# Ouro project seal.
# Precedence is: CLI > environment > this file > built-in defaults.
# trust {} records intent; the compiler still checks every program.

seal 1

project {
  name = "ouro"
  version = "0.1.0"
}

build {
  profile = "dev"
  jobs = 10
  cc = "cc"
  opt = "O1"
  out = "_build"
  c_out = "_build/c"
  verbosity = "normal"
  reproducible = false
}

cache {
  enabled = true
  dir = "_cache/ouro"
  size = "2048mb"
  cleanup = "lru"
  ccache = "auto"
}

trust {
  compiler = "required"
  generated = "checked"
  effects = "outside-checker"
}
