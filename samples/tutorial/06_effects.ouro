-- Handle an operation in a pure expression.
-- Surface: effect Op : T  |  perform Op  |  handle ... with | Op k => ... | pure x => ... end
-- An operation clause can resume the continuation once.

import "../../std/string_prims.ouro";

-- @entry main
effect Ask : String

def main : String :=
  handle perform Ask with
  | Ask k => k "Ouro"
  | pure x => x
  end
