-- Tutorial 06: algebraic effects (pure smoke, no --io)
-- Surface: effect Op : T  |  perform Op  |  handle ... with | Op k => ... | pure x => ... end
-- One-shot resume only (multi-shot is unsupported / fail-closed).
-- Runtime extraction for this tutorial is not part of the cleaned archive's
-- default smoke path.

import "../../std/runtime.ouro";

-- @entry main
effect Ask : String

def main : String :=
  handle perform Ask with
  | Ask k => k "Ouro"
  | pure x => x
  end
