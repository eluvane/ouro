-- Tutorial 03: polymorphic lists
-- The list literals below never spell Nil/Cons, so the tutorial's data types
-- are roots too.
-- @entry singleton tutorial_pair Nat List
inductive Nat : Type := | Z : Nat | S : Nat -> Nat;
inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def singleton (n : Nat) : List Nat := [n];

def tutorial_pair : List Nat := [Z, S Z];
