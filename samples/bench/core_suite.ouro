-- Frozen language-case benchmark; extend only additively.

-- Every case below is a benchmark root, including the data types and the
-- folds no other case calls.
-- @entry type_in_type1 pi_univ id comp twelve
-- @entry Nat Bool List Pair add map foldr
def type_in_type1 : Type1 := Type;
def pi_univ : Type2 := (_ : Type1) -> Type;

def id (A : Type) (x : A) : A := x;
def comp (A : Type) (B : Type) (C : Type) (f : B -> C) (g : A -> B) (x : A) : C := f (g x);

inductive Nat : Type := | Z : Nat | S : Nat -> Nat;
inductive Bool : Type := | True : Bool | False : Bool;
inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;
inductive Pair (A : Type) (B : Type) : Type :=
  | MkPair : A -> B -> Pair A B;

def add : Nat -> Nat -> Nat :=
  fix add (n : Nat) (m : Nat) : Nat :=
    match n with | Z => m | S n' => S (add n' m) end;

def map (A : Type) (B : Type) (f : A -> B) : List A -> List B :=
    fix map (xs : List A) : List B :=
      match xs with
      | Nil => Nil B
      | Cons x xs' => Cons B (f x) (map xs')
      end;

def foldr (A : Type) (B : Type) (f : A -> B -> B) (z : B) : List A -> B :=
    fix foldr (xs : List A) : B :=
      match xs with
      | Nil => z
      | Cons x xs' => f x (foldr xs')
      end;

def twelve : Nat :=
  let six : Nat := add 2 4 in
  (add six six : Nat);
