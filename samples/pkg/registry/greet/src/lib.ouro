-- Package "greet" depends on package "hello" (see Ouro.seal). Sibling
-- packages sit next to each other both in the registry and in a project's
-- _ouro_pkgs/, so this one relative import works before and after
-- `coil install` / `ouro1 pkg install`.

-- @entry greet_msg greet_of

import "../../hello/src/lib.ouro";

def greet_msg : Greeting := hello_msg;

def greet_of (A : Type) (x : A) : A := hello_id A x;
