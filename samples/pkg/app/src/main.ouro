-- Sample project for coil / `ouro1 pkg`. `coil install` vendors greet and its
-- dependency hello into _ouro_pkgs/. Quality tools require a regular source
-- file, so the checkable import uses the registry copy (the same modules
-- install vendors). The compiler still sees only a relative path.
--   cd samples/pkg/app

-- @entry main

import "../../registry/greet/src/lib.ouro";
import "../../../../std/io.ouro";

def main : IO Unit :=
    do println "greet -> package";
       println "hello -> package";
       exit 0
