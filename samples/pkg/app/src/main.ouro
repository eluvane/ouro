-- Sample project for coil / `ouro1 pkg`. `coil install` vendors greet and its
-- dependency hello into _ouro_pkgs/, and the imports below are plain relative
-- paths into that directory — the compiler knows nothing about packages.
--   cd samples/pkg/app

-- @entry main

import "../_ouro_pkgs/greet/src/lib.ouro";
import "../../../../std/io.ouro";

def main : IO Unit :=
    do println "greet -> package";
       println "hello -> package";
       exit 0
