-- Identity vocabulary for typed external transformations.

import "../../std/crypto.ouro",
  "../../std/format.ouro";

inductive ContentIdentity : Type :=
  | ContentDigest : String -> String -> ContentIdentity;

inductive TransformationIdentity : Type :=
  | MkTransformationIdentity : String -> TransformationIdentity;

inductive ArtifactIdentity : Type :=
  | DeclaredSourceIdentity :
      String -> Maybe ContentIdentity -> ArtifactIdentity
  | DerivedArtifactIdentity :
      TransformationIdentity -> Maybe ContentIdentity -> ArtifactIdentity;

inductive ToolIdentity : Type :=
  | MkToolIdentity : String -> String -> String -> ToolIdentity;

inductive ReproducibilityParameter : Type :=
  | MkReproducibilityParameter :
      String -> String -> ReproducibilityParameter;

inductive ToolDeterminism : Type :=
  | DeterministicTool : ToolDeterminism
  | NondeterministicTool : String -> ToolDeterminism;

inductive ExecutionEnvironment : Type :=
  | PinnedEnvironment : String -> ExecutionEnvironment
  | UnpinnedEnvironment : String -> ExecutionEnvironment;

inductive OutputContract : Type :=
  | ExpectedFileOutput : String -> String -> OutputContract;


def contentIdentityAlgorithm (identity : ContentIdentity) : String :=
  match identity with
  | ContentDigest algorithm _ => algorithm
  end;

def contentIdentityDigest (identity : ContentIdentity) : String :=
  match identity with
  | ContentDigest _ digest => digest
  end;

def transformationIdentityValue
  (identity : TransformationIdentity) : String :=
  match identity with
  | MkTransformationIdentity value => value
  end;

def declaredSourceArtifactIdentity (source : String) : ArtifactIdentity :=
  DeclaredSourceIdentity(source, Nothing ContentIdentity);

def contentAddressedSourceArtifactIdentity
  (source : String)
  (algorithm : String)
  (digest : String) : ArtifactIdentity :=
  DeclaredSourceIdentity source
    (Just(ContentIdentity, ContentDigest algorithm digest));

def artifactIdentityKind (identity : ArtifactIdentity) : String :=
  match identity with
  | DeclaredSourceIdentity _ _ => "declared_source"
  | DerivedArtifactIdentity _ _ => "derived_transformation"
  end;

def artifactIdentityContent
  (identity : ArtifactIdentity) : Maybe ContentIdentity :=
  match identity with
  | DeclaredSourceIdentity _ content => content
  | DerivedArtifactIdentity _ content => content
  end;

def artifactIdentityTransformation
  (identity : ArtifactIdentity) : Maybe TransformationIdentity :=
  match identity with
  | DeclaredSourceIdentity _ _ => Nothing TransformationIdentity
  | DerivedArtifactIdentity transformation _ =>
      Just TransformationIdentity transformation
  end;

def artifactHasContentIdentity (identity : ArtifactIdentity) : Bool :=
  match artifactIdentityContent identity with
  | Nothing => False
  | Just _ => True
  end;

def toolIdentityName (tool : ToolIdentity) : String :=
  match tool with
  | MkToolIdentity name _ _ => name
  end;

def toolIdentityExecutable (tool : ToolIdentity) : String :=
  match tool with
  | MkToolIdentity _ executable _ => executable
  end;

def toolIdentityVersion (tool : ToolIdentity) : String :=
  match tool with
  | MkToolIdentity _ _ version => version
  end;

def toolIdentityLabel (tool : ToolIdentity) : String :=
  str_cat3(toolIdentityName tool, "@", toolIdentityVersion tool);

def parameterName (parameter : ReproducibilityParameter) : String :=
  match parameter with
  | MkReproducibilityParameter name _ => name
  end;

def parameterValue (parameter : ReproducibilityParameter) : String :=
  match parameter with
  | MkReproducibilityParameter _ value => value
  end;

def outputContractKind (contract : OutputContract) : String :=
  match contract with
  | ExpectedFileOutput kind _ => kind
  end;

def outputContractPath (contract : OutputContract) : String :=
  match contract with
  | ExpectedFileOutput _ path => path
  end;


def canonicalField (name : String) (value : String) : String :=
  str_cat4(name, "#", show_nat (str_len value), str_cat3 ":" value ";");

def canonicalContentIdentity (identity : ContentIdentity) : String :=
  str_join "|"
    ([ canonicalField("algorithm", contentIdentityAlgorithm identity)
    , canonicalField("digest", contentIdentityDigest identity)
    ] : List String);

def canonicalOptionalContent
  (content : Maybe ContentIdentity) : String :=
  match content with
  | Nothing => canonicalField "content" "unknown"
  | Just identity =>
      canonicalField("content", canonicalContentIdentity identity)
  end;

def artifactIdentityCanonical (identity : ArtifactIdentity) : String :=
  match identity with
  | DeclaredSourceIdentity source content =>
      str_join "|"
        ([ canonicalField "artifact-kind" "declared-source"
        , canonicalField "source" source
        , canonicalOptionalContent content
        ] : List String)
  | DerivedArtifactIdentity transformation content =>
      str_join "|"
        ([ canonicalField "artifact-kind" "derived-transformation"
        , canonicalField "transformation"
            (transformationIdentityValue transformation)
        , canonicalOptionalContent content
        ] : List String)
  end;

def canonicalStrings : List String -> String :=
  fix canonicalStrings (values : List String) : String :=
    match values with
    | Nil => ""
    | Cons value rest =>
        str_concat(canonicalField "item" value, canonicalStrings rest)
    end;

def canonicalParameters : List ReproducibilityParameter -> String :=
  fix canonicalParameters
    (parameters : List ReproducibilityParameter) : String :=
    match parameters with
    | Nil => ""
    | Cons parameter rest =>
        str_concat
          (str_join ""
            ([ canonicalField("parameter-name", parameterName parameter)
            , canonicalField("parameter-value", parameterValue parameter)
            ] : List String))
          (canonicalParameters rest)
    end;

def canonicalArtifactIdentities : List ArtifactIdentity -> String :=
  fix canonicalArtifactIdentities
    (artifacts : List ArtifactIdentity) : String :=
    match artifacts with
    | Nil => ""
    | Cons artifact rest =>
        str_concat
          (canonicalField("artifact", artifactIdentityCanonical artifact))
          (canonicalArtifactIdentities rest)
    end;

def canonicalEnvironment (environment : ExecutionEnvironment) : String :=
  match environment with
  | PinnedEnvironment identity => canonicalField "pinned" identity
  | UnpinnedEnvironment reason => canonicalField "unpinned" reason
  end;

def canonicalDeterminism (determinism : ToolDeterminism) : String :=
  match determinism with
  | DeterministicTool => "deterministic"
  | NondeterministicTool reason => str_concat "nondeterministic:" reason
  end;

def canonicalOutputContract (contract : OutputContract) : String :=
  str_join "|"
    ([ canonicalField("kind", outputContractKind contract)
    , canonicalField("path", outputContractPath contract)
    ] : List String);
