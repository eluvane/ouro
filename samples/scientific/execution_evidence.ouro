-- Typed execution records and provenance relationships.

import "identity.ouro",
  "../../std/crypto.ouro";

inductive ToolSpec (Input : Type) (Output : Type) : Type :=
  | MkToolSpec :
      ToolIdentity ->
      List String ->
      List ReproducibilityParameter ->
      ExecutionEnvironment ->
      ToolDeterminism ->
      OutputContract ->
      ToolSpec Input Output;

inductive ToolInvocation (Input : Type) (Output : Type) : Type :=
  | MkToolInvocation :
      ToolSpec Input Output ->
      Input ->
      List ArtifactIdentity ->
      ToolInvocation Input Output;

inductive StreamMetadata : Type :=
  | MkStreamMetadata : Nat -> String -> StreamMetadata;

inductive Reproducibility : Type :=
  | ReproducibilityMetadataComplete :
      TransformationIdentity -> Reproducibility
  | IncompleteReproducibility : String -> Reproducibility;

inductive ExecutionAttempt : Type :=
  | MkExecutionAttempt :
      ToolIdentity ->
      List String ->
      List ReproducibilityParameter ->
      ExecutionEnvironment ->
      ToolDeterminism ->
      List ArtifactIdentity ->
      OutputContract ->
      TransformationIdentity ->
      Nat ->
      StreamMetadata ->
      StreamMetadata ->
      ExecutionAttempt;

inductive ExecutionRecord : Type :=
  | MkExecutionRecord :
      ExecutionAttempt ->
      ArtifactIdentity ->
      Reproducibility ->
      ExecutionRecord;

inductive ExecutionEvidence (Input : Type) (Output : Type) : Type :=
  | MkExecutionEvidence :
      ExecutionRecord -> ExecutionEvidence Input Output;

inductive SuccessfulExecution (Input : Type) (Output : Type) : Type :=
  | MkSuccessfulExecution :
      Input ->
      ExecutionEvidence Input Output ->
      SuccessfulExecution Input Output;

inductive ExternalToolError : Type :=
  | InvalidExternalToolSpec : String -> ExternalToolError
  | OutputPreparationFailed : ToolIdentity -> String -> ExternalToolError
  | ExternalProcessFailed : ExecutionAttempt -> ExternalToolError
  | ExpectedOutputMissing : ExecutionAttempt -> ExternalToolError;

inductive Provenance : Type :=
  | SourceArtifact : String -> ArtifactIdentity -> Provenance
  | DerivedArtifact : Provenance -> ExecutionRecord -> Provenance
  | JoinedArtifact : Provenance -> Provenance -> ExecutionRecord -> Provenance;


def toolSpecIdentity
  (Input : Type)
  (Output : Type)
  (spec : ToolSpec Input Output) : ToolIdentity :=
  match spec with
  | MkToolSpec tool _ _ _ _ _ => tool
  end;

def toolSpecArguments
  (Input : Type)
  (Output : Type)
  (spec : ToolSpec Input Output) : List String :=
  match spec with
  | MkToolSpec _ arguments _ _ _ _ => arguments
  end;

def toolSpecParameters
  (Input : Type)
  (Output : Type)
  (spec : ToolSpec Input Output) : List ReproducibilityParameter :=
  match spec with
  | MkToolSpec _ _ parameters _ _ _ => parameters
  end;

def toolSpecEnvironment
  (Input : Type)
  (Output : Type)
  (spec : ToolSpec Input Output) : ExecutionEnvironment :=
  match spec with
  | MkToolSpec _ _ _ environment _ _ => environment
  end;

def toolSpecDeterminism
  (Input : Type)
  (Output : Type)
  (spec : ToolSpec Input Output) : ToolDeterminism :=
  match spec with
  | MkToolSpec _ _ _ _ determinism _ => determinism
  end;

def toolSpecOutputContract
  (Input : Type)
  (Output : Type)
  (spec : ToolSpec Input Output) : OutputContract :=
  match spec with
  | MkToolSpec _ _ _ _ _ contract => contract
  end;

def toolSpecOutputPath
  (Input : Type)
  (Output : Type)
  (spec : ToolSpec Input Output) : String :=
  outputContractPath (toolSpecOutputContract Input Output spec);

def streamMetadata (text : String) : StreamMetadata :=
  MkStreamMetadata(str_len text, sha256 text);

def streamMetadataSize (metadata : StreamMetadata) : Nat :=
  match metadata with
  | MkStreamMetadata size _ => size
  end;

def streamMetadataDigest (metadata : StreamMetadata) : String :=
  match metadata with
  | MkStreamMetadata _ digest => digest
  end;

def reproducibilityCode (status : Reproducibility) : String :=
  match status with
  | ReproducibilityMetadataComplete _ => "metadata_complete"
  | IncompleteReproducibility _ => "incomplete"
  end;

def reproducibilityReason (status : Reproducibility) : String :=
  match status with
  | ReproducibilityMetadataComplete _ => ""
  | IncompleteReproducibility reason => reason
  end;

def reproducibilityTransformationIdentity
  (status : Reproducibility) : Maybe TransformationIdentity :=
  match status with
  | ReproducibilityMetadataComplete identity =>
      Just TransformationIdentity identity
  | IncompleteReproducibility _ => Nothing TransformationIdentity
  end;

def executionAttemptTool (attempt : ExecutionAttempt) : ToolIdentity :=
  match attempt with
  | MkExecutionAttempt tool _ _ _ _ _ _ _ _ _ _ => tool
  end;

def executionAttemptArguments (attempt : ExecutionAttempt) : List String :=
  match attempt with
  | MkExecutionAttempt _ arguments _ _ _ _ _ _ _ _ _ => arguments
  end;

def executionAttemptParameters
  (attempt : ExecutionAttempt) : List ReproducibilityParameter :=
  match attempt with
  | MkExecutionAttempt _ _ parameters _ _ _ _ _ _ _ _ => parameters
  end;

def executionAttemptEnvironment
  (attempt : ExecutionAttempt) : ExecutionEnvironment :=
  match attempt with
  | MkExecutionAttempt _ _ _ environment _ _ _ _ _ _ _ => environment
  end;

def executionAttemptDeterminism
  (attempt : ExecutionAttempt) : ToolDeterminism :=
  match attempt with
  | MkExecutionAttempt _ _ _ _ determinism _ _ _ _ _ _ => determinism
  end;

def executionAttemptInputArtifacts
  (attempt : ExecutionAttempt) : List ArtifactIdentity :=
  match attempt with
  | MkExecutionAttempt _ _ _ _ _ inputs _ _ _ _ _ => inputs
  end;

def executionAttemptOutputContract
  (attempt : ExecutionAttempt) : OutputContract :=
  match attempt with
  | MkExecutionAttempt _ _ _ _ _ _ contract _ _ _ _ => contract
  end;

def executionAttemptOutputKind (attempt : ExecutionAttempt) : String :=
  outputContractKind (executionAttemptOutputContract attempt);

def executionAttemptOutputPath (attempt : ExecutionAttempt) : String :=
  outputContractPath (executionAttemptOutputContract attempt);

def executionAttemptTransformationIdentity
  (attempt : ExecutionAttempt) : TransformationIdentity :=
  match attempt with
  | MkExecutionAttempt _ _ _ _ _ _ _ identity _ _ _ => identity
  end;

def executionAttemptStatus (attempt : ExecutionAttempt) : Nat :=
  match attempt with
  | MkExecutionAttempt _ _ _ _ _ _ _ _ status _ _ => status
  end;

def executionAttemptStdout (attempt : ExecutionAttempt) : StreamMetadata :=
  match attempt with
  | MkExecutionAttempt _ _ _ _ _ _ _ _ _ stdoutMetadata _ =>
      stdoutMetadata
  end;

def executionAttemptStderr (attempt : ExecutionAttempt) : StreamMetadata :=
  match attempt with
  | MkExecutionAttempt _ _ _ _ _ _ _ _ _ _ stderrMetadata =>
      stderrMetadata
  end;

def executionRecordAttempt (execution : ExecutionRecord) : ExecutionAttempt :=
  match execution with
  | MkExecutionRecord attempt _ _ => attempt
  end;

def executionRecordOutputIdentity
  (execution : ExecutionRecord) : ArtifactIdentity :=
  match execution with
  | MkExecutionRecord _ outputIdentity _ => outputIdentity
  end;

def executionRecordReproducibility
  (execution : ExecutionRecord) : Reproducibility :=
  match execution with
  | MkExecutionRecord _ _ reproducibility => reproducibility
  end;

def executionEvidenceRecord
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : ExecutionRecord :=
  match evidence with
  | MkExecutionEvidence execution => execution
  end;

def executionEvidenceAttempt
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : ExecutionAttempt :=
  executionRecordAttempt (executionEvidenceRecord Input Output evidence);

def executionEvidenceTool
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : ToolIdentity :=
  executionAttemptTool (executionEvidenceAttempt Input Output evidence);

def executionEvidenceArguments
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : List String :=
  executionAttemptArguments (executionEvidenceAttempt Input Output evidence);

def executionEvidenceParameters
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output)
  : List ReproducibilityParameter :=
  executionAttemptParameters (executionEvidenceAttempt Input Output evidence);

def executionEvidenceInputArtifacts
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : List ArtifactIdentity :=
  executionAttemptInputArtifacts (executionEvidenceAttempt Input Output evidence);

def executionEvidenceOutputContract
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : OutputContract :=
  executionAttemptOutputContract (executionEvidenceAttempt Input Output evidence);

def executionEvidenceOutputPath
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : String :=
  executionAttemptOutputPath (executionEvidenceAttempt Input Output evidence);

def executionEvidenceTransformationIdentity
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : TransformationIdentity :=
  executionAttemptTransformationIdentity
    (executionEvidenceAttempt Input Output evidence);

def executionEvidenceOutputIdentity
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : ArtifactIdentity :=
  executionRecordOutputIdentity (executionEvidenceRecord Input Output evidence);

def executionEvidenceStatus
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : Nat :=
  executionAttemptStatus (executionEvidenceAttempt Input Output evidence);

def executionEvidenceStdout
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : StreamMetadata :=
  executionAttemptStdout (executionEvidenceAttempt Input Output evidence);

def executionEvidenceStderr
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : StreamMetadata :=
  executionAttemptStderr (executionEvidenceAttempt Input Output evidence);

def executionEvidenceReproducibility
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : Reproducibility :=
  executionRecordReproducibility (executionEvidenceRecord Input Output evidence);

def successfulExecutionInput
  (Input : Type)
  (Output : Type)
  (execution : SuccessfulExecution Input Output) : Input :=
  match execution with
  | MkSuccessfulExecution input _ => input
  end;

def successfulExecutionEvidence
  (Input : Type)
  (Output : Type)
  (execution : SuccessfulExecution Input Output)
  : ExecutionEvidence Input Output :=
  match execution with
  | MkSuccessfulExecution _ evidence => evidence
  end;

def provenanceArtifactIdentity (provenance : Provenance) : ArtifactIdentity :=
  match provenance with
  | SourceArtifact _ identity => identity
  | DerivedArtifact _ execution => executionRecordOutputIdentity execution
  | JoinedArtifact _ _ execution => executionRecordOutputIdentity execution
  end;

def provenanceParentArtifactIdentities
  (provenance : Provenance) : List ArtifactIdentity :=
  match provenance with
  | SourceArtifact _ _ => Nil ArtifactIdentity
  | DerivedArtifact parent _ =>
      ([ provenanceArtifactIdentity parent ] : List ArtifactIdentity)
  | JoinedArtifact left right _ =>
      ([ provenanceArtifactIdentity left
      , provenanceArtifactIdentity right
      ] : List ArtifactIdentity)
  end;

def provenanceSourceArtifactIdentities : Provenance -> List ArtifactIdentity :=
  fix provenanceSourceArtifactIdentities (provenance : Provenance)
    : List ArtifactIdentity :=
    match provenance with
    | SourceArtifact _ identity => ([ identity ] : List ArtifactIdentity)
    | DerivedArtifact parent _ =>
        provenanceSourceArtifactIdentities parent
    | JoinedArtifact left right _ =>
        append ArtifactIdentity
          (provenanceSourceArtifactIdentities left)
          (provenanceSourceArtifactIdentities right)
    end;

def provenanceExecutionRecord
  (provenance : Provenance) : Maybe ExecutionRecord :=
  match provenance with
  | SourceArtifact _ _ => Nothing ExecutionRecord
  | DerivedArtifact _ execution => Just ExecutionRecord execution
  | JoinedArtifact _ _ execution => Just ExecutionRecord execution
  end;

def provenanceTransformationIdentity
  (provenance : Provenance) : Maybe TransformationIdentity :=
  match provenanceExecutionRecord provenance with
  | Nothing => Nothing TransformationIdentity
  | Just execution =>
      Just TransformationIdentity
        (executionAttemptTransformationIdentity
          (executionRecordAttempt execution))
  end;

def provenanceKind (provenance : Provenance) : String :=
  match provenance with
  | SourceArtifact _ _ => "source"
  | DerivedArtifact _ _ => "derived_execution"
  | JoinedArtifact _ _ _ => "joined_execution"
  end;
