import "bio.ouro";

def indexedSource : Provenance :=
  SourceArtifact "indexed GRCh38 BAM"
    (declaredSourceArtifactIdentity "fixture:indexed-GRCh38");

def indexedBam : Bam Human GRCh38 CoordinateSorted Indexed :=
  MkBam Human GRCh38 CoordinateSorted Indexed "aligned.bam" indexedSource;

def grch37AnnotationSource : Provenance :=
  SourceArtifact "legacy GRCh37 annotation"
    (declaredSourceArtifactIdentity "fixture:annotation-GRCh37");

def grch37Annotation : GeneAnnotation Human GRCh37 :=
  MkGeneAnnotation Human GRCh37 "legacy.gtf" grch37AnnotationSource;

-- A GRCh38 BAM cannot prepare a GRCh37 quantification invocation.
def invalidBuildMix
  (spec :
    ToolSpec
      (QuantificationInput Human GRCh38)
      (Expression Samples Genes RawCounts))
  : ToolInvocation
      (QuantificationInput Human GRCh38)
      (Expression Samples Genes RawCounts) :=
  prepareQuantification Human GRCh38 spec indexedBam grch37Annotation;
