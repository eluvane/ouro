import "bio.ouro";

def variantBamSource : Provenance :=
  SourceArtifact "GRCh38 indexed BAM"
    (declaredSourceArtifactIdentity "fixture:variant-bam-GRCh38");

def variantBam : Bam Human GRCh38 CoordinateSorted Indexed :=
  MkBam Human GRCh38 CoordinateSorted Indexed
    "sample.GRCh38.sorted.bam" variantBamSource;

def legacyReferenceSource : Provenance :=
  SourceArtifact "GRCh37 reference"
    (declaredSourceArtifactIdentity "fixture:reference-GRCh37");

def legacyReference : ReferenceGenome Human GRCh37 :=
  MkReferenceGenome Human GRCh37 "GRCh37.fa" legacyReferenceSource;

-- A GRCh38 BAM cannot be called against a GRCh37 reference.
def invalidVariantBuildMix
  (spec :
    ToolSpec
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants))
  : ToolInvocation
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants) :=
  prepareVariantCalling Human GRCh38 spec variantBam legacyReference;
