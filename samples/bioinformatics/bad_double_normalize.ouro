import "bio.ouro";

def normalizedSource : Provenance :=
  SourceArtifact "normalized expression"
    (declaredSourceArtifactIdentity "fixture:normalized-expression");

def normalized : Expression Samples Genes Normalized :=
  MkExpression Samples Genes Normalized "normalized.tsv" normalizedSource;

-- Normalization preparation accepts raw counts, not an already normalized matrix.
def invalidDoubleNormalize
  (spec :
    ToolSpec
      (Expression Samples Genes RawCounts)
      (Expression Samples Genes Normalized))
  : ToolInvocation
      (Expression Samples Genes RawCounts)
      (Expression Samples Genes Normalized) :=
  prepareNormalization Samples Genes spec normalized;
