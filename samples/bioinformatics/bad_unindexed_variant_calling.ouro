import "bio.ouro";

def unindexedVariantBamSource : Provenance :=
  SourceArtifact "GRCh38 unindexed BAM"
    (declaredSourceArtifactIdentity "fixture:variant-bam-unindexed");

def unindexedVariantBam : Bam Human GRCh38 CoordinateSorted Unindexed :=
  MkBam Human GRCh38 CoordinateSorted Unindexed
    "sample.GRCh38.sorted.bam" unindexedVariantBamSource;

def variantReferenceSource : Provenance :=
  SourceArtifact "GRCh38 reference"
    (declaredSourceArtifactIdentity "fixture:variant-reference-GRCh38");

def variantReference : ReferenceGenome Human GRCh38 :=
  MkReferenceGenome Human GRCh38 "GRCh38.fa" variantReferenceSource;

-- Variant calling requires a coordinate-sorted and indexed BAM.
def invalidUnindexedVariantCalling
  (spec :
    ToolSpec
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants))
  : ToolInvocation
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants) :=
  prepareVariantCalling Human GRCh38 spec
    unindexedVariantBam variantReference;
