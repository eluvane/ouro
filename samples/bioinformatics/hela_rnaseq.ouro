-- Fixture-backed HeLa RNA-seq slice with two real process boundaries.

import "bio.ouro";
import "../../std/format.ouro";

def helaSampleSource : Provenance :=
  SourceArtifact "HeLa-S3 RNA sample"
    (declaredSourceArtifactIdentity "biosample:hela-s3");

def helaSample : BiologicalSample Human :=
  MkBiologicalSample Human "HeLa-S3" "poly(A)+ RNA" helaSampleSource;

def helaReadsSource : Provenance :=
  SourceArtifact "HeLa-S3 paired-end FASTQ manifest"
    (declaredSourceArtifactIdentity "dataset:hela-s3-rna-seq");

def helaReadFiles : ReadFiles PairedEnd :=
  PairedReads "data/hela_R1.fastq.gz" "data/hela_R2.fastq.gz";

def helaReads : Fastq Human PairedEnd UncheckedReads :=
  MkFastq Human PairedEnd UncheckedReads
    helaSample helaReadFiles helaReadsSource;

def grch38Source : Provenance :=
  SourceArtifact "GRCh38 primary assembly"
    (declaredSourceArtifactIdentity "reference:GRCh38");

def grch38Reference : ReferenceGenome Human GRCh38 :=
  MkReferenceGenome Human GRCh38
    "references/GRCh38.primary_assembly.fa" grch38Source;

def gencodeSource : Provenance :=
  SourceArtifact "GENCODE GRCh38 gene annotation"
    (declaredSourceArtifactIdentity "annotation:GENCODE-GRCh38");

def gencodeAnnotation : GeneAnnotation Human GRCh38 :=
  MkGeneAnnotation Human GRCh38
    "references/gencode.annotation.gtf" gencodeSource;

def validationOutput : String :=
  "_build/bioinformatics/hela.validation.json";

def alignmentOutput : String :=
  "_build/bioinformatics/hela.aligned.bam";

def fixtureValidationSpec :
  ToolSpec
    (Fastq Human PairedEnd UncheckedReads)
    (Fastq Human PairedEnd ValidatedReads) :=
  MkToolSpec
    (Fastq Human PairedEnd UncheckedReads)
    (Fastq Human PairedEnd ValidatedReads)
    (MkToolIdentity "fixture-fastq-validator" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "validate"
    , validationOutput
    , "data/hela_R1.fastq.gz"
    , "data/hela_R2.fastq.gz"
    ] : List String)
    ([ MkReproducibilityParameter "mode" "validate"
    , MkReproducibilityParameter "schema" "1"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput "validated-fastq" validationOutput);

def fixtureAlignmentSpec :
  ToolSpec
    (AlignmentInput Human PairedEnd GRCh38)
    (Bam Human GRCh38 Unsorted Unindexed) :=
  MkToolSpec
    (AlignmentInput Human PairedEnd GRCh38)
    (Bam Human GRCh38 Unsorted Unindexed)
    (MkToolIdentity "fixture-aligner" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "align"
    , alignmentOutput
    , "data/hela_R1.fastq.gz"
    , "data/hela_R2.fastq.gz"
    , "references/GRCh38.primary_assembly.fa"
    ] : List String)
    ([ MkReproducibilityParameter "mode" "align"
    , MkReproducibilityParameter "reference" "GRCh38"
    , MkReproducibilityParameter "layout" "paired"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput "bam:GRCh38:unsorted:unindexed" alignmentOutput);

def failedAlignmentOutput : String :=
  "_build/bioinformatics/hela.failed.bam";

def failedAlignmentSpec :
  ToolSpec
    (AlignmentInput Human PairedEnd GRCh38)
    (Bam Human GRCh38 Unsorted Unindexed) :=
  MkToolSpec
    (AlignmentInput Human PairedEnd GRCh38)
    (Bam Human GRCh38 Unsorted Unindexed)
    (MkToolIdentity "fixture-aligner" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "fail"
    , failedAlignmentOutput
    , "data/hela_R1.fastq.gz"
    , "data/hela_R2.fastq.gz"
    , "references/GRCh38.primary_assembly.fa"
    ] : List String)
    ([ MkReproducibilityParameter "mode" "fail"
    , MkReproducibilityParameter "reference" "GRCh38"
    , MkReproducibilityParameter "layout" "paired"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput
      "bam:GRCh38:unsorted:unindexed" failedAlignmentOutput);

def missingAlignmentOutput : String :=
  "_build/bioinformatics/hela.missing.bam";

def missingAlignmentSpec :
  ToolSpec
    (AlignmentInput Human PairedEnd GRCh38)
    (Bam Human GRCh38 Unsorted Unindexed) :=
  MkToolSpec
    (AlignmentInput Human PairedEnd GRCh38)
    (Bam Human GRCh38 Unsorted Unindexed)
    (MkToolIdentity "fixture-aligner" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "no-output"
    , missingAlignmentOutput
    , "data/hela_R1.fastq.gz"
    , "data/hela_R2.fastq.gz"
    , "references/GRCh38.primary_assembly.fa"
    ] : List String)
    ([ MkReproducibilityParameter "mode" "no-output"
    , MkReproducibilityParameter "reference" "GRCh38"
    , MkReproducibilityParameter "layout" "paired"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput
      "bam:GRCh38:unsorted:unindexed" missingAlignmentOutput);

inductive HelaOutcome : Type :=
  | MkHelaOutcome :
      Fastq Human PairedEnd ValidatedReads ->
      ExecutionEvidence
        (Fastq Human PairedEnd UncheckedReads)
        (Fastq Human PairedEnd ValidatedReads) ->
      Bam Human GRCh38 Unsorted Unindexed ->
      ExecutionEvidence
        (AlignmentInput Human PairedEnd GRCh38)
        (Bam Human GRCh38 Unsorted Unindexed) ->
      HelaOutcome;

def runHelaPipeline : IO (Either ExternalToolError HelaOutcome) :=
  let validationInvocation :
    ToolInvocation
      (Fastq Human PairedEnd UncheckedReads)
      (Fastq Human PairedEnd ValidatedReads) :=
    prepareReadValidation Human PairedEnd fixtureValidationSpec helaReads in
  do let! validationResult :=
       runExternalTool
         (Fastq Human PairedEnd UncheckedReads)
         (Fastq Human PairedEnd ValidatedReads)
         validationInvocation;
     match validationResult with
     | Left error =>
         io_pure (Either ExternalToolError HelaOutcome)
           (Left ExternalToolError HelaOutcome error)
     | Right validationExecution =>
         let validated : Fastq Human PairedEnd ValidatedReads :=
           validateReads Human PairedEnd validationExecution in
         let validationEvidence :
           ExecutionEvidence
             (Fastq Human PairedEnd UncheckedReads)
             (Fastq Human PairedEnd ValidatedReads) :=
           successfulExecutionEvidence
             (Fastq Human PairedEnd UncheckedReads)
             (Fastq Human PairedEnd ValidatedReads)
             validationExecution in
         let alignmentInvocation :
           ToolInvocation
             (AlignmentInput Human PairedEnd GRCh38)
             (Bam Human GRCh38 Unsorted Unindexed) :=
           prepareAlignment Human PairedEnd GRCh38
             fixtureAlignmentSpec validated grch38Reference in
         do let! alignmentResult :=
              runExternalTool
                (AlignmentInput Human PairedEnd GRCh38)
                (Bam Human GRCh38 Unsorted Unindexed)
                alignmentInvocation;
            match alignmentResult with
            | Left error =>
                io_pure (Either ExternalToolError HelaOutcome)
                  (Left ExternalToolError HelaOutcome error)
            | Right alignmentExecution =>
                let aligned : Bam Human GRCh38 Unsorted Unindexed :=
                  alignReads Human PairedEnd GRCh38 alignmentExecution in
                let alignmentEvidence :
                  ExecutionEvidence
                    (AlignmentInput Human PairedEnd GRCh38)
                    (Bam Human GRCh38 Unsorted Unindexed) :=
                  successfulExecutionEvidence
                    (AlignmentInput Human PairedEnd GRCh38)
                    (Bam Human GRCh38 Unsorted Unindexed)
                    alignmentExecution in
                io_pure (Either ExternalToolError HelaOutcome)
                  (Right ExternalToolError HelaOutcome
                    (MkHelaOutcome validated validationEvidence
                      aligned alignmentEvidence))
            end
     end

def evidenceToolLabel
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : String :=
  toolIdentityLabel (executionEvidenceTool Input Output evidence);

def evidenceHasIdentity
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : Bool :=
  notb
    (str_null
      (transformationIdentityValue
        (executionEvidenceTransformationIdentity Input Output evidence)));

def evidenceHasStdoutMetadata
  (Input : Type)
  (Output : Type)
  (evidence : ExecutionEvidence Input Output) : Bool :=
  ltb_nat Z
    (streamMetadataSize (executionEvidenceStdout Input Output evidence));

def reportOutcome (outcome : HelaOutcome) : IO Unit :=
  match outcome with
  | MkHelaOutcome _ validationEvidence aligned alignmentEvidence =>
      do println "typed_validation=ok";
         println "typed_alignment=ok";
         println
           (kv_line "validation_tool"
             (evidenceToolLabel
               (Fastq Human PairedEnd UncheckedReads)
               (Fastq Human PairedEnd ValidatedReads)
               validationEvidence));
         println
           (kv_line "alignment_tool"
             (evidenceToolLabel
               (AlignmentInput Human PairedEnd GRCh38)
               (Bam Human GRCh38 Unsorted Unindexed)
               alignmentEvidence));
         println
           (kv_line "exit_status"
             (show_nat
               (executionEvidenceStatus
                 (AlignmentInput Human PairedEnd GRCh38)
                 (Bam Human GRCh38 Unsorted Unindexed)
                 alignmentEvidence)));
         println
           (kv_line "output_path"
             (bamPath Human GRCh38 Unsorted Unindexed aligned));
         println
           (kv_line "output_identity"
             (show_bool
               (evidenceHasIdentity
                 (AlignmentInput Human PairedEnd GRCh38)
                 (Bam Human GRCh38 Unsorted Unindexed)
                 alignmentEvidence)));
         println
           (kv_line "input_artifacts"
             (show_nat
               (length ArtifactIdentity
                 (executionEvidenceInputArtifacts
                   (AlignmentInput Human PairedEnd GRCh38)
                   (Bam Human GRCh38 Unsorted Unindexed)
                   alignmentEvidence))));
         println
           (kv_line "arguments"
             (show_nat
               (length String
                 (executionEvidenceArguments
                   (AlignmentInput Human PairedEnd GRCh38)
                   (Bam Human GRCh38 Unsorted Unindexed)
                   alignmentEvidence))));
         println
           (kv_line "provenance"
             (provenanceKind
               (bamProvenance Human GRCh38 Unsorted Unindexed aligned)));
         println
           (kv_line "validation_reproducibility"
             (reproducibilityCode
               (executionEvidenceReproducibility
                 (Fastq Human PairedEnd UncheckedReads)
                 (Fastq Human PairedEnd ValidatedReads)
                 validationEvidence)));
         println
           (kv_line "alignment_reproducibility"
             (reproducibilityCode
               (executionEvidenceReproducibility
                 (AlignmentInput Human PairedEnd GRCh38)
                 (Bam Human GRCh38 Unsorted Unindexed)
                 alignmentEvidence)));
         println
           (kv_line "stdout_metadata"
             (show_bool
               (evidenceHasStdoutMetadata
                 (AlignmentInput Human PairedEnd GRCh38)
                 (Bam Human GRCh38 Unsorted Unindexed)
                 alignmentEvidence)))
  end;

def errorHasStderrMetadata (error : ExternalToolError) : Bool :=
  match externalToolErrorAttempt error with
  | Nothing => False
  | Just attempt =>
      ltb_nat Z (streamMetadataSize (executionAttemptStderr attempt))
  end;

def reportFailureResult
  (result :
    Either ExternalToolError
      (SuccessfulExecution
        (AlignmentInput Human PairedEnd GRCh38)
        (Bam Human GRCh38 Unsorted Unindexed))) : IO Unit :=
  match result with
  | Left error =>
      do println
           (kv_line "failed_process"
             (str_cat3 (externalToolErrorCode error) ":"
               (show_nat (externalToolErrorStatus error))));
         println
           (kv_line "failed_stderr_metadata"
             (show_bool (errorHasStderrMetadata error)))
  | Right _ =>
      do println "failed_process=unexpected_success";
         println "failed_stderr_metadata=false"
  end;

def reportMissingResult
  (result :
    Either ExternalToolError
      (SuccessfulExecution
        (AlignmentInput Human PairedEnd GRCh38)
        (Bam Human GRCh38 Unsorted Unindexed))) : IO Unit :=
  match result with
  | Left error =>
      println (kv_line "missing_output" (externalToolErrorCode error))
  | Right _ => println "missing_output=unexpected_success"
  end;

def runFailureRegressions
  (validated : Fastq Human PairedEnd ValidatedReads) : IO Unit :=
  let failedInvocation :
    ToolInvocation
      (AlignmentInput Human PairedEnd GRCh38)
      (Bam Human GRCh38 Unsorted Unindexed) :=
    prepareAlignment Human PairedEnd GRCh38
      failedAlignmentSpec validated grch38Reference in
  let missingInvocation :
    ToolInvocation
      (AlignmentInput Human PairedEnd GRCh38)
      (Bam Human GRCh38 Unsorted Unindexed) :=
    prepareAlignment Human PairedEnd GRCh38
      missingAlignmentSpec validated grch38Reference in
  do let! failedResult :=
       runExternalTool
         (AlignmentInput Human PairedEnd GRCh38)
         (Bam Human GRCh38 Unsorted Unindexed)
         failedInvocation;
     reportFailureResult failedResult;
     let! wroteStale := fs_write_checked missingAlignmentOutput "stale-output";
     match wroteStale with
     | Left error =>
         println (kv_line "stale_write" (fs_error_code error))
     | Right _ =>
         do let! missingResult :=
              runExternalTool
                (AlignmentInput Human PairedEnd GRCh38)
                (Bam Human GRCh38 Unsorted Unindexed)
                missingInvocation;
            reportMissingResult missingResult
     end

-- @entry main
def main : IO Unit :=
  do let! result := runHelaPipeline;
     match result with
     | Left error =>
         do println (kv_line "pipeline_error" (externalToolErrorMessage error));
            exit 1
     | Right outcome =>
         match outcome with
         | MkHelaOutcome validated _ _ _ =>
             do reportOutcome outcome;
                runFailureRegressions validated
         end
     end
