import "bio.ouro";

-- Validation evidence cannot be reused as alignment evidence.
def invalidEvidenceStage
  (execution :
    SuccessfulExecution
      (Fastq Human PairedEnd UncheckedReads)
      (Fastq Human PairedEnd ValidatedReads))
  : Bam Human GRCh38 Unsorted Unindexed :=
  alignReads Human PairedEnd GRCh38 execution;
