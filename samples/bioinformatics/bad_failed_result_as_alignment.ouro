import "bio.ouro";

-- A result that may contain failure is not successful alignment evidence.
def invalidFailurePromotion
  (result :
    Either ExternalToolError
      (SuccessfulExecution
        (AlignmentInput Human PairedEnd GRCh38)
        (Bam Human GRCh38 Unsorted Unindexed)))
  : Bam Human GRCh38 Unsorted Unindexed :=
  alignReads Human PairedEnd GRCh38 result;
