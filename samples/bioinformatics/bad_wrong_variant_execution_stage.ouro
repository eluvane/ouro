import "bio.ouro";

-- Variant-calling evidence cannot be reused as filtering evidence.
def invalidVariantEvidenceStage
  (execution :
    SuccessfulExecution
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants))
  : Vcf Human GRCh38 FilteredVariants :=
  filterVariants Human GRCh38 execution;
