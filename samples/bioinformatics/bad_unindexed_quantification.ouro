import "bio.ouro";

def sortedSource : Provenance :=
  SourceArtifact "unindexed GRCh38 BAM"
    (declaredSourceArtifactIdentity "fixture:unindexed-GRCh38");

def sortedBam : Bam Human GRCh38 CoordinateSorted Unindexed :=
  MkBam Human GRCh38 CoordinateSorted Unindexed
    "aligned.sorted.bam" sortedSource;

def annotationSource : Provenance :=
  SourceArtifact "GRCh38 annotation"
    (declaredSourceArtifactIdentity "fixture:annotation-GRCh38");

def annotation : GeneAnnotation Human GRCh38 :=
  MkGeneAnnotation Human GRCh38 "gencode.gtf" annotationSource;

-- Quantification preparation requires an indexed BAM state.
def invalidUnindexedQuantification
  (spec :
    ToolSpec
      (QuantificationInput Human GRCh38)
      (Expression Samples Genes RawCounts))
  : ToolInvocation
      (QuantificationInput Human GRCh38)
      (Expression Samples Genes RawCounts) :=
  prepareQuantification Human GRCh38 spec sortedBam annotation;
