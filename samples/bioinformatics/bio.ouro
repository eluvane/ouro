-- Indexed bioinformatics artifacts connected through typed execution evidence.

import "../scientific/external_tool.ouro";

inductive Organism : Type :=
  | Human : Organism
  | Mouse : Organism;

inductive GenomeBuild : Organism -> Type :=
  | GRCh37 : GenomeBuild Human
  | GRCh38 : GenomeBuild Human
  | GRCm39 : GenomeBuild Mouse;

inductive ReadLayout : Type :=
  | SingleEnd : ReadLayout
  | PairedEnd : ReadLayout;

inductive ReadFiles : ReadLayout -> Type :=
  | SingleRead : String -> ReadFiles SingleEnd
  | PairedReads : String -> String -> ReadFiles PairedEnd;

inductive ReadValidation : Type :=
  | UncheckedReads : ReadValidation
  | ValidatedReads : ReadValidation;

inductive SortState : Type :=
  | Unsorted : SortState
  | CoordinateSorted : SortState;

inductive IndexState : Type :=
  | Unindexed : IndexState
  | Indexed : IndexState;

inductive MatrixAxis : Type :=
  | Samples : MatrixAxis
  | Cells : MatrixAxis
  | Genes : MatrixAxis;

inductive ExpressionScale : Type :=
  | RawCounts : ExpressionScale
  | Normalized : ExpressionScale;

inductive VariantState : Type :=
  | RawVariants : VariantState
  | FilteredVariants : VariantState;

inductive BiologicalSample (organism : Organism) : Type :=
  | MkBiologicalSample : String -> String -> Provenance -> BiologicalSample organism;

inductive Fastq
  (organism : Organism)
  (layout : ReadLayout)
  (validation : ReadValidation) : Type :=
  | MkFastq :
      BiologicalSample organism ->
      ReadFiles layout ->
      Provenance ->
      Fastq organism layout validation;

inductive ReferenceGenome
  (organism : Organism)
  (build : GenomeBuild organism) : Type :=
  | MkReferenceGenome : String -> Provenance -> ReferenceGenome organism build;

inductive GeneAnnotation
  (organism : Organism)
  (build : GenomeBuild organism) : Type :=
  | MkGeneAnnotation : String -> Provenance -> GeneAnnotation organism build;

inductive Bam
  (organism : Organism)
  (build : GenomeBuild organism)
  (sorting : SortState)
  (indexing : IndexState) : Type :=
  | MkBam : String -> Provenance -> Bam organism build sorting indexing;

inductive Expression
  (rows : MatrixAxis)
  (columns : MatrixAxis)
  (scale : ExpressionScale) : Type :=
  | MkExpression : String -> Provenance -> Expression rows columns scale;

inductive Vcf
  (organism : Organism)
  (build : GenomeBuild organism)
  (state : VariantState) : Type :=
  | MkVcf : String -> Provenance -> Vcf organism build state;

inductive AlignmentInput
  (organism : Organism)
  (layout : ReadLayout)
  (build : GenomeBuild organism) : Type :=
  | MkAlignmentInput :
      Fastq organism layout ValidatedReads ->
      ReferenceGenome organism build ->
      AlignmentInput organism layout build;

inductive QuantificationInput
  (organism : Organism)
  (build : GenomeBuild organism) : Type :=
  | MkQuantificationInput :
      Bam organism build CoordinateSorted Indexed ->
      GeneAnnotation organism build ->
      QuantificationInput organism build;

inductive VariantCallingInput
  (organism : Organism)
  (build : GenomeBuild organism) : Type :=
  | MkVariantCallingInput :
      Bam organism build CoordinateSorted Indexed ->
      ReferenceGenome organism build ->
      VariantCallingInput organism build;

def fastqProvenance
  (organism : Organism)
  (layout : ReadLayout)
  (validation : ReadValidation)
  (reads : Fastq organism layout validation) : Provenance :=
  match reads with
  | MkFastq _ _ provenance => provenance
  end;

def referenceProvenance
  (organism : Organism)
  (build : GenomeBuild organism)
  (reference : ReferenceGenome organism build) : Provenance :=
  match reference with
  | MkReferenceGenome _ provenance => provenance
  end;

def annotationProvenance
  (organism : Organism)
  (build : GenomeBuild organism)
  (annotation : GeneAnnotation organism build) : Provenance :=
  match annotation with
  | MkGeneAnnotation _ provenance => provenance
  end;

def bamPath
  (organism : Organism)
  (build : GenomeBuild organism)
  (sorting : SortState)
  (indexing : IndexState)
  (bam : Bam organism build sorting indexing) : String :=
  match bam with
  | MkBam path _ => path
  end;

def bamProvenance
  (organism : Organism)
  (build : GenomeBuild organism)
  (sorting : SortState)
  (indexing : IndexState)
  (bam : Bam organism build sorting indexing) : Provenance :=
  match bam with
  | MkBam _ provenance => provenance
  end;

def expressionPath
  (rows : MatrixAxis)
  (columns : MatrixAxis)
  (scale : ExpressionScale)
  (matrix : Expression rows columns scale) : String :=
  match matrix with
  | MkExpression path _ => path
  end;

def expressionProvenance
  (rows : MatrixAxis)
  (columns : MatrixAxis)
  (scale : ExpressionScale)
  (matrix : Expression rows columns scale) : Provenance :=
  match matrix with
  | MkExpression _ provenance => provenance
  end;

def vcfPath
  (organism : Organism)
  (build : GenomeBuild organism)
  (state : VariantState)
  (vcf : Vcf organism build state) : String :=
  match vcf with
  | MkVcf path _ => path
  end;

def vcfProvenance
  (organism : Organism)
  (build : GenomeBuild organism)
  (state : VariantState)
  (vcf : Vcf organism build state) : Provenance :=
  match vcf with
  | MkVcf _ provenance => provenance
  end;

def prepareReadValidation
  (organism : Organism)
  (layout : ReadLayout)
  (spec :
    ToolSpec
      (Fastq organism layout UncheckedReads)
      (Fastq organism layout ValidatedReads))
  (reads : Fastq organism layout UncheckedReads)
  : ToolInvocation
      (Fastq organism layout UncheckedReads)
      (Fastq organism layout ValidatedReads) :=
  MkToolInvocation
    (Fastq organism layout UncheckedReads)
    (Fastq organism layout ValidatedReads)
    spec reads
    ([ provenanceArtifactIdentity
        (fastqProvenance organism layout UncheckedReads reads)
    ] : List ArtifactIdentity);

def validateReads
  (organism : Organism)
  (layout : ReadLayout)
  (execution :
    SuccessfulExecution
      (Fastq organism layout UncheckedReads)
      (Fastq organism layout ValidatedReads))
  : Fastq organism layout ValidatedReads :=
  match execution with
  | MkSuccessfulExecution reads evidence =>
      match reads with
      | MkFastq sample files provenance =>
          MkFastq organism layout ValidatedReads sample files
            (DerivedArtifact provenance
              (executionEvidenceRecord
                (Fastq organism layout UncheckedReads)
                (Fastq organism layout ValidatedReads)
                evidence))
      end
  end;

def prepareAlignment
  (organism : Organism)
  (layout : ReadLayout)
  (build : GenomeBuild organism)
  (spec :
    ToolSpec
      (AlignmentInput organism layout build)
      (Bam organism build Unsorted Unindexed))
  (reads : Fastq organism layout ValidatedReads)
  (reference : ReferenceGenome organism build)
  : ToolInvocation
      (AlignmentInput organism layout build)
      (Bam organism build Unsorted Unindexed) :=
  MkToolInvocation
    (AlignmentInput organism layout build)
    (Bam organism build Unsorted Unindexed)
    spec
    (MkAlignmentInput organism layout build reads reference)
    ([ provenanceArtifactIdentity
        (fastqProvenance organism layout ValidatedReads reads)
    , provenanceArtifactIdentity
        (referenceProvenance organism build reference)
    ] : List ArtifactIdentity);

def alignReads
  (organism : Organism)
  (layout : ReadLayout)
  (build : GenomeBuild organism)
  (execution :
    SuccessfulExecution
      (AlignmentInput organism layout build)
      (Bam organism build Unsorted Unindexed))
  : Bam organism build Unsorted Unindexed :=
  match execution with
  | MkSuccessfulExecution input evidence =>
      match input with
      | MkAlignmentInput reads reference =>
          MkBam organism build Unsorted Unindexed
            (executionEvidenceOutputPath
              (AlignmentInput organism layout build)
              (Bam organism build Unsorted Unindexed)
              evidence)
            (JoinedArtifact
              (fastqProvenance organism layout ValidatedReads reads)
              (referenceProvenance organism build reference)
              (executionEvidenceRecord
                (AlignmentInput organism layout build)
                (Bam organism build Unsorted Unindexed)
                evidence))
      end
  end;

def prepareSortBam
  (organism : Organism)
  (build : GenomeBuild organism)
  (spec :
    ToolSpec
      (Bam organism build Unsorted Unindexed)
      (Bam organism build CoordinateSorted Unindexed))
  (bam : Bam organism build Unsorted Unindexed)
  : ToolInvocation
      (Bam organism build Unsorted Unindexed)
      (Bam organism build CoordinateSorted Unindexed) :=
  MkToolInvocation
    (Bam organism build Unsorted Unindexed)
    (Bam organism build CoordinateSorted Unindexed)
    spec bam
    ([ provenanceArtifactIdentity
        (bamProvenance organism build Unsorted Unindexed bam)
    ] : List ArtifactIdentity);

def sortBam
  (organism : Organism)
  (build : GenomeBuild organism)
  (execution :
    SuccessfulExecution
      (Bam organism build Unsorted Unindexed)
      (Bam organism build CoordinateSorted Unindexed))
  : Bam organism build CoordinateSorted Unindexed :=
  match execution with
  | MkSuccessfulExecution bam evidence =>
      MkBam organism build CoordinateSorted Unindexed
        (executionEvidenceOutputPath
          (Bam organism build Unsorted Unindexed)
          (Bam organism build CoordinateSorted Unindexed)
          evidence)
        (DerivedArtifact
          (bamProvenance organism build Unsorted Unindexed bam)
          (executionEvidenceRecord
            (Bam organism build Unsorted Unindexed)
            (Bam organism build CoordinateSorted Unindexed)
            evidence))
  end;

def prepareIndexBam
  (organism : Organism)
  (build : GenomeBuild organism)
  (spec :
    ToolSpec
      (Bam organism build CoordinateSorted Unindexed)
      (Bam organism build CoordinateSorted Indexed))
  (bam : Bam organism build CoordinateSorted Unindexed)
  : ToolInvocation
      (Bam organism build CoordinateSorted Unindexed)
      (Bam organism build CoordinateSorted Indexed) :=
  MkToolInvocation
    (Bam organism build CoordinateSorted Unindexed)
    (Bam organism build CoordinateSorted Indexed)
    spec bam
    ([ provenanceArtifactIdentity
        (bamProvenance organism build CoordinateSorted Unindexed bam)
    ] : List ArtifactIdentity);

def indexBam
  (organism : Organism)
  (build : GenomeBuild organism)
  (execution :
    SuccessfulExecution
      (Bam organism build CoordinateSorted Unindexed)
      (Bam organism build CoordinateSorted Indexed))
  : Bam organism build CoordinateSorted Indexed :=
  match execution with
  | MkSuccessfulExecution bam evidence =>
      MkBam organism build CoordinateSorted Indexed
        (bamPath organism build CoordinateSorted Unindexed bam)
        (DerivedArtifact
          (bamProvenance organism build CoordinateSorted Unindexed bam)
          (executionEvidenceRecord
            (Bam organism build CoordinateSorted Unindexed)
            (Bam organism build CoordinateSorted Indexed)
            evidence))
  end;

def prepareQuantification
  (organism : Organism)
  (build : GenomeBuild organism)
  (spec :
    ToolSpec
      (QuantificationInput organism build)
      (Expression Samples Genes RawCounts))
  (bam : Bam organism build CoordinateSorted Indexed)
  (annotation : GeneAnnotation organism build)
  : ToolInvocation
      (QuantificationInput organism build)
      (Expression Samples Genes RawCounts) :=
  MkToolInvocation
    (QuantificationInput organism build)
    (Expression Samples Genes RawCounts)
    spec
    (MkQuantificationInput organism build bam annotation)
    ([ provenanceArtifactIdentity
        (bamProvenance organism build CoordinateSorted Indexed bam)
    , provenanceArtifactIdentity
        (annotationProvenance organism build annotation)
    ] : List ArtifactIdentity);

def quantifyGenes
  (organism : Organism)
  (build : GenomeBuild organism)
  (execution :
    SuccessfulExecution
      (QuantificationInput organism build)
      (Expression Samples Genes RawCounts))
  : Expression Samples Genes RawCounts :=
  match execution with
  | MkSuccessfulExecution input evidence =>
      match input with
      | MkQuantificationInput bam annotation =>
          MkExpression Samples Genes RawCounts
            (executionEvidenceOutputPath
              (QuantificationInput organism build)
              (Expression Samples Genes RawCounts)
              evidence)
            (JoinedArtifact
              (bamProvenance organism build CoordinateSorted Indexed bam)
              (annotationProvenance organism build annotation)
              (executionEvidenceRecord
                (QuantificationInput organism build)
                (Expression Samples Genes RawCounts)
                evidence))
      end
  end;

def prepareNormalization
  (rows : MatrixAxis)
  (columns : MatrixAxis)
  (spec :
    ToolSpec
      (Expression rows columns RawCounts)
      (Expression rows columns Normalized))
  (matrix : Expression rows columns RawCounts)
  : ToolInvocation
      (Expression rows columns RawCounts)
      (Expression rows columns Normalized) :=
  MkToolInvocation
    (Expression rows columns RawCounts)
    (Expression rows columns Normalized)
    spec matrix
    ([ provenanceArtifactIdentity
        (expressionProvenance rows columns RawCounts matrix)
    ] : List ArtifactIdentity);

def normalizeCounts
  (rows : MatrixAxis)
  (columns : MatrixAxis)
  (execution :
    SuccessfulExecution
      (Expression rows columns RawCounts)
      (Expression rows columns Normalized))
  : Expression rows columns Normalized :=
  match execution with
  | MkSuccessfulExecution matrix evidence =>
      MkExpression rows columns Normalized
        (executionEvidenceOutputPath
          (Expression rows columns RawCounts)
          (Expression rows columns Normalized)
          evidence)
        (DerivedArtifact
          (expressionProvenance rows columns RawCounts matrix)
          (executionEvidenceRecord
            (Expression rows columns RawCounts)
            (Expression rows columns Normalized)
            evidence))
  end;

def prepareVariantCalling
  (organism : Organism)
  (build : GenomeBuild organism)
  (spec :
    ToolSpec
      (VariantCallingInput organism build)
      (Vcf organism build RawVariants))
  (bam : Bam organism build CoordinateSorted Indexed)
  (reference : ReferenceGenome organism build)
  : ToolInvocation
      (VariantCallingInput organism build)
      (Vcf organism build RawVariants) :=
  MkToolInvocation
    (VariantCallingInput organism build)
    (Vcf organism build RawVariants)
    spec
    (MkVariantCallingInput organism build bam reference)
    ([ provenanceArtifactIdentity
        (bamProvenance organism build CoordinateSorted Indexed bam)
    , provenanceArtifactIdentity
        (referenceProvenance organism build reference)
    ] : List ArtifactIdentity);

def callVariants
  (organism : Organism)
  (build : GenomeBuild organism)
  (execution :
    SuccessfulExecution
      (VariantCallingInput organism build)
      (Vcf organism build RawVariants))
  : Vcf organism build RawVariants :=
  match execution with
  | MkSuccessfulExecution input evidence =>
      match input with
      | MkVariantCallingInput bam reference =>
          MkVcf organism build RawVariants
            (executionEvidenceOutputPath
              (VariantCallingInput organism build)
              (Vcf organism build RawVariants)
              evidence)
            (JoinedArtifact
              (bamProvenance organism build CoordinateSorted Indexed bam)
              (referenceProvenance organism build reference)
              (executionEvidenceRecord
                (VariantCallingInput organism build)
                (Vcf organism build RawVariants)
                evidence))
      end
  end;

def prepareVariantFiltering
  (organism : Organism)
  (build : GenomeBuild organism)
  (spec :
    ToolSpec
      (Vcf organism build RawVariants)
      (Vcf organism build FilteredVariants))
  (vcf : Vcf organism build RawVariants)
  : ToolInvocation
      (Vcf organism build RawVariants)
      (Vcf organism build FilteredVariants) :=
  MkToolInvocation
    (Vcf organism build RawVariants)
    (Vcf organism build FilteredVariants)
    spec vcf
    ([ provenanceArtifactIdentity
        (vcfProvenance organism build RawVariants vcf)
    ] : List ArtifactIdentity);

def filterVariants
  (organism : Organism)
  (build : GenomeBuild organism)
  (execution :
    SuccessfulExecution
      (Vcf organism build RawVariants)
      (Vcf organism build FilteredVariants))
  : Vcf organism build FilteredVariants :=
  match execution with
  | MkSuccessfulExecution vcf evidence =>
      MkVcf organism build FilteredVariants
        (executionEvidenceOutputPath
          (Vcf organism build RawVariants)
          (Vcf organism build FilteredVariants)
          evidence)
        (DerivedArtifact
          (vcfProvenance organism build RawVariants vcf)
          (executionEvidenceRecord
            (Vcf organism build RawVariants)
            (Vcf organism build FilteredVariants)
            evidence))
  end;
