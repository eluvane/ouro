import "bio.ouro";

def sampleSource : Provenance :=
  SourceArtifact "unchecked sample"
    (declaredSourceArtifactIdentity "fixture:sample");

def sample : BiologicalSample Human :=
  MkBiologicalSample Human "sample" "RNA" sampleSource;

def uncheckedSource : Provenance :=
  SourceArtifact "unchecked reads"
    (declaredSourceArtifactIdentity "fixture:unchecked-reads");

def unchecked : Fastq Human PairedEnd UncheckedReads :=
  MkFastq Human PairedEnd UncheckedReads sample
    (PairedReads "r1.fastq" "r2.fastq") uncheckedSource;

def referenceSource : Provenance :=
  SourceArtifact "GRCh38 reference"
    (declaredSourceArtifactIdentity "fixture:reference-GRCh38");

def reference : ReferenceGenome Human GRCh38 :=
  MkReferenceGenome Human GRCh38 "GRCh38.fa" referenceSource;

-- Alignment preparation accepts validated reads only.
def invalidUncheckedAlignment
  (spec :
    ToolSpec
      (AlignmentInput Human PairedEnd GRCh38)
      (Bam Human GRCh38 Unsorted Unindexed))
  : ToolInvocation
      (AlignmentInput Human PairedEnd GRCh38)
      (Bam Human GRCh38 Unsorted Unindexed) :=
  prepareAlignment Human PairedEnd GRCh38 spec unchecked reference;
