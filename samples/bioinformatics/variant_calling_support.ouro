-- Independent GRCh38 variant-calling slice over the generic execution layer.

import "bio.ouro";

def hg001BamSource : Provenance :=
  SourceArtifact "HG001 coordinate-sorted indexed alignment"
    (declaredSourceArtifactIdentity "fixture:HG001:GRCh38:indexed-bam");

def hg001Bam : Bam Human GRCh38 CoordinateSorted Indexed :=
  MkBam Human GRCh38 CoordinateSorted Indexed
    "data/HG001.GRCh38.sorted.bam" hg001BamSource;

def hg001ReferenceSource : Provenance :=
  SourceArtifact "GRCh38 variant-calling reference"
    (declaredSourceArtifactIdentity "reference:GRCh38:variant-calling");

def hg001Reference : ReferenceGenome Human GRCh38 :=
  MkReferenceGenome Human GRCh38
    "references/GRCh38.primary_assembly.fa" hg001ReferenceSource;

def rawVcfOutput : String :=
  "_build/bioinformatics/HG001.raw.vcf";

def filteredVcfOutput : String :=
  "_build/bioinformatics/HG001.filtered.vcf";

def fixtureVariantCallSpec :
  ToolSpec
    (VariantCallingInput Human GRCh38)
    (Vcf Human GRCh38 RawVariants) :=
  MkToolSpec
    (VariantCallingInput Human GRCh38)
    (Vcf Human GRCh38 RawVariants)
    (MkToolIdentity "fixture-variant-caller" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "variant-call"
    , rawVcfOutput
    , "data/HG001.GRCh38.sorted.bam"
    , "references/GRCh38.primary_assembly.fa"
    ] : List String)
    ([ MkReproducibilityParameter "reference" "GRCh38"
    , MkReproducibilityParameter "min-base-quality" "20"
    , MkReproducibilityParameter "caller-model" "fixture-v1"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput "vcf:GRCh38:raw" rawVcfOutput);

def fixtureVariantCallChangedParameterSpec :
  ToolSpec
    (VariantCallingInput Human GRCh38)
    (Vcf Human GRCh38 RawVariants) :=
  MkToolSpec
    (VariantCallingInput Human GRCh38)
    (Vcf Human GRCh38 RawVariants)
    (MkToolIdentity "fixture-variant-caller" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "variant-call"
    , rawVcfOutput
    , "data/HG001.GRCh38.sorted.bam"
    , "references/GRCh38.primary_assembly.fa"
    ] : List String)
    ([ MkReproducibilityParameter "reference" "GRCh38"
    , MkReproducibilityParameter "min-base-quality" "21"
    , MkReproducibilityParameter "caller-model" "fixture-v1"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput "vcf:GRCh38:raw" rawVcfOutput);

def fixtureVariantCallChangedContractSpec :
  ToolSpec
    (VariantCallingInput Human GRCh38)
    (Vcf Human GRCh38 RawVariants) :=
  MkToolSpec
    (VariantCallingInput Human GRCh38)
    (Vcf Human GRCh38 RawVariants)
    (MkToolIdentity "fixture-variant-caller" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "variant-call"
    , rawVcfOutput
    , "data/HG001.GRCh38.sorted.bam"
    , "references/GRCh38.primary_assembly.fa"
    ] : List String)
    ([ MkReproducibilityParameter "reference" "GRCh38"
    , MkReproducibilityParameter "min-base-quality" "20"
    , MkReproducibilityParameter "caller-model" "fixture-v1"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput "vcf:GRCh38:raw:alternate-contract" rawVcfOutput);

def fixtureVariantFilterSpec :
  ToolSpec
    (Vcf Human GRCh38 RawVariants)
    (Vcf Human GRCh38 FilteredVariants) :=
  MkToolSpec
    (Vcf Human GRCh38 RawVariants)
    (Vcf Human GRCh38 FilteredVariants)
    (MkToolIdentity "fixture-variant-filter" "sh" "1.0.0")
    ([ "samples/bioinformatics/fixture_tool.sh"
    , "variant-filter"
    , filteredVcfOutput
    , rawVcfOutput
    ] : List String)
    ([ MkReproducibilityParameter "minimum-quality" "30"
    , MkReproducibilityParameter "filter-name" "PASS"
    ] : List ReproducibilityParameter)
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    DeterministicTool
    (ExpectedFileOutput "vcf:GRCh38:filtered" filteredVcfOutput);

def variantCallInputIdentities : List ArtifactIdentity :=
  ([ provenanceArtifactIdentity
      (bamProvenance Human GRCh38 CoordinateSorted Indexed hg001Bam)
  , provenanceArtifactIdentity
      (referenceProvenance Human GRCh38 hg001Reference)
  ] : List ArtifactIdentity);

def alternateVariantCallInputIdentities : List ArtifactIdentity :=
  ([ declaredSourceArtifactIdentity "fixture:HG001:GRCh38:alternate-bam"
  , provenanceArtifactIdentity
      (referenceProvenance Human GRCh38 hg001Reference)
  ] : List ArtifactIdentity);

def sameArtifactIdentity
  (left : ArtifactIdentity)
  (right : ArtifactIdentity) : Bool :=
  str_eq (artifactIdentityCanonical left) (artifactIdentityCanonical right);

def exactTwoInputIdentities
  (actual : List ArtifactIdentity)
  (expectedFirst : ArtifactIdentity)
  (expectedSecond : ArtifactIdentity) : Bool :=
  match actual with
  | Nil => False
  | Cons first rest =>
      match rest with
      | Nil => False
      | Cons second tail =>
          match tail with
          | Nil =>
              match sameArtifactIdentity first expectedFirst with
              | True => sameArtifactIdentity second expectedSecond
              | False => False
              end
          | Cons _ _ => False
          end
      end
  end;

def sameTransformationIdentity
  (left : TransformationIdentity)
  (right : TransformationIdentity) : Bool :=
  str_eq
    (transformationIdentityValue left)
    (transformationIdentityValue right);

def transformationIdentityStable : Bool :=
  sameTransformationIdentity
    (invocationTransformationIdentity
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants)
      fixtureVariantCallSpec variantCallInputIdentities)
    (invocationTransformationIdentity
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants)
      fixtureVariantCallSpec variantCallInputIdentities);

def parameterChangesTransformationIdentity : Bool :=
  notb
    (sameTransformationIdentity
      (invocationTransformationIdentity
        (VariantCallingInput Human GRCh38)
        (Vcf Human GRCh38 RawVariants)
        fixtureVariantCallSpec variantCallInputIdentities)
      (invocationTransformationIdentity
        (VariantCallingInput Human GRCh38)
        (Vcf Human GRCh38 RawVariants)
        fixtureVariantCallChangedParameterSpec variantCallInputIdentities));

def inputChangesTransformationIdentity : Bool :=
  notb
    (sameTransformationIdentity
      (invocationTransformationIdentity
        (VariantCallingInput Human GRCh38)
        (Vcf Human GRCh38 RawVariants)
        fixtureVariantCallSpec variantCallInputIdentities)
      (invocationTransformationIdentity
        (VariantCallingInput Human GRCh38)
        (Vcf Human GRCh38 RawVariants)
        fixtureVariantCallSpec alternateVariantCallInputIdentities));

def outputContractChangesTransformationIdentity : Bool :=
  notb
    (sameTransformationIdentity
      (invocationTransformationIdentity
        (VariantCallingInput Human GRCh38)
        (Vcf Human GRCh38 RawVariants)
        fixtureVariantCallSpec variantCallInputIdentities)
      (invocationTransformationIdentity
        (VariantCallingInput Human GRCh38)
        (Vcf Human GRCh38 RawVariants)
        fixtureVariantCallChangedContractSpec variantCallInputIdentities));

def nondeterministicMetadataIsIncomplete : Bool :=
  let identity : TransformationIdentity :=
    invocationTransformationIdentity
      (VariantCallingInput Human GRCh38)
      (Vcf Human GRCh38 RawVariants)
      fixtureVariantCallSpec variantCallInputIdentities in
  match reproducibilityFor
    (PinnedEnvironment "repo-fixture:v2;executor=posix-sh")
    (NondeterministicTool "seed is not fixed")
    identity with
  | ReproducibilityMetadataComplete _ => False
  | IncompleteReproducibility _ => True
  end;
