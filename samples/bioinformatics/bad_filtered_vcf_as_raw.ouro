import "bio.ouro";

def filteredSource : Provenance :=
  SourceArtifact "already filtered GRCh38 VCF"
    (declaredSourceArtifactIdentity "fixture:filtered-vcf-GRCh38");

def filteredVcf : Vcf Human GRCh38 FilteredVariants :=
  MkVcf Human GRCh38 FilteredVariants "filtered.vcf" filteredSource;

-- Filtering consumes RawVariants, not a VCF already in FilteredVariants state.
def invalidSecondVariantFilter
  (spec :
    ToolSpec
      (Vcf Human GRCh38 RawVariants)
      (Vcf Human GRCh38 FilteredVariants))
  : ToolInvocation
      (Vcf Human GRCh38 RawVariants)
      (Vcf Human GRCh38 FilteredVariants) :=
  prepareVariantFiltering Human GRCh38 spec filteredVcf;
