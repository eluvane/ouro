-- HTTP POST via the checked request primitive. Gate uses a local mock server
-- and a golden body.

import "../../std/http.ouro";

-- @entry main
def print_line (s : String) : IO Unit := prim_stdout_write (prim_string_concat s "\n");

def headers : List (Pair String String) :=
  [MkPair String String "Content-Type" "application/json"];

def main : IO Unit :=
  io_bind (Pair(Nat, Pair String String)) Unit
    (prim_http_request "http://127.0.0.1:8765/echo" headers "{\"ping\":true}")
    (fun (reply : Pair Nat (Pair String String)) =>
      match reply with | MkPair _status rest => match rest with | MkPair body _reason =>
        io_bind Unit Unit (body |> print_line)
          (fun (_ : Unit) => prim_exit 0) end end)
