-- HTTP POST via prim_http_post (M8). Gate uses local mock server + golden body.

import "../../std/runtime.ouro";

-- @entry main
def print_line (s : String) : IO Unit := prim_stdout_write (prim_string_concat s "\n");

def headers : List (Pair String String) :=
  [MkPair String String "Content-Type" "application/json"];

def main : IO Unit :=
  io_bind String Unit
    (prim_http_post "http://127.0.0.1:8765/echo" headers "{\"ping\":true}")
    (fun (body : String) =>
      io_bind Unit Unit (body |> print_line)
        (fun (_ : Unit) => prim_exit 0))
