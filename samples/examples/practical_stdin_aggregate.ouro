-- stdin + parsing + aggregation + exit code.

import "../../std/collections.ouro";
import "../../std/format.ouro";
import "../../std/io.ouro";
import "../../std/num.ouro";
import "../../std/text.ouro";

def input_numbers (text : String) : List Nat :=
    filter_map String Nat str_parse_nat (str_lines text);

def aggregate_report (xs : List Nat) : String :=
    str_unlines
      ([ kv_line "count" (show_nat (length Nat xs))
      , kv_line "sum" (show_nat (nat_sum xs))
      , kv_line "min" (show_nat (nat_min_list 0 xs))
      , kv_line "max" (show_nat (nat_max_list 0 xs))
      , kv_line "mean_floor" (show_nat (nat_mean_floor xs))
      ] : List String);

-- @entry main
def main : IO Unit :=
    do let! text := read_all;
       println (aggregate_report (input_numbers text));
       exit 0
