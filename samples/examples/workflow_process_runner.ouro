-- Command spec -> checked process run -> stdout/exit report.

import "../../std/process.ouro",
  "../../std/processx.ouro",
  "../../std/report.ouro",
  "../../std/text.ouro";

def workflow_command : CommandSpec :=
    command_spec("echo", ["ouro"] : List String);

-- @entry main
def main : IO Unit :=
    do let! out := process_stdout_checked workflow_command;
       match out with
       | Left e =>
         do eprintln (process_error_message e);
            exit 1
       | Right stdout =>
         do println
              (report_render
                (report_add "stdout" (str_chomp stdout)
                  (report_add "cmd" (command_render workflow_command) report_empty)));
            exit 0
       end
