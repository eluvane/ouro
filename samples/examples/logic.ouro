-- Logic as inductives; proofs are ordinary terms.

-- @entry and_sym or_sym
inductive And (P : Type) (Q : Type) : Type :=
  | Conj : P -> Q -> And P Q;

inductive Or (P : Type) (Q : Type) : Type :=
  | Inl : P -> Or P Q
  | Inr : Q -> Or P Q;

def and_sym (P : Type) (Q : Type) (h : And P Q) : And Q P :=
    match h with
    | Conj p q => Conj Q P q p
    end;

def or_sym (P : Type) (Q : Type) (h : Or P Q) : Or Q P :=
    match h with
    | Inl p => Inr Q P p
    | Inr q => Inl Q P q
    end;
