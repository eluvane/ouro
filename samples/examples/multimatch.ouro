-- @entry t1 t2 r1 r2 a1 a2
inductive Nat : Type := | Z : Nat | S : Nat -> Nat;
inductive Bool : Type := | True : Bool | False : Bool;

-- Structural equality (2-scrutinee multi-match).
def eqNat : Nat -> Nat -> Bool :=
  fix eqNat (n : Nat) (m : Nat) : Bool :=
    match n, m with
    | Z, Z => True
    | Z, S _ => False
    | S _, Z => False
    | S n', S m' => eqNat n' m'
    end;

-- 3-scrutinee OR; whole-row wildcards unsupported (pattern must start with a ctor).
def or3 (a : Bool) (b : Bool) (c : Bool) : Bool :=
    match a, b, c with
    | True, True, True => True
    | True, True, False => True
    | True, False, True => True
    | True, False, False => True
    | False, True, True => True
    | False, True, False => True
    | False, False, True => True
    | False, False, False => False
    end;

def and2 (a : Bool) (b : Bool) : Bool :=
    match a, b with
    | True, True => True
    | True, False => False
    | False, True => False
    | False, False => False
    end;

def t1 : Bool := eqNat(S (S Z), S (S Z));
def t2 : Bool := eqNat(S Z, S (S Z));
def r1 : Bool := or3 True False True;
def r2 : Bool := or3 False False False;
def a1 : Bool := and2 True True;
def a2 : Bool := and2 True False;
