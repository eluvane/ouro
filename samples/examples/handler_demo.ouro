-- Handler monadic desugar smoke (native check path).
-- pure clause required; ops resume once via k (not multi-shot AE).

-- @entry run_write run_pure_only Console
inductive Nat : Type := | Z : Nat | S : Nat -> Nat;
inductive Unit : Type := | tt : Unit;

effect Console where
  | write : Nat -> Nat
  | read : Unit -> Nat

def run_write : Nat :=
  handle perform write(S Z) with
  | write (n) k => k n
  | pure x => x
  end;

def run_pure_only : Nat :=
  handle 2 with
  | pure x => x
  end;
