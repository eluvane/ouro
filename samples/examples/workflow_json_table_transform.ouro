-- JSON/table transform acceptance: typed JSON getters plus header-aware rows.

import "../../std/jsonx.ouro";
import "../../std/report.ouro";
import "../../std/tablex.ouro";

def workflow_json_input : Json :=
    jsonx_parse_or_null "{\"source\":\"events\",\"limit\":2,\"enabled\":true}";

def workflow_table_input : List (List String) :=
    table_from_csv "name,status,count\nalpha,ok,2\nbeta,skip,5\n";

def workflow_json_table_report : Report :=
    report_add "projection" "name,count"
      (report_add_nat "active_rows" (tablex_count_where workflow_table_input "status" "ok")
        (report_add_bool "enabled" (fromMaybe Bool False (jsonx_get_bool workflow_json_input "enabled"))
          (report_add_nat "limit" (fromMaybe Nat 0 (jsonx_get_nat workflow_json_input "limit"))
            (report_add "source" (fromMaybe String "" (jsonx_get_string workflow_json_input "source"))
              report_empty))));

-- @entry main
def main : IO Unit :=
    do println (report_render workflow_json_table_report);
       exit 0
