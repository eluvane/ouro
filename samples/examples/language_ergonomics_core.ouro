-- Language ergonomics source sample.
-- Active through scripts/ouro1.sh check and the regenerated split
-- frontend seed (direct _build/c/ouro1).

import "../../std/io.ouro";

-- The pipe, list-literal and ascription cases are roots of their own: main
-- below demonstrates do-notation, not these.
-- @entry two nums numsLen
def two : Nat := Z |> S |> S;

-- The declaration annotation supplies the expected List element type.
def nums : List Nat := [Z, S Z, two];

def numsLen : Nat := ((nums |> length Nat) : Nat);

-- @entry main
def main : IO Unit :=
  do let! line := readLine;
     println (concat "echo: " line)
