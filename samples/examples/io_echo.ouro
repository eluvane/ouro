-- IO (M7): stdin lines -> stdout via do let! sequencing.

import "../../std/runtime.ouro";

-- @entry main
def main : IO Unit :=
  do let! l1 := prim_stdin_read_line;
      let! l2 := prim_stdin_read_line;
      prim_stdout_write
        (prim_string_concat "line=" (prim_string_concat l1 "\n"));
      prim_stdout_write
        (prim_string_concat "line2=" (prim_string_concat l2 "\n"));
      prim_exit 0
