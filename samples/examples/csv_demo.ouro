-- Tiny CSV parse/print/get: header + two rows, one quoted comma field.
import "../../std/csv.ouro";
import "../../std/io.ouro";
import "../../std/string_prims.ouro";

-- @entry main
def raw : String :=
  "name,city,note\nAlice,Paris,\"hello, world\"\nBob,London,ok";

def table : List (List String) := csv_parse raw;

def main : IO Unit :=
  do println (csv_print table);
      println (concat "get=" (csv_get table 1 2));
      println (concat "nrows=" (prim_string_of_nat (csv_nrows table)));
      exit 0
