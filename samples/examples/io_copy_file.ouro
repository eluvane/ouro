import "../../std/fs.ouro",
  "../../std/format.ouro",
  "../../std/pathx.ouro";

def copy_dir : String := "_build/ouro_samples/io_copy";
def copy_src : String := path_join ([copy_dir, "source.txt"] : List String);
def copy_dst : String := path_join ([copy_dir, "dest.txt"] : List String);

def report_unit_result (name : String) (r : Either FsError Unit) : IO Unit :=
    match r with
    | Left e => println (kv_line(name, fs_error_code e))
    | Right _ => println (kv_line name "ok")
    end;

-- @entry main
def main : IO Unit :=
    do let! made := fs_mkdir_p_checked copy_dir;
       report_unit_result "mkdir" made;
       let! wrote := fs_write_checked copy_src "copy me\n";
       report_unit_result "write" wrote;
       let! copied := fs_copy_checked copy_src copy_dst;
       report_unit_result "copy" copied;
       let! read_back := fs_read_checked copy_dst;
       match read_back with
       | Left e => println (kv_line("read", fs_error_code e))
       | Right text => println (kv_line("read", str_trim text))
       end;
       exit 0
