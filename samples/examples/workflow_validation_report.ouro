-- Accumulated validation report: show all user-facing errors together.

import "../../std/report.ouro",
  "../../std/validation.ouro";

def workflow_validation_errors : Validation String Unit :=
    validation_collect_unit String
      ([ validation_require String "missing --input" False
      , validation_map String String Unit (fun (_ : String) => MkUnit)
      (validation_require_nonempty "empty --name" "")
      , validation_require String "ok" True
      ] : List (Validation String Unit));

def workflow_validation_report : String :=
    match workflow_validation_errors with
    | Left errors =>
      report_render
        (report_add "messages" (str_join "|" errors)
          (report_add_nat "errors" (length String errors) report_empty))
    | Right _ =>
      report_render (report_add "status" "ok" report_empty)
    end;

-- @entry main
def main : IO Unit :=
    do println workflow_validation_report;
       exit 0
