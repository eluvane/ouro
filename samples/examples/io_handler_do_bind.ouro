-- The pure clause returns the IO action unchanged.
-- The let! inside the action still lowers to io_bind.

import "../../std/runtime.ouro";

-- @entry main
def main : IO Unit :=
  handle
    do let! line := prim_stdin_read_line;
        prim_stdout_write (prim_string_concat("handler=", prim_string_concat line "\n"));
        prim_exit 0
  with
  | pure r => r
  end
