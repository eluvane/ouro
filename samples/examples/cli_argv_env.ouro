import "../../std/format.ouro",
  "../../std/process.ouro";

-- @entry main
def main : IO Unit :=
    do let! parsed := process_args;
       println (kv_line("positionals", show_nat (length(String, args_positional parsed))));
       let! envv := process_env_or "OURO_SAMPLE_ENV_UNSET" "missing";
       println (kv_line "env" envv);
       exit 0
