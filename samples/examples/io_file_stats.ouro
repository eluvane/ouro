import "../../std/fs.ouro";
import "../../std/format.ouro";

def stats_path : String := "samples/examples/io_stats_input.txt";

-- @entry main
def main : IO Unit :=
    do let! r := fs_read_checked stats_path;
       match r with
       | Left e =>
           do eprintln (fs_error_message e);
              exit 1
       | Right text =>
           do println (kv_line "bytes" (show_nat (str_len text)));
              println (kv_line "lines" (show_nat (count_lines text)));
              println (kv_line "contains_ouro" (show_bool (str_contains text "Ouro")));
              exit 0
       end
