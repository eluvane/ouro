-- Fibonacci on Nat (self-contained).

-- @entry fib
inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

def add : Nat -> Nat -> Nat :=
  fix add (n : Nat) (m : Nat) : Nat :=
    match n with
    | Z => m
    | S n' => S (add n' m)
    end;

def fib : Nat -> Nat :=
  fix fib (n : Nat) : Nat :=
    match n with
    | Z => Z
    | S n' => S (add(n', fib n'))
    end;
