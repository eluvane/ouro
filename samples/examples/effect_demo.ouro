-- Algebraic effects + monadic handle.

-- @entry main
inductive Nat : Type := | Z : Nat | S : Nat -> Nat;

effect Console where
  | read : Nat -> Nat
  | write : Nat -> Nat

-- Ops rebound locally; pure returns the result.
def main : Nat :=
  handle
    perform write (perform read (S Z))
  with
  | write (n) k => k n
  | read (_) k => k (S Z)
  | pure x => x
  end;
