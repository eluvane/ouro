-- List reverse (self-contained). Each definition is its own root.
-- @entry Nat List add append reverse

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def add : Nat -> Nat -> Nat :=
  fix add (n : Nat) (m : Nat) : Nat :=
    match n with
    | Z => m
    | S n' => S (add n' m)
    end;

def append (A : Type) : List A -> List A -> List A :=
    fix append (xs : List A) : List A -> List A :=
      match xs with
      | Nil => fun (ys : List A) => ys
      | Cons x xs' => fun (ys : List A) => Cons A x (append xs' ys)
      end;

def reverse (A : Type) : List A -> List A :=
    fix reverse (xs : List A) : List A :=
      match xs with
      | Nil => Nil A
      | Cons x xs' => append A (reverse xs') ([x])
      end;
