import "../../std/format.ouro";
import "../../std/io.ouro";
import "../../std/string.ouro";

def words_input (s : String) : String :=
    str_replace s "\n" " ";

def word_count (s : String) : Nat :=
    length String (str_words (words_input s));

-- @entry main
def main : IO Unit :=
    do let! input := read_all;
       println (kv_line "bytes" (show_nat (str_len input)));
       println (kv_line "lines" (show_nat (count_lines input)));
       println (kv_line "words" (show_nat (word_count input)));
       exit 0
