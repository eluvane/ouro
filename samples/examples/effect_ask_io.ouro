-- Handler + do let! + IO: perform AskName, resume, write, exit.

import "../../std/runtime.ouro";

-- @entry main
effect AskName : String

def main : IO Unit :=
  handle
    do let! name := perform AskName;
        prim_stdout_write (prim_string_concat "hello " name);
        prim_exit 0
  with
  | AskName k => k "Ouro"
  | pure r => r
  end
