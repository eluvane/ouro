-- CLI args + checked file read + text transform + stdout.

import "../../std/args.ouro";
import "../../std/cli.ouro";
import "../../std/fs.ouro";
import "../../std/io.ouro";
import "../../std/text.ouro";

def transform_text (a : Args) (text : String) : String :=
    match cli_flag a "upper" with
    | True => str_upper text
    | False => text
    end;

-- @entry main
def main : IO Unit :=
    do let! av := argv;
       let parsed : Args := cli_from_argv (["upper"] : List String) av in
       match cli_required_pos parsed 0 "input-file" with
       | Left e =>
           do eprintln (cli_error_block "practical_cli_file" "[--upper] <input-file>" e);
              exit 2
       | Right path =>
           do let! r := fs_read_checked path;
              match r with
              | Left fs_e =>
                  do eprintln (fs_error_message fs_e);
                     exit 1
              | Right text =>
                  do print (transform_text parsed text);
                     exit 0
              end
       end
