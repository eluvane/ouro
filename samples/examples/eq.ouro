-- Equality test via Bool.

-- @entry is_zero is_five
inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Bool : Type :=
  | True : Bool
  | False : Bool;

def is_zero (n : Nat) : Bool :=
    match n with
    | Z => True
    | S _ => False
    end;

def is_five (n : Nat) : Bool :=
    match n with
    | Z => False
    | S m => is_zero m
    end;
