-- Import prelude (relative path).
import "../../std/prelude.ouro";

-- @entry twelve total
def six : Nat := add 2 4;

def twelve : Nat := mul 2 six;

def seed : List Nat := [Z, S Z];

def doubled : List Nat :=
  seed |> map Nat Nat (fun (n : Nat) => add n n);

def total : Nat := doubled |> foldr Nat Nat add Z;
