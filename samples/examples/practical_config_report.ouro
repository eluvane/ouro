-- config file + typed getters + report output.

import "../../std/args.ouro";
import "../../std/cli.ouro";
import "../../std/config.ouro";
import "../../std/format.ouro";
import "../../std/fsx.ouro";
import "../../std/io.ouro";


def render_config_report (cfg : Config) : String :=
    str_unlines
      ([ kv_line "name" (config_get_or cfg "name" "unknown")
      , kv_line "limit" (show_nat (config_get_nat_or cfg "limit" 0))
      , kv_line "enabled" (show_bool (config_get_bool_or cfg "enabled" False))
      ] : List String);

-- @entry main
def main : IO Unit :=
    do let! av := argv;
       let parsed : Args := cli_from_argv (Nil String) av in
       match cli_required_pos parsed 0 "config-file" with
       | Left e =>
           do eprintln (cli_error_block "practical_config_report" "<config-file>" e);
              exit 2
       | Right path =>
           do let! r := fsx_read_config path;
              match r with
              | Left fs_e =>
                  do eprintln (fs_error_message fs_e);
                     exit 1
              | Right cfg =>
                  do println (render_config_report cfg);
                     exit 0
              end
       end
