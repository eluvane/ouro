import "../../std/format.ouro",
  "../../std/io.ouro",
  "../../std/stringx.ouro";

def grep_keep (line : String) : Bool := str_contains line "ouro";

-- @entry main
def main : IO Unit :=
    do let! input := read_all;
       println (str_unlines (filter String grep_keep (str_lines input)));
       exit 0
