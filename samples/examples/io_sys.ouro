-- IO runtime: argv/env/fs/proc/time via do let! sequencing.
-- Gate sets OURO_IO_GATE=gate42, args "a b", prepares _build/m7/lsdir/only.txt.

import "../../std/fs.ouro";
import "../../std/process.ouro";
import "../../std/string_prims.ouro";

-- @entry main
def show_flag (b : Bool) : String := match b with | True => "T" | False => "F" end;

def print_line (s : String) : IO Unit := println s;

def step_time : IO Unit :=
  do let! _t := now;
      print_line "time-ok";
      exit 0

def step_proc : IO Unit :=
  do let! r := process_run_checked "node" (["-e", "console.log(6*7)"] : List String);
      match r with
      | Left e =>
          do print_line (process_error_message e);
             exit 1
      | Right result =>
          match result with
          | MkProcResult code out _err =>
              do print_line (concat "proc-code=" (prim_string_of_nat code));
                 print (concat "proc-out=" out);
                 step_time
          end
      end

def step_ls : IO Unit :=
  do let! entries := fs_list "_build/m7/lsdir";
      print_line
        (concat "ls="
          (match entries with | Nil => "empty" | Cons f _ => f end));
      step_proc

def step_exists : IO Unit :=
  do let! ex := fs_exists "_build/m7/io_fs_probe.txt";
      print_line (concat "exists=" (show_flag ex));
      step_ls

def step_fs_read : IO Unit :=
  do let! content := fs_read_checked "_build/m7/io_fs_probe.txt";
      match content with
      | Left e =>
          do print_line (fs_error_message e);
             exit 1
      | Right text =>
          do print_line (concat "fs=" text);
             step_exists
      end

def step_fs_write : IO Unit :=
  do let! wrote := fs_write_checked "_build/m7/io_fs_probe.txt" "fs-ok-42";
      match wrote with
      | Left e =>
          do print_line (fs_error_message e);
             exit 1
      | Right _ => step_fs_read
      end

def step_env : IO Unit :=
  do let! ev := env_get "OURO_IO_GATE";
      print_line
        (concat "env=" (match ev with | Nothing => "none" | Just v => v end));
      step_fs_write

def main : IO Unit :=
  do let! args := argv;
      print_line (concat "argc=" (prim_string_of_nat (args |> length String)));
      step_env
