-- IO runtime (M7): argv/env/fs/proc/time via do let! sequencing.
-- Gate sets OURO_IO_GATE=gate42, args "a b", prepares _build/m7/lsdir/only.txt.

import "../../std/runtime.ouro";

-- @entry main
def show_bool (b : Bool) : String := match b with | True => "T" | False => "F" end;

def print_line (s : String) : IO Unit := prim_stdout_write (prim_string_concat s "\n");

def step_time : IO Unit :=
  do let! _t := prim_time_now;
      print_line "time-ok";
      prim_exit 0

def step_proc : IO Unit :=
  do let! r := prim_proc_exec "node" (["-e", "console.log(6*7)"] : List String);
      match r with
      | MkProcResult code out _err =>
          do print_line (prim_string_concat "proc-code=" (prim_string_of_nat code));
            prim_stdout_write (prim_string_concat "proc-out=" out);
            step_time
      end

def step_ls : IO Unit :=
  do let! entries := prim_fs_list_dir "_build/m7/lsdir";
      print_line
        (prim_string_concat "ls="
          (match entries with | Nil => "empty" | Cons f _ => f end));
      step_proc

def step_exists : IO Unit :=
  do let! ex := prim_fs_exists "_build/m7/io_fs_probe.txt";
      print_line (prim_string_concat "exists=" (show_bool ex));
      step_ls

def step_fs_read : IO Unit :=
  do let! content := prim_fs_read_file "_build/m7/io_fs_probe.txt";
      print_line (prim_string_concat "fs=" content);
      step_exists

def step_fs_write : IO Unit :=
  do prim_fs_write_file "_build/m7/io_fs_probe.txt" "fs-ok-42";
      step_fs_read

def step_env : IO Unit :=
  do let! ev := prim_env_get "OURO_IO_GATE";
      print_line
        (prim_string_concat "env=" (match ev with | Nothing => "none" | Just v => v end));
      step_fs_write

def main : IO Unit :=
  do let! args := prim_argv;
      print_line (prim_string_concat "argc=" (prim_string_of_nat (args |> length String)));
      step_env
