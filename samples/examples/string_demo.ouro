-- String literals + pure string prims (M6); concat via prim_string_concat.

import "../../std/runtime.ouro";

-- @export greeting_len; @doc docs/api/std_string.md
-- @export slice_ok; @doc docs/api/std_string.md
-- @export of_nat_ok; @doc docs/api/std_string.md
-- @export codes_roundtrip; @doc docs/api/std_string.md
-- @entry main

def greeting : String := prim_string_concat "hello, " "ouro";

def greeting_len : Nat := prim_string_length greeting;

def slice_ok : Bool := prim_string_eq (prim_string_slice "zabcz" 1 3) "abc";

def of_nat_ok : Bool := prim_string_eq (prim_string_of_nat 42) "42";

def codes_roundtrip : Bool :=
  prim_string_eq (prim_string_of_char_codes (prim_string_to_char_codes "ab9")) "ab9";

def main : String := greeting;
