-- Small JSON object: print, parse, and report roundtrip.
import "../../std/json.ouro",
  "../../std/io.ouro";

-- @entry main
def sample_fields : List (Pair String Json) :=
  [MkPair String Json "ok" (JBool True),
   MkPair String Json "n" (JNum "42")];

def sample : Json := JObj sample_fields;

def printed : String := json_print sample;

def parsed : Maybe Json := parse_json printed;

def roundtrip : Bool :=
  match parsed with
  | Nothing => False
  | Just j => json_roundtrip_ok (json_print j)
  end;

def show_roundtrip : String :=
  match roundtrip with
  | True => "true"
  | False => "false"
  end;

def main : IO Unit :=
  do println (concat "print=" printed);
      println (concat "roundtrip=" show_roundtrip);
      exit 0
