-- Workspace tool acceptance: create workspace, write, copy, and report paths.

import "../../std/report.ouro",
  "../../std/workspace.ouro";

def workspace_tool_root : String := "_build/workflow_workspace_tool";

def workspace_tool_report (w : Workspace) : String :=
    report_render
      (report_add "copy" "out/input.copy.txt"
        (report_add "written" "data/input.txt"
          (report_add "workspace" (workspace_root w) report_empty)));

-- @entry main
def main : IO Unit :=
    do let! made := workspace_make workspace_tool_root;
       match made with
       | Left e =>
         do eprintln (fs_error_message e);
            exit 1
       | Right w =>
         do let! wrote := workspace_write_text w "data/input.txt" "hello\n";
            match wrote with
            | Left e =>
              do eprintln (fs_error_message e);
                 exit 1
            | Right _ =>
              do let! copied :=
                   fs_copy_checked
                     (workspace_file w "data/input.txt")
                     (workspace_file w "out/input.copy.txt");
                 match copied with
                 | Left e =>
                   do eprintln (fs_error_message e);
                      exit 1
                 | Right _ =>
                   do println (workspace_tool_report w);
                      exit 0
                 end
            end
       end
