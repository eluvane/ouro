-- stdin -> nonblank/comment filtering -> Nat fields -> aggregate report.

import "../../std/lines.ouro",
  "../../std/num.ouro",
  "../../std/report.ouro";

def stdin_report (lines : List String) : String :=
    let data : List String := line_data_lines "#" lines in
    let values : List Nat := line_nat_values data in
    report_render
      (report_add_nat "sum" (nat_sum values)
        (report_add_nat "values" (length Nat values)
          (report_add_nat "kept" (length String data)
            (report_add "kind" "stdin-line-report" report_empty))));

-- @entry main
def main : IO Unit :=
    do let! lines := line_read_stdin;
       println (stdin_report lines);
       exit 0
