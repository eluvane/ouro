import "../../std/fs.ouro",
  "../../std/format.ouro";

def config_path : String := "samples/examples/app_config.kv";

def print_lookup (name : String) (table : String) : IO Unit :=
    match lookup_table table name with
    | Nothing => println (kv_line name "missing")
    | Just value => println (kv_line name value)
    end;

-- @entry main
def main : IO Unit :=
    do let! loaded := fs_read_checked config_path;
       match loaded with
       | Left e =>
           do eprintln (fs_error_message e);
              exit 1
       | Right table =>
           do print_lookup "mode" table;
              print_lookup "threads" table;
              print_lookup "missing" table;
              exit 0
       end
