-- Primitive synthesis fills trivial holes.

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Bool : Type :=
  | True : Bool
  | False : Bool;

-- assumption
def id1 (A : Type) (_ : A) : A := _;

-- assumption
def const1 (A : Type) (_ : A) (_ : A) : A := _;

-- ctor
def pick : Bool := _;

-- intro
def swap_pair (A : Type) (B : Type) (_ : A) (_ : B) : A := _;

def one : Nat := 1;

-- apply
def use_apply (A : Type) (_ : A) : A :=
    _;

def use_id : Nat := id1 Nat one;

-- dependent function type
def dep_id (A : Type) (_ : A) : A := _;
