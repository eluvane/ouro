-- Metaprogram-style derivations with provenance tags. Holes `_` for synthesis.

inductive Nat : Type := | Z : Nat | S : Nat -> Nat;

inductive Bool : Type := | True : Bool | False : Bool;

inductive Pair (A : Type) (B : Type) : Type :=
  | MkPair : A -> B -> Pair A B;

-- gen/derive_id seed 0; synthesis: assumption
def gen_id (A : Type) (_ : A) : A := _;

-- gen/derive_const seed 0; synthesis: assumption
def gen_const (A : Type) (B : Type) (_ : A) (_ : B) : A := _;

-- gen/derive_flip seed 0; fully generated (reorder beyond primitive synth)
def gen_flip (A : Type) (B : Type) (C : Type) (f : A -> B -> C) (b : B) (a : A) : C := f a b;

-- gen/derive_onPair seed 0; synthesis: intro/apply on g
def gen_onPair (A : Type) (B : Type) (g : A -> B) (p : Pair A A) : Pair B B :=
    match p with | MkPair x y => MkPair B B (g x) (g y) end;

-- gen/derive_swap seed 0; fully generated
def gen_swap (A : Type) (B : Type) (p : Pair A B) : Pair B A :=
    match p with | MkPair a b => MkPair B A b a end;

-- gen/derive_const_body seed 0; fully generated
def gen_const_body (A : Type) (x : A) (_ : A) : A := x;

-- gen/derive_isZ seed 0; fully generated case analysis
def gen_isZ : Nat -> Bool :=
  fix gen_isZ (n : Nat) : Bool :=
    match n with | Z => True | S _ => False end;
