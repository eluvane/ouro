-- Config-driven file transform acceptance using checked workspace IO.

import "../../std/configx.ouro",
  "../../std/lines.ouro",
  "../../std/report.ouro",
  "../../std/text.ouro",
  "../../std/workspace.ouro";

def config_tool_root : String := "_build/workflow_config_transform";

def prefix_line (prefix : String) (line : String) : String :=
    str_cat3 prefix ":" line;

def transform_text (cfg : Config) (text : String) : String :=
    let prefix : String := config_get_or cfg "prefix" "OUT" in
    lines_to_text
      (map String String (prefix_line prefix)
        (line_data_lines("#", lines_from_text text)));

def config_tool_report (cfg : Config) (output : String) : String :=
    report_render
      (report_add "output" (str_replace (str_chomp output) "\n" "|")
        (report_add "prefix" (config_get_or cfg "prefix" "OUT") report_empty));

def config_tool_prepare (w : Workspace) : IO (Either FsError Unit) :=
    do let! cfg_written := workspace_write_text w "tool.conf" "prefix=OUT\n";
       match cfg_written with
       | Left e => fs_err Unit e
       | Right _ => workspace_write_text w "input.txt" "alpha\n# skip\nbeta\n"
       end

-- @entry main
def main : IO Unit :=
    do let! made := workspace_make config_tool_root;
       match made with
       | Left e =>
         do eprintln (fs_error_message e);
            exit 1
       | Right w =>
         do let! prepared := config_tool_prepare w;
            match prepared with
            | Left e =>
              do eprintln (fs_error_message e);
                 exit 1
            | Right _ =>
              do let! cfg_read := fsx_read_config (workspace_file w "tool.conf");
                 match cfg_read with
                 | Left e =>
                   do eprintln (fs_error_message e);
                      exit 1
                 | Right cfg =>
                   do let! transformed :=
                        fsx_read_transform_write_checked
                          (workspace_file w "input.txt")
                          (workspace_file w "output.txt")
                          (transform_text cfg);
                      match transformed with
                      | Left e =>
                        do eprintln (fs_error_message e);
                           exit 1
                      | Right _ =>
                        do let! out := workspace_read_text w "output.txt";
                           match out with
                           | Left e =>
                             do eprintln (fs_error_message e);
                                exit 1
                           | Right text =>
                             do println (config_tool_report cfg text);
                                exit 0
                           end
                      end
                 end
            end
       end
