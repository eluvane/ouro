import "../../std/format.ouro",
  "../../std/io.ouro",
  "../../std/pathx.ouro";

-- @entry main
def main : IO Unit :=
    do println (kv_line("join", path_join ([ "a", "b", "tool.ouro" ] : List String)));
       println (kv_line("dirname", path_dirname "a/b/tool.ouro"));
       println (kv_line("basename", path_basename "a/b/tool.ouro"));
       println (kv_line("normal", path_normalize "a/./b/../c//"));
       println (kv_line("normalized_join", path_join_normalized ([ "a", ".", "b", "..", "c" ] : List String)));
       exit 0
