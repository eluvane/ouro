-- Algebraic effect + one-shot handler: perform AskName, resume with a value.
import "../../std/io.ouro";

-- @entry main
effect AskName : String

def main : IO Unit :=
  handle
    do let! name := perform AskName;
        println (concat "hello " name);
        exit 0
  with
  | AskName k => k "Ouro"
  | pure r => r
  end
