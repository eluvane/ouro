-- Shared raw-runtime vocabulary. The ordinary data types have the same
-- checked identities in standard-library and system programs. This module
-- imports no host IO or managed runtime implementation.
import "../std/types.ouro";

intrinsic U8 : Type := "ouro.u8";
intrinsic U32 : Type := "ouro.u32";
intrinsic U64 : Type := "ouro.u64";
intrinsic I32 : Type := "ouro.i32";
intrinsic USize : Type := "ouro.usize";
intrinsic RawPtr : Type -> Type := "ouro.raw_ptr";
intrinsic Runtime : Type -> Type := "ouro.runtime";
intrinsic runtime_pure : (A : Type) -> A -> Runtime A := "ouro.runtime.pure";
intrinsic runtime_bind : (A : Type) -> (B : Type) -> Runtime A -> (A -> Runtime B) -> Runtime B := "ouro.runtime.bind";
intrinsic runtime_loop : (A : Type) -> A -> (A -> Runtime U8) -> (A -> Runtime A) -> Runtime A := "ouro.runtime.loop";

intrinsic u8_from_nat : Nat -> Maybe U8 := "ouro.u8.from_nat.checked";
intrinsic u32_from_nat : Nat -> Maybe U32 := "ouro.u32.from_nat.checked";
intrinsic i32_from_nat : Nat -> Maybe I32 := "ouro.i32.from_nat.checked";
intrinsic usize_from_nat : Nat -> Maybe USize := "ouro.usize.from_nat.checked";
intrinsic u8_sub : U8 -> U8 -> U8 := "ouro.u8.sub.wrap";
intrinsic u8_equal : U8 -> U8 -> Bool := "ouro.u8.eq";
intrinsic u8_to_u32 : U8 -> U32 := "ouro.convert.u8.u32.zext";
intrinsic u32_sub : U32 -> U32 -> U32 := "ouro.u32.sub.wrap";
intrinsic u32_equal : U32 -> U32 -> Bool := "ouro.u32.eq";
intrinsic u32_less : U32 -> U32 -> Bool := "ouro.u32.lt";
intrinsic u32_shift_left : U32 -> U32 -> U32 := "ouro.u32.shl";
intrinsic u32_to_u64 : U32 -> U64 := "ouro.convert.u32.u64.zext";
intrinsic u32_to_i32 : U32 -> I32 := "ouro.convert.u32.i32.reinterpret";
intrinsic i32_to_u32 : I32 -> U32 := "ouro.convert.i32.u32.reinterpret";
intrinsic i32_sub : I32 -> I32 -> I32 := "ouro.i32.sub.wrap";
intrinsic i32_equal : I32 -> I32 -> Bool := "ouro.i32.eq";
intrinsic i32_less : I32 -> I32 -> Bool := "ouro.i32.lt";
intrinsic u64_to_usize : U64 -> USize := "ouro.convert.u64.usize.reinterpret";
intrinsic usize_add : USize -> USize -> USize := "ouro.usize.add.wrap";
intrinsic usize_sub : USize -> USize -> USize := "ouro.usize.sub.wrap";
intrinsic usize_and : USize -> USize -> USize := "ouro.usize.and";
intrinsic usize_xor : USize -> USize -> USize := "ouro.usize.xor";
intrinsic usize_equal : USize -> USize -> Bool := "ouro.usize.eq";
intrinsic usize_less : USize -> USize -> Bool := "ouro.usize.lt";
intrinsic usize_shift_left : USize -> U32 -> USize := "ouro.usize.shl";
intrinsic usize_to_u64 : USize -> U64 := "ouro.convert.usize.u64.reinterpret";
intrinsic u64_to_u32 : U64 -> U32 := "ouro.convert.u64.u32.narrow.wrap";

intrinsic raw_null : (A : Type) -> RawPtr A := "ouro.raw.null";
intrinsic raw_add : (A : Type) -> RawPtr A -> USize -> Runtime (RawPtr A) := "ouro.raw.add.wrap";
intrinsic raw_cast : (A : Type) -> (B : Type) -> RawPtr A -> Runtime (RawPtr B) := "ouro.raw.cast";
intrinsic raw_to_bits : (A : Type) -> RawPtr A -> Runtime USize := "ouro.raw.to_bits";
intrinsic raw_from_bits : (A : Type) -> USize -> Runtime (RawPtr A) := "ouro.raw.from_bits";
intrinsic raw_load_u8 : RawPtr U8 -> Runtime U8 := "ouro.raw.load" U8;
intrinsic raw_store_u8 : RawPtr U8 -> U8 -> Runtime Unit := "ouro.raw.store" U8;
intrinsic raw_load_u32 : RawPtr U32 -> Runtime U32 := "ouro.raw.load" U32;
intrinsic raw_store_u32 : RawPtr U32 -> U32 -> Runtime Unit := "ouro.raw.store" U32;
intrinsic raw_load_usize : RawPtr USize -> Runtime USize := "ouro.raw.load" USize;
intrinsic raw_store_usize : RawPtr USize -> USize -> Runtime Unit := "ouro.raw.store" USize;

def raw_bool_and (first : Bool) (second : Bool) : Bool :=
    match first with | True => second | False => False end;
def raw_bool_not (value : Bool) : Bool :=
    match value with | True => raw_bool_and False True | False => True end;

def raw_one (anchor : USize) : USize :=
    match usize_from_nat 1 with | Just one => one | Nothing => usize_sub anchor anchor end;

def raw_times_eight (value : USize) : USize :=
    let twice : USize := usize_add value value in
    let four : USize := usize_add twice twice in
    usize_add four four;

def raw_load_size_at (base : RawPtr U8) (offset : USize) : Runtime USize :=
    runtime_bind (RawPtr U8) USize (raw_add U8 base offset) (fun (address : RawPtr U8) =>
      runtime_bind (RawPtr USize) USize (raw_cast U8 USize address) (fun (cell : RawPtr USize) =>
        raw_load_usize cell));

def raw_store_size_at (base : RawPtr U8) (offset : USize) (value : USize) : Runtime Unit :=
    runtime_bind (RawPtr U8) Unit (raw_add U8 base offset) (fun (address : RawPtr U8) =>
      runtime_bind (RawPtr USize) Unit (raw_cast U8 USize address) (fun (cell : RawPtr USize) =>
        raw_store_usize cell value));

def raw_load_word_at (base : RawPtr U8) (offset : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 (raw_add U8 base offset) (fun (address : RawPtr U8) =>
      runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 address) (fun (cell : RawPtr U32) =>
        raw_load_u32 cell));

def raw_store_word_at (base : RawPtr U8) (offset : USize) (value : U32) : Runtime Unit :=
    runtime_bind (RawPtr U8) Unit (raw_add U8 base offset) (fun (address : RawPtr U8) =>
      runtime_bind (RawPtr U32) Unit (raw_cast U8 U32 address) (fun (cell : RawPtr U32) =>
        raw_store_u32 cell value));

def raw_restore_size (output : RawPtr USize) (saved : USize) (error : U32) : Runtime U32 :=
    runtime_bind Unit U32 (raw_store_usize output saved) (fun (_restored : Unit) => runtime_pure U32 error);

def raw_restore_word (count : RawPtr U32) (saved : U32) (error : U32) : Runtime U32 :=
    runtime_bind Unit U32 (raw_store_u32 count saved) (fun (_restored : Unit) => runtime_pure U32 error);

def raw_u32_to_size (value : U32) : USize := u64_to_usize (u32_to_u64 value);
def raw_size_to_u32 (value : USize) : U32 := u64_to_u32 (usize_to_u64 value);

-- Zero denotes invalid size/alignment or overflow. Positive results are the
-- exact size rounded up to a positive power-of-two alignment, without wrapping.
def raw_size_round_up (bytes : USize) (alignment : USize) : USize :=
    let zero : USize := usize_sub bytes bytes in
    match usize_equal bytes zero with | True => zero | False =>
      match usize_equal alignment zero with | True => zero | False =>
        match usize_from_nat 1 with | Nothing => zero | Just one =>
          let mask : USize := usize_sub alignment one in
          match usize_equal (usize_and alignment mask) zero with | False => zero | True =>
            let total : USize := usize_add bytes mask in
            match usize_less total bytes with | True => zero | False =>
              usize_and total (usize_xor (usize_sub zero one) mask)
            end end end end end;
