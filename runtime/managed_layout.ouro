-- Managed ABI v1: 32-byte header, 40-byte readonly descriptor. The compiler
-- initializes context {heap, roots, count, bytes, descriptor_count, entries[]}
-- before calling this runtime. Entries contain {address, role}: object=1,
-- shadow frame=2. Zero-initialized budget and private-heap-handle words follow
-- all entries; callers reserve 56 + 16*descriptor_count bytes for this context.
-- No foreign descriptor address is dereferenced.
import "managed_memory.ouro";

-- One budget word follows the unchanged descriptor entries. Zero means a
-- collection is due. The word index and its byte offset must both fit USize.
def managed_collection_budget_word (count : USize) : USize :=
    let zero : USize := usize_sub count count in
    let one : USize := managed_one count in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let five : USize := usize_add three two in
    let entries : USize := usize_add count count in
    let word : USize := usize_add entries five in
    match raw_bool_and (raw_bool_not (usize_less entries count))
      (raw_bool_and (usize_less entries word)
        (usize_equal (managed_shift_right (managed_word_offset word) (raw_size_to_u32 three)) word)) with
    | False => zero | True => word end;

-- The heap owner follows the unchanged budget. Check the complete final
-- word, including its end, before any caller forms a footer address.
def managed_heap_handle_word (count : USize) : USize :=
    let zero : USize := usize_sub count count in
    let one : USize := managed_one count in
    let three : USize := usize_add (usize_add one one) one in
    let budget : USize := managed_collection_budget_word count in
    let owner : USize := usize_add budget one in
    let ending : USize := usize_add owner one in
    match raw_bool_and (raw_bool_not (usize_equal budget zero))
      (raw_bool_and (usize_less budget owner)
        (raw_bool_and (usize_less owner ending)
          (usize_equal (managed_shift_right (managed_word_offset ending)
            (raw_size_to_u32 three)) ending))) with
    | False => zero | True => owner end;

def managed_descriptor_known (context : RawPtr U8) (descriptor : RawPtr U8) (role : USize) : Runtime Bool :=
    runtime_bind USize Bool (raw_to_bits U8 descriptor) (fun (wanted : USize) =>
      let zero : USize := usize_sub wanted wanted in
      let one : USize := managed_one wanted in
      let two : USize := usize_add one one in
      let four : USize := usize_add two two in
      let five : USize := usize_add four one in
      runtime_bind USize Bool (managed_read_word context four) (fun (count : USize) =>
        match u8_from_nat 1 with | Nothing => runtime_pure Bool False | Just running =>
          runtime_bind USize Bool (runtime_loop USize zero
            (fun (index : USize) => match usize_less index count with
              | False => runtime_pure U8 (u8_sub running running)
              | True => let offset : USize := usize_add five (usize_add index index) in
                  runtime_bind USize U8 (managed_read_word context offset)
                    (fun (candidate : USize) => runtime_bind USize U8
                      (managed_read_word context (usize_add offset one))
                      (fun (actual : USize) => runtime_pure U8 (match raw_bool_and
                        (usize_equal candidate wanted) (usize_equal actual role) with
                        | True => u8_sub running running | False => running end))) end)
            (fun (index : USize) => runtime_pure USize (usize_add index one)))
            (fun (found : USize) => runtime_pure Bool (usize_less found count)) end));

def managed_descriptor_shape (kind : USize) (prefix : USize) (start : USize)
    (mode : USize) (argument : USize) : Bool :=
    let zero : USize := usize_sub kind kind in
    let one : USize := managed_one kind in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add five one in
    let seven : USize := usize_add six one in
    let fifteen : USize := usize_sub (usize_add (managed_word_offset one) (managed_word_offset one)) one in
    match raw_bool_and (raw_bool_not (usize_equal kind zero)) (raw_bool_not (usize_less fifteen kind)) with
    | False => False
    | True => match usize_equal kind one with
      | True => raw_bool_and (usize_equal prefix (managed_word_offset seven))
          (raw_bool_and (usize_equal start prefix)
            (raw_bool_and (usize_equal mode two) (usize_equal argument (managed_word_offset six))))
      | False => match usize_equal kind two with
        | True => raw_bool_and (usize_equal prefix (managed_word_offset five))
            (raw_bool_and (usize_equal start prefix)
              (raw_bool_and (usize_equal mode two) (usize_equal argument (managed_word_offset four))))
        | False => match usize_less five kind with
          | False => raw_bool_and (raw_bool_not (usize_less kind three))
              (raw_bool_and (usize_equal prefix (managed_word_offset six))
                (raw_bool_and (usize_equal start (managed_word_offset five))
                  (raw_bool_and (usize_equal mode one) (usize_equal argument one))))
          | True => raw_bool_and (usize_equal prefix (managed_word_offset five))
              (raw_bool_and (usize_equal start zero)
                (raw_bool_and (usize_equal mode zero) (usize_equal argument zero))) end end end end;

def managed_descriptor_fields (descriptor : RawPtr U8) (bytes : USize) : Runtime Bool :=
    let zero : USize := usize_sub bytes bytes in
    let one : USize := managed_one bytes in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    runtime_bind U32 Bool (managed_read_u32 descriptor zero) (fun (version : U32) =>
      match u32_equal version (raw_size_to_u32 one) with | False => runtime_pure Bool False | True =>
        runtime_bind U32 Bool (managed_read_u32 descriptor four) (fun (kind : U32) =>
          runtime_bind USize Bool (managed_read_word descriptor one) (fun (prefix : USize) =>
            runtime_bind USize Bool (managed_read_word descriptor two) (fun (start : USize) =>
              runtime_bind USize Bool (managed_read_word descriptor three) (fun (mode : USize) =>
                runtime_bind USize Bool (managed_read_word descriptor four) (fun (argument : USize) =>
                  runtime_pure Bool (raw_bool_and (raw_bool_not (usize_less bytes prefix))
                    (managed_descriptor_shape (raw_u32_to_size kind) prefix start mode argument))))))) end);

def managed_descriptor_valid (context : RawPtr U8) (descriptor : RawPtr U8) (bytes : USize) : Runtime Bool :=
    let zero : USize := usize_sub bytes bytes in
    let one : USize := managed_one bytes in
    let seven : USize := usize_sub (managed_word_offset one) one in
    match raw_bool_and (raw_bool_not (usize_equal bytes zero)) (usize_equal (usize_and bytes seven) zero) with
    | False => runtime_pure Bool False
    | True => runtime_bind Bool Bool (managed_descriptor_known context descriptor one) (fun (known : Bool) =>
        match known with | False => runtime_pure Bool False
        | True => managed_descriptor_fields descriptor bytes end) end;

-- base must be a registered allocation start. Descriptor identity and v1
-- layout are checked before reading a dynamic reference count. Every traced
-- range then fits inside the recorded object bytes, without multiplication.
def managed_check_object (context : RawPtr U8) (base : RawPtr U8) : Runtime Unit :=
    runtime_bind USize Unit (raw_to_bits U8 base) (fun (bits : USize) =>
      let zero : USize := usize_sub bits bits in
      let one : USize := managed_one bits in
      let two : USize := usize_add one one in
      let three : USize := usize_add two one in
      let four : USize := usize_add two two in
      let seven : USize := usize_sub (managed_word_offset one) one in
      runtime_bind Unit Unit (managed_require
        (raw_bool_and (raw_bool_not (usize_equal bits zero)) (usize_equal (usize_and bits seven) zero)) bits)
        (fun (aligned : Unit) => runtime_bind (RawPtr U8) Unit (managed_read_pointer base zero) (fun (descriptor : RawPtr U8) =>
          runtime_bind USize Unit (managed_read_word base one) (fun (bytes : USize) =>
            runtime_bind Bool Unit (managed_descriptor_valid context descriptor bytes) (fun (valid : Bool) =>
              runtime_bind Unit Unit (managed_require valid bytes) (fun (layout : Unit) =>
                runtime_bind USize Unit (managed_read_word descriptor two) (fun (start : USize) =>
                  runtime_bind USize Unit (managed_read_word descriptor three) (fun (mode : USize) =>
                    runtime_bind USize Unit (managed_read_word descriptor four) (fun (argument : USize) =>
                      runtime_bind USize Unit
                        (match usize_equal mode two with
                          | True => managed_read_word base (managed_shift_right argument (raw_size_to_u32 three))
                          | False => runtime_pure USize argument end)
                        (fun (count : USize) => managed_require
                          (raw_bool_not (usize_less
                            (managed_shift_right (usize_sub bytes start) (raw_size_to_u32 three)) count)) bytes))))))))));
