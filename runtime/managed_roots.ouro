-- Exact shadow-root traversal. Inspection requires a separate live/aligned
-- 32-byte raw scratch buffer; its first three words count frames, slots and
-- non-null slots, while word three bounds heap scans. Marking additionally
-- requires the collector worklist layout from managed_mark.ouro.
import "managed_mark.ouro";

def managed_visit_slot_with_heap (context : RawPtr U8) (frame : RawPtr U8) (descriptor : RawPtr U8)
    (base : RawPtr U8) (index : USize) (scratch : RawPtr U8) (tracing : Bool)
    (heap_checked : Bool) : Runtime Unit :=
    let zero : USize := usize_sub index index in
    let one : USize := managed_one index in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let seven : USize := usize_sub(managed_word_offset one, one) in
    runtime_bind USize Unit (managed_read_word(descriptor, usize_add index one)) (fun (offset : USize) =>
      runtime_bind USize Unit (raw_to_bits U8 base) (fun (base_bits : USize) =>
        runtime_bind USize Unit (raw_to_bits U8 frame) (fun (frame_bits : USize) =>
          runtime_bind Unit Unit (managed_require
            (raw_bool_and (usize_equal(usize_and offset seven, zero))
              (raw_bool_and (raw_bool_not (usize_less(offset, managed_word_offset four)))
                (raw_bool_not (usize_less(usize_sub(usize_sub frame_bits base_bits, managed_word_offset one), offset))))) offset)
            (fun (_range : Unit) => runtime_bind Unit Unit (managed_increment scratch one) (fun (_counted_outer : Unit) =>
              runtime_bind (RawPtr U8) Unit (raw_add U8 base offset) (fun (cell : RawPtr U8) =>
                runtime_bind USize Unit (managed_read_word cell zero) (fun (value : USize) =>
                  match usize_equal value zero with | True => runtime_pure Unit MkUnit | False =>
                    runtime_bind Bool Unit (match heap_checked with
                      | False => managed_object_known context value scratch
                      | True => managed_object_in_mark_heap context value scratch end) (fun (known : Bool) =>
                      runtime_bind Unit Unit (managed_require known value) (fun (_registered : Unit) =>
                        runtime_bind (RawPtr U8) Unit (raw_from_bits U8 value) (fun (object : RawPtr U8) =>
                          runtime_bind Unit Unit (managed_check_object context object)
                            (fun (_checked : Unit) => runtime_bind Unit Unit (managed_increment scratch two)
                            (fun (_counted : Unit) => match tracing with
                              | False => runtime_pure Unit MkUnit
                              | True => managed_mark_push object scratch value end))))) end)))))));

def managed_visit_frame_with_heap (context : RawPtr U8) (frame : RawPtr U8) (scratch : RawPtr U8) (tracing : Bool)
    (heap_checked : Bool) : Runtime (RawPtr U8) :=
    runtime_bind USize (RawPtr U8) (raw_to_bits U8 frame) (fun (frame_bits : USize) =>
      let zero : USize := usize_sub frame_bits frame_bits in
      let one : USize := managed_one frame_bits in
      let two : USize := usize_add one one in
      let three : USize := usize_add two one in
      let seven : USize := usize_sub(managed_word_offset one, one) in
      runtime_bind Unit (RawPtr U8) (managed_require
        (raw_bool_and(raw_bool_not (usize_equal frame_bits zero), usize_equal(usize_and frame_bits seven, zero))) frame_bits)
        (fun (_aligned : Unit) => runtime_bind (RawPtr U8) (RawPtr U8) (managed_read_pointer frame zero) (fun (previous : RawPtr U8) =>
          runtime_bind USize (RawPtr U8) (raw_to_bits U8 previous) (fun (previous_bits : USize) =>
            runtime_bind Unit (RawPtr U8) (managed_require
              (match usize_equal previous_bits zero with | True => True | False => usize_less frame_bits previous_bits end) frame_bits)
              (fun (_ordered : Unit) => runtime_bind (RawPtr U8) (RawPtr U8) (managed_read_pointer frame one) (fun (descriptor : RawPtr U8) =>
                runtime_bind Bool (RawPtr U8) (managed_descriptor_known context descriptor two) (fun (known : Bool) =>
                  runtime_bind Unit (RawPtr U8) (managed_require known frame_bits) (fun (_registered : Unit) =>
                    runtime_bind (RawPtr U8) (RawPtr U8) (managed_read_pointer frame two) (fun (base : RawPtr U8) =>
                      runtime_bind USize (RawPtr U8) (raw_to_bits U8 base) (fun (base_bits : USize) =>
                        runtime_bind Unit (RawPtr U8) (managed_require
                          (raw_bool_and (raw_bool_not (usize_equal base_bits zero))
                            (raw_bool_and(usize_equal(usize_and base_bits seven, zero), usize_less base_bits frame_bits))) frame_bits)
                          (fun (_base_valid : Unit) => runtime_bind USize (RawPtr U8) (managed_read_word descriptor zero) (fun (count : USize) =>
                            runtime_bind Unit (RawPtr U8) (managed_require
                              (raw_bool_and (raw_bool_not (usize_equal count zero))
                                (raw_bool_not (usize_less(managed_shift_right(usize_sub frame_bits base_bits, raw_size_to_u32 three), count)))) frame_bits)
                              (fun (_bounded : Unit) => runtime_bind Unit (RawPtr U8) (managed_increment scratch zero) (fun (_counted : Unit) =>
                                match u8_from_nat 1 with
                                | Nothing => runtime_pure(RawPtr U8, raw_null U8)
                                | Just running => runtime_bind USize (RawPtr U8) (runtime_loop USize zero
                                    (fun (index : USize) => runtime_pure U8 (match usize_less index count with
                                      | True => running | False => u8_sub running running end))
                                    (fun (index : USize) => runtime_bind Unit USize (managed_visit_slot_with_heap context frame descriptor base index scratch tracing heap_checked)
                                      (fun (_checked : Unit) => runtime_pure(USize, usize_add index one))))
                                    (fun (_finished : USize) => runtime_pure(RawPtr U8, previous)) end))))))))))))));

def managed_visit_roots_with_heap (context : RawPtr U8) (scratch : RawPtr U8) (tracing : Bool)
    (heap_checked : Bool) : Runtime Unit :=
    runtime_bind USize Unit (raw_to_bits U8 context) (fun (bits : USize) =>
      let zero : USize := usize_sub bits bits in
      let one : USize := managed_one bits in
      let two : USize := usize_add one one in
      runtime_bind Unit Unit (managed_write_word scratch zero zero) (fun (_a : Unit) =>
        runtime_bind Unit Unit (managed_write_word scratch one zero) (fun (_b : Unit) =>
          runtime_bind Unit Unit (managed_write_word scratch two zero) (fun (_c : Unit) =>
            runtime_bind (RawPtr U8) Unit (managed_read_pointer context one) (fun (first : RawPtr U8) =>
              match u8_from_nat 1 with | Nothing => managed_panic bits | Just running =>
                runtime_bind (RawPtr U8) Unit (runtime_loop (RawPtr U8) first
                  (fun (frame : RawPtr U8) => runtime_bind Bool U8 (managed_pointer_is_null frame) (fun (empty : Bool) =>
                    runtime_pure(U8, match empty with | True => u8_sub running running | False => running end)))
                  (fun (frame : RawPtr U8) => managed_visit_frame_with_heap context frame scratch tracing heap_checked))
                  (fun (_finished : RawPtr U8) => runtime_pure Unit MkUnit) end)))));

def managed_visit_roots (context : RawPtr U8) (scratch : RawPtr U8) (tracing : Bool) : Runtime Unit :=
    managed_visit_roots_with_heap context scratch tracing False;

def managed_inspect_roots (context : RawPtr U8) (scratch : RawPtr U8) : Runtime Unit :=
    managed_visit_roots context scratch False;

-- Called only by collection after the complete managed_gc_heap False pass.
def managed_mark_roots_after_heap (context : RawPtr U8) (scratch : RawPtr U8) : Runtime Unit :=
    managed_visit_roots_with_heap context scratch True True;
