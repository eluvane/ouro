-- Allocation-free standard-stream byte output. The caller supplies the message and
-- a live, aligned, writable U32 count cell disjoint from the message range.
-- Empty output needs no storage. Invalid ranges/handles, OS errors, zero
-- progress, and impossible write counts return False. No String is allocated.
-- Nonempty lengths must be below USize::MAX; the loop reserves bytes+1 as its
-- failure state. A False result may follow a successfully written prefix.
import "windows_io.ouro",
  "../raw_buffer.ouro";

-- Caller establishes offset <= bytes < USize::MAX and one = 1. The sentinel
-- bytes+1 ends the loop on failure. Each successful partial write advances by
-- its actual positive count, never by the requested count.
def raw_windows_write_progress (bytes : USize) (offset : USize) (requested : U32)
    (written : U32) (status : U32) (one : USize) : USize :=
    let failure : USize := usize_add bytes one in
    let zero : U32 := u32_sub status status in
    match u32_equal status zero with | True => failure | False =>
      match u32_equal written zero with | True => failure | False =>
        match u32_less requested written with | True => failure | False =>
          let progress : USize := raw_u32_to_size written in
          match usize_less(usize_sub bytes offset, progress) with
          | True => failure | False => usize_add offset progress end end end end;

def raw_windows_write_chunk (remaining : USize) (one : USize) : U32 :=
    let word_one : U32 := raw_size_to_u32 one in
    let maximum : U32 := u32_sub(u32_sub word_one word_one, word_one) in
    match usize_less(raw_u32_to_size maximum, remaining) with
    | True => maximum | False => raw_size_to_u32 remaining end;

def raw_windows_write_step (stream_handle : RawPtr U8) (message : RawPtr U8) (bytes : USize)
    (written : RawPtr U32) (offset : USize) (one : USize) : Runtime USize :=
    let requested : U32 := raw_windows_write_chunk(usize_sub bytes offset, one) in
    runtime_bind (RawPtr U8) USize (raw_add U8 message offset) (fun (address : RawPtr U8) =>
      runtime_bind Unit USize (raw_store_u32(written, u32_sub requested requested))
        (fun (_cleared : Unit) => runtime_bind U32 USize
          (windows_write_file stream_handle address requested written (raw_null U8))
          (fun (status : U32) => runtime_bind U32 USize (raw_load_u32 written)
            (fun (actual : U32) => runtime_pure USize
              (raw_windows_write_progress bytes offset requested actual status one)))));

def raw_windows_write_loop (stream_handle : RawPtr U8) (message : RawPtr U8) (bytes : USize)
    (written : RawPtr U32) (one : USize) : Runtime Bool :=
    match u8_from_nat 1 with | Nothing => runtime_pure Bool False | Just running =>
      runtime_bind USize Bool (runtime_loop USize (usize_sub bytes bytes)
        (fun (offset : USize) => runtime_pure U8 (match usize_less offset bytes with
          | True => running | False => u8_sub running running end))
        (fun (offset : USize) => raw_windows_write_step stream_handle message bytes written offset one))
        (fun (finished : USize) => runtime_pure(Bool, usize_equal finished bytes)) end;

def raw_windows_standard_write (selector : U32) (message : RawPtr U8) (bytes : USize)
    (written : RawPtr U32) : Runtime Bool :=
    let zero : USize := usize_sub bytes bytes in
    match usize_equal bytes zero with | True => runtime_pure Bool True | False =>
      match usize_from_nat 1 with | Nothing => runtime_pure Bool False | Just one =>
        let maximum : USize := usize_sub zero one in
        match usize_equal bytes maximum with | True => runtime_pure Bool False | False =>
          match u32_from_nat 4 with | Nothing => runtime_pure Bool False | Just word_four =>
            let four : USize := raw_u32_to_size word_four in
            runtime_bind Bool Bool (raw_buffer_range message bytes zero bytes) (fun (valid : Bool) =>
              match valid with | False => runtime_pure Bool False | True =>
                runtime_bind USize Bool (raw_to_bits U32 written) (fun (scratch : USize) =>
                  match usize_equal scratch zero with | True => runtime_pure Bool False | False =>
                    match usize_equal(usize_and(scratch, usize_sub four one), zero) with
                    | False => runtime_pure Bool False
                    | True => runtime_bind (RawPtr U8) Bool (raw_cast U32 U8 written)
                      (fun (scratch_pointer : RawPtr U8) => runtime_bind Bool Bool
                        (raw_buffer_range scratch_pointer four zero four) (fun (scratch_valid : Bool) =>
                          match scratch_valid with | False => runtime_pure Bool False | True =>
                            runtime_bind USize Bool (raw_to_bits U8 message) (fun (message_bits : USize) =>
                              match raw_buffer_disjoint scratch four message_bits bytes with
                              | False => runtime_pure Bool False
                              | True => runtime_bind (RawPtr U8) Bool (windows_get_std_handle selector)
                                  (fun (stream_handle : RawPtr U8) => runtime_bind USize Bool (raw_to_bits U8 stream_handle)
                                    (fun (handle_bits : USize) =>
                                      match usize_equal handle_bits zero with | True => runtime_pure Bool False | False =>
                                        match usize_equal handle_bits maximum with | True => runtime_pure Bool False
                                        | False => raw_windows_write_loop stream_handle message bytes written one end end)) end)
                          end)) end end) end) end end end end;

-- True means every requested byte was written; False can follow a prefix.
-- Both streams preserve embedded NUL and perform no newline conversion.
def raw_windows_stdout (message : RawPtr U8) (bytes : USize) (written : RawPtr U32) : Runtime Bool :=
    match u32_from_nat 11 with | Nothing => runtime_pure Bool False | Just selector =>
      raw_windows_standard_write (u32_sub(u32_sub selector selector, selector)) message bytes written end;

def raw_windows_stderr (message : RawPtr U8) (bytes : USize) (written : RawPtr U32) : Runtime Bool :=
    match u32_from_nat 12 with | Nothing => runtime_pure Bool False | Just selector =>
      raw_windows_standard_write (u32_sub(u32_sub selector selector, selector)) message bytes written end;

-- The message is best-effort emergency output; either write outcome ends in
-- nonzero process termination. The code-only entry works without any buffers.
def raw_windows_panic (message : RawPtr U8) (bytes : USize) (written : RawPtr U32) (code : U32)
    : Runtime Unit :=
    runtime_bind Bool Unit (raw_windows_stderr message bytes written) (fun (_printed : Bool) =>
      raw_windows_panic_code code);
