-- Shared, allocation-free Win32 status and storage checks. Raw callers own
-- the supplied storage; range checks do not establish its actual lifetime.
import "windows_x64.ouro";
import "../raw_buffer.ouro";

extern windows_get_last_error : Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetLastError" "nogc";

-- These internal word helpers receive one=1 from a checked literal conversion.
def raw_windows_int_max (one : USize) : USize :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    usize_sub (usize_shift_left one (raw_size_to_u32 (usize_sub (usize_add sixteen sixteen) one))) one;

def raw_windows_parameter_error (one : USize) : U32 :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    let thirtytwo : USize := usize_add sixteen sixteen in
    raw_size_to_u32 (usize_add (usize_add thirtytwo thirtytwo) (usize_add sixteen (usize_sub eight one)));

def raw_windows_general_error (one : USize) : U32 :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    raw_size_to_u32 (usize_sub (usize_add (usize_add eight eight) (usize_add eight eight)) one);

-- Read immediately after a failed OS call. A missing error code remains a
-- failure (ERROR_GEN_FAILURE), never the success status zero.
def raw_windows_last_failure (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 windows_get_last_error (fun (error : U32) =>
      runtime_pure U32 (match u32_equal error (u32_sub error error) with
        | True => raw_windows_general_error one | False => error end));

def raw_windows_count_cell (cell : RawPtr U32) (one : USize) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    runtime_bind USize Bool (raw_to_bits U32 cell) (fun (bits : USize) =>
      match usize_equal (usize_and bits (usize_sub four one)) zero with
      | False => runtime_pure Bool False
      | True => runtime_bind (RawPtr U8) Bool (raw_cast U32 U8 cell) (fun (bytes : RawPtr U8) =>
          raw_buffer_range bytes four zero four) end);

-- Empty ranges have no bytes that can overlap. Nonempty ranges must have
-- passed raw_buffer_range before this helper is called.
def raw_windows_storage_disjoint (first : RawPtr U8) (first_bytes : USize)
    (second : RawPtr U8) (second_bytes : USize) : Runtime Bool :=
    let zero : USize := usize_sub first_bytes first_bytes in
    match usize_equal first_bytes zero with | True => runtime_pure Bool True | False =>
      match usize_equal second_bytes zero with | True => runtime_pure Bool True | False =>
        runtime_bind USize Bool (raw_to_bits U8 first) (fun (left : USize) =>
          runtime_bind USize Bool (raw_to_bits U8 second) (fun (right : USize) =>
            runtime_pure Bool (raw_buffer_disjoint left first_bytes right second_bytes))) end end;

-- source/target may be null only for their empty ranges. The result count
-- cell must be aligned, writable and disjoint from both byte ranges.
def raw_windows_conversion_storage (source : RawPtr U8) (source_bytes : USize)
    (target : RawPtr U8) (target_bytes : USize) (count : RawPtr U32) (one : USize) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    runtime_bind Bool Bool (raw_buffer_range source source_bytes zero source_bytes) (fun (readable : Bool) =>
      match readable with | False => runtime_pure Bool False | True =>
        runtime_bind Bool Bool (raw_buffer_range target target_bytes zero target_bytes) (fun (writable : Bool) =>
          match writable with | False => runtime_pure Bool False | True =>
            runtime_bind Bool Bool (raw_windows_count_cell count one) (fun (count_valid : Bool) =>
              match count_valid with | False => runtime_pure Bool False | True =>
                runtime_bind Bool Bool (raw_windows_storage_disjoint source source_bytes target target_bytes)
                  (fun (separate : Bool) => match separate with | False => runtime_pure Bool False | True =>
                    runtime_bind (RawPtr U8) Bool (raw_cast U32 U8 count) (fun (cell : RawPtr U8) =>
                      runtime_bind Bool Bool (raw_windows_storage_disjoint cell four source source_bytes)
                        (fun (before : Bool) => match before with | False => runtime_pure Bool False | True =>
                          raw_windows_storage_disjoint cell four target target_bytes end)) end) end) end) end);

def raw_windows_wide_aligned (base : RawPtr U8) (units : USize) (one : USize) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    match usize_equal units zero with | True => runtime_pure Bool True | False =>
      runtime_bind USize Bool (raw_to_bits U8 base) (fun (bits : USize) =>
        runtime_pure Bool (usize_equal (usize_and bits one) zero)) end;

def raw_windows_store_count (count : RawPtr U32) (value : U32) : Runtime U32 :=
    runtime_bind Unit U32 (raw_store_u32 count value)
      (fun (written : Unit) => runtime_pure U32 (u32_sub value value));

def raw_windows_size_cell (cell : RawPtr USize) (one : USize) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    runtime_bind USize Bool (raw_to_bits USize cell) (fun (bits : USize) =>
      match usize_equal (usize_and bits (usize_sub eight one)) zero with
      | False => runtime_pure Bool False
      | True => runtime_bind (RawPtr U8) Bool (raw_cast USize U8 cell) (fun (bytes : RawPtr U8) =>
          raw_buffer_range bytes eight zero eight) end);

def raw_windows_insufficient_buffer (one : USize) : U32 :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    raw_size_to_u32 (usize_sub (usize_shift_left one (raw_size_to_u32 (usize_sub eight one)))
      (usize_add four two));
