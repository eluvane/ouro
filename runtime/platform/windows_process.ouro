-- Shell-free process creation. Arguments exclude argv[0]; their descriptor
-- table contains 16-byte { UTF-16 pointer bits, length excluding zero } entries.
-- executable and directory are terminated UTF-16. Directory is absolute.
-- Environment is an explicit, sorted, double-zero-terminated Unicode block.
-- Storage/strings stay live and immutable for the call. Raw checks establish
-- ranges and alignment, not provenance or freedom from concurrent mutation.
import "windows_process_launch.ouro";
import "windows_process_wait.ouro";
import "windows_process_environment.ouro";

def raw_process_absolute_directory (directory : RawPtr U8) (units : USize) (one : USize) : Runtime Bool :=
    let process_number_92 : USize := (usize_add (raw_process_eight (usize_add (raw_process_eight one) (usize_add one (usize_add one one)))) (usize_add (usize_add one one) (usize_add one one))) in

    match usize_less units (usize_add one (usize_add one one)) with | True => runtime_pure Bool False | False =>
      runtime_bind USize Bool (raw_windows_wide_unit directory (usize_sub one one) one) (fun (first : USize) =>
        runtime_bind USize Bool (raw_windows_wide_unit directory one one) (fun (second : USize) =>
          match raw_bool_and (usize_equal first process_number_92) (usize_equal second process_number_92) with
          | True => runtime_pure Bool True
          | False => runtime_bind USize Bool (raw_windows_wide_unit directory (usize_add one one) one) (fun (third : USize) =>
              let upper : Bool := raw_bool_and (raw_bool_not (usize_less first (usize_add (raw_process_eight (raw_process_eight one)) one))) (usize_less first (usize_add (raw_process_eight (usize_add (raw_process_eight one) (usize_add one (usize_add one one)))) (usize_add one (usize_add one one)))) in
              let lower : Bool := raw_bool_and (raw_bool_not (usize_less first (usize_add (raw_process_eight (usize_add (raw_process_eight one) (usize_add (usize_add one one) (usize_add one one)))) one))) (usize_less first (usize_add (raw_process_eight (usize_add (raw_process_eight one) (usize_add (usize_add one (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))))) (usize_add one (usize_add one one)))) in
              runtime_pure Bool (raw_bool_and (match upper with | True => True | False => lower end)
                (raw_bool_and (usize_equal second (usize_add (raw_process_eight (usize_add (usize_add one (usize_add one one)) (usize_add (usize_add one one) (usize_add one one)))) (usize_add one one)))
                  (match usize_equal third process_number_92 with | True => True | False => usize_equal third (usize_add (raw_process_eight (usize_add (usize_add one one) (usize_add one (usize_add one one)))) (usize_add (usize_add one (usize_add one one)) (usize_add (usize_add one one) (usize_add one one)))) end)))) end)) end;

def raw_process_argument_check (arguments : RawPtr U8) (count : USize)
    (index : USize) (owner : RawPtr U8) (one : USize) : Runtime USize :=
    let offset : USize := raw_process_eight (usize_add index index) in
    runtime_bind USize USize (raw_process_load arguments offset) (fun (bits : USize) =>
      runtime_bind USize USize (raw_process_load arguments (usize_add offset (raw_process_eight one))) (fun (units : USize) =>
        runtime_bind (RawPtr U8) USize (raw_from_bits U8 bits) (fun (source : RawPtr U8) =>
          runtime_bind Bool USize (raw_process_string_valid source units one) (fun (valid : Bool) =>
            match valid with | False => runtime_pure USize (usize_add count one) | True =>
              let terminated : USize := usize_add units one in
              runtime_bind Bool USize (raw_windows_storage_disjoint source (usize_add terminated terminated) owner (raw_process_eight (usize_add one (usize_add one one))))
                (fun (separate : Bool) => runtime_pure USize (match separate with
                  | True => usize_add index one | False => usize_add count one end)) end))));

def raw_process_arguments_valid (arguments : RawPtr U8) (count : USize)
    (owner : RawPtr U8) (one : USize) : Runtime Bool :=
    match usize_less (raw_process_command_limit one) count with | True => runtime_pure Bool False | False =>
      match usize_equal count (usize_sub one one) with | True => runtime_pure Bool True | False =>
        let bytes : USize := raw_process_eight (usize_add count count) in
        runtime_bind Bool Bool (raw_process_storage arguments bytes one) (fun (valid : Bool) =>
          match valid with | False => runtime_pure Bool False | True =>
            runtime_bind Bool Bool (raw_windows_storage_disjoint arguments bytes owner (raw_process_eight (usize_add one (usize_add one one)))) (fun (separate : Bool) =>
              match separate with | False => runtime_pure Bool False | True =>
                match u8_from_nat 1 with | Nothing => runtime_pure Bool False | Just running =>
                  runtime_bind USize Bool (runtime_loop USize (usize_sub one one)
                    (fun (index : USize) => runtime_pure U8 (match usize_less index count with
                      | True => running | False => u8_sub running running end))
                    (fun (index : USize) => raw_process_argument_check arguments count index owner one))
                    (fun (finished : USize) => runtime_pure Bool (usize_equal finished count)) end end) end) end end;

def raw_process_owner_empty (owner : RawPtr U8) (one : USize) : Runtime Bool :=
    runtime_bind Bool Bool (raw_process_storage owner (raw_process_eight (usize_add one (usize_add one one))) one) (fun (valid : Bool) =>
      match valid with | False => runtime_pure Bool False | True =>
        runtime_bind USize Bool (raw_process_load owner (usize_sub one one)) (fun (process : USize) =>
          runtime_bind USize Bool (raw_process_load owner (raw_process_eight one)) (fun (thread : USize) =>
            runtime_pure Bool (raw_bool_and (usize_equal process (usize_sub one one)) (usize_equal thread (usize_sub one one))))) end);

def raw_process_inputs_valid (executable : RawPtr U8) (executable_units : USize)
    (arguments : RawPtr U8) (count : USize) (environment : RawPtr U8) (environment_units : USize)
    (directory : RawPtr U8) (directory_units : USize) (owner : RawPtr U8) (one : USize) : Runtime Bool :=
    let process_number_24 : USize := (raw_process_eight (usize_add one (usize_add one one))) in

    runtime_bind Bool Bool (raw_process_owner_empty owner one) (fun (empty : Bool) =>
      match empty with | False => runtime_pure Bool False | True =>
        runtime_bind Bool Bool (raw_windows_path_output executable executable_units owner process_number_24 (raw_process_eight one) one) (fun (valid_executable : Bool) =>
          match valid_executable with | False => runtime_pure Bool False | True =>
            match usize_less (raw_process_command_limit one) executable_units with | True => runtime_pure Bool False | False =>
              runtime_bind USize Bool (raw_process_scan executable executable_units (usize_sub one one) (usize_add (raw_process_eight (usize_add (usize_add one one) (usize_add one one))) (usize_add one one)) False one) (fun (quote : USize) =>
                match usize_equal quote executable_units with | False => runtime_pure Bool False | True =>
                  runtime_bind Bool Bool (raw_windows_path_output directory directory_units owner process_number_24 (raw_process_eight one) one) (fun (valid_directory : Bool) =>
                    match valid_directory with | False => runtime_pure Bool False | True =>
                      runtime_bind Bool Bool (raw_process_absolute_directory directory directory_units one) (fun (absolute : Bool) =>
                        match absolute with | False => runtime_pure Bool False | True =>
                          runtime_bind Bool Bool (raw_process_environment_valid environment environment_units one) (fun (valid_environment : Bool) =>
                            match valid_environment with | False => runtime_pure Bool False | True =>
                              runtime_bind Bool Bool (raw_windows_storage_disjoint environment (usize_add environment_units environment_units) owner process_number_24)
                                (fun (separate : Bool) => match separate with | False => runtime_pure Bool False | True =>
                                  raw_process_arguments_valid arguments count owner one end) end) end) end) end) end end) end);

def raw_process_start_owned (executable : RawPtr U8) (executable_units : USize)
    (arguments : RawPtr U8) (count : USize) (environment : RawPtr U8) (directory : RawPtr U8)
    (input : RawPtr U8) (output : RawPtr U8) (error : RawPtr U8) (owner : RawPtr U8) (one : USize) : Runtime U32 :=
    let command_bytes : USize := usize_shift_left one (raw_size_to_u32 (raw_process_eight (usize_add one one))) in
    runtime_bind (RawPtr U8) U32 (raw_pages_allocate (usize_add command_bytes (raw_process_eight one)) (raw_process_eight one)) (fun (command : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 command) (fun (bits : USize) =>
        match usize_equal bits (usize_sub one one) with | True => runtime_pure U32 (raw_size_to_u32 (raw_process_eight one)) | False =>
          runtime_bind (RawPtr U8) U32 (raw_add U8 command command_bytes) (fun (cursor_bytes : RawPtr U8) =>
            runtime_bind (RawPtr USize) U32 (raw_cast U8 USize cursor_bytes) (fun (cursor : RawPtr USize) =>
              runtime_bind USize U32 (raw_process_build_command executable executable_units arguments count command cursor one)
                (fun (units : USize) => runtime_bind U32 U32 (match usize_less (raw_process_command_limit one) units with
                  | True => runtime_pure U32 (raw_size_to_u32 (usize_add (raw_process_eight (usize_add (raw_process_eight (usize_add one (usize_add one one))) one)) (usize_add (usize_add one (usize_add one one)) (usize_add one (usize_add one one)))))
                  | False => raw_process_launch executable command environment directory input output error owner one end)
                  (fun (result : U32) => runtime_bind Unit U32 (raw_process_release command one)
                    (fun (_released : Unit) => runtime_pure U32 result))))) end));

-- On success owner receives PROCESS_INFORMATION and owns both handles. On
-- failure it is unchanged. Start rejects a nonempty owner to prevent leaks.
-- Status zero is success; all failures are nonzero Win32 status codes.
def raw_windows_process_start (executable : RawPtr U8) (executable_units : USize)
    (arguments : RawPtr U8) (count : USize) (environment : RawPtr U8) (environment_units : USize)
    (directory : RawPtr U8) (directory_units : USize) (input : RawPtr U8)
    (output : RawPtr U8) (error : RawPtr U8) (owner : RawPtr U8) : Runtime U32 :=
    let one : USize := raw_process_one executable_units in
    runtime_bind Bool U32 (raw_process_inputs_valid executable executable_units arguments count environment environment_units
      directory directory_units owner one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
          raw_process_start_owned executable executable_units arguments count environment directory input output error owner one end);
