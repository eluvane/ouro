-- Windows clock values remain exact 64-bit integers. Counter ticks are for
-- intervals; FILETIME is UTC in 100 ns units since 1601-01-01. No epoch or
-- floating-point conversion is hidden in this raw API.
import "windows_common.ouro";

extern windows_query_counter : RawPtr USize -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "QueryPerformanceCounter" "nogc";
extern windows_query_frequency : RawPtr USize -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "QueryPerformanceFrequency" "nogc";
extern windows_precise_file_time : RawPtr USize -> Runtime Unit :=
    "windows-x86_64" "win64" "kernel32.dll" "GetSystemTimePreciseAsFileTime" "nogc";

def raw_windows_clock_restore (output : RawPtr USize) (saved : USize) (error : U32) : Runtime U32 :=
    let result : Runtime U32 := raw_restore_size output saved error in result;

-- Zero status publishes the queried word. Failure preserves the caller's
-- output. The caller owns one live, writable and 8-byte-aligned USize cell.
def raw_windows_clock_query (frequency : Bool) (output : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize output) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bits)))
    | Just one => runtime_bind Bool U32 (raw_windows_size_cell output one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind USize U32 (raw_load_usize output) (fun (saved : USize) =>
            runtime_bind U32 U32 (match frequency with
              | True => windows_query_frequency output | False => windows_query_counter output end)
              (fun (status : U32) => match u32_equal status (u32_sub status status) with
                | True => runtime_bind U32 U32 (raw_windows_last_failure one)
                    (fun (error : U32) => raw_windows_clock_restore output saved error)
                | False => runtime_bind USize U32 (raw_load_usize output) (fun (value : USize) =>
                    match raw_bool_and frequency (usize_equal value (usize_sub one one)) with
                    | True => raw_windows_clock_restore output saved (raw_windows_general_error one)
                    | False => runtime_pure U32 (u32_sub status status) end) end)) end) end;

def raw_windows_counter (output : RawPtr USize) : Runtime U32 := raw_windows_clock_query False output;
def raw_windows_counter_frequency (output : RawPtr USize) : Runtime U32 := raw_windows_clock_query True output;

-- Windows 8 or later is required by the imported precise UTC clock.
def raw_windows_wall_time (output : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize output) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bits)))
    | Just one => runtime_bind Bool U32 (raw_windows_size_cell output one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind Unit U32 (windows_precise_file_time output)
            (fun (_written : Unit) => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) end;
