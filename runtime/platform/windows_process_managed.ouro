-- Shell-free inherited-environment capture. Only the OS-owned environment
-- snapshot bypasses user-supplied block validation (it includes Windows drive
-- pseudo variables); no caller text is accepted through that path. Current
-- directory is inherited by CreateProcessW. Input is a private empty file.
import "windows_process_managed_memory.ouro";
import "windows_temp.ouro";

def raw_process_managed_table_step (owner : RawPtr U8) (table : RawPtr U8) (index : USize) : Runtime USize :=
runtime_bind USize USize (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize USize (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one))) (fun (bits : USize) =>
runtime_bind (RawPtr U8) USize (raw_from_bits U8 bits) (fun (node : (RawPtr U8)) =>
runtime_bind USize USize (raw_process_load node (usize_sub one one)) (fun (next : USize) =>
runtime_bind USize USize (raw_process_load node (raw_process_eight one)) (fun (units : USize) =>
runtime_bind (RawPtr U8) USize (raw_add U8 node (raw_process_eight (usize_add one one))) (fun (text : (RawPtr U8)) =>
runtime_bind USize USize (raw_to_bits U8 text) (fun (text_bits : USize) =>
runtime_bind Unit USize (raw_process_store table (raw_process_eight (usize_add index index)) text_bits) (fun (pointer : Unit) =>
runtime_bind Unit USize (raw_process_store table (usize_add (raw_process_eight (usize_add index index)) (raw_process_eight one)) units) (fun (length : Unit) =>
runtime_bind Unit USize (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one)) next) (fun (advanced : Unit) =>
runtime_pure USize (usize_add index one)))))))))));

def raw_process_managed_spawn_environment (owner : RawPtr U8) (table : RawPtr U8) (count : USize) (environment : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load table (usize_sub one one)) (fun (exe_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 exe_bits) (fun (executable : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load table (raw_process_eight one)) (fun (units : USize) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 table (raw_process_eight (usize_add one one))) (fun (arguments : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one))) (fun (input_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 input_bits) (fun (input : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add one one) one))) (fun (out_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 out_bits) (fun (output : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add one one) one) one))) (fun (err_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 err_bits) (fun (error : (RawPtr U8)) =>
runtime_bind Bool U32 (raw_windows_path_valid executable units one) (fun (valid : Bool) =>
match valid with
| False => runtime_pure U32 (raw_windows_parameter_error one)
| True => runtime_bind USize U32 (raw_process_scan executable units (usize_sub one one) (usize_add (usize_add (raw_process_eight (usize_add (usize_add (usize_add one one) one) one)) one) one) False one) (fun (quote : USize) =>
match usize_equal quote units with
| False => runtime_pure U32 (raw_windows_parameter_error one)
| True => raw_process_start_owned executable units arguments (usize_sub count one)
 environment (raw_null U8) input output error owner one end) end))))))))))));

def raw_process_managed_spawn (owner : RawPtr U8) (table : RawPtr U8) (count : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) U32 (windows_environment_strings) (fun (environment : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 environment) (fun (bits : USize) =>
match usize_equal bits (usize_sub one one) with
| True => raw_windows_last_failure one
| False => runtime_bind U32 U32 (raw_process_managed_spawn_environment owner table count environment) (fun (status : U32) =>
runtime_bind U32 U32 (windows_free_environment_strings environment) (fun (freed : U32) =>
match u32_equal freed (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 (usize_add (raw_process_eight (usize_add (raw_process_eight one) one)) one))) (fun (fatal : Unit) =>
runtime_pure U32 (raw_windows_general_error one))
| False => runtime_pure U32 status end)) end)));

def raw_process_managed_table (owner : RawPtr U8) (table : RawPtr U8) (count : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add one one) one) one) one))) (fun (first : USize) =>
runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one)) first) (fun (cursor : Unit) =>
match u8_from_nat 1 with
| Nothing => runtime_pure U32 (raw_windows_general_error one)
| Just running => runtime_bind USize U32 (runtime_loop USize (usize_sub one one)
(fun (index : USize) => runtime_pure U8 (match usize_less index count with | True => running | False => u8_sub running running end))
(fun (index : USize) => raw_process_managed_table_step owner table index)) (fun (filled : USize) =>
raw_process_managed_spawn owner table count) end)));

def raw_process_managed_launch (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add one one) one) one) one) one) one))) (fun (count : USize) =>
match usize_equal count (usize_sub one one) with
| True => runtime_pure U32 (raw_windows_parameter_error one)
| False => runtime_bind (RawPtr U8) U32 (raw_pages_allocate (raw_process_eight (usize_add count count)) (raw_process_eight one)) (fun (table : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 table) (fun (bits : USize) =>
match usize_equal bits (usize_sub one one) with
| True => runtime_pure U32 (raw_windows_general_error one)
| False => runtime_bind U32 U32 (raw_process_managed_table owner table count) (fun (status : U32) =>
runtime_bind Bool U32 (raw_pages_release table) (fun (freed : Bool) =>
match freed with
| True => runtime_pure U32 status
| False => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 (usize_add (raw_process_eight (usize_add (raw_process_eight one) one)) one))) (fun (fatal : Unit) =>
runtime_pure U32 (raw_windows_general_error one)) end)) end)) end));

def raw_process_managed_read_step (owner : RawPtr U8) (stream : RawPtr U8) (buffer : RawPtr U8) (bytes : USize) (position : USize) : Runtime USize :=
runtime_bind USize USize (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) USize (raw_add U8 buffer position) (fun (target : (RawPtr U8)) =>
runtime_bind (RawPtr U8) USize (raw_add U8 owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one))) (fun (scratch : (RawPtr U8)) =>
runtime_bind (RawPtr U32) USize (raw_cast U8 U32 scratch) (fun (count : (RawPtr U32)) =>
runtime_bind U32 USize (raw_windows_file_read stream target (match usize_less (raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight (usize_add one one)))))) (usize_sub bytes position) with | True => (raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight (usize_add one one)))))) | False => usize_sub bytes position end) count) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (usize_sub one one)) with
| False => runtime_pure USize (usize_add bytes one)
| True => runtime_bind U32 USize (raw_load_u32 count) (fun (actual : U32) =>
let transferred : USize := raw_u32_to_size actual in
match raw_bool_and (usize_less (usize_sub one one) transferred) (raw_bool_not (usize_less (usize_sub bytes position) transferred)) with
| True => runtime_pure USize (usize_add position transferred)
| False => runtime_pure USize (usize_add bytes one) end) end)))));

def raw_process_managed_read_loop (owner : RawPtr U8) (stream : RawPtr U8) (buffer : RawPtr U8) (bytes : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
match u8_from_nat 1 with
| Nothing => runtime_pure U32 (raw_windows_general_error one)
| Just running => runtime_bind USize U32 (runtime_loop USize (usize_sub one one)
(fun (position : USize) => runtime_pure U8 (match usize_less position bytes with | True => running | False => u8_sub running running end))
(fun (position : USize) => raw_process_managed_read_step owner stream buffer bytes position)) (fun (finished : USize) =>
runtime_pure U32 (match usize_equal finished bytes with
| True => raw_size_to_u32 (usize_sub one one) | False => raw_windows_general_error one end)) end);

def raw_process_managed_read (owner : RawPtr U8) (handle_offset : USize) (data_offset : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner handle_offset) (fun (bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (stream : (RawPtr U8)) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 owner (usize_add data_offset (raw_process_eight one))) (fun (length_bytes : (RawPtr U8)) =>
runtime_bind (RawPtr USize) U32 (raw_cast U8 USize length_bytes) (fun (length : (RawPtr USize)) =>
runtime_bind U32 U32 (raw_windows_file_length stream length) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (usize_sub one one)) with
| False => runtime_pure U32 status
| True => runtime_bind USize U32 (raw_load_usize length) (fun (bytes : USize) =>
match usize_equal bytes (usize_sub one one) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes (raw_process_eight one)) (fun (buffer : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 buffer) (fun (data : USize) =>
match usize_equal data (usize_sub one one) with
| True => runtime_pure U32 (raw_windows_general_error one)
| False => runtime_bind Unit U32 (raw_process_store owner data_offset data) (fun (owned : Unit) =>
raw_process_managed_read_loop owner stream buffer bytes) end)) end) end))))));

def raw_process_managed_wait_read (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (usize_sub one one)) (fun (bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (process : (RawPtr U8)) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one))) (fun (code_bytes : (RawPtr U8)) =>
runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 code_bytes) (fun (code : (RawPtr U32)) =>
runtime_bind U32 U32 (raw_windows_process_wait process (u32_sub (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 one)) code) (fun (waited : U32) =>
match u32_equal waited (raw_size_to_u32 (usize_sub one one)) with
| False => runtime_bind U32 U32 (raw_windows_process_cancel process (raw_size_to_u32 (usize_add (raw_process_eight (usize_add (raw_process_eight one) one)) one)) (u32_sub (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 one)) code) (fun (cancelled : U32) =>
runtime_pure U32 waited)
| True => runtime_bind U32 U32 (raw_windows_process_capture_rewind owner) (fun (rewound : U32) =>
match u32_equal rewound (raw_size_to_u32 (usize_sub one one)) with
| False => runtime_pure U32 rewound
| True => runtime_bind U32 U32 (raw_process_managed_read owner (raw_process_eight (usize_add (usize_add one one) one)) (raw_process_eight (raw_process_eight one))) (fun (output : U32) =>
match u32_equal output (raw_size_to_u32 (usize_sub one one)) with
| False => runtime_pure U32 output | True => raw_process_managed_read owner (raw_process_eight (usize_add (usize_add (usize_add one one) one) one)) (raw_process_eight (usize_add (usize_add (raw_process_eight one) one) one)) end) end) end))))));

def raw_process_managed_launched (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_process_managed_launch owner) (fun (status : U32) =>
-- Raw workspace exhaustion/general invariant failure is not a child exit.
match (match u32_equal status (raw_size_to_u32 (raw_process_eight one)) with
  | True => True | False => u32_equal status (raw_windows_general_error one) end) with
| True => runtime_pure U32 status
| False =>
match u32_equal status (raw_size_to_u32 (usize_sub one one)) with
| True => raw_process_managed_wait_read owner
| False => runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one)) (raw_u32_to_size status)) (fun (error : Unit) =>
runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one)) (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one)) one) one) one) one) one) one) one)) (fun (code : Unit) =>
runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))) end end));

def raw_windows_process_managed_run (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) U32 (raw_add U8 owner (raw_process_eight (usize_add (usize_add one one) one))) (fun (cell24 : (RawPtr U8)) =>
runtime_bind (RawPtr USize) U32 (raw_cast U8 USize cell24) (fun (handle24 : (RawPtr USize)) =>
runtime_bind U32 U32 (raw_windows_temp_capture handle24) (fun (opened24 : U32) =>
match u32_equal opened24 (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind (RawPtr U8) U32 (raw_add U8 owner (raw_process_eight (usize_add (usize_add (usize_add one one) one) one))) (fun (cell32 : (RawPtr U8)) =>
runtime_bind (RawPtr USize) U32 (raw_cast U8 USize cell32) (fun (handle32 : (RawPtr USize)) =>
runtime_bind U32 U32 (raw_windows_temp_capture handle32) (fun (opened32 : U32) =>
match u32_equal opened32 (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind (RawPtr U8) U32 (raw_add U8 owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one))) (fun (cell112 : (RawPtr U8)) =>
runtime_bind (RawPtr USize) U32 (raw_cast U8 USize cell112) (fun (handle112 : (RawPtr USize)) =>
runtime_bind U32 U32 (raw_windows_temp_capture handle112) (fun (opened112 : U32) =>
match u32_equal opened112 (raw_size_to_u32 (usize_sub one one)) with
| True => raw_process_managed_launched owner
| False => runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one)) (raw_u32_to_size opened112)) (fun (error : Unit) =>
runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one)) (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one)) one) one) one) one) one) one) one)) (fun (code : Unit) =>
runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))) end)))
| False => runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one)) (raw_u32_to_size opened32)) (fun (error : Unit) =>
runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one)) (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one)) one) one) one) one) one) one) one)) (fun (code : Unit) =>
runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))) end)))
| False => runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one)) (raw_u32_to_size opened24)) (fun (error : Unit) =>
runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one)) (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one)) one) one) one) one) one) one) one)) (fun (code : Unit) =>
runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))) end))));

