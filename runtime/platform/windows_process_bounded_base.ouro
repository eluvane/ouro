-- Private sequential captured-process owner; no callback or worker pool.
-- 0..127 retain the ordinary capture layout. Extension (all 8-byte slots):
-- 128 job, 136 completion port, 144 timeout ms, 152 memory MiB/bytes,
-- 160 CPU count, 168 stdout cap, 176 stderr cap, 184 outcome kind,
-- 192 detail, 200 maximum observed job commit, 208 execution start tick,
-- 216 cleanup start tick, 224 272-byte workspace, 232 quiesced,
-- 240 completion queue observed empty, 248 completion read error.
-- Kinds: 0 child exit; 1 OS; 2 timeout; 3 cleanup; 4 invalid limits;
-- 5 observed memory limit; 6 stdout overflow; 7 stderr overflow.
import "windows_process_inherit_launch.ouro";

extern windows_capture_port_create : RawPtr U8 -> RawPtr U8 -> USize -> U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "CreateIoCompletionPort" "nogc";
extern windows_capture_port_next : RawPtr U8 -> RawPtr U32 -> RawPtr USize -> RawPtr USize -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetQueuedCompletionStatus" "nogc";
extern windows_capture_job_query : RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "QueryInformationJobObject" "nogc";
extern windows_capture_job_terminate : RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TerminateJobObject" "nogc";
extern windows_capture_affinity : RawPtr U8 -> RawPtr USize -> RawPtr USize -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetProcessAffinityMask" "nogc";
extern windows_capture_ticks : Runtime U64 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetTickCount64" "nogc";

def raw_capture_or (first : Bool) (second : Bool) : Bool :=
    match first with | True => True | False => second end;

