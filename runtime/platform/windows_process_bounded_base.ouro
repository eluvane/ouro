def raw_capture_result (owner : RawPtr U8) (kind : USize) (detail : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_outcome one) kind) (fun (_tag : Unit) =>
  runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_detail one) detail) (fun (_value : Unit) =>
  runtime_pure(U32, raw_size_to_u32 (usize_sub one one)))));

def raw_capture_note (owner : RawPtr U8) (kind : USize) (detail : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_outcome one)) (fun (current : USize) =>
  match usize_equal(current, usize_sub one one) with
| True => raw_capture_result owner kind detail
| False => runtime_pure(U32, raw_size_to_u32 (usize_sub one one)) end));

def raw_capture_resource (owner : RawPtr U8) (message : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_outcome one)) (fun (current : USize) =>
  match usize_equal(current, usize_add(usize_add one one, one)) with
| True => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))
| False => raw_capture_result owner (usize_add(usize_add(usize_add one one, usize_add one one), one)) message end));

def raw_capture_os (owner : RawPtr U8) (status : U32) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
raw_capture_result owner one (raw_u32_to_size status));

def raw_capture_time (owner : RawPtr U8) (offset : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U64 U32 (windows_capture_ticks) (fun (ticks : U64) =>
  runtime_bind Unit U32 (raw_process_store owner offset (u64_to_usize ticks)) (fun (_saved : Unit) =>
  runtime_pure(U32, raw_size_to_u32 (usize_sub one one)))));

def raw_capture_elapsed (owner : RawPtr U8) (offset : USize) : Runtime USize :=
    runtime_bind USize USize (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let _one : USize := raw_process_one anchor in
runtime_bind USize USize (raw_process_load owner offset) (fun (started : USize) =>
  runtime_bind U64 USize (windows_capture_ticks) (fun (ticks : U64) =>
  runtime_pure(USize, usize_sub(u64_to_usize ticks, started)))));

def raw_capture_open (owner : RawPtr U8) (offset : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let _one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) U32 (raw_add U8 owner offset) (fun (bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize bytes) (fun (cell : RawPtr USize) =>
    raw_windows_temp_capture cell)));

def raw_capture_input_step (owner : RawPtr U8) (input : RawPtr U8) (source : RawPtr U8) (bytes : USize) (offset : USize) : Runtime USize :=
    runtime_bind USize USize (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) USize (raw_add U8 owner (raw_capture_owner_stdin_written one)) (fun (count_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U32) USize (raw_cast U8 U32 count_bytes) (fun (count : (RawPtr U32)) =>
  runtime_bind (RawPtr U8) USize (raw_add U8 source offset) (fun (cursor : (RawPtr U8)) =>
  runtime_bind U32 USize (raw_windows_file_write input cursor (match usize_less(usize_sub bytes offset, usize_shift_left(one, raw_size_to_u32 (usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one)))))) with | True => usize_sub bytes offset | False => (usize_shift_left(one, raw_size_to_u32 (usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one)))))) end) count) (fun (status : U32) =>
  match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 USize (raw_load_u32 count) (fun (actual : U32) =>
  match u32_equal(actual, raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind Unit USize (raw_process_store(owner, raw_capture_owner_conversion_error one, usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add one one, usize_add one one), one))))) (fun (_saved : Unit) =>
  runtime_pure USize bytes)
| False => runtime_pure(USize, usize_add(offset, raw_u32_to_size actual)) end)
| False => runtime_bind Unit USize (raw_process_store(owner, raw_capture_owner_conversion_error one, raw_u32_to_size status)) (fun (_saved : Unit) =>
  runtime_pure USize bytes) end)))));

def raw_windows_process_bounded_input (owner : RawPtr U8) (source : RawPtr U8) (bytes : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (runtime_bind U32 U32 (raw_capture_open(owner, usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, usize_add one one), one))), usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))))))) (fun (opened : U32) =>
  match u32_equal(opened, raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_stdin_handle one)) (fun (input_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 input_bits) (fun (input : (RawPtr U8)) =>
  match u8_from_nat 1 with | Nothing => runtime_pure(U32, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)), one))))) | Just running => runtime_bind USize U32 (runtime_loop USize (usize_sub one one)
(fun (offset : USize) => runtime_pure(U8, match usize_less offset bytes with | True => running | False => u8_sub running running end))
(fun (offset : USize) => raw_capture_input_step owner input source bytes offset)) (fun (_written : USize) =>
  runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_conversion_error one)) (fun (status : USize) =>
  match usize_equal(status, usize_sub one one) with
| True => raw_windows_process_rewind input
| False => runtime_pure(U32, raw_size_to_u32 status) end)) end))
| False => runtime_pure U32 opened end)) (fun (status : U32) =>
  runtime_bind Unit U32 (raw_process_store(owner, raw_capture_owner_conversion_error one, raw_u32_to_size status)) (fun (_saved : Unit) =>
  runtime_pure(U32, raw_size_to_u32 (usize_sub one one)))));

def raw_capture_validate (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_timeout one)) (fun (timeout : USize) =>
  runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_memory one)) (fun (memory : USize) =>
  runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_cpu_count one)) (fun (cpus : USize) =>
  runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_stdout_cap one)) (fun (output : USize) =>
  runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_stderr_cap one)) (fun (error : USize) =>
  match raw_bool_and(usize_less(usize_sub one one, timeout), usize_less(timeout, usize_sub(usize_shift_left(one, raw_size_to_u32 (usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, usize_add one one), one))))), one))) with
| True => match raw_bool_and(usize_less(usize_sub one one, memory), raw_bool_not (usize_less(usize_sub(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, usize_add one one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add one one, usize_add one one))))), one), memory))) with
| True => match usize_equal cpus one with
| True => match raw_bool_not (usize_less(usize_sub(usize_sub(usize_sub one one, one), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, usize_add one one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)), one)))), output)) with
| True => match raw_bool_not (usize_less(usize_sub(usize_sub(usize_sub one one, one), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, usize_add one one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)), one)))), error)) with
| True => runtime_bind Unit U32 (raw_process_store(owner, raw_capture_owner_memory one, usize_shift_left(memory, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))), usize_add(usize_add one one, usize_add one one)))))) (fun (_scaled : Unit) =>
  runtime_pure(U32, raw_size_to_u32 (usize_sub one one)))
| False => raw_capture_result(owner, usize_add(usize_add one one, usize_add one one), usize_add(usize_add(usize_add one one, usize_add one one), one)) end
| False => raw_capture_result(owner, usize_add(usize_add one one, usize_add one one), usize_add(usize_add one one, usize_add one one)) end
| False => raw_capture_result(owner, usize_add(usize_add one one, usize_add one one), usize_add(usize_add one one, one)) end
| False => raw_capture_result(owner, usize_add(usize_add one one, usize_add one one), usize_add one one) end
| False => raw_capture_result owner (usize_add(usize_add one one, usize_add one one)) one end))))));
