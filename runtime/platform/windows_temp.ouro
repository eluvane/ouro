-- Fixed workspace: 65536 bytes UTF-16, 98304 bytes UTF-8, then
-- security/random scratch. Never pass a managed pointer to these helpers.
import "windows_temp_create.ouro";

def raw_temp_create_core (source : RawPtr U8) (bytes : USize) (in_directory : Bool)
    (storage : RawPtr U8) (count : RawPtr U32) (owner : RawPtr USize)
    (capture : Bool) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind Unit U32 (raw_store_usize owner zero) (fun (_ : Unit) =>
      runtime_bind U32 U32 (raw_temp_directory source bytes in_directory storage count one) (fun (status : U32) =>
        match u32_equal status (raw_size_to_u32 zero) with | False => runtime_pure U32 status
        | True => runtime_bind U32 U32 (raw_load_u32 count) (fun (length : U32) =>
            let units : USize := raw_u32_to_size length in
            match raw_bool_and (usize_less zero units) (usize_less units (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 two)) two)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 two)) one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) four))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) two))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) one))) (usize_add (usize_shift_left one (raw_size_to_u32 eight)) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one)))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) two)))))))))))) with
            | False => runtime_pure U32 (raw_windows_general_error one)
            | True => runtime_bind (RawPtr U8) U32 (raw_add U8 storage (usize_shift_left one (raw_size_to_u32 sixteen))) (fun (output : RawPtr U8) =>
                runtime_bind (RawPtr U8) U32 (raw_add U8 storage (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 four)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))))))) (fun (scratch : RawPtr U8) =>
                  raw_temp_create_ready storage units output scratch count owner capture one)) end) end));

-- Success zero: closed, empty private named file, UTF-8 bytes at offset
-- 65536 and exact byte count published. Caller owns removal. One is an
-- ordinary OS failure. Other statuses are raw/text/cleanup failures.
-- storage is a live aligned 196608-byte owner; source and count are disjoint.
def raw_windows_temp_create (source : RawPtr U8) (bytes : USize) (in_directory : Bool)
    (storage : RawPtr U8) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bytes)) (fun (_ : Unit) => runtime_pure U32 (raw_size_to_u32 bytes))
    | Just one =>
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind USize U32 (raw_to_bits U8 storage) (fun (address : USize) =>
      match usize_equal (usize_and address (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) zero with
      | False => runtime_pure U32 (raw_windows_parameter_error one)
      | True => runtime_bind Bool U32 (raw_windows_conversion_storage source bytes storage (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 four)) one))) (usize_shift_left one (raw_size_to_u32 sixteen))) count one) (fun (valid : Bool) =>
          match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
          | True => runtime_bind (RawPtr U8) U32 (raw_add U8 storage (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 four)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) one))) eight)))) (fun (cell : RawPtr U8) =>
              runtime_bind (RawPtr USize) U32 (raw_cast U8 USize cell) (fun (owner : RawPtr USize) =>
                raw_temp_create_core source bytes in_directory storage count owner False one)) end) end) end;

-- Capture transfers a fresh non-inheritable read/write DELETE_ON_CLOSE
-- handle into an aligned, zero owner cell. Capture files omit
-- FILE_ATTRIBUTE_TEMPORARY so a killed writer cannot drop already-written
-- bytes from the cache. Zero succeeds; one is OS failure.
-- Invalid storage, encoding, allocation and cleanup terminate with 73.
def raw_temp_capture_storage (owner : RawPtr USize) (storage : RawPtr U8) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind (RawPtr U8) U32 (raw_add U8 storage (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 four)) one))) (usize_shift_left one (raw_size_to_u32 sixteen)))) (fun (cell : RawPtr U8) =>
      runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 cell) (fun (count : RawPtr U32) =>
        runtime_bind U32 U32 (raw_temp_create_core (raw_null U8) zero False storage count owner True one) (fun (status : U32) =>
          runtime_bind Bool U32 (raw_pages_release storage) (fun (released : Bool) =>
            match raw_bool_and released (raw_bool_not (u32_less (raw_size_to_u32 one) status)) with
            | True => runtime_pure U32 status
            | False => runtime_bind USize U32 (raw_load_usize owner) (fun (bits : USize) =>
                runtime_bind U32 U32 (match usize_equal bits zero with
                  | True => runtime_pure U32 (raw_size_to_u32 zero)
                  | False => runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (stream_handle : RawPtr U8) => raw_windows_file_close stream_handle) end)
                  (fun (_ : U32) => raw_temp_panic one)) end))));

def raw_windows_temp_capture (owner : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize owner) (fun (anchor : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 anchor))
          (fun (_ : Unit) => runtime_pure U32 (raw_size_to_u32 anchor)))
    | Just one =>
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind Bool U32 (raw_windows_size_cell owner one) (fun (valid : Bool) =>
      match valid with | False => raw_temp_panic one | True =>
        runtime_bind USize U32 (raw_load_usize owner) (fun (previous : USize) =>
          match usize_equal previous zero with | False => raw_temp_panic one | True =>
            runtime_bind (RawPtr U8) U32 (raw_pages_allocate (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 four)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 sixteen)) eight)) eight) (fun (storage : RawPtr U8) =>
              runtime_bind USize U32 (raw_to_bits U8 storage) (fun (bits : USize) =>
                match usize_equal bits zero with | True => raw_temp_panic one
                | False => raw_temp_capture_storage owner storage one end)) end) end) end;
