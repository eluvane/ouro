-- A successful attempt publishes one live handle. No conversion or allocation
-- occurs after CreateFileW. Two alone means collision and authorizes retry.
import "windows_temp_base.ouro";

def raw_temp_attempt (wide : RawPtr U8) (start : USize) (output : RawPtr U8)
    (scratch : RawPtr U8) (count : RawPtr U32) (owner : RawPtr USize)
    (capture : Bool) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind (RawPtr U8) U32 (raw_add U8 scratch (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))))) (fun (random : RawPtr U8) =>
      runtime_bind U32 U32 (windows_temp_random (raw_null U8) random (raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) one)))) (raw_size_to_u32 two))
        (fun (random_status : U32) => match u32_equal random_status (raw_size_to_u32 zero) with
          | False => runtime_pure U32 (raw_size_to_u32 one)
          | True => runtime_bind Unit U32 (raw_temp_hex wide start random one) (fun (_ : Unit) =>
              runtime_bind U32 U32 (raw_windows_utf16_to_utf8 wide (usize_add start (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) one)))) output (usize_add (usize_shift_left one (raw_size_to_u32 sixteen)) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one)))))) count)
                (fun (converted : U32) => match u32_equal converted (raw_size_to_u32 zero) with
                  | False => runtime_pure U32 (raw_windows_general_error one)
                  | True => runtime_bind (RawPtr U8) U32 (windows_create_file wide
                      (raw_size_to_u32 (usize_add
                        (usize_shift_left (usize_add two one) (raw_size_to_u32 (usize_sub (usize_add sixteen sixteen) two)))
                        (match capture with | False => zero | True => usize_shift_left one (raw_size_to_u32 sixteen) end)))
                      (raw_size_to_u32 zero) scratch (raw_size_to_u32 one)
                      (raw_size_to_u32 (match capture with
                        | False => usize_shift_left one (raw_size_to_u32 eight)
                        | True => usize_shift_left one (raw_size_to_u32 (usize_add sixteen (usize_add eight two))) end)) (raw_null U8))
                      (fun (stream_handle : RawPtr U8) => runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one)
                        (fun (opened : Bool) => match opened with
                          | True => runtime_bind USize U32 (raw_to_bits U8 stream_handle) (fun (bits : USize) =>
                              runtime_bind Unit U32 (raw_store_usize owner bits) (fun (_ : Unit) => runtime_pure U32 (raw_size_to_u32 zero)))
                          | False => runtime_bind U32 U32 windows_get_last_error (fun (error : U32) =>
                              runtime_pure U32 (match u32_equal error (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) two))) sixteen)) with | True => raw_size_to_u32 two
                                | False => match u32_equal error (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 four)) (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one)))))) with | True => raw_size_to_u32 two
                                  | False => raw_size_to_u32 one end end)) end)) end)) end));

-- Attempt counter is a machine word; only CREATE_NEW collisions retry.
def raw_temp_attempts (wide : RawPtr U8) (start : USize) (output : RawPtr U8)
    (scratch : RawPtr U8) (count : RawPtr U32) (owner : RawPtr USize)
    (capture : Bool) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind (RawPtr U8) U32 (raw_add U8 scratch (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) one))) sixteen)) (fun (cell : RawPtr U8) =>
      runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 cell) (fun (status_cell : RawPtr U32) =>
        runtime_bind Unit U32 (raw_store_u32 status_cell (raw_size_to_u32 two)) (fun (_ : Unit) =>
          match u8_from_nat 1 with | Nothing => raw_temp_panic one | Just running =>
            runtime_bind USize U32 (runtime_loop USize zero
              (fun (attempt : USize) => runtime_bind U32 U8 (raw_load_u32 status_cell) (fun (status : U32) =>
                runtime_pure U8 (match raw_bool_and (usize_less attempt (usize_shift_left one (raw_size_to_u32 eight))) (u32_equal status (raw_size_to_u32 two)) with
                  | True => running | False => u8_sub running running end)))
              (fun (attempt : USize) => runtime_bind U32 USize
                (raw_temp_attempt wide start output scratch count owner capture one) (fun (status : U32) =>
                  runtime_bind Unit USize (raw_store_u32 status_cell status)
                    (fun (_ : Unit) => runtime_pure USize (usize_add attempt one)))))
              (fun (_ : USize) => runtime_bind U32 U32 (raw_load_u32 status_cell) (fun (status : U32) =>
                runtime_pure U32 (match u32_equal status (raw_size_to_u32 two) with | True => raw_size_to_u32 one | False => status end))) end)));

-- Release the OS-allocated DACL before transferring a named file or handle.
-- Failure closes the unpublished owner and tries to remove the named file.
def raw_temp_security_release (wide : RawPtr U8) (scratch : RawPtr U8) (owner : RawPtr USize)
    (capture : Bool) (status : U32) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind (RawPtr U8) U32 (raw_add U8 scratch (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) one)))) (fun (cell : RawPtr U8) =>
      runtime_bind (RawPtr USize) U32 (raw_cast U8 USize cell) (fun (descriptor : RawPtr USize) =>
        runtime_bind USize U32 (raw_load_usize descriptor) (fun (bits : USize) =>
          runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (security : RawPtr U8) =>
            runtime_bind (RawPtr U8) U32 (windows_local_free security) (fun (remaining : RawPtr U8) =>
              runtime_bind USize U32 (raw_to_bits U8 remaining) (fun (left : USize) =>
                runtime_bind USize U32 (raw_load_usize owner) (fun (handle_bits : USize) =>
                  match usize_equal handle_bits zero with
                  | True => runtime_pure U32 (match usize_equal left zero with | True => status | False => raw_windows_general_error one end)
                  | False => match raw_bool_and capture (usize_equal left zero) with
                    | True => runtime_pure U32 status
                    | False => runtime_bind (RawPtr U8) U32 (raw_from_bits U8 handle_bits) (fun (stream_handle : RawPtr U8) =>
                        runtime_bind U32 U32 (raw_windows_file_close stream_handle) (fun (closed : U32) =>
                          runtime_bind Unit U32 (raw_store_usize owner zero) (fun (_ : Unit) =>
                            match raw_bool_and (usize_equal left zero) (u32_equal closed (raw_size_to_u32 zero)) with
                            | True => runtime_pure U32 status
                            | False => runtime_bind U32 U32 (windows_delete_file wide)
                                (fun (_ : U32) => raw_temp_panic one) end))) end end)))))));

def raw_temp_create_ready (wide : RawPtr U8) (units : USize) (output : RawPtr U8)
    (scratch : RawPtr U8) (count : RawPtr U32) (owner : RawPtr USize)
    (capture : Bool) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    match u8_from_nat 0 with | Nothing => raw_temp_panic one | Just nul =>
      runtime_bind Unit U32 (raw_temp_ascii wide units nul one) (fun (_ : Unit) =>
        runtime_bind Bool U32 (raw_windows_path_valid wide units one) (fun (valid : Bool) =>
          match valid with | False => runtime_pure U32 (raw_windows_general_error one)
          | True => runtime_bind USize U32 (raw_windows_wide_unit wide (usize_sub units one) one) (fun (last : USize) =>
              runtime_bind USize U32 (match raw_bool_and (raw_bool_not (usize_equal last (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 two)) (usize_add (usize_shift_left one (raw_size_to_u32 one)) one)))))) (raw_bool_not (usize_equal last (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 two)) two))) (usize_add (usize_shift_left one (raw_size_to_u32 four)) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 one)) one))) four))))) with
                | False => runtime_pure USize units
                | True => match u8_from_nat 47 with | Nothing => runtime_bind U32 USize (raw_temp_panic one) (fun (_ : U32) => runtime_pure USize zero)
                  | Just slash => runtime_bind Unit USize (raw_temp_ascii wide units slash one)
                      (fun (_ : Unit) => runtime_pure USize (usize_add units one)) end end) (fun (start : USize) =>
                runtime_bind U32 U32 (raw_temp_security_make scratch one) (fun (security_status : U32) =>
                  match u32_equal security_status (raw_size_to_u32 zero) with | False => runtime_pure U32 security_status
                  | True => runtime_bind U32 U32 (raw_temp_attempts wide start output scratch count owner capture one)
                      (fun (status : U32) => raw_temp_security_release wide scratch owner capture status one) end))) end)) end;
