-- A header name is an ASCII HTTP token. Values reject all control bytes,
-- CR, LF, DEL and NUL. An invalid header fails the request; none are dropped.
import "windows_http_open.ouro";

def raw_windows_http_header (ctx : RawPtr U8) (name : RawPtr U8) (names : USize) (value : RawPtr U8) (values : USize) (one : USize) : Runtime U32 :=
    runtime_bind Bool U32 (raw_http_context_valid ctx one) (fun (valid : Bool) =>
match valid with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True =>
    match raw_bool_and (raw_bool_not (usize_less (raw_windows_int_max one) names)) (raw_bool_not (usize_less (raw_windows_int_max one) values)) with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True =>
let total : USize := usize_add (usize_add names values) (raw_http_c2 one) in
match raw_bool_and (usize_less total (raw_windows_int_max one)) (raw_bool_not (usize_equal names (raw_http_c0 one))) with | False => raw_http_error ctx (raw_windows_parameter_error one) one | True => runtime_bind Bool U32 (raw_http_text_valid name names one one) (fun (name_valid : Bool) =>
runtime_bind Bool U32 (raw_http_text_valid value values (raw_http_c2 one) one) (fun (value_valid : Bool) =>
match raw_bool_and name_valid value_valid with | False => raw_http_error ctx (raw_windows_parameter_error one) one | True =>
let name_bytes : USize := usize_add names names in
let value_bytes : USize := usize_add values values in
let allocation : USize := usize_add (usize_add total total) (raw_http_c2 one) in
runtime_bind (RawPtr U8) U32 (raw_pages_allocate allocation (raw_http_c8 one)) (fun (line : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 line) (fun (bits : USize) =>
match usize_equal bits (raw_http_c0 one) with | True => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | False => runtime_bind U32 U32 (runtime_bind Bool U32 (raw_buffer_copy line allocation name name_bytes name_bytes) (fun (copied : Bool) =>
match copied with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True => runtime_bind (RawPtr U8) U32 (raw_add U8 line name_bytes) (fun (colon : (RawPtr U8)) =>
runtime_bind Unit U32 (match u8_from_nat 58 with | Nothing => windows_exit_process (raw_size_to_u32 (raw_http_c73 one)) | Just byte => runtime_bind (RawPtr U8) Unit (raw_add U8 colon (raw_http_c0 one)) (fun (p : RawPtr U8) => raw_store_u8 p byte) end) (fun (_ : Unit) =>
runtime_bind Unit U32 (match u8_from_nat 32 with | Nothing => windows_exit_process (raw_size_to_u32 (raw_http_c73 one)) | Just byte_0 => runtime_bind (RawPtr U8) Unit (raw_add U8 colon (raw_http_c2 one)) (fun (p : RawPtr U8) => raw_store_u8 p byte_0) end) (fun (_ : Unit) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 colon (raw_http_c4 one)) (fun (destination : (RawPtr U8)) =>
runtime_bind Bool U32 (raw_buffer_copy destination value_bytes value value_bytes value_bytes) (fun (copied_0 : Bool) =>
match copied_0 with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True => runtime_bind (RawPtr U8) U32 (raw_http_handle ctx (raw_http_c16 one)) (fun (request : (RawPtr U8)) =>
runtime_bind U32 U32 (windows_http_header request line (raw_size_to_u32 total) (raw_size_to_u32 (raw_http_c536870912 one))) (fun (added : U32) =>
raw_http_bool ctx added one)) end))))) end)) (fun (status : U32) =>
runtime_bind Bool U32 (raw_pages_release line) (fun (released : Bool) =>
match released with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True => runtime_pure U32 status end)) end)) end)) end end end);
