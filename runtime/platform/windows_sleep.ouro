-- Sequential managed Runtime delay through an ordinary Win64 extern.
-- The input remains an unbounded Nat. Only the fixed one-second interval
-- reaches DWORD, so neither multiplication overflow nor INFINITE is possible.
import "windows_x64.ouro";

def windows_sleep (milliseconds : U32) : Runtime Unit :=
    windows_capture_sleep milliseconds;

inductive WindowsSleepError : Type :=
  | WindowsSleepMillisecondsUnavailable : WindowsSleepError
  | WindowsSleepLoopFlagUnavailable : WindowsSleepError;

def WindowsSleepResult : Type := Either WindowsSleepError Unit;

def windows_sleep_milliseconds_per_second : Nat := 1000;

-- Sleep is void: it has no OS failure status and does not authorize reading
-- GetLastError. Constant-conversion failure remains an explicit typed error.
-- The loop retains its current Nat through each managed Runtime action;
-- it does not construct n pending actions or recurse n frames in advance.
def windows_sleep_seconds (seconds : Nat) : Runtime WindowsSleepResult :=
    match u32_from_nat windows_sleep_milliseconds_per_second with
    | Nothing => runtime_pure WindowsSleepResult
        (Left WindowsSleepError Unit WindowsSleepMillisecondsUnavailable)
    | Just milliseconds => match u8_from_nat 1 with
        | Nothing => runtime_pure WindowsSleepResult
            (Left WindowsSleepError Unit WindowsSleepLoopFlagUnavailable)
        | Just running => runtime_bind Nat WindowsSleepResult
            (runtime_loop Nat seconds
              (fun (remaining : Nat) => runtime_pure U8
                (match remaining with
                 | Z => u8_sub running running
                 | S _ => running end))
              (fun (remaining : Nat) => match remaining with
                | Z => runtime_pure Nat Z
                | S rest => runtime_bind Unit Nat (windows_sleep milliseconds)
                    (fun (_ : Unit) => runtime_pure Nat rest) end))
            (fun (_ : Nat) => runtime_pure WindowsSleepResult
              (Right WindowsSleepError Unit MkUnit))
        end
    end;
