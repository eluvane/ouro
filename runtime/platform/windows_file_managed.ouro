-- Operations needed by the managed file adapters. Successful open publishes
-- ownership before validation/truncation, so every later failure can close it.
import "windows_file.ouro";

extern windows_file_size : RawPtr U8 -> RawPtr USize -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFileSizeEx" "nogc";
extern windows_file_information : RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFileInformationByHandleEx" "nogc";
extern windows_file_set_end : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "SetEndOfFile" "nogc";

-- OPEN_ALWAYS with FILE_FLAG_OPEN_REPARSE_POINT does not truncate a target.
-- The owner cell is unchanged on failure. Call prepare_write on this handle
-- before writing; a successful open must be closed even if preparation fails.
def raw_windows_file_open_write (path : RawPtr U8) (units : USize) (owner : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 units))
    | Just one =>
        let zero : USize := usize_sub one one in
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let sixteen : USize := usize_add eight eight in
        let thirty : USize := usize_sub(usize_add sixteen sixteen, two) in
        let twentyone : USize := usize_add(sixteen, usize_add four one) in
        let access : U32 := raw_size_to_u32 (usize_shift_left(one, raw_size_to_u32 thirty)) in
        let flags : U32 := raw_size_to_u32 (usize_add
          (usize_shift_left(one, raw_size_to_u32 (usize_sub eight one)))
          (usize_shift_left(one, raw_size_to_u32 twentyone))) in
        runtime_bind (RawPtr U8) U32 (raw_cast USize U8 owner) (fun (cell : RawPtr U8) =>
          runtime_bind Bool U32 (raw_windows_path_output path units cell eight eight one) (fun (valid : Bool) =>
            match valid with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
              runtime_bind (RawPtr U8) U32 (windows_create_file path access (raw_size_to_u32 zero)
                (raw_null U8) (raw_size_to_u32 four) flags (raw_null U8)) (fun (stream_handle : RawPtr U8) =>
                  runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (opened : Bool) =>
                    match opened with | False => raw_windows_last_failure one | True =>
                      runtime_bind USize U32 (raw_to_bits U8 stream_handle) (fun (bits : USize) =>
                        runtime_bind Unit U32 (raw_store_usize owner bits)
                          (fun (_stored : Unit) => runtime_pure(U32, raw_size_to_u32 zero))) end)) end)) end;

def raw_windows_file_restore_size (output : RawPtr USize) (saved : USize) (error : U32) : Runtime U32 :=
    let result : Runtime U32 := raw_restore_size output saved error in result;

-- The length is captured once on the already opened handle. The handle is
-- flushed first so a killed writer cannot hide already-written bytes.
-- Failure leaves the aligned, caller-owned USize cell unchanged; negative
-- sizes are rejected.
def raw_windows_file_length (stream_handle : RawPtr U8) (output : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize output) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (_unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 bits)))
    | Just one => runtime_bind Bool U32 (raw_windows_size_cell output one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
          runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (opened : Bool) =>
            match opened with | False => runtime_pure(U32, raw_windows_invalid_handle one) | True =>
              runtime_bind USize U32 (raw_load_usize output) (fun (saved : USize) =>
                runtime_bind U32 U32 (windows_flush_file stream_handle) (fun (_flushed : U32) =>
                runtime_bind U32 U32 (windows_file_size stream_handle output) (fun (status : U32) =>
                  match u32_equal(status, u32_sub status status) with
                  | True => runtime_bind U32 U32 (raw_windows_last_failure one)
                      (fun (error : U32) => raw_windows_file_restore_size output saved error)
                  | False => runtime_bind USize U32 (raw_load_usize output) (fun (length : USize) =>
                      let zero : USize := usize_sub one one in
                      let two : USize := usize_add one one in
                      let four : USize := usize_add two two in
                      let eight : USize := usize_add four four in
                      let sixteen : USize := usize_add eight eight in
                      let thirtytwo : USize := usize_add sixteen sixteen in
                      let shift : USize := usize_sub(usize_add thirtytwo thirtytwo, one) in
                      let maximum : USize := usize_sub(usize_shift_left(one, raw_size_to_u32 shift), one) in
                      match usize_less maximum length with
                      | True => raw_windows_file_restore_size output saved (raw_windows_general_error one)
                      | False => runtime_pure(U32, raw_size_to_u32 zero) end) end))) end) end) end;

-- FileAttributeTagInfo is eight bytes. Check the opened handle's attributes
-- before seeking/truncation, preserving the legacy final-component guard.
-- The caller owns the scratch cell and the handle on every return path.
def raw_windows_file_prepare_write (stream_handle : RawPtr U8) (scratch : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize scratch) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (_unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 bits)))
    | Just one =>
        let zero : USize := usize_sub one one in
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let nine : USize := usize_add eight one in
        let reparse : USize := usize_shift_left(one, raw_size_to_u32 (usize_add eight two)) in
        runtime_bind Bool U32 (raw_windows_size_cell scratch one) (fun (valid : Bool) =>
          match valid with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
            runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (opened : Bool) =>
              match opened with | False => runtime_pure(U32, raw_windows_invalid_handle one) | True =>
                runtime_bind (RawPtr U8) U32 (raw_cast USize U8 scratch) (fun (buffer : RawPtr U8) =>
                  runtime_bind U32 U32 (windows_file_information stream_handle (raw_size_to_u32 nine)
                    buffer (raw_size_to_u32 eight)) (fun (status : U32) =>
                      match u32_equal(status, u32_sub status status) with
                      | True => raw_windows_last_failure one
                      | False => runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 buffer) (fun (attributes : RawPtr U32) =>
                          runtime_bind U32 U32 (raw_load_u32 attributes) (fun (flags : U32) =>
                            match usize_equal(usize_and(raw_u32_to_size flags, reparse), zero) with
                            | False => runtime_pure(U32, raw_size_to_u32 (usize_add four one))
                            | True => runtime_bind U32 U32 (windows_seek_file stream_handle (usize_to_u64 zero)
                                (raw_null U8) (raw_size_to_u32 zero)) (fun (sought : U32) =>
                                  match u32_equal(sought, u32_sub sought sought) with
                                  | True => raw_windows_last_failure one
                                  | False => runtime_bind U32 U32 (windows_file_set_end stream_handle)
                                      (fun (truncated : U32) => raw_windows_bool_status truncated one) end) end)) end)) end) end) end;
