-- Explicit Unicode environment blocks. No parent environment is inherited.
-- Units includes both terminating zero units. Entries are NAME=VALUE, with
-- nonempty names, sorted strictly by case-insensitive ordinal name. Duplicate
-- names, drive-current-directory pseudo variables and malformed UTF-16 fail.
-- Unicode blocks have no invented ANSI 32767-unit limit.
import "windows_process_quote.ouro";

extern windows_compare_ordinal : RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "CompareStringOrdinal" "nogc";

def raw_process_previous_environment (block : RawPtr U8) (start : USize) (one : USize) : Runtime USize :=
    match u8_from_nat 1 with | Nothing => runtime_pure USize start | Just running =>
      runtime_loop USize (usize_sub start one)
        (fun (position : USize) => match usize_equal(position, usize_sub one one) with
          | True => runtime_pure(U8, u8_sub running running)
          | False => runtime_bind USize U8 (raw_windows_wide_unit block (usize_sub position one) one)
              (fun (code : USize) => runtime_pure U8 (match usize_equal(code, usize_sub one one) with
                | True => u8_sub running running | False => running end)) end)
        (fun (position : USize) => runtime_pure(USize, usize_sub position one)) end;

def raw_process_environment_order (block : RawPtr U8) (start : USize)
    (name_end : USize) (one : USize) : Runtime Bool :=
    match usize_equal(start, usize_sub one one) with | True => runtime_pure Bool True | False =>
      runtime_bind USize Bool (raw_process_previous_environment block start one) (fun (previous : USize) =>
        runtime_bind USize Bool (raw_process_scan block (usize_sub start one) previous (usize_add(raw_process_eight (usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one))), usize_add(usize_add one one, usize_add(one, usize_add one one)))) False one)
          (fun (previous_name_end : USize) =>
            runtime_bind (RawPtr U8) Bool (raw_add U8 block (usize_add previous previous)) (fun (left : RawPtr U8) =>
              runtime_bind (RawPtr U8) Bool (raw_add U8 block (usize_add start start)) (fun (right : RawPtr U8) =>
                runtime_bind U32 Bool (windows_compare_ordinal left (raw_size_to_u32 (usize_sub previous_name_end previous))
                  right (raw_size_to_u32 (usize_sub name_end start)) (raw_size_to_u32 one))
                  (fun (comparison : U32) => runtime_pure(Bool, u32_equal(comparison, raw_size_to_u32 one))))))) end;

def raw_process_environment_entry (block : RawPtr U8) (units : USize) (start : USize)
    (end_position : USize) (one : USize) : Runtime USize :=
    runtime_bind USize USize (raw_process_scan block end_position start (usize_add(raw_process_eight (usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one))), usize_add(usize_add one one, usize_add(one, usize_add one one)))) False one) (fun (name_end : USize) =>
      match raw_bool_and(usize_less start name_end, usize_less name_end end_position) with
      | False => runtime_pure USize units
      | True => runtime_bind (RawPtr U8) USize (raw_add U8 block (usize_add start start)) (fun (entry : RawPtr U8) =>
          runtime_bind Bool USize (raw_windows_path_valid entry (usize_sub end_position start) one) (fun (valid : Bool) =>
            match valid with | False => runtime_pure USize units | True =>
              runtime_bind Bool USize (raw_process_environment_order block start name_end one) (fun (ordered : Bool) =>
                runtime_pure USize (match ordered with
                  | True => usize_add end_position one | False => units end)) end)) end);

def raw_process_environment_step (block : RawPtr U8) (units : USize) (start : USize) (one : USize) : Runtime USize :=
    runtime_bind USize USize (raw_process_scan block (usize_sub units one) start (usize_sub one one) False one)
      (fun (end_position : USize) => match raw_bool_and (usize_less start end_position)
        (usize_less(end_position, usize_sub units one)) with
        | False => runtime_pure USize units
        | True => raw_process_environment_entry block units start end_position one end);

def raw_process_environment_valid (block : RawPtr U8) (units : USize) (one : USize) : Runtime Bool :=
    let process_number_0 : USize := (usize_sub one one) in

    match raw_bool_and (raw_bool_not (usize_less(units, usize_add one one)))
      (raw_bool_not (usize_less(raw_windows_int_max one, units))) with
    | False => runtime_pure Bool False
    | True => runtime_bind Bool Bool (raw_windows_wide_aligned block units one) (fun (aligned : Bool) =>
        match aligned with | False => runtime_pure Bool False | True =>
          runtime_bind Bool Bool (raw_buffer_range(block, usize_add units units, process_number_0, usize_add units units)) (fun (range : Bool) =>
            match range with | False => runtime_pure Bool False | True =>
              runtime_bind USize Bool (raw_windows_wide_unit block (usize_sub units one) one) (fun (last : USize) =>
                match usize_equal last process_number_0 with | False => runtime_pure Bool False | True =>
                  runtime_bind USize Bool (raw_windows_wide_unit block process_number_0 one) (fun (first : USize) =>
                    match usize_equal first process_number_0 with
                    | True => runtime_pure(Bool, usize_equal(units, usize_add one one))
                    | False => match u8_from_nat 1 with | Nothing => runtime_pure Bool False | Just running =>
                        runtime_bind USize Bool (runtime_loop USize process_number_0
                          (fun (start : USize) => runtime_pure U8 (match usize_less(start, usize_sub units one) with
                            | True => running | False => u8_sub running running end))
                          (fun (start : USize) => raw_process_environment_step block units start one))
                          (fun (finished : USize) => runtime_pure(Bool, usize_equal(finished, usize_sub units one))) end end) end) end) end) end;
