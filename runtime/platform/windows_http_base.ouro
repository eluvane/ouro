def raw_http_c2 (one : USize) : USize := let half : USize := (raw_http_c1 one) in usize_add half half;
def raw_http_c3 (one : USize) : USize := usize_add(raw_http_c2 one, one);
def raw_http_c4 (one : USize) : USize := let half : USize := (raw_http_c2 one) in usize_add half half;
