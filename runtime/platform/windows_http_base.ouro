def raw_http_context_valid (ctx : RawPtr U8) (one : USize) : Runtime Bool :=
    runtime_bind Bool Bool (raw_buffer_range(ctx, raw_http_c64 one, raw_http_c0 one, raw_http_c64 one)) (fun (range : Bool) =>
match range with | False => runtime_pure Bool False | True => runtime_bind USize Bool (raw_to_bits U8 ctx) (fun (bits : USize) =>
runtime_pure(Bool, usize_equal(usize_and(bits, usize_sub(raw_http_c8 one, one)), raw_http_c0 one))) end);

def raw_http_get (base : RawPtr U8) (offset : USize) : Runtime USize :=
    let result : Runtime USize := raw_load_size_at base offset in result;
def raw_http_put (base : RawPtr U8) (offset : USize) (value : USize) : Runtime Unit :=
    let result : Runtime Unit := raw_store_size_at base offset value in result;
def raw_http_get32 (base : RawPtr U8) (offset : USize) : Runtime U32 :=
    let result : Runtime U32 := raw_load_word_at base offset in result;
def raw_http_put32 (base : RawPtr U8) (offset : USize) (value : U32) : Runtime Unit :=
    let result : Runtime Unit := raw_store_word_at base offset value in result;
def raw_http_handle (base : RawPtr U8) (offset : USize) : Runtime (RawPtr U8) :=
    runtime_bind(USize, RawPtr U8, raw_http_get base offset, fun (bits : USize) => raw_from_bits U8 bits);
def raw_http_save (base : RawPtr U8) (offset : USize) (stream_handle : RawPtr U8) : Runtime Unit :=
    runtime_bind(USize, Unit, raw_to_bits U8 stream_handle, fun (bits : USize) => raw_http_put base offset bits);

-- 0 is success, 1 is an OS/input failure (error cell holds its Win32 code),
-- 2 is an internal storage/conversion/lifetime failure. No partial success.
def raw_http_error (ctx : RawPtr U8) (error : U32) (one : USize) : Runtime U32 :=
    runtime_bind Unit U32 (raw_http_put32 ctx (raw_http_c44 one) error)
      (fun (_ : Unit) => runtime_pure(U32, raw_size_to_u32 one));
def raw_http_failed (ctx : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind(U32, U32, raw_windows_last_failure one, fun (error : U32) => raw_http_error ctx error one);
def raw_http_bool (ctx : RawPtr U8) (result : U32) (one : USize) : Runtime U32 :=
    match u32_equal(result, raw_size_to_u32 (raw_http_c0 one)) with
    | True => raw_http_failed ctx one | False => runtime_pure(U32, raw_size_to_u32 (raw_http_c0 one)) end;

-- The absolute monotonic deadline also detects slow-drip responses. Remaining
-- time is installed before every blocking phase; certificate flags stay default.
def raw_http_deadline (ctx : RawPtr U8) (stream_handle : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_http_get(ctx, raw_http_c48 one)) (fun (start : USize) =>
      runtime_bind U64 U32 windows_http_ticks (fun (now : U64) =>
        let elapsed : USize := usize_sub(u64_to_usize now, start) in
        match usize_less(elapsed, raw_http_c5000 one) with
        | False => raw_http_error ctx (raw_size_to_u32 (raw_http_c12002 one)) one
        | True => let left : U32 := raw_size_to_u32 (usize_sub(raw_http_c5000 one, elapsed)) in
            runtime_bind U32 U32 (windows_http_timeouts stream_handle left left left left)
              (fun (okay : U32) => raw_http_bool ctx okay one) end));

-- Closing a failed handle does not prevent closing remaining handles/pages.
def raw_http_close_at (ctx : RawPtr U8) (offset : USize) (one : USize) : Runtime Bool :=
    runtime_bind USize Bool (raw_http_get ctx offset) (fun (bits : USize) =>
      match usize_equal(bits, raw_http_c0 one) with | True => runtime_pure Bool True
      | False => runtime_bind (RawPtr U8) Bool (raw_from_bits U8 bits) (fun (stream_handle : RawPtr U8) =>
          runtime_bind U32 Bool (windows_http_close stream_handle) (fun (closed : U32) =>
            match u32_equal(closed, raw_size_to_u32 (raw_http_c0 one)) with
            | True => runtime_pure Bool False
            | False => runtime_bind Unit Bool (raw_http_put ctx offset (raw_http_c0 one))
                (fun (_ : Unit) => runtime_pure Bool True) end)) end);

-- one is exactly 1, supplied by the checked managed bridge.

def raw_windows_http_close (ctx : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind Bool U32 (raw_http_context_valid ctx one) (fun (valid : Bool) =>
match valid with | False => runtime_pure(U32, raw_size_to_u32 (raw_http_c2 one)) | True =>
    runtime_bind Bool U32 (raw_http_close_at ctx (raw_http_c16 one) one) (fun (a : Bool) =>
runtime_bind Bool U32 (raw_http_close_at ctx (raw_http_c8 one) one) (fun (b : Bool) =>
runtime_bind Bool U32 (raw_http_close_at ctx (raw_http_c0 one) one) (fun (c : Bool) =>
runtime_bind USize U32 (raw_http_get(ctx, raw_http_c24 one)) (fun (head : USize) =>
runtime_bind Unit U32 (raw_http_put(ctx, raw_http_c56 one, raw_http_c0 one)) (fun (_ : Unit) =>
match u8_from_nat 1 with | Nothing => runtime_pure(U32, raw_size_to_u32 (raw_http_c2 one)) | Just running => runtime_bind USize U32 (runtime_loop USize head (fun (node : USize) => runtime_pure(U8, match usize_equal(node, raw_http_c0 one) with | True => u8_sub running running | False => running end)) (fun (node : USize) => runtime_bind (RawPtr U8) USize (raw_from_bits U8 node) (fun (page : (RawPtr U8)) =>
runtime_bind USize USize (raw_http_get(page, raw_http_c0 one)) (fun (next : USize) =>
runtime_bind Bool USize (raw_pages_release page) (fun (released : Bool) =>
match released with | True => runtime_pure USize next | False => runtime_bind Unit USize (raw_http_put ctx (raw_http_c56 one) one) (fun (_ : Unit) =>
runtime_pure USize next) end))))) (fun (_ : USize) =>
runtime_bind USize U32 (raw_http_get(ctx, raw_http_c56 one)) (fun (failed : USize) =>
runtime_bind Unit U32 (raw_http_put(ctx, raw_http_c24 one, raw_http_c0 one)) (fun (_ : Unit) =>
