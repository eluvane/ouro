-- WinHTTP owns TLS verification. No shell, child process, or managed pointer
-- crosses this raw ABI. Context: handles 0/8/16, chunk head 24, total 32,
-- HTTP status 40, Win32 error 44, monotonic start 48, chunk tail 56.
-- Every entry requires the same live, aligned, zero-initialized 64-byte
-- caller-owned context; all input ranges are disjoint from it.
import "windows_text.ouro",
  "windows_path.ouro";

extern windows_http_open : RawPtr U8 -> U32 -> RawPtr U8 -> RawPtr U8 -> U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpOpen" "nogc";
extern windows_http_connect : RawPtr U8 -> RawPtr U8 -> U32 -> U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpConnect" "nogc";
extern windows_http_request : RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> RawPtr (RawPtr U8) -> U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpOpenRequest" "nogc";
extern windows_http_crack : RawPtr U8 -> U32 -> U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpCrackUrl" "nogc";
extern windows_http_close : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpCloseHandle" "nogc";
extern windows_http_timeouts : RawPtr U8 -> U32 -> U32 -> U32 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpSetTimeouts" "nogc";
extern windows_http_option : RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpSetOption" "nogc";
extern windows_http_header : RawPtr U8 -> RawPtr U8 -> U32 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpAddRequestHeaders" "nogc";
extern windows_http_send : RawPtr U8 -> RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> U32 -> USize -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpSendRequest" "nogc";
extern windows_http_receive : RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpReceiveResponse" "nogc";
extern windows_http_query : RawPtr U8 -> U32 -> RawPtr U8 -> RawPtr U8 -> RawPtr U32 -> RawPtr U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpQueryHeaders" "nogc";
extern windows_http_read : RawPtr U8 -> RawPtr U8 -> U32 -> RawPtr U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "winhttp.dll" "WinHttpReadData" "nogc";
extern windows_http_ticks : Runtime U64 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetTickCount64" "nogc";

