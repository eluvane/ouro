-- Copy through the OS with overwrite enabled. Both paths must satisfy the
-- strict terminated UTF-16 contract before the filesystem call. Zero means
-- success; failure retains its Win32 status. The OS owns its copy handles.
import "windows_fs_mutation.ouro";

extern windows_copy_file : RawPtr U8 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "CopyFileW" "nogc";

def raw_windows_file_copy (source : RawPtr U8) (source_units : USize)
    (target : RawPtr U8) (target_units : USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 source_units))
        (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 source_units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid source source_units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind Bool U32 (raw_windows_path_valid target target_units one) (fun (next : Bool) =>
            match next with | False => runtime_pure U32 (raw_windows_parameter_error one)
            | True => runtime_bind U32 U32 (windows_copy_file source target (raw_size_to_u32 (usize_sub one one)))
                (fun (status : U32) => raw_windows_bool_status status one) end) end) end;
