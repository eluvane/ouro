def raw_capture_quiesce (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_quiesced one)) (fun (quiesced : USize) =>
  match usize_equal quiesced one with
| True => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))
| False => runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_job one)) (fun (bits : USize) =>
  match usize_equal(bits, usize_sub one one) with
| True => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_time(owner, raw_capture_owner_cleanup_start one)) (fun (_started : U32) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (job : (RawPtr U8)) =>
  runtime_bind U32 U32 (windows_capture_job_terminate(job, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add(usize_add one one, usize_add one one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add one one, usize_add one one), one)))))))) (fun (terminated : U32) =>
  runtime_bind U32 U32 (raw_windows_bool_status terminated one) (fun (status : U32) =>
  match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with
| True => match u8_from_nat 1 with | Nothing => runtime_pure(U32, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)), one))))) | Just running => runtime_bind USize U32 (runtime_loop USize (usize_sub one one)
(fun (state : USize) => runtime_pure(U8, match usize_equal(state, usize_sub one one) with | True => running | False => u8_sub running running end))
(fun (_state : USize) => raw_capture_quiet_step owner)) (fun (finished : USize) =>
  match usize_equal finished one with
| True => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))
| False => runtime_pure(U32, raw_size_to_u32 (usize_sub(finished, usize_add one one))) end) end
| False => runtime_pure U32 status end)))) end) end));
