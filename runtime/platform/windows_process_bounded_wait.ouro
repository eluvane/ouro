import "windows_process_bounded_monitor.ouro";

def raw_capture_wait_once (owner : RawPtr U8) (milliseconds : U32) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_process one)) (fun (process_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 process_bits) (fun (process : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 owner (raw_capture_owner_exit_code one)) (fun (code_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 code_bytes) (fun (code : (RawPtr U32)) =>
  runtime_bind U32 U32 (windows_wait_process process milliseconds) (fun (result : U32) =>
  match u32_equal(result, raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (windows_process_exit_code process code) (fun (queried : U32) =>
  runtime_bind U32 U32 (raw_windows_bool_status queried one) (fun (status : U32) =>
  match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_load_u32 code) (fun (exit_code : U32) =>
  runtime_bind U32 U32 (raw_capture_result(owner, usize_sub one one, raw_u32_to_size exit_code)) (fun (_saved : U32) =>
  runtime_pure(U32, raw_size_to_u32 one)))
| False => runtime_bind U32 U32 (raw_capture_os owner status) (fun (_saved : U32) =>
  runtime_pure(U32, raw_size_to_u32 one)) end))
| False => match u32_equal(result, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))))), usize_add one one))) with
| True => runtime_bind USize U32 (raw_capture_elapsed(owner, raw_capture_owner_execution_start one)) (fun (elapsed : USize) =>
  runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_timeout one)) (fun (limit : USize) =>
  match usize_less elapsed limit with
| True => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add one one) limit) (fun (_saved : U32) =>
  runtime_pure(U32, raw_size_to_u32 one)) end))
| False => match u32_equal(result, u32_sub(raw_size_to_u32 (usize_sub one one), raw_size_to_u32 one)) with
| True => runtime_bind U32 U32 (raw_windows_last_failure one) (fun (status : U32) =>
  runtime_bind U32 U32 (raw_capture_os owner status) (fun (_saved : U32) =>
  runtime_pure(U32, raw_size_to_u32 one)))
| False => runtime_bind U32 U32 (raw_capture_os(owner, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)), one)))))) (fun (_saved : U32) =>
  runtime_pure(U32, raw_size_to_u32 one)) end end end))))));

def raw_capture_wait_step (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_capture_monitor owner) (fun (status : U32) =>
  match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_outcome one)) (fun (kind : USize) =>
  match usize_equal(kind, usize_sub one one) with
| True => runtime_bind USize U32 (raw_capture_elapsed(owner, raw_capture_owner_execution_start one)) (fun (elapsed : USize) =>
  runtime_bind USize U32 (raw_process_load(owner, raw_capture_owner_timeout one)) (fun (limit : USize) =>
  match usize_less elapsed limit with
| True => raw_capture_wait_once(owner, raw_size_to_u32 (match usize_less(usize_sub limit elapsed, usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add one one)) with | True => usize_sub limit elapsed | False => (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add one one)) end))
| False => raw_capture_wait_once(owner, raw_size_to_u32 (usize_sub one one)) end))
| False => runtime_pure(U32, raw_size_to_u32 one) end)
| False => runtime_bind U32 U32 (raw_capture_os owner status) (fun (_saved : U32) =>
  runtime_pure(U32, raw_size_to_u32 one)) end));

def raw_capture_wait (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
match u8_from_nat 1 with | Nothing => runtime_pure(U32, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, usize_add one one))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_add one one, one))), usize_add(usize_add(usize_add(usize_add one one, one), usize_add(usize_add one one, one)), one))))) | Just running => runtime_bind U32 U32 (runtime_loop U32 (raw_size_to_u32 (usize_sub one one))
(fun (state : U32) => runtime_pure(U8, match u32_equal(state, raw_size_to_u32 (usize_sub one one)) with | True => running | False => u8_sub running running end))
(fun (_state : U32) => raw_capture_wait_step owner)) (fun (_finished : U32) =>
  runtime_pure(U32, raw_size_to_u32 (usize_sub one one))) end);

