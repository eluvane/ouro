-- Private process ABI helpers. Callers supply live, exclusively owned storage.
import "windows_file.ouro";
import "../native_types.ouro";

extern windows_current_process : Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "GetCurrentProcess" "nogc";
extern windows_duplicate_handle : RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> RawPtr USize -> U32 -> U32 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "DuplicateHandle" "nogc";
extern windows_initialize_attributes : RawPtr U8 -> U32 -> U32 -> RawPtr USize -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "InitializeProcThreadAttributeList" "nogc";
extern windows_update_attribute : RawPtr U8 -> U32 -> USize -> RawPtr U8 -> USize -> RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "UpdateProcThreadAttribute" "nogc";
extern windows_delete_attributes : RawPtr U8 -> Runtime Unit :=
    "windows-x86_64" "win64" "kernel32.dll" "DeleteProcThreadAttributeList" "nogc";
extern windows_create_process : RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> U32 -> U32 -> RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "CreateProcessW" "nogc";
extern windows_wait_process : RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "WaitForSingleObject" "nogc";
extern windows_process_exit_code : RawPtr U8 -> RawPtr U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetExitCodeProcess" "nogc";
extern windows_terminate_process : RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TerminateProcess" "nogc";

def raw_process_eight (value : USize) : USize :=
    let scaled : USize := raw_times_eight value in scaled;

def raw_process_one (anchor : USize) : USize :=
    let one : USize := raw_one anchor in one;

def raw_process_load (base : RawPtr U8) (offset : USize) : Runtime USize :=
    let result : Runtime USize := raw_load_size_at base offset in result;

def raw_process_store (base : RawPtr U8) (offset : USize) (value : USize) : Runtime Unit :=
    let result : Runtime Unit := raw_store_size_at base offset value in result;

def raw_process_store_word (base : RawPtr U8) (offset : USize) (value : U32) : Runtime Unit :=
    let result : Runtime Unit := raw_store_word_at base offset value in result;

def raw_process_storage (base : RawPtr U8) (bytes : USize) (one : USize) : Runtime Bool :=
    runtime_bind Bool Bool (raw_buffer_range base bytes (usize_sub one one) bytes) (fun (range : Bool) =>
      match range with | False => runtime_pure Bool False | True =>
        runtime_bind USize Bool (raw_to_bits U8 base) (fun (bits : USize) =>
          runtime_pure Bool (usize_equal (usize_and bits (usize_add (usize_add one (usize_add one one)) (usize_add (usize_add one one) (usize_add one one)))) (usize_sub one one))) end);

-- A failed explicit close leaves its ownership cell unchanged. Zero cells
-- own nothing. This primitive also permits cleanup of partially filled state.
def raw_process_close_cell (base : RawPtr U8) (offset : USize) (one : USize) : Runtime U32 :=
    let process_number_0 : USize := (usize_sub one one) in

    runtime_bind USize U32 (raw_process_load base offset) (fun (bits : USize) =>
      match usize_equal bits process_number_0 with | True => runtime_pure U32 (raw_size_to_u32 process_number_0) | False =>
        runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (owned_handle : RawPtr U8) =>
          runtime_bind U32 U32 (raw_windows_file_close owned_handle) (fun (status : U32) =>
            match u32_equal status (raw_size_to_u32 process_number_0) with | False => runtime_pure U32 status | True =>
              runtime_bind Unit U32 (raw_process_store base offset process_number_0)
                (fun (_cleared : Unit) => runtime_pure U32 status) end)) end);

-- Internal launch workspace cannot return owned handles to its caller. An
-- impossible cleanup failure is fail-stop, as for raw_pages_reject.
def raw_process_require_cleanup (status : U32) : Runtime Unit :=
    match u32_equal status (u32_sub status status) with
    | True => runtime_pure Unit MkUnit | False => raw_windows_panic_code status end;

def raw_process_release (owner : RawPtr U8) (one : USize) : Runtime Unit :=
    runtime_bind Bool Unit (raw_pages_release owner) (fun (released : Bool) =>
      match released with | True => runtime_pure Unit MkUnit
      | False => raw_windows_panic_code (raw_windows_general_error one) end);

def raw_process_duplicate (source : RawPtr U8) (target : RawPtr U8) (offset : USize) (one : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 windows_current_process (fun (self : RawPtr U8) =>
      runtime_bind (RawPtr U8) U32 (raw_add U8 target offset) (fun (bytes : RawPtr U8) =>
        runtime_bind (RawPtr USize) U32 (raw_cast U8 USize bytes) (fun (cell : RawPtr USize) =>
          runtime_bind U32 U32 (windows_duplicate_handle self source self cell
            (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 one) (raw_size_to_u32 (usize_add one one)))
            (fun (status : U32) => raw_windows_bool_status status one))));

def raw_process_duplicate_streams (input : RawPtr U8) (output : RawPtr U8) (error : RawPtr U8)
    (startup : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (raw_process_duplicate input startup (raw_process_eight (usize_add (raw_process_eight one) (usize_add one one))) one) (fun (first : U32) =>
      match u32_equal first (raw_size_to_u32 (usize_sub one one)) with | False => runtime_pure U32 first | True =>
        runtime_bind U32 U32 (raw_process_duplicate output startup (raw_process_eight (usize_add (raw_process_eight one) (usize_add one (usize_add one one)))) one) (fun (second : U32) =>
          match u32_equal second (raw_size_to_u32 (usize_sub one one)) with | False => runtime_pure U32 second | True =>
            raw_process_duplicate error startup (raw_process_eight (usize_add (raw_process_eight one) (usize_add (usize_add one one) (usize_add one one)))) one end) end);

def raw_process_close_duplicates (startup : RawPtr U8) (one : USize) : Runtime Unit :=
    runtime_bind U32 Unit (raw_process_close_cell startup (raw_process_eight (usize_add (raw_process_eight one) (usize_add one one))) one) (fun (first : U32) =>
      runtime_bind Unit Unit (raw_process_require_cleanup first) (fun (_first_closed : Unit) =>
        runtime_bind U32 Unit (raw_process_close_cell startup (raw_process_eight (usize_add (raw_process_eight one) (usize_add one (usize_add one one)))) one) (fun (second : U32) =>
          runtime_bind Unit Unit (raw_process_require_cleanup second) (fun (_second_closed : Unit) =>
            runtime_bind U32 Unit (raw_process_close_cell startup (raw_process_eight (usize_add (raw_process_eight one) (usize_add (usize_add one one) (usize_add one one)))) one)
              (fun (third : U32) => raw_process_require_cleanup third)))));
