-- Path operations use the same strict, explicitly terminated UTF-16 contract.
-- Status zero is success. OS errors remain nonzero; no operation is recursive.
import "windows_file.ouro";

extern windows_create_directory : RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "CreateDirectoryW" "nogc";
extern windows_remove_directory : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "RemoveDirectoryW" "nogc";
extern windows_delete_file : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "DeleteFileW" "nogc";
extern windows_move_file : RawPtr U8 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "MoveFileExW" "nogc";
extern windows_get_file_attributes : RawPtr U8 -> U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFileAttributesExW" "nogc";

def raw_windows_directory_create (path : RawPtr U8) (units : USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid path units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind U32 U32 (windows_create_directory path (raw_null U8))
            (fun (status : U32) => raw_windows_bool_status status one) end) end;

def raw_windows_directory_remove (path : RawPtr U8) (units : USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid path units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind U32 U32 (windows_remove_directory path)
            (fun (status : U32) => raw_windows_bool_status status one) end) end;

def raw_windows_file_delete (path : RawPtr U8) (units : USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid path units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind U32 U32 (windows_delete_file path)
            (fun (status : U32) => raw_windows_bool_status status one) end) end;

-- Same-volume rename. Cross-volume copying, delayed reboot actions and shell
-- operations are never enabled. Replacement is explicit; directories follow
-- the OS rules, including failure when the destination already exists.
def raw_windows_file_rename (source : RawPtr U8) (source_units : USize) (target : RawPtr U8)
    (target_units : USize) (replace : Bool) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 source_units))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 source_units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid source source_units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind Bool U32 (raw_windows_path_valid target target_units one) (fun (next : Bool) =>
            match next with | False => runtime_pure U32 (raw_windows_parameter_error one)
            | True => runtime_bind U32 U32 (windows_move_file source target (raw_size_to_u32
                (match replace with | True => one | False => usize_sub one one end)))
                (fun (status : U32) => raw_windows_bool_status status one) end) end) end;

-- The caller supplies 36 writable bytes aligned to 4, disjoint from path.
-- On success the Win32 layout is: attributes U32 at 0; FILETIME pairs at
-- 4/12/20 (creation/access/write); size high/low U32 at 28/32. On OS failure
-- the metadata buffer is unspecified and must not be consumed as a result.
def raw_windows_file_metadata (path : RawPtr U8) (units : USize) (output : RawPtr U8) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 units))
    | Just one =>
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let sixteen : USize := usize_add eight eight in
        let bytes : USize := usize_add (usize_add sixteen sixteen) four in
        runtime_bind Bool U32 (raw_windows_path_output path units output bytes four one) (fun (valid : Bool) =>
          match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
          | True => runtime_bind U32 U32 (windows_get_file_attributes path (raw_size_to_u32 (usize_sub one one)) output)
              (fun (status : U32) => raw_windows_bool_status status one) end) end;
