-- Private CREATE_NEW files with an owner-only protected DACL.
import "windows_file.ouro",
  "windows_fs.ouro",
  "windows_startup.ouro",
  "windows_text.ouro";

extern windows_temp_path : U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetTempPathW" "nogc";
extern windows_temp_random : RawPtr U8 -> RawPtr U8 -> U32 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "bcrypt.dll" "BCryptGenRandom" "nogc";
extern windows_temp_security : RawPtr U8 -> U32 -> RawPtr USize -> RawPtr U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "advapi32.dll" "ConvertStringSecurityDescriptorToSecurityDescriptorW" "nogc";

def raw_temp_panic (one : USize) : Runtime U32 :=
    let _zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let _sixteen : USize := usize_add eight eight in
    runtime_bind Unit U32 (windows_exit_process (raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 two), two))), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), one)))))
      (fun (_ : Unit) => runtime_pure(U32, raw_windows_general_error one));

def raw_temp_ascii (path : RawPtr U8) (index : USize) (value : U8) (one : USize) : Runtime Unit :=
    runtime_bind (RawPtr U8) Unit (raw_add U8 path (usize_add index index)) (fun (low : RawPtr U8) =>
      runtime_bind Unit Unit (raw_store_u8 low value) (fun (_ : Unit) =>
        runtime_bind (RawPtr U8) Unit (raw_add U8 low one) (fun (high : RawPtr U8) =>
          raw_store_u8(high, u8_sub value value))));

-- The constant D:P(A;;FA;;;OW) disables inherited access and grants only
-- the owner full access. Windows allocates the descriptor, not Ouro.
def raw_temp_security_text (text : RawPtr U8) (one : USize) : Runtime Unit :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let _sixteen : USize := usize_add eight eight in
    match u8_from_nat 68 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte => runtime_bind Unit Unit (raw_temp_ascii text zero byte one) (fun (_ : Unit) => match u8_from_nat 58 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_0 => runtime_bind Unit Unit (raw_temp_ascii text one byte_0 one) (fun (_ : Unit) => match u8_from_nat 80 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_1 => runtime_bind Unit Unit (raw_temp_ascii text two byte_1 one) (fun (_ : Unit) => match u8_from_nat 40 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_2 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 one), one)) byte_2 one) (fun (_ : Unit) => match u8_from_nat 65 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_3 => runtime_bind Unit Unit (raw_temp_ascii text four byte_3 one) (fun (_ : Unit) => match u8_from_nat 59 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_4 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 two), one)) byte_4 one) (fun (_ : Unit) => match u8_from_nat 59 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_5 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 two), two)) byte_5 one) (fun (_ : Unit) => match u8_from_nat 70 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_6 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 two), usize_add(usize_shift_left(one, raw_size_to_u32 one), one))) byte_6 one) (fun (_ : Unit) => match u8_from_nat 65 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_7 => runtime_bind Unit Unit (raw_temp_ascii text eight byte_7 one) (fun (_ : Unit) => match u8_from_nat 59 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_8 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), one)) byte_8 one) (fun (_ : Unit) => match u8_from_nat 59 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_9 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), two)) byte_9 one) (fun (_ : Unit) => match u8_from_nat 59 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_10 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 one), one))) byte_10 one) (fun (_ : Unit) => match u8_from_nat 79 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_11 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), four)) byte_11 one) (fun (_ : Unit) => match u8_from_nat 87 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_12 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 two), one))) byte_12 one) (fun (_ : Unit) => match u8_from_nat 41 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_13 => runtime_bind Unit Unit (raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 two), two))) byte_13 one) (fun (_ : Unit) => match u8_from_nat 0 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just byte_14 => runtime_bind(Unit, Unit, raw_temp_ascii text (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), usize_add(usize_shift_left(one, raw_size_to_u32 two), usize_add(usize_shift_left(one, raw_size_to_u32 one), one)))) byte_14 one, fun (_ : Unit) => runtime_pure Unit MkUnit) end) end) end) end) end) end) end) end) end) end) end) end) end) end) end) end;

def raw_temp_security_make (scratch : RawPtr U8) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    runtime_bind (RawPtr U8) U32 (raw_add U8 scratch (usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 two), two))))) (fun (text : RawPtr U8) =>
      runtime_bind (RawPtr U8) U32 (raw_add U8 scratch (usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 two), one))))) (fun (cell : RawPtr U8) =>
        runtime_bind (RawPtr USize) U32 (raw_cast U8 USize cell) (fun (owner : RawPtr USize) =>
          runtime_bind Unit U32 (raw_store_usize owner zero) (fun (_ : Unit) =>
            runtime_bind Unit U32 (raw_temp_security_text text one) (fun (_ : Unit) =>
              runtime_bind U32 U32 (windows_temp_security(text, raw_size_to_u32 one, owner, raw_null U32))
                (fun (status : U32) => match u32_equal(status, raw_size_to_u32 zero) with
                  | True => runtime_pure(U32, raw_windows_general_error one)
                  | False => runtime_bind USize U32 (raw_load_usize owner) (fun (bits : USize) =>
                      match usize_equal bits zero with | True => raw_temp_panic one | False =>
                        runtime_bind (RawPtr USize) U32 (raw_cast U8 USize scratch) (fun (size : RawPtr USize) =>
                          runtime_bind Unit U32 (raw_store_usize(size, usize_add(usize_shift_left(one, raw_size_to_u32 four), eight))) (fun (_ : Unit) =>
                            runtime_bind (RawPtr USize) U32 (raw_add USize size eight) (fun (descriptor : RawPtr USize) =>
                              runtime_bind Unit U32 (raw_store_usize descriptor bits) (fun (_ : Unit) =>
                                runtime_bind (RawPtr USize) U32 (raw_add USize size sixteen) (fun (inherit : RawPtr USize) =>
                                  runtime_bind Unit U32 (raw_store_usize inherit zero)
                                    (fun (_ : Unit) => runtime_pure(U32, raw_size_to_u32 zero))))))) end) end))))));

-- The source path is strict UTF-8; the process directory uses GetTempPathW.
def raw_temp_directory (source : RawPtr U8) (bytes : USize) (in_directory : Bool)
    (wide : RawPtr U8) (count : RawPtr U32) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    let limit : USize := usize_sub (usize_shift_left(one, raw_size_to_u32 (usize_sub sixteen one)))
      (usize_shift_left(one, raw_size_to_u32 (usize_add four two))) in
    match in_directory with
    | True => match usize_equal bytes zero with
      | True => runtime_pure(U32, raw_size_to_u32 one)
      | False => runtime_bind U32 U32 (raw_windows_utf8_to_utf16 source bytes (raw_null U8) zero count)
          (fun (status : U32) => match u32_equal(status, raw_size_to_u32 zero) with
            | False => runtime_pure(U32, raw_windows_general_error one)
            | True => runtime_bind U32 U32 (raw_load_u32 count) (fun (required : U32) =>
                match usize_less(raw_u32_to_size required, limit) with
                | False => runtime_pure(U32, raw_size_to_u32 one)
                | True => runtime_bind U32 U32 (raw_windows_utf8_to_utf16 source bytes wide limit count)
                    (fun (filled : U32) => runtime_pure U32
                      (match u32_equal(filled, raw_size_to_u32 zero) with
                        | True => filled | False => raw_windows_general_error one end)) end) end) end
    | False => runtime_bind U32 U32 (windows_temp_path(raw_size_to_u32 limit, wide))
        (fun (actual : U32) => match u32_equal(actual, raw_size_to_u32 zero) with
          | True => runtime_pure(U32, raw_size_to_u32 one)
          | False => match usize_less(raw_u32_to_size actual, limit) with
            | False => runtime_pure(U32, raw_size_to_u32 one)
            | True => raw_windows_store_count count actual end end) end;

-- 32 independent random low nibbles retain 128 bits of OS randomness.
def raw_temp_hex (wide : RawPtr U8) (start : USize) (random : RawPtr U8) (one : USize) : Runtime Unit :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let _sixteen : USize := usize_add eight eight in
    match u8_from_nat 1 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
    | Just running => match u8_from_nat 16 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
      | Just base => match u8_from_nat 48 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
        | Just digit => match u8_from_nat 87 with | Nothing => runtime_bind(U32, Unit, raw_temp_panic one, fun (_ : U32) => runtime_pure Unit MkUnit)
          | Just letter => runtime_bind USize Unit (runtime_loop USize zero
              (fun (index : USize) => runtime_pure(U8, match usize_less(index, usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 two), one)))) with | True => running | False => u8_sub running running end))
              (fun (index : USize) => runtime_bind (RawPtr U8) USize (raw_add U8 random index) (fun (cell : RawPtr U8) =>
                runtime_bind U8 USize (raw_load_u8 cell) (fun (byte : U8) =>
                  runtime_bind U8 USize (runtime_loop U8 byte
                    (fun (value : U8) => runtime_pure(U8, match u32_less(u8_to_u32 value, u8_to_u32 base) with | True => u8_sub running running | False => running end))
                    (fun (value : U8) => runtime_pure(U8, u8_sub value base))) (fun (nibble : U8) =>
                      let ascii_base : U8 := match usize_less(raw_u32_to_size (u8_to_u32 nibble), usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 one), one))), two)) with | True => digit | False => letter end in
                      runtime_bind Unit USize (raw_temp_ascii wide (usize_add start index)
                        (u8_sub(ascii_base, u8_sub(u8_sub nibble nibble, nibble))) one)
                        (fun (_ : Unit) => runtime_pure(USize, usize_add index one)))))))
              (fun (_ : USize) => raw_temp_ascii(wide, usize_add(start, usize_shift_left(one, raw_size_to_u32 (usize_add(usize_shift_left(one, raw_size_to_u32 two), one)))), u8_sub running running, one))
          end end end end;
