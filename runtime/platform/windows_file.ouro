-- Synchronous file handles and binary IO. Status zero means success; every
-- failure returns a nonzero Win32 code. Callers own live raw buffers and must
-- close each successful handle explicitly. These functions allocate no heap.
import "windows_path.ouro";
import "windows_io.ouro";

extern windows_create_file : RawPtr U8 -> U32 -> U32 -> RawPtr U8 -> U32 -> U32 -> RawPtr U8 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "CreateFileW" "nogc";
extern windows_close_handle : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "CloseHandle" "nogc";
extern windows_read_file : RawPtr U8 -> RawPtr U8 -> U32 -> RawPtr U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "ReadFile" "nogc";
extern windows_flush_file : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "FlushFileBuffers" "nogc";
extern windows_seek_file : RawPtr U8 -> U64 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "SetFilePointerEx" "nogc";

def raw_windows_bool_status (status : U32) (one : USize) : Runtime U32 :=
    match u32_equal status (u32_sub status status) with
    | True => raw_windows_last_failure one
    | False => runtime_pure U32 (u32_sub status status) end;

def raw_windows_handle_valid (stream_handle : RawPtr U8) (one : USize) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    runtime_bind USize Bool (raw_to_bits U8 stream_handle) (fun (bits : USize) =>
      runtime_pure Bool (raw_bool_and (raw_bool_not (usize_equal bits zero))
        (raw_bool_not (usize_equal bits (usize_sub zero one)))));

def raw_windows_invalid_handle (one : USize) : U32 :=
    let two : USize := usize_add one one in
    raw_size_to_u32 (usize_add (usize_add two two) two);

-- Access and sharing use Win32 masks. Disposition is 1..5 (CREATE_NEW,
-- CREATE_ALWAYS, OPEN_EXISTING, OPEN_ALWAYS, TRUNCATE_EXISTING). Handles are
-- synchronous and non-inheritable. Temporary files require CREATE_NEW and
-- use DELETE_ON_CLOSE: a collision is an error, never a truncate/reopen race.
-- On success owner receives handle bits in an aligned USize cell; on failure
-- it is unchanged. The owner cell cannot overlap the terminated path.
def raw_windows_file_open (path : RawPtr U8) (units : USize) (access : U32) (sharing : U32)
    (disposition : U32) (temporary : Bool) (owner : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code access)
        (fun (_unexpected : Unit) => runtime_pure U32 access)
    | Just one =>
        let zero : USize := usize_sub one one in
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let seven : USize := usize_sub eight one in
        let mode : USize := raw_u32_to_size disposition in
        match raw_bool_and (raw_bool_and (usize_less zero mode) (usize_less mode (usize_add four two)))
          (raw_bool_and (raw_bool_not (usize_less seven (raw_u32_to_size sharing)))
            (match temporary with | True => usize_equal mode one | False => True end)) with
        | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind (RawPtr U8) U32 (raw_cast USize U8 owner) (fun (cell : RawPtr U8) =>
            runtime_bind Bool U32 (raw_windows_path_output path units cell eight eight one) (fun (valid : Bool) =>
              match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                let flags : U32 := raw_size_to_u32 (match temporary with
                  | False => usize_shift_left one (raw_size_to_u32 seven)
                  | True => usize_add (usize_shift_left one (raw_size_to_u32 eight))
                      (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add eight eight) (usize_add eight two)))) end) in
                runtime_bind (RawPtr U8) U32 (windows_create_file path access sharing (raw_null U8)
                  disposition flags (raw_null U8)) (fun (stream_handle : RawPtr U8) =>
                    runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (opened : Bool) =>
                      match opened with | False => raw_windows_last_failure one | True =>
                        runtime_bind USize U32 (raw_to_bits U8 stream_handle) (fun (bits : USize) =>
                          runtime_bind Unit U32 (raw_store_usize owner bits)
                            (fun (_stored : Unit) => runtime_pure U32 (raw_size_to_u32 zero))) end)) end)) end end;

def raw_windows_file_control (closing : Bool) (stream_handle : RawPtr U8) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits U8 stream_handle) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bits)))
    | Just one => runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_invalid_handle one)
        | True => runtime_bind U32 U32 (match closing with
            | True => windows_close_handle stream_handle | False => windows_flush_file stream_handle end)
            (fun (status : U32) => raw_windows_bool_status status one) end) end;

-- A zero close status consumes the handle. A failure leaves cleanup with the caller.
def raw_windows_file_close (stream_handle : RawPtr U8) : Runtime U32 :=
    raw_windows_file_control True stream_handle;

def raw_windows_file_flush (stream_handle : RawPtr U8) : Runtime U32 :=
    raw_windows_file_control False stream_handle;

def raw_windows_file_restore_count (count : RawPtr U32) (saved : U32) (error : U32) : Runtime U32 :=
    let result : Runtime U32 := raw_restore_word count saved error in result;

-- Capture GetLastError before restoring the caller's count on OS failure.
-- Read zero is EOF. A positive request with a zero write is a failed progress
-- contract. A successful partial operation reports its actual count.
def raw_windows_file_result (writing : Bool) (requested : U32) (count : RawPtr U32)
    (saved : U32) (status : U32) (one : USize) : Runtime U32 :=
    let zero : U32 := u32_sub status status in
    match u32_equal status zero with
    | True => runtime_bind U32 U32 (raw_windows_last_failure one)
        (fun (error : U32) => raw_windows_file_restore_count count saved error)
    | False => runtime_bind U32 U32 (raw_load_u32 count) (fun (actual : U32) =>
        match raw_bool_and (raw_bool_not (u32_less requested actual))
          (match writing with | False => True | True => raw_bool_not (u32_equal actual zero) end) with
        | False => raw_windows_file_restore_count count saved (raw_windows_general_error one)
        | True => runtime_pure U32 zero end) end;

-- One synchronous operation, at most U32::MAX bytes. Buffers/count may change
-- only after validation. OS failure may have transferred a prefix; count is
-- restored, so callers must treat that failure as an interrupted operation.
def raw_windows_file_transfer (writing : Bool) (stream_handle : RawPtr U8) (buffer : RawPtr U8)
    (bytes : USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bytes))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bytes))
    | Just one =>
        let zero : USize := usize_sub one one in
        let word_one : U32 := raw_size_to_u32 one in
        let maximum : USize := raw_u32_to_size (u32_sub (u32_sub word_one word_one) word_one) in
        match usize_less maximum bytes with | True => runtime_pure U32 (raw_windows_parameter_error one) | False =>
          runtime_bind Bool U32 (raw_windows_conversion_storage buffer bytes (raw_null U8) zero count one) (fun (storage : Bool) =>
            match storage with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
              runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (valid : Bool) =>
                match valid with | False => runtime_pure U32 (raw_windows_invalid_handle one) | True =>
                  match usize_equal bytes zero with | True => raw_windows_store_count count (raw_size_to_u32 zero)
                  | False => runtime_bind U32 U32 (raw_load_u32 count) (fun (saved : U32) =>
                      let requested : U32 := raw_size_to_u32 bytes in
                      runtime_bind U32 U32 (match writing with
                        | True => windows_write_file stream_handle buffer requested count (raw_null U8)
                        | False => windows_read_file stream_handle buffer requested count (raw_null U8) end)
                        (fun (status : U32) => raw_windows_file_result writing requested count saved status one)) end end) end) end end;

def raw_windows_file_read (stream_handle : RawPtr U8) (buffer : RawPtr U8) (bytes : USize) (count : RawPtr U32) : Runtime U32 :=
    raw_windows_file_transfer False stream_handle buffer bytes count;

def raw_windows_file_write (stream_handle : RawPtr U8) (buffer : RawPtr U8) (bytes : USize) (count : RawPtr U32) : Runtime U32 :=
    raw_windows_file_transfer True stream_handle buffer bytes count;
