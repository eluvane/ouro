-- Fixed Win32 BY_HANDLE_FILE_INFORMATION layouts. Publication requires three
-- distinct single-link ordinary files on one volume and an empty reservation.
import "windows_file.ouro";

extern windows_replace_information : RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFileInformationByHandle" "nogc";

-- These are the source attributes whose exact values SetFileAttributesW can
-- prepare on the stage: HIDDEN, SYSTEM, ARCHIVE, NORMAL, TEMPORARY and
-- NOT_CONTENT_INDEXED. Read-only, links, sparse/compressed/encrypted/offline
-- files and other metadata modes are refused before source publication.
def raw_windows_replace_attributes (one : USize) : USize :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    let archive : USize := usize_add sixteen sixteen in
    let normal : USize := usize_add (usize_add archive archive) (usize_add archive archive) in
    usize_add (usize_add two four) (usize_add archive (usize_add normal
      (usize_add (usize_add normal normal) (usize_shift_left one (raw_size_to_u32 (usize_add eight (usize_add four one)))))));

def raw_windows_replace_supported (attributes : U32) (one : USize) : Bool :=
    let bits : USize := raw_u32_to_size attributes in
    usize_equal bits (usize_and bits (raw_windows_replace_attributes one));

def raw_windows_replace_same (left : RawPtr U8) (right : RawPtr U8) (one : USize) : Runtime Bool :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    runtime_bind U32 Bool (raw_load_word_at left (usize_shift_left (usize_add eight (usize_add two one)) (raw_size_to_u32 two))) (fun (high : U32) =>
      runtime_bind U32 Bool (raw_load_word_at right (usize_shift_left (usize_add eight (usize_add two one)) (raw_size_to_u32 two))) (fun (other_high : U32) =>
        runtime_bind U32 Bool (raw_load_word_at left (usize_shift_left (usize_add eight four) (raw_size_to_u32 two))) (fun (low : U32) =>
          runtime_bind U32 Bool (raw_load_word_at right (usize_shift_left (usize_add eight four) (raw_size_to_u32 two))) (fun (other_low : U32) =>
            runtime_pure Bool (raw_bool_and (u32_equal high other_high) (u32_equal low other_low))))));

def raw_windows_replace_file_shape (info : RawPtr U8) (empty : Bool) (one : USize) : Runtime U32 :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    runtime_bind U32 U32 (raw_load_word_at info (usize_sub one one)) (fun (attributes : U32) =>
    runtime_bind U32 U32 (raw_load_word_at info (usize_shift_left (usize_add eight two) (raw_size_to_u32 two))) (fun (links : U32) =>
      runtime_bind U32 U32 (raw_load_word_at info (usize_shift_left eight (raw_size_to_u32 two))) (fun (high : U32) =>
        runtime_bind U32 U32 (raw_load_word_at info (usize_shift_left (usize_add eight one) (raw_size_to_u32 two))) (fun (low : U32) =>
          let zero : U32 := raw_size_to_u32 (usize_sub one one) in
          runtime_pure U32 (match raw_bool_and (raw_windows_replace_supported attributes one)
            (raw_bool_and (u32_equal links (raw_size_to_u32 one))
            (match empty with | False => True
             | True => raw_bool_and (u32_equal high zero) (u32_equal low zero) end)) with
            | True => zero | False => raw_windows_parameter_error one end)))));

def raw_windows_replace_inspect_handle (stream_handle : RawPtr U8) (info : RawPtr U8)
    (flush : Bool) (empty : Bool) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (windows_replace_information stream_handle info) (fun (loaded : U32) =>
      match u32_equal loaded (u32_sub loaded loaded) with
      | True => raw_windows_last_failure one
      | False => runtime_bind U32 U32 (raw_windows_replace_file_shape info empty one) (fun (status : U32) =>
          match raw_bool_and flush (u32_equal status (u32_sub status status)) with
          | False => runtime_pure U32 status | True => raw_windows_file_flush stream_handle end)
      end);

def raw_windows_replace_inspect (path : RawPtr U8) (info : RawPtr U8)
    (flush : Bool) (empty : Bool) (one : USize) : Runtime U32 :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    let access : U32 := raw_size_to_u32 (match flush with
      | False => usize_sub one one
      | True => usize_shift_left one (raw_size_to_u32 (usize_sub (usize_add sixteen sixteen) two)) end) in
    let flags : U32 := raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add sixteen (usize_add four one)))) in
    runtime_bind (RawPtr U8) U32 (windows_create_file path access (raw_size_to_u32 (usize_sub eight one))
      (raw_null U8) (raw_size_to_u32 (usize_add two one)) flags (raw_null U8)) (fun (stream_handle : RawPtr U8) =>
        runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (opened : Bool) =>
          match opened with | False => raw_windows_last_failure one
          | True => runtime_bind U32 U32 (raw_windows_replace_inspect_handle stream_handle info flush empty one)
              (fun (status : U32) => runtime_bind U32 U32 (raw_windows_file_close stream_handle) (fun (closed : U32) =>
                runtime_pure U32 (match u32_equal status (u32_sub status status) with
                  | True => closed | False => status end))) end));

def raw_windows_replace_identities (source : RawPtr U8) (stage : RawPtr U8) (backup : RawPtr U8)
    (one : USize) : Runtime U32 :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    runtime_bind U32 U32 (raw_load_word_at source (usize_shift_left (usize_sub eight one) (raw_size_to_u32 two))) (fun (volume : U32) =>
      runtime_bind U32 U32 (raw_load_word_at stage (usize_shift_left (usize_sub eight one) (raw_size_to_u32 two))) (fun (stage_volume : U32) =>
        runtime_bind U32 U32 (raw_load_word_at backup (usize_shift_left (usize_sub eight one) (raw_size_to_u32 two))) (fun (backup_volume : U32) =>
          runtime_bind Bool U32 (raw_windows_replace_same source stage one) (fun (source_stage : Bool) =>
            runtime_bind Bool U32 (raw_windows_replace_same source backup one) (fun (source_backup : Bool) =>
              runtime_bind Bool U32 (raw_windows_replace_same stage backup one) (fun (stage_backup : Bool) =>
                runtime_pure U32 (match raw_bool_and (u32_equal volume stage_volume)
                  (raw_bool_and (u32_equal volume backup_volume)
                    (raw_bool_and (raw_bool_not source_stage)
                      (raw_bool_and (raw_bool_not source_backup) (raw_bool_not stage_backup)))) with
                  | True => u32_sub volume volume | False => raw_windows_parameter_error one end)))))));

def raw_windows_replace_inspections (source : RawPtr U8) (stage : RawPtr U8) (backup : RawPtr U8)
    (source_info : RawPtr U8) (stage_info : RawPtr U8) (backup_info : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (raw_windows_replace_inspect source source_info False False one) (fun (first : U32) =>
      match u32_equal first (u32_sub first first) with | False => runtime_pure U32 first
      | True => runtime_bind U32 U32 (raw_windows_replace_inspect stage stage_info True False one) (fun (second : U32) =>
          match u32_equal second (u32_sub second second) with | False => runtime_pure U32 second
          | True => runtime_bind U32 U32 (raw_windows_replace_inspect backup backup_info False True one) (fun (third : U32) =>
              match u32_equal third (u32_sub third third) with | False => runtime_pure U32 third
              | True => raw_windows_replace_identities source_info stage_info backup_info one end) end) end);

def raw_windows_replace_files (source : RawPtr U8) (stage : RawPtr U8) (backup : RawPtr U8) (one : USize) : Runtime U32 :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let stride : USize := usize_shift_left (usize_sub eight one) (raw_size_to_u32 (usize_add two one)) in
    runtime_bind (RawPtr U8) U32 (raw_pages_allocate (usize_add stride (usize_add stride stride)) eight) (fun (base : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
        match usize_equal address (usize_sub one one) with
        | True => runtime_pure U32 (raw_size_to_u32 eight)
        | False => runtime_bind U32 U32
            (runtime_bind (RawPtr U8) U32 (raw_add U8 base stride) (fun (next : RawPtr U8) =>
              runtime_bind (RawPtr U8) U32 (raw_add U8 next stride) (fun (last : RawPtr U8) =>
                raw_windows_replace_inspections source stage backup base next last one)))
            (fun (result : U32) => runtime_bind Bool U32 (raw_pages_release base) (fun (released : Bool) =>
              runtime_pure U32 (match released with | True => result | False => raw_windows_general_error one end))) end));
