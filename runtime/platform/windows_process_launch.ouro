-- Win64 STARTUPINFOEXW is 112 bytes: DWORD cb at 0, flags at 60,
-- handles at 80/88/96, attribute pointer at 104. PROCESS_INFORMATION
-- is 24 bytes (handles 0/8, DWORD identifiers 16/20).
-- ABI: Microsoft processthreadsapi.h / winbase.h, CreateProcessW and
-- UpdateProcThreadAttribute documentation. HANDLE_LIST=0x20002.
import "windows_process_base.ouro";

def raw_process_create_ready (executable : RawPtr U8) (command : RawPtr U8)
    (environment : RawPtr U8) (directory : RawPtr U8) (startup : RawPtr U8)
    (attributes : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 (raw_add U8 startup (raw_process_eight (usize_add(raw_process_eight one, usize_add one one)))) (fun (handles : RawPtr U8) =>
      runtime_bind U32 U32 (windows_update_attribute attributes (raw_size_to_u32 (usize_sub one one))
        (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(raw_process_eight (usize_add one one), one))), usize_add one one))
        handles (raw_process_eight (usize_add(one, usize_add one one))) (raw_null U8) (raw_null U8)) (fun (updated : U32) =>
          runtime_bind U32 U32 (raw_windows_bool_status updated one) (fun (status : U32) =>
            match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with | False => runtime_pure U32 status | True =>
              runtime_bind Unit U32 (raw_process_store_word(startup, usize_sub one one, raw_size_to_u32 (raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one))))))) (fun (_cb : Unit) =>
                runtime_bind Unit U32 (raw_process_store_word(startup, usize_add(raw_process_eight (usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one))), usize_add(usize_add one one, usize_add one one)), raw_size_to_u32 (raw_process_eight (raw_process_eight (usize_add(usize_add one one, usize_add one one)))))) (fun (_flags : Unit) =>
                  runtime_bind USize U32 (raw_to_bits U8 attributes) (fun (bits : USize) =>
                    runtime_bind Unit U32 (raw_process_store startup (raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add one one, usize_add(one, usize_add one one))))) bits) (fun (_stored : Unit) =>
                      runtime_bind (RawPtr U8) U32 (raw_add U8 startup (raw_process_eight (raw_process_eight (usize_add one one)))) (fun (information : RawPtr U8) =>
                        runtime_bind U32 U32 (windows_create_process executable command (raw_null U8) (raw_null U8)
                          (raw_size_to_u32 one)
                          (raw_size_to_u32 (usize_add (usize_shift_left(one, raw_size_to_u32 (usize_add(raw_process_eight (usize_add(one, usize_add one one)), usize_add(one, usize_add one one)))))
                            (usize_add(usize_shift_left(one, raw_size_to_u32 (usize_add(raw_process_eight (usize_add one one), usize_add(one, usize_add one one)))), raw_process_eight (raw_process_eight (raw_process_eight (usize_add one one)))))))
                          environment directory startup information)
                          (fun (created : U32) => raw_windows_bool_status created one)))))) end)));

def raw_process_with_attributes (executable : RawPtr U8) (command : RawPtr U8)
    (environment : RawPtr U8) (directory : RawPtr U8) (startup : RawPtr U8)
    (size_cell : RawPtr USize) (one : USize) : Runtime U32 :=
    let process_number_0 : USize := (usize_sub one one) in

    runtime_bind USize U32 (raw_load_usize size_cell) (fun (bytes : USize) =>
      match usize_equal bytes process_number_0 with | True => runtime_pure(U32, raw_windows_general_error one) | False =>
        runtime_bind (RawPtr U8) U32 (raw_pages_allocate(bytes, raw_process_eight one)) (fun (attributes : RawPtr U8) =>
          runtime_bind USize U32 (raw_to_bits U8 attributes) (fun (bits : USize) =>
            match usize_equal bits process_number_0 with | True => runtime_pure(U32, raw_size_to_u32 (raw_process_eight one)) | False =>
              runtime_bind U32 U32 (windows_initialize_attributes attributes (raw_size_to_u32 one)
                (raw_size_to_u32 process_number_0) size_cell) (fun (initialized : U32) =>
                  runtime_bind U32 U32 (raw_windows_bool_status initialized one) (fun (status : U32) =>
                    runtime_bind U32 U32 (match u32_equal(status, raw_size_to_u32 process_number_0) with
                      | False => runtime_pure U32 status
                      | True => runtime_bind U32 U32 (raw_process_create_ready executable command environment directory startup attributes one)
                          (fun (created : U32) => runtime_bind Unit U32 (windows_delete_attributes attributes)
                            (fun (_deleted : Unit) => runtime_pure U32 created)) end)
                      (fun (result : U32) => runtime_bind Unit U32 (raw_process_release attributes one)
                        (fun (_released : Unit) => runtime_pure U32 result)))) end)) end);

def raw_process_launch_attributes (executable : RawPtr U8) (command : RawPtr U8)
    (environment : RawPtr U8) (directory : RawPtr U8) (startup : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 (raw_add U8 startup (raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one)))))) (fun (bytes : RawPtr U8) =>
      runtime_bind (RawPtr USize) U32 (raw_cast U8 USize bytes) (fun (size_cell : RawPtr USize) =>
        runtime_bind U32 U32 (windows_initialize_attributes (raw_null U8) (raw_size_to_u32 one)
          (raw_size_to_u32 (usize_sub one one)) size_cell) (fun (query : U32) =>
            match u32_equal(query, raw_size_to_u32 (usize_sub one one)) with
            | False => runtime_pure(U32, raw_windows_general_error one)
            | True => runtime_bind U32 U32 (raw_windows_last_failure one) (fun (status : U32) =>
                match u32_equal(status, raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), usize_add one one))) with | False => runtime_pure U32 status | True =>
                  raw_process_with_attributes executable command environment directory startup size_cell one end) end)));

-- Internal primitive used only after complete public argument/storage checks.
-- Scratch allocation is zero initialized by VirtualAlloc. Exactly three
-- temporary inheritable duplicates are listed; all other handles are excluded.
def raw_process_launch (executable : RawPtr U8) (command : RawPtr U8)
    (environment : RawPtr U8) (directory : RawPtr U8) (input : RawPtr U8)
    (output : RawPtr U8) (error : RawPtr U8) (owner : RawPtr U8) (one : USize) : Runtime U32 :=
    let process_number_24 : USize := (raw_process_eight (usize_add(one, usize_add one one))) in

    runtime_bind (RawPtr U8) U32 (raw_pages_allocate(raw_process_eight (usize_add(raw_process_eight (usize_add one one), usize_add(usize_add one one, usize_add one one))), raw_process_eight one)) (fun (startup : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 startup) (fun (bits : USize) =>
        match usize_equal(bits, usize_sub one one) with | True => runtime_pure(U32, raw_size_to_u32 (raw_process_eight one)) | False =>
          runtime_bind U32 U32 (raw_process_duplicate_streams input output error startup one) (fun (duplicated : U32) =>
            runtime_bind U32 U32 (match u32_equal(duplicated, raw_size_to_u32 (usize_sub one one)) with
              | False => runtime_pure U32 duplicated
              | True => raw_process_launch_attributes executable command environment directory startup one end)
              (fun (result : U32) =>
                runtime_bind Unit U32 (raw_process_close_duplicates startup one) (fun (_closed : Unit) =>
                  runtime_bind Unit U32 (match u32_equal(result, raw_size_to_u32 (usize_sub one one)) with
                    | False => runtime_pure Unit MkUnit
                    | True => runtime_bind (RawPtr U8) Unit (raw_add U8 startup (raw_process_eight (raw_process_eight (usize_add one one)))) (fun (information : RawPtr U8) =>
                        runtime_bind Bool Unit (raw_buffer_copy owner process_number_24 information process_number_24 process_number_24)
                          (fun (copied : Bool) => match copied with | True => runtime_pure Unit MkUnit
                            | False => raw_windows_panic_code (raw_windows_general_error one) end)) end)
                    (fun (_transferred : Unit) => runtime_bind Unit U32 (raw_process_release startup one)
                      (fun (_released : Unit) => runtime_pure U32 result))))) end));
