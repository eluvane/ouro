-- Managed capture owner is 128 zeroed bytes. Fields 0..39 are the raw
-- capture owner; 40/48 first/last argument node, 56 argument count including
-- executable, 64/72 stdout allocation/length, 80/88 stderr allocation/length,
-- 96 child code, 104 launch error, 112 empty input handle, 120 scratch.
-- Every published raw pointer belongs to this owner until close. Nodes are
-- zeroed pages: next at 0, UTF-16 count at 8, terminated text at 16.
import "windows_process_capture.ouro",
  "windows_file_managed.ouro",
  "windows_startup.ouro",
  "windows_text.ouro";

def raw_process_managed_release_cell (owner : RawPtr U8) (offset : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner offset) (fun (bits : USize) =>
match usize_equal(bits, usize_sub one one) with
| True => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))
| False => runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (page : (RawPtr U8)) =>
runtime_bind Bool U32 (raw_pages_release page) (fun (released : Bool) =>
match released with
| False => runtime_pure(U32, raw_windows_general_error one)
| True => runtime_bind Unit U32 (raw_process_store owner offset (usize_sub one one)) (fun (_cleared : Unit) =>
runtime_pure(U32, raw_size_to_u32 (usize_sub one one))) end)) end));

def raw_process_managed_node_free (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load(owner, raw_process_eight (usize_add(usize_add(usize_add(usize_add one one, one), one), one)))) (fun (bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (node : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load(node, usize_sub one one)) (fun (next : USize) =>
runtime_bind Bool U32 (raw_pages_release node) (fun (freed : Bool) =>
match freed with
| False => runtime_pure(U32, raw_windows_general_error one)
| True => runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add(usize_add(usize_add(usize_add one one, one), one), one))) next) (fun (_advanced : Unit) =>
runtime_pure(U32, raw_size_to_u32 (usize_sub one one))) end)))));

-- Cleanup never silently detaches a live direct child.
def raw_process_managed_stop (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load(owner, usize_sub one one)) (fun (bits : USize) =>
match usize_equal(bits, usize_sub one one) with
| True => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))
| False => runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (process : RawPtr U8) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 owner (usize_sub(raw_process_eight (raw_process_eight (usize_add one one)), raw_process_eight one))) (fun (scratch : RawPtr U8) =>
runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 scratch) (fun (code : RawPtr U32) =>
raw_windows_process_cancel process (raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, one)), one)))
  (u32_sub(raw_size_to_u32 (usize_sub one one), raw_size_to_u32 one)) code))) end));

def raw_windows_process_managed_release (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_windows_process_capture_close owner) (fun (captures : U32) =>
runtime_bind U32 U32 (raw_process_close_cell owner (raw_process_eight (usize_add(usize_add(usize_add(usize_add(usize_add(usize_add(raw_process_eight one, one), one), one), one), one), one))) one) (fun (input : U32) =>
runtime_bind U32 U32 (raw_process_managed_release_cell(owner, raw_process_eight (raw_process_eight one))) (fun (output : U32) =>
runtime_bind U32 U32 (raw_process_managed_release_cell(owner, raw_process_eight (usize_add(usize_add(raw_process_eight one, one), one)))) (fun (error : U32) =>
match u8_from_nat 1 with
| Nothing => runtime_pure(U32, raw_windows_general_error one)
| Just running => runtime_bind U32 U32 (runtime_loop U32 (raw_size_to_u32 (usize_sub one one))
(fun (status : U32) => match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with
| False => runtime_pure(U8, u8_sub running running)
| True => runtime_bind USize U8 (raw_process_load(owner, raw_process_eight (usize_add(usize_add(usize_add(usize_add one one, one), one), one)))) (fun (first : USize) =>
runtime_pure(U8, match usize_equal(first, usize_sub one one) with | True => u8_sub running running | False => running end)) end)
(fun (_status : U32) => raw_process_managed_node_free owner)) (fun (nodes : U32) =>
runtime_pure U32 (match u32_equal(captures, raw_size_to_u32 (usize_sub one one)) with | False => captures | True =>
match u32_equal(input, raw_size_to_u32 (usize_sub one one)) with | False => input | True =>
match u32_equal(output, raw_size_to_u32 (usize_sub one one)) with | False => output | True =>
match u32_equal(error, raw_size_to_u32 (usize_sub one one)) with | False => error | True => nodes end end end end)) end)))));

def raw_windows_process_managed_close (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_process_managed_stop owner) (fun (stopped : U32) =>
  runtime_bind U32 U32 (raw_windows_process_managed_release owner) (fun (released : U32) =>
  runtime_pure(U32, match u32_equal(stopped, raw_size_to_u32 (usize_sub one one)) with | True => released | False => stopped end))));

def raw_process_managed_link (owner : RawPtr U8) (node : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_to_bits U8 node) (fun (bits : USize) =>
runtime_bind USize U32 (raw_process_load(owner, raw_process_eight (usize_add(usize_add(usize_add(usize_add(usize_add one one, one), one), one), one)))) (fun (last : USize) =>
runtime_bind USize U32 (raw_process_load(owner, raw_process_eight (usize_add(usize_add(usize_add(usize_add(usize_add(usize_add one one, one), one), one), one), one)))) (fun (count : USize) =>
runtime_bind Unit U32 (match usize_equal(last, usize_sub one one) with
| True => raw_process_store owner (raw_process_eight (usize_add(usize_add(usize_add(usize_add one one, one), one), one))) bits
| False => runtime_bind (RawPtr U8) Unit (raw_from_bits U8 last) (fun (previous : (RawPtr U8)) =>
raw_process_store previous (usize_sub one one) bits) end) (fun (_linked : Unit) =>
runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add(usize_add(usize_add(usize_add(usize_add one one, one), one), one), one))) bits) (fun (_tail : Unit) =>
runtime_bind Unit U32 (raw_process_store(owner, raw_process_eight (usize_add(usize_add(usize_add(usize_add(usize_add(usize_add one one, one), one), one), one), one)), usize_add count one)) (fun (_counted : Unit) =>
runtime_pure(U32, raw_size_to_u32 (usize_sub one one)))))))));

def raw_process_managed_push_allocated (owner : RawPtr U8) (source : RawPtr U8) (bytes : USize) (node : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_process_managed_link owner node) (fun (_linked : U32) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 node (raw_process_eight (usize_add one one))) (fun (text : (RawPtr U8)) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 node (raw_process_eight one)) (fun (count_bytes : (RawPtr U8)) =>
runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 count_bytes) (fun (count : (RawPtr U32)) =>
runtime_bind U32 U32 (raw_windows_utf8_to_utf16 source bytes text bytes count) (fun (status : U32) =>
match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with
| False => runtime_pure U32 status
| True => runtime_bind U32 U32 (raw_load_u32 count) (fun (units : U32) =>
runtime_bind Bool U32 (raw_process_string_valid text (raw_u32_to_size units) one) (fun (valid : Bool) =>
runtime_pure U32 (match valid with
| True => raw_size_to_u32 (usize_sub one one)
| False => raw_windows_parameter_error one end))) end))))));

def raw_windows_process_managed_push (owner : RawPtr U8) (source : RawPtr U8) (bytes : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind Bool U32 (raw_process_storage owner (raw_process_eight (raw_process_eight (usize_add one one))) one) (fun (valid : Bool) =>
match valid with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
runtime_bind USize U32 (raw_process_load(owner, raw_process_eight (usize_add(usize_add(usize_add(usize_add(usize_add(usize_add one one, one), one), one), one), one)))) (fun (count : USize) =>
match (raw_bool_and (usize_less(count, raw_process_command_limit one))
(raw_bool_not (usize_less(raw_windows_int_max one, bytes)))) with
| False => runtime_pure(U32, raw_windows_parameter_error one)
| True => runtime_bind (RawPtr U8) U32 (raw_pages_allocate(usize_add(usize_add(usize_add(raw_process_eight (usize_add one one), one), one), usize_add bytes bytes), raw_process_eight one)) (fun (node : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 node) (fun (bits : USize) =>
match usize_equal(bits, usize_sub one one) with
| True => runtime_pure(U32, raw_windows_general_error one)
| False => raw_process_managed_push_allocated owner source bytes node end)) end) end));
