import "windows_process_bounded_base.ouro";

def raw_capture_event_step (owner : RawPtr U8) (port : RawPtr U8) (workspace : RawPtr U8) (index : USize) : Runtime USize :=
    runtime_bind USize USize (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) USize (raw_add U8 workspace (raw_capture_workspace_event_message one)) (fun (message_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U32) USize (raw_cast U8 U32 message_bytes) (fun (message : (RawPtr U32)) =>
  runtime_bind (RawPtr U8) USize (raw_add U8 workspace (raw_capture_workspace_event_key one)) (fun (key_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) USize (raw_cast U8 USize key_bytes) (fun (key : (RawPtr USize)) =>
  runtime_bind (RawPtr U8) USize (raw_add U8 workspace (raw_capture_workspace_event_overlapped one)) (fun (overlapped_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) USize (raw_cast U8 USize overlapped_bytes) (fun (overlapped : (RawPtr USize)) =>
  runtime_bind U32 USize (windows_capture_port_next port message key overlapped (raw_size_to_u32 (usize_sub one one))) (fun (received : U32) =>
  match u32_equal received (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 USize (raw_windows_last_failure one) (fun (status : U32) =>
  match u32_equal status (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))))) (usize_add one one))) with
| True => runtime_bind Unit USize (raw_process_store owner (raw_capture_owner_queue_empty one) one) (fun (quiet : Unit) =>
  runtime_pure USize (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)))))
| False => runtime_bind Unit USize (raw_process_store owner (raw_capture_owner_queue_error one) (raw_u32_to_size status)) (fun (saved : Unit) =>
  runtime_pure USize (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))))) end)
| False => runtime_bind USize USize (raw_load_usize key) (fun (actual_key : USize) =>
  runtime_bind U32 USize (raw_load_u32 message) (fun (event : U32) =>
  match usize_equal actual_key one with
| True => runtime_bind U32 USize (match raw_capture_or (u32_equal event (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) one))) (u32_equal event (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add one one)))) with
| True => raw_capture_resource owner (raw_u32_to_size event)
| False => runtime_pure U32 (raw_size_to_u32 (usize_sub one one)) end) (fun (noted : U32) =>
  runtime_pure USize (usize_add index one))
| False => runtime_bind Unit USize (raw_process_store owner (raw_capture_owner_queue_error one) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (fun (invalid : Unit) =>
  runtime_pure USize (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))))) end)) end))))))));

def raw_capture_events (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_completion_port one)) (fun (port_bits : USize) =>
  match usize_equal port_bits (usize_sub one one) with
| True => runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_process one)) (fun (process : USize) =>
  match usize_equal process (usize_sub one one) with
| True => runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_queue_empty one) one) (fun (empty : Unit) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))
| False => runtime_pure U32 (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))) end)
| False => match u8_from_nat 1 with | Nothing => runtime_pure U32 (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one)))) | Just running => runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_queue_empty one) (usize_sub one one)) (fun (quiet : Unit) =>
  runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_queue_error one) (usize_sub one one)) (fun (clear : Unit) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_completion_port one)) (fun (port_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 port_bits) (fun (port : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_workspace one)) (fun (workspace_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 workspace_bits) (fun (workspace : (RawPtr U8)) =>
  runtime_bind USize U32 (runtime_loop USize (usize_sub one one)
(fun (index : USize) => runtime_pure U8 (match usize_less index (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)))) with | True => running | False => u8_sub running running end))
(fun (index : USize) => raw_capture_event_step owner port workspace index)) (fun (drained : USize) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_queue_error one)) (fun (status : USize) =>
  runtime_pure U32 (raw_size_to_u32 status))))))))) end end));

def raw_capture_peak (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_job one)) (fun (job_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 job_bits) (fun (job : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_workspace one)) (fun (workspace_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 workspace_bits) (fun (workspace : (RawPtr U8)) =>
  runtime_bind U32 U32 (windows_capture_job_query job (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) one)) workspace (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))))) (raw_null U8)) (fun (queried : U32) =>
  runtime_bind U32 U32 (raw_windows_bool_status queried one) (fun (status : U32) =>
  match u32_equal status (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_process_load workspace (raw_capture_workspace_peak_job_commit one)) (fun (peak : USize) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_peak one)) (fun (prior : USize) =>
  runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_peak one) (match usize_less prior peak with | True => peak | False => prior end)) (fun (recorded : Unit) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_memory one)) (fun (limit : USize) =>
  match usize_less limit peak with
| True => raw_capture_resource owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add one one))
| False => runtime_pure U32 (raw_size_to_u32 (usize_sub one one)) end))))
| False => runtime_pure U32 status end)))))));

def raw_capture_measure (owner : RawPtr U8) (handle_offset : USize) (cap_offset : USize) (kind : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner handle_offset) (fun (bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (stream : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_workspace one)) (fun (workspace_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 workspace_bits) (fun (workspace : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 workspace (raw_capture_workspace_stream_length one)) (fun (length_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize length_bytes) (fun (length : (RawPtr USize)) =>
  runtime_bind U32 U32 (raw_windows_file_length stream length) (fun (status : U32) =>
  match u32_equal status (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_load_usize length) (fun (actual : USize) =>
  runtime_bind USize U32 (raw_process_load owner cap_offset) (fun (limit : USize) =>
  match usize_less limit actual with
| True => raw_capture_note owner kind actual
| False => runtime_pure U32 (raw_size_to_u32 (usize_sub one one)) end))
| False => runtime_pure U32 status end))))))));

def raw_capture_monitor (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_capture_events owner) (fun (events : U32) =>
  match u32_equal events (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_capture_peak owner) (fun (peak : U32) =>
  match u32_equal peak (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_capture_measure owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))))) (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))) (fun (output : U32) =>
  match u32_equal output (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_capture_measure owner (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))))) (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one)) (fun (error : U32) =>
  runtime_pure U32 error)
| False => runtime_pure U32 output end)
| False => runtime_pure U32 peak end)
| False => runtime_pure U32 events end));
