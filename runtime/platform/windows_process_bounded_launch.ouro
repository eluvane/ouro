import "windows_process_bounded_base.ouro";

def raw_capture_limits (owner : RawPtr U8) (job : RawPtr U8) (workspace : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) U32 (raw_add U8 workspace (raw_capture_workspace_process_affinity one)) (fun (process_mask_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize process_mask_bytes) (fun (process_mask : (RawPtr USize)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 workspace (raw_capture_workspace_system_affinity one)) (fun (system_mask_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize system_mask_bytes) (fun (system_mask : (RawPtr USize)) =>
  runtime_bind (RawPtr U8) U32 (windows_current_process) (fun (current : (RawPtr U8)) =>
  runtime_bind U32 U32 (windows_capture_affinity current process_mask system_mask) (fun (queried : U32) =>
  runtime_bind U32 U32 (raw_windows_bool_status queried one) (fun (status : U32) =>
  match u32_equal status (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_load_usize process_mask) (fun (mask : USize) =>
  match usize_equal mask (usize_sub one one) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))) (usize_add one one))))
| False => runtime_bind Unit U32 (raw_process_store_word workspace (raw_capture_workspace_limit_flags one) (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add (usize_add (usize_add one one) (usize_add one one)) one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add one one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one))))))))) (fun (_flags : Unit) =>
  runtime_bind Unit U32 (raw_process_store workspace (raw_capture_workspace_affinity one) (usize_and mask (usize_sub (usize_sub one one) mask))) (fun (_affinity : Unit) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_memory one)) (fun (memory : USize) =>
  runtime_bind Unit U32 (raw_process_store workspace (raw_capture_workspace_job_memory_limit one) memory) (fun (_bound : Unit) =>
  runtime_bind U32 U32 (windows_set_process_job job (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) one)) workspace (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one))))))) (fun (configured : U32) =>
  raw_windows_bool_status configured one))))) end)
| False => runtime_pure U32 status end))))))));

def raw_capture_port (owner : RawPtr U8) (job : RawPtr U8) (workspace : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 (usize_sub (usize_sub one one) one)) (fun (invalid : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (windows_capture_port_create invalid (raw_null U8) (usize_sub one one) (raw_size_to_u32 one)) (fun (port : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_to_bits U8 port) (fun (bits : USize) =>
  match usize_equal bits (usize_sub one one) with
| True => raw_windows_last_failure one
| False => runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_completion_port one) bits) (fun (_owned : Unit) =>
  runtime_bind Unit U32 (raw_process_store workspace (raw_capture_workspace_completion_key one) one) (fun (_key : Unit) =>
  runtime_bind Unit U32 (raw_process_store workspace (raw_capture_workspace_completion_port one) bits) (fun (_stored_port : Unit) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 workspace (raw_capture_workspace_completion_key one)) (fun (association : (RawPtr U8)) =>
  runtime_bind U32 U32 (windows_set_process_job job (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one)) association (raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))))) (fun (associated : U32) =>
  raw_windows_bool_status associated one))))) end))));

def raw_capture_setup (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) U32 (raw_pages_allocate (usize_add (usize_shift_left one (raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one))))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one)))) (fun (workspace : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_to_bits U8 workspace) (fun (bits : USize) =>
  match usize_equal bits (usize_sub one one) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))))
| False => runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_workspace one) bits) (fun (_owned : Unit) =>
  runtime_bind U32 U32 (raw_process_inherit_job owner one) (fun (created : U32) =>
  match u32_equal created (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_job one)) (fun (job_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 job_bits) (fun (job : (RawPtr U8)) =>
  runtime_bind U32 U32 (raw_capture_limits owner job workspace) (fun (configured : U32) =>
  match u32_equal configured (raw_size_to_u32 (usize_sub one one)) with
| True => raw_capture_port owner job workspace
| False => runtime_pure U32 configured end)))
| False => runtime_pure U32 created end)) end)));

def raw_process_bounded_spawn_environment (owner : RawPtr U8) (table : RawPtr U8) (count : USize) (environment : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load table (usize_sub one one)) (fun (exe_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 exe_bits) (fun (executable : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load table (raw_process_eight one)) (fun (units : USize) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 table (raw_process_eight (usize_add one one))) (fun (arguments : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one))) (fun (input_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 input_bits) (fun (input : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add one one) one))) (fun (out_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 out_bits) (fun (output : (RawPtr U8)) =>
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add one one) one) one))) (fun (err_bits : USize) =>
runtime_bind (RawPtr U8) U32 (raw_from_bits U8 err_bits) (fun (error : (RawPtr U8)) =>
runtime_bind Bool U32 (raw_windows_path_valid executable units one) (fun (valid : Bool) =>
match valid with
| False => runtime_pure U32 (raw_windows_parameter_error one)
| True => runtime_bind USize U32 (raw_process_scan executable units (usize_sub one one) (usize_add (usize_add (raw_process_eight (usize_add (usize_add (usize_add one one) one) one)) one) one) False one) (fun (quote : USize) =>
match usize_equal quote units with
| False => runtime_pure U32 (raw_windows_parameter_error one)
| True => raw_process_inherit_start executable units arguments (usize_sub count one)
 environment (raw_null U8) input output error owner one end) end))))))))))));

def raw_process_bounded_spawn (owner : RawPtr U8) (table : RawPtr U8) (count : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind (RawPtr U8) U32 (windows_environment_strings) (fun (environment : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 environment) (fun (bits : USize) =>
match usize_equal bits (usize_sub one one) with
| True => raw_windows_last_failure one
| False => runtime_bind U32 U32 (raw_process_bounded_spawn_environment owner table count environment) (fun (status : U32) =>
runtime_bind U32 U32 (windows_free_environment_strings environment) (fun (freed : U32) =>
match u32_equal freed (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 (usize_add (raw_process_eight (usize_add (raw_process_eight one) one)) one))) (fun (_fatal : Unit) =>
runtime_pure U32 (raw_windows_general_error one))
| False => runtime_pure U32 status end)) end)));

def raw_process_bounded_table (owner : RawPtr U8) (table : RawPtr U8) (count : USize) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add one one) one) one) one))) (fun (first : USize) =>
runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (raw_process_eight one) one) one) one) one) one) one) one)) first) (fun (_cursor : Unit) =>
match u8_from_nat 1 with
| Nothing => runtime_pure U32 (raw_windows_general_error one)
| Just running => runtime_bind USize U32 (runtime_loop USize (usize_sub one one)
(fun (index : USize) => runtime_pure U8 (match usize_less index count with | True => running | False => u8_sub running running end))
(fun (index : USize) => raw_process_managed_table_step owner table index)) (fun (_filled : USize) =>
raw_process_bounded_spawn owner table count) end)));

def raw_process_bounded_launch (owner : RawPtr U8) : Runtime U32 :=
runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add one one) one) one) one) one) one))) (fun (count : USize) =>
match usize_equal count (usize_sub one one) with
| True => runtime_pure U32 (raw_windows_parameter_error one)
| False => runtime_bind (RawPtr U8) U32 (raw_pages_allocate (raw_process_eight (usize_add count count)) (raw_process_eight one)) (fun (table : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 table) (fun (bits : USize) =>
match usize_equal bits (usize_sub one one) with
| True => runtime_pure U32 (raw_windows_general_error one)
| False => runtime_bind U32 U32 (raw_process_bounded_table owner table count) (fun (status : U32) =>
runtime_bind Bool U32 (raw_pages_release table) (fun (freed : Bool) =>
match freed with
| True => runtime_pure U32 status
| False => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 (usize_add (raw_process_eight (usize_add (raw_process_eight one) one)) one))) (fun (_fatal : Unit) =>
runtime_pure U32 (raw_windows_general_error one)) end)) end)) end));
