-- Private managed bridge. A fresh zeroed 136-byte owner extends the capture
-- argument-storage layout without capture files: process/thread at 0/8,
-- argument nodes 40/48/count 56, child exit 96, OS status 104, scratch 120,
-- owned job handle 128. Cells 24/32/64/80/112 remain zero.
-- Child process and descendants belong to the job from creation until close.
-- Parent termination closes the non-inherited job handle, including Ctrl+C
-- under Windows' default console handler. No callback or Ctrl+C ignore state
-- is installed. Foreground calls inherit the parent's cwd and environment.
import "windows_process_inherit_launch.ouro";

def raw_windows_process_inherit_close (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
      let one : USize := raw_process_one anchor in
      runtime_bind U32 U32 (raw_process_close_cell owner (raw_process_eight (raw_process_eight (usize_add one one))) one) (fun (job : U32) =>
        runtime_bind U32 U32 (raw_windows_process_managed_close owner) (fun (resources : U32) =>
          runtime_pure U32 (match u32_equal job (raw_size_to_u32 (usize_sub one one)) with
            | True => resources | False => job end))));

-- Preserve the first conversion/setup error as data. Later pushes perform
-- no conversion; all earlier nodes are retained for the ordinary cleanup.
def raw_windows_process_inherit_push (owner : RawPtr U8) (source : RawPtr U8) (bytes : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
      let one : USize := raw_process_one anchor in
      runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))) one))) (fun (error : USize) =>
        match usize_equal error (usize_sub one one) with
        | False => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
        | True => runtime_bind U32 U32 (raw_windows_process_managed_push owner source bytes) (fun (status : U32) =>
            runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))) one)) (raw_u32_to_size status))
              (fun (saved : Unit) => runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))) end));

def raw_process_inherit_spawn_environment (owner : RawPtr U8) (table : RawPtr U8)
    (count : USize) (environment : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_process_load table (usize_sub one one)) (fun (exe_bits : USize) =>
      runtime_bind (RawPtr U8) U32 (raw_from_bits U8 exe_bits) (fun (executable : RawPtr U8) =>
        runtime_bind USize U32 (raw_process_load table (raw_process_eight one)) (fun (units : USize) =>
          runtime_bind (RawPtr U8) U32 (raw_add U8 table (raw_process_eight (usize_add one one))) (fun (arguments : RawPtr U8) =>
            runtime_bind Bool U32 (raw_windows_path_valid executable units one) (fun (valid : Bool) =>
              match valid with
              | False => runtime_pure U32 (raw_windows_parameter_error one)
              | True => runtime_bind USize U32 (raw_process_scan executable units (usize_sub one one) (usize_add (usize_add (usize_add (raw_process_eight one) (raw_process_eight one)) one) (usize_add (usize_add (raw_process_eight one) (raw_process_eight one)) one)) False one) (fun (quote : USize) =>
                  match usize_equal quote units with
                  | False => runtime_pure U32 (raw_windows_parameter_error one)
                  | True => runtime_bind (RawPtr U8) U32 (windows_get_std_handle (u32_sub (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) one) (usize_add (usize_add (usize_add one one) (usize_add one one)) one))))) (fun (input : RawPtr U8) =>
                      runtime_bind (RawPtr U8) U32 (windows_get_std_handle (u32_sub (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) one) (usize_add (usize_add (usize_add one one) (usize_add one one)) one)) one)))) (fun (output : RawPtr U8) =>
                        runtime_bind (RawPtr U8) U32 (windows_get_std_handle (u32_sub (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)))))) (fun (error : RawPtr U8) =>
                          raw_process_inherit_start executable units arguments (usize_sub count one)
                            environment (raw_null U8) input output error owner one))) end) end)))));

def raw_process_inherit_spawn (owner : RawPtr U8) (table : RawPtr U8) (count : USize) (one : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 windows_environment_strings (fun (environment : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 environment) (fun (bits : USize) =>
        match usize_equal bits (usize_sub one one) with
        | True => raw_windows_last_failure one
        | False => runtime_bind U32 U32 (raw_process_inherit_spawn_environment owner table count environment one) (fun (status : U32) =>
            runtime_bind U32 U32 (windows_free_environment_strings environment) (fun (freed : U32) =>
              match u32_equal freed (raw_size_to_u32 (usize_sub one one)) with
              | True => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one) (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one)) (usize_add (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one) (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one))) (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one) (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one)) (usize_add (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one) (usize_add (usize_add (usize_add (usize_add one one) (usize_add one one)) (usize_add (usize_add one one) (usize_add one one))) one)))) one)))
                  (fun (fatal : Unit) => runtime_pure U32 (raw_windows_general_error one))
              | False => runtime_pure U32 status end)) end));

def raw_process_inherit_table (owner : RawPtr U8) (table : RawPtr U8) (count : USize) (one : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (fun (first : USize) =>
      runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one) (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one)) one)) first) (fun (cursor : Unit) =>
        match u8_from_nat 1 with
        | Nothing => runtime_pure U32 (raw_windows_general_error one)
        | Just running => runtime_bind USize U32 (runtime_loop USize (usize_sub one one)
            (fun (index : USize) => runtime_pure U8 (match usize_less index count with
              | True => running | False => u8_sub running running end))
            (fun (index : USize) => raw_process_managed_table_step owner table index))
            (fun (filled : USize) => raw_process_inherit_spawn owner table count one) end));

def raw_process_inherit_launch_arguments (owner : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (fun (count : USize) =>
      match usize_equal count (usize_sub one one) with
      | True => runtime_pure U32 (raw_windows_parameter_error one)
      | False => runtime_bind (RawPtr U8) U32 (raw_pages_allocate (raw_process_eight (usize_add count count)) (raw_process_eight one)) (fun (table : RawPtr U8) =>
          runtime_bind USize U32 (raw_to_bits U8 table) (fun (bits : USize) =>
            match usize_equal bits (usize_sub one one) with
            | True => runtime_pure U32 (raw_size_to_u32 (raw_process_eight one))
            | False => runtime_bind U32 U32 (raw_process_inherit_table owner table count one) (fun (status : U32) =>
                runtime_bind Unit U32 (raw_process_release table one) (fun (freed : Unit) =>
                  runtime_pure U32 status)) end)) end);

def raw_process_inherit_wait (owner : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_process_load owner (usize_sub one one)) (fun (bits : USize) =>
      runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (process : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (raw_add U8 owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))))) (fun (bytes : RawPtr U8) =>
          runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 bytes) (fun (code : RawPtr U32) =>
            raw_windows_process_wait process (u32_sub (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 one)) code))));

def raw_process_inherit_run_ready (owner : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (raw_process_inherit_job owner one) (fun (job : U32) =>
      match u32_equal job (raw_size_to_u32 (usize_sub one one)) with
      | False => runtime_pure U32 job
      | True => runtime_bind U32 U32 (raw_process_inherit_launch_arguments owner one) (fun (launched : U32) =>
          match u32_equal launched (raw_size_to_u32 (usize_sub one one)) with
          | False => runtime_pure U32 launched
          | True => raw_process_inherit_wait owner one end) end);

def raw_windows_process_inherit_run (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
      let one : USize := raw_process_one anchor in
      runtime_bind USize U32 (raw_process_load owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))) one))) (fun (error : USize) =>
        match usize_equal error (usize_sub one one) with
        | False => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
        | True => runtime_bind U32 U32 (raw_process_inherit_run_ready owner one) (fun (status : U32) =>
            runtime_bind Unit U32 (raw_process_store owner (raw_process_eight (usize_add (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one))) one)) (raw_u32_to_size status))
              (fun (saved : Unit) => runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))) end));
