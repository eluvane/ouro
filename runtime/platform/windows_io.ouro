-- Shared synchronous Windows stream ABI; no managed allocation.
import "windows_x64.ouro";

extern windows_get_std_handle : U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "GetStdHandle" "nogc";
extern windows_write_file : RawPtr U8 -> RawPtr U8 -> U32 -> RawPtr U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "WriteFile" "nogc";
