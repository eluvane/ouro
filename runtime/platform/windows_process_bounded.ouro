import "windows_process_bounded_launch.ouro";
import "windows_process_bounded_wait.ouro";

def raw_capture_discard (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_stdout_length one) (usize_sub one one)) (fun (_output : Unit) =>
  runtime_bind Unit U32 (raw_process_store owner (raw_capture_owner_stderr_length one) (usize_sub one one)) (fun (_error : Unit) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))));

def raw_capture_read_error (owner : RawPtr U8) (status : U32) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let _one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_capture_os owner status) (fun (_saved : U32) =>
  raw_capture_discard owner));

-- Same stop code as TerminateJobObject. Used only for the direct child.
def raw_capture_stop_code (one : USize) : U32 :=
    raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add (usize_add (usize_add one one) (usize_add one one)) one)))));

-- 1024 ms. Rewind/read treat WAIT_TIMEOUT as OS error and would replace timeout.
def raw_capture_cleanup_wait (one : USize) : U32 :=
    raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))) (usize_add one one))));

def raw_capture_reap (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_process one)) (fun (process_bits : USize) =>
  match usize_equal process_bits (usize_sub one one) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind (RawPtr U8) U32 (raw_from_bits U8 process_bits) (fun (process : (RawPtr U8)) =>
  runtime_bind U32 U32 (windows_wait_process process (raw_size_to_u32 (usize_sub one one))) (fun (ready : U32) =>
  match u32_equal ready (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 ready
| False => match u32_equal ready (raw_size_to_u32 (usize_add (usize_shift_left one (raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))))) (usize_add one one))) with
| True => runtime_bind U32 U32 (windows_terminate_process process (raw_capture_stop_code one)) (fun (stopped : U32) =>
  runtime_bind U32 U32 (windows_wait_process process (raw_capture_cleanup_wait one)) (fun (waited : U32) =>
  runtime_pure U32 (match u32_equal stopped stopped with | True => waited | False => waited end)))
| False => runtime_pure U32 ready end end)) end));

def raw_capture_output_failure (owner : RawPtr U8) (kind : USize) (actual : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_outcome one)) (fun (current : USize) =>
  match usize_equal current (usize_add (usize_add (usize_add one one) (usize_add one one)) one) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => raw_capture_result owner kind actual end));

def raw_capture_read (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_stdout_cap one)) (fun (output_limit : USize) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_stderr_cap one)) (fun (error_limit : USize) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_stdout_handle one)) (fun (output_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 output_bits) (fun (output : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_stderr_handle one)) (fun (error_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 error_bits) (fun (error : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_workspace one)) (fun (workspace_bits : USize) =>
  runtime_bind (RawPtr U8) U32 (raw_from_bits U8 workspace_bits) (fun (workspace : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 workspace (raw_capture_workspace_stream_length one)) (fun (length_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize length_bytes) (fun (length : (RawPtr USize)) =>
  runtime_bind U32 U32 (raw_windows_file_length output length) (fun (out_status : U32) =>
  match u32_equal out_status (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_load_usize length) (fun (out_bytes : USize) =>
  match usize_less output_limit out_bytes with
| True => runtime_bind U32 U32 (raw_capture_output_failure owner (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) out_bytes) (fun (_recorded : U32) =>
  raw_capture_discard owner)
| False => runtime_bind U32 U32 (raw_windows_file_length error length) (fun (err_status : U32) =>
  match u32_equal err_status (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_load_usize length) (fun (err_bytes : USize) =>
  match usize_less error_limit err_bytes with
| True => runtime_bind U32 U32 (raw_capture_output_failure owner (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one) err_bytes) (fun (_recorded : U32) =>
  raw_capture_discard owner)
| False => runtime_bind U32 U32 (raw_windows_process_capture_rewind owner) (fun (rewound : U32) =>
  match u32_equal rewound (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_process_managed_read owner (raw_capture_owner_stdout_handle one) (raw_capture_owner_stdout_buffer one)) (fun (output_0 : U32) =>
  match u32_equal output_0 (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_process_managed_read owner (raw_capture_owner_stderr_handle one) (raw_capture_owner_stderr_buffer one)) (fun (error_0 : U32) =>
  match u32_equal error_0 (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => raw_capture_read_error owner error_0 end)
| False => raw_capture_read_error owner output_0 end)
| False => raw_capture_read_error owner rewound end) end)
| False => raw_capture_read_error owner err_status end) end)
| False => raw_capture_read_error owner out_status end))))))))))));

def raw_capture_launched (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_capture_wait owner) (fun (waited : U32) =>
  match u32_equal waited (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => raw_capture_os owner waited end));

def raw_capture_close_handles (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_process_close_cell owner (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) one) (fun (job : U32) =>
  runtime_bind U32 U32 (match u32_equal job (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size job)) (fun (_recorded : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) (fun (_noted : U32) =>
  runtime_bind U32 U32 (raw_process_close_cell owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one)))) one) (fun (port : U32) =>
  runtime_bind U32 U32 (match u32_equal port (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size port)) (fun (_recorded : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) (fun (_noted_0 : U32) =>
  runtime_bind U32 U32 (raw_process_close_cell owner (usize_sub one one) one) (fun (process : U32) =>
  runtime_bind U32 U32 (match u32_equal process (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size process)) (fun (_recorded : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) (fun (_noted_1 : U32) =>
  runtime_bind U32 U32 (raw_process_close_cell owner (raw_capture_owner_thread one) one) (fun (thread : U32) =>
  runtime_bind U32 U32 (match u32_equal thread (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size thread)) (fun (_recorded : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) (fun (_noted_2 : U32) =>
  runtime_bind U32 U32 (raw_process_close_cell owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one)))) one) (fun (output : U32) =>
  runtime_bind U32 U32 (match u32_equal output (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size output)) (fun (_recorded : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) (fun (_noted_3 : U32) =>
  runtime_bind U32 U32 (raw_process_close_cell owner (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) one) (fun (error : U32) =>
  runtime_bind U32 U32 (match u32_equal error (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size error)) (fun (_recorded : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) (fun (_noted_4 : U32) =>
  runtime_bind U32 U32 (raw_process_close_cell owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))))) one) (fun (input : U32) =>
  runtime_bind U32 U32 (match u32_equal input (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size input)) (fun (_recorded : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end) (fun (_noted : U32) =>
  runtime_pure U32 (raw_size_to_u32 (usize_sub one one)))))))))))))))));

def raw_windows_process_bounded_run (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_outcome one)) (fun (kind : USize) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_conversion_error one)) (fun (conversion : USize) =>
  match usize_equal kind (usize_sub one one) with
| True => match usize_equal conversion (usize_sub one one) with
| True => runtime_bind U32 U32 (raw_capture_validate owner) (fun (_validated : U32) =>
  runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_outcome one)) (fun (kind_0 : USize) =>
  match usize_equal kind_0 (usize_sub one one) with
| True => runtime_bind U32 U32 (raw_capture_open owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) (usize_add one one)))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one))))) (fun (stdout : U32) =>
  match u32_equal stdout (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_capture_open owner (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one)))) (fun (stderr : U32) =>
  match u32_equal stderr (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_capture_setup owner) (fun (setup : U32) =>
  match u32_equal setup (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_capture_time owner (raw_capture_owner_execution_start one)) (fun (_started : U32) =>
  runtime_bind U32 U32 (raw_process_bounded_launch owner) (fun (launched : U32) =>
  match u32_equal launched (raw_size_to_u32 (usize_sub one one)) with
| True => raw_capture_launched owner
| False => raw_capture_os owner launched end))
| False => raw_capture_os owner setup end)
| False => raw_capture_os owner stderr end)
| False => raw_capture_os owner stdout end)
| False => runtime_pure U32 (raw_size_to_u32 (usize_sub one one)) end))
| False => raw_capture_result owner one conversion end
| False => runtime_pure U32 (raw_size_to_u32 (usize_sub one one)) end))) (fun (_executed : U32) =>
  runtime_bind U32 U32 (runtime_bind U32 U32 (raw_capture_quiesce owner) (fun (quiet : U32) =>
  match u32_equal quiet (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind U32 U32 (raw_capture_reap owner) (fun (reaped : U32) =>
  match u32_equal reaped (raw_size_to_u32 (usize_sub one one)) with
| True => runtime_bind USize U32 (raw_process_load owner (raw_capture_owner_outcome one)) (fun (kind : USize) =>
  match raw_capture_or (usize_equal kind (usize_sub one one)) (raw_capture_or (usize_equal kind (usize_add one one)) (usize_equal kind (usize_add (usize_add (usize_add one one) (usize_add one one)) one))) with
| True => raw_capture_read owner
| False => raw_capture_discard owner end)
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size reaped)) (fun (_recorded : U32) =>
  raw_capture_discard owner) end)
| False => runtime_bind U32 U32 (raw_capture_result owner (usize_add (usize_add one one) one) (raw_u32_to_size quiet)) (fun (_recorded : U32) =>
  raw_capture_discard owner) end)) (fun (_captured : U32) =>
  raw_capture_close_handles owner)));

-- Last-handle close is a fallback after a failed finite quiescence check.
-- Cleanup waits for the process handle and may use a finite TerminateProcess
-- when the job did not contain the child. It never waits INFINITE.
def raw_windows_process_bounded_close (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
  let one : USize := raw_process_one anchor in
runtime_bind U32 U32 (raw_process_close_cell owner (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) one) (fun (job : U32) =>
  runtime_bind U32 U32 (raw_process_close_cell owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add one one) one)))) one) (fun (port : U32) =>
  runtime_bind U32 U32 (raw_process_managed_release_cell owner (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)) one))) (usize_add (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) one) (usize_add (usize_add one one) one)))) (usize_shift_left one (raw_size_to_u32 (usize_add (usize_add (usize_add one one) (usize_add one one)) one)))))) (fun (workspace : U32) =>
  runtime_bind U32 U32 (raw_windows_process_managed_release owner) (fun (resources : U32) =>
  runtime_pure U32 (match u32_equal job (raw_size_to_u32 (usize_sub one one)) with | False => job | True => match u32_equal port (raw_size_to_u32 (usize_sub one one)) with | False => port | True => match u32_equal workspace (raw_size_to_u32 (usize_sub one one)) with | False => workspace | True => resources end end end))))));
