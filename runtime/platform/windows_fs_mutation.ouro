-- These adapters operate on a caller-owned, writable, terminated UTF-16 path.
-- Parent creation restores every temporary separator before returning. The
-- final OS status is retained; low-level Unit actions decide its contract.
import "windows_fs.ouro";

def raw_windows_directory_prefix (path : RawPtr U8) (index : USize) (one : USize) : Runtime USize :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    let slash : USize := usize_sub (usize_add (usize_add sixteen sixteen) sixteen) one in
    let backslash : USize := usize_sub (usize_add slash slash) two in
    let next : USize := usize_add index one in
    runtime_bind USize USize (raw_windows_wide_unit path index one) (fun (code : USize) =>
      let separator : Bool := match usize_equal code slash with
        | True => True | False => usize_equal code backslash end in
      match separator with
      | False => runtime_pure USize next
      | True => runtime_bind (RawPtr U8) USize (raw_add U8 path (usize_add index index)) (fun (first : RawPtr U8) =>
          runtime_bind U8 USize (raw_load_u8 first) (fun (saved : U8) =>
            runtime_bind Unit USize (raw_store_u8 first (u8_sub saved saved)) (fun (_terminated : Unit) =>
              runtime_bind U32 USize (windows_create_directory path (raw_null U8)) (fun (_prefix_status : U32) =>
                runtime_bind Unit USize (raw_store_u8 first saved)
                  (fun (_restored : Unit) => runtime_pure USize next))))) end);

def raw_windows_directory_parents (path : RawPtr U8) (units : USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid path units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => match u8_from_nat 1 with
          | Nothing => runtime_pure U32 (raw_windows_parameter_error one)
          | Just running => runtime_bind USize U32 (runtime_loop USize one
              (fun (index : USize) => runtime_pure U8 (match usize_less index units with
                | True => running | False => u8_sub running running end))
              (fun (index : USize) => raw_windows_directory_prefix path index one))
              (fun (_finished : USize) => runtime_bind U32 U32 (windows_create_directory path (raw_null U8))
                (fun (status : U32) => raw_windows_bool_status status one)) end end) end;

-- DeleteFileW handles file entries; RemoveDirectoryW handles empty directories
-- and directory links. This operation never enumerates or deletes children.
def raw_windows_path_remove (path : RawPtr U8) (units : USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid path units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind U32 U32 (windows_delete_file path) (fun (status : U32) =>
            match u32_equal status (raw_size_to_u32 (usize_sub one one)) with
            | False => raw_windows_bool_status status one
            | True => runtime_bind U32 U32 (windows_remove_directory path)
                (fun (directory_status : U32) => raw_windows_bool_status directory_status one) end) end) end;
