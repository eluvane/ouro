-- Metadata-preserving source publication with an explicit recovery file.
-- The caller owns three distinct ordinary files on one volume; the stage and
-- backup are private. Zero publishes the stage and moves the old source to the
-- backup. Nonzero retains the actual OS status, including partial 1176/1177.
-- Ouro owns recovery; this adapter never guesses which file to remove.
import "windows_fs_security.ouro";
import "windows_fs_replace_info.ouro";

extern windows_file_attributes : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFileAttributesW" "nogc";
extern windows_set_file_attributes : RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "SetFileAttributesW" "nogc";
extern windows_replace_file : RawPtr U8 -> RawPtr U8 -> RawPtr U8 -> U32 -> RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "ReplaceFileW" "nogc";

def raw_windows_replace_commit (source : RawPtr U8) (stage : RawPtr U8)
    (backup : RawPtr U8) (attributes : U32) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (raw_windows_file_same_security_owner source stage one) (fun (identity : U32) =>
      match u32_equal identity (u32_sub identity identity) with
      | False => runtime_pure U32 identity
      | True => runtime_bind U32 U32 (windows_set_file_attributes stage attributes) (fun (prepared : U32) =>
          match u32_equal prepared (u32_sub prepared prepared) with
          | True => raw_windows_last_failure one
          | False => runtime_bind U32 U32
              (windows_replace_file source stage backup (u32_sub attributes attributes) (raw_null U8) (raw_null U8))
              (fun (result : U32) => raw_windows_bool_status result one)
          end)
      end);

def raw_windows_replace_backup (source : RawPtr U8) (stage : RawPtr U8)
    (backup : RawPtr U8) (attributes : U32) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (windows_file_attributes backup) (fun (flags : U32) =>
      match u32_equal flags (u32_sub (u32_sub flags flags) (raw_size_to_u32 one)) with
      | True => raw_windows_last_failure one
      | False => match raw_windows_replace_supported flags one with
        | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind U32 U32 (raw_windows_replace_files source stage backup one) (fun (status : U32) =>
            match u32_equal status (u32_sub status status) with
            | True => raw_windows_replace_commit source stage backup attributes one
            | False => runtime_pure U32 status end)
        end
      end);

def raw_windows_replace_stage (source : RawPtr U8) (stage : RawPtr U8)
    (backup : RawPtr U8) (attributes : U32) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (windows_file_attributes stage) (fun (flags : U32) =>
      match u32_equal flags (u32_sub (u32_sub flags flags) (raw_size_to_u32 one)) with
      | True => raw_windows_last_failure one
      | False => match raw_windows_replace_supported flags one with
        | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => raw_windows_replace_backup source stage backup attributes one
        end
      end);

def raw_windows_replace_source (source : RawPtr U8) (stage : RawPtr U8)
    (backup : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (windows_file_attributes source) (fun (flags : U32) =>
      match u32_equal flags (u32_sub (u32_sub flags flags) (raw_size_to_u32 one)) with
      | True => raw_windows_last_failure one
      | False => match raw_windows_replace_supported flags one with
        | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => raw_windows_replace_stage source stage backup flags one
        end
      end);

def raw_windows_file_replace (source : RawPtr U8) (source_units : USize)
    (stage : RawPtr U8) (stage_units : USize) (backup : RawPtr U8) (backup_units : USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 source_units))
        (fun (_ : Unit) => runtime_pure U32 (raw_size_to_u32 source_units))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid source source_units one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind Bool U32 (raw_windows_path_valid stage stage_units one) (fun (staged : Bool) =>
            match staged with | False => runtime_pure U32 (raw_windows_parameter_error one)
            | True => runtime_bind Bool U32 (raw_windows_path_valid backup backup_units one) (fun (saved : Bool) =>
                match saved with | False => runtime_pure U32 (raw_windows_parameter_error one)
                | True => raw_windows_replace_source source stage backup one end) end) end)
    end;
