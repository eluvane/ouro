    "windows-x86_64" "win64" "kernel32.dll" "CreateJobObjectW" "nogc";
extern windows_set_process_job : RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "SetInformationJobObject" "nogc";

