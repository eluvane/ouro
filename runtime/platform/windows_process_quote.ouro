-- Microsoft command-line argument rules, implemented entirely in Ouro.
-- Every argument is quoted. Backslashes before a quote and trailing
-- backslashes are doubled; a literal quote gets one additional backslash.
-- See learn.microsoft.com/cpp/c-language/parsing-c-command-line-arguments.
import "windows_process_base.ouro";

-- The command's content limit is 32766 UTF-16 units; one final zero gives
-- CreateProcessW's maximum of 32767. The sentinel 32768 denotes overflow.
def raw_process_command_limit (one : USize) : USize :=
    usize_sub(usize_shift_left(one, raw_size_to_u32 (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one))))), usize_add one one);
def raw_process_command_invalid (one : USize) : USize :=
    usize_shift_left(one, raw_size_to_u32 (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))));

def raw_process_string_valid (source : RawPtr U8) (units : USize) (one : USize) : Runtime Bool :=
    let process_number_0 : USize := (usize_sub one one) in

    match usize_less(raw_process_command_limit one, units) with | True => runtime_pure Bool False | False =>
      match usize_equal units process_number_0 with | False => raw_windows_path_valid source units one | True =>
        runtime_bind Bool Bool (raw_windows_wide_aligned source one one) (fun (aligned : Bool) =>
          match aligned with | False => runtime_pure Bool False | True =>
            runtime_bind Bool Bool (raw_buffer_range(source, usize_add one one, process_number_0, usize_add one one)) (fun (range : Bool) =>
              match range with | False => runtime_pure Bool False | True =>
                runtime_bind USize Bool (raw_windows_wide_unit source process_number_0 one)
                  (fun (value : USize) => runtime_pure(Bool, usize_equal value process_number_0)) end) end) end end;

-- Scan a live UTF-16 range. Equal=True consumes a run of the chosen code;
-- Equal=False stops at that code. Neither path reads the limit position.
def raw_process_scan (source : RawPtr U8) (limit : USize) (start : USize)
    (code : USize) (equal : Bool) (one : USize) : Runtime USize :=
    match u8_from_nat 1 with | Nothing => runtime_pure USize limit | Just running =>
      runtime_loop USize start
        (fun (index : USize) => match usize_less index limit with
          | False => runtime_pure(U8, u8_sub running running)
          | True => runtime_bind USize U8 (raw_windows_wide_unit source index one) (fun (value : USize) =>
              let matched : Bool := match equal with | True => usize_equal value code
                | False => raw_bool_not (usize_equal value code) end in
              runtime_pure U8 (match matched with
                | True => running | False => u8_sub running running end)) end)
        (fun (index : USize) => runtime_pure(USize, usize_add index one)) end;

def raw_process_store_ascii (output : RawPtr U8) (index : USize) (value : U8) (one : USize) : Runtime Unit :=
    runtime_bind (RawPtr U8) Unit (raw_add U8 output (usize_add index index)) (fun (low : RawPtr U8) =>
      runtime_bind Unit Unit (raw_store_u8 low value) (fun (_stored : Unit) =>
        runtime_bind (RawPtr U8) Unit (raw_add U8 low one) (fun (high : RawPtr U8) =>
          raw_store_u8(high, u8_sub value value))));

-- Output is a private 32767-unit allocation. Writes before an overflow are
-- discarded by the launch caller; no process or user output is created.
def raw_process_emit_ascii (output : RawPtr U8) (cursor : USize) (value : U8)
    (count : USize) (one : USize) : Runtime USize :=
    let limit : USize := raw_process_command_limit one in
    match usize_less limit cursor with | True => runtime_pure(USize, raw_process_command_invalid one) | False =>
      match usize_less(usize_sub limit cursor, count) with | True => runtime_pure(USize, raw_process_command_invalid one) | False =>
        let end_position : USize := usize_add cursor count in
        match u8_from_nat 1 with | Nothing => runtime_pure(USize, raw_process_command_invalid one) | Just running =>
          runtime_loop USize cursor
            (fun (position : USize) => runtime_pure U8 (match usize_less position end_position with
              | True => running | False => u8_sub running running end))
            (fun (position : USize) => runtime_bind Unit USize (raw_process_store_ascii output position value one)
              (fun (_stored : Unit) => runtime_pure(USize, usize_add position one))) end end end;

def raw_process_emit_wide (output : RawPtr U8) (cursor : USize)
    (source : RawPtr U8) (index : USize) (one : USize) : Runtime USize :=
    match usize_less(cursor, raw_process_command_limit one) with
    | False => runtime_pure(USize, raw_process_command_invalid one)
    | True => runtime_bind (RawPtr U8) USize (raw_add U8 source (usize_add index index)) (fun (read_low : RawPtr U8) =>
        runtime_bind (RawPtr U8) USize (raw_add U8 output (usize_add cursor cursor)) (fun (write_low : RawPtr U8) =>
          runtime_bind U8 USize (raw_load_u8 read_low) (fun (low : U8) =>
            runtime_bind Unit USize (raw_store_u8 write_low low) (fun (_stored_low : Unit) =>
              runtime_bind (RawPtr U8) USize (raw_add U8 read_low one) (fun (read_high : RawPtr U8) =>
                runtime_bind (RawPtr U8) USize (raw_add U8 write_low one) (fun (write_high : RawPtr U8) =>
                  runtime_bind U8 USize (raw_load_u8 read_high) (fun (high : U8) =>
                    runtime_bind Unit USize (raw_store_u8 write_high high)
                      (fun (_stored_high : Unit) => runtime_pure(USize, usize_add cursor one))))))))) end;

def raw_process_quote_run (source : RawPtr U8) (units : USize) (index : USize)
    (next : USize) (output : RawPtr U8) (cursor : RawPtr USize) (one : USize) : Runtime USize :=
    let process_number_34 : USize := (usize_add(raw_process_eight (usize_add(usize_add one one, usize_add one one)), usize_add one one)) in

    runtime_bind USize USize (match usize_equal next units with
      | True => runtime_pure USize process_number_34 | False => raw_windows_wide_unit source next one end)
      (fun (code : USize) =>
        let slashes : USize := usize_sub next index in
        let escaped : USize := match usize_equal code process_number_34 with
          | False => slashes | True => usize_add (usize_add slashes slashes)
              (match usize_equal next units with | True => (usize_sub one one) | False => one end) end in
        runtime_bind USize USize (raw_load_usize cursor) (fun (position : USize) =>
          runtime_bind USize USize (match u8_from_nat 92 with
            | Nothing => runtime_pure(USize, raw_process_command_invalid one)
            | Just slash => raw_process_emit_ascii output position slash escaped one end)
            (fun (after_slashes : USize) =>
              runtime_bind USize USize (match usize_equal next units with
                | True => runtime_pure USize after_slashes
                | False => raw_process_emit_wide output after_slashes source next one end)
                (fun (after_code : USize) => runtime_bind Unit USize (raw_store_usize cursor after_code)
                  (fun (_stored : Unit) => runtime_pure USize (match usize_less(raw_process_command_limit one, after_code) with
                    | True => usize_add units one
                    | False => match usize_equal next units with | True => units | False => usize_add next one end end))))));

def raw_process_quote_argument (source : RawPtr U8) (units : USize)
    (output : RawPtr U8) (cursor : RawPtr USize) (one : USize) : Runtime USize :=
    match u8_from_nat 34 with | Nothing => runtime_pure(USize, raw_process_command_invalid one) | Just quote =>
      match u8_from_nat 1 with | Nothing => runtime_pure(USize, raw_process_command_invalid one) | Just running =>
        runtime_bind USize USize (raw_load_usize cursor) (fun (position : USize) =>
          runtime_bind USize USize (raw_process_emit_ascii output position quote one one) (fun (opened : USize) =>
            runtime_bind Unit USize (raw_store_usize cursor opened) (fun (_stored_open : Unit) =>
              runtime_bind USize USize (runtime_loop USize (usize_sub one one)
                (fun (index : USize) => runtime_pure U8 (match usize_less index units with
                  | True => running | False => u8_sub running running end))
                (fun (index : USize) => runtime_bind USize USize (raw_process_scan source units index (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(one, usize_add one one))), usize_add(usize_add one one, usize_add one one))) True one)
                  (fun (next : USize) => raw_process_quote_run source units index next output cursor one)))
                (fun (_finished : USize) => runtime_bind USize USize (raw_load_usize cursor) (fun (after : USize) =>
                  runtime_bind USize USize (raw_process_emit_ascii output after quote one one) (fun (closed : USize) =>
                    runtime_bind Unit USize (raw_store_usize cursor closed)
                      (fun (_stored_close : Unit) => runtime_pure USize closed))))))) end end;

-- argv excludes argv[0]. Each 16-byte descriptor is { pointer bits, units };
-- each pointed-to string is valid, terminated UTF-16, including empty args.
-- All memory remains live and unmodified by other threads during this call.
def raw_process_command_step (arguments : RawPtr U8) (index : USize)
    (output : RawPtr U8) (cursor : RawPtr USize) (one : USize) : Runtime USize :=
    let offset : USize := raw_process_eight (usize_add index index) in
    runtime_bind USize USize (raw_process_load arguments offset) (fun (bits : USize) =>
      runtime_bind USize USize (raw_process_load(arguments, usize_add(offset, raw_process_eight one))) (fun (units : USize) =>
        runtime_bind (RawPtr U8) USize (raw_from_bits U8 bits) (fun (source : RawPtr U8) =>
          runtime_bind USize USize (raw_load_usize cursor) (fun (position : USize) =>
            runtime_bind USize USize (match u8_from_nat 32 with
              | Nothing => runtime_pure(USize, raw_process_command_invalid one)
              | Just space => raw_process_emit_ascii output position space one one end) (fun (separated : USize) =>
                runtime_bind Unit USize (raw_store_usize cursor separated) (fun (_stored : Unit) =>
                  runtime_bind USize USize (raw_process_quote_argument source units output cursor one)
                    (fun (_quoted : USize) => runtime_pure(USize, usize_add index one))))))));

def raw_process_build_command (executable : RawPtr U8) (executable_units : USize)
    (arguments : RawPtr U8) (count : USize) (output : RawPtr U8)
    (cursor : RawPtr USize) (one : USize) : Runtime USize :=
    runtime_bind Unit USize (raw_store_usize(cursor, usize_sub one one)) (fun (_initialized : Unit) =>
      runtime_bind USize USize (raw_process_quote_argument executable executable_units output cursor one) (fun (_first : USize) =>
        match u8_from_nat 1 with | Nothing => runtime_pure(USize, raw_process_command_invalid one) | Just running =>
          runtime_bind USize USize (runtime_loop USize (usize_sub one one)
            (fun (index : USize) => runtime_bind USize U8 (raw_load_usize cursor) (fun (position : USize) =>
              runtime_pure U8 (match raw_bool_and (usize_less index count)
                (raw_bool_not (usize_less(raw_process_command_limit one, position))) with
                | True => running | False => u8_sub running running end)))
            (fun (index : USize) => raw_process_command_step arguments index output cursor one))
            (fun (_finished : USize) => runtime_bind USize USize (raw_load_usize cursor) (fun (position : USize) =>
              match usize_less(raw_process_command_limit one, position) with
              | True => runtime_pure(USize, raw_process_command_invalid one)
              | False => runtime_bind Unit USize (raw_process_store_ascii output position (u8_sub running running) one)
                  (fun (_terminated : Unit) => runtime_pure USize position) end)) end));
