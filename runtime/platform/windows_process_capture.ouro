-- Capture owner: PROCESS_INFORMATION at 0..23, stdout handle at 24 and
-- stderr handle at 32, total 40 bytes aligned to eight. Initialize it to zero.
-- Exclusive CREATE_NEW files use DELETE_ON_CLOSE. The two original handles
-- stay non-inheritable; process_start creates its explicit temporary duplicates.
-- This captures arbitrarily large streams without pipe-buffer deadlock.
-- Disk capacity remains a host limit. Descendant processes are not tracked.
import "windows_process.ouro";

def raw_process_capture_create (path : RawPtr U8) (units : USize)
    (owner : RawPtr U8) (offset : USize) (one : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 (raw_add U8 owner offset) (fun (bytes : RawPtr U8) =>
      runtime_bind (RawPtr USize) U32 (raw_cast U8 USize bytes) (fun (cell : RawPtr USize) =>
        raw_windows_file_open path units
          (raw_size_to_u32 (usize_shift_left (usize_add one (usize_add one one)) (raw_size_to_u32 (usize_add (raw_process_eight (usize_add one (usize_add one one))) (usize_add (usize_add one (usize_add one one)) (usize_add one (usize_add one one)))))))
          (raw_size_to_u32 (usize_sub one one)) (raw_size_to_u32 one) True cell));

def raw_process_capture_empty (owner : RawPtr U8) (one : USize) : Runtime Bool :=
    runtime_bind Bool Bool (raw_process_storage owner (raw_process_eight (usize_add (usize_add one one) (usize_add one (usize_add one one)))) one) (fun (valid : Bool) =>
      match valid with | False => runtime_pure Bool False | True =>
        runtime_bind Bool Bool (raw_process_owner_empty owner one) (fun (empty : Bool) =>
          match empty with | False => runtime_pure Bool False | True =>
            runtime_bind USize Bool (raw_process_load owner (raw_process_eight (usize_add one (usize_add one one)))) (fun (output : USize) =>
              runtime_bind USize Bool (raw_process_load owner (raw_process_eight (usize_add (usize_add one one) (usize_add one one)))) (fun (error : USize) =>
                runtime_pure Bool (raw_bool_and (usize_equal output (usize_sub one one)) (usize_equal error (usize_sub one one))))) end) end);

-- Open capture files before process_start. Paths must name new files in an
-- owned directory. A collision never reopens/truncates an existing file.
-- If the second open fails, close the first. A rare failed cleanup preserves
-- its owner cell: callers must call capture_close even after an open failure.
def raw_windows_process_capture_open (output_path : RawPtr U8) (output_units : USize)
    (error_path : RawPtr U8) (error_units : USize) (owner : RawPtr U8) : Runtime U32 :=
    let one : USize := raw_process_one output_units in
    let process_number_24 : USize := (raw_process_eight (usize_add one (usize_add one one))) in
    let process_number_40 : USize := (raw_process_eight (usize_add (usize_add one one) (usize_add one (usize_add one one)))) in

    runtime_bind Bool U32 (raw_process_capture_empty owner one) (fun (empty : Bool) =>
      match empty with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
        runtime_bind Bool U32 (raw_windows_path_output output_path output_units owner process_number_40 (raw_process_eight one) one) (fun (first_valid : Bool) =>
          match first_valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
            runtime_bind Bool U32 (raw_windows_path_output error_path error_units owner process_number_40 (raw_process_eight one) one) (fun (second_valid : Bool) =>
              match second_valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                runtime_bind U32 U32 (raw_process_capture_create output_path output_units owner process_number_24 one) (fun (first : U32) =>
                  match u32_equal first (raw_size_to_u32 (usize_sub one one)) with | False => runtime_pure U32 first | True =>
                    runtime_bind U32 U32 (raw_process_capture_create error_path error_units owner (raw_process_eight (usize_add (usize_add one one) (usize_add one one))) one) (fun (second : U32) =>
                      match u32_equal second (raw_size_to_u32 (usize_sub one one)) with | True => runtime_pure U32 second | False =>
                        runtime_bind U32 U32 (raw_process_close_cell owner process_number_24 one)
                          (fun (_cleanup : U32) => runtime_pure U32 second) end) end) end) end) end);

def raw_process_capture_ready (owner : RawPtr U8) (one : USize) : Runtime U32 :=
    let process_number_0 : USize := (usize_sub one one) in

    runtime_bind Bool U32 (raw_process_storage owner (raw_process_eight (usize_add (usize_add one one) (usize_add one (usize_add one one)))) one) (fun (valid : Bool) =>
      match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
        runtime_bind USize U32 (raw_process_load owner process_number_0) (fun (bits : USize) =>
          runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (process : RawPtr U8) =>
            runtime_bind Bool U32 (raw_windows_handle_valid process one) (fun (live : Bool) =>
              match live with | False => runtime_pure U32 (raw_windows_invalid_handle one) | True =>
                runtime_bind U32 U32 (windows_wait_process process (raw_size_to_u32 process_number_0)) (fun (wait : U32) =>
                  match u32_equal wait (raw_size_to_u32 process_number_0) with | True => runtime_pure U32 wait | False =>
                    match u32_equal wait (raw_size_to_u32 (usize_add (raw_process_eight (raw_process_eight (usize_add (usize_add one one) (usize_add one one)))) (usize_add one one))) with | True => runtime_pure U32 wait | False =>
                      match u32_equal wait (u32_sub (raw_size_to_u32 process_number_0) (raw_size_to_u32 one)) with
                      | True => raw_windows_last_failure one | False => runtime_pure U32 (raw_windows_general_error one) end end end) end))) end);

def raw_process_capture_rewind_one (owner : RawPtr U8) (offset : USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_process_load owner offset) (fun (bits : USize) =>
      runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (file : RawPtr U8) =>
        raw_windows_process_rewind file));

-- Rewind after wait/cancel and before reading either stream. A live process
-- returns WAIT_TIMEOUT and no file position is changed. Keep its process
-- handle until reading is complete; no other thread may seek/read these files.
def raw_windows_process_capture_rewind (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
      let one : USize := raw_process_one anchor in
      runtime_bind U32 U32 (raw_process_capture_ready owner one) (fun (ready : U32) =>
        match u32_equal ready (raw_size_to_u32 (usize_sub one one)) with | False => runtime_pure U32 ready | True =>
          runtime_bind U32 U32 (raw_process_capture_rewind_one owner (raw_process_eight (usize_add one (usize_add one one)))) (fun (first : U32) =>
            match u32_equal first (raw_size_to_u32 (usize_sub one one)) with | False => runtime_pure U32 first | True =>
              raw_process_capture_rewind_one owner (raw_process_eight (usize_add (usize_add one one) (usize_add one one))) end) end));

-- Read an already rewound stream. Returns exact transferred bytes, zero at
-- EOF. The buffer/count must not overlap any owner cell. A live child returns
-- WAIT_TIMEOUT without changing output or the shared file position.
def raw_windows_process_capture_read (owner : RawPtr U8) (error_stream : Bool)
    (buffer : RawPtr U8) (bytes : USize) (count : RawPtr U32) : Runtime U32 :=
    let one : USize := raw_process_one bytes in
    let process_number_40 : USize := (raw_process_eight (usize_add (usize_add one one) (usize_add one (usize_add one one)))) in

    runtime_bind U32 U32 (raw_process_capture_ready owner one) (fun (ready : U32) =>
      match u32_equal ready (raw_size_to_u32 (usize_sub one one)) with | False => runtime_pure U32 ready | True =>
        runtime_bind Bool U32 (raw_windows_conversion_storage buffer bytes (raw_null U8) (usize_sub one one) count one) (fun (valid : Bool) =>
          match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
            runtime_bind Bool U32 (raw_windows_storage_disjoint buffer bytes owner process_number_40) (fun (separate : Bool) =>
              match separate with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                runtime_bind (RawPtr U8) U32 (raw_cast U32 U8 count) (fun (cell : RawPtr U8) =>
                  runtime_bind Bool U32 (raw_windows_storage_disjoint cell (usize_add (usize_add one one) (usize_add one one)) owner process_number_40) (fun (count_separate : Bool) =>
                    match count_separate with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                      runtime_bind USize U32 (raw_process_load owner (match error_stream with | True => (raw_process_eight (usize_add (usize_add one one) (usize_add one one))) | False => (raw_process_eight (usize_add one (usize_add one one))) end))
                        (fun (bits : USize) => runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (stream : RawPtr U8) =>
                          raw_windows_file_read stream buffer bytes count)) end)) end) end) end);

-- Attempt every close and retain every handle whose close failed. This is
-- idempotent for zero cells. Call wait/cancel first when detaching is unwanted.
def raw_windows_process_capture_close (owner : RawPtr U8) : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits U8 owner) (fun (anchor : USize) =>
      let one : USize := raw_process_one anchor in
      runtime_bind Bool U32 (raw_process_storage owner (raw_process_eight (usize_add (usize_add one one) (usize_add one (usize_add one one)))) one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
          runtime_bind U32 U32 (raw_windows_process_close owner) (fun (process : U32) =>
            runtime_bind U32 U32 (raw_process_close_cell owner (raw_process_eight (usize_add one (usize_add one one))) one) (fun (output : U32) =>
              runtime_bind U32 U32 (raw_process_close_cell owner (raw_process_eight (usize_add (usize_add one one) (usize_add one one))) one) (fun (error : U32) =>
                runtime_pure U32 (match u32_equal process (raw_size_to_u32 (usize_sub one one)) with | False => process | True =>
                  match u32_equal output (raw_size_to_u32 (usize_sub one one)) with | False => output | True => error end end)))) end));
