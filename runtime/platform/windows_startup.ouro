-- Startup state uses Windows Unicode APIs directly. The argv/environment
-- owner words contain raw OS allocations, never managed roots. Borrowed
-- pointers remain valid only until the corresponding successful close.
import "windows_path.ouro";

extern windows_command_line : Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "GetCommandLineW" "nogc";
extern windows_command_line_argv : RawPtr U8 -> RawPtr U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "shell32.dll" "CommandLineToArgvW" "nogc";
extern windows_local_free : RawPtr U8 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "LocalFree" "nogc";
extern windows_environment_strings : Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "GetEnvironmentStringsW" "nogc";
extern windows_free_environment_strings : RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "FreeEnvironmentStringsW" "nogc";
extern windows_get_environment_variable : RawPtr U8 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetEnvironmentVariableW" "nogc";
extern windows_set_last_error : U32 -> Runtime Unit :=
    "windows-x86_64" "win64" "kernel32.dll" "SetLastError" "nogc";
extern windows_get_current_directory : U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetCurrentDirectoryW" "nogc";

def raw_windows_startup_words (owner : RawPtr USize) (count : RawPtr U32) (one : USize) : Runtime Bool :=
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    runtime_bind Bool Bool (raw_windows_size_cell owner one) (fun (valid : Bool) =>
      match valid with | False => runtime_pure Bool False | True =>
        runtime_bind Bool Bool (raw_windows_count_cell count one) (fun (count_valid : Bool) =>
          match count_valid with | False => runtime_pure Bool False | True =>
            runtime_bind (RawPtr U8) Bool (raw_cast USize U8 owner) (fun (first : RawPtr U8) =>
              runtime_bind (RawPtr U8) Bool (raw_cast U32 U8 count) (fun (second : RawPtr U8) =>
                raw_windows_storage_disjoint first eight second four)) end) end);

def raw_windows_startup_restore_count (count : RawPtr U32) (saved : U32) (error : U32) : Runtime U32 :=
    let result : Runtime U32 := raw_restore_word count saved error in result;

-- Internal cleanup of a rejected argv allocation must not lose ownership.
def raw_windows_argv_reject (table : RawPtr U8) (count : RawPtr U32) (saved : U32) (one : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 (windows_local_free table) (fun (remaining : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 remaining) (fun (bits : USize) =>
        match usize_equal bits (usize_sub one one) with
        | True => raw_windows_startup_restore_count count saved (raw_windows_general_error one)
        | False => runtime_bind U32 U32 (raw_windows_last_failure one) (fun (error : U32) =>
            runtime_bind Unit U32 (raw_windows_panic_code error) (fun (unexpected : Unit) => runtime_pure U32 error)) end));

-- Success writes a table owner and positive argc, including argv[0]. The
-- output cells must be disjoint. Failure preserves both caller values.
def raw_windows_argv_open (owner : RawPtr USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize owner) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bits)))
    | Just one => runtime_bind Bool U32 (raw_windows_startup_words owner count one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
          runtime_bind U32 U32 (raw_load_u32 count) (fun (saved : U32) =>
            runtime_bind (RawPtr U8) U32 windows_command_line (fun (line : RawPtr U8) =>
              runtime_bind USize U32 (raw_to_bits U8 line) (fun (line_bits : USize) =>
                match usize_equal line_bits (usize_sub one one) with
                | True => raw_windows_last_failure one
                | False => runtime_bind (RawPtr U8) U32 (windows_command_line_argv line count) (fun (table : RawPtr U8) =>
                    runtime_bind USize U32 (raw_to_bits U8 table) (fun (bits : USize) =>
                      match usize_equal bits (usize_sub one one) with
                      | True => runtime_bind U32 U32 (raw_windows_last_failure one)
                          (fun (error : U32) => raw_windows_startup_restore_count count saved error)
                      | False => runtime_bind U32 U32 (raw_load_u32 count) (fun (argc : U32) =>
                          match raw_bool_and (u32_less (u32_sub argc argc) argc)
                            (raw_bool_not (usize_less (raw_windows_int_max one) (raw_u32_to_size argc))) with
                          | False => raw_windows_argv_reject table count saved one
                          | True => runtime_bind Unit U32 (raw_store_usize owner bits)
                              (fun (stored : Unit) => runtime_pure U32 (u32_sub argc argc)) end) end)) end))) end) end;

-- The table/count pair must come from a live argv owner. Success publishes
-- one borrowed UTF-16 string pointer; empty arguments are retained.
def raw_windows_argv_at (table : RawPtr U8) (count : U32) (index : USize) (output : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code count) (fun (unexpected : Unit) => runtime_pure U32 count)
    | Just one =>
        let zero : USize := usize_sub one one in
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let size : USize := raw_u32_to_size count in
        match raw_bool_and (usize_less index size) (raw_bool_not (usize_less (raw_windows_int_max one) size)) with
        | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => let bytes : USize := usize_shift_left size (raw_size_to_u32 (usize_add two one)) in
            runtime_bind Bool U32 (raw_buffer_range table bytes zero bytes) (fun (valid : Bool) =>
              match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                runtime_bind Bool U32 (raw_windows_size_cell output one) (fun (cell_valid : Bool) =>
                  match cell_valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                    runtime_bind (RawPtr U8) U32 (raw_cast USize U8 output) (fun (cell : RawPtr U8) =>
                      runtime_bind Bool U32 (raw_windows_storage_disjoint table bytes cell eight) (fun (separate : Bool) =>
                        match separate with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                          runtime_bind (RawPtr U8) U32
                            (raw_add U8 table (usize_shift_left index (raw_size_to_u32 (usize_add two one))))
                            (fun (entry : RawPtr U8) => runtime_bind (RawPtr USize) U32 (raw_cast U8 USize entry)
                              (fun (word : RawPtr USize) => runtime_bind USize U32 (raw_load_usize word)
                                (fun (value : USize) => match usize_equal value zero with
                                  | True => runtime_pure U32 (raw_windows_general_error one)
                                  | False => runtime_bind Unit U32 (raw_store_usize output value)
                                      (fun (stored : Unit) => runtime_pure U32 (raw_size_to_u32 zero)) end))) end)) end) end) end end;

def raw_windows_environment_open (owner : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize owner) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bits)))
    | Just one => runtime_bind Bool U32 (raw_windows_size_cell owner one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
          runtime_bind (RawPtr U8) U32 windows_environment_strings (fun (block : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 block) (fun (bits : USize) =>
              match usize_equal bits (usize_sub one one) with
              | True => raw_windows_last_failure one
              | False => runtime_bind Unit U32 (raw_store_usize owner bits)
                  (fun (stored : Unit) => runtime_pure U32 (raw_size_to_u32 (usize_sub one one))) end)) end) end;

-- Internal dispatcher; callers must match the allocation's actual API.
-- Success zeros the owner. Failure preserves it for explicit cleanup.
def raw_windows_startup_close (environment : Bool) (owner : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize owner) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bits)))
    | Just one => runtime_bind Bool U32 (raw_windows_size_cell owner one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
          runtime_bind USize U32 (raw_load_usize owner) (fun (bits : USize) =>
            let zero : USize := usize_sub one one in
            match usize_equal bits zero with | True => runtime_pure U32 (raw_windows_parameter_error one) | False =>
              runtime_bind (RawPtr U8) U32 (raw_from_bits U8 bits) (fun (block : RawPtr U8) =>
                runtime_bind Bool U32 (match environment with
                  | True => runtime_bind U32 Bool (windows_free_environment_strings block)
                      (fun (status : U32) => runtime_pure Bool (raw_bool_not (u32_equal status (u32_sub status status))))
                  | False => runtime_bind (RawPtr U8) Bool (windows_local_free block)
                      (fun (remaining : RawPtr U8) => runtime_bind USize Bool (raw_to_bits U8 remaining)
                        (fun (address : USize) => runtime_pure Bool (usize_equal address zero))) end)
                  (fun (released : Bool) => match released with
                    | False => raw_windows_last_failure one
                    | True => runtime_bind Unit U32 (raw_store_usize owner zero)
                        (fun (stored : Unit) => runtime_pure U32 (raw_size_to_u32 zero)) end)) end) end) end;

def raw_windows_argv_close (owner : RawPtr USize) : Runtime U32 := raw_windows_startup_close False owner;
def raw_windows_environment_close (owner : RawPtr USize) : Runtime U32 := raw_windows_startup_close True owner;

-- The bounded scan reads at most capacity UTF-16 units, stopping at the first
-- zero. It accepts empty text. Unicode validity is checked during conversion.
def raw_windows_wide_length (text : RawPtr U8) (capacity : USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 capacity))
        (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 capacity))
    | Just one =>
        let zero : USize := usize_sub one one in
        match usize_less (raw_windows_int_max one) capacity with
        | True => runtime_pure U32 (raw_windows_parameter_error one)
        | False => runtime_bind Bool U32 (raw_windows_wide_aligned text capacity one) (fun (aligned : Bool) =>
            match aligned with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
              runtime_bind Bool U32 (raw_windows_conversion_storage text (usize_add capacity capacity)
                (raw_null U8) zero count one) (fun (valid : Bool) =>
                  match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                    match u8_from_nat 1 with
                    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_windows_general_error one))
                        (fun (unexpected : Unit) => runtime_pure U32 (raw_windows_general_error one))
                    | Just running => runtime_bind USize U32 (runtime_loop USize zero
                        (fun (index : USize) => match usize_less index capacity with
                          | False => runtime_pure U8 (u8_sub running running)
                          | True => runtime_bind USize U8 (raw_windows_wide_unit text index one)
                              (fun (unit : USize) => runtime_pure U8 (match usize_equal unit zero with
                                | True => u8_sub running running | False => running end)) end)
                        (fun (index : USize) => runtime_pure USize (usize_add index one)))
                        (fun (length : USize) => match usize_less length capacity with
                          | False => runtime_pure U32 (raw_windows_insufficient_buffer one)
                          | True => raw_windows_store_count count (raw_size_to_u32 length) end) end end) end) end end;

-- Query/fill protocol: success stores the length excluding the terminator.
-- ERROR_INSUFFICIENT_BUFFER stores required capacity including the terminator.
-- Other failures preserve count. A short OS write may modify the buffer.
def raw_windows_startup_string_result (empty_allowed : Bool) (actual : U32) (capacity : USize)
    (count : RawPtr U32) (one : USize) : Runtime U32 :=
    let zero : U32 := u32_sub actual actual in
    match u32_equal actual zero with
    | True => runtime_bind U32 U32 windows_get_last_error (fun (error : U32) =>
        match u32_equal error zero with
        | False => runtime_pure U32 error
        | True => match empty_allowed with
          | True => raw_windows_store_count count zero
          | False => runtime_pure U32 (raw_windows_general_error one) end end)
    | False => runtime_bind U32 U32 (raw_windows_store_count count actual) (fun (stored : U32) =>
        runtime_pure U32 (match usize_less (raw_u32_to_size actual) capacity with
          | True => zero | False => raw_windows_insufficient_buffer one end)) end;

def raw_windows_startup_buffer (buffer : RawPtr U8) (capacity : USize) (count : RawPtr U32) (one : USize) : Runtime Bool :=
    match usize_less (raw_windows_int_max one) capacity with
    | True => runtime_pure Bool False
    | False => runtime_bind Bool Bool (raw_windows_wide_aligned buffer capacity one) (fun (aligned : Bool) =>
        match aligned with | False => runtime_pure Bool False | True =>
          raw_windows_conversion_storage (raw_null U8) (usize_sub one one) buffer
            (usize_add capacity capacity) count one end) end;

def raw_windows_current_directory (buffer : RawPtr U8) (capacity : USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 capacity))
        (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 capacity))
    | Just one => runtime_bind Bool U32 (raw_windows_startup_buffer buffer capacity count one) (fun (valid : Bool) =>
        match valid with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
          runtime_bind U32 U32 (windows_get_current_directory (raw_size_to_u32 capacity) buffer)
            (fun (actual : U32) => raw_windows_startup_string_result False actual capacity count one) end) end;

def raw_windows_environment_get (name : RawPtr U8) (units : USize) (buffer : RawPtr U8)
    (capacity : USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 capacity))
        (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 capacity))
    | Just one => runtime_bind Bool U32 (raw_windows_path_valid name units one) (fun (valid_name : Bool) =>
        match valid_name with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
          runtime_bind Bool U32 (raw_windows_startup_buffer buffer capacity count one) (fun (valid_buffer : Bool) =>
            match valid_buffer with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
              let terminated : USize := usize_add units one in
              let name_bytes : USize := usize_add terminated terminated in
              runtime_bind Bool U32 (raw_windows_storage_disjoint name name_bytes buffer (usize_add capacity capacity))
                (fun (separate : Bool) => match separate with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
                  runtime_bind (RawPtr U8) U32 (raw_cast U32 U8 count) (fun (cell : RawPtr U8) =>
                    let two : USize := usize_add one one in
                    runtime_bind Bool U32 (raw_windows_storage_disjoint name name_bytes cell (usize_add two two))
                      (fun (separate_count : Bool) => match separate_count with
                        | False => runtime_pure U32 (raw_windows_parameter_error one)
                        | True => runtime_bind Unit U32 (windows_set_last_error (raw_size_to_u32 (usize_sub one one)))
                            (fun (cleared : Unit) => runtime_bind U32 U32
                              (windows_get_environment_variable name buffer (raw_size_to_u32 capacity))
                              (fun (actual : U32) => raw_windows_startup_string_result True actual capacity count one)) end)) end)
            end) end) end;
