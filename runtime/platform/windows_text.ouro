-- Strict length-based UTF-8/UTF-16 conversion using Win32. Embedded zeroes
-- are text data; path adapters must reject them separately. No terminator is
-- added and no managed or raw allocation occurs here.
import "windows_common.ouro";

extern windows_multi_byte_to_wide_char : U32 -> U32 -> RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "MultiByteToWideChar" "nogc";
extern windows_wide_char_to_multi_byte : U32 -> U32 -> RawPtr U8 -> U32 -> RawPtr U8 -> U32 -> RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "WideCharToMultiByte" "nogc";

-- CP_UTF8=65001, assembled as ordinary machine words rather than a large
-- unary natural. Internal callers supply one=1.
def raw_windows_utf8_page (one : USize) : U32 :=
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    let sixteen : USize := usize_add eight eight in
    let thirtytwo : USize := usize_add sixteen sixteen in
    let sixtyfour : USize := usize_add thirtytwo thirtytwo in
    let byte_base : USize := usize_add (usize_add sixtyfour sixtyfour) (usize_add sixtyfour sixtyfour) in
    raw_size_to_u32 (usize_add (usize_shift_left (usize_sub byte_base three) (raw_size_to_u32 eight))
      (usize_sub byte_base (usize_add sixteen (usize_sub eight one))));

-- A positive OS result must fit its signed-int result type and, except in
-- sizing mode, the supplied destination capacity. Invalid OS results fail.
def raw_windows_conversion_result (actual : U32) (capacity : USize)
    (count : RawPtr U32) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    match u32_equal actual (u32_sub actual actual) with
    | True => raw_windows_last_failure one
    | False => let size : USize := raw_u32_to_size actual in
        match raw_bool_and (raw_bool_not (usize_less (raw_windows_int_max one) size))
          (match usize_equal capacity zero with | True => True | False => raw_bool_not (usize_less capacity size) end) with
        | False => runtime_pure U32 (raw_windows_general_error one)
        | True => raw_windows_store_count count actual end end;

def raw_windows_utf8_convert (source : RawPtr U8) (bytes : USize) (target : RawPtr U8)
    (capacity : USize) (count : RawPtr U32) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let eight : USize := usize_add four four in
    match usize_equal bytes zero with
    | True => raw_windows_store_count count (raw_size_to_u32 zero)
    | False => runtime_bind U32 U32 (windows_multi_byte_to_wide_char
        (raw_windows_utf8_page one) (raw_size_to_u32 eight) source (raw_size_to_u32 bytes)
        (match usize_equal capacity zero with | True => raw_null U8 | False => target end) (raw_size_to_u32 capacity))
        (fun (actual : U32) => raw_windows_conversion_result actual capacity count one) end;

def raw_windows_utf16_convert (source : RawPtr U8) (units : USize) (target : RawPtr U8)
    (capacity : USize) (count : RawPtr U32) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    let seven : USize := usize_sub (usize_add four four) one in
    match usize_equal units zero with
    | True => raw_windows_store_count count (raw_size_to_u32 zero)
    | False => runtime_bind U32 U32 (windows_wide_char_to_multi_byte
        (raw_windows_utf8_page one) (u32_shift_left (raw_size_to_u32 one) (raw_size_to_u32 seven))
        source (raw_size_to_u32 units)
        (match usize_equal capacity zero with | True => raw_null U8 | False => target end) (raw_size_to_u32 capacity)
        (raw_null U8) (raw_null U8))
        (fun (actual : U32) => raw_windows_conversion_result actual capacity count one) end;

-- Returns zero on success and a nonzero Win32 error on failure. Success
-- writes the exact UTF-16 unit count. Capacity zero queries the required size;
-- an empty input succeeds with count zero and needs no source/target storage.
-- Counts are bounded by INT_MAX before narrowing. All UTF-16 storage is
-- aligned to two bytes. The count is unchanged on failure; destination bytes
-- may have been modified by a failed OS conversion.
def raw_windows_utf8_to_utf16 (source : RawPtr U8) (bytes : USize) (target : RawPtr U8)
    (capacity : USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bytes))
        (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 bytes))
    | Just one =>
        let maximum : USize := raw_windows_int_max one in
        match raw_bool_and (raw_bool_not (usize_less maximum bytes)) (raw_bool_not (usize_less maximum capacity)) with
        | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind Bool U32 (raw_windows_wide_aligned target capacity one) (fun (aligned : Bool) =>
            match aligned with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
              runtime_bind Bool U32 (raw_windows_conversion_storage source bytes target (usize_add capacity capacity) count one)
                (fun (valid : Bool) => match valid with
                  | False => runtime_pure U32 (raw_windows_parameter_error one)
                  | True => raw_windows_utf8_convert source bytes target capacity count one end) end) end end;

-- The reverse conversion uses the same status/count protocol. Source length
-- is in UTF-16 units; destination capacity and the returned count are bytes.
-- Unpaired UTF-16 surrogates are errors, never replacement characters.
def raw_windows_utf16_to_utf8 (source : RawPtr U8) (units : USize) (target : RawPtr U8)
    (capacity : USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 units))
    | Just one =>
        let maximum : USize := raw_windows_int_max one in
        match raw_bool_and (raw_bool_not (usize_less maximum units)) (raw_bool_not (usize_less maximum capacity)) with
        | False => runtime_pure U32 (raw_windows_parameter_error one)
        | True => runtime_bind Bool U32 (raw_windows_wide_aligned source units one) (fun (aligned : Bool) =>
            match aligned with | False => runtime_pure U32 (raw_windows_parameter_error one) | True =>
              runtime_bind Bool U32 (raw_windows_conversion_storage source (usize_add units units) target capacity count one)
                (fun (valid : Bool) => match valid with
                  | False => runtime_pure U32 (raw_windows_parameter_error one)
                  | True => raw_windows_utf16_convert source units target capacity count one end) end) end end;
