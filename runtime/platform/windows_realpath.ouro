-- Realpath helpers distinguish absence from a broken raw contract: status
-- zero succeeds, one is ordinary OS unavailability, and other codes fail.
-- Owner/count cells are published only on success. Callers own all buffers
-- and close every successful handle; these helpers allocate no storage.
import "windows_file.ouro";

extern windows_final_path_by_handle : RawPtr U8 -> RawPtr U8 -> U32 -> U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFinalPathNameByHandleW" "nogc";

-- Resolve links and junctions using FILE_READ_ATTRIBUTES, sharing 7,
-- OPEN_EXISTING and FILE_FLAG_BACKUP_SEMANTICS. The owner is an aligned
-- USize cell disjoint from the complete terminated UTF-16 input path. It
-- must contain zero; a preowned cell is rejected before opening a handle.
def raw_windows_realpath_open (path : RawPtr U8) (units : USize) (owner : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 units))
    | Just one =>
        let zero : USize := usize_sub one one in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let seven : USize := usize_sub eight one in
        let sixteen : USize := usize_add eight eight in
        runtime_bind (RawPtr U8) U32 (raw_cast USize U8 owner) (fun (cell : RawPtr U8) =>
          runtime_bind Bool U32 (raw_windows_path_output path units cell eight eight one) (fun (valid : Bool) =>
            match valid with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
              runtime_bind USize U32 (raw_load_usize owner) (fun (previous : USize) =>
                match usize_equal previous zero with
                | False => runtime_pure(U32, raw_windows_parameter_error one)
                | True => let access : U32 := raw_size_to_u32 (usize_shift_left(one, raw_size_to_u32 seven)) in
                    let flags : U32 := raw_size_to_u32
                      (usize_shift_left(one, raw_size_to_u32 (usize_add(sixteen, usize_add eight one)))) in
                    runtime_bind (RawPtr U8) U32 (windows_create_file path access (raw_size_to_u32 seven)
                      (raw_null U8) (raw_size_to_u32 three) flags (raw_null U8)) (fun (stream_handle : RawPtr U8) =>
                        runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (opened : Bool) =>
                          match opened with | False => runtime_pure(U32, raw_size_to_u32 one) | True =>
                            runtime_bind USize U32 (raw_to_bits U8 stream_handle) (fun (bits : USize) =>
                              runtime_bind Unit U32 (raw_store_usize owner bits)
                                (fun (_stored : Unit) => runtime_pure(U32, raw_size_to_u32 zero))) end)) end) end)) end;

-- Query counts include the terminator. A successful fill excludes it and
-- must fit strictly inside capacity. Validate the complete returned path
-- before publishing its count: no embedded NUL, missing terminator or lone
-- surrogate is accepted. A failed OS call may modify destination bytes.
def raw_windows_realpath_result (buffer : RawPtr U8) (capacity : USize)
    (count : RawPtr U32) (actual : U32) (one : USize) : Runtime U32 :=
    let zero : USize := usize_sub one one in
    match u32_equal(actual, u32_sub actual actual) with
    | True => runtime_pure(U32, raw_size_to_u32 one)
    | False => let size : USize := raw_u32_to_size actual in
        match usize_less(raw_windows_int_max one, size) with
        | True => runtime_pure(U32, raw_windows_general_error one)
        | False => match usize_equal capacity zero with
          | True => match usize_less one size with
            | False => runtime_pure(U32, raw_windows_general_error one)
            | True => raw_windows_store_count count actual end
          | False => match usize_less size capacity with
            | False => runtime_pure(U32, raw_windows_insufficient_buffer one)
            | True => runtime_bind Bool U32 (raw_windows_path_valid buffer size one) (fun (valid : Bool) =>
                match valid with | False => runtime_pure(U32, raw_windows_general_error one)
                | True => raw_windows_store_count count actual end) end end end end;

-- Capacity zero performs one sizing query with NULL output. A positive
-- capacity is the number of caller-owned WCHAR slots, including the NUL.
-- FILE_NAME_NORMALIZED | VOLUME_NAME_DOS is exactly zero. Growth between
-- query and fill is a failed bounded read; no retry or partial result occurs.
def raw_windows_realpath_read (stream_handle : RawPtr U8) (buffer : RawPtr U8)
    (capacity : USize) (count : RawPtr U32) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 capacity))
        (fun (_unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 capacity))
    | Just one =>
        let zero : USize := usize_sub one one in
        match usize_less(raw_windows_int_max one, capacity) with
        | True => runtime_pure(U32, raw_windows_parameter_error one)
        | False => runtime_bind Bool U32 (raw_windows_wide_aligned buffer capacity one) (fun (aligned : Bool) =>
            match aligned with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
              runtime_bind Bool U32
                (raw_windows_conversion_storage (raw_null U8) zero buffer (usize_add capacity capacity) count one)
                (fun (storage : Bool) => match storage with
                  | False => runtime_pure(U32, raw_windows_parameter_error one)
                  | True => runtime_bind Bool U32 (raw_windows_handle_valid stream_handle one) (fun (valid : Bool) =>
                      match valid with | False => runtime_pure(U32, raw_windows_invalid_handle one) | True =>
                        runtime_bind U32 U32 (windows_final_path_by_handle stream_handle
                          (match usize_equal capacity zero with | True => raw_null U8 | False => buffer end)
                          (raw_size_to_u32 capacity) (raw_size_to_u32 zero))
                          (fun (actual : U32) => raw_windows_realpath_result buffer capacity count actual one) end) end) end) end end;
