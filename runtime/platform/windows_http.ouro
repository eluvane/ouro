-- Responses are collected in 4096-byte owned pages, preserving byte counts
-- and embedded NUL. No Content-Length assumption and no quadratic re-copy.
-- The context owns a page before any operation on it can fail.
import "windows_http_header.ouro";

def raw_http_read_step (ctx : RawPtr U8) (request : RawPtr U8) (one : USize) : Runtime U32 :=
    runtime_bind U32 U32 (raw_http_deadline ctx request one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind (RawPtr U8) U32 (raw_pages_allocate (raw_http_c4112 one) (raw_http_c8 one)) (fun (page : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 page) (fun (bits : USize) =>
match usize_equal bits (raw_http_c0 one) with | True => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | False => runtime_bind USize U32 (raw_http_get ctx (raw_http_c56 one)) (fun (tail : USize) =>
runtime_bind Unit U32 (match usize_equal tail (raw_http_c0 one) with | True => raw_http_save ctx (raw_http_c24 one) page | False => runtime_bind (RawPtr U8) Unit (raw_from_bits U8 tail) (fun (last : RawPtr U8) => raw_http_save last (raw_http_c0 one) page) end) (fun (_ : Unit) =>
runtime_bind Unit U32 (raw_http_save ctx (raw_http_c56 one) page) (fun (_ : Unit) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 page (raw_http_c16 one)) (fun (buffer : (RawPtr U8)) =>
runtime_bind (RawPtr U8) U32 (raw_add U8 page (raw_http_c8 one)) (fun (counter : (RawPtr U8)) =>
runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 counter) (fun (count : (RawPtr U32)) =>
runtime_bind U32 U32 (windows_http_read request buffer (raw_size_to_u32 (raw_http_c4096 one)) count) (fun (read_result : U32) =>
runtime_bind U32 U32 (raw_http_bool ctx read_result one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind U32 U32 (raw_http_deadline ctx request one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind USize U32 (raw_http_get page (raw_http_c8 one)) (fun (actual : USize) =>
match usize_less (raw_http_c4096 one) actual with | True => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | False => match usize_equal actual (raw_http_c0 one) with | True => runtime_pure U32 (raw_size_to_u32 (raw_http_c3 one)) | False => runtime_bind USize U32 (raw_http_get ctx (raw_http_c32 one)) (fun (total : USize) =>
let combined : USize := usize_add total actual in
match usize_less combined total with | True => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | False => runtime_bind Unit U32 (raw_http_put ctx (raw_http_c32 one) combined) (fun (_ : Unit) =>
runtime_pure U32 (raw_size_to_u32 (raw_http_c0 one))) end) end end) end) end)))))))) end)) end);

def raw_windows_http_send (ctx : RawPtr U8) (body : RawPtr U8) (bytes : USize) (one : USize) : Runtime U32 :=
    runtime_bind Bool U32 (raw_http_context_valid ctx one) (fun (valid : Bool) =>
match valid with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True =>
    match usize_less (raw_windows_int_max one) bytes with | True => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | False => runtime_bind Bool U32 (raw_buffer_range body bytes (raw_http_c0 one) bytes) (fun (valid : Bool) =>
match valid with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True => runtime_bind (RawPtr U8) U32 (raw_http_handle ctx (raw_http_c16 one)) (fun (request : (RawPtr U8)) =>
runtime_bind U32 U32 (raw_http_deadline ctx request one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind U32 U32 (windows_http_send request (raw_null U8) (raw_size_to_u32 (raw_http_c0 one)) body (raw_size_to_u32 bytes) (raw_size_to_u32 bytes) (raw_http_c0 one)) (fun (sent : U32) =>
runtime_bind U32 U32 (raw_http_bool ctx sent one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind U32 U32 (raw_http_deadline ctx request one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind U32 U32 (windows_http_receive request (raw_null U8)) (fun (received : U32) =>
runtime_bind U32 U32 (raw_http_bool ctx received one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind U32 U32 (raw_http_deadline ctx request one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
runtime_bind (RawPtr U8) U32 (raw_pages_allocate (raw_http_c8 one) (raw_http_c8 one)) (fun (scratch : (RawPtr U8)) =>
runtime_bind USize U32 (raw_to_bits U8 scratch) (fun (bits : USize) =>
match usize_equal bits (raw_http_c0 one) with | True => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | False => runtime_bind U32 U32 (runtime_bind (RawPtr U8) U32 (raw_add U8 ctx (raw_http_c40 one)) (fun (status_cell : (RawPtr U8)) =>
runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 scratch) (fun (size_cell : (RawPtr U32)) =>
runtime_bind Unit U32 (raw_http_put32 scratch (usize_sub one one) (raw_size_to_u32 (raw_http_c4 one))) (fun (_ : Unit) =>
runtime_bind U32 U32 (windows_http_query request (raw_size_to_u32 (raw_http_c536870931 one)) (raw_null U8) status_cell size_cell (raw_null U32)) (fun (queried : U32) =>
runtime_bind U32 U32 (raw_http_bool ctx queried one) (fun (status : U32) =>
match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | False => runtime_pure U32 status | True =>
match u8_from_nat 1 with | Nothing => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | Just running => runtime_bind U32 U32 (runtime_loop U32 (raw_size_to_u32 (raw_http_c0 one)) (fun (status : U32) => runtime_pure U8 (match u32_equal status (raw_size_to_u32 (raw_http_c0 one)) with | True => running | False => u8_sub running running end)) (fun (_ : U32) => raw_http_read_step ctx request one)) (fun (finished : U32) =>
runtime_pure U32 (match u32_equal finished (raw_size_to_u32 (raw_http_c3 one)) with | True => (raw_size_to_u32 (raw_http_c0 one)) | False => finished end)) end end)))))) (fun (status : U32) =>
runtime_bind Bool U32 (raw_pages_release scratch) (fun (released : Bool) =>
match released with | False => runtime_pure U32 (raw_size_to_u32 (raw_http_c2 one)) | True => runtime_pure U32 status end)) end)) end) end)) end) end)) end)) end) end end);
