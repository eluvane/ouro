-- Probe the literal directory with list/read-attributes access before using a
-- wildcard search. A successful open publishes ownership even for a file;
-- check_handle then distinguishes directories, and the caller always closes.
import "windows_directory.ouro",
  "windows_file_managed.ouro";

def raw_windows_directory_open_literal (path : RawPtr U8) (units : USize)
    (owner : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 units))
        (fun (_unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 units))
    | Just one =>
        let zero : USize := usize_sub one one in
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let sixteen : USize := usize_add eight eight in
        let access : USize := usize_add(one, usize_shift_left(one, raw_size_to_u32 (usize_sub eight one))) in
        let flags : USize := usize_shift_left(one, raw_size_to_u32 (usize_add(sixteen, usize_add eight one))) in
        runtime_bind (RawPtr U8) U32 (raw_cast USize U8 owner) (fun (cell : RawPtr U8) =>
          runtime_bind Bool U32 (raw_windows_path_output path units cell eight eight one) (fun (valid : Bool) =>
            match valid with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
              runtime_bind (RawPtr U8) U32 (windows_create_file path (raw_size_to_u32 access)
                (raw_size_to_u32 (usize_sub eight one)) (raw_null U8) (raw_size_to_u32 (usize_add two one))
                (raw_size_to_u32 flags) (raw_null U8)) (fun (directory_handle : RawPtr U8) =>
                  runtime_bind Bool U32 (raw_windows_handle_valid directory_handle one) (fun (opened : Bool) =>
                    match opened with | False => raw_windows_last_failure one | True =>
                      runtime_bind USize U32 (raw_to_bits U8 directory_handle) (fun (bits : USize) =>
                        runtime_bind Unit U32 (raw_store_usize owner bits)
                          (fun (_stored : Unit) => runtime_pure(U32, raw_size_to_u32 zero))) end)) end)) end;

-- FILE_ATTRIBUTE_TAG_INFO occupies eight bytes. Check the opened handle;
-- path metadata alone would not establish directory type or list access.
-- A non-directory returns ERROR_DIRECTORY (267), with ownership unchanged.
def raw_windows_directory_check_handle (directory_handle : RawPtr U8) (scratch : RawPtr USize) : Runtime U32 :=
    match usize_from_nat 1 with
    | Nothing => runtime_bind USize U32 (raw_to_bits USize scratch) (fun (bits : USize) =>
        runtime_bind Unit U32 (raw_windows_panic_code (raw_size_to_u32 bits))
          (fun (_unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 bits)))
    | Just one =>
        let zero : USize := usize_sub one one in
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let sixteen : USize := usize_add eight eight in
        let not_directory : USize := usize_add (usize_shift_left(one, raw_size_to_u32 eight))
          (usize_add(eight, usize_add two one)) in
        runtime_bind Bool U32 (raw_windows_size_cell scratch one) (fun (valid : Bool) =>
          match valid with | False => runtime_pure(U32, raw_windows_parameter_error one) | True =>
            runtime_bind Bool U32 (raw_windows_handle_valid directory_handle one) (fun (opened : Bool) =>
              match opened with | False => runtime_pure(U32, raw_windows_invalid_handle one) | True =>
                runtime_bind (RawPtr U8) U32 (raw_cast USize U8 scratch) (fun (buffer : RawPtr U8) =>
                  runtime_bind U32 U32 (windows_file_information directory_handle (raw_size_to_u32 (usize_add eight one))
                    buffer (raw_size_to_u32 eight)) (fun (status : U32) =>
                      match u32_equal(status, u32_sub status status) with
                      | True => raw_windows_last_failure one
                      | False => runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 buffer) (fun (attributes : RawPtr U32) =>
                          runtime_bind U32 U32 (raw_load_u32 attributes) (fun (flags : U32) =>
                            runtime_pure U32 (raw_size_to_u32 (match usize_equal
                              (usize_and(raw_u32_to_size flags, sixteen)) zero with
                              | True => not_directory | False => zero end)))) end)) end) end) end;
