-- Managed source-owned path staging around the existing exclusive raw helper.
-- The existing helper's status is used only as zero/nonzero, never as a saved DWORD.
import "windows_fs.ouro",
  "windows_text.ouro",
  "../../std/fs_create_model.ouro";

intrinsic fs_create_u32_to_nat : U32 -> Nat := "ouro.u32.to_nat.bits";

def WindowsFsCreateResult : Type := Either FsCreateDirError Unit;

def windows_fs_create_fail (error : FsCreateDirError) : Runtime WindowsFsCreateResult :=
    runtime_pure(WindowsFsCreateResult, Left FsCreateDirError Unit error);

-- The exact managed byte count is bounded by the caller-owned UTF-8 region.
-- Fixed managed path/base values remain outside the decreasing fixpoint.
def windows_fs_create_copy (path : String) (base : RawPtr U8) (one : USize)
    : Nat -> Nat -> USize -> Runtime WindowsFsCreateResult :=
  fix copy (remaining : Nat) (index : Nat) (offset : USize) : Runtime WindowsFsCreateResult :=
    match remaining with
    | Z => runtime_pure(WindowsFsCreateResult, Right FsCreateDirError Unit MkUnit)
    | S rest => match u8_from_nat (prim_string_byte_at path index) with
      | Nothing => windows_fs_create_fail FsCreateDirInvalidPath
      | Just byte => runtime_bind (RawPtr U8) WindowsFsCreateResult (raw_add U8 base offset)
          (fun (address : RawPtr U8) => runtime_bind Unit WindowsFsCreateResult (raw_store_u8 address byte)
            (fun (_ : Unit) => copy(rest, S index, usize_add offset one)))
      end
    end;

def windows_fs_create_terminated (wide : RawPtr U8) (units : USize) (one : USize)
    (create : RawPtr U8 -> USize -> Runtime U32) : Runtime WindowsFsCreateResult :=
    match u8_from_nat 0 with
    | Nothing => windows_fs_create_fail FsCreateDirConstantsFailed
    | Just nul => runtime_bind (RawPtr U8) WindowsFsCreateResult (raw_add U8 wide (usize_add units units))
        (fun (first : RawPtr U8) => runtime_bind Unit WindowsFsCreateResult (raw_store_u8 first nul)
          (fun (_ : Unit) => runtime_bind (RawPtr U8) WindowsFsCreateResult (raw_add U8 first one)
            (fun (second : RawPtr U8) => runtime_bind Unit WindowsFsCreateResult (raw_store_u8 second nul)
              (fun (_ : Unit) => runtime_bind U32 WindowsFsCreateResult (create wide units)
                (fun (status : U32) => runtime_pure WindowsFsCreateResult
                  (fs_create_dir_result (u32_equal(status, u32_sub status status))))))))
    end;

-- One owner: UTF-8 [0,98304), UTF-16 [98304,163840), U32 count [163840,163844).
def windows_fs_create_convert (owner : RawPtr U8) (bytes : USize) (wide_capacity : USize)
    (one : USize) (create : RawPtr U8 -> USize -> Runtime U32) : Runtime WindowsFsCreateResult :=
    let wide_bytes : USize := usize_add wide_capacity wide_capacity in
    let input_capacity : USize := usize_add wide_bytes wide_capacity in
    let count_offset : USize := usize_add input_capacity wide_bytes in
    runtime_bind (RawPtr U8) WindowsFsCreateResult (raw_add U8 owner input_capacity)
      (fun (wide : RawPtr U8) => runtime_bind (RawPtr U8) WindowsFsCreateResult (raw_add U8 owner count_offset)
        (fun (cell : RawPtr U8) => runtime_bind (RawPtr U32) WindowsFsCreateResult (raw_cast U8 U32 cell)
          (fun (count : RawPtr U32) => runtime_bind Unit WindowsFsCreateResult
            (raw_store_u32(count, raw_size_to_u32 (usize_sub one one)))
            (fun (_ : Unit) => runtime_bind U32 WindowsFsCreateResult
              (raw_windows_utf8_to_utf16 owner bytes wide (usize_sub wide_capacity one) count)
              (fun (status : U32) => match u32_equal(status, u32_sub status status) with
                | False => windows_fs_create_fail FsCreateDirConversionFailed
                | True => runtime_bind U32 WindowsFsCreateResult (raw_load_u32 count)
                    (fun (actual : U32) => match fs_create_dir_wide_count (fs_create_u32_to_nat actual)
                        (fs_create_u32_to_nat (raw_size_to_u32 wide_capacity)) with
                      | Left error => windows_fs_create_fail error
                      | Right _ => windows_fs_create_terminated wide (raw_u32_to_size actual) one create
                      end)
                end)))));

-- All allocated paths converge on one release of the original base. Operations
-- are explicit only so native fault fixtures can observe the same owning path.
def windows_fs_create_owned (path : String) (bytes : Nat) (owner : RawPtr U8)
    (one : USize) (wide_capacity : USize) (release : RawPtr U8 -> Runtime Bool)
    (create : RawPtr U8 -> USize -> Runtime U32) : Runtime WindowsFsCreateResult :=
    runtime_bind WindowsFsCreateResult WindowsFsCreateResult
      (windows_fs_create_copy path owner one bytes 0 (usize_sub one one))
      (fun (copied : WindowsFsCreateResult) => runtime_bind WindowsFsCreateResult WindowsFsCreateResult
        (match copied with
         | Left error => windows_fs_create_fail error
         | Right _ => match usize_from_nat bytes with
           | Nothing => windows_fs_create_fail FsCreateDirInvalidCount
           | Just size => windows_fs_create_convert owner size wide_capacity one create
           end
         end)
        (fun (result : WindowsFsCreateResult) => runtime_bind Bool WindowsFsCreateResult (release owner)
          (fun (released : Bool) => runtime_pure(WindowsFsCreateResult, fs_create_dir_released result released))));

def windows_fs_create_with (allocate : USize -> USize -> Runtime (RawPtr U8))
    (release : RawPtr U8 -> Runtime Bool) (create : RawPtr U8 -> USize -> Runtime U32)
    (path : String) : Runtime WindowsFsCreateResult :=
    match usize_from_nat 1, u32_from_nat 15 with
    | Just one, Just shift =>
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let wide_capacity : USize := usize_shift_left one shift in
        let wide_bytes : USize := usize_add wide_capacity wide_capacity in
        let input_capacity : USize := usize_add wide_bytes wide_capacity in
        let allocation_bytes : USize := usize_add(usize_add input_capacity wide_bytes, four) in
        match fs_create_dir_path_length(path, fs_create_u32_to_nat (raw_size_to_u32 input_capacity)) with
        | Left error => windows_fs_create_fail error
        | Right bytes => runtime_bind (RawPtr U8) WindowsFsCreateResult (allocate allocation_bytes eight)
            (fun (owner : RawPtr U8) => runtime_bind USize WindowsFsCreateResult (raw_to_bits U8 owner)
              (fun (address : USize) => match usize_equal(address, usize_sub one one) with
                | True => windows_fs_create_fail FsCreateDirAllocationFailed
                | False => windows_fs_create_owned path bytes owner one wide_capacity release create
                end))
        end
    | Just _, Nothing => windows_fs_create_fail FsCreateDirConstantsFailed
    | Nothing, Just _ => windows_fs_create_fail FsCreateDirConstantsFailed
    | Nothing, Nothing => windows_fs_create_fail FsCreateDirConstantsFailed
    end;

def windows_fs_create_checked (path : String) : Runtime WindowsFsCreateResult :=
    windows_fs_create_with
      (fun (bytes : USize) (alignment : USize) => raw_pages_allocate bytes alignment)
      raw_pages_release
      (fun (wide : RawPtr U8) (units : USize) => raw_windows_directory_create wide units) path;
