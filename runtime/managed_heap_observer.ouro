-- The compiler supplies its current managed context when this action executes.
-- Requested object bytes include headers and unswept objects, not OS overhead.
import "managed_layout.ouro";

intrinsic managed_allocated_requested_bytes : Runtime (Maybe Nat) :=
    "ouro.managed.allocated_requested_bytes";

-- This raw helper receives live compiler-owned context storage. It observes
-- maintained accounting; it does not collect, walk the heap or mutate metadata.
def raw_managed_allocated_requested_bytes (context : RawPtr U8) : Runtime USize :=
    runtime_bind USize USize (raw_to_bits U8 context) (fun (anchor : USize) =>
      let zero : USize := usize_sub anchor anchor in
      let one : USize := managed_one anchor in
      let two : USize := usize_add one one in
      let three : USize := usize_add two one in
      let four : USize := usize_add two two in
      let five : USize := usize_add four one in
      let seven : USize := usize_sub(managed_word_offset one, one) in
      runtime_bind Unit USize (managed_require
        (raw_bool_and (raw_bool_not (usize_equal anchor zero))
          (usize_equal(usize_and anchor seven, zero))) anchor) (fun (_aligned : Unit) =>
        runtime_bind USize USize (managed_read_word context zero) (fun (head : USize) =>
          runtime_bind USize USize (managed_read_word context two) (fun (count : USize) =>
            runtime_bind USize USize (managed_read_word context three) (fun (bytes : USize) =>
              match usize_equal count zero with
              | True => runtime_bind Unit USize (managed_require
                  (raw_bool_and(usize_equal head zero, usize_equal bytes zero)) anchor)
                  (fun (_empty : Unit) => runtime_pure USize bytes)
              | False => runtime_bind Unit USize (managed_require
                  (raw_bool_and (raw_bool_not (usize_equal head zero))
                    (raw_bool_and (usize_equal(usize_and head seven, zero))
                      (raw_bool_not (usize_less (managed_shift_right bytes (raw_size_to_u32 five)) count)))) anchor)
                  (fun (_accounted : Unit) =>
                    runtime_bind USize USize (managed_read_word context four) (fun (descriptors : USize) =>
                      let owner_word : USize := managed_heap_handle_word descriptors in
                      runtime_bind Unit USize (managed_require(raw_bool_not (usize_equal owner_word zero), anchor))
                        (fun (_layout : Unit) =>
                          runtime_bind USize USize (managed_read_word context owner_word) (fun (owner : USize) =>
                            runtime_bind Unit USize (managed_require(raw_bool_not (usize_equal owner zero), anchor))
                              (fun (_owned : Unit) => runtime_pure USize bytes)))))
              end)))));
