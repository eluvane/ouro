{
	"comments": {
		"lineComment": "--"
	},
	"brackets": [
		["(", ")"],
		["[", "]"],
		["{", "}"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "{", "close": "}" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["(", ")"],
		["[", "]"],
		["{", "}"],
		["\"", "\""]
	],
	"wordPattern": "[A-Za-z_][A-Za-z0-9_']*",
	"indentationRules": {
		"increaseIndentPattern": "(:=|=>|\\bwith\\b|\\bdo\\b|\\bwhere\\b)\\s*$",
		"decreaseIndentPattern": "^\\s*(end\\b|\\|)"
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*--",
			"action": { "indent": "none", "appendText": "-- " }
		}
	]
}
