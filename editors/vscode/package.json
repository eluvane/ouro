{
	"name": "ouro-vscode",
	"displayName": "Ouro",
	"description": "Ouro language support: syntax highlighting plus the ouro-lsp language server (diagnostics, hover, go to definition, completion, formatting).",
	"version": "0.1.0",
	"publisher": "ouro",
	"private": true,
	"engines": {
		"vscode": "^1.91.0"
	},
	"categories": [
		"Programming Languages",
		"Formatters"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"activationEvents": [
		"onLanguage:ouro"
	],
	"contributes": {
		"languages": [
			{
				"id": "ouro",
				"aliases": [
					"Ouro",
					"ouro"
				],
				"extensions": [
					".ouro"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "ouro",
				"scopeName": "source.ouro",
				"path": "./syntaxes/ouro.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "ouro.restartServer",
				"title": "Ouro: Restart Language Server"
			}
		],
		"configuration": {
			"title": "Ouro",
			"properties": {
				"ouro.server.command": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"restricted": true,
					"markdownDescription": "Trusted local program that speaks LSP on stdio. It must be configured explicitly; workspace settings cannot choose an executable."
				},
				"ouro.server.args": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "machine",
					"restricted": true,
					"description": "Arguments for ouro.server.command. Ignored unless that setting is set."
				},
				"ouro.root": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"restricted": true,
					"description": "Ouro checkout to run the toolchain from. Empty means the first workspace folder."
				},
				"ouro.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Log the JSON-RPC traffic to the Ouro output channel."
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"lint": "biome check --error-on-warnings --config-path ../../quality/biome.json src test",
		"test": "npm run lint && npm run compile && node test/launch-policy.test.mjs",
		"watch": "tsc -watch -p ./"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/node": "^22.13.0",
		"@types/vscode": "^1.91.0",
		"typescript": "^7.0.2"
	}
}
