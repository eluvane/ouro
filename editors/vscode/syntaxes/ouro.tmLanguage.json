{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Ouro",
	"scopeName": "source.ouro",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#string" },
		{ "include": "#import" },
		{ "include": "#declaration" },
		{ "include": "#keyword" },
		{ "include": "#universe" },
		{ "include": "#number" },
		{ "include": "#constructor" },
		{ "include": "#operator" },
		{ "include": "#hole" }
	],
	"repository": {
		"comment": {
			"comments": "Line comments only; -- runs to the end of the line. @entry and OURO-* codes carry meaning, so they are scoped apart.",
			"begin": "--",
			"end": "$",
			"name": "comment.line.double-dash.ouro",
			"patterns": [
				{
					"match": "@(entry|module)\\b",
					"name": "keyword.control.directive.ouro"
				},
				{
					"match": "\\bOURO-[A-Z]+-[0-9]+\\b",
					"name": "constant.other.diagnostic-code.ouro"
				}
			]
		},
		"string": {
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.ouro",
			"patterns": [
				{
					"match": "\\\\([\\\\\"nrt0]|x[0-9A-Fa-f]{2})",
					"name": "constant.character.escape.ouro"
				},
				{
					"match": "\\\\.",
					"name": "invalid.illegal.unknown-escape.ouro"
				}
			]
		},
		"import": {
			"comments": "import \"path\"; — the path is what the compiler and the language server resolve.",
			"match": "\\b(import)\\s+(\"[^\"]*\")",
			"captures": {
				"1": { "name": "keyword.control.import.ouro" },
				"2": { "name": "string.quoted.double.ouro" }
			}
		},
		"declaration": {
			"match": "^\\s*(def|axiom|inductive|record|effect)\\s+([A-Za-z_][A-Za-z0-9_']*)",
			"captures": {
				"1": { "name": "keyword.other.declaration.ouro" },
				"2": { "name": "entity.name.function.ouro" }
			}
		},
		"keyword": {
			"comments": "The lexer's table (compiler/lexer.ouro), plus the let! sugar.",
			"patterns": [
				{
					"match": "\\b(def|axiom|inductive|record|effect|import|where)\\b",
					"name": "keyword.other.declaration.ouro"
				},
				{
					"match": "\\b(match|with|end|do|handle|perform)\\b",
					"name": "keyword.control.ouro"
				},
				{
					"match": "\\blet!|\\b(let|in|fix|fun)\\b",
					"name": "keyword.other.binding.ouro"
				}
			]
		},
		"universe": {
			"match": "\\bType[0-9]*\\b",
			"name": "support.type.universe.ouro"
		},
		"number": {
			"match": "\\b[0-9]+\\b",
			"name": "constant.numeric.ouro"
		},
		"constructor": {
			"comments": "Capitalised names are types and constructors by convention throughout std/.",
			"match": "\\b[A-Z][A-Za-z0-9_']*\\b",
			"name": "entity.name.type.ouro"
		},
		"operator": {
			"match": ":=|->|=>|<-|\\|>|[|:;,]",
			"name": "keyword.operator.ouro"
		},
		"hole": {
			"comments": "? is a hole the elaborator is expected to fill.",
			"match": "\\?",
			"name": "variable.other.hole.ouro"
		}
	}
}
