{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouro-lang.github.io/schema/ouro.kernel-core-artifact.v1.schema.json",
  "title": "ouro.kernel-core-artifact.v1",
  "description": "Canonical JSON core artifact emitted for kernel replay. Consumed by scripts/kernel_recheck.py. Cache, generated-C, and selfhost outputs are outside this schema and outside the TCB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "expect", "decls"],
  "properties": {
    "kind": {
      "const": "ouro.kernel-core-artifact.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "expect": {
      "type": "string",
      "enum": ["accept", "reject"]
    },
    "decls": {
      "type": "array",
      "items": { "$ref": "#/$defs/decl" }
    }
  },
  "$defs": {
    "binderName": {
      "type": "string",
      "minLength": 1
    },
    "nat": {
      "type": "integer",
      "minimum": 0
    },
    "term": {
      "description": "Tagged JSON array encoding of a de Bruijn core term.",
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{ "const": "Rel" }, { "$ref": "#/$defs/nat" }],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [{ "const": "Sort" }, { "$ref": "#/$defs/nat" }],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [{ "const": "StringLit" }, { "type": "string" }],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "Pi" },
            { "$ref": "#/$defs/binderName" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "Lam" },
            { "$ref": "#/$defs/binderName" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "App" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "LetIn" },
            { "$ref": "#/$defs/binderName" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [{ "const": "Const" }, { "$ref": "#/$defs/binderName" }],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [{ "const": "Ind" }, { "$ref": "#/$defs/binderName" }],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "Construct" },
            { "$ref": "#/$defs/binderName" },
            { "$ref": "#/$defs/nat" },
            { "$ref": "#/$defs/nat" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "Case" },
            { "$ref": "#/$defs/caseInfo" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" },
            { "type": "array", "items": { "$ref": "#/$defs/term" } }
          ],
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [
            { "const": "Fix" },
            { "$ref": "#/$defs/binderName" },
            { "$ref": "#/$defs/nat" },
            { "$ref": "#/$defs/nat" },
            { "$ref": "#/$defs/term" },
            { "$ref": "#/$defs/term" }
          ],
          "minItems": 6,
          "maxItems": 6
        }
      ]
    },
    "caseInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ind", "nparams", "ctors"],
      "properties": {
        "ind": { "$ref": "#/$defs/binderName" },
        "nparams": { "$ref": "#/$defs/nat" },
        "ctors": {
          "type": "array",
          "items": { "$ref": "#/$defs/nat" }
        }
      }
    },
    "binder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/binderName" },
        "type": { "$ref": "#/$defs/term" }
      }
    },
    "ctor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/binderName" },
        "type": { "$ref": "#/$defs/term" }
      }
    },
    "decl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "type"],
          "properties": {
            "kind": { "enum": ["def", "axiom"] },
            "name": { "$ref": "#/$defs/binderName" },
            "type": { "$ref": "#/$defs/term" },
            "body": {
              "description": "Required for kind=def unless the declaration is an admit. Null/absent means no body.",
              "oneOf": [{ "$ref": "#/$defs/term" }, { "type": "null" }]
            },
            "admit": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "ctors"],
          "properties": {
            "kind": { "const": "ind" },
            "name": { "$ref": "#/$defs/binderName" },
            "params": {
              "type": "array",
              "items": { "$ref": "#/$defs/binder" }
            },
            "indices": {
              "type": "array",
              "items": { "$ref": "#/$defs/binder" }
            },
            "sort": { "$ref": "#/$defs/nat" },
            "ctors": {
              "type": "array",
              "items": { "$ref": "#/$defs/ctor" }
            }
          }
        }
      ]
    }
  }
}
