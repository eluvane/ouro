-- Source parser composition over the same mode helpers and ABI as bootstrap.
-- Keep the recursive fuel boundary here; shards receive its recursive callback.

import "parse_a.ouro";
import "parse_b.ouro";
import "../std/types.ouro";
import "parser_min.ouro";
import "token.ouro";

def parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value :=
  fix parse (fuel : Nat) (mode : Mode) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match fuel with
    | Z => PErr Value pos
    | S fuel' =>
        let recur : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value :=
          fun (_requested : Nat) (next_mode : Mode) (tokens : List Token)
              (position : Nat) (value : Value) =>
            parse fuel' next_mode tokens position value in
        match mode with
        | MExpr => parse fuel' MPipe toks pos extra
        | MPipe =>
            bindValue Expr asExpr (parse fuel' MPi toks pos extra)
              (fun (lhs : Expr) (toks2 : List Token) (pos2 : Nat) =>
                parse fuel' MPipeTail toks2 pos2 (VExpr lhs))
        | MPipeTail => parse_a_pipetail recur fuel' toks pos extra
        | MPi => parse_a_pi recur fuel' toks pos extra
        | MPiFromApp => parse_a_pifromapp recur fuel' toks pos extra
        | MApp =>
            bindValue Expr asExpr (parse fuel' MAtom toks pos extra)
              (fun (head : Expr) (toks2 : List Token) (pos2 : Nat) =>
                parse fuel' MAppTail toks2 pos2 (VExpr head))
        | MAppTail => parse_a_apptail recur fuel' toks pos extra
        | MAtom => parse_a_atom recur fuel' toks pos extra
        | MParen => parse_a_paren recur fuel' toks pos extra
        | MKeywordAtom => parse_a_keywordatom recur fuel' toks pos extra
        | MFun => parse_b_fun recur fuel' toks pos extra
        | MLet => parse_b_let recur fuel' toks pos extra
        | MMatch => parse_b_match recur fuel' toks pos extra
        | MFix => parse_b_fix recur fuel' toks pos extra
        | MTypedBinder => parse_a_typedbinder recur fuel' toks pos extra
        | MTypedBinderGroup => parse_a_typedbindergroup recur fuel' toks pos extra
        | MTypedBinders => parse_a_typedbinders recur fuel' toks pos extra
        | MFunBinders => parse_a_funbinders recur fuel' toks pos extra
        | MPattern => parse_b_pattern recur fuel' toks pos extra
        | MPatternVars => parse_b_pattern_vars recur fuel' toks pos extra
        | MPatterns => parse_b_patterns recur fuel' toks pos extra
        | MMultiBranches => parse_b_multi_branches recur fuel' toks pos extra
        | MScrutList => parse_b_scrut_list recur fuel' toks pos extra
        | MEffectAnnotation => parse_a_effectannotation recur fuel' toks pos extra
        | MEffectRow => parse_a_effectrow recur fuel' toks pos extra
        | MCommaList => parse_a_commalist recur fuel' toks pos extra
        | MListElems => parse_a_listelems recur fuel' toks pos extra
        | MListTail => parse_a_listtail recur fuel' toks pos extra
        | MIdentCommaList => parse_a_identcommalist recur fuel' toks pos extra
        | MDoStmt => parse_b_do_stmt recur fuel' toks pos extra
        | MDoExprs => parse_b_do_exprs recur fuel' toks pos extra
        | MPerform => parse_b_perform recur fuel' toks pos extra
        | MDo =>
            bindValue (List Expr) asListExpr (parse fuel' MDoExprs toks pos extra)
              (fun (es : List Expr) (toks2 : List Token) (pos2 : Nat) =>
                okExpr (EDo es) toks2 pos2)
        | MHandle => parse_b_handle recur fuel' toks pos extra
        | MHandleClauses => parse_b_handle_clauses recur fuel' toks pos extra
        end
    end;
