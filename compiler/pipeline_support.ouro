-- Packed frontend stitcher: shortcuts here remain untrusted until compile_program/kernel checking succeeds.
-- Import-alias and record expanders run before lexing so C seams never rescan source.

-- @entry compile_from_decls
-- @export collect_lower_env_from; @doc docs/tcb.md
-- @export lower_decls_env; @doc docs/tcb.md
-- @export compile_from_decls; @doc docs/tcb.md
-- @export compile_checked_from_decls; @doc docs/tcb.md

import "source_text.ouro",
  "../std/data.ouro",
  "../std/listx.ouro",
  "ast.ouro",
  "source_origin.ouro",
  "source_spans.ouro",
  "source_name_index.ouro",
  "token.ouro",
  "core.ouro",
  "pipeline_abi.ouro",
  "pipeline_surface.ouro",
  "pipeline_check.ouro",
  "file_check_model.ouro",
  "file_check_environment.ouro",
  "path.ouro",
  "import_paths.ouro",
  "lower_env.ouro",
  "lower_decl_types.ouro",
  "checked_program.ouro",
  "core_literals.ouro";

def pipeline_thousand : Nat := fuel1k;

def depth_gate : Nat :=
  add(ten, add(ten, add(ten, S (S Z))));

def parse_err_code : Nat := ten;
def lex_malformed_err_code : Nat := S ten;
def lex_exhausted_err_code : Nat := S (S ten);

def gebNat (n : Nat) (m : Nat) : Bool :=
  match compareNat n m with
  | LT => False
  | EQ => True
  | GT => True
  end;

def maxNat2 (a : Nat) (b : Nat) : Nat :=
  match gebNat a b with
  | True => a
  | False => b
  end;

def ctor_infos_of (indId : Nat) (nparams : Nat) (marked : Nat) (idx : Nat)
    (cs : List (Pair Nat Expr)) : List CtorInfo :=
    (fix go (rest : List (Pair Nat Expr)) (index : Nat) : List CtorInfo :=
      match rest with
      | Nil => Nil CtorInfo
      | Cons ctor tail =>
          match ctor with
          | MkPair nameId ty =>
              Cons CtorInfo
                (MkCtorInfo nameId indId index nparams (expr_pi_arity pipeline_thousand ty) marked)
                (go(tail, S index))
          end
      end) cs idx;

def id_of_name (st : InternState) (name : List Nat) : Nat :=
  match st with
  | MkIntern ids _nextId _strs _nextStr =>
      match source_lookup_id ids name with
      | Nothing => Z
      | Just n => n
      end
  end;

def name_String : List Nat := ([83, 116, 114, 105, 110, 103] : List Nat);
def name_Unit : List Nat := ([85, 110, 105, 116] : List Nat);
def name_IO : List Nat := ([73, 79] : List Nat);
def name_io_bind : List Nat := ([105, 111, 95, 98, 105, 110, 100] : List Nat);
def name_pure : List Nat := ([112, 117, 114, 101] : List Nat);
def name_List : List Nat := ([76, 105, 115, 116] : List Nat);
def name_Nil : List Nat := ([78, 105, 108] : List Nat);
def name_Cons : List Nat := ([67, 111, 110, 115] : List Nat);

inductive PipelineRoleChoice : Type :=
  | PipelineNoRole : PipelineRoleChoice
  | PipelineOneRole : Nat -> PipelineRoleChoice
  | PipelineDuplicateRole : PipelineRoleChoice;

def pipeline_literal_id (st : InternState) (bytes : List Nat) : Maybe Nat :=
  match st with
  | MkIntern _ _ strings _ => source_lookup_id strings bytes
  end;

def pipeline_add_role (choice : PipelineRoleChoice) (name : Nat)
    : PipelineRoleChoice :=
  match choice with
  | PipelineNoRole => PipelineOneRole name
  | PipelineOneRole _ => PipelineDuplicateRole
  | PipelineDuplicateRole => PipelineDuplicateRole
  end;

-- These are only lowering hints. Every intrinsic and representation is still
-- validated by the declaration checker after lowering.
def pipeline_role_choice (st : InternState) (key : List Nat)
    (is_intrinsic : Bool) (decls : List Decl) : PipelineRoleChoice :=
  match pipeline_literal_id st key with
  | Nothing => PipelineNoRole
  | Just label =>
      foldl Decl PipelineRoleChoice
        (fun (choice : PipelineRoleChoice) (decl : Decl) =>
          match decl with
          | DIntrinsic name _ current _ =>
              match andb(is_intrinsic, eqNat current label) with
              | True => pipeline_add_role choice name
              | False => choice
              end
          | DRepresentation name current =>
              match andb(notb is_intrinsic, eqNat current label) with
              | True => pipeline_add_role choice name
              | False => choice
              end
          | DDef _ _ _ _ _ => choice
          | DAxiom _ _ => choice
          | DInductive _ _ _ _ _ => choice
          | DEffect _ _ _ => choice
          | DExtern _ _ _ => choice
          | DImport _ => choice
          end) PipelineNoRole decls
  end;

def pipeline_role_or_name (st : InternState) (name : List Nat)
    (choice : PipelineRoleChoice) : Nat :=
  match choice with
  | PipelineNoRole => id_of_name st name
  | PipelineOneRole selected => selected
  | PipelineDuplicateRole => Z
  end;

def pipeline_role_id (choice : PipelineRoleChoice) : Nat :=
  match choice with
  | PipelineOneRole selected => selected
  | PipelineNoRole => Z
  | PipelineDuplicateRole => Z
  end;

def pipeline_declares_const (name : Nat) : List Decl -> Bool :=
  fix find (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons decl rest =>
        match decl with
        | DDef current _ _ _ _ => orb(eqNat current name, find rest)
        | DAxiom current _ => orb(eqNat current name, find rest)
        | DIntrinsic current _ _ _ => orb(eqNat current name, find rest)
        | DExtern current _ _ => orb(eqNat current name, find rest)
        | DInductive _ _ _ _ _ => find rest
        | DEffect _ _ _ => find rest
        | DRepresentation _ _ => find rest
        | DImport _ => find rest
        end
    end;

-- Keep a checked local wrapper for legacy `do` syntax when it exists. If an
-- alias collision removed its bare name, use the intrinsic role instead.
def pipeline_runtime_hint (st : InternState) (name : List Nat)
    (choice : PipelineRoleChoice) (decls : List Decl) : Nat :=
  let ordinary : Nat := id_of_name st name in
  match choice with
  | PipelineNoRole => ordinary
  | PipelineDuplicateRole => Z
  | PipelineOneRole role_name =>
      match pipeline_declares_const ordinary decls with
      | True => ordinary
      | False => role_name
      end
  end;

def pipeline_declared_lower_env (specials : List Nat)
    (decls : List Decl) : LowerEnv :=
  (fix go (ds : List Decl) : LowerEnv :=
    match ds with
    | Nil =>
        MkLowerEnv (Nil Nat) (Nil Nat) (Nil CtorInfo)
          specials
          (Nil (Pair Nat Surface)) (Nil (Pair Nat Surface))
          (Nil DefInfo)
    | Cons d ds' =>
        match go ds' with
        | MkLowerEnv cids iids ctors accumulated_specials pays types defs =>
            match d with
            | DDef n _ _ marked params =>
                MkLowerEnv (Cons Nat n cids) iids ctors accumulated_specials pays types
                  (match params with
                   | Nil => defs
                   | Cons _ _ => Cons DefInfo (DefInfoOf n marked params) defs
                   end)
            | DAxiom n _ =>
                MkLowerEnv (Cons Nat n cids) iids ctors accumulated_specials pays types defs
            | DIntrinsic n _ _ _ =>
                MkLowerEnv (Cons Nat n cids) iids ctors accumulated_specials pays types defs
            | DExtern n _ _ =>
                MkLowerEnv (Cons Nat n cids) iids ctors accumulated_specials pays types defs
            | DRepresentation _ _ =>
                MkLowerEnv cids iids ctors accumulated_specials pays types defs
            | DInductive n ps _fam cs marked =>
                MkLowerEnv cids (Cons Nat n iids)
                  (append CtorInfo
                    (ctor_infos_of n (length(Pair Nat Expr, ps)) marked Z cs) ctors)
                  accumulated_specials pays types defs
            | DEffect _ _ _ =>
                MkLowerEnv cids iids ctors accumulated_specials pays types defs
            | DImport _ =>
                MkLowerEnv cids iids ctors accumulated_specials pays types defs
            end
        end
    end) decls;

def pipeline_standard_special_ids (st : InternState) (decls : List Decl)
    : List Nat :=
    let string_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 115, 116, 114, 105, 110, 103] : List Nat)
      True decls in
    let unit_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 117, 110, 105, 116] : List Nat)
      False decls in
    let list_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 108, 105, 115, 116] : List Nat)
      False decls in
    let runtime_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 114, 117, 110, 116, 105, 109, 101] : List Nat)
      True decls in
    let runtime_bind_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 114, 117, 110, 116, 105, 109, 101,
        46, 98, 105, 110, 100] : List Nat) True decls in
    let list_name : Nat := pipeline_role_or_name st name_List list_role in
    let list_ctors : Pair Nat Nat := match list_role with
      | PipelineNoRole => MkPair Nat Nat
          (id_of_name st name_Nil) (id_of_name st name_Cons)
      | PipelineOneRole selected => pipeline_role_ctors selected decls
      | PipelineDuplicateRole => MkPair Nat Nat Z Z
      end in
    match list_ctors with
    | MkPair nil_id cons_id =>
        ([pipeline_role_or_name st name_String string_role,
          pipeline_role_or_name st name_Unit unit_role,
          pipeline_runtime_hint st name_IO runtime_role decls,
          pipeline_runtime_hint st name_io_bind runtime_bind_role decls,
          id_of_name st name_pure, list_name, nil_id, cons_id] : List Nat)
    end;

def pipeline_nominal_special_ids (st : InternState) (decls : List Decl)
    : List Nat :=
    let maybe_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 109, 97, 121, 98, 101] : List Nat)
      False decls in
    let nat_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 110, 97, 116] : List Nat)
      False decls in
    let range_bound_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 114, 97, 110, 103, 101, 45, 98, 111, 117, 110, 100] : List Nat)
      False decls in
    let range_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 114, 97, 110, 103, 101] : List Nat)
      False decls in
    let bool_role : PipelineRoleChoice := pipeline_role_choice st
      ([111, 117, 114, 111, 46, 98, 111, 111, 108] : List Nat)
      False decls in
    let maybe_ctors : Pair Nat Nat := match maybe_role with
      | PipelineOneRole selected => pipeline_role_ctors selected decls
      | PipelineNoRole => MkPair Nat Nat Z Z
      | PipelineDuplicateRole => MkPair Nat Nat Z Z
      end in
    match maybe_ctors with
    | MkPair nothing_id just_id =>
        ([pipeline_role_id nat_role, pipeline_role_id range_bound_role,
          pipeline_role_id range_role, pipeline_role_id bool_role,
          pipeline_role_id maybe_role, nothing_id, just_id] : List Nat)
    end;

def collect_lower_env_from (st : InternState) (decls : List Decl) : LowerEnv :=
    pipeline_declared_lower_env
      (append Nat (pipeline_standard_special_ids st decls)
        (pipeline_nominal_special_ids st decls)) decls;

inductive LoweredDecl : Type :=
  | LoweredDeclOf : Nat -> Pair (Maybe Nat) LoweredSurface -> LoweredDecl;

def source_decl_slot (decl : Decl) : Pair Nat Nat :=
  match decl with
  | DDef name _ _ _ _ => MkPair Nat Nat 0 name
  | DAxiom name _ => MkPair Nat Nat 1 name
  | DInductive name _ _ _ _ => MkPair Nat Nat 2 name
  | DEffect name _ _ => MkPair Nat Nat 3 name
  | DImport path => MkPair Nat Nat 4 path
  | DIntrinsic name _ _ _ => MkPair Nat Nat 5 name
  | DExtern name _ _ => MkPair Nat Nat 6 name
  | DRepresentation target _ => MkPair Nat Nat 7 target
  end;

def source_decl_same_slot (before : Decl) (after : Decl) : Bool :=
  match source_decl_slot before with | MkPair before_kind before_name =>
    match source_decl_slot after with | MkPair after_kind after_name =>
      andb(eqNat before_kind after_kind, eqNat before_name after_name)
    end end;

-- Provenance rows do not authorize checking or runtime binding.
inductive SourceModuleSlot : Type :=
  | SourceModuleSlotOf : Nat -> Pair (Pair Nat Nat) (Maybe (Pair Nat Nat)) -> SourceModuleSlot;

inductive SourceCheckedOwner : Type :=
  | SourceCheckedOwnerOf : Entry -> Maybe (Pair Nat (Pair Nat Nat)) -> SourceCheckedOwner;

inductive CheckedSourcePacket : Type :=
  | CheckedSourcePacketOf : CheckedProgram ->
      Pair (List SourceModuleSlot) (List SourceCheckedOwner) -> CheckedSourcePacket;

def source_slot_equal (left : Pair Nat Nat) (right : Pair Nat Nat) : Bool :=
  match left with | MkPair left_kind left_name =>
    match right with | MkPair right_kind right_name =>
      andb(eqNat left_kind right_kind, eqNat left_name right_name)
    end end;

def source_origin_rows_append (first : Either SourceOriginError (List OwnedSourceOccurrence))
    (second : Either SourceOriginError (List OwnedSourceOccurrence))
    : Either SourceOriginError (List OwnedSourceOccurrence) :=
  match first with
  | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
  | Right heads => match second with
    | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
    | Right tails => Right SourceOriginError (List OwnedSourceOccurrence)
        (append OwnedSourceOccurrence heads tails)
    end
  end;

def source_origin_empty_rows (mapping : Either SourceOriginError (Maybe OriginalSourceMap))
    : Either SourceOriginError (List OwnedSourceOccurrence) :=
  match mapping with
  | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
  | Right optional => match optional with
    | Nothing => Right SourceOriginError (List OwnedSourceOccurrence) []
    | Just origin => match original_map_validate origin with
      | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
      | Right _ => Right SourceOriginError (List OwnedSourceOccurrence) []
      end
    end
  end;

def source_origin_occurrence_follows (previous : Maybe (Pair Nat (Pair Nat Nat)))
    (kind : Nat) (current : Pair Nat Nat) : Bool :=
  match current with | MkPair first past =>
    andb(ltb_nat first past,
      (match previous with
       | Nothing => True
       | Just prior => match prior with | MkPair prior_kind interval =>
         match interval with | MkPair start finish =>
           orb(leb_nat finish first,
             andb(eqNat kind 4, andb(eqNat prior_kind 4, andb(eqNat start first, eqNat finish past))))
         end end
       end))
  end;

def source_origin_capture_occurrences (unit : Nat) (before : List Decl) (after : List Decl)
    (occurrences : List ParsedSourceOccurrence) (spans : TokenSpans) (mapping : OriginalSourceMap)
    : Either SourceOriginError (List OwnedSourceOccurrence) :=
  match original_map_validate mapping with
  | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
  | Right checked => match checked with | OriginalSourceMapOf totals _ => match totals with
    | MkPair _ prepared_total => match spans with | MkTokenSpans actual_total _ =>
      match eqNat prepared_total actual_total with
      | False => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginCoverage
      | True =>
          (fix go (originals : List Decl) (canonical : List Decl)
              (rows : List ParsedSourceOccurrence) (ordinal : Nat) (previous : Maybe (Pair Nat (Pair Nat Nat)))
              : Either SourceOriginError (List OwnedSourceOccurrence) :=
            match originals with
            | Nil => match canonical with
              | Cons _ _ => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginOccurrence
              | Nil => match rows with
                | Cons _ _ => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginOccurrence
                | Nil => Right SourceOriginError (List OwnedSourceOccurrence) []
                end
              end
            | Cons original rest => match canonical with
              | Nil => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginOccurrence
              | Cons current tail => match rows with
                | Nil => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginOccurrence
                | Cons row more => match row with | ParsedSourceOccurrenceOf captured position =>
                  match position with | MkPair index interval =>
                    match source_decl_slot original with | MkPair kind _ =>
                      match source_decl_slot current with | MkPair current_kind _ =>
                        match andb(eqNat index ordinal,
                            andb(source_decl_same_slot original captured,
                              andb(eqNat kind current_kind,
                                andb((match original with
                                      | DImport _ => True
                                      | DDef _ _ _ _ _ => source_decl_same_slot original current
                                      | DAxiom _ _ => source_decl_same_slot original current
                                      | DInductive _ _ _ _ _ => source_decl_same_slot original current
                                      | DEffect _ _ _ => source_decl_same_slot original current
                                      | DIntrinsic _ _ _ _ => source_decl_same_slot original current
                                      | DExtern _ _ _ => source_decl_same_slot original current
                                      | DRepresentation _ _ => source_decl_same_slot original current
                                      end), source_origin_occurrence_follows previous kind interval)))) with
                        | False => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginOccurrence
                        | True => match interval with | MkPair first past =>
                          match token_span_bytes spans first past with
                          | Nothing => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginOccurrence
                          | Just bytes => match original_map_cover checked bytes with
                            | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
                            | Right envelope => match go rest tail more (S ordinal)
                                  (Just (Pair Nat (Pair Nat Nat)) (MkPair Nat (Pair Nat Nat) kind interval)) with
                              | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
                              | Right others => Right SourceOriginError (List OwnedSourceOccurrence)
                                  (Cons OwnedSourceOccurrence
                                    (OwnedSourceOccurrenceOf unit
                                      (MkPair ParsedSourceOccurrence (Maybe OriginalEnvelope)
                                        (ParsedSourceOccurrenceOf current position) envelope)) others)
                              end
                            end
                          end
                        end
                        end
                      end end
                    end end
                  end
                end
            end) before after occurrences 0 (Nothing (Pair Nat (Pair Nat Nat)))
      end
    end end end
  end;

def source_origin_occurrence (unit : Nat) (slot : Pair Nat Nat)
    (occurrences : List OwnedSourceOccurrence) : Maybe OriginalEnvelope :=
  let candidates : List OwnedSourceOccurrence := filter OwnedSourceOccurrence
    (fun (row : OwnedSourceOccurrence) => match row with | OwnedSourceOccurrenceOf owner captured =>
      match captured with | MkPair occurrence _ => match occurrence with | ParsedSourceOccurrenceOf decl _ =>
        andb(eqNat unit owner, source_slot_equal slot (source_decl_slot decl))
      end end end) occurrences in
  match candidates with
  | Nil => Nothing OriginalEnvelope
  | Cons row rest => match rest with
    | Cons _ _ => Nothing OriginalEnvelope
    | Nil => match row with | OwnedSourceOccurrenceOf _ captured =>
      match captured with | MkPair _ envelope => envelope end end
    end
  end;

def source_origin_capture_rows (unit : Nat) (before : List Decl) (after : List Decl)
    (spans : Maybe TokenSpans) (occurrences : Maybe (List ParsedSourceOccurrence))
    (mapping : Either SourceOriginError (Maybe OriginalSourceMap))
    : Either SourceOriginError (List OwnedSourceOccurrence) :=
  match mapping with
  | Left error => Left SourceOriginError (List OwnedSourceOccurrence) error
  | Right origin => match spans with
    | Nothing => match occurrences with
      | Just _ => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginCoverage
      | Nothing => match origin with
        | Just _ => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginCoverage
        | Nothing => Right SourceOriginError (List OwnedSourceOccurrence) []
        end
      end
    | Just marks => match occurrences with
      | Nothing => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginCoverage
      | Just rows => match origin with
        | Nothing => Left SourceOriginError (List OwnedSourceOccurrence) SourceOriginCoverage
        | Just owned => source_origin_capture_occurrences unit before after rows marks owned
        end
      end
    end
  end;

def source_module_slot_relation (owner : Nat) (before : List Decl)
    (after : List Decl) : List SourceModuleSlot :=
  let complete : Bool := eqNat (length Decl before) (length Decl after) in
  (fix go (remaining : List Decl) (originals : List Decl) : List SourceModuleSlot :=
    match remaining with
    | Nil => []
    | Cons decl rest =>
        let current : Pair Nat Nat := source_decl_slot decl in
        let original : Pair (Maybe (Pair Nat Nat)) (List Decl) :=
          match originals with
          | Nil => MkPair (Maybe (Pair Nat Nat)) (List Decl)
              (Nothing (Pair Nat Nat)) []
          | Cons prior tail =>
              let previous : Pair Nat Nat := source_decl_slot prior in
              MkPair (Maybe (Pair Nat Nat)) (List Decl)
                (match current with | MkPair current_kind _ =>
                  match previous with | MkPair prior_kind _ =>
                    match andb(complete, eqNat current_kind prior_kind) with
                    | True => Just (Pair Nat Nat) previous
                    | False => Nothing (Pair Nat Nat)
                    end
                  end end) tail
          end in
        match original with | MkPair prior tail =>
          Cons SourceModuleSlot
            (SourceModuleSlotOf owner
              (MkPair (Pair Nat Nat) (Maybe (Pair Nat Nat)) current prior))
            (go rest tail)
        end
    end) after before;

def source_module_unit_slots : List SrcUnit -> List SourceModuleSlot :=
  fix go (units : List SrcUnit) : List SourceModuleSlot :=
    match units with
    | Nil => []
    | Cons unit rest => match unit with | MkSrcUnit owner _ =>
        let decls : List Decl := src_unit_decls unit in
        append SourceModuleSlot (source_module_slot_relation owner decls decls) (go rest)
      end
    end;

def source_module_original_slot (owner : Nat) (scoped : Pair Nat Nat)
    (slots : List SourceModuleSlot) : Maybe (Pair Nat Nat) :=
  let candidates : List SourceModuleSlot := filter SourceModuleSlot
    (fun (row : SourceModuleSlot) => match row with | SourceModuleSlotOf unit relation =>
      match relation with | MkPair current _ =>
        andb(eqNat owner unit, source_slot_equal scoped current)
      end end) slots in
  match candidates with
  | Nil => Nothing (Pair Nat Nat)
  | Cons row rest => match rest with
      | Cons _ _ => Nothing (Pair Nat Nat)
      | Nil => match row with | SourceModuleSlotOf _ relation =>
          match relation with | MkPair current original => match original with
          | Nothing => Nothing (Pair Nat Nat)
          | Just prior => match current with | MkPair current_kind _ =>
              match prior with | MkPair prior_kind _ =>
                match eqNat current_kind prior_kind with
                | True => original
                | False => Nothing (Pair Nat Nat)
                end
              end end
          end end
        end
      end
  end;

def source_checked_entry_slot (entry : Entry) : Pair Nat Nat :=
  match entry with
  | MkEntry name _ body => match body with
      | Just _ => MkPair Nat Nat 0 name
      | Nothing => MkPair Nat Nat 1 name
      end
  | MkIndEntry name _ => MkPair Nat Nat 2 name
  | MkBoundEntry name _ binding => match binding with
      | PrimitiveIntrinsicBinding _ _ _ _ => MkPair Nat Nat 5 name
      | PrimitiveExternBinding _ => MkPair Nat Nat 6 name
      end
  | MkRoleEntry binding => match binding with | PrimitiveRoleOf _ shape =>
      match shape with | PrimitiveInductiveOf name _ _ _ _ => MkPair Nat Nat 7 name end
    end
  end;

def source_checked_unaligned_candidates (slot : Pair Nat Nat)
    : List SourceDecl -> List (Maybe (Pair Nat (Pair Nat Nat))) :=
  fix go (sources : List SourceDecl) : List (Maybe (Pair Nat (Pair Nat Nat))) :=
    match sources with
    | Nil => []
    | Cons source rest => match source with | SourceDeclOf _ decl =>
        let tail : List (Maybe (Pair Nat (Pair Nat Nat))) := go rest in
        match source_slot_equal slot (source_decl_slot decl) with
        | True => Cons (Maybe (Pair Nat (Pair Nat Nat)))
            (Nothing (Pair Nat (Pair Nat Nat))) tail
        | False => tail
        end
      end
    end;

-- Exhausted/misaligned origins still contribute unknown matching candidates.
def source_checked_owner_candidates (slot : Pair Nat Nat) (slots : List SourceModuleSlot)
    (sources : List SourceDecl) (decls : List Decl)
    : List (Maybe (Pair Nat (Pair Nat Nat))) :=
  (fix go (remaining : List Decl) (origins : List SourceDecl)
      : List (Maybe (Pair Nat (Pair Nat Nat))) :=
    match remaining with
    | Nil => source_checked_unaligned_candidates slot origins
    | Cons decl rest =>
        let position : Pair (Maybe Nat) (List SourceDecl) := match origins with
          | Nil => MkPair (Maybe Nat) (List SourceDecl) (Nothing Nat) []
          | Cons source tail => match source with | SourceDeclOf unit prior =>
              MkPair (Maybe Nat) (List SourceDecl)
                (match source_decl_same_slot prior decl with
                 | False => Nothing Nat | True => unit end) tail
            end
          end in
        match position with | MkPair unit tail =>
          let others : List (Maybe (Pair Nat (Pair Nat Nat))) := go rest tail in
          match source_slot_equal slot (source_decl_slot decl) with
          | False => others
          | True => Cons (Maybe (Pair Nat (Pair Nat Nat)))
              (match unit with
               | Nothing => Nothing (Pair Nat (Pair Nat Nat))
               | Just owner => match source_module_original_slot owner
                   (source_decl_slot decl) slots with
                   | Nothing => Nothing (Pair Nat (Pair Nat Nat))
                   | Just original => Just (Pair Nat (Pair Nat Nat))
                       (MkPair Nat (Pair Nat Nat) owner original)
                   end
               end) others
          end
        end
    end) decls sources;

def source_checked_owners (slots : List SourceModuleSlot)
    (sources : List SourceDecl) (decls : List Decl) (entries : List Entry)
    : List SourceCheckedOwner :=
  let slot_key (slot : Pair Nat Nat) : List Nat :=
    let (MkPair kind name) := slot in [add kind Z, add name Z] in
  let duplicates : SourceNameIndex :=
    (fix collect (remaining : List Entry) (seen : SourceNameIndex)
        (repeated : SourceNameIndex) : SourceNameIndex :=
      match remaining with
      | Nil => repeated
      | Cons entry rest =>
          let key : List Nat := slot_key (source_checked_entry_slot entry) in
          match source_name_index_lookup key seen with
          | Nothing => collect rest (source_name_index_insert key Z seen) repeated
          | Just _ => collect rest seen (source_name_index_insert key Z repeated)
          end
      end) entries SourceNameIndexEmpty SourceNameIndexEmpty in
  map Entry SourceCheckedOwner (fun (entry : Entry) =>
    let slot : Pair Nat Nat := source_checked_entry_slot entry in
    SourceCheckedOwnerOf entry
      (match source_name_index_lookup (slot_key slot) duplicates with
       | Just _ => Nothing (Pair Nat (Pair Nat Nat))
       | Nothing => match source_checked_owner_candidates slot slots sources decls with
           | Nil => Nothing (Pair Nat (Pair Nat Nat))
           | Cons owner rest => match rest with
               | Nil => owner
               | Cons _ _ => Nothing (Pair Nat (Pair Nat Nat))
               end
           end
       end)) entries;

def checked_source_packet_program (packet : CheckedSourcePacket) : CheckedProgram :=
  match packet with | CheckedSourcePacketOf checked _ => checked end;

def checked_source_packet_slots (packet : CheckedSourcePacket) : List SourceModuleSlot :=
  match packet with | CheckedSourcePacketOf _ metadata =>
    match metadata with | MkPair slots _ => slots end
  end;

def checked_source_packet_owners (packet : CheckedSourcePacket) : List SourceCheckedOwner :=
  match packet with | CheckedSourcePacketOf _ metadata =>
    match metadata with | MkPair _ owners => owners end
  end;

def checked_source_packet_project (result : SourceResult CheckedSourcePacket)
    : SourceResult CheckedProgram :=
  match result with
  | SourceErr failure => SourceErr CheckedProgram failure
  | SourceOk packet => SourceOk CheckedProgram (checked_source_packet_program packet)
  end;

-- @export checked_source_packet_snapshot; @doc docs/tcb.md
def checked_source_packet_snapshot (result : SourceResult CheckedSourcePacket) (state : InternState)
    : Pair (SourceResult CheckedSourcePacket) InternState :=
  MkPair (SourceResult CheckedSourcePacket) InternState result state;

inductive SourceOriginMetadata : Type :=
  | SourceOriginMetadataOf : Pair (List SourceModuleSlot) (List OwnedSourceOccurrence) ->
      List (Pair Entry (Maybe OriginalEnvelope)) -> SourceOriginMetadata;

inductive SourceOriginCompilation : Type :=
  | SourceOriginCompilationOf : Pair (SourceResult CheckedSourcePacket) InternState ->
      Either SourceOriginError SourceOriginMetadata -> SourceOriginCompilation;

def source_origin_entry_rows (packet : CheckedSourcePacket) (occurrences : List OwnedSourceOccurrence)
    : List (Pair Entry (Maybe OriginalEnvelope)) :=
  map SourceCheckedOwner (Pair Entry (Maybe OriginalEnvelope))
    (fun (row : SourceCheckedOwner) => match row with | SourceCheckedOwnerOf entry owner =>
      MkPair Entry (Maybe OriginalEnvelope) entry
        (match owner with
         | Nothing => Nothing OriginalEnvelope
         | Just location => match location with | MkPair unit slot =>
           source_origin_occurrence unit slot occurrences
           end
         end)
      end) (checked_source_packet_owners packet);

def source_origin_compilation_finish
    (observed : Pair (Pair (SourceResult CheckedSourcePacket) InternState)
      (Either SourceOriginError (Pair (List SourceModuleSlot) (List OwnedSourceOccurrence))))
    : SourceOriginCompilation :=
  match observed with | MkPair original metadata =>
    SourceOriginCompilationOf original
      (match metadata with
       | Left error => Left SourceOriginError SourceOriginMetadata error
       | Right locations => match original with | MkPair result _ =>
         match locations with | MkPair _ occurrences =>
           Right SourceOriginError SourceOriginMetadata
             (SourceOriginMetadataOf locations
               (match result with
                | SourceErr _ => []
                | SourceOk packet => source_origin_entry_rows packet occurrences
                end))
         end end
       end)
  end;

def source_origin_compilation_original (compilation : SourceOriginCompilation)
    : Pair (SourceResult CheckedSourcePacket) InternState :=
  match compilation with | SourceOriginCompilationOf original _ => original end;

def source_origin_compilation_metadata (compilation : SourceOriginCompilation)
    : Either SourceOriginError SourceOriginMetadata :=
  match compilation with | SourceOriginCompilationOf _ metadata => metadata end;

def source_origin_failure_span (owner : SourceFailureOwner) (metadata : SourceOriginMetadata)
    : Maybe (Pair Nat Nat) :=
  match owner with | SourceFailureOwnerOf declaration location =>
    match declaration with | MkPair name _ => match location with | MkPair unit _ =>
      match unit with
      | Nothing => Nothing (Pair Nat Nat)
      | Just actual_unit => match metadata with | SourceOriginMetadataOf locations _ =>
        match locations with | MkPair slots occurrences =>
          let candidates : List SourceModuleSlot := filter SourceModuleSlot
            (fun (row : SourceModuleSlot) => match row with | SourceModuleSlotOf candidate relation =>
              match relation with | MkPair current _ => match current with | MkPair _ current_name =>
                andb(eqNat actual_unit candidate, eqNat name current_name)
              end end end) slots in
          match candidates with
          | Nil => Nothing (Pair Nat Nat)
          | Cons row rest => match rest with
            | Cons _ _ => Nothing (Pair Nat Nat)
            | Nil => match row with | SourceModuleSlotOf _ relation => match relation with
              | MkPair current _ => match source_module_original_slot actual_unit current slots with
                | Nothing => Nothing (Pair Nat Nat)
                | Just original => match source_origin_occurrence actual_unit original occurrences with
                  | Nothing => Nothing (Pair Nat Nat)
                  | Just envelope => Just (Pair Nat Nat) (original_envelope_span envelope)
                  end
                end
              end end
            end
          end
        end end
      end
    end end
  end;

def source_origin_failure_with_span (failure : SourceFailure) (metadata : SourceOriginMetadata) : SourceFailure :=
  match failure with | SourceFailureOf error tagged => match tagged with | MkPair owner cause =>
    SourceFailureOf error
      (MkPair (Maybe SourceFailureOwner) (Maybe LowerRootCause)
        (match owner with
         | Nothing => Nothing SourceFailureOwner
         | Just actual => match actual with | SourceFailureOwnerOf declaration location =>
           match location with | MkPair unit _ =>
             Just SourceFailureOwner
               (SourceFailureOwnerOf declaration
                 (MkPair (Maybe Nat) (Maybe (Pair Nat Nat)) unit (source_origin_failure_span actual metadata)))
           end end
         end) cause)
  end end;

def source_origin_compilation_with_spans (compilation : SourceOriginCompilation)
    : Either SourceOriginError (Pair (SourceResult CheckedSourcePacket) InternState) :=
  match compilation with | SourceOriginCompilationOf original metadata =>
    match metadata with
    | Left error => Left SourceOriginError (Pair (SourceResult CheckedSourcePacket) InternState) error
    | Right locations => match original with | MkPair result state =>
      Right SourceOriginError (Pair (SourceResult CheckedSourcePacket) InternState)
        (MkPair (SourceResult CheckedSourcePacket) InternState
          (match result with
           | SourceErr failure => SourceErr CheckedSourcePacket (source_origin_failure_with_span failure locations)
           | SourceOk checked => SourceOk CheckedSourcePacket checked
           end) state)
      end
    end
  end;

-- @export checked_source_packet_reject; @doc docs/tcb.md
def checked_source_packet_reject (error : CompError) : SourceResult CheckedSourcePacket :=
  SourceErr CheckedSourcePacket (source_failure_unknown error);

private def lower_definitions
  (A : Type)
  (make_definition : Nat -> Maybe Nat -> Surface -> LoweredSurface -> A)
  (lower_expr : LowerEnv -> Maybe Surface -> Expr -> LoweredSurface)
  (env : LowerEnv) (sources : List SourceDecl) (decls : List Decl) : List A :=
  (fix go (rest : List Decl) (origins : List SourceDecl) : List A :=
    match rest with
    | Nil => Nil A
    | Cons decl tail =>
        let slot : Pair (Maybe Nat) (List SourceDecl) := match origins with
          | Nil => MkPair (Maybe Nat) (List SourceDecl) (Nothing Nat) (Nil SourceDecl)
          | Cons original next => match original with | SourceDeclOf unit before =>
              MkPair (Maybe Nat) (List SourceDecl)
                (match source_decl_same_slot before decl with
                 | True => unit | False => Nothing Nat end) next
              end
          end in
        match slot with | MkPair unit next =>
          match decl with
          | DDef name typ body _ _ =>
              let annotation : Surface := lowered_surface_value
                (lower_expr env (Nothing Surface) typ) in
              Cons A
                (make_definition name unit annotation (lower_expr env (Just Surface annotation) body))
                (go tail next)
          | DAxiom _ _ => go tail next
          | DIntrinsic _ _ _ _ => go tail next
          | DExtern _ _ _ => go tail next
          | DRepresentation _ _ => go tail next
          | DInductive _ _ _ _ _ => go tail next
          | DEffect _ _ _ => go tail next
          | DImport _ => go tail next
          end
        end
    end) decls sources;

def lower_decls_env_with_cause
  (lower_expr : LowerEnv -> Maybe Surface -> Expr -> LoweredSurface)
  (env : LowerEnv) (sources : List SourceDecl) (decls : List Decl) : List LoweredDecl :=
  lower_definitions LoweredDecl
    (fun (name : Nat) (unit : Maybe Nat) (_annotation : Surface) (body : LoweredSurface) =>
      LoweredDeclOf name (MkPair (Maybe Nat) LoweredSurface unit body))
    lower_expr env sources decls;

private def lowered_decl_surface (decl : LoweredDecl) : Pair Nat Surface :=
  match decl with | LoweredDeclOf name payload => match payload with
    | MkPair _ lowered => MkPair Nat Surface name (lowered_surface_value lowered)
  end end;

private def prepared_definition_body (row : Pair LoweredDecl Surface) : LoweredDecl :=
  let (MkPair body _) := row in body;

def lowered_decl_surfaces (decls : List LoweredDecl) : List (Pair Nat Surface) :=
  map LoweredDecl (Pair Nat Surface) lowered_decl_surface decls;

private def rewrite_lowered_surface (lowered : LoweredSurface) : LoweredSurface :=
  match lowered with | LoweredSurfaceOf surface cause =>
    LoweredSurfaceOf (rewrite_dummy_anns surface) cause
  end;

def rewrite_lowered_decls (decls : List LoweredDecl) : List LoweredDecl :=
  map LoweredDecl LoweredDecl (fun (decl : LoweredDecl) =>
    match decl with | LoweredDeclOf name payload => match payload with
      | MkPair unit lowered =>
          LoweredDeclOf name (MkPair (Maybe Nat) LoweredSurface unit
            (rewrite_lowered_surface lowered))
      end end) decls;

def lower_decls_env
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (env : LowerEnv) (decls : List Decl) : List (Pair Nat Surface) :=
  lowered_decl_surfaces
    (lower_decls_env_with_cause
      (fun (environment : LowerEnv) (expected : Maybe Surface) (expr : Expr) =>
        LoweredSurfaceOf (lower_expr_env2 environment expected expr) (Nothing LowerRootCause))
      env (source_decls_without_unit decls) decls);

-- SVar 0 in a binder annotation is the underscore dummy. SInd 0 keeps the
-- established runtime binder shape; expected-directed declaration checking
-- ignores this frontend-only annotation instead of granting it global meaning.
def rewrite_surface_pairs : List (Pair Nat Surface) -> List (Pair Nat Surface) :=
  fix go (xs : List (Pair Nat Surface)) : List (Pair Nat Surface) :=
    match xs with
    | Nil => Nil (Pair Nat Surface)
    | Cons p xs' =>
        match p with
        | MkPair n s =>
            Cons (Pair Nat Surface)
              (MkPair Nat Surface n (rewrite_dummy_anns s))
              (go xs')
        end
    end;

def pipeline_env_io_id (env : LowerEnv) : Nat :=
    env_ioId env;

def pipeline_surface_result : Surface -> Surface :=
  fix pipeline_surface_result (surface : Surface) : Surface :=
    match surface with
    | SPi _ _ cod => pipeline_surface_result cod
    | SVar _ => surface
    | SSort _ => surface
    | SLam _ _ _ => surface
    | SApp _ _ => surface
    | SLet _ _ _ _ => surface
    | SConst _ => surface
    | SInd _ => surface
    | SConstruct _ _ _ => surface
    | SCase _ _ _ _ => surface
    | SFix _ _ _ _ _ => surface
    | SHole _ => surface
    | SEffectRow _ => surface
    | SPerform _ _ => surface
    | SStr _ _ => surface
    end;

def pipeline_io_payload (env : LowerEnv) (surface : Surface) : Maybe Surface :=
    match peel_io_payload env (pipeline_surface_result surface) with
    | Just _ => Just Surface surface
    | Nothing => Nothing Surface
    end;

def collect_io_payloads
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (env : LowerEnv) : List Decl -> List (Pair Nat Surface) :=
  fix collect_io_payloads (decls : List Decl) : List (Pair Nat Surface) :=
    match decls with
    | Nil => Nil (Pair Nat Surface)
    | Cons decl rest =>
        let tail : List (Pair Nat Surface) := collect_io_payloads rest in
        match decl with
        | DDef name ty _ _ _ =>
            match pipeline_io_payload env
              (rewrite_dummy_anns
                (lower_expr_env2 env (Nothing Surface) ty)) with
            | Nothing => tail
            | Just payload =>
                Cons(Pair Nat Surface, MkPair Nat Surface name payload, tail)
            end
        | DAxiom name ty =>
            match pipeline_io_payload env
              (rewrite_dummy_anns
                (lower_expr_env2 env (Nothing Surface) ty)) with
            | Nothing => tail
            | Just payload =>
                Cons(Pair Nat Surface, MkPair Nat Surface name payload, tail)
            end
        | DInductive _ _ _ _ _ => tail
        | DEffect _ _ _ => tail
        | DImport _ => tail
        | DIntrinsic _ _ _ _ => tail
        | DExtern _ _ _ => tail
        | DRepresentation _ _ => tail
        end
    end;

def populate_decl_types
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (env : LowerEnv) (decls : List Decl) : LowerEnv :=
    match env with
    | MkLowerEnv constants inductives ctors specials payloads _ defs =>
        MkLowerEnv constants inductives ctors specials payloads
          (collect_decl_types
            (fun (known : List (Pair Nat Surface)) (ty : Expr) =>
              rewrite_dummy_anns
                (lower_expr_env2
                  (MkLowerEnv constants inductives ctors specials payloads known defs)
                  (Nothing Surface) ty))
            decls) defs
    end;

def populate_io_payloads
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (env : LowerEnv) (decls : List Decl) : LowerEnv :=
    let typed_env : LowerEnv := populate_decl_types lower_expr_env2 env decls in
    match typed_env with
    | MkLowerEnv constants inductives ctors specials _ types defs =>
        MkLowerEnv constants inductives ctors specials
          (collect_io_payloads lower_expr_env2 typed_env decls) types defs
    end;

def surface_depth : Surface -> Nat :=
  fix go (s : Surface) : Nat :=
    match s with
    | SVar _ => S Z
    | SSort _ => S Z
    | SPi _ a b => S (maxNat2(go a, go b))
    | SLam _ a b => S (maxNat2(go a, go b))
    | SApp f a => S (maxNat2(go f, go a))
    | SLet _ v t b => S (maxNat2(go v, maxNat2(go t, go b)))
    | SConst _ => S Z
    | SInd _ => S Z
    | SConstruct _ _ _ => S Z
    | SCase _ p sc bs =>
        S (maxNat2 (go p)
            (maxNat2 (go sc)
              ((fix max_list (xs : List Surface) : Nat :=
                  match xs with
                  | Nil => Z
                  | Cons x xs' => maxNat2(go x, max_list xs')
                  end) bs)))
    | SFix _ _ _ t b => S (maxNat2(go t, go b))
    | SHole _ => S Z
    | SEffectRow t => S (go t)
    | SPerform _ args =>
        S ((fix max_list (xs : List Surface) : Nat :=
              match xs with
              | Nil => Z
              | Cons x xs' => maxNat2(go x, max_list xs')
              end) args)
    | SStr _ _ => S Z
    end;

def surfaces_max_depth : List (Pair Nat Surface) -> Nat :=
  fix go (xs : List (Pair Nat Surface)) : Nat :=
    match xs with
    | Nil => Z
    | Cons p xs' =>
        match p with
        | MkPair _ s => maxNat2(surface_depth s, go xs')
        end
    end;

-- The fallback needs only a threshold, not every subtree's exact maximum.
-- Explicit matches stop once one child reaches it, including shared subtrees.
def surface_depth_at_least : Nat -> Surface -> Bool :=
  fix reaches (minimum : Nat) (surface : Surface) : Bool :=
    match minimum with
    | Z => True
    | S remaining =>
        match remaining with
        | Z => True
        | S _ =>
            let any_child : List Surface -> Bool :=
              fix visit (children : List Surface) : Bool :=
                match children with
                | Nil => False
                | Cons child rest =>
                    match reaches remaining child with
                    | True => True
                    | False => visit rest
                    end
                end in
            match surface with
            | SVar _ => False
            | SSort _ => False
            | SPi _ domain codomain => any_child ([domain, codomain] : List Surface)
            | SLam _ annotation body => any_child ([annotation, body] : List Surface)
            | SApp function argument => any_child ([function, argument] : List Surface)
            | SLet _ value typ body => any_child ([value, typ, body] : List Surface)
            | SConst _ => False
            | SInd _ => False
            | SConstruct _ _ _ => False
            | SCase _ predicate scrutinee branches =>
                any_child (Cons Surface predicate (Cons Surface scrutinee branches))
            | SFix _ _ _ typ body => any_child ([typ, body] : List Surface)
            | SHole _ => False
            | SEffectRow payload => reaches remaining payload
            | SPerform _ arguments => any_child arguments
            | SStr _ _ => False
            end
        end
    end;

def surfaces_depth_at_least (minimum : Nat)
    (surfaces : List (Pair Nat Surface)) : Bool :=
    match minimum with
    | Z => True
    | S _ =>
        (fix visit (remaining : List (Pair Nat Surface)) : Bool :=
          match remaining with
          | Nil => False
          | Cons pair rest =>
              match pair with
              | MkPair _ surface =>
                  match surface_depth_at_least minimum surface with
                  | True => True
                  | False => visit rest
                  end
              end
          end) surfaces
    end;

def surface_has_hole : Surface -> Bool :=
  fix go (s : Surface) : Bool :=
    match s with
    | SVar _ => False
    | SSort _ => False
    | SPi _ a b => orb(go a, go b)
    | SLam _ a b => orb(go a, go b)
    | SApp f a => orb(go f, go a)
    | SLet _ v t b => orb(go v, orb(go t, go b))
    | SConst _ => False
    | SInd _ => False
    | SConstruct _ _ _ => False
    | SCase _ p sc bs =>
        orb (go p)
          (orb (go sc)
            ((fix any_list (xs : List Surface) : Bool :=
                match xs with
                | Nil => False
                | Cons x xs' =>
                    match go x with
                    | True => True
                    | False => any_list xs'
                    end
                end) bs))
    | SFix _ _ _ t b => orb(go t, go b)
    | SHole _ => True
    | SEffectRow t => go t
    | SPerform _ args =>
        (fix any_list (xs : List Surface) : Bool :=
            match xs with
            | Nil => False
            | Cons x xs' =>
                match go x with
                | True => True
                | False => any_list xs'
                end
            end) args
    | SStr _ _ => False
    end;

def surfaces_have_hole : List (Pair Nat Surface) -> Bool :=
  fix go (xs : List (Pair Nat Surface)) : Bool :=
    match xs with
    | Nil => False
    | Cons p xs' =>
        match p with
        | MkPair _ s =>
            match surface_has_hole s with
            | True => True
            | False => go xs'
            end
        end
    end;

-- Declaration checker plan. These helpers preserve declared types, axioms,
-- inductives, and effects while pairing each DDef with the exact emitted body.
def compile_surfaces_with_location
  (compile_program : List (Pair Nat Surface) ->
    Pair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation))
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (fuel : Nat) (surfaces : List (Pair Nat Surface))
  : Pair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation) :=
  match compile_program surfaces with
  | MkPair result owner => match result with
    | COk cores => MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
        (COk (List (Pair Nat CoreTerm)) cores) (Nothing CompileProgramLocation)
    | CErr error => match error with | ErrCode code _ =>
        match eqNat code 2 with
        | False => MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
            (CErr (List (Pair Nat CoreTerm)) error) owner
        | True => match andb (surfaces_depth_at_least depth_gate surfaces)
            (notb (surfaces_have_hole surfaces)) with
            | False => MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
                (CErr (List (Pair Nat CoreTerm)) error) owner
            | True => MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
                (COk (List (Pair Nat CoreTerm)) (elaborate_surfaces fuel surfaces))
                (Nothing CompileProgramLocation)
            end
        end end
    end
  end;

def compile_surfaces
  (compile_program : List (Pair Nat Surface) -> CompResult (List (Pair Nat CoreTerm)))
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (fuel : Nat) (surfaces : List (Pair Nat Surface))
  : CompResult (List (Pair Nat CoreTerm)) :=
  match compile_surfaces_with_location
      (fun (items : List (Pair Nat Surface)) =>
        MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
          (compile_program items) (Nothing CompileProgramLocation))
      elaborate_surfaces fuel surfaces with
  | MkPair result _ => result
  end;

def decl_check_names : List Decl -> List Nat :=
  fix decl_check_names (decls : List Decl) : List Nat :=
    match decls with
    | Nil => Nil Nat
    | Cons decl rest =>
        let tail : List Nat := decl_check_names rest in
        match decl with
        | DDef name _ _ _ _ => Cons Nat name tail
        | DAxiom name _ => Cons Nat name tail
        | DIntrinsic name _ _ _ => Cons Nat name tail
        | DExtern name _ _ => Cons Nat name tail
        | DRepresentation _ _ => tail
        | DInductive name _ _ _ _ => Cons Nat name tail
        | DEffect _ _ ops => append Nat (rec_field_names ops) tail
        | DImport _ => tail
        end
    end;

def decls_have_effect : List Decl -> Bool :=
  fix decls_have_effect (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons decl rest =>
        match decl with
        | DEffect _ _ _ => True
        | DDef _ _ _ _ _ => decls_have_effect rest
        | DAxiom _ _ => decls_have_effect rest
        | DIntrinsic _ _ _ _ => decls_have_effect rest
        | DExtern _ _ _ => decls_have_effect rest
        | DRepresentation _ _ => decls_have_effect rest
        | DInductive _ _ _ _ _ => decls_have_effect rest
        | DImport _ => decls_have_effect rest
        end
    end;

def unit_decl_names : List SrcUnit -> Nat -> List Nat :=
  fix unit_decl_names (units : List SrcUnit) (root_id : Nat) : List Nat :=
  match units with
  | Nil => Nil Nat
  | Cons unit rest =>
      match unit with
      | MkSrcUnit path_id _ =>
          match eqNat path_id root_id with
          | True => decl_check_names (src_unit_decls unit)
          | False => unit_decl_names rest root_id
          end
      end
  end;

def checked_emitted_body (name : Nat) : List Entry -> Maybe CoreTerm :=
  fix find (entries : List Entry) : Maybe CoreTerm :=
    match entries with
    | Nil => Nothing CoreTerm
    | Cons entry rest =>
        match entry with
        | MkEntry current _ body =>
            match eqNat name current with
            | True => body
            | False => find rest
            end
        | MkIndEntry _ _ => find rest
        | MkBoundEntry _ _ _ => find rest
        | MkRoleEntry _ => find rest
        end
    end;

def checked_emitted_cores (checked : List Entry)
    : List (Pair Nat CoreTerm) -> CompResult (List (Pair Nat CoreTerm)) :=
  let environment : CheckEnvironment := check_environment_from_entries
    (filter Entry (fun (entry : Entry) => match entry with
      | MkEntry _ _ _ => True
      | MkIndEntry _ _ => False | MkBoundEntry _ _ _ => False | MkRoleEntry _ => False
      end) checked) in
  fix emit (cores : List (Pair Nat CoreTerm)) : CompResult (List (Pair Nat CoreTerm)) :=
    match cores with
    | Nil => COk(List (Pair Nat CoreTerm), Nil (Pair Nat CoreTerm))
    | Cons pair rest =>
        match pair with
        | MkPair name _ =>
            match check_environment_const name environment with
            | Nothing => CErr(List (Pair Nat CoreTerm), ErrCode 46 name)
            | Just body =>
                match emit rest with
                | CErr error => CErr(List (Pair Nat CoreTerm), error)
                | COk tail => COk (List (Pair Nat CoreTerm))
                    (Cons(Pair Nat CoreTerm, MkPair Nat CoreTerm name body, tail))
                end
            end
        end
    end;

inductive CheckedEmittedResult : Type :=
  | CheckedEmittedError : CompError -> CheckedEmittedResult
  | CheckedEmittedDeclarationError : List FileItem -> Nat -> CheckPhase -> CheckFailure -> CheckedEmittedResult
  | CheckedEmittedOk : CheckedProgram -> CheckedEmittedResult;

def checked_emitted_declaration_error (name : Nat) (phase : CheckPhase)
    (failure : CheckFailure) : CompError :=
  ErrCode (add 40 (declaration_failure_code CheckSourceCore phase failure)) name;

def checked_emitted_comp_result (result : CheckedEmittedResult) : CompResult CheckedProgram :=
  match result with
  | CheckedEmittedError error => CErr CheckedProgram error
  | CheckedEmittedDeclarationError _ name phase failure =>
      CErr CheckedProgram (checked_emitted_declaration_error name phase failure)
  | CheckedEmittedOk checked => COk CheckedProgram checked
  end;

private def check_emitted_plan_result
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (selected : List Nat) (fuel : Nat) (st : InternState)
  (cores : List (Pair Nat CoreTerm)) (plan : CheckPlan)
  : CheckedEmittedResult :=
    match plan with
    | CheckPlanErr detail =>
        CheckedEmittedError (ErrCode 46 detail)
    | CheckPlanOk items =>
        match resolve_literal_plan fuel st items with
        | CErr error => CheckedEmittedError error
        | COk resolved => match check_module fuel selected resolved with
        | DeclarationsOk checked =>
            match checked_emitted_cores checked cores with
            | CErr failure => CheckedEmittedError failure
            | COk emitted => CheckedEmittedOk (CheckedProgramOf st checked emitted)
            end
        | DeclarationsErr name phase failure =>
            CheckedEmittedDeclarationError resolved name phase failure
        end
        end
    end;

def check_emitted_decls_result
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (selected : List Nat) (fuel : Nat) (st : InternState) (env : LowerEnv) (decls : List Decl)
  (cores : List (Pair Nat CoreTerm))
  : CheckedEmittedResult :=
    check_emitted_plan_result check_module selected fuel st cores
      (build_check_plan lower_expr_env2 elaborate fuel env st decls cores);

def check_emitted_decls
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (selected : List Nat) (fuel : Nat) (st : InternState) (env : LowerEnv) (decls : List Decl)
  (cores : List (Pair Nat CoreTerm))
  : CompResult CheckedProgram :=
  checked_emitted_comp_result
    (check_emitted_decls_result check_module lower_expr_env2 elaborate
      selected fuel st env decls cores);

def source_checked_definition_units (name : Nat) (sources : List SourceDecl)
    (decls : List Decl) : List (Maybe Nat) :=
  (fix collect (rest : List Decl) (origins : List SourceDecl) : List (Maybe Nat) :=
    match rest with
    | Nil => []
    | Cons decl tail =>
        let slot : Pair (Maybe Nat) (List SourceDecl) := match origins with
          | Nil => MkPair (Maybe Nat) (List SourceDecl) (Nothing Nat) (Nil SourceDecl)
          | Cons original next => match original with | SourceDeclOf unit before =>
              MkPair (Maybe Nat) (List SourceDecl)
                (match source_decl_same_slot before decl with
                 | True => unit | False => Nothing Nat end) next
              end
          end in
        match slot with | MkPair unit next =>
          let remaining : List (Maybe Nat) := collect tail next in
          match decl with
          | DDef current _ _ _ _ => match eqNat current name with
              | False => remaining
              | True => Cons (Maybe Nat) unit remaining
              end
          | DAxiom _ _ => remaining | DInductive _ _ _ _ _ => remaining
          | DEffect _ _ _ => remaining | DImport _ => remaining
          | DIntrinsic _ _ _ _ => remaining | DExtern _ _ _ => remaining
          | DRepresentation _ _ => remaining
          end
        end
    end) decls sources;

def source_checked_definition_owner (items : List FileItem) (name : Nat)
    (sources : List SourceDecl) (decls : List Decl) : Maybe SourceFailureOwner :=
  match filter FileItem (fun (item : FileItem) => match item with
    | FDef current _ _ => eqNat current name
    | FAxiom current _ => eqNat current name
    | FInd declaration => match declaration with | MkIndDecl current _ _ _ _ => eqNat current name end
    | FIntrinsic current _ _ _ => eqNat current name
    | FExtern current _ _ => eqNat current name
    | FRepresentation current _ => eqNat current name
    end) items with
  | Nil => Nothing SourceFailureOwner
  | Cons item rest => match rest with
      | Cons _ _ => Nothing SourceFailureOwner
      | Nil => match item with
          | FDef _ _ _ => match source_checked_definition_units name sources decls with
              | Nil => Nothing SourceFailureOwner
              | Cons unit remaining => match remaining with
                  | Cons _ _ => Nothing SourceFailureOwner
                  | Nil => match unit with
                      | Nothing => Nothing SourceFailureOwner
                      | Just path => Just SourceFailureOwner
                          (SourceFailureOwnerOf (MkPair Nat CompileProgramPhase name CompileCorePhase)
                            (MkPair (Maybe Nat) (Maybe (Pair Nat Nat))
                              (Just Nat path) (Nothing (Pair Nat Nat))))
                      end
                  end
              end
          | FAxiom _ _ => Nothing SourceFailureOwner
          | FInd _ => Nothing SourceFailureOwner
          | FIntrinsic _ _ _ _ => Nothing SourceFailureOwner
          | FExtern _ _ _ => Nothing SourceFailureOwner
          | FRepresentation _ _ => Nothing SourceFailureOwner
          end
      end
  end;

def checked_emitted_source_result (sources : List SourceDecl) (decls : List Decl)
    (result : CheckedEmittedResult) : SourceResult CheckedProgram :=
  match result with
  | CheckedEmittedError error => SourceErr CheckedProgram (source_failure_unknown error)
  | CheckedEmittedOk checked => SourceOk CheckedProgram checked
  | CheckedEmittedDeclarationError items name phase failure =>
      let owner : Maybe SourceFailureOwner := match phase with
        | CheckDeclarationType => source_checked_definition_owner items name sources decls
        | CheckDeclarationBody => source_checked_definition_owner items name sources decls
        | CheckDeclarationPlan => Nothing SourceFailureOwner
        | CheckInductiveDeclaration => Nothing SourceFailureOwner
        end in
      SourceErr CheckedProgram
        (SourceFailureOf (checked_emitted_declaration_error name phase failure)
          (MkPair (Maybe SourceFailureOwner) (Maybe LowerRootCause)
            owner (Nothing LowerRootCause)))
  end;


def checked_emitted_packet_result (slots : List SourceModuleSlot) (sources : List SourceDecl)
    (decls : List Decl) (result : CheckedEmittedResult) : SourceResult CheckedSourcePacket :=
  match checked_emitted_source_result sources decls result with
  | SourceErr failure => SourceErr CheckedSourcePacket failure
  | SourceOk checked => SourceOk CheckedSourcePacket
      (CheckedSourcePacketOf checked
        (MkPair (List SourceModuleSlot) (List SourceCheckedOwner) slots
          (source_checked_owners slots sources decls (checked_program_entries checked))))
  end;

-- Declaration compilation receives a closed import graph. A remaining import
-- has no supplied unit and must not disappear during lowering or plan building.
def first_unresolved_import : List Decl -> Maybe Nat :=
  fix scan (decls : List Decl) : Maybe Nat :=
    match decls with
    | Nil => Nothing Nat
    | Cons decl rest => match decl with
      | DImport path => Just Nat path
      | DDef _ _ _ _ _ => scan rest | DAxiom _ _ => scan rest
      | DInductive _ _ _ _ _ => scan rest | DEffect _ _ _ => scan rest
      | DIntrinsic _ _ _ _ => scan rest | DExtern _ _ _ => scan rest
      | DRepresentation _ _ => scan rest end end;

def first_residual_open (left : Maybe Nat) (right : Maybe Nat)
    : Maybe Nat :=
  match left with
  | Just alias => Just Nat alias
  | Nothing => right
  end;

def first_residual_open_expr : Expr -> Maybe Nat :=
  fix go (expr : Expr) : Maybe Nat :=
    match expr with
    | EOpen alias _ => Just Nat alias
    | EVar _ => Nothing Nat
    | EHole _ => Nothing Nat
    | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat
    | ERange _ _ _ => Nothing Nat
    | EStr _ => Nothing Nat
    | ENoBranch => Nothing Nat
    | ENoBinder => Nothing Nat
    | EApp function argument =>
        first_residual_open (go function) (go argument)
    | ENamedCall function rows =>
        first_residual_open (go function)
          ((fix scan (items : List (Pair Nat Expr)) : Maybe Nat :=
            match items with
            | Nil => Nothing Nat
            | Cons row rest =>
                match row with
                | MkPair _ value =>
                    first_residual_open (go value) (scan rest)
                end
            end) rows)
    | ELam _ annotation body =>
        first_residual_open
          (match annotation with
           | Nothing => Nothing Nat
           | Just typ => go typ
           end) (go body)
    | EPi _ domain codomain =>
        first_residual_open (go domain) (go codomain)
    | ELet _ annotation value body =>
        first_residual_open
          (match annotation with
           | Nothing => Nothing Nat
           | Just typ => go typ
           end)
          (first_residual_open (go value) (go body))
    | EAscribe value typ =>
        first_residual_open (go value) (go typ)
    | EMatch scrutinee branches =>
        first_residual_open (go scrutinee) (go branches)
    | EIf condition yes no =>
        first_residual_open (go condition)
          (first_residual_open (go yes) (go no))
    | EIfLet _ subject yes no =>
        first_residual_open (go subject)
          (first_residual_open (go yes) (go no))
    | ECoalesce operand fallback =>
        first_residual_open (go operand) (go fallback)
    | EFix _ binders result body =>
        first_residual_open (go binders)
          (first_residual_open (go result) (go body))
    | EEffectRow typ _ => go typ
    | EPerform _ arguments =>
        (fix scan (items : List Expr) : Maybe Nat :=
          match items with
          | Nil => Nothing Nat
          | Cons item rest => first_residual_open (go item) (scan rest)
          end) arguments
    | EDo items =>
        (fix scan (pending : List Expr) : Maybe Nat :=
          match pending with
          | Nil => Nothing Nat
          | Cons item rest => first_residual_open (go item) (scan rest)
          end) items
    | EList items =>
        (fix scan (pending : List Expr) : Maybe Nat :=
          match pending with
          | Nil => Nothing Nat
          | Cons item rest => first_residual_open (go item) (scan rest)
          end) items
    | EListSpread items tail =>
        first_residual_open
          ((fix scan (pending : List Expr) : Maybe Nat :=
            match pending with
            | Nil => Nothing Nat
            | Cons item rest => first_residual_open (go item) (scan rest)
            end) items)
          (go tail)
    | EHandle computation clauses =>
        first_residual_open (go computation)
          ((fix scan (pending : List (Pair Nat (Pair (List Nat) Expr)))
              : Maybe Nat :=
            match pending with
            | Nil => Nothing Nat
            | Cons clause rest => match clause with
              | MkPair _ payload => match payload with
                | MkPair _ body => first_residual_open (go body) (scan rest)
                end
              end
            end) clauses)
    | EBranch _ body rest =>
        first_residual_open (go body) (go rest)
    | EBinder _ typ rest =>
        first_residual_open (go typ) (go rest)
    | EMultiMatch scrutinees rows =>
        first_residual_open
          ((fix scan (pending : List Expr) : Maybe Nat :=
            match pending with
            | Nil => Nothing Nat
            | Cons item rest => first_residual_open (go item) (scan rest)
            end) scrutinees)
          ((fix scan (pending : List (Pair (List (Pair Nat (List Nat))) Expr))
              : Maybe Nat :=
            match pending with
            | Nil => Nothing Nat
            | Cons row rest => match row with
              | MkPair _ body => first_residual_open (go body) (scan rest)
              end
            end) rows)
    | EDoBind _ action => go action
    | ESpan _ _ inner => go inner
    | EFallible container _ _ body =>
        first_residual_open (go container) (go body)
    end;

def first_residual_open_fields : List (Pair Nat Expr) -> Maybe Nat :=
  fix scan (fields : List (Pair Nat Expr)) : Maybe Nat :=
    match fields with
    | Nil => Nothing Nat
    | Cons field rest => match field with
      | MkPair _ typ =>
          first_residual_open (first_residual_open_expr typ) (scan rest)
      end
    end;

def first_residual_open_decls : List Decl -> Maybe Nat :=
  fix scan (decls : List Decl) : Maybe Nat :=
    match decls with
    | Nil => Nothing Nat
    | Cons decl rest =>
        let here : Maybe Nat := match decl with
          | DDef _ typ body _ _ =>
              first_residual_open (first_residual_open_expr typ)
                (first_residual_open_expr body)
          | DAxiom _ typ => first_residual_open_expr typ
          | DInductive _ params family constructors _ =>
              first_residual_open (first_residual_open_fields params)
                (first_residual_open (first_residual_open_expr family)
                  (first_residual_open_fields constructors))
          | DEffect _ params operations =>
              first_residual_open (first_residual_open_fields params)
                (first_residual_open_fields operations)
          | DIntrinsic _ typ _ implementation =>
              first_residual_open (first_residual_open_expr typ)
                (match implementation with
                 | Nothing => Nothing Nat
                 | Just body => first_residual_open_expr body
                 end)
          | DExtern _ typ _ => first_residual_open_expr typ
          | DImport _ => Nothing Nat
          | DRepresentation _ _ => Nothing Nat
          end in
        first_residual_open here (scan rest)
    end;

-- Canonical stitch: desugar matches, collect env, lower, rewrite dummy
-- anns, compile_program, fuel32 fallback to elaborate_surfaces, then check the
-- ordered declaration plan against the exact emitted bodies.
def lowered_root_cause (lowered : LoweredSurface) : Maybe LowerRootCause :=
  match lowered with | LoweredSurfaceOf surface cause => match surface with
    | SHole name => match cause with
        | Nothing => Nothing LowerRootCause
        | Just root => match root with
          | LowerRootList _ => match eqNat name Z with
              | True => cause | False => Nothing LowerRootCause end
          | LowerRootNamedHole expected => match andb(eqNat name expected, notb(eqNat name Z)) with
              | True => cause | False => Nothing LowerRootCause end
          end
        end
    | SVar _ => Nothing LowerRootCause
    | SSort _ => Nothing LowerRootCause
    | SPi _ _ _ => Nothing LowerRootCause
    | SLam _ _ _ => Nothing LowerRootCause
    | SApp _ _ => Nothing LowerRootCause
    | SLet _ _ _ _ => Nothing LowerRootCause
    | SConst _ => Nothing LowerRootCause
    | SInd _ => Nothing LowerRootCause
    | SConstruct _ _ _ => Nothing LowerRootCause
    | SCase _ _ _ _ => Nothing LowerRootCause
    | SFix _ _ _ _ _ => Nothing LowerRootCause
    | SEffectRow _ => Nothing LowerRootCause
    | SPerform _ _ => Nothing LowerRootCause
    | SStr _ _ => Nothing LowerRootCause
    end end;

private def source_program_failure_from
    (A : Type) (select_decl : A -> LoweredDecl) (decls : List A)
    (location : CompileProgramLocation) (error : CompError) : SourceFailure :=
  match location with | CompileProgramLocationOf owner ordinal =>
    let selected : Maybe LoweredDecl :=
      (fix at (rest : List A) (index : Nat) : Maybe LoweredDecl :=
        match rest with
        | Nil => Nothing LoweredDecl
        | Cons decl tail => match index with
          | Z => Just LoweredDecl (select_decl decl)
          | S previous => at tail previous
          end
        end) decls ordinal in
    let info : Pair (Maybe Nat) (Maybe LowerRootCause) := match selected with
      | Nothing => MkPair (Maybe Nat) (Maybe LowerRootCause)
          (Nothing Nat) (Nothing LowerRootCause)
      | Just decl => match decl with | LoweredDeclOf actual payload => match owner with
          | MkPair expected phase => match eqNat actual expected with
            | False => MkPair (Maybe Nat) (Maybe LowerRootCause)
                (Nothing Nat) (Nothing LowerRootCause)
            | True => match payload with | MkPair unit lowered =>
                MkPair (Maybe Nat) (Maybe LowerRootCause) unit
                  (match phase with
                   | CompileSurfacePhase => match error with | ErrCode code detail =>
                       match andb(eqNat code 2, eqNat detail 0) with
                       | True => lowered_root_cause lowered | False => Nothing LowerRootCause end
                       end
                   | CompileFutureSlotPhase => Nothing LowerRootCause
                   | CompileDuplicatePhase => Nothing LowerRootCause
                   | CompileFutureGlobalPhase => Nothing LowerRootCause
                   | CompileCorePhase => Nothing LowerRootCause
                   end)
                end
            end
          end end
      end in
    match info with | MkPair unit cause =>
      SourceFailureOf error
        (MkPair (Maybe SourceFailureOwner) (Maybe LowerRootCause)
          (Just SourceFailureOwner (SourceFailureOwnerOf owner
            (MkPair (Maybe Nat) (Maybe (Pair Nat Nat)) unit (Nothing (Pair Nat Nat))))) cause)
    end
  end;

def source_program_failure (decls : List LoweredDecl)
    (location : CompileProgramLocation) (error : CompError) : SourceFailure :=
  source_program_failure_from LoweredDecl (fun (decl : LoweredDecl) => decl) decls location error;

def program_result_with_location (result : CompileProgramLocatedResult)
    : Pair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation) :=
  match result with
  | CompileProgramLocatedErr location error =>
      MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
        (CErr (List (Pair Nat CoreTerm)) error) (Just CompileProgramLocation location)
  | CompileProgramLocatedOk cores =>
      MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
        (COk (List (Pair Nat CoreTerm)) cores) (Nothing CompileProgramLocation)
  end;

inductive SourceDiagnostic : Type :=
  | SourceDiagnosticOf : Pair Nat CompileProgramPhase ->
      Pair (Maybe Nat) (Maybe LowerRootCause) -> SourceDiagnostic;

-- @export source_failure_diagnostic; @doc docs/tcb.md
def source_failure_diagnostic (failure : SourceFailure) : Maybe SourceDiagnostic :=
  match failure with | SourceFailureOf _error metadata => match metadata with
    | MkPair owner cause => match owner with
      | Nothing => Nothing SourceDiagnostic
      | Just located => match located with | SourceFailureOwnerOf declaration origin =>
          match origin with | MkPair unit _span =>
            Just SourceDiagnostic (SourceDiagnosticOf declaration
              (MkPair (Maybe Nat) (Maybe LowerRootCause) unit cause))
          end end
      end
    end end;

-- This is the common acceptance path; compatibility adapters erase metadata.
def compile_checked_decls_with_result
  (A : Type)
  (finish : List SourceDecl -> List Decl -> CheckedEmittedResult -> SourceResult A)
  (desugar_file : List Decl -> List Decl)
  (rewrite_declarations : Nat -> LowerEnv -> List Decl -> List Decl)
  (lower_expr : LowerEnv -> Maybe Surface -> Expr -> LoweredSurface)
  (compile_program : List (Pair Nat Surface) ->
    Pair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation))
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (selected : List Nat) (fuel : Nat) (st : InternState) (sources : List SourceDecl)
  : SourceResult A :=
  let ds : List Decl := source_decl_values sources in
  let lower_value (env : LowerEnv) (expected : Maybe Surface) (expr : Expr) : Surface :=
    lowered_surface_value (lower_expr env expected expr) in
  match first_unresolved_import ds with
  | Just path => SourceErr A (source_failure_unknown (ErrCode 92 path))
  | Nothing => match first_residual_open_decls ds with
    | Just alias => SourceErr A (source_failure_unknown (ErrCode 98 alias))
    | Nothing =>
        let ds1 : List Decl := desugar_file ds in
        let base_env : LowerEnv := collect_lower_env_from st ds1 in
        let ds2 : List Decl := rewrite_declarations fuel base_env ds1 in
        let env : LowerEnv := populate_io_payloads lower_value base_env ds2 in
        -- The body needs the raw annotation. The plan rewrites it before elaboration.
        let prepared : List (Pair LoweredDecl Surface) :=
          lower_definitions (Pair LoweredDecl Surface)
            (fun (name : Nat) (unit : Maybe Nat) (annotation : Surface) (body : LoweredSurface) =>
              MkPair LoweredDecl Surface
                (LoweredDeclOf name (MkPair (Maybe Nat) LoweredSurface unit (rewrite_lowered_surface body)))
                annotation)
            lower_expr env sources ds2 in
        let surfaces : List (Pair Nat Surface) :=
          map (Pair LoweredDecl Surface) (Pair Nat Surface)
            (fun (row : Pair LoweredDecl Surface) =>
              lowered_decl_surface (prepared_definition_body row))
            prepared in
        match compile_surfaces_with_location compile_program elaborate_surfaces fuel surfaces with
        | MkPair result owner => match result with
          | CErr error => SourceErr A
              (match owner with
               | Nothing => source_failure_unknown error
               | Just location =>
                   source_program_failure_from (Pair LoweredDecl Surface) prepared_definition_body
                     prepared location error
               end)
          | COk cores =>
              let annotations : List (Pair Nat Surface) :=
                map (Pair LoweredDecl Surface) (Pair Nat Surface)
                  (fun (row : Pair LoweredDecl Surface) =>
                    let (MkPair lowered annotation) := row in
                    let (LoweredDeclOf name _payload) := lowered in
                    MkPair Nat Surface name annotation)
                  prepared in
              finish sources ds2
                (check_emitted_plan_result check_module selected fuel st cores
                  (build_check_plan_with_annotations lower_value elaborate fuel env st ds2 cores
                    (Just (List (Pair Nat Surface)) annotations)))
          end
        end
    end
  end;

def compile_checked_decls_with_source_packet
  (desugar_file : List Decl -> List Decl)
  (rewrite_declarations : Nat -> LowerEnv -> List Decl -> List Decl)
  (lower_expr : LowerEnv -> Maybe Surface -> Expr -> LoweredSurface)
  (compile_program : List (Pair Nat Surface) ->
    Pair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation))
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (slots : List SourceModuleSlot) (selected : List Nat) (fuel : Nat) (st : InternState) (sources : List SourceDecl)
  : SourceResult CheckedSourcePacket :=
  compile_checked_decls_with_result CheckedSourcePacket (checked_emitted_packet_result slots)
    desugar_file rewrite_declarations lower_expr compile_program elaborate_surfaces elaborate
    check_module selected fuel st sources;

def compile_checked_decls_with_metadata
  (desugar_file : List Decl -> List Decl)
  (rewrite_declarations : Nat -> LowerEnv -> List Decl -> List Decl)
  (lower_expr : LowerEnv -> Maybe Surface -> Expr -> LoweredSurface)
  (compile_program : List (Pair Nat Surface) ->
    Pair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation))
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (selected : List Nat) (fuel : Nat) (st : InternState) (sources : List SourceDecl)
  : SourceResult CheckedProgram :=
  compile_checked_decls_with_result CheckedProgram checked_emitted_source_result
    desugar_file rewrite_declarations lower_expr compile_program elaborate_surfaces elaborate
    check_module selected fuel st sources;

def compile_checked_from_decls_with_source_packet
  (desugar_file : List Decl -> List Decl)
  (rewrite_declarations : Nat -> LowerEnv -> List Decl -> List Decl)
  (lower_expr : LowerEnv -> Maybe Surface -> Expr -> LoweredSurface)
  (compile_program : List (Pair Nat Surface) -> CompileProgramLocatedResult)
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (slots : List SourceModuleSlot) (selected : List Nat) (fuel : Nat) (st : InternState) (sources : List SourceDecl)
  : SourceResult CheckedSourcePacket :=
  compile_checked_decls_with_source_packet desugar_file rewrite_declarations lower_expr
    (fun (items : List (Pair Nat Surface)) => program_result_with_location (compile_program items))
    elaborate_surfaces elaborate check_module slots selected fuel st sources;

-- @export compile_checked_from_decls_with_origin; @doc docs/tcb.md
def compile_checked_from_decls_with_origin
  (desugar_file : List Decl -> List Decl)
  (rewrite_declarations : Nat -> LowerEnv -> List Decl -> List Decl)
  (lower_expr : LowerEnv -> Maybe Surface -> Expr -> LoweredSurface)
  (compile_program : List (Pair Nat Surface) -> CompileProgramLocatedResult)
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (selected : List Nat) (fuel : Nat) (st : InternState) (sources : List SourceDecl)
  : SourceResult CheckedProgram :=
  compile_checked_decls_with_metadata desugar_file rewrite_declarations lower_expr
    (fun (items : List (Pair Nat Surface)) => program_result_with_location (compile_program items))
    elaborate_surfaces elaborate check_module selected fuel st sources;

def compile_checked_from_decls
  (desugar_file : List Decl -> List Decl)
  (rewrite_declarations : Nat -> LowerEnv -> List Decl -> List Decl)
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (compile_program : List (Pair Nat Surface) -> CompResult (List (Pair Nat CoreTerm)))
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (selected : List Nat) (fuel : Nat) (st : InternState) (ds : List Decl)
  : CompResult CheckedProgram :=
  source_result_comp CheckedProgram
    (compile_checked_decls_with_metadata desugar_file rewrite_declarations
      (fun (env : LowerEnv) (expected : Maybe Surface) (expr : Expr) =>
        LoweredSurfaceOf (lower_expr_env2 env expected expr) (Nothing LowerRootCause))
      (fun (items : List (Pair Nat Surface)) =>
        MkPair (CompResult (List (Pair Nat CoreTerm))) (Maybe CompileProgramLocation)
          (compile_program items) (Nothing CompileProgramLocation))
      elaborate_surfaces elaborate check_module selected fuel st (source_decls_without_unit ds));

def compile_from_decls
  (desugar_file : List Decl -> List Decl)
  (rewrite_declarations : Nat -> LowerEnv -> List Decl -> List Decl)
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (compile_program : List (Pair Nat Surface) -> CompResult (List (Pair Nat CoreTerm)))
  (elaborate_surfaces : Nat -> List (Pair Nat Surface) -> List (Pair Nat CoreTerm))
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (check_module : Nat -> List Nat -> List FileItem -> DeclarationResult)
  (selected : List Nat) (fuel : Nat) (st : InternState) (ds : List Decl)
  : CompResult (List (Pair Nat CoreTerm)) :=
    checked_program_erase
      (compile_checked_from_decls desugar_file rewrite_declarations lower_expr_env2
        compile_program elaborate_surfaces elaborate check_module selected fuel st ds);

def name_of_id (st : InternState) (id : Nat) : List Nat :=
  match st with
  | MkIntern ids _next _strs _nextStr =>
      (fix go (xs : List (Pair (List Nat) Nat)) : List Nat :=
          match xs with
          | Nil => Nil Nat
          | Cons p xs' =>
              match p with
              | MkPair s i =>
                  match eqNat i id with
                  | True => s
                  | False => go xs'
                  end
              end
          end) ids
  end;

def str_of_id (st : InternState) (id : Nat) : List Nat :=
  match st with
  | MkIntern _ids _next strs _nextStr =>
      (fix go (xs : List (Pair (List Nat) Nat)) : List Nat :=
          match xs with
          | Nil => Nil Nat
          | Cons p xs' =>
              match p with
              | MkPair s i =>
                  match eqNat i id with
                  | True => s
                  | False => go xs'
                  end
              end
          end) strs
  end;

def canon_imports_with (State : Type) (base : List Nat)
    (intern_string : State -> List Nat -> Pair Nat State) (intern_state : State -> InternState)
    (initial : State) (decls : List Decl) : Pair (List Decl) State :=
  canonicalize_import_declarations State base intern_string
    (fun (state : State) (id : Nat) => str_of_id (intern_state state) id)
    initial decls;

def canon_imports (base : List Nat)
    (intern_string : InternState -> List Nat -> Pair Nat InternState)
    (initial : InternState) (decls : List Decl) : Pair (List Decl) InternState :=
  canon_imports_with InternState base intern_string (fun (st : InternState) => st) initial decls;
