-- Lowering builds kernel-facing surface terms; rewrite-only normalization stays in lower_rewrite to keep this cone small.

-- @entry lower_expr
-- @entry lower_expr_env
-- @entry lower_expr_env2

import "lower_support.ouro",
  "lower_fallible.ouro",
  "lower_spread.ouro",
  "lower_implicit.ouro",
  "lower_implicit_function.ouro",
  "../std/types.ouro",
  "pipeline_abi.ouro",
  "lower_env.ouro";

-- @bound(cyclo <= 94)
def lower_xvvar
  (_lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (_fuel' : Nat)
  (env : LowerEnv)
  (_er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (n : Nat) : LowerVal :=
    match lower_implicit_constructor _lower_run _fuel' env _er fixSelf locals
        (EVar n) with
    | InferredCtor term => VSurf term
    | NoMarkedCtor =>
        match lower_implicit_function _lower_run _fuel' env _er fixSelf locals
            (EVar n) with
        | InferredDef term => VSurf term
        | NoMarkedDef => VSurf (resolve_var_fix env fixSelf locals n)
        | MarkedDefWithoutHint => VSurf (resolve_var_fix env fixSelf locals n)
        end
    | MarkedCtorWithoutHint => VSurf (resolve_var_fix env fixSelf locals n)
    end;

def lower_xvhole
  (_lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (_fuel' : Nat)
  (_env : LowerEnv)
  (_er : Maybe Surface)
  (_fixSelf : Maybe Nat)
  (_locals : List (Pair Nat Surface))
  (m : Maybe Nat) : LowerVal :=
VSurf (hole_of_maybe m);

def lower_xvsort
  (_lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (_fuel' : Nat)
  (_env : LowerEnv)
  (_er : Maybe Surface)
  (_fixSelf : Maybe Nat)
  (_locals : List (Pair Nat Surface))
  (u : Nat) : LowerVal :=
VSurf (SSort u);

def lower_xvnat
  (_lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (_fuel' : Nat)
  (env : LowerEnv)
  (_er : Maybe Surface)
  (_fixSelf : Maybe Nat)
  (_locals : List (Pair Nat Surface))
  (n : Nat) : LowerVal :=
VSurf (lower_nat_env env n);

def lower_xvrange (env : LowerEnv) (start : Nat) (stop : Nat)
    (inclusive : Bool) : LowerVal :=
    let nat_id : Nat := env_natRoleId env in
    let bound_id : Nat := env_rangeBoundId env in
    let range_id : Nat := env_rangeId env in
    let identified : Bool :=
      andb (notb (eqNat nat_id 0))
        (andb (notb (eqNat bound_id 0))
          (andb (notb (eqNat range_id 0))
            (andb (notb (eqNat nat_id bound_id))
              (andb (notb (eqNat nat_id range_id))
                (notb (eqNat bound_id range_id)))))) in
    let nat_shape : Bool :=
      andb (eqNat (count_ctors_ind nat_id (env_ctors env)) 2)
        (andb (eqNat (arity_at nat_id 0 (env_ctors env)) 0)
          (andb (eqNat (arity_at nat_id 1 (env_ctors env)) 1)
            (eqNat (nparams_of_ind nat_id (env_ctors env)) 0))) in
    let bound_shape : Bool :=
      andb (eqNat (count_ctors_ind bound_id (env_ctors env)) 2)
        (andb (eqNat (arity_at bound_id 0 (env_ctors env)) 0)
          (andb (eqNat (arity_at bound_id 1 (env_ctors env)) 0)
            (eqNat (nparams_of_ind bound_id (env_ctors env)) 0))) in
    let range_shape : Bool :=
      andb (eqNat (count_ctors_ind range_id (env_ctors env)) 1)
        (andb (eqNat (arity_at range_id 0 (env_ctors env)) 4)
          (eqNat (nparams_of_ind range_id (env_ctors env)) 0)) in
    let valid : Bool := andb identified (andb nat_shape (andb bound_shape range_shape)) in
    match valid with
    | False => VSurf (SConst Z)
    | True =>
        let numeral : Nat -> Surface :=
          fix numeral (n : Nat) : Surface :=
            match n with
            | Z => SConstruct nat_id 0 0
            | S previous => SApp (SConstruct nat_id 1 0) (numeral previous)
            end in
        let bound : Surface := match inclusive with
          | False => SConstruct bound_id 0 0
          | True => SConstruct bound_id 1 0
          end in
        VSurf (SApp (SApp (SApp (SApp (SConstruct range_id 0 0)
          (numeral start)) (numeral stop)) (numeral 1)) bound)
    end;

def lower_xvstr
  (_lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (_fuel' : Nat)
  (env : LowerEnv)
  (_er : Maybe Surface)
  (_fixSelf : Maybe Nat)
  (_locals : List (Pair Nat Surface))
  (n : Nat) : LowerVal :=
VSurf (SStr(n, env_stringTyId env));

def lower_xvlist
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (elems : List Expr) : LowerVal :=
    let build (elemTy : Surface) (xs : List Expr) : Surface :=
      (fix go (rest : List Expr) : Surface :=
          match rest with
          | Nil => list_nil_surface env elemTy
          | Cons x tail =>
              let head : Surface :=
                vsurf_or_hole
                  (lower_run fuel' env (Just Surface elemTy) fixSelf locals (LExpr x)) in
              list_cons_surface env elemTy head (go tail)
          end) xs in
    match er with
    | Nothing =>
        match elems with
        | Nil => VSurf hole0
        | Cons first rest =>
            let head : Surface :=
              vsurf_or_hole
                (lower_run fuel' env (Nothing Surface) fixSelf locals (LExpr first)) in
            match surface_type_hint env locals fuel1k head with
            | Nothing => VSurf hole0
            | Just elemTy =>
                match surface_hint_has_placeholder locals fuel1k elemTy with
                | True => VSurf hole0
                | False =>
                    VSurf (list_cons_surface env elemTy head (build elemTy rest))
                end
            end
        end
    | Just listTy =>
        match peel_list_elem env listTy with
        | Nothing => VSurf hole0
        | Just elemTy => VSurf (build elemTy elems)
        end
    end;

def lower_xvapp
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (f : Expr)
  (a : Expr) : LowerVal :=
    let ordinary_app (function_expected : Maybe Surface) : LowerVal :=
      let function : Surface :=
        vsurf_or_hole
          (lower_run fuel' env function_expected fixSelf locals (LExpr f)) in
      let argument : Surface :=
        vsurf_or_hole
          (lower_run fuel' env (surface_argument_expected env locals function)
            fixSelf locals (LExpr a)) in
      VSurf (SApp function argument) in
    match lower_implicit_constructor lower_run fuel' env er fixSelf locals
        (EApp f a) with
    | InferredCtor term => VSurf term
    | NoMarkedCtor =>
        match lower_implicit_function lower_run fuel' env er fixSelf locals
            (EApp f a) with
        | InferredDef term => VSurf term
        | NoMarkedDef => ordinary_app (app_function_expected f er)
        | MarkedDefWithoutHint => ordinary_app (Nothing Surface)
        end
    | MarkedCtorWithoutHint => ordinary_app (Nothing Surface)
    end;

def lower_xvlam
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (name : Nat)
  (ann : Maybe Expr)
  (body : Expr) : LowerVal :=
    let annE : Expr := from_maybe_expr ann in
    let expectedDomain : Maybe Surface :=
      match ann with
      | Nothing => lambda_domain_hint locals er
      | Just _ => Nothing Surface
      end in
    let annS : Surface :=
      match ann with
      | Nothing =>
          match expectedDomain with
          | Nothing => SInd Z
          | Just domain => domain
          end
      | Just _ =>
          vsurf_or_hole
            (lower_run fuel' env er fixSelf locals (LExpr annE))
      end in
    let locals' : List (Pair Nat Surface) :=
      cons_local name annS locals in
    let erBody : Maybe Surface :=
      match ann with
      | Just _ => peel_er_lam er
      | Nothing =>
          match expectedDomain with
          | Nothing => peel_er_lam er
          | Just _ => lambda_body_expected er name
          end
      end in
    let bodyS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env erBody fixSelf locals' (LExpr body)) in
    VSurf (SLam name annS bodyS);

def lower_xvpi
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (name : Nat)
  (dom : Expr)
  (cod : Expr) : LowerVal :=
    let domS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env er fixSelf locals (LExpr dom)) in
    let locals' : List (Pair Nat Surface) :=
      cons_local name domS locals in
    let codS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env er fixSelf locals' (LExpr cod)) in
    VSurf (SPi name domS codS);

def lower_xvlet
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (name : Nat)
  (ann : Maybe Expr)
  (val : Expr)
  (body : Expr) : LowerVal :=
    let annE : Expr := from_maybe_expr ann in
    let tyS : Surface :=
      match ann with
      | Nothing => SInd Z
      | Just _ =>
          vsurf_or_hole
            (lower_run fuel' env er fixSelf locals (LExpr annE))
      end in
    -- The let value uses its annotation, not the enclosing result type.
    let erVal : Maybe Surface :=
      match ann with
      | Nothing => Nothing Surface
      | Just _ => Just Surface tyS
      end in
    let valS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env erVal fixSelf locals (LExpr val)) in
    let localTy : Surface :=
      match ann with
      | Just _ => tyS
      | Nothing =>
          match surface_type_hint env locals fuel1k valS with
          | Nothing => tyS
          | Just hint =>
              match surface_hint_has_placeholder locals fuel1k hint with
              | True => tyS
              | False => hint
              end
          end
      end in
    let locals' : List (Pair Nat Surface) :=
      cons_local name localTy locals in
    let bodyS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env er fixSelf locals' (LExpr body)) in
    VSurf (SLet name valS tyS bodyS);

def lower_xvascribe
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (tm : Expr)
  (ty : Expr) : LowerVal :=
    let tyS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env er fixSelf locals (LExpr ty)) in
    lower_run fuel' env (Just Surface tyS) fixSelf locals (LExpr tm);

def lower_xvmatch
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (scrut : Expr)
  (branches : Expr) : LowerVal :=
    let keys : List (Pair Nat Surface) :=
      scan_branch_keys env branches in
    match prepare_match env scrut locals keys with
    | NoMatchSetup =>
        lower_run fuel' env er fixSelf locals (LExpr scrut)
    | ReadyMatch indId nparams params family =>
        let scrutS : Surface :=
          vsurf_or_hole
            (lower_run fuel' env er fixSelf locals (LExpr scrut)) in
        let pairs : List (Pair Nat Surface) :=
          vbranches_or_nil
            (lower_run fuel' env er fixSelf locals
              (LBranch params family branches)) in
        VSurf
          (finish_match env er scrutS
            (ReadyMatch indId nparams params family) pairs)
    end;

def lower_xvfix
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (name : Nat)
  (binders : Expr)
  (ret : Expr)
  (body : Expr) : LowerVal :=
    let bl : List (Pair Nat Surface) :=
      vbinders_or_nil
        (lower_run fuel' env er fixSelf locals (LBinders binders)) in
    let localsB : List (Pair Nat Surface) :=
      extend_locals bl locals in
    let retS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env er fixSelf localsB (LExpr ret)) in
    let ty : Surface := fold_pi bl retS in
    let localsF : List (Pair Nat Surface) :=
      cons_local name ty localsB in
    let bodyS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env (Just Surface retS) (Just Nat name)
          localsF (LExpr body)) in
    let bodyL : Surface := fold_lam bl bodyS in
    let arity : Nat := length(Pair Nat Surface, bl) in
    let recArg : Nat := first_nonsort_at bl Z in
    VSurf (SFix name recArg arity ty bodyL);

def lower_xveffectrow
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (ty : Expr)
  (_ops : List Nat) : LowerVal :=
    let tyS : Surface :=
      vsurf_or_hole
        (lower_run fuel' env er fixSelf locals (LExpr ty)) in
    VSurf (SEffectRow tyS);

def lower_xvperform
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (op : Nat)
  (args : List Expr) : LowerVal :=
    let xs : List Surface :=
      vlist_or_nil
        (lower_run fuel' env er fixSelf locals (LArgs args)) in
    VSurf (SPerform op xs);

def lower_xvhandle
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (comp : Expr)
  (clauses : List (Pair Nat (Pair (List Nat) Expr))) : LowerVal :=
    match pure_only_handler_clause env clauses with
    | Nothing => VSurf hole0
    | Just p =>
        match p with
        | MkPair binder body =>
            let tyS : Surface :=
              match er with
              | Just ty => ty
              | Nothing => sort0
              end in
            let compS : Surface :=
              vsurf_or_hole
                (lower_run fuel' env (Just Surface tyS) fixSelf locals
                  (LExpr comp)) in
            let locals' : List (Pair Nat Surface) :=
              cons_local binder tyS locals in
            let bodyS : Surface :=
              vsurf_or_hole
                (lower_run fuel' env er fixSelf locals' (LExpr body)) in
            VSurf (SLet binder compS tyS bodyS)
        end
    end;

def lower_xvdo
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (stmts : List Expr) : LowerVal :=
    VSurf
      ((fix go (xs : List Expr) (localsGo : List (Pair Nat Surface)) : Surface :=
          match xs with
          | Nil => hole0
          | Cons e rest =>
              match peel_do_bind e with
              | MkPair mname action =>
                  match rest with
                  | Nil =>
                      vsurf_or_hole
                        (lower_run fuel' env er fixSelf localsGo (LExpr action))
                  | Cons _ _ =>
                      let action_surface : Surface :=
                        vsurf_or_hole
                          (lower_run fuel' env (Nothing Surface) fixSelf localsGo
                            (LExpr action)) in
                      let aTy : Surface :=
                        match surface_io_payload_hint env localsGo action_surface with
                        | Just payload => payload
                        | Nothing => unit_surface env
                        end in
                      let maTy : Surface := io_surface env aTy in
                      let ma : Surface :=
                        vsurf_or_hole
                          (lower_run fuel' env (Just Surface maTy) fixSelf localsGo (LExpr action)) in
                      let name : Nat :=
                        match mname with
                        | Just n => n
                        | Nothing => Z
                        end in
                      let localsTail : List (Pair Nat Surface) :=
                        match mname with
                        | Just n => cons_local n aTy localsGo
                        | Nothing => localsGo
                        end in
                      let tail : Surface := go rest localsTail in
                      let bTy : Surface :=
                        match er with
                        | Just _ => expected_io_payload_or_unit env er
                        | Nothing =>
                            match surface_io_payload_hint env localsTail tail with
                            | Just payload => payload
                            | Nothing => unit_surface env
                            end
                        end in
                      let k : Surface := SLam name aTy tail in
                      apply_io_bind_surface env aTy bTy ma k
                  end
              end
          end) stmts locals);

def lower_xvunsupported
  (_lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (_fuel' : Nat)
  (_env : LowerEnv)
  (_er : Maybe Surface)
  (_fixSelf : Maybe Nat)
  (_locals : List (Pair Nat Surface)) : LowerVal :=
VSurf hole0;

def lower_lbranch
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel' : Nat)
  (env : LowerEnv)
  (er : Maybe Surface)
  (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface))
  (params : List Surface)
  (family : Surface)
  (br : Expr) : LowerVal :=
    match view_branch br with
    | BranchEnd => VBranchPairs (Nil (Pair Nat Surface))
    | BranchNode packed body rest =>
        match peel_branch_pack env packed with
        | MkPair ctorOpt pvars =>
            let bps : List (Pair Nat Surface) :=
              branch_binder_pairs pvars params family in
            let locals' : List (Pair Nat Surface) :=
              extend_locals bps locals in
            let bodyS : Surface :=
              vsurf_or_hole
                (lower_run fuel' env er fixSelf locals' (LExpr body)) in
            let restPs : List (Pair Nat Surface) :=
              vbranches_or_nil
                (lower_run fuel' env er fixSelf locals
                  (LBranch params family rest)) in
            let key : Nat :=
              match ctorOpt with
              | Just cid => cid
              | Nothing => length Nat pvars
              end in
            let one : Pair Nat Surface :=
              MkPair Nat Surface key
                (match ctorOpt with
                 | Nothing => wrap_lams_branch pvars bodyS params family
                 | Just cid =>
                     match lookup_ctor(cid, env_ctors env) with
                     | Nothing => hole0
                     | Just ctor =>
                         match eqNat(length Nat pvars, ctor_arity ctor) with
                         | False => hole0
                         | True => wrap_lams_branch pvars bodyS params family
                         end
                     end
                 end) in
            VBranchPairs (Cons (Pair Nat Surface) one restPs)
        end
    end;

def lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat -> List (Pair Nat Surface) -> LowerMode -> LowerVal :=
  fix lower_run (fuel : Nat) (env : LowerEnv) (er : Maybe Surface) (fixSelf : Maybe Nat) (locals : List (Pair Nat Surface)) (mode : LowerMode) : LowerVal :=
    match fuel with
    | Z => empty_lower mode
    | S fuel' =>
        let recur (_requested : Nat) (next_env : LowerEnv) (next_er : Maybe Surface)
              (next_self : Maybe Nat) (next_locals : List (Pair Nat Surface)) (next_mode : LowerMode) : LowerVal :=
            lower_run fuel' next_env next_er next_self next_locals next_mode in
        match mode with
        | LExpr expr =>
            match view_expr expr with
            | XVVar n => lower_xvvar recur fuel' env er fixSelf locals n
            | XVHole m => lower_xvhole recur fuel' env er fixSelf locals m
            | XVSort u => lower_xvsort recur fuel' env er fixSelf locals u
            | XVNat n => lower_xvnat recur fuel' env er fixSelf locals n
            | XVRange start stop inclusive => lower_xvrange env start stop inclusive
            | XVStr n => lower_xvstr recur fuel' env er fixSelf locals n
            | XVList elems => lower_xvlist recur fuel' env er fixSelf locals elems
            | XVListSpread elems tail =>
                lower_xvlistspread recur fuel' env er fixSelf locals elems tail
            | XVApp f a => lower_xvapp recur fuel' env er fixSelf locals f a
            | XVLam name ann body => lower_xvlam recur fuel' env er fixSelf locals name ann body
            | XVPi name dom cod => lower_xvpi recur fuel' env er fixSelf locals name dom cod
            | XVLet name ann val body => lower_xvlet recur fuel' env er fixSelf locals name ann val body
            | XVAscribe tm ty => lower_xvascribe recur fuel' env er fixSelf locals tm ty
            | XVMatch scrut branches => lower_xvmatch recur fuel' env er fixSelf locals scrut branches
            | XVFix name binders ret body => lower_xvfix recur fuel' env er fixSelf locals name binders ret body
            | XVEffectRow ty ops => lower_xveffectrow recur fuel' env er fixSelf locals ty ops
            | XVPerform op args => lower_xvperform recur fuel' env er fixSelf locals op args
            | XVHandle comp clauses => lower_xvhandle recur fuel' env er fixSelf locals comp clauses
            | XVDo stmts => lower_xvdo recur fuel' env er fixSelf locals stmts
            | XVFallible container failure success body =>
                lower_xvfallible recur fuel' env fixSelf locals
                  container failure success body
            | XVUnsupported => lower_xvunsupported recur fuel' env er fixSelf locals
            end
        | LBranch params family br => lower_lbranch recur fuel' env er fixSelf locals params family br
        | LBinders b =>
            match view_binder b with
            | BinderEnd => VBinderPairs (Nil (Pair Nat Surface))
            | BinderNode id ty rest =>
                let tyS : Surface :=
                  vsurf_or_hole
                    (lower_run fuel' env er fixSelf locals (LExpr ty)) in
                let restPs : List (Pair Nat Surface) :=
                  vbinders_or_nil
                    (lower_run fuel' env er fixSelf locals (LBinders rest)) in
                let one : Pair Nat Surface := MkPair Nat Surface id tyS in
                VBinderPairs (Cons (Pair Nat Surface) one restPs)
            end
        | LArgs xs =>
            match xs with
            | Nil => VSurfList (Nil Surface)
            | Cons a xs' =>
                let aS : Surface :=
                  vsurf_or_hole
                    (lower_run fuel' env er fixSelf locals (LExpr a)) in
                let rest : List Surface :=
                  vlist_or_nil
                    (lower_run fuel' env er fixSelf locals (LArgs xs')) in
                VSurfList (Cons Surface aS rest)
            end
        end
    end;

def lower_expr_env2 (env : LowerEnv) (er : Maybe Surface) (e : Expr) : Surface :=
    vsurf_or_hole
      (lower_run fuel1k env er (Nothing Nat) (Nil (Pair Nat Surface))
        (LExpr e));

def lower_expr_env (env : LowerEnv) (e : Expr) : Surface :=
    lower_expr_env2 env (Nothing Surface) e;

def lower_expr (e : Expr) : Surface :=
    lower_expr_env empty_env e;
