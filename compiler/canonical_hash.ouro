-- Deterministic FNV-1a 64-bit hashing for canonical compiler artifacts.
-- This is an identity/cache key, not a cryptographic trust boundary.

import "base.ouro";
import "../std/data.ouro";
import "../std/word.ouro";

inductive CanonicalHash : Type :=
  | MkCanonicalHash : Nat -> Nat -> CanonicalHash;

def csh_mask16 : Nat := sub (shl32 1 16) 1;
def csh_prime_low : Nat := 435;

def csh_offset : CanonicalHash :=
  MkCanonicalHash
    (w32_of_bytes 115 157 3 131)
    (w32_of_bytes 20 101 15 176);

def csh_mul_low (x : Nat) : Pair Nat Nat :=
  let x0 : Nat := and32 x csh_mask16 in
  let x1 : Nat := shr32 x 16 in
  let p0 : Nat := mul x0 csh_prime_low in
  let p1 : Nat := add (mul x1 csh_prime_low) (shr32 p0 16) in
  let lo : Nat :=
    or32 (and32 p0 csh_mask16)
      (shl32 (and32 p1 csh_mask16) 16) in
  MkPair Nat Nat lo (shr32 p1 16);

def canonical_hash_byte (hash : CanonicalHash) (byte : Nat) : CanonicalHash :=
  match hash with
  | MkCanonicalHash lo hi =>
      let xlo : Nat := xor32 lo (and32 byte w32_mask8) in
      match csh_mul_low xlo with
      | MkPair next_lo carry =>
          match csh_mul_low hi with
          | MkPair hi_mul _ =>
              MkCanonicalHash next_lo
                (add32 (add32 hi_mul carry) (shl32 xlo 8))
          end
      end
  end;

def canonical_hash_codes_from (hash : CanonicalHash) (codes : List Nat)
    : CanonicalHash :=
  (fix go (xs : List Nat) (current : CanonicalHash) : CanonicalHash :=
    match xs with
    | Nil => current
    | Cons byte rest => go rest (canonical_hash_byte current byte)
    end) codes hash;

def canonical_hash_codes (codes : List Nat) : CanonicalHash :=
  canonical_hash_codes_from csh_offset codes;

def canonical_hash_eq (a : CanonicalHash) (b : CanonicalHash) : Bool :=
  match a with
  | MkCanonicalHash alo ahi =>
      match b with
      | MkCanonicalHash blo bhi => andb (eqNat alo blo) (eqNat ahi bhi)
      end
  end;

def canonical_hash_bytes (hash : CanonicalHash) : List Nat :=
  match hash with
  | MkCanonicalHash lo hi =>
      [ w32_b3 lo, w32_b2 lo, w32_b1 lo, w32_b0 lo
      , w32_b3 hi, w32_b2 hi, w32_b1 hi, w32_b0 hi
      ]
  end;
