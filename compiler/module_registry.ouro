import "module_registry_base.ouro";

-- resolve_import_paths returns dependency-first order. The cache preserves
-- each file's exported names across its own import edges, while the compiler
-- still checks every declaration in the full import closure.
def module_export_cache (units : List SrcUnit) (reached : List Nat)
    (aliases : List ModuleAliasUnit) (members : List ModuleMember)
    (st : InternState) : ResolveResult (List ModuleExports) :=
  (fix go (paths : List Nat) (cache : List ModuleExports)
      : ResolveResult (List ModuleExports) :=
    match paths with
    | Nil => ROk (List ModuleExports) cache
    | Cons owner rest => match findUnit owner units with
      | None => RErr (List ModuleExports) 2 owner
      | Some decls =>
          let rules : List ModuleRule := module_rules_for owner aliases in
          match module_validate_selected st members rules with
          | RErr code detail => RErr (List ModuleExports) code detail
          | ROk _ => match module_import_exports st members rules cache decls with
            | RErr code detail => RErr (List ModuleExports) code detail
            | ROk imported =>
                let owned : List (Pair Nat Nat) :=
                  module_owned_exports owner members in
                go rest (Cons ModuleExports
                  (MkModuleExports owner
                    (module_unique_exports
                      (append (Pair Nat Nat) owned
                        (module_shadow_exports owned imported)))) cache)
            end
          end
      end
    end) reached (Nil ModuleExports);

def module_has_selected_rules : List ModuleRule -> Bool :=
  fix go (rules : List ModuleRule) : Bool :=
    match rules with
    | Nil => False
    | Cons rule rest => match rule with
      | ModuleSelected _ _ => True
      | ModulePlain _ => go rest
      | ModuleGrant _ _ _ => go rest
      end
    end;

def module_has_reached_selection (reached : List Nat)
    : List ModuleAliasUnit -> Bool :=
  fix go (units : List ModuleAliasUnit) : Bool :=
    match units with
    | Nil => False
    | Cons unit rest => match unit with
      | MkModuleAliasUnit owner _ rules =>
          match andb(memNat owner reached,
              module_has_selected_rules rules) with
          | True => True
          | False => go rest
          end
      end
    end;

def module_alias_target (alias : List Nat)
    : List (Pair (List Nat) Nat) -> Maybe Nat :=
  fix go (bindings : List (Pair (List Nat) Nat)) : Maybe Nat :=
    match bindings with
    | Nil => Nothing Nat
    | Cons item rest =>
        match item with
        | MkPair name target =>
            match source_bytes_equal name alias with
            | True => Just Nat target
            | False => go rest
            end
        end
    end;

def module_open_members (current : Nat) (target : Nat)
    (st : InternState) (rules : List ModuleRule)
    (members : List ModuleMember) : List (Pair Nat Nat) :=
  let direct : List (Pair Nat Nat) :=
    match module_selected_for target rules with
    | Nothing => module_owned_exports target members
    | Just selectors => module_selected_exports st target selectors members
    end in
  (fix go (remaining : List (Pair Nat Nat)) : List (Pair Nat Nat) :=
    match remaining with
    | Nil => Nil (Pair Nat Nat)
    | Cons item rest => match item with
      | MkPair short symbol => match module_member current short members with
        | Just _ => go rest
        | Nothing => Cons (Pair Nat Nat)
            (MkPair Nat Nat short symbol) (go rest)
        end
      end
    end) direct;

def module_open_ctors (units : List SrcUnit) (target : Nat)
    (members : List ModuleMember)
    (refs : List (Pair Nat Nat)) : List Nat :=
  match findUnit target units with
  | None => Nil Nat
  | Some decls =>
      let symbols : List Nat :=
        (fix go (names : List Nat) : List Nat :=
          match names with
          | Nil => Nil Nat
          | Cons name rest => match module_member target name members with
            | Nothing => go rest
            | Just symbol => Cons Nat symbol (go rest)
            end
          end) (module_ctor_names decls) in
      filter Nat (fun (name : Nat) => match module_lookup name refs with
        | Nothing => False
        | Just symbol => memNat symbol symbols
        end) (map (Pair Nat Nat) Nat (fun (item : Pair Nat Nat) =>
          match item with | MkPair short _ => short end) refs)
  end;

def module_opens_for (units : List SrcUnit) (st : InternState)
    (current : Nat) (rules : List ModuleRule)
    (members : List ModuleMember)
    : List (Pair (List Nat) Nat) -> List ModuleOpen :=
  fix go (aliases : List (Pair (List Nat) Nat)) : List ModuleOpen :=
    match aliases with
    | Nil => Nil ModuleOpen
    | Cons item rest => match item with
      | MkPair spelling target =>
          let tail : List ModuleOpen := go rest in
          match st with
          | MkIntern ids _ _ _ =>
              match source_lookup_id ids spelling with
              | Nothing => tail
              | Just alias =>
                  let refs : List (Pair Nat Nat) :=
                    module_open_members current target st rules members in
                  Cons ModuleOpen
                    (MkModuleOpen alias refs
                      (module_open_ctors units target members refs)) tail
              end
          end
      end
    end;

def module_source_opens (st : InternState)
    : List (List Nat) -> List ModuleOpen :=
  fix go (names : List (List Nat)) : List ModuleOpen :=
    match names with
    | Nil => Nil ModuleOpen
    | Cons spelling rest =>
        let tail : List ModuleOpen := go rest in
        match st with
        | MkIntern ids _ _ _ =>
            match source_lookup_id ids spelling with
            | Nothing => tail
            | Just alias => Cons ModuleOpen
                (MkModuleOpen alias (Nil (Pair Nat Nat)) (Nil Nat)) tail
            end
        end
    end;

def module_split_marker (name : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  (fix go (bytes : List Nat) (prefix : List Nat)
      : Maybe (Pair (List Nat) (List Nat)) :=
    match bytes with
    | Nil => Nothing (Pair(List Nat, List Nat))
    | Cons c rest =>
        match eqNat c 64 with
        | True =>
            match prefix with
            | Nil => Nothing (Pair(List Nat, List Nat))
            | Cons _ _ =>
                match rest with
                | Nil => Nothing (Pair(List Nat, List Nat))
                | Cons _ _ => Just (Pair(List Nat, List Nat))
                    (MkPair(List Nat, List Nat, reverse Nat prefix, rest))
                end
            end
        | False => go rest (Cons Nat c prefix)
        end
    end) name (Nil Nat);

-- A declaration in the current file wins over imported short names. Multiple
-- distinct imported owners with the same short spelling are ambiguous.
def module_unqualified (owner : Nat) (visible : List Nat)
    (name : Nat) (members : List ModuleMember) : ModuleDecision :=
  match module_member owner name members with
  | Just symbol => ModuleFound symbol
  | Nothing =>
      (fix go (rows : List ModuleMember) (found : Maybe Nat)
          : ModuleDecision :=
        match rows with
        | Nil =>
            match found with
            | Nothing => ModuleAbsent
            | Just symbol => ModuleFound symbol
            end
        | Cons item rest =>
            match item with
            | MkModuleMember path short symbol =>
                match andb(eqNat short name, memNat path visible) with
                | False => go rest found
                | True =>
                    match found with
                    | Nothing => go rest (Just Nat symbol)
                    | Just _ => ModuleAmbiguous
                    end
                end
            end
        end) members (Nothing Nat)
  end;

def module_heads (owner : Nat) (conflicts : List Nat)
    : List ModuleMember -> List (Pair Nat Nat) :=
  fix go (members : List ModuleMember) : List (Pair Nat Nat) :=
    match members with
    | Nil => Nil (Pair Nat Nat)
    | Cons item rest =>
        match item with
        | MkModuleMember path short symbol =>
            match andb(eqNat path owner, memNat short conflicts) with
            | True => Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) (go rest)
            | False => go rest
            end
        end
    end;

def module_unqualified_maps (owner : Nat) (visible : List Nat)
    (conflicts : List Nat) (members : List ModuleMember) : ModuleMaps :=
  (fix go (names : List Nat)
      (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
      : ModuleMaps :=
    match names with
    | Nil => MkModuleMaps (module_heads owner conflicts members) refs errors
    | Cons short rest =>
        match module_unqualified owner visible short members with
        | ModuleAbsent => go rest refs errors
        | ModuleFound symbol =>
            go rest (Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) refs)
              errors
        | ModuleAmbiguous =>
            go rest refs
              (Cons (Pair Nat Nat) (MkPair Nat Nat short 6) errors)
        end
    end) conflicts (Nil (Pair Nat Nat)) (Nil (Pair Nat Nat));

def module_add_decision (prior : ModuleDecision) (symbol : Nat)
    : ModuleDecision :=
  match prior with
  | ModuleAbsent => ModuleFound symbol
  | ModuleFound previous => match eqNat previous symbol with
    | True => prior | False => ModuleAmbiguous end
  | ModuleAmbiguous => ModuleAmbiguous
  end;

def module_scope_decision (owner : Nat) (name : Nat)
    (members : List ModuleMember)
    (exports : List (Pair Nat Nat)) : ModuleDecision :=
  match module_member owner name members with
  | Just symbol => ModuleFound symbol
  | Nothing =>
      (fix go (rows : List (Pair Nat Nat)) (choice : ModuleDecision)
          : ModuleDecision :=
        match rows with
        | Nil => choice
        | Cons item rest => match item with
          | MkPair short symbol => match eqNat short name with
            | True => go rest (module_add_decision choice symbol)
            | False => go rest choice
            end
          end
        end) exports ModuleAbsent
  end;

def module_all_names (members : List ModuleMember)
    : List Nat :=
  (fix go (rows : List ModuleMember) (seen : List Nat) : List Nat :=
    match rows with
    | Nil => seen
    | Cons item rest => match item with
      | MkModuleMember _ short _ => match memNat short seen with
        | True => go rest seen
        | False => go rest (Cons Nat short seen)
        end
      end
    end) members (Nil Nat);

def module_export_names : List (Pair Nat Nat) -> List Nat :=
  fix go (exports : List (Pair Nat Nat)) : List Nat :=
    match exports with
    | Nil => Nil Nat
    | Cons item rest => match item with
      | MkPair short _ => Cons Nat short (go rest)
      end
    end;

def module_exports_symbol (symbol : Nat)
    : List (Pair Nat Nat) -> Bool :=
  fix go (exports : List (Pair Nat Nat)) : Bool :=
    match exports with
    | Nil => False
    | Cons item rest => match item with
      | MkPair _ candidate => match eqNat symbol candidate with
        | True => True | False => go rest end
      end
    end;

def module_unique_names (first : List Nat) (second : List Nat)
    : List Nat :=
  (fix go (remaining : List Nat) (seen : List Nat) : List Nat :=
    match remaining with
    | Nil => seen
    | Cons name rest => match memNat name seen with
      | True => go rest seen
      | False => go rest (Cons Nat name seen)
      end
    end) first second;

def module_scope_maps (owner : Nat) (names : List Nat)
    (members : List ModuleMember)
    (exports : List (Pair Nat Nat)) : ModuleMaps :=
  (fix go (remaining : List Nat)
      (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
      : ModuleMaps :=
    match remaining with
    | Nil => MkModuleMaps (module_heads owner names members)
        refs errors
    | Cons short rest =>
        match module_scope_decision owner short members exports with
        | ModuleFound symbol =>
            go rest (Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) refs)
              errors
        | ModuleAmbiguous =>
            go rest refs
              (Cons (Pair Nat Nat) (MkPair Nat Nat short 6) errors)
        | ModuleAbsent =>
            go rest refs
              (Cons (Pair Nat Nat) (MkPair Nat Nat short 5) errors)
        end
    end) names (Nil (Pair Nat Nat)) (Nil (Pair Nat Nat));

def module_marker_ids (st : InternState) : List (Pair (List Nat) Nat) :=
  match st with
  | MkIntern identifiers _ _ _ =>
      (fix go (rows : List (Pair (List Nat) Nat))
          : List (Pair (List Nat) Nat) :=
        match rows with
        | Nil => Nil (Pair(List Nat, Nat))
        | Cons item rest =>
            match item with
            | MkPair spelling _ =>
                match module_split_marker spelling with
                | Nothing => go rest
                | Just _ => Cons (Pair(List Nat) Nat) item (go rest)
                end
            end
        end) identifiers
  end;

-- A source-only entry has no imported unit bodies to resolve. It still must
-- reject a qualified marker in a declaration or binder before its existing
-- unresolved-import failure, rather than treating that marker as a new name.
def module_source_guard (fuel : Nat) (aliases : ImpReg)
    (st : InternState) (decls : List Decl) : ResolveResult (List Decl) :=
  match aliases with
  | MkImpReg names _ _ =>
      match names with
      | Nil => ROk (List Decl) decls
      | Cons _ _ =>
          let marker_ids : List Nat :=
            map (Pair(List Nat, Nat)) Nat
              (fun (item : Pair (List Nat) Nat) =>
                match item with | MkPair _ id => id end) (module_marker_ids st) in
          match marker_ids with
          | Nil => ROk (List Decl) decls
          | Cons _ _ =>
              match module_rewrite_decls_with_opens fuel
                  (Nil (Pair Nat Nat)) (Nil (Pair Nat Nat))
                  (Nil (Pair Nat Nat)) (module_source_opens st names)
                  marker_ids (module_ctor_names decls)
                  (Nil (Pair Nat Nat)) decls with
              | RErr code detail => RErr (List Decl) code detail
              | ROk _ => ROk (List Decl) decls
              end
          end
      end
  end;

def module_marker_maps (st : InternState) (current : Nat)
    (visible : List Nat) (aliases : List (Pair (List Nat) Nat))
    (rules : List ModuleRule) (members : List ModuleMember)
    (exports : List (Pair Nat Nat)) (isolate : Bool)
    (markers : List (Pair (List Nat) Nat))
    (initial : ModuleMaps) : ModuleMaps :=
      (fix go (ids : List (Pair (List Nat) Nat))
          (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
          (heads : List (Pair Nat Nat)) : ModuleMaps :=
        match ids with
        | Nil => MkModuleMaps heads refs errors
        | Cons item rest =>
            match item with
            | MkPair spelling id =>
                let grant : Maybe (Pair Nat (List Nat)) :=
                  module_grant_for spelling rules in
                match grant with
                | Just granted => match granted with
                  | MkPair target member =>
                      match module_member_bytes st target member members with
                      | Nothing => go rest refs
                          (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors) heads
                      | Just symbol =>
                          let allowed : Bool :=
                            match eqNat target current with
                            | True => True
                            | False => match isolate with
                              | True => orb(module_edge_allows target member rules,
                                  module_exports_symbol symbol exports)
                              | False => memNat target visible
                              end
                            end in
                          match allowed with
                          | False => go rest refs
                              (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors)
                              heads
                          | True => go rest
                              (Cons (Pair Nat Nat) (MkPair Nat Nat id symbol) refs)
                              errors heads
                          end
                      end
                  end
                | Nothing => match module_split_marker spelling with
                  | Nothing => go rest refs errors heads
                  | Just parts => match parts with
                    | MkPair alias member =>
                        match module_alias_target alias aliases with
                        | Nothing => go rest refs errors heads
                        | Just target =>
                            match module_edge_allows target member rules with
                            | False => go rest refs
                                (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors)
                                heads
                            | True =>
                                match module_member_bytes st target member members with
                                | Nothing => go rest refs
                                    (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors)
                                    heads
                                | Just symbol => go rest
                                    (Cons (Pair Nat Nat) (MkPair Nat Nat id symbol) refs)
                                    errors heads
                                end
                            end
                        end
                    end
                  end
                end
            end
        end) markers
          (match initial with | MkModuleMaps _ refs _ => refs end)
          (match initial with | MkModuleMaps _ _ errors => errors end)
          (match initial with | MkModuleMaps heads _ _ => heads end);

def module_symbol_is_ctor (units : List SrcUnit)
    (members : List ModuleMember) (symbol : Nat) : Bool :=
  (fix go (rows : List ModuleMember) : Bool :=
    match rows with
    | Nil => False
    | Cons item rest => match item with
      | MkModuleMember owner short current =>
          match eqNat current symbol with
          | False => go rest
          | True => match findUnit owner units with
            | None => False
            | Some decls => memNat short (module_ctor_names decls)
            end
          end
      end
    end) members;

def module_qualified_ctors (units : List SrcUnit)
    (members : List ModuleMember) (refs : List (Pair Nat Nat))
    (markers : List (Pair (List Nat) Nat)) : List Nat :=
  (fix go (rows : List (Pair (List Nat) Nat)) : List Nat :=
    match rows with
    | Nil => Nil Nat
    | Cons item rest =>
        let tail : List Nat := go rest in
        match item with
        | MkPair _ marker =>
            match module_lookup marker refs with
            | Nothing => tail
            | Just symbol =>
                match module_symbol_is_ctor units members symbol with
                | True => Cons Nat marker tail
                | False => tail
                end
            end
        end
    end) markers;

def module_bare_ctors (units : List SrcUnit)
    (members : List ModuleMember) (refs : List (Pair Nat Nat))
    (errors : List (Pair Nat Nat)) (names : List Nat) : List Nat :=
  (fix go (remaining : List Nat) : List Nat :=
    match remaining with
    | Nil => Nil Nat
    | Cons name rest =>
        let tail : List Nat := go rest in
        match module_lookup name errors with
        | Just _ => tail
        | Nothing =>
            let symbol : Nat := match module_lookup name refs with
              | Just target => target | Nothing => name end in
            match module_symbol_is_ctor units members symbol with
            | True => Cons Nat name tail
            | False => tail
            end
        end
    end) names;

def module_maps_for (units : List SrcUnit) (aliases : List ModuleAliasUnit)
    (members : List ModuleMember) (conflicts : List Nat)
    (markers : List (Pair (List Nat) Nat))
    (scope_cache : List ModuleExports)
    (st : InternState) (owner : Nat) (isolate : Bool)
    : ResolveResult (Pair ModuleMaps (List Nat)) :=
  match resolve_import_paths units owner with
  | RErr code detail => RErr (Pair ModuleMaps (List Nat)) code detail
  | ROk visible =>
      let local_aliases : List (Pair (List Nat) Nat) :=
        module_aliases_for owner aliases in
      let rules : List ModuleRule := module_rules_for owner aliases in
      match module_validate_selected st members rules with
      | RErr code detail => RErr (Pair ModuleMaps (List Nat)) code detail
      | ROk _ =>
          let scoped : ResolveResult (List (Pair Nat Nat)) :=
            match isolate with
            | False => ROk (List (Pair Nat Nat)) (Nil (Pair Nat Nat))
            | True => match module_exports_for owner scope_cache with
              | Nothing => RErr (List (Pair Nat Nat)) 8 owner
              | Just exports => ROk (List (Pair Nat Nat)) exports
              end
            end in
          match scoped with
          | RErr code detail => RErr (Pair ModuleMaps (List Nat)) code detail
          | ROk exports =>
              let names : List Nat := match isolate with
                | True => module_unique_names (module_all_names members)
                    (module_export_names exports)
                | False => conflicts
                end in
              let base_maps : ModuleMaps := match isolate with
                | True => module_scope_maps owner names members exports
                | False => module_unqualified_maps owner visible
                    conflicts members
                end in
              let mapped : ModuleMaps := module_marker_maps st owner visible
                local_aliases rules members exports isolate markers base_maps in
              match mapped with
              | MkModuleMaps _ refs errors =>
                  let candidates : List Nat := match isolate with
                    | True => names
                    | False => module_visible_ctors units visible
                    end in
                  ROk (Pair ModuleMaps (List Nat))
                    (MkPair ModuleMaps (List Nat) mapped
                      (append Nat
                        (module_bare_ctors units members refs errors candidates)
                        (module_qualified_ctors units members refs markers)))
              end
          end
      end
  end;

def module_rewrite_units (fuel : Nat) (units : List SrcUnit)
    (reached : List Nat) (aliases : List ModuleAliasUnit)
    (members : List ModuleMember) (conflicts : List Nat)
    (markers : List (Pair (List Nat) Nat)) (marker_ids : List Nat)
    (scope_cache : List ModuleExports) (st : InternState) (isolate : Bool)
    : ResolveResult (Pair (List SrcUnit) InternState) :=
  (fix go (remaining : List SrcUnit) (current : InternState)
      : ResolveResult (Pair (List SrcUnit) InternState) :=
    match remaining with
    | Nil => ROk (Pair (List SrcUnit) InternState)
        (MkPair (List SrcUnit) InternState (Nil SrcUnit) current)
    | Cons unit rest =>
        match unit with
        | MkSrcUnit owner decls =>
            match memNat owner reached with
            | False =>
                match go rest current with
                | RErr code detail =>
                    RErr (Pair (List SrcUnit) InternState) code detail
                | ROk tail => match tail with
                    | MkPair rewritten final_st =>
                        ROk (Pair (List SrcUnit) InternState)
                          (MkPair (List SrcUnit) InternState
                            (Cons SrcUnit unit rewritten) final_st)
                    end
                end
            | True =>
                match module_maps_for units aliases members conflicts
                    markers scope_cache current owner isolate with
                | RErr code detail =>
                    RErr (Pair (List SrcUnit) InternState) code detail
                | ROk scoped_maps =>
                    match scoped_maps with
                    | MkPair maps constructors =>
                      match maps with
                      | MkModuleMaps heads refs errors =>
                        match module_binder_maps current marker_ids refs with
                        | RErr code detail =>
                            RErr (Pair (List SrcUnit) InternState) code detail
                        | ROk allocation =>
                            match allocation with
                            | MkPair binders next_st =>
                                let opens : List ModuleOpen :=
                                  module_opens_for units next_st owner
                                    (module_rules_for owner aliases) members
                                    (module_aliases_for owner aliases) in
                                let pure_label : Nat :=
                                  match module_ident_id next_st name_pure with
                                  | Nothing => 0 | Just name => name end in
                                match module_rewrite_decls_with_opens_pure fuel
                                    heads refs errors opens marker_ids
                                    constructors binders pure_label decls with
                                | RErr code detail =>
                                    RErr (Pair (List SrcUnit) InternState)
                                      code detail
                                | ROk updated =>
                                    match go rest next_st with
                                    | RErr code detail =>
                                        RErr (Pair (List SrcUnit) InternState)
                                          code detail
                                    | ROk tail =>
                                        match tail with
                                        | MkPair rewritten final_st =>
                                            ROk (Pair (List SrcUnit) InternState)
                                              (MkPair (List SrcUnit)
                                                InternState
                                                (Cons SrcUnit
                                                  (MkSrcUnit owner updated)
                                                  rewritten)
                                                final_st)
                                        end
                                    end
                                end
                            end
                        end
                      end
                    end
                end
            end
        end
    end) units st;

def module_resolve_units (fuel : Nat) (units : List SrcUnit)
    (alias_files : List (Pair (List Nat) ImpReg))
    (root : Nat) (st : InternState)
    : ResolveResult (Pair (List SrcUnit) InternState) :=
  match module_duplicate_units units with
  | Just _ => RErr (Pair (List SrcUnit) InternState) 8 0
  | Nothing => match module_has_aliases alias_files with
  | False => ROk (Pair (List SrcUnit) InternState)
      (MkPair (List SrcUnit) InternState units st)
  | True => match resolve_import_paths units root with
  | RErr code detail => RErr (Pair (List SrcUnit) InternState) code detail
  | ROk reached =>
      match module_alias_units st alias_files with
      | RErr code detail => RErr (Pair (List SrcUnit) InternState) code detail
      | ROk aliases =>
          match module_has_reached_aliases reached aliases with
          | False => ROk (Pair (List SrcUnit) InternState)
              (MkPair (List SrcUnit) InternState units st)
          | True =>
          let seeds : List (Pair Nat Nat) := module_seed_units units reached in
          let conflicts : List Nat := module_conflict_names seeds in
          let isolate : Bool := module_has_reached_selection reached aliases in
          match module_legacy_special_collision st conflicts with
          | Just name =>
              RErr (Pair (List SrcUnit) InternState) 6 name
          | Nothing =>
          let markers : List (Pair (List Nat) Nat) := module_marker_ids st in
          let marker_ids : List Nat :=
            map (Pair(List Nat, Nat)) Nat
              (fun (item : Pair (List Nat) Nat) =>
                match item with | MkPair _ id => id end) markers in
          match module_members st root reached conflicts seeds isolate with
          | RErr code detail => RErr (Pair (List SrcUnit) InternState) code detail
          | ROk built =>
              match built with
              | MkPair members st2 =>
                  let scopes : ResolveResult (List ModuleExports) :=
                    match isolate with
                    | False => ROk (List ModuleExports) (Nil ModuleExports)
                    | True => module_export_cache units reached aliases members st2
                    end in
                  match scopes with
                  | RErr code detail =>
                      RErr (Pair (List SrcUnit) InternState) code detail
                  | ROk cache =>
                      match module_rewrite_units fuel units reached aliases
                          members conflicts markers marker_ids cache st2 isolate with
                      | RErr code detail =>
                          RErr (Pair (List SrcUnit) InternState) code detail
                      | ROk updated => ROk (Pair (List SrcUnit) InternState) updated
                      end
                  end
              end
          end
          end
          end
      end
  end
  end
  end;
