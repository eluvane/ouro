import "module_registry_base.ouro";

inductive ModuleResolvedUnits : Type :=
  | ModuleResolvedUnitsOf : Pair (List SrcUnit) InternState ->
      List SourceModuleSlot -> ModuleResolvedUnits;

def module_resolved_units_project (result : ResolveResult ModuleResolvedUnits)
    : ResolveResult (Pair (List SrcUnit) InternState) :=
  match result with
  | RErr code detail => RErr (Pair (List SrcUnit) InternState) code detail
  | ROk packet => match packet with | ModuleResolvedUnitsOf resolved _ =>
      ROk (Pair (List SrcUnit) InternState) resolved
    end
  end;

-- resolve_import_paths returns dependency-first order. The cache preserves
-- each file's exported names across its own import edges, while the compiler
-- still checks every declaration in the full import closure.
def module_export_cache (units : List SrcUnit) (reached : List Nat)
    (aliases : List ModuleAliasUnit) (members : List ModuleMember)
    (st : InternState) : ResolveResult (List ModuleExports) :=
  (fix go (paths : List Nat) (cache : List ModuleExports)
      : ResolveResult (List ModuleExports) :=
    match paths with
    | Nil => ROk (List ModuleExports) cache
    | Cons owner rest => match findUnit owner units with
      | None => RErr (List ModuleExports) 2 owner
      | Some decls =>
          let rules : List ModuleRule := module_rules_for owner aliases in
          match module_validate_selected st members rules with
          | RErr code detail => RErr (List ModuleExports) code detail
          | ROk _ => match module_import_exports st members rules cache decls with
            | RErr code detail => RErr (List ModuleExports) code detail
            | ROk imported =>
                let owned : List (Pair Nat Nat) :=
                  module_owned_exports owner members in
                go rest (Cons ModuleExports
                  (MkModuleExports owner
                    (module_unique_exports
                      (append (Pair Nat Nat) owned
                        (module_shadow_exports owned imported)))) cache)
            end
          end
      end
    end) reached (Nil ModuleExports);

def module_has_selected_rules : List ModuleRule -> Bool :=
  fix go (rules : List ModuleRule) : Bool :=
    match rules with
    | Nil => False
    | Cons rule rest => match rule with
      | ModuleSelected _ _ => True
      | ModulePlain _ => go rest
      | ModuleGrant _ _ _ => go rest
      | ModuleFieldGrant _ _ _ => go rest
      end
    end;

def module_has_reached_selection (reached : List Nat)
    : List ModuleAliasUnit -> Bool :=
  fix go (units : List ModuleAliasUnit) : Bool :=
    match units with
    | Nil => False
    | Cons unit rest => match unit with
      | MkModuleAliasUnit owner _ rules =>
          match andb(memNat owner reached,
              module_has_selected_rules rules) with
          | True => True
          | False => go rest
          end
      end
    end;

def module_alias_target (alias : List Nat)
    : List (Pair (List Nat) Nat) -> Maybe Nat :=
  fix go (bindings : List (Pair (List Nat) Nat)) : Maybe Nat :=
    match bindings with
    | Nil => Nothing Nat
    | Cons item rest =>
        match item with
        | MkPair name target =>
            match source_bytes_equal name alias with
            | True => Just Nat target
            | False => go rest
            end
        end
    end;

def module_open_members (current : Nat) (target : Nat)
    (st : InternState) (rules : List ModuleRule)
    (members : List ModuleMember) : List (Pair Nat Nat) :=
  let direct : List (Pair Nat Nat) :=
    match module_selected_for target rules with
    | Nothing => module_owned_exports target members
    | Just selectors => module_selected_exports st target selectors members
    end in
  (fix go (remaining : List (Pair Nat Nat)) : List (Pair Nat Nat) :=
    match remaining with
    | Nil => Nil (Pair Nat Nat)
    | Cons item rest => match item with
      | MkPair short symbol => match module_member current short members with
        | Just _ => go rest
        | Nothing => Cons (Pair Nat Nat)
            (MkPair Nat Nat short symbol) (go rest)
        end
      end
    end) direct;

def module_open_ctors (units : List SrcUnit) (target : Nat)
    (members : List ModuleMember)
    (refs : List (Pair Nat Nat)) : List Nat :=
  match findUnit target units with
  | None => Nil Nat
  | Some decls =>
      let symbols : List Nat :=
        (fix go (names : List Nat) : List Nat :=
          match names with
          | Nil => Nil Nat
          | Cons name rest => match module_member target name members with
            | Nothing => go rest
            | Just symbol => Cons Nat symbol (go rest)
            end
          end) (module_ctor_names decls) in
      filter Nat (fun (name : Nat) => match module_lookup name refs with
        | Nothing => False
        | Just symbol => memNat symbol symbols
        end) (map (Pair Nat Nat) Nat (fun (item : Pair Nat Nat) =>
          match item with | MkPair short _ => short end) refs)
  end;

def module_opens_for (units : List SrcUnit) (st : InternState)
    (current : Nat) (rules : List ModuleRule)
    (members : List ModuleMember)
    : List (Pair (List Nat) Nat) -> List ModuleOpen :=
  fix go (aliases : List (Pair (List Nat) Nat)) : List ModuleOpen :=
    match aliases with
    | Nil => Nil ModuleOpen
    | Cons item rest => match item with
      | MkPair spelling target =>
          let tail : List ModuleOpen := go rest in
          match st with
          | MkIntern ids _ _ _ =>
              match source_lookup_id ids spelling with
              | Nothing => tail
              | Just alias =>
                  let refs : List (Pair Nat Nat) :=
                    module_open_members current target st rules members in
                  Cons ModuleOpen
                    (MkModuleOpen alias refs
                      (module_open_ctors units target members refs)) tail
              end
          end
      end
    end;

def module_source_opens (st : InternState)
    : List (List Nat) -> List ModuleOpen :=
  fix go (names : List (List Nat)) : List ModuleOpen :=
    match names with
    | Nil => Nil ModuleOpen
    | Cons spelling rest =>
        let tail : List ModuleOpen := go rest in
        match st with
        | MkIntern ids _ _ _ =>
            match source_lookup_id ids spelling with
            | Nothing => tail
            | Just alias => Cons ModuleOpen
                (MkModuleOpen alias (Nil (Pair Nat Nat)) (Nil Nat)) tail
            end
        end
    end;

def module_split_marker (name : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  (fix go (bytes : List Nat) (prefix : List Nat)
      : Maybe (Pair (List Nat) (List Nat)) :=
    match bytes with
    | Nil => Nothing (Pair(List Nat, List Nat))
    | Cons c rest =>
        match eqNat c 64 with
        | True =>
            match prefix with
            | Nil => Nothing (Pair(List Nat, List Nat))
            | Cons _ _ =>
                match rest with
                | Nil => Nothing (Pair(List Nat, List Nat))
                | Cons _ _ => Just (Pair(List Nat, List Nat))
                    (MkPair(List Nat, List Nat, reverse Nat prefix, rest))
                end
            end
        | False => go rest (Cons Nat c prefix)
        end
    end) name (Nil Nat);

-- A declaration in the current file wins over imported short names. Multiple
-- distinct imported owners with the same short spelling are ambiguous.
def module_unqualified (owner : Nat) (visible : List Nat)
    (name : Nat) (members : List ModuleMember) : ModuleDecision :=
  match module_member owner name members with
  | Just symbol => ModuleFound symbol
  | Nothing =>
      (fix go (rows : List ModuleMember) (found : Maybe Nat)
          : ModuleDecision :=
        match rows with
        | Nil =>
            match found with
            | Nothing => ModuleAbsent
            | Just symbol => ModuleFound symbol
            end
        | Cons item rest =>
            match item with
            | MkModuleMember path short symbol public =>
                match andb(public, andb(eqNat short name, memNat path visible)) with
                | False => go rest found
                | True =>
                    match found with
                    | Nothing => go rest (Just Nat symbol)
                    | Just _ => ModuleAmbiguous
                    end
                end
            end
        end) members (Nothing Nat)
  end;

def module_heads (owner : Nat) (conflicts : List Nat)
    : List ModuleMember -> List (Pair Nat Nat) :=
  fix go (members : List ModuleMember) : List (Pair Nat Nat) :=
    match members with
    | Nil => Nil (Pair Nat Nat)
    | Cons item rest =>
        match item with
        | MkModuleMember path short symbol _ =>
            match eqNat path owner with
            | False => go rest
            | True =>
                match memNat short conflicts with
                | True => Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) (go rest)
                | False => go rest
                end
            end
        end
    end;

def module_unqualified_maps (owner : Nat) (visible : List Nat)
    (conflicts : List Nat) (members : List ModuleMember) : ModuleMaps :=
  (fix go (names : List Nat)
      (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
      : ModuleMaps :=
    match names with
    | Nil => MkModuleMaps (module_heads owner conflicts members) refs errors
    | Cons short rest =>
        match module_unqualified owner visible short members with
        | ModuleAbsent => go rest refs errors
        | ModuleFound symbol =>
            go rest (Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) refs)
              errors
        | ModuleAmbiguous =>
            go rest refs
              (Cons (Pair Nat Nat) (MkPair Nat Nat short 6) errors)
        end
    end) conflicts (Nil (Pair Nat Nat)) (Nil (Pair Nat Nat));

def module_add_decision (prior : ModuleDecision) (symbol : Nat)
    : ModuleDecision :=
  match prior with
  | ModuleAbsent => ModuleFound symbol
  | ModuleFound previous => match eqNat previous symbol with
    | True => prior | False => ModuleAmbiguous end
  | ModuleAmbiguous => ModuleAmbiguous
  end;

def module_scope_decision (owner : Nat) (name : Nat)
    (members : List ModuleMember)
    (exports : List (Pair Nat Nat)) : ModuleDecision :=
  match module_member owner name members with
  | Just symbol => ModuleFound symbol
  | Nothing =>
      (fix go (rows : List (Pair Nat Nat)) (choice : ModuleDecision)
          : ModuleDecision :=
        match rows with
        | Nil => choice
        | Cons item rest => match item with
          | MkPair short symbol => match eqNat short name with
            | True => go rest (module_add_decision choice symbol)
            | False => go rest choice
            end
          end
        end) exports ModuleAbsent
  end;

def module_field_decision (units : List SrcUnit)
    (scope_cache : List ModuleExports) (all_aliases : List ModuleAliasUnit)
    (st : InternState) (owner : Nat) (atom : List Nat)
    (members : List ModuleMember) (isolate : Bool) : ModuleDecision :=
  match module_split_marker atom with
  | Just parts => match parts with
    | MkPair alias member =>
        match module_alias_target alias (module_aliases_for owner all_aliases) with
        | Nothing => ModuleAbsent
        | Just target =>
            match module_edge_allows target member
                (module_rules_for owner all_aliases) with
            | False => ModuleAbsent
            | True => match module_public_member_bytes st target member members with
              | Nothing => ModuleAbsent
              | Just symbol => ModuleFound symbol
              end
            end
        end
    end
  | Nothing => match module_ident_id st atom with
    | Nothing => ModuleAbsent
    | Just short => match isolate with
      | True => match module_exports_for owner scope_cache with
        | Nothing => ModuleAbsent
        | Just exports => module_scope_decision owner short members exports
        end
      | False => match resolve_import_paths units owner with
        | RErr _ _ => ModuleAbsent
        | ROk visible => module_unqualified owner visible short members
        end
      end
    end
  end;

def module_all_names (members : List ModuleMember)
    : List Nat :=
  (fix go (rows : List ModuleMember) (seen : List Nat)
      (index : SourceNameIndex) : List Nat :=
    match rows with
    | Nil => seen
    | Cons item rest => match item with
      | MkModuleMember _ short _ _ =>
          let key : List Nat := [short] in
          match source_name_index_lookup key index with
          | Just _ => go rest seen index
          | Nothing => go rest (Cons Nat short seen)
              (source_name_index_insert key Z index)
          end
      end
    end) members (Nil Nat) SourceNameIndexEmpty;

def module_export_names : List (Pair Nat Nat) -> List Nat :=
  fix go (exports : List (Pair Nat Nat)) : List Nat :=
    match exports with
    | Nil => Nil Nat
    | Cons item rest => match item with
      | MkPair short _ => Cons Nat short (go rest)
      end
    end;

def module_exports_symbol (symbol : Nat)
    : List (Pair Nat Nat) -> Bool :=
  fix go (exports : List (Pair Nat Nat)) : Bool :=
    match exports with
    | Nil => False
    | Cons item rest => match item with
      | MkPair _ candidate => match eqNat symbol candidate with
        | True => True | False => go rest end
      end
    end;

def module_foreign_private_symbol (current : Nat) (symbol : Nat)
    : List ModuleMember -> Bool :=
  fix go (members : List ModuleMember) : Bool :=
    match members with
    | Nil => False
    | Cons item rest => match item with
      | MkModuleMember owner _ target public =>
          match andb(eqNat target symbol,
              andb(notb(eqNat owner current), notb(public))) with
          | True => True
          | False => go rest
          end
      end
    end;

private def module_collect_unique_names : List Nat -> List Nat -> SourceNameIndex
    -> Pair (List Nat) SourceNameIndex :=
  fix go (remaining : List Nat) (names : List Nat)
      (index : SourceNameIndex) : Pair (List Nat) SourceNameIndex :=
    match remaining with
    | Nil => MkPair (List Nat) SourceNameIndex names index
    | Cons name rest =>
        let key : List Nat := [name] in
        match source_name_index_lookup key index with
        | Just _ => go rest names index
        | Nothing => go rest (Cons Nat name names)
            (source_name_index_insert key Z index)
        end
    end;

def module_unique_names (first : List Nat) (second : List Nat)
    : List Nat :=
  match module_collect_unique_names (append Nat (reverse Nat second) first)
      (Nil Nat) SourceNameIndexEmpty with
  | MkPair names _ => names
  end;

private def module_merge_common_names (common : List Nat) (exported : List Nat)
    : List Nat :=
  match module_collect_unique_names (reverse Nat exported) (Nil Nat)
      SourceNameIndexEmpty with
  | MkPair names export_index =>
      (fix prepend (remaining : List Nat) (result : List Nat) : List Nat :=
        match remaining with
        | Nil => result
        | Cons name rest =>
            match source_name_index_lookup [name] export_index with
            | Just _ => prepend rest result
            | Nothing => prepend rest (Cons Nat name result)
            end
        end) common names
  end;

def module_scope_maps (owner : Nat) (names : List Nat)
    (members : List ModuleMember)
    (exports : List (Pair Nat Nat)) : ModuleMaps :=
  let local_index : SourceNameIndex :=
    (fix collect (rows : List ModuleMember) (index : SourceNameIndex)
        : SourceNameIndex :=
      match rows with
      | Nil => index
      | Cons item rest => match item with
        | MkModuleMember path short symbol _ =>
            match eqNat path owner with
            | True => collect rest (source_name_index_insert [short] symbol index)
            | False => collect rest index
            end
        end
      end) members SourceNameIndexEmpty in
  let exports_from : List (Pair Nat Nat) -> SourceNameIndex -> SourceNameIndex ->
      Pair SourceNameIndex SourceNameIndex :=
    fix collect (rows : List (Pair Nat Nat)) (symbols : SourceNameIndex)
        (ambiguous : SourceNameIndex) : Pair SourceNameIndex SourceNameIndex :=
      match rows with
      | Nil => MkPair SourceNameIndex SourceNameIndex symbols ambiguous
      | Cons row rest => match (row : Pair Nat Nat) with
        | MkPair short symbol =>
            let key : List Nat := [short] in
            match source_name_index_lookup key symbols with
            | Nothing => collect rest (source_name_index_insert key symbol symbols) ambiguous
            | Just previous => match eqNat previous symbol with
              | True => collect rest symbols ambiguous
              | False => collect rest symbols (source_name_index_insert key Z ambiguous)
              end
            end
        end
      end in
  (fix go (remaining : List Nat)
      (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
      (cached : Maybe (Pair SourceNameIndex SourceNameIndex)) : ModuleMaps :=
    match remaining with
    | Nil => MkModuleMaps (module_heads owner names members)
        refs errors
    | Cons short rest =>
        let key : List Nat := [short] in
        match source_name_index_lookup key local_index with
        | Just symbol =>
            go rest (Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) refs)
              errors cached
        | Nothing =>
            let prepared : Pair SourceNameIndex SourceNameIndex :=
              match cached with
              | Just current => current
              | Nothing => exports_from exports SourceNameIndexEmpty SourceNameIndexEmpty
              end in
            match (prepared : Pair SourceNameIndex SourceNameIndex) with
            | MkPair symbols ambiguous =>
                let next : Maybe (Pair SourceNameIndex SourceNameIndex) :=
                  Just (Pair SourceNameIndex SourceNameIndex) prepared in
                match source_name_index_lookup key ambiguous with
                | Just _ => go rest refs
                    (Cons (Pair Nat Nat) (MkPair Nat Nat short 6) errors) next
                | Nothing => match source_name_index_lookup key symbols with
                  | Just symbol =>
                      go rest (Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) refs)
                        errors next
                  | Nothing => go rest refs
                      (Cons (Pair Nat Nat) (MkPair Nat Nat short 5) errors) next
                  end
                end
            end
        end
    end) names (Nil (Pair Nat Nat)) (Nil (Pair Nat Nat))
      (Nothing (Pair SourceNameIndex SourceNameIndex));

def module_marker_ids (st : InternState) : List (Pair (List Nat) Nat) :=
  match st with
  | MkIntern identifiers _ _ _ =>
      (fix go (rows : List (Pair (List Nat) Nat))
          : List (Pair (List Nat) Nat) :=
        match rows with
        | Nil => Nil (Pair(List Nat, Nat))
        | Cons item rest =>
            match item with
            | MkPair spelling _ =>
                match module_split_marker spelling with
                | Nothing => go rest
                | Just _ => Cons (Pair(List Nat) Nat) item (go rest)
                end
            end
        end) identifiers
  end;

-- A source-only entry has no imported unit bodies to resolve. It still must
-- reject a qualified marker in a declaration or binder before its existing
-- unresolved-import failure, rather than treating that marker as a new name.
def module_source_guard (fuel : Nat) (aliases : ImpReg)
    (st : InternState) (decls : List Decl) : ResolveResult (List Decl) :=
  match aliases with
  | MkImpReg _ _ =>
      let names : List (List Nat) := imp_reg_names aliases in
      match names with
      | Nil => ROk (List Decl) decls
      | Cons _ _ =>
          let marker_ids : List Nat :=
            map (Pair(List Nat, Nat)) Nat
              (fun (item : Pair (List Nat) Nat) =>
                match item with | MkPair _ id => id end) (module_marker_ids st) in
          match marker_ids with
          | Nil => ROk (List Decl) decls
          | Cons _ _ =>
              match module_rewrite_decls_with_opens fuel
                  (Nil (Pair Nat Nat)) (Nil (Pair Nat Nat))
                  (Nil (Pair Nat Nat)) (module_source_opens st names)
                  marker_ids (module_ctor_names decls)
                  (Nil (Pair Nat Nat)) decls with
              | RErr code detail => RErr (List Decl) code detail
              | ROk _ => ROk (List Decl) decls
              end
          end
      end
  end;

def module_marker_maps (units : List SrcUnit)
    (scope_cache : List ModuleExports)
    (all_aliases : List ModuleAliasUnit)
    (st : InternState) (current : Nat)
    (visible : List Nat) (aliases : List (Pair (List Nat) Nat))
    (rules : List ModuleRule) (members : List ModuleMember)
    (exports : List (Pair Nat Nat)) (isolate : Bool)
    (markers : List (Pair (List Nat) Nat))
    (initial : ModuleMaps) : ModuleMaps :=
      (fix go (ids : List (Pair (List Nat) Nat))
          (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
          (heads : List (Pair Nat Nat)) : ModuleMaps :=
        match ids with
        | Nil => MkModuleMaps heads refs errors
        | Cons item rest =>
            match item with
            | MkPair spelling id =>
                let grant : Maybe (Pair Nat (List Nat)) :=
                  module_grant_for spelling rules in
                match grant with
                | Just granted => match granted with
                  | MkPair target member =>
                      let resolved : Maybe Nat := match eqNat target current with
                        | True => module_member_bytes st target member members
                        | False => module_public_member_bytes st target member members
                        end in
                      match resolved with
                      | Nothing => go rest refs
                          (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors) heads
                      | Just symbol =>
                          let allowed : Bool :=
                            match eqNat target current with
                            | True => True
                            | False => match isolate with
                              | True => orb(module_edge_allows target member rules,
                                  module_exports_symbol symbol exports)
                              | False => memNat target visible
                              end
                            end in
                          match allowed with
                          | False => go rest refs
                              (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors)
                              heads
                          | True => go rest
                              (Cons (Pair Nat Nat) (MkPair Nat Nat id symbol) refs)
                              errors heads
                          end
                      end
                  end
                | Nothing => match module_field_grant_for spelling rules with
                  | Just field_grant => match field_grant with
                    | MkPair owner atom =>
                        match module_field_decision units scope_cache all_aliases
                            st owner atom members isolate with
                        | ModuleFound symbol =>
                            match module_foreign_private_symbol current symbol members with
                            | True => go rest refs
                                (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors) heads
                            | False => go rest
                                (Cons (Pair Nat Nat) (MkPair Nat Nat id symbol) refs)
                                errors heads
                            end
                        | ModuleAbsent => go rest refs
                            (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors) heads
                        | ModuleAmbiguous => go rest refs
                            (Cons (Pair Nat Nat) (MkPair Nat Nat id 6) errors) heads
                        end
                    end
                  | Nothing => match module_split_marker spelling with
                  | Nothing => go rest refs errors heads
                  | Just parts => match parts with
                    | MkPair alias member =>
                        match module_alias_target alias aliases with
                        | Nothing => go rest refs errors heads
                        | Just target =>
                            match module_edge_allows target member rules with
                            | False => go rest refs
                                (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors)
                                heads
                            | True =>
                                match module_public_member_bytes st target member members with
                                | Nothing => go rest refs
                                    (Cons (Pair Nat Nat) (MkPair Nat Nat id 5) errors)
                                    heads
                                | Just symbol => go rest
                                    (Cons (Pair Nat Nat) (MkPair Nat Nat id symbol) refs)
                                    errors heads
                                end
                            end
                        end
                    end
                  end
                  end
                end
            end
        end) markers
          (match initial with | MkModuleMaps _ refs _ => refs end)
          (match initial with | MkModuleMaps _ _ errors => errors end)
          (match initial with | MkModuleMaps heads _ _ => heads end);

def module_symbol_is_ctor (units : List SrcUnit)
    (members : List ModuleMember) (symbol : Nat) : Bool :=
  (fix go (rows : List ModuleMember) : Bool :=
    match rows with
    | Nil => False
    | Cons item rest => match item with
      | MkModuleMember owner short current _ =>
          match eqNat current symbol with
          | False => go rest
          | True => match findUnit owner units with
            | None => False
            | Some decls => memNat short (module_ctor_names decls)
            end
          end
      end
    end) members;

def module_qualified_ctors (units : List SrcUnit)
    (members : List ModuleMember) (refs : List (Pair Nat Nat))
    (markers : List (Pair (List Nat) Nat)) : List Nat :=
  (fix go (rows : List (Pair (List Nat) Nat)) : List Nat :=
    match rows with
    | Nil => Nil Nat
    | Cons item rest =>
        let tail : List Nat := go rest in
        match item with
        | MkPair _ marker =>
            match module_lookup marker refs with
            | Nothing => tail
            | Just symbol =>
                match module_symbol_is_ctor units members symbol with
                | True => Cons Nat marker tail
                | False => tail
                end
            end
        end
    end) markers;

def module_bare_ctors (units : List SrcUnit)
    (members : List ModuleMember) (refs : List (Pair Nat Nat))
    (errors : List (Pair Nat Nat)) (names : List Nat) : List Nat :=
  let pairs_from (rows : List (Pair Nat Nat)) : SourceNameIndex :=
    (fix collect (remaining : List (Pair Nat Nat)) (index : SourceNameIndex)
        : SourceNameIndex :=
      match remaining with
      | Nil => index
      | Cons row rest => match (row : Pair Nat Nat) with
        | MkPair key value => collect rest
            (source_name_index_insert [add key Z] value index)
        end
      end) rows SourceNameIndexEmpty in
  match names with
  | Nil => Nil Nat
  | Cons _ _ =>
      let error_index : SourceNameIndex := pairs_from errors in
      let eligible : List Nat :=
        filter Nat (fun (name : Nat) =>
          match source_name_index_lookup [add name Z] error_index with
          | Just _ => False | Nothing => True end) names in
      match eligible with
      | Nil => Nil Nat
      | Cons _ _ =>
          let ref_index : SourceNameIndex := pairs_from refs in
          let symbol_for (name : Nat) : Nat :=
            match source_name_index_lookup [add name Z] ref_index with
            | Just symbol => symbol | Nothing => name end in
          let wanted : SourceNameIndex :=
            (fix collect (remaining : List Nat) (index : SourceNameIndex)
                : SourceNameIndex :=
              match remaining with
              | Nil => index
              | Cons name rest => collect rest
                  (source_name_index_insert [add (symbol_for name) Z] Z index)
              end) eligible SourceNameIndexEmpty in
          let first_members : List ModuleMember :=
            (fix collect (rows : List ModuleMember) (seen : SourceNameIndex)
                (selected : List ModuleMember) : List ModuleMember :=
              match rows with
              | Nil => selected
              | Cons item rest => match item with
                | MkModuleMember _ _ symbol _ =>
                    let key : List Nat := [add symbol Z] in
                    match source_name_index_lookup key wanted with
                    | Nothing => collect rest seen selected
                    | Just _ => match source_name_index_lookup key seen with
                      | Just _ => collect rest seen selected
                      | Nothing => collect rest
                          (source_name_index_insert key Z seen)
                          (Cons ModuleMember item selected)
                      end
                    end
                end
              end) members SourceNameIndexEmpty (Nil ModuleMember) in
          match first_members with
          | Nil => Nil Nat
          | Cons _ _ =>
              let owners : SourceNameIndex :=
                (fix collect (rows : List ModuleMember) (index : SourceNameIndex)
                    : SourceNameIndex :=
                  match rows with
                  | Nil => index
                  | Cons item rest => match item with
                    | MkModuleMember owner _ _ _ => collect rest
                        (source_name_index_insert [add owner Z] Z index)
                    end
                  end) first_members SourceNameIndexEmpty in
              let add_ctors (owner : Nat) (decls : List Decl)
                  (index : SourceNameIndex) : SourceNameIndex :=
                (fix collect (remaining : List Nat) (known : SourceNameIndex)
                    : SourceNameIndex :=
                  match remaining with
                  | Nil => known
                  | Cons short rest => collect rest
                      (source_name_index_insert [add owner Z, add short Z] Z known)
                  end) (module_ctor_names decls) index in
              let ctor_pairs : SourceNameIndex :=
                (fix collect (rows : List SrcUnit) (seen : SourceNameIndex)
                    (index : SourceNameIndex) : SourceNameIndex :=
                  match rows with
                  | Nil => index
                  | Cons unit rest => match unit with
                    | MkSrcUnit owner _ =>
                        let key : List Nat := [add owner Z] in
                        match source_name_index_lookup key owners with
                        | Nothing => collect rest seen index
                        | Just _ => match source_name_index_lookup key seen with
                          | Just _ => collect rest seen index
                          | Nothing => collect rest
                              (source_name_index_insert key Z seen)
                              (add_ctors owner (src_unit_decls unit) index)
                          end
                        end
                    end
                  end) units SourceNameIndexEmpty SourceNameIndexEmpty in
              let ctor_symbols : SourceNameIndex :=
                (fix collect (rows : List ModuleMember) (index : SourceNameIndex)
                    : SourceNameIndex :=
                  match rows with
                  | Nil => index
                  | Cons item rest => match item with
                    | MkModuleMember owner short symbol _ =>
                        match source_name_index_lookup
                            [add owner Z, add short Z] ctor_pairs with
                        | Nothing => collect rest index
                        | Just _ => collect rest
                            (source_name_index_insert [add symbol Z] Z index)
                        end
                    end
                  end) first_members SourceNameIndexEmpty in
              (fix go (remaining : List Nat) : List Nat :=
                match remaining with
                | Nil => Nil Nat
                | Cons name rest =>
                    let tail : List Nat := go rest in
                    match source_name_index_lookup
                        [add (symbol_for name) Z] ctor_symbols with
                    | Just _ => Cons Nat name tail
                    | Nothing => tail
                    end
                end) eligible
          end
      end
  end;

-- Retained names are the unique list from module_all_names for these members.
def module_maps_for_cached_pure (units : List SrcUnit) (aliases : List ModuleAliasUnit)
    (members : List ModuleMember) (conflicts : List Nat)
    (markers : List (Pair (List Nat) Nat))
    (scope_cache : List ModuleExports)
    (st : InternState) (owner : Nat) (cache : Pair Bool (Maybe (List Nat)))
    : ResolveResult (Pair (Pair ModuleMaps (List Nat)) (Maybe (List Nat))) :=
  match cache with
  | MkPair isolate cached_names =>
  match resolve_import_paths units owner with
  | RErr code detail => RErr (Pair (Pair ModuleMaps (List Nat)) (Maybe (List Nat))) code detail
  | ROk visible =>
      let local_aliases : List (Pair (List Nat) Nat) :=
        module_aliases_for owner aliases in
      let rules : List ModuleRule := module_rules_for owner aliases in
      match module_validate_selected st members rules with
      | RErr code detail => RErr (Pair (Pair ModuleMaps (List Nat)) (Maybe (List Nat))) code detail
      | ROk _ =>
          let scoped : ResolveResult (List (Pair Nat Nat)) :=
            match isolate with
            | False => ROk (List (Pair Nat Nat)) (Nil (Pair Nat Nat))
            | True => match module_exports_for owner scope_cache with
              | Nothing => RErr (List (Pair Nat Nat)) 8 owner
              | Just exports => ROk (List (Pair Nat Nat)) exports
              end
            end in
          match scoped with
          | RErr code detail => RErr (Pair (Pair ModuleMaps (List Nat)) (Maybe (List Nat))) code detail
          | ROk exports =>
              let prepared_names : Pair (List Nat) (Maybe (List Nat)) :=
                match isolate with
                | True =>
                    let common : List Nat := match cached_names with
                      | Nothing => module_all_names members
                      | Just retained => retained
                      end in
                    MkPair (List Nat) (Maybe (List Nat))
                      (module_merge_common_names common (module_export_names exports))
                      (Just (List Nat) common)
                | False => MkPair (List Nat) (Maybe (List Nat)) conflicts cached_names
                end in
              match prepared_names with
              | MkPair names next_names =>
              let base_maps : ModuleMaps := match isolate with
                | True => module_scope_maps owner names members exports
                | False => module_unqualified_maps owner visible
                    conflicts members
                end in
              let mapped : ModuleMaps := module_marker_maps units scope_cache
                aliases st owner visible
                local_aliases rules members exports isolate markers base_maps in
              match mapped with
              | MkModuleMaps _ refs errors =>
                  let candidates : List Nat := match isolate with
                    | True => names
                    | False => module_visible_ctors units visible
                    end in
                  ROk (Pair (Pair ModuleMaps (List Nat)) (Maybe (List Nat)))
                    (MkPair (Pair ModuleMaps (List Nat)) (Maybe (List Nat))
                    (MkPair ModuleMaps (List Nat) mapped
                      (append Nat
                        (module_bare_ctors units members refs errors candidates)
                        (module_qualified_ctors units members refs markers)))
                    next_names)
              end
          end
      end
  end
  end
  end;

def module_maps_for (units : List SrcUnit) (aliases : List ModuleAliasUnit)
    (members : List ModuleMember) (conflicts : List Nat)
    (markers : List (Pair (List Nat) Nat))
    (scope_cache : List ModuleExports)
    (st : InternState) (owner : Nat) (isolate : Bool)
    : ResolveResult (Pair ModuleMaps (List Nat)) :=
  module_result_map
    (Pair (Pair ModuleMaps (List Nat)) (Maybe (List Nat)))
    (Pair ModuleMaps (List Nat))
    (fun (result : Pair (Pair ModuleMaps (List Nat)) (Maybe (List Nat))) =>
      match result with | MkPair maps _ => maps end)
    (module_maps_for_cached_pure units aliases members conflicts markers scope_cache st owner
      (MkPair Bool (Maybe (List Nat)) isolate (Nothing (List Nat))));

def module_rewrite_unit_cached_pure
    (shared_names : Pair (Pair (Pair (List SrcUnit) (List ModuleAliasUnit))
      (Pair (Pair (List ModuleMember) (List Nat))
        (Pair (List (Pair (List Nat) Nat)) (List ModuleExports)))) (Maybe (List Nat)))
    (fuel : Nat) (marker_ids : List Nat) (current : InternState)
    (isolate : Bool) (owner : Nat) (body : Pair (List Decl) (List Nat))
    : ResolveResult (Pair (Pair SrcUnit InternState) (Maybe (List Nat))) :=
  match shared_names with
  | MkPair shared cached_names =>
  match shared with
  | MkPair unit_inputs scope_inputs => match unit_inputs with
    | MkPair units aliases => match scope_inputs with
      | MkPair member_inputs marker_inputs => match member_inputs with
        | MkPair members conflicts => match marker_inputs with
          | MkPair markers scope_cache => match body with
            | MkPair decls private_names =>
                match module_maps_for_cached_pure units aliases members conflicts
                    markers scope_cache current owner
                    (MkPair Bool (Maybe (List Nat)) isolate cached_names) with
                | RErr code detail => RErr (Pair (Pair SrcUnit InternState) (Maybe (List Nat))) code detail
                | ROk cached_maps => match cached_maps with
                  | MkPair scoped_maps next_names => match scoped_maps with
                  | MkPair maps constructors => match maps with
                    | MkModuleMaps heads refs errors =>
                        match module_binder_maps current marker_ids refs with
                        | RErr code detail => RErr (Pair (Pair SrcUnit InternState) (Maybe (List Nat))) code detail
                        | ROk allocation => match allocation with
                          | MkPair binders next_st =>
                              let opens : List ModuleOpen :=
                                module_opens_for units next_st owner
                                  (module_rules_for owner aliases) members
                                  (module_aliases_for owner aliases) in
                              let pure_label : Nat :=
                                match module_ident_id next_st name_pure with
                                | Nothing => 0 | Just name => name end in
                              match module_rewrite_decls_with_opens_pure fuel
                                  heads refs errors opens marker_ids
                                  constructors binders pure_label decls with
                              | RErr code detail =>
                                  RErr (Pair (Pair SrcUnit InternState) (Maybe (List Nat))) code detail
                              | ROk updated =>
                                  ROk (Pair (Pair SrcUnit InternState) (Maybe (List Nat)))
                                    (MkPair (Pair SrcUnit InternState) (Maybe (List Nat))
                                      (MkPair SrcUnit InternState
                                      (mk_src_unit owner updated private_names) next_st) next_names)
                              end
                          end
                        end
                    end
                  end
                end
            end
          end
        end
      end
    end
  end
  end
  end;

def module_rewrite_unit_pure
    (shared : Pair (Pair (List SrcUnit) (List ModuleAliasUnit))
      (Pair (Pair (List ModuleMember) (List Nat))
        (Pair (List (Pair (List Nat) Nat)) (List ModuleExports))))
    (fuel : Nat) (marker_ids : List Nat) (current : InternState)
    (isolate : Bool) (owner : Nat) (body : Pair (List Decl) (List Nat))
    : ResolveResult (Pair SrcUnit InternState) :=
  module_result_map
    (Pair (Pair SrcUnit InternState) (Maybe (List Nat)))
    (Pair SrcUnit InternState)
    (fun (result : Pair (Pair SrcUnit InternState) (Maybe (List Nat))) =>
      match result with | MkPair unit_state _ => unit_state end)
    (module_rewrite_unit_cached_pure
      (MkPair (Pair (Pair (List SrcUnit) (List ModuleAliasUnit))
      (Pair (Pair (List ModuleMember) (List Nat))
        (Pair (List (Pair (List Nat) Nat)) (List ModuleExports)))) (Maybe (List Nat)) shared (Nothing (List Nat)))
      fuel marker_ids current isolate owner body);

def module_rewrite_units_with_metadata (retain_slots : Bool) (fuel : Nat) (units : List SrcUnit)
    (reached : List Nat) (aliases : List ModuleAliasUnit)
    (members : List ModuleMember) (conflicts : List Nat)
    (markers : List (Pair (List Nat) Nat)) (marker_ids : List Nat)
    (scope_cache : List ModuleExports) (st : InternState) (isolate : Bool)
    : ResolveResult ModuleResolvedUnits :=
  let shared : Pair (Pair (List SrcUnit) (List ModuleAliasUnit))
      (Pair (Pair (List ModuleMember) (List Nat))
        (Pair (List (Pair (List Nat) Nat)) (List ModuleExports))) :=
    MkPair (Pair (List SrcUnit) (List ModuleAliasUnit))
      (Pair (Pair (List ModuleMember) (List Nat))
        (Pair (List (Pair (List Nat) Nat)) (List ModuleExports)))
      (MkPair (List SrcUnit) (List ModuleAliasUnit) units aliases)
      (MkPair (Pair (List ModuleMember) (List Nat))
        (Pair (List (Pair (List Nat) Nat)) (List ModuleExports))
        (MkPair (List ModuleMember) (List Nat) members conflicts)
        (MkPair (List (Pair (List Nat) Nat)) (List ModuleExports) markers scope_cache)) in
  (fix go (remaining : List SrcUnit) (current : InternState)
      (cached_names : Maybe (List Nat)) : ResolveResult ModuleResolvedUnits :=
    match remaining with
    | Nil => ROk ModuleResolvedUnits
        (ModuleResolvedUnitsOf (MkPair (List SrcUnit) InternState (Nil SrcUnit) current) [])
    | Cons unit rest =>
        match unit with
        | MkSrcUnit owner body =>
            let decls : List Decl := src_unit_decls unit in
            match memNat owner reached with
            | False =>
                match go rest current cached_names with
                | RErr code detail =>
                    RErr ModuleResolvedUnits code detail
                | ROk tail => match tail with
                    | ModuleResolvedUnitsOf result slots => match result with | MkPair rewritten final_st =>
                        ROk ModuleResolvedUnits
                          (ModuleResolvedUnitsOf
                            (MkPair (List SrcUnit) InternState
                              (Cons SrcUnit unit rewritten) final_st) slots)
                    end end
                end
            | True =>
                match module_rewrite_unit_cached_pure
                    (MkPair (Pair (Pair (List SrcUnit) (List ModuleAliasUnit))
      (Pair (Pair (List ModuleMember) (List Nat))
        (Pair (List (Pair (List Nat) Nat)) (List ModuleExports)))) (Maybe (List Nat)) shared cached_names)
                    fuel marker_ids current isolate owner body with
                | RErr code detail => RErr ModuleResolvedUnits code detail
                | ROk updated => match updated with
                  | MkPair unit_state next_names => match unit_state with
                  | MkPair updated_unit next_st =>
                      match go rest next_st next_names with
                      | RErr code detail => RErr ModuleResolvedUnits code detail
                      | ROk tail => match tail with
                        | ModuleResolvedUnitsOf result slots => match result with
                          | MkPair rewritten final_st =>
                              ROk ModuleResolvedUnits
                                (ModuleResolvedUnitsOf
                                  (MkPair (List SrcUnit) InternState
                                    (Cons SrcUnit updated_unit rewritten) final_st)
                                  (match retain_slots with
                                   | False => slots
                                   | True => append SourceModuleSlot
                                       (source_module_slot_relation owner decls
                                         (src_unit_decls updated_unit)) slots
                                   end))
                          end
                        end
                      end
                  end
                end
            end
        end
    end
    end) units st (Nothing (List Nat));

def module_rewrite_units (fuel : Nat) (units : List SrcUnit)
    (reached : List Nat) (aliases : List ModuleAliasUnit)
    (members : List ModuleMember) (conflicts : List Nat)
    (markers : List (Pair (List Nat) Nat)) (marker_ids : List Nat)
    (scope_cache : List ModuleExports) (st : InternState) (isolate : Bool)
    : ResolveResult (Pair (List SrcUnit) InternState) :=
  module_resolved_units_project
    (module_rewrite_units_with_metadata False fuel units reached aliases members conflicts
      markers marker_ids scope_cache st isolate);

def module_resolve_units_with_metadata (retain_slots : Bool) (fuel : Nat) (units : List SrcUnit)
    (alias_files : List (Pair (List Nat) ImpReg))
    (root : Nat) (st : InternState)
    : ResolveResult ModuleResolvedUnits :=
  match module_validate_private units with
  | RErr code detail => RErr ModuleResolvedUnits code detail
  | ROk _ => match module_duplicate_units units with
  | Just _ => RErr ModuleResolvedUnits 8 0
  | Nothing => match orb(module_has_aliases alias_files,
      module_has_any_private units) with
  | False => ROk ModuleResolvedUnits
      (ModuleResolvedUnitsOf (MkPair (List SrcUnit) InternState units st)
        (match retain_slots with | False => [] | True => source_module_unit_slots units end))
  | True => match resolve_import_paths units root with
  | RErr code detail => RErr ModuleResolvedUnits code detail
  | ROk reached =>
      match module_alias_units st alias_files with
      | RErr code detail => RErr ModuleResolvedUnits code detail
      | ROk aliases =>
          match orb(module_has_reached_aliases reached aliases,
              module_has_private reached units) with
          | False => ROk ModuleResolvedUnits
              (ModuleResolvedUnitsOf (MkPair (List SrcUnit) InternState units st)
                (match retain_slots with | False => [] | True => source_module_unit_slots units end))
          | True =>
          let seeds : List (Pair Nat Nat) := module_seed_units units reached in
          let conflicts : List Nat := module_conflict_names seeds in
          let isolate : Bool := orb(module_has_reached_selection reached aliases,
            module_has_private reached units) in
          let public_collision : Maybe Nat :=
            match orb(notb(module_has_private reached units),
                orb(module_has_reached_selection reached aliases,
                  module_has_alias_bindings reached aliases)) with
            | True => Nothing Nat
            | False => module_public_collision seeds units
            end in
          match public_collision with
          | Just name => RErr ModuleResolvedUnits 6 name
          | Nothing => match module_legacy_special_collision st conflicts with
          | Just name =>
              RErr ModuleResolvedUnits 6 name
          | Nothing =>
          let markers : List (Pair (List Nat) Nat) := module_marker_ids st in
          let marker_ids : List Nat :=
            map (Pair(List Nat, Nat)) Nat
              (fun (item : Pair (List Nat) Nat) =>
                match item with | MkPair _ id => id end) markers in
          match module_members st root reached conflicts seeds units isolate with
          | RErr code detail => RErr ModuleResolvedUnits code detail
          | ROk built =>
              match built with
              | MkPair members st2 =>
                  let scopes : ResolveResult (List ModuleExports) :=
                    match isolate with
                    | False => ROk (List ModuleExports) (Nil ModuleExports)
                    | True => module_export_cache units reached aliases members st2
                    end in
                  match scopes with
                  | RErr code detail =>
                      RErr ModuleResolvedUnits code detail
                  | ROk cache =>
                      module_rewrite_units_with_metadata retain_slots fuel units reached aliases
                        members conflicts markers marker_ids cache st2 isolate
                  end
              end
          end
          end
          end
          end
      end
  end
  end
  end
  end;

def module_resolve_units_with_slots (fuel : Nat) (units : List SrcUnit)
    (alias_files : List (Pair (List Nat) ImpReg))
    (root : Nat) (st : InternState) : ResolveResult ModuleResolvedUnits :=
  module_resolve_units_with_metadata True fuel units alias_files root st;

def module_resolve_units (fuel : Nat) (units : List SrcUnit)
    (alias_files : List (Pair (List Nat) ImpReg))
    (root : Nat) (st : InternState)
    : ResolveResult (Pair (List SrcUnit) InternState) :=
  module_resolved_units_project
    (module_resolve_units_with_metadata False fuel units alias_files root st);
