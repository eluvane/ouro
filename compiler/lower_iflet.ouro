-- A flat constructor test expands to a complete checked case.

import "lower_spread.ouro";

def iflet_is_hole (term : Surface) : Bool :=
  match term with
  | SHole _ => True
  | SVar _ => False
  | SSort _ => False
  | SLam _ _ _ => False
  | SApp _ _ => False
  | SLet _ _ _ _ => False
  | SConst _ => False
  | SInd _ => False
  | SConstruct _ _ _ => False
  | SCase _ _ _ _ => False
  | SFix _ _ _ _ _ => False
  | SEffectRow _ => False
  | SPerform _ _ => False
  | SStr _ _ => False
  | SPi _ _ _ => False
  end;

inductive IfLetPi : Type :=
  | IfLetNoPi : IfLetPi
  | IfLetHasPi : Nat -> Surface -> Surface -> IfLetPi;

def iflet_pi (term : Surface) : IfLetPi :=
  match term with
  | SPi binder domain codomain => IfLetHasPi binder domain codomain
  | SVar _ => IfLetNoPi
  | SSort _ => IfLetNoPi
  | SLam _ _ _ => IfLetNoPi
  | SApp _ _ => IfLetNoPi
  | SLet _ _ _ _ => IfLetNoPi
  | SConst _ => IfLetNoPi
  | SInd _ => IfLetNoPi
  | SConstruct _ _ _ => IfLetNoPi
  | SCase _ _ _ _ => IfLetNoPi
  | SFix _ _ _ _ _ => IfLetNoPi
  | SHole _ => IfLetNoPi
  | SEffectRow _ => IfLetNoPi
  | SPerform _ _ => IfLetNoPi
  | SStr _ _ => IfLetNoPi
  end;

def iflet_instantiate_params (typ : Surface) (params : List Surface)
    : Maybe Surface :=
  (fix go (remaining : List Surface) (current : Surface) : Maybe Surface :=
    match remaining with
    | Nil => Just Surface current
    | Cons value rest =>
        match iflet_pi current with
        | IfLetNoPi => Nothing Surface
        | IfLetHasPi binder _ codomain =>
            go rest (surface_subst_name binder value codomain)
        end
    end) params typ;

def iflet_unique_names (names : List Nat) : Bool :=
  (fix go (remaining : List Nat) : Bool :=
    match remaining with
    | Nil => True
    | Cons name rest =>
        andb (orb (eqNat name Z) (notb (memNat(name, rest))))
          (go rest)
    end) names;

def iflet_bindings (names : List Nat) (typ : Surface) (fresh : Nat)
    : Maybe (List (Pair Nat Surface)) :=
  (fix go (remaining : List Nat) (current : Surface) (next : Nat)
      : Maybe (List (Pair Nat Surface)) :=
    match remaining with
    | Nil => Just (List (Pair Nat Surface)) (Nil (Pair Nat Surface))
    | Cons source_name rest =>
        match iflet_pi current with
        | IfLetNoPi => Nothing (List (Pair Nat Surface))
        | IfLetHasPi binder domain codomain =>
            let name : Nat :=
              match eqNat source_name Z with
              | True => next
              | False => source_name
              end in
            match go rest (surface_subst_name binder (SVar name) codomain)
                (S next) with
            | Nothing => Nothing (List (Pair Nat Surface))
            | Just tail =>
                Just (List (Pair Nat Surface))
                  (Cons (Pair Nat Surface)
                    (MkPair Nat Surface name domain) tail)
            end
        end
    end) names typ fresh;

def iflet_wrap (binders : List (Pair Nat Surface)) (body : Surface)
    : Surface :=
  (fix go (remaining : List (Pair Nat Surface)) : Surface :=
    match remaining with
    | Nil => body
    | Cons binding rest =>
        match binding with
        | MkPair name domain => SLam name domain (go rest)
        end
    end) binders;

def iflet_binding_types_valid (locals : List (Pair Nat Surface))
    (binders : List (Pair Nat Surface)) : Bool :=
  (fix go (remaining : List (Pair Nat Surface))
      (scope : List (Pair Nat Surface)) : Bool :=
    match remaining with
    | Nil => True
    | Cons binding rest =>
        match binding with
        | MkPair name domain =>
            andb (notb (surface_hint_has_placeholder scope fuel1k domain))
              (go rest (cons_local name domain scope))
        end
    end) binders locals;

def iflet_motive_binders (typ : Surface) (count : Nat) (fresh : Nat)
    : Maybe (List (Pair Nat Surface)) :=
  (fix go (remaining : Nat) (current : Surface) (next : Nat)
      : Maybe (List (Pair Nat Surface)) :=
    match remaining with
    | Z => Just (List (Pair Nat Surface)) (Nil (Pair Nat Surface))
    | S rest =>
        match iflet_pi current with
        | IfLetNoPi => Nothing (List (Pair Nat Surface))
        | IfLetHasPi binder domain codomain =>
            match go rest (surface_subst_name binder (SVar next) codomain)
                (S next) with
            | Nothing => Nothing (List (Pair Nat Surface))
            | Just tail =>
                Just (List (Pair Nat Surface))
                  (Cons (Pair Nat Surface)
                    (MkPair Nat Surface next domain) tail)
            end
        end
    end) count typ fresh;

def iflet_motive (env : LowerEnv) (family : Nat) (nparams : Nat)
    (result : Surface) (fresh : Nat) : Maybe Surface :=
  match lookup_decl_type env family with
  | Nothing => Nothing Surface
  | Just family_type =>
      let motive_fresh : Nat :=
        S (maxNat fresh (fallible_max_var family_type)) in
      match iflet_motive_binders family_type nparams motive_fresh with
      | Nothing => Nothing Surface
      | Just binders =>
          let args : List Surface :=
            map (Pair Nat Surface) Surface
              (fun (binding : Pair Nat Surface) =>
                match binding with
                | MkPair name _ => SVar name
                end) binders in
          let subject_binder : Nat := add motive_fresh nparams in
          Just Surface (iflet_wrap binders
            (SLam subject_binder (apply_params family args) result))
      end
  end;

def iflet_other_branch (env : LowerEnv) (family : Nat) (index : Nat)
    (params : List Surface) (body : Surface) (fresh : Nat)
    : Maybe Surface :=
  match lookup_ctor_type env family index with
  | Nothing => Nothing Surface
  | Just ctor_type =>
      match iflet_instantiate_params ctor_type params with
      | Nothing => Nothing Surface
      | Just fields =>
          let next : Nat := S (maxNat fresh (fallible_max_var fields)) in
          let arity : Nat := arity_at family index (env_ctors env) in
          (fix wrap (remaining : Nat) (current : Surface) (name : Nat)
              : Maybe Surface :=
            match remaining with
            | Z => Just Surface body
            | S count =>
                match iflet_pi current with
                | IfLetNoPi => Nothing Surface
                | IfLetHasPi binder domain codomain =>
                    match wrap count
                        (surface_subst_name binder (SVar name) codomain)
                        (S name) with
                    | Nothing => Nothing Surface
                    | Just inner => Just Surface (SLam name domain inner)
                    end
                end
            end) arity fields next
      end
  end;

def iflet_branches (env : LowerEnv) (family : Nat) (params : List Surface)
    (chosen : Nat) (success : Surface) (fallback : Surface) (fresh : Nat)
    : Maybe (List Surface) :=
  let count : Nat := count_ctors_ind family (env_ctors env) in
  (fix go (remaining : Nat) (index : Nat) : Maybe (List Surface) :=
    match remaining with
    | Z => Just (List Surface) (Nil Surface)
    | S rest =>
        let current : Maybe Surface :=
          match eqNat index chosen with
          | True => Just Surface success
          | False => iflet_other_branch env family index params fallback fresh
          end in
        match current, go rest (S index) with
        | Just branch, Just tail => Just (List Surface) (Cons Surface branch tail)
        | Nothing, Just _ => Nothing (List Surface)
        | Just _, Nothing => Nothing (List Surface)
        | Nothing, Nothing => Nothing (List Surface)
        end
    end) count Z;

def iflet_finish
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat ->
    List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel : Nat) (env : LowerEnv) (fixSelf : Maybe Nat)
  (locals : List (Pair Nat Surface)) (ctor : CtorInfo)
  (names : List Nat) (params : List Surface) (fields : Surface)
  (input : Surface) (fallback : Surface) (result_type : Surface)
  (fresh : Nat) (yes : Expr) : LowerVal :=
  match iflet_is_hole input with
  | True => VSurf hole0
  | False => match iflet_is_hole fallback with
    | True => VSurf hole0
    | False =>
      match iflet_bindings names fields fresh with
      | Nothing => VSurf hole0
      | Just binders =>
          let branch_locals : List (Pair Nat Surface) :=
            extend_locals binders locals in
          match orb
              (surface_hint_has_placeholder branch_locals fuel1k result_type)
              (notb (iflet_binding_types_valid locals binders)) with
          | True => VSurf hole0
          | False =>
              match lower_run fuel env (Just Surface result_type)
                  fixSelf branch_locals (LExpr yes) with
              | VSurf success =>
                  match iflet_is_hole success with
                  | True => VSurf hole0
                  | False =>
                      let family : Nat := ctor_indId ctor in
                      let nparams : Nat := ctor_nparams ctor in
                      match iflet_motive env family nparams result_type fresh,
                          iflet_branches env family params (ctor_idx ctor)
                            (iflet_wrap binders success) fallback fresh with
                      | Just motive, Just branches =>
                          let selected : Surface :=
                            SCase (MkCaseInfo family nparams
                              (arities_in_ctor_order env family))
                              motive input branches in
                          match eqNat (count_ctors_ind family (env_ctors env)) 1 with
                          | False => VSurf selected
                          | True =>
                              -- A one-constructor case has no fallback branch;
                              -- a dead thunk keeps its source else checked.
                              let unused : Nat := S (maxNat
                                (fallible_max_var selected)
                                (fallible_max_var fallback)) in
                              let arg : Nat := S unused in
                              VSurf (SLet unused
                                (SLam arg (SSort Z) fallback)
                                (SPi arg (SSort Z) result_type)
                                selected)
                          end
                      | Nothing, Just _ => VSurf hole0
                      | Just _, Nothing => VSurf hole0
                      | Nothing, Nothing => VSurf hole0
                      end
                  end
              | VBranchPairs _ => VSurf hole0
              | VBinderPairs _ => VSurf hole0
              | VSurfList _ => VSurf hole0
              end
          end
      end
    end
  end;

def iflet_lower_typed
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat ->
    List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel : Nat) (env : LowerEnv) (expected : Maybe Surface)
  (fixSelf : Maybe Nat) (locals : List (Pair Nat Surface))
  (ctor : CtorInfo) (names : List Nat) (params : List Surface)
  (input : Surface) (input_type : Surface) (whole : Expr)
  (yes : Expr) (no : Expr) : LowerVal :=
  let family : Nat := ctor_indId ctor in
  match lookup_ctor_type env family (ctor_idx ctor) with
  | Nothing => VSurf hole0
  | Just ctor_type =>
      match iflet_instantiate_params ctor_type params with
      | Nothing => VSurf hole0
      | Just fields =>
          let fallback : Surface := vsurf_or_hole
            (lower_run fuel env expected fixSelf locals (LExpr no)) in
          let result : Maybe Surface :=
            match expected with
            | Just typ => Just Surface typ
            | Nothing => surface_type_hint env locals fuel1k fallback
            end in
          match result with
          | Nothing => VSurf hole0
          | Just result_type =>
              match spread_max_expr fuel1k whole with
              | Nothing => VSurf hole0
              | Just source_max =>
                  let fresh : Nat := S (maxNat source_max
                    (maxNat (fallible_max_var input)
                      (maxNat (fallible_max_var input_type)
                        (maxNat (fallible_max_var fallback)
                          (maxNat (fallible_max_var result_type)
                            (fallible_max_var ctor_type)))))) in
                  iflet_finish lower_run fuel env fixSelf locals ctor
                    names params fields input fallback result_type fresh yes
              end
          end
      end
  end;

def lower_xviflet
  (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat ->
    List (Pair Nat Surface) -> LowerMode -> LowerVal)
  (fuel : Nat) (env : LowerEnv) (expected : Maybe Surface)
  (fixSelf : Maybe Nat) (locals : List (Pair Nat Surface))
  (pattern : List Nat) (subject : Expr) (yes : Expr) (no : Expr)
  : LowerVal :=
  match pattern with
  | Nil => VSurf hole0
  | Cons ctor_name names =>
      match lookup_ctor(ctor_name, env_ctors env) with
      | Nothing => VSurf hole0
      | Just ctor =>
          let family : Nat := ctor_indId ctor in
          let nparams : Nat := ctor_nparams ctor in
          let input : Surface := vsurf_or_hole
            (lower_run fuel env (Nothing Surface) fixSelf locals
              (LExpr subject)) in
          let input_annotation : Maybe Expr :=
            match view_expr subject with
            | XVAscribe _ annotation => Just Expr annotation
            | XVVar _ => Nothing Expr
            | XVHole _ => Nothing Expr
            | XVSort _ => Nothing Expr
            | XVNat _ => Nothing Expr
            | XVStr _ => Nothing Expr
            | XVApp _ _ => Nothing Expr
            | XVLam _ _ _ => Nothing Expr
            | XVPi _ _ _ => Nothing Expr
            | XVLet _ _ _ _ => Nothing Expr
            | XVMatch _ _ => Nothing Expr
            | XVFix _ _ _ _ => Nothing Expr
            | XVEffectRow _ _ => Nothing Expr
            | XVPerform _ _ => Nothing Expr
            | XVDo _ => Nothing Expr
            | XVList _ => Nothing Expr
            | XVListSpread _ _ => Nothing Expr
            | XVRange _ _ _ => Nothing Expr
            | XVHandle _ _ => Nothing Expr
            | XVFallible _ _ _ _ => Nothing Expr
            | XVNamedCall _ _ => Nothing Expr
            | XVUnsupported => Nothing Expr
            | XVIf _ _ _ => Nothing Expr
            | XVIfLet _ _ _ _ => Nothing Expr
            end in
          let input_hint : Maybe Surface :=
            match input_annotation with
            | Just annotation =>
                Just Surface (vsurf_or_hole
                  (lower_run fuel env (Nothing Surface) fixSelf locals
                    (LExpr annotation)))
            | Nothing => surface_type_hint env locals fuel1k input
            end in
          match input_hint with
          | Nothing => VSurf hole0
          | Just input_type =>
              match peel_ind_apps input_type with
              | Nothing => VSurf hole0
              | Just family_args =>
                  match family_args with
                  | MkPair actual_family params =>
                      let shape : Bool :=
                        andb (eqNat actual_family family)
                          (andb (eqNat(length Surface params, nparams))
                            (andb (eqNat(length Nat names, ctor_arity ctor))
                              (andb (iflet_unique_names names)
                                (notb (surface_hint_has_placeholder
                                  locals fuel1k input_type))))) in
                      match shape with
                      | False => VSurf hole0
                      | True =>
                          iflet_lower_typed lower_run fuel env expected fixSelf
                            locals ctor names params input input_type
                            (EIfLet pattern subject yes no) yes no
                      end
                  end
              end
          end
      end
  end;
