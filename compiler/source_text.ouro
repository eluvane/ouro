-- Shared byte-level source operations for lexer, preprocessing and diagnostics.
-- No parser, registry, filesystem or error policy belongs in this cone.

import "../std/natx.ouro",
  "../std/utf8_scalar.ouro";

-- Byte predicates run per character. Cache numeral values so generated code
-- does not rebuild Peano literals on each comparison.
def source_ch_space : Nat := 32;
def source_ch_tab : Nat := 9;
def source_ch_lf : Nat := 10;
def source_ch_cr : Nat := 13;
def source_ch_zero : Nat := 48;
def source_ch_nine : Nat := 57;
def source_ch_upper_a : Nat := 65;
def source_ch_upper_z : Nat := 90;
def source_ch_lower_a : Nat := 97;
def source_ch_lower_z : Nat := 122;
def source_ch_under : Nat := 95;
def source_ch_quote : Nat := 39;
def source_ch_double_quote : Nat := 34;
def source_ch_backslash : Nat := 92;
def source_ch_hash : Nat := 35;
def source_ch_raw_r : Nat := 114;
def source_ch_dash : Nat := 45;

def source_is_ws (c : Nat) : Bool :=
  orb (eq_nat c source_ch_space)
    (orb(eq_nat c source_ch_tab, orb(eq_nat c source_ch_lf, eq_nat c source_ch_cr)));

def source_is_digit (c : Nat) : Bool :=
  andb(leb_nat source_ch_zero c, leb_nat c source_ch_nine);

def source_is_alpha (c : Nat) : Bool :=
  orb (andb(leb_nat source_ch_upper_a c, leb_nat c source_ch_upper_z))
      (andb(leb_nat source_ch_lower_a c, leb_nat c source_ch_lower_z));

def source_is_ident_start (c : Nat) : Bool :=
  orb(source_is_alpha c, eq_nat c source_ch_under);

def source_is_ident_char (c : Nat) : Bool :=
  orb(source_is_ident_start c, orb(source_is_digit c, eq_nat c source_ch_quote));

def source_hex_digit (c : Nat) : Maybe Nat :=
  match source_is_digit c with
  | True => Just Nat (sub c source_ch_zero)
  | False =>
      match andb(leb_nat 65 c, leb_nat c 70) with
      | True => Just Nat (add 10 (sub c 65))
      | False =>
          match andb(leb_nat 97 c, leb_nat c 102) with
          | True => Just Nat (add 10 (sub c 97))
          | False => Nothing Nat
          end
      end
  end;

-- Input begins at the opening brace after \u. Reject malformed scalar escapes.
def source_unicode_braced (input : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match input with
  | Nil => Nothing (Pair (List Nat) (List Nat))
  | Cons brace rest =>
      match eq_nat brace 123 with
      | False => Nothing (Pair (List Nat) (List Nat))
      | True =>
          (fix digits (left : Nat) (xs : List Nat) (value : Nat) (seen : Bool)
              : Maybe (Pair (List Nat) (List Nat)) :=
            match xs with
            | Nil => Nothing (Pair (List Nat) (List Nat))
            | Cons c tail =>
                match eq_nat c 125 with
                | True =>
                    match seen with
                    | False => Nothing (Pair (List Nat) (List Nat))
                    | True =>
                        match utf8_scalar_checked value with
                        | Nothing => Nothing (Pair (List Nat) (List Nat))
                        | Just bytes => Just(Pair (List Nat) (List Nat),
                            MkPair(List Nat, List Nat, bytes, tail))
                        end
                    end
                | False =>
                    match left with
                    | Z => Nothing (Pair (List Nat) (List Nat))
                    | S remaining =>
                        match source_hex_digit c with
                        | Nothing => Nothing (Pair (List Nat) (List Nat))
                        | Just digit => digits remaining tail
                            (add(mul 16 value, digit)) True
                        end
                    end
                end
            end) 6 rest Z False
      end
  end;

-- Decode one canonical UTF-8 scalar, retaining the original byte tail.
def source_scalar_cont : Nat -> List Nat -> Nat -> Nat -> Maybe (Pair Nat (List Nat)) :=
  fix go (remaining : Nat) (src : List Nat) (value : Nat) (minimum : Nat)
      : Maybe (Pair Nat (List Nat)) :=
    match remaining with
    | Z =>
        match andb(leb_nat minimum value, utf8_scalar_valid value) with
        | True => Just(Pair Nat (List Nat), MkPair Nat (List Nat) value src)
        | False => Nothing (Pair Nat (List Nat))
        end
    | S left => match src with
      | Nil => Nothing (Pair Nat (List Nat))
      | Cons byte rest =>
          match andb(leb_nat 128 byte, ltb_nat byte 192) with
          | False => Nothing (Pair Nat (List Nat))
          | True => go left rest (add(mul value 64, sub byte 128)) minimum
          end
      end
    end;

def source_take_scalar (src : List Nat) : Maybe (Pair Nat (List Nat)) :=
  match src with
  | Nil => Nothing (Pair Nat (List Nat))
  | Cons byte rest =>
      match ltb_nat byte 128 with
      | True => Just(Pair Nat (List Nat), MkPair Nat (List Nat) byte rest)
      | False =>
          match andb(leb_nat 194 byte, ltb_nat byte 224) with
          | True => source_scalar_cont 1 rest (sub byte 192) 128
          | False =>
              match andb(leb_nat 224 byte, ltb_nat byte 240) with
              | True => source_scalar_cont 2 rest (sub byte 224) (mul 32 64)
              | False =>
                  match andb(leb_nat 240 byte, leb_nat byte 244) with
                  | True => source_scalar_cont 3 rest (sub byte 240) (mul 16 (mul 64 64))
                  | False => Nothing (Pair Nat (List Nat))
                  end
              end
          end
      end
  end;

def source_scalar_only (src : List Nat) : Maybe Nat :=
  match source_take_scalar src with
  | Nothing => Nothing Nat
  | Just decoded => match decoded with
    | MkPair value rest => match rest with
      | Nil => Just Nat value
      | Cons _ _ => Nothing Nat
      end
    end
  end;

def source_char_escape (src : List Nat) : Maybe Nat :=
  match src with
  | Nil => Nothing Nat
  | Cons byte rest =>
      match eq_nat byte 117 with
      | True => match source_unicode_braced rest with
        | Nothing => Nothing Nat
        | Just decoded => match decoded with
          | MkPair bytes after => match after with
            | Nil => source_scalar_only bytes
            | Cons _ _ => Nothing Nat
            end
          end
        end
      | False => match rest with
        | Cons _ _ => Nothing Nat
        | Nil =>
            match eq_nat byte 110 with
            | True => Just Nat source_ch_lf
            | False => match eq_nat byte 116 with
              | True => Just Nat source_ch_tab
              | False => match eq_nat byte 114 with
                | True => Just Nat source_ch_cr
                | False => match orb(eq_nat byte source_ch_quote,
                    orb(eq_nat byte source_ch_double_quote,
                        eq_nat byte source_ch_backslash)) with
                  | True => Just Nat byte
                  | False => Nothing Nat
                  end
                end
              end
            end
        end
      end
  end;

def source_char_payload (src : List Nat) : Maybe Nat :=
  match src with
  | Nil => Nothing Nat
  | Cons byte rest =>
      match eq_nat byte source_ch_backslash with
      | True => source_char_escape rest
      | False => source_scalar_only src
      end
  end;

-- A scalar spelling needs at most twelve bytes, including both quotes.
def source_take_character (fuel : Nat) (src : List Nat)
    : Maybe (Pair Nat (List Nat)) :=
  match fuel with
  | Z => Nothing (Pair Nat (List Nat))
  | S remaining => match src with
    | Nil => Nothing (Pair Nat (List Nat))
    | Cons opening rest => match eq_nat opening source_ch_quote with
      | False => Nothing (Pair Nat (List Nat))
      | True =>
          let budget : Nat := match leb_nat remaining 11 with
            | True => remaining | False => 11 end in
          (fix body (left : Nat) (xs : List Nat) (escaped : Bool) (acc : List Nat)
              : Maybe (Pair Nat (List Nat)) :=
            match left with
            | Z => Nothing (Pair Nat (List Nat))
            | S next => match xs with
              | Nil => Nothing (Pair Nat (List Nat))
              | Cons byte tail =>
                  match orb(eq_nat byte source_ch_lf, eq_nat byte source_ch_cr) with
                  | True => Nothing (Pair Nat (List Nat))
                  | False => match andb(notb escaped, eq_nat byte source_ch_quote) with
                    | True => match source_char_payload (reverse Nat acc) with
                      | Nothing => Nothing (Pair Nat (List Nat))
                      | Just value => Just(Pair Nat (List Nat), MkPair Nat (List Nat) value tail)
                      end
                    | False => body next tail
                        (andb(notb escaped, eq_nat byte source_ch_backslash)) (Cons Nat byte acc)
                    end
                  end
              end
            end) budget rest False (Nil Nat)
      end
    end
  end;

def source_bytes_equal : List Nat -> List Nat -> Bool :=
  fix source_bytes_equal (xs : List Nat) (ys : List Nat) : Bool :=
    match xs with
    | Nil =>
        match ys with
        | Nil => True
        | Cons _ _ => False
        end
    | Cons x xs' =>
        match ys with
        | Nil => False
        | Cons y ys' =>
            match eq_nat x y with
            | True => source_bytes_equal xs' ys'
            | False => False
            end
        end
    end;

def source_starts : List Nat -> List Nat -> Bool :=
  fix source_starts (pat : List Nat) (xs : List Nat) : Bool :=
    match pat with
    | Nil => True
    | Cons p ps =>
        match xs with
        | Nil => False
        | Cons x xs' =>
            match eq_nat p x with
            | True => source_starts ps xs'
            | False => False
            end
        end
    end;

def source_drop_prefix : List Nat -> List Nat -> List Nat :=
  fix source_drop_prefix (pat : List Nat) (xs : List Nat) : List Nat :=
    match pat with
    | Nil => xs
    | Cons _ ps =>
        match xs with
        | Nil => Nil Nat
        | Cons _ xs' => source_drop_prefix ps xs'
        end
    end;

def source_raw_prefix : List Nat :=
  [source_ch_raw_r, source_ch_hash, source_ch_double_quote];

def source_is_raw_start (src : List Nat) : Bool :=
  source_starts source_raw_prefix src;

-- Identifier primes remain part of their word; a consumed literal resets this context.
def source_char_boundary (previous_ident : Bool) (src : List Nat) : Bool :=
  match src with
  | Nil => False
  | Cons byte _ => andb(notb previous_ident, eq_nat byte source_ch_quote)
  end;

def source_is_literal_start (previous_ident : Bool) (src : List Nat) : Bool :=
  match src with
  | Nil => False
  | Cons byte _ =>
      orb(eq_nat byte source_ch_double_quote,
        orb(source_is_raw_start src, source_char_boundary previous_ident src))
  end;

-- Nothing leaves the scan unbounded; Just n allows exactly n source bytes.
def source_raw_budget_step (budget : Maybe Nat) : Maybe (Maybe Nat) :=
  match budget with
  | Nothing => Just (Maybe Nat) (Nothing Nat)
  | Just left =>
      match left with
      | Z => Nothing (Maybe Nat)
      | S remaining => Just (Maybe Nat) (Just Nat remaining)
      end
  end;

def source_raw_budget_has_byte (budget : Maybe Nat) : Bool :=
  match budget with
  | Nothing => True
  | Just left => notb(eq_nat left Z)
  end;

-- The only raw delimiter is r#"..."#. Backslashes and inner quotes are bytes.
def source_take_raw_with_budget (budget : Maybe Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match source_is_raw_start src with
  | False => Nothing (Pair(List Nat, List Nat))
  | True =>
      match source_raw_budget_step budget with
      | Nothing => Nothing (Pair(List Nat, List Nat))
      | Just after_r =>
          match source_raw_budget_step after_r with
          | Nothing => Nothing (Pair(List Nat, List Nat))
          | Just after_hash =>
              match source_raw_budget_step after_hash with
              | Nothing => Nothing (Pair(List Nat, List Nat))
              | Just after_quote =>
                  (fix body (xs : List Nat) (left : Maybe Nat) (acc : List Nat)
                      : Maybe (Pair (List Nat) (List Nat)) :=
                    match xs with
                    | Nil => Nothing (Pair(List Nat, List Nat))
                    | Cons c rest =>
                        match source_raw_budget_step left with
                        | Nothing => Nothing (Pair(List Nat, List Nat))
                        | Just after_c =>
                            match andb(eq_nat c source_ch_double_quote,
                                source_starts ([source_ch_hash] : List Nat) rest) with
                            | True =>
                                match source_raw_budget_has_byte after_c with
                                | False => Nothing (Pair(List Nat, List Nat))
                                | True => Just(Pair(List Nat, List Nat),
                                    MkPair(List Nat, List Nat, reverse Nat acc,
                                      source_drop_prefix ([source_ch_hash] : List Nat) rest))
                                end
                            | False => body rest after_c (Cons Nat c acc)
                            end
                        end
                    end) (source_drop_prefix source_raw_prefix src)
                      after_quote (Nil Nat)
              end
          end
      end
  end;

def source_take_raw_bounded (fuel : Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  source_take_raw_with_budget (Just Nat fuel) src;

def source_take_raw (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  source_take_raw_with_budget (Nothing Nat) src;

-- Keep comment bytes and physical line breaks, but hide literal bytes before
-- line-based policy scans. Each output byte keeps its source offset.
def source_is_comment (src : List Nat) : Bool :=
  match src with
  | Nil => False
  | Cons c rest =>
      match eq_nat c source_ch_dash with
      | False => False
      | True =>
          match rest with
          | Nil => False
          | Cons c2 _ => eq_nat c2 source_ch_dash
          end
      end
  end;

def source_mask_literal_byte (byte : Nat) : Nat :=
  match orb(eq_nat byte source_ch_lf, eq_nat byte source_ch_cr) with
  | True => byte
  | False => source_ch_space
  end;

def source_mask_literals (src : List Nat) : List Nat :=
  reverse Nat
    ((fix scan (fuel : Nat) (xs : List Nat) (previous : Nat)
        (quote : Nat) (raw : Bool) (comment : Bool) (escaped : Bool)
        (acc : List Nat) : List Nat :=
      match fuel with
      | Z => acc
      | S remaining => match xs with
        | Nil => acc
        | Cons byte rest =>
            match comment with
            | True => scan remaining rest byte Z False
                (notb(eq_nat byte source_ch_lf)) False (Cons Nat byte acc)
            | False => match raw with
              | True =>
                  match andb(eq_nat byte source_ch_double_quote,
                      source_starts ([source_ch_hash] : List Nat) rest) with
                  | True => scan remaining
                      (source_drop_prefix ([source_ch_hash] : List Nat) rest)
                      source_ch_hash Z False False False
                      (Cons Nat source_ch_space (Cons Nat source_ch_space acc))
                  | False => scan remaining rest byte Z True False False
                      (Cons Nat (source_mask_literal_byte byte) acc)
                  end
              | False =>
                  match eq_nat quote Z with
                  | False =>
                      let closing : Bool := andb(notb escaped, eq_nat byte quote) in
                      let next_escape : Bool := andb(notb escaped,
                        eq_nat byte source_ch_backslash) in
                      scan remaining rest
                        (match closing with | True => Z | False => byte end)
                        (match closing with | True => Z | False => quote end)
                        False False next_escape
                        (Cons Nat (source_mask_literal_byte byte) acc)
                  | True =>
                      match source_is_comment xs with
                      | True => scan remaining rest byte Z False True False
                          (Cons Nat byte acc)
                      | False => match source_is_raw_start xs with
                        | True => scan remaining
                            (source_drop_prefix source_raw_prefix xs)
                            source_ch_double_quote Z True False False
                            (Cons Nat source_ch_space
                              (Cons Nat source_ch_space
                                (Cons Nat source_ch_space acc)))
                        | False =>
                            let starts_quote : Bool := orb
                              (eq_nat byte source_ch_double_quote)
                              (andb(eq_nat byte source_ch_quote,
                                notb(source_is_ident_char previous))) in
                            match starts_quote with
                            | True => scan remaining rest byte byte False False False
                                (Cons Nat source_ch_space acc)
                            | False => scan remaining rest byte Z False False False
                                (Cons Nat byte acc)
                            end
                        end
                      end
                  end
              end
            end
        end
      end) (S (length Nat src)) src Z Z False False False (Nil Nat));

def source_word_end (src : List Nat) : Bool :=
  match src with
  | Nil => True
  | Cons c _ =>
      notb (source_is_ident_char c)
  end;

def source_skip_line : List Nat -> List Nat :=
  fix source_skip_line (xs : List Nat) : List Nat :=
    match xs with
    | Nil => Nil Nat
    | Cons c rest =>
        match eq_nat c source_ch_lf with
        | True => xs
        | False => source_skip_line rest
        end
    end;

def source_skip_quote_pos : List Nat -> Nat -> Nat -> Pair (List Nat) Nat :=
  fix go (xs : List Nat) (quote : Nat) (pos : Nat) : Pair (List Nat) Nat :=
    match xs with
    | Nil => MkPair(List Nat, Nat, Nil Nat, pos)
    | Cons byte rest =>
        match eq_nat byte quote with
        | True => MkPair(List Nat, Nat, rest, S pos)
        | False =>
            match eq_nat byte source_ch_backslash with
            | True =>
                match rest with
                | Nil => MkPair(List Nat, Nat, Nil Nat, S pos)
                | Cons _ rest2 => go(rest2, quote, S (S pos))
                end
            | False => go(rest, quote, S pos)
            end
        end
    end;

def source_skip_string_pos (xs : List Nat) (pos : Nat) : Pair (List Nat) Nat :=
  source_skip_quote_pos xs source_ch_double_quote pos;

def source_skip_string (xs : List Nat) : List Nat :=
  match source_skip_string_pos xs Z with
  | MkPair rest _ => rest
  end;

-- Callers establish source_is_literal_start before skipping a character.
-- Return the tail after a quoted or raw spelling. Malformed raw input remains opaque
-- to source rewrites and is rejected by the production lexer.
def source_skip_literal (src : List Nat) : List Nat :=
  match src with
  | Nil => Nil Nat
  | Cons c rest =>
      match orb(eq_nat c source_ch_double_quote, eq_nat c source_ch_quote) with
      | True => match source_skip_quote_pos rest c Z with | MkPair tail _ => tail end
      | False =>
          match source_is_raw_start src with
          | False => src
          | True => match source_take_raw src with
            | Nothing => Nil Nat
            | Just parsed => match parsed with | MkPair _ tail => tail end
            end
          end
      end
  end;

def source_skip_raw_pos (src : List Nat) (pos : Nat)
    : Maybe (Pair (List Nat) Nat) :=
  match source_take_raw src with
  | Nothing => Nothing (Pair(List Nat, Nat))
  | Just parsed => match parsed with
    | MkPair bytes tail => Just(Pair(List Nat, Nat),
        MkPair(List Nat, Nat, tail,
          add pos (add(length Nat bytes, 5))))
    end
  end;

def source_word_at (w : List Nat) (src : List Nat) : Bool :=
  andb(source_starts w src, source_word_end (source_drop_prefix w src));

def source_skip_ws (src : List Nat) : List Nat :=
  (fix go (fuel : Nat) (xs : List Nat) : List Nat :=
    match fuel with
    | Z => xs
    | S fuel2 =>
        match xs with
        | Nil => Nil Nat
        | Cons c rest =>
            match source_is_ws c with
            | True => go fuel2 rest
            | False =>
                match source_is_comment xs with
                | True => go(fuel2, source_skip_line rest)
                | False => xs
                end
            end
        end
    end) (length Nat src) src;

def source_take_ident (src : List Nat) : Pair (List Nat) (List Nat) :=
  (fix go (xs : List Nat) (acc : List Nat) : Pair (List Nat) (List Nat) :=
    match xs with
    | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | Cons c rest =>
        match source_is_ident_char c with
        | True => go(rest, Cons Nat c acc)
        | False => MkPair(List Nat, List Nat, reverse Nat acc, xs)
        end
    end) src (Nil Nat);

def source_lookup_id :
    List (Pair (List Nat) Nat) -> List Nat -> Maybe Nat :=
  fix source_lookup_id (xs : List (Pair (List Nat) Nat)) (key : List Nat) : Maybe Nat :=
    match xs with
    | Nil => Nothing Nat
    | Cons p rest =>
        match p with
        | MkPair k v =>
            match source_bytes_equal k key with
            | True => Just Nat v
            | False => source_lookup_id rest key
            end
        end
    end;

def source_skip_line_pos : List Nat -> Nat -> Pair (List Nat) Nat :=
  fix go (xs : List Nat) (pos : Nat) : Pair (List Nat) Nat :=
    match xs with
    | Nil => MkPair(List Nat, Nat, Nil Nat, pos)
    | Cons byte rest =>
        match eq_nat byte source_ch_lf with
        | True => MkPair(List Nat, Nat, rest, S pos)
        | False => go(rest, S pos)
        end
    end;

def source_emit_reversed (initial : List Nat) (input : List Nat) : List Nat :=
  (fix source_emit_reversed (xs : List Nat) (acc : List Nat) : List Nat :=
    match xs with
    | Nil => acc
    | Cons c cs => source_emit_reversed(cs, Cons Nat c acc)
    end) input initial;

def source_copy_raw (acc : List Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match source_take_raw src with
  | Nothing => Nothing (Pair(List Nat, List Nat))
  | Just parsed => match parsed with
    | MkPair bytes tail =>
        Just(Pair(List Nat, List Nat),
          MkPair(List Nat, List Nat,
            source_emit_reversed acc
              (take Nat (add(length Nat bytes, 5)) src), tail))
    end
  end;

def name_in (n : List Nat) : List (List Nat) -> Bool :=
  fix name_in (xs : List (List Nat)) : Bool :=
    match xs with
    | Nil => False
    | Cons y ys => orb(source_bytes_equal n y, name_in ys)
    end;

-- Emit onto a shared reversed accumulator in one walk. Do not allocate a
-- prefix list or compare the remaining file against the tail at each byte.
def source_emit_until_lf (initial : List Nat) (input : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (xs : List Nat) (acc : List Nat) : Pair (List Nat) (List Nat) :=
    match xs with
    | Nil => MkPair(List Nat, List Nat, acc, Nil Nat)
    | Cons c rest =>
        match eq_nat c source_ch_lf with
        | True => MkPair(List Nat, List Nat, acc, xs)
        | False => go(rest, Cons Nat c acc)
        end
    end) input initial;

def source_emit_quote_body (quote : Nat) (initial : List Nat) (input : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (xs : List Nat) (acc : List Nat) : Pair (List Nat) (List Nat) :=
    match xs with
    | Nil => MkPair(List Nat, List Nat, acc, Nil Nat)
    | Cons c rest =>
        match eq_nat c quote with
        | True => MkPair(List Nat, List Nat, Cons Nat c acc, rest)
        | False =>
            match eq_nat c source_ch_backslash with
            | True =>
                match rest with
                | Nil => MkPair(List Nat, List Nat, Cons Nat c acc, Nil Nat)
                | Cons e rest2 => go(rest2, Cons Nat e (Cons Nat c acc))
                end
            | False => go(rest, Cons Nat c acc)
            end
        end
    end) input initial;

def source_emit_quoted_body (initial : List Nat) (input : List Nat)
    : Pair (List Nat) (List Nat) :=
  source_emit_quote_body source_ch_double_quote initial input;

def source_copy_quoted (acc : List Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match src with
  | Nil => Nothing (Pair(List Nat, List Nat))
  | Cons c rest =>
      match eq_nat c source_ch_double_quote with
      | False => Nothing (Pair(List Nat, List Nat))
      | True =>
          Just (Pair(List Nat, List Nat))
            (source_emit_quoted_body(Cons Nat c acc, rest))
      end
  end;

def source_copy_literal_at (previous_ident : Bool) (acc : List Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match source_is_raw_start src with
  | False => match source_char_boundary previous_ident src with
    | False => source_copy_quoted acc src
    | True => match src with
      | Nil => Nothing (Pair(List Nat, List Nat))
      | Cons opening rest => Just(Pair(List Nat, List Nat),
          source_emit_quote_body opening (Cons Nat opening acc) rest)
      end
    end
  | True =>
      match source_copy_raw acc src with
      | Just copied => Just(Pair(List Nat, List Nat), copied)
      | Nothing => Just(Pair(List Nat, List Nat),
          MkPair(List Nat, List Nat,
            source_emit_reversed acc src, Nil Nat))
      end
  end;

def source_copy_literal (acc : List Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  source_copy_literal_at (match acc with | Nil => False | Cons byte _ => source_is_ident_char byte end) acc src;

def source_copy_comment_or_literal_at (previous_ident : Bool) (acc : List Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match src with
  | Nil => Nothing (Pair(List Nat, List Nat))
  | Cons _ _ =>
      match source_is_comment src with
      | True => Just(Pair(List Nat, List Nat), source_emit_until_lf acc src)
      | False => source_copy_literal_at previous_ident acc src
      end
  end;

def source_copy_comment_or_string (acc : List Nat) (src : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  source_copy_comment_or_literal_at
    (match acc with | Nil => False | Cons byte _ => source_is_ident_char byte end) acc src;
