-- Lexer token tags and keyword ids are consumed directly by parser and generated C seams.

-- @entry lex_all

import "source_text.ouro",
  "base.ouro",
  "../std/char.ouro",
  "../std/data.ouro",
  "token.ouro",
  "pipeline_abi.ouro";

def ch_dq : Nat := 34;
def ch_lbracket : Nat := 91;
def ch_rbracket : Nat := 93;
def ch_dash : Nat := 45;
def ch_bs : Nat := 92;
def ch_bar : Nat := 124;
def ch_n : Nat := 110;
def ch_t : Nat := 116;
def ch_r : Nat := 114;

def mul10b (n : Nat) : Nat := mul n ten;

def digit_valb (c : Nat) : Nat := sub c ch_zero;

-- Arithmetic increments keep native counters compact; a growing S spine
-- makes every later identifier equality walk all preceding allocations.
def intern_ident (st : InternState) (name : List Nat) : Pair Nat InternState :=
    match st with
    | MkIntern ids nextId strs nextStr =>
        match source_lookup_id ids name with
        | Just n => MkPair Nat InternState n st
        | Nothing =>
            MkPair Nat InternState nextId
              (MkIntern
                (Cons (Pair(List Nat, Nat))
                  (MkPair (List Nat) Nat name nextId) ids)
                (add(nextId, S Z)) strs nextStr)
        end
    end;

def intern_string (st : InternState) (s : List Nat) : Pair Nat InternState :=
    match st with
    | MkIntern ids nextId strs nextStr =>
        match source_lookup_id strs s with
        | Just n => MkPair Nat InternState n st
        | Nothing =>
            MkPair Nat InternState nextStr
              (MkIntern ids nextId
                (Cons (Pair(List Nat, Nat))
                  (MkPair (List Nat) Nat s nextStr) strs)
                (add(nextStr, S Z)))
        end
    end;

def n1 (a : Nat) : List Nat := ([a] : List Nat);
def n2 (a : Nat) (b : Nat) : List Nat := Cons Nat a (n1 b);
def n3 (a : Nat) (b : Nat) (c : Nat) : List Nat := Cons Nat a (n2 b c);
def n4 (a : Nat) (b : Nat) (c : Nat) (d : Nat) : List Nat := Cons Nat a (n3 b c d);
def n5 (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) : List Nat := Cons Nat a (n4 b c d e);
def n6 (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) : List Nat := Cons Nat a (n5 b c d e f);
def n7 (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) (g : Nat) : List Nat := Cons Nat a (n6 b c d e f g);
def n9 (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) (g : Nat) (h : Nat) (i : Nat) : List Nat :=
  Cons Nat a (Cons Nat b (n7 c d e f g h i));

def kw_chars_def : List Nat := n3 100 101 102;
def kw_chars_axiom : List Nat := n5 97 120 105 111 109;
def kw_chars_inductive : List Nat := n9 105 110 100 117 99 116 105 118 101;
def kw_chars_fun : List Nat := n3 102 117 110;
def kw_chars_match : List Nat := n5 109 97 116 99 104;
def kw_chars_with : List Nat := n4 119 105 116 104;
def kw_chars_end : List Nat := n3 101 110 100;
def kw_chars_let : List Nat := n3 108 101 116;
def kw_chars_in : List Nat := n2 105 110;
def kw_chars_fix : List Nat := n3 102 105 120;
def kw_chars_import : List Nat := n6 105 109 112 111 114 116;
def kw_chars_effect : List Nat := n6 101 102 102 101 99 116;
def kw_chars_where : List Nat := n5 119 104 101 114 101;
def kw_chars_do : List Nat := n2 100 111;
def kw_chars_perform : List Nat := n7 112 101 114 102 111 114 109;
def kw_chars_handle : List Nat := n6 104 97 110 100 108 101;
def kw_chars_record : List Nat := n6 114 101 99 111 114 100;
def kw_chars_intrinsic : List Nat := n9 105 110 116 114 105 110 115 105 99;
def kw_chars_extern : List Nat := n6 101 120 116 101 114 110;
def kw_chars_representation : List Nat :=
  ([114, 101, 112, 114, 101, 115, 101, 110, 116, 97, 116, 105, 111, 110] : List Nat);
def kw_chars_open : List Nat := n4 111 112 101 110;
def kw_chars_uscore : List Nat := n1 95;

def kp (cs : List Nat) (k : Nat) (tl : List (Pair (List Nat) Nat)) : List (Pair (List Nat) Nat) :=
  Cons(Pair(List Nat, Nat), MkPair (List Nat) Nat cs k, tl);

-- Flat kw table (nested eqListNat towers blow elab). Cons form stays
-- parseable by the committed stage0 seed during regeneration.
def kw_table : List (Pair (List Nat) Nat) :=
  kp kw_chars_def kwDef (
  kp kw_chars_axiom kwAxiom (
  kp kw_chars_inductive kwInductive (
  kp kw_chars_fun kwFun (
  kp kw_chars_match kwMatch (
  kp kw_chars_with kwWith (
  kp kw_chars_end kwEnd (
  kp kw_chars_let kwLet (
  kp kw_chars_in kwIn (
  kp kw_chars_fix kwFix (
  kp kw_chars_import kwImport (
  kp kw_chars_effect kwEffect (
  kp kw_chars_where kwWhere (
  kp kw_chars_do kwDo (
  kp kw_chars_perform kwPerform (
  kp kw_chars_handle kwHandle (
  kp kw_chars_record kwRecord (
  kp kw_chars_intrinsic kwIntrinsic (
  kp kw_chars_extern kwExtern (
  kp kw_chars_representation kwRepresentation (Nil (Pair(List Nat, Nat))))))))))))))))))))));

def classify_ident (name : List Nat) : Maybe Token :=
    match source_bytes_equal name kw_chars_uscore with
    | True => Just(Token, THole (Nothing Nat))
    | False =>
        match source_lookup_id kw_table name with
        | Just kid => Just(Token, TKeyword kid)
        | Nothing => Nothing Token
        end
    end;

-- "Type" / "Type"++digits → Just remainder; else Nothing.
def starts_with_Type (name : List Nat) : Maybe (List Nat) :=
    match name with
    | Nil => Nothing (List Nat)
    | Cons c0 rest0 =>
        match rest0 with
        | Nil => Nothing (List Nat)
        | Cons c1 rest1 =>
            match rest1 with
            | Nil => Nothing (List Nat)
            | Cons c2 rest2 =>
                match rest2 with
                | Nil => Nothing (List Nat)
                | Cons c3 rest =>
                    match andb (eqNat c0 84)
                          (andb (eqNat c1 121)
                            (andb(eqNat c2 112, eqNat c3 101))) with
                    | True => Just(List Nat, rest)
                    | False => Nothing (List Nat)
                    end
                end
            end
        end
    end;

def all_digits : List Nat -> Bool :=
  fix all_digits (xs : List Nat) : Bool :=
    match xs with
    | Nil => True
    | Cons c rest =>
        match source_is_digit c with
        | True => all_digits rest
        | False => False
        end
    end;

def parse_nat_go : List Nat -> Nat -> Nat :=
  fix parse_nat_go (xs : List Nat) (acc : Nat) : Nat :=
    match xs with
    | Nil => acc
    | Cons c rest => parse_nat_go(rest, add(mul10b acc, digit_valb c))
    end;

def parse_nat_ltr (xs : List Nat) : Nat := parse_nat_go xs Z;

def try_type_token (name : List Nat) : Maybe Token :=
    match starts_with_Type name with
    | Nothing => Nothing Token
    | Just rest =>
        match rest with
        | Nil => Just(Token, TType Z)
        | Cons _ _ =>
            match all_digits rest with
            | True => Just(Token, TType (parse_nat_ltr rest))
            | False => Nothing Token
            end
        end
    end;

def skip_line : Nat -> List Nat -> List Nat :=
  fix skip_line (fuel : Nat) (src : List Nat) : List Nat :=
    match fuel with
    | Z => src
    | S fuel' =>
        match src with
        | Nil => Nil Nat
        | Cons c rest =>
            match eqNat c ch_lf with
            | True => src
            | False => skip_line fuel' rest
            end
        end
    end;

def skip_ws : Nat -> List Nat -> List Nat :=
  fix skip_ws (fuel : Nat) (src : List Nat) : List Nat :=
    match fuel with
    | Z => src
    | S fuel' =>
        match src with
        | Nil => Nil Nat
        | Cons c rest =>
            match source_is_ws c with
            | True => skip_ws fuel' rest
            | False =>
                match eqNat c ch_dash with
                | True =>
                    match rest with
                    | Nil => src
                    | Cons c2 rest2 =>
                        match eqNat c2 ch_dash with
                        | True => skip_ws(fuel', skip_line fuel' rest2)
                        | False => src
                        end
                    end
                | False => src
                end
            end
        end
    end;

def take_ident : Nat -> List Nat -> List Nat -> Pair (List Nat) (List Nat) :=
  fix take_ident (fuel : Nat) (src : List Nat) (acc : List Nat)
    : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, src)
    | S fuel' =>
        match src with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match source_is_ident_char c with
            | True => take_ident fuel' rest (Cons Nat c acc)
            | False => MkPair(List Nat, List Nat, reverse Nat acc, src)
            end
        end
    end;

-- A number must consume the whole identifier-shaped word. Otherwise 0xG or
-- 12abc could be accepted as a shorter Nat followed by a separate identifier.
def number_digit (base : Nat) (c : Nat) : Maybe Nat :=
    let value : Maybe Nat :=
      match source_is_digit c with
      | True => Just Nat (sub c ch_zero)
      | False =>
          match andb(compiler_le_nat 65 c, compiler_le_nat c 70) with
          | True => Just Nat (add(sub c 65, 10))
          | False =>
              match andb(compiler_le_nat 97 c, compiler_le_nat c 102) with
              | True => Just Nat (add(sub c 97, 10))
              | False => Nothing Nat
              end
          end
      end in
    match value with
    | Nothing => Nothing Nat
    | Just digit =>
        match compiler_lt_nat digit base with
        | True => Just Nat digit
        | False => Nothing Nat
        end
    end;

def number_digits : List Nat -> Nat -> Nat -> Bool -> Maybe Nat :=
  fix number_digits (chars : List Nat) (base : Nat) (acc : Nat) (after_digit : Bool)
      : Maybe Nat :=
    match chars with
    | Nil =>
        match after_digit with
        | True => Just Nat acc
        | False => Nothing Nat
        end
    | Cons c rest =>
        match eqNat c ch_under with
        | True =>
            match after_digit with
            | True => number_digits rest base acc False
            | False => Nothing Nat
            end
        | False =>
            match number_digit base c with
            | Nothing => Nothing Nat
            | Just digit => number_digits rest base (add(mul acc base, digit)) True
            end
        end
    end;

def parse_number (chars : List Nat) : Maybe Nat :=
    match chars with
    | Nil => Nothing Nat
    | Cons first rest =>
        match eqNat first ch_zero with
        | False => number_digits chars 10 Z False
        | True =>
            match rest with
            | Nil => Just Nat Z
            | Cons marker digits =>
                match orb(eqNat marker 120, eqNat marker 88) with
                | True => number_digits digits 16 Z False
                | False =>
                    match orb(eqNat marker 98, eqNat marker 66) with
                    | True => number_digits digits 2 Z False
                    | False => number_digits chars 10 Z False
                    end
                end
            end
        end
    end;

-- The checked-source import prepass is the only producer of `alias@member`.
-- Raw lexer entry points keep the ordinary identifier grammar.
def take_import_ident : Nat -> List Nat -> List Nat -> Pair (List Nat) (List Nat) :=
  fix go (fuel : Nat) (src : List Nat) (acc : List Nat)
    : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, src)
    | S remaining =>
        match src with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match orb(source_is_ident_char c, eqNat c 64) with
            | True => go remaining rest (Cons Nat c acc)
            | False => MkPair(List Nat, List Nat, reverse Nat acc, src)
            end
        end
    end;

def take_digits : Nat -> List Nat -> List Nat -> Pair (List Nat) (List Nat) :=
  fix take_digits (fuel : Nat) (src : List Nat) (acc : List Nat)
    : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, src)
    | S fuel' =>
        match src with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match source_is_digit c with
            | True => take_digits fuel' rest (Cons Nat c acc)
            | False => MkPair(List Nat, List Nat, reverse Nat acc, src)
            end
        end
    end;

inductive StrLex : Type :=
  | StrOk : List Nat -> List Nat -> StrLex
  | StrErr : StrLex;

def take_string : Nat -> List Nat -> List Nat -> StrLex :=
  fix take_string (fuel : Nat) (src : List Nat) (acc : List Nat) : StrLex :=
    match fuel with
    | Z => StrErr
    | S fuel' =>
        match src with
        | Nil => StrErr
        | Cons c rest =>
            match eqNat c ch_dq with
            | True => StrOk(reverse Nat acc, rest)
            | False =>
                match eqNat c ch_bs with
                | True =>
                    match rest with
                    | Nil => StrErr
                    | Cons e rest2 =>
                        match eqNat e ch_n with
                        | True =>
                            take_string fuel' rest2 (Cons Nat ch_lf acc)
                        | False =>
                            match eqNat e ch_t with
                            | True =>
                                take_string fuel' rest2 (Cons Nat ch_tab acc)
                            | False =>
                                match eqNat e ch_r with
                                | True =>
                                    take_string fuel' rest2 (Cons Nat ch_cr acc)
                                | False =>
                                    match eqNat e ch_dq with
                                    | True =>
                                        take_string fuel' rest2 (Cons Nat ch_dq acc)
                                    | False =>
                                        match eqNat e ch_bs with
                                        | True =>
                                            take_string fuel' rest2
                                              (Cons Nat ch_bs acc)
                                        | False =>
                                            match eqNat e 117 with
                                            | True =>
                                                match rest2 with
                                                | Cons brace _ =>
                                                    match eqNat brace 123 with
                                                    | True =>
                                                        match source_unicode_braced rest2 with
                                                        | Nothing => StrErr
                                                        | Just parsed => match parsed with
                                                          | MkPair bytes after =>
                                                              take_string fuel' after
                                                                (append Nat (reverse Nat bytes) acc)
                                                          end
                                                        end
                                                    | False => take_string fuel' rest2
                                                        (Cons Nat e (Cons Nat ch_bs acc))
                                                    end
                                                | Nil => take_string fuel' rest2
                                                    (Cons Nat e (Cons Nat ch_bs acc))
                                                end
                                            | False =>
                                                -- keep \ + char (Windows paths)
                                                take_string fuel' rest2
                                                  (Cons Nat e (Cons Nat ch_bs acc))
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                | False => take_string fuel' rest (Cons Nat c acc)
                end
            end
        end
    end;

inductive Step : Type :=
  | StepTok : Token -> List Nat -> InternState -> Step
  | StepEof : InternState -> Step
  | LexStepErr : InternState -> Step;

-- Lexing never turns an invalid or over-budget suffix into an ordinary EOF.
-- The three constructors intentionally keep malformed input and exhaustion
-- distinct for every caller that decides whether source is accepted.

def tok_simple1 (c : Nat) (rest : List Nat) (st : InternState) : Maybe Step :=
    match eqNat c ch_lparen with
    | True => Just(Step, StepTok TLparen rest st)
    | False =>
        match eqNat c ch_rparen with
        | True => Just(Step, StepTok TRparen rest st)
        | False =>
            match eqNat c ch_bar with
            | True =>
                match rest with
                | Nil => Just(Step, StepTok TBar rest st)
                | Cons c2 rest2 =>
                    match eqNat c2 ch_gt with
                    | True => Just(Step, StepTok TPipe rest2 st)
                    | False => Just(Step, StepTok TBar rest st)
                    end
                end
            | False =>
                match eqNat c ch_semi with
                | True => Just(Step, StepTok TSemi rest st)
                | False =>
                    match eqNat c ch_comma with
                    | True => Just(Step, StepTok TComma rest st)
                    | False => Nothing Step
                    end
                end
            end
        end
    end;

def tok_simple2 (c : Nat) (rest : List Nat) (st : InternState) : Maybe Step :=
    match eqNat c ch_lbrace with
    | True => Just(Step, StepTok TBraceL rest st)
    | False =>
        match eqNat c ch_rbrace with
        | True => Just(Step, StepTok TBraceR rest st)
        | False =>
            match eqNat c ch_bang with
            | True => Just(Step, StepTok TExclam rest st)
            | False =>
                match eqNat c ch_lbracket with
                | True => Just(Step, StepTok TBracketL rest st)
                | False =>
                    match eqNat c ch_rbracket with
                    | True => Just(Step, StepTok TBracketR rest st)
                    | False => Nothing Step
                    end
                end
            end
        end
    end;

def tok_hole (fuel' : Nat) (rest : List Nat) (st : InternState) : Step :=
    match rest with
    | Nil => StepTok(THole (Just Nat Z), Nil Nat, st)
    | Cons c2 rest2 =>
        match source_is_ident_start c2 with
        | False => StepTok (THole (Just Nat Z)) rest st
        | True =>
            match take_ident(fuel', Cons Nat c2 rest2, Nil Nat) with
            | MkPair name src' =>
                match intern_ident st name with
                | MkPair id st' => StepTok (THole (Just Nat id)) src' st'
                end
            end
        end
    end;

def tok_string (fuel' : Nat) (rest : List Nat) (st : InternState) : Step :=
    match take_string fuel' rest (Nil Nat) with
    | StrErr => LexStepErr st
    | StrOk content src' =>
        match intern_string st content with
        | MkPair id st' => StepTok (TString id) src' st'
        end
    end;

def tok_colon (rest : List Nat) (st : InternState) : Step :=
    match rest with
    | Nil => StepTok TColon (Nil Nat) st
    | Cons c2 rest2 =>
        match eqNat c2 ch_eq with
        | True => StepTok TColonEq rest2 st
        | False => StepTok TColon rest st
        end
    end;

def tok_arrowish (c : Nat) (rest : List Nat) (st : InternState) : Step :=
    match eqNat c ch_dash with
    | True =>
        match rest with
        | Nil => LexStepErr st
        | Cons c2 rest2 =>
            match eqNat c2 ch_gt with
            | True => StepTok TArrow rest2 st
            | False => LexStepErr st
            end
        end
    | False =>
        match eqNat c ch_eq with
        | True =>
            match rest with
            | Nil => LexStepErr st
            | Cons c2 rest2 =>
                match eqNat c2 ch_gt with
                | True => StepTok TFatArrow rest2 st
                | False => LexStepErr st
                end
            end
        | False =>
            match eqNat c ch_lt with
            | True =>
                match rest with
                | Nil => LexStepErr st
                | Cons c2 rest2 =>
                    match eqNat c2 ch_dash with
                    | True => StepTok TBind rest2 st
                    | False => LexStepErr st
                    end
                end
            | False => LexStepErr st
            end
        end
    end;

def tok_nat_or_ident (fuel' : Nat) (c : Nat) (rest : List Nat) (st : InternState) : Step :=
    match source_is_digit c with
    | True =>
        match take_ident(fuel', Cons Nat c rest, Nil Nat) with
        | MkPair chars src' =>
            match source_word_end src' with
            | False => LexStepErr st
            | True =>
                match parse_number chars with
                | Nothing => LexStepErr st
                | Just value => StepTok (TNat value) src' st
                end
            end
        end
    | False =>
        match source_is_ident_start c with
        | False => LexStepErr st
        | True =>
            match take_ident(fuel', Cons Nat c rest, Nil Nat) with
            | MkPair name src' =>
                match classify_ident name with
                | Just tok => StepTok tok src' st
                | Nothing =>
                    match try_type_token name with
                    | Just tok => StepTok tok src' st
                    | Nothing =>
                        match intern_ident st name with
                        | MkPair id st' => StepTok (TIdent id) src' st'
                        end
                    end
                end
            end
        end
    end;

def tok_import_ident (fuel' : Nat) (c : Nat) (rest : List Nat)
    (st : InternState) : Step :=
  match take_import_ident(fuel', Cons Nat c rest, Nil Nat) with
  | MkPair name src' =>
      match source_bytes_equal name kw_chars_open with
      | True => StepTok (TKeyword kwOpen) src' st
      | False => match classify_ident name with
      | Just tok => StepTok tok src' st
      | Nothing =>
          match try_type_token name with
          | Just tok => StepTok tok src' st
          | Nothing =>
              match intern_ident st name with
              | MkPair id st' => StepTok (TIdent id) src' st'
              end
          end
      end
      end
  end;

def next_token_char (fuel' : Nat) (c : Nat) (rest : List Nat) (st : InternState) : Step :=
    match tok_simple1 c rest st with
    | Just s => s
    | Nothing =>
        match tok_simple2 c rest st with
        | Just s => s
        | Nothing =>
            match eqNat c ch_qmark with
            | True => tok_hole fuel' rest st
            | False =>
                match eqNat c ch_dq with
                | True => tok_string fuel' rest st
                | False =>
                    match source_is_raw_start (Cons Nat c rest) with
                    | True =>
                        match source_take_raw_bounded (S fuel') (Cons Nat c rest) with
                        | Nothing => LexStepErr st
                        | Just parsed => match parsed with
                          | MkPair content tail =>
                              match intern_string st content with
                                | MkPair id st' => StepTok (TString id) tail st'
                                end
                          end
                        end
                    | False =>
                    match eqNat c 46 with
                    | True =>
                        match rest with
                        | Cons next tail =>
                            match eqNat next 46 with
                            | True => StepTok TDotDot tail st
                            | False => LexStepErr st
                            end
                        | Nil => LexStepErr st
                        end
                    | False => match eqNat c ch_colon with
                    | True => tok_colon rest st
                    | False =>
                        match orb(orb(eqNat c ch_dash, eqNat c ch_eq), eqNat c ch_lt) with
                        | True => tok_arrowish c rest st
                        | False => tok_nat_or_ident fuel' c rest st
                        end
                    end
                    end
                    end
                end
            end
        end
    end;

def next_token (fuel : Nat) (src0 : List Nat) (st : InternState) : Step :=
    match fuel with
    | Z => LexStepErr st
    | S fuel' =>
        match skip_ws fuel' src0 with
        | Nil => StepEof st
        | Cons c rest => next_token_char fuel' c rest st
        end
    end;

def next_import_token (fuel : Nat) (src0 : List Nat) (st : InternState) : Step :=
  match fuel with
  | Z => LexStepErr st
  | S remaining =>
      match skip_ws remaining src0 with
      | Nil => StepEof st
      | Cons c rest =>
          match source_is_ident_start c with
          | True => tok_import_ident remaining c rest st
          | False => next_token_char remaining c rest st
          end
      end
  end;

-- The native host may reclaim one token step's lookup temporaries. Token
-- semantics and this fuel/accumulator traversal stay in the canonical lexer.
def lex_go_with
    (step_token : Nat -> List Nat -> InternState -> Step) :
    Nat -> List Nat -> InternState -> List Token ->
    LexResult :=
  fix lex_go (fuel : Nat) (src : List Nat) (st : InternState)
    (acc : List Token) : LexResult :=
    match fuel with
    | Z =>
        match src with
        | Nil => LexOk(reverse(Token, Cons Token TEof acc), st)
        | Cons _ _ => LexExhausted st
        end
    | S fuel' =>
        match step_token fuel' src st with
        | StepEof st' =>
            LexOk(reverse(Token, Cons Token TEof acc), st')
        | LexStepErr st' => LexMalformed st'
        | StepTok tok src' st' =>
            lex_go fuel' src' st' (Cons Token tok acc)
        end
    end;

def lex_go : Nat -> List Nat -> InternState -> List Token -> LexResult :=
    lex_go_with next_token;

def lex_go_import : Nat -> List Nat -> InternState -> List Token -> LexResult :=
    lex_go_with next_import_token;

def lex_all (fuel : Nat) (src : List Nat) : LexResult :=
    lex_go fuel src empty_intern (Nil Token);

def lex_all_import (fuel : Nat) (src : List Nat) : LexResult :=
    lex_go_import fuel src empty_intern (Nil Token);


def unit_intern_ids (st : InternState) : List (Pair (List Nat) Nat) :=
    match st with
    | MkIntern ids _ _ _ => ids
    end;
