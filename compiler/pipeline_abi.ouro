-- Shared frontend values for source composition and packed translation units.
-- Constructor order and fields are the runtime ABI; imports share the same
-- nominal types instead of separately declaring values with matching tags.

import "ast.ouro",
  "core.ouro",
  "token.ouro";

-- Fields: name, family, constructor index, parameter count, field arity,
-- leading opt-in Type parameter count.
inductive CtorInfo : Type :=
  | MkCtorInfo : Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> CtorInfo;

-- Resolved definition identity, marked leading Type0 count, and declared slots.
inductive DefInfo : Type :=
  | DefInfoOf : Nat -> Nat -> List DefParam -> DefInfo;

inductive LowerEnv : Type :=
  | MkLowerEnv :
      List Nat -> List Nat -> List CtorInfo -> List Nat ->
      List (Pair Nat Surface) -> List (Pair Nat Surface) ->
      List DefInfo -> LowerEnv;

-- Intern fields: ids, nextId, strings, nextString. Identifiers start at one;
-- string ids start at zero.
inductive InternState : Type :=
  | MkIntern :
      List (Pair (List Nat) Nat) -> Nat ->
      List (Pair (List Nat) Nat) -> Nat -> InternState;

def empty_intern : InternState :=
    MkIntern (Nil (Pair(List Nat, Nat))) (S Z)
      (Nil (Pair(List Nat, Nat))) Z;

-- Malformed input and exhaustion remain distinct from ordinary EOF.
inductive LexResult : Type :=
  | LexOk : List Token -> InternState -> LexResult
  | LexMalformed : InternState -> LexResult
  | LexExhausted : InternState -> LexResult;

inductive ParseResult (A : Type) : Type :=
  | POk : A -> List Token -> Nat -> ParseResult A
  | PErr : Nat -> ParseResult A;

-- A stage result alone is not evidence that a module passed checking.
inductive CompError : Type :=
  | ErrCode : Nat -> Nat -> CompError;

inductive CompResult (A : Type) : Type :=
  | CErr : CompError -> CompResult A
  | COk : A -> CompResult A;

inductive SrcUnit : Type :=
  | MkSrcUnit : Nat -> List Decl -> SrcUnit;

-- RErr: 1=cycle, 2=missing unit, 3=fuel; detail is the path id.
inductive ResolveResult (A : Type) : Type :=
  | ROk : A -> ResolveResult A
  | RErr : Nat -> Nat -> ResolveResult A;

inductive ImpReg : Type :=
  | MkImpReg : List (List Nat) -> List (Pair (List Nat) (List Nat)) -> ImpReg;

inductive ImpPrep : Type :=
  | ImpErr : Nat -> Nat -> ImpPrep
  | ImpOk : List Nat -> ImpPrep;

inductive RecField : Type :=
  | MkRecField : List Nat -> List Nat -> RecField;

inductive RecInfo : Type :=
  | MkRecInfo : List Nat -> List Nat -> List Nat -> List RecField -> RecInfo;

inductive RecBind : Type :=
  | MkRecBind : List Nat -> Nat -> List Nat -> RecBind;

inductive RecReg : Type :=
  | MkRecReg : Nat -> List RecInfo -> List (List Nat) -> List RecBind -> RecReg;

inductive PrepResult : Type :=
  | PrepErr : Nat -> Nat -> PrepResult
  | PrepOk : List Nat -> PrepResult;
