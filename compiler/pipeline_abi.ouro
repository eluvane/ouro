-- Shared frontend values for source composition and packed translation units.
-- Constructor order and fields are the runtime ABI; imports share the same
-- nominal types instead of separately declaring values with matching tags.

import "ast.ouro",
  "core.ouro",
  "token.ouro";

-- Fields: name, family, constructor index, parameter count, field arity,
-- leading opt-in Type parameter count.
inductive CtorInfo : Type :=
  | MkCtorInfo : Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> CtorInfo;

-- Resolved definition identity, marked leading Type0 count, and declared slots.
inductive DefInfo : Type :=
  | DefInfoOf : Nat -> Nat -> List DefParam -> DefInfo;

inductive LowerEnv : Type :=
  | MkLowerEnv :
      List Nat -> List Nat -> List CtorInfo -> List Nat ->
      List (Pair Nat Surface) -> List (Pair Nat Surface) ->
      List DefInfo -> LowerEnv;

-- Intern fields: ids, nextId, strings, nextString. Identifiers start at one;
-- string ids start at zero.
inductive InternState : Type :=
  | MkIntern :
      List (Pair (List Nat) Nat) -> Nat ->
      List (Pair (List Nat) Nat) -> Nat -> InternState;

def empty_intern : InternState :=
    MkIntern (Nil (Pair(List Nat, Nat))) (S Z)
      (Nil (Pair(List Nat, Nat))) Z;

-- Malformed input and exhaustion remain distinct from ordinary EOF.
inductive LexResult : Type :=
  | LexOk : List Token -> InternState -> LexResult
  | LexMalformed : InternState -> LexResult
  | LexExhausted : InternState -> LexResult;

inductive ParseResult (A : Type) : Type :=
  | POk : A -> List Token -> Nat -> ParseResult A
  | PErr : Nat -> ParseResult A;

-- A stage result alone is not evidence that a module passed checking.
inductive CompError : Type :=
  | ErrCode : Nat -> Nat -> CompError;

inductive CompResult (A : Type) : Type :=
  | CErr : CompError -> CompResult A
  | COk : A -> CompResult A;

-- These frontend phases do not establish declaration acceptance or source spans.
inductive CompileProgramPhase : Type :=
  | CompileFutureSlotPhase : CompileProgramPhase
  | CompileDuplicatePhase : CompileProgramPhase
  | CompileFutureGlobalPhase : CompileProgramPhase
  | CompileSurfacePhase : CompileProgramPhase
  | CompileCorePhase : CompileProgramPhase;

-- The owner is the resolved name supplied with the failing Surface.
inductive CompileProgramResult : Type :=
  | CompileProgramErr : Pair Nat CompileProgramPhase -> CompError -> CompileProgramResult
  | CompileProgramOk : List (Pair Nat CoreTerm) -> CompileProgramResult;

inductive LowerListRefusal : Type :=
  | LowerListEmptyWithoutExpected : LowerListRefusal
  | LowerListHeadWithoutType : LowerListRefusal
  | LowerListHeadPlaceholder : LowerListRefusal
  | LowerListExpectedNotList : LowerListRefusal;

inductive LowerRootCause : Type :=
  | LowerRootList : LowerListRefusal -> LowerRootCause
  | LowerRootNamedHole : Nat -> LowerRootCause;

inductive LoweredSurface : Type :=
  | LoweredSurfaceOf : Surface -> Maybe LowerRootCause -> LoweredSurface;

def lowered_surface_value (lowered : LoweredSurface) : Surface :=
  match lowered with | LoweredSurfaceOf surface _ => surface end;

inductive SourceDecl : Type :=
  | SourceDeclOf : Maybe Nat -> Decl -> SourceDecl;

def source_decl_values (decls : List SourceDecl) : List Decl :=
  map SourceDecl Decl (fun (item : SourceDecl) =>
    match item with | SourceDeclOf _ decl => decl end) decls;

def source_decls_without_unit (decls : List Decl) : List SourceDecl :=
  map Decl SourceDecl (fun (decl : Decl) => SourceDeclOf (Nothing Nat) decl) decls;

-- The ordinal distinguishes repeated names without a second compilation.
inductive CompileProgramLocation : Type :=
  | CompileProgramLocationOf : Pair Nat CompileProgramPhase -> Nat -> CompileProgramLocation;

inductive CompileProgramLocatedResult : Type :=
  | CompileProgramLocatedErr : CompileProgramLocation -> CompError -> CompileProgramLocatedResult
  | CompileProgramLocatedOk : List (Pair Nat CoreTerm) -> CompileProgramLocatedResult;

def compile_program_located_result (result : CompileProgramLocatedResult)
    : CompResult (List (Pair Nat CoreTerm)) :=
  match result with
  | CompileProgramLocatedErr _ error => CErr (List (Pair Nat CoreTerm)) error
  | CompileProgramLocatedOk cores => COk (List (Pair Nat CoreTerm)) cores
  end;

-- Unit IDs are interned canonical paths. Spans are original byte intervals;
-- compatibility producers retain Nothing. The additive original-origin sidecar
-- can project validated whole declaration envelopes without changing this ABI.
inductive SourceFailureOwner : Type :=
  | SourceFailureOwnerOf : Pair Nat CompileProgramPhase ->
      Pair (Maybe Nat) (Maybe (Pair Nat Nat)) -> SourceFailureOwner;

inductive SourceFailure : Type :=
  | SourceFailureOf : CompError ->
      Pair (Maybe SourceFailureOwner) (Maybe LowerRootCause) -> SourceFailure;

inductive SourceResult (A : Type) : Type :=
  | SourceErr : SourceFailure -> SourceResult A
  | SourceOk : A -> SourceResult A;

def source_failure_unknown (error : CompError) : SourceFailure :=
  SourceFailureOf error
    (MkPair (Maybe SourceFailureOwner) (Maybe LowerRootCause)
      (Nothing SourceFailureOwner) (Nothing LowerRootCause));

def source_result_comp (A : Type) (result : SourceResult A) : CompResult A :=
  match result with
  | SourceErr failure => match failure with | SourceFailureOf error _ => CErr A error end
  | SourceOk value => COk A value
  end;

-- Keep two erased fields: the strict packer reserves tag-zero arity-three
-- records for polymorphic pairs.
inductive SrcUnit : Type :=
  | MkSrcUnit : Nat -> Pair (List Decl) (List Nat) -> SrcUnit;

def mk_src_unit (path : Nat) (decls : List Decl)
    (private_names : List Nat) : SrcUnit :=
  MkSrcUnit path
    (MkPair (List Decl) (List Nat) decls private_names);

def src_unit_decls (unit : SrcUnit) : List Decl :=
  match unit with
  | MkSrcUnit _ body => match body with | MkPair decls _ => decls end
  end;

def src_unit_private_names (unit : SrcUnit) : List Nat :=
  match unit with
  | MkSrcUnit _ body => match body with | MkPair _ names => names end
  end;

-- The parser owns visibility; private names include generated members of an
-- inductive or effect, while the declaration list remains complete for checking.
inductive ParsedFile : Type :=
  | MkParsedFile : List Decl -> List Nat -> ParsedFile;

-- RErr: 1=cycle, 2=missing unit, 3=fuel; detail is the path id.
inductive ResolveResult (A : Type) : Type :=
  | ROk : A -> ResolveResult A
  | RErr : Nat -> Nat -> ResolveResult A;

inductive ImportSelector : Type :=
  | MkImportSelector : List Nat -> List Nat -> ImportSelector;

inductive ImpRule : Type :=
  | ImpPlain : List Nat -> ImpRule
  | ImpSelected : List Nat -> List ImportSelector -> ImpRule
  | ImpRecordGrant : List Nat -> List Nat -> List Nat -> ImpRule
  | ImpFieldTypeGrant : List Nat -> List Nat -> List Nat -> ImpRule;

inductive ImpReg : Type :=
  | MkImpReg : Pair (List (List Nat)) (List (Pair (List Nat) (List Nat))) ->
      List ImpRule -> ImpReg;

def imp_reg_names (reg : ImpReg) : List (List Nat) :=
  match reg with
  | MkImpReg entries _ => match entries with
    | MkPair names _ => names
    end
  end;

def imp_reg_bindings (reg : ImpReg) : List (Pair (List Nat) (List Nat)) :=
  match reg with
  | MkImpReg entries _ => match entries with
    | MkPair _ bindings => bindings
    end
  end;

inductive ImpPrep : Type :=
  | ImpErr : Nat -> Nat -> ImpPrep
  | ImpOk : List Nat -> ImpPrep;

inductive RecField : Type :=
  | MkRecField : List Nat -> List Nat -> RecField;

inductive RecOwnerScope : Type :=
  | MkRecOwnerScope : ImpReg -> List (List Nat) -> RecOwnerScope;

inductive RecInfo : Type :=
  | MkRecInfo : List Nat -> List Nat -> List Nat -> List RecField ->
      RecOwnerScope -> RecInfo;

inductive RecBind : Type :=
  | MkRecBind : List Nat -> Nat -> List Nat -> RecBind;

inductive RecReg : Type :=
  | MkRecReg : Nat -> List RecInfo -> List (List Nat) -> List RecBind -> RecReg;

inductive PrepResult : Type :=
  | PrepErr : Nat -> Nat -> PrepResult
  | PrepOk : List Nat -> PrepResult;
