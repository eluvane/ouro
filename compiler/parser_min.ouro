-- Shared parser ABI for split parser shards; constructor order must stay in lockstep with parser.ouro.

-- @export parse_min_ok; @doc docs/tcb.md

import "../std/data.ouro";
import "token.ouro";
import "ast.ouro";
import "pipeline_abi.ouro";

-- Mode-tagged single fix (no mutual recursion).
inductive Mode : Type :=
  | MExpr : Mode
  | MPipe : Mode
  | MPipeTail : Mode
  | MPi : Mode
  | MApp : Mode
  | MAppTail : Mode
  | MAtom : Mode
  | MParen : Mode
  | MFun : Mode
  | MLet : Mode
  | MMatch : Mode
  | MFix : Mode
  | MTypedBinder : Mode
  | MTypedBinderGroup : Mode
  | MTypedBinders : Mode
  | MFunBinders : Mode
  | MPattern : Mode
  | MPatternVars : Mode
  | MPatterns : Mode
  | MMultiBranches : Mode
  | MScrutList : Mode
  | MKeywordAtom : Mode
  | MEffectAnnotation : Mode
  | MEffectRow : Mode
  | MCommaList : Mode
  | MListElems : Mode
  | MListTail : Mode
  | MIdentCommaList : Mode
  | MDoExprs : Mode
  | MPerform : Mode
  | MDo : Mode
  | MHandle : Mode
  | MHandleClauses : Mode
  | MPiFromApp : Mode
  | MDoStmt : Mode;

inductive Value : Type :=
  | VExpr : Expr -> Value
  | VNat : Nat -> Value
  | VPairNatExpr : Pair Nat Expr -> Value
  | VListPairNatExpr : List (Pair Nat Expr) -> Value
  | VListPairNatMaybeExpr : List (Pair Nat (Maybe Expr)) -> Value
  | VPairNatListNat : Pair Nat (List Nat) -> Value
  | VListPairNatListNat : List (Pair Nat (List Nat)) -> Value
  | VListExpr : List Expr -> Value
  | VListNat : List Nat -> Value
  | VRow : Pair (List (Pair Nat (List Nat))) Expr -> Value
  | VListRow : List (Pair (List (Pair Nat (List Nat))) Expr) -> Value
  | VHandleClause : Pair Nat (Pair (List Nat) Expr) -> Value
  | VListHandleClause : List (Pair Nat (Pair (List Nat) Expr)) -> Value;

def peek (toks : List Token) : Token :=
    match toks with
    | Nil => TEof
    | Cons t _ => t
    end;

def bump (toks : List Token) (pos : Nat) : Pair (List Token) Nat :=
    match toks with
    | Nil => MkPair (List Token) Nat (Nil Token) pos
    | Cons _ rest => MkPair (List Token) Nat rest (S pos)
    end;

def tagIdent : Nat := 0;
def tagNat : Nat := 1;
def tagKeyword : Nat := 2;
def tagType : Nat := 3;
def tagColon : Nat := 4;
def tagColonEq : Nat := 5;
def tagArrow : Nat := 6;
def tagFatArrow : Nat := 7;
def tagBar : Nat := 8;
def tagLparen : Nat := 9;
def tagRparen : Nat := 10;
def tagSemi : Nat := 11;
def tagHole : Nat := 12;
def tagString : Nat := 13;
def tagComma : Nat := 14;
def tagBraceL : Nat := 15;
def tagBraceR : Nat := 16;
def tagExclam : Nat := 17;
def tagEof : Nat := 18;
def tagBind : Nat := 19;
def tagPipe : Nat := 20;
def tagBracketL : Nat := 21;
def tagBracketR : Nat := 22;

def token_tag (t : Token) : Nat :=
    match t with
    | TIdent _ => tagIdent
    | TNat _ => tagNat
    | TKeyword _ => tagKeyword
    | TType _ => tagType
    | TColon => tagColon
    | TColonEq => tagColonEq
    | TArrow => tagArrow
    | TFatArrow => tagFatArrow
    | TBar => tagBar
    | TLparen => tagLparen
    | TRparen => tagRparen
    | TSemi => tagSemi
    | THole _ => tagHole
    | TString _ => tagString
    | TComma => tagComma
    | TBraceL => tagBraceL
    | TBraceR => tagBraceR
    | TExclam => tagExclam
    | TEof => tagEof
    | TBind => tagBind
    | TPipe => tagPipe
    | TBracketL => tagBracketL
    | TBracketR => tagBracketR
    end;

def is_lparen (t : Token) : Bool := eqNat (token_tag t) tagLparen;
def is_colon (t : Token) : Bool := eqNat (token_tag t) tagColon;
def is_arrow (t : Token) : Bool := eqNat (token_tag t) tagArrow;
def is_bar (t : Token) : Bool := eqNat (token_tag t) tagBar;
def is_semi (t : Token) : Bool := eqNat (token_tag t) tagSemi;
def is_comma (t : Token) : Bool := eqNat (token_tag t) tagComma;
def is_brace_r (t : Token) : Bool := eqNat (token_tag t) tagBraceR;
def is_exclam (t : Token) : Bool := eqNat (token_tag t) tagExclam;
def is_eof (t : Token) : Bool := eqNat (token_tag t) tagEof;
def is_bind (t : Token) : Bool := eqNat (token_tag t) tagBind;
def is_pipe (t : Token) : Bool := eqNat (token_tag t) tagPipe;
def is_bracket_r (t : Token) : Bool := eqNat (token_tag t) tagBracketR;

def token_nat_payload (t : Token) : Nat :=
    match t with
    | TIdent n => n
    | TNat n => n
    | TKeyword n => n
    | TType n => n
    | TString n => n
    | THole _ => Z
    | TColon => Z
    | TColonEq => Z
    | TArrow => Z
    | TFatArrow => Z
    | TBar => Z
    | TLparen => Z
    | TRparen => Z
    | TSemi => Z
    | TComma => Z
    | TBraceL => Z
    | TBraceR => Z
    | TExclam => Z
    | TBind => Z
    | TPipe => Z
    | TBracketL => Z
    | TBracketR => Z
    | TEof => Z
    end;

def token_hole_payload (t : Token) : Maybe Nat :=
    match t with
    | THole m => m
    | TIdent _ => Nothing Nat
    | TNat _ => Nothing Nat
    | TKeyword _ => Nothing Nat
    | TType _ => Nothing Nat
    | TColon => Nothing Nat
    | TColonEq => Nothing Nat
    | TArrow => Nothing Nat
    | TFatArrow => Nothing Nat
    | TBar => Nothing Nat
    | TLparen => Nothing Nat
    | TRparen => Nothing Nat
    | TSemi => Nothing Nat
    | TString _ => Nothing Nat
    | TComma => Nothing Nat
    | TBraceL => Nothing Nat
    | TBraceR => Nothing Nat
    | TExclam => Nothing Nat
    | TBind => Nothing Nat
    | TPipe => Nothing Nat
    | TBracketL => Nothing Nat
    | TBracketR => Nothing Nat
    | TEof => Nothing Nat
    end;

def tokenIsIdent (t : Token) : Maybe Nat :=
    match eqNat (token_tag t) tagIdent with
    | True => Just Nat (token_nat_payload t)
    | False => Nothing Nat
    end;

def tokenIsNat (t : Token) : Maybe Nat :=
    match eqNat (token_tag t) tagNat with
    | True => Just Nat (token_nat_payload t)
    | False => Nothing Nat
    end;

def tokenIsType (t : Token) : Maybe Nat :=
    match eqNat (token_tag t) tagType with
    | True => Just Nat (token_nat_payload t)
    | False => Nothing Nat
    end;

def tokenIsHole (t : Token) : Maybe (Maybe Nat) :=
    match eqNat (token_tag t) tagHole with
    | True => Just (Maybe Nat) (token_hole_payload t)
    | False => Nothing (Maybe Nat)
    end;

def tokenIsString (t : Token) : Maybe Nat :=
    match eqNat (token_tag t) tagString with
    | True => Just Nat (token_nat_payload t)
    | False => Nothing Nat
    end;

def tokenIsKeyword (t : Token) : Maybe Nat :=
    match eqNat (token_tag t) tagKeyword with
    | True => Just Nat (token_nat_payload t)
    | False => Nothing Nat
    end;

def tokenIsBinderName (t : Token) : Maybe Nat :=
    match tokenIsIdent t with
    | Just n => Just Nat n
    | Nothing =>
        match tokenIsHole t with
        | Nothing => Nothing Nat
        | Just m =>
            match m with
            | Nothing => Just Nat Z
            | Just _ => Nothing Nat
            end
        end
    end;

def is_keyword_atom_index (k : Nat) : Bool :=
    orb (eqNat k kwFun)
      (orb (eqNat k kwLet)
        (orb (eqNat k kwMatch)
          (eqNat k kwFix)));

def is_atom_start (t : Token) : Bool :=
    orb (orb (eqNat (token_tag t) tagIdent)
            (orb (eqNat (token_tag t) tagNat)
              (orb (eqNat (token_tag t) tagType)
                (orb (eqNat (token_tag t) tagLparen)
                  (orb (eqNat (token_tag t) tagBracketL)
                    (orb (eqNat (token_tag t) tagHole)
                      (eqNat (token_tag t) tagString)))))))
        (is_keyword_atom_index
          (maybe Nat Nat Z (fun (x : Nat) => x) (tokenIsKeyword t)));

def is_comma_list_start (t : Token) : Bool :=
    orb (is_atom_start t)
      (match tokenIsKeyword t with
      | Nothing => False
      | Just k => orb (eqNat k kwPerform) (orb (eqNat k kwDo) (eqNat k kwHandle))
      end);

def is_binder_name (t : Token) : Bool :=
    match tokenIsBinderName t with
    | Just _ => True
    | Nothing => False
    end;

def binder_names_continue : List Token -> Bool -> Bool :=
  fix binder_names_continue (toks : List Token) (seen : Bool) : Bool :=
    match toks with
    | Nil => False
    | Cons t rest =>
        match is_colon t with
        | True => seen
        | False =>
            match is_binder_name t with
            | True => binder_names_continue rest True
            | False => False
            end
        end
    end;

def is_binder_ahead (toks : List Token) : Bool :=
    match toks with
    | Nil => False
    | Cons t rest =>
        match is_lparen t with
        | False => False
        | True => binder_names_continue rest False
        end
    end;

def expect_tag (tag : Nat) (toks : List Token) (pos : Nat) : ParseResult Unit :=
    match toks with
    | Nil => PErr Unit pos
    | Cons t rest =>
        match eqNat (token_tag t) tag with
        | True => POk Unit MkUnit rest (S pos)
        | False => PErr Unit pos
        end
    end;

def expect_arrow : List Token -> Nat -> ParseResult Unit := expect_tag tagArrow;
def expect_fat_arrow : List Token -> Nat -> ParseResult Unit := expect_tag tagFatArrow;
def expect_lparen : List Token -> Nat -> ParseResult Unit := expect_tag tagLparen;
def expect_rparen : List Token -> Nat -> ParseResult Unit := expect_tag tagRparen;
def expect_colon : List Token -> Nat -> ParseResult Unit := expect_tag tagColon;
def expect_colon_eq : List Token -> Nat -> ParseResult Unit := expect_tag tagColonEq;
def expect_bar : List Token -> Nat -> ParseResult Unit := expect_tag tagBar;
def expect_brace_l : List Token -> Nat -> ParseResult Unit := expect_tag tagBraceL;
def expect_brace_r : List Token -> Nat -> ParseResult Unit := expect_tag tagBraceR;
def expect_bracket_r : List Token -> Nat -> ParseResult Unit := expect_tag tagBracketR;

def expect_ident (toks : List Token) (pos : Nat) : ParseResult Nat :=
    match toks with
    | Nil => PErr Nat pos
    | Cons t rest =>
        match tokenIsIdent t with
        | Nothing => PErr Nat pos
        | Just n => POk Nat n rest (S pos)
        end
    end;

def expect_binder_name (toks : List Token) (pos : Nat) : ParseResult Nat :=
    match toks with
    | Nil => PErr Nat pos
    | Cons t rest =>
        match tokenIsBinderName t with
        | Nothing => PErr Nat pos
        | Just n => POk Nat n rest (S pos)
        end
    end;

def expect_keyword (kw : Nat) (toks : List Token) (pos : Nat) : ParseResult Unit :=
    match toks with
    | Nil => PErr Unit pos
    | Cons t rest =>
        match tokenIsKeyword t with
        | Nothing => PErr Unit pos
        | Just k =>
            match eqNat k kw with
            | True => POk Unit MkUnit rest (S pos)
            | False => PErr Unit pos
            end
        end
    end;

def expect_string (toks : List Token) (pos : Nat) : ParseResult Nat :=
    match toks with
    | Nil => PErr Nat pos
    | Cons t rest =>
        match tokenIsString t with
        | Nothing => PErr Nat pos
        | Just n => POk Nat n rest (S pos)
        end
    end;

def bindParseResult (A : Type) (B : Type) (r : ParseResult A) (f : A -> List Token -> Nat -> ParseResult B) : ParseResult B :=
    match r with
    | POk a toks pos => f a toks pos
    | PErr pos => PErr B pos
    end;

-- List literals must sit on a `List T` binding; the seed elaborator rejects
-- `[x]` as a polymorphic constructor argument (historical CErr 64).
def list1_nat (n : Nat) : List Nat := ([n] : List Nat);
def list1_expr (e : Expr) : List Expr := ([e] : List Expr);

-- Parse one or more names before the ':' in a canonical typed binder group.
def parse_binder_names : Nat -> List Token -> Nat -> ParseResult (List Nat) :=
  fix parse_binder_names (fuel : Nat) (toks : List Token) (pos : Nat) : ParseResult (List Nat) :=
    match fuel with
    | Z => PErr (List Nat) pos
    | S fuel' =>
        match is_binder_name (peek toks) with
        | False => PErr (List Nat) pos
        | True =>
            bindParseResult Nat (List Nat) (expect_binder_name toks pos)
              (fun (n : Nat) (toks2 : List Token) (pos2 : Nat) =>
                match is_colon (peek toks2) with
                | True => POk (List Nat) (list1_nat n) toks2 pos2
                | False =>
                    bindParseResult (List Nat) (List Nat) (parse_binder_names fuel' toks2 pos2)
                      (fun (ns : List Nat) (toks3 : List Token) (pos3 : Nat) =>
                        POk (List Nat) (Cons Nat n ns) toks3 pos3)
                end)
        end
    end;

def mk_typed_binder_pairs : List Nat -> Expr -> List (Pair Nat Expr) :=
  fix mk_typed_binder_pairs (names : List Nat) (ty : Expr) : List (Pair Nat Expr) :=
    match names with
    | Nil => Nil (Pair Nat Expr)
    | Cons n rest => Cons (Pair Nat Expr) (MkPair Nat Expr n ty) (mk_typed_binder_pairs rest ty)
    end;

def mk_typed_maybe_binders : List (Pair Nat Expr) -> List (Pair Nat (Maybe Expr)) :=
  fix mk_typed_maybe_binders (bs : List (Pair Nat Expr)) : List (Pair Nat (Maybe Expr)) :=
    match bs with
    | Nil => Nil (Pair Nat (Maybe Expr))
    | Cons b rest =>
        match b with
        | MkPair n ty => Cons (Pair Nat (Maybe Expr)) (MkPair Nat (Maybe Expr) n (Just Expr ty)) (mk_typed_maybe_binders rest)
        end
    end;

def mk_lam_chain : List (Pair Nat (Maybe Expr)) -> Expr -> Expr :=
  fix mk_lam_chain (bs : List (Pair Nat (Maybe Expr))) (body : Expr) : Expr :=
    match bs with
    | Nil => body
    | Cons b rest =>
        match b with
        | MkPair n ann => ELam n ann (mk_lam_chain rest body)
        end
    end;

def mk_typed_lam_chain : List (Pair Nat Expr) -> Expr -> Expr :=
  fix mk_typed_lam_chain (bs : List (Pair Nat Expr)) (body : Expr) : Expr :=
    match bs with
    | Nil => body
    | Cons b rest =>
        match b with
        | MkPair n ty => ELam n (Just Expr ty) (mk_typed_lam_chain rest body)
        end
    end;

def mk_binder_chain : List (Pair Nat Expr) -> Expr :=
  fix mk_binder_chain (bs : List (Pair Nat Expr)) : Expr :=
    match bs with
    | Nil => ENoBinder
    | Cons b rest =>
        match b with
        | MkPair n ty => EBinder n ty (mk_binder_chain rest)
        end
    end;

def asExpr (v : Value) : Maybe (Expr) :=
    match v with
    | VExpr e => Just (Expr) e
    | VNat _v0 => Nothing (Expr)
    | VPairNatExpr _v0 => Nothing (Expr)
    | VListPairNatExpr _v0 => Nothing (Expr)
    | VListPairNatMaybeExpr _v0 => Nothing (Expr)
    | VPairNatListNat _v0 => Nothing (Expr)
    | VListPairNatListNat _v0 => Nothing (Expr)
    | VListExpr _v0 => Nothing (Expr)
    | VListNat _v0 => Nothing (Expr)
    | VRow _v0 => Nothing (Expr)
    | VListRow _v0 => Nothing (Expr)
    | VHandleClause _v0 => Nothing (Expr)
    | VListHandleClause _v0 => Nothing (Expr)
    end;

def asNat (v : Value) : Maybe (Nat) :=
    match v with
    | VExpr _v0 => Nothing (Nat)
    | VNat n => Just (Nat) n
    | VPairNatExpr _v0 => Nothing (Nat)
    | VListPairNatExpr _v0 => Nothing (Nat)
    | VListPairNatMaybeExpr _v0 => Nothing (Nat)
    | VPairNatListNat _v0 => Nothing (Nat)
    | VListPairNatListNat _v0 => Nothing (Nat)
    | VListExpr _v0 => Nothing (Nat)
    | VListNat _v0 => Nothing (Nat)
    | VRow _v0 => Nothing (Nat)
    | VListRow _v0 => Nothing (Nat)
    | VHandleClause _v0 => Nothing (Nat)
    | VListHandleClause _v0 => Nothing (Nat)
    end;

def asListPairNatExpr (v : Value) : Maybe (List (Pair Nat Expr)) :=
    match v with
    | VExpr _v0 => Nothing (List (Pair Nat Expr))
    | VNat _v0 => Nothing (List (Pair Nat Expr))
    | VPairNatExpr _v0 => Nothing (List (Pair Nat Expr))
    | VListPairNatExpr ps => Just (List (Pair Nat Expr)) ps
    | VListPairNatMaybeExpr _v0 => Nothing (List (Pair Nat Expr))
    | VPairNatListNat _v0 => Nothing (List (Pair Nat Expr))
    | VListPairNatListNat _v0 => Nothing (List (Pair Nat Expr))
    | VListExpr _v0 => Nothing (List (Pair Nat Expr))
    | VListNat _v0 => Nothing (List (Pair Nat Expr))
    | VRow _v0 => Nothing (List (Pair Nat Expr))
    | VListRow _v0 => Nothing (List (Pair Nat Expr))
    | VHandleClause _v0 => Nothing (List (Pair Nat Expr))
    | VListHandleClause _v0 => Nothing (List (Pair Nat Expr))
    end;

def asListPairNatMaybeExpr (v : Value) : Maybe (List (Pair Nat (Maybe Expr))) :=
    match v with
    | VExpr _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VNat _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VPairNatExpr _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VListPairNatExpr _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VListPairNatMaybeExpr ps => Just (List (Pair Nat (Maybe Expr))) ps
    | VPairNatListNat _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VListPairNatListNat _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VListExpr _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VListNat _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VRow _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VListRow _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VHandleClause _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    | VListHandleClause _v0 => Nothing (List (Pair Nat (Maybe Expr)))
    end;

def asPairNatListNat (v : Value) : Maybe (Pair Nat (List Nat)) :=
    match v with
    | VExpr _v0 => Nothing (Pair Nat (List Nat))
    | VNat _v0 => Nothing (Pair Nat (List Nat))
    | VPairNatExpr _v0 => Nothing (Pair Nat (List Nat))
    | VListPairNatExpr _v0 => Nothing (Pair Nat (List Nat))
    | VListPairNatMaybeExpr _v0 => Nothing (Pair Nat (List Nat))
    | VPairNatListNat p => Just (Pair Nat (List Nat)) p
    | VListPairNatListNat _v0 => Nothing (Pair Nat (List Nat))
    | VListExpr _v0 => Nothing (Pair Nat (List Nat))
    | VListNat _v0 => Nothing (Pair Nat (List Nat))
    | VRow _v0 => Nothing (Pair Nat (List Nat))
    | VListRow _v0 => Nothing (Pair Nat (List Nat))
    | VHandleClause _v0 => Nothing (Pair Nat (List Nat))
    | VListHandleClause _v0 => Nothing (Pair Nat (List Nat))
    end;

def asListPairNatListNat (v : Value) : Maybe (List (Pair Nat (List Nat))) :=
    match v with
    | VExpr _v0 => Nothing (List (Pair Nat (List Nat)))
    | VNat _v0 => Nothing (List (Pair Nat (List Nat)))
    | VPairNatExpr _v0 => Nothing (List (Pair Nat (List Nat)))
    | VListPairNatExpr _v0 => Nothing (List (Pair Nat (List Nat)))
    | VListPairNatMaybeExpr _v0 => Nothing (List (Pair Nat (List Nat)))
    | VPairNatListNat _v0 => Nothing (List (Pair Nat (List Nat)))
    | VListPairNatListNat ps => Just (List (Pair Nat (List Nat))) ps
    | VListExpr _v0 => Nothing (List (Pair Nat (List Nat)))
    | VListNat _v0 => Nothing (List (Pair Nat (List Nat)))
    | VRow _v0 => Nothing (List (Pair Nat (List Nat)))
    | VListRow _v0 => Nothing (List (Pair Nat (List Nat)))
    | VHandleClause _v0 => Nothing (List (Pair Nat (List Nat)))
    | VListHandleClause _v0 => Nothing (List (Pair Nat (List Nat)))
    end;

def asListExpr (v : Value) : Maybe (List Expr) :=
    match v with
    | VExpr _v0 => Nothing (List Expr)
    | VNat _v0 => Nothing (List Expr)
    | VPairNatExpr _v0 => Nothing (List Expr)
    | VListPairNatExpr _v0 => Nothing (List Expr)
    | VListPairNatMaybeExpr _v0 => Nothing (List Expr)
    | VPairNatListNat _v0 => Nothing (List Expr)
    | VListPairNatListNat _v0 => Nothing (List Expr)
    | VListExpr es => Just (List Expr) es
    | VListNat _v0 => Nothing (List Expr)
    | VRow _v0 => Nothing (List Expr)
    | VListRow _v0 => Nothing (List Expr)
    | VHandleClause _v0 => Nothing (List Expr)
    | VListHandleClause _v0 => Nothing (List Expr)
    end;

def asListNat (v : Value) : Maybe (List Nat) :=
    match v with
    | VExpr _v0 => Nothing (List Nat)
    | VNat _v0 => Nothing (List Nat)
    | VPairNatExpr _v0 => Nothing (List Nat)
    | VListPairNatExpr _v0 => Nothing (List Nat)
    | VListPairNatMaybeExpr _v0 => Nothing (List Nat)
    | VPairNatListNat _v0 => Nothing (List Nat)
    | VListPairNatListNat _v0 => Nothing (List Nat)
    | VListExpr _v0 => Nothing (List Nat)
    | VListNat ns => Just (List Nat) ns
    | VRow _v0 => Nothing (List Nat)
    | VListRow _v0 => Nothing (List Nat)
    | VHandleClause _v0 => Nothing (List Nat)
    | VListHandleClause _v0 => Nothing (List Nat)
    end;

def asListRow (v : Value) : Maybe (List (Pair (List (Pair Nat (List Nat))) Expr)) :=
    match v with
    | VExpr _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VNat _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VPairNatExpr _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VListPairNatExpr _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VListPairNatMaybeExpr _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VPairNatListNat _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VListPairNatListNat _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VListExpr _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VListNat _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VRow _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VListRow rs => Just (List (Pair (List (Pair Nat (List Nat))) Expr)) rs
    | VHandleClause _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    | VListHandleClause _v0 => Nothing (List (Pair (List (Pair Nat (List Nat))) Expr))
    end;

def asListHandleClause (v : Value) : Maybe (List (Pair Nat (Pair (List Nat) Expr))) :=
    match v with
    | VExpr _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VNat _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VPairNatExpr _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VListPairNatExpr _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VListPairNatMaybeExpr _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VPairNatListNat _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VListPairNatListNat _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VListExpr _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VListNat _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VRow _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VListRow _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VHandleClause _v0 => Nothing (List (Pair Nat (Pair (List Nat) Expr)))
    | VListHandleClause cs => Just (List (Pair Nat (Pair (List Nat) Expr))) cs
    end;

def okExpr (e : Expr) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VExpr e) toks pos;

def okPairNatExpr (p : Pair Nat Expr) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VPairNatExpr p) toks pos;

def okListPairNatExpr (ps : List (Pair Nat Expr)) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VListPairNatExpr ps) toks pos;

def okListPairNatMaybeExpr (ps : List (Pair Nat (Maybe Expr))) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VListPairNatMaybeExpr ps) toks pos;

def okPairNatListNat (p : Pair Nat (List Nat)) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VPairNatListNat p) toks pos;

def okListPairNatListNat (ps : List (Pair Nat (List Nat))) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VListPairNatListNat ps) toks pos;

def okListExpr (es : List Expr) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VListExpr es) toks pos;

def okListNat (ns : List Nat) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VListNat ns) toks pos;

def okListRow (rs : List (Pair (List (Pair Nat (List Nat))) Expr)) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VListRow rs) toks pos;

def okListHandleClause (cs : List (Pair Nat (Pair (List Nat) Expr))) (toks : List Token) (pos : Nat) : ParseResult Value := POk Value (VListHandleClause cs) toks pos;

def bindValue (A : Type) (f : Value -> Maybe A) (r : ParseResult Value) (cont : A -> List Token -> Nat -> ParseResult Value) : ParseResult Value :=
    match r with
    | POk v toks pos =>
        match f v with
        | Nothing => PErr Value pos
        | Just a => cont a toks pos
        end
    | PErr pos => PErr Value pos
    end;

-- 1 scrut → EMatch; multi / multi-col patterns → EMultiMatch.
-- Named apart from desugar_match.ouro's desugar_match: that one is
-- fuel-driven and returns Expr, this one runs at parse time and carries the
-- token stream, so a module importing both stages needs distinct names.
def desugar_match_rows (scruts : List Expr) (rows : List (Pair (List (Pair Nat (List Nat))) Expr)) (toks : List Token) (pos : Nat) : ParseResult Expr :=
    match scruts with
    | Nil => PErr Expr pos
    | Cons scrut rest_scruts =>
        match rest_scruts with
        | Cons _ _ =>
            match rows with
            | Nil => POk Expr (EMatch scrut ENoBranch) toks pos
            | Cons _ _ => POk Expr (EMultiMatch scruts rows) toks pos
            end
        | Nil =>
            match rows with
            | Nil => POk Expr (EMatch scrut ENoBranch) toks pos
            | Cons r rest =>
                match r with
                | MkPair pats body =>
                    match pats with
                    | Cons p patsrest =>
                        match patsrest with
                        | Nil =>
                            match p with
                            | MkPair ctor vars =>
                                POk Expr
                                  (EMatch scrut
                                    (EBranch (Cons Nat ctor vars) body
                                      (build_branches rest)))
                                  toks pos
                            end
                        | Cons _p2 _p2s =>
                            POk Expr (EMultiMatch scruts rows) toks pos
                        end
                    | Nil => PErr Expr pos
                    end
                end
            end
        end
    end;

def parse_min_ok : Nat := Z;
