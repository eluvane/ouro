import "ast.ouro",
  "path.ouro";

def canonicalize_import_declarations (State : Type) (base : List Nat)
    (intern_string : State -> List Nat -> Pair Nat State)
    (spelling_bytes : State -> Nat -> List Nat)
    (initial : State) (decls : List Decl) : Pair (List Decl) State :=
  (fix go (remaining : List Decl) (state : State) : Pair (List Decl) State :=
    match remaining with
    | Nil => MkPair (List Decl) State (Nil Decl) state
    | Cons decl rest =>
        let rewritten : Pair Decl State := match decl with
          | DImport spelling =>
              match intern_string state (canon_path base (spelling_bytes state spelling)) with
              | MkPair canonical updated => MkPair Decl State (DImport canonical) updated
              end
          | DDef _ _ _ _ _ => MkPair Decl State decl state
          | DAxiom _ _ => MkPair Decl State decl state
          | DInductive _ _ _ _ _ => MkPair Decl State decl state
          | DEffect _ _ _ => MkPair Decl State decl state
          | DIntrinsic _ _ _ _ => MkPair Decl State decl state
          | DExtern _ _ _ => MkPair Decl State decl state
          | DRepresentation _ _ => MkPair Decl State decl state
          end in
        match rewritten with
        | MkPair head next =>
            match go rest next with
            | MkPair tail final => MkPair (List Decl) State (Cons Decl head tail) final
            end
        end
    end) decls initial;
