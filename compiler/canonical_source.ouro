-- Deterministic serialization and hashing for CanonicalSourceUnit.
-- The compilation hot path keeps tokens directly; these functions materialize
-- compact bytes only for cache identity, tests, diagnostics evidence, or debug.

import "source_text.ouro",
  "../std/data.ouro",
  "../std/word.ouro",
  "canonical_model.ouro",
  "canonical_hash.ouro",
  "token.ouro";

inductive CanonicalBytesResult : Type :=
  | CanonicalBytesOk : List Nat -> CanonicalBytesResult
  | CanonicalBytesErr : Nat -> Nat -> CanonicalBytesResult;

inductive CanonicalHashResult : Type :=
  | CanonicalHashOk : CanonicalHash -> CanonicalHashResult
  | CanonicalHashErr : Nat -> Nat -> CanonicalHashResult;

def cs_err_ident : Nat := 1;
def cs_err_string : Nat := 2;
def cs_err_keyword : Nat := 3;

def cs_lookup_id (entries : List (Pair (List Nat) Nat)) (id : Nat)
    : Maybe (List Nat) :=
  (fix go (rest : List (Pair (List Nat) Nat)) : Maybe (List Nat) :=
    match rest with
    | Nil => Nothing (List Nat)
    | Cons entry tail =>
        match entry with
        | MkPair text found =>
            match eqNat found id with
            | True => Just(List Nat, text)
            | False => go tail
            end
        end
    end) entries;

def cs_nat_codes (value : Nat) : List Nat :=
  map(Nat, Nat, fun (digit : Nat) => add 48 digit, to_digits value);

def cs_nat_rev (value : Nat) : List Nat :=
  reverse(Nat, cs_nat_codes value);

def cs_escape_string (content : List Nat) : List Nat :=
  reverse Nat
    ((fix go (rest : List Nat) (acc : List Nat) : List Nat :=
      match rest with
      | Nil => Cons Nat 34 acc
      | Cons byte tail =>
          match eqNat byte 10 with
          | True => go(tail, Cons Nat 110 (Cons Nat 92 acc))
          | False =>
              match eqNat byte 9 with
              | True => go(tail, Cons Nat 116 (Cons Nat 92 acc))
              | False =>
                  match eqNat byte 13 with
                  | True => go(tail, Cons Nat 114 (Cons Nat 92 acc))
                  | False =>
                      match eqNat byte 34 with
                      | True => go(tail, Cons Nat 34 (Cons Nat 92 acc))
                      | False =>
                          match eqNat byte 92 with
                          | True => go(tail, Cons Nat 92 (Cons Nat 92 acc))
                          | False => go(tail, Cons Nat byte acc)
                          end
                      end
                  end
              end
          end
      end) content [34]);

def cs_keyword_codes (keyword : Nat) : Maybe (List Nat) :=
  match eqNat keyword kwDef with
  | True => Just(List Nat, [100, 101, 102])
  | False =>
      match eqNat keyword kwAxiom with
      | True => Just(List Nat, [97, 120, 105, 111, 109])
      | False =>
          match eqNat keyword kwInductive with
          | True => Just(List Nat, [105, 110, 100, 117, 99, 116, 105, 118, 101])
          | False =>
              match eqNat keyword kwFun with
              | True => Just(List Nat, [102, 117, 110])
              | False =>
                  match eqNat keyword kwMatch with
                  | True => Just(List Nat, [109, 97, 116, 99, 104])
                  | False =>
                      match eqNat keyword kwWith with
                      | True => Just(List Nat, [119, 105, 116, 104])
                      | False =>
                          match eqNat keyword kwEnd with
                          | True => Just(List Nat, [101, 110, 100])
                          | False =>
                              match eqNat keyword kwLet with
                              | True => Just(List Nat, [108, 101, 116])
                              | False =>
                                  match eqNat keyword kwIn with
                                  | True => Just(List Nat, [105, 110])
                                  | False =>
                                      match eqNat keyword kwFix with
                                      | True => Just(List Nat, [102, 105, 120])
                                      | False =>
                                          match eqNat keyword kwImport with
                                          | True => Just(List Nat, [105, 109, 112, 111, 114, 116])
                                          | False =>
                                              match eqNat keyword kwEffect with
                                              | True => Just(List Nat, [101, 102, 102, 101, 99, 116])
                                              | False =>
                                                  match eqNat keyword kwWhere with
                                                  | True => Just(List Nat, [119, 104, 101, 114, 101])
                                                  | False =>
                                                      match eqNat keyword kwDo with
                                                      | True => Just(List Nat, [100, 111])
                                                      | False =>
                                                          match eqNat keyword kwPerform with
                                                          | True => Just(List Nat, [112, 101, 114, 102, 111, 114, 109])
                                                          | False =>
                                                              match eqNat keyword kwHandle with
                                                              | True => Just(List Nat, [104, 97, 110, 100, 108, 101])
                                                              | False =>
                                                                  match eqNat keyword kwRecord with
                                                                  | True => Just(List Nat, [114, 101, 99, 111, 114, 100])
                                                                  | False =>
                                                                      match eqNat keyword kwIntrinsic with
                                                                      | True => Just(List Nat, [105, 110, 116, 114, 105, 110, 115, 105, 99])
                                                                      | False =>
                                                                          match eqNat keyword kwExtern with
                                                                          | True => Just(List Nat, [101, 120, 116, 101, 114, 110])
                                                                          | False =>
                                                                              match eqNat keyword kwRepresentation with
                                                                              | True => Just(List Nat, [114, 101, 112, 114, 101, 115, 101, 110, 116, 97, 116, 105, 111, 110])
                                                                              | False => Nothing (List Nat)
                                                                              end
                                                                          end
                                                                      end
                                                                  end
                                                              end
                                                          end
                                                      end
                                                  end
                                              end
                                          end
                                      end
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
  end;

def cs_token_codes
    (idents : List (Pair (List Nat) Nat))
    (strings : List (Pair (List Nat) Nat))
    (token : Token) : CanonicalBytesResult :=
  match token with
  | TIdent id =>
      match cs_lookup_id idents id with
      | Nothing => CanonicalBytesErr cs_err_ident id
      | Just text => CanonicalBytesOk text
      end
  | TNat value => CanonicalBytesOk (cs_nat_codes value)
  | TKeyword keyword =>
      match cs_keyword_codes keyword with
      | Nothing => CanonicalBytesErr cs_err_keyword keyword
      | Just text => CanonicalBytesOk text
      end
  | TType level =>
      match level with
      | Z => CanonicalBytesOk [84, 121, 112, 101]
      | S _ => CanonicalBytesOk (append Nat [84, 121, 112, 101] (cs_nat_codes level))
      end
  | TColon => CanonicalBytesOk [58]
  | TColonEq => CanonicalBytesOk [58, 61]
  | TArrow => CanonicalBytesOk [45, 62]
  | TFatArrow => CanonicalBytesOk [61, 62]
  | TBar => CanonicalBytesOk [124]
  | TLparen => CanonicalBytesOk [40]
  | TRparen => CanonicalBytesOk [41]
  | TSemi => CanonicalBytesOk [59]
  | THole hole =>
      match hole with
      | Nothing => CanonicalBytesOk [63]
      | Just id =>
          match cs_lookup_id idents id with
          | Nothing => CanonicalBytesErr cs_err_ident id
          | Just text => CanonicalBytesOk (Cons Nat 63 text)
          end
      end
  | TString id =>
      match cs_lookup_id strings id with
      | Nothing => CanonicalBytesErr cs_err_string id
      | Just text => CanonicalBytesOk (cs_escape_string text)
      end
  | TComma => CanonicalBytesOk [44]
  | TBraceL => CanonicalBytesOk [123]
  | TBraceR => CanonicalBytesOk [125]
  | TExclam => CanonicalBytesOk [33]
  | TEof => CanonicalBytesOk (Nil Nat)
  | TBind => CanonicalBytesOk [60, 45]
  | TPipe => CanonicalBytesOk [124, 62]
  | TBracketL => CanonicalBytesOk [91]
  | TBracketR => CanonicalBytesOk [93]
  | TDotDot => CanonicalBytesOk [46, 46]
  end;

def cs_first (bytes : List Nat) : Maybe Nat :=
  match bytes with
  | Nil => Nothing Nat
  | Cons byte _ => Just Nat byte
  end;

def cs_between (lower : Nat) (byte : Nat) (upper : Nat) : Bool :=
  andb
    (match compareNat lower byte with | GT => False | LT => True | EQ => True end)
    (match compareNat byte upper with | GT => False | LT => True | EQ => True end);

def cs_is_digit (byte : Nat) : Bool := cs_between 48 byte 57;

def cs_is_alpha (byte : Nat) : Bool :=
  orb(cs_between 65 byte 90, cs_between 97 byte 122);

def cs_is_ident_start (byte : Nat) : Bool :=
  orb(cs_is_alpha byte, eqNat byte 95);

def cs_is_ident_char (byte : Nat) : Bool :=
  orb(cs_is_ident_start byte, orb(cs_is_digit byte, eqNat byte 39));

def cs_needs_separator (previous : Token) (next_bytes : List Nat) : Bool :=
  match cs_first next_bytes with
  | Nothing => False
  | Just first =>
      match previous with
      | TIdent _ => cs_is_ident_char first
      | TKeyword _ => cs_is_ident_char first
      | TType _ => cs_is_ident_char first
      | TNat _ => orb(cs_is_digit first, cs_is_ident_start first)
      | THole hole =>
          match hole with
          | Nothing => cs_is_ident_start first
          | Just _ => cs_is_ident_char first
          end
      | TColon => eqNat first 61
      | TColonEq => False
      | TArrow => False
      | TFatArrow => False
      | TBar => False
      | TLparen => False
      | TRparen => False
      | TSemi => False
      | TString _ => False
      | TComma => False
      | TBraceL => False
      | TBraceR => False
      | TExclam => False
      | TEof => False
      | TBind => False
      | TPipe => False
      | TBracketL => False
      | TBracketR => False
      | TDotDot => False
      end
  end;

def cs_is_eof (token : Token) : Bool :=
  match token with
  | TEof => True
  | TIdent _ => False
  | TNat _ => False
  | TKeyword _ => False
  | TType _ => False
  | TColon => False
  | TColonEq => False
  | TArrow => False
  | TFatArrow => False
  | TBar => False
  | TLparen => False
  | TRparen => False
  | TSemi => False
  | THole _ => False
  | TString _ => False
  | TComma => False
  | TBraceL => False
  | TBraceR => False
  | TExclam => False
  | TBind => False
  | TPipe => False
  | TBracketL => False
  | TBracketR => False
  | TDotDot => False
  end;

def canonical_bytes_from
    (idents : List (Pair (List Nat) Nat))
    (strings : List (Pair (List Nat) Nat))
    (unit : CanonicalSourceUnit) : CanonicalBytesResult :=
  (fix go (tokens : List Token) (previous : Maybe Token) (acc : List Nat)
      : CanonicalBytesResult :=
    match tokens with
    | Nil => CanonicalBytesOk (reverse Nat acc)
    | Cons token rest =>
        match cs_is_eof token with
        | True => CanonicalBytesOk (reverse Nat acc)
        | False =>
            match cs_token_codes idents strings token with
            | CanonicalBytesErr code detail => CanonicalBytesErr code detail
            | CanonicalBytesOk bytes =>
                let acc1 : List Nat :=
                  match previous with
                  | Nothing => acc
                  | Just prev =>
                      match cs_needs_separator prev bytes with
                      | True => Cons Nat 32 acc
                      | False => acc
                      end
                  end in
                go(rest, Just Token token, source_emit_reversed acc1 bytes)
            end
        end
    end) (canonical_tokens unit) (Nothing Token) (Nil Nat);

def canonical_semantic_hash_from
    (idents : List (Pair (List Nat) Nat))
    (strings : List (Pair (List Nat) Nat))
    (unit : CanonicalSourceUnit) : CanonicalHashResult :=
  match canonical_bytes_from idents strings unit with
  | CanonicalBytesErr code detail => CanonicalHashErr code detail
  | CanonicalBytesOk bytes => CanonicalHashOk (canonical_hash_codes bytes)
  end;

def canonical_compact_bytes_from
    (idents : List (Pair (List Nat) Nat))
    (strings : List (Pair (List Nat) Nat))
    (unit : CanonicalSourceUnit) : Maybe Nat :=
  match canonical_bytes_from idents strings unit with
  | CanonicalBytesErr _ _ => Nothing Nat
  | CanonicalBytesOk bytes => Just(Nat, length Nat bytes)
  end;

def canonical_removed_bytes_from
    (idents : List (Pair (List Nat) Nat))
    (strings : List (Pair (List Nat) Nat))
    (unit : CanonicalSourceUnit) : Maybe Nat :=
  match canonical_compact_bytes_from idents strings unit with
  | Nothing => Nothing Nat
  | Just compact_bytes =>
      Just(Nat, sub(canonical_source_bytes unit, compact_bytes))
  end;
