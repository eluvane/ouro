-- Records desugar to existing single-constructor inductives; no kernel rule is introduced here.

-- @entry expand_records
-- @export expand_records; @doc docs/syntax.md
-- @export record_ctor_type; @doc docs/syntax.md
-- @export rec_field_names; @doc docs/syntax.md
-- @export expand_one; @doc docs/syntax.md

import "../std/data.ouro",
  "ast.ouro";

-- A record field is (name, type), same pairing the inductive ctor list uses.
def record_ctor_type (name : Nat) (fs : List (Pair Nat Expr)) : Expr :=
  mk_pi_chain(fs, EVar name);

def record_accessor_body (ctor : Nat) (arg : Nat) (fs : List (Pair Nat Expr))
    (selected : Nat) : Expr :=
  EMatch (EVar arg)
    (EBranch
      (Cons Nat ctor (rec_field_names fs))
      (EVar selected)
      ENoBranch);

def rec_accessors (recName : Nat) (ctor : Nat) (arg : Nat)
    : List (Pair Nat Expr) -> List Decl :=
  fix rec_accessors (fs : List (Pair Nat Expr)) : List Decl :=
    match fs with
    | Nil => Nil Decl
    | Cons f rest =>
        match f with
        | MkPair n ty =>
            Cons Decl
              (DDef n
                (EPi arg (EVar recName) ty)
                (ELam arg (Just(Expr, EVar recName))
                  (record_accessor_body ctor arg fs n)))
              (rec_accessors rest)
        end
    end;

def expand_one (name : Nat) (ctor : Nat) (fs : List (Pair Nat Expr)) : List Decl :=
  Cons Decl
    (DInductive name (Nil (Pair Nat Expr)) (ESort Z)
      (Cons (Pair Nat Expr)
        (MkPair Nat Expr ctor (record_ctor_type name fs))
        (Nil (Pair Nat Expr))) Z)
    (rec_accessors name ctor Z fs);

-- Record syntax is pre-expanded to DInductive before this pass.
def expand_records (ds : List Decl) : List Decl := ds;
