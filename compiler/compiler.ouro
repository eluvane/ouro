-- @entry compile_pipeline
-- @export compile_program; @doc docs/tcb.md
-- @export compile_program_with_owner; @doc docs/tcb.md
-- @export compile_program_with_location; @doc docs/tcb.md
-- @export compile_program_result; @doc docs/tcb.md
-- @export extract_program; @doc docs/tcb.md
-- @export compile_program_extract; @doc docs/tcb.md
-- @export compile_core_extract_one; @doc docs/tcb.md
-- @export pipeline_status_after; @doc docs/tcb.md
-- @export extract_apps; @doc docs/tcb.md

import "../std/data.ouro",
  "core.ouro",
  "pipeline_abi.ouro";
import "file_check_environment.ouro", "source_name_index.ouro";

def fuel32 : Nat := add(add ten ten, add(12, ten));

-- Outside valid contexts; checked paths reject missing names first.
def compile_missing_rel : Nat := fuel1k;

def lookup_c (name : Nat) : List Nat -> Nat :=
    fix lookup_c (ctx : List Nat) : Nat :=
      match ctx with
      | Nil => compile_missing_rel
      | Cons y ys =>
          match eqNat y name with
          | True => Z
          | False => S (lookup_c ys)
          end
      end;

def bound_name (name : Nat) : List Nat -> Bool :=
    fix bound_name (ctx : List Nat) : Bool :=
      match ctx with
      | Nil => False
      | Cons y ys =>
          match eqNat y name with
          | True => True
          | False => bound_name ys
          end
      end;

def case_info_has_future_global (ci : CaseInfo) (future : List Nat) : Bool :=
    match ci with
    | MkCaseInfo ind _ _ => bound_name ind future
    end;

-- Both preflight paths visit the same global-bearing fields at the same depth.
def surface_global_references : Nat -> Surface -> EntryIndex :=
  fun (initial_fuel : Nat) (root_surface : Surface) =>
      (fix visit (fuel : Nat) (surface : Surface) (index : EntryIndex) : EntryIndex :=
        match fuel with
        | Z => index
        | S next =>
            match surface with
            | SVar _ => index
            | SSort _ => index
            | SPi _ domain codomain => visit next codomain (visit next domain index)
            | SLam _ annotation body => visit next body (visit next annotation index)
            | SApp function argument => visit next argument (visit next function index)
            | SLet _ value typ body => visit next body (visit next typ (visit next value index))
            | SConst name => entry_index_insert name EntryIndexReserved index
            | SInd name => entry_index_insert name EntryIndexReserved index
            | SConstruct family _ _ => entry_index_insert family EntryIndexReserved index
            | SCase info predicate scrutinee branches =>
                let family_index : EntryIndex := match info with
                  | MkCaseInfo family _ _ => entry_index_insert family EntryIndexReserved index
                  end in
                let branch_index : EntryIndex := visit next scrutinee (visit next predicate family_index) in
                (fix scan (pending : List Surface) (known : EntryIndex) : EntryIndex :=
                  match pending with
                  | Nil => known
                  | Cons branch rest => scan rest (visit next branch known)
                  end) branches branch_index
            | SFix _ _ _ typ body => visit next body (visit next typ index)
            | SHole _ => index
            | SEffectRow typ => visit next typ index
            | SPerform operation arguments =>
                (fix scan (pending : List Surface) (known : EntryIndex) : EntryIndex :=
                  match pending with
                  | Nil => known
                  | Cons argument rest => scan rest (visit next argument known)
                  end) arguments (entry_index_insert operation EntryIndexReserved index)
            | SStr _ typ => entry_index_insert typ EntryIndexReserved index
            end
        end) initial_fuel root_surface EntryIndexEmpty;

def surface_has_future_global (fuel : Nat) (surface : Surface) (future : List Nat) : Bool :=
    let references : EntryIndex := surface_global_references fuel surface in
    match references with
    | EntryIndexEmpty => False
    | EntryIndexNode _ _ _ _ _ =>
        (fix find (remaining : List Nat) : Bool :=
          match remaining with
          | Nil => False
          | Cons name rest => match entry_index_lookup name references with
              | Just _ => True
              | Nothing => find rest
              end
          end) future
    end;

-- Totality sentinel (public paths reject unsupported first).
def invalid_core_c : CoreTerm := CRel compile_missing_rel;

-- Holes/fuel out → False (compile_pipeline fails closed).
def surface_supported : Nat -> Surface -> List Nat -> Bool :=
  fix surface_supported (fuel : Nat) (s : Surface) (ctx : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel' =>
        match s with
        | SVar name => bound_name name ctx
        | SSort _ => True
        | SPi name dom cod =>
            andb (surface_supported fuel' dom ctx)
              (surface_supported fuel' cod (Cons Nat name ctx))
        | SLam name ann body =>
            andb (surface_supported fuel' ann ctx)
              (surface_supported fuel' body (Cons Nat name ctx))
        | SApp f a =>
            andb (surface_supported fuel' f ctx)
              (surface_supported fuel' a ctx)
        | SLet name v ty body =>
            andb (surface_supported fuel' v ctx)
              (andb (surface_supported fuel' ty ctx)
                (surface_supported fuel' body (Cons Nat name ctx)))
        | SConst _ => True
        | SInd _ => True
        | SConstruct _ _ _ => True
        | SCase _ p scrut bs =>
            andb (surface_supported fuel' p ctx)
              (andb (surface_supported fuel' scrut ctx)
                ((fix go (xs : List Surface) : Bool :=
                    match xs with
                    | Nil => True
                    | Cons b xs' =>
                        andb(surface_supported fuel' b ctx, go xs')
                    end) bs))
        | SFix name _ _ ty body =>
            andb (surface_supported fuel' ty ctx)
              (surface_supported fuel' body (Cons Nat name ctx))
        | SHole _ => False
        | SEffectRow ty => surface_supported fuel' ty ctx
        | SPerform _ args =>
            (fix go (xs : List Surface) : Bool :=
                match xs with
                | Nil => True
                | Cons a xs' =>
                    andb(surface_supported fuel' a ctx, go xs')
                end) args
        | SStr _ _ => True
        end
    end;

-- Total elab; callers must precheck surface_supported.
def compile_elab_fuel : Nat -> Surface -> List Nat -> CoreTerm :=
  fix compile_elab_fuel (fuel : Nat) (s : Surface) (ctx : List Nat) : CoreTerm :=
    match fuel with
    | Z => invalid_core_c
    | S fuel' =>
        match s with
        | SVar name => CRel (lookup_c name ctx)
        | SSort u => CSort u
        | SPi name dom cod =>
            CPi (compile_elab_fuel fuel' dom ctx)
              (compile_elab_fuel fuel' cod (Cons Nat name ctx))
        | SLam name ann body =>
            CLam (compile_elab_fuel fuel' ann ctx)
              (compile_elab_fuel fuel' body (Cons Nat name ctx))
        | SApp f a =>
            CApp(compile_elab_fuel fuel' f ctx, compile_elab_fuel fuel' a ctx)
        | SLet name v ty body =>
            CLetIn (compile_elab_fuel fuel' v ctx) (compile_elab_fuel fuel' ty ctx)
              (compile_elab_fuel fuel' body (Cons Nat name ctx))
        | SConst n => CConst n
        | SInd n => CInd n
        | SConstruct i j np => CConstruct i j np
        | SCase ci p scrut bs =>
            CCase ci (compile_elab_fuel fuel' p ctx)
              (compile_elab_fuel fuel' scrut ctx)
              ((fix go (xs : List Surface) : List CoreTerm :=
                  match xs with
                  | Nil => Nil CoreTerm
                  | Cons b xs' =>
                      Cons(CoreTerm, compile_elab_fuel fuel' b ctx, go xs')
                  end) bs)
        | SFix name rec_arg arity ty body =>
            CFix name rec_arg arity (compile_elab_fuel fuel' ty ctx)
              (compile_elab_fuel fuel' body (Cons Nat name ctx))
        | SHole _ => invalid_core_c
        | SEffectRow ty => compile_elab_fuel fuel' ty ctx
        | SPerform op args =>
            (fix go (xs : List Surface) (acc : CoreTerm) : CoreTerm :=
                match xs with
                | Nil => acc
                | Cons a xs' =>
                    go(xs', CApp(acc, compile_elab_fuel fuel' a ctx))
                end) args (CConst op)
        | SStr n ty => CStrLit n ty
        end
    end;

def compile_surface (s : Surface) (ctx : List Nat) : CoreTerm :=
    compile_elab_fuel fuel32 s ctx;

-- Untrusted structural traversal only. Declaration acceptance belongs to
-- file_elab; the CompResult returned by these lowering stages is not a proof
-- that the term is scoped or well typed.
def wf_core : Nat -> CoreTerm -> Bool :=
  fix wf_core (fuel : Nat) (t : CoreTerm) : Bool :=
    match fuel with
    | Z => False
    | S fuel' =>
        match t with
        | CRel _ => True
        | CSort _ => True
        | CPi a b => andb(wf_core fuel' a, wf_core fuel' b)
        | CLam a b => andb(wf_core fuel' a, wf_core fuel' b)
        | CApp f a => andb(wf_core fuel' f, wf_core fuel' a)
        | CLetIn v ty body =>
            andb (wf_core fuel' v)
              (andb(wf_core fuel' ty, wf_core fuel' body))
        | CConst _ => True
        | CInd _ => True
        | CConstruct _ _ _ => True
        | CCase _ p scrut bs =>
            andb (wf_core fuel' p)
              (andb (wf_core fuel' scrut)
                ((fix go (xs : List CoreTerm) : Bool :=
                    match xs with
                    | Nil => True
                    | Cons b xs' => andb(wf_core fuel' b, go xs')
                    end) bs))
        | CFix _ _ _ ty body =>
            andb(wf_core fuel' ty, wf_core fuel' body)
        | CStrBytes _ _ => True
        | CStrLit _ _ => True
        end
    end;

def check_core (t : CoreTerm) : Bool := wf_core fuel32 t;

def compile_stage_check (s : Surface) (ctx : List Nat)
    : Either (Pair CompileProgramPhase CompError) CoreTerm :=
    match surface_supported fuel32 s ctx with
    | False => Left (Pair CompileProgramPhase CompError) CoreTerm
        (MkPair CompileProgramPhase CompError CompileSurfacePhase (ErrCode(S (S Z), Z)))
    | True =>
        let t : CoreTerm := compile_surface s ctx in
        match check_core t with
        | True => Right (Pair CompileProgramPhase CompError) CoreTerm t
        | False => Left (Pair CompileProgramPhase CompError) CoreTerm
            (MkPair CompileProgramPhase CompError CompileCorePhase (ErrCode(S (S Z), S Z)))
        end
    end;

def compile_and_check (s : Surface) (ctx : List Nat) : CompResult CoreTerm :=
    match compile_stage_check s ctx with
    | Left failed => match failed with
      | MkPair _ error => CErr CoreTerm error
      end
    | Right core => COk CoreTerm core
    end;

def extract_tag (t : CoreTerm) : Nat :=
    match t with
    | CRel _ => Z
    | CSort _ => S Z
    | CPi _ _ => 2
    | CLam _ _ => 3
    | CApp _ _ => 4
    | CLetIn _ _ _ => 5
    | CConst _ => 6
    | CInd _ => 7
    | CConstruct _ _ _ => 8
    | CCase _ _ _ _ => 9
    | CFix _ _ _ _ _ => 10
    | CStrLit _ _ => 11
    | CStrBytes _ _ => 12
    end;

def count_apps : Nat -> CoreTerm -> Nat :=
  fix count_apps (fuel : Nat) (t : CoreTerm) : Nat :=
    match fuel with
    | Z => Z
    | S fuel' =>
        match t with
        | CRel _ => Z
        | CSort _ => Z
        | CPi a b => add(count_apps fuel' a, count_apps fuel' b)
        | CLam a b => add(count_apps fuel' a, count_apps fuel' b)
        | CApp f a =>
            S (add(count_apps fuel' f, count_apps fuel' a))
        | CLetIn v ty body =>
            add (count_apps fuel' v)
              (add(count_apps fuel' ty, count_apps fuel' body))
        | CConst _ => Z
        | CInd _ => Z
        | CConstruct _ _ _ => Z
        | CCase _ p scrut bs =>
            add (count_apps fuel' p)
              (add (count_apps fuel' scrut)
                ((fix go (xs : List CoreTerm) : Nat :=
                    match xs with
                    | Nil => Z
                    | Cons b xs' => add(count_apps fuel' b, go xs')
                    end) bs))
        | CFix _ _ _ ty body =>
            add(count_apps fuel' ty, count_apps fuel' body)
        | CStrBytes _ _ => Z
        | CStrLit _ _ => Z
        end
    end;

def compile_pipeline (s : Surface) (ctx : List Nat) : CompResult CoreTerm :=
    compile_and_check s ctx;

def status_ok : Nat := Z;

def status_err (detail : Nat) : Nat := S detail;

def pipeline_ok : List Nat -> Nat :=
  fix pipeline_ok (xs : List Nat) : Nat :=
    match xs with
    | Nil => Z
    | Cons s xs' =>
        match s with
        | Z => pipeline_ok xs'
        | S d => S d
        end
    end;

def pipeline_ok_stages (p : Nat) (d : Nat) (l : Nat) (c : Nat) (e : Nat) : Nat :=
    let xs : List Nat := ([p, d, l, c, e] : List Nat) in
    pipeline_ok xs;

def extract_apps (t : CoreTerm) : Nat := count_apps fuel32 t;

def compile_program_item_with (duplicate : Nat -> List Nat -> Bool)
    (future_global : Surface -> List Nat -> Bool)
    (name : Nat) (surface : Surface) (future : List Nat)
    (ctx : List Nat) (seen : List Nat)
    : Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm) :=
  let refuse (phase : CompileProgramPhase)
      : Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm) :=
    Left (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm)
      (MkPair CompileProgramPhase CompError phase (ErrCode 3 name)) in
  match future with
  | Nil => refuse CompileFutureSlotPhase
  | Cons _ future_rest =>
      match duplicate name seen with
      | True => refuse CompileDuplicatePhase
      | False =>
          match future_global surface future_rest with
          | True => refuse CompileFutureGlobalPhase
          | False => match compile_stage_check surface ctx with
            | Left failed => Left (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm) failed
            | Right core => Right (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm)
                (MkPair (List Nat) CoreTerm future_rest core)
            end
          end
      end
  end;

def compile_program_item_pure : Nat -> Surface -> List Nat -> List Nat -> List Nat ->
    Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm) :=
  compile_program_item_with bound_name (surface_has_future_global fuel32);

def compile_program_walk
    (compile_item : Nat -> Nat -> Surface -> List Nat -> List Nat -> List Nat ->
      Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm))
    (xs : List (Pair Nat Surface)) (names : List Nat) : CompileProgramLocatedResult :=
  (fix go (items : List (Pair Nat Surface)) (future : List Nat)
      (ctx : List Nat) (seen : List Nat) (ordinal : Nat)
      : CompileProgramLocatedResult :=
    match items with
    | Nil => CompileProgramLocatedOk (Nil (Pair Nat CoreTerm))
    | Cons pair rest => match pair with
      | MkPair name surface =>
          let failure (phase : CompileProgramPhase) (error : CompError)
              : CompileProgramLocatedResult :=
            CompileProgramLocatedErr
              (CompileProgramLocationOf (MkPair Nat CompileProgramPhase name phase) ordinal) error in
          match compile_item ordinal name surface future ctx seen with
          | Left failed => match failed with
            | MkPair phase error => failure phase error
            end
          | Right compiled => match compiled with
            | MkPair future_rest core =>
                match go rest future_rest (Cons Nat name ctx) (Cons Nat name seen) (S ordinal) with
                | CompileProgramLocatedErr owner error => CompileProgramLocatedErr owner error
                | CompileProgramLocatedOk cores =>
                    CompileProgramLocatedOk
                      (Cons (Pair Nat CoreTerm) (MkPair Nat CoreTerm name core) cores)
                end
            end
          end
      end
    end) xs names (Nil Nat) (Nil Nat) Z;

def compile_program_with_location_with
    (compile_item : Nat -> Surface -> List Nat -> List Nat -> List Nat ->
      Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm))
    (xs : List (Pair Nat Surface)) : CompileProgramLocatedResult :=
  compile_program_walk (fun (_ : Nat) => compile_item) xs (surface_names xs);

-- Insertion keeps the first value. Insert on descent for the first position
-- and on return for the last position.
def compile_name_positions (names : List Nat) : Pair SourceNameIndex SourceNameIndex :=
  (fix collect (remaining : List Nat) (ordinal : Nat) (first : SourceNameIndex)
      : Pair SourceNameIndex SourceNameIndex :=
    match remaining with
    | Nil => MkPair SourceNameIndex SourceNameIndex first SourceNameIndexEmpty
    | Cons name rest =>
        let key : List Nat := [name] in
        match collect rest (add ordinal 1) (source_name_index_insert key ordinal first) with
        | MkPair firsts last => MkPair SourceNameIndex SourceNameIndex firsts
            (source_name_index_insert key ordinal last)
        end
    end) names Z SourceNameIndexEmpty;

def compile_name_seen (first : SourceNameIndex) (ordinal : Nat) (name : Nat) : Bool :=
    match source_name_index_lookup ([name] : List Nat) first with
    | Nothing => False
    | Just position => compiler_lt_nat position ordinal
    end;

def compile_future_reference (last : SourceNameIndex) (ordinal : Nat) (surface : Surface) : Bool :=
    (fix find (references : EntryIndex) : Bool :=
      match references with
      | EntryIndexEmpty => False
      | EntryIndexNode _ name _ left right =>
          let later : Bool :=
            match source_name_index_lookup ([name] : List Nat) last with
            | Nothing => False
            | Just position => compiler_lt_nat ordinal position
            end in
          match later with
          | True => True
          | False => match find left with | True => True | False => find right end
          end
      end) (surface_global_references fuel32 surface);

def compile_program_with_location_indexed_with
    (scope_item :
      (Nat -> Surface -> List Nat -> List Nat -> List Nat ->
        Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm)) ->
      Nat -> Surface -> List Nat -> List Nat -> List Nat ->
        Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm))
    (xs : List (Pair Nat Surface)) : CompileProgramLocatedResult :=
    let names : List Nat := surface_names xs in
    match compile_name_positions names with
    | MkPair first last =>
        compile_program_walk
          (fun (ordinal : Nat) => scope_item (compile_program_item_with
            (fun (name : Nat) (_ : List Nat) => compile_name_seen first ordinal name)
            (fun (surface : Surface) (_ : List Nat) => compile_future_reference last ordinal surface)))
          xs names
    end;

def compile_program_with_location (xs : List (Pair Nat Surface)) : CompileProgramLocatedResult :=
    compile_program_with_location_indexed_with
      (fun (item : Nat -> Surface -> List Nat -> List Nat -> List Nat ->
        Either (Pair CompileProgramPhase CompError) (Pair (List Nat) CoreTerm)) => item) xs;

def compile_program_with_owner (xs : List (Pair Nat Surface)) : CompileProgramResult :=
  match compile_program_with_location xs with
  | CompileProgramLocatedErr location error => match location with
    | CompileProgramLocationOf owner _ => CompileProgramErr owner error
    end
  | CompileProgramLocatedOk cores => CompileProgramOk cores
  end;

def compile_program_result (result : CompileProgramResult)
    : CompResult (List (Pair Nat CoreTerm)) :=
    match result with
    | CompileProgramErr _ error => CErr (List (Pair Nat CoreTerm)) error
    | CompileProgramOk cores => COk (List (Pair Nat CoreTerm)) cores
    end;

def compile_program (xs : List (Pair Nat Surface)) : CompResult (List (Pair Nat CoreTerm)) :=
    compile_program_result (compile_program_with_owner xs);

def compile_core_extract : List (Pair Nat CoreTerm) -> List (Pair Nat Nat) :=
  fix compile_core_extract (xs : List (Pair Nat CoreTerm))
    : List (Pair Nat Nat) :=
    match xs with
    | Nil => Nil (Pair Nat Nat)
    | Cons p xs' =>
        match p with
        | MkPair name t =>
            Cons (Pair Nat Nat)
              (MkPair Nat Nat name (extract_tag t))
              (compile_core_extract xs')
        end
    end;

def extract_program (xs : List (Pair Nat CoreTerm)) : CompResult (List (Pair Nat Nat)) :=
    COk(List (Pair Nat Nat), compile_core_extract xs);

def compile_program_extract (xs : List (Pair Nat Surface)) : CompResult (List (Pair Nat Nat)) :=
    match compile_program xs with
    | CErr e => CErr(List (Pair Nat Nat), e)
    | COk cores => extract_program cores
    end;

def compile_core_extract_one (name : Nat) (t : CoreTerm) : Pair Nat Nat :=
    MkPair Nat Nat name (extract_tag t);

def pipeline_status_after (r : CompResult CoreTerm) : Nat :=
    match r with
    | CErr _ =>
        pipeline_ok_stages status_ok status_ok status_ok
          (status_err (S (S Z))) status_ok
    | COk _ =>
        pipeline_ok_stages status_ok status_ok status_ok status_ok status_ok
    end;
