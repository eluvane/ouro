-- Canonical diagnostic output from an already checked program. This is not
-- a replay format or a second checker. Global references use interned names;
-- local binders use de Bruijn indices, so local renaming does not change it.
-- Every list is length-prefixed and every natural ends with an ASCII space.
-- The dump includes complete declarations, bindings, roles and emitted cores.
import "checked_program.ouro";
import "file_check_environment.ouro";
import "core_literals.ouro";
import "primitive_contracts.ouro";
import "../std/natx.ouro";

def checked_output_number (value : Nat) : List Nat :=
    append Nat (map Nat Nat (fun (digit : Nat) => add 48 digit) (to_digits value)) ([32] : List Nat);

def checked_output_numbers (values : List Nat) : List Nat :=
    append Nat (checked_output_number (length Nat values))
      ((fix emit (rest : List Nat) : List Nat :=
        match rest with | Nil => ([] : List Nat) | Cons value tail =>
          append Nat (checked_output_number value) (emit tail) end) values);

def checked_output_join : List (CompResult (List Nat)) -> CompResult (List Nat) :=
  fix join (parts : List (CompResult (List Nat))) : CompResult (List Nat) :=
    match parts with
    | Nil => COk (List Nat) ([] : List Nat)
    | Cons part rest => literal_bind (List Nat) (List Nat) part
        (fun (head : List Nat) => literal_map (List Nat) (List Nat)
          (fun (tail : List Nat) => append Nat head tail) (join rest))
    end;

def checked_output_tag (tag : Nat) (parts : List (CompResult (List Nat)))
    : CompResult (List Nat) :=
    literal_map (List Nat) (List Nat)
      (fun (bytes : List Nat) => append Nat (checked_output_number tag) bytes)
      (checked_output_join parts);

def checked_output_list (A : Type) (emit : A -> CompResult (List Nat)) (values : List A)
    : CompResult (List Nat) :=
    literal_map (List Nat) (List Nat)
      (fun (bytes : List Nat) => append Nat (checked_output_number (length A values)) bytes)
      ((fix walk (rest : List A) : CompResult (List Nat) :=
        match rest with
        | Nil => COk (List Nat) ([] : List Nat)
        | Cons value tail => checked_output_join
            ([emit value, walk tail] : List (CompResult (List Nat)))
        end) values);

def checked_output_optional (emit : CoreTerm -> CompResult (List Nat)) (value : Maybe CoreTerm)
    : CompResult (List Nat) :=
    match value with
    | Nothing => checked_output_tag 0 ([] : List (CompResult (List Nat)))
    | Just term => checked_output_tag 1 ([emit term] : List (CompResult (List Nat)))
    end;

def checked_output_name (state : InternState) (ident : Nat) : CompResult (List Nat) :=
    match state with | MkIntern names _ _ _ =>
      literal_map (List Nat) (List Nat) checked_output_numbers (literal_lookup names ident)
    end;

def checked_output_term (state : InternState) : Nat -> CoreTerm -> CompResult (List Nat) :=
  fix emit (fuel : Nat) (term : CoreTerm) : CompResult (List Nat) :=
    match fuel with
    | Z => CErr (List Nat) (ErrCode 44 0)
    | S next =>
        let child : CoreTerm -> CompResult (List Nat) := fun (value : CoreTerm) => emit next value in
        match term with
        | CRel index => checked_output_tag 0
            ([COk (List Nat) (checked_output_number index)] : List (CompResult (List Nat)))
        | CSort level => checked_output_tag 1
            ([COk (List Nat) (checked_output_number level)] : List (CompResult (List Nat)))
        | CPi domain body => checked_output_tag 2 ([child domain, child body] : List (CompResult (List Nat)))
        | CLam annotation body => checked_output_tag 3 ([child annotation, child body] : List (CompResult (List Nat)))
        | CApp function argument => checked_output_tag 4 ([child function, child argument] : List (CompResult (List Nat)))
        | CLetIn value annotation body => checked_output_tag 5
            ([child value, child annotation, child body] : List (CompResult (List Nat)))
        | CConst name => checked_output_tag 6 ([checked_output_name state name] : List (CompResult (List Nat)))
        | CInd name => checked_output_tag 7 ([checked_output_name state name] : List (CompResult (List Nat)))
        | CConstruct family ordinal parameters => checked_output_tag 8
            ([checked_output_name state family, COk (List Nat) (checked_output_number ordinal),
             COk (List Nat) (checked_output_number parameters)] : List (CompResult (List Nat)))
        | CCase info motive scrutinee branches => match info with
            | MkCaseInfo family parameters arities => checked_output_tag 9
                ([checked_output_name state family, COk (List Nat) (checked_output_number parameters),
                 COk (List Nat) (checked_output_numbers arities), child motive, child scrutinee,
                 checked_output_list CoreTerm child branches] : List (CompResult (List Nat)))
            end
        | CFix _ argument arity annotation body => checked_output_tag 10
            ([COk (List Nat) (checked_output_number argument), COk (List Nat) (checked_output_number arity),
             child annotation, child body] : List (CompResult (List Nat)))
        | CStrLit name _ => CErr (List Nat) (ErrCode 46 name)
        | CStrBytes bytes type_id => checked_output_tag 12
            ([checked_output_name state type_id, COk (List Nat) (checked_output_numbers bytes)] : List (CompResult (List Nat)))
        end
    end;

def checked_output_abi_value (emit : CoreTerm -> CompResult (List Nat))
    (value : PrimitiveAbiValue) : CompResult (List Nat) :=
    match value with
    | PrimitiveAbiWord word => checked_output_tag 0
        ([COk (List Nat) (checked_output_numbers (primitive_word_name word))] : List (CompResult (List Nat)))
    | PrimitiveAbiPointer pointee => checked_output_tag 1 ([emit pointee] : List (CompResult (List Nat)))
    | PrimitiveAbiFunction signature => checked_output_tag 2 ([emit signature] : List (CompResult (List Nat)))
    end;

def checked_output_abi (emit : CoreTerm -> CompResult (List Nat))
    (signature : PrimitiveAbiSignature) : CompResult (List Nat) :=
    match signature with | PrimitiveAbiSignatureOf arguments result => checked_output_join
      ([checked_output_list PrimitiveAbiValue (checked_output_abi_value emit) arguments,
       match result with
       | Nothing => checked_output_tag 0 ([] : List (CompResult (List Nat)))
       | Just value => checked_output_tag 1 ([checked_output_abi_value emit value] : List (CompResult (List Nat)))
       end] : List (CompResult (List Nat)))
    end;

def checked_output_gc (policy : PrimitiveGc) : List Nat :=
    checked_output_number (match policy with | PrimitiveNoGc => 0 | PrimitiveMayGc => 1 end);

def checked_output_execution (mode : PrimitiveExecution) : List Nat :=
    checked_output_number (match mode with | PrimitiveTypeOnly => 0 | PrimitivePureValue => 1
      | PrimitiveRuntimeAction => 2 end);

def checked_output_binding (emit : CoreTerm -> CompResult (List Nat))
    (binding : PrimitiveBinding) : CompResult (List Nat) :=
    match binding with
    | PrimitiveIntrinsicBinding id mode gc specialization => checked_output_tag 0
        ([COk (List Nat) (checked_output_numbers (primitive_key id)),
         COk (List Nat) (checked_output_execution mode), COk (List Nat) (checked_output_gc gc),
         checked_output_optional emit specialization] : List (CompResult (List Nat)))
    | PrimitiveExternBinding external => match external with
        | CheckedExternOf target abi dll symbol signature gc => checked_output_tag 1
            ([COk (List Nat) (checked_output_number (match target with | PrimitiveWindowsX64 => 0 end)),
             COk (List Nat) (checked_output_number (match abi with | PrimitiveWin64 => 0 end)),
             COk (List Nat) (checked_output_numbers dll), COk (List Nat) (checked_output_numbers symbol),
             checked_output_abi emit signature, COk (List Nat) (checked_output_gc gc)] : List (CompResult (List Nat)))
        end
    end;

def checked_output_inductive (state : InternState) (emit : CoreTerm -> CompResult (List Nat))
    (declaration : IndDecl) : CompResult (List Nat) :=
    match declaration with | MkIndDecl name parameters indices level constructors => checked_output_join
      ([checked_output_name state name,
       checked_output_list Param (fun (parameter : Param) => match parameter with | MkParam _ typ => emit typ end) parameters,
       checked_output_list CoreTerm emit indices, COk (List Nat) (checked_output_number level),
       checked_output_list Ctor (fun (constructor : Ctor) => match constructor with | MkCtor name typ =>
         checked_output_join ([checked_output_name state name, emit typ] : List (CompResult (List Nat))) end)
           constructors] : List (CompResult (List Nat)))
    end;

def checked_output_role (state : InternState) (emit : CoreTerm -> CompResult (List Nat))
    (binding : PrimitiveRoleBinding) : CompResult (List Nat) :=
    match binding with | PrimitiveRoleOf role shape => match shape with
      | PrimitiveInductiveOf name parameters indices typ constructors => checked_output_join
          ([COk (List Nat) (checked_output_number (primitive_role_code role)), checked_output_name state name,
           COk (List Nat) (checked_output_number parameters), COk (List Nat) (checked_output_number indices),
           emit typ, checked_output_list CoreTerm emit constructors] : List (CompResult (List Nat)))
      end
    end;

def checked_output_entry (state : InternState) (fuel : Nat) (entry : Entry) : CompResult (List Nat) :=
    let emit : CoreTerm -> CompResult (List Nat) := checked_output_term state fuel in
    match entry with
    | MkEntry name typ body => checked_output_tag 0
        ([checked_output_name state name, emit typ, checked_output_optional emit body] : List (CompResult (List Nat)))
    | MkIndEntry name declaration => checked_output_tag 1
        ([checked_output_name state name, checked_output_inductive state emit declaration] : List (CompResult (List Nat)))
    | MkBoundEntry name typ binding => checked_output_tag 2
        ([checked_output_name state name, emit typ, checked_output_binding emit binding] : List (CompResult (List Nat)))
    | MkRoleEntry binding => checked_output_tag 3 ([checked_output_role state emit binding] : List (CompResult (List Nat)))
    end;

def checked_program_dump (fuel : Nat) (program : CheckedProgram) : CompResult (List Nat) :=
    match fuel with
    | Z => CErr (List Nat) (ErrCode 44 0)
    | S _ => match program with | CheckedProgramOf state entries cores =>
        literal_map (List Nat) (List Nat)
          (fun (bytes : List Nat) => append Nat
            ([111, 117, 114, 111, 46, 99, 104, 101, 99, 107, 101, 100, 45, 112, 114, 111, 103, 114, 97, 109, 46, 118, 49, 10] : List Nat)
            (append Nat bytes ([10] : List Nat)))
          (checked_output_join
            ([checked_output_list Entry (checked_output_entry state fuel) entries,
             checked_output_list (Pair Nat CoreTerm) (fun (pair : Pair Nat CoreTerm) => match pair with
               | MkPair name body => checked_output_join
                   ([checked_output_name state name, checked_output_term state fuel body] : List (CompResult (List Nat))) end)
                     cores] : List (CompResult (List Nat))))
        end
    end;

-- Classify global type formers from their checked declaration types. In
-- particular, an opaque String -> String value is never a type former.
-- The caller supplies the canonical normalizer; output adds no typing rules.
def checked_type_former_using
    (normalize : Nat -> CoreTerm -> NormalizeResult CoreTerm) : Nat -> CoreTerm -> CompResult Bool :=
  fix classify (fuel : Nat) (typ : CoreTerm) : CompResult Bool :=
    match fuel with
    | Z => CErr Bool (ErrCode 44 0)
    | S next => match normalize next typ with
        | NormalizeExhausted => CErr Bool (ErrCode 44 0)
        | NormalizeMalformed _ => CErr Bool (ErrCode 49 0)
        | Normalized head => match head with
            | CSort _ => COk Bool True
            | CPi _ body => classify next body
            | CRel _ => COk Bool False | CConst _ => COk Bool False | CInd _ => COk Bool False
            | CLam _ _ => COk Bool False | CApp _ _ => COk Bool False | CLetIn _ _ _ => COk Bool False
            | CConstruct _ _ _ => COk Bool False | CCase _ _ _ _ => COk Bool False
            | CFix _ _ _ _ _ => COk Bool False | CStrLit _ _ => COk Bool False | CStrBytes _ _ => COk Bool False
            end
        end
    end;

def checked_program_type_globals_using
    (normalize : Nat -> CoreTerm -> NormalizeResult CoreTerm)
    (fuel : Nat) (program : CheckedProgram) : CompResult (List Nat) :=
    let entries : List Entry := checked_program_entries program in
    (fix collect (rest : List Entry) : CompResult (List Nat) :=
      match rest with
      | Nil => COk (List Nat) ([] : List Nat)
      | Cons entry tail =>
          let include : Nat -> CoreTerm -> CompResult (List Nat) := fun (name : Nat) (typ : CoreTerm) =>
            literal_bind Bool (List Nat) (checked_type_former_using normalize fuel typ)
              (fun (type_only : Bool) => literal_map (List Nat) (List Nat)
                (fun (names : List Nat) => match type_only with | True => Cons Nat name names | False => names end)
                (collect tail)) in
          match entry with
          | MkEntry name typ _ => include name typ
          | MkBoundEntry name typ _ => include name typ
          | MkIndEntry name _ => literal_map (List Nat) (List Nat) (fun (names : List Nat) => Cons Nat name names) (collect tail)
          | MkRoleEntry _ => collect tail
          end
      end) entries;

def checked_program_type_globals
    (normalize : Nat -> List Entry -> CoreTerm -> NormalizeResult CoreTerm)
    (fuel : Nat) (program : CheckedProgram) : CompResult (List Nat) :=
    let entries : List Entry := checked_program_entries program in
    checked_program_type_globals_using
      (fun (budget : Nat) (typ : CoreTerm) => normalize budget entries typ) fuel program;

-- Production normalization shares one lookup environment across every global
-- and every binder in its type. The injected raw entry point remains available.
def checked_program_type_globals_indexed
    (normalize : Nat -> CheckEnvironment -> CoreTerm -> NormalizeResult CoreTerm)
    (fuel : Nat) (program : CheckedProgram) : CompResult (List Nat) :=
    let environment : CheckEnvironment := check_environment_from_entries (checked_program_entries program) in
    checked_program_type_globals_using
      (fun (budget : Nat) (typ : CoreTerm) => normalize budget environment typ) fuel program;

-- This adapter is removed with the legacy C host. Checked identities select
-- its String and supported IO implementations. Other native operations retain
-- their exact key and fail explicitly when this host has no implementation.
def checked_c_binding_key (binding : PrimitiveBinding) : List Nat :=
    match binding with
    | PrimitiveIntrinsicBinding id _ _ _ => match id with
        | PrimitiveStringOperation operation => append Nat
            ([112, 114, 105, 109, 95, 115, 116, 114, 105, 110, 103, 95] : List Nat)
            (primitive_string_op_name operation)
        | PrimitiveU8Type => primitive_key id | PrimitiveU32Type => primitive_key id
        | PrimitiveU64Type => primitive_key id | PrimitiveI32Type => primitive_key id
        | PrimitiveUSizeType => primitive_key id | PrimitiveRawPtrType => primitive_key id
        | PrimitiveRuntimeType => primitive_key id | PrimitiveRawFnType => primitive_key id
        | PrimitiveStringType => primitive_key id | PrimitiveWordOperation _ _ => primitive_key id
        | PrimitiveWordConversion _ _ _ => primitive_key id | PrimitiveWordFromNat _ => primitive_key id
        | PrimitiveWordToNat _ => primitive_key id | PrimitiveRuntimePure => ([105, 111, 95, 112, 117, 114, 101] : List Nat)
        | PrimitiveRuntimeBind => ([105, 111, 95, 98, 105, 110, 100] : List Nat) | PrimitiveRuntimeLoop => primitive_key id
        | PrimitiveRawNull => primitive_key id | PrimitiveRawLoad => primitive_key id
        | PrimitiveRawStore => primitive_key id | PrimitiveRawAddWrap => primitive_key id
        | PrimitiveRawCast => primitive_key id | PrimitiveRawToBits => primitive_key id
        | PrimitiveRawFromBits => primitive_key id | PrimitiveFnCall => primitive_key id
        | PrimitiveStdoutWrite => ([112, 114, 105, 109, 95, 115, 116, 100, 111, 117, 116, 95, 119, 114, 105, 116, 101] : List Nat)
        | PrimitiveStderrWrite => ([112, 114, 105, 109, 95, 115, 116, 100, 101, 114, 114, 95, 119, 114, 105, 116, 101] : List Nat)
        | PrimitiveStdoutFlush => ([112, 114, 105, 109, 95, 115, 116, 100, 111, 117, 116, 95, 102, 108, 117, 115, 104] : List Nat)
        | PrimitiveProcessExit => ([112, 114, 105, 109, 95, 101, 120, 105, 116] : List Nat)
        | PrimitiveArgv => ([112, 114, 105, 109, 95, 97, 114, 103, 118] : List Nat)
        | PrimitiveEnvGet => ([112, 114, 105, 109, 95, 101, 110, 118, 95, 103, 101, 116] : List Nat)
        | PrimitiveTimeNow => ([112, 114, 105, 109, 95, 116, 105, 109, 101, 95, 110, 111, 119] : List Nat)
        | PrimitiveFileKind => ([112, 114, 105, 109, 95, 102, 115, 95, 107, 105, 110, 100] : List Nat)
        | PrimitiveFileExists => ([112, 114, 105, 109, 95, 102, 115, 95, 101, 120, 105, 115, 116, 115] : List Nat)
        | PrimitiveFileIsDirectory => ([112, 114, 105, 109, 95, 102, 115, 95, 105, 115, 95, 100, 105, 114] : List Nat)
        | PrimitiveDirectoryCreate => ([112, 114, 105, 109, 95, 102, 115, 95, 109, 107, 100, 105, 114] : List Nat)
        | PrimitivePathRemove => ([112, 114, 105, 109, 95, 102, 115, 95, 114, 101, 109, 111, 118, 101] : List Nat)
        | PrimitiveFileCopy => ([112, 114, 105, 109, 95, 102, 115, 95, 99, 111, 112, 121, 95, 102, 105, 108, 101] : List Nat)
        | PrimitiveFileRename => ([112, 114, 105, 109, 95, 102, 115, 95, 114, 101, 110, 97, 109, 101] : List Nat)
        | PrimitiveFileRealpath => ([112, 114, 105, 109, 95, 102, 115, 95, 114, 101, 97, 108, 112, 97, 116, 104] : List Nat)
        | PrimitiveFileTemp => ([112, 114, 105, 109, 95, 102, 115, 95, 116, 101, 109, 112, 95, 102, 105, 108, 101] : List Nat)
        | PrimitiveFileTempIn => ([112, 114, 105, 109, 95, 102, 115, 95, 116, 101, 109, 112, 95, 102, 105, 108, 101, 95, 105, 110] : List Nat)
        | PrimitiveProcessInherit => primitive_key id
        | PrimitiveProcessBounded => primitive_key id
        | PrimitiveProcessCapture => primitive_key id
        | PrimitiveHttpPost => primitive_key id
        | PrimitiveStdinReadLine => ([112, 114, 105, 109, 95, 115, 116, 100, 105, 110, 95, 114, 101, 97, 100, 95, 108, 105, 110, 101] : List Nat)
        | PrimitiveStdinReadBytes => ([112, 114, 105, 109, 95, 115, 116, 100, 105, 110, 95, 114, 101, 97, 100, 95, 98, 121, 116, 101, 115] : List Nat)
        | PrimitiveFileRead => ([112, 114, 105, 109, 95, 102, 115, 95, 114, 101, 97, 100, 95, 102, 105, 108, 101] : List Nat)
        | PrimitiveFileWrite => ([112, 114, 105, 109, 95, 102, 115, 95, 119, 114, 105, 116, 101, 95, 102, 105, 108, 101] : List Nat)
        | PrimitiveDirectoryList => ([112, 114, 105, 109, 95, 102, 115, 95, 108, 105, 115, 116, 95, 100, 105, 114] : List Nat)
        | PrimitiveDirectoryListable => ([112, 114, 105, 109, 95, 102, 115, 95, 108, 105, 115, 116, 97, 98, 108, 101] : List Nat)
        end
    | PrimitiveExternBinding _ => ([111, 117, 114, 111, 46, 101, 120, 116, 101, 114, 110] : List Nat)
    end;

def checked_program_c_shims (program : CheckedProgram) : List (Pair Nat (List Nat)) :=
    (fix collect (rest : List Entry) : List (Pair Nat (List Nat)) :=
      match rest with
      | Nil => ([] : List (Pair Nat (List Nat)))
      | Cons entry tail => match entry with
          | MkBoundEntry name _ binding => Cons (Pair Nat (List Nat))
              (MkPair Nat (List Nat) name (checked_c_binding_key binding)) (collect tail)
          | MkEntry _ _ _ => collect tail | MkIndEntry _ _ => collect tail | MkRoleEntry _ => collect tail
          end
      end) (checked_program_entries program);
