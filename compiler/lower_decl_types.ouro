-- Declared type hints for lowering. Checking still owns acceptance of every
-- annotation and body; these hints supply argument domains for surface sugar.

import "ast.ouro",
  "core.ouro";

def lower_named_types
  (lower_type : List (Pair Nat Surface) -> Expr -> Surface)
  (params : List (Pair Nat Expr))
  (entries : List (Pair Nat Expr)) (known : List (Pair Nat Surface))
    : List (Pair Nat Surface) :=
    (fix go (rest : List (Pair Nat Expr)) (types : List (Pair Nat Surface))
        : List (Pair Nat Surface) :=
      match rest with
      | Nil => types
      | Cons entry tail =>
          match entry with
          | MkPair name ty =>
              go tail
                (Cons (Pair Nat Surface)
                  (MkPair Nat Surface name (lower_type(types, mk_pi_chain params ty)))
                  types)
          end
      end) entries known;

def collect_decl_types
  (lower_type : List (Pair Nat Surface) -> Expr -> Surface)
  (decls : List Decl) : List (Pair Nat Surface) :=
    (fix go (rest : List Decl) (types : List (Pair Nat Surface))
        : List (Pair Nat Surface) :=
      match rest with
      | Nil => types
      | Cons decl tail =>
          match decl with
          | DDef name ty _ =>
              go tail
                (Cons (Pair Nat Surface)
                  (MkPair Nat Surface name (lower_type types ty)) types)
          | DAxiom name ty =>
              go tail
                (Cons (Pair Nat Surface)
                  (MkPair Nat Surface name (lower_type types ty)) types)
          | DIntrinsic name ty _ _ =>
              go tail
                (Cons (Pair Nat Surface)
                  (MkPair Nat Surface name (lower_type types ty)) types)
          | DExtern name ty _ =>
              go tail
                (Cons (Pair Nat Surface)
                  (MkPair Nat Surface name (lower_type types ty)) types)
          | DInductive name params family ctors _ =>
              let family_types : List (Pair Nat Surface) :=
                Cons (Pair Nat Surface)
                  (MkPair Nat Surface name
                    (lower_type(types, mk_pi_chain params family))) types in
              go(tail, lower_named_types lower_type params ctors family_types)
          | DEffect _ params ops =>
              go(tail, lower_named_types lower_type params ops types)
          | DImport _ => go tail types
          | DRepresentation _ _ => go tail types
          end
      end) decls (Nil (Pair Nat Surface));
