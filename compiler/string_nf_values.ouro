-- Pure normalizer values use checked primitive/representation identities.
-- No source spelling, native opcode, callback or host String implementation
-- participates in these reductions.
import "string_nf_bytes.ouro",
  "file_check_model.ouro",
  "primitive_contracts.ouro",
  "primitive_model.ouro";

def string_value_map (A : Type) (B : Type) (build : A -> B)
    (value : NormalizeResult A) : NormalizeResult B :=
    normalize_bind A B value (fun (result : A) => Normalized(B, build result));

def string_value_role (role : PrimitiveRole) : List Entry -> Maybe Nat :=
  fix find (entries : List Entry) : Maybe Nat :=
    match entries with
    | Nil => Nothing Nat
    | Cons entry rest =>
        match entry with
        | MkEntry _ _ _ => find rest
        | MkIndEntry _ _ => find rest
        | MkBoundEntry _ _ _ => find rest
        | MkRoleEntry binding => match binding with
            | PrimitiveRoleOf candidate shape =>
                match primitive_role_equal role candidate with
                | False => find rest
                | True => match shape with
                    | PrimitiveInductiveOf name _ _ _ _ => Just Nat name
                    end
                end
            end
        end
    end;

-- Only the first binding of a name has authority. An older String intrinsic
-- cannot authenticate a newer opaque, inductive, extern or machine binding.
def string_value_type_binding (name : Nat) : List Entry -> Bool :=
  fix find (entries : List Entry) : Bool :=
    match entries with
    | Nil => False
    | Cons entry rest => match entry with
        | MkEntry current _ _ => match eqNat current name with
            | True => False | False => find rest end
        | MkIndEntry current _ => match eqNat current name with
            | True => False | False => find rest end
        | MkRoleEntry _ => find rest
        | MkBoundEntry current _ binding => match eqNat current name with
            | False => find rest
            | True => match binding with
                | PrimitiveExternBinding _ => False
                | PrimitiveIntrinsicBinding id _ _ _ => primitive_id_equal id PrimitiveStringType
                end
            end
        end
    end;

-- Callers weak-head reduce the literal's type before authenticating its head.
def string_value_type_head (entries : List Entry) (term : CoreTerm) : Maybe Nat :=
    match term with
    | CConst name => match string_value_type_binding name entries with
        | True => Just Nat name | False => Nothing Nat end
    | CRel _ => Nothing Nat | CSort _ => Nothing Nat | CPi _ _ => Nothing Nat
    | CLam _ _ => Nothing Nat | CApp _ _ => Nothing Nat | CLetIn _ _ _ => Nothing Nat
    | CInd _ => Nothing Nat | CConstruct _ _ _ => Nothing Nat
    | CCase _ _ _ _ => Nothing Nat | CFix _ _ _ _ _ => Nothing Nat
    | CStrLit _ _ => Nothing Nat | CStrBytes _ _ => Nothing Nat
    end;

def string_value_type (scope : List Entry) : Maybe Nat :=
  (fix find (entries : List Entry) : Maybe Nat :=
    match entries with
    | Nil => Nothing Nat
    | Cons entry rest => match entry with
        | MkEntry _ _ _ => find rest
        | MkIndEntry _ _ => find rest
        | MkRoleEntry _ => find rest
        | MkBoundEntry name _ binding => match binding with
            | PrimitiveExternBinding _ => find rest
            | PrimitiveIntrinsicBinding id _ _ _ =>
                match primitive_id_equal id PrimitiveStringType with
                | True => match string_value_type_binding name scope with
                    | True => Just Nat name | False => find rest end
                | False => find rest
                end
            end
        end
    end) scope;

def string_value_required (value : Maybe Nat) : NormalizeResult Nat :=
    match value with
    | Just name => Normalized Nat name
    | Nothing => NormalizeMalformed Nat NormalizeStringArguments
    end;

inductive StringValueSpine : Type :=
  | StringValueSpineOf : CoreTerm -> List CoreTerm -> StringValueSpine;

def string_value_spine : Nat -> CoreTerm -> List CoreTerm -> NormalizeResult StringValueSpine :=
  fix collect (fuel : Nat) (term : CoreTerm) (args : List CoreTerm)
      : NormalizeResult StringValueSpine :=
    match fuel with
    | Z => NormalizeExhausted StringValueSpine
    | S next => match term with
        | CApp function argument => collect next function (Cons CoreTerm argument args)
        | CRel _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CSort _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CPi _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CLam _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CLetIn _ _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CConst _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CInd _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CConstruct _ _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CCase _ _ _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CFix _ _ _ _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CStrLit _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        | CStrBytes _ _ => Normalized(StringValueSpine, StringValueSpineOf term args)
        end
    end;

inductive StringValueCtor : Type :=
  | StringValueNotCtor : StringValueCtor
  | StringValueCtorOf : Nat -> Nat -> Nat -> StringValueCtor;

def string_value_ctor (term : CoreTerm) : StringValueCtor :=
    match term with
    | CConstruct family index params => StringValueCtorOf family index params
    | CRel _ => StringValueNotCtor | CSort _ => StringValueNotCtor
    | CPi _ _ => StringValueNotCtor | CLam _ _ => StringValueNotCtor
    | CApp _ _ => StringValueNotCtor | CLetIn _ _ _ => StringValueNotCtor
    | CConst _ => StringValueNotCtor | CInd _ => StringValueNotCtor
    | CCase _ _ _ _ => StringValueNotCtor | CFix _ _ _ _ _ => StringValueNotCtor
    | CStrLit _ _ => StringValueNotCtor | CStrBytes _ _ => StringValueNotCtor
    end;

def string_value_bytes (reduce : CoreTerm -> NormalizeResult CoreTerm)
    (term : CoreTerm) : NormalizeResult (Maybe (List Nat)) :=
    string_value_map CoreTerm (Maybe (List Nat))
      (fun (normal : CoreTerm) => match normal with
        | CStrBytes bytes _ => Just(List Nat, bytes)
        | CRel _ => Nothing (List Nat) | CSort _ => Nothing (List Nat)
        | CPi _ _ => Nothing (List Nat) | CLam _ _ => Nothing (List Nat)
        | CApp _ _ => Nothing (List Nat) | CLetIn _ _ _ => Nothing (List Nat)
        | CConst _ => Nothing (List Nat) | CInd _ => Nothing (List Nat)
        | CConstruct _ _ _ => Nothing (List Nat) | CCase _ _ _ _ => Nothing (List Nat)
        | CFix _ _ _ _ _ => Nothing (List Nat) | CStrLit _ _ => Nothing (List Nat)
        end) (reduce term);

def string_value_nat (reduce : CoreTerm -> NormalizeResult CoreTerm)
    (family : Nat) : Nat -> CoreTerm -> NormalizeResult (Maybe Nat) :=
  fix decode (fuel : Nat) (term : CoreTerm) : NormalizeResult (Maybe Nat) :=
    match fuel with
    | Z => NormalizeExhausted (Maybe Nat)
    | S next => normalize_bind CoreTerm (Maybe Nat) (reduce term)
        (fun (normal : CoreTerm) =>
          normalize_bind StringValueSpine (Maybe Nat)
            (string_value_spine next normal ([] : List CoreTerm))
            (fun (spine : StringValueSpine) => match spine with
              | StringValueSpineOf head args => match string_value_ctor head with
                | StringValueNotCtor => Normalized(Maybe Nat, Nothing Nat)
                | StringValueCtorOf actual index params =>
                    match eqNat actual family with
                    | False => Normalized(Maybe Nat, Nothing Nat)
                    | True => match eqNat params 0 with
                      | False => NormalizeMalformed(Maybe Nat, NormalizeStringArguments)
                      | True => match index with
                        | Z => match args with
                            | Nil => Normalized(Maybe Nat, Just Nat 0)
                            | Cons _ _ => NormalizeMalformed(Maybe Nat, NormalizeStringArguments)
                            end
                        | S previous => match previous with
                            | S _ => NormalizeMalformed(Maybe Nat, NormalizeStringArguments)
                            | Z => match args with
                                | Nil => Normalized(Maybe Nat, Nothing Nat)
                                | Cons argument rest => match rest with
                                    | Cons _ _ => NormalizeMalformed(Maybe Nat, NormalizeStringArguments)
                                    | Nil => string_value_map (Maybe Nat) (Maybe Nat)
                                        (fun (value : Maybe Nat) => mapMaybe Nat Nat (fun (number : Nat) => S number) value)
                                        (decode next argument)
                                    end
                                end
                            end
                        end
                      end
                    end
                end
              end))
    end;

def string_value_make_nat (family : Nat) : Nat -> Nat -> NormalizeResult CoreTerm :=
  fix build (fuel : Nat) (value : Nat) : NormalizeResult CoreTerm :=
    match fuel with
    | Z => NormalizeExhausted CoreTerm
    | S next => match value with
        | Z => Normalized(CoreTerm, CConstruct family 0 0)
        | S previous => string_value_map CoreTerm CoreTerm
            (fun (argument : CoreTerm) => CApp(CConstruct family 1 0, argument))
            (build next previous)
        end
    end;

def string_value_make_list (family : Nat) (element : CoreTerm)
    : Nat -> List CoreTerm -> NormalizeResult CoreTerm :=
  fix build (fuel : Nat) (values : List CoreTerm) : NormalizeResult CoreTerm :=
    match fuel with
    | Z => NormalizeExhausted CoreTerm
    | S next => match values with
        | Nil => Normalized(CoreTerm, CApp(CConstruct family 0 1, element))
        | Cons head rest => string_value_map CoreTerm CoreTerm
            (fun (tail : CoreTerm) =>
              CApp(CApp(CApp(CConstruct family 1 1, element), head), tail))
            (build next rest)
        end
    end;

def string_value_nats (family : Nat) : Nat -> List Nat -> NormalizeResult (List CoreTerm) :=
  fix build (fuel : Nat) (values : List Nat) : NormalizeResult (List CoreTerm) :=
    match fuel with
    | Z => NormalizeExhausted (List CoreTerm)
    | S next => match values with
        | Nil => Normalized(List CoreTerm, [] : List CoreTerm)
        | Cons value rest => normalize_bind CoreTerm (List CoreTerm)
            (string_value_make_nat family next value)
            (fun (head : CoreTerm) => string_value_map (List CoreTerm) (List CoreTerm)
              (fun (tail : List CoreTerm) => Cons CoreTerm head tail) (build next rest))
        end
    end;

def string_value_codes (reduce : CoreTerm -> NormalizeResult CoreTerm)
    (nat_family : Nat) (list_family : Nat)
    : Nat -> CoreTerm -> NormalizeResult (Maybe (List Nat)) :=
  fix decode (fuel : Nat) (term : CoreTerm) : NormalizeResult (Maybe (List Nat)) :=
    match fuel with
    | Z => NormalizeExhausted (Maybe (List Nat))
    | S next => normalize_bind CoreTerm (Maybe (List Nat)) (reduce term)
        (fun (normal : CoreTerm) => normalize_bind StringValueSpine (Maybe (List Nat))
          (string_value_spine next normal ([] : List CoreTerm))
          (fun (spine : StringValueSpine) => match spine with
            | StringValueSpineOf head args => match string_value_ctor head with
              | StringValueNotCtor => Normalized(Maybe (List Nat), Nothing (List Nat))
              | StringValueCtorOf family index params =>
                  match eqNat family list_family with
                  | False => Normalized(Maybe (List Nat), Nothing (List Nat))
                  | True => match eqNat params 1 with
                    | False => NormalizeMalformed(Maybe (List Nat), NormalizeStringArguments)
                    | True => match args with
                      | Nil => Normalized(Maybe (List Nat), Nothing (List Nat))
                      | Cons _element fields => match index with
                          | Z => match fields with
                              | Nil => Normalized(Maybe (List Nat), Just(List Nat, [] : List Nat))
                              | Cons _ _ => NormalizeMalformed(Maybe (List Nat), NormalizeStringArguments)
                              end
                          | S previous => match previous with
                              | S _ => NormalizeMalformed(Maybe (List Nat), NormalizeStringArguments)
                              | Z => match fields with
                                  | Nil => Normalized(Maybe (List Nat), Nothing (List Nat))
                                  | Cons first remaining => match remaining with
                                      | Nil => Normalized(Maybe (List Nat), Nothing (List Nat))
                                      | Cons last excess => match excess with
                                          | Cons _ _ => NormalizeMalformed(Maybe (List Nat), NormalizeStringArguments)
                                          | Nil => normalize_bind (Maybe Nat) (Maybe (List Nat))
                                              (string_value_nat reduce nat_family next first)
                                              (fun (value : Maybe Nat) => match value with
                                                | Nothing => Normalized(Maybe (List Nat), Nothing (List Nat))
                                                | Just number => string_value_map (Maybe (List Nat)) (Maybe (List Nat))
                                                    (fun (tail : Maybe (List Nat)) =>
                                                      mapMaybe (List Nat) (List Nat)
                                                        (fun (values : List Nat) => Cons Nat number values) tail)
                                                    (decode next last)
                                                end)
                                          end
                                      end
                                  end
                              end
                          end
                      end
                    end
                  end
              end
            end))
    end;

def string_value_pack_bytes (entries : List Entry) (result : NormalizeResult (List Nat))
    : NormalizeResult CoreTerm :=
    normalize_bind Nat CoreTerm (string_value_required (string_value_type entries))
      (fun (typ : Nat) => string_value_map (List Nat) CoreTerm
        (fun (bytes : List Nat) => CStrBytes bytes typ) result);

def string_value_pack_nat (fuel : Nat) (entries : List Entry) (result : NormalizeResult Nat)
    : NormalizeResult CoreTerm :=
    normalize_bind Nat CoreTerm (string_value_required (string_value_role PrimitiveNatRole entries))
      (fun (family : Nat) => normalize_bind Nat CoreTerm result
        (fun (value : Nat) => string_value_make_nat family fuel value));

def string_value_pack_bool (entries : List Entry) (result : NormalizeResult Bool)
    : NormalizeResult CoreTerm :=
    normalize_bind Nat CoreTerm (string_value_required (string_value_role PrimitiveBoolRole entries))
      (fun (family : Nat) => string_value_map Bool CoreTerm
        (fun (value : Bool) => CConstruct family (match value with | True => 0 | False => 1 end) 0) result);

def string_value_pack_codes (fuel : Nat) (entries : List Entry) (result : NormalizeResult (List Nat))
    : NormalizeResult CoreTerm :=
    normalize_bind Nat CoreTerm (string_value_required (string_value_role PrimitiveNatRole entries))
      (fun (nat_family : Nat) => normalize_bind Nat CoreTerm
        (string_value_required (string_value_role PrimitiveListRole entries))
        (fun (list_family : Nat) => normalize_bind (List Nat) CoreTerm result
          (fun (values : List Nat) => normalize_bind (List CoreTerm) CoreTerm
            (string_value_nats nat_family fuel values)
            (fun (terms : List CoreTerm) => string_value_make_list list_family (CInd nat_family) fuel terms))));

def string_value_pack_strings (fuel : Nat) (entries : List Entry)
    (result : NormalizeResult (List (List Nat))) : NormalizeResult CoreTerm :=
    normalize_bind Nat CoreTerm (string_value_required (string_value_type entries))
      (fun (typ : Nat) => normalize_bind Nat CoreTerm
        (string_value_required (string_value_role PrimitiveListRole entries))
        (fun (family : Nat) => normalize_bind (List (List Nat)) CoreTerm result
          (fun (values : List (List Nat)) => string_value_make_list family (CConst typ) fuel
            (map(List Nat, CoreTerm, fun (bytes : List Nat) => CStrBytes bytes typ, values)))));

def string_value_pack_index (fuel : Nat) (entries : List Entry)
    (result : NormalizeResult (Maybe Nat)) : NormalizeResult CoreTerm :=
    normalize_bind Nat CoreTerm (string_value_required (string_value_role PrimitiveNatRole entries))
      (fun (nat_family : Nat) => normalize_bind Nat CoreTerm
        (string_value_required (string_value_role PrimitiveMaybeRole entries))
        (fun (maybe_family : Nat) => normalize_bind (Maybe Nat) CoreTerm result
          (fun (value : Maybe Nat) => match value with
            | Nothing => Normalized(CoreTerm, CApp(CConstruct maybe_family 0 1, CInd nat_family))
            | Just number => string_value_map CoreTerm CoreTerm
                (fun (term : CoreTerm) => CApp(CApp(CConstruct maybe_family 1 1, CInd nat_family), term))
                (string_value_make_nat nat_family fuel number)
            end)));
