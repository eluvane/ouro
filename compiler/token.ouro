-- Token constructors are a frontend ABI shared by lexer, parser shards, and generated C entry points.

import "../std/data.ouro",
  "base.ouro";

inductive Token : Type :=
  | TIdent : Nat -> Token
  | TNat : Nat -> Token
  | TKeyword : Nat -> Token
  | TType : Nat -> Token
  | TColon : Token
  | TColonEq : Token
  | TArrow : Token
  | TFatArrow : Token
  | TBar : Token
  | TLparen : Token
  | TRparen : Token
  | TSemi : Token
  | THole : Maybe Nat -> Token
  | TString : Nat -> Token
  | TComma : Token
  | TBraceL : Token
  | TBraceR : Token
  | TExclam : Token
  | TEof : Token
  | TBind : Token
  | TPipe : Token
  | TBracketL : Token
  | TBracketR : Token;

-- Keyword indices carried by TKeyword. Shared for the same reason as Token:
-- the lexer assigns them and the parser reads them back.
def kwDef : Nat := 0;
def kwAxiom : Nat := 1;
def kwInductive : Nat := 2;
def kwFun : Nat := 3;
def kwMatch : Nat := 4;
def kwWith : Nat := 5;
def kwEnd : Nat := 6;
def kwLet : Nat := 7;
def kwIn : Nat := 8;
def kwFix : Nat := 9;
def kwImport : Nat := 10;
def kwEffect : Nat := 11;
def kwWhere : Nat := 12;
def kwDo : Nat := 13;
def kwPerform : Nat := 14;
def kwHandle : Nat := 15;
def kwRecord : Nat := 16;
def kwIntrinsic : Nat := 17;
def kwExtern : Nat := 18;
def kwRepresentation : Nat := 19;
def kwOpen : Nat := 20;
