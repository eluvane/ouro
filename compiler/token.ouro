-- Token constructors are a frontend ABI shared by lexer, parser shards, and generated C entry points.

import "../std/data.ouro",
  "base.ouro";

inductive Token : Type :=
  | TIdent : Nat -> Token
  | TNat : Nat -> Token
  | TKeyword : Nat -> Token
  | TType : Nat -> Token
  | TColon : Token
  | TColonEq : Token
  | TArrow : Token
  | TFatArrow : Token
  | TBar : Token
  | TLparen : Token
  | TRparen : Token
  | TSemi : Token
  | THole : Maybe Nat -> Token
  | TString : Nat -> Token
  | TComma : Token
  | TBraceL : Token
  | TBraceR : Token
  | TExclam : Token
  | TEof : Token
  | TBind : Token
  | TPipe : Token
  | TBracketL : Token
  | TBracketR : Token
  | TDotDot : Token
  | TDotDotEq : Token
  | TByteString : List Nat -> Token
  | TCoalesce : Token;

-- Keyword indices carried by TKeyword. Shared for the same reason as Token:
-- the lexer assigns them and the parser reads them back.
def kwDef : Nat := 0;
def kwAxiom : Nat := 1;
def kwInductive : Nat := 2;
def kwFun : Nat := 3;
def kwMatch : Nat := 4;
def kwWith : Nat := 5;
def kwEnd : Nat := 6;
def kwLet : Nat := 7;
def kwIn : Nat := 8;
def kwFix : Nat := 9;
def kwImport : Nat := 10;
def kwEffect : Nat := 11;
def kwWhere : Nat := 12;
def kwDo : Nat := 13;
def kwPerform : Nat := 14;
def kwHandle : Nat := 15;
def kwRecord : Nat := 16;
def kwIntrinsic : Nat := 17;
def kwExtern : Nat := 18;
def kwRepresentation : Nat := 19;
def kwOpen : Nat := 20;
def kwIf : Nat := 21;
def kwThen : Nat := 22;
def kwElse : Nat := 23;
def kwPrivate : Nat := 24;

def token_kw_chars_def : List Nat := ([100, 101, 102] : List Nat);
def token_kw_chars_axiom : List Nat := ([97, 120, 105, 111, 109] : List Nat);
def token_kw_chars_inductive : List Nat := ([105, 110, 100, 117, 99, 116, 105, 118, 101] : List Nat);
def token_kw_chars_fun : List Nat := ([102, 117, 110] : List Nat);
def token_kw_chars_match : List Nat := ([109, 97, 116, 99, 104] : List Nat);
def token_kw_chars_with : List Nat := ([119, 105, 116, 104] : List Nat);
def token_kw_chars_end : List Nat := ([101, 110, 100] : List Nat);
def token_kw_chars_let : List Nat := ([108, 101, 116] : List Nat);
def token_kw_chars_in : List Nat := ([105, 110] : List Nat);
def token_kw_chars_fix : List Nat := ([102, 105, 120] : List Nat);
def token_kw_chars_import : List Nat := ([105, 109, 112, 111, 114, 116] : List Nat);
def token_kw_chars_effect : List Nat := ([101, 102, 102, 101, 99, 116] : List Nat);
def token_kw_chars_where : List Nat := ([119, 104, 101, 114, 101] : List Nat);
def token_kw_chars_do : List Nat := ([100, 111] : List Nat);
def token_kw_chars_perform : List Nat := ([112, 101, 114, 102, 111, 114, 109] : List Nat);
def token_kw_chars_handle : List Nat := ([104, 97, 110, 100, 108, 101] : List Nat);
def token_kw_chars_record : List Nat := ([114, 101, 99, 111, 114, 100] : List Nat);
def token_kw_chars_intrinsic : List Nat := ([105, 110, 116, 114, 105, 110, 115, 105, 99] : List Nat);
def token_kw_chars_extern : List Nat := ([101, 120, 116, 101, 114, 110] : List Nat);
def token_kw_chars_representation : List Nat := ([114, 101, 112, 114, 101, 115, 101, 110, 116, 97, 116, 105, 111, 110] : List Nat);
def token_kw_chars_if : List Nat := ([105, 102] : List Nat);
def token_kw_chars_then : List Nat := ([116, 104, 101, 110] : List Nat);
def token_kw_chars_else : List Nat := ([101, 108, 115, 101] : List Nat);
def token_kw_chars_private : List Nat := ([112, 114, 105, 118, 97, 116, 101] : List Nat);

def token_keyword_entry (cs : List Nat) (k : Nat) (tl : List (Pair (List Nat) Nat)) : List (Pair (List Nat) Nat) :=
  Cons(Pair(List Nat, Nat), MkPair (List Nat) Nat cs k, tl);

-- A flat keyword table avoids deeply nested equality calls in elaboration.
-- The stage0 seed can parse this constructor form during regeneration.
def token_keyword_table_base : List (Pair (List Nat) Nat) :=
  token_keyword_entry token_kw_chars_def kwDef (
  token_keyword_entry token_kw_chars_axiom kwAxiom (
  token_keyword_entry token_kw_chars_inductive kwInductive (
  token_keyword_entry token_kw_chars_fun kwFun (
  token_keyword_entry token_kw_chars_match kwMatch (
  token_keyword_entry token_kw_chars_with kwWith (
  token_keyword_entry token_kw_chars_end kwEnd (
  token_keyword_entry token_kw_chars_let kwLet (
  token_keyword_entry token_kw_chars_in kwIn (
  token_keyword_entry token_kw_chars_fix kwFix (
  token_keyword_entry token_kw_chars_import kwImport (
  token_keyword_entry token_kw_chars_effect kwEffect (
  token_keyword_entry token_kw_chars_where kwWhere (
  token_keyword_entry token_kw_chars_do kwDo (
  token_keyword_entry token_kw_chars_perform kwPerform (
  token_keyword_entry token_kw_chars_handle kwHandle (
  token_keyword_entry token_kw_chars_record kwRecord (
  token_keyword_entry token_kw_chars_intrinsic kwIntrinsic (
  token_keyword_entry token_kw_chars_extern kwExtern (
  token_keyword_entry token_kw_chars_representation kwRepresentation (
  token_keyword_entry token_kw_chars_private kwPrivate (Nil (Pair(List Nat, Nat)))))))))))))))))))))));

def token_keyword_table : List (Pair (List Nat) Nat) :=
  token_keyword_entry token_kw_chars_if kwIf
    (token_keyword_entry token_kw_chars_then kwThen
      (token_keyword_entry token_kw_chars_else kwElse token_keyword_table_base));
