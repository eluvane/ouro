-- JsIR is shared by JS-style and C printers; tag order is part of the generated runtime ABI.

import "../std/data.ouro";

inductive JsIR : Type :=
  | JVar    : Nat -> JsIR
  | JGlob   : Nat -> JsIR
  | JLam    : Nat -> JsIR -> JsIR
  | JApp    : JsIR -> JsIR -> JsIR
  | JCtor   : Nat -> Nat -> List JsIR -> JsIR
  | JSwitch : JsIR -> List Nat -> List JsIR -> JsIR
  | JFix    : Nat -> List Nat -> JsIR -> JsIR
  | JLet    : Nat -> JsIR -> JsIR -> JsIR
  | JErr    : Nat -> JsIR
  | JStr    : Nat -> JsIR
  | JStrBytes : List Nat -> JsIR;

def extract_collect_apps : JsIR -> List JsIR -> Pair JsIR (List JsIR) :=
  fix extract_collect_apps (j : JsIR) (acc : List JsIR) : Pair JsIR (List JsIR) :=
    match j with
    | JApp f a => extract_collect_apps f (Cons JsIR a acc)
    | JVar _ => MkPair JsIR (List JsIR) j acc
    | JGlob _ => MkPair JsIR (List JsIR) j acc
    | JLam _ _ => MkPair JsIR (List JsIR) j acc
    | JCtor _ _ _ => MkPair JsIR (List JsIR) j acc
    | JSwitch _ _ _ => MkPair JsIR (List JsIR) j acc
    | JFix _ _ _ => MkPair JsIR (List JsIR) j acc
    | JLet _ _ _ => MkPair JsIR (List JsIR) j acc
    | JErr _ => MkPair JsIR (List JsIR) j acc
    | JStr _ => MkPair JsIR (List JsIR) j acc
    | JStrBytes _ => MkPair JsIR (List JsIR) j acc
    end;
