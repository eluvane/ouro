-- Native consumers retain the complete checked environment and literal table.
-- The declaration pipeline constructs this value only after every input item
-- succeeds. The ordered bodies are the exact elaborated terms in that environment.

import "pipeline_abi.ouro";
import "file_check_model.ouro";

inductive CheckedProgram : Type :=
  | CheckedProgramOf : InternState -> List Entry -> List (Pair Nat CoreTerm) -> CheckedProgram;

def checked_program_intern (program : CheckedProgram) : InternState :=
    match program with | CheckedProgramOf state _ _ => state end;

def checked_program_entries (program : CheckedProgram) : List Entry :=
    match program with | CheckedProgramOf _ entries _ => entries end;

def checked_program_cores (program : CheckedProgram) : List (Pair Nat CoreTerm) :=
    match program with | CheckedProgramOf _ _ cores => cores end;

-- Explicit compatibility projection for the transitional C backend.
def checked_program_erase (result : CompResult CheckedProgram)
    : CompResult (List (Pair Nat CoreTerm)) :=
    match result with
    | CErr failure => CErr (List (Pair Nat CoreTerm)) failure
    | COk program => COk (List (Pair Nat CoreTerm)) (checked_program_cores program)
    end;
