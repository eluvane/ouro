-- Derived exact-spelling lookup. The ordered intern tables remain the ABI;
-- duplicate keys retain the first list entry, including its original ID.

import "source_text.ouro";

inductive SourceNameIndex : Type :=
  | SourceNameIndexEmpty : SourceNameIndex
  | SourceNameIndexNode : Nat -> List Nat -> Nat -> SourceNameIndex -> SourceNameIndex -> SourceNameIndex;

def source_name_compare : List Nat -> List Nat -> Ordering :=
  fix compare (left : List Nat) (right : List Nat) : Ordering :=
    match left with
    | Nil => match right with | Nil => EQ | Cons _ _ => LT end
    | Cons byte rest => match right with
      | Nil => GT
      | Cons other tail => match compareNat byte other with
        | EQ => compare rest tail
        | LT => LT
        | GT => GT
        end
      end
    end;

def source_name_index_height (tree : SourceNameIndex) : Nat :=
  match tree with | SourceNameIndexEmpty => Z | SourceNameIndexNode height _ _ _ _ => height end;

def source_name_index_node (key : List Nat) (value : Nat)
    (left : SourceNameIndex) (right : SourceNameIndex) : SourceNameIndex :=
  SourceNameIndexNode (S (maxNat(source_name_index_height left, source_name_index_height right)))
    key value left right;

def source_name_index_left_heavy (key : List Nat) (value : Nat)
    (left : SourceNameIndex) (right : SourceNameIndex) : SourceNameIndex :=
  match left with
  | SourceNameIndexEmpty => source_name_index_node key value left right
  | SourceNameIndexNode _ first first_value outer inner =>
      match leb_nat(source_name_index_height inner, source_name_index_height outer) with
      | True => source_name_index_node first first_value outer (source_name_index_node key value inner right)
      | False => match inner with
        | SourceNameIndexEmpty => source_name_index_node first first_value outer (source_name_index_node key value inner right)
        | SourceNameIndexNode _ middle middle_value inner_left inner_right =>
            source_name_index_node middle middle_value
              (source_name_index_node first first_value outer inner_left)
              (source_name_index_node key value inner_right right)
        end
      end
  end;

def source_name_index_right_heavy (key : List Nat) (value : Nat)
    (left : SourceNameIndex) (right : SourceNameIndex) : SourceNameIndex :=
  match right with
  | SourceNameIndexEmpty => source_name_index_node key value left right
  | SourceNameIndexNode _ last last_value inner outer =>
      match leb_nat(source_name_index_height inner, source_name_index_height outer) with
      | True => source_name_index_node last last_value (source_name_index_node key value left inner) outer
      | False => match inner with
        | SourceNameIndexEmpty => source_name_index_node last last_value (source_name_index_node key value left inner) outer
        | SourceNameIndexNode _ middle middle_value inner_left inner_right =>
            source_name_index_node middle middle_value
              (source_name_index_node key value left inner_left)
              (source_name_index_node last last_value inner_right outer)
        end
      end
  end;

def source_name_index_balance (key : List Nat) (value : Nat)
    (left : SourceNameIndex) (right : SourceNameIndex) : SourceNameIndex :=
  match ltb_nat(S (source_name_index_height right), source_name_index_height left) with
  | True => source_name_index_left_heavy key value left right
  | False => match ltb_nat(S (source_name_index_height left), source_name_index_height right) with
    | True => source_name_index_right_heavy key value left right
    | False => source_name_index_node key value left right
    end
  end;

def source_name_index_insert (key : List Nat) (value : Nat) : SourceNameIndex -> SourceNameIndex :=
  fix insert (tree : SourceNameIndex) : SourceNameIndex :=
    match tree with
    | SourceNameIndexEmpty => source_name_index_node key value SourceNameIndexEmpty SourceNameIndexEmpty
    | SourceNameIndexNode _ current stored left right =>
        match source_name_compare key current with
        | EQ => tree
        | LT => source_name_index_balance current stored (insert left) right
        | GT => source_name_index_balance current stored left (insert right)
        end
    end;

def source_name_index_lookup (key : List Nat) : SourceNameIndex -> Maybe Nat :=
  fix lookup (tree : SourceNameIndex) : Maybe Nat :=
    match tree with
    | SourceNameIndexEmpty => Nothing Nat
    | SourceNameIndexNode _ current value left right =>
        match source_name_compare key current with
        | EQ => Just Nat value
        | LT => lookup left
        | GT => lookup right
        end
    end;

def source_name_index_from (table : List (Pair (List Nat) Nat)) : SourceNameIndex :=
  (fix collect (remaining : List (Pair (List Nat) Nat)) (tree : SourceNameIndex) : SourceNameIndex :=
    match remaining with
    | Nil => tree
    | Cons pair rest => match pair with
      | MkPair key value => collect rest (source_name_index_insert key value tree)
      end
    end) table SourceNameIndexEmpty;
