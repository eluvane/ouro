-- Second split parser shard; tag contracts must match parser_min and token exactly.

import "parser_min.ouro",
  "token.ouro";

def parse_b_fun (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  bindValue (List (Pair(Nat, Maybe Expr))) asListPairNatMaybeExpr (parse fuel' MFunBinders toks pos extra)
    (fun (bs : List (Pair Nat (Maybe Expr))) (toks2 : List Token) (pos2 : Nat) =>
      match bs with
      | Nil => PErr Value pos2
      | Cons _ _ =>
          bindParseResult Unit Value (expect_fat_arrow toks2 pos2)
            (fun (_u : Unit) (toks3 : List Token) (pos3 : Nat) =>
              bindValue Expr asExpr (parse fuel' MExpr toks3 pos3 extra)
                (fun (body : Expr) (toks4 : List Token) (pos4 : Nat) =>
                  okExpr (mk_lam_chain bs body) toks4 pos4))
      end);

def parse_b_local_value (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (name : Nat) (fuel' : Nat) (params : List (Pair Nat Expr))
    (finish : Nat -> Maybe Expr -> Expr -> List Token -> Nat -> ParseResult Value)
    (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  match is_colon (peek toks) with
  | True =>
      bindParseResult Unit Value (expect_colon toks pos)
        (fun (_u : Unit) (after_colon : List Token) (type_pos : Nat) =>
          bindValue Expr asExpr (parse fuel' MExpr after_colon type_pos extra)
            (fun (ann : Expr) (after_type : List Token) (assign_pos : Nat) =>
              bindParseResult Unit Value (expect_colon_eq after_type assign_pos)
                (fun (_assign : Unit) (after_assign : List Token) (value_pos : Nat) =>
                  bindValue Expr asExpr (parse fuel' MExpr after_assign value_pos extra)
                    (fun (value : Expr) (after_value : List Token) (end_pos : Nat) =>
                      finish name (Just Expr (mk_pi_chain params ann))
                        (mk_typed_lam_chain params value) after_value end_pos))))
  | False =>
      bindParseResult Unit Value (expect_colon_eq toks pos)
        (fun (_assign : Unit) (after_assign : List Token) (value_pos : Nat) =>
          bindValue Expr asExpr (parse fuel' MExpr after_assign value_pos extra)
            (fun (value : Expr) (after_value : List Token) (end_pos : Nat) =>
              finish name (Nothing Expr)
                (mk_typed_lam_chain params value) after_value end_pos))
  end;

-- Parameters have exactly the declaration telescope's scope. The local name
-- itself is not in scope in its value; recursion still requires explicit fix.
def parse_b_binding (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value)
    (finish : Nat -> Maybe Expr -> Expr -> List Token -> Nat -> ParseResult Value)
    : ParseResult Value :=
  bindParseResult Nat Value (expect_ident toks pos)
    (fun (name : Nat) (tail : List Token) (position : Nat) =>
      match is_binder_ahead tail with
      | False =>
          parse_b_local_value parse name fuel' (Nil (Pair Nat Expr))
            finish tail position extra
      | True =>
          bindValue (List (Pair Nat Expr)) asListPairNatExpr
            (parse fuel' MTypedBinders tail position extra)
            (fun (params : List (Pair Nat Expr)) (after : List Token) (next : Nat) =>
              parse_b_local_value parse name fuel' params
                finish after next extra)
      end);

def parse_b_block_final
    (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value)
    : ParseResult Value :=
  bindValue Expr asExpr (parse fuel' MExpr toks pos extra)
    (fun (value : Expr) (after : List Token) (position : Nat) =>
      bindParseResult Unit Value (expect_brace_r after position)
        (fun (_close : Unit) (rest : List Token) (end_pos : Nat) =>
          okExpr value rest end_pos));

-- The braces identify a pure expression scope. Each semicolon introduces an
-- ordinary ELet; the final expression is mandatory and has no semicolon.
def parse_b_block_body
    (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel : Nat) (toks : List Token) (pos : Nat) (extra : Value)
    : ParseResult Value :=
  (fix go (remaining : Nat) (items : List Token) (position : Nat)
      : ParseResult Value :=
    match remaining with
    | Z => PErr Value position
    | S next =>
        match tokenIsKeyword (peek items) with
        | Nothing => parse_b_block_final parse next items position extra
        | Just keyword =>
            match eqNat keyword kwLet with
            | False => parse_b_block_final parse next items position extra
            | True =>
                match items with
                | Nil => PErr Value position
                | Cons _ after_let =>
                    match eqNat(token_tag (peek after_let), tagBraceL) with
                    | True => parse_b_block_final parse next items position extra
                    | False =>
                        parse_b_binding parse next after_let (S position) extra
                          (fun (name : Nat) (ann : Maybe Expr) (value : Expr)
                              (after_value : List Token) (end_pos : Nat) =>
                            match is_semi (peek after_value) with
                            | True =>
                                bindParseResult Unit Value
                                  (expect_tag tagSemi after_value end_pos)
                                  (fun (_semi : Unit) (tail : List Token)
                                      (tail_pos : Nat) =>
                                    bindValue Expr asExpr
                                      (go next tail tail_pos)
                                      (fun (body : Expr) (rest : List Token)
                                          (past : Nat) =>
                                        okExpr (ELet name ann value body)
                                          rest past))
                            | False =>
                                bindParseResult Unit Value
                                  (expect_keyword kwIn after_value end_pos)
                                  (fun (_in : Unit) (tail : List Token)
                                      (tail_pos : Nat) =>
                                    bindValue Expr asExpr
                                      (parse_b_block_final parse next
                                        tail tail_pos extra)
                                      (fun (body : Expr) (rest : List Token)
                                          (past : Nat) =>
                                        okExpr (ELet name ann value body)
                                          rest past))
                            end)
                    end
                end
            end
        end
    end) fuel toks pos;

def parse_b_let (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  match eqNat(token_tag (peek toks), tagBraceL) with
  | True =>
      bindParseResult Unit Value (expect_brace_l toks pos)
        (fun (_open : Unit) (body : List Token) (body_pos : Nat) =>
          parse_b_block_body parse fuel' body body_pos extra)
  | False =>
      parse_b_binding parse fuel' toks pos extra
        (fun (name : Nat) (ann : Maybe Expr) (value : Expr)
            (after_value : List Token) (end_pos : Nat) =>
          bindParseResult Unit Value (expect_keyword kwIn after_value end_pos)
            (fun (_in : Unit) (body_tokens : List Token) (body_pos : Nat) =>
              bindValue Expr asExpr (parse fuel' MExpr body_tokens body_pos extra)
                (fun (body : Expr) (rest : List Token) (past : Nat) =>
                  okExpr (ELet name ann value body) rest past)))
  end;

def parse_b_match (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  let cont11 (scruts : List Expr) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
      let cont7 (_u : Unit) (toks3 : List Token) (pos3 : Nat) : ParseResult Value :=
      bindValue (List (Pair(List (Pair(Nat, List Nat)), Expr))) asListRow (parse fuel' MMultiBranches toks3 pos3 extra)
      (fun (rows : List (Pair (List (Pair Nat (List Nat))) Expr)) (toks4 : List Token) (pos4 : Nat) =>
      let cont1 (_u2 : Unit) (toks5 : List Token) (pos5 : Nat) : ParseResult Value :=
      match desugar_match_rows scruts rows toks5 pos5 with
      | PErr p => PErr Value p
      | POk e toks6 pos6 => okExpr e toks6 pos6
      end
      in bindParseResult Unit Value (expect_keyword kwEnd toks4 pos4)
      cont1)
      in bindParseResult Unit Value (expect_keyword kwWith toks2 pos2)
      cont7
    in bindValue (List Expr) asListExpr (parse fuel' MScrutList toks pos extra)
    cont11;

def parse_b_fix (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  let cont13 (n : Nat) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
      bindValue (List (Pair Nat Expr)) asListPairNatExpr (parse fuel' MTypedBinders toks2 pos2 extra)
      (fun (bs : List (Pair Nat Expr)) (toks3 : List Token) (pos3 : Nat) =>
      match bs with
      | Nil => PErr Value pos3
      | Cons _ _ =>
      bindParseResult Unit Value (expect_colon toks3 pos3)
      (fun (_u : Unit) (toks4 : List Token) (pos4 : Nat) =>
      bindValue Expr asExpr (parse fuel' MExpr toks4 pos4 extra)
      (fun (ret : Expr) (toks5 : List Token) (pos5 : Nat) =>
      bindParseResult Unit Value (expect_colon_eq toks5 pos5)
      (fun (_u2 : Unit) (toks6 : List Token) (pos6 : Nat) =>
      bindValue Expr asExpr (parse fuel' MExpr toks6 pos6 extra)
      (fun (body : Expr) (toks7 : List Token) (pos7 : Nat) =>
      okExpr (EFix n (mk_binder_chain bs) ret body) toks7 pos7))))
      end)
    in bindParseResult Nat Value (expect_ident toks pos)
    cont13;

def parse_b_pattern (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  bindParseResult Nat Value (expect_ident toks pos)
    (fun (ctor : Nat) (toks2 : List Token) (pos2 : Nat) =>
      bindValue (List Nat) asListNat (parse fuel' MPatternVars toks2 pos2 extra)
        (fun (vars : List Nat) (toks3 : List Token) (pos3 : Nat) =>
          okPairNatListNat (MkPair Nat (List Nat) ctor vars) toks3 pos3));

def parse_b_pattern_vars (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  match tokenIsIdent (peek toks) with
  | Just _ni =>
      bindParseResult Nat Value (expect_ident toks pos)
        (fun (n : Nat) (toks2 : List Token) (pos2 : Nat) =>
          bindValue (List Nat) asListNat (parse fuel' MPatternVars toks2 pos2 extra)
            (fun (ns : List Nat) (toks3 : List Token) (pos3 : Nat) =>
              okListNat (Cons Nat n ns) toks3 pos3))
  | Nothing =>
      match tokenIsHole (peek toks) with
      | Just m =>
          match m with
          | Nothing =>
              bindParseResult Unit Value (expect_tag tagHole toks pos)
                (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
                  bindValue (List Nat) asListNat (parse fuel' MPatternVars toks2 pos2 extra)
                    (fun (ns : List Nat) (toks3 : List Token) (pos3 : Nat) =>
                      okListNat (Cons Nat Z ns) toks3 pos3))
          | Just _mi => okListNat (Nil Nat) toks pos
          end
      | Nothing => okListNat (Nil Nat) toks pos
      end
  end;

def parse_b_patterns (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  bindValue (Pair(Nat, List Nat)) asPairNatListNat (parse fuel' MPattern toks pos extra)
    (fun (p : Pair Nat (List Nat)) (toks2 : List Token) (pos2 : Nat) =>
      match is_comma (peek toks2) with
      | True =>
          match toks2 with
          | Cons _ rest =>
              bindValue (List (Pair(Nat, List Nat))) asListPairNatListNat (parse fuel' MPatterns rest (S pos2) extra)
                (fun (ps : List (Pair Nat (List Nat))) (toks3 : List Token) (pos3 : Nat) =>
                  okListPairNatListNat (Cons (Pair(Nat, List Nat)) p ps) toks3 pos3)
          | Nil => PErr Value pos2
          end
      | False => okListPairNatListNat (Cons(Pair(Nat, List Nat), p, Nil (Pair(Nat, List Nat)))) toks2 pos2
      end);

def parse_b_multi_branches (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  match is_bar (peek toks) with
  | False => okListRow (Nil (Pair(List (Pair(Nat, List Nat)), Expr))) toks pos
  | True =>
      bindParseResult Unit Value (expect_bar toks pos)
        (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
          bindValue (List (Pair(Nat, List Nat))) asListPairNatListNat (parse fuel' MPatterns toks2 pos2 extra)
            (fun (pats : List (Pair Nat (List Nat))) (toks3 : List Token) (pos3 : Nat) =>
              bindParseResult Unit Value (expect_fat_arrow toks3 pos3)
                (fun (_u2 : Unit) (toks4 : List Token) (pos4 : Nat) =>
                  bindValue Expr asExpr (parse fuel' MExpr toks4 pos4 extra)
                    (fun (body : Expr) (toks5 : List Token) (pos5 : Nat) =>
                      bindValue (List (Pair(List (Pair(Nat, List Nat)), Expr))) asListRow (parse fuel' MMultiBranches toks5 pos5 extra)
                        (fun (rest : List (Pair (List (Pair Nat (List Nat))) Expr)) (toks6 : List Token) (pos6 : Nat) =>
                          okListRow (Cons(Pair(List (Pair(Nat, List Nat)), Expr), MkPair (List (Pair(Nat, List Nat))) Expr pats body, rest)) toks6 pos6)))))
  end;

def parse_b_scrut_list (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  let cont5 (e : Expr) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
      match is_comma (peek toks2) with
      | True =>
      match toks2 with
      | Cons _ rest =>
      bindValue (List Expr) asListExpr (parse fuel' MScrutList rest (S pos2) extra)
      (fun (es : List Expr) (toks3 : List Token) (pos3 : Nat) =>
      okListExpr (Cons Expr e es) toks3 pos3)
      | Nil => PErr Value pos2
      end
      | False => okListExpr (list1_expr e) toks2 pos2
      end
    in bindValue Expr asExpr (parse fuel' MExpr toks pos extra)
    cont5;

def parse_b_do_stmt (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  match toks with
  | Nil => parse fuel' MExpr toks pos extra
  | Cons t1 rest1 =>
      match tokenIsKeyword t1 with
      | Just k =>
          match eqNat k kwLet with
          | True =>
              match rest1 with
              | Nil => parse fuel' MExpr toks pos extra
              | Cons tBang restBang =>
                  match is_exclam tBang with
                  | False => parse fuel' MExpr toks pos extra
                  | True =>
                      bindParseResult Nat Value (expect_binder_name(restBang, S (S pos)))
                        (fun (binder : Nat) (toksName : List Token) (posName : Nat) =>
                          bindParseResult Unit Value (expect_colon_eq toksName posName)
                            (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
                              bindValue Expr asExpr (parse fuel' MExpr toks2 pos2 extra)
                                (fun (action : Expr) (toks3 : List Token) (pos3 : Nat) =>
                                  okExpr (EDoBind binder action) toks3 pos3)))
                  end
              end
          | False => parse fuel' MExpr toks pos extra
          end
      | Nothing =>
      match tokenIsBinderName t1 with
      | Nothing => parse fuel' MExpr toks pos extra
      | Just binder =>
          match rest1 with
          | Nil => parse fuel' MExpr toks pos extra
          | Cons t2 rest2 =>
              match is_bind t2 with
              | True =>
                  bindValue Expr asExpr (parse fuel' MExpr rest2 (S (S pos)) extra)
                    (fun (action : Expr) (toks2 : List Token) (pos2 : Nat) =>
                      okExpr (EDoBind binder action) toks2 pos2)
              | False => parse fuel' MExpr toks pos extra
              end
          end
      end
      end
  end;

def parse_b_do_exprs (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  let cont4 (e : Expr) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
      match is_semi (peek toks2) with
      | True =>
      match toks2 with
      | Cons _ rest =>
      bindValue (List Expr) asListExpr (parse fuel' MDoExprs rest (S pos2) extra)
      (fun (es : List Expr) (toks3 : List Token) (pos3 : Nat) =>
      okListExpr (Cons Expr e es) toks3 pos3)
      | Nil => PErr Value pos2
      end
      | False => okListExpr (list1_expr e) toks2 pos2
      end
    in bindValue Expr asExpr (parse fuel' MDoStmt toks pos extra)
    cont4;

def parse_b_perform (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  bindParseResult Nat Value (expect_ident toks pos)
    (fun (op : Nat) (toks2 : List Token) (pos2 : Nat) =>
      match is_lparen (peek toks2) with
      | True =>
          bindParseResult Unit Value (expect_lparen toks2 pos2)
            (fun (_u : Unit) (toks3 : List Token) (pos3 : Nat) =>
              bindValue (List Expr) asListExpr (parse fuel' MCommaList toks3 pos3 extra)
                (fun (args : List Expr) (toks4 : List Token) (pos4 : Nat) =>
                  bindParseResult Unit Value (expect_rparen toks4 pos4)
                    (fun (_u2 : Unit) (toks5 : List Token) (pos5 : Nat) =>
                      okExpr (EPerform op args) toks5 pos5)))
      | False =>
          okExpr (EPerform(op, Nil Expr)) toks2 pos2
      end);

def parse_b_do (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  bindValue (List Expr) asListExpr (parse fuel' MDoExprs toks pos extra)
    (fun (es : List Expr) (toks2 : List Token) (pos2 : Nat) =>
      okExpr (EDo es) toks2 pos2);

def parse_b_handle (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  bindValue Expr asExpr (parse fuel' MExpr toks pos extra)
    (fun (comp : Expr) (toks2 : List Token) (pos2 : Nat) =>
      bindParseResult Unit Value (expect_keyword kwWith toks2 pos2)
        (fun (_u : Unit) (toks3 : List Token) (pos3 : Nat) =>
          bindValue (List (Pair(Nat, Pair(List Nat, Expr)))) asListHandleClause (parse fuel' MHandleClauses toks3 pos3 extra)
            (fun (clauses : List (Pair Nat (Pair (List Nat) Expr))) (toks4 : List Token) (pos4 : Nat) =>
              match tokenIsKeyword (peek toks4) with
              | Nothing => okExpr (EHandle comp clauses) toks4 pos4
              | Just k =>
                  match eqNat k kwEnd with
                  | True =>
                      bindParseResult Unit Value (expect_keyword kwEnd toks4 pos4)
                        (fun (_u2 : Unit) (toks5 : List Token) (pos5 : Nat) =>
                          okExpr (EHandle comp clauses) toks5 pos5)
                  | False => okExpr (EHandle comp clauses) toks4 pos4
                  end
              end)));

-- Continuation-passing clause parser: few branches, many small lambdas.
-- @bound(cyclo <= 7)
def parse_b_handle_clauses (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
  match is_bar (peek toks) with
  | False => okListHandleClause (Nil (Pair(Nat, Pair(List Nat, Expr)))) toks pos
  | True =>
      bindParseResult Unit Value (expect_bar toks pos)
        (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
          bindParseResult Nat Value (expect_ident toks2 pos2)
            (fun (op : Nat) (toks3 : List Token) (pos3 : Nat) =>
              match is_lparen (peek toks3) with
              | True =>
                  bindParseResult Unit Value (expect_lparen toks3 pos3)
                    (fun (_u2 : Unit) (toks4 : List Token) (pos4 : Nat) =>
                      bindValue (List Nat) asListNat (parse fuel' MIdentCommaList toks4 pos4 extra)
                        (fun (args : List Nat) (toks5 : List Token) (pos5 : Nat) =>
                          bindParseResult Unit Value (expect_rparen toks5 pos5)
                            (fun (_u3 : Unit) (toks6 : List Token) (pos6 : Nat) =>
                              bindParseResult Nat Value (expect_binder_name toks6 pos6)
                                (fun (k : Nat) (toks7 : List Token) (pos7 : Nat) =>
                                  bindParseResult Unit Value (expect_fat_arrow toks7 pos7)
                                    (fun (_u4 : Unit) (toks8 : List Token) (pos8 : Nat) =>
                                      bindValue Expr asExpr (parse fuel' MExpr toks8 pos8 extra)
                                        (fun (body : Expr) (toks9 : List Token) (pos9 : Nat) =>
                                          bindValue (List (Pair(Nat, Pair(List Nat, Expr)))) asListHandleClause (parse fuel' MHandleClauses toks9 pos9 extra)
                                            (fun (rest : List (Pair Nat (Pair (List Nat) Expr))) (toks10 : List Token) (pos10 : Nat) =>
                                              okListHandleClause (Cons(Pair(Nat, Pair(List Nat, Expr)), MkPair(Nat, Pair(List Nat, Expr), op, MkPair(List Nat, Expr, append Nat args (list1_nat k), body)), rest)) toks10 pos10)))))))
              | False =>
                  bindParseResult Nat Value (expect_binder_name toks3 pos3)
                    (fun (x : Nat) (toks4 : List Token) (pos4 : Nat) =>
                      bindParseResult Unit Value (expect_fat_arrow toks4 pos4)
                        (fun (_u2 : Unit) (toks5 : List Token) (pos5 : Nat) =>
                          bindValue Expr asExpr (parse fuel' MExpr toks5 pos5 extra)
                            (fun (body : Expr) (toks6 : List Token) (pos6 : Nat) =>
                              bindValue (List (Pair(Nat, Pair(List Nat, Expr)))) asListHandleClause (parse fuel' MHandleClauses toks6 pos6 extra)
                                (fun (rest : List (Pair Nat (Pair (List Nat) Expr))) (toks7 : List Token) (pos7 : Nat) =>
                                  okListHandleClause (Cons(Pair(Nat, Pair(List Nat, Expr)), MkPair(Nat, Pair(List Nat, Expr), op, MkPair(List Nat, Expr, list1_nat x, body)), rest)) toks7 pos7))))
              end))
  end;

def parse_b (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value :=
  fun (fuel : Nat) (mode : Mode) (toks : List Token) (pos : Nat) (extra : Value) =>
    match fuel with
    | Z => PErr Value pos
    | S fuel' =>
        match mode with
        | MExpr => parse fuel mode toks pos extra
        | MPipe => parse fuel mode toks pos extra
        | MPipeTail => parse fuel mode toks pos extra
        | MPi => parse fuel mode toks pos extra
        | MPiFromApp => parse fuel mode toks pos extra
        | MApp => parse fuel mode toks pos extra
        | MAppTail => parse fuel mode toks pos extra
        | MAtom => parse fuel mode toks pos extra
        | MParen => parse fuel mode toks pos extra
        | MKeywordAtom => parse fuel mode toks pos extra
        | MFun => parse_b_fun parse fuel' toks pos extra
        | MLet => parse_b_let parse fuel' toks pos extra
        | MMatch => parse_b_match parse fuel' toks pos extra
        | MFix => parse_b_fix parse fuel' toks pos extra
        | MTypedBinder => parse fuel mode toks pos extra
        | MTypedBinderGroup => parse fuel mode toks pos extra
        | MTypedBinders => parse fuel mode toks pos extra
        | MFunBinders => parse fuel mode toks pos extra
        | MPattern => parse_b_pattern parse fuel' toks pos extra
        | MPatternVars => parse_b_pattern_vars parse fuel' toks pos extra
        | MPatterns => parse_b_patterns parse fuel' toks pos extra
        | MMultiBranches => parse_b_multi_branches parse fuel' toks pos extra
        | MScrutList => parse_b_scrut_list parse fuel' toks pos extra
        | MEffectAnnotation => parse fuel mode toks pos extra
        | MEffectRow => parse fuel mode toks pos extra
        | MCommaList => parse fuel mode toks pos extra
        | MListElems => parse fuel mode toks pos extra
        | MListTail => parse fuel mode toks pos extra
        | MIdentCommaList => parse fuel mode toks pos extra
        | MDoStmt => parse_b_do_stmt parse fuel' toks pos extra
        | MDoExprs => parse_b_do_exprs parse fuel' toks pos extra
        | MPerform => parse_b_perform parse fuel' toks pos extra
        | MDo => parse_b_do parse fuel' toks pos extra
        | MHandle => parse_b_handle parse fuel' toks pos extra
        | MHandleClauses => parse_b_handle_clauses parse fuel' toks pos extra
        end
    end;
