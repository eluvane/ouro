-- First split parser shard; keep shared parser types in parser_min to avoid duplicate generated symbols.

import "parser_min.ouro",
  "token.ouro";

-- One arm per Mode, so the branch count is the size of the mode table.
-- @bound(cyclo <= 132)
def parse_a_pipetail
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match asExpr extra with
    | Nothing => PErr Value pos
    | Just lhs =>
        match is_pipe (peek toks) with
        | False => okExpr lhs toks pos
        | True =>
            match toks with
            | Nil => PErr Value pos
            | Cons _ rest =>
                bindValue Expr asExpr (parse fuel' MApp rest (S pos) extra)
                  (fun (rhs : Expr) (toks3 : List Token) (pos3 : Nat) =>
                    parse fuel' MPipeTail toks3 pos3 (VExpr (EApp rhs lhs)))
            end
        end
    end;

def parse_a_pi
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    -- (x y : A) is Pi only if '->' follows; else reparse as app/ascribe.
    match is_binder_ahead toks with
    | True =>
        let cont12 (group : List (Pair Nat Expr)) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
            bindValue (List (Pair Nat Expr)) asListPairNatExpr (parse fuel' MTypedBinders toks2 pos2 extra)
            (fun (bs : List (Pair Nat Expr)) (toks3 : List Token) (pos3 : Nat) =>
            match is_arrow (peek toks3) with
            | True =>
            bindParseResult Unit Value (expect_arrow toks3 pos3)
            (fun (_u : Unit) (toks4 : List Token) (pos4 : Nat) =>
            bindValue Expr asExpr (parse fuel' MPi toks4 pos4 extra)
            (fun (rhs : Expr) (toks5 : List Token) (pos5 : Nat) =>
            bindValue Expr asExpr (parse fuel' MEffectAnnotation toks5 pos5 (VExpr rhs))
            (fun (rhs' : Expr) (toks6 : List Token) (pos6 : Nat) =>
            okExpr (mk_pi_chain(append (Pair Nat Expr) group bs, rhs')) toks6 pos6)))
            | False =>
            parse fuel' MPiFromApp toks pos extra
            end)
          in bindValue (List (Pair Nat Expr)) asListPairNatExpr (parse fuel' MTypedBinderGroup toks pos extra)
          cont12
    | False =>
        parse fuel' MPiFromApp toks pos extra
    end;

def parse_a_pifromapp
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    let cont10 (head : Expr) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
        match is_arrow (peek toks2) with
        | True =>
        bindParseResult Unit Value (expect_arrow toks2 pos2)
        (fun (_u : Unit) (toks3 : List Token) (pos3 : Nat) =>
        bindValue Expr asExpr (parse fuel' MPi toks3 pos3 extra)
        (fun (rhs : Expr) (toks4 : List Token) (pos4 : Nat) =>
        bindValue Expr asExpr (parse fuel' MEffectAnnotation toks4 pos4 (VExpr rhs))
        (fun (rhs' : Expr) (toks5 : List Token) (pos5 : Nat) =>
        okExpr (EPi Z head rhs') toks5 pos5)))
        | False =>
        bindValue Expr asExpr (parse fuel' MEffectAnnotation toks2 pos2 (VExpr head))
        (fun (head' : Expr) (toks3 : List Token) (pos3 : Nat) =>
        okExpr head' toks3 pos3)
        end
      in bindValue Expr asExpr (parse fuel' MApp toks pos extra)
      cont10;

-- A call group is a sequence of ordinary applications, never a tuple or a
-- receiver lookup. Parse each argument with the shared expression callback.
def parse_a_call_argument
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    bindValue Expr asExpr (parse fuel MExpr toks pos extra)
      (fun (arg : Expr) (tail : List Token) (position : Nat) =>
        match is_colon (peek tail) with
        | False => okExpr arg tail position
        | True =>
            bindParseResult Unit Value (expect_colon tail position)
              (fun (_u : Unit) (after : List Token) (next : Nat) =>
                bindValue Expr asExpr (parse fuel MExpr after next extra)
                  (fun (ty : Expr) (rest : List Token) (end_pos : Nat) =>
                    okExpr (EAscribe arg ty) rest end_pos))
        end);

def parse_a_call_arguments
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel : Nat) (head : Expr) (toks : List Token) (pos : Nat)
  (extra : Value) : ParseResult Value :=
  let finish (head : Expr) (rows : List (Pair Nat Expr))
      (named : Bool) : Expr :=
    match named with
    | True => ENamedCall head rows
    | False =>
        (fix apply (items : List (Pair Nat Expr)) (term : Expr) : Expr :=
          match items with
          | Nil => term
          | Cons pair rest =>
              match pair with
              | MkPair _ argument => apply rest (EApp term argument)
              end
          end) rows head
    end in
  (fix arguments (fuel : Nat) (head : Expr)
      (rows : List (Pair Nat Expr)) (named : Bool)
      (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match fuel with
    | Z => PErr Value pos
    | S remaining =>
        let parsed : ParseResult (Pair Nat Expr) :=
          match toks with
          | Nil => PErr (Pair Nat Expr) pos
          | Cons first after_first =>
              match tokenIsIdent first with
              | Nothing =>
                  match parse_a_call_argument parse remaining toks pos extra with
                  | PErr p => PErr (Pair Nat Expr) p
                  | POk value rest end_pos =>
                      match asExpr value with
                      | Nothing => PErr (Pair Nat Expr) end_pos
                      | Just argument =>
                          POk (Pair Nat Expr) (MkPair Nat Expr Z argument) rest end_pos
                      end
                  end
              | Just label =>
                  match eqNat(token_tag(peek after_first), tagColonEq) with
                  | False =>
                      match parse_a_call_argument parse remaining toks pos extra with
                      | PErr p => PErr (Pair Nat Expr) p
                      | POk value rest end_pos =>
                          match asExpr value with
                          | Nothing => PErr (Pair Nat Expr) end_pos
                          | Just argument =>
                              POk (Pair Nat Expr) (MkPair Nat Expr Z argument) rest end_pos
                          end
                      end
                  | True =>
                      match bump after_first (S pos) with
                      | MkPair after_assign rhs_pos =>
                          match orb(is_comma(peek after_assign),
                              eqNat(token_tag(peek after_assign), tagRparen)) with
                          | True =>
                              POk (Pair Nat Expr)
                                (MkPair Nat Expr label (EVar label))
                                after_assign rhs_pos
                          | False =>
                              match parse_a_call_argument parse remaining
                                  after_assign rhs_pos extra with
                              | PErr p => PErr (Pair Nat Expr) p
                              | POk value rest end_pos =>
                                  match asExpr value with
                                  | Nothing => PErr (Pair Nat Expr) end_pos
                                  | Just argument =>
                                      POk (Pair Nat Expr)
                                        (MkPair Nat Expr label argument) rest end_pos
                                  end
                              end
                          end
                      end
                  end
              end
          end in
        bindParseResult (Pair Nat Expr) Value parsed
          (fun (row : Pair Nat Expr) (tail : List Token) (position : Nat) =>
            match row with
            | MkPair label _ =>
                match andb named (eqNat label Z) with
                | True => PErr Value pos
                | False =>
                    let all : List (Pair Nat Expr) :=
                      append (Pair Nat Expr) rows [row] in
                    let any_named : Bool := orb named (notb (eqNat label Z)) in
                    match is_comma (peek tail) with
                    | False =>
                        bindParseResult Unit Value (expect_rparen tail position)
                          (fun (_u : Unit) (after : List Token) (next : Nat) =>
                            okExpr (finish head all any_named) after next)
                    | True =>
                        match bump tail position with
                        | MkPair after next =>
                            match eqNat(token_tag (peek after), tagRparen) with
                            | True =>
                                bindParseResult Unit Value (expect_rparen after next)
                                  (fun (_u : Unit) (rest : List Token) (end_pos : Nat) =>
                                    okExpr (finish head all any_named) rest end_pos)
                            | False =>
                                arguments remaining head all any_named after next extra
                            end
                        end
                    end
                end
            end)
    end) fuel head (Nil (Pair Nat Expr)) False toks pos extra;

def parse_a_apptail
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match asExpr extra with
    | Nothing => PErr Value pos
    | Just head =>
        match is_atom_start (peek toks) with
        | False => okExpr head toks pos
        | True =>
            match is_lparen (peek toks) with
            | True =>
                bindParseResult Unit Value (expect_lparen toks pos)
                  (fun (_u : Unit) (tail : List Token) (position : Nat) =>
                    bindValue Expr asExpr
                      (parse_a_call_arguments parse fuel' head tail position extra)
                      (fun (applied : Expr) (after : List Token) (next : Nat) =>
                        parse fuel' MAppTail after next (VExpr applied)))
            | False =>
                bindValue Expr asExpr (parse fuel' MAtom toks pos extra)
                  (fun (a : Expr) (toks3 : List Token) (pos3 : Nat) =>
                    parse fuel' MAppTail toks3 pos3 (VExpr (EApp head a)))
            end
        end
    end;

def parse_a_atom
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match toks with
    | Nil => PErr Value pos
    | Cons t rest =>
        match tokenIsIdent t with
        | Just n => okExpr(EVar n, rest, S pos)
        | Nothing =>
            match tokenIsNat t with
            | Just n => okExpr(ENat n, rest, S pos)
            | Nothing =>
                match tokenIsString t with
                | Just n => okExpr(EStr n, rest, S pos)
                | Nothing =>
                match tokenIsType t with
                | Just u => okExpr(ESort u, rest, S pos)
                | Nothing =>
                    match tokenIsHole t with
                    | Just m => okExpr(EHole m, rest, S pos)
                    | Nothing =>
                        match is_lparen t with
                        | True => parse fuel' MParen rest (S pos) extra
                        | False =>
                            match eqNat(token_tag t, tagBracketL) with
                            | True => parse fuel' MListElems rest (S pos) extra
                            | False =>
                                match tokenIsKeyword t with
                                | Nothing => PErr Value pos
                                | Just k => parse fuel' MKeywordAtom rest (S pos) (VNat k)
                                end
                            end
                        end
                    end
                end
                end
            end
        end
    end;

def parse_a_paren
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    let cont8 (e : Expr) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
        match is_colon (peek toks2) with
        | True =>
        bindParseResult Unit Value (expect_colon toks2 pos2)
        (fun (_u : Unit) (toks3 : List Token) (pos3 : Nat) =>
        bindValue Expr asExpr (parse fuel' MExpr toks3 pos3 extra)
        (fun (ty : Expr) (toks4 : List Token) (pos4 : Nat) =>
        bindParseResult Unit Value (expect_rparen toks4 pos4)
        (fun (_u2 : Unit) (toks5 : List Token) (pos5 : Nat) =>
        okExpr (EAscribe e ty) toks5 pos5)))
        | False =>
        bindParseResult Unit Value (expect_rparen toks2 pos2)
        (fun (_u : Unit) (toks3 : List Token) (pos3 : Nat) =>
        okExpr e toks3 pos3)
        end
      in bindValue Expr asExpr (parse fuel' MExpr toks pos extra)
      cont8;

def parse_a_keywordatom
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match asNat extra with
    | Nothing => PErr Value pos
    | Just k =>
        match eqNat k kwOpen with
        | True =>
            bindParseResult Nat Value (expect_ident toks pos)
              (fun (alias : Nat) (after_alias : List Token) (alias_pos : Nat) =>
                bindParseResult Unit Value
                  (expect_keyword kwIn after_alias alias_pos)
                  (fun (_ : Unit) (after_in : List Token) (in_pos : Nat) =>
                    bindValue Expr asExpr (parse fuel' MExpr after_in in_pos extra)
                      (fun (body : Expr) (tail : List Token) (end_pos : Nat) =>
                        okExpr (EOpen alias body) tail end_pos)))
        | False => match eqNat k kwFun with
        | True => parse fuel' MFun toks pos extra
        | False =>
            match eqNat k kwLet with
            | True => parse fuel' MLet toks pos extra
            | False =>
                match eqNat k kwMatch with
                | True => parse fuel' MMatch toks pos extra
                | False =>
                    match eqNat k kwFix with
                    | True => parse fuel' MFix toks pos extra
                    | False =>
                        match eqNat k kwPerform with
                        | True => parse fuel' MPerform toks pos extra
                        | False =>
                            match eqNat k kwDo with
                            | True => parse fuel' MDo toks pos extra
                            | False =>
                                match eqNat k kwHandle with
                                | True => parse fuel' MHandle toks pos extra
                                | False => PErr Value pos
                                end
                            end
                        end
                    end
                end
            end
        end
        end
    end;

def parse_a_typedbinder
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    bindValue (List (Pair Nat Expr)) asListPairNatExpr (parse fuel' MTypedBinderGroup toks pos extra)
      (fun (bs : List (Pair Nat Expr)) (toks2 : List Token) (pos2 : Nat) =>
        match bs with
        | Nil => PErr Value pos2
        | Cons b rest =>
            match rest with
            | Nil => okPairNatExpr b toks2 pos2
            | Cons _ _ => PErr Value pos2
            end
        end);

def parse_a_typedbindergroup
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    bindParseResult Unit Value (expect_lparen toks pos)
      (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
        bindParseResult (List Nat) Value (parse_binder_names fuel' toks2 pos2)
          (fun (names : List Nat) (toks3 : List Token) (pos3 : Nat) =>
            bindParseResult Unit Value (expect_colon toks3 pos3)
              (fun (_u2 : Unit) (toks4 : List Token) (pos4 : Nat) =>
                bindValue Expr asExpr (parse fuel' MExpr toks4 pos4 extra)
                  (fun (ty : Expr) (toks5 : List Token) (pos5 : Nat) =>
                    bindParseResult Unit Value (expect_rparen toks5 pos5)
                      (fun (_u3 : Unit) (toks6 : List Token) (pos6 : Nat) =>
                        okListPairNatExpr (mk_typed_binder_pairs names ty) toks6 pos6)))));

def parse_a_typedbinders
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match is_binder_ahead toks with
    | True =>
        bindValue (List (Pair Nat Expr)) asListPairNatExpr (parse fuel' MTypedBinderGroup toks pos extra)
          (fun (group : List (Pair Nat Expr)) (toks2 : List Token) (pos2 : Nat) =>
            bindValue (List (Pair Nat Expr)) asListPairNatExpr (parse fuel' MTypedBinders toks2 pos2 extra)
              (fun (bs : List (Pair Nat Expr)) (toks3 : List Token) (pos3 : Nat) =>
                okListPairNatExpr (append (Pair Nat Expr) group bs) toks3 pos3))
    | False => okListPairNatExpr (Nil (Pair Nat Expr)) toks pos
    end;

def parse_a_funbinders
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match is_binder_ahead toks with
    | True =>
        let cont2 (group : List (Pair Nat Expr)) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
            bindValue (List (Pair(Nat, Maybe Expr))) asListPairNatMaybeExpr (parse fuel' MFunBinders toks2 pos2 extra)
            (fun (bs : List (Pair Nat (Maybe Expr))) (toks3 : List Token) (pos3 : Nat) =>
            okListPairNatMaybeExpr (append(Pair(Nat, Maybe Expr), mk_typed_maybe_binders group, bs)) toks3 pos3)
          in bindValue (List (Pair Nat Expr)) asListPairNatExpr (parse fuel' MTypedBinderGroup toks pos extra)
          cont2
    | False =>
        match tokenIsIdent (peek toks) with
        | Just _ni =>
            bindParseResult Nat Value (expect_ident toks pos)
              (fun (n : Nat) (toks2 : List Token) (pos2 : Nat) =>
                bindValue (List (Pair(Nat, Maybe Expr))) asListPairNatMaybeExpr (parse fuel' MFunBinders toks2 pos2 extra)
                  (fun (bs : List (Pair Nat (Maybe Expr))) (toks3 : List Token) (pos3 : Nat) =>
                    okListPairNatMaybeExpr (Cons(Pair(Nat, Maybe Expr), MkPair(Nat, Maybe Expr, n, Nothing Expr), bs)) toks3 pos3))
        | Nothing => okListPairNatMaybeExpr (Nil (Pair(Nat, Maybe Expr))) toks pos
        end
    end;

def parse_a_effectannotation
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match asExpr extra with
    | Nothing => PErr Value pos
    | Just ty =>
        match is_exclam (peek toks) with
        | False => okExpr ty toks pos
        | True =>
            bindParseResult Unit Value (expect_tag tagExclam toks pos)
              (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
                bindParseResult Unit Value (expect_brace_l toks2 pos2)
                  (fun (_u2 : Unit) (toks3 : List Token) (pos3 : Nat) =>
                    bindValue (List Nat) asListNat (parse fuel' MEffectRow toks3 pos3 extra)
                      (fun (row : List Nat) (toks4 : List Token) (pos4 : Nat) =>
                        bindParseResult Unit Value (expect_brace_r toks4 pos4)
                          (fun (_u3 : Unit) (toks5 : List Token) (pos5 : Nat) =>
                            okExpr (EEffectRow ty row) toks5 pos5))))
        end
    end;

def parse_a_effectrow
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    let cont9 (n : Nat) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
        match is_comma (peek toks2) with
        | True =>
        match toks2 with
        | Cons _ rest =>
        bindValue (List Nat) asListNat (parse fuel' MEffectRow rest (S pos2) extra)
        (fun (ns : List Nat) (toks3 : List Token) (pos3 : Nat) =>
        okListNat (Cons Nat n ns) toks3 pos3)
        | Nil => PErr Value pos2
        end
        | False =>
        match is_brace_r (peek toks2) with
        | True =>
        bindParseResult Unit Value (expect_brace_r toks2 pos2)
        (fun (_u : Unit) (toks3 : List Token) (pos3 : Nat) =>
        okListNat (list1_nat n) toks3 pos3)
        | False => PErr Value pos2
        end
        end
      in bindParseResult Nat Value (expect_ident toks pos)
      cont9;

def parse_a_commalist
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    -- Empty argument list (e.g. perform Ask()) is allowed; fail-closed
    -- only when a token starts an expression but cannot form one.
    match is_comma_list_start (peek toks) with
    | False => okListExpr (Nil Expr) toks pos
    | True =>
        let cont6 (e : Expr) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
            match is_comma (peek toks2) with
            | True =>
            match toks2 with
            | Cons _ rest =>
            bindValue (List Expr) asListExpr (parse fuel' MCommaList rest (S pos2) extra)
            (fun (es : List Expr) (toks3 : List Token) (pos3 : Nat) =>
            okListExpr (Cons Expr e es) toks3 pos3)
            | Nil => PErr Value pos2
            end
            | False => okListExpr (list1_expr e) toks2 pos2
            end
          in bindValue Expr asExpr (parse fuel' MExpr toks pos extra)
          cont6
    end;

def parse_a_spread_close
  (elems : List Expr) (tail : Expr) (toks : List Token) (pos : Nat)
    : ParseResult Value :=
  match is_comma (peek toks) with
  | True =>
      match toks with
      | Nil => PErr Value pos
      | Cons _ rest =>
          bindParseResult Unit Value (expect_bracket_r rest (S pos))
            (fun (_u : Unit) (after : List Token) (past : Nat) =>
              okExpr (EListSpread elems tail) after past)
      end
  | False =>
      bindParseResult Unit Value (expect_bracket_r toks pos)
        (fun (_u : Unit) (after : List Token) (past : Nat) =>
          okExpr (EListSpread elems tail) after past)
  end;

def parse_a_spread
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (elems : List Expr) (toks : List Token)
  (pos : Nat) (extra : Value) : ParseResult Value :=
  match toks with
  | Nil => PErr Value pos
  | Cons _ rest =>
      bindValue Expr asExpr (parse fuel' MExpr rest (S pos) extra)
        (fun (tail : Expr) (after : List Token) (past : Nat) =>
          parse_a_spread_close elems tail after past)
  end;

def parse_a_listelems
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match is_bracket_r (peek toks) with
    | True =>
        bindParseResult Unit Value (expect_bracket_r toks pos)
          (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
            okExpr (EList (Nil Expr)) toks2 pos2)
    | False =>
        match is_dot_dot (peek toks) with
        | True => parse_a_spread parse fuel' (Nil Expr) toks pos extra
        | False =>
            bindValue Expr asExpr (parse fuel' MExpr toks pos extra)
              (fun (first : Expr) (toks2 : List Token) (pos2 : Nat) =>
                parse fuel' MListTail toks2 pos2 (VListExpr (list1_expr first)))
        end
    end;

def parse_a_listtail
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match asListExpr extra with
    | Nothing => PErr Value pos
    | Just elems =>
        match is_comma (peek toks) with
        | True =>
            match toks with
            | Nil => PErr Value pos
            | Cons _ rest =>
                match is_bracket_r (peek rest) with
                | True =>
                    bindParseResult Unit Value (expect_bracket_r rest (S pos))
                      (fun (_u : Unit) (tail : List Token) (position : Nat) =>
                        okExpr (EList elems) tail position)
                | False =>
                    match is_dot_dot (peek rest) with
                    | True => parse_a_spread parse fuel' elems rest (S pos) extra
                    | False =>
                        bindValue Expr asExpr (parse fuel' MExpr rest (S pos) extra)
                          (fun (next : Expr) (toks2 : List Token) (pos2 : Nat) =>
                            parse fuel' MListTail toks2 pos2 (VListExpr (append Expr elems (list1_expr next))))
                    end
                end
            end
        | False =>
            bindParseResult Unit Value (expect_bracket_r toks pos)
              (fun (_u : Unit) (toks2 : List Token) (pos2 : Nat) =>
                okExpr (EList elems) toks2 pos2)
        end
    end;

def parse_a_identcommalist
  (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
  (fuel' : Nat) (toks : List Token) (pos : Nat) (extra : Value) : ParseResult Value :=
    match tokenIsBinderName (peek toks) with
    | Nothing => okListNat (Nil Nat) toks pos
    | Just _ =>
        let cont3 (n : Nat) (toks2 : List Token) (pos2 : Nat) : ParseResult Value :=
            match is_comma (peek toks2) with
            | True =>
            match toks2 with
            | Cons _ rest =>
            bindValue (List Nat) asListNat (parse fuel' MIdentCommaList rest (S pos2) extra)
            (fun (ns : List Nat) (toks3 : List Token) (pos3 : Nat) =>
            okListNat (Cons Nat n ns) toks3 pos3)
            | Nil => PErr Value pos2
            end
            | False => okListNat (list1_nat n) toks2 pos2
            end
          in bindParseResult Nat Value (expect_binder_name toks pos)
          cont3
    end;

def parse_a (parse : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value :=
  fun (fuel : Nat) (mode : Mode) (toks : List Token) (pos : Nat) (extra : Value) =>
    match fuel with
    | Z => PErr Value pos
    | S fuel' =>
        match mode with
        | MExpr => parse fuel' MPipe toks pos extra
        | MPipe =>
            bindValue Expr asExpr (parse fuel' MPi toks pos extra)
              (fun (lhs : Expr) (toks2 : List Token) (pos2 : Nat) =>
                parse fuel' MPipeTail toks2 pos2 (VExpr lhs))
        | MPipeTail => parse_a_pipetail parse fuel' toks pos extra
        | MPi => parse_a_pi parse fuel' toks pos extra
        | MPiFromApp => parse_a_pifromapp parse fuel' toks pos extra
        | MApp =>
            bindValue Expr asExpr (parse fuel' MAtom toks pos extra)
              (fun (head : Expr) (toks2 : List Token) (pos2 : Nat) =>
                parse fuel' MAppTail toks2 pos2 (VExpr head))
        | MAppTail => parse_a_apptail parse fuel' toks pos extra
        | MAtom => parse_a_atom parse fuel' toks pos extra
        | MParen => parse_a_paren parse fuel' toks pos extra
        | MKeywordAtom => parse_a_keywordatom parse fuel' toks pos extra
        | MFun => parse fuel mode toks pos extra
        | MLet => parse fuel mode toks pos extra
        | MMatch => parse fuel mode toks pos extra
        | MFix => parse fuel mode toks pos extra
        | MTypedBinder => parse_a_typedbinder parse fuel' toks pos extra
        | MTypedBinderGroup => parse_a_typedbindergroup parse fuel' toks pos extra
        | MTypedBinders => parse_a_typedbinders parse fuel' toks pos extra
        | MFunBinders => parse_a_funbinders parse fuel' toks pos extra
        | MPattern => parse fuel mode toks pos extra
        | MPatternVars => parse fuel mode toks pos extra
        | MPatterns => parse fuel mode toks pos extra
        | MMultiBranches => parse fuel mode toks pos extra
        | MScrutList => parse fuel mode toks pos extra
        | MEffectAnnotation => parse_a_effectannotation parse fuel' toks pos extra
        | MEffectRow => parse_a_effectrow parse fuel' toks pos extra
        | MCommaList => parse_a_commalist parse fuel' toks pos extra
        | MListElems => parse_a_listelems parse fuel' toks pos extra
        | MListTail => parse_a_listtail parse fuel' toks pos extra
        | MIdentCommaList => parse_a_identcommalist parse fuel' toks pos extra
        | MDoStmt => parse fuel mode toks pos extra
        | MDoExprs => parse fuel mode toks pos extra
        | MPerform => parse fuel mode toks pos extra
        | MDo => parse fuel mode toks pos extra
        | MHandle => parse fuel mode toks pos extra
        | MHandleClauses => parse fuel mode toks pos extra
        end
    end;
