-- Shared annotation normalization for packed frontend surfaces.

import "core.ouro";

def peel_dummy (s : Surface) : Surface :=
  match s with
  | SVar n =>
      match eqNat n Z with
      | True => SInd Z
      | False => SVar n
      end
  | SSort n => SSort n
  | SPi n a b => SPi n a b
  | SLam n a b => SLam n a b
  | SApp f a => SApp f a
  | SLet n v t b => SLet n v t b
  | SConst n => SConst n
  | SInd n => SInd n
  | SConstruct a b c => SConstruct a b c
  | SCase ci p sc bs => SCase ci p sc bs
  | SFix n r ar t b => SFix n r ar t b
  | SHole n => SHole n
  | SEffectRow t => SEffectRow t
  | SPerform n xs => SPerform n xs
  | SStr a b => SStr a b
  end;

def rewrite_dummy_anns : Surface -> Surface :=
  fix go (s : Surface) : Surface :=
    match s with
    | SVar n => SVar n
    | SSort n => SSort n
    | SPi n ann body => SPi(n, peel_dummy (go ann), go body)
    | SLam n ann body => SLam(n, peel_dummy (go ann), go body)
    | SApp f a => SApp(go f, go a)
    | SLet n v ty body => SLet(n, go v, peel_dummy (go ty), go body)
    | SConst n => SConst n
    | SInd n => SInd n
    | SConstruct a b c => SConstruct a b c
    | SCase ci p sc bs =>
        SCase ci (go p) (go sc)
          ((fix go_list (ys : List Surface) : List Surface :=
              match ys with
              | Nil => Nil Surface
              | Cons x ys' => Cons(Surface, go x, go_list ys')
              end) bs)
    | SFix n r ar ty body => SFix n r ar (peel_dummy (go ty)) (go body)
    | SHole n => SHole n
    | SEffectRow t => SEffectRow (go t)
    | SPerform n xs =>
        SPerform n
          ((fix go_list (ys : List Surface) : List Surface :=
              match ys with
              | Nil => Nil Surface
              | Cons x ys' => Cons(Surface, go x, go_list ys')
              end) xs)
    | SStr a b => SStr a b
    end;
