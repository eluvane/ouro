-- Shared helpers live here to keep split frontend cones from drifting into duplicate definitions.

import "../std/data.ouro";

-- Shared optional, so stages that used to declare their own Option can sit in
-- one translation unit without colliding on the constructor names.
-- @entry fuel1k ten
inductive Option (A : Type) : Type :=
  | None : Option A
  | Some : A -> Option A;

def eqNat : Nat -> Nat -> Bool :=
  fix eqNat (n : Nat) (m : Nat) : Bool :=
    match n with
    | Z => match m with | Z => True | S _ => False end
    | S n' => match m with | Z => False | S m' => eqNat n' m' end
    end;

def memNat (x : Nat) : List Nat -> Bool :=
    elem Nat eqNat x;

def ten : Nat := 10;

def fuel1k : Nat := mul ten (mul ten ten);

def compiler_le_nat (n : Nat) (m : Nat) : Bool :=
    match compareNat n m with
    | GT => False
    | LT => True
    | EQ => True
    end;

def compiler_lt_nat (n : Nat) (m : Nat) : Bool :=
    match compareNat n m with
    | LT => True
    | EQ => False
    | GT => False
    end;

def compiler_bool_equal (left : Bool) (right : Bool) : Bool :=
    match left with
    | True => right
    | False => notb right
    end;

def compiler_nth (A : Type) : List A -> Nat -> Maybe A :=
    fix compiler_nth (xs : List A) (i : Nat) : Maybe A :=
      match xs with
      | Nil => Nothing A
      | Cons x xs' =>
          match i with
          | Z => Just A x
          | S i' => compiler_nth xs' i'
          end
      end;

def compiler_nth_nat : Nat -> List Nat -> Nat :=
  fix compiler_nth_nat (i : Nat) (xs : List Nat) : Nat :=
    match xs with
    | Nil => Z
    | Cons x rest =>
        match i with
        | Z => x
        | S i' => compiler_nth_nat i' rest
        end
    end;
