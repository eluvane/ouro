-- A unit-local index is derived from the shared lists and extended with them.
-- It never changes InternState's constructor, field order, or assigned IDs.

import "pipeline_abi.ouro",
  "source_name_index.ouro";

inductive LexerIntern : Type :=
  | LexerInternOf : InternState -> SourceNameIndex -> SourceNameIndex -> LexerIntern;

def lexer_intern_state (indexed : LexerIntern) : InternState :=
  match indexed with | LexerInternOf state _ _ => state end;

def lexer_intern_from (state : InternState) : LexerIntern :=
  match state with | MkIntern ids _ strings _ =>
    LexerInternOf state (source_name_index_from ids) (source_name_index_from strings)
  end;

def lexer_intern_ident (indexed : LexerIntern) (name : List Nat) : Pair Nat LexerIntern :=
  match indexed with | LexerInternOf state identifiers strings =>
    match source_name_index_lookup name identifiers with
    | Just id => MkPair Nat LexerIntern id indexed
    | Nothing => match state with | MkIntern ids next_id texts next_string =>
        MkPair Nat LexerIntern next_id
          (LexerInternOf
            (MkIntern (Cons (Pair (List Nat) Nat) (MkPair (List Nat) Nat name next_id) ids)
              (add next_id 1) texts next_string)
            (source_name_index_insert name next_id identifiers) strings)
      end
    end
  end;

def lexer_intern_string (indexed : LexerIntern) (text : List Nat) : Pair Nat LexerIntern :=
  match indexed with | LexerInternOf state identifiers strings =>
    match source_name_index_lookup text strings with
    | Just id => MkPair Nat LexerIntern id indexed
    | Nothing => match state with | MkIntern ids next_id texts next_string =>
        MkPair Nat LexerIntern next_string
          (LexerInternOf
            (MkIntern ids next_id
              (Cons (Pair (List Nat) Nat) (MkPair (List Nat) Nat text next_string) texts)
              (add next_string 1))
            identifiers (source_name_index_insert text next_string strings))
      end
    end
  end;
