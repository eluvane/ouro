-- Expression substitution for handler rewriting.
-- Kept off lower_rewrite.ouro so both modules stay under the size cap.

import "lower_env.ouro";

def subst_expr : Nat -> Nat -> Expr -> Expr -> Expr :=
  fix subst_expr (fuel : Nat) (name : Nat) (replacement : Expr) (e : Expr) : Expr :=
    match fuel with
    | Z => e
    | S fuel' =>
        match e with
        | EVar n =>
            match eqNat n name with
            | True => replacement
            | False => EVar n
            end
        | EHole h => EHole h
        | ESort u => ESort u
        | ENat n => ENat n
        | EStr s => EStr s
        | EApp f a =>
            EApp (subst_expr fuel' name replacement f)
              (subst_expr fuel' name replacement a)
        | ELam n ann body =>
            ELam n
              (match ann with
              | Nothing => Nothing Expr
              | Just ty => Just Expr (subst_expr fuel' name replacement ty)
              end : Maybe Expr)
              (match eqNat n name with
              | True => body
              | False => subst_expr fuel' name replacement body
              end)
        | EPi n dom cod =>
            EPi n (subst_expr fuel' name replacement dom)
              (match eqNat n name with
              | True => cod
              | False => subst_expr fuel' name replacement cod
              end)
        | ELet n ann value body =>
            ELet n
              (match ann with
              | Nothing => Nothing Expr
              | Just ty => Just Expr (subst_expr fuel' name replacement ty)
              end : Maybe Expr)
              (subst_expr fuel' name replacement value)
              (match eqNat n name with
              | True => body
              | False => subst_expr fuel' name replacement body
              end)
        | EAscribe e0 ty =>
            EAscribe (subst_expr fuel' name replacement e0)
              (subst_expr fuel' name replacement ty)
        | EMatch scrut branches =>
            EMatch (subst_expr fuel' name replacement scrut) branches
        | EFix fn binders ret body =>
            EFix fn (subst_expr fuel' name replacement binders)
              (match eqNat fn name with
              | True => ret
              | False => subst_expr fuel' name replacement ret
              end)
              (match eqNat fn name with
              | True => body
              | False => subst_expr fuel' name replacement body
              end)
        | EEffectRow ty ops =>
            EEffectRow (subst_expr fuel' name replacement ty) ops
        | EPerform op args =>
            EPerform op
              ((fix go (xs : List Expr) : List Expr :=
                match xs with
                | Nil => Nil Expr
                | Cons x xs' =>
                    Cons Expr (subst_expr fuel' name replacement x) (go xs')
                end) args)
        | EDo es =>
            EDo
              ((fix go (xs : List Expr) : List Expr :=
                match xs with
                | Nil => Nil Expr
                | Cons x xs' =>
                    Cons Expr (subst_expr fuel' name replacement x) (go xs')
                end) es)
        | EDoBind n action =>
            EDoBind n (subst_expr fuel' name replacement action)
        | EList elems =>
            EList
              ((fix go (xs : List Expr) : List Expr :=
                match xs with
                | Nil => Nil Expr
                | Cons x xs' =>
                    Cons Expr (subst_expr fuel' name replacement x) (go xs')
                end) elems)
        | EHandle comp clauses =>
            EHandle (subst_expr fuel' name replacement comp)
              ((fix go (cs : List (Pair Nat (Pair (List Nat) Expr)))
                  : List (Pair Nat (Pair (List Nat) Expr)) :=
                match cs with
                | Nil => Nil (Pair Nat (Pair (List Nat) Expr))
                | Cons c cs' =>
                    match c with
                    | MkPair op payload =>
                        match payload with
                        | MkPair binders body =>
                            let shadowed : Bool :=
                              (fix has (xs : List Nat) : Bool :=
                                match xs with
                                | Nil => False
                                | Cons x xs' => orb (eqNat x name) (has xs')
                                end) binders in
                            Cons (Pair Nat (Pair (List Nat) Expr))
                              (MkPair Nat (Pair (List Nat) Expr) op
                                (MkPair (List Nat) Expr binders
                                  (match shadowed with
                                  | True => body
                                  | False => subst_expr fuel' name replacement body
                                  end)))
                              (go cs')
                        end
                    end
                end) clauses)
        | EBranch packed body rest =>
            EBranch packed (subst_expr fuel' name replacement body)
              (subst_expr fuel' name replacement rest)
        | ENoBranch => ENoBranch
        | EBinder n ty rest =>
            EBinder n (subst_expr fuel' name replacement ty)
              (match eqNat n name with
              | True => rest
              | False => subst_expr fuel' name replacement rest
              end)
        | ENoBinder => ENoBinder
        | EMultiMatch scruts rows => EMultiMatch scruts rows
        end
    end;

def subst_expr_list (fuel : Nat) (name : Nat) (replacement : Expr)
    : List Expr -> List Expr :=
  fix subst_expr_list (xs : List Expr) : List Expr :=
    match xs with
    | Nil => Nil Expr
    | Cons x xs' =>
        Cons Expr (subst_expr fuel name replacement x)
          (subst_expr_list xs')
    end;

def same_nat_expr_length (xs : List Nat) (ys : List Expr) : Bool :=
    eqNat (length Nat xs) (length Expr ys);

def subst_handler_args (fuel : Nat) (names : List Nat) (args : List Expr)
    (body : Expr) : Expr :=
  (fix go (ns : List Nat) (as : List Expr) (b : Expr) : Expr :=
    match ns, as with
    | Nil, Nil => b
    | Cons n ns', Cons a as' =>
        go ns' as' (subst_expr fuel n a b)
    | Nil, Cons _ _ => b
    | Cons _ _, Nil => b
    end) names args body;
