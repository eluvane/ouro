-- Record sugar expands before lexing into ordinary inductive/accessor source accepted by the existing frontend.

import "source_text.ouro",
  "../std/data.ouro",
  "base.ouro",
  "pipeline_abi.ouro";

inductive RecEnv : Type :=
  | MkRecEnv : List RecBind -> RecEnv;

inductive RecParse : Type :=
  | RecPErr : Nat -> RecParse
  | RecPOk : RecInfo -> List Nat -> List Nat -> RecParse;

inductive RewriteR : Type :=
  | RwErr : Nat -> RewriteR
  | RwOk : List Nat -> List Nat -> RewriteR;

inductive DefHead : Type :=
  | NoHead : DefHead
  | MkHead : List Nat -> RecEnv -> Maybe Nat -> List Nat -> List Nat -> DefHead;

-- @export empty_rec_reg; @doc docs/syntax.md
def empty_rec_reg : RecReg :=
  MkRecReg(Z, Nil RecInfo, Nil (List Nat), Nil RecBind);

-- Keep the next helper outside the public-export window of empty_rec_reg.


def empty_rec_env : RecEnv := MkRecEnv (Nil RecBind);

def rec_code_malformed : Nat := S Z;
def rec_code_dup : Nat := 2;
def rec_code_need_ty : Nat := 3;
def rec_code_missing : Nat := 4;
def rec_code_unknown : Nat := 5;
def rec_code_collide : Nat := 6;
def rec_code_proj : Nat := 7;

def ch_lf_p : Nat := source_ch_lf;
def ch_space_p : Nat := source_ch_space;
def ch_dq_p : Nat := source_ch_double_quote;
def ch_lparen_p : Nat := 40;
def ch_rparen_p : Nat := 41;
def ch_comma_p : Nat := 44;
def ch_dot_p : Nat := 46;
def ch_colon_p : Nat := 58;
def ch_semi_p : Nat := 59;
def ch_eq_p : Nat := 61;
def ch_lbrace_p : Nat := 123;
def ch_rbrace_p : Nat := 125;
def ch_lbrack_p : Nat := 91;
def ch_rbrack_p : Nat := 93;

def n1p (a : Nat) : List Nat := ([a] : List Nat);
def list1_recinfo (ri : RecInfo) : List RecInfo := ([ri] : List RecInfo);
def n2p (a : Nat) (b : Nat) : List Nat := Cons Nat a (n1p b);
def n3p (a : Nat) (b : Nat) (c : Nat) : List Nat := Cons Nat a (n2p b c);
def n4p (a : Nat) (b : Nat) (c : Nat) (d : Nat) : List Nat := Cons Nat a (n3p b c d);
def n5p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) : List Nat :=
  Cons Nat a (n4p b c d e);
def n6p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) : List Nat :=
  Cons Nat a (n5p b c d e f);
def n7p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) (g : Nat)
    : List Nat := Cons Nat a (n6p b c d e f g);
def n9p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) (g : Nat)
    (h : Nat) (i : Nat) : List Nat := Cons Nat a (Cons Nat b (n7p c d e f g h i));

def word_at (w : List Nat) (src : List Nat) : Bool := source_word_at w src;

def w_record : List Nat := n6p 114 101 99 111 114 100;
def w_where : List Nat := n5p 119 104 101 114 101;
def w_end : List Nat := n3p 101 110 100;
def w_constructor : List Nat :=
  Cons Nat 99 (Cons Nat 111 (n9p 110 115 116 114 117 99 116 111 114));
def w_def : List Nat := n3p 100 101 102;
def w_let_p : List Nat := n3p 108 101 116;
def w_axiom : List Nat := n5p 97 120 105 111 109;
def w_inductive : List Nat := n9p 105 110 100 117 99 116 105 118 101;
def w_effect : List Nat := n6p 101 102 102 101 99 116;
def w_intrinsic_p : List Nat := n9p 105 110 116 114 105 110 115 105 99;
def w_extern_p : List Nat := n6p 101 120 116 101 114 110;
def w_with : List Nat := n4p 119 105 116 104;
def w_Mk : List Nat := n2p 77 107;
def s_uscore : List Nat := n1p 95;
def s_inductive : List Nat :=
  Cons Nat 105 (n9p 110 100 117 99 116 105 118 101 32);
def s_colonsp : List Nat := n3p 32 58 32;
def s_arrow : List Nat := n4p 32 45 62 32;
def s_semi_nl : List Nat := n2p 59 10;
def s_defsp : List Nat := n4p 100 101 102 32;
def s_lp_p_colon : List Nat := n6p 32 40 112 32 58 32;
def s_rp_colon : List Nat := n4p 41 32 58 32;
def s_coloneqbar : List Nat := n7p 32 58 61 10 32 32 124;
def s_sp_bar_sp : List Nat := n2p 32 32;
def s_matchp : List Nat :=
  Cons Nat 32 (Cons Nat 58 (Cons Nat 61 (Cons Nat 32
    (n6p 109 97 116 99 104 32))));
def s_with_bar : List Nat := n7p 112 32 119 105 116 104 32;
def s_bar_sp : List Nat := n2p 124 32;
def s_arrow_end : List Nat := n4p 32 61 62 32;
def s_end_semi : List Nat := n6p 32 101 110 100 59 10;

def skip_ws_p (src : List Nat) : List Nat := source_skip_ws src;

def field_named (n : List Nat) : List RecField -> Bool :=
  fix field_named (fs : List RecField) : Bool :=
    match fs with
    | Nil => False
    | Cons f rest =>
        match f with
        | MkRecField fn _ => orb(source_bytes_equal n fn, field_named rest)
        end
    end;

def find_rec_idx (n : List Nat) (xs : List RecInfo) : Maybe Nat :=
  (fix go (rest : List RecInfo) (index : Nat) : Maybe Nat :=
    match rest with
    | Nil => Nothing Nat
    | Cons r tail =>
      match r with
      | MkRecInfo _ rn _ _ =>
        match source_bytes_equal n rn with
        | True => Just Nat index
        | False => go(tail, S index)
        end
      end
    end) xs Z;

def nth_rec : List RecInfo -> Nat -> Maybe RecInfo :=
  fix nth_rec (xs : List RecInfo) (i : Nat) : Maybe RecInfo :=
    match xs with
    | Nil => Nothing RecInfo
    | Cons r rest =>
        match i with
        | Z => Just RecInfo r
        | S i' => nth_rec rest i'
        end
    end;

def find_field_idx (n : List Nat) (fields : List RecField) : Maybe Nat :=
  (fix go (rest : List RecField) (index : Nat) : Maybe Nat :=
    match rest with
    | Nil => Nothing Nat
    | Cons f tail =>
      match f with
      | MkRecField fn _ =>
        match source_bytes_equal n fn with
        | True => Just Nat index
        | False => go(tail, S index)
        end
      end
    end) fields Z;

def env_lookup (env : RecEnv) (reg : RecReg) (n : List Nat) : Maybe Nat :=
  match env with
  | MkRecEnv bs =>
      (fix go (xs : List RecBind) : Maybe Nat :=
        match xs with
        | Nil =>
            match reg with
            | MkRecReg _ _ _ gs =>
                (fix go2 (ys : List RecBind) : Maybe Nat :=
                  match ys with
                  | Nil => Nothing Nat
                  | Cons b rest =>
                      match b with
                      | MkRecBind bn bi =>
                          match source_bytes_equal n bn with
                          | True => Just Nat bi
                          | False => go2 rest
                          end
                      end
                  end) gs
            end
        | Cons b rest =>
            match b with
            | MkRecBind bn bi =>
                match source_bytes_equal n bn with
                | True => Just Nat bi
                | False => go rest
                end
            end
        end) bs
  end;

def env_add (env : RecEnv) (n : List Nat) (i : Nat) : RecEnv :=
  match env with
  | MkRecEnv bs => MkRecEnv (Cons RecBind (MkRecBind n i) bs)
  end;

def trim_bytes (xs : List Nat) : List Nat :=
  let drop_l : List Nat :=
    (fix go (ys : List Nat) : List Nat :=
      match ys with
      | Nil => Nil Nat
      | Cons c rest =>
          match source_is_ws c with
          | True => go rest
          | False => ys
          end
      end) xs in
  reverse Nat
    ((fix go (ys : List Nat) : List Nat :=
      match ys with
      | Nil => Nil Nat
      | Cons c rest =>
          match source_is_ws c with
          | True => go rest
          | False => ys
          end
      end) (reverse Nat drop_l));

def type_to_rec (reg : RecReg) (ty : List Nat) : Maybe Nat :=
  match reg with
  | MkRecReg _ recs _ _ => find_rec_idx(trim_bytes ty, recs)
  end;

def bump_depth (c : Nat) (depth : Nat) : Nat :=
  match orb (eqNat c ch_lparen_p)
        (orb(eqNat c ch_lbrace_p, eqNat c ch_lbrack_p)) with
  | True => S depth
  | False =>
      match orb (eqNat c ch_rparen_p)
            (orb(eqNat c ch_rbrace_p, eqNat c ch_rbrack_p)) with
      | True =>
          match depth with
          | Z => Z
          | S d' => d'
          end
      | False => depth
      end
  end;

def take_until_word (w : List Nat) (xs0 : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S fuel2 =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match andb(eqNat depth Z, word_at w xs) with
            | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
            | False =>
                match source_copy_comment_or_string acc xs with
                | Just copied =>
                    match copied with
                    | MkPair acc2 tail => go fuel2 tail acc2 depth
                    end
                | Nothing => go(fuel2, rest, Cons Nat c acc, bump_depth c depth)
                end
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z;

def take_until_char (stop : Nat) (xs0 : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S fuel2 =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match andb(eqNat depth Z, eqNat c stop) with
            | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
            | False =>
                match source_copy_comment_or_string acc xs with
                | Just copied =>
                    match copied with
                    | MkPair acc2 tail => go fuel2 tail acc2 depth
                    end
                | Nothing => go(fuel2, rest, Cons Nat c acc, bump_depth c depth)
                end
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z;

def take_until_coloneq (xs0 : List Nat) : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S fuel2 =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match rest with
            | Cons c2 _rest2 =>
                match andb (eqNat depth Z)
                      (andb(eqNat c ch_colon_p, eqNat c2 ch_eq_p)) with
                | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
                | False =>
                    match source_copy_comment_or_string acc xs with
                    | Just copied =>
                        match copied with
                        | MkPair acc2 tail => go fuel2 tail acc2 depth
                        end
                    | Nothing => go(fuel2, rest, Cons Nat c acc, bump_depth c depth)
                    end
                end
            | Nil => MkPair (List Nat) (List Nat)
                       (reverse(Nat, Cons Nat c acc)) (Nil Nat)
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z;

def matching_brace (xs0 : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Maybe (Pair (List Nat) (List Nat)) :=
    match fuel with
    | Z => Nothing (Pair(List Nat, List Nat))
    | S fuel2 =>
        match xs with
        | Nil => Nothing (Pair(List Nat, List Nat))
        | Cons c rest =>
            match eqNat c ch_lbrace_p with
            | True => go(fuel2, rest, Cons Nat c acc, S depth)
            | False =>
                match eqNat c ch_rbrace_p with
                | True =>
                    match depth with
                    | Z => Nothing (Pair(List Nat, List Nat))
                    | S d' =>
                        match d' with
                        | Z =>
                            Just (Pair(List Nat, List Nat))
                              (MkPair (List Nat) (List Nat)
                                (reverse(Nat, Cons Nat c acc)) rest)
                        | S _ => go fuel2 rest (Cons Nat c acc) d'
                        end
                    end
                | False =>
                    match source_copy_comment_or_string acc xs with
                    | Just copied =>
                        match copied with
                        | MkPair acc2 tail => go fuel2 tail acc2 depth
                        end
                    | Nothing => go fuel2 rest (Cons Nat c acc) depth
                    end
                end
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z;

def strip_braces (body : List Nat) : List Nat :=
  match body with
  | Cons _ restb =>
      reverse Nat
        (match reverse Nat restb with
         | Cons _ mid => mid
         | Nil => Nil Nat
         end)
  | Nil => Nil Nat
  end;

def top_has_assign (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) (depth : Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match rest with
            | Cons c2 _ =>
                match andb (eqNat depth Z)
                      (andb(eqNat c ch_colon_p, eqNat c2 ch_eq_p)) with
                | True => True
                | False =>
                    match source_is_comment xs with
                    | True => go fuel2 (source_skip_line rest) depth
                    | False =>
                        match eqNat c ch_dq_p with
                        | True => go fuel2 (source_skip_string rest) depth
                        | False => go fuel2 rest (bump_depth c depth)
                        end
                    end
                end
            | Nil => False
            end
        end
    end) (length Nat src) src Z;

def top_has_with (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) (depth : Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match andb(eqNat depth Z, word_at w_with xs) with
            | True => True
            | False =>
                match source_is_comment xs with
                | True => go fuel2 (source_skip_line rest) depth
                | False =>
                    match eqNat c ch_dq_p with
                    | True => go fuel2 (source_skip_string rest) depth
                    | False => go fuel2 rest (bump_depth c depth)
                    end
                end
            end
        end
    end) (length Nat src) src Z;

def rec_reg_has_recs (reg : RecReg) : Bool :=
  match reg with
  | MkRecReg _ recs _ _ =>
      match recs with
      | Nil => False
      | Cons _ _ => True
      end
  end;

-- Only the word-bounded `record` keyword activates this prepass; dots and braces are valid existing syntax.
def src_has_record_keyword (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go(fuel2, source_skip_line rest)
            | False =>
                match eqNat c ch_dq_p with
                | True => go(fuel2, source_skip_string rest)
                | False =>
                    match source_is_ident_start c with
                    | True =>
                        match source_take_ident xs with
                        | MkPair id after =>
                            match source_bytes_equal id w_record with
                            | True => True
                            | False => go fuel2 after
                            end
                        end
                    | False => go fuel2 rest
                    end
                end
            end
        end
    end) (length Nat src) src;

-- @export records_maybe_needed; @doc docs/syntax.md
def records_maybe_needed (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go(fuel2, source_skip_line rest)
            | False =>
                match eqNat c ch_dq_p with
                | True => go(fuel2, source_skip_string rest)
                | False =>
                    match source_is_ident_start c with
                    | True =>
                        match source_take_ident xs with
                        | MkPair id after =>
                            match source_bytes_equal id w_record with
                            | True => True
                            | False =>
                                match source_bytes_equal id w_let_p with
                                | False => go fuel2 after
                                | True =>
                                    match skip_ws_p after with
                                    | Cons brace rest =>
                                        match eqNat brace ch_lbrace_p with
                                        | False => go fuel2 after
                                        | True =>
                                            match matching_brace (Cons Nat brace rest) with
                                            | Nothing => go fuel2 after
                                            | Just block =>
                                                match block with
                                                | MkPair body tail =>
                                                    orb(go fuel2 (strip_braces body), go fuel2 tail)
                                                end
                                            end
                                        end
                                    | Nil => go fuel2 after
                                    end
                                end
                            end
                        end
                    | False =>
                        match eqNat c ch_dot_p with
                        | True => True
                        | False =>
                            match eqNat c ch_lbrace_p with
                            | True =>
                                match matching_brace xs with
                                | Nothing => go fuel2 rest
                                | Just p =>
                                    match p with
                                    | MkPair body tail =>
                                        let inner : List Nat := strip_braces body in
                                        match orb (top_has_assign inner)
                                              (top_has_with inner) with
                                        | True => True
                                        | False => go fuel2 tail
                                        end
                                    end
                                end
                            | False => go fuel2 rest
                            end
                        end
                    end
                end
            end
        end
    end) (length Nat src) src;

def collect_decl_names (src : List Nat) : List (List Nat) :=
  reverse (List Nat)
    ((fix go (fuel : Nat) (xs : List Nat) (acc : List (List Nat)) : List (List Nat) :=
      match fuel with
      | Z => acc
      | S fuel2 =>
          match xs with
          | Nil => acc
          | Cons c rest =>
              match source_is_comment xs with
              | True => go fuel2 (source_skip_line rest) acc
              | False =>
                  match eqNat c ch_dq_p with
                  | True => go fuel2 (source_skip_string rest) acc
                  | False =>
                      match source_is_ident_start c with
                      | True =>
                          match source_take_ident xs with
                          | MkPair id after =>
                              match orb (source_bytes_equal id w_def)
                                    (orb (source_bytes_equal id w_axiom)
                                      (orb (source_bytes_equal id w_inductive)
                                        (orb (source_bytes_equal id w_effect)
                                          (orb (source_bytes_equal id w_record)
                                            (orb (source_bytes_equal id w_intrinsic_p)
                                              (source_bytes_equal id w_extern_p)))))) with
                              | True =>
                                  let after2 : List Nat := skip_ws_p after in
                                  match source_take_ident after2 with
                                  | MkPair nm rest3 =>
                                      match nm with
                                      | Nil => go fuel2 after2 acc
                                      | Cons _ _ =>
                                          go fuel2 rest3 (Cons (List Nat) nm acc)
                                      end
                                  end
                              | False => go fuel2 after acc
                              end
                          end
                      | False => go fuel2 rest acc
                      end
                  end
              end
          end
      end) (length Nat src) src (Nil (List Nat)));

def acc_name (recN : List Nat) (fld : List Nat) : List Nat :=
  append Nat recN (append Nat s_uscore fld);

def emit_fields_ty (initial : List Nat) (fields : List RecField) : List Nat :=
  (fix go (fs : List RecField) (acc : List Nat) : List Nat :=
    match fs with
    | Nil => acc
    | Cons f rest =>
        match f with
        | MkRecField _ ty =>
            match rest with
            | Nil => source_emit_reversed acc ty
            | Cons _ _ => go(rest, source_emit_reversed(source_emit_reversed acc ty, s_arrow))
            end
        end
    end) fields initial;

def emit_pat_fields (initial : List Nat) (fields : List RecField) : List Nat :=
  (fix go (fs : List RecField) (acc : List Nat) : List Nat :=
    match fs with
    | Nil => acc
    | Cons f rest =>
        match f with
        | MkRecField n _ =>
            go(rest, source_emit_reversed(Cons Nat ch_space_p acc, n))
        end
    end) fields initial;

def emit_accessors (recN : List Nat) (ctor : List Nat) (allfs : List RecField)
    (initial : List Nat) (fields : List RecField) : List Nat :=
  (fix go (fs : List RecField) (acc : List Nat) : List Nat :=
    match fs with
    | Nil => acc
    | Cons f rest =>
        match f with
        | MkRecField n ty =>
            let a1 : List Nat := source_emit_reversed acc s_defsp in
            let a2 : List Nat := source_emit_reversed(a1, acc_name recN n) in
            let a3 : List Nat := source_emit_reversed a2 s_lp_p_colon in
            let a4 : List Nat := source_emit_reversed a3 recN in
            let a5 : List Nat := source_emit_reversed a4 s_rp_colon in
            let a6 : List Nat := source_emit_reversed a5 ty in
            let a7 : List Nat := source_emit_reversed a6 s_matchp in
            let a8 : List Nat := source_emit_reversed a7 s_with_bar in
            let a9 : List Nat := source_emit_reversed a8 s_bar_sp in
            let a10 : List Nat := source_emit_reversed a9 ctor in
            let a11 : List Nat := emit_pat_fields a10 allfs in
            let a12 : List Nat := source_emit_reversed a11 s_arrow_end in
            let a13 : List Nat := source_emit_reversed a12 n in
            go(rest, source_emit_reversed a13 s_end_semi)
        end
    end) fields initial;

def emit (acc : List Nat) (chunk : List Nat) : List Nat :=
    source_emit_reversed acc chunk;

def emit_record (acc : List Nat) (ri : RecInfo) (sort : List Nat) : List Nat :=
  match ri with
  | MkRecInfo _ name ctor fs =>
      let a1 : List Nat := Cons Nat ch_lf_p acc in
      let a2 : List Nat := source_emit_reversed a1 s_inductive in
      let a3 : List Nat := source_emit_reversed a2 name in
      let a4 : List Nat := source_emit_reversed a3 s_colonsp in
      let a5 : List Nat := source_emit_reversed a4 sort in
      let a6 : List Nat := source_emit_reversed a5 s_coloneqbar in
      let a7 : List Nat := source_emit_reversed(source_emit_reversed a6 s_sp_bar_sp, ctor) in
      let a8 : List Nat := source_emit_reversed a7 s_colonsp in
      let a9 : List Nat :=
        match fs with
        | Nil => source_emit_reversed a8 name
        | Cons _ _ => source_emit_reversed(emit_fields_ty a8 fs, append Nat s_arrow name)
        end in
      emit_accessors name ctor fs (source_emit_reversed a9 s_semi_nl) fs
  end;
