import "preprocess_record_text_base.ouro";

def record_generated_aliases (aliases : ImpReg)
    (reg : RecReg) (bare_atoms : List (List Nat)) (rewritten : List Nat)
    : ImpReg :=
  match reg with
  | MkRecReg _ recs _ _ =>
      (fix go (items : List RecInfo) (index : Nat) (result : ImpReg)
          : ImpReg :=
        match items with
        | Nil => result
        | Cons info rest =>
            let result1 : ImpReg :=
              match record_fresh_alias index bare_atoms aliases with
              | Nothing => result
              | Just alias => match info with
                | MkRecInfo owner _ _ _ => match result with
                  | MkImpReg names bindings rules =>
                      MkImpReg names bindings
                        (append ImpRule
                          (record_grants_for alias owner
                            (record_grant_members info) rewritten) rules)
                  end
                end
              end in
            go rest (S index) result1
        end) recs Z aliases
  end;

def record_owner_qualifier (reg : RecReg) (current : List Nat)
    (aliases : ImpReg) (bare_atoms : List (List Nat))
    (index : Nat) (generated : List Nat) : Maybe (List Nat) :=
  match record_owner_prefix reg current aliases index with
  | Nothing => Nothing (List Nat)
  | Just prefix => match prefix with
    | Cons _ _ => Just (List Nat) prefix
    | Nil => match name_in generated bare_atoms with
      | True => match record_fresh_alias index bare_atoms aliases with
        | Nothing => Nothing (List Nat)
        | Just alias => Just (List Nat) (append Nat alias ([64] : List Nat))
        end
      | False => Just (List Nat) prefix
      end
    end
  end;

def record_generated_name (reg : RecReg) (current : List Nat)
    (aliases : ImpReg) (bare_atoms : List (List Nat))
    (index : Nat) (name : List Nat) : Maybe (List Nat) :=
  match record_owner_qualifier reg current aliases bare_atoms index name with
  | Nothing => Nothing (List Nat)
  | Just prefix => Just (List Nat) (append Nat prefix name)
  end;

def record_owned_type (reg : RecReg) (current : List Nat)
    (aliases : ImpReg) (bare_atoms : List (List Nat))
    (index : Nat) : Maybe (List Nat) :=
  match reg with
  | MkRecReg _ recs _ _ => match nth_rec recs index with
    | Nothing => Nothing (List Nat)
    | Just info => match info with
      | MkRecInfo _ name _ _ =>
          record_generated_name reg current aliases bare_atoms index name
      end
    end
  end;

def owned_rec_idx (owner : List Nat) (name : List Nat)
    (recs : List RecInfo) : Maybe Nat :=
  (fix find (rest : List RecInfo) (index : Nat) : Maybe Nat :=
    match rest with
    | Nil => Nothing Nat
    | Cons info tail => match info with
      | MkRecInfo path short _ _ =>
          match andb(source_bytes_equal path owner,
              source_bytes_equal short name) with
          | True => Just Nat index
          | False => find tail (S index)
          end
      end
    end) recs Z;

def owned_global_rec (reg : RecReg) (owner : List Nat)
    (name : List Nat) : Maybe Nat :=
  match reg with
  | MkRecReg _ _ _ globals =>
      (fix find (rest : List RecBind) : Maybe Nat :=
        match rest with
        | Nil => Nothing Nat
        | Cons binding tail => match binding with
          | MkRecBind short index path =>
              match andb(source_bytes_equal short name,
                  source_bytes_equal path owner) with
              | True => Just Nat index
              | False => find tail
              end
          end
        end) globals
  end;

def bump_depth (c : Nat) (depth : Nat) : Nat :=
  match orb (eqNat c ch_lparen_p)
        (orb(eqNat c ch_lbrace_p, eqNat c ch_lbrack_p)) with
  | True => S depth
  | False =>
      match orb (eqNat c ch_rparen_p)
            (orb(eqNat c ch_rbrace_p, eqNat c ch_rbrack_p)) with
      | True =>
          match depth with
          | Z => Z
          | S d' => d'
          end
      | False => depth
      end
  end;

def take_until_word (w : List Nat) (xs0 : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      (prior_ident : Bool) : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S fuel2 =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match andb(eqNat depth Z, andb(notb prior_ident, word_at w xs)) with
            | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
            | False =>
                match source_copy_comment_or_string acc xs with
                | Just copied =>
                    match copied with
                    | MkPair acc2 tail => go fuel2 tail acc2 depth False
                    end
                | Nothing => go(fuel2, rest, Cons Nat c acc,
                    bump_depth c depth, source_is_ident_char c)
                end
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z False;

def take_until_char (stop : Nat) (xs0 : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S fuel2 =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match andb(eqNat depth Z, eqNat c stop) with
            | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
            | False =>
                match source_copy_comment_or_string acc xs with
                | Just copied =>
                    match copied with
                    | MkPair acc2 tail => go fuel2 tail acc2 depth
                    end
                | Nothing => go(fuel2, rest, Cons Nat c acc, bump_depth c depth)
                end
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z;

def type_to_rec (reg : RecReg) (current : List Nat)
    (aliases : ImpReg) (ty : List Nat) : Maybe Nat :=
  (fix go (fuel : Nat) (xs : List Nat) : Maybe Nat :=
    match fuel with
    | Z => Nothing Nat
    | S remaining =>
        match skip_ws_p xs with
        | Nil => Nothing Nat
        | Cons c rest =>
            match eqNat c ch_lparen_p with
            | True =>
                match take_until_char ch_rparen_p rest with
                | MkPair inner closing =>
                    match closing with
                    | Nil => Nothing Nat
                    | Cons closer after =>
                        match eqNat closer ch_rparen_p with
                        | False => Nothing Nat
                        | True =>
                            match skip_ws_p after with
                            | Cons _ _ => Nothing Nat
                            | Nil => go remaining inner
                            end
                        end
                    end
                end
            | False =>
                match record_take_atom (Cons Nat c rest) with
                | MkPair name after =>
                    match name with
                    | Nil => Nothing Nat
                    | Cons _ _ =>
                        match skip_ws_p after with
                        | Cons _ _ => Nothing Nat
                        | Nil =>
                            match record_marker_parts name with
                            | Nothing => match reg with
                              | MkRecReg _ recs _ _ =>
                                  match owned_rec_idx current name recs with
                                  | Just index => Just Nat index
                                  | Nothing => find_rec_idx name recs
                                  end
                              end
                            | Just parts => match parts with
                              | MkPair alias member =>
                                  match record_alias_target current aliases alias with
                                  | Nothing => Nothing Nat
                                  | Just owner => match reg with
                                    | MkRecReg _ recs _ _ => owned_rec_idx owner member recs
                                    end
                                  end
                              end
                            end
                        end
                    end
                end
            end
        end
    end) (S (length Nat ty)) ty;

-- Field types are written in the record owner's source, not the caller's.
-- Without that owner's import bindings, only its own nominal records are safe
-- to recognize from an imported field declaration.
def record_field_type_to_rec (reg : RecReg) (current : List Nat)
    (aliases : ImpReg) (owner : List Nat) (ty : List Nat) : Maybe Nat :=
  match source_bytes_equal owner current with
  | True => type_to_rec reg current aliases ty
  | False =>
      match type_to_rec reg owner
          (MkImpReg (Nil (List Nat)) (Nil (Pair (List Nat) (List Nat)))
            (Nil ImpRule)) ty with
      | Nothing => Nothing Nat
      | Just index => match reg with
        | MkRecReg _ recs _ _ => match nth_rec recs index with
          | Nothing => Nothing Nat
          | Just info => match info with
            | MkRecInfo actual_owner _ _ _ =>
                match source_bytes_equal owner actual_owner with
                | True => Just Nat index
                | False => Nothing Nat
                end
            end
          end
        end
      end
  end;

def type_record_hint (reg : RecReg) (current : List Nat)
    (aliases : ImpReg)
    (ty : List Nat) : Maybe (Pair Nat (List Nat)) :=
  match type_to_rec reg current aliases ty with
  | Nothing => Nothing (Pair Nat (List Nat))
  | Just index => match record_marker_parts (trim_bytes ty) with
    | Just _ => Just (Pair Nat (List Nat))
        (MkPair Nat (List Nat) index (record_qualifier ty))
    | Nothing => match record_owner_prefix reg current aliases index with
      | Nothing => Nothing (Pair Nat (List Nat))
      | Just qualifier => Just (Pair Nat (List Nat))
          (MkPair Nat (List Nat) index qualifier)
      end
    end
  end;

def record_hint_index (hint : Maybe (Pair Nat (List Nat))) : Maybe Nat :=
  match hint with
  | Nothing => Nothing Nat
  | Just pair => match pair with
    | MkPair index _ => Just Nat index
    end
  end;

def record_index_hint (index : Maybe Nat)
    : Maybe (Pair Nat (List Nat)) :=
  match index with
  | Nothing => Nothing (Pair Nat (List Nat))
  | Just value => Just (Pair Nat (List Nat))
      (MkPair Nat (List Nat) value (Nil Nat))
  end;

def take_until_coloneq (xs0 : List Nat) : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S fuel2 =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match rest with
            | Cons c2 _rest2 =>
                match andb (eqNat depth Z)
                      (andb(eqNat c ch_colon_p, eqNat c2 ch_eq_p)) with
                | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
                | False =>
                    match source_copy_comment_or_string acc xs with
                    | Just copied =>
                        match copied with
                        | MkPair acc2 tail => go fuel2 tail acc2 depth
                        end
                    | Nothing => go(fuel2, rest, Cons Nat c acc, bump_depth c depth)
                    end
                end
            | Nil => MkPair (List Nat) (List Nat)
                       (reverse(Nat, Cons Nat c acc)) (Nil Nat)
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z;

def matching_brace (xs0 : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Maybe (Pair (List Nat) (List Nat)) :=
    match fuel with
    | Z => Nothing (Pair(List Nat, List Nat))
    | S fuel2 =>
        match xs with
        | Nil => Nothing (Pair(List Nat, List Nat))
        | Cons c rest =>
            match eqNat c ch_lbrace_p with
            | True => go(fuel2, rest, Cons Nat c acc, S depth)
            | False =>
                match eqNat c ch_rbrace_p with
                | True =>
                    match depth with
                    | Z => Nothing (Pair(List Nat, List Nat))
                    | S d' =>
                        match d' with
                        | Z =>
                            Just (Pair(List Nat, List Nat))
                              (MkPair (List Nat) (List Nat)
                                (reverse(Nat, Cons Nat c acc)) rest)
                        | S _ => go fuel2 rest (Cons Nat c acc) d'
                        end
                    end
                | False =>
                    match source_copy_comment_or_string acc xs with
                    | Just copied =>
                        match copied with
                        | MkPair acc2 tail => go fuel2 tail acc2 depth
                        end
                    | Nothing => go fuel2 rest (Cons Nat c acc) depth
                    end
                end
            end
        end
    end) (length Nat xs0) xs0 (Nil Nat) Z;

def strip_braces (body : List Nat) : List Nat :=
  match body with
  | Cons _ restb =>
      reverse Nat
        (match reverse Nat restb with
         | Cons _ mid => mid
         | Nil => Nil Nat
         end)
  | Nil => Nil Nat
  end;

def top_has_assign (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) (depth : Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match rest with
            | Cons c2 _ =>
                match andb (eqNat depth Z)
                      (andb(eqNat c ch_colon_p, eqNat c2 ch_eq_p)) with
                | True => True
                | False =>
                    match source_is_comment xs with
                    | True => go fuel2 (source_skip_line rest) depth
                    | False =>
                        match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
                        | True => go fuel2 (source_skip_literal xs) depth
                        | False => go fuel2 rest (bump_depth c depth)
                        end
                    end
                end
            | Nil => False
            end
        end
    end) (length Nat src) src Z;

def top_starts_pun (src : List Nat) : Bool :=
  match source_take_ident (skip_ws_p src) with
  | MkPair field rest =>
      match field with
      | Nil => False
      | Cons _ _ =>
          match skip_ws_p rest with
          | Nil => True
          | Cons c _ => eqNat c ch_comma_p
          end
      end
  end;

def top_has_with (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) (depth : Nat)
      (prior_ident : Bool) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match andb(eqNat depth Z, andb(notb prior_ident, word_at w_with xs)) with
            | True => True
            | False =>
                match source_is_comment xs with
                | True => go fuel2 (source_skip_line rest) depth False
                | False =>
                    match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
                    | True => go fuel2 (source_skip_literal xs) depth False
                    | False => go fuel2 rest (bump_depth c depth)
                        (source_is_ident_char c)
                    end
                end
            end
        end
    end) (length Nat src) src Z False;

def rec_reg_has_recs (reg : RecReg) : Bool :=
  match reg with
  | MkRecReg _ recs _ _ =>
      match recs with
      | Nil => False
      | Cons _ _ => True
      end
  end;

-- Only the word-bounded `record` keyword activates this prepass; dots and braces are valid existing syntax.
def src_has_record_keyword (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go(fuel2, source_skip_line rest)
            | False =>
                match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
                | True => go(fuel2, source_skip_literal xs)
                | False =>
                    match source_is_ident_start c with
                    | True =>
                        match source_take_ident xs with
                        | MkPair id after =>
                            match source_bytes_equal id w_record with
                            | True => True
                            | False => go fuel2 after
                            end
                        end
                    | False => go fuel2 rest
                    end
                end
            end
        end
    end) (length Nat src) src;

-- @export records_maybe_needed; @doc docs/syntax.md
def records_maybe_needed (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S fuel2 =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go(fuel2, source_skip_line rest)
            | False =>
                match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
                | True => go(fuel2, source_skip_literal xs)
                | False =>
                    match source_is_ident_start c with
                    | True =>
                        match source_take_ident xs with
                        | MkPair id after =>
                            match source_bytes_equal id w_record with
                            | True => True
                            | False =>
                                match source_bytes_equal id w_let_p with
                                | False => go fuel2 after
                                | True =>
                                    match skip_ws_p after with
                                    | Cons brace rest =>
                                        match eqNat brace ch_lbrace_p with
                                        | False => go fuel2 after
                                        | True =>
                                            match matching_brace (Cons Nat brace rest) with
                                            | Nothing => go fuel2 after
                                            | Just block =>
                                                match block with
                                                | MkPair body tail =>
                                                    orb(go fuel2 (strip_braces body), go fuel2 tail)
                                                end
                                            end
                                        end
                                    | Nil => go fuel2 after
                                    end
                                end
                            end
                        end
                    | False =>
                        match eqNat c ch_dot_p with
                        | True => True
                        | False =>
                            match eqNat c ch_lbrace_p with
                            | True =>
                                match matching_brace xs with
                                | Nothing => go fuel2 rest
                                | Just p =>
                                    match p with
                                    | MkPair body tail =>
                                        let inner : List Nat := strip_braces body in
                                        match orb (top_has_assign inner)
                                              (orb(top_starts_pun inner, top_has_with inner)) with
                                        | True => True
                                        | False => go fuel2 tail
                                        end
                                    end
                                end
                            | False => go fuel2 rest
                            end
                        end
                    end
                end
            end
        end
    end) (length Nat src) src;

def collect_decl_names (src : List Nat) : List (List Nat) :=
  reverse (List Nat)
    ((fix go (fuel : Nat) (xs : List Nat) (acc : List (List Nat)) : List (List Nat) :=
      match fuel with
      | Z => acc
      | S fuel2 =>
          match xs with
          | Nil => acc
          | Cons c rest =>
              match source_is_comment xs with
              | True => go fuel2 (source_skip_line rest) acc
              | False =>
                  match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
                  | True => go fuel2 (source_skip_literal xs) acc
                  | False =>
                      match source_is_ident_start c with
                      | True =>
                          match source_take_ident xs with
                          | MkPair id after =>
                              match orb (source_bytes_equal id w_def)
                                    (orb (source_bytes_equal id w_axiom)
                                      (orb (source_bytes_equal id w_inductive)
                                        (orb (source_bytes_equal id w_effect)
                                          (orb (source_bytes_equal id w_record)
                                            (orb (source_bytes_equal id w_intrinsic_p)
                                              (source_bytes_equal id w_extern_p)))))) with
                              | True =>
                                  let after2 : List Nat := skip_ws_p after in
                                  match source_take_ident after2 with
                                  | MkPair nm rest3 =>
                                      match nm with
                                      | Nil => go fuel2 after2 acc
                                      | Cons _ _ =>
                                          go fuel2 rest3 (Cons (List Nat) nm acc)
                                      end
                                  end
                              | False => go fuel2 after acc
                              end
                          end
                      | False => go fuel2 rest acc
                      end
                  end
              end
          end
      end) (length Nat src) src (Nil (List Nat)));

def acc_name (recN : List Nat) (fld : List Nat) : List Nat :=
  append Nat recN (append Nat s_uscore fld);

def field_type_has_top_arrow (input : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) (depth : Nat) : Bool :=
    match fuel with
    | Z => False
    | S remaining =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go remaining (source_skip_line rest) depth
            | False =>
                match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
                | True => go remaining (source_skip_literal xs) depth
                | False =>
                    match rest with
                    | Nil => False
                    | Cons next _ =>
                        match andb(eqNat depth Z,
                              andb(eqNat c 45, eqNat next 62)) with
                        | True => True
                        | False => go remaining rest (bump_depth c depth)
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input Z;

def emit_ctor_field_type (acc : List Nat) (ty : List Nat) : List Nat :=
  match field_type_has_top_arrow ty with
  | False => source_emit_reversed acc ty
  | True => source_emit_reversed
      (source_emit_reversed (Cons Nat ch_lparen_p acc) ty)
      (n1p ch_rparen_p)
  end;

def emit_fields_ty (initial : List Nat) (fields : List RecField) : List Nat :=
  (fix go (fs : List RecField) (acc : List Nat) : List Nat :=
    match fs with
    | Nil => acc
    | Cons f rest =>
        match f with
        | MkRecField _ ty =>
            match rest with
            | Nil => emit_ctor_field_type acc ty
            | Cons _ _ => go(rest, source_emit_reversed(emit_ctor_field_type acc ty, s_arrow))
            end
        end
    end) fields initial;

def emit_pat_fields (initial : List Nat) (fields : List RecField) : List Nat :=
  (fix go (fs : List RecField) (acc : List Nat) : List Nat :=
    match fs with
    | Nil => acc
    | Cons f rest =>
        match f with
        | MkRecField n _ =>
            go(rest, source_emit_reversed(Cons Nat ch_space_p acc, n))
        end
    end) fields initial;

def emit_accessors (recN : List Nat) (ctor : List Nat) (allfs : List RecField)
    (initial : List Nat) (fields : List RecField) : List Nat :=
  (fix go (fs : List RecField) (acc : List Nat) : List Nat :=
    match fs with
    | Nil => acc
    | Cons f rest =>
        match f with
        | MkRecField n ty =>
            let a1 : List Nat := source_emit_reversed acc s_defsp in
            let a2 : List Nat := source_emit_reversed(a1, acc_name recN n) in
            let a3 : List Nat := source_emit_reversed a2 s_lp_p_colon in
            let a4 : List Nat := source_emit_reversed a3 recN in
            let a5 : List Nat := source_emit_reversed a4 s_rp_colon in
            let a6 : List Nat := source_emit_reversed a5 ty in
            let a7 : List Nat := source_emit_reversed a6 s_matchp in
            let a8 : List Nat := source_emit_reversed a7 s_with_bar in
            let a9 : List Nat := source_emit_reversed a8 s_bar_sp in
            let a10 : List Nat := source_emit_reversed a9 ctor in
            let a11 : List Nat := emit_pat_fields a10 allfs in
            let a12 : List Nat := source_emit_reversed a11 s_arrow_end in
            let a13 : List Nat := source_emit_reversed a12 n in
            go(rest, source_emit_reversed a13 s_end_semi)
        end
    end) fields initial;

def emit (acc : List Nat) (chunk : List Nat) : List Nat :=
    source_emit_reversed acc chunk;

def emit_record (acc : List Nat) (ri : RecInfo) (sort : List Nat) : List Nat :=
  match ri with
  | MkRecInfo _ name ctor fs =>
      let a1 : List Nat := Cons Nat ch_lf_p acc in
      let a2 : List Nat := source_emit_reversed a1 s_inductive in
      let a3 : List Nat := source_emit_reversed a2 name in
      let a4 : List Nat := source_emit_reversed a3 s_colonsp in
      let a5 : List Nat := source_emit_reversed a4 sort in
      let a6 : List Nat := source_emit_reversed a5 s_coloneqbar in
      let a7 : List Nat := source_emit_reversed(source_emit_reversed a6 s_sp_bar_sp, ctor) in
      let a8 : List Nat := source_emit_reversed a7 s_colonsp in
      let a9 : List Nat :=
        match fs with
        | Nil => source_emit_reversed a8 name
        | Cons _ _ => source_emit_reversed(emit_fields_ty a8 fs, append Nat s_arrow name)
        end in
      emit_accessors name ctor fs (source_emit_reversed a9 s_semi_nl) fs
  end;
