-- Surface syntax is shared across parser, desugar, lower, lint, and formatter; constructor order is a cross-stage ABI.

import "../std/data.ouro",
  "base.ouro";

inductive Expr : Type :=
  | EVar : Nat -> Expr
  | EHole : Maybe Nat -> Expr
  | ESort : Nat -> Expr
  | ENat : Nat -> Expr
  | EApp : Expr -> Expr -> Expr
  | ELam : Nat -> Maybe Expr -> Expr -> Expr
  | EPi : Nat -> Expr -> Expr -> Expr
  | ELet : Nat -> Maybe Expr -> Expr -> Expr -> Expr
  | EAscribe : Expr -> Expr -> Expr
  | EMatch : Expr -> Expr -> Expr
  | EFix : Nat -> Expr -> Expr -> Expr -> Expr
  | EEffectRow : Expr -> List Nat -> Expr
  | EPerform : Nat -> List Expr -> Expr
  | EDo : List Expr -> Expr
  | EHandle : Expr -> List (Pair Nat (Pair (List Nat) Expr)) -> Expr
  | EBranch : List Nat -> Expr -> Expr -> Expr
  | ENoBranch : Expr
  | EBinder : Nat -> Expr -> Expr -> Expr
  | ENoBinder : Expr
  | EMultiMatch : List Expr -> List (Pair (List (Pair Nat (List Nat))) Expr) -> Expr
  | EStr : Nat -> Expr
  | EDoBind : Nat -> Expr -> Expr
  | EList : List Expr -> Expr
  -- First and past-the-end token indices of the wrapped expression. Only the
  -- spanned source parser emits it; every consumer treats it as transparent.
  | ESpan : Nat -> Nat -> Expr -> Expr
  | EFallible : Expr -> Nat -> Nat -> Expr -> Expr;

inductive Decl : Type :=
  | DDef : Nat -> Expr -> Expr -> Decl
  | DAxiom : Nat -> Expr -> Decl
  -- Final field counts the leading opt-in Type parameters; checking validates it.
  | DInductive : Nat -> List (Pair Nat Expr) -> Expr -> List (Pair Nat Expr) -> Nat -> Decl
  | DEffect : Nat -> List (Pair Nat Expr) -> List (Pair Nat Expr) -> Decl
  | DImport : Nat -> Decl
  | DIntrinsic : Nat -> Expr -> Nat -> Maybe Expr -> Decl
  | DExtern : Nat -> Expr -> List Nat -> Decl
  | DRepresentation : Nat -> Nat -> Decl;

def fallible_bare_question : Expr -> Bool :=
  fix fallible_bare_question (term : Expr) : Bool :=
    match term with
    | ESpan _ _ inner => fallible_bare_question inner
    | EHole m =>
        match m with
        | Just n => eqNat n Z
        | Nothing => False
        end
    | EVar _ => False
    | ESort _ => False
    | ENat _ => False
    | EApp _ _ => False
    | ELam _ _ _ => False
    | EPi _ _ _ => False
    | ELet _ _ _ _ => False
    | EAscribe _ _ => False
    | EMatch _ _ => False
    | EFix _ _ _ _ => False
    | EEffectRow _ _ => False
    | EPerform _ _ => False
    | EDo _ => False
    | EHandle _ _ => False
    | EBranch _ _ _ => False
    | ENoBranch => False
    | EBinder _ _ _ => False
    | ENoBinder => False
    | EMultiMatch _ _ => False
    | EStr _ => False
    | EDoBind _ _ => False
    | EList _ => False
    | EFallible _ _ _ _ => False
    end;

def fallible_postfix : Expr -> Maybe Expr :=
  fix fallible_postfix (term : Expr) : Maybe Expr :=
    match term with
    | ESpan _ _ inner => fallible_postfix inner
    | EApp operand question =>
        match fallible_bare_question question with
        | True => Just Expr operand
        | False => Nothing Expr
        end
    | EVar _ => Nothing Expr
    | EHole _ => Nothing Expr
    | ESort _ => Nothing Expr
    | ENat _ => Nothing Expr
    | ELam _ _ _ => Nothing Expr
    | EPi _ _ _ => Nothing Expr
    | ELet _ _ _ _ => Nothing Expr
    | EAscribe _ _ => Nothing Expr
    | EMatch _ _ => Nothing Expr
    | EFix _ _ _ _ => Nothing Expr
    | EEffectRow _ _ => Nothing Expr
    | EPerform _ _ => Nothing Expr
    | EDo _ => Nothing Expr
    | EHandle _ _ => Nothing Expr
    | EBranch _ _ _ => Nothing Expr
    | ENoBranch => Nothing Expr
    | EBinder _ _ _ => Nothing Expr
    | ENoBinder => Nothing Expr
    | EMultiMatch _ _ => Nothing Expr
    | EStr _ => Nothing Expr
    | EDoBind _ _ => Nothing Expr
    | EList _ => Nothing Expr
    | EFallible _ _ _ _ => Nothing Expr
    end;

-- Analysis walks the checked block's operand and continuation. The qmark is
-- control flow, not an unresolved hole; nested lambda/do expressions retain
-- their own boundary and are not rewritten here.
def fallible_analysis_body (fuel : Nat) (body : Expr) : Expr :=
  (fix go (remaining : Nat) (term : Expr) : Expr :=
    match remaining with
    | Z => term
    | S next =>
        match term with
        | ESpan first past inner => ESpan first past (go next inner)
        | ELet name ann value rest =>
            ELet name ann
              (match fallible_postfix value with
              | Nothing => value
              | Just operand => operand
              end)
              (go next rest)
        | EApp _ _ =>
            match fallible_postfix term with
            | Nothing => term
            | Just operand => operand
            end
        | EVar _ => term
        | EHole _ => term
        | ESort _ => term
        | ENat _ => term
        | ELam _ _ _ => term
        | EPi _ _ _ => term
        | EAscribe _ _ => term
        | EMatch _ _ => term
        | EFix _ _ _ _ => term
        | EEffectRow _ _ => term
        | EPerform _ _ => term
        | EDo _ => term
        | EHandle _ _ => term
        | EBranch _ _ _ => term
        | ENoBranch => term
        | EBinder _ _ _ => term
        | ENoBinder => term
        | EMultiMatch _ _ => term
        | EStr _ => term
        | EDoBind _ _ => term
        | EList _ => term
        | EFallible _ _ _ _ => term
        end
    end) fuel body;

def do_bind_of : Expr -> Maybe (Pair Nat Expr) :=
  fix do_bind_of (e : Expr) : Maybe (Pair Nat Expr) :=
    match e with
    | ESpan _ _ inner => do_bind_of inner
    | EDoBind n rhs => Just(Pair Nat Expr, MkPair Nat Expr n rhs)
    | EVar _ => Nothing (Pair Nat Expr)
    | EHole _ => Nothing (Pair Nat Expr)
    | ESort _ => Nothing (Pair Nat Expr)
    | ENat _ => Nothing (Pair Nat Expr)
    | EApp _ _ => Nothing (Pair Nat Expr)
    | ELam _ _ _ => Nothing (Pair Nat Expr)
    | EPi _ _ _ => Nothing (Pair Nat Expr)
    | ELet _ _ _ _ => Nothing (Pair Nat Expr)
    | EAscribe _ _ => Nothing (Pair Nat Expr)
    | EMatch _ _ => Nothing (Pair Nat Expr)
    | EFix _ _ _ _ => Nothing (Pair Nat Expr)
    | EEffectRow _ _ => Nothing (Pair Nat Expr)
    | EPerform _ _ => Nothing (Pair Nat Expr)
    | EDo _ => Nothing (Pair Nat Expr)
    | EHandle _ _ => Nothing (Pair Nat Expr)
    | EBranch _ _ _ => Nothing (Pair Nat Expr)
    | ENoBranch => Nothing (Pair Nat Expr)
    | EBinder _ _ _ => Nothing (Pair Nat Expr)
    | ENoBinder => Nothing (Pair Nat Expr)
    | EMultiMatch _ _ => Nothing (Pair Nat Expr)
    | EStr _ => Nothing (Pair Nat Expr)
    | EList _ => Nothing (Pair Nat Expr)
    | EFallible _ _ _ _ => Nothing (Pair Nat Expr)
    end;

def mk_pi_chain : List (Pair Nat Expr) -> Expr -> Expr :=
  fix mk_pi_chain (bs : List (Pair Nat Expr)) (body : Expr) : Expr :=
    match bs with
    | Nil => body
    | Cons b rest =>
        match b with
        | MkPair n ty => EPi n ty (mk_pi_chain rest body)
        end
    end;

def rec_field_names : List (Pair Nat Expr) -> List Nat :=
  fix rec_field_names (fs : List (Pair Nat Expr)) : List Nat :=
    match fs with
    | Nil => Nil Nat
    | Cons f rest =>
        match f with
        | MkPair n _ => Cons Nat n (rec_field_names rest)
        end
    end;

def expr_pi_arity : Nat -> Expr -> Nat :=
  fix expr_pi_arity (fuel : Nat) (t : Expr) : Nat :=
    match fuel with
    | Z => Z
    | S fuel' =>
        match t with
        | EVar _ => Z
        | EHole _ => Z
        | ESort _ => Z
        | ENat _ => Z
        | EStr _ => Z
        | EApp _ _ => Z
        | ELam _ _ _ => Z
        | EPi _ _ body => S (expr_pi_arity fuel' body)
        | ELet _ _ _ _ => Z
        | EAscribe _ _ => Z
        | EMatch _ _ => Z
        | EFix _ _ _ _ => Z
        | EEffectRow _ _ => Z
        | EPerform _ _ => Z
        | EDo _ => Z
        | EDoBind _ _ => Z
        | EList _ => Z
        | EFallible _ _ _ _ => Z
        | EHandle _ _ => Z
        | EBranch _ _ _ => Z
        | ENoBranch => Z
        | EBinder _ _ _ => Z
        | ENoBinder => Z
        | EMultiMatch _ _ => Z
        | ESpan _ _ inner => expr_pi_arity fuel' inner
        end
    end;

def build_branches : List (Pair (List (Pair Nat (List Nat))) Expr) -> Expr :=
  fix build_branches (rows : List (Pair (List (Pair Nat (List Nat))) Expr)) : Expr :=
    match rows with
    | Nil => ENoBranch
    | Cons r rest =>
        match r with
        | MkPair pats body =>
            match pats with
            | Nil => build_branches rest
            | Cons p _ =>
                match p with
                | MkPair ctor vars =>
                    EBranch(Cons Nat ctor vars, body, build_branches rest)
                end
            end
        end
    end;
