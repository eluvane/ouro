-- Surface syntax is shared across parser, desugar, lower, lint, and formatter; constructor order is a cross-stage ABI.

import "../std/data.ouro";
import "base.ouro";

inductive Expr : Type :=
  | EVar : Nat -> Expr
  | EHole : Maybe Nat -> Expr
  | ESort : Nat -> Expr
  | ENat : Nat -> Expr
  | EApp : Expr -> Expr -> Expr
  | ELam : Nat -> Maybe Expr -> Expr -> Expr
  | EPi : Nat -> Expr -> Expr -> Expr
  | ELet : Nat -> Maybe Expr -> Expr -> Expr -> Expr
  | EAscribe : Expr -> Expr -> Expr
  | EMatch : Expr -> Expr -> Expr
  | EFix : Nat -> Expr -> Expr -> Expr -> Expr
  | EEffectRow : Expr -> List Nat -> Expr
  | EPerform : Nat -> List Expr -> Expr
  | EDo : List Expr -> Expr
  | EHandle : Expr -> List (Pair Nat (Pair (List Nat) Expr)) -> Expr
  | EBranch : List Nat -> Expr -> Expr -> Expr
  | ENoBranch : Expr
  | EBinder : Nat -> Expr -> Expr -> Expr
  | ENoBinder : Expr
  | EMultiMatch : List Expr -> List (Pair (List (Pair Nat (List Nat))) Expr) -> Expr
  | EStr : Nat -> Expr
  | EDoBind : Nat -> Expr -> Expr
  | EList : List Expr -> Expr;

inductive Decl : Type :=
  | DDef : Nat -> Expr -> Expr -> Decl
  | DAxiom : Nat -> Expr -> Decl
  | DInductive : Nat -> List (Pair Nat Expr) -> Expr -> List (Pair Nat Expr) -> Decl
  | DEffect : Nat -> List (Pair Nat Expr) -> List (Pair Nat Expr) -> Decl
  | DImport : Nat -> Decl
  | DIntrinsic : Nat -> Expr -> Nat -> Maybe Expr -> Decl
  | DExtern : Nat -> Expr -> List Nat -> Decl
  | DRepresentation : Nat -> Nat -> Decl;


def do_bind_of (e : Expr) : Maybe (Pair Nat Expr) :=
    match e with
    | EDoBind n rhs => Just (Pair Nat Expr) (MkPair Nat Expr n rhs)
    | EVar _ => Nothing (Pair Nat Expr)
    | EHole _ => Nothing (Pair Nat Expr)
    | ESort _ => Nothing (Pair Nat Expr)
    | ENat _ => Nothing (Pair Nat Expr)
    | EApp _ _ => Nothing (Pair Nat Expr)
    | ELam _ _ _ => Nothing (Pair Nat Expr)
    | EPi _ _ _ => Nothing (Pair Nat Expr)
    | ELet _ _ _ _ => Nothing (Pair Nat Expr)
    | EAscribe _ _ => Nothing (Pair Nat Expr)
    | EMatch _ _ => Nothing (Pair Nat Expr)
    | EFix _ _ _ _ => Nothing (Pair Nat Expr)
    | EEffectRow _ _ => Nothing (Pair Nat Expr)
    | EPerform _ _ => Nothing (Pair Nat Expr)
    | EDo _ => Nothing (Pair Nat Expr)
    | EHandle _ _ => Nothing (Pair Nat Expr)
    | EBranch _ _ _ => Nothing (Pair Nat Expr)
    | ENoBranch => Nothing (Pair Nat Expr)
    | EBinder _ _ _ => Nothing (Pair Nat Expr)
    | ENoBinder => Nothing (Pair Nat Expr)
    | EMultiMatch _ _ => Nothing (Pair Nat Expr)
    | EStr _ => Nothing (Pair Nat Expr)
    | EList _ => Nothing (Pair Nat Expr)
    end;

def mk_pi_chain : List (Pair Nat Expr) -> Expr -> Expr :=
  fix mk_pi_chain (bs : List (Pair Nat Expr)) (body : Expr) : Expr :=
    match bs with
    | Nil => body
    | Cons b rest =>
        match b with
        | MkPair n ty => EPi n ty (mk_pi_chain rest body)
        end
    end;

def rec_field_names : List (Pair Nat Expr) -> List Nat :=
  fix rec_field_names (fs : List (Pair Nat Expr)) : List Nat :=
    match fs with
    | Nil => Nil Nat
    | Cons f rest =>
        match f with
        | MkPair n _ => Cons Nat n (rec_field_names rest)
        end
    end;

def expr_pi_arity : Nat -> Expr -> Nat :=
  fix expr_pi_arity (fuel : Nat) (t : Expr) : Nat :=
    match fuel with
    | Z => Z
    | S fuel' =>
        match t with
        | EVar _ => Z
        | EHole _ => Z
        | ESort _ => Z
        | ENat _ => Z
        | EStr _ => Z
        | EApp _ _ => Z
        | ELam _ _ _ => Z
        | EPi _ _ body => S (expr_pi_arity fuel' body)
        | ELet _ _ _ _ => Z
        | EAscribe _ _ => Z
        | EMatch _ _ => Z
        | EFix _ _ _ _ => Z
        | EEffectRow _ _ => Z
        | EPerform _ _ => Z
        | EDo _ => Z
        | EDoBind _ _ => Z
        | EList _ => Z
        | EHandle _ _ => Z
        | EBranch _ _ _ => Z
        | ENoBranch => Z
        | EBinder _ _ _ => Z
        | ENoBinder => Z
        | EMultiMatch _ _ => Z
        end
    end;

def build_branches : List (Pair (List (Pair Nat (List Nat))) Expr) -> Expr :=
  fix build_branches (rows : List (Pair (List (Pair Nat (List Nat))) Expr)) : Expr :=
    match rows with
    | Nil => ENoBranch
    | Cons r rest =>
        match r with
        | MkPair pats body =>
            match pats with
            | Nil => build_branches rest
            | Cons p _ =>
                match p with
                | MkPair ctor vars =>
                    EBranch (Cons Nat ctor vars) body (build_branches rest)
                end
            end
        end
    end;
