-- Resolve interned source literals before declaration checking. The checker
-- receives bytes, including embedded NUL, rather than an opaque table index.
import "pipeline_abi.ouro";
import "file_check_model.ouro";

def literal_bind (A : Type) (B : Type) (result : CompResult A)
    (next : A -> CompResult B) : CompResult B :=
    match result with | CErr failure => CErr B failure | COk value => next value end;

def literal_map (A : Type) (B : Type) (build : A -> B) (result : CompResult A) : CompResult B :=
    literal_bind A B result (fun (value : A) => COk B (build value));

def literal_lookup (strings : List (Pair (List Nat) Nat)) (name : Nat) : CompResult (List Nat) :=
    (fix find (remaining : List (Pair (List Nat) Nat)) : CompResult (List Nat) :=
      match remaining with
      | Nil => CErr (List Nat) (ErrCode 46 name)
      | Cons pair rest => match pair with
          | MkPair bytes current => match eqNat current name with
              | True => COk (List Nat) bytes | False => find rest
              end
          end
      end) strings;

def literal_pair (resolve : CoreTerm -> CompResult CoreTerm)
    (build : CoreTerm -> CoreTerm -> CoreTerm) (left : CoreTerm) (right : CoreTerm)
    : CompResult CoreTerm :=
    literal_bind CoreTerm CoreTerm (resolve left)
      (fun (first : CoreTerm) => literal_map CoreTerm CoreTerm (build first) (resolve right));

def literal_list (resolve : CoreTerm -> CompResult CoreTerm)
    : List CoreTerm -> CompResult (List CoreTerm) :=
  fix visit (terms : List CoreTerm) : CompResult (List CoreTerm) :=
    match terms with
    | Nil => COk (List CoreTerm) ([] : List CoreTerm)
    | Cons term rest => literal_bind CoreTerm (List CoreTerm) (resolve term)
        (fun (head : CoreTerm) => literal_map (List CoreTerm) (List CoreTerm)
          (fun (tail : List CoreTerm) => Cons CoreTerm head tail) (visit rest))
    end;

def resolve_core_literals (strings : List (Pair (List Nat) Nat))
    : Nat -> CoreTerm -> CompResult CoreTerm :=
  fix visit (fuel : Nat) (term : CoreTerm) : CompResult CoreTerm :=
    match fuel with
    | Z => CErr CoreTerm (ErrCode 44 0)
    | S next =>
        let resolve : CoreTerm -> CompResult CoreTerm :=
          fun (child : CoreTerm) => visit next child in
        match term with
        | CStrLit name typ => literal_map (List Nat) CoreTerm
            (fun (bytes : List Nat) => CStrBytes bytes typ) (literal_lookup strings name)
        | CPi domain codomain => literal_pair resolve
            (fun (first : CoreTerm) (second : CoreTerm) => CPi first second) domain codomain
        | CLam annotation body => literal_pair resolve
            (fun (first : CoreTerm) (second : CoreTerm) => CLam first second) annotation body
        | CApp function argument => literal_pair resolve
            (fun (first : CoreTerm) (second : CoreTerm) => CApp first second) function argument
        | CLetIn value typ body => literal_bind CoreTerm CoreTerm (resolve value)
            (fun (resolved : CoreTerm) => literal_pair resolve
              (fun (annotation : CoreTerm) (result : CoreTerm) => CLetIn resolved annotation result) typ body)
        | CCase info predicate scrutinee branches =>
            literal_bind CoreTerm CoreTerm (resolve predicate)
              (fun (motive : CoreTerm) => literal_bind CoreTerm CoreTerm (resolve scrutinee)
                (fun (value : CoreTerm) => literal_map (List CoreTerm) CoreTerm
                  (fun (bodies : List CoreTerm) => CCase info motive value bodies)
                  (literal_list resolve branches)))
        | CFix name argument arity typ body => literal_pair resolve
            (fun (annotation : CoreTerm) (result : CoreTerm) =>
              CFix name argument arity annotation result) typ body
        | CRel _ => COk CoreTerm term | CSort _ => COk CoreTerm term
        | CConst _ => COk CoreTerm term | CInd _ => COk CoreTerm term
        | CConstruct _ _ _ => COk CoreTerm term | CStrBytes _ _ => COk CoreTerm term
        end
    end;

def literal_params (resolve : CoreTerm -> CompResult CoreTerm)
    : List Param -> CompResult (List Param) :=
  fix visit (params : List Param) : CompResult (List Param) :=
    match params with
    | Nil => COk (List Param) ([] : List Param)
    | Cons param rest => match param with
        | MkParam name typ => literal_bind CoreTerm (List Param) (resolve typ)
            (fun (annotation : CoreTerm) => literal_map (List Param) (List Param)
              (fun (tail : List Param) => Cons Param (MkParam name annotation) tail) (visit rest))
        end
    end;

def literal_ctors (resolve : CoreTerm -> CompResult CoreTerm)
    : List Ctor -> CompResult (List Ctor) :=
  fix visit (ctors : List Ctor) : CompResult (List Ctor) :=
    match ctors with
    | Nil => COk (List Ctor) ([] : List Ctor)
    | Cons ctor rest => match ctor with
        | MkCtor name typ => literal_bind CoreTerm (List Ctor) (resolve typ)
            (fun (annotation : CoreTerm) => literal_map (List Ctor) (List Ctor)
              (fun (tail : List Ctor) => Cons Ctor (MkCtor name annotation) tail) (visit rest))
        end
    end;

def literal_inductive (resolve : CoreTerm -> CompResult CoreTerm) (decl : IndDecl)
    : CompResult IndDecl :=
    match decl with
    | MkIndDecl name params indices sort ctors =>
        literal_bind (List Param) IndDecl (literal_params resolve params)
          (fun (arguments : List Param) => literal_bind (List CoreTerm) IndDecl
            (literal_list resolve indices)
            (fun (types : List CoreTerm) => literal_map (List Ctor) IndDecl
              (fun (constructors : List Ctor) => MkIndDecl name arguments types sort constructors)
              (literal_ctors resolve ctors)))
    end;

def literal_optional (resolve : CoreTerm -> CompResult CoreTerm) (term : Maybe CoreTerm)
    : CompResult (Maybe CoreTerm) :=
    match term with
    | Nothing => COk (Maybe CoreTerm) (Nothing CoreTerm)
    | Just value => literal_map CoreTerm (Maybe CoreTerm)
        (fun (resolved : CoreTerm) => Just CoreTerm resolved) (resolve value)
    end;

def literal_item (resolve : CoreTerm -> CompResult CoreTerm) (item : FileItem) : CompResult FileItem :=
    match item with
    | FDef name typ body => literal_bind CoreTerm FileItem (resolve typ)
        (fun (annotation : CoreTerm) => literal_map CoreTerm FileItem
          (fun (resolved : CoreTerm) => FDef name annotation resolved) (resolve body))
    | FAxiom name typ => literal_map CoreTerm FileItem
        (fun (annotation : CoreTerm) => FAxiom name annotation) (resolve typ)
    | FInd decl => literal_map IndDecl FileItem
        (fun (resolved : IndDecl) => FInd resolved) (literal_inductive resolve decl)
    | FIntrinsic name typ key specialization => literal_bind CoreTerm FileItem (resolve typ)
        (fun (annotation : CoreTerm) => literal_map (Maybe CoreTerm) FileItem
          (fun (resolved : Maybe CoreTerm) => FIntrinsic name annotation key resolved)
          (literal_optional resolve specialization))
    | FExtern name typ request => literal_map CoreTerm FileItem
        (fun (annotation : CoreTerm) => FExtern name annotation request) (resolve typ)
    | FRepresentation _ _ => COk FileItem item
    end;

def resolve_literal_plan (fuel : Nat) (state : InternState)
    : List FileItem -> CompResult (List FileItem) :=
  fix visit (items : List FileItem) : CompResult (List FileItem) :=
    match state with
    | MkIntern _ _ strings _ => match items with
        | Nil => COk (List FileItem) ([] : List FileItem)
        | Cons item rest => literal_bind FileItem (List FileItem)
            (literal_item (fun (term : CoreTerm) => resolve_core_literals strings fuel term) item)
            (fun (head : FileItem) => literal_map (List FileItem) (List FileItem)
              (fun (tail : List FileItem) => Cons FileItem head tail) (visit rest))
        end
    end;
