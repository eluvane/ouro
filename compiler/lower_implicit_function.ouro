-- Opt-in definition parameters use bounded source type hints and checked apps.

import "lower_implicit.ouro";

inductive ImplicitDefResult : Type :=
  | NoMarkedDef : ImplicitDefResult
  | MarkedDefWithoutHint : ImplicitDefResult
  | InferredDef : Surface -> ImplicitDefResult;

def implicit_def_head (fuel : Nat) (env : LowerEnv)
    (fixSelf : Maybe Nat) (locals : List (Pair Nat Surface))
    (term : Expr) : Maybe (Pair DefInfo (List Expr)) :=
  match implicit_app_head fuel term with
  | Nothing => Nothing (Pair DefInfo (List Expr))
  | Just spine =>
      match spine with
      | MkPair name args =>
          match resolve_var_fix env fixSelf locals name with
          | SConst resolved =>
              match eqNat resolved name with
              | False => Nothing (Pair DefInfo (List Expr))
              | True =>
                  match lookup_def_info name (env_defInfos env) with
                  | Nothing => Nothing (Pair DefInfo (List Expr))
                  | Just info =>
                      match def_info_prefix info with
                      | Z => Nothing (Pair DefInfo (List Expr))
                      | S _ => Just (Pair DefInfo (List Expr))
                          (MkPair DefInfo (List Expr) info args)
                      end
                  end
              end
          | SVar _ => Nothing (Pair DefInfo (List Expr))
          | SSort _ => Nothing (Pair DefInfo (List Expr))
          | SPi _ _ _ => Nothing (Pair DefInfo (List Expr))
          | SLam _ _ _ => Nothing (Pair DefInfo (List Expr))
          | SApp _ _ => Nothing (Pair DefInfo (List Expr))
          | SLet _ _ _ _ => Nothing (Pair DefInfo (List Expr))
          | SInd _ => Nothing (Pair DefInfo (List Expr))
          | SConstruct _ _ _ => Nothing (Pair DefInfo (List Expr))
          | SCase _ _ _ _ => Nothing (Pair DefInfo (List Expr))
          | SFix _ _ _ _ _ => Nothing (Pair DefInfo (List Expr))
          | SHole _ => Nothing (Pair DefInfo (List Expr))
          | SEffectRow _ => Nothing (Pair DefInfo (List Expr))
          | SPerform _ _ => Nothing (Pair DefInfo (List Expr))
          | SStr _ _ => Nothing (Pair DefInfo (List Expr))
          end
      end
  end;

def implicit_app_view (ty : Surface) : Maybe (Pair Surface Surface) :=
  match ty with
  | SApp function argument =>
      Just (Pair Surface Surface) (MkPair Surface Surface function argument)
  | SVar _ => Nothing (Pair Surface Surface)
  | SSort _ => Nothing (Pair Surface Surface)
  | SPi _ _ _ => Nothing (Pair Surface Surface)
  | SLam _ _ _ => Nothing (Pair Surface Surface)
  | SLet _ _ _ _ => Nothing (Pair Surface Surface)
  | SConst _ => Nothing (Pair Surface Surface)
  | SInd _ => Nothing (Pair Surface Surface)
  | SConstruct _ _ _ => Nothing (Pair Surface Surface)
  | SCase _ _ _ _ => Nothing (Pair Surface Surface)
  | SFix _ _ _ _ _ => Nothing (Pair Surface Surface)
  | SHole _ => Nothing (Pair Surface Surface)
  | SEffectRow _ => Nothing (Pair Surface Surface)
  | SPerform _ _ => Nothing (Pair Surface Surface)
  | SStr _ _ => Nothing (Pair Surface Surface)
  end;

-- Anonymous arrow binders use zero repeatedly; their spelling is not a
-- reference to an outer binder. Actual SVar zero is rejected by the hint
-- reliability guard before this matcher. Named binders keep the conservative scan.
def implicit_pi_mentions_binder (binder : Nat) (codomain : Surface) : Bool :=
  match binder with
  | Z => False
  | S _ => surface_mentions_name fuel1k binder codomain
  end;

-- Match only finite, same-head type shapes. Marked SVar nodes are the sole
-- slots; a nondependent Pi may change binder spelling without capture.
def implicit_match_def_type (fuel : Nat) (env : LowerEnv)
    (locals : List (Pair Nat Surface)) (names : List Nat)
    (known : List (Pair Nat Surface)) (template : Surface)
    (actual : Surface) : Maybe (List (Pair Nat Surface)) :=
  (fix go (remaining : Nat) (collected : List (Pair Nat Surface))
      (wanted : Surface) (found : Surface)
      : Maybe (List (Pair Nat Surface)) :=
    match remaining with
    | Z => Nothing (List (Pair Nat Surface))
    | S next =>
        match wanted with
        | SVar name =>
            match memNat(name, names) with
            | False =>
                match implicit_hints_agree wanted found with
                | True => Just (List (Pair Nat Surface)) collected
                | False => Nothing (List (Pair Nat Surface))
                end
            | True =>
                match implicit_candidate_reliable env locals found with
                | False => Nothing (List (Pair Nat Surface))
                | True =>
                    match lookup_local name collected with
                    | Nothing => Just (List (Pair Nat Surface))
                        (cons_local name found collected)
                    | Just prior =>
                        match implicit_hints_agree prior found with
                        | True => Just (List (Pair Nat Surface)) collected
                        | False => Nothing (List (Pair Nat Surface))
                        end
                    end
                end
            end
        | SApp function argument =>
            match implicit_app_view found with
            | Nothing => Nothing (List (Pair Nat Surface))
            | Just parts =>
                match parts with
                | MkPair actual_function actual_argument =>
                    match go next collected function actual_function with
                    | Nothing => Nothing (List (Pair Nat Surface))
                    | Just updated => go next updated argument actual_argument
                    end
                end
            end
        | SPi binder domain codomain =>
            match implicit_pi_view found with
            | NoImplicitPi => Nothing (List (Pair Nat Surface))
            | ImplicitPi actual_binder actual_domain actual_codomain =>
                match orb(implicit_pi_mentions_binder binder codomain,
                    implicit_pi_mentions_binder actual_binder actual_codomain) with
                | True => Nothing (List (Pair Nat Surface))
                | False =>
                    match go next collected domain actual_domain with
                    | Nothing => Nothing (List (Pair Nat Surface))
                    | Just updated => go next updated codomain actual_codomain
                    end
                end
            end
        | SSort _ =>
            match implicit_hints_agree wanted found with
            | True => Just (List (Pair Nat Surface)) collected
            | False => Nothing (List (Pair Nat Surface))
            end
        | SConst _ =>
            match implicit_hints_agree wanted found with
            | True => Just (List (Pair Nat Surface)) collected
            | False => Nothing (List (Pair Nat Surface))
            end
        | SInd _ =>
            match implicit_hints_agree wanted found with
            | True => Just (List (Pair Nat Surface)) collected
            | False => Nothing (List (Pair Nat Surface))
            end
        | SLam _ _ _ => Nothing (List (Pair Nat Surface))
        | SLet _ _ _ _ => Nothing (List (Pair Nat Surface))
        | SConstruct _ _ _ => Nothing (List (Pair Nat Surface))
        | SCase _ _ _ _ => Nothing (List (Pair Nat Surface))
        | SFix _ _ _ _ _ => Nothing (List (Pair Nat Surface))
        | SHole _ => Nothing (List (Pair Nat Surface))
        | SEffectRow _ => Nothing (List (Pair Nat Surface))
        | SPerform _ _ => Nothing (List (Pair Nat Surface))
        | SStr _ _ => Nothing (List (Pair Nat Surface))
        end
    end) fuel known template actual;

def implicit_collect_def_hints (env : LowerEnv)
    (locals : List (Pair Nat Surface)) (names : List Nat)
    (fields : Surface) (hints : List (Maybe Surface))
    (expected : Maybe Surface) : Maybe (List (Pair Nat Surface)) :=
  (fix go (rest : List (Maybe Surface)) (signature : Surface)
      (known : List (Pair Nat Surface)) (seen : List Nat)
      (first : Bool) : Maybe (List (Pair Nat Surface)) :=
    match rest with
    | Nil =>
        match expected with
        | Nothing => Just (List (Pair Nat Surface)) known
        | Just result =>
            match implicit_candidate_reliable env locals result with
            | False => Nothing (List (Pair Nat Surface))
            | True => implicit_match_def_type fuel1k env locals names
                known signature result
            end
        end
    | Cons hint tail =>
        match implicit_pi_view signature with
        | NoImplicitPi => Nothing (List (Pair Nat Surface))
        | ImplicitPi binder domain codomain =>
            match orb(andb(notb(eqNat binder Z),
                  orb(memNat(binder, names), memNat(binder, seen))),
                implicit_pi_mentions_binder binder codomain) with
            | True => Nothing (List (Pair Nat Surface))
            | False =>
                match hint with
                | Nothing =>
                    match first with
                    | True => Nothing (List (Pair Nat Surface))
                    | False => go tail codomain known (Cons Nat binder seen) False
                    end
                | Just candidate =>
                    match implicit_candidate_reliable env locals candidate with
                    | False =>
                        match first with
                        | True => Nothing (List (Pair Nat Surface))
                        | False => go tail codomain known
                            (Cons Nat binder seen) False
                        end
                    | True =>
                        match implicit_match_def_type fuel1k env locals names
                            known domain candidate with
                        | Nothing => Nothing (List (Pair Nat Surface))
                        | Just updated => go tail codomain updated
                            (Cons Nat binder seen) False
                        end
                    end
                end
            end
        end
    end) hints fields (Nil (Pair Nat Surface)) (Nil Nat) True;

def implicit_def_prefix
    (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat ->
      List (Pair Nat Surface) -> LowerMode -> LowerVal)
    (fuel : Nat) (env : LowerEnv) (er : Maybe Surface)
    (fixSelf : Maybe Nat) (locals : List (Pair Nat Surface))
    (info : DefInfo) (args : List Expr) : Maybe (List Surface) :=
  let marked : Nat := def_info_prefix info in
  let declared : Nat := def_info_declared info in
  match orb(eqNat marked Z, ltb_nat declared marked) with
  | True => Nothing (List Surface)
  | False =>
      match eqNat(length Expr args, sub declared marked) with
      | False => Nothing (List Surface)
      | True =>
          match lookup_decl_type env (def_info_name info) with
          | Nothing => Nothing (List Surface)
          | Just signature =>
              match implicit_marked_binders marked signature with
              | Nothing => Nothing (List Surface)
              | Just split =>
                  match split with
                  | MkPair names fields =>
                      match implicit_collect_def_hints env locals names fields
                          (implicit_arg_hints lower_run fuel env fixSelf locals args)
                          er with
                      | Nothing => Nothing (List Surface)
                      | Just known => implicit_prefix_from_known names known
                      end
                  end
              end
          end
      end
  end;

def lower_implicit_function
    (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat ->
      List (Pair Nat Surface) -> LowerMode -> LowerVal)
    (fuel : Nat) (env : LowerEnv) (er : Maybe Surface)
    (fixSelf : Maybe Nat) (locals : List (Pair Nat Surface))
    (term : Expr) : ImplicitDefResult :=
  match implicit_def_head fuel env fixSelf locals term with
  | Nothing => NoMarkedDef
  | Just head =>
      match head with
      | MkPair info args =>
          match implicit_def_prefix lower_run fuel env er fixSelf locals
              info args with
          | Nothing => MarkedDefWithoutHint
          | Just prefix =>
              InferredDef
                (implicit_apply_exprs lower_run fuel env fixSelf locals
                  (implicit_apply_surfaces
                    (SConst (def_info_name info)) prefix) args)
          end
      end
  end;
