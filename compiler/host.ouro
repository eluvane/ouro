-- User-path orchestration lives in Ouro, but filesystem and process effects remain host/runtime responsibilities.

-- @entry eval_row_count
-- @entry elab_row_count
-- @entry check_ok
-- @entry check_fail
-- @entry eval_rows
-- @entry host_backend

import "../std/data.ouro";

inductive HostBackend : Type :=
  | HostOuro1 : HostBackend;

def host_backend : HostBackend := HostOuro1;

def eval_row_count : Nat :=
  5;

def elab_row_count : Nat :=
  8;

def check_ok : Nat := Z;

def check_fail : Nat := S Z;

-- Five eval smoke rows transferred from the retired JS contract.
inductive EvalKind : Type :=
  | EvalExpr : EvalKind
  | EvalPrint : EvalKind;

inductive EvalRow : Type :=
  | MkEvalRow : Nat -> EvalKind -> Nat -> EvalRow;

def eval_rows : List EvalRow :=
  [ MkEvalRow Z EvalExpr Z,
    MkEvalRow (S Z) EvalPrint Z,
    MkEvalRow (S (S Z)) EvalExpr Z,
    MkEvalRow (3) EvalPrint Z,
    MkEvalRow (4) EvalExpr (S Z) ];
