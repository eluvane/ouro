-- Variable-use walk for lowering rewrites. Kept off the rewrite_handlers
-- definition so both the module and the walker stay under the strict size caps.

-- @entry expr_uses_var

import "lower_env.ouro";

def expr_uses_var_list (use : Expr -> Bool) : List Expr -> Bool :=
  fix go (xs : List Expr) : Bool :=
    match xs with
    | Nil => False
    | Cons x xs' => orb(use x, go xs')
    end;

def expr_uses_var_names (name : Nat) : List Nat -> Bool :=
  fix has (xs : List Nat) : Bool :=
    match xs with
    | Nil => False
    | Cons x xs' => orb(eqNat x name, has xs')
    end;

def expr_uses_var_branches
  (use : Expr -> Bool) (name : Nat) (branches : Expr) : Bool :=
  (fix go (bs : Expr) : Bool :=
    match bs with
    | EBranch packed body rest =>
        let shadowed : Bool := expr_uses_var_names name packed in
        orb
          (match shadowed with
          | True => False
          | False => use body
          end)
          (go rest)
    | ENoBranch => False
    | EVar _ => False
    | EHole _ => False
    | ESort _ => False
    | ENat _ => False
    | EApp _ _ => False
    | ELam _ _ _ => False
    | EPi _ _ _ => False
    | ELet _ _ _ _ => False
    | EAscribe _ _ => False
    | EMatch _ _ => False
    | EFix _ _ _ _ => False
    | EEffectRow _ _ => False
    | EPerform _ _ => False
    | EDo _ => False
    | EDoBind _ _ => False
    | EHandle _ _ => False
    | EBinder _ _ _ => False
    | ENoBinder => False
    | EMultiMatch _ _ => False
    | EList _ => False
    | EStr _ => False
    | ESpan _ _ inner => go inner
    | EFallible _ _ _ _ => False
    | EOpen _ inner => go inner
    | ENamedCall _ _ => False
    end) branches;

def expr_uses_var_handle
  (use : Expr -> Bool) (name : Nat)
  (clauses : List (Pair Nat (Pair (List Nat) Expr))) : Bool :=
  (fix go (cs : List (Pair Nat (Pair (List Nat) Expr))) : Bool :=
    match cs with
    | Nil => False
    | Cons c cs' =>
        match c with
        | MkPair _ payload =>
            match payload with
            | MkPair binders body =>
                let shadowed : Bool := expr_uses_var_names name binders in
                orb
                  (match shadowed with
                  | True => False
                  | False => use body
                  end)
                  (go cs')
            end
        end
    end) clauses;

-- Walks every Expr constructor, including the nested rows of a multi-match.
-- @bound(cyclo <= 55)
def expr_uses_var : Nat -> Nat -> Expr -> Bool :=
  fix expr_uses_var (fuel : Nat) (name : Nat) (e : Expr) : Bool :=
    match fuel with
    | Z => True
    | S fuel' =>
        let use (item : Expr) : Bool :=
          expr_uses_var fuel' name item in
        match e with
        | EVar n => eqNat n name
        | EHole _ => False
        | ESort _ => False
        | ENat _ => False
        | EStr _ => False
        | EApp f a => orb(use f, use a)
        | ELam n ann body =>
            orb
              (maybe Expr Bool False use ann)
              (match eqNat n name with
              | True => False
              | False => use body
              end)
        | EPi n dom cod =>
            orb (use dom)
              (match eqNat n name with
              | True => False
              | False => use cod
              end)
        | ELet n ann value body =>
            orb
              (maybe Expr Bool False use ann)
              (orb (use value)
                (match eqNat n name with
                | True => False
                | False => use body
                end))
        | EAscribe e0 ty => orb(use e0, use ty)
        | EMatch scrut branches =>
            orb(use scrut, expr_uses_var_branches use name branches)
        | EFix fn binders ret body =>
            orb (use binders)
              (match eqNat fn name with
              | True => False
              | False => orb(use ret, use body)
              end)
        | EEffectRow ty _ => use ty
        | EPerform _ args => expr_uses_var_list use args
        | EDo es => expr_uses_var_list use es
        | EList elems => expr_uses_var_list use elems
        | EDoBind n action => orb(eqNat n name, use action)
        | EHandle comp clauses =>
            orb(use comp, expr_uses_var_handle use name clauses)
        | EBranch _ body rest => orb(use body, use rest)
        | ENoBranch => False
        | EBinder n ty rest =>
            orb (use ty)
              (match eqNat n name with
              | True => False
              | False => use rest
              end)
        | ENoBinder => False
        | EMultiMatch scruts rows =>
            orb (expr_uses_var_list use scruts)
              ((fix go_rows (xs : List (Pair (List (Pair Nat (List Nat))) Expr)) : Bool :=
                match xs with
                | Nil => False
                | Cons row rest =>
                    match row with
                    | MkPair _ body => orb(use body, go_rows rest)
                    end
                end) rows)
        | ESpan _ _ inner => use inner
        | EFallible container _ _ body => orb(use container, use body)
        | EOpen _ inner => use inner
        | ENamedCall head rows =>
            orb(use head,
              (fix scan (items : List (Pair Nat Expr)) : Bool :=
                match items with
                | Nil => False
                | Cons row rest =>
                    match row with
                    | MkPair _ value => orb(use value, scan rest)
                    end
                end) rows)
        end
    end;
