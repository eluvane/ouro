-- Both forms defer OS work until execution, even when used as values.
import "managed_temp_body.ouro";

def managed_temp_action (compiler : ManagedCompiler) (path : Maybe MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match path with
    | Nothing => managed_action compiler ([] : List MirValue)
        (fun (_ : List MirValue) (entered : ManagedState) => managed_temp_body compiler (Nothing MirValue) entered) state
    | Just value => managed_action compiler ([value] : List MirValue)
        (fun (captures : List MirValue) (entered : ManagedState) =>
          lower_bind MirValue ManagedResult (lower_single MirValue captures)
            (fun (captured : MirValue) => managed_temp_body compiler (Just MirValue captured) entered)) state end;

def managed_temp_value (compiler : ManagedCompiler) (in_directory : Bool) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match in_directory with
    | False => managed_temp_action compiler (Nothing MirValue) state
    | True => let caller : LowerState := managed_flow state in
        lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
          (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
            lower_bind ManagedResult ManagedResult
              (managed_temp_action compiler (Just MirValue (MirUse 1)) (managed_with_flow reserved (lower_empty_state 2)))
              (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf action after =>
                let function : MirFunction := managed_finish_function symbol
                  ([111,117,114,111,95,102,115,95,116,101,109,112,95,105,110] : List Nat)
                  ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) action after in
                managed_emit_callable compiler 3 symbol False ([] : List MirValue)
                  (managed_with_flow (managed_add_function function after) caller) end) end) end;

def managed_temp_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (in_directory : Bool) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match in_directory with
    | False => match arguments with
      | Nil => managed_temp_action compiler (Nothing MirValue) state
      | Cons _ _ => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end
    | True => lower_bind CoreTerm ManagedResult (lower_single CoreTerm arguments) (fun (term : CoreTerm) =>
        lower_bind ManagedResult ManagedResult (step scope term state)
          (fun (value : ManagedResult) => match value with | ManagedResultOf path next =>
            managed_temp_action compiler (Just MirValue path) next end)) end;
