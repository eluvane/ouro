-- Unary closures retain evaluated values. Each generated code function takes
-- (environment, argument); recursive closure environments contain a self edge.
import "managed_nat_arithmetic.ouro";
import "../../std/types.ouro";
import "../core.ouro";
import "lower_model.ouro";
import "mir_model.ouro";
import "x64.ouro";
import "pe_model.ouro";
import "codegen_model.ouro";
import "../primitive_model.ouro";
import "../file_check_model.ouro";
import "../pipeline_abi.ouro";
import "../file_elab_term.ouro";
import "../file_elab_lookup.ouro";
import "managed_model.ouro";
import "../erasure.ouro";
import "lower_types.ouro";

-- Eta expansion uses the checked, normalized telescope. Its body retains the
-- original global ID, so ordinary closure conversion reaches saturated lowering.
def managed_eta_expand : Nat -> CoreTerm -> CoreTerm -> Either NativeLowerError CoreTerm :=
  fix expand (fuel : Nat) (annotation : CoreTerm) (applied : CoreTerm)
      : Either NativeLowerError CoreTerm :=
    match fuel with | Z => Left NativeLowerError CoreTerm LowerResourceExhausted
    | S next => match piViewRaw annotation with
      | Nothing => Right NativeLowerError CoreTerm applied
      | Just product => match product with | MkPi domain codomain =>
          lower_map CoreTerm CoreTerm (fun (body : CoreTerm) => CLam domain body)
            (expand next codomain (CApp (lift 1 applied) (CRel 0))) end end end;

def managed_compile_closure (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (body : CoreTerm) (recursive : Bool) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind (Pair ManagedScope ManagedState) ManagedResult
          (managed_capture_scope scope 0 (managed_with_flow reserved (lower_empty_state 2)))
          (fun (captured : Pair ManagedScope ManagedState) => match captured with | MkPair environment entered =>
            lower_bind ManagedResult ManagedResult
              (step (Cons (Maybe MirValue) (Just MirValue (MirUse 1)) environment) body entered)
              (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value after =>
                let function : MirFunction := managed_finish_function symbol
                  ([111,117,114,111,95,109,97,110,97,103,101,100,95,108,97,109,98,100,97] : List Nat)
                  ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) value after in
                managed_emit_callable compiler 3 symbol recursive (managed_values scope)
                  (managed_with_flow (managed_add_function function after) caller) end) end) end);

def managed_fix (compiler : ManagedCompiler) (step : ManagedStep)
    : Nat -> ManagedScope -> CoreTerm -> ManagedState -> Either NativeLowerError ManagedResult :=
  fix find_argument (fuel : Nat) (scope : ManagedScope) (body : CoreTerm) (state : ManagedState)
      : Either NativeLowerError ManagedResult :=
    match fuel with | Z => Left NativeLowerError ManagedResult LowerResourceExhausted
    | S next => match lower_term_view body with
      | LowerLambdaTerm annotation inner => match is_sort_ann annotation with
        | True => find_argument next (Cons (Maybe MirValue) (Nothing MirValue) scope) inner state
        | False => managed_compile_closure compiler step scope inner True state end
      | LowerLocalTerm _ => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 10)
      | LowerApplyTerm _ _ => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 10)
      | LowerLetTerm _ _ _ => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 10)
      | LowerGlobalTerm _ => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 10)
      | LowerConstructorTerm _ _ _ => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 10)
      | LowerCaseTerm _ _ _ _ => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 10)
      | LowerOtherTerm _ => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 10) end end;

def managed_call (compiler : ManagedCompiler) (closure : MirValue) (argument : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_invoke compiler 3 closure argument state;

def managed_application (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (function : CoreTerm) (argument : CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (step scope function state)
      (fun (called : ManagedResult) => match called with | ManagedResultOf closure next =>
        lower_bind ManagedResult ManagedResult (step scope argument next)
          (fun (supplied : ManagedResult) => match supplied with | ManagedResultOf value after =>
            managed_call compiler closure value after end) end);

def managed_arguments (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    : List CoreTerm -> ManagedState -> Either NativeLowerError ManagedFields :=
  fix arguments (terms : List CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedFields :=
    match terms with | Nil => Right NativeLowerError ManagedFields (ManagedFieldsOf ([] : List MirValue) state)
    | Cons term rest => match managed_erased_argument compiler scope term with
      | True => arguments rest state
      | False => lower_bind ManagedResult ManagedFields (step scope term state)
          (fun (first : ManagedResult) => match first with | ManagedResultOf value next =>
            lower_map ManagedFields ManagedFields (fun (tail : ManagedFields) => match tail with
              | ManagedFieldsOf values after => ManagedFieldsOf (Cons MirValue value values) after end)
              (arguments rest next) end) end end;

def managed_constructor_application (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (fuel : Nat) (family : Nat) (index : Nat) (parameters : Nat) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind Unit ManagedResult
      (lower_require (leb_nat parameters (length CoreTerm arguments)) (LowerInvalidCall family))
      (fun (_ : Unit) => match lower_is_role (managed_compiler_entries compiler) (CInd family) PrimitiveNatRole with
        | True => managed_nat_constructor compiler step scope fuel family index parameters arguments state
        | False => lower_bind ManagedFields ManagedResult (managed_arguments compiler step scope (drop CoreTerm parameters arguments) state)
            (fun (fields : ManagedFields) => match fields with | ManagedFieldsOf values next =>
              managed_constructor compiler family (managed_bits MirUSize index) values next end) end);
