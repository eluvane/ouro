-- Path/file/eta helpers shared by the full and stdio term lowerers.
-- Host dispatch and saturated primitive application stay in each owner so the
-- stdio driver can keep a smaller process/http/temp cone.
import "managed_word.ouro",
  "../file_elab_lookup.ouro",
  "../string_nf_eval.ouro",
  "managed_closures.ouro",
  "managed_files.ouro",
  "managed_directories.ouro",
  "managed_fs_copy.ouro",
  "managed_realpath.ouro",
  "managed_fs_mutations.ouro",
  "managed_model.ouro",
  "../primitive_model.ouro",
  "lower_model.ouro",
  "../primitive_contracts.ouro",
  "managed_fs_kind.ouro",
  "managed_fs_predicates.ouro",
  "lower_boundary.ouro",
  "../file_elab_infer.ouro",
  "mir_model.ouro",
  "../file_check_model.ouro",
  "../constructor_closures.ouro";

def managed_path_intrinsic_value (compiler : ManagedCompiler) (primitive : PrimitiveId)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match managed_fs_mutation_operation primitive with
    | Just create => managed_fs_mutation_value compiler create state
    | Nothing => match primitive_id_equal primitive PrimitiveFileCopy with
      | True => managed_copy_value compiler state
      | False => match managed_directory_operation primitive with
        | Just listable => managed_directory_value compiler listable state
        | Nothing => match primitive_id_equal primitive PrimitiveFileRealpath with
          | True => managed_realpath_value compiler state
          | False => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive) end end end end;

def managed_file_intrinsic_value (compiler : ManagedCompiler) (primitive : PrimitiveId)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match managed_file_operation primitive with
    | Just writing => managed_file_value compiler writing state
    | Nothing => match primitive_id_equal primitive PrimitiveFileKind with
      | True => managed_fs_kind_value compiler state
      | False => match managed_fs_predicate_operation primitive with
        | Just directory => managed_fs_predicate_value compiler directory state
        | Nothing => managed_path_intrinsic_value compiler primitive state end end end;

def managed_eta_value (compiler : ManagedCompiler) (step : ManagedStep) (fuel : Nat)
    (id : Nat) (annotation : CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult
      (lower_normalize fuel (managed_compiler_environment compiler) annotation)
      (fun (normal : CoreTerm) => lower_bind CoreTerm ManagedResult
        (managed_eta_expand fuel normal (CConst id)) (fun (expanded : CoreTerm) =>
          lower_bind Unit ManagedResult
            (lower_check Unit id (check_term_checked_indexed fuel (managed_compiler_environment compiler)
              ([] : List CoreTerm) expanded annotation))
            (fun (_ : Unit) => step ([] : List (Maybe MirValue)) expanded state)));

def managed_partial_string_application (primitive : PrimitiveId) (arguments : List CoreTerm) : Bool :=
    match string_nf_operation primitive with
    | Nothing =>
        let count : Nat := length CoreTerm arguments in
        orb (andb(primitive_id_equal primitive PrimitiveFileRename, ltb_nat count 2))
          (andb(primitive_id_equal primitive PrimitiveFileReplace, ltb_nat count 3))
    | Just operation => ltb_nat(length CoreTerm arguments, length(Nat, string_nf_input_kinds operation)) end;

def managed_contract_saturated (contract : LowerContract) (arguments : List CoreTerm) : Bool :=
    match contract with | LowerContractOf _ _ parameters _ _ =>
      eqNat(length LowerType parameters, length CoreTerm arguments) end;

def managed_global_body (compiler : ManagedCompiler) (fuel : Nat) (id : Nat) : Either NativeLowerError CoreTerm :=
    let entries : List Entry := managed_compiler_entries compiler in
    match lookup_type id entries, lookup_const id entries with
    | Just annotation, Just body => lower_bind CoreTerm CoreTerm
        (lower_check CoreTerm id (close_constructors_checked_indexed fuel (managed_compiler_environment compiler) body))
        (fun (closed : CoreTerm) => lower_map Unit CoreTerm (fun (_ : Unit) => closed)
          (lower_check Unit id (check_term_checked_indexed fuel (managed_compiler_environment compiler)
            ([] : List CoreTerm) closed annotation)))
    | Nothing, Just _ => Left NativeLowerError CoreTerm (LowerUnknownGlobal id)
    | Just _, Nothing => Left NativeLowerError CoreTerm (LowerUnknownGlobal id)
    | Nothing, Nothing => Left NativeLowerError CoreTerm (LowerUnknownGlobal id) end;
