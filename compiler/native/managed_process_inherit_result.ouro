-- The result holds distinct OS status and complete U32 child exit status.
-- No captured stream is allocated. Job and raw argument nodes are released
-- while the result remains a managed root.
import "managed_process_inherit_arguments.ouro",
  "managed_process_result.ouro",
  "managed_model.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "pe_model.ouro",
  "managed_files_memory.ouro",
  "lower_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "../pipeline_abi.ouro",
  "managed_process_memory.ouro",
  "managed_startup_memory.ouro",
  "managed_nat.ouro",
  "managed_stdio.ouro";

def managed_process_inherit_cleanup (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_process_call compiler ManagedProcessInheritClose ([owner] : List MirValue) state)
      (fun (closed : ManagedResult) => match closed with | ManagedResultOf status next =>
        lower_bind ManagedResult ManagedResult (managed_startup_zero status next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay after =>
            lower_bind ManagedResult ManagedResult (managed_file_cleanup compiler scope after)
              (fun (released : ManagedResult) => match released with | ManagedResultOf freed finished =>
                managed_binary MirU8 MirAnd okay freed finished end) end) end);

def managed_process_inherit_result (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirU32 owner 104 state)
      (fun (loaded_error : ManagedResult) => match loaded_error with | ManagedResultOf error next =>
        lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordU32 error next)
          (fun (boxed_error : ManagedResult) => match boxed_error with | ManagedResultOf status after =>
            lower_bind ManagedResult ManagedResult (managed_load MirU32 owner 96 after)
              (fun (loaded_code : ManagedResult) => match loaded_code with | ManagedResultOf code entered =>
                lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordU32 code entered)
                  (fun (boxed_code : ManagedResult) => match boxed_code with | ManagedResultOf number counted =>
                    lower_bind ManagedResult ManagedResult (managed_process_pair compiler status number counted)
                      (fun (constructed : ManagedResult) => match constructed with | ManagedResultOf value paired =>
                        lower_bind ManagedResult ManagedResult (managed_process_inherit_cleanup compiler owner scope paired)
                          (fun (cleaned : ManagedResult) => match cleaned with | ManagedResultOf okay released =>
                            lower_bind Nat ManagedResult (managed_stdio_exit_symbol compiler)
                              (fun (exit : Nat) => lower_map ManagedState ManagedResult
                                (fun (finished : ManagedState) => ManagedResultOf value finished)
                                (managed_stdio_require exit okay released)) end) end) end) end) end) end);

def managed_process_inherit_owned (compiler : ManagedCompiler) (executable : MirValue) (arguments : MirValue)
    (owner : MirValue) (scope : ManagedFileScope) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (managed_process_inherit_push compiler owner scope executable state)
      (fun (pushed : ManagedState) => lower_bind ManagedState ManagedResult
        (managed_process_inherit_arguments compiler owner scope arguments pushed)
        (fun (supplied : ManagedState) => lower_bind ManagedResult ManagedResult
          (managed_process_call compiler ManagedProcessInheritRun ([owner] : List MirValue) supplied)
          (fun (ran : ManagedResult) => match ran with | ManagedResultOf status after =>
            -- Raw setup and wait failures are stored in the owner's result.
            -- The helper's return is only an invariant status, never child exit.
            lower_bind ManagedResult ManagedResult (managed_startup_zero status after)
              (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay checked =>
                lower_bind Nat ManagedResult (managed_stdio_exit_symbol compiler)
                  (fun (exit : Nat) => lower_bind ManagedState ManagedResult
                    (managed_stdio_require exit okay checked) (managed_process_inherit_result compiler owner scope)) end) end)));

def managed_process_inherit_body (compiler : ManagedCompiler) (executable : MirValue) (arguments : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_file_buffer compiler (ManagedFileScopeOf([] : List MirValue, Nothing MirValue))
      (managed_bits MirUSize 136) (managed_process_inherit_owned compiler executable arguments) state;
