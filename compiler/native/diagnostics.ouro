-- Native compilation diagnostics shared by the CLI and development drivers.
import "lower_source.ouro";
import "../../std/string.ouro";
def managed_driver_join (separator : String) : List String -> String :=
  fix join (items : List String) : String := match items with | Nil => "" | Cons item rest =>
    match rest with | Nil => item | Cons _ _ => prim_string_concat item (prim_string_concat separator (join rest)) end end;
def managed_driver_error (failure : NativeCodegenError) : String :=
    match failure with
    | NativeMirError mir_failure => match mir_failure with
      | MirResourceExhausted => "mir:resource" | MirDuplicateSymbol id => prim_string_concat "mir:symbol:" (prim_string_of_nat id)
      | MirUnknownSymbol id => prim_string_concat "mir:unknown:" (prim_string_of_nat id)
      | MirDuplicateLocal _ => "mir:duplicate-local" | MirUnknownLocal _ => "mir:unknown-local"
      | MirDuplicateBlock _ => "mir:duplicate-block" | MirUnknownBlock _ => "mir:unknown-block"
      | MirUninitialized _ _ => "mir:uninitialized" | MirTypeMismatch id => prim_string_concat "mir:type:" (prim_string_of_nat id)
      | MirInvalidLiteral => "mir:literal" | MirInvalidConversion _ => "mir:conversion" | MirInvalidAddress _ => "mir:address"
      | MirInvalidCall id => prim_string_concat "mir:call:" (prim_string_of_nat id)
      | MirInvalidReturn _ => "mir:return" | MirInvalidEntry _ => "mir:entry" | MirInvalidName _ => "mir:name"
      | MirInvalidDisplacement => "mir:displacement" | MirInvalidData id => prim_string_concat "mir:data:" (prim_string_of_nat id)
      | MirUnreachableBlock _ => "mir:unreachable"
      | MirGcCallMismatch caller target => managed_driver_join ":" (["mir:gc-call", prim_string_of_nat caller, prim_string_of_nat target] : List String)
      | MirGcUnsafeRuntime id => prim_string_concat "mir:gc-runtime:" (prim_string_of_nat id) end
    | NativeEncodingError _ => "x64:encoding" | NativePeError _ => "pe:layout"
    | NativeMissingSlot _ => "x64:slot" | NativeMissingLabel _ => "x64:label" | NativeCodeTooLarge => "x64:size" end;

def managed_driver_source_error (error : NativeSourceError) : String :=
    match error with
    | NativeSourceCheckError failure => match failure with | ErrCode code detail =>
        managed_driver_join ":" (["source", prim_string_of_nat code, prim_string_of_nat detail] : List String) end
    | NativeSourceLowerError failure => match failure with
      | LowerResourceExhausted => "lower:resource" | LowerDeclarationFailure id _ _ => prim_string_concat "lower:declaration:" (prim_string_of_nat id)
      | LowerMetadataMismatch id => prim_string_concat "lower:metadata:" (prim_string_of_nat id)
      | LowerBodyMismatch id => prim_string_concat "lower:body:" (prim_string_of_nat id)
      | LowerUnsupportedType _ => "lower:type" | LowerUnsupportedTerm tag => prim_string_concat "lower:term:" (prim_string_of_nat tag)
      | LowerUnsupportedPrimitive _ => "lower:primitive" | LowerUnknownGlobal id => prim_string_concat "lower:global:" (prim_string_of_nat id)
      | LowerUnboundLocal id => prim_string_concat "lower:local:" (prim_string_of_nat id)
      | LowerInvalidCall id => prim_string_concat "lower:call:" (prim_string_of_nat id)
      | LowerEffectMismatch => "lower:effect" | LowerInvalidEntry id => prim_string_concat "lower:entry:" (prim_string_of_nat id)
      | LowerMirFailure mir_error => prim_string_concat "lower:" (managed_driver_error (NativeMirError mir_error))
      | LowerBackendFailure backend_error => prim_string_concat "lower:" (managed_driver_error backend_error) end end;
