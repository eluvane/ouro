-- The directory/access probe uses the literal terminated path. Only after it
-- closes successfully do listing actions append the wildcard and enumerate.
import "managed_directories_entries.ouro";

def managed_directory_path_max : MirValue :=
    MirBits MirUSize (X64Words64 (X64Bytes32 253 255 255 127) codegen_zero);

def managed_directory_boolean (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (okay : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_boolean compiler okay state)
      (fun (boxed : ManagedResult) => match boxed with | ManagedResultOf value next =>
        managed_directory_complete compiler scope value next end);

def managed_directory_pattern_end (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (storage : MirValue) (wide : MirValue) (star : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul star (managed_bits MirUSize 2) state)
      (fun (located : ManagedResult) => match located with | ManagedResultOf first next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 1) next)
          (fun (high : ManagedResult) => match high with | ManagedResultOf second after =>
            lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 2) after)
              (fun (zero : ManagedResult) => match zero with | ManagedResultOf third final =>
                lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 3) final)
                  (fun (last : ManagedResult) => match last with | ManagedResultOf fourth entered =>
                    lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd star (managed_bits MirUSize 1) entered)
                      (fun (total : ManagedResult) => match total with | ManagedResultOf units finished =>
                        managed_directory_first compiler scope storage wide units count
                          (managed_emit_all ([MirStoreAt wide first (managed_bits MirU8 42),
                            MirStoreAt wide second (managed_bits MirU8 0), MirStoreAt wide third (managed_bits MirU8 0),
                            MirStoreAt wide fourth (managed_bits MirU8 0)] : List MirInstruction) finished) end) end) end) end) end);

def managed_directory_pattern_separator (wide : MirValue) (units : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul units (managed_bits MirUSize 2) state)
      (fun (located : ManagedResult) => match located with | ManagedResultOf first next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 1) next)
          (fun (high : ManagedResult) => match high with | ManagedResultOf second after =>
            managed_binary MirUSize MirAdd units (managed_bits MirUSize 1)
              (managed_emit_all ([MirStoreAt wide first (managed_bits MirU8 92),
                MirStoreAt wide second (managed_bits MirU8 0)] : List MirInstruction) after) end) end);

-- A bare drive designator refers to that drive's current directory.
def managed_directory_separator (pointer : MirValue) (units : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirU8 pointer 0 state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf low next =>
        lower_bind ManagedResult ManagedResult (managed_load MirU8 pointer 1 next)
          (fun (high : ManagedResult) => match high with | ManagedResultOf upper after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirEqual low (managed_bits MirU8 47) after)
              (fun (slash : ManagedResult) => match slash with | ManagedResultOf forward after_slash =>
                lower_bind ManagedResult ManagedResult (managed_compare MirEqual low (managed_bits MirU8 92) after_slash)
                  (fun (backslash : ManagedResult) => match backslash with | ManagedResultOf backward after_backslash =>
                    lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirOr forward backward after_backslash)
                      (fun (tested : ManagedResult) => match tested with | ManagedResultOf separator checked =>
                        lower_bind ManagedResult ManagedResult (managed_compare MirEqual low (managed_bits MirU8 58) checked)
                          (fun (colon : ManagedResult) => match colon with | ManagedResultOf designator after_colon =>
                            lower_bind ManagedResult ManagedResult (managed_compare MirEqual units (managed_bits MirUSize 2) after_colon)
                              (fun (short : ManagedResult) => match short with | ManagedResultOf pair after_short =>
                                lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd designator pair after_short)
                                  (fun (drive : ManagedResult) => match drive with | ManagedResultOf relative after_drive =>
                                    lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirOr separator relative after_drive)
                                      (fun (joined : ManagedResult) => match joined with | ManagedResultOf direct after_join =>
                                        lower_bind ManagedResult ManagedResult (managed_compare MirEqual upper (managed_bits MirU8 0) after_join)
                                          (fun (ascii : ManagedResult) => match ascii with | ManagedResultOf plain finished =>
                                            managed_binary MirU8 MirAnd direct plain finished end) end) end) end) end) end) end) end) end) end);

def managed_directory_pattern (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (storage : MirValue)
    (wide : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirSub units (managed_bits MirUSize 1) state)
      (fun (last : ManagedResult) => match last with | ManagedResultOf index next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul index (managed_bits MirUSize 2) next)
          (fun (located : ManagedResult) => match located with | ManagedResultOf offset after =>
            lower_bind ManagedResult ManagedResult
              (managed_fresh MirRawPtr (fun (local : Nat) => MirPointerAdd local wide offset) after)
              (fun (position : ManagedResult) => match position with | ManagedResultOf pointer final =>
                lower_bind ManagedResult ManagedResult (managed_directory_separator pointer units final)
                  (fun (tested : ManagedResult) => match tested with | ManagedResultOf separated checked =>
                    lower_bind ManagedResult ManagedResult (managed_string_choose MirUSize separated
                      (fun (current : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf units current))
                      (managed_directory_pattern_separator wide units) checked)
                      (fun (chosen : ManagedResult) => match chosen with | ManagedResultOf star finished =>
                        managed_directory_pattern_end compiler scope storage wide star count finished end) end) end) end) end);


def managed_directory_probe_closed (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (listable : Bool) (storage : MirValue) (wide : MirValue) (units : MirValue) (count : MirValue)
    (checked : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match listable with
    | True => lower_bind ManagedResult ManagedResult (managed_startup_zero checked state)
        (fun (tested : ManagedResult) => match tested with | ManagedResultOf directory next =>
          managed_directory_boolean compiler scope directory next end)
    | False => lower_bind ManagedState ManagedResult (managed_directory_status compiler scope checked state)
        (managed_directory_pattern compiler scope storage wide units count) end;

def managed_directory_probe_opened (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (listable : Bool) (storage : MirValue) (wide : MirValue) (units : MirValue) (count : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirUSize storage 0 state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bits next =>
        lower_bind ManagedResult ManagedResult (managed_convert MirRawPtr MirRawFromBits bits next)
          (fun (converted : ManagedResult) => match converted with | ManagedResultOf directory after =>
            lower_bind ManagedResult ManagedResult (managed_startup_pointer storage 8 after)
              (fun (located : ManagedResult) => match located with | ManagedResultOf scratch final =>
                lower_bind ManagedResult ManagedResult
                  (managed_directory_call compiler ManagedDirectoryCheck ([directory, scratch] : List MirValue) final)
                  (fun (inspected : ManagedResult) => match inspected with | ManagedResultOf checked entered =>
                    lower_bind ManagedResult ManagedResult
                      (managed_directory_call compiler ManagedDirectoryFileClose ([directory] : List MirValue) entered)
                      (fun (closed : ManagedResult) => match closed with | ManagedResultOf status finished =>
                        lower_bind ManagedState ManagedResult (managed_directory_status compiler scope status finished)
                          (managed_directory_probe_closed compiler scope listable storage wide units count checked) end) end) end) end) end);

def managed_directory_probe (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (listable : Bool)
    (storage : MirValue) (wide : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_directory_call compiler ManagedDirectoryOpen ([wide, units, storage] : List MirValue) state)
      (fun (opened : ManagedResult) => match opened with | ManagedResultOf status next =>
        match listable with
        | False => lower_bind ManagedState ManagedResult (managed_directory_status compiler scope status next)
            (managed_directory_probe_opened compiler scope listable storage wide units count)
        | True => lower_bind ManagedResult ManagedResult (managed_startup_zero status next)
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay after =>
              managed_string_choose MirManagedPtr okay
                (managed_directory_probe_opened compiler scope listable storage wide units count)
                (managed_directory_boolean compiler scope (managed_bits MirU8 0)) after end) end end);

def managed_directory_path_complete (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (listable : Bool)
    (storage : MirValue) (wide : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf actual next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual units next)
          (fun (compared : ManagedResult) => match compared with | ManagedResultOf exact after =>
            lower_bind ManagedState ManagedResult (managed_directory_require compiler scope exact after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_binary MirUSize MirMul units (managed_bits MirUSize 2) checked)
                (fun (located : ManagedResult) => match located with | ManagedResultOf first entered =>
                  lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 1) entered)
                    (fun (last : ManagedResult) => match last with | ManagedResultOf second final =>
                      lower_bind ManagedResult ManagedResult (managed_directory_call compiler ManagedDirectoryPathValid
                        ([wide, units, managed_bits MirUSize 1] : List MirValue)
                        (managed_emit_all ([MirStoreAt wide first (managed_bits MirU8 0),
                          MirStoreAt wide second (managed_bits MirU8 0)] : List MirInstruction) final))
                        (fun (tested : ManagedResult) => match tested with | ManagedResultOf valid finished =>
                          lower_bind ManagedState ManagedResult (managed_directory_require compiler scope valid finished)
                            (managed_directory_probe compiler scope listable storage wide units count) end) end) end)) end) end);

def managed_directory_path_fill (compiler : ManagedCompiler) (listable : Bool) (storage : MirValue)
    (source : MirValue) (bytes : MirValue) (units : MirValue) (count : MirValue)
    (wide : MirValue) (scope : ManagedDirectoryScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_directory_call compiler ManagedDirectoryToWide
      ([source, bytes, wide, units, count] : List MirValue) state)
      (fun (filled : ManagedResult) => match filled with | ManagedResultOf status next =>
        lower_bind ManagedState ManagedResult (managed_directory_status compiler scope status next)
          (managed_directory_path_complete compiler scope listable storage wide units count) end);

def managed_directory_path_allocate (compiler : ManagedCompiler) (listable : Bool) (storage : MirValue)
    (source : MirValue) (bytes : MirValue) (count : MirValue) (scope : ManagedDirectoryScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf units next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater units (managed_bits MirUSize 0) next)
          (fun (positive : ManagedResult) => match positive with | ManagedResultOf nonempty after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual units managed_directory_path_max after)
              (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd nonempty fits final)
                  (fun (combined : ManagedResult) => match combined with | ManagedResultOf valid checked =>
                    lower_bind ManagedState ManagedResult (managed_directory_require compiler scope valid checked)
                      (fun (entered : ManagedState) => lower_bind ManagedResult ManagedResult
                        (managed_binary MirUSize MirAdd units (managed_bits MirUSize 3) entered)
                        (fun (terminated : ManagedResult) => match terminated with | ManagedResultOf capacity after_capacity =>
                          lower_bind ManagedResult ManagedResult
                            (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) after_capacity)
                            (fun (sized : ManagedResult) => match sized with | ManagedResultOf allocation finished =>
                              managed_directory_buffer compiler scope allocation
                                (managed_directory_path_fill compiler listable storage source bytes units count) finished end) end)) end) end) end) end);

def managed_directory_path_copy (compiler : ManagedCompiler) (listable : Bool) (storage : MirValue)
    (path : MirValue) (bytes : MirValue) (count : MirValue) (source : MirValue) (scope : ManagedDirectoryScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult
      (managed_bytes_copy path (managed_bits MirUSize 40) source (managed_bits MirUSize 0) bytes state)
      (fun (copied : ManagedState) => lower_bind ManagedResult ManagedResult
        (managed_directory_call compiler ManagedDirectoryToWide
          ([source, bytes, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) copied)
        (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
          lower_bind ManagedState ManagedResult (managed_directory_status compiler scope status next)
            (managed_directory_path_allocate compiler listable storage source bytes count scope) end));

def managed_directory_path_storage (compiler : ManagedCompiler) (listable : Bool) (path : MirValue)
    (bytes : MirValue) (storage : MirValue) (scope : ManagedDirectoryScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_pointer storage 16 state)
      (fun (located : ManagedResult) => match located with | ManagedResultOf count next =>
        managed_directory_buffer compiler scope bytes (managed_directory_path_copy compiler listable storage path bytes count)
          (managed_emit_all ([MirStore storage (codegen_disp 0) (managed_bits MirUSize 0),
            MirStore storage (codegen_disp 8) (managed_bits MirUSize 0),
            MirStore storage (codegen_disp 16) (managed_bits MirUSize 0)] : List MirInstruction) next) end);

def managed_directory_body (compiler : ManagedCompiler) (listable : Bool) (path : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let scope : ManagedDirectoryScope := ManagedDirectoryScopeOf ([] : List MirValue)
      (Nothing (Pair ManagedDirectoryHelper MirValue)) in
    lower_bind ManagedResult ManagedResult (managed_string_size compiler path state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater bytes (managed_bits MirUSize 0) next)
          (fun (nonempty : ManagedResult) => match nonempty with | ManagedResultOf positive after =>
            lower_bind ManagedState ManagedResult (managed_directory_require compiler scope positive after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_compare MirLessEqual bytes
                  (MirBits MirUSize (X64Words64 (X64Bytes32 255 255 255 127) codegen_zero)) checked)
                (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                  lower_bind ManagedState ManagedResult (managed_directory_require compiler scope fits final)
                    (managed_directory_buffer compiler scope (managed_bits MirUSize (add managed_directory_name_buffer_offset managed_directory_name_capacity))
                      (managed_directory_path_storage compiler listable path bytes)) end)) end) end);
