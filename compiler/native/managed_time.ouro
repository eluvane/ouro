-- UTC is read when the action runs. The raw FILETIME buffer is released
-- before allocating the Nat and decimal String returned to ordinary code.
import "managed_stdio.ouro",
  "managed_string_decimal.ouro",
  "../../std/types.ouro",
  "managed_model.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "pe_model.ouro",
  "lower_model.ouro",
  "codegen_model.ouro",
  "../file_check_environment.ouro",
  "../file_check_model.ouro",
  "../primitive_model.ouro",
  "../primitive_check.ouro",
  "lower_types.ouro",
  "../primitive_contracts.ouro",
  "../primitive_registry_base.ouro",
  "managed_strings.ouro",
  "managed_string_ops.ouro",
  "managed_nat.ouro",
  "managed_actions.ouro";

inductive ManagedTimeRuntime : Type :=
  | ManagedTimeRuntimeOf : Nat -> Nat -> Nat -> Nat -> ManagedTimeRuntime;

def managed_time_query_name : List Nat :=
    ([114,97,119,95,119,105,110,100,111,119,115,95,119,97,108,108,95,116,105,109,101] : List Nat);

def managed_time_query_expected (compiler : ManagedCompiler) : Either NativeLowerError CoreTerm :=
    let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
    lower_from_primitive CoreTerm (CSort 0)
      (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
        primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
          primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveUSizeType bindings) (fun (size : CoreTerm) =>
            primitive_map CoreTerm CoreTerm (fun (word : CoreTerm) => CPi(CApp pointer size, CApp runtime word))
              (primitive_type_ref PrimitiveU32Type bindings)))));

def managed_time_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    match managed_stdio_has compiler PrimitiveTimeNow with
    | False => Right(NativeLowerError, List Nat, [] : List Nat)
    | True => lower_bind CoreTerm (List Nat) (managed_time_query_expected compiler) (fun (expected : CoreTerm) =>
        lower_bind Nat (List Nat) (managed_runtime_definition compiler fuel managed_time_query_name expected)
          (fun (query : Nat) =>
            (fix resolve (helpers : List ManagedStdioHelper) : Either NativeLowerError (List Nat) :=
              match helpers with | Nil => Right(NativeLowerError, List Nat, [query] : List Nat)
              | Cons helper rest => lower_bind CoreTerm (List Nat) (managed_stdio_expected compiler helper)
                  (fun (annotation : CoreTerm) => lower_bind Nat (List Nat)
                    (managed_runtime_definition compiler fuel (managed_stdio_helper_name helper) annotation)
                    (fun (id : Nat) => lower_map(List Nat, List Nat, Cons Nat id, resolve rest))) end)
              ([ManagedStdioAllocate, ManagedStdioRelease] : List ManagedStdioHelper))) end;

def managed_time_runtime (compiler : ManagedCompiler) : Either NativeLowerError ManagedTimeRuntime :=
    lower_bind Nat ManagedTimeRuntime (managed_stdio_contract compiler ManagedStdioAllocate) (fun (allocate : Nat) =>
      lower_bind Nat ManagedTimeRuntime (managed_stdio_contract compiler ManagedStdioRelease) (fun (release : Nat) =>
        lower_bind CoreTerm ManagedTimeRuntime (managed_time_query_expected compiler) (fun (expected : CoreTerm) =>
          lower_bind LowerContract ManagedTimeRuntime
            (managed_runtime_contract compiler primitive_default_fuel managed_time_query_name expected)
            (fun (query : LowerContract) => lower_map Nat ManagedTimeRuntime
              (ManagedTimeRuntimeOf allocate release (lower_contract_id query)) (managed_stdio_exit_symbol compiler)))));

-- 116444736000000000 ticks separate the documented 1601 and Unix epochs.
-- Construct the exact 64-bit constant as bytes, without a huge unary literal.
def managed_time_unix_epoch : MirValue :=
    MirBits(MirUSize, X64Words64(X64Bytes32 0 128 62 213, X64Bytes32 222 177 157 1));

def managed_time_milliseconds (negative : MirValue) (ticks : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_string_choose MirUSize negative
        (fun (before : ManagedState) => lower_bind ManagedResult ManagedResult
          (managed_binary MirUSize MirSub managed_time_unix_epoch ticks before)
          (fun (difference : ManagedResult) => match difference with | ManagedResultOf elapsed next =>
            managed_binary MirUSize MirAdd elapsed (managed_bits(MirUSize, sub(mul 100 100, 1))) next end))
        (managed_binary MirUSize MirSub ticks managed_time_unix_epoch) state)
      (fun (selected : ManagedResult) => match selected with | ManagedResultOf absolute next =>
        managed_binary MirUSize MirDiv absolute (managed_bits(MirUSize, mul 100 100)) next end);

-- Both query failure and release failure are observed after the release call.
-- The staging word is initialized even when the raw query preserves it.
def managed_time_read_allocated (runtime : ManagedTimeRuntime) (buffer : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match runtime with | ManagedTimeRuntimeOf _ release query exit =>
      lower_bind ManagedResult ManagedResult
        (managed_fresh MirU32 (fun (local : Nat) => MirCall MirMayGc (Just Nat local) (MirDirect query)
          ([buffer] : List MirValue))
          (managed_emit(MirStore(buffer, codegen_disp 0, managed_bits MirUSize 0), state)))
        (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
          lower_bind ManagedResult ManagedResult (managed_load MirUSize buffer 0 next)
            (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf ticks after_load =>
              lower_bind ManagedResult ManagedResult
                (managed_fresh MirU8 (fun (local : Nat) => MirCall MirMayGc (Just Nat local) (MirDirect release)
                  ([buffer] : List MirValue)) after_load)
                (fun (released : ManagedResult) => match released with | ManagedResultOf closed after_release =>
                  lower_bind ManagedState ManagedResult (managed_stdio_require exit closed after_release)
                    (fun (cleaned : ManagedState) => lower_bind ManagedResult ManagedResult
                      (managed_compare MirEqual status (managed_bits MirU32 0) cleaned)
                      (fun (tested : ManagedResult) => match tested with | ManagedResultOf success after_test =>
                        lower_map ManagedState ManagedResult
                          (fun (finished : ManagedState) => ManagedResultOf ticks finished)
                          (managed_stdio_require exit success after_test) end)) end) end) end) end;

def managed_time_read (runtime : ManagedTimeRuntime) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match runtime with | ManagedTimeRuntimeOf allocate _ _ exit =>
      lower_bind ManagedResult ManagedResult
        (managed_fresh MirRawPtr (fun (local : Nat) => MirCall MirMayGc (Just Nat local) (MirDirect allocate)
          ([managed_bits MirUSize 8, managed_bits MirUSize 8] : List MirValue)) state)
        (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf buffer next =>
          lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual buffer (managed_bits MirRawPtr 0) next)
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf present after =>
              lower_bind ManagedState ManagedResult (managed_stdio_require exit present after)
                (managed_time_read_allocated runtime buffer) end) end) end;

-- Milliseconds are rounded toward the preceding instant, including dates
-- before 1970. The negative branch cannot overflow: its distance is at most
-- the 1601-to-1970 offset, leaving room for the 9999-tick ceiling adjustment.
def managed_time_text (compiler : ManagedCompiler) (ticks : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_compare MirLess ticks managed_time_unix_epoch state)
      (fun (tested : ManagedResult) => match tested with | ManagedResultOf negative next =>
        lower_bind ManagedResult ManagedResult (managed_time_milliseconds negative ticks next)
          (fun (converted : ManagedResult) => match converted with | ManagedResultOf milliseconds after =>
            lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordUSize milliseconds after)
              (fun (boxed : ManagedResult) => match boxed with | ManagedResultOf natural after_box =>
                lower_bind ManagedResult ManagedResult (managed_string_of_nat_value compiler natural after_box)
                  (fun (decimal : ManagedResult) => match decimal with | ManagedResultOf text after_text =>
                    managed_string_choose MirManagedPtr negative
                      (fun (signed : ManagedState) => lower_bind ManagedResult ManagedResult
                        (managed_string_literal compiler ([45] : List Nat) signed)
                        (fun (prefix : ManagedResult) => match prefix with | ManagedResultOf minus after_prefix =>
                          managed_string_concat_values compiler minus text after_prefix end))
                      (fun (positive : ManagedState) => Right NativeLowerError ManagedResult
                        (ManagedResultOf text positive)) after_text end) end) end) end);

def managed_time_body (compiler : ManagedCompiler) (runtime : ManagedTimeRuntime)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_nat_helper ([111,117,114,111,95,116,105,109,101,95,110,111,119] : List Nat)
        ([] : List MirLocal) ([] : List MirValue) MirUSize (managed_time_read runtime) state)
      (fun (read : ManagedResult) => match read with | ManagedResultOf ticks next =>
        managed_time_text compiler ticks next end);

def managed_time_action (compiler : ManagedCompiler) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedTimeRuntime ManagedResult (managed_time_runtime compiler) (fun (runtime : ManagedTimeRuntime) =>
      managed_action compiler ([] : List MirValue)
        (fun (_ : List MirValue) (entered : ManagedState) => managed_time_body compiler runtime entered) state);

def managed_time_primitive (compiler : ManagedCompiler) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind Unit ManagedResult (lower_require(nullb CoreTerm arguments, LowerInvalidCall 0))
      (fun (_ : Unit) => managed_time_action compiler state);
