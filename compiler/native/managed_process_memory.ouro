-- Helpers require checked ordinary bodies, complete pointee signatures and
-- the same raw lowering contract. Managed captures never enter raw storage.
import "managed_files_memory.ouro",
  "managed_string_lists.ouro",
  "managed_runtime_symbols.ouro",
  "managed_model.ouro",
  "lower_model.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "pe_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "../primitive_check.ouro",
  "lower_types.ouro",
  "../primitive_contracts.ouro",
  "../primitive_registry_base.ouro",
  "managed_stdio.ouro",
  "managed_startup_memory.ouro",
  "lower_loop.ouro";

inductive ManagedProcessHelper : Type :=
  | ManagedProcessAllocate : ManagedProcessHelper | ManagedProcessRelease : ManagedProcessHelper
  | ManagedProcessPush : ManagedProcessHelper | ManagedProcessRun : ManagedProcessHelper
  | ManagedProcessClose : ManagedProcessHelper
  | ManagedProcessInheritPush : ManagedProcessHelper
  | ManagedProcessInheritRun : ManagedProcessHelper
  | ManagedProcessInheritClose : ManagedProcessHelper
  | ManagedProcessBoundedInput : ManagedProcessHelper
  | ManagedProcessBoundedRun : ManagedProcessHelper
  | ManagedProcessBoundedClose : ManagedProcessHelper;

def managed_process_helper_name (helper : ManagedProcessHelper) : List Nat :=
    match helper with
    | ManagedProcessAllocate => managed_file_helper_name ManagedFileAllocate
    | ManagedProcessRelease => managed_file_helper_name ManagedFileRelease
    | ManagedProcessInheritPush => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,105,110,104,101,114,105,116,95,112,117,115,104] : List Nat)
    | ManagedProcessPush => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,109,97,110,97,103,101,100,95,112,117,115,104] : List Nat)
    | ManagedProcessInheritRun => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,105,110,104,101,114,105,116,95,114,117,110] : List Nat)
    | ManagedProcessRun => managed_runtime_symbol "raw_windows_process_managed_run"
    | ManagedProcessInheritClose => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,105,110,104,101,114,105,116,95,99,108,111,115,101] : List Nat)
    | ManagedProcessBoundedInput => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,98,111,117,110,100,101,100,95,105,110,112,117,116] : List Nat)
    | ManagedProcessBoundedRun => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,98,111,117,110,100,101,100,95,114,117,110] : List Nat)
    | ManagedProcessBoundedClose => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,98,111,117,110,100,101,100,95,99,108,111,115,101] : List Nat)
    | ManagedProcessClose => ([114,97,119,95,119,105,110,100,111,119,115,95,112,114,111,99,101,115,115,95,109,97,110,97,103,101,100,95,99,108,111,115,101] : List Nat)
    end;

def managed_process_expected (compiler : ManagedCompiler) (helper : ManagedProcessHelper)
    : Either NativeLowerError CoreTerm :=
    match helper with
    | ManagedProcessAllocate => managed_file_expected compiler ManagedFileAllocate
    | ManagedProcessRelease => managed_file_expected compiler ManagedFileRelease
    | ManagedProcessPush =>
        let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
        lower_from_primitive CoreTerm (CSort 0)
          (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
            primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
              primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU8Type bindings) (fun (byte : CoreTerm) =>
                primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU32Type bindings) (fun (word : CoreTerm) =>
                  primitive_map CoreTerm CoreTerm (fun (size : CoreTerm) =>
                    primitive_arrow([CApp pointer byte, CApp pointer byte, size] : List CoreTerm, CApp runtime word))
                    (primitive_type_ref PrimitiveUSizeType bindings))))))
    | ManagedProcessInheritPush =>
        let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
        lower_from_primitive CoreTerm (CSort 0)
          (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
            primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
              primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU8Type bindings) (fun (byte : CoreTerm) =>
                primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU32Type bindings) (fun (word : CoreTerm) =>
                  primitive_map CoreTerm CoreTerm (fun (size : CoreTerm) =>
                    primitive_arrow([CApp pointer byte, CApp pointer byte, size] : List CoreTerm, CApp runtime word))
                    (primitive_type_ref PrimitiveUSizeType bindings))))))
    | ManagedProcessBoundedInput =>
        let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
        lower_from_primitive CoreTerm (CSort 0)
          (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
            primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
              primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU8Type bindings) (fun (byte : CoreTerm) =>
                primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU32Type bindings) (fun (word : CoreTerm) =>
                  primitive_map CoreTerm CoreTerm (fun (size : CoreTerm) =>
                    primitive_arrow([CApp pointer byte, CApp pointer byte, size] : List CoreTerm, CApp runtime word))
                    (primitive_type_ref PrimitiveUSizeType bindings))))))
    | ManagedProcessInheritRun => managed_file_expected compiler ManagedFileClose
    | ManagedProcessInheritClose => managed_file_expected compiler ManagedFileClose
    | ManagedProcessRun => managed_file_expected compiler ManagedFileClose
    | ManagedProcessBoundedRun => managed_file_expected compiler ManagedFileClose
    | ManagedProcessBoundedClose => managed_file_expected compiler ManagedFileClose
    | ManagedProcessClose => managed_file_expected compiler ManagedFileClose end;

def managed_process_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    let capture : List ManagedProcessHelper := match managed_stdio_has compiler PrimitiveProcessCapture with
      | False => [] | True => [ManagedProcessAllocate, ManagedProcessRelease, ManagedProcessPush,
          ManagedProcessRun, ManagedProcessClose] end in
    let inherited : List ManagedProcessHelper := match managed_stdio_has compiler PrimitiveProcessInherit with
      | False => [] | True => [ManagedProcessAllocate, ManagedProcessRelease, ManagedProcessInheritPush,
          ManagedProcessInheritRun, ManagedProcessInheritClose] end in
    let bounded : List ManagedProcessHelper := match managed_stdio_has compiler PrimitiveProcessBounded with
      | False => [] | True => [ManagedProcessAllocate, ManagedProcessRelease, ManagedProcessInheritPush,
          ManagedProcessBoundedInput, ManagedProcessBoundedRun, ManagedProcessBoundedClose] end in
    (fix resolve (helpers : List ManagedProcessHelper) : Either NativeLowerError (List Nat) :=
      match helpers with | Nil => Right(NativeLowerError, List Nat, [] : List Nat)
      | Cons helper rest => lower_bind CoreTerm (List Nat) (managed_process_expected compiler helper)
          (fun (expected : CoreTerm) => lower_bind Nat (List Nat)
            (managed_runtime_definition compiler fuel (managed_process_helper_name helper) expected)
            (fun (id : Nat) => lower_map(List Nat, List Nat, Cons Nat id, resolve rest))) end)
      (append ManagedProcessHelper bounded (append ManagedProcessHelper capture inherited));

def managed_process_call (compiler : ManagedCompiler) (helper : ManagedProcessHelper)
    (arguments : List MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (managed_process_expected compiler helper) (fun (expected : CoreTerm) =>
      lower_bind LowerContract ManagedResult
        (managed_runtime_contract compiler primitive_default_fuel (managed_process_helper_name helper) expected)
        (fun (contract : LowerContract) =>
          let typ : MirType := match helper with
            | ManagedProcessAllocate => MirRawPtr | ManagedProcessRelease => MirU8
            | ManagedProcessPush => MirU32 | ManagedProcessRun => MirU32 | ManagedProcessClose => MirU32
            | ManagedProcessInheritPush => MirU32 | ManagedProcessInheritRun => MirU32
            | ManagedProcessInheritClose => MirU32
            | ManagedProcessBoundedInput => MirU32 | ManagedProcessBoundedRun => MirU32 | ManagedProcessBoundedClose => MirU32 end in
          managed_fresh typ (fun (local : Nat) =>
            MirCall(MirMayGc, Just Nat local, MirDirect (lower_contract_id contract), arguments)) state));

def managed_process_cleanup (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_process_call compiler ManagedProcessClose ([owner] : List MirValue) state)
      (fun (closed : ManagedResult) => match closed with | ManagedResultOf status next =>
        lower_bind ManagedResult ManagedResult (managed_startup_zero status next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay after =>
            lower_bind ManagedResult ManagedResult (managed_file_cleanup compiler scope after)
              (fun (released : ManagedResult) => match released with | ManagedResultOf freed finished =>
                managed_binary MirU8 MirAnd okay freed finished end) end) end);

def managed_process_require (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (condition : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind Nat ManagedState (managed_stdio_exit_symbol compiler) (fun (exit : Nat) =>
      lower_bind LowerLoopBlocks ManagedState (lower_loop_blocks (managed_flow state))
        (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt valid invalid _ flow =>
          lower_map ManagedResult ManagedState (fun (cleaned : ManagedResult) => match cleaned with
            | ManagedResultOf _ after => managed_switch_block valid MirTrap
                (managed_emit (MirCall MirMayGc (Nothing Nat) (MirDirect exit)
                  ([managed_bits MirU32 73] : List MirValue)) after) end)
            (managed_process_cleanup compiler owner scope
              (managed_with_flow(state, lower_switch_block invalid (MirBranch condition valid invalid) flow))) end));

def managed_process_status (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (status : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_startup_zero status state)
      (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay next =>
        managed_process_require compiler owner scope okay next end);
