-- A no-follow query preserves the existing 0/1/2/3 result contract. The
-- captured String is live through conversion; all raw pages are scoped.
import "managed_startup_environment.ouro";

def managed_fs_kind_query_name : List Nat :=
    ([114,97,119,95,119,105,110,100,111,119,115,95,102,105,108,101,95,109,101,116,97,100,97,116,97] : List Nat);

def managed_fs_kind_query_expected (compiler : ManagedCompiler) : Either NativeLowerError CoreTerm :=
    let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
    lower_from_primitive CoreTerm (CSort 0)
      (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
        primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
          primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU8Type bindings) (fun (byte : CoreTerm) =>
            primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveUSizeType bindings) (fun (size : CoreTerm) =>
              primitive_map CoreTerm CoreTerm (fun (word : CoreTerm) =>
                primitive_arrow ([CApp pointer byte, size, CApp pointer byte] : List CoreTerm) (CApp runtime word))
                (primitive_type_ref PrimitiveU32Type bindings))))));

def managed_fs_kind_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    match orb (managed_stdio_has compiler PrimitiveFileKind)
      (orb (managed_stdio_has compiler PrimitiveFileExists) (managed_stdio_has compiler PrimitiveFileIsDirectory)) with
    | False => Right NativeLowerError (List Nat) ([] : List Nat)
    | True => lower_bind CoreTerm (List Nat) (managed_fs_kind_query_expected compiler) (fun (expected : CoreTerm) =>
        lower_bind Nat (List Nat) (managed_runtime_definition compiler fuel managed_fs_kind_query_name expected)
          (fun (query : Nat) =>
            (fix resolve (helpers : List ManagedStartupHelper) : Either NativeLowerError (List Nat) :=
              match helpers with | Nil => Right NativeLowerError (List Nat) ([query] : List Nat)
              | Cons helper rest => lower_bind CoreTerm (List Nat) (managed_startup_expected compiler helper)
                  (fun (annotation : CoreTerm) => lower_bind Nat (List Nat)
                    (managed_runtime_definition compiler fuel (managed_startup_helper_name helper) annotation)
                    (fun (id : Nat) => lower_map (List Nat) (List Nat) (Cons Nat id) (resolve rest))) end)
              ([ManagedStartupAllocate, ManagedStartupRelease, ManagedStartupToWide] : List ManagedStartupHelper))) end;

def managed_fs_kind_attributes (compiler : ManagedCompiler) (buffer : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirU32 buffer 0 state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf attributes next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirU32 MirAnd attributes (managed_bits MirU32 1024) next)
          (fun (masked : ManagedResult) => match masked with | ManagedResultOf reparse after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual reparse (managed_bits MirU32 0) after)
              (fun (tested : ManagedResult) => match tested with | ManagedResultOf link final =>
                managed_string_choose MirManagedPtr link (managed_nat_literal_value compiler 3)
                  (fun (ordinary : ManagedState) => lower_bind ManagedResult ManagedResult
                    (managed_binary MirU32 MirAnd attributes (managed_bits MirU32 16) ordinary)
                    (fun (marked : ManagedResult) => match marked with | ManagedResultOf directory after_mask =>
                      lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual directory (managed_bits MirU32 0) after_mask)
                        (fun (checked : ManagedResult) => match checked with | ManagedResultOf is_directory after_check =>
                          managed_string_choose MirManagedPtr is_directory (managed_nat_literal_value compiler 2)
                            (managed_nat_literal_value compiler 1) after_check end) end)) final end) end) end);

-- Metadata is unspecified on query failure. Only a zero status permits the
-- attribute load; the established unknown kind is returned for other OS errors.
def managed_fs_metadata_read (compiler : ManagedCompiler)
    (present : MirValue -> ManagedState -> Either NativeLowerError ManagedResult)
    (missing : ManagedState -> Either NativeLowerError ManagedResult) (wide : MirValue) (units : MirValue)
    (buffer : MirValue) (scope : ManagedStartupScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (managed_fs_kind_query_expected compiler) (fun (expected : CoreTerm) =>
      lower_bind LowerContract ManagedResult
        (managed_runtime_contract compiler primitive_default_fuel managed_fs_kind_query_name expected)
        (fun (contract : LowerContract) => lower_bind ManagedResult ManagedResult
          (managed_fresh MirU32 (fun (local : Nat) => MirCall MirMayGc (Just Nat local)
            (MirDirect (lower_contract_id contract)) ([wide, units, buffer] : List MirValue)) state)
          (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
            lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual status (managed_bits MirU32 87) next)
              (fun (valid : ManagedResult) => match valid with | ManagedResultOf parameter after =>
                managed_startup_check compiler scope parameter
                  (fun (entered : ManagedState) => lower_bind ManagedResult ManagedResult
                    (managed_startup_zero status entered)
                    (fun (checked : ManagedResult) => match checked with | ManagedResultOf success final =>
                      managed_string_choose MirManagedPtr success (present buffer)
                        missing final end)) after end) end)));

def managed_fs_kind_read (compiler : ManagedCompiler) (wide : MirValue) (units : MirValue)
    (buffer : MirValue) (scope : ManagedStartupScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_fs_metadata_read compiler (managed_fs_kind_attributes compiler)
      (managed_nat_literal_value compiler 0) wide units buffer scope state;

def managed_fs_kind_query (compiler : ManagedCompiler) (scope : ManagedStartupScope)
    (wide : MirValue) (units : MirValue) (_count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_startup_buffer compiler scope (managed_bits MirUSize 36)
      (managed_fs_kind_read compiler wide units) state;

def managed_fs_kind_storage (compiler : ManagedCompiler) (value : MirValue) (bytes : MirValue)
    (count : MirValue) (scope : ManagedStartupScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_startup_buffer compiler scope bytes
      (managed_startup_name_copy compiler (managed_fs_kind_query compiler) value bytes count) state;

def managed_fs_path_body (compiler : ManagedCompiler)
    (missing : ManagedState -> Either NativeLowerError ManagedResult)
    (storage : MirValue -> MirValue -> MirValue -> ManagedStartupScope -> ManagedState -> Either NativeLowerError ManagedResult) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let scope : ManagedStartupScope := ManagedStartupScopeOf ([] : List MirValue) (Nothing MirValue) in
    lower_bind ManagedResult ManagedResult (managed_string_size compiler value state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual bytes (managed_bits MirUSize 0) next)
          (fun (checked : ManagedResult) => match checked with | ManagedResultOf empty after =>
            managed_string_choose MirManagedPtr empty missing
              (fun (nonempty : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_compare MirLessEqual bytes managed_startup_int_max nonempty)
                (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                  managed_startup_check compiler scope fits
                    (managed_startup_buffer compiler scope (managed_bits MirUSize 8)
                      (storage value bytes)) final end)) after end) end);

def managed_fs_kind_body (compiler : ManagedCompiler) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_fs_path_body compiler (managed_nat_literal_value compiler 0)
      (managed_fs_kind_storage compiler) value state;

def managed_fs_kind_action (compiler : ManagedCompiler) (path : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_action compiler ([path] : List MirValue)
      (fun (captures : List MirValue) (entered : ManagedState) =>
        lower_bind MirValue ManagedResult (lower_single MirValue captures)
          (fun (value : MirValue) => managed_fs_kind_body compiler value entered)) state;

def managed_fs_kind_value (compiler : ManagedCompiler) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_fs_kind_action compiler (MirUse 1) (managed_with_flow reserved (lower_empty_state 2)))
          (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf action after =>
            let function : MirFunction := managed_finish_function symbol
              ([111,117,114,111,95,102,115,95,107,105,110,100] : List Nat)
              ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) action after in
            managed_emit_callable compiler 3 symbol False ([] : List MirValue)
              (managed_with_flow (managed_add_function function after) caller) end) end);

def managed_fs_kind_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (arguments : List CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (lower_single CoreTerm arguments) (fun (term : CoreTerm) =>
      lower_bind ManagedResult ManagedResult (step scope term state)
        (fun (value : ManagedResult) => match value with | ManagedResultOf path next =>
          managed_fs_kind_action compiler path next end));
