-- The three-path publication primitive reuses checked path conversion and its
-- scoped cleanup. Its Nat result retains the OS status for Ouro recovery.
import "managed_fs_rename.ouro";
import "lower_raw.ouro";
import "../../std/types.ouro";
import "managed_model.ouro";
import "mir_model.ouro";
import "lower_model.ouro";
import "../file_check_model.ouro";
import "../primitive_model.ouro";
import "../primitive_check.ouro";
import "lower_types.ouro";
import "../primitive_contracts.ouro";
import "../primitive_registry_base.ouro";
import "managed_stdio.ouro";
import "managed_startup_memory.ouro";
import "managed_nat.ouro";
import "managed_fs_copy.ouro";
import "managed_actions.ouro";

def managed_replace_name : List Nat :=
    [114,97,119,95,119,105,110,100,111,119,115,95,102,105,108,101,95,114,101,112,108,97,99,101];

def managed_replace_expected (compiler : ManagedCompiler) : Either NativeLowerError CoreTerm :=
    let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
    lower_from_primitive CoreTerm (CSort 0)
      (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
        primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
          primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU8Type bindings) (fun (byte : CoreTerm) =>
            primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveUSizeType bindings) (fun (size : CoreTerm) =>
              primitive_map CoreTerm CoreTerm (fun (word : CoreTerm) =>
                let path : CoreTerm := CApp pointer byte in
                primitive_arrow ([path, size, path, size, path, size] : List CoreTerm) (CApp runtime word))
                (primitive_type_ref PrimitiveU32Type bindings))))));

def managed_replace_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    match managed_stdio_has compiler PrimitiveFileReplace with
    | False => Right NativeLowerError (List Nat) []
    | True => lower_bind CoreTerm (List Nat) (managed_replace_expected compiler) (fun (expected : CoreTerm) =>
        lower_bind Nat (List Nat) (managed_runtime_definition compiler fuel managed_replace_name expected)
          (fun (replace : Nat) =>
            (fix helpers (rest : List ManagedStartupHelper) : Either NativeLowerError (List Nat) :=
              match rest with | Nil => Right NativeLowerError (List Nat) [replace]
              | Cons helper tail => lower_bind CoreTerm (List Nat) (managed_startup_expected compiler helper)
                  (fun (annotation : CoreTerm) => lower_bind Nat (List Nat)
                    (managed_runtime_definition compiler fuel (managed_startup_helper_name helper) annotation)
                    (fun (id : Nat) => lower_map (List Nat) (List Nat) (Cons Nat id) (helpers tail))) end)
              ([ManagedStartupAllocate, ManagedStartupRelease, ManagedStartupToWide] : List ManagedStartupHelper))) end;

def managed_publication_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    lower_bind (List Nat) (List Nat) (managed_rename_roots compiler fuel) (fun (renames : List Nat) =>
      lower_map (List Nat) (List Nat) (append Nat renames) (managed_replace_roots compiler fuel));

def managed_replace_query (compiler : ManagedCompiler) (source : MirValue) (source_units : MirValue)
    (stage : MirValue) (stage_units : MirValue) (_scope : ManagedStartupScope)
    (backup : MirValue) (backup_units : MirValue) (_count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (managed_replace_expected compiler) (fun (expected : CoreTerm) =>
      lower_bind LowerContract ManagedResult
        (managed_runtime_contract compiler primitive_default_fuel managed_replace_name expected)
        (fun (contract : LowerContract) => lower_bind ManagedResult ManagedResult
          (managed_fresh MirU32 (fun (local : Nat) => MirCall MirMayGc (Just Nat local)
            (MirDirect (lower_contract_id contract))
            ([source, source_units, stage, stage_units, backup, backup_units] : List MirValue)) state)
          (fun (replaced : ManagedResult) => match replaced with | ManagedResultOf status next =>
            managed_nat_from_word compiler PrimitiveWordU32 status next end)));

def managed_replace_stage (compiler : ManagedCompiler) (backup : MirValue)
    (source : MirValue) (source_units : MirValue) (scope : ManagedStartupScope)
    (stage : MirValue) (stage_units : MirValue) (_count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_copy_path compiler (managed_replace_query compiler source source_units stage stage_units) backup scope state;

def managed_replace_source (compiler : ManagedCompiler) (stage : MirValue) (backup : MirValue)
    (scope : ManagedStartupScope) (source : MirValue) (source_units : MirValue) (_count : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_copy_path compiler (managed_replace_stage compiler backup source source_units) stage scope state;

def managed_replace_captured (compiler : ManagedCompiler) (values : List MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match values with | Nil => Left NativeLowerError ManagedResult (LowerInvalidCall 0)
    | Cons source rest => match rest with | Nil => Left NativeLowerError ManagedResult (LowerInvalidCall 0)
      | Cons stage more => match more with | Nil => Left NativeLowerError ManagedResult (LowerInvalidCall 0)
        | Cons backup extra => match extra with
          | Nil => managed_copy_path compiler (managed_replace_source compiler stage backup) source
              (ManagedStartupScopeOf ([] : List MirValue) (Nothing MirValue)) state
          | Cons _ _ => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end end end end;

def managed_replace_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (arguments : List CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_three ManagedResult arguments (fun (source : CoreTerm) (stage : CoreTerm) (backup : CoreTerm) =>
      lower_bind ManagedResult ManagedResult (step scope source state)
        (fun (original : ManagedResult) => match original with | ManagedResultOf from next =>
          lower_bind ManagedResult ManagedResult (step scope stage next)
            (fun (candidate : ManagedResult) => match candidate with | ManagedResultOf to after =>
              lower_bind ManagedResult ManagedResult (step scope backup after)
                (fun (saved : ManagedResult) => match saved with | ManagedResultOf recovery entered =>
                  managed_action compiler ([from, to, recovery] : List MirValue)
                    (managed_replace_captured compiler) entered end) end) end));
