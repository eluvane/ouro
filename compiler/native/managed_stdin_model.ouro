-- Stdin uses checked raw helpers, one bounded staging page and an owned String.
import "managed_stdio.ouro";
import "managed_files_memory.ouro";
import "../../std/types.ouro";
import "managed_model.ouro";
import "mir_model.ouro";
import "x64.ouro";
import "pe_model.ouro";
import "lower_model.ouro";
import "codegen_model.ouro";
import "../file_check_environment.ouro";
import "../file_check_model.ouro";
import "../primitive_model.ouro";
import "../primitive_check.ouro";
import "lower_types.ouro";
import "../primitive_contracts.ouro";
import "../primitive_registry_base.ouro";
import "lower_loop.ouro";

inductive ManagedStdinRuntime : Type :=
  | ManagedStdinRuntimeOf : Nat -> Nat -> Nat -> Nat -> ManagedStdinRuntime;

def managed_stdin_runtime (compiler : ManagedCompiler) : Either NativeLowerError ManagedStdinRuntime :=
    lower_bind Nat ManagedStdinRuntime (managed_stdio_contract compiler ManagedStdioAllocate) (fun (allocate : Nat) =>
      lower_bind Nat ManagedStdinRuntime (managed_stdio_contract compiler ManagedStdioRelease) (fun (release : Nat) =>
        lower_bind CoreTerm ManagedStdinRuntime (managed_stdin_reader_expected compiler) (fun (expected : CoreTerm) =>
          lower_bind LowerContract ManagedStdinRuntime
            (managed_runtime_contract compiler primitive_default_fuel managed_stdin_reader_name expected)
            (fun (reader : LowerContract) => lower_map Nat ManagedStdinRuntime
              (ManagedStdinRuntimeOf allocate release (lower_contract_id reader)) (managed_stdio_exit_symbol compiler)))));

-- Failure attempts the only owned raw release before exiting. Successful
-- reads leave that release to the normal scope exit. Both outcomes use 73.
def managed_stdin_require (runtime : ManagedStdinRuntime) (buffer : MirValue)
    (condition : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    match runtime with | ManagedStdinRuntimeOf _ release _ exit =>
      lower_bind LowerLoopBlocks ManagedState (lower_loop_blocks (managed_flow state))
        (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt valid invalid _ flow =>
          lower_map ManagedResult ManagedState (fun (released : ManagedResult) => match released with
            | ManagedResultOf _ after => managed_switch_block valid MirTrap
                (managed_emit (MirCall MirMayGc (Nothing Nat) (MirDirect exit)
                  ([managed_bits MirU32 73] : List MirValue)) after) end)
            (managed_fresh MirU8 (fun (local : Nat) => MirCall MirMayGc (Just Nat local)
              (MirDirect release) ([buffer] : List MirValue))
              (managed_switch_block invalid (MirBranch condition valid invalid) (managed_with_flow state flow))) end) end;

def managed_stdin_close (runtime : ManagedStdinRuntime) (buffer : MirValue)
    (value : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match runtime with | ManagedStdinRuntimeOf _ release _ exit =>
      lower_bind ManagedResult ManagedResult
        (managed_fresh MirU8 (fun (local : Nat) => MirCall MirMayGc (Just Nat local)
          (MirDirect release) ([buffer] : List MirValue)) state)
        (fun (released : ManagedResult) => match released with | ManagedResultOf okay next =>
          lower_map ManagedState ManagedResult (fun (after : ManagedState) => ManagedResultOf value after)
            (managed_stdio_require exit okay next) end) end;
