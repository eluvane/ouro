-- Names are captured as managed byte strings. Each invocation performs a
-- fresh Unicode lookup with one sizing call and one exact-capacity read.
import "managed_startup_strings.ouro";
import "mir_model.ouro";
import "x64.ouro";
import "codegen_model.ouro";
import "managed_model.ouro";
import "pe_model.ouro";
import "lower_model.ouro";
import "../file_check_environment.ouro";
import "../file_check_model.ouro";
import "../primitive_model.ouro";
import "../pipeline_abi.ouro";
import "managed_startup_memory.ouro";
import "managed_strings.ouro";
import "managed_actions.ouro";
import "lower_ops.ouro";
import "managed_string_ops.ouro";

def managed_startup_int_max : MirValue :=
    MirBits MirUSize (X64Words64 (X64Bytes32 255 255 255 127) codegen_zero);

def managed_startup_environment_value (compiler : ManagedCompiler) (scope : ManagedStartupScope)
    (wide : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_string compiler scope wide units count state)
      (fun (copied : ManagedResult) => match copied with | ManagedResultOf value next =>
        managed_startup_optional compiler (Just MirValue value) next end);

def managed_startup_environment_complete (compiler : ManagedCompiler) (scope : ManagedStartupScope)
    (wide : MirValue) (capacity : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (read : ManagedResult) => match read with | ManagedResultOf units next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd units (managed_bits MirUSize 1) next)
          (fun (terminated : ManagedResult) => match terminated with | ManagedResultOf actual after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual capacity after)
              (fun (checked : ManagedResult) => match checked with | ManagedResultOf unchanged final =>
                managed_startup_check compiler scope unchanged
                  (managed_startup_environment_value compiler scope wide units count) final end) end) end);

-- Growth, shrinkage or disappearance between query and fill is a failure.
-- There is no truncation and no unbounded retry. Same-length writes retain
-- the value returned by the single successful Win32 read.
def managed_startup_environment_fill (compiler : ManagedCompiler) (name : MirValue) (name_units : MirValue)
    (capacity : MirValue) (count : MirValue) (wide : MirValue) (scope : ManagedStartupScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_startup_call compiler ManagedStartupEnvironment ([name, name_units, wide, capacity, count] : List MirValue) state)
      (fun (read : ManagedResult) => match read with | ManagedResultOf status next =>
        managed_startup_status compiler scope status
          (managed_startup_environment_complete compiler scope wide capacity count) next end);

def managed_startup_environment_allocate (compiler : ManagedCompiler) (scope : ManagedStartupScope)
    (name : MirValue) (name_units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (required : ManagedResult) => match required with | ManagedResultOf capacity next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual capacity (managed_bits MirUSize 0) next)
          (fun (positive : ManagedResult) => match positive with | ManagedResultOf nonzero after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual capacity managed_startup_int_max after)
              (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits entered =>
                lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd nonzero fits entered)
                  (fun (checked : ManagedResult) => match checked with | ManagedResultOf okay final =>
                    managed_startup_check compiler scope okay (fun (valid : ManagedState) =>
                      lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) valid)
                        (fun (size : ManagedResult) => match size with | ManagedResultOf bytes allocated =>
                          managed_startup_buffer compiler scope bytes
                            (managed_startup_environment_fill compiler name name_units capacity count) allocated end)) final end) end) end) end);

def managed_startup_environment_query (compiler : ManagedCompiler) (scope : ManagedStartupScope)
    (name : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_startup_call compiler ManagedStartupEnvironment
        ([name, units, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) state)
      (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual status (managed_bits MirU32 203) next)
          (fun (missing : ManagedResult) => match missing with | ManagedResultOf absent after =>
            managed_string_choose MirManagedPtr absent (managed_startup_optional compiler (Nothing MirValue))
              (fun (present : ManagedState) =>
                lower_bind ManagedResult ManagedResult (managed_compare MirEqual status (managed_bits MirU32 122) present)
                  (fun (checked : ManagedResult) => match checked with | ManagedResultOf sized final =>
                    managed_startup_check compiler scope sized
                      (managed_startup_environment_allocate compiler scope name units count) final end)) after end) end);

def managed_startup_name_complete (compiler : ManagedCompiler)
    (endpoint : ManagedStartupScope -> MirValue -> MirValue -> MirValue -> ManagedState -> Either NativeLowerError ManagedResult) (scope : ManagedStartupScope)
    (wide : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (written : ManagedResult) => match written with | ManagedResultOf actual next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual units next)
          (fun (checked : ManagedResult) => match checked with | ManagedResultOf complete after =>
            managed_startup_check compiler scope complete (fun (valid : ManagedState) =>
              lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul units (managed_bits MirUSize 2) valid)
                (fun (end_at : ManagedResult) => match end_at with | ManagedResultOf first entered =>
                  lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 1) entered)
                    (fun (last_at : ManagedResult) => match last_at with | ManagedResultOf second final =>
                      endpoint scope wide units count
                        (managed_emit_all ([MirStoreAt wide first (managed_bits MirU8 0),
                          MirStoreAt wide second (managed_bits MirU8 0)] : List MirInstruction) final) end) end)) after end) end);

def managed_startup_name_fill (compiler : ManagedCompiler)
    (endpoint : ManagedStartupScope -> MirValue -> MirValue -> MirValue -> ManagedState -> Either NativeLowerError ManagedResult) (source : MirValue) (bytes : MirValue)
    (units : MirValue) (count : MirValue) (wide : MirValue) (scope : ManagedStartupScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_startup_call compiler ManagedStartupToWide ([source, bytes, wide, units, count] : List MirValue) state)
      (fun (converted : ManagedResult) => match converted with | ManagedResultOf status next =>
        managed_startup_status compiler scope status (managed_startup_name_complete compiler endpoint scope wide units count) next end);

def managed_startup_name_allocate (compiler : ManagedCompiler)
    (endpoint : ManagedStartupScope -> MirValue -> MirValue -> MirValue -> ManagedState -> Either NativeLowerError ManagedResult) (scope : ManagedStartupScope)
    (source : MirValue) (bytes : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (required : ManagedResult) => match required with | ManagedResultOf units next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirLess units managed_startup_int_max next)
          (fun (checked : ManagedResult) => match checked with | ManagedResultOf fits after =>
            managed_startup_check compiler scope fits (fun (valid : ManagedState) =>
              lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd units (managed_bits MirUSize 1) valid)
                (fun (terminated : ManagedResult) => match terminated with | ManagedResultOf capacity entered =>
                  lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) entered)
                    (fun (sized : ManagedResult) => match sized with | ManagedResultOf allocated final =>
                      managed_startup_buffer compiler scope allocated
                        (managed_startup_name_fill compiler endpoint source bytes units count) final end) end)) after end) end);

def managed_startup_name_query (compiler : ManagedCompiler)
    (endpoint : ManagedStartupScope -> MirValue -> MirValue -> MirValue -> ManagedState -> Either NativeLowerError ManagedResult) (scope : ManagedStartupScope)
    (source : MirValue) (bytes : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_startup_call compiler ManagedStartupToWide
        ([source, bytes, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) state)
      (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
        managed_startup_status compiler scope status
          (managed_startup_name_allocate compiler endpoint scope source bytes count) next end);

def managed_startup_name_copy (compiler : ManagedCompiler)
    (endpoint : ManagedStartupScope -> MirValue -> MirValue -> MirValue -> ManagedState -> Either NativeLowerError ManagedResult) (value : MirValue) (bytes : MirValue) (count : MirValue)
    (buffer : MirValue) (scope : ManagedStartupScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult
      (managed_bytes_copy value (managed_bits MirUSize 40) buffer (managed_bits MirUSize 0) bytes state)
      (managed_startup_name_query compiler endpoint scope buffer bytes count);

def managed_startup_environment_storage (compiler : ManagedCompiler) (value : MirValue) (bytes : MirValue)
    (count : MirValue) (scope : ManagedStartupScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_startup_buffer compiler scope bytes (managed_startup_name_copy compiler (managed_startup_environment_query compiler) value bytes count) state;

def managed_startup_environment_body (compiler : ManagedCompiler) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let scope : ManagedStartupScope := ManagedStartupScopeOf ([] : List MirValue) (Nothing MirValue) in
    lower_bind ManagedResult ManagedResult (managed_string_size compiler value state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual bytes (managed_bits MirUSize 0) next)
          (fun (checked : ManagedResult) => match checked with | ManagedResultOf empty after =>
            managed_string_choose MirManagedPtr empty (managed_startup_optional compiler (Nothing MirValue))
              (fun (nonempty : ManagedState) =>
                lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual bytes managed_startup_int_max nonempty)
                  (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                    managed_startup_check compiler scope fits
                      (managed_startup_buffer compiler scope (managed_bits MirUSize 8)
                        (managed_startup_environment_storage compiler value bytes)) final end)) after end) end);

def managed_startup_environment_action (compiler : ManagedCompiler) (name : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_action compiler ([name] : List MirValue)
      (fun (captures : List MirValue) (entered : ManagedState) =>
        lower_bind MirValue ManagedResult (lower_single MirValue captures)
          (fun (value : MirValue) => managed_startup_environment_body compiler value entered)) state;
