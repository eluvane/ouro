-- The user-facing native source path obtains its input from the canonical
-- declaration checker. The raw CheckedProgram entry is independently rechecked.
import "lower.ouro";
import "../driver.ouro";
import "image_types.ouro";
import "mir_model.ouro";
import "lower_model.ouro";
import "x64.ouro";
import "pe_model.ouro";
import "codegen_model.ouro";
import "../primitive_model.ouro";
import "../file_check_model.ouro";
import "../source_text.ouro";
import "codegen.ouro";

inductive NativeSourceError : Type :=
  | NativeSourceCheckError : CompError -> NativeSourceError
  | NativeSourceLowerError : NativeLowerError -> NativeSourceError;

def native_lower_source (fuel : Nat) (limits : MirLimits) (entry_name : List Nat) (source : List Nat)
    : Either NativeSourceError NativeLoweredProgram :=
    match compile_checked_source fuel source with
    | CErr err => Left NativeSourceError NativeLoweredProgram (NativeSourceCheckError err)
    | COk checked => match checked_program_intern checked with | MkIntern names _ _ _ =>
      match source_lookup_id names entry_name with
      | Nothing => Left NativeSourceError NativeLoweredProgram (NativeSourceLowerError (LowerInvalidEntry 0))
      | Just entry => match native_lower_checked fuel limits entry checked with
        | Left err => Left NativeSourceError NativeLoweredProgram (NativeSourceLowerError err)
        | Right lowered => Right NativeSourceError NativeLoweredProgram lowered end end end end;

def native_compile_source (fuel : Nat) (limits : MirLimits) (entry_name : List Nat) (source : List Nat)
    : Either NativeSourceError NativeImage :=
    match native_lower_source fuel limits entry_name source with
    | Left err => Left NativeSourceError NativeImage err
    | Right lowered => match lowered with | NativeLoweredOf _ _ mir =>
      match codegen_program limits mir with
      | Left err => Left NativeSourceError NativeImage (NativeSourceLowerError (LowerBackendFailure err))
      | Right image => Right NativeSourceError NativeImage image end end end;

-- The import-aware path retains every checked declaration and replays the
-- resulting CheckedProgram before selecting machine contracts or emitting PE.
def native_lower_units (fuel : Nat) (limits : MirLimits) (entry_name : List Nat) (root : List Nat)
    (files : List (Pair (List Nat) (List Nat))) : Either NativeSourceError NativeLoweredProgram :=
    match compile_checked_units fuel root files with
    | CErr err => Left NativeSourceError NativeLoweredProgram (NativeSourceCheckError err)
    | COk checked => match checked_program_intern checked with | MkIntern names _ _ _ =>
      match source_lookup_id names entry_name with
      | Nothing => Left NativeSourceError NativeLoweredProgram (NativeSourceLowerError (LowerInvalidEntry 0))
      | Just entry => match native_lower_checked fuel limits entry checked with
        | Left err => Left NativeSourceError NativeLoweredProgram (NativeSourceLowerError err)
        | Right lowered => Right NativeSourceError NativeLoweredProgram lowered end end end end;

def native_compile_units (fuel : Nat) (limits : MirLimits) (entry_name : List Nat) (root : List Nat)
    (files : List (Pair (List Nat) (List Nat))) : Either NativeSourceError NativeImage :=
    match native_lower_units fuel limits entry_name root files with
    | Left err => Left NativeSourceError NativeImage err
    | Right lowered => match lowered with | NativeLoweredOf _ _ mir =>
      match codegen_program limits mir with
      | Left err => Left NativeSourceError NativeImage (NativeSourceLowerError (LowerBackendFailure err))
      | Right image => Right NativeSourceError NativeImage image end end end;

def source_compile_units (fuel : Nat) (root : List Nat)
    (files : List (Pair (List Nat) (List Nat)))
    : CompResult CheckedProgram :=
    compile_checked_units fuel root files;
