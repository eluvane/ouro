-- Checked raw FFI arguments are captured as ordinary values when the action is
-- built. Unboxing and the foreign call happen only when that action runs.
import "managed_actions.ouro";

def managed_unbox_scalar (compiler : ManagedCompiler) (typ : MirType) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match typ with
    | MirU8 => managed_unbox_word compiler PrimitiveWordU8 value state
    | MirU32 => managed_unbox_word compiler PrimitiveWordU32 value state
    | MirU64 => managed_unbox_word compiler PrimitiveWordU64 value state
    | MirI32 => managed_unbox_word compiler PrimitiveWordI32 value state
    | MirUSize => managed_unbox_word compiler PrimitiveWordUSize value state
    | MirRawPtr => managed_unbox_pointer compiler value state
    | MirManagedPtr => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 13) end;

def managed_box_scalar (compiler : ManagedCompiler) (typ : MirType) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match typ with
    | MirU8 => managed_box_word compiler PrimitiveWordU8 value state
    | MirU32 => managed_box_word compiler PrimitiveWordU32 value state
    | MirU64 => managed_box_word compiler PrimitiveWordU64 value state
    | MirI32 => managed_box_word compiler PrimitiveWordI32 value state
    | MirUSize => managed_box_word compiler PrimitiveWordUSize value state
    | MirRawPtr => managed_box_pointer compiler value state
    | MirManagedPtr => Left NativeLowerError ManagedResult (LowerUnsupportedTerm 13) end;

def managed_unit_value (compiler : ManagedCompiler) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitiveUnitRole)
      (fun (unit : Nat) => managed_constructor compiler unit (managed_bits MirUSize 0) ([] : List MirValue) state);

def managed_unbox_typed (compiler : ManagedCompiler) (typ : LowerType) (mir : MirType)
    (value : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match lower_is_role (managed_compiler_entries compiler) (lower_type_core typ) PrimitiveBoolRole with
    | True => managed_unbox_boolean compiler value state
    | False => managed_unbox_scalar compiler mir value state end;

def managed_box_typed (compiler : ManagedCompiler) (typ : LowerType) (mir : MirType)
    (value : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind LowerType ManagedResult (lower_pure_type typ) (fun (pure : LowerType) =>
      match lower_is_role (managed_compiler_entries compiler) (lower_type_core pure) PrimitiveBoolRole with
      | True => managed_boolean compiler value state
      | False => managed_box_scalar compiler mir value state end);

def managed_unbox_arguments (compiler : ManagedCompiler)
    : List LowerType -> List MirValue -> ManagedState -> Either NativeLowerError ManagedFields :=
  fix unbox (types : List LowerType) (values : List MirValue) (state : ManagedState)
      : Either NativeLowerError ManagedFields :=
    match types, values with
    | Nil, Nil => Right NativeLowerError ManagedFields (ManagedFieldsOf ([] : List MirValue) state)
    | Nil, Cons _ _ => Left NativeLowerError ManagedFields (LowerInvalidCall 0)
    | Cons _ _, Nil => Left NativeLowerError ManagedFields (LowerInvalidCall 0)
    | Cons typ rest, Cons value more => match lower_type_mir typ with
      | Nothing => Left NativeLowerError ManagedFields (LowerUnsupportedType (lower_type_core typ))
      | Just mir => lower_bind ManagedResult ManagedFields (managed_unbox_typed compiler typ mir value state)
          (fun (first : ManagedResult) => match first with | ManagedResultOf scalar next =>
            lower_map ManagedFields ManagedFields (fun (tail : ManagedFields) => match tail with
              | ManagedFieldsOf arguments after => ManagedFieldsOf (Cons MirValue scalar arguments) after end)
              (unbox rest more next) end) end end;

def managed_external_call (compiler : ManagedCompiler) (contract : LowerContract)
    (captures : List MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match contract with | LowerContractOf id _ parameters result _ =>
      lower_bind ManagedFields ManagedResult (managed_unbox_arguments compiler parameters captures state)
        (fun (unboxed : ManagedFields) => match unboxed with | ManagedFieldsOf arguments next =>
          match lower_type_mir result with
          | Nothing => managed_unit_value compiler (managed_emit (MirCall MirMayGc (Nothing Nat) (MirDirect id) arguments) next)
          | Just typ => lower_bind ManagedResult ManagedResult
              (managed_fresh typ (fun (local : Nat) => MirCall MirMayGc (Just Nat local) (MirDirect id) arguments) next)
              (fun (called : ManagedResult) => match called with | ManagedResultOf value after =>
                managed_box_typed compiler result typ value after end) end end) end;

-- A partially applied extern is an ordinary unary closure. The final argument
-- constructs a Runtime action; only invoking that action calls the OS.
def managed_external_value (compiler : ManagedCompiler) (contract : LowerContract)
    : List LowerType -> List MirValue -> ManagedState -> Either NativeLowerError ManagedResult :=
  fix partial (remaining : List LowerType) (captures : List MirValue) (state : ManagedState)
      : Either NativeLowerError ManagedResult :=
    match remaining with
    | Nil => managed_action compiler captures (managed_external_call compiler contract) state
    | Cons _ rest =>
        let caller : LowerState := managed_flow state in
        lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
          (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
            lower_bind (Pair ManagedScope ManagedState) ManagedResult
              (managed_capture_scope (map MirValue (Maybe MirValue) (Just MirValue) captures) 0
                (managed_with_flow reserved (lower_empty_state 2)))
              (fun (captured : Pair ManagedScope ManagedState) => match captured with | MkPair environment entered =>
                lower_bind ManagedResult ManagedResult
                  (partial rest (append MirValue (managed_values environment) ([MirUse 1] : List MirValue)) entered)
                  (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value after =>
                    let function : MirFunction := managed_finish_function symbol
                      ([111,117,114,111,95,109,97,110,97,103,101,100,95,102,111,114,101,105,103,110] : List Nat)
                      ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) value after in
                    managed_emit_callable compiler 3 symbol False captures
                      (managed_with_flow (managed_add_function function after) caller) end) end) end) end;

-- Only reuse a contract already compiled by the raw dependency pass. This is
-- representation selection after checking, never a retry after failed checking.
def managed_raw_contract_call (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (contract : LowerContract) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedFields ManagedResult (managed_arguments compiler step scope arguments state)
      (fun (captured : ManagedFields) => match captured with | ManagedFieldsOf values next =>
        match contract with | LowerContractOf _ _ _ result _ => match lower_type_action result with
          | True => managed_action compiler values (managed_external_call compiler contract) next
          | False => managed_external_call compiler contract values next end end end);

def managed_external (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope) (fuel : Nat)
    (id : Nat) (annotation : CoreTerm) (binding : PrimitiveBinding) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind LowerContract ManagedResult
      (lower_make_contract_indexed fuel (managed_compiler_environment compiler) id annotation (Just PrimitiveBinding binding))
      (fun (contract : LowerContract) => match contract with | LowerContractOf _ _ parameters result _ =>
        lower_bind Unit ManagedResult (lower_require
          (andb (lower_type_action result) (leb_nat (length CoreTerm arguments) (length LowerType parameters))) (LowerInvalidCall id))
          (fun (_ : Unit) => lower_bind ManagedFields ManagedResult (managed_arguments compiler step scope arguments state)
            (fun (captured : ManagedFields) => match captured with | ManagedFieldsOf values next =>
              managed_external_value compiler contract (drop LowerType (length CoreTerm arguments) parameters) values next end)) end);
