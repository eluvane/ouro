import "managed_http_result.ouro";

def managed_http_one_header (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue) (pair : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitivePairRole) (fun (family : Nat) => lower_bind ManagedState ManagedResult (managed_expect_descriptor compiler 1 pair start) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 8 next) (fun (result : ManagedResult) => match result with | ManagedResultOf allocated next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_compare MirGreaterEqual allocated (managed_bits MirUSize 72) next) (fun (result : ManagedResult) => match result with | ManagedResultOf fits next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedResult (managed_http_require compiler scope fits next) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 32 state) (fun (result : ManagedResult) => match result with | ManagedResultOf actual next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual (managed_bits MirUSize family) next) (fun (result : ManagedResult) => match result with | ManagedResultOf valid next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedResult (managed_http_require compiler scope valid next) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 40 state) (fun (result : ManagedResult) => match result with | ManagedResultOf actual next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual (managed_bits MirUSize 0) next) (fun (result : ManagedResult) => match result with | ManagedResultOf valid next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedResult (managed_http_require compiler scope valid next) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 48 state) (fun (result : ManagedResult) => match result with | ManagedResultOf actual next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual (managed_bits MirUSize 2) next) (fun (result : ManagedResult) => match result with | ManagedResultOf valid next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedResult (managed_http_require compiler scope valid next) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_load MirManagedPtr pair 56 state) (fun (result : ManagedResult) => match result with | ManagedResultOf first next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_load MirManagedPtr pair 64 next) (fun (result : ManagedResult) => match result with | ManagedResultOf second next =>
let state : ManagedState := next in
managed_http_text compiler first scope (fun (name : MirValue) (names : MirValue) (owned : ManagedHttpScope) (entered : ManagedState) => managed_http_text compiler second owned (fun (value : MirValue) (values : MirValue) (scope : ManagedHttpScope) (final : ManagedState) => managed_http_call compiler ManagedHttpHeader ([ctx, name, names, value, values] : List MirValue) final) entered) next end) end)) end) end)) end) end)) end) end)) end) end)));

def managed_http_headers (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue)
    (headers : MirValue) (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitiveListRole)
      (fun (family : Nat) => lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirManagedPtr start)
        (fun (cursor_cell : Pair Nat ManagedState) => match cursor_cell with | MkPair cursor next =>
          lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirU32 next)
            (fun (status_cell : Pair Nat ManagedState) => match status_cell with | MkPair status after =>
              let initialized : ManagedState := managed_emit_all
                ([MirMove cursor headers, MirMove status (managed_bits MirU32 0)] : List MirInstruction) after in
              lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
                (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                  lower_bind ManagedResult ManagedResult
                    (managed_string_list_tag compiler family (MirUse cursor)
                      (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                    (fun (tagged : ManagedResult) => match tagged with | ManagedResultOf present checked =>
                      lower_bind ManagedResult ManagedResult (managed_startup_zero (MirUse status) checked)
                        (fun (successful : ManagedResult) => match successful with | ManagedResultOf okay bounded =>
                          lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd present okay bounded)
                            (fun (combined : ManagedResult) => match combined with | ManagedResultOf running entered =>
                              lower_bind ManagedResult ManagedResult
                                (managed_load MirManagedPtr (MirUse cursor) 56
                                  (managed_switch_block body (MirBranch running body finish) entered))
                                (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf pair current =>
                                  lower_bind ManagedResult ManagedResult (managed_load MirManagedPtr (MirUse cursor) 64 current)
                                    (fun (tail : ManagedResult) => match tail with | ManagedResultOf rest selected =>
                                      lower_map ManagedResult ManagedResult (fun (added : ManagedResult) => match added with
                                        | ManagedResultOf result final => ManagedResultOf (MirUse status)
                                            (managed_switch_block finish (MirJump header)
                                              (managed_emit_all ([MirMove cursor rest, MirMove status result] : List MirInstruction) final)) end)
                                        (managed_http_one_header compiler scope ctx pair selected) end) end) end) end) end) end) end) end));

def managed_http_after_open (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue) (headers : MirValue) (body : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_http_headers compiler scope ctx headers start) (fun (result : ManagedResult) => match result with | ManagedResultOf status next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_startup_zero status next) (fun (result : ManagedResult) => match result with | ManagedResultOf okay next =>
let state : ManagedState := next in
managed_string_choose MirU32 okay (managed_http_bytes compiler body scope (fun (buffer : MirValue) (bytes : MirValue) (owned : ManagedHttpScope) (entered : ManagedState) => managed_http_call compiler ManagedHttpSend ([ctx, buffer, bytes] : List MirValue) entered)) (fun (current : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf status current)) next end) end);

def managed_http_context (compiler : ManagedCompiler) (url : MirValue) (headers : MirValue) (body : MirValue) (ctx : MirValue) (scope : ManagedHttpScope)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    let opened : ManagedHttpScope := match scope with | ManagedHttpScopeOf buffers _ => ManagedHttpScopeOf buffers (Just MirValue ctx) end in
lower_bind ManagedResult ManagedResult (managed_http_text compiler url opened (fun (wide : MirValue) (units : MirValue) (owned : ManagedHttpScope) (entered : ManagedState) => managed_http_call compiler ManagedHttpOpen ([ctx, wide, units] : List MirValue) entered) start) (fun (result : ManagedResult) => match result with | ManagedResultOf status next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_startup_zero status next) (fun (result : ManagedResult) => match result with | ManagedResultOf okay next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_choose MirU32 okay (managed_http_after_open compiler opened ctx headers body) (fun (current : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf status current)) next) (fun (result : ManagedResult) => match result with | ManagedResultOf status next =>
let state : ManagedState := next in
managed_http_finish compiler opened ctx status next end) end) end);

def managed_http_body (compiler : ManagedCompiler) (url : MirValue) (headers : MirValue) (body : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_http_buffer compiler (ManagedHttpScopeOf ([] : List MirValue) (Nothing MirValue)) (managed_bits MirUSize 64) (managed_http_context compiler url headers body) state;
