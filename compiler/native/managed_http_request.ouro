import "managed_http_result.ouro";

def managed_http_one_header (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue) (pair : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitivePairRole)
      (fun (family : Nat) => lower_bind ManagedState ManagedResult (managed_expect_descriptor compiler 1 pair start)
        (fun (opened : ManagedState) =>
          lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 8 opened)
            (fun (as_alloc : ManagedResult) => match as_alloc with | ManagedResultOf allocated after_alloc =>
              lower_bind ManagedResult ManagedResult
                (managed_compare MirGreaterEqual allocated (managed_bits MirUSize 72) after_alloc)
                (fun (as_fits : ManagedResult) => match as_fits with | ManagedResultOf fits after_fits =>
                  lower_bind ManagedState ManagedResult (managed_http_require compiler scope fits after_fits)
                    (fun (sized : ManagedState) =>
                      lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 32 sized)
                        (fun (as_tag : ManagedResult) => match as_tag with | ManagedResultOf actual after_tag =>
                          lower_bind ManagedResult ManagedResult
                            (managed_compare MirEqual actual (managed_bits MirUSize family) after_tag)
                            (fun (as_pair : ManagedResult) => match as_pair with | ManagedResultOf valid_pair after_pair =>
                              lower_bind ManagedState ManagedResult
                                (managed_http_require compiler scope valid_pair after_pair)
                                (fun (typed : ManagedState) =>
                                  lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 40 typed)
                                    (fun (as_left : ManagedResult) => match as_left with | ManagedResultOf left_tag after_left =>
                                      lower_bind ManagedResult ManagedResult
                                        (managed_compare MirEqual left_tag (managed_bits MirUSize 0) after_left)
                                        (fun (as_left_ok : ManagedResult) => match as_left_ok with | ManagedResultOf valid_left after_left_ok =>
                                          lower_bind ManagedState ManagedResult
                                            (managed_http_require compiler scope valid_left after_left_ok)
                                            (fun (left_ok : ManagedState) =>
                                              lower_bind ManagedResult ManagedResult (managed_load MirUSize pair 48 left_ok)
                                                (fun (as_right : ManagedResult) => match as_right with | ManagedResultOf right_tag after_right =>
                                                  lower_bind ManagedResult ManagedResult
                                                    (managed_compare MirEqual right_tag (managed_bits MirUSize 2) after_right)
                                                    (fun (as_right_ok : ManagedResult) => match as_right_ok with | ManagedResultOf valid_right after_right_ok =>
                                                      lower_bind ManagedState ManagedResult
                                                        (managed_http_require compiler scope valid_right after_right_ok)
                                                        (fun (right_ok : ManagedState) =>
                                                          lower_bind ManagedResult ManagedResult
                                                            (managed_load MirManagedPtr pair 56 right_ok)
                                                            (fun (as_first : ManagedResult) => match as_first with | ManagedResultOf first after_first =>
                                                              lower_bind ManagedResult ManagedResult
                                                                (managed_load MirManagedPtr pair 64 after_first)
                                                                (fun (as_second : ManagedResult) => match as_second with | ManagedResultOf second after_second =>
                                                                  managed_http_text compiler first scope
                                                                    (fun (header_name : MirValue) (names : MirValue) (owned : ManagedHttpScope) (entered : ManagedState) =>
                                                                      managed_http_text compiler second owned
                                                                        (fun (header_value : MirValue) (values : MirValue) (_inner : ManagedHttpScope) (final : ManagedState) =>
                                                                          managed_http_call compiler ManagedHttpHeader
                                                                            ([ctx, header_name, names, header_value, values] : List MirValue) final)
                                                                        entered) after_second end) end)) end) end)) end) end)) end) end)) end) end)));

def managed_http_headers (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue)
    (headers : MirValue) (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitiveListRole)
      (fun (family : Nat) => lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirManagedPtr start)
        (fun (cursor_cell : Pair Nat ManagedState) => match cursor_cell with | MkPair cursor next =>
          lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirU32 next)
            (fun (status_cell : Pair Nat ManagedState) => match status_cell with | MkPair status after =>
              let initialized : ManagedState := managed_emit_all
                ([MirMove cursor headers, MirMove status (managed_bits MirU32 0)] : List MirInstruction) after in
              lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
                (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                  lower_bind ManagedResult ManagedResult
                    (managed_string_list_tag compiler family (MirUse cursor)
                      (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                    (fun (tagged : ManagedResult) => match tagged with | ManagedResultOf present checked =>
                      lower_bind ManagedResult ManagedResult (managed_startup_zero (MirUse status) checked)
                        (fun (successful : ManagedResult) => match successful with | ManagedResultOf okay bounded =>
                          lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd present okay bounded)
                            (fun (combined : ManagedResult) => match combined with | ManagedResultOf running entered =>
                              lower_bind ManagedResult ManagedResult
                                (managed_load MirManagedPtr (MirUse cursor) 56
                                  (managed_switch_block body (MirBranch running body finish) entered))
                                (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf pair current =>
                                  lower_bind ManagedResult ManagedResult (managed_load MirManagedPtr (MirUse cursor) 64 current)
                                    (fun (tail : ManagedResult) => match tail with | ManagedResultOf rest selected =>
                                      lower_map ManagedResult ManagedResult (fun (added : ManagedResult) => match added with
                                        | ManagedResultOf result final => ManagedResultOf (MirUse status)
                                            (managed_switch_block finish (MirJump header)
                                              (managed_emit_all ([MirMove cursor rest, MirMove status result] : List MirInstruction) final)) end)
                                        (managed_http_one_header compiler scope ctx pair selected) end) end) end) end) end) end) end) end));

def managed_http_after_open (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue) (headers : MirValue) (body : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_http_headers compiler scope ctx headers start)
      (fun (as_headers : ManagedResult) => match as_headers with | ManagedResultOf status after_headers =>
        lower_bind ManagedResult ManagedResult (managed_startup_zero status after_headers)
          (fun (as_ok : ManagedResult) => match as_ok with | ManagedResultOf okay after_ok =>
            managed_string_choose MirU32 okay
              (managed_http_bytes compiler body scope
                (fun (buffer : MirValue) (bytes : MirValue) (_owned : ManagedHttpScope) (entered : ManagedState) =>
                  managed_http_call compiler ManagedHttpSend ([ctx, buffer, bytes] : List MirValue) entered))
              (fun (current : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf status current))
              after_ok end) end);

def managed_http_context (compiler : ManagedCompiler) (url : MirValue) (headers : MirValue) (body : MirValue) (ctx : MirValue) (scope : ManagedHttpScope)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    let opened : ManagedHttpScope := match scope with | ManagedHttpScopeOf buffers _ => ManagedHttpScopeOf buffers (Just MirValue ctx) end in
lower_bind ManagedResult ManagedResult (managed_http_text compiler url opened
      (fun (wide : MirValue) (units : MirValue) (_owned : ManagedHttpScope) (entered : ManagedState) =>
        managed_http_call compiler ManagedHttpOpen ([ctx, wide, units] : List MirValue) entered) start)
      (fun (as_open : ManagedResult) => match as_open with | ManagedResultOf status after_open =>
        lower_bind ManagedResult ManagedResult (managed_startup_zero status after_open)
          (fun (as_ok : ManagedResult) => match as_ok with | ManagedResultOf okay after_ok =>
            lower_bind ManagedResult ManagedResult
              (managed_string_choose MirU32 okay (managed_http_after_open compiler opened ctx headers body)
                (fun (current : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf status current))
                after_ok)
              (fun (as_sent : ManagedResult) => match as_sent with | ManagedResultOf sent after_sent =>
                managed_http_finish compiler opened ctx sent after_sent end) end) end);

def managed_http_body (compiler : ManagedCompiler) (url : MirValue) (headers : MirValue) (body : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_http_buffer compiler (ManagedHttpScopeOf ([] : List MirValue) (Nothing MirValue)) (managed_bits MirUSize 64) (managed_http_context compiler url headers body) state;
