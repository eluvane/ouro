-- Boxed machine adapters use the same checked primitive identities and MIR
-- operation selectors as the scalar path. Unsupported primitives stay errors.
import "managed_word.ouro";
import "managed_process_bounded.ouro";
import "managed_string_lists.ouro";
import "managed_string_replace.ouro";
import "managed_string_split.ouro";
import "managed_string_decimal.ouro";
import "managed_stdio.ouro";
import "managed_startup.ouro";
import "managed_time.ouro";
import "managed_fs_copy.ouro";
import "managed_stdin.ouro";
import "managed_files.ouro";
import "managed_directories.ouro";
import "managed_realpath.ouro";
import "managed_temp.ouro";
import "managed_process.ouro";
import "managed_process_inherit.ouro";
import "managed_http.ouro";
import "managed_fs_rename.ouro";
import "managed_fs_replace.ouro";
import "managed_model.ouro";
import "../primitive_model.ouro";
import "lower_model.ouro";
import "managed_strings.ouro";
import "managed_string_access.ouro";
import "managed_string_search.ouro";
import "managed_actions.ouro";
import "managed_raw.ouro";
import "managed_fs_kind.ouro";
import "managed_fs_predicates.ouro";
import "managed_fs_mutations.ouro";

def managed_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope) (fuel : Nat)
    (primitive : PrimitiveId) (specialization : Maybe CoreTerm) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match primitive with
    | PrimitiveWordOperation word operation => managed_word_operation compiler step scope word operation arguments state
    | PrimitiveWordConversion from into operation => managed_word_conversion compiler step scope from into operation arguments state
    | PrimitiveWordFromNat word => managed_word_from_nat compiler step scope fuel word arguments state
    | PrimitiveU8Type => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveU32Type => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveU64Type => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveI32Type => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveUSizeType => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveRawPtrType => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveRuntimeType => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveRawFnType => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveStringType => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveWordToNat word => managed_word_to_nat compiler step scope word arguments state
    | PrimitiveStringOperation operation => match operation with
      | PrimitiveStringConcat => managed_string_binary compiler step scope True arguments state
      | PrimitiveStringEqual => managed_string_binary compiler step scope False arguments state
      | PrimitiveStringLength => managed_string_unary step scope (managed_string_length_value compiler) arguments state
      | PrimitiveStringByteAt => managed_string_binary_values step scope (managed_string_byte_at_value compiler) arguments state
      | PrimitiveStringSlice => managed_string_ternary step scope (managed_string_slice_value compiler) arguments state
      | PrimitiveStringOfNat => managed_string_unary step scope (managed_string_of_nat_value compiler) arguments state
      | PrimitiveStringToCodes => managed_string_unary step scope (managed_string_to_codes_value compiler) arguments state
      | PrimitiveStringOfCodes => managed_string_unary step scope (managed_string_of_codes_value compiler) arguments state
      | PrimitiveStringStarts => managed_string_binary_values step scope (managed_string_starts_values compiler) arguments state
      | PrimitiveStringEnds => managed_string_binary_values step scope (managed_string_ends_values compiler) arguments state
      | PrimitiveStringContains => managed_string_binary_values step scope (managed_string_contains_values compiler) arguments state
      | PrimitiveStringIndex => managed_string_binary_values step scope (managed_string_index_values compiler) arguments state
      | PrimitiveStringSplit => managed_string_binary_values step scope (managed_string_split_values compiler) arguments state
      | PrimitiveStringReplace => managed_string_ternary step scope (managed_string_replace_values compiler) arguments state
      | PrimitiveStringLessEqual => managed_string_binary_values step scope (managed_string_less_equal_values compiler) arguments state
      | PrimitiveStringTokens => managed_string_unary step scope (managed_string_tokens_value compiler) arguments state end
    | PrimitiveRuntimePure => managed_runtime_pure compiler step scope arguments state
    | PrimitiveRuntimeBind => managed_runtime_bind compiler step scope arguments state
    | PrimitiveRuntimeLoop => managed_runtime_loop compiler step scope arguments state
    | PrimitiveRawNull => managed_raw_null compiler arguments state
    | PrimitiveRawLoad => managed_raw_storage compiler step scope fuel specialization False arguments state
    | PrimitiveRawStore => managed_raw_storage compiler step scope fuel specialization True arguments state
    | PrimitiveRawAddWrap => managed_raw_add compiler step scope arguments state
    | PrimitiveRawCast => managed_raw_cast compiler step scope arguments state
    | PrimitiveRawToBits => managed_raw_bits compiler step scope False arguments state
    | PrimitiveRawFromBits => managed_raw_bits compiler step scope True arguments state
    | PrimitiveFnCall => Left NativeLowerError ManagedResult (LowerUnsupportedPrimitive primitive)
    | PrimitiveStdoutWrite => managed_stdio_primitive compiler step scope ManagedStdoutWrite arguments state
    | PrimitiveStderrWrite => managed_stdio_primitive compiler step scope ManagedStderrWrite arguments state
    | PrimitiveStdoutFlush => managed_stdio_primitive compiler step scope ManagedStdoutFlush arguments state
    | PrimitiveProcessExit => managed_stdio_primitive compiler step scope ManagedProcessExit arguments state
    | PrimitiveArgv => managed_startup_primitive compiler step scope False arguments state
    | PrimitiveEnvGet => managed_startup_primitive compiler step scope True arguments state
    | PrimitiveTimeNow => managed_time_primitive compiler arguments state
    | PrimitiveFileKind => managed_fs_kind_primitive compiler step scope arguments state
    | PrimitiveFileExists => managed_fs_predicate_primitive compiler step scope False arguments state
    | PrimitiveFileIsDirectory => managed_fs_predicate_primitive compiler step scope True arguments state
    | PrimitiveDirectoryCreate => managed_fs_mutation_primitive compiler step scope True arguments state
    | PrimitivePathRemove => managed_fs_mutation_primitive compiler step scope False arguments state
    | PrimitiveFileCopy => managed_copy_primitive compiler step scope arguments state
    | PrimitiveFileRename => managed_rename_primitive compiler step scope arguments state
    | PrimitiveFileReplace => managed_replace_primitive compiler step scope arguments state
    | PrimitiveFileRealpath => managed_realpath_primitive compiler step scope arguments state
    | PrimitiveFileTemp => managed_temp_primitive compiler step scope False arguments state
    | PrimitiveFileTempIn => managed_temp_primitive compiler step scope True arguments state
    | PrimitiveProcessBounded => managed_process_bounded_primitive compiler step scope arguments state
    | PrimitiveProcessInherit => managed_process_inherit_primitive compiler step scope arguments state
    | PrimitiveProcessCapture => managed_process_primitive compiler step scope arguments state
    | PrimitiveHttpPost => managed_http_primitive compiler step scope arguments state
    | PrimitiveStdinReadLine => managed_stdin_primitive compiler step scope False arguments state
    | PrimitiveStdinReadBytes => managed_stdin_primitive compiler step scope True arguments state
    | PrimitiveFileRead => managed_file_primitive compiler step scope False arguments state
    | PrimitiveFileWrite => managed_file_primitive compiler step scope True arguments state
    | PrimitiveDirectoryList => managed_directory_primitive compiler step scope False arguments state
    | PrimitiveDirectoryListable => managed_directory_primitive compiler step scope True arguments state end;
