-- Parent IDs refer to resolved checked definitions. Capture is diagnostic data.
import "../../std/listx.ouro", "../base.ouro";

inductive NativeFunctionOwner : Type :=
  | NativeFunctionSource : Nat -> Bool -> NativeFunctionOwner
  | NativeFunctionUnknown : NativeFunctionOwner;

inductive NativeFunctionOrigin : Type :=
  | NativeFunctionOriginOf : Nat -> NativeFunctionOwner -> NativeFunctionOrigin;

inductive NativeOriginCapture : Type :=
  | NativeOriginsDisabled : NativeOriginCapture
  | NativeOriginsEnabled : Maybe Nat -> List NativeFunctionOrigin -> NativeOriginCapture;

def native_origins_parent (capture : NativeOriginCapture) : Maybe Nat :=
    match capture with
    | NativeOriginsDisabled => Nothing Nat
    | NativeOriginsEnabled parent _ => parent
    end;

def native_origins_record (symbol : Nat) (capture : NativeOriginCapture) : NativeOriginCapture :=
    match capture with
    | NativeOriginsDisabled => capture
    | NativeOriginsEnabled parent rows =>
        NativeOriginsEnabled parent (Cons NativeFunctionOrigin
          (NativeFunctionOriginOf symbol (match parent with
            | Nothing => NativeFunctionUnknown
            | Just source => NativeFunctionSource source True
            end)) rows)
    end;

def native_origins_rows (capture : NativeOriginCapture) : List NativeFunctionOrigin :=
    match capture with
    | NativeOriginsDisabled => []
    | NativeOriginsEnabled _ rows => reverse NativeFunctionOrigin rows
    end;

def native_origin_symbol (row : NativeFunctionOrigin) : Nat :=
    match row with | NativeFunctionOriginOf symbol _ => symbol end;
