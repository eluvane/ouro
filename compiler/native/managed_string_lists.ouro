-- Checked List roles use constructor ordinal 0 (Nil) or 1 (Cons). Parameters
-- are erased; Cons stores its managed head/tail at byte offsets 56 and 64.
import "managed_string_access.ouro";

def managed_string_list_tag (compiler : ManagedCompiler) (family : Nat) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (managed_expect_descriptor compiler 1 value state)
      (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize value 8 checked)
        (fun (size : ManagedResult) => match size with | ManagedResultOf allocated next =>
          lower_bind ManagedResult ManagedResult (managed_compare MirGreaterEqual allocated (managed_bits MirUSize 56) next)
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf valid after_test =>
              lower_bind ManagedState ManagedResult (managed_guard valid after_test)
                (fun (bounded : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize value 32 bounded)
                  (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf actual after_family =>
                    lower_bind ManagedState ManagedResult (managed_require_equal actual (managed_bits MirUSize family) after_family)
                      (fun (family_checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize value 40 family_checked)
                        (fun (tagged : ManagedResult) => match tagged with | ManagedResultOf tag after_tag =>
                          lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual tag (managed_bits MirUSize 1) after_tag)
                            (fun (range : ManagedResult) => match range with | ManagedResultOf in_range after_range =>
                              lower_bind ManagedState ManagedResult (managed_guard in_range after_range)
                                (fun (tag_checked : ManagedState) => lower_bind ManagedResult ManagedResult
                                  (managed_binary MirUSize MirShl tag (managed_bits MirU32 1) tag_checked)
                                  (fun (fields : ManagedResult) => match fields with | ManagedResultOf expected_count after_fields =>
                                    lower_bind ManagedResult ManagedResult (managed_load MirUSize value 48 after_fields)
                                      (fun (counted : ManagedResult) => match counted with | ManagedResultOf count after_count =>
                                        lower_bind ManagedState ManagedResult (managed_require_equal count expected_count after_count)
                                          (fun (count_checked : ManagedState) => lower_bind ManagedResult ManagedResult
                                            (managed_binary MirUSize MirShl tag (managed_bits MirU32 4) count_checked)
                                            (fun (payload : ManagedResult) => match payload with | ManagedResultOf bytes after_payload =>
                                              lower_bind ManagedResult ManagedResult
                                                (managed_binary MirUSize MirAdd bytes (managed_bits MirUSize 56) after_payload)
                                                (fun (required : ManagedResult) => match required with | ManagedResultOf minimum after_minimum =>
                                                  lower_bind ManagedResult ManagedResult (managed_compare MirGreaterEqual allocated minimum after_minimum)
                                                    (fun (fit : ManagedResult) => match fit with | ManagedResultOf fits after_fit =>
                                                      lower_bind ManagedState ManagedResult (managed_guard fits after_fit)
                                                        (fun (finished : ManagedState) => managed_convert MirU8 MirNarrow tag finished) end) end) end)) end) end)) end) end)) end)) end) end));

def managed_string_codes_step (compiler : ManagedCompiler) (family : Nat) (value : MirValue)
    (index : Nat) (result : Nat) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_string_load_byte value (MirUse index)
      (managed_emit (MirBinaryOp index MirSub (MirUse index) (managed_bits MirUSize 1)) state))
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf byte next =>
        lower_bind ManagedResult ManagedState (managed_nat_from_word compiler PrimitiveWordU8 byte next)
          (fun (boxed : ManagedResult) => match boxed with | ManagedResultOf natural after =>
            lower_map ManagedResult ManagedState (fun (cons : ManagedResult) => match cons with
              | ManagedResultOf node finish => managed_emit (MirMove result node) finish end)
              (managed_constructor compiler family (managed_bits MirUSize 1) ([natural, MirUse result] : List MirValue) after) end) end);

def managed_string_to_codes_value (compiler : ManagedCompiler) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitiveListRole)
      (fun (family : Nat) => lower_bind ManagedResult ManagedResult (managed_string_size compiler value state)
        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf count next =>
          lower_bind ManagedResult ManagedResult (managed_constructor compiler family (managed_bits MirUSize 0) ([] : List MirValue) next)
            (fun (empty : ManagedResult) => match empty with | ManagedResultOf nil after_nil =>
              lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirUSize after_nil)
                (fun (cell : Pair Nat ManagedState) => match cell with | MkPair index after_index =>
                  lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirManagedPtr after_index)
                    (fun (list : Pair Nat ManagedState) => match list with | MkPair result after_list =>
                      let initialized : ManagedState := managed_emit_all
                        ([MirMove index count, MirMove result nil] : List MirInstruction) after_list in
                      lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
                        (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                          lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual (MirUse index) (managed_bits MirUSize 0)
                            (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                            (fun (tested : ManagedResult) => match tested with | ManagedResultOf running after_test =>
                              lower_map ManagedState ManagedResult (fun (after_body : ManagedState) => ManagedResultOf (MirUse result)
                                (managed_switch_block finish (MirJump header) after_body))
                                (managed_string_codes_step compiler family value index result
                                  (managed_switch_block body (MirBranch running body finish) after_test)) end) end) end) end) end) end));

def managed_string_list_count (compiler : ManagedCompiler) (family : Nat) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirManagedPtr state)
      (fun (list : Pair Nat ManagedState) => match list with | MkPair cursor next =>
        lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirUSize next)
          (fun (cell : Pair Nat ManagedState) => match cell with | MkPair count after_count =>
            let initialized : ManagedState := managed_emit_all
              ([MirMove cursor value, MirMove count (managed_bits MirUSize 0)] : List MirInstruction) after_count in
            lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
              (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                lower_bind ManagedResult ManagedResult (managed_string_list_tag compiler family (MirUse cursor)
                  (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                  (fun (tested : ManagedResult) => match tested with | ManagedResultOf running after_test =>
                    lower_bind ManagedResult ManagedResult (managed_load MirManagedPtr (MirUse cursor) 64
                      (managed_switch_block body (MirBranch running body finish) after_test))
                      (fun (tail : ManagedResult) => match tail with | ManagedResultOf rest after_tail =>
                        lower_bind ManagedResult ManagedResult
                          (managed_binary MirUSize MirAdd (MirUse count) (managed_bits MirUSize 1) after_tail)
                          (fun (incremented : ManagedResult) => match incremented with | ManagedResultOf size after_increment =>
                            lower_bind ManagedResult ManagedResult (managed_compare MirGreater size (MirUse count) after_increment)
                              (fun (range : ManagedResult) => match range with | ManagedResultOf fits after_range =>
                                lower_map ManagedState ManagedResult (fun (bounded : ManagedState) => ManagedResultOf (MirUse count)
                                  (managed_switch_block finish (MirJump header) (managed_emit_all
                                    ([MirMove cursor rest, MirMove count size] : List MirInstruction) bounded)))
                                  (managed_guard fits after_range) end) end) end) end) end) end) end);

-- The low byte of the first limb is Nat modulo 256, for any limb count.
def managed_string_code_byte (compiler : ManagedCompiler) (natural : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_nat_count compiler natural state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf count next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual count (managed_bits MirUSize 0) next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf nonzero after_test =>
            managed_string_choose MirU8 nonzero (fun (present : ManagedState) =>
              lower_bind ManagedResult ManagedResult (managed_load MirU32 natural 40 present)
                (fun (limb : ManagedResult) => match limb with | ManagedResultOf low after_limb =>
                  managed_convert MirU8 MirNarrow low after_limb end))
              (managed_string_value (managed_bits MirU8 0)) after_test end) end);

def managed_string_of_codes_step (compiler : ManagedCompiler) (cursor : Nat)
    (target : MirValue) (index : Nat) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_load MirManagedPtr (MirUse cursor) 56 state)
      (fun (head : ManagedResult) => match head with | ManagedResultOf natural next =>
        lower_bind ManagedResult ManagedState (managed_load MirManagedPtr (MirUse cursor) 64 next)
          (fun (tail : ManagedResult) => match tail with | ManagedResultOf rest after_tail =>
            lower_bind ManagedResult ManagedState (managed_string_code_byte compiler natural after_tail)
              (fun (encoded : ManagedResult) => match encoded with | ManagedResultOf byte after_byte =>
                lower_map ManagedResult ManagedState (fun (at : ManagedResult) => match at with
                  | ManagedResultOf offset finish => managed_emit_all
                      ([MirStoreAt target offset byte, MirMove cursor rest,
                        MirBinaryOp index MirAdd (MirUse index) (managed_bits MirUSize 1)] : List MirInstruction) finish end)
                  (managed_binary MirUSize MirAdd (MirUse index) (managed_bits MirUSize 40) after_byte) end) end) end);

-- A preceding count pass checks every List node. This pass has no allocations
-- or foreign calls, and immutable checked lists cannot change between passes.
def managed_string_fill_codes (compiler : ManagedCompiler) (value : MirValue)
    (target : MirValue) (count : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind (Pair Nat ManagedState) ManagedState (managed_fresh_local MirManagedPtr state)
      (fun (list : Pair Nat ManagedState) => match list with | MkPair cursor next =>
        lower_bind (Pair Nat ManagedState) ManagedState (managed_fresh_local MirUSize next)
          (fun (cell : Pair Nat ManagedState) => match cell with | MkPair index after_index =>
            let initialized : ManagedState := managed_emit_all
              ([MirMove cursor value, MirMove index (managed_bits MirUSize 0)] : List MirInstruction) after_index in
            lower_bind LowerLoopBlocks ManagedState (lower_loop_blocks (managed_flow initialized))
              (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                lower_bind ManagedResult ManagedState (managed_compare MirLess (MirUse index) count
                  (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                  (fun (tested : ManagedResult) => match tested with | ManagedResultOf running after_test =>
                    lower_map ManagedState ManagedState (managed_switch_block finish (MirJump header))
                      (managed_string_of_codes_step compiler cursor target index
                        (managed_switch_block body (MirBranch running body finish) after_test)) end) end) end) end);

def managed_string_of_codes_value (compiler : ManagedCompiler) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitiveListRole)
      (fun (family : Nat) => lower_bind ManagedResult ManagedResult (managed_string_list_count compiler family value state)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf count next =>
          lower_bind ManagedResult ManagedResult (managed_string_allocate compiler count next)
            (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf result after_allocate =>
              lower_map ManagedState ManagedResult (fun (finished : ManagedState) => ManagedResultOf result finished)
                (managed_string_fill_codes compiler value result count after_allocate) end) end));
