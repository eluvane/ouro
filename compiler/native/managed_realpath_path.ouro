-- One scope owns metadata, copied input UTF-8, terminated input UTF-16,
-- final UTF-16 and final UTF-8. Every successful open is closed on all exits.
import "managed_realpath_strings.ouro",
  "managed_model.ouro",
  "managed_files_memory.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "lower_model.ouro",
  "pe_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "../pipeline_abi.ouro",
  "managed_startup_memory.ouro",
  "managed_realpath_memory.ouro",
  "managed_strings.ouro",
  "managed_string_ops.ouro";

def managed_realpath_read_complete (compiler : ManagedCompiler) (scope : ManagedFileScope)
    (wide : MirValue) (capacity : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf units next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater units (managed_bits MirUSize 0) next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf positive after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope positive after)
              (fun (nonempty : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_compare MirLess units capacity nonempty)
                (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                  lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits final)
                    (managed_realpath_string compiler scope wide units count) end)) end) end);

def managed_realpath_read_fill (compiler : ManagedCompiler) (stream_handle : MirValue) (capacity : MirValue)
    (count : MirValue) (wide : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_realpath_call compiler ManagedRealpathRead
      ([stream_handle, wide, capacity, count] : List MirValue) state)
      (fun (filled : ManagedResult) => match filled with | ManagedResultOf status next =>
        managed_realpath_status compiler scope status
          (managed_realpath_read_complete compiler scope wide capacity count) next end);

def managed_realpath_read_allocate (compiler : ManagedCompiler) (scope : ManagedFileScope)
    (stream_handle : MirValue) (count : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf capacity next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater capacity (managed_bits MirUSize 1) next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf positive after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope positive after)
              (fun (nonempty : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_compare MirLessEqual capacity managed_realpath_int_max nonempty)
                (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                  lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits final)
                    (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                      (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) checked)
                      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes ready =>
                        managed_file_buffer compiler scope bytes
                          (managed_realpath_read_fill compiler stream_handle capacity count) ready end)) end)) end) end);

def managed_realpath_read (compiler : ManagedCompiler) (scope : ManagedFileScope)
    (stream_handle : MirValue) (count : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_realpath_call compiler ManagedRealpathRead
      ([stream_handle, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) state)
      (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
        managed_realpath_status compiler scope status
          (managed_realpath_read_allocate compiler scope stream_handle count) next end);

def managed_realpath_open (compiler : ManagedCompiler) (storage : MirValue) (wide : MirValue)
    (units : MirValue) (count : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_realpath_call compiler ManagedRealpathOpen
      ([wide, units, storage] : List MirValue) state)
      (fun (opened : ManagedResult) => match opened with | ManagedResultOf status next =>
        managed_realpath_status compiler scope status
          (fun (success : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize storage 0 success)
            (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bits after =>
              lower_bind ManagedResult ManagedResult (managed_convert MirRawPtr MirRawFromBits bits after)
                (fun (converted : ManagedResult) => match converted with | ManagedResultOf stream_handle final =>
                  managed_realpath_read compiler (managed_file_handle stream_handle scope) stream_handle count final end) end)) next end);

def managed_realpath_path_complete (compiler : ManagedCompiler) (storage : MirValue) (wide : MirValue)
    (units : MirValue) (count : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf actual next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual units next)
          (fun (compared : ManagedResult) => match compared with | ManagedResultOf exact after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope exact after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_binary MirUSize MirMul units (managed_bits MirUSize 2) checked)
                (fun (located : ManagedResult) => match located with | ManagedResultOf first entered =>
                  lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 1) entered)
                    (fun (last : ManagedResult) => match last with | ManagedResultOf second final =>
                      managed_realpath_open compiler storage wide units count scope
                        (managed_emit_all ([MirStoreAt wide first (managed_bits MirU8 0),
                          MirStoreAt wide second (managed_bits MirU8 0)] : List MirInstruction) final) end) end)) end) end);

def managed_realpath_path_fill (compiler : ManagedCompiler) (storage : MirValue) (source : MirValue)
    (bytes : MirValue) (units : MirValue) (count : MirValue) (wide : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_realpath_call compiler ManagedRealpathToWide
      ([source, bytes, wide, units, count] : List MirValue) state)
      (fun (filled : ManagedResult) => match filled with | ManagedResultOf status next =>
        lower_bind ManagedState ManagedResult (managed_file_status compiler scope status next)
          (managed_realpath_path_complete compiler storage wide units count scope) end);

def managed_realpath_path_allocate (compiler : ManagedCompiler) (storage : MirValue) (source : MirValue)
    (bytes : MirValue) (count : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf units next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater units (managed_bits MirUSize 0) next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf positive after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope positive after)
              (fun (nonempty : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_compare MirLess units managed_realpath_int_max nonempty)
                (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                  lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits final)
                    (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                      (managed_binary MirUSize MirAdd units (managed_bits MirUSize 1) checked)
                      (fun (terminated : ManagedResult) => match terminated with | ManagedResultOf capacity entered =>
                        lower_bind ManagedResult ManagedResult
                          (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) entered)
                          (fun (sized : ManagedResult) => match sized with | ManagedResultOf allocation ready =>
                            managed_file_buffer compiler scope allocation
                              (managed_realpath_path_fill compiler storage source bytes units count) ready end) end)) end)) end) end);

def managed_realpath_path_copy (compiler : ManagedCompiler) (storage : MirValue) (path : MirValue)
    (bytes : MirValue) (count : MirValue) (source : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult
      (managed_bytes_copy path (managed_bits MirUSize 40) source (managed_bits MirUSize 0) bytes state)
      (fun (copied : ManagedState) => lower_bind ManagedResult ManagedResult
        (managed_realpath_call compiler ManagedRealpathToWide
          ([source, bytes, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) copied)
        (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
          lower_bind ManagedState ManagedResult (managed_file_status compiler scope status next)
            (managed_realpath_path_allocate compiler storage source bytes count scope) end));

def managed_realpath_path_storage (compiler : ManagedCompiler) (path : MirValue) (bytes : MirValue)
    (storage : MirValue) (scope : ManagedFileScope) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_pointer storage 16 state)
      (fun (located : ManagedResult) => match located with | ManagedResultOf count next =>
        managed_file_buffer compiler scope bytes (managed_realpath_path_copy compiler storage path bytes count)
          (managed_emit_all ([MirStore(storage, codegen_disp 0, managed_bits MirUSize 0),
            MirStore(storage, codegen_disp 8, managed_bits MirUSize 0),
            MirStore(storage, codegen_disp 16, managed_bits MirUSize 0)] : List MirInstruction) next) end);

def managed_realpath_body (compiler : ManagedCompiler) (path : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let scope : ManagedFileScope := ManagedFileScopeOf([] : List MirValue, Nothing MirValue) in
    lower_bind ManagedResult ManagedResult (managed_string_size compiler path state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual bytes (managed_bits MirUSize 0) next)
          (fun (checked : ManagedResult) => match checked with | ManagedResultOf empty after =>
            managed_string_choose MirManagedPtr empty (managed_realpath_missing compiler scope)
              (fun (nonempty : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_compare MirLessEqual bytes managed_realpath_int_max nonempty)
                (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                  lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits final)
                    (managed_file_buffer compiler scope (managed_bits MirUSize 24)
                      (managed_realpath_path_storage compiler path bytes)) end)) after end) end);
