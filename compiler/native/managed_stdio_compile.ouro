-- Native driver and fixture callers share the same checked managed lowerer.
import "managed_source.ouro";

-- One checked program, then managed lowering. Scalar lowering runs only when
-- the entry is a raw Runtime/word program (no GC symbols / IO type).
def native_emit_image (limits : MirLimits) (lowered : NativeLoweredProgram)
    : Either NativeSourceError NativeImage :=
    match lowered with
    | NativeLoweredOf _ _ mir =>
      match codegen_program limits mir with
      | Left error =>
          Left NativeSourceError NativeImage (NativeSourceLowerError (LowerBackendFailure error))
      | Right image => Right NativeSourceError NativeImage image
      end
    end;

def native_scalar_lower_checked (fuel : Nat) (limits : MirLimits) (entry : Nat)
    (checked : CheckedProgram) : Either NativeSourceError NativeLoweredProgram :=
    match native_lower_checked fuel limits entry checked with
    | Left error => Left NativeSourceError NativeLoweredProgram (NativeSourceLowerError error)
    | Right lowered => Right NativeSourceError NativeLoweredProgram lowered
    end;

def native_lower_auto (fuel : Nat) (limits : MirLimits) (entry : Nat)
    (checked : CheckedProgram) : Either NativeSourceError NativeLoweredProgram :=
    match native_managed_lower_checked fuel limits entry checked with
    | Right lowered => Right NativeSourceError NativeLoweredProgram lowered
    | Left error =>
      match error with
      | NativeSourceCheckError _ => Left NativeSourceError NativeLoweredProgram error
      | NativeSourceLowerError failure =>
        match failure with
        | LowerUnsupportedType _ =>
            native_scalar_lower_checked fuel limits entry checked
        | LowerUnknownGlobal _ =>
            native_scalar_lower_checked fuel limits entry checked
        | LowerResourceExhausted => Left NativeSourceError NativeLoweredProgram error
        | LowerDeclarationFailure _ _ _ => Left NativeSourceError NativeLoweredProgram error
        | LowerMetadataMismatch _ => Left NativeSourceError NativeLoweredProgram error
        | LowerBodyMismatch _ => Left NativeSourceError NativeLoweredProgram error
        | LowerUnsupportedTerm _ => Left NativeSourceError NativeLoweredProgram error
        | LowerUnsupportedPrimitive _ => Left NativeSourceError NativeLoweredProgram error
        | LowerUnboundLocal _ => Left NativeSourceError NativeLoweredProgram error
        | LowerInvalidCall _ => Left NativeSourceError NativeLoweredProgram error
        | LowerEffectMismatch => Left NativeSourceError NativeLoweredProgram error
        | LowerInvalidEntry _ => Left NativeSourceError NativeLoweredProgram error
        | LowerMirFailure _ => Left NativeSourceError NativeLoweredProgram error
        | LowerBackendFailure _ => Left NativeSourceError NativeLoweredProgram error
        end
      end
    end;

def native_compile_units_auto (fuel : Nat) (limits : MirLimits) (entry_name : List Nat)
    (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError NativeImage :=
    match compile_checked_units fuel root files with
    | CErr err => Left NativeSourceError NativeImage (NativeSourceCheckError err)
    | COk checked =>
      match checked_program_intern checked with
      | MkIntern names _ _ _ =>
        match source_lookup_id names entry_name with
        | Nothing =>
            Left NativeSourceError NativeImage (NativeSourceLowerError (LowerInvalidEntry 0))
        | Just entry =>
          match native_lower_auto fuel limits entry checked with
          | Left error => Left NativeSourceError NativeImage error
          | Right lowered => native_emit_image limits lowered
          end
        end
      end
    end;
