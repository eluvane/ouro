-- Native driver and fixture callers share the same checked managed lowerer.
import "managed_source.ouro",
  "image_types.ouro",
  "mir_model.ouro",
  "lower_model.ouro",
  "x64.ouro",
  "pe_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "lower_source.ouro",
  "../pipeline_abi.ouro",
  "codegen.ouro",
  "lower.ouro",
  "../driver.ouro";

-- One checked program, then managed lowering. Scalar lowering runs only when
-- the entry is a raw Runtime/word program (no GC symbols / IO type).
def native_emit_image (limits : MirLimits) (lowered : NativeLoweredProgram)
    : Either NativeSourceError NativeImage :=
    match lowered with
    | NativeLoweredOf _ _ mir =>
      match codegen_program limits mir with
      | Left error =>
          Left NativeSourceError NativeImage (NativeSourceLowerError (LowerBackendFailure error))
      | Right image => Right NativeSourceError NativeImage image
      end
    end;

def native_scalar_lower_checked (fuel : Nat) (limits : MirLimits) (entry : Nat)
    (checked : CheckedProgram) : Either NativeSourceError NativeLoweredProgram :=
    match native_lower_checked fuel limits entry checked with
    | Left error => Left NativeSourceError NativeLoweredProgram (NativeSourceLowerError error)
    | Right lowered => Right NativeSourceError NativeLoweredProgram lowered
    end;

def native_scalar_lower_rechecked (limits : MirLimits) (entry : Nat)
    (rechecked : NativeRecheckedProgram) : Either NativeSourceError NativeLoweredProgram :=
    match native_lower_rechecked limits entry rechecked with
    | Left error => Left NativeSourceError NativeLoweredProgram (NativeSourceLowerError error)
    | Right lowered => Right NativeSourceError NativeLoweredProgram lowered
    end;

def native_lower_auto_with (Lowered : Type) (fuel : Nat) (checked : CheckedProgram)
    (managed : NativeRecheckedProgram -> Either NativeSourceError Lowered)
    (scalar : NativeRecheckedProgram -> Either NativeSourceError Lowered)
    : Either NativeSourceError Lowered :=
    match native_prepare_rechecked_program fuel checked with
    | Left failure => Left NativeSourceError Lowered (NativeSourceLowerError failure)
    | Right rechecked => match managed rechecked with
      | Right lowered => Right NativeSourceError Lowered lowered
      | Left error => match error with
        | NativeSourceCheckError _ => Left NativeSourceError Lowered error
        | NativeSourceLowerError failure => match failure with
          | LowerUnsupportedType _ => scalar rechecked
          | LowerUnknownGlobal _ => scalar rechecked
          | LowerResourceExhausted => Left NativeSourceError Lowered error
          | LowerDeclarationFailure _ _ _ => Left NativeSourceError Lowered error
          | LowerMetadataMismatch _ => Left NativeSourceError Lowered error
          | LowerBodyMismatch _ => Left NativeSourceError Lowered error
          | LowerUnsupportedTerm _ => Left NativeSourceError Lowered error
          | LowerUnsupportedPrimitive _ => Left NativeSourceError Lowered error
          | LowerUnboundLocal _ => Left NativeSourceError Lowered error
          | LowerInvalidCall _ => Left NativeSourceError Lowered error
          | LowerEffectMismatch => Left NativeSourceError Lowered error
          | LowerInvalidEntry _ => Left NativeSourceError Lowered error
          | LowerMirFailure _ => Left NativeSourceError Lowered error
          | LowerBackendFailure _ => Left NativeSourceError Lowered error
          end
        end
      end
    end;

def native_lower_auto (fuel : Nat) (limits : MirLimits) (entry : Nat)
    (checked : CheckedProgram) : Either NativeSourceError NativeLoweredProgram :=
    native_lower_auto_with NativeLoweredProgram fuel checked
      (native_managed_lower_rechecked limits entry) (native_scalar_lower_rechecked limits entry);

def native_compile_units_auto (fuel : Nat) (limits : MirLimits) (entry_name : List Nat)
    (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError NativeImage :=
    match compile_checked_units fuel root files with
    | CErr err => Left NativeSourceError NativeImage (NativeSourceCheckError err)
    | COk checked =>
      match checked_program_intern checked with
      | MkIntern names _ _ _ =>
        match source_lookup_id names entry_name with
        | Nothing =>
            Left NativeSourceError NativeImage (NativeSourceLowerError (LowerInvalidEntry 0))
        | Just entry =>
          match native_lower_auto fuel limits entry checked with
          | Left error => Left NativeSourceError NativeImage error
          | Right lowered => native_emit_image limits lowered
          end
        end
      end
    end;
