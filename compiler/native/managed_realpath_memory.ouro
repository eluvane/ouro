-- Realpath shares ordinary file ownership: CloseHandle first, then every
-- raw page in reverse acquisition order. No argv/LocalFree scope is used.
import "managed_files_memory.ouro";

inductive ManagedRealpathHelper : Type :=
  | ManagedRealpathAllocate : ManagedRealpathHelper | ManagedRealpathRelease : ManagedRealpathHelper
  | ManagedRealpathToWide : ManagedRealpathHelper | ManagedRealpathFromWide : ManagedRealpathHelper
  | ManagedRealpathOpen : ManagedRealpathHelper | ManagedRealpathRead : ManagedRealpathHelper
  | ManagedRealpathClose : ManagedRealpathHelper;

def managed_realpath_helper_name (helper : ManagedRealpathHelper) : List Nat :=
    match helper with
    | ManagedRealpathAllocate => managed_file_helper_name ManagedFileAllocate
    | ManagedRealpathRelease => managed_file_helper_name ManagedFileRelease
    | ManagedRealpathToWide => managed_file_helper_name ManagedFileToWide
    | ManagedRealpathFromWide => managed_startup_helper_name ManagedStartupFromWide
    | ManagedRealpathOpen => ([114,97,119,95,119,105,110,100,111,119,115,95,114,101,97,108,112,97,116,104,95,111,112,101,110] : List Nat)
    | ManagedRealpathRead => ([114,97,119,95,119,105,110,100,111,119,115,95,114,101,97,108,112,97,116,104,95,114,101,97,100] : List Nat)
    | ManagedRealpathClose => managed_file_helper_name ManagedFileClose end;

def managed_realpath_expected (compiler : ManagedCompiler) (helper : ManagedRealpathHelper)
    : Either NativeLowerError CoreTerm :=
    match helper with
    | ManagedRealpathAllocate => managed_file_expected compiler ManagedFileAllocate
    | ManagedRealpathRelease => managed_file_expected compiler ManagedFileRelease
    | ManagedRealpathToWide => managed_file_expected compiler ManagedFileToWide
    | ManagedRealpathFromWide => managed_startup_expected compiler ManagedStartupFromWide
    | ManagedRealpathOpen => managed_file_expected compiler ManagedFileOpenWrite
    | ManagedRealpathRead => managed_file_expected compiler ManagedFileRead
    | ManagedRealpathClose => managed_file_expected compiler ManagedFileClose end;

def managed_realpath_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    match managed_stdio_has compiler PrimitiveFileRealpath with
    | False => Right NativeLowerError (List Nat) ([] : List Nat)
    | True => (fix resolve (helpers : List ManagedRealpathHelper) : Either NativeLowerError (List Nat) :=
        match helpers with | Nil => Right NativeLowerError (List Nat) ([] : List Nat)
        | Cons helper rest => lower_bind CoreTerm (List Nat) (managed_realpath_expected compiler helper)
            (fun (expected : CoreTerm) => lower_bind Nat (List Nat)
              (managed_runtime_definition compiler fuel (managed_realpath_helper_name helper) expected)
              (fun (id : Nat) => lower_map (List Nat) (List Nat) (Cons Nat id) (resolve rest))) end)
        ([ManagedRealpathAllocate, ManagedRealpathRelease, ManagedRealpathToWide, ManagedRealpathFromWide,
          ManagedRealpathOpen, ManagedRealpathRead, ManagedRealpathClose] : List ManagedRealpathHelper) end;

def managed_realpath_call (compiler : ManagedCompiler) (helper : ManagedRealpathHelper)
    (arguments : List MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (managed_realpath_expected compiler helper) (fun (expected : CoreTerm) =>
      lower_bind LowerContract ManagedResult
        (managed_runtime_contract compiler primitive_default_fuel (managed_realpath_helper_name helper) expected)
        (fun (contract : LowerContract) =>
          let typ : MirType := match helper with
            | ManagedRealpathAllocate => MirRawPtr | ManagedRealpathRelease => MirU8
            | ManagedRealpathToWide => MirU32 | ManagedRealpathFromWide => MirU32
            | ManagedRealpathOpen => MirU32 | ManagedRealpathRead => MirU32 | ManagedRealpathClose => MirU32 end in
          managed_fresh typ (fun (local : Nat) =>
            MirCall MirMayGc (Just Nat local) (MirDirect (lower_contract_id contract)) arguments) state));

def managed_realpath_missing (compiler : ManagedCompiler) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_string_allocate compiler (managed_bits MirUSize 0) state)
      (fun (empty : ManagedResult) => match empty with | ManagedResultOf value next =>
        managed_file_complete compiler scope value next end);

-- Only status one represents ordinary OS unavailability. Contract failures,
-- malformed text and incomplete reads terminate after complete scoped cleanup.
def managed_realpath_status (compiler : ManagedCompiler) (scope : ManagedFileScope) (status : MirValue)
    (body : ManagedState -> Either NativeLowerError ManagedResult) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual status (managed_bits MirU32 1) state)
      (fun (tested : ManagedResult) => match tested with | ManagedResultOf valid next =>
        lower_bind ManagedState ManagedResult (managed_file_require compiler scope valid next)
          (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_startup_zero status checked)
            (fun (compared : ManagedResult) => match compared with | ManagedResultOf success after =>
              managed_string_choose MirManagedPtr success body (managed_realpath_missing compiler scope) after end)) end);
