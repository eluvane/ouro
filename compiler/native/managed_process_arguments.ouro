-- Each argument staging page is released before the next iteration. The raw
-- owner retains its converted copy; the managed list tail remains a GC root.
import "managed_process_memory.ouro";
import "managed_model.ouro";
import "mir_model.ouro";
import "x64.ouro";
import "pe_model.ouro";
import "managed_files_memory.ouro";
import "lower_model.ouro";
import "codegen_model.ouro";
import "../primitive_model.ouro";
import "../file_check_model.ouro";
import "../pipeline_abi.ouro";
import "managed_strings.ouro";
import "lower_constants.ouro";
import "lower_loop.ouro";
import "managed_string_lists.ouro";
import "managed_string_ops.ouro";
import "lower_types.ouro";

def managed_process_push_buffer (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (value : MirValue) (bytes : MirValue) (buffer : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let owned : ManagedFileScope := managed_file_own buffer scope in
    lower_bind ManagedState ManagedState
      (managed_bytes_copy value (managed_bits MirUSize 40) buffer (managed_bits MirUSize 0) bytes state)
      (fun (copied : ManagedState) => lower_bind ManagedResult ManagedState
        (managed_process_call compiler ManagedProcessPush ([owner, buffer, bytes] : List MirValue) copied)
        (fun (pushed : ManagedResult) => match pushed with | ManagedResultOf status next =>
          lower_bind ManagedState ManagedState (managed_process_status compiler owner owned status next)
            (fun (checked : ManagedState) => lower_bind ManagedResult ManagedState
              (managed_process_call compiler ManagedProcessRelease ([buffer] : List MirValue) checked)
              (fun (released : ManagedResult) => match released with | ManagedResultOf okay after =>
                managed_process_require compiler owner owned okay after end)) end));

def managed_process_push (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (value : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_string_size compiler value state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedState (managed_binary MirUSize MirAdd bytes (managed_bits MirUSize 1) next)
          (fun (sized_buffer : ManagedResult) => match sized_buffer with | ManagedResultOf capacity sized_state =>
            lower_bind ManagedResult ManagedState
              (managed_process_call compiler ManagedProcessAllocate
                ([capacity, managed_bits MirUSize 8] : List MirValue) sized_state)
              (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf buffer after =>
                lower_bind ManagedResult ManagedState (managed_compare MirNotEqual buffer (managed_bits MirRawPtr 0) after)
                  (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay entered =>
                    lower_bind ManagedState ManagedState (managed_process_require compiler owner scope okay entered)
                      (managed_process_push_buffer compiler owner scope value bytes buffer) end) end) end) end);

def managed_process_arguments (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (arguments : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind Nat ManagedState (lower_role_identity (managed_compiler_entries compiler) PrimitiveListRole)
      (fun (family : Nat) => lower_bind (Pair Nat ManagedState) ManagedState (managed_fresh_local MirManagedPtr state)
        (fun (cell : Pair Nat ManagedState) => match cell with | MkPair cursor next =>
          let initialized : ManagedState := managed_emit (MirMove cursor arguments) next in
          lower_bind LowerLoopBlocks ManagedState (lower_loop_blocks (managed_flow initialized))
            (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
              lower_bind ManagedResult ManagedState (managed_string_list_tag compiler family (MirUse cursor)
                (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                (fun (tested : ManagedResult) => match tested with | ManagedResultOf running after_test =>
                  lower_bind ManagedResult ManagedState (managed_load MirManagedPtr (MirUse cursor) 56
                    (managed_switch_block body (MirBranch running body finish) after_test))
                    (fun (head : ManagedResult) => match head with | ManagedResultOf value after_head =>
                      lower_bind ManagedResult ManagedState (managed_load MirManagedPtr (MirUse cursor) 64 after_head)
                        (fun (tail : ManagedResult) => match tail with | ManagedResultOf rest after_tail =>
                          lower_map ManagedState ManagedState (fun (pushed : ManagedState) =>
                            managed_switch_block finish (MirJump header) (managed_emit (MirMove cursor rest) pushed))
                            (managed_process_push compiler owner scope value after_tail) end) end) end) end) end));
