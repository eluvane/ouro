-- Optional native specialization of complete, already checked definitions.
-- Resolved roles and exact Core authorize it; display names have no authority.
import "lower_constants.ouro",
  "../../std/types.ouro",
  "../core.ouro",
  "lower_model.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "pe_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "../pipeline_abi.ouro",
  "lower_boundary.ouro",
  "../file_check_result.ouro",
  "../file_elab_core.ouro",
  "../primitive_contracts.ouro",
  "../primitive_roles.ouro",
  "../file_elab_lookup.ouro";

inductive ManagedNatOperation : Type :=
  | ManagedNatEqual : Nat -> ManagedNatOperation
  | ManagedNatAdd : ManagedNatOperation
  | ManagedNatSubtract : ManagedNatOperation
  | ManagedNatCompare : Nat -> ManagedNatOperation;

inductive ManagedNatSmallOperation : Type :=
  | ManagedNatSmallMultiply : ManagedNatSmallOperation
  | ManagedNatSmallDivide : ManagedNatSmallOperation
  | ManagedNatSmallRemainder : ManagedNatSmallOperation;

def managed_nat_binary_type (natural : Nat) (result : Nat) : CoreTerm :=
    CPi(CInd natural, CPi(CInd natural, CInd result));

def managed_nat_comparison_template (natural : Nat) (result : Nat)
    (equal : Nat) (less : Nat) (greater : Nat) : CoreTerm :=
    let number : CoreTerm := CInd natural in
    let motive : CoreTerm := CLam(number, CInd result) in
    let info : CaseInfo := MkCaseInfo natural 0 ([0,1] : List Nat) in
    CFix 0 0 2 (managed_nat_binary_type natural result)
      (CLam number (CLam number (CCase info motive (CRel 1)
        ([CCase info (CLam(number, CApp(motive, CConstruct natural 0 0))) (CRel 0)
            ([CConstruct result equal 0, CLam(number, CConstruct result less 0)] : List CoreTerm),
          CLam number (CCase info
            (CLam(number, CApp(motive, CApp(CConstruct natural 1 0, CRel 1)))) (CRel 1)
            ([CConstruct result greater 0,
              CLam(number, CApp(CApp(CRel 4, CRel 1), CRel 0))] : List CoreTerm))] : List CoreTerm))));

def managed_nat_add_template (natural : Nat) : CoreTerm :=
    let number : CoreTerm := CInd natural in
    CFix 0 0 2 (managed_nat_binary_type natural natural)
      (CLam number (CLam number (CCase (MkCaseInfo natural 0 ([0,1] : List Nat))
        (CLam number number) (CRel 1)
        ([CRel 0, CLam number (CApp (CConstruct natural 1 0)
          (CApp(CApp(CRel 3, CRel 0), CRel 1)))] : List CoreTerm))));

def managed_nat_subtract_template (natural : Nat) : CoreTerm :=
    let number : CoreTerm := CInd natural in
    let motive : CoreTerm := CLam number number in
    let info : CaseInfo := MkCaseInfo natural 0 ([0,1] : List Nat) in
    CFix 0 0 2 (managed_nat_binary_type natural natural)
      (CLam number (CLam number (CCase info motive (CRel 1)
        ([CConstruct natural 0 0,
          CLam number (CCase info
            (CLam(number, CApp(motive, CApp(CConstruct natural 1 0, CRel 1)))) (CRel 1)
            ([CRel 2, CLam(number, CApp(CApp(CRel 4, CRel 1), CRel 0))] : List CoreTerm))] : List CoreTerm))));

def managed_nat_core_equal (fuel : Nat) (id : Nat) (left : CoreTerm) (right : CoreTerm)
    : Either NativeLowerError Bool :=
    lower_check Bool id (check_from_normalize(Bool, eqTerm_checked fuel left right));

def managed_nat_exact (fuel : Nat) (id : Nat) (annotation : CoreTerm) (body : CoreTerm)
    (expected_type : CoreTerm) (expected_body : CoreTerm) : Either NativeLowerError Bool :=
    lower_bind Bool Bool (managed_nat_core_equal fuel id annotation expected_type)
      (fun (typed : Bool) => match typed with
        | False => Right NativeLowerError Bool False
        | True => managed_nat_core_equal fuel id body expected_body end);

def managed_nat_registered (entries : List Entry) (role : PrimitiveRole) : Maybe Nat :=
    mapMaybe PrimitiveRoleBinding Nat primitive_role_id
      (find PrimitiveRoleBinding (fun (binding : PrimitiveRoleBinding) =>
        primitive_role_equal(role, primitive_role_kind binding)) (primitive_roles_environment entries));

-- Only a literal Nat -> Nat -> family declaration can select these templates.
def managed_nat_type_families (left : CoreTerm) (right : CoreTerm) (result : CoreTerm) : Maybe (Pair Nat Nat) :=
    match primitive_shape left with
    | PrimitiveShapeAtom left_tag natural => match primitive_shape right with
        | PrimitiveShapeAtom right_tag other => match primitive_shape result with
            | PrimitiveShapeAtom result_tag family =>
                match andb (eqNat left_tag 3)
                  (andb(eqNat right_tag 3, andb(eqNat result_tag 3, eqNat natural other))) with
                | True => Just(Pair Nat Nat, MkPair Nat Nat natural family)
                | False => Nothing (Pair Nat Nat) end
            | PrimitiveShapePair _ _ _ => Nothing (Pair Nat Nat)
            | PrimitiveShapeOther => Nothing (Pair Nat Nat) end
        | PrimitiveShapePair _ _ _ => Nothing (Pair Nat Nat)
        | PrimitiveShapeOther => Nothing (Pair Nat Nat) end
    | PrimitiveShapePair _ _ _ => Nothing (Pair Nat Nat)
    | PrimitiveShapeOther => Nothing (Pair Nat Nat) end;

def managed_nat_type_parts (annotation : CoreTerm) : Maybe (Pair Nat Nat) :=
    match primitive_shape annotation with
    | PrimitiveShapePair first left rest => match primitive_shape rest with
        | PrimitiveShapePair second right result => match andb(eqNat first 4, eqNat second 4) with
            | True => managed_nat_type_families left right result
            | False => Nothing (Pair Nat Nat) end
        | PrimitiveShapeAtom _ _ => Nothing (Pair Nat Nat)
        | PrimitiveShapeOther => Nothing (Pair Nat Nat) end
    | PrimitiveShapeAtom _ _ => Nothing (Pair Nat Nat)
    | PrimitiveShapeOther => Nothing (Pair Nat Nat) end;

def managed_nat_result_enum (entries : List Entry) (fuel : Nat) (id : Nat) (family : Nat)
    : Either NativeLowerError Bool :=
    match lookup_ind family entries with
    | Nothing => Right NativeLowerError Bool False
    | Just declaration => match declaration with | MkIndDecl actual parameters indices level constructors =>
        match andb (eqNat actual family) (andb (nullb Param parameters)
          (andb(nullb CoreTerm indices, andb(eqNat level 0, eqNat(length Ctor constructors, 3))))) with
        | False => Right NativeLowerError Bool False
        | True => foldr Ctor (Either NativeLowerError Bool)
            (fun (constructor : Ctor) (tail : Either NativeLowerError Bool) =>
              lower_bind Bool Bool tail (fun (matched : Bool) => match matched with
                | False => Right NativeLowerError Bool False
                | True => match constructor with | MkCtor _ typ =>
                    managed_nat_core_equal fuel id typ (CInd family) end end))
            (Right NativeLowerError Bool True) constructors end end end;

def managed_nat_operation_when (operation : ManagedNatOperation) (matched : Bool) : Maybe ManagedNatOperation :=
    match matched with | True => Just ManagedNatOperation operation | False => Nothing ManagedNatOperation end;

def managed_nat_recognize_result (entries : List Entry) (fuel : Nat) (id : Nat)
    (natural : Nat) (result : Nat) (annotation : CoreTerm) (body : CoreTerm)
    : Either NativeLowerError (Maybe ManagedNatOperation) :=
    let typ : CoreTerm := managed_nat_binary_type natural result in
    match eqNat natural result with
    | True => lower_bind Bool (Maybe ManagedNatOperation)
        (managed_nat_exact fuel id annotation body typ (managed_nat_add_template natural))
        (fun (addition : Bool) => match addition with
          | True => Right(NativeLowerError, Maybe ManagedNatOperation, Just ManagedNatOperation ManagedNatAdd)
          | False => lower_map Bool (Maybe ManagedNatOperation) (managed_nat_operation_when ManagedNatSubtract)
              (managed_nat_exact fuel id annotation body typ (managed_nat_subtract_template natural)) end)
    | False => let boolean : Bool := match managed_nat_registered entries PrimitiveBoolRole with
          | Just family => eqNat result family | Nothing => False end in
        match boolean with
        | True => lower_map Bool (Maybe ManagedNatOperation) (managed_nat_operation_when (ManagedNatEqual result))
            (managed_nat_exact fuel id annotation body typ (managed_nat_comparison_template natural result 0 1 1))
        | False => lower_bind Bool (Maybe ManagedNatOperation) (managed_nat_result_enum entries fuel id result)
            (fun (enumeration : Bool) => match enumeration with
              | False => Right(NativeLowerError, Maybe ManagedNatOperation, Nothing ManagedNatOperation)
              | True => lower_map Bool (Maybe ManagedNatOperation) (managed_nat_operation_when (ManagedNatCompare result))
                  (managed_nat_exact fuel id annotation body typ (managed_nat_comparison_template natural result 1 0 2)) end)
        end end;

-- The caller has rechecked the program and closed/checked this exact body.
-- Mismatches retain ordinary lowering; checked comparison failures propagate.
def managed_nat_recognize (entries : List Entry) (fuel : Nat) (id : Nat)
    (annotation : CoreTerm) (body : CoreTerm) : Either NativeLowerError (Maybe ManagedNatOperation) :=
    match managed_nat_type_parts annotation with
    | Nothing => Right(NativeLowerError, Maybe ManagedNatOperation, Nothing ManagedNatOperation)
    | Just parts => match parts with | MkPair natural result =>
        match managed_nat_registered entries PrimitiveNatRole with
        | Nothing => Right(NativeLowerError, Maybe ManagedNatOperation, Nothing ManagedNatOperation)
        | Just registered => match eqNat natural registered with
            | False => Right(NativeLowerError, Maybe ManagedNatOperation, Nothing ManagedNatOperation)
            | True => managed_nat_recognize_result entries fuel id natural result annotation body end end end end;
