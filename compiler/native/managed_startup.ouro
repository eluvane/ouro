-- The zero-argument argv value is already an action. Environment lookup is
-- a first-class unary closure whose application only captures its name.
import "managed_startup_argv.ouro";
import "managed_startup_environment.ouro";

def managed_startup_operation (primitive : PrimitiveId) : Maybe Bool :=
    match primitive_id_equal primitive PrimitiveArgv with | True => Just Bool False | False =>
      match primitive_id_equal primitive PrimitiveEnvGet with | True => Just Bool True
      | False => Nothing Bool end end;

def managed_startup_environment_partial (compiler : ManagedCompiler) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_startup_environment_action compiler (MirUse 1) (managed_with_flow reserved (lower_empty_state 2)))
          (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf action after =>
            let function : MirFunction := managed_finish_function symbol
              ([111,117,114,111,95,101,110,118,95,112,97,114,116,105,97,108] : List Nat)
              ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) action after in
            managed_emit_callable compiler 3 symbol False ([] : List MirValue)
              (managed_with_flow (managed_add_function function after) caller) end) end);

def managed_startup_value (compiler : ManagedCompiler) (environment : Bool) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match environment with | False => managed_startup_argv_action compiler state
    | True => managed_startup_environment_partial compiler state end;

def managed_startup_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (environment : Bool) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match environment with
    | False => lower_bind Unit ManagedResult (lower_require (eqNat (length CoreTerm arguments) 0) (LowerInvalidCall 0))
        (fun (_ : Unit) => managed_startup_argv_action compiler state)
    | True => lower_bind CoreTerm ManagedResult (lower_single CoreTerm arguments) (fun (term : CoreTerm) =>
        lower_bind ManagedResult ManagedResult (step scope term state)
          (fun (value : ManagedResult) => match value with | ManagedResultOf name next =>
            managed_startup_environment_action compiler name next end)) end;
