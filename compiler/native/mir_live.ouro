-- Managed local liveness is derived from MIR uses, definitions and CFG edges.
-- Facts start empty and grow backwards to a fixed point. No annotation or
-- partially converged result is accepted as a reason to remove a root.
import "mir.ouro",
  "mir_model.ouro",
  "mir_flow.ouro",
  "x64.ouro",
  "mir_gc.ouro";

def mir_live_roots (function : MirFunction) : List Nat :=
    match function with | MirFunctionDef _ _ args locals _ _ _ =>
      concat_map MirLocal Nat (fun (local : MirLocal) => match local with | MirLocalDef id typ =>
        match mir_type_equal typ MirManagedPtr with | True => ([id] : List Nat) | False => ([] : List Nat) end end)
        (append MirLocal args locals) end;

def mir_live_reads (roots : List Nat) (values : List MirValue) : List Nat :=
    foldr MirValue (List Nat) (fun (value : MirValue) (live : List Nat) => match value with
      | MirBits _ _ => live | MirUse id => match mir_has id roots with
        | True => mir_add id live | False => live end end) ([] : List Nat) values;

def mir_live_instruction (roots : List Nat) (after : List Nat) (instruction : MirInstruction) : List Nat :=
    let carried : List Nat := match mir_destination instruction with
      | Nothing => after | Just dest => filter Nat (fun (id : Nat) => notb (eq_nat id dest)) after end in
    mir_union(mir_live_reads(roots, mir_reads instruction), carried);

def mir_live_before (roots : List Nat) (instructions : List MirInstruction) (after : List Nat) : List Nat :=
    foldr MirInstruction (List Nat) (fun (instruction : MirInstruction) (live : List Nat) =>
      mir_live_instruction roots live instruction) after instructions;

def mir_live_successors (facts : List MirBlockFact)
    : List Nat -> Either MirError (List Nat) :=
  fix collect (successors : List Nat) : Either MirError (List Nat) :=
    match successors with | Nil => Right(MirError, List Nat, [] : List Nat)
    | Cons id rest => match mir_fact_at id facts with
      | Left err => Left MirError (List Nat) err | Right values =>
        mapRight(MirError, List Nat, List Nat, mir_union values, collect rest) end end;

def mir_live_after (roots : List Nat) (facts : List MirBlockFact) (block : MirBlock)
    : Either MirError (List Nat) :=
    match block with | MirBlockDef _ _ term =>
      mapRight MirError (List Nat) (List Nat) (mir_union (mir_live_reads(roots, mir_terminator_reads term)))
        (mir_live_successors(facts, mir_successors block)) end;

def mir_live_step (roots : List Nat) (facts : List MirBlockFact)
    : List MirBlock -> Either MirError (List MirBlockFact) :=
  fix step (blocks : List MirBlock) : Either MirError (List MirBlockFact) :=
    match blocks with | Nil => Right(MirError, List MirBlockFact, [] : List MirBlockFact)
    | Cons block rest => match block with | MirBlockDef id instructions _ =>
      match mir_live_after roots facts block with | Left err => Left MirError (List MirBlockFact) err
      | Right after => mapRight MirError (List MirBlockFact) (List MirBlockFact)
          (fun (tail : List MirBlockFact) => Cons MirBlockFact (MirFact(id, mir_live_before roots instructions after)) tail)
          (step rest) end end end;

-- GEN is the exact ordered transfer from empty successor facts; KILL contains
-- every destination, including non-roots for arbitrary-input helper parity.
-- Retaining successor order also retains the first unknown-edge diagnostic.
inductive MirLiveSummary : Type :=
  | MirLiveTransfer : Nat -> List Nat -> List Nat -> List Nat -> MirLiveSummary;

def mir_live_summary (roots : List Nat) (block : MirBlock) : MirLiveSummary :=
    match block with | MirBlockDef id instructions term =>
      MirLiveTransfer id
        (mir_live_before roots instructions (mir_live_reads(roots, mir_terminator_reads term)))
        (mir_generated block) (mir_successors block) end;

def mir_live_summary_step (facts : List MirBlockFact)
    : List MirLiveSummary -> Either MirError (List MirBlockFact) :=
  fix step (summaries : List MirLiveSummary) : Either MirError (List MirBlockFact) :=
    match summaries with | Nil => Right(MirError, List MirBlockFact, [] : List MirBlockFact)
    | Cons summary rest => match summary with | MirLiveTransfer id generated killed successors =>
      match mir_live_successors facts successors with
      | Left err => Left MirError (List MirBlockFact) err
      | Right after =>
        let before : List Nat := mir_union generated
          (filter Nat (fun (value : Nat) => notb (mir_has value killed)) after) in
        mapRight MirError (List MirBlockFact) (List MirBlockFact)
          (fun (tail : List MirBlockFact) => Cons MirBlockFact (MirFact id before) tail)
          (step rest) end end end;

-- A live use reaches its predecessors along a simple path: a repeated block
-- adds no new use of the same local. N blocks therefore need at most N growth
-- rounds plus the equality check, independent of block ordering and backedges.
-- Callers may supply a smaller budget; exhaustion remains an exact error.
def mir_live_facts (fuel : Nat) (roots : List Nat) (blocks : List MirBlock)
    : Either MirError (List MirBlockFact) :=
    match fuel with | Z => Left MirError (List MirBlockFact) MirResourceExhausted | S _ =>
    let summaries : List MirLiveSummary := map MirBlock MirLiveSummary (mir_live_summary roots) blocks in
    let initial : List MirBlockFact := map MirBlock MirBlockFact
      (fun (block : MirBlock) => MirFact(mir_block_id block, [] : List Nat)) blocks in
    -- Every block reads only the previous round, never a just-updated fact.
    (fix converge (remaining : Nat) (facts : List MirBlockFact) : Either MirError (List MirBlockFact) :=
      match remaining with | Z => Left MirError (List MirBlockFact) MirResourceExhausted
      | S next => match mir_live_summary_step facts summaries with
        | Left err => Left MirError (List MirBlockFact) err
        | Right updated => match mir_facts_equal facts updated with
          | True => Right MirError (List MirBlockFact) updated
          | False => converge next updated end end end) fuel initial end;

def mir_live_instructions (roots : List Nat)
    : List MirInstruction -> List Nat -> Pair (List Nat) (List (Pair MirInstruction (List Nat))) :=
  fix annotate (instructions : List MirInstruction) (after : List Nat)
      : Pair (List Nat) (List (Pair MirInstruction (List Nat))) :=
    match instructions with
    | Nil => MkPair(List Nat, List (Pair(MirInstruction, List Nat)), after, [] : List (Pair(MirInstruction, List Nat)))
    | Cons instruction rest => match annotate rest after with | MkPair next tail =>
      let before : List Nat := mir_live_instruction roots next instruction in
      MkPair (List Nat) (List (Pair(MirInstruction, List Nat))) before
        (Cons(Pair(MirInstruction, List Nat), MkPair MirInstruction (List Nat) instruction before, tail)) end end;

def mir_live_safepoint (instruction : MirInstruction) : Bool :=
    match instruction with | MirManagedAlloc _ _ _ _ _ => True
    | MirCall gc _ _ _ => notb (mir_gc_is_no_gc gc)
    | MirMove _ _ => False | MirBinaryOp _ _ _ _ => False | MirCompare _ _ _ _ => False
    | MirConvert _ _ _ => False | MirLoad _ _ _ => False | MirStore _ _ _ => False
    | MirLoadAt _ _ _ => False | MirStoreAt _ _ _ => False
    | MirAddress _ _ => False | MirPointerAdd _ _ _ => False | MirManagedContext _ => False end;
