-- x64 unwind records and an embedded function-address map.
-- https://learn.microsoft.com/cpp/build/exception-handling-x64
-- https://learn.microsoft.com/cpp/build/prolog-and-epilog

import "pe_model.ouro";
import "image_types.ouro";
import "x64.ouro";

inductive PePushInfo : Type :=
  | PePushInfoData : List Nat -> List Nat -> Nat -> PePushInfo;

inductive PeUnwindInfo : Type :=
  | PeUnwindInfoData : List Nat -> List Nat -> PeUnwindInfo;

inductive PeFunctionInfo : Type :=
  | PeFunctionInfoData : Nat -> Nat -> Nat -> List Nat -> List Nat -> PeFunctionInfo;

-- FunctionInfoData: ID, begin RVA, end RVA, name bytes, unwind bytes.
-- The cursor retains the original text suffix at the checked function start.
inductive PeFunctionScan : Type :=
  | PeFunctionScanAt : PeFunctionInfo -> List Nat -> PeFunctionScan;

inductive PeFunctionTables : Type :=
  | PeFunctionTablesData : List Nat -> List Nat -> List Nat -> List PeFunctionAddress -> PeFunctionTables;

def pe_nonvolatile (reg : X64Register) : Bool :=
    elem Nat eq_nat (x64_register_code reg) ([3, 5, 6, 7, 12, 13, 14, 15] : List Nat);

def pe_validate_saved (name : Nat) : List X64Register -> Either PeError Unit :=
  fix pe_validate_saved (registers : List X64Register) : Either PeError Unit :=
    match registers with
    | Nil => Right PeError Unit MkUnit
    | Cons reg rest =>
      match andb (pe_nonvolatile reg)
          (notb (elem Nat eq_nat (x64_register_code reg) (map X64Register Nat x64_register_code rest))) with
      | False => Left PeError Unit (PeUnsupportedFrame name)
      | True => pe_validate_saved rest
      end
    end;

def pe_push_info : List X64Register -> Nat -> Either PeError PePushInfo :=
  fix pe_push_info (registers : List X64Register) (offset : Nat) : Either PeError PePushInfo :=
    match registers with
    | Nil => Right PeError PePushInfo (PePushInfoData ([] : List Nat) ([] : List Nat) offset)
    | Cons reg rest =>
      match x64_encode (X64Push reg) with
      | Left err => Left PeError PePushInfo (PeInstructionError err)
      | Right bytes =>
        let next_offset : Nat := add offset (length Nat bytes) in
        match pe_push_info rest next_offset with
        | Left err => Left PeError PePushInfo err
        | Right info =>
          match info with
          | PePushInfoData tail codes end_offset => Right PeError PePushInfo
              (PePushInfoData (append Nat bytes tail)
                (append Nat codes ([next_offset, mul 16 (x64_register_code reg)] : List Nat)) end_offset)
          end
        end
      end
    end;

def pe_allocation_slots (allocation : Nat) : Nat :=
    match leb_nat allocation 128 with | True => 1 | False =>
      match ltb_nat allocation (mul 8 pe_byte2_place) with | True => 2 | False => 3 end end;

def pe_allocation_codes (offset : Nat) (allocation : Nat) : List Nat :=
    match pe_allocation_slots allocation with
    | Z => ([] : List Nat)
    | S rest => match rest with
      | Z => ([offset, add 2 (mul 16 (sub (div_nat allocation 8) 1))] : List Nat)
      | S next => match next with
        | Z => append Nat ([offset, 1] : List Nat) (pe_le16 (div_nat allocation 8))
        | S _ => append Nat ([offset, 17] : List Nat) (pe_le32 allocation) end end end;

def pe_frame_with_allocation (saved : List X64Register) (allocation : Nat)
    (allocation_instructions : List X64Instruction) : Either PeError PeUnwindInfo :=
    match pe_push_info saved 0 with
    | Left err => Left PeError PeUnwindInfo err
    | Right pushes =>
      match pushes with
      | PePushInfoData push_bytes push_codes push_size =>
        match x64_encode_block allocation_instructions with
        | Left err => Left PeError PeUnwindInfo (PeInstructionError err)
        | Right stack_bytes =>
          let prolog_size : Nat := add push_size (length Nat stack_bytes) in
          let slots : Nat := add (length X64Register saved) (pe_allocation_slots allocation) in
          let allocation_codes : List Nat := pe_allocation_codes prolog_size allocation in
          Right PeError PeUnwindInfo
            (PeUnwindInfoData (append Nat push_bytes stack_bytes)
              (pe_pad 4 (pe_join ([([1, prolog_size, slots, 0] : List Nat), allocation_codes, push_codes] : List (List Nat)))))
        end
      end
    end;

def pe_frame_encoding (saved : List X64Register) (allocation : Nat) : Either PeError PeUnwindInfo :=
    pe_frame_with_allocation saved allocation
      ([X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (pe_word32 allocation)] : List X64Instruction);

def pe_probed_encoding (saved : List X64Register) (allocation : Nat) (probe : X64Displacement)
    : Either PeError PeUnwindInfo :=
    pe_frame_with_allocation saved allocation
      ([X64MovImm32 X64Rax (pe_word32 allocation), X64CallRelative probe,
        X64ArithmeticReg X64Bits64 X64Subtract X64Rsp X64Rax] : List X64Instruction);

def pe_encode_frame (name : Nat) (frame : PeFrame) : Either PeError PeUnwindInfo :=
    match frame with
    | PeLeaf => Right PeError PeUnwindInfo (PeUnwindInfoData ([] : List Nat) ([1, 0, 0, 0] : List Nat))
    | PeCallFrame saved allocation =>
      match leb_nat pe_section_alignment allocation with
      | True => Left PeError PeUnwindInfo (PeStackProbeRequired name)
      | False =>
        match andb (leb_nat 32 allocation)
            (andb (eq_nat (mod_nat allocation 8) 0)
              (eq_nat (mod_nat (add allocation (mul 8 (length X64Register saved))) 16) 8)) with
        | False => Left PeError PeUnwindInfo (PeUnsupportedFrame name)
        | True =>
          match pe_validate_saved name saved with
          | Left err => Left PeError PeUnwindInfo err
          | Right _ => pe_frame_encoding saved allocation
          end
        end
      end
    | PeProbedFrame saved allocation probe =>
      match andb (leb_nat pe_section_alignment allocation)
          (andb (leb_nat allocation pe_max_rva)
            (andb (eq_nat (mod_nat allocation 8) 0)
              (eq_nat (mod_nat (add allocation (mul 8 (length X64Register saved))) 16) 8))) with
      | False => Left PeError PeUnwindInfo (PeUnsupportedFrame name)
      | True => match pe_validate_saved name saved with
        | Left err => Left PeError PeUnwindInfo err
        | Right _ => pe_probed_encoding saved allocation probe end end
    end;

def pe_function_scan (sections : List PePlacedSection) (symbols : List PeSymbol)
    (function : PeFunction) (cursor : Maybe (Pair Nat (List Nat))) : Either PeError PeFunctionScan :=
    match function with
    | PeCodeFunction name size label frame =>
      match pe_find_symbol name symbols with
      | Nothing => Left PeError PeFunctionScan (PeMissingSymbol name)
      | Just symbol =>
        match symbol with
        | PeNamedSymbol _ section offset =>
          match pe_section_equal section PeText with
          | False => Left PeError PeFunctionScan (PeInvalidFunction name)
          | True =>
            match pe_find_section PeText sections with
            | Nothing => Left PeError PeFunctionScan (PeInvalidFunction name)
            | Just text =>
              match text with
              | PeSectionAt _ rva _ _ bytes =>
                let bytes_len : Nat := length Nat bytes in
                match andb (ltb_nat 0 size)
                    (andb (ltb_nat offset bytes_len) (leb_nat size (sub bytes_len offset))) with
                | False => Left PeError PeFunctionScan (PeInvalidFunction name)
                | True =>
                  match pe_check_bytes label with
                  | Left err => Left PeError PeFunctionScan err
                  | Right _ =>
                    match pe_encode_frame name frame with
                    | Left err => Left PeError PeFunctionScan err
                    | Right unwind =>
                      match unwind with
                      | PeUnwindInfoData prolog metadata =>
                        let start : Nat := add rva offset in
                        let prolog_len : Nat := length Nat prolog in
                        -- Ordered functions reuse the preceding suffix. A backwards
                        -- function still checks its own original bytes before ordering.
                        let actual : List Nat := match cursor with
                          | Nothing => drop Nat offset bytes
                          | Just previous => match previous with | MkPair position source =>
                              match leb_nat position start with
                              | True => drop Nat (sub start position) source
                              | False => drop Nat offset bytes end end end in
                        match andb (ltb_nat prolog_len size)
                            (pe_bytes_equal prolog (take Nat prolog_len actual)) with
                        | False => Left PeError PeFunctionScan (PePrologMismatch name)
                        | True => Right PeError PeFunctionScan (PeFunctionScanAt
                            (PeFunctionInfoData name start (add start size) label metadata) actual)
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end;

def pe_function_info (sections : List PePlacedSection) (symbols : List PeSymbol)
    (function : PeFunction) : Either PeError PeFunctionInfo :=
    mapRight PeError PeFunctionScan PeFunctionInfo
      (fun (scanned : PeFunctionScan) => match scanned with | PeFunctionScanAt info _ => info end)
      (pe_function_scan sections symbols function (Nothing (Pair Nat (List Nat))));

def pe_collect_functions (sections : List PePlacedSection) (symbols : List PeSymbol)
    (functions : List PeFunction) : Either PeError (List PeFunctionInfo) :=
    (fix go (rest : List PeFunction) (previous_end : Nat)
        (cursor : Maybe (Pair Nat (List Nat))) : Either PeError (List PeFunctionInfo) :=
      match rest with
      | Nil => Right PeError (List PeFunctionInfo) ([] : List PeFunctionInfo)
      | Cons function tail =>
        match pe_function_scan sections symbols function cursor with
        | Left err => Left PeError (List PeFunctionInfo) err
        | Right scanned => match scanned with | PeFunctionScanAt info source =>
          match info with
          | PeFunctionInfoData name start end_rva _ _ =>
            match leb_nat previous_end start with
            | False => Left PeError (List PeFunctionInfo) (PeUnorderedFunction name)
            | True => mapRight PeError (List PeFunctionInfo) (List PeFunctionInfo)
                (fun (remaining : List PeFunctionInfo) => Cons PeFunctionInfo info remaining) (go tail end_rva (Just (Pair Nat (List Nat)) (MkPair Nat (List Nat) start source)))
            end
          end end
        end
      end) functions 0 (Nothing (Pair Nat (List Nat)));

def pe_entry_rva (name : Nat) : List PeFunctionInfo -> Either PeError Nat :=
  fix pe_entry_rva (functions : List PeFunctionInfo) : Either PeError Nat :=
    match functions with
    | Nil => Left PeError Nat (PeMissingEntry name)
    | Cons info rest =>
      match info with
      | PeFunctionInfoData key start _ _ _ =>
        match eq_nat key name with | True => Right PeError Nat start | False => pe_entry_rva rest end
      end
    end;

def pe_encode_function_tables : List PeFunctionInfo -> Nat -> PeFunctionTables :=
  fix pe_encode_function_tables (functions : List PeFunctionInfo) (unwind_rva : Nat) : PeFunctionTables :=
    match functions with
    | Nil => PeFunctionTablesData ([] : List Nat) ([] : List Nat) ([] : List Nat) ([] : List PeFunctionAddress)
    | Cons info rest =>
      match info with
      | PeFunctionInfoData name start end_rva label metadata =>
        match pe_encode_function_tables rest (add unwind_rva (length Nat metadata)) with
        | PeFunctionTablesData pdata xdata names addresses =>
          PeFunctionTablesData
            (pe_join ([pe_le32 start, pe_le32 end_rva, pe_le32 unwind_rva, pdata] : List (List Nat)))
            (append Nat metadata xdata)
            (pe_join ([pe_le32 name, pe_le32 start, pe_le32 end_rva, pe_le32 (length Nat label), pe_pad 4 label, names] : List (List Nat)))
            (Cons PeFunctionAddress (PeFunctionAt name start end_rva label) addresses)
        end
      end
    end;

def pe_function_map_header (count : Nat) : List Nat :=
    pe_join ([([79, 85, 82, 79, 77, 65, 80, 0] : List Nat), pe_le32 1, pe_le32 count] : List (List Nat));
