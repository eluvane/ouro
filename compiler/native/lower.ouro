-- Checked Core -> scalar Native MIR -> Windows PE32+.
-- Public entry points recheck forgeable inputs and always run MIR validation.
import "lower_terms.ouro";

def lower_label (state : InternState) (id : Nat) : Either NativeLowerError (List Nat) :=
    match state with | MkIntern names _ _ _ =>
      (fix find_name (remaining : List (Pair (List Nat) Nat)) : Either NativeLowerError (List Nat) :=
        match remaining with | Nil => Left NativeLowerError (List Nat) (LowerMetadataMismatch id)
        | Cons pair rest => match pair with | MkPair name actual => match eqNat id actual with
          | True => Right NativeLowerError (List Nat) name | False => find_name rest end end end) names end;

def lower_function_indexed (fuel : Nat) (program : CheckedProgram) (sig : CheckEnvironment) (contracts : List LowerContract)
    (contract : LowerContract) (body : CoreTerm) : Either NativeLowerError MirFunction :=
    match contract with | LowerContractOf id _ parameters result _ =>
      lower_bind (List Nat) MirFunction (lower_label (checked_program_intern program) id) (fun (label : List Nat) =>
        lower_bind LowerFunctionBody MirFunction
          (lower_parameters sig fuel parameters body 0 ([] : List LowerBinding))
          (fun (prepared : LowerFunctionBody) => match prepared with | LowerFunctionBodyOf args captured term next =>
            lower_map LowerResult MirFunction (fun (lowered : LowerResult) => match lowered with
              | LowerResultOf _ value final => match final with | LowerStateOf _ locals _ _ =>
                MirFunctionDef id label args (reverse MirLocal locals) (lower_type_mir result) 0
                  (lower_finish_blocks (MirReturn value) final) end end)
              (lower_expression sig contracts fuel captured term result
                (lower_empty_state next)) end)) end;

def lower_functions_indexed (fuel : Nat) (program : CheckedProgram) (sig : CheckEnvironment) (contracts : List LowerContract)
    : List LowerContract -> Either NativeLowerError (List MirFunction) :=
  fix functions (pending : List LowerContract) : Either NativeLowerError (List MirFunction) :=
    match pending with | Nil => Right NativeLowerError (List MirFunction) ([] : List MirFunction)
    | Cons contract rest => match contract with | LowerContractOf id _ _ _ binding => match binding with
      | Just _ => functions rest
      | Nothing => match lookup_const id (checked_program_entries program) with
        | Nothing => Left NativeLowerError (List MirFunction) (LowerUnknownGlobal id)
        | Just body => lower_bind MirFunction (List MirFunction) (lower_function_indexed fuel program sig contracts contract body)
            (fun (function : MirFunction) => lower_map (List MirFunction) (List MirFunction)
              (fun (more : List MirFunction) => Cons MirFunction function more) (functions rest)) end end end end;

-- Compatibility boundaries reconstruct a canonical lookup index from input
-- declarations; native acceptance continues to require lower_recheck_program.
def lower_function (fuel : Nat) (program : CheckedProgram) (contracts : List LowerContract)
    (contract : LowerContract) (body : CoreTerm) : Either NativeLowerError MirFunction :=
    lower_function_indexed fuel program (check_environment_from_entries (checked_program_entries program))
      contracts contract body;

def lower_functions (fuel : Nat) (program : CheckedProgram) (contracts : List LowerContract)
    (pending : List LowerContract) : Either NativeLowerError (List MirFunction) :=
    lower_functions_indexed fuel program (check_environment_from_entries (checked_program_entries program))
      contracts pending;

def lower_add_import (dll : List Nat) (external : MirExtern) : List MirLibrary -> List MirLibrary :=
  fix add_import (libraries : List MirLibrary) : List MirLibrary :=
    match libraries with | Nil => ([MirLibraryDef dll ([external] : List MirExtern)] : List MirLibrary)
    | Cons library rest => match library with | MirLibraryDef name externs => match pe_library_equal dll name with
      | True => Cons MirLibrary (MirLibraryDef name (append MirExtern externs ([external] : List MirExtern))) rest
      | False => Cons MirLibrary library (add_import rest) end end end;

def lower_libraries : List LowerContract -> Either NativeLowerError (List MirLibrary) :=
  fix libraries (contracts : List LowerContract) : Either NativeLowerError (List MirLibrary) :=
    match contracts with | Nil => Right NativeLowerError (List MirLibrary) ([] : List MirLibrary)
    | Cons contract rest => match contract with | LowerContractOf id _ _ _ binding => match binding with
      | Nothing => libraries rest
      | Just primitive => match primitive with
        | PrimitiveIntrinsicBinding native _ _ _ => Left NativeLowerError (List MirLibrary) (LowerUnsupportedPrimitive native)
        | PrimitiveExternBinding external => match external with | CheckedExternOf _ _ dll symbol _ gc =>
          lower_bind MirSignature (List MirLibrary) (lower_mir_signature contract) (fun (signature : MirSignature) =>
            lower_map (List MirLibrary) (List MirLibrary)
              (fun (tail : List MirLibrary) => lower_add_import dll (MirExternDef
                (match gc with | PrimitiveNoGc => MirNoGc | PrimitiveMayGc => MirMayGc end) id symbol signature) tail)
              (libraries rest)) end end end end end;

def lower_entry_max (entry : Entry) : Nat :=
    match entry with | MkEntry id _ _ => id | MkBoundEntry id _ _ => id
    | MkRoleEntry _ => lower_entry_id entry
    | MkIndEntry id declaration => match declaration with | MkIndDecl _ _ _ _ constructors =>
      foldr Ctor Nat (fun (ctor : Ctor) (other : Nat) => match ctor with | MkCtor name _ => maxNat name other end) id constructors end end;

def lower_exit_signature : MirSignature := MirSignatureOf ([MirU32] : List MirType) (Nothing MirType);

def lower_exit_signature_valid (signature : MirSignature) : Bool :=
    match signature with | MirSignatureOf args result =>
      match args with | Nil => False | Cons arg rest =>
        andb (mir_type_equal arg MirU32) (andb (eqNat (length MirType rest) 0)
          (match result with | Nothing => True | Just _ => False end)) end end;

def lower_find_exit : List MirLibrary -> Either NativeLowerError (Maybe Nat) :=
  fix find_exit (libraries : List MirLibrary) : Either NativeLowerError (Maybe Nat) :=
    match libraries with | Nil => Right NativeLowerError (Maybe Nat) (Nothing Nat)
    | Cons library rest => match library with | MirLibraryDef name externs => match pe_library_equal name lower_kernel_library with
      | False => find_exit rest
      | True => (fix find_function (remaining : List MirExtern) : Either NativeLowerError (Maybe Nat) :=
          match remaining with | Nil => Right NativeLowerError (Maybe Nat) (Nothing Nat)
          | Cons external more => match external with | MirExternDef _ id symbol signature =>
            match pe_bytes_equal symbol lower_exit_symbol with
            | False => find_function more
            | True => lower_map Unit (Maybe Nat) (fun (_ : Unit) => Just Nat id)
                (lower_require (lower_exit_signature_valid signature) (LowerMetadataMismatch id)) end end end) externs end end end;

def lower_startup (id : Nat) (main_id : Nat) (exit_id : Nat) : MirFunction :=
    MirFunctionDef id ([111, 117, 114, 111, 95, 101, 110, 116, 114, 121] : List Nat)
      ([] : List MirLocal) ([MirLocalDef 0 MirU32] : List MirLocal) (Nothing MirType) 0
      ([MirBlockDef 0
        ([MirCall MirMayGc (Just Nat 0) (MirDirect main_id) ([] : List MirValue),
          MirCall MirMayGc (Nothing Nat) (MirDirect exit_id) ([MirUse 0] : List MirValue)] : List MirInstruction)
        MirTrap] : List MirBlock);

def lower_check_entry (entry : Nat) (contracts : List LowerContract) : Either NativeLowerError Unit :=
    match lower_find_contract entry contracts with
    | Nothing => Left NativeLowerError Unit (LowerInvalidEntry entry)
    | Just contract => match contract with | LowerContractOf _ _ args result binding =>
      lower_require (andb (eqNat (length LowerType args) 0)
        (andb (match lower_type_mir result with | Nothing => False | Just mir => mir_type_equal mir MirU32 end)
          (match binding with | Nothing => True | Just _ => False end))) (LowerInvalidEntry entry) end end;

def lower_finish (limits : MirLimits) (program : CheckedProgram) (contracts : List LowerContract)
    (functions : List MirFunction) (libraries : List MirLibrary) (entry : Nat)
    : Either NativeLowerError NativeLoweredProgram :=
    let maximum : Nat := foldr Entry Nat (fun (item : Entry) (other : Nat) => maxNat (lower_entry_max item) other)
      0 (checked_program_entries program) in
    lower_bind Unit NativeLoweredProgram (lower_require (leb_nat maximum (sub pe_max_rva 3)) LowerResourceExhausted)
      (fun (_ : Unit) => lower_bind (Maybe Nat) NativeLoweredProgram (lower_find_exit libraries)
        (fun (existing : Maybe Nat) =>
          let exit_id : Nat := match existing with | Just id => id | Nothing => S maximum end in
          let imports : List MirLibrary := match existing with | Just _ => libraries
            | Nothing => lower_add_import lower_kernel_library (MirExternDef MirNoGc exit_id lower_exit_symbol lower_exit_signature) libraries end in
          let start_id : Nat := add maximum 2 in
          let mir : MirProgram := MirProgramDef
            (Cons MirFunction (lower_startup start_id entry exit_id) functions) ([] : List MirData) imports start_id in
          match mir_annotate_calls limits mir with
          | Left err => Left NativeLowerError NativeLoweredProgram (LowerMirFailure err)
          | Right annotated => Right NativeLowerError NativeLoweredProgram (NativeLoweredOf program contracts annotated) end));

def native_lower_checked (fuel : Nat) (limits : MirLimits) (entry : Nat) (input : CheckedProgram)
    : Either NativeLowerError NativeLoweredProgram :=
    lower_bind CheckedProgram NativeLoweredProgram (lower_recheck_program fuel input) (fun (program : CheckedProgram) =>
      let entries : List Entry := checked_program_entries program in
      let sig : CheckEnvironment := check_environment_from_entries entries in
      lower_bind (List LowerContract) NativeLoweredProgram (lower_collect_contracts_indexed sig fuel (reverse Entry entries))
        (fun (contracts : List LowerContract) => lower_bind Unit NativeLoweredProgram (lower_check_entry entry contracts)
          (fun (_ : Unit) => lower_bind (List MirFunction) NativeLoweredProgram (lower_functions_indexed fuel program sig contracts contracts)
            (fun (functions : List MirFunction) => lower_bind (List MirLibrary) NativeLoweredProgram (lower_libraries contracts)
              (fun (libraries : List MirLibrary) => lower_finish limits program contracts functions libraries entry)))));

def native_lower_program (fuel : Nat) (limits : MirLimits) (entry : Nat) (program : CheckedProgram)
    : Either NativeLowerError MirProgram :=
    lower_map NativeLoweredProgram MirProgram
      (fun (lowered : NativeLoweredProgram) => match lowered with | NativeLoweredOf _ _ mir => mir end)
      (native_lower_checked fuel limits entry program);
