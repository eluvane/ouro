-- Only paths are decoded as strict UTF-8. File contents stay byte-counted.
-- The three cells hold the opened owner, size/scratch and conversion count.
import "managed_files_transfer.ouro";

def managed_file_int_max : MirValue :=
    MirBits MirUSize (X64Words64 (X64Bytes32 255 255 255 127) codegen_zero);

def managed_file_path_complete (compiler : ManagedCompiler) (content : Maybe MirValue) (storage : MirValue)
    (wide : MirValue) (units : MirValue) (count : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf actual next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual units next)
          (fun (compared : ManagedResult) => match compared with | ManagedResultOf exact after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope exact after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_binary MirUSize MirMul units (managed_bits MirUSize 2) checked)
                (fun (located : ManagedResult) => match located with | ManagedResultOf first entered =>
                  lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd first (managed_bits MirUSize 1) entered)
                    (fun (last : ManagedResult) => match last with | ManagedResultOf second final =>
                      managed_file_open compiler content storage wide units scope
                        (managed_emit_all ([MirStoreAt wide first (managed_bits MirU8 0),
                          MirStoreAt wide second (managed_bits MirU8 0)] : List MirInstruction) final) end) end)) end) end);

def managed_file_path_fill (compiler : ManagedCompiler) (content : Maybe MirValue) (storage : MirValue)
    (source : MirValue) (bytes : MirValue) (units : MirValue) (count : MirValue)
    (wide : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_file_call compiler ManagedFileToWide ([source, bytes, wide, units, count] : List MirValue) state)
      (fun (filled : ManagedResult) => match filled with | ManagedResultOf status next =>
        lower_bind ManagedState ManagedResult (managed_file_status compiler scope status next)
          (managed_file_path_complete compiler content storage wide units count scope) end);

def managed_file_path_allocate (compiler : ManagedCompiler) (content : Maybe MirValue) (storage : MirValue)
    (source : MirValue) (bytes : MirValue) (count : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf units next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirLess units managed_file_int_max next)
          (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_binary MirUSize MirAdd units (managed_bits MirUSize 1) checked)
                (fun (terminated : ManagedResult) => match terminated with | ManagedResultOf capacity entered =>
                  lower_bind ManagedResult ManagedResult
                    (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) entered)
                    (fun (sized : ManagedResult) => match sized with | ManagedResultOf allocation final =>
                      managed_file_buffer compiler scope allocation
                        (managed_file_path_fill compiler content storage source bytes units count) final end) end)) end) end);

def managed_file_path_copy (compiler : ManagedCompiler) (content : Maybe MirValue) (storage : MirValue)
    (path : MirValue) (bytes : MirValue) (count : MirValue) (source : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult
      (managed_bytes_copy path (managed_bits MirUSize 40) source (managed_bits MirUSize 0) bytes state)
      (fun (copied : ManagedState) => lower_bind ManagedResult ManagedResult
        (managed_file_call compiler ManagedFileToWide
          ([source, bytes, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) copied)
        (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
          lower_bind ManagedState ManagedResult (managed_file_status compiler scope status next)
            (managed_file_path_allocate compiler content storage source bytes count scope) end));

def managed_file_path_storage (compiler : ManagedCompiler) (content : Maybe MirValue)
    (path : MirValue) (bytes : MirValue) (storage : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_pointer storage 16 state)
      (fun (located : ManagedResult) => match located with | ManagedResultOf count next =>
        managed_file_buffer compiler scope bytes (managed_file_path_copy compiler content storage path bytes count)
          (managed_emit_all ([MirStore storage (codegen_disp 0) (managed_bits MirUSize 0),
            MirStore storage (codegen_disp 8) (managed_bits MirUSize 0),
            MirStore storage (codegen_disp 16) (managed_bits MirUSize 0)] : List MirInstruction) next) end);

def managed_file_body (compiler : ManagedCompiler) (path : MirValue) (content : Maybe MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let scope : ManagedFileScope := ManagedFileScopeOf ([] : List MirValue) (Nothing MirValue) in
    lower_bind ManagedResult ManagedResult (managed_string_size compiler path state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater bytes (managed_bits MirUSize 0) next)
          (fun (nonempty : ManagedResult) => match nonempty with | ManagedResultOf positive after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope positive after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_compare MirLessEqual bytes managed_file_int_max checked)
                (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                  lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits final)
                    (managed_file_buffer compiler scope (managed_bits MirUSize 24)
                      (managed_file_path_storage compiler content path bytes)) end)) end) end);
