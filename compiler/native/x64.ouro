-- Typed x86-64 encoding for the native backend's integer subset.
-- Intel SDM volume 2, instruction format chapter and instruction tables:
-- https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
-- This module is built by the previous compiler. Nat fields below are bounded
-- encoded bytes, not the representation or semantics of user machine integers.

import "../../std/natx.ouro";

inductive X64Register : Type :=
  | X64Rax : X64Register
  | X64Rcx : X64Register
  | X64Rdx : X64Register
  | X64Rbx : X64Register
  | X64Rsp : X64Register
  | X64Rbp : X64Register
  | X64Rsi : X64Register
  | X64Rdi : X64Register
  | X64R8 : X64Register
  | X64R9 : X64Register
  | X64R10 : X64Register
  | X64R11 : X64Register
  | X64R12 : X64Register
  | X64R13 : X64Register
  | X64R14 : X64Register
  | X64R15 : X64Register;

inductive X64Width : Type :=
  | X64Bits32 : X64Width
  | X64Bits64 : X64Width;

-- Little-endian byte parts; every part is checked before encoding.
inductive X64Word32 : Type :=
  | X64Bytes32 : Nat -> Nat -> Nat -> Nat -> X64Word32;

inductive X64Word64 : Type :=
  | X64Words64 : X64Word32 -> X64Word32 -> X64Word64;

-- Signed magnitude permits checking overflow before two's-complement encoding.
-- Relative branches and RIP addresses are measured from the next instruction.
inductive X64Displacement : Type :=
  | X64Forward : X64Word32 -> X64Displacement
  | X64Backward : X64Word32 -> X64Displacement;

inductive X64Scale : Type :=
  | X64Scale1 : X64Scale
  | X64Scale2 : X64Scale
  | X64Scale4 : X64Scale
  | X64Scale8 : X64Scale;

inductive X64Address : Type :=
  | X64Base : X64Register -> X64Displacement -> X64Address
  | X64Indexed : X64Register -> X64Register -> X64Scale -> X64Displacement -> X64Address
  | X64Rip : X64Displacement -> X64Address;

inductive X64Operand : Type :=
  | X64RegisterOperand : X64Register -> X64Operand
  | X64MemoryOperand : X64Address -> X64Operand;

inductive X64Arithmetic : Type :=
  | X64Add : X64Arithmetic
  | X64Or : X64Arithmetic
  | X64And : X64Arithmetic
  | X64Subtract : X64Arithmetic
  | X64Xor : X64Arithmetic
  | X64Compare : X64Arithmetic;

inductive X64Shift : Type :=
  | X64ShiftLeft : X64Shift
  | X64ShiftRight : X64Shift
  | X64ShiftArithmeticRight : X64Shift;

inductive X64Signedness : Type :=
  | X64Unsigned : X64Signedness
  | X64Signed : X64Signedness;

inductive X64Condition : Type :=
  | X64Overflow : X64Condition
  | X64NotOverflow : X64Condition
  | X64Below : X64Condition
  | X64AboveEqual : X64Condition
  | X64Equal : X64Condition
  | X64NotEqual : X64Condition
  | X64BelowEqual : X64Condition
  | X64Above : X64Condition
  | X64Negative : X64Condition
  | X64Nonnegative : X64Condition
  | X64Parity : X64Condition
  | X64NotParity : X64Condition
  | X64Less : X64Condition
  | X64GreaterEqual : X64Condition
  | X64LessEqual : X64Condition
  | X64Greater : X64Condition;

-- Operand order is destination, source. All memory addresses are 64-bit.
-- ArithmeticImm32 sign-extends its immediate for a 64-bit operation.
-- Divide consumes EDX:EAX or RDX:RAX, returning quotient in (R/E)AX and
-- remainder in (R/E)DX. The caller must prepare the high dividend and guard
-- zero divisors/quotient overflow when language semantics require a typed error.
-- ShiftCL uses the hardware's masked count; immediate shifts reject masked
-- counts so an accidental 32/64 is never silently changed into zero.
inductive X64Instruction : Type :=
  | X64MovImm32 : X64Register -> X64Word32 -> X64Instruction
  | X64MovImm64 : X64Register -> X64Word64 -> X64Instruction
  | X64Mov : X64Width -> X64Register -> X64Register -> X64Instruction
  | X64Load : X64Width -> X64Register -> X64Address -> X64Instruction
  | X64Store : X64Width -> X64Address -> X64Register -> X64Instruction
  | X64Load8Zero : X64Register -> X64Address -> X64Instruction
  | X64Store8 : X64Address -> X64Register -> X64Instruction
  | X64SignExtend32 : X64Register -> X64Register -> X64Instruction
  | X64TestMemory8 : X64Address -> Nat -> X64Instruction
  | X64Lea : X64Register -> X64Address -> X64Instruction
  | X64ArithmeticReg : X64Width -> X64Arithmetic -> X64Register -> X64Register -> X64Instruction
  | X64ArithmeticImm32 : X64Width -> X64Arithmetic -> X64Register -> X64Word32 -> X64Instruction
  | X64Multiply : X64Width -> X64Register -> X64Operand -> X64Instruction
  | X64Divide : X64Width -> X64Signedness -> X64Operand -> X64Instruction
  | X64SignExtendDividend : X64Width -> X64Instruction
  | X64ShiftImm : X64Width -> X64Shift -> X64Register -> Nat -> X64Instruction
  | X64ShiftCL : X64Width -> X64Shift -> X64Register -> X64Instruction
  | X64CallRelative : X64Displacement -> X64Instruction
  | X64JumpRelative : X64Displacement -> X64Instruction
  | X64JumpIf : X64Condition -> X64Displacement -> X64Instruction
  | X64CallIndirect : X64Operand -> X64Instruction
  | X64JumpIndirect : X64Operand -> X64Instruction
  | X64Push : X64Register -> X64Instruction
  | X64Pop : X64Register -> X64Instruction
  | X64Return : X64Instruction
  | X64Trap : X64Instruction
  | X64TailJumpIndirect : X64Address -> X64Instruction;

inductive X64EncodeError : Type :=
  | X64ByteOutOfRange : Nat -> X64EncodeError
  | X64DisplacementOutOfRange : X64EncodeError
  | X64StackPointerIndex : X64EncodeError
  | X64ShiftOutOfRange : X64Width -> Nat -> X64EncodeError;

def x64_register_code (reg : X64Register) : Nat :=
    match reg with
    | X64Rax => 0 | X64Rcx => 1 | X64Rdx => 2 | X64Rbx => 3
    | X64Rsp => 4 | X64Rbp => 5 | X64Rsi => 6 | X64Rdi => 7
    | X64R8 => 8 | X64R9 => 9 | X64R10 => 10 | X64R11 => 11
    | X64R12 => 12 | X64R13 => 13 | X64R14 => 14 | X64R15 => 15
    end;

def x64_register_low (reg : X64Register) : Nat :=
    mod_nat (x64_register_code reg) 8;

def x64_register_high (reg : X64Register) : Nat :=
    div_nat (x64_register_code reg) 8;

def x64_width_bit (width : X64Width) : Nat :=
    match width with | X64Bits32 => 0 | X64Bits64 => 8 end;

def x64_rex (width : X64Width) (reg : Nat) (index : Nat) (base : Nat) : List Nat :=
    let bits : Nat := add (x64_width_bit width) (add (mul 4 reg) (add (mul 2 index) base)) in
    match bits with
    | Z => ([] : List Nat)
    | S _ => ([add 64 bits] : List Nat)
    end;

def x64_validate_bytes : List Nat -> Either X64EncodeError (List Nat) :=
  fix x64_validate_bytes (bytes : List Nat) : Either X64EncodeError (List Nat) :=
    match bytes with
    | Nil => Right X64EncodeError (List Nat) ([] : List Nat)
    | Cons byte rest =>
      match ltb_nat byte 256 with
      | False => Left X64EncodeError (List Nat) (X64ByteOutOfRange byte)
      | True => mapRight X64EncodeError (List Nat) (List Nat)
          (fun (tail : List Nat) => Cons Nat byte tail) (x64_validate_bytes rest)
      end
    end;

def x64_word32_bytes (word : X64Word32) : Either X64EncodeError (List Nat) :=
    match word with
    | X64Bytes32 byte0 byte1 byte2 byte3 => x64_validate_bytes ([byte0, byte1, byte2, byte3] : List Nat)
    end;

def x64_word64_bytes (word : X64Word64) : Either X64EncodeError (List Nat) :=
    match word with
    | X64Words64 low high =>
      match x64_word32_bytes low with
      | Left err => Left X64EncodeError (List Nat) err
      | Right low_bytes => mapRight X64EncodeError (List Nat) (List Nat)
          (append Nat low_bytes) (x64_word32_bytes high)
      end
    end;

def x64_negate_bytes (bytes : List Nat) : List Nat :=
    (fix go (rest : List Nat) (carry : Nat) : List Nat :=
      match rest with
      | Nil => ([] : List Nat)
      | Cons byte tail =>
        let value : Nat := add (sub 255 byte) carry in
        match ltb_nat value 256 with
        | True => Cons Nat value (go tail 0)
        | False => Cons Nat 0 (go tail 1)
        end
      end) bytes 1;

def x64_displacement_word (disp : X64Displacement) : X64Word32 :=
    match disp with | X64Forward word => word | X64Backward word => word end;

def x64_displacement_fits (disp : X64Displacement) : Bool :=
    match disp with
    | X64Forward word =>
      match word with | X64Bytes32 _ _ _ high => ltb_nat high 128 end
    | X64Backward word =>
      match word with
      | X64Bytes32 low byte1 byte2 high =>
        orb (ltb_nat high 128)
          (andb (eq_nat high 128) (andb (eq_nat low 0) (andb (eq_nat byte1 0) (eq_nat byte2 0))))
      end
    end;

def x64_displacement_bytes (disp : X64Displacement) : Either X64EncodeError (List Nat) :=
    match x64_word32_bytes (x64_displacement_word disp) with
    | Left err => Left X64EncodeError (List Nat) err
    | Right bytes =>
      match x64_displacement_fits disp with
      | False => Left X64EncodeError (List Nat) X64DisplacementOutOfRange
      | True => Right X64EncodeError (List Nat)
          (match disp with | X64Forward _ => bytes | X64Backward _ => x64_negate_bytes bytes end)
      end
    end;

def x64_displacement_zero (disp : X64Displacement) : Bool :=
    match x64_displacement_word disp with
    | X64Bytes32 low byte1 byte2 high =>
      andb (eq_nat low 0) (andb (eq_nat byte1 0) (andb (eq_nat byte2 0) (eq_nat high 0)))
    end;

def x64_displacement_small (disp : X64Displacement) : Bool :=
    let limit : Nat := match disp with | X64Forward _ => 127 | X64Backward _ => 128 end in
    match x64_displacement_word disp with
    | X64Bytes32 low byte1 byte2 high =>
      andb (leb_nat low limit) (andb (eq_nat byte1 0) (andb (eq_nat byte2 0) (eq_nat high 0)))
    end;

def x64_scale_bits (scale : X64Scale) : Nat :=
    match scale with | X64Scale1 => 0 | X64Scale2 => 64 | X64Scale4 => 128 | X64Scale8 => 192 end;

-- The two Nat fields are REX.X and REX.B bits; the list begins with ModR/M.
inductive X64AddressEncoding : Type :=
  | X64EncodedAddress : Nat -> Nat -> List Nat -> X64AddressEncoding;

def x64_base_address (reg_field : Nat) (base : X64Register) (index_high : Nat)
    (sib : List Nat) (disp : X64Displacement) : Either X64EncodeError X64AddressEncoding :=
    match x64_displacement_bytes disp with
    | Left err => Left X64EncodeError X64AddressEncoding err
    | Right bytes =>
      let base_low : Nat := x64_register_low base in
      let mode : Nat :=
        match andb (x64_displacement_zero disp) (notb (eq_nat base_low 5)) with
        | True => 0
        | False => match x64_displacement_small disp with | True => 64 | False => 128 end
        end in
      let rm : Nat := match sib with | Nil => base_low | Cons _ _ => 4 end in
      let displacement : List Nat :=
        match eq_nat mode 0 with
        | True => ([] : List Nat)
        | False => match eq_nat mode 64 with | True => take Nat 1 bytes | False => bytes end
        end in
      Right X64EncodeError X64AddressEncoding
        (X64EncodedAddress index_high (x64_register_high base)
          (Cons Nat (add mode (add (mul 8 reg_field) rm)) (append Nat sib displacement)))
    end;

def x64_address_bytes (reg_field : Nat) (address : X64Address) : Either X64EncodeError X64AddressEncoding :=
    match address with
    | X64Base base disp =>
      let sib : List Nat := match eq_nat (x64_register_low base) 4 with | True => ([36] : List Nat) | False => ([] : List Nat) end in
      x64_base_address reg_field base 0 sib disp
    | X64Indexed base index scale disp =>
      match eq_nat (x64_register_code index) 4 with
      | True => Left X64EncodeError X64AddressEncoding X64StackPointerIndex
      | False => x64_base_address reg_field base (x64_register_high index)
          ([add (x64_scale_bits scale) (add (mul 8 (x64_register_low index)) (x64_register_low base))] : List Nat) disp
      end
    | X64Rip disp => mapRight X64EncodeError (List Nat) X64AddressEncoding
        (fun (bytes : List Nat) => X64EncodedAddress 0 0 (Cons Nat (add (mul 8 reg_field) 5) bytes))
        (x64_displacement_bytes disp)
    end;

def x64_operand_bytes (reg_field : Nat) (operand : X64Operand) : Either X64EncodeError X64AddressEncoding :=
    match operand with
    | X64RegisterOperand reg => Right X64EncodeError X64AddressEncoding
        (X64EncodedAddress 0 (x64_register_high reg) ([add 192 (add (mul 8 reg_field) (x64_register_low reg))] : List Nat))
    | X64MemoryOperand address => x64_address_bytes reg_field address
    end;

def x64_modrm_instruction (width : X64Width) (opcodes : List Nat)
    (reg_field : Nat) (reg_high : Nat) (operand : X64Operand) : Either X64EncodeError (List Nat) :=
    match x64_operand_bytes reg_field operand with
    | Left err => Left X64EncodeError (List Nat) err
    | Right encoded =>
      match encoded with
      | X64EncodedAddress index_high base_high bytes => Right X64EncodeError (List Nat)
          (append Nat (x64_rex width reg_high index_high base_high) (append Nat opcodes bytes))
      end
    end;

def x64_register_instruction (width : X64Width) (opcodes : List Nat)
    (reg : X64Register) (operand : X64Operand) : Either X64EncodeError (List Nat) :=
    x64_modrm_instruction width opcodes (x64_register_low reg) (x64_register_high reg) operand;

def x64_arithmetic_group (operation : X64Arithmetic) : Nat :=
    match operation with
    | X64Add => 0 | X64Or => 1 | X64And => 4
    | X64Subtract => 5 | X64Xor => 6 | X64Compare => 7
    end;

def x64_shift_group (operation : X64Shift) : Nat :=
    match operation with | X64ShiftLeft => 4 | X64ShiftRight => 5 | X64ShiftArithmeticRight => 7 end;

def x64_condition_code (condition : X64Condition) : Nat :=
    match condition with
    | X64Overflow => 0 | X64NotOverflow => 1 | X64Below => 2 | X64AboveEqual => 3
    | X64Equal => 4 | X64NotEqual => 5 | X64BelowEqual => 6 | X64Above => 7
    | X64Negative => 8 | X64Nonnegative => 9 | X64Parity => 10 | X64NotParity => 11
    | X64Less => 12 | X64GreaterEqual => 13 | X64LessEqual => 14 | X64Greater => 15
    end;

def x64_with_immediate (prefix : Either X64EncodeError (List Nat))
    (immediate : Either X64EncodeError (List Nat)) : Either X64EncodeError (List Nat) :=
    match prefix with
    | Left err => Left X64EncodeError (List Nat) err
    | Right bytes => mapRight X64EncodeError (List Nat) (List Nat) (append Nat bytes) immediate
    end;

def x64_immediate_move (width : X64Width) (reg : X64Register)
    (immediate : Either X64EncodeError (List Nat)) : Either X64EncodeError (List Nat) :=
    mapRight X64EncodeError (List Nat) (List Nat)
      (append Nat (append Nat (x64_rex width 0 0 (x64_register_high reg)) ([add 184 (x64_register_low reg)] : List Nat))) immediate;

def x64_shift_immediate (width : X64Width) (operation : X64Shift)
    (reg : X64Register) (count : Nat) : Either X64EncodeError (List Nat) :=
    let limit : Nat := match width with | X64Bits32 => 32 | X64Bits64 => 64 end in
    match ltb_nat count limit with
    | False => Left X64EncodeError (List Nat) (X64ShiftOutOfRange width count)
    | True =>
      match eq_nat count 1 with
      | True => x64_modrm_instruction width ([209] : List Nat) (x64_shift_group operation) 0 (X64RegisterOperand reg)
      | False => x64_with_immediate
          (x64_modrm_instruction width ([193] : List Nat) (x64_shift_group operation) 0 (X64RegisterOperand reg))
          (Right X64EncodeError (List Nat) ([count] : List Nat))
      end
    end;

def x64_relative_instruction (opcodes : List Nat) (disp : X64Displacement) : Either X64EncodeError (List Nat) :=
    mapRight X64EncodeError (List Nat) (List Nat) (append Nat opcodes) (x64_displacement_bytes disp);

-- Byte stores need a REX prefix for SPL/BPL/SIL/DIL even when no extension
-- bits are set. Otherwise register encodings 4..7 would select AH/CH/DH/BH.
def x64_byte_store (address : X64Address) (source : X64Register) : Either X64EncodeError (List Nat) :=
    match x64_address_bytes (x64_register_low source) address with
    | Left err => Left X64EncodeError (List Nat) err
    | Right encoded => match encoded with | X64EncodedAddress index_high base_high bytes =>
      let rex : List Nat := x64_rex X64Bits32 (x64_register_high source) index_high base_high in
      let prefix : List Nat := match rex with | Cons _ _ => rex
        | Nil => match leb_nat 4 (x64_register_code source) with | True => ([64] : List Nat) | False => ([] : List Nat) end end in
      Right X64EncodeError (List Nat) (append Nat prefix (Cons Nat 136 bytes)) end end;

def x64_encode (instruction : X64Instruction) : Either X64EncodeError (List Nat) :=
    match instruction with
    | X64MovImm32 reg word => x64_immediate_move X64Bits32 reg (x64_word32_bytes word)
    | X64MovImm64 reg word => x64_immediate_move X64Bits64 reg (x64_word64_bytes word)
    | X64Mov width dest source => x64_register_instruction width ([137] : List Nat) source (X64RegisterOperand dest)
    | X64Load width dest address => x64_register_instruction width ([139] : List Nat) dest (X64MemoryOperand address)
    | X64Store width address source => x64_register_instruction width ([137] : List Nat) source (X64MemoryOperand address)
    | X64Load8Zero dest address => x64_register_instruction X64Bits32 ([15, 182] : List Nat) dest (X64MemoryOperand address)
    | X64Store8 address source => x64_byte_store address source
    | X64SignExtend32 dest source => x64_register_instruction X64Bits64 ([99] : List Nat) dest (X64RegisterOperand source)
    | X64TestMemory8 address immediate => x64_with_immediate
        (x64_modrm_instruction X64Bits32 ([246] : List Nat) 0 0 (X64MemoryOperand address))
        (x64_validate_bytes ([immediate] : List Nat))
    | X64Lea dest address => x64_register_instruction X64Bits64 ([141] : List Nat) dest (X64MemoryOperand address)
    | X64ArithmeticReg width operation dest source =>
        x64_register_instruction width ([add 1 (mul 8 (x64_arithmetic_group operation))] : List Nat) source (X64RegisterOperand dest)
    | X64ArithmeticImm32 width operation dest immediate =>
        x64_with_immediate
          (x64_modrm_instruction width ([129] : List Nat) (x64_arithmetic_group operation) 0 (X64RegisterOperand dest))
          (x64_word32_bytes immediate)
    | X64Multiply width dest source => x64_register_instruction width ([15, 175] : List Nat) dest source
    | X64Divide width signedness divisor =>
        x64_modrm_instruction width ([247] : List Nat)
          (match signedness with | X64Unsigned => 6 | X64Signed => 7 end) 0 divisor
    | X64SignExtendDividend width => Right X64EncodeError (List Nat) (append Nat (x64_rex width 0 0 0) ([153] : List Nat))
    | X64ShiftImm width operation reg count => x64_shift_immediate width operation reg count
    | X64ShiftCL width operation reg => x64_modrm_instruction width ([211] : List Nat) (x64_shift_group operation) 0 (X64RegisterOperand reg)
    | X64CallRelative disp => x64_relative_instruction ([232] : List Nat) disp
    | X64JumpRelative disp => x64_relative_instruction ([233] : List Nat) disp
    | X64JumpIf condition disp => x64_relative_instruction ([15, add 128 (x64_condition_code condition)] : List Nat) disp
    | X64CallIndirect target => x64_modrm_instruction X64Bits32 ([255] : List Nat) 2 0 target
    | X64JumpIndirect target => x64_modrm_instruction X64Bits32 ([255] : List Nat) 4 0 target
    -- REX.W marks a tail call for the Windows unwinder. Ordinary jumps keep
    -- their existing encoding; codegen owns the surrounding epilog contract.
    | X64TailJumpIndirect target => x64_modrm_instruction X64Bits64 ([255] : List Nat) 4 0 (X64MemoryOperand target)
    | X64Push reg => Right X64EncodeError (List Nat)
        (append Nat (x64_rex X64Bits32 0 0 (x64_register_high reg)) ([add 80 (x64_register_low reg)] : List Nat))
    | X64Pop reg => Right X64EncodeError (List Nat)
        (append Nat (x64_rex X64Bits32 0 0 (x64_register_high reg)) ([add 88 (x64_register_low reg)] : List Nat))
    | X64Return => Right X64EncodeError (List Nat) ([195] : List Nat)
    | X64Trap => Right X64EncodeError (List Nat) ([15, 11] : List Nat)
    end;

-- Encoding a block fails as a whole; callers never receive a successful prefix
-- when a later instruction contains an unrepresentable operand.
def x64_encode_block : List X64Instruction -> Either X64EncodeError (List Nat) :=
  fix x64_encode_block (instructions : List X64Instruction) : Either X64EncodeError (List Nat) :=
    match instructions with
    | Nil => Right X64EncodeError (List Nat) ([] : List Nat)
    | Cons instruction rest =>
      match x64_encode instruction with
      | Left err => Left X64EncodeError (List Nat) err
      | Right bytes => mapRight X64EncodeError (List Nat) (List Nat) (append Nat bytes) (x64_encode_block rest)
      end
    end;
