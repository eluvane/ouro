-- Directory handles and search handles have different close operations.
-- Each scope owns at most one handle and a LIFO list of raw pages.
import "managed_files_memory.ouro",
  "../../std/types.ouro",
  "managed_startup_memory.ouro",
  "managed_model.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "lower_model.ouro",
  "pe_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "../pipeline_abi.ouro",
  "../primitive_check.ouro",
  "lower_types.ouro",
  "../primitive_contracts.ouro",
  "../primitive_registry_base.ouro",
  "../primitive_roles.ouro",
  "managed_stdio.ouro",
  "managed_fs_copy.ouro";

inductive ManagedDirectoryHelper : Type :=
  | ManagedDirectoryAllocate : ManagedDirectoryHelper | ManagedDirectoryRelease : ManagedDirectoryHelper
  | ManagedDirectoryToWide : ManagedDirectoryHelper | ManagedDirectoryFromWide : ManagedDirectoryHelper
  | ManagedDirectoryWideLength : ManagedDirectoryHelper | ManagedDirectoryPathValid : ManagedDirectoryHelper
  | ManagedDirectoryOpen : ManagedDirectoryHelper | ManagedDirectoryCheck : ManagedDirectoryHelper
  | ManagedDirectoryFileClose : ManagedDirectoryHelper | ManagedDirectoryFirst : ManagedDirectoryHelper
  | ManagedDirectoryNext : ManagedDirectoryHelper | ManagedDirectorySearchClose : ManagedDirectoryHelper;

inductive ManagedDirectoryScope : Type :=
  | ManagedDirectoryScopeOf : List MirValue -> Maybe (Pair ManagedDirectoryHelper MirValue) -> ManagedDirectoryScope;

def managed_directory_helper_name (helper : ManagedDirectoryHelper) : List Nat :=
    match helper with
    | ManagedDirectoryAllocate => managed_file_helper_name ManagedFileAllocate
    | ManagedDirectoryRelease => managed_file_helper_name ManagedFileRelease
    | ManagedDirectoryToWide => managed_file_helper_name ManagedFileToWide
    | ManagedDirectoryFromWide => managed_startup_helper_name ManagedStartupFromWide
    | ManagedDirectoryWideLength => managed_startup_helper_name ManagedStartupWideLength
    | ManagedDirectoryPathValid => ([114,97,119,95,119,105,110,100,111,119,115,95,112,97,116,104,95,118,97,108,105,100] : List Nat)
    | ManagedDirectoryOpen => ([114,97,119,95,119,105,110,100,111,119,115,95,100,105,114,101,99,116,111,114,121,95,111,112,101,110,95,108,105,116,101,114,97,108] : List Nat)
    | ManagedDirectoryCheck => ([114,97,119,95,119,105,110,100,111,119,115,95,100,105,114,101,99,116,111,114,121,95,99,104,101,99,107,95,104,97,110,100,108,101] : List Nat)
    | ManagedDirectoryFileClose => managed_file_helper_name ManagedFileClose
    | ManagedDirectoryFirst => ([114,97,119,95,119,105,110,100,111,119,115,95,100,105,114,101,99,116,111,114,121,95,102,105,114,115,116] : List Nat)
    | ManagedDirectoryNext => ([114,97,119,95,119,105,110,100,111,119,115,95,100,105,114,101,99,116,111,114,121,95,110,101,120,116] : List Nat)
    | ManagedDirectorySearchClose => ([114,97,119,95,119,105,110,100,111,119,115,95,100,105,114,101,99,116,111,114,121,95,99,108,111,115,101] : List Nat) end;

def managed_directory_status_expected (compiler : ManagedCompiler) (helper : ManagedDirectoryHelper)
    : Either NativeLowerError CoreTerm :=
    let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
    lower_from_primitive CoreTerm (CSort 0)
      (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
        primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
          primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU8Type bindings) (fun (byte : CoreTerm) =>
            primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU32Type bindings) (fun (word : CoreTerm) =>
              primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveUSizeType bindings) (fun (size : CoreTerm) =>
                primitive_map CoreTerm CoreTerm (fun (boolean : CoreTerm) =>
                  let buffer : CoreTerm := CApp pointer byte in
                  let result : CoreTerm := match helper with | ManagedDirectoryPathValid => boolean
                    | ManagedDirectoryAllocate => word
                    | ManagedDirectoryRelease => word
                    | ManagedDirectoryToWide => word
                    | ManagedDirectoryFromWide => word
                    | ManagedDirectoryWideLength => word
                    | ManagedDirectoryOpen => word
                    | ManagedDirectoryCheck => word
                    | ManagedDirectoryFileClose => word
                    | ManagedDirectoryFirst => word
                    | ManagedDirectoryNext => word
                    | ManagedDirectorySearchClose => word end in
                  let arguments : List CoreTerm := match helper with
                    | ManagedDirectoryFirst => ([buffer, size, buffer, size, CApp pointer size] : List CoreTerm)
                    | ManagedDirectoryNext => ([buffer, buffer, size] : List CoreTerm)
                    | ManagedDirectoryPathValid => ([buffer, size, size] : List CoreTerm)
                    | ManagedDirectoryAllocate => ([] : List CoreTerm)
                    | ManagedDirectoryRelease => ([] : List CoreTerm)
                    | ManagedDirectoryToWide => ([] : List CoreTerm)
                    | ManagedDirectoryFromWide => ([] : List CoreTerm)
                    | ManagedDirectoryWideLength => ([] : List CoreTerm)
                    | ManagedDirectoryOpen => ([] : List CoreTerm)
                    | ManagedDirectoryCheck => ([] : List CoreTerm)
                    | ManagedDirectoryFileClose => ([] : List CoreTerm)
                    | ManagedDirectorySearchClose => ([] : List CoreTerm) end in
                  primitive_arrow(arguments, CApp runtime result))
                  (primitive_role_ref(PrimitiveBoolRole, primitive_roles_environment (managed_compiler_entries compiler)))))))));

def managed_directory_expected (compiler : ManagedCompiler) (helper : ManagedDirectoryHelper)
    : Either NativeLowerError CoreTerm :=
    match helper with
    | ManagedDirectoryAllocate => managed_file_expected compiler ManagedFileAllocate
    | ManagedDirectoryRelease => managed_file_expected compiler ManagedFileRelease
    | ManagedDirectoryToWide => managed_file_expected compiler ManagedFileToWide
    | ManagedDirectoryFromWide => managed_startup_expected compiler ManagedStartupFromWide
    | ManagedDirectoryWideLength => managed_startup_expected compiler ManagedStartupWideLength
    | ManagedDirectoryPathValid => managed_directory_status_expected compiler helper
    | ManagedDirectoryOpen => managed_file_expected compiler ManagedFileOpenWrite
    | ManagedDirectoryCheck => managed_file_expected compiler ManagedFileLength
    | ManagedDirectoryFileClose => managed_file_expected compiler ManagedFileClose
    | ManagedDirectoryFirst => managed_directory_status_expected compiler helper
    | ManagedDirectoryNext => managed_directory_status_expected compiler helper
    | ManagedDirectorySearchClose => managed_file_expected compiler ManagedFileClose end;

def managed_directory_helpers (compiler : ManagedCompiler) : List ManagedDirectoryHelper :=
    let listing : Bool := managed_stdio_has compiler PrimitiveDirectoryList in
    match orb(listing, managed_stdio_has compiler PrimitiveDirectoryListable) with
    | False => ([] : List ManagedDirectoryHelper)
    | True => append ManagedDirectoryHelper
        ([ManagedDirectoryAllocate, ManagedDirectoryRelease, ManagedDirectoryToWide, ManagedDirectoryPathValid,
          ManagedDirectoryOpen, ManagedDirectoryCheck, ManagedDirectoryFileClose] : List ManagedDirectoryHelper)
        (match listing with | False => ([] : List ManagedDirectoryHelper)
          | True => ([ManagedDirectoryFirst, ManagedDirectoryNext, ManagedDirectorySearchClose,
              ManagedDirectoryWideLength, ManagedDirectoryFromWide] : List ManagedDirectoryHelper) end) end;

def managed_directory_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    (fix resolve (helpers : List ManagedDirectoryHelper) : Either NativeLowerError (List Nat) :=
      match helpers with | Nil => Right(NativeLowerError, List Nat, [] : List Nat) | Cons helper rest =>
        lower_bind CoreTerm (List Nat) (managed_directory_expected compiler helper) (fun (expected : CoreTerm) =>
          lower_bind Nat (List Nat) (managed_runtime_definition compiler fuel (managed_directory_helper_name helper) expected)
            (fun (id : Nat) => lower_map(List Nat, List Nat, Cons Nat id, resolve rest))) end)
      (managed_directory_helpers compiler);

def managed_directory_call (compiler : ManagedCompiler) (helper : ManagedDirectoryHelper)
    (arguments : List MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (managed_directory_expected compiler helper) (fun (expected : CoreTerm) =>
      lower_bind LowerContract ManagedResult
        (managed_runtime_contract compiler primitive_default_fuel (managed_directory_helper_name helper) expected)
        (fun (contract : LowerContract) =>
          let typ : MirType := match helper with | ManagedDirectoryAllocate => MirRawPtr
            | ManagedDirectoryRelease => MirU8 | ManagedDirectoryPathValid => MirU8
            | ManagedDirectoryToWide => MirU32
            | ManagedDirectoryFromWide => MirU32
            | ManagedDirectoryWideLength => MirU32
            | ManagedDirectoryOpen => MirU32
            | ManagedDirectoryCheck => MirU32
            | ManagedDirectoryFileClose => MirU32
            | ManagedDirectoryFirst => MirU32
            | ManagedDirectoryNext => MirU32
            | ManagedDirectorySearchClose => MirU32 end in
          managed_fresh typ (fun (local : Nat) =>
            MirCall(MirMayGc, Just Nat local, MirDirect (lower_contract_id contract), arguments)) state));

def managed_directory_own (buffer : MirValue) (scope : ManagedDirectoryScope) : ManagedDirectoryScope :=
    match scope with | ManagedDirectoryScopeOf buffers owner =>
      ManagedDirectoryScopeOf(Cons MirValue buffer buffers, owner) end;

def managed_directory_handle (close : ManagedDirectoryHelper) (value : MirValue)
    (scope : ManagedDirectoryScope) : ManagedDirectoryScope :=
    match scope with | ManagedDirectoryScopeOf buffers _ =>
      ManagedDirectoryScopeOf buffers (Just (Pair ManagedDirectoryHelper MirValue)
        (MkPair ManagedDirectoryHelper MirValue close value)) end;

def managed_directory_cleanup (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match scope with | ManagedDirectoryScopeOf buffers owner => match owner with
      | Nothing => managed_startup_release_all compiler buffers (managed_bits MirU8 1) state
      | Just pair => match pair with | MkPair close value =>
          lower_bind ManagedResult ManagedResult (managed_directory_call compiler close ([value] : List MirValue) state)
            (fun (closed : ManagedResult) => match closed with | ManagedResultOf status next =>
              lower_bind ManagedResult ManagedResult (managed_startup_zero status next)
                (fun (checked : ManagedResult) => match checked with | ManagedResultOf okay after =>
                  managed_startup_release_all compiler buffers okay after end) end) end end end;

def managed_directory_require (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (condition : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind Nat ManagedState (managed_stdio_exit_symbol compiler) (fun (exit : Nat) =>
      lower_bind (Pair Nat ManagedState) ManagedState (managed_fresh_block state)
        (fun (good : Pair Nat ManagedState) => match good with | MkPair valid next =>
          lower_bind (Pair Nat ManagedState) ManagedState (managed_fresh_block next)
            (fun (bad : Pair Nat ManagedState) => match bad with | MkPair invalid after =>
              lower_map ManagedResult ManagedState (fun (cleaned : ManagedResult) => match cleaned with
                | ManagedResultOf _ final => managed_switch_block valid MirTrap
                    (managed_emit (MirCall MirMayGc (Nothing Nat) (MirDirect exit)
                      ([managed_bits MirU32 73] : List MirValue)) final) end)
                (managed_directory_cleanup compiler scope
                  (managed_switch_block invalid (MirBranch condition valid invalid) after)) end) end));

def managed_directory_status (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (status : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_startup_zero status state)
      (fun (checked : ManagedResult) => match checked with | ManagedResultOf okay next =>
        managed_directory_require compiler scope okay next end);

def managed_directory_buffer (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (bytes : MirValue)
    (body : MirValue -> ManagedDirectoryScope -> ManagedState -> Either NativeLowerError ManagedResult)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_directory_call compiler ManagedDirectoryAllocate ([bytes, managed_bits MirUSize 8] : List MirValue) state)
      (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf buffer next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual buffer (managed_bits MirRawPtr 0) next)
          (fun (checked : ManagedResult) => match checked with | ManagedResultOf okay after =>
            lower_bind ManagedState ManagedResult (managed_directory_require compiler scope okay after)
              (body(buffer, managed_directory_own buffer scope)) end) end);

def managed_directory_complete (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (value : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (managed_stdio_exit_symbol compiler) (fun (exit : Nat) =>
      lower_bind ManagedResult ManagedResult (managed_directory_cleanup compiler scope state)
        (fun (cleaned : ManagedResult) => match cleaned with | ManagedResultOf okay next =>
          lower_map ManagedState ManagedResult (fun (finished : ManagedState) => ManagedResultOf value finished)
            (managed_stdio_require exit okay next) end));

-- Alias for managed_source. The body resolves when this file is selected
-- because managed_fs_copy is a keep-import.
def source_copy_roots (compiler : ManagedCompiler) (fuel : Nat) : Either NativeLowerError (List Nat) :=
    managed_copy_roots compiler fuel;
