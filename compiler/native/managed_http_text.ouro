-- Raw staging retains the managed source across every safepoint. Text alone
-- is strictly converted; binary request and response payloads never decode.
import "managed_http_memory.ouro";


def managed_http_int_max : MirValue :=
    MirBits MirUSize (X64Words64 (X64Bytes32 255 255 255 127) codegen_zero);
def managed_http_bytes (compiler : ManagedCompiler) (value : MirValue) (scope : ManagedHttpScope)
    (body : MirValue -> MirValue -> ManagedHttpScope -> ManagedState -> Either NativeLowerError ManagedResult)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_string_size compiler value state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual bytes managed_http_int_max next)
          (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits after =>
            lower_bind ManagedState ManagedResult (managed_http_require compiler scope fits after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_binary MirUSize MirAdd bytes (managed_bits MirUSize 1) checked)
                (fun (padded : ManagedResult) => match padded with | ManagedResultOf allocation entered =>
                  managed_http_buffer compiler scope allocation
                    (fun (buffer : MirValue) (owned : ManagedHttpScope) (current : ManagedState) =>
                      lower_bind ManagedState ManagedResult
                        (managed_bytes_copy value (managed_bits MirUSize 40) buffer (managed_bits MirUSize 0) bytes current)
                        (body buffer bytes owned)) entered end)) end) end);

def managed_http_text_fill (compiler : ManagedCompiler) (source : MirValue) (bytes : MirValue)
    (capacity : MirValue) (wide : MirValue) (scope : ManagedHttpScope)
    (body : MirValue -> MirValue -> ManagedHttpScope -> ManagedState -> Either NativeLowerError ManagedResult)
    (count : MirValue) (owned : ManagedHttpScope) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_file_call compiler ManagedFileToWide ([source, bytes, wide, capacity, count] : List MirValue) state)
      (fun (converted : ManagedResult) => match converted with | ManagedResultOf status next =>
        lower_bind ManagedState ManagedResult (managed_http_status compiler owned status next)
          (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_startup_count count checked)
            (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf units after =>
              lower_bind ManagedResult ManagedResult (managed_compare MirLess units capacity after)
                (fun (tested : ManagedResult) => match tested with | ManagedResultOf fits entered =>
                  lower_bind ManagedState ManagedResult (managed_http_require compiler owned fits entered)
                    (fun (bounded : ManagedState) => lower_bind ManagedResult ManagedResult
                      (managed_binary MirUSize MirMul units (managed_bits MirUSize 2) bounded)
                      (fun (first : ManagedResult) => match first with | ManagedResultOf low final =>
                        lower_bind ManagedResult ManagedResult
                          (managed_binary MirUSize MirAdd low (managed_bits MirUSize 1) final)
                          (fun (second : ManagedResult) => match second with | ManagedResultOf high terminated =>
                            body wide units owned
                              (managed_emit_all ([MirStoreAt wide low (managed_bits MirU8 0),
                                MirStoreAt wide high (managed_bits MirU8 0)] : List MirInstruction) terminated) end) end)) end) end)) end);

def managed_http_text_raw (compiler : ManagedCompiler)
    (body : MirValue -> MirValue -> ManagedHttpScope -> ManagedState -> Either NativeLowerError ManagedResult)
    (source : MirValue) (bytes : MirValue) (scope : ManagedHttpScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd bytes (managed_bits MirUSize 1) state)
      (fun (padded : ManagedResult) => match padded with | ManagedResultOf capacity next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) next)
          (fun (sized : ManagedResult) => match sized with | ManagedResultOf allocation after =>
            managed_http_buffer compiler scope allocation
              (fun (wide : MirValue) (owned : ManagedHttpScope) (entered : ManagedState) =>
                managed_http_buffer compiler owned (managed_bits MirUSize 8)
                  (managed_http_text_fill compiler source bytes capacity wide owned body) entered) after end) end);

def managed_http_text (compiler : ManagedCompiler) (value : MirValue) (scope : ManagedHttpScope)
    (body : MirValue -> MirValue -> ManagedHttpScope -> ManagedState -> Either NativeLowerError ManagedResult)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_http_bytes compiler value scope (managed_http_text_raw compiler body) state;
