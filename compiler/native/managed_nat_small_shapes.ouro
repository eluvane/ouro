-- Optional execution specialization of complete, already checked source.
-- Candidate extraction is not authority: exact Core and dependencies decide.
import "managed_nat_shapes.ouro",
  "managed_model.ouro",
  "../file_elab_lookup.ouro",
  "../core.ouro",
  "lower_model.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "pe_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "lower_types.ouro",
  "lower_boundary.ouro",
  "../file_elab.ouro",
  "../file_elab_infer.ouro",
  "../constructor_closures.ouro";

def managed_small_nat_mul_template (natural : Nat) (addition : Nat) : CoreTerm :=
    let number : CoreTerm := CInd natural in
    CFix 0 0 2 (managed_nat_binary_type natural natural)
      (CLam number (CLam number (CCase (MkCaseInfo natural 0 [0,1])
        (CLam number number) (CRel 1)
        [CConstruct natural 0 0, CLam number
          (CApp (CApp(CConst addition, CRel 1))
            (CApp(CApp(CRel 3, CRel 0), CRel 1)))])));

def managed_small_nat_less_template (natural : Nat) (boolean : Nat) (ordering : Nat) (comparison : Nat) : CoreTerm :=
    let number : CoreTerm := CInd natural in
    CLam number (CLam number (CCase (MkCaseInfo ordering 0 [0,0,0])
      (CLam(CInd ordering, CInd boolean))
      (CApp(CApp(CConst comparison, CRel 1), CRel 0))
      [CConstruct boolean 0 0, CConstruct boolean 1 0, CConstruct boolean 1 0]));

def managed_small_nat_div_template (natural : Nat) (boolean : Nat) (less : Nat) (subtract : Nat) : CoreTerm :=
    let number : CoreTerm := CInd natural in
    let zero : CoreTerm := CConstruct natural 0 0 in
    let successor : CoreTerm := CConstruct natural 1 0 in
    let motive : CoreTerm := CLam number number in
    let info : CaseInfo := MkCaseInfo natural 0 [0,1] in
    let successor_rel : CoreTerm := CApp(successor, CRel 1) in
    let inner_motive : CoreTerm := CLam(CInd boolean, CApp motive successor_rel) in
    let less_left : CoreTerm := CApp(CConst less, CRel 1) in
    let condition : CoreTerm := CApp(less_left, CRel 6) in
    let subtract_left : CoreTerm := CApp(CConst subtract, CRel 1) in
    let remainder : CoreTerm := CApp(subtract_left, CRel 6) in
    let rec_step : CoreTerm := CApp(CRel 4, CRel 0) in
    let rec_succ : CoreTerm := CApp(successor, CRel 2) in
    let recurse : CoreTerm := CApp(CApp rec_step rec_succ, remainder) in
    let loop_inner : CoreTerm := CPi number number in
    let loop_mid : CoreTerm := CPi number loop_inner in
    let loop_ty : CoreTerm := CPi number loop_mid in
    let loop : CoreTerm := CFix 0 0 3 loop_ty
      (CLam number (CLam number (CLam number (CCase info motive (CRel 2)
        [CRel 1, CLam(number, CCase (MkCaseInfo boolean 0 [0,0]) inner_motive condition [CRel 2,recurse])])))) in
    CLam number (CLam number (CCase info motive (CRel 0)
      [zero, CLam(number, CApp(CApp(CApp(loop, CApp(successor, CRel 2)), zero), CRel 2))]));

def managed_small_nat_mod_template (natural : Nat) (boolean : Nat) (less : Nat) (subtract : Nat) : CoreTerm :=
    let number : CoreTerm := CInd natural in
    let successor : CoreTerm := CConstruct natural 1 0 in
    let motive : CoreTerm := CLam number number in
    let info : CaseInfo := MkCaseInfo natural 0 [0,1] in
    let successor_rel : CoreTerm := CApp(successor, CRel 1) in
    let inner_motive : CoreTerm := CLam(CInd boolean, CApp motive successor_rel) in
    let less_left : CoreTerm := CApp(CConst less, CRel 1) in
    let condition : CoreTerm := CApp(less_left, CRel 5) in
    let subtract_left : CoreTerm := CApp(CConst subtract, CRel 1) in
    let remainder : CoreTerm := CApp(subtract_left, CRel 5) in
    let rec_step : CoreTerm := CApp(CRel 3, CRel 0) in
    let recurse : CoreTerm := CApp rec_step remainder in
    let loop : CoreTerm := CFix 0 0 2 (managed_nat_binary_type natural natural)
      (CLam number (CLam number (CCase info motive (CRel 1)
        [CRel 0, CLam(number, CCase (MkCaseInfo boolean 0 [0,0]) inner_motive condition [CRel 1,recurse])])) ) in
    CLam number (CLam number (CCase info motive (CRel 0)
      [CRel 1, CLam(number, CApp(CApp(loop, CApp(successor, CRel 2)), CRel 2))]));

-- Peel only source binders/fixpoints. Full templates later reject every extra
-- binder, argument, case field or declaration mismatch.
def managed_small_nat_peel : Nat -> CoreTerm -> Either NativeLowerError CoreTerm :=
  fix peel (fuel : Nat) (term : CoreTerm) : Either NativeLowerError CoreTerm :=
    match fuel with | Z => Left NativeLowerError CoreTerm LowerResourceExhausted
    | S next => match term with
      | CLam _ body => peel next body | CFix _ _ _ _ body => peel next body
      | CRel _ => Right NativeLowerError CoreTerm term | CConst _ => Right NativeLowerError CoreTerm term
      | CInd _ => Right NativeLowerError CoreTerm term | CConstruct _ _ _ => Right NativeLowerError CoreTerm term
      | CSort _ => Right NativeLowerError CoreTerm term | CPi _ _ => Right NativeLowerError CoreTerm term
      | CApp _ _ => Right NativeLowerError CoreTerm term | CLetIn _ _ _ => Right NativeLowerError CoreTerm term
      | CCase _ _ _ _ => Right NativeLowerError CoreTerm term
      | CStrLit _ _ => Right NativeLowerError CoreTerm term | CStrBytes _ _ => Right NativeLowerError CoreTerm term end end;

def managed_small_nat_case (term : CoreTerm) : Maybe (Pair CoreTerm (List CoreTerm)) :=
    match lower_term_view term with
    | LowerCaseTerm _ _ condition branches => Just(Pair(CoreTerm, List CoreTerm), MkPair CoreTerm (List CoreTerm) condition branches)
    | LowerLocalTerm _ => Nothing (Pair(CoreTerm, List CoreTerm))
    | LowerLambdaTerm _ _ => Nothing (Pair(CoreTerm, List CoreTerm))
    | LowerApplyTerm _ _ => Nothing (Pair(CoreTerm, List CoreTerm))
    | LowerLetTerm _ _ _ => Nothing (Pair(CoreTerm, List CoreTerm))
    | LowerGlobalTerm _ => Nothing (Pair(CoreTerm, List CoreTerm))
    | LowerConstructorTerm _ _ _ => Nothing (Pair(CoreTerm, List CoreTerm))
    | LowerOtherTerm _ => Nothing (Pair(CoreTerm, List CoreTerm)) end;

def managed_small_nat_global (fuel : Nat) (term : CoreTerm) : Either NativeLowerError (Maybe Nat) :=
    lower_map (Pair(CoreTerm, List CoreTerm)) (Maybe Nat) (fun (spine : Pair CoreTerm (List CoreTerm)) =>
      match spine with | MkPair head _ => match lower_term_view head with
        | LowerGlobalTerm id => Just Nat id | LowerLocalTerm _ => Nothing Nat
        | LowerLambdaTerm _ _ => Nothing Nat | LowerApplyTerm _ _ => Nothing Nat
        | LowerLetTerm _ _ _ => Nothing Nat | LowerConstructorTerm _ _ _ => Nothing Nat
        | LowerCaseTerm _ _ _ _ => Nothing Nat | LowerOtherTerm _ => Nothing Nat end end)
      (lower_spine fuel term ([] : List CoreTerm));

def managed_small_nat_second (fuel : Nat) (term : CoreTerm) : Either NativeLowerError (Maybe CoreTerm) :=
    lower_map CoreTerm (Maybe CoreTerm) (fun (plain : CoreTerm) =>
      match managed_small_nat_case plain with | Nothing => Nothing CoreTerm
      | Just parts => match parts with | MkPair _ branches => compiler_nth CoreTerm branches 1 end end)
      (managed_small_nat_peel fuel term);

-- Authenticated dependencies use the same checked environment/index as their
-- caller. A missing ordinary body is a mismatch, not inferred arithmetic.
def managed_small_nat_body (compiler : ManagedCompiler) (fuel : Nat) (id : Nat)
    : Either NativeLowerError (Maybe (Pair CoreTerm CoreTerm)) :=
    let entries : List Entry := managed_compiler_entries compiler in
    match lookup_type id entries, lookup_const id entries with
    | Just annotation, Just body => lower_bind CoreTerm (Maybe (Pair CoreTerm CoreTerm))
        (lower_check CoreTerm id (close_constructors_checked_indexed fuel (managed_compiler_environment compiler) body))
        (fun (closed : CoreTerm) => lower_map Unit (Maybe (Pair CoreTerm CoreTerm))
          (fun (_ : Unit) => Just(Pair CoreTerm CoreTerm, MkPair CoreTerm CoreTerm annotation closed))
          (lower_check Unit id (check_term_checked_indexed fuel (managed_compiler_environment compiler)
            ([] : List CoreTerm) closed annotation)))
    | Nothing, Just _ => Right(NativeLowerError, Maybe (Pair CoreTerm CoreTerm), Nothing (Pair CoreTerm CoreTerm))
    | Just _, Nothing => Right(NativeLowerError, Maybe (Pair CoreTerm CoreTerm), Nothing (Pair CoreTerm CoreTerm))
    | Nothing, Nothing => Right(NativeLowerError, Maybe (Pair CoreTerm CoreTerm), Nothing (Pair CoreTerm CoreTerm)) end;

def managed_small_nat_known (compiler : ManagedCompiler) (fuel : Nat) (id : Nat)
    : Either NativeLowerError (Maybe ManagedNatOperation) :=
    lower_bind (Maybe (Pair CoreTerm CoreTerm)) (Maybe ManagedNatOperation) (managed_small_nat_body compiler fuel id)
      (fun (found : Maybe (Pair CoreTerm CoreTerm)) => match found with
        | Nothing => Right(NativeLowerError, Maybe ManagedNatOperation, Nothing ManagedNatOperation)
        | Just parts => match parts with | MkPair annotation body =>
            managed_nat_recognize (managed_compiler_entries compiler) fuel id annotation body end end);

def managed_small_nat_arithmetic_dependency (compiler : ManagedCompiler) (fuel : Nat) (id : Nat) (subtracting : Bool)
    : Either NativeLowerError Bool :=
    lower_map (Maybe ManagedNatOperation) Bool (fun (found : Maybe ManagedNatOperation) => match found with
      | Nothing => False | Just operation => match operation with
        | ManagedNatAdd => notb subtracting | ManagedNatSubtract => subtracting
        | ManagedNatEqual _ => False | ManagedNatCompare _ => False end end)
      (managed_small_nat_known compiler fuel id);

def managed_small_nat_less_body (compiler : ManagedCompiler) (fuel : Nat) (natural : Nat) (boolean : Nat)
    (id : Nat) (annotation : CoreTerm) (body : CoreTerm) : Either NativeLowerError Bool :=
    lower_bind CoreTerm Bool (managed_small_nat_peel fuel body) (fun (plain : CoreTerm) =>
      match managed_small_nat_case plain with
      | Nothing => Right NativeLowerError Bool False
      | Just parts => match parts with | MkPair condition _ =>
          lower_bind (Maybe Nat) Bool (managed_small_nat_global fuel condition) (fun (comparison : Maybe Nat) =>
            match comparison with | Nothing => Right NativeLowerError Bool False
            | Just target => lower_bind (Maybe ManagedNatOperation) Bool (managed_small_nat_known compiler fuel target)
                (fun (known : Maybe ManagedNatOperation) => match known with
                  | Nothing => Right NativeLowerError Bool False
                  | Just operation => match operation with
                    | ManagedNatCompare ordering => managed_nat_exact fuel id annotation body
                        (managed_nat_binary_type natural boolean) (managed_small_nat_less_template natural boolean ordering target)
                    | ManagedNatAdd => Right NativeLowerError Bool False
                    | ManagedNatSubtract => Right NativeLowerError Bool False
                    | ManagedNatEqual _ => Right NativeLowerError Bool False end end) end) end end);

def managed_small_nat_less_dependency (compiler : ManagedCompiler) (fuel : Nat) (natural : Nat) (boolean : Nat) (id : Nat)
    : Either NativeLowerError Bool :=
    lower_bind (Maybe (Pair CoreTerm CoreTerm)) Bool (managed_small_nat_body compiler fuel id)
      (fun (found : Maybe (Pair CoreTerm CoreTerm)) => match found with
        | Nothing => Right NativeLowerError Bool False
        | Just parts => match parts with | MkPair annotation body =>
            managed_small_nat_less_body compiler fuel natural boolean id annotation body end end);

def managed_small_nat_mul_candidate (compiler : ManagedCompiler) (fuel : Nat) (id : Nat)
    (natural : Nat) (annotation : CoreTerm) (body : CoreTerm) : Either NativeLowerError Bool :=
    lower_bind (Maybe CoreTerm) Bool (managed_small_nat_second fuel body) (fun (branch : Maybe CoreTerm) =>
      match branch with | Nothing => Right NativeLowerError Bool False
      | Just value => lower_bind CoreTerm Bool (managed_small_nat_peel fuel value) (fun (plain : CoreTerm) =>
          lower_bind (Maybe Nat) Bool (managed_small_nat_global fuel plain) (fun (addition : Maybe Nat) =>
            match addition with | Nothing => Right NativeLowerError Bool False
            | Just target => lower_bind Bool Bool (managed_nat_exact fuel id annotation body
                (managed_nat_binary_type natural natural) (managed_small_nat_mul_template natural target))
                (fun (exact : Bool) => match exact with | False => Right NativeLowerError Bool False
                  | True => managed_small_nat_arithmetic_dependency compiler fuel target False end) end)) end);

def managed_small_nat_div_refs (fuel : Nat) (branch : CoreTerm)
    : Either NativeLowerError (Maybe (Pair Nat Nat)) :=
    lower_bind CoreTerm (Maybe (Pair Nat Nat)) (managed_small_nat_peel fuel branch) (fun (plain : CoreTerm) =>
      match managed_small_nat_case plain with
      | Nothing => Right(NativeLowerError, Maybe (Pair Nat Nat), Nothing (Pair Nat Nat))
      | Just parts => match parts with | MkPair condition branches =>
          lower_bind (Maybe Nat) (Maybe (Pair Nat Nat)) (managed_small_nat_global fuel condition) (fun (less : Maybe Nat) =>
            match less with | Nothing => Right(NativeLowerError, Maybe (Pair Nat Nat), Nothing (Pair Nat Nat))
            | Just test => match compiler_nth CoreTerm branches 1 with
                | Nothing => Right(NativeLowerError, Maybe (Pair Nat Nat), Nothing (Pair Nat Nat))
                | Just recurse => lower_bind (Pair(CoreTerm, List CoreTerm)) (Maybe (Pair Nat Nat))
                    (lower_spine fuel recurse ([] : List CoreTerm)) (fun (spine : Pair CoreTerm (List CoreTerm)) =>
                      match spine with | MkPair _ arguments => match compiler_nth CoreTerm (reverse CoreTerm arguments) 0 with
                        | Nothing => Right(NativeLowerError, Maybe (Pair Nat Nat), Nothing (Pair Nat Nat))
                        | Just last => lower_map (Maybe Nat) (Maybe (Pair Nat Nat))
                            (fun (subtract : Maybe Nat) => match subtract with | Nothing => Nothing (Pair Nat Nat)
                              | Just target => Just(Pair Nat Nat, MkPair Nat Nat test target) end)
                            (managed_small_nat_global fuel last) end end) end end) end end);

def managed_small_nat_div_candidates (fuel : Nat) (body : CoreTerm)
    : Either NativeLowerError (Maybe (Pair Nat Nat)) :=
    lower_bind (Maybe CoreTerm) (Maybe (Pair Nat Nat)) (managed_small_nat_second fuel body)
      (fun (branch : Maybe CoreTerm) => match branch with
        | Nothing => Right(NativeLowerError, Maybe (Pair Nat Nat), Nothing (Pair Nat Nat))
        | Just value => lower_bind CoreTerm (Maybe (Pair Nat Nat)) (managed_small_nat_peel fuel value)
            (fun (plain : CoreTerm) => lower_bind (Pair(CoreTerm, List CoreTerm)) (Maybe (Pair Nat Nat))
              (lower_spine fuel plain ([] : List CoreTerm)) (fun (spine : Pair CoreTerm (List CoreTerm)) =>
                match spine with | MkPair loop _ => lower_bind (Maybe CoreTerm) (Maybe (Pair Nat Nat))
                    (managed_small_nat_second fuel loop) (fun (inner : Maybe CoreTerm) => match inner with
                      | Nothing => Right(NativeLowerError, Maybe (Pair Nat Nat), Nothing (Pair Nat Nat))
                      | Just arm => managed_small_nat_div_refs fuel arm end) end)) end);

def managed_small_nat_div_operation (fuel : Nat) (id : Nat) (natural : Nat) (boolean : Nat)
    (less : Nat) (subtract : Nat) (annotation : CoreTerm) (body : CoreTerm)
    : Either NativeLowerError (Maybe ManagedNatSmallOperation) :=
    let typ : CoreTerm := managed_nat_binary_type natural natural in
    lower_bind Bool (Maybe ManagedNatSmallOperation) (managed_nat_exact fuel id annotation body typ
      (managed_small_nat_div_template natural boolean less subtract)) (fun (division : Bool) => match division with
      | True => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Just ManagedNatSmallOperation ManagedNatSmallDivide)
      | False => lower_map Bool (Maybe ManagedNatSmallOperation) (fun (remainder : Bool) => match remainder with
          | True => Just ManagedNatSmallOperation ManagedNatSmallRemainder | False => Nothing ManagedNatSmallOperation end)
          (managed_nat_exact fuel id annotation body typ (managed_small_nat_mod_template natural boolean less subtract)) end);

def managed_small_nat_div_recognize (compiler : ManagedCompiler) (fuel : Nat) (id : Nat) (natural : Nat)
    (annotation : CoreTerm) (body : CoreTerm) : Either NativeLowerError (Maybe ManagedNatSmallOperation) :=
    match managed_nat_registered(managed_compiler_entries compiler, PrimitiveBoolRole) with
    | Nothing => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Nothing ManagedNatSmallOperation)
    | Just boolean => lower_bind (Maybe (Pair Nat Nat)) (Maybe ManagedNatSmallOperation)
        (managed_small_nat_div_candidates fuel body) (fun (found : Maybe (Pair Nat Nat)) => match found with
          | Nothing => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Nothing ManagedNatSmallOperation)
          | Just targets => match targets with | MkPair less subtract =>
              lower_bind (Maybe ManagedNatSmallOperation) (Maybe ManagedNatSmallOperation)
                (managed_small_nat_div_operation fuel id natural boolean less subtract annotation body)
                (fun (operation : Maybe ManagedNatSmallOperation) => match operation with
                  | Nothing => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Nothing ManagedNatSmallOperation)
                  | Just selected => lower_bind Bool (Maybe ManagedNatSmallOperation)
                      (managed_small_nat_arithmetic_dependency compiler fuel subtract True)
                      (fun (subtraction : Bool) => match subtraction with
                        | False => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Nothing ManagedNatSmallOperation)
                        | True => lower_map Bool (Maybe ManagedNatSmallOperation) (fun (comparison : Bool) => match comparison with
                            | True => Just ManagedNatSmallOperation selected | False => Nothing ManagedNatSmallOperation end)
                            (managed_small_nat_less_dependency compiler fuel natural boolean less) end) end) end end) end;

def managed_small_nat_recognize (compiler : ManagedCompiler) (fuel : Nat) (id : Nat)
    (annotation : CoreTerm) (body : CoreTerm) : Either NativeLowerError (Maybe ManagedNatSmallOperation) :=
    match managed_nat_type_parts annotation with
    | Nothing => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Nothing ManagedNatSmallOperation)
    | Just parts => match parts with | MkPair natural result =>
        match managed_nat_registered(managed_compiler_entries compiler, PrimitiveNatRole) with
        | Nothing => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Nothing ManagedNatSmallOperation)
        | Just registered => match andb(eqNat registered natural, eqNat natural result) with
            | False => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Nothing ManagedNatSmallOperation)
            | True => lower_bind Bool (Maybe ManagedNatSmallOperation)
                (managed_small_nat_mul_candidate compiler fuel id natural annotation body)
                (fun (multiplication : Bool) => match multiplication with
                  | True => Right(NativeLowerError, Maybe ManagedNatSmallOperation, Just ManagedNatSmallOperation ManagedNatSmallMultiply)
                  | False => managed_small_nat_div_recognize compiler fuel id natural annotation body end)
            end end end end;
