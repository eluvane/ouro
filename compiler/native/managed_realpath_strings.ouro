-- Canonical paths strip the exact extended prefix and replace ASCII '\'.
-- The UTF-8 payload otherwise stays byte-for-byte unchanged.
import "managed_realpath_memory.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "codegen_model.ouro",
  "managed_model.ouro",
  "pe_model.ouro",
  "lower_model.ouro",
  "../file_check_environment.ouro",
  "../file_check_model.ouro",
  "../primitive_model.ouro",
  "../pipeline_abi.ouro",
  "managed_strings.ouro",
  "lower_loop.ouro",
  "managed_files_memory.ouro",
  "managed_startup_memory.ouro",
  "managed_string_ops.ouro";

def managed_realpath_int_max : MirValue :=
    MirBits(MirUSize, X64Words64(X64Bytes32 255 255 255 127, codegen_zero));

def managed_realpath_prefix (source : MirValue) (bytes : MirValue) (prefix : List Nat)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_compare MirGreaterEqual bytes (managed_bits(MirUSize, length Nat prefix)) state)
      (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits next =>
        managed_string_choose MirU8 fits
          ((fix compare (pending : List Nat) (offset : Nat) (equal : MirValue) (current : ManagedState)
              : Either NativeLowerError ManagedResult :=
            match pending with | Nil => Right NativeLowerError ManagedResult (ManagedResultOf equal current)
            | Cons byte rest => lower_bind ManagedResult ManagedResult (managed_load MirU8 source offset current)
                (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf actual after =>
                  lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual (managed_bits MirU8 byte) after)
                    (fun (tested : ManagedResult) => match tested with | ManagedResultOf same final =>
                      lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd equal same final)
                        (fun (combined : ManagedResult) => match combined with | ManagedResultOf all finished =>
                          compare rest (S offset) all finished end) end) end) end)
            prefix 0 (managed_bits MirU8 1))
          (fun (short : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf(managed_bits MirU8 0, short))) next end);

def managed_realpath_copy (source : MirValue) (first : MirValue) (target : MirValue)
    (start : MirValue) (bytes : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind (Pair Nat ManagedState) ManagedState (managed_fresh_local MirUSize state)
      (fun (cell : Pair Nat ManagedState) => match cell with | MkPair index allocated =>
        let initialized : ManagedState := managed_emit(MirMove(index, managed_bits MirUSize 0), allocated) in
        lower_bind LowerLoopBlocks ManagedState (lower_loop_blocks (managed_flow initialized))
          (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
            lower_bind ManagedResult ManagedState (managed_compare MirLess (MirUse index) bytes
              (managed_with_flow(initialized, lower_switch_block header (MirJump header) flow)))
              (fun (tested : ManagedResult) => match tested with | ManagedResultOf running next =>
                lower_bind ManagedResult ManagedState (managed_binary MirUSize MirAdd first (MirUse index)
                  (managed_switch_block body (MirBranch running body finish) next))
                  (fun (located : ManagedResult) => match located with | ManagedResultOf offset after =>
                    lower_bind ManagedResult ManagedState
                      (managed_fresh MirU8 (fun (local : Nat) => MirLoadAt local source offset) after)
                      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf byte current =>
                        lower_bind ManagedResult ManagedState (managed_compare MirEqual byte (managed_bits MirU8 92) current)
                          (fun (checked : ManagedResult) => match checked with | ManagedResultOf slash selected =>
                            lower_bind ManagedResult ManagedState (managed_string_choose MirU8 slash
                              (fun (yes : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf(managed_bits MirU8 47, yes)))
                              (fun (no : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf byte no)) selected)
                              (fun (mapped : ManagedResult) => match mapped with | ManagedResultOf value ready =>
                                lower_bind ManagedResult ManagedState (managed_binary MirUSize MirAdd start (MirUse index) ready)
                                  (fun (at_target : ManagedResult) => match at_target with | ManagedResultOf destination final =>
                                    Right NativeLowerError ManagedState (managed_switch_block finish (MirJump header)
                                      (managed_emit_all ([MirStoreAt target destination value,
                                        MirBinaryOp(index, MirAdd, MirUse index, managed_bits MirUSize 1)] : List MirInstruction) final))
                                    end) end) end) end) end) end) end) end);

def managed_realpath_normalize_from (compiler : ManagedCompiler) (source : MirValue) (bytes : MirValue)
    (skip : Nat) (prefix : Nat) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirSub bytes (managed_bits MirUSize skip) state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf remaining next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd remaining (managed_bits MirUSize prefix) next)
          (fun (lengthened : ManagedResult) => match lengthened with | ManagedResultOf count after =>
            lower_bind ManagedResult ManagedResult (managed_string_allocate compiler count after)
              (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf value final =>
                let initialized : ManagedState := match eqNat prefix 2 with | False => final
                  | True => managed_emit_all ([MirStore(value, codegen_disp 40, managed_bits MirU8 47),
                      MirStore(value, codegen_disp 41, managed_bits MirU8 47)] : List MirInstruction) final end in
                lower_map ManagedState ManagedResult (fun (finished : ManagedState) => ManagedResultOf value finished)
                  (managed_realpath_copy source (managed_bits MirUSize skip) value
                    (managed_bits(MirUSize, add 40 prefix)) remaining initialized) end) end) end);

-- Prefix probes guard every fixed-offset load, including empty and short
-- inputs. UNC matching is case-sensitive, as in the retained C contract.
def managed_realpath_normalize (compiler : ManagedCompiler) (source : MirValue) (bytes : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_realpath_prefix source bytes ([92,92,63,92,85,78,67,92] : List Nat) state)
      (fun (tested : ManagedResult) => match tested with | ManagedResultOf unc next =>
        managed_string_choose MirManagedPtr unc (managed_realpath_normalize_from compiler source bytes 8 2)
          (fun (ordinary : ManagedState) => lower_bind ManagedResult ManagedResult
            (managed_realpath_prefix source bytes ([92,92,63,92] : List Nat) ordinary)
            (fun (checked : ManagedResult) => match checked with | ManagedResultOf extended after =>
              managed_string_choose MirManagedPtr extended (managed_realpath_normalize_from compiler source bytes 4 0)
                (managed_realpath_normalize_from compiler source bytes 0 0) after end)) next end);

def managed_realpath_string_complete (compiler : ManagedCompiler) (scope : ManagedFileScope)
    (source : MirValue) (bytes : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf actual next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual bytes next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf exact after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope exact after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_realpath_normalize compiler source bytes checked)
                (fun (normalized : ManagedResult) => match normalized with | ManagedResultOf value finished =>
                  managed_file_complete compiler scope value finished end)) end) end);

def managed_realpath_string_fill (compiler : ManagedCompiler) (wide : MirValue) (units : MirValue)
    (count : MirValue) (bytes : MirValue) (buffer : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_realpath_call compiler ManagedRealpathFromWide
      ([wide, units, buffer, bytes, count] : List MirValue) state)
      (fun (filled : ManagedResult) => match filled with | ManagedResultOf status next =>
        lower_bind ManagedState ManagedResult (managed_file_status compiler scope status next)
          (managed_realpath_string_complete compiler scope buffer bytes count) end);

def managed_realpath_string (compiler : ManagedCompiler) (scope : ManagedFileScope)
    (wide : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_realpath_call compiler ManagedRealpathFromWide
      ([wide, units, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) state)
      (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
        lower_bind ManagedState ManagedResult (managed_file_status compiler scope status next)
          (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_startup_count count checked)
            (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes after =>
              lower_bind ManagedResult ManagedResult (managed_compare MirGreater bytes (managed_bits MirUSize 0) after)
                (fun (tested : ManagedResult) => match tested with | ManagedResultOf positive final =>
                  lower_bind ManagedState ManagedResult (managed_file_require compiler scope positive final)
                    (fun (nonempty : ManagedState) => lower_bind ManagedResult ManagedResult
                      (managed_compare MirLessEqual bytes managed_realpath_int_max nonempty)
                      (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits ready =>
                        lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits ready)
                          (managed_file_buffer compiler scope bytes
                            (managed_realpath_string_fill compiler wide units count bytes)) end)) end) end)) end);
