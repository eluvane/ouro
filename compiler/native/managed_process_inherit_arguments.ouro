-- Argument staging happens before job creation. The shared cleanup is
-- sufficient here; the raw inherited push retains typed conversion errors.
import "managed_process_arguments.ouro";

def managed_process_inherit_push (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (value : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    managed_process_stage_value ManagedProcessInheritPush compiler owner scope value state;

def managed_process_inherit_arguments (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (arguments : MirValue) (state : ManagedState) : Either NativeLowerError ManagedState :=
    managed_process_arguments_with ManagedProcessInheritPush compiler owner scope arguments state;
