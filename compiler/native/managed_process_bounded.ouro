-- Construction captures executable, argv, stdin and limits. Each execution
-- acquires a fresh owner; first-class and partial application remain deferred.
import "managed_process_bounded_result.ouro";

def managed_process_bounded_action (compiler : ManagedCompiler) (executable : MirValue) (arguments : MirValue)
    (request : MirValue) (action_state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_action compiler ([executable, arguments, request] : List MirValue)
      (fun (captures : List MirValue) (entered : ManagedState) =>
        match captures with | Cons first rest => match rest with | Cons second last =>
          lower_bind MirValue ManagedResult (lower_single MirValue last)
            (fun (third : MirValue) => managed_process_bounded_body compiler first second third entered)
          | Nil => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end
        | Nil => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end) action_state;

def managed_process_bounded_limits_value (compiler : ManagedCompiler) (executable : MirValue) (arguments : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_load MirManagedPtr (MirUse 0) 40 (managed_with_flow reserved (lower_empty_state 2)))
          (fun (first : ManagedResult) => match first with | ManagedResultOf name next =>
            lower_bind ManagedResult ManagedResult (managed_load MirManagedPtr (MirUse 0) 48 next)
              (fun (second : ManagedResult) => match second with | ManagedResultOf fields entered =>
                lower_bind ManagedResult ManagedResult (managed_process_bounded_action compiler name fields (MirUse 1) entered)
                  (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf action after =>
                    let function : MirFunction := managed_finish_function symbol
                      ([112,114,111,99,101,115,115,95,99,97,112,116,117,114,101,95,114,101,113,117,101,115,116] : List Nat)
                      ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) action after in
                    managed_emit_callable compiler 3 symbol False ([executable, arguments] : List MirValue)
                      (managed_with_flow (managed_add_function function after) caller) end) end) end) end);

def managed_process_bounded_arguments_value (compiler : ManagedCompiler) (executable : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_load MirManagedPtr (MirUse 0) 40 (managed_with_flow reserved (lower_empty_state 2)))
          (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf name entered =>
            lower_bind ManagedResult ManagedResult (managed_process_bounded_limits_value compiler name (MirUse 1) entered)
              (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value after =>
                let function : MirFunction := managed_finish_function symbol
                  ([112,114,111,99,101,115,115,95,99,97,112,116,117,114,101,95,97,114,103,117,109,101,110,116,115] : List Nat)
                  ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) value after in
                managed_emit_callable compiler 3 symbol False ([executable] : List MirValue)
                  (managed_with_flow (managed_add_function function after) caller) end) end) end);

def managed_process_bounded_value (compiler : ManagedCompiler) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_process_bounded_arguments_value compiler (MirUse 1) (managed_with_flow reserved (lower_empty_state 2)))
          (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value after =>
            let function : MirFunction := managed_finish_function symbol
              ([112,114,111,99,101,115,115,95,99,97,112,116,117,114,101,95,101,120,101,99,117,116,97,98,108,101] : List Nat)
              ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) value after in
            managed_emit_callable compiler 3 symbol False ([] : List MirValue)
              (managed_with_flow (managed_add_function function after) caller) end) end);

def managed_process_bounded_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (arguments : List CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedFields ManagedResult (managed_arguments compiler step scope arguments state)
      (fun (supplied : ManagedFields) => match supplied with | ManagedFieldsOf values next =>
        match values with
        | Nil => managed_process_bounded_value compiler next
        | Cons executable rest => match rest with
          | Nil => managed_process_bounded_arguments_value compiler executable next
          | Cons argv_value last => match last with
            | Nil => managed_process_bounded_limits_value compiler executable argv_value next
            | Cons request extra => match extra with
              | Nil => managed_process_bounded_action compiler executable argv_value request next
              | Cons _ _ => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end end end end end);
