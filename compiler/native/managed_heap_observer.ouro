-- Capture accounting before Nat/Maybe boxing, only when the Runtime action runs.
import "managed_stdio.ouro",
  "managed_runtime_symbols.ouro",
  "managed_actions.ouro",
  "managed_nat.ouro";

def managed_heap_observer_name : List Nat :=
    managed_runtime_symbol "raw_managed_allocated_requested_bytes";

def managed_heap_observer_expected (compiler : ManagedCompiler) : Either NativeLowerError CoreTerm :=
    let bindings : List PrimitiveResolved := primitive_environment (managed_compiler_entries compiler) in
    lower_from_primitive CoreTerm (CSort 0)
      (primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRuntimeType bindings) (fun (runtime : CoreTerm) =>
        primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveRawPtrType bindings) (fun (pointer : CoreTerm) =>
          primitive_bind CoreTerm CoreTerm (primitive_type_ref PrimitiveU8Type bindings) (fun (byte : CoreTerm) =>
            primitive_map CoreTerm CoreTerm (fun (word : CoreTerm) => CPi(CApp pointer byte, CApp runtime word))
              (primitive_type_ref PrimitiveUSizeType bindings)))));

def managed_heap_observer_roots (compiler : ManagedCompiler) (fuel : Nat)
    : Either NativeLowerError (List Nat) :=
    match managed_stdio_has compiler PrimitiveManagedAllocatedRequestedBytes with
    | False => Right(NativeLowerError, List Nat, [] : List Nat)
    | True => lower_bind CoreTerm (List Nat) (managed_heap_observer_expected compiler) (fun (expected : CoreTerm) =>
        lower_map Nat (List Nat) (fun (id : Nat) => ([id] : List Nat))
          (managed_runtime_definition compiler fuel managed_heap_observer_name expected)) end;

def managed_heap_observer_body (compiler : ManagedCompiler) (query : Nat)
    (family : Nat) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_fresh MirRawPtr (fun (local : Nat) => MirManagedContext local) state)
      (fun (context : ManagedResult) => match context with | ManagedResultOf pointer next =>
        lower_bind ManagedResult ManagedResult
          (managed_fresh MirUSize (fun (local : Nat) => MirCall MirNoGc (Just Nat local)
            (MirDirect query) ([pointer] : List MirValue)) next)
          (fun (sample : ManagedResult) => match sample with | ManagedResultOf bytes after =>
            lower_bind ManagedResult ManagedResult
              (managed_nat_from_word compiler PrimitiveWordUSize bytes after)
              (fun (boxed : ManagedResult) => match boxed with | ManagedResultOf natural ready =>
                managed_constructor compiler family (managed_bits MirUSize 1) ([natural] : List MirValue) ready
              end) end) end);

def managed_heap_observer_action (compiler : ManagedCompiler) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (managed_heap_observer_expected compiler) (fun (expected : CoreTerm) =>
      lower_bind LowerContract ManagedResult
        (managed_runtime_contract compiler primitive_default_fuel managed_heap_observer_name expected)
        (fun (contract : LowerContract) =>
          lower_bind Nat ManagedResult (lower_role_identity(managed_compiler_entries compiler, PrimitiveMaybeRole))
            (fun (family : Nat) => managed_action compiler ([] : List MirValue)
              (fun (_captures : List MirValue) (entered : ManagedState) =>
                managed_heap_observer_body compiler (lower_contract_id contract) family entered) state)));

def managed_heap_observer_primitive (compiler : ManagedCompiler) (arguments : List CoreTerm)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Unit ManagedResult (lower_require(nullb CoreTerm arguments, LowerInvalidCall 0))
      (fun (_ : Unit) => managed_heap_observer_action compiler state);
