-- Output pages are raw byte arrays, never text. Allocate managed strings
-- before copying and retain both strings and their pair through cleanup.
import "managed_process_arguments.ouro";
import "managed_model.ouro";
import "mir_model.ouro";
import "x64.ouro";
import "pe_model.ouro";
import "managed_files_memory.ouro";
import "lower_model.ouro";
import "codegen_model.ouro";
import "../primitive_model.ouro";
import "../file_check_model.ouro";
import "../pipeline_abi.ouro";
import "managed_process_memory.ouro";
import "managed_strings.ouro";
import "lower_constants.ouro";
import "managed_nat.ouro";
import "managed_stdio.ouro";
import "managed_string_ops.ouro";
import "lower_types.ouro";

def managed_process_string (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (offset : Nat) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirUSize owner (add offset 8) state)
      (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd bytes (managed_bits MirUSize 47) next)
          (fun (added : ManagedResult) => match added with | ManagedResultOf total after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirGreaterEqual total bytes after)
              (fun (tested : ManagedResult) => match tested with | ManagedResultOf fits bounded =>
                lower_bind ManagedState ManagedResult (managed_process_require compiler owner scope fits bounded)
                  (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_string_allocate compiler bytes checked)
                    (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf value entered =>
                      lower_bind ManagedResult ManagedResult (managed_load MirUSize owner offset entered)
                        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bits located =>
                          lower_bind ManagedResult ManagedResult (managed_convert MirRawPtr MirRawFromBits bits located)
                            (fun (cast : ManagedResult) => match cast with | ManagedResultOf source copied =>
                              lower_map ManagedState ManagedResult (fun (finished : ManagedState) => ManagedResultOf value finished)
                                (managed_bytes_copy source (managed_bits MirUSize 0) value (managed_bits MirUSize 40) bytes copied) end) end) end)) end) end) end);

def managed_process_pair (compiler : ManagedCompiler) (first : MirValue) (second : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitivePairRole)
      (fun (family : Nat) => managed_constructor compiler family (managed_bits MirUSize 0)
        ([first, second] : List MirValue) state);

def managed_process_result (compiler : ManagedCompiler) (owner : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_process_string compiler owner scope 64 state)
      (fun (output : ManagedResult) => match output with | ManagedResultOf stdout next =>
        lower_bind ManagedResult ManagedResult (managed_load MirUSize owner 104 next)
          (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf error after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirEqual error (managed_bits MirUSize 0) after)
              (fun (tested : ManagedResult) => match tested with | ManagedResultOf launched entered =>
                lower_bind ManagedResult ManagedResult
                  (managed_string_choose MirManagedPtr launched (managed_process_string compiler owner scope 80)
                    (managed_string_literal compiler ([112,114,111,99,101,115,115,32,115,101,116,117,112,32,111,114,32,108,97,117,110,99,104,32,102,97,105,108,101,100,32,40,87,105,110,51,50,41] : List Nat)) entered)
                  (fun (errors : ManagedResult) => match errors with | ManagedResultOf stderr selected =>
                    lower_bind ManagedResult ManagedResult (managed_process_pair compiler stdout stderr selected)
                      (fun (streams : ManagedResult) => match streams with | ManagedResultOf pair paired =>
                        lower_bind ManagedResult ManagedResult (managed_load MirU32 owner 96 paired)
                          (fun (status : ManagedResult) => match status with | ManagedResultOf code counted =>
                            lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordU32 code counted)
                              (fun (natural : ManagedResult) => match natural with | ManagedResultOf number boxed =>
                                lower_bind ManagedResult ManagedResult (managed_process_pair compiler number pair boxed)
                                  (fun (result : ManagedResult) => match result with | ManagedResultOf value constructed =>
                                    lower_bind ManagedResult ManagedResult (managed_process_cleanup compiler owner scope constructed)
                                      (fun (cleaned : ManagedResult) => match cleaned with | ManagedResultOf okay released =>
                                        lower_bind Nat ManagedResult (managed_stdio_exit_symbol compiler)
                                          (fun (exit : Nat) => lower_map ManagedState ManagedResult
                                            (fun (finished : ManagedState) => ManagedResultOf value finished)
                                            (managed_stdio_require exit okay released)) end) end) end) end) end) end) end) end) end);

def managed_process_owned (compiler : ManagedCompiler) (executable : MirValue) (arguments : MirValue)
    (owner : MirValue) (scope : ManagedFileScope) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (managed_process_push compiler owner scope executable state)
      (fun (pushed : ManagedState) => lower_bind ManagedState ManagedResult (managed_process_arguments compiler owner scope arguments pushed)
        (fun (supplied : ManagedState) => lower_bind ManagedResult ManagedResult
          (managed_process_call compiler ManagedProcessRun ([owner] : List MirValue) supplied)
          (fun (ran : ManagedResult) => match ran with | ManagedResultOf status after =>
            lower_bind ManagedState ManagedResult (managed_process_status compiler owner scope status after)
              (managed_process_result compiler owner scope) end)));

def managed_process_body (compiler : ManagedCompiler) (executable : MirValue) (arguments : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_file_buffer compiler (ManagedFileScopeOf ([] : List MirValue) (Nothing MirValue))
      (managed_bits MirUSize 128) (managed_process_owned compiler executable arguments) state;
