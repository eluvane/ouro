-- Construction and aliases capture the path. Every invocation probes and,
-- for listing, enumerates again; previous results remain ordinary GC values.
import "managed_directories_path.ouro";

def managed_directory_operation (primitive : PrimitiveId) : Maybe Bool :=
    match primitive_id_equal primitive PrimitiveDirectoryList with | True => Just Bool False | False =>
      match primitive_id_equal primitive PrimitiveDirectoryListable with | True => Just Bool True
      | False => Nothing Bool end end;

def managed_directory_action (compiler : ManagedCompiler) (listable : Bool) (path : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_action compiler ([path] : List MirValue)
      (fun (values : List MirValue) (entered : ManagedState) =>
        lower_bind MirValue ManagedResult (lower_single MirValue values)
          (fun (name : MirValue) => managed_directory_body compiler listable name entered)) state;

def managed_directory_value (compiler : ManagedCompiler) (listable : Bool) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_directory_action compiler listable (MirUse 1) (managed_with_flow reserved (lower_empty_state 2)))
          (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value after =>
            let function : MirFunction := managed_finish_function symbol
              ([111,117,114,111,95,100,105,114,101,99,116,111,114,121,95,112,97,116,104] : List Nat)
              ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) value after in
            managed_emit_callable compiler 3 symbol False ([] : List MirValue)
              (managed_with_flow (managed_add_function function after) caller) end) end);

def managed_directory_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (listable : Bool) (arguments : List CoreTerm) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (lower_single CoreTerm arguments)
      (fun (path : CoreTerm) => lower_bind ManagedResult ManagedResult (step scope path state)
        (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value next =>
          managed_directory_action compiler listable value next end));
