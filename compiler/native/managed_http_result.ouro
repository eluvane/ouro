import "managed_http_text.ouro";
import "managed_string_decimal.ouro";
import "managed_string_lists.ouro";

def managed_http_pair (compiler : ManagedCompiler) (code : MirValue) (body : MirValue) (reason : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitivePairRole) (fun (family : Nat) => lower_bind ManagedResult ManagedResult (managed_constructor compiler family (managed_bits MirUSize 0) ([body, reason] : List MirValue) state) (fun (result : ManagedResult) => match result with | ManagedResultOf inner next =>
let state : ManagedState := next in
managed_constructor compiler family (managed_bits MirUSize 0) ([code, inner] : List MirValue) next end));

def managed_http_failure (compiler : ManagedCompiler) (ctx : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirU32 ctx 44 state) (fun (result : ManagedResult) => match result with | ManagedResultOf error next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordU32 error next) (fun (result : ManagedResult) => match result with | ManagedResultOf natural next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_of_nat_value compiler natural next) (fun (result : ManagedResult) => match result with | ManagedResultOf number next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_literal compiler ([87,105,110,72,84,84,80,32,101,114,114,111,114,32] : List Nat) next) (fun (result : ManagedResult) => match result with | ManagedResultOf prefix next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_concat_values compiler prefix number next) (fun (result : ManagedResult) => match result with | ManagedResultOf reason next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_allocate compiler (managed_bits MirUSize 0) next) (fun (result : ManagedResult) => match result with | ManagedResultOf empty next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordU32 (managed_bits MirU32 0) next) (fun (result : ManagedResult) => match result with | ManagedResultOf zero next =>
let state : ManagedState := next in
managed_http_pair compiler zero empty reason next end) end) end) end) end) end) end);

def managed_http_copy_step (compiler : ManagedCompiler) (scope : ManagedHttpScope) (total : MirValue) (value : MirValue) (node : Nat) (offset : Nat)
    (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_convert MirRawPtr MirRawFromBits (MirUse node) state) (fun (result : ManagedResult) => match result with | ManagedResultOf page next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedState (managed_load MirUSize page 8 next) (fun (result : ManagedResult) => match result with | ManagedResultOf count next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedState (managed_binary MirUSize MirSub total (MirUse offset) next) (fun (result : ManagedResult) => match result with | ManagedResultOf remaining next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedState (managed_compare MirLessEqual count remaining next) (fun (result : ManagedResult) => match result with | ManagedResultOf fits next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedState (managed_http_require compiler scope fits next) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedState (managed_binary MirUSize MirAdd (MirUse offset) (managed_bits MirUSize 40) next) (fun (result : ManagedResult) => match result with | ManagedResultOf at next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedState (managed_bytes_copy page (managed_bits MirUSize 16) value at count next) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedState (managed_load MirUSize page 0 next) (fun (result : ManagedResult) => match result with | ManagedResultOf following next =>
let state : ManagedState := next in
Right NativeLowerError ManagedState (managed_emit_all ([MirMove node following, MirBinaryOp offset MirAdd (MirUse offset) count] : List MirInstruction) next) end)) end)) end) end) end) end);

def managed_http_copy_body (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue)
    (total : MirValue) (value : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirUSize ctx 24 state)
      (fun (head : ManagedResult) => match head with | ManagedResultOf first next =>
let state : ManagedState := next in
        lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirUSize next)
          (fun (node_cell : Pair Nat ManagedState) => match node_cell with | MkPair node after =>
            lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirUSize after)
              (fun (offset_cell : Pair Nat ManagedState) => match offset_cell with | MkPair offset entered =>
                let initialized : ManagedState := managed_emit_all
                  ([MirMove node first, MirMove offset (managed_bits MirUSize 0)] : List MirInstruction) entered in
                lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
                  (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                    lower_bind ManagedResult ManagedResult
                      (managed_compare MirNotEqual (MirUse node) (managed_bits MirUSize 0)
                        (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                      (fun (tested : ManagedResult) => match tested with | ManagedResultOf running checked =>
                        lower_bind ManagedState ManagedResult
                          (managed_http_copy_step compiler scope total value node offset
                            (managed_switch_block body (MirBranch running body finish) checked))
                          (fun (copied : ManagedState) => lower_bind ManagedResult ManagedResult
                            (managed_compare MirEqual (MirUse offset) total (managed_switch_block finish (MirJump header) copied))
                            (fun (complete : ManagedResult) => match complete with | ManagedResultOf exact final =>
                              lower_map ManagedState ManagedResult (fun (done : ManagedState) => ManagedResultOf value done)
                                (managed_http_require compiler scope exact final) end)) end) end) end) end) end);

def managed_http_success (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirUSize ctx 32 state) (fun (result : ManagedResult) => match result with | ManagedResultOf total next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_allocate compiler total next) (fun (result : ManagedResult) => match result with | ManagedResultOf body next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_http_copy_body compiler scope ctx total body next) (fun (result : ManagedResult) => match result with | ManagedResultOf body next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_load MirU32 ctx 40 next) (fun (result : ManagedResult) => match result with | ManagedResultOf status next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordU32 status next) (fun (result : ManagedResult) => match result with | ManagedResultOf code next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_allocate compiler (managed_bits MirUSize 0) next) (fun (result : ManagedResult) => match result with | ManagedResultOf empty next =>
let state : ManagedState := next in
managed_http_pair compiler code body empty next end) end) end) end) end) end);

def managed_http_finish (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue) (status : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual status (managed_bits MirU32 1) state) (fun (result : ManagedResult) => match result with | ManagedResultOf valid next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedResult (managed_http_require compiler scope valid state) (fun (next : ManagedState) =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_startup_zero status next) (fun (result : ManagedResult) => match result with | ManagedResultOf success next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_string_choose MirManagedPtr success (managed_http_success compiler scope ctx) (managed_http_failure compiler ctx) next) (fun (result : ManagedResult) => match result with | ManagedResultOf value next =>
let state : ManagedState := next in
lower_bind ManagedResult ManagedResult (managed_http_call compiler ManagedHttpClose ([ctx] : List MirValue) next) (fun (result : ManagedResult) => match result with | ManagedResultOf closed next =>
let state : ManagedState := next in
lower_bind ManagedState ManagedResult (managed_http_status compiler scope closed next) (fun (next : ManagedState) =>
let state : ManagedState := next in
Right NativeLowerError ManagedResult (ManagedResultOf value next)) end) end) end)) end);
