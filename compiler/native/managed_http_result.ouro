import "managed_http_text.ouro";
import "managed_string_decimal.ouro";
import "managed_string_lists.ouro";

def managed_http_pair (compiler : ManagedCompiler) (code : MirValue) (body : MirValue) (reason : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitivePairRole) (fun (family : Nat) => lower_bind ManagedResult ManagedResult (managed_constructor compiler family (managed_bits MirUSize 0) ([body, reason] : List MirValue) start) (fun (result : ManagedResult) => match result with | ManagedResultOf inner next =>
managed_constructor compiler family (managed_bits MirUSize 0) ([code, inner] : List MirValue) next end));

def managed_http_failure (compiler : ManagedCompiler) (ctx : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirU32 ctx 44 start)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf error after_error =>
        lower_bind ManagedResult ManagedResult (managed_nat_from_word compiler PrimitiveWordU32 error after_error)
          (fun (as_nat : ManagedResult) => match as_nat with | ManagedResultOf natural after_nat =>
            lower_bind ManagedResult ManagedResult (managed_string_of_nat_value compiler natural after_nat)
              (fun (as_text : ManagedResult) => match as_text with | ManagedResultOf number after_text =>
                lower_bind ManagedResult ManagedResult
                  (managed_string_literal compiler ([87,105,110,72,84,84,80,32,101,114,114,111,114,32] : List Nat) after_text)
                  (fun (as_prefix : ManagedResult) => match as_prefix with | ManagedResultOf prefix after_prefix =>
                    lower_bind ManagedResult ManagedResult (managed_string_concat_values compiler prefix number after_prefix)
                      (fun (as_reason : ManagedResult) => match as_reason with | ManagedResultOf reason after_reason =>
                        lower_bind ManagedResult ManagedResult
                          (managed_string_allocate compiler (managed_bits MirUSize 0) after_reason)
                          (fun (as_empty : ManagedResult) => match as_empty with | ManagedResultOf empty after_empty =>
                            lower_bind ManagedResult ManagedResult
                              (managed_nat_from_word compiler PrimitiveWordU32 (managed_bits MirU32 0) after_empty)
                              (fun (as_zero : ManagedResult) => match as_zero with | ManagedResultOf zero after_zero =>
                                managed_http_pair compiler zero empty reason after_zero end) end) end) end) end) end) end);

def managed_http_copy_step (compiler : ManagedCompiler) (scope : ManagedHttpScope) (total : MirValue) (value : MirValue) (node : Nat) (offset : Nat)
    (start : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_convert MirRawPtr MirRawFromBits (MirUse node) start)
      (fun (as_page : ManagedResult) => match as_page with | ManagedResultOf page after_page =>
        lower_bind ManagedResult ManagedState (managed_load MirUSize page 8 after_page)
          (fun (as_count : ManagedResult) => match as_count with | ManagedResultOf count after_count =>
            lower_bind ManagedResult ManagedState (managed_binary MirUSize MirSub total (MirUse offset) after_count)
              (fun (as_left : ManagedResult) => match as_left with | ManagedResultOf remaining after_left =>
                lower_bind ManagedResult ManagedState (managed_compare MirLessEqual count remaining after_left)
                  (fun (as_fits : ManagedResult) => match as_fits with | ManagedResultOf fits after_fits =>
                    lower_bind ManagedState ManagedState (managed_http_require compiler scope fits after_fits)
                      (fun (required : ManagedState) =>
                        lower_bind ManagedResult ManagedState
                          (managed_binary MirUSize MirAdd (MirUse offset) (managed_bits MirUSize 40) required)
                          (fun (as_at : ManagedResult) => match as_at with | ManagedResultOf at after_at =>
                            lower_bind ManagedState ManagedState
                              (managed_bytes_copy page (managed_bits MirUSize 16) value at count after_at)
                              (fun (copied : ManagedState) =>
                                lower_bind ManagedResult ManagedState (managed_load MirUSize page 0 copied)
                                  (fun (as_next : ManagedResult) => match as_next with | ManagedResultOf following after_follow =>
                                    Right NativeLowerError ManagedState
                                      (managed_emit_all
                                        ([MirMove node following, MirBinaryOp offset MirAdd (MirUse offset) count]
                                          : List MirInstruction) after_follow) end) end) end) end) end) end);

def managed_http_copy_body (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue)
    (total : MirValue) (value : MirValue) (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirUSize ctx 24 start)
      (fun (head : ManagedResult) => match head with | ManagedResultOf first next =>
        lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirUSize next)
          (fun (node_cell : Pair Nat ManagedState) => match node_cell with | MkPair node after =>
            lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirUSize after)
              (fun (offset_cell : Pair Nat ManagedState) => match offset_cell with | MkPair offset entered =>
                let initialized : ManagedState := managed_emit_all
                  ([MirMove node first, MirMove offset (managed_bits MirUSize 0)] : List MirInstruction) entered in
                lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
                  (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                    lower_bind ManagedResult ManagedResult
                      (managed_compare MirNotEqual (MirUse node) (managed_bits MirUSize 0)
                        (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                      (fun (tested : ManagedResult) => match tested with | ManagedResultOf running checked =>
                        lower_bind ManagedState ManagedResult
                          (managed_http_copy_step compiler scope total value node offset
                            (managed_switch_block body (MirBranch running body finish) checked))
                          (fun (copied : ManagedState) => lower_bind ManagedResult ManagedResult
                            (managed_compare MirEqual (MirUse offset) total (managed_switch_block finish (MirJump header) copied))
                            (fun (complete : ManagedResult) => match complete with | ManagedResultOf exact final =>
                              lower_map ManagedState ManagedResult (fun (done : ManagedState) => ManagedResultOf value done)
                                (managed_http_require compiler scope exact final) end)) end) end) end) end) end);

def managed_http_success (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirUSize ctx 32 start)
      (fun (as_total : ManagedResult) => match as_total with | ManagedResultOf total after_total =>
        lower_bind ManagedResult ManagedResult (managed_string_allocate compiler total after_total)
          (fun (as_body : ManagedResult) => match as_body with | ManagedResultOf body after_body =>
            lower_bind ManagedResult ManagedResult (managed_http_copy_body compiler scope ctx total body after_body)
              (fun (as_copied : ManagedResult) => match as_copied with | ManagedResultOf filled after_copy =>
                lower_bind ManagedResult ManagedResult (managed_load MirU32 ctx 40 after_copy)
                  (fun (as_status : ManagedResult) => match as_status with | ManagedResultOf status after_status =>
                    lower_bind ManagedResult ManagedResult
                      (managed_nat_from_word compiler PrimitiveWordU32 status after_status)
                      (fun (as_code : ManagedResult) => match as_code with | ManagedResultOf code after_code =>
                        lower_bind ManagedResult ManagedResult
                          (managed_string_allocate compiler (managed_bits MirUSize 0) after_code)
                          (fun (as_empty : ManagedResult) => match as_empty with | ManagedResultOf empty after_empty =>
                            managed_http_pair compiler code filled empty after_empty end) end) end) end) end) end);

def managed_http_finish (compiler : ManagedCompiler) (scope : ManagedHttpScope) (ctx : MirValue) (status : MirValue)
    (start : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual status (managed_bits MirU32 1) start)
      (fun (as_valid : ManagedResult) => match as_valid with | ManagedResultOf valid after_valid =>
        lower_bind ManagedState ManagedResult (managed_http_require compiler scope valid after_valid)
          (fun (required : ManagedState) =>
            lower_bind ManagedResult ManagedResult (managed_startup_zero status required)
              (fun (as_ok : ManagedResult) => match as_ok with | ManagedResultOf success after_ok =>
                lower_bind ManagedResult ManagedResult
                  (managed_string_choose MirManagedPtr success
                    (managed_http_success compiler scope ctx) (managed_http_failure compiler ctx) after_ok)
                  (fun (as_value : ManagedResult) => match as_value with | ManagedResultOf value after_value =>
                    lower_bind ManagedResult ManagedResult
                      (managed_http_call compiler ManagedHttpClose ([ctx] : List MirValue) after_value)
                      (fun (as_closed : ManagedResult) => match as_closed with | ManagedResultOf closed after_closed =>
                        lower_bind ManagedState ManagedResult
                          (managed_http_status compiler scope closed after_closed)
                          (fun (finished : ManagedState) =>
                            Right NativeLowerError ManagedResult (ManagedResultOf value finished)) end) end) end)) end);
