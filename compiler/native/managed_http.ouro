-- Applying POST captures three managed arguments. The OS is touched only by
-- running its action, and every invocation acquires a fresh WinHTTP context.
import "managed_http_request.ouro",
  "managed_model.ouro",
  "mir_model.ouro",
  "x64.ouro",
  "pe_model.ouro",
  "lower_model.ouro",
  "codegen_model.ouro",
  "../primitive_model.ouro",
  "../file_check_model.ouro",
  "../pipeline_abi.ouro",
  "managed_actions.ouro",
  "lower_ops.ouro",
  "managed_closures.ouro",
  "../core.ouro";

def managed_http_action (compiler : ManagedCompiler) (url : MirValue) (headers : MirValue)
    (body : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_action compiler ([url, headers, body] : List MirValue)
      (fun (captures : List MirValue) (entered : ManagedState) =>
        match captures with | Cons first rest => match rest with | Cons second last =>
          lower_bind MirValue ManagedResult (lower_single MirValue last)
            (fun (third : MirValue) => managed_http_body compiler first second third entered)
          | Nil => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end
        | Nil => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end) state;

def managed_http_body_value (compiler : ManagedCompiler) (url : MirValue) (headers : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_load(MirManagedPtr, MirUse 0, 40, managed_with_flow(reserved, lower_empty_state 2)))
          (fun (first : ManagedResult) => match first with | ManagedResultOf name next =>
            lower_bind ManagedResult ManagedResult (managed_load MirManagedPtr (MirUse 0) 48 next)
              (fun (second : ManagedResult) => match second with | ManagedResultOf fields entered =>
                lower_bind ManagedResult ManagedResult (managed_http_action compiler name fields (MirUse 1) entered)
                  (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf action after =>
                    let function : MirFunction := managed_finish_function symbol
                      ([104,116,116,112,95,98,111,100,121] : List Nat)
                      ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) action after in
                    managed_emit_callable compiler 3 symbol False ([url, headers] : List MirValue)
                      (managed_with_flow(managed_add_function function after, caller)) end) end) end) end);

def managed_http_headers_value (compiler : ManagedCompiler) (url : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_load(MirManagedPtr, MirUse 0, 40, managed_with_flow(reserved, lower_empty_state 2)))
          (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf name entered =>
            lower_bind ManagedResult ManagedResult (managed_http_body_value compiler name (MirUse 1) entered)
              (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value after =>
                let function : MirFunction := managed_finish_function symbol
                  ([104,116,116,112,95,104,101,97,100,101,114,115] : List Nat)
                  ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) value after in
                managed_emit_callable compiler 3 symbol False ([url] : List MirValue)
                  (managed_with_flow(managed_add_function function after, caller)) end) end) end);

def managed_http_value (compiler : ManagedCompiler) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_http_headers_value(compiler, MirUse 1, managed_with_flow(reserved, lower_empty_state 2)))
          (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf value after =>
            let function : MirFunction := managed_finish_function symbol
              ([104,116,116,112,95,117,114,108] : List Nat)
              ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) value after in
            managed_emit_callable compiler 3 symbol False ([] : List MirValue)
              (managed_with_flow(managed_add_function function after, caller)) end) end);

def managed_http_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (arguments : List CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedFields ManagedResult (managed_arguments compiler step scope arguments state)
      (fun (supplied : ManagedFields) => match supplied with | ManagedFieldsOf values next =>
        match values with
        | Nil => managed_http_value compiler next
        | Cons url rest => match rest with
          | Nil => managed_http_headers_value compiler url next
          | Cons headers last => match last with
            | Nil => managed_http_body_value compiler url headers next
            | Cons body extra => match extra with
              | Nil => managed_http_action compiler url headers body next
              | Cons _ _ => Left NativeLowerError ManagedResult (LowerInvalidCall 0) end end end end end);
