-- Allocate the complete managed destination before acquiring a file. The
-- raw helper encodes the final path before atomic creation; afterwards only
-- bounded copying and cleanup remain. No managed address is sent to Win32.
import "managed_temp_memory.ouro";
import "../../std/types.ouro";
import "../../std/prelude.ouro";
import "x64.ouro";
import "managed_model.ouro";
import "mir_model.ouro";
import "pe_model.ouro";
import "lower_model.ouro";
import "codegen_model.ouro";
import "../file_check_environment.ouro";
import "../file_check_model.ouro";
import "../primitive_model.ouro";
import "../pipeline_abi.ouro";
import "managed_files_memory.ouro";
import "managed_startup_memory.ouro";
import "managed_realpath_strings.ouro";
import "managed_strings.ouro";
import "managed_realpath_memory.ouro";
import "managed_string_ops.ouro";

-- Up to three UTF-8 bytes per UTF-16 unit in the bounded native path.
def managed_temp_path_capacity : Nat := mul 3 (mul 128 native_byte_base);

-- Keep large arena sizes arithmetic so bootstrap C has bounded expressions.
def managed_temp_finish (compiler : ManagedCompiler) (result : MirValue) (storage : MirValue)
    (count : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual bytes (managed_bits MirUSize managed_temp_path_capacity) next)
          (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits after)
              (fun (checked : ManagedState) => lower_bind ManagedState ManagedResult
                (managed_realpath_copy storage (managed_bits MirUSize pe_byte2_place) result (managed_bits MirUSize 40) bytes checked)
                (fun (copied : ManagedState) => managed_file_complete compiler scope result
                  (managed_emit (MirStore result (codegen_disp 32) bytes) copied))) end) end);

def managed_temp_run (compiler : ManagedCompiler) (source : MirValue) (bytes : MirValue)
    (in_directory : Bool) (result : MirValue) (count : MirValue) (storage : MirValue)
    (scope : ManagedFileScope) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_temp_call compiler source bytes in_directory storage count state)
      (fun (called : ManagedResult) => match called with | ManagedResultOf status next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual status (managed_bits MirU32 1) next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf valid after =>
            lower_bind ManagedState ManagedResult (managed_file_require compiler scope valid after)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_startup_zero status checked)
                (fun (zero_test : ManagedResult) => match zero_test with | ManagedResultOf success final =>
                  managed_string_choose MirManagedPtr success
                    (managed_temp_finish compiler result storage count scope)
                    (fun (missing : ManagedState) => managed_file_complete compiler scope result
                      (managed_emit (MirStore result (codegen_disp 32) (managed_bits MirUSize 0)) missing)) final end)) end) end);

def managed_temp_storage (compiler : ManagedCompiler) (source : MirValue) (bytes : MirValue)
    (in_directory : Bool) (result : MirValue) (count : MirValue) (scope : ManagedFileScope)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    managed_file_buffer compiler scope (managed_bits MirUSize (mul 3 pe_byte2_place))
      (managed_temp_run compiler source bytes in_directory result count) state;

def managed_temp_prepare (compiler : ManagedCompiler) (source : MirValue) (bytes : MirValue)
    (in_directory : Bool) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_string_allocate compiler (managed_bits MirUSize managed_temp_path_capacity) state)
      (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf result next =>
        managed_file_buffer compiler scope (managed_bits MirUSize 8)
          (managed_temp_storage compiler source bytes in_directory result) next end);

def managed_temp_copy (compiler : ManagedCompiler) (path : MirValue) (bytes : MirValue)
    (source : MirValue) (scope : ManagedFileScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult
      (managed_bytes_copy path (managed_bits MirUSize 40) source (managed_bits MirUSize 0) bytes state)
      (managed_temp_prepare compiler source bytes True scope);

def managed_temp_body (compiler : ManagedCompiler) (path : Maybe MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let scope : ManagedFileScope := ManagedFileScopeOf ([] : List MirValue) (Nothing MirValue) in
    match path with
    | Nothing => managed_temp_prepare compiler (managed_bits MirRawPtr 0) (managed_bits MirUSize 0) False scope state
    | Just value => lower_bind ManagedResult ManagedResult (managed_string_size compiler value state)
        (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes next =>
          lower_bind ManagedResult ManagedResult (managed_compare MirEqual bytes (managed_bits MirUSize 0) next)
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf empty after =>
              managed_string_choose MirManagedPtr empty (managed_realpath_missing compiler scope)
                (fun (nonempty : ManagedState) => lower_bind ManagedResult ManagedResult
                  (managed_compare MirLessEqual bytes managed_realpath_int_max nonempty)
                  (fun (size_test : ManagedResult) => match size_test with | ManagedResultOf fits checked =>
                    lower_bind ManagedState ManagedResult (managed_file_require compiler scope fits checked)
                      (managed_file_buffer compiler scope bytes (managed_temp_copy compiler value bytes)) end)) after end) end) end;
