-- Search output stays in one fixed caller-owned buffer. Only a successful
-- API call permits reading its bounded filename; no error returns a prefix.
import "managed_directories_memory.ouro";
import "managed_startup_strings.ouro";

def managed_directory_name_capacity : Nat := 1040;

def managed_directory_name_filled (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (buffer : MirValue) (bytes : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf actual next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual actual bytes next)
          (fun (compared : ManagedResult) => match compared with | ManagedResultOf exact after =>
            lower_bind ManagedState ManagedResult (managed_directory_require compiler scope exact after)
              (managed_startup_string_copy compiler buffer bytes) end) end);

def managed_directory_name_sized (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (wide : MirValue) (units : MirValue) (buffer : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bytes next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater bytes (managed_bits MirUSize 0) next)
          (fun (positive : ManagedResult) => match positive with | ManagedResultOf nonempty after =>
            lower_bind ManagedResult ManagedResult
              (managed_compare MirLessEqual bytes (managed_bits MirUSize managed_directory_name_capacity) after)
              (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd nonempty fits final)
                  (fun (combined : ManagedResult) => match combined with | ManagedResultOf valid checked =>
                    lower_bind ManagedState ManagedResult (managed_directory_require compiler scope valid checked)
                      (fun (entered : ManagedState) => lower_bind ManagedResult ManagedResult
                        (managed_directory_call compiler ManagedDirectoryFromWide
                          ([wide, units, buffer, bytes, count] : List MirValue) entered)
                        (fun (converted : ManagedResult) => match converted with | ManagedResultOf status filled =>
                          lower_bind ManagedState ManagedResult (managed_directory_status compiler scope status filled)
                            (managed_directory_name_filled compiler scope buffer bytes count) end)) end) end) end) end);

def managed_directory_name (compiler : ManagedCompiler) (scope : ManagedDirectoryScope)
    (wide : MirValue) (units : MirValue) (buffer : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult
      (managed_directory_call compiler ManagedDirectoryFromWide
        ([wide, units, managed_bits MirRawPtr 0, managed_bits MirUSize 0, count] : List MirValue) state)
      (fun (queried : ManagedResult) => match queried with | ManagedResultOf status next =>
        lower_bind ManagedState ManagedResult (managed_directory_status compiler scope status next)
          (managed_directory_name_sized compiler scope wide units buffer count) end);

def managed_directory_dot (wide : MirValue) (units : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_load MirU32 wide 0 state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf prefix next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirEqual units (managed_bits MirUSize 1) next)
          (fun (one : ManagedResult) => match one with | ManagedResultOf single after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirEqual prefix (managed_bits MirU32 46) after)
              (fun (first : ManagedResult) => match first with | ManagedResultOf period final =>
                lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd single period final)
                  (fun (dot : ManagedResult) => match dot with | ManagedResultOf current entered =>
                    lower_bind ManagedResult ManagedResult (managed_compare MirEqual units (managed_bits MirUSize 2) entered)
                      (fun (two : ManagedResult) => match two with | ManagedResultOf double after_two =>
                        lower_bind ManagedResult ManagedResult (managed_compare MirEqual prefix
                          (MirBits MirU32 (X64Words64 (X64Bytes32 46 0 46 0) codegen_zero)) after_two)
                          (fun (second : ManagedResult) => match second with | ManagedResultOf periods after_second =>
                            lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd double periods after_second)
                              (fun (parent : ManagedResult) => match parent with | ManagedResultOf previous finished =>
                                managed_binary MirU8 MirOr current previous finished end) end) end) end) end) end) end);

def managed_directory_entry_value (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (family : Nat)
    (wide : MirValue) (units : MirValue) (buffer : MirValue) (count : MirValue) (tail : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_directory_dot wide units state)
      (fun (tested : ManagedResult) => match tested with | ManagedResultOf skip next =>
        managed_string_choose MirManagedPtr skip
          (fun (current : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf tail current))
          (fun (current : ManagedState) => lower_bind ManagedResult ManagedResult
            (managed_directory_name compiler scope wide units buffer count current)
            (fun (converted : ManagedResult) => match converted with | ManagedResultOf name after =>
              managed_constructor compiler family (managed_bits MirUSize 1) ([name, tail] : List MirValue) after end)) next end);

def managed_directory_entry_length (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (family : Nat)
    (wide : MirValue) (buffer : MirValue) (count : MirValue) (tail : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_count count state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf units next =>
        lower_bind ManagedResult ManagedResult (managed_compare MirGreater units (managed_bits MirUSize 0) next)
          (fun (positive : ManagedResult) => match positive with | ManagedResultOf nonempty after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirLess units (managed_bits MirUSize 260) after)
              (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits final =>
                lower_bind ManagedResult ManagedResult (managed_binary MirU8 MirAnd nonempty fits final)
                  (fun (combined : ManagedResult) => match combined with | ManagedResultOf valid checked =>
                    lower_bind ManagedState ManagedResult (managed_directory_require compiler scope valid checked)
                      (managed_directory_entry_value compiler scope family wide units buffer count tail) end) end) end) end);

def managed_directory_entry (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (family : Nat)
    (data : MirValue) (buffer : MirValue) (count : MirValue) (tail : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_pointer data 44 state)
      (fun (located : ManagedResult) => match located with | ManagedResultOf wide next =>
        lower_bind ManagedResult ManagedResult
          (managed_directory_call compiler ManagedDirectoryWideLength ([wide, managed_bits MirUSize 260, count] : List MirValue) next)
          (fun (measured : ManagedResult) => match measured with | ManagedResultOf status after =>
            lower_bind ManagedState ManagedResult (managed_directory_status compiler scope status after)
              (managed_directory_entry_length compiler scope family wide buffer count tail) end) end);

-- This list was built solely above. Reverse it to preserve the enumeration's
-- reported order; that order itself is unspecified and is never sorted here.
def managed_directory_reverse_step (compiler : ManagedCompiler) (family : Nat) (cursor : Nat) (result : Nat)
    (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_load MirManagedPtr (MirUse cursor) 56 state)
      (fun (head : ManagedResult) => match head with | ManagedResultOf name next =>
        lower_bind ManagedResult ManagedState (managed_load MirManagedPtr (MirUse cursor) 64 next)
          (fun (tail : ManagedResult) => match tail with | ManagedResultOf rest after =>
            lower_map ManagedResult ManagedState (fun (linked : ManagedResult) => match linked with
              | ManagedResultOf list final => managed_emit (MirMove result list) final end)
              (managed_constructor compiler family (managed_bits MirUSize 1) ([name, MirUse result] : List MirValue)
                (managed_emit (MirMove cursor rest) after)) end) end);

def managed_directory_reverse (compiler : ManagedCompiler) (family : Nat) (value : MirValue) (nil : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirManagedPtr state)
      (fun (position : Pair Nat ManagedState) => match position with | MkPair cursor next =>
        lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirManagedPtr next)
          (fun (output : Pair Nat ManagedState) => match output with | MkPair result after =>
            let initialized : ManagedState := managed_emit_all ([MirMove cursor value, MirMove result nil] : List MirInstruction) after in
            lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
              (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                lower_bind ManagedResult ManagedResult (managed_load MirUSize (MirUse cursor) 40
                  (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                  (fun (tagged : ManagedResult) => match tagged with | ManagedResultOf tag entered =>
                    lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual tag (managed_bits MirUSize 0) entered)
                      (fun (tested : ManagedResult) => match tested with | ManagedResultOf running current =>
                        lower_map ManagedState ManagedResult (fun (finished : ManagedState) =>
                          ManagedResultOf (MirUse result) (managed_switch_block finish (MirJump header) finished))
                          (managed_directory_reverse_step compiler family cursor result
                            (managed_switch_block body (MirBranch running body finish) current)) end) end) end) end) end);

def managed_directory_search_step (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (family : Nat)
    (search : MirValue) (data : MirValue) (buffer : MirValue) (count : MirValue) (list : Nat) (status : Nat)
    (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_directory_entry compiler scope family data buffer count (MirUse list) state)
      (fun (entry : ManagedResult) => match entry with | ManagedResultOf value next =>
        lower_map ManagedResult ManagedState (fun (advanced : ManagedResult) => match advanced with
          | ManagedResultOf code after => managed_emit (MirMove status code) after end)
          (managed_directory_call compiler ManagedDirectoryNext ([search, data, managed_bits MirUSize 592] : List MirValue)
            (managed_emit (MirMove list value) next)) end);

def managed_directory_search (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (family : Nat)
    (search : MirValue) (data : MirValue) (buffer : MirValue) (count : MirValue) (nil : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirManagedPtr state)
      (fun (result : Pair Nat ManagedState) => match result with | MkPair list next =>
        lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_local MirU32 next)
          (fun (code : Pair Nat ManagedState) => match code with | MkPair status after =>
            let initialized : ManagedState := managed_emit_all
              ([MirMove list nil, MirMove status (managed_bits MirU32 0)] : List MirInstruction) after in
            lower_bind LowerLoopBlocks ManagedResult (lower_loop_blocks (managed_flow initialized))
              (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
                lower_bind ManagedResult ManagedResult (managed_startup_zero (MirUse status)
                  (managed_with_flow initialized (lower_switch_block header (MirJump header) flow)))
                  (fun (tested : ManagedResult) => match tested with | ManagedResultOf running current =>
                    lower_bind ManagedState ManagedResult
                      (managed_directory_search_step compiler scope family search data buffer count list status
                        (managed_switch_block body (MirBranch running body finish) current))
                      (fun (stepped : ManagedState) => lower_bind ManagedResult ManagedResult
                        (managed_compare MirEqual (MirUse status) (managed_bits MirU32 18)
                          (managed_switch_block finish (MirJump header) stepped))
                        (fun (ended : ManagedResult) => match ended with | ManagedResultOf eof finished =>
                          lower_bind ManagedState ManagedResult (managed_directory_require compiler scope eof finished)
                            (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                              (managed_directory_reverse compiler family (MirUse list) nil checked)
                              (fun (ordered : ManagedResult) => match ordered with | ManagedResultOf value final =>
                                managed_directory_complete compiler scope value final end)) end)) end) end) end) end);

def managed_directory_first_result (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (family : Nat)
    (storage : MirValue) (data : MirValue) (buffer : MirValue) (count : MirValue) (nil : MirValue)
    (status : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_startup_zero status state)
      (fun (tested : ManagedResult) => match tested with | ManagedResultOf opened next =>
        managed_string_choose MirManagedPtr opened
          (fun (current : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize storage 0 current)
            (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bits after =>
              lower_bind ManagedResult ManagedResult (managed_convert MirRawPtr MirRawFromBits bits after)
                (fun (converted : ManagedResult) => match converted with | ManagedResultOf search final =>
                  managed_directory_search compiler (managed_directory_handle ManagedDirectorySearchClose search scope)
                    family search data buffer count nil final end) end))
          (fun (current : ManagedState) => lower_bind ManagedResult ManagedResult
            (managed_compare MirEqual status (managed_bits MirU32 2) current)
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf no_match after =>
              lower_bind ManagedState ManagedResult (managed_directory_require compiler scope no_match after)
                (managed_directory_complete compiler scope nil) end)) next end);

def managed_directory_first (compiler : ManagedCompiler) (scope : ManagedDirectoryScope) (storage : MirValue)
    (pattern : MirValue) (units : MirValue) (count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind Nat ManagedResult (lower_role_identity (managed_compiler_entries compiler) PrimitiveListRole)
      (fun (family : Nat) => lower_bind ManagedResult ManagedResult
        (managed_constructor compiler family (managed_bits MirUSize 0) ([] : List MirValue) state)
        (fun (empty : ManagedResult) => match empty with | ManagedResultOf nil next =>
          lower_bind ManagedResult ManagedResult (managed_startup_pointer storage 32 next)
            (fun (found : ManagedResult) => match found with | ManagedResultOf data after =>
              lower_bind ManagedResult ManagedResult (managed_startup_pointer storage 624 after)
                (fun (staging : ManagedResult) => match staging with | ManagedResultOf buffer final =>
                  lower_bind ManagedResult ManagedResult (managed_directory_call compiler ManagedDirectoryFirst
                    ([pattern, units, data, managed_bits MirUSize 592, storage] : List MirValue) final)
                    (fun (opened : ManagedResult) => match opened with | ManagedResultOf status entered =>
                      managed_directory_first_result compiler scope family storage data buffer count nil status entered end) end) end) end));
