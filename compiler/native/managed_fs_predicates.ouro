-- Existence and directory queries preserve Win32 metadata results. The
-- reparse bit does not replace the directory bit or turn existence false.
import "managed_fs_kind.ouro";

def managed_fs_predicate_operation (primitive : PrimitiveId) : Maybe Bool :=
    match primitive_id_equal primitive PrimitiveFileExists with
    | True => Just Bool False
    | False => match primitive_id_equal primitive PrimitiveFileIsDirectory with
      | True => Just Bool True | False => Nothing Bool end end;

def managed_fs_predicate_attributes (compiler : ManagedCompiler) (directory : Bool)
    (buffer : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    match directory with
    | False => managed_boolean compiler (managed_bits MirU8 1) state
    | True => lower_bind ManagedResult ManagedResult (managed_load MirU32 buffer 0 state)
        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf attributes next =>
          lower_bind ManagedResult ManagedResult
            (managed_binary MirU32 MirAnd attributes (managed_bits MirU32 16) next)
            (fun (masked : ManagedResult) => match masked with | ManagedResultOf bits after =>
              lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual bits (managed_bits MirU32 0) after)
                (fun (checked : ManagedResult) => match checked with | ManagedResultOf found final =>
                  managed_boolean compiler found final end) end) end) end;

def managed_fs_predicate_query (compiler : ManagedCompiler) (directory : Bool) (scope : ManagedStartupScope)
    (wide : MirValue) (units : MirValue) (_count : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_startup_buffer compiler scope (managed_bits MirUSize 36)
      (managed_fs_metadata_read compiler (managed_fs_predicate_attributes compiler directory)
        (managed_boolean compiler (managed_bits MirU8 0)) wide units) state;

def managed_fs_predicate_storage (compiler : ManagedCompiler) (directory : Bool) (value : MirValue) (bytes : MirValue)
    (count : MirValue) (scope : ManagedStartupScope) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_startup_buffer compiler scope bytes
      (managed_startup_name_copy compiler (managed_fs_predicate_query compiler directory) value bytes count) state;

def managed_fs_predicate_action (compiler : ManagedCompiler) (directory : Bool) (path : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    managed_action compiler ([path] : List MirValue)
      (fun (captures : List MirValue) (entered : ManagedState) =>
        lower_bind MirValue ManagedResult (lower_single MirValue captures)
          (fun (value : MirValue) => managed_fs_path_body compiler
            (managed_boolean compiler (managed_bits MirU8 0))
            (managed_fs_predicate_storage compiler directory) value entered)) state;

def managed_fs_predicate_value (compiler : ManagedCompiler) (directory : Bool) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let caller : LowerState := managed_flow state in
    lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol state)
      (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol reserved =>
        lower_bind ManagedResult ManagedResult
          (managed_fs_predicate_action compiler directory (MirUse 1) (managed_with_flow reserved (lower_empty_state 2)))
          (fun (compiled : ManagedResult) => match compiled with | ManagedResultOf action after =>
            let name : List Nat := match directory with
              | False => ([111,117,114,111,95,102,115,95,101,120,105,115,116,115] : List Nat)
              | True => ([111,117,114,111,95,102,115,95,105,115,95,100,105,114] : List Nat) end in
            let function : MirFunction := managed_finish_function symbol name
              ([MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr] : List MirLocal) action after in
            managed_emit_callable compiler 3 symbol False ([] : List MirValue)
              (managed_with_flow (managed_add_function function after) caller) end) end);

def managed_fs_predicate_primitive (compiler : ManagedCompiler) (step : ManagedStep) (scope : ManagedScope)
    (directory : Bool) (arguments : List CoreTerm) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind CoreTerm ManagedResult (lower_single CoreTerm arguments) (fun (term : CoreTerm) =>
      lower_bind ManagedResult ManagedResult (step scope term state)
        (fun (value : ManagedResult) => match value with | ManagedResultOf path next =>
          managed_fs_predicate_action compiler directory path next end));
