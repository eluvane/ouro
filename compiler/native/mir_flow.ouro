-- Reachability and definite assignment. Non-entry facts start at the full
-- local set and descend by predecessor intersection; entry starts at arguments.
-- This handles loop backedges without assuming that a loop runs even once.
import "mir_types.ouro";

inductive MirBlockFact : Type :=
  | MirFact : Nat -> List Nat -> MirBlockFact;

def mir_fact_at (id : Nat) : List MirBlockFact -> Either MirError (List Nat) :=
  fix mir_fact_at (facts : List MirBlockFact) : Either MirError (List Nat) :=
    match facts with | Nil => Left MirError (List Nat) (MirUnknownBlock id)
    | Cons fact rest => match fact with | MirFact key values =>
      match eq_nat id key with | True => Right MirError (List Nat) values | False => mir_fact_at rest end end end;

def mir_generated (block : MirBlock) : List Nat :=
    match block with | MirBlockDef _ instructions _ =>
      foldr MirInstruction (List Nat) (fun (instruction : MirInstruction) (values : List Nat) =>
        match mir_destination instruction with | Nothing => values | Just id => mir_add id values end)
        ([] : List Nat) instructions end;

-- A host may release a round's temporary allocations after retaining its
-- exact frontier. The same foldr, frozen seen set and fuel step stay here.
def mir_reachable_with
    (run_ids : (Unit -> List Nat) -> List Nat)
    (fuel : Nat) (entry : Nat) (blocks : List MirBlock) : Either MirError Unit :=
    (fix go (remaining : Nat) (seen : List Nat) : Either MirError Unit :=
      match remaining with | Z => Left MirError Unit MirResourceExhausted | S next =>
        let reached : List Nat := run_ids (fun (_ : Unit) => foldr MirBlock (List Nat)
          (fun (block : MirBlock) (ids : List Nat) => match mir_has (mir_block_id block) seen with
            | False => ids | True => mir_union (mir_successors block) ids end) seen blocks) in
        -- seen is unique, and mir_union only adds absent successors.
        -- A monotone frontier is unchanged exactly when its size is unchanged.
        match eq_nat (length Nat reached) (length Nat seen) with
        | False => go next reached
        | True => mir_each MirBlock (fun (block : MirBlock) =>
            mir_require (mir_has (mir_block_id block) reached) (MirUnreachableBlock (mir_block_id block))) blocks end end)
      fuel ([entry] : List Nat);

def mir_reachable (fuel : Nat) (entry : Nat) (blocks : List MirBlock) : Either MirError Unit :=
    mir_reachable_with (fun (work : Unit -> List Nat) => work MkUnit) fuel entry blocks;

def mir_predecessor_values (target : Nat) (facts : List MirBlockFact)
    : List MirBlock -> List Nat -> Either MirError (List Nat) :=
  fix mir_predecessor_values (blocks : List MirBlock) (common : List Nat) : Either MirError (List Nat) :=
    match blocks with | Nil => Right MirError (List Nat) common
    | Cons block rest => match mir_has target (mir_successors block) with
      | False => mir_predecessor_values rest common
      | True => match mir_fact_at (mir_block_id block) facts with
        | Left err => Left MirError (List Nat) err
        | Right incoming => mir_predecessor_values rest (mir_intersection common (mir_union (mir_generated block) incoming))
        end end end;

-- Block types are checked before flow, so incoming and generated IDs are
-- subsets of declared locals. The first predecessor therefore supplies the
-- intersection seed directly; only later predecessors require an intersection.
def mir_predecessor_declared (target : Nat) (facts : List MirBlockFact)
    (blocks : List MirBlock) (locals : List Nat) : Either MirError (List Nat) :=
    (fix scan (pending : List MirBlock) (common : Maybe (List Nat)) : Either MirError (List Nat) :=
      match pending with | Nil => Right MirError (List Nat)
        (match common with | Nothing => locals | Just values => values end)
      | Cons block rest => match mir_has target (mir_successors block) with
        | False => scan rest common
        | True => match mir_fact_at (mir_block_id block) facts with
          | Left err => Left MirError (List Nat) err
          | Right incoming => let outgoing : List Nat := mir_union (mir_generated block) incoming in
              scan rest (Just (List Nat) (match common with | Nothing => outgoing
                | Just values => mir_intersection values outgoing end)) end end end)
      blocks (Nothing (List Nat));

-- Publish each descending fact before visiting the next block. Forward paths
-- then propagate in one pass instead of moving facts one edge per pass.
-- Block/error order, predecessor intersection and the final fixed-
-- point check stay the same; backedges still require convergence and fuel.
def mir_flow_step_with
    (predecessors : Nat -> List MirBlockFact -> List MirBlock -> List Nat -> Either MirError (List Nat))
    (entry : Nat) (args : List Nat) (locals : List Nat)
    (blocks : List MirBlock) (facts : List MirBlockFact) (rest : List MirBlock)
    : Either MirError (List MirBlockFact) :=
    (fix step (pending : List MirBlock) (known : List MirBlockFact) : Either MirError (List MirBlockFact) :=
      match pending with | Nil => Right MirError (List MirBlockFact) ([] : List MirBlockFact)
      | Cons block tail =>
        let id : Nat := mir_block_id block in
        let incoming : Either MirError (List Nat) := match eq_nat id entry with
          | True => Right MirError (List Nat) args | False => predecessors id known blocks locals end in
        match incoming with | Left err => Left MirError (List MirBlockFact) err | Right values =>
          let updated : List MirBlockFact := map MirBlockFact MirBlockFact (fun (fact : MirBlockFact) =>
            match fact with | MirFact key _ => match eq_nat id key with
              | True => MirFact key values | False => fact end end) known in
          mapRight MirError (List MirBlockFact) (List MirBlockFact)
            (fun (remaining : List MirBlockFact) => Cons MirBlockFact (MirFact id values) remaining)
            (step tail updated) end end) rest facts;

def mir_facts_equal : List MirBlockFact -> List MirBlockFact -> Bool :=
  fix mir_facts_equal (left : List MirBlockFact) (right : List MirBlockFact) : Bool :=
    match left, right with
    | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
    | Cons a rest_a, Cons b rest_b => match a, b with | MirFact id_a values_a, MirFact id_b values_b =>
      match eq_nat id_a id_b with
      | False => False
      | True => match mir_set_equal values_a values_b with
        | False => False | True => mir_facts_equal rest_a rest_b end end end end;

-- Retain a complete round before releasing its temporaries. This keeps shared
-- predecessor lists together; convergence and fuel remain outside the callback.
def mir_flow_facts_with
    (run_facts : (Unit -> Either MirError (List MirBlockFact)) -> Either MirError (List MirBlockFact))
    (predecessors : Nat -> List MirBlockFact -> List MirBlock -> List Nat -> Either MirError (List Nat))
    (fuel : Nat) (entry : Nat) (args : List Nat) (locals : List Nat)
    (blocks : List MirBlock) : Either MirError (List MirBlockFact) :=
    let initial : List MirBlockFact := map MirBlock MirBlockFact
      (fun (block : MirBlock) => MirFact (mir_block_id block)
        (match eq_nat entry (mir_block_id block) with | True => args | False => locals end)) blocks in
    (fix go (remaining : Nat) (facts : List MirBlockFact) : Either MirError (List MirBlockFact) :=
      match remaining with | Z => Left MirError (List MirBlockFact) MirResourceExhausted | S next =>
        match run_facts (fun (_ : Unit) => mir_flow_step_with predecessors entry args locals blocks facts blocks) with
        | Left err => Left MirError (List MirBlockFact) err
        | Right updated => match mir_facts_equal facts updated with
          | True => Right MirError (List MirBlockFact) updated | False => go next updated end end end) fuel initial;

def mir_flow_facts (fuel : Nat) (entry : Nat) (args : List Nat) (locals : List Nat)
    (blocks : List MirBlock) : Either MirError (List MirBlockFact) :=
    mir_flow_facts_with (fun (work : Unit -> Either MirError (List MirBlockFact)) => work MkUnit)
      mir_predecessor_values fuel entry args locals blocks;

def mir_check_initialized (block : Nat) (initialized : List Nat) (value : MirValue) : Either MirError Unit :=
    match value with | MirBits _ _ => Right MirError Unit MkUnit
    | MirUse id => mir_require (mir_has id initialized) (MirUninitialized block id) end;

def mir_check_block_uses (facts : List MirBlockFact) (block : MirBlock) : Either MirError Unit :=
    match block with | MirBlockDef id instructions term => match mir_fact_at id facts with
    | Left err => Left MirError Unit err | Right incoming =>
      (fix go (rest : List MirInstruction) (initialized : List Nat) : Either MirError Unit :=
        match rest with
        | Nil => mir_each MirValue (mir_check_initialized id initialized) (mir_terminator_reads term)
        | Cons instruction tail =>
          match mir_each MirValue (mir_check_initialized id initialized) (mir_reads instruction) with
          | Left err => Left MirError Unit err | Right _ =>
            let after : List Nat := match mir_destination instruction with
              | Nothing => initialized | Just dest => mir_add dest initialized end in
            go tail after end end) instructions incoming end end;

-- Only mir_check_function calls this path, after every instruction has passed
-- local/type validation. Public flow helpers keep arbitrary-input semantics.
def mir_check_declared_flow_with
    (run_unit : (Unit -> Either MirError Unit) -> Either MirError Unit)
    (run_facts : (Unit -> Either MirError (List MirBlockFact)) -> Either MirError (List MirBlockFact))
    (predecessors : Nat -> List MirBlockFact -> List MirBlock -> List Nat -> Either MirError (List Nat))
    (fuel : Nat) (entry : Nat) (args : List Nat) (locals : List Nat)
    (blocks : List MirBlock) : Either MirError Unit :=
    match run_unit (fun (_ : Unit) => mir_reachable fuel entry blocks) with | Left err => Left MirError Unit err | Right _ =>
      match mir_flow_facts_with run_facts predecessors fuel entry args locals blocks with
      | Left err => Left MirError Unit err
      | Right facts => run_unit (fun (_ : Unit) => mir_each MirBlock (mir_check_block_uses facts) blocks) end end;

def mir_check_declared_flow (fuel : Nat) (entry : Nat) (args : List Nat) (locals : List Nat)
    (blocks : List MirBlock) : Either MirError Unit :=
    mir_check_declared_flow_with (fun (work : Unit -> Either MirError Unit) => work MkUnit)
      (fun (work : Unit -> Either MirError (List MirBlockFact)) => work MkUnit)
      mir_predecessor_declared fuel entry args locals blocks;
