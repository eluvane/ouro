-- Type-argument erasure predicates used by managed lowering and JsIR extract.
-- Kept off the JsIR/C printer modules so the native compiler cone does not
-- import extract.ouro or jsir.ouro.

import "../std/data.ouro";
import "base.ouro";
import "core.ouro";

-- Binder: (name-id, erased?).
inductive BEntry : Type :=
  | MkB : Nat -> Bool -> BEntry;

-- Erase only sort anns (CSort). CInd (e.g. Nat) is data — keep binder.
def is_sort_ann (t : CoreTerm) : Bool :=
    match core_sort_level t with
    | Just _ => True
    | Nothing => False
    end;

def nth_b : List BEntry -> Nat -> Maybe BEntry :=
  compiler_nth BEntry;

-- Type-arg test: erased Rel (poly A:Type) counts as type so spines erase.
-- Type-form CApp (a type former applied to anything, e.g. `List Decl`)
-- is dropped as an argument. CConst of a *value* must stay; only
-- CInd/CSort/CPi/erased Rel count as type heads.
def is_type_arg_rel (i : Nat) (ctx : List BEntry) : Bool :=
    match nth_b ctx i with
    | Nothing => False
    | Just b =>
        match b with
        | MkB _ erased => erased
        end
    end;

def is_type_arg_ctx_with (type_globals : List Nat)
    : CoreTerm -> List BEntry -> Bool :=
  fix is_type_arg_ctx_with (t : CoreTerm) (ctx : List BEntry) : Bool :=
    match t with
    | CSort _ => True
    | CPi _ _ => True
    | CInd _ => True
    | CRel i => is_type_arg_rel i ctx
    | CLam _ _ => False
    | CApp f _ => is_type_arg_ctx_with f ctx
    | CLetIn _ _ _ => False
    | CConst n => memNat n type_globals
    | CConstruct _ _ _ => False
    | CStrBytes _ _ => False
    | CStrLit _ _ => False
    | CCase _ _ _ _ => False
    | CFix _ _ _ _ _ => False
    end;

def is_type_arg_ctx (t : CoreTerm) (ctx : List BEntry) : Bool :=
    is_type_arg_ctx_with (Nil Nat) t ctx;
