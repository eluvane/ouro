-- Typed failures stay distinct until the host-facing diagnostic boundary.

import "file_elab_core.ouro";
import "file_check_model.ouro";
import "file_check_environment.ouro";
import "file_check_work.ouro";

def check_bind (A : Type) (B : Type) (result : CheckResult A)
    (next : A -> CheckResult B) : CheckResult B :=
    match result with
    | CheckOk value => next value
    | CheckErr failure => CheckErr B failure
    end;

def check_map (A : Type) (B : Type) (convert : A -> B)
    (result : CheckResult A) : CheckResult B :=
    match result with
    | CheckOk value => CheckOk B (convert value)
    | CheckErr failure => CheckErr B failure
    end;

def check_from_normalize (A : Type) (result : NormalizeResult A) : CheckResult A :=
    match result with
    | Normalized value => CheckOk A value
    | NormalizeExhausted => CheckErr A CheckResourceLimit
    | NormalizeMalformed fault => CheckErr A (CheckReductionFailure fault)
    end;

def check_from_maybe (A : Type) (failure : CheckFailure)
    (result : Maybe A) : CheckResult A :=
    match result with
    | Just value => CheckOk A value
    | Nothing => CheckErr A failure
    end;

def check_to_maybe (A : Type) (result : CheckResult A) : Maybe A :=
    match result with
    | CheckOk value => Just A value
    | CheckErr _ => Nothing A
    end;

def check_succeeded (A : Type) (result : CheckResult A) : Bool :=
    match result with
    | CheckOk _ => True
    | CheckErr _ => False
    end;

def check_require (condition : Bool) (failure : CheckFailure) : CheckResult Unit :=
    match condition with
    | True => CheckOk Unit MkUnit
    | False => CheckErr Unit failure
    end;

def check_require_result (result : CheckResult Bool) (failure : CheckFailure)
    : CheckResult Unit :=
    check_bind Bool Unit result (fun (condition : Bool) => check_require condition failure);

def check_and (first : CheckResult Bool) (next : Unit -> CheckResult Bool) : CheckResult Bool :=
    check_bind Bool Bool first
      (fun (accepted : Bool) =>
        match accepted with
        | False => CheckOk Bool False
        | True => next MkUnit
        end);

def check_bool (result : CheckResult Bool) : Bool :=
    match result with
    | CheckOk accepted => accepted
    | CheckErr _ => False
    end;

def check_sort_indexed (fuel : Nat) (sig : CheckEnvironment) (term : CoreTerm) : CheckResult Nat :=
    check_bind CoreTerm Nat (check_from_normalize CoreTerm (whnf_checked_worker fuel sig term))
      (fun (normal : CoreTerm) =>
        check_from_maybe Nat (CheckTypeFailure CheckExpectedSort) (core_sort_level normal));


-- Raw-list compatibility boundaries derive lookup state exactly once.
def check_sort (fuel : Nat) (sig : List Entry) (term : CoreTerm)
    : CheckResult Nat :=
    check_input_guard Nat ([CheckInputTerm term] : List CheckInputWork)
      (fun (_work : Unit) =>
        check_sort_indexed fuel (check_environment_from_entries sig) term);
