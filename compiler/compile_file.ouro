-- Untrusted lowering and extraction summaries. These APIs receive bodies
-- without declaration types; COk records local stage completion, not module
-- acceptance. Public source compilation checks declarations in driver.ouro.

-- @entry compile_file_result
-- @export pack_ok; @doc docs/tcb.md
-- @export compile_named_surfaces; @doc docs/tcb.md
-- @export extract_named_cores; @doc docs/tcb.md
-- @export compile_cores; @doc docs/tcb.md
-- @export compile_file_bundle; @doc docs/tcb.md

import "compiler.ouro";

inductive NamedInfo : Type :=
  | MkNamedInfo : Nat -> Nat -> Nat -> NamedInfo;

inductive FileBundle : Type :=
  | MkBundle :
      List Nat ->
      List (Pair Nat CoreTerm) ->
      List (Pair Nat Nat) ->
      FileBundle;

inductive CompilationSummary : Type :=
  | MkCompilationSummary : List Nat -> List NamedInfo -> CompilationSummary;

def pipeline_all_ok : List Nat := ([status_ok, status_ok, status_ok, status_ok, status_ok] : List Nat);

def pack_ok (xs : List Nat) : CompResult (List Nat) :=
    match pipeline_ok xs with
    | Z => COk (List Nat) xs
    | S d => CErr (List Nat) (ErrCode (S Z) (S d))
    end;

def compile_named_surfaces (xs : List (Pair Nat Surface)) : CompResult (List (Pair Nat CoreTerm)) :=
    compile_program xs;

def extract_named_cores (xs : List (Pair Nat CoreTerm)) : List (Pair Nat Nat) :=
  compile_core_extract xs;

def named_infos : List (Pair Nat CoreTerm) -> List NamedInfo :=
  fix named_infos (xs : List (Pair Nat CoreTerm)) : List NamedInfo :=
    match xs with
    | Nil => Nil NamedInfo
    | Cons p xs' =>
        match p with
        | MkPair name t =>
            Cons NamedInfo
              (MkNamedInfo name (extract_tag t) (extract_apps t))
              (named_infos xs')
        end
    end;

def compile_cores (xs : List (Pair Nat CoreTerm)) : CompResult (List (Pair Nat Nat)) :=
  extract_program xs;

-- Stage metadata describes this lowering pass only; it is not checker evidence.
def compile_file_bundle (xs : List (Pair Nat Surface)) : CompResult FileBundle :=
    match compile_named_surfaces xs with
    | CErr e => CErr FileBundle e
    | COk cores =>
        COk FileBundle
          (MkBundle pipeline_all_ok cores (extract_named_cores cores))
    end;

def compile_file_result (xs : List (Pair Nat Surface)) : CompResult CompilationSummary :=
    match compile_named_surfaces xs with
    | CErr e => CErr CompilationSummary e
    | COk cores =>
        COk CompilationSummary
          (MkCompilationSummary pipeline_all_ok (named_infos cores))
    end;
