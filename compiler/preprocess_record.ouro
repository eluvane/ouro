import "preprocess_record_expr.ouro";

def parse_param_env (reg : RecReg) (env : RecEnv) (seg : List Nat) : RecEnv :=
  match take_until_char ch_colon_p seg with
  | MkPair before after =>
      match after with
      | Cons _ ty0 =>
          match type_to_rec reg ty0 with
          | Nothing => env
          | Just ri =>
              (fix go (scan_fuel : Nat) (xs : List Nat) (e : RecEnv) : RecEnv :=
                match scan_fuel with
                | Z => e
                | S remaining =>
                    let xs1 : List Nat := skip_ws_p xs in
                    match xs1 with
                    | Nil => e
                    | Cons c rest =>
                        match source_is_ident_start c with
                        | True =>
                            match source_take_ident xs1 with
                            | MkPair id rest2 => go remaining rest2 (env_add e id ri)
                            end
                        | False => go remaining rest e
                        end
                    end
                end) (S (length Nat before)) before env
          end
      | Nil => env
      end
  end;

def parse_def_header (reg : RecReg) (src : List Nat) : DefHead :=
  match source_take_ident (skip_ws_p (source_drop_prefix w_def src)) with
  | MkPair name rest =>
      match name with
      | Nil => NoHead
      | Cons _ _ =>
          (fix go (scan_fuel : Nat) (xs : List Nat) (env : RecEnv) : DefHead :=
            match scan_fuel with
            | Z => NoHead
            | S remaining =>
                let xs1 : List Nat := skip_ws_p xs in
                match xs1 with
                | Nil => NoHead
                | Cons c rest2 =>
                    match eqNat c ch_lparen_p with
                    | True =>
                        match take_until_char ch_rparen_p rest2 with
                        | MkPair inside afterp =>
                            let env2 : RecEnv := parse_param_env reg env inside in
                            match afterp with
                            | Cons _ r => go remaining r env2
                            | Nil => NoHead
                            end
                        end
                    | False =>
                        match eqNat c ch_colon_p with
                        | True =>
                            match take_until_coloneq rest2 with
                            | MkPair ret rest3 =>
                                match rest3 with
                                | Cons _ rest4 =>
                                    match rest4 with
                                    | Cons _ body0 =>
                                        match take_until_char ch_semi_p body0 with
                                        | MkPair body tail =>
                                            MkHead name env (type_to_rec reg ret)
                                              body tail
                                        end
                                    | Nil => NoHead
                                    end
                                | Nil => NoHead
                                end
                            end
                        | False => NoHead
                        end
                    end
                end
            end) (S (length Nat rest)) rest empty_rec_env
      end
  end;

def register_global (reg : RecReg) (name : List Nat) (ri : Nat) : RecReg :=
  match reg with
  | MkRecReg _ recs names gs =>
      MkRecReg Z recs names (Cons RecBind (MkRecBind name ri) gs)
  end;

def cut_prefix (a : List Nat) (b : List Nat) : List Nat :=
  (fix go (xs : List Nat) (acc : List Nat) : List Nat :=
    match source_starts b xs with
    | True => reverse Nat acc
    | False =>
        match xs with
        | Nil => reverse Nat acc
        | Cons c rest => go(rest, Cons Nat c acc)
        end
    end) a (Nil Nat);

def rewrite_defs (reg0 : RecReg) (src : List Nat) : Pair RecReg PrepResult :=
  (fix go (scan_fuel : Nat) (reg : RecReg) (xs : List Nat) (acc : List Nat)
      : Pair RecReg PrepResult :=
    match scan_fuel with
    | Z => MkPair RecReg PrepResult reg (PrepErr rec_code_malformed Z)
    | S remaining =>
        match xs with
        | Nil => MkPair RecReg PrepResult reg (PrepOk (reverse Nat acc))
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just p =>
                match p with
                | MkPair acc2 xs2 => go remaining reg xs2 acc2
                end
            | Nothing =>
                match source_is_ident_start c with
                | True =>
                    match source_take_ident xs with
                    | MkPair id after =>
                        match source_bytes_equal id w_def with
                        | True =>
                            match parse_def_header reg xs with
                            | NoHead => go remaining reg after (emit acc id)
                            | MkHead name env mrec body tail =>
                                match rewrite_expr reg env mrec body with
                                | RwErr e =>
                                    MkPair RecReg PrepResult reg (PrepErr e Z)
                                | RwOk body2 _ =>
                                    let header : List Nat := cut_prefix xs body in
                                    let a2 : List Nat := emit(emit acc header, body2) in
                                    let a3 : List Nat :=
                                      match tail with
                                      | Cons sc _ =>
                                          match eqNat sc ch_semi_p with
                                          | True => Cons Nat ch_semi_p a2
                                          | False => a2
                                          end
                                      | Nil => a2
                                      end in
                                    let tail2 : List Nat :=
                                      match tail with
                                      | Cons sc restt =>
                                          match eqNat sc ch_semi_p with
                                          | True => restt
                                          | False => tail
                                          end
                                      | Nil => tail
                                      end in
                                    let reg2 : RecReg :=
                                      match mrec with
                                      | Just ri => register_global reg name ri
                                      | Nothing => reg
                                      end in
                                    go remaining reg2 tail2 a3
                                end
                            end
                        | False => go remaining reg after (emit acc id)
                        end
                    end
                | False => go remaining reg rest (Cons Nat c acc)
                end
            end
        end
    end) (S (length Nat src)) reg0 src (Nil Nat);

-- @export preprocess_records_reg; @doc docs/syntax.md
def preprocess_records_reg (reg0 : RecReg) (src : List Nat)
    : Pair RecReg PrepResult :=
  match orb(src_has_record_keyword src, rec_reg_has_recs reg0) with
  | False => MkPair RecReg PrepResult reg0 (PrepOk src)
  | True =>
      let names : List (List Nat) := collect_decl_names src in
      let reg1 : RecReg :=
        match reg0 with
        | MkRecReg _tag recs old gs =>
            MkRecReg Z recs (append (List Nat) names old) gs
        end in
      match expand_record_decls reg1 src with
      | MkPair reg2 r1 =>
          match r1 with
          | PrepErr c d => MkPair RecReg PrepResult reg2 (PrepErr c d)
          | PrepOk mid => rewrite_defs reg2 mid
          end
      end
  end;

-- @entry preprocess_records
-- @export preprocess_records; @doc docs/syntax.md
def preprocess_records (src : List Nat) : PrepResult :=
  match preprocess_records_reg empty_rec_reg src with
  | MkPair _reg r => r
  end;
