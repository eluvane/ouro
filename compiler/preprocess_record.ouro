import "preprocess_record_expr.ouro";

def parse_param_env (reg : RecReg) (env : RecEnv)
    (current : List Nat) (aliases : ImpReg) (seg : List Nat) : RecEnv :=
  match take_until_char ch_colon_p seg with
  | MkPair before after =>
      match after with
      | Cons _ ty0 =>
          match type_to_rec reg current aliases ty0 with
          | Nothing => env
          | Just ri =>
              (fix go (scan_fuel : Nat) (xs : List Nat) (e : RecEnv) : RecEnv :=
                match scan_fuel with
                | Z => e
                | S remaining =>
                    let xs1 : List Nat := skip_ws_p xs in
                    match xs1 with
                    | Nil => e
                    | Cons c rest =>
                        match source_is_ident_start c with
                        | True =>
                            match source_take_ident xs1 with
                            | MkPair id rest2 => go remaining rest2 (env_add e id ri)
                            end
                        | False => go remaining rest e
                        end
                    end
                end) (S (length Nat before)) before env
          end
      | Nil => env
      end
  end;

def parse_def_header (reg : RecReg) (current : List Nat)
    (aliases : ImpReg)
    (src : List Nat) : DefHead :=
  match source_take_ident (skip_ws_p (source_drop_prefix w_def src)) with
  | MkPair name rest =>
      match name with
      | Nil => NoHead
      | Cons _ _ =>
          (fix go (scan_fuel : Nat) (xs : List Nat) (env : RecEnv) : DefHead :=
            match scan_fuel with
            | Z => NoHead
            | S remaining =>
                let xs1 : List Nat := skip_ws_p xs in
                match xs1 with
                | Nil => NoHead
                | Cons c rest2 =>
                    match eqNat c ch_lparen_p with
                    | True =>
                        match take_until_char ch_rparen_p rest2 with
                        | MkPair inside afterp =>
                            let env2 : RecEnv :=
                              parse_param_env reg env current aliases inside in
                            match afterp with
                            | Cons _ r => go remaining r env2
                            | Nil => NoHead
                            end
                        end
                    | False =>
                        match eqNat c ch_colon_p with
                        | True =>
                            match take_until_coloneq rest2 with
                            | MkPair ret rest3 =>
                                match rest3 with
                                | Cons _ rest4 =>
                                    match rest4 with
                                    | Cons _ body0 =>
                                        match take_until_char ch_semi_p body0 with
                                        | MkPair body tail =>
                                            MkHead name env
                                              (type_record_hint reg current
                                                aliases ret)
                                              body tail
                                        end
                                    | Nil => NoHead
                                    end
                                | Nil => NoHead
                                end
                            end
                        | False => NoHead
                        end
                    end
                end
            end) (S (length Nat rest)) rest empty_rec_env
      end
  end;

def register_global (reg : RecReg) (owner : List Nat)
    (name : List Nat) (ri : Nat) : RecReg :=
  match reg with
  | MkRecReg _ recs names gs =>
      MkRecReg Z recs names
        (Cons RecBind (MkRecBind name ri owner) gs)
  end;

def cut_prefix (a : List Nat) (b : List Nat) : List Nat :=
  (fix go (xs : List Nat) (acc : List Nat) : List Nat :=
    match source_starts b xs with
    | True => reverse Nat acc
    | False =>
        match xs with
        | Nil => reverse Nat acc
        | Cons c rest => go(rest, Cons Nat c acc)
        end
    end) a (Nil Nat);

def rewrite_defs_with_origin (retain : Bool) (reg0 : RecReg) (owner : List Nat)
    (aliases : ImpReg) (bare_atoms : List (List Nat))
    (src : List Nat)
    : Pair (Pair RecReg PrepResult) (Either SourceOriginError (Maybe OriginalSourceMap)) :=
  record_origin_finish src
  ((fix go (scan_fuel : Nat) (reg : RecReg) (xs : List Nat) (literal_prior : Bool) (acc : List Nat)
      (capture : OriginalCapture) : Pair (Pair RecReg PrepResult) OriginalCapture :=
    match scan_fuel with
    | Z => record_origin_result reg (PrepErr rec_code_malformed Z) capture
    | S remaining =>
        match xs with
        | Nil => record_origin_result reg (PrepOk (source_emit_reversed (Nil Nat) acc)) capture
        | Cons c rest =>
            match source_copy_comment_or_literal_at literal_prior acc xs with
            | Just p =>
                match p with
                | MkPair acc2 xs2 => go remaining reg xs2 False acc2 capture
                end
            | Nothing =>
                match source_is_ident_start c with
                | True =>
                    match source_take_ident xs with
                    | MkPair id after =>
                        match source_bytes_equal id w_def with
                        | True =>
                            match parse_def_header reg owner aliases xs with
                            | NoHead => go remaining reg after True (emit acc id) capture
                            | MkHead name env mrec body tail =>
                                match rewrite_expr reg env owner aliases bare_atoms
                                        mrec body with
                                | RwErr e =>
                                    record_origin_result reg (PrepErr e Z) capture
                                | RwOk body2 _ =>
                                    let header : List Nat := cut_prefix xs body in
                                    let a2 : List Nat := emit(emit acc header, body2) in
                                    let a3 : List Nat :=
                                      match tail with
                                      | Cons sc _ =>
                                          match eqNat sc ch_semi_p with
                                          | True => Cons Nat ch_semi_p a2
                                          | False => a2
                                          end
                                      | Nil => a2
                                      end in
                                    let tail2 : List Nat :=
                                      match tail with
                                      | Cons sc restt =>
                                          match eqNat sc ch_semi_p with
                                          | True => restt
                                          | False => tail
                                          end
                                      | Nil => tail
                                      end in
                                    let reg2 : RecReg :=
                                      match mrec with
                                      | Just hint => match hint with
                                        | MkPair ri _ => register_global reg owner name ri
                                        end
                                      | Nothing => reg
                                      end in
                                    go remaining reg2 tail2 False a3
                                      (original_capture_change capture xs tail2 acc a3 False)
                                end
                            end
                        | False => go remaining reg after True (emit acc id) capture
                        end
                    end
                | False => go remaining reg rest (source_is_ident_char c) (Cons Nat c acc) capture
                end
            end
        end
    end) (S (length Nat src)) reg0 src False (Nil Nat) (original_capture_start retain));

def rewrite_defs (reg0 : RecReg) (owner : List Nat)
    (aliases : ImpReg) (bare_atoms : List (List Nat)) (src : List Nat) : Pair RecReg PrepResult :=
  fst (Pair RecReg PrepResult) (Either SourceOriginError (Maybe OriginalSourceMap))
    (rewrite_defs_with_origin False reg0 owner aliases bare_atoms src);

def preprocess_records_reg_with_origin (retain : Bool) (owner : List Nat) (aliases : ImpReg)
    (reg0 : RecReg) (src : List Nat)
    : Pair (Pair RecReg (Pair ImpReg PrepResult)) (Either SourceOriginError (Maybe OriginalSourceMap)) :=
  let needed : Bool := match rec_reg_has_recs reg0 with
    | True => True
    | False => match src_has_record_keyword src with
      | True => True
      | False => src_has_record_projection src
      end
    end in
  match needed with
  | False => MkPair (Pair RecReg (Pair ImpReg PrepResult))
      (Either SourceOriginError (Maybe OriginalSourceMap))
      (MkPair RecReg (Pair ImpReg PrepResult) reg0
        (MkPair ImpReg PrepResult aliases (PrepOk src)))
      (Right SourceOriginError (Maybe OriginalSourceMap)
        (match retain with
         | False => Nothing OriginalSourceMap
         | True => Just OriginalSourceMap (original_identity (length Nat src))
         end))
  | True =>
      let names : List (List Nat) := collect_decl_names src in
      let bare_atoms : List (List Nat) := record_bare_atoms src in
      let reg1 : RecReg :=
        match reg0 with
        | MkRecReg _tag recs old gs =>
            MkRecReg Z recs (append (List Nat) names old) gs
        end in
      match expand_record_decls_with_origin retain reg1 owner aliases names src with
      | MkPair expanded before => match expanded with | MkPair reg2 r1 =>
          match r1 with
          | PrepErr c d => MkPair (Pair RecReg (Pair ImpReg PrepResult))
              (Either SourceOriginError (Maybe OriginalSourceMap))
              (MkPair RecReg (Pair ImpReg PrepResult) reg2
                (MkPair ImpReg PrepResult aliases (PrepErr c d))) before
          | PrepOk mid =>
              match rewrite_defs_with_origin retain reg2 owner aliases bare_atoms mid with
              | MkPair rewritten after => match rewritten with | MkPair reg3 result => match result with
                | PrepErr c d => MkPair (Pair RecReg (Pair ImpReg PrepResult))
                    (Either SourceOriginError (Maybe OriginalSourceMap))
                    (MkPair RecReg (Pair ImpReg PrepResult) reg3
                      (MkPair ImpReg PrepResult aliases (PrepErr c d))) after
                | PrepOk output => MkPair (Pair RecReg (Pair ImpReg PrepResult))
                    (Either SourceOriginError (Maybe OriginalSourceMap))
                    (MkPair RecReg (Pair ImpReg PrepResult) reg3
                      (MkPair ImpReg PrepResult
                      (record_generated_aliases aliases reg3 bare_atoms
                        output) (PrepOk output)))
                    (record_origin_compose before after)
                end end
              end
          end
      end end
  end;

-- @export preprocess_records_reg; @doc docs/syntax.md
def preprocess_records_reg (owner : List Nat) (aliases : ImpReg)
    (reg0 : RecReg) (src : List Nat) : Pair RecReg (Pair ImpReg PrepResult) :=
  fst (Pair RecReg (Pair ImpReg PrepResult)) (Either SourceOriginError (Maybe OriginalSourceMap))
    (preprocess_records_reg_with_origin False owner aliases reg0 src);

-- @entry preprocess_records
-- @export preprocess_records; @doc docs/syntax.md
def preprocess_records (src : List Nat) : PrepResult :=
  match preprocess_records_reg (Nil Nat)
      (MkImpReg (MkPair (List (List Nat)) (List (Pair (List Nat) (List Nat)))
        (Nil (List Nat)) (Nil (Pair(List Nat, List Nat))))
        (Nil ImpRule))
      empty_rec_reg src with
  | MkPair _reg tagged => match tagged with
    | MkPair aliases result => match aliases with
      | MkImpReg _registered_entries rules => match imp_reg_names aliases with
        | Cons _first_alias _remaining_aliases => PrepErr rec_code_need_ty Z
        | Nil => match rules with
          | Nil => result
          | Cons _first_rule _remaining_rules => PrepErr rec_code_need_ty Z
          end
        end
      end
    end
  end;
