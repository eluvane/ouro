-- Record sugar expands before lexing into ordinary inductive/accessor source accepted by the existing frontend.

import "preprocess_record_text.ouro";

def parse_record_fields (input : List Nat) (initial : List RecField) : RecParse :=
  (fix parse_record_fields (fuel : Nat) (xs : List Nat) (fs : List RecField) : RecParse :=
    match fuel with
    | Z => RecPErr rec_code_malformed
    | S remaining =>
        let xs1 : List Nat := skip_ws_p xs in
        match word_at w_end xs1 with
        | True =>
            let after : List Nat := skip_ws_p (source_drop_prefix w_end xs1) in
            match after with
            | Cons c rest =>
                match eqNat c ch_semi_p with
                | True =>
                    RecPOk (MkRecInfo(Nil Nat, Nil Nat, Nil Nat, reverse RecField fs))
                      (Nil Nat) rest
                | False =>
                    RecPOk (MkRecInfo(Nil Nat, Nil Nat, Nil Nat, reverse RecField fs))
                      (Nil Nat) after
                end
            | Nil =>
                RecPOk (MkRecInfo(Nil Nat, Nil Nat, Nil Nat, reverse RecField fs))
                  (Nil Nat) (Nil Nat)
            end
        | False =>
            match word_at w_constructor xs1 with
            | True =>
                match source_take_ident (skip_ws_p (source_drop_prefix w_constructor xs1)) with
                | MkPair ctor rest =>
                    match ctor with
                    | Nil => RecPErr rec_code_malformed
                    | Cons _ _ =>
                        match skip_ws_p rest with
                        | Cons c rest2 =>
                            match eqNat c ch_semi_p with
                            | True =>
                                match parse_record_fields remaining rest2 fs with
                                | RecPErr e => RecPErr e
                                | RecPOk ri sort tail =>
                                    match ri with
                                    | MkRecInfo _ n _ fs2 =>
                                        RecPOk (MkRecInfo (Nil Nat) n ctor fs2) sort tail
                                    end
                                end
                            | False => RecPErr rec_code_malformed
                            end
                        | Nil => RecPErr rec_code_malformed
                        end
                    end
                end
            | False =>
                match source_take_ident xs1 with
                | MkPair fld rest =>
                    match fld with
                    | Nil => RecPErr rec_code_malformed
                    | Cons _ _ =>
                        match field_named fld fs with
                        | True => RecPErr rec_code_dup
                        | False =>
                            match skip_ws_p rest with
                            | Cons c rest2 =>
                                match eqNat c ch_colon_p with
                                | True =>
                                    match take_until_char ch_semi_p rest2 with
                                    | MkPair ty rest3 =>
                                        match rest3 with
                                        | Cons sc rest4 =>
                                            match eqNat sc ch_semi_p with
                                            | True =>
                                                parse_record_fields remaining rest4
                                                  (Cons RecField
                                                    (MkRecField(fld, trim_bytes ty))
                                                    fs)
                                            | False => RecPErr rec_code_malformed
                                            end
                                        | Nil => RecPErr rec_code_malformed
                                        end
                                    end
                                | False => RecPErr rec_code_malformed
                                end
                            | Nil => RecPErr rec_code_malformed
                            end
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input initial;

def parse_record (src : List Nat) : RecParse :=
  match source_take_ident (skip_ws_p (source_drop_prefix w_record src)) with
  | MkPair name rest =>
      match name with
      | Nil => RecPErr rec_code_malformed
      | Cons _ _ =>
          match skip_ws_p rest with
          | Cons c rest2 =>
              match eqNat c ch_colon_p with
              | True =>
                  match take_until_word w_where rest2 with
                  | MkPair sort rest3 =>
                      match word_at w_where rest3 with
                      | False => RecPErr rec_code_malformed
                      | True =>
                          match parse_record_fields
                                  (source_drop_prefix w_where rest3)
                                  (Nil RecField) with
                          | RecPErr e => RecPErr e
                          | RecPOk ri _ tail =>
                              match ri with
                              | MkRecInfo _ _ ctor0 fs =>
                                  let ctor : List Nat :=
                                    match ctor0 with
                                    | Nil => append Nat w_Mk name
                                    | Cons _ _ => ctor0
                                    end in
                                  RecPOk (MkRecInfo (Nil Nat) name ctor fs)
                                    (trim_bytes sort) tail
                              end
                          end
                      end
                  end
              | False => RecPErr rec_code_malformed
              end
          | Nil => RecPErr rec_code_malformed
          end
      end
  end;

def collide_record (reg : RecReg) (ri : RecInfo) : Bool :=
  match reg with
  | MkRecReg _ _ names _ =>
      match ri with
      | MkRecInfo _ name ctor fs =>
          orb (name_in ctor names)
            ((fix go (xs : List RecField) : Bool :=
              match xs with
              | Nil => False
              | Cons f rest =>
                  match f with
                  | MkRecField n _ =>
                      orb(name_in(acc_name name n, names), go rest)
                  end
              end) fs)
      end
  end;

def register_record (reg : RecReg) (owner : List Nat)
    (ri : RecInfo) : RecReg :=
  match reg with
  | MkRecReg _ recs names gs =>
      match ri with
      | MkRecInfo _ name ctor fs =>
          let names1 : List (List Nat) :=
            Cons (List Nat) ctor
              ((fix go (xs : List RecField) (acc : List (List Nat))
                  : List (List Nat) :=
                match xs with
                | Nil => acc
                | Cons f rest =>
                    match f with
                    | MkRecField n _ =>
                        go(rest, Cons(List Nat, acc_name name n, acc))
                    end
                end) fs names) in
          MkRecReg Z (append RecInfo recs
            (list1_recinfo (MkRecInfo owner name ctor fs)))
            names1 gs
      end
  end;

def expand_record_decls (reg0 : RecReg) (owner : List Nat)
    (src : List Nat)
    : Pair RecReg PrepResult :=
  (fix go (scan_fuel : Nat) (reg : RecReg) (xs : List Nat) (acc : List Nat)
      : Pair RecReg PrepResult :=
    match scan_fuel with
    | Z => MkPair RecReg PrepResult reg (PrepErr rec_code_malformed Z)
    | S remaining =>
        match xs with
        | Nil => MkPair RecReg PrepResult reg (PrepOk (reverse Nat acc))
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just p =>
                match p with
                | MkPair acc2 xs2 => go remaining reg xs2 acc2
                end
            | Nothing =>
                match source_is_ident_start c with
                | True =>
                    match source_take_ident xs with
                    | MkPair id after =>
                        match source_bytes_equal id w_record with
                        | True =>
                            match parse_record xs with
                            | RecPErr e => MkPair RecReg PrepResult reg (PrepErr e Z)
                            | RecPOk ri sort tail =>
                                match collide_record reg ri with
                                | True =>
                                    MkPair RecReg PrepResult reg
                                      (PrepErr rec_code_collide Z)
                                | False =>
                                    go remaining (register_record reg owner ri) tail
                                      (emit_record acc ri sort)
                                end
                            end
                        | False => go remaining reg after (emit acc id)
                        end
                    end
                | False => go remaining reg rest (Cons Nat c acc)
                end
            end
        end
    end) (S (length Nat src)) reg0 src (Nil Nat);

def take_until_comma_or_end (xs0 : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match xs with
    | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | Cons c rest =>
        match andb (eqNat depth Z)
              (orb(eqNat c ch_comma_p, eqNat c ch_rbrace_p)) with
        | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
        | False => go(rest, Cons Nat c acc, bump_depth c depth)
        end
    end) xs0 (Nil Nat) Z;

def all_seen (n : Nat) (seen : List Nat) : Bool :=
  (fix go (remaining : Nat) : Bool :=
    match remaining with
    | Z => True
    | S index => andb(memNat index seen, go index)
    end) n;

def lookup_val (idx : Nat) : List (Pair Nat (List Nat)) -> List Nat :=
  fix lookup_val (xs : List (Pair Nat (List Nat))) : List Nat :=
    match xs with
    | Nil => Nil Nat
    | Cons p rest =>
        match p with
        | MkPair i v =>
            match eqNat i idx with
            | True => v
            | False => lookup_val rest
            end
        end
    end;

def build_ctor_app (ctor : List Nat) (fs : List RecField)
    (vals : List (Pair Nat (List Nat))) : List Nat :=
  reverse Nat
    ((fix go (left : List RecField) (i : Nat) (acc : List Nat) : List Nat :=
      match left with
      | Nil => acc
      | Cons _ rest =>
          let a1 : List Nat := Cons Nat ch_space_p acc in
          let a2 : List Nat := Cons Nat ch_lparen_p a1 in
          let a3 : List Nat := emit(a2, lookup_val i vals) in
          go(rest, S i, Cons Nat ch_rparen_p a3)
      end) fs Z (emit(Nil Nat, ctor)));

def fill_literal_go (fs : List RecField) (ctor : List Nat) (n : Nat)
    (input : List Nat) (initial_seen : List Nat) (initial_vals : List (Pair Nat (List Nat))) : RewriteR :=
  (fix fill_literal_go (fuel : Nat) (xs : List Nat) (seen : List Nat)
      (vals : List (Pair Nat (List Nat))) : RewriteR :=
    match fuel with
    | Z => RwErr rec_code_malformed
    | S remaining =>
        let xs1 : List Nat := skip_ws_p xs in
        match xs1 with
        | Nil =>
            match all_seen n seen with
            | False => RwErr rec_code_missing
            | True => RwOk(build_ctor_app ctor fs vals, Nil Nat)
            end
        | Cons c _ =>
            match eqNat c ch_rbrace_p with
            | True =>
                match all_seen n seen with
                | False => RwErr rec_code_missing
                | True => RwOk(build_ctor_app ctor fs vals, Nil Nat)
                end
            | False =>
                match source_take_ident xs1 with
                | MkPair fld rest =>
                    match fld with
                    | Nil => RwErr rec_code_malformed
                    | Cons _ _ =>
                        match skip_ws_p rest with
                        | Cons c1 rest2 =>
                            match rest2 with
                            | Cons c2 rest3 =>
                                match andb (eqNat c1 ch_colon_p)
                                      (eqNat c2 ch_eq_p) with
                                | True =>
                                    match find_field_idx fld fs with
                                    | Nothing => RwErr rec_code_unknown
                                    | Just idx =>
                                        match memNat idx seen with
                                        | True => RwErr rec_code_dup
                                        | False =>
                                            match take_until_comma_or_end rest3 with
                                            | MkPair expr rest4 =>
                                                let rest5 : List Nat :=
                                                  skip_ws_p rest4 in
                                                let rest6 : List Nat :=
                                                  match rest5 with
                                                  | Cons cm rcm =>
                                                      match eqNat cm ch_comma_p with
                                                      | True => rcm
                                                      | False => rest5
                                                      end
                                                  | Nil => rest5
                                                  end in
                                                fill_literal_go remaining rest6 (Cons Nat idx seen)
                                                  (Cons (Pair(Nat, List Nat))
                                                    (MkPair Nat (List Nat) idx
                                                      (trim_bytes expr))
                                                    vals)
                                            end
                                        end
                                    end
                                | False => RwErr rec_code_malformed
                                end
                            | Nil => RwErr rec_code_malformed
                            end
                        | Nil => RwErr rec_code_malformed
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input initial_seen initial_vals;

def fill_literal (fs : List RecField) (ctor : List Nat) (inner : List Nat)
    : RewriteR :=
  fill_literal_go fs ctor (length RecField fs) inner (Nil Nat)
    (Nil (Pair(Nat, List Nat)));

def projection_record_hint (reg : RecReg) (env : RecEnv)
    (current : List Nat) (aliases : ImpReg)
    (bare_atoms : List (List Nat)) (base : List Nat) (field : List Nat)
    : Maybe (Pair Nat (List Nat)) :=
  match record_marker_parts base with
  | Nothing => match env_lookup env reg base with
    | Nothing => Nothing (Pair Nat (List Nat))
    | Just index => match reg with
      | MkRecReg _ recs _ _ => match nth_rec recs index with
        | Nothing => Nothing (Pair Nat (List Nat))
        | Just info => match info with
          | MkRecInfo _ record_name _ _ =>
              match record_owner_qualifier reg current aliases bare_atoms
                      index (acc_name record_name field) with
              | Nothing => Nothing (Pair Nat (List Nat))
              | Just qualifier => Just (Pair Nat (List Nat))
                  (MkPair Nat (List Nat) index qualifier)
              end
          end
        end
      end
    end
  | Just parts => match parts with
    | MkPair alias name =>
        match record_alias_target current aliases alias with
        | Nothing => Nothing (Pair Nat (List Nat))
        | Just owner =>
            match owned_global_rec reg owner name with
            | Nothing => Nothing (Pair Nat (List Nat))
            | Just index => match reg with
              | MkRecReg _ recs _ _ =>
                  match nth_rec recs index with
                  | Nothing => Nothing (Pair Nat (List Nat))
                  | Just info => match info with
                    | MkRecInfo record_owner _ _ _ =>
                        match source_bytes_equal record_owner owner with
                        | False => Nothing (Pair Nat (List Nat))
                        | True => Just (Pair Nat (List Nat))
                            (MkPair Nat (List Nat) index
                              (append Nat alias ([64] : List Nat)))
                        end
                    end
                  end
              end
            end
        end
    end
  end;

def type_record_hint (reg : RecReg) (current : List Nat)
    (aliases : ImpReg)
    (ty : List Nat) : Maybe (Pair Nat (List Nat)) :=
  match type_to_rec reg current aliases ty with
  | Nothing => Nothing (Pair Nat (List Nat))
  | Just index => match record_marker_parts (trim_bytes ty) with
    | Just _ => Just (Pair Nat (List Nat))
        (MkPair Nat (List Nat) index (record_qualifier ty))
    | Nothing => match record_owner_prefix reg current aliases index with
      | Nothing => Nothing (Pair Nat (List Nat))
      | Just qualifier => Just (Pair Nat (List Nat))
          (MkPair Nat (List Nat) index qualifier)
      end
    end
  end;

-- Nested expansion and suffix scans each consume an explicit input-sized bound.
def rewrite_expr (reg : RecReg) (env : RecEnv)
    (current : List Nat) (aliases : ImpReg)
    (bare_atoms : List (List Nat))
    (initial_expected : Maybe (Pair Nat (List Nat)))
    (input : List Nat) : RewriteR :=
  (fix rewrite_expr (depth_fuel : Nat)
      (expected : Maybe (Pair Nat (List Nat))) (xs0 : List Nat) : RewriteR :=
    match depth_fuel with
    | Z => RwErr rec_code_malformed
    | S depth_left =>
        (fix go (scan_fuel : Nat) (xs : List Nat) (acc : List Nat) : RewriteR :=
          match scan_fuel with
          | Z => RwErr rec_code_malformed
          | S scan_left =>
              match xs with
              | Nil => RwOk(reverse Nat acc, Nil Nat)
              | Cons c rest =>
                  match source_copy_comment_or_string acc xs with
                  | Just p =>
                      match p with
                      | MkPair acc2 xs2 => go scan_left xs2 acc2
                      end
                  | Nothing =>
                      match eqNat c ch_lbrace_p with
                      | True =>
                          match matching_brace xs with
                          | Nothing => RwErr rec_code_malformed
                          | Just br =>
                              match br with
                              | MkPair body tail =>
                                  match top_has_with (strip_braces body) with
                                  | True => RwErr rec_code_need_ty
                                  | False =>
                                      match top_has_assign (strip_braces body) with
                                      | False => go scan_left tail (emit acc body)
                                      | True =>
                                          match expected with
                                          | Nothing => RwErr rec_code_need_ty
                                          | Just hint => match hint with
                                            | MkPair ri qualifier =>
                                              match reg with
                                              | MkRecReg _ recs _ _ =>
                                                  match nth_rec recs ri with
                                                  | Nothing => RwErr rec_code_need_ty
                                                  | Just info =>
                                                      match info with
                                                      | MkRecInfo _ _ ctor fs =>
                                                          let emitted : Maybe (List Nat) :=
                                                            match qualifier with
                                                            | Nil => record_owner_qualifier reg
                                                                current aliases bare_atoms ri ctor
                                                            | Cons _ _ => Just (List Nat) qualifier
                                                            end in
                                                          match emitted with
                                                          | Nothing => RwErr rec_code_need_ty
                                                          | Just prefix => match fill_literal fs
                                                                  (append Nat prefix ctor)
                                                                  (strip_braces body) with
                                                          | RwErr e => RwErr e
                                                          | RwOk lit _ =>
                                                              match rewrite_expr depth_left
                                                                      (Nothing (Pair Nat (List Nat))) lit with
                                                              | RwErr e => RwErr e
                                                              | RwOk lit2 _ =>
                                                                  go scan_left tail (emit acc lit2)
                                                              end
                                                          end
                                                          end
                                                      end
                                                  end
                                              end
                                            end
                                          end
                                      end
                                  end
                              end
                          end
                      | False =>
                          match source_is_ident_start c with
                          | True =>
                              match record_take_atom xs with
                              | MkPair id after =>
                                  match after with
                                  | Cons d after2 =>
                                      match eqNat d ch_dot_p with
                                      | True =>
                                          match source_take_ident after2 with
                                          | MkPair fld after3 =>
                                              match fld with
                                              | Nil => RwErr rec_code_proj
                                              | Cons _ _ =>
                                                  match projection_record_hint reg env
                                                      current aliases bare_atoms id fld with
                                                  | Nothing => RwErr rec_code_proj
                                                  | Just hint => match hint with
                                                    | MkPair ri qualifier =>
                                                      match reg with
                                                      | MkRecReg _ recs _ _ =>
                                                          match nth_rec recs ri with
                                                          | Nothing => RwErr rec_code_proj
                                                          | Just info =>
                                                              match info with
                                                              | MkRecInfo _ rname _ rfs =>
                                                                  match find_field_idx
                                                                          fld rfs with
                                                                  | Nothing =>
                                                                      RwErr rec_code_proj
                                                                  | Just _ =>
                                                                      let a1 : List Nat :=
                                                                        emit acc
                                                                          (append Nat qualifier
                                                                            (acc_name rname fld)) in
                                                                      go scan_left after3
                                                                        (emit(Cons Nat ch_space_p a1, id))
                                                                  end
                                                              end
                                                          end
                                                      end
                                                    end
                                                  end
                                              end
                                          end
                                      | False => go scan_left after (emit acc id)
                                      end
                                  | Nil => go scan_left after (emit acc id)
                                  end
                              end
                          | False => go scan_left rest (Cons Nat c acc)
                          end
                      end
                  end
              end
          end) (S (length Nat xs0)) xs0 (Nil Nat)
    end) (S (length Nat input)) initial_expected input;

def parse_param_env (reg : RecReg) (env : RecEnv)
    (current : List Nat) (aliases : ImpReg) (seg : List Nat) : RecEnv :=
  match take_until_char ch_colon_p seg with
  | MkPair before after =>
      match after with
      | Cons _ ty0 =>
          match type_to_rec reg current aliases ty0 with
          | Nothing => env
          | Just ri =>
              (fix go (scan_fuel : Nat) (xs : List Nat) (e : RecEnv) : RecEnv :=
                match scan_fuel with
                | Z => e
                | S remaining =>
                    let xs1 : List Nat := skip_ws_p xs in
                    match xs1 with
                    | Nil => e
                    | Cons c rest =>
                        match source_is_ident_start c with
                        | True =>
                            match source_take_ident xs1 with
                            | MkPair id rest2 => go remaining rest2 (env_add e id ri)
                            end
                        | False => go remaining rest e
                        end
                    end
                end) (S (length Nat before)) before env
          end
      | Nil => env
      end
  end;

def parse_def_header (reg : RecReg) (current : List Nat)
    (aliases : ImpReg)
    (src : List Nat) : DefHead :=
  match source_take_ident (skip_ws_p (source_drop_prefix w_def src)) with
  | MkPair name rest =>
      match name with
      | Nil => NoHead
      | Cons _ _ =>
          (fix go (scan_fuel : Nat) (xs : List Nat) (env : RecEnv) : DefHead :=
            match scan_fuel with
            | Z => NoHead
            | S remaining =>
                let xs1 : List Nat := skip_ws_p xs in
                match xs1 with
                | Nil => NoHead
                | Cons c rest2 =>
                    match eqNat c ch_lparen_p with
                    | True =>
                        match take_until_char ch_rparen_p rest2 with
                        | MkPair inside afterp =>
                            let env2 : RecEnv :=
                              parse_param_env reg env current aliases inside in
                            match afterp with
                            | Cons _ r => go remaining r env2
                            | Nil => NoHead
                            end
                        end
                    | False =>
                        match eqNat c ch_colon_p with
                        | True =>
                            match take_until_coloneq rest2 with
                            | MkPair ret rest3 =>
                                match rest3 with
                                | Cons _ rest4 =>
                                    match rest4 with
                                    | Cons _ body0 =>
                                        match take_until_char ch_semi_p body0 with
                                        | MkPair body tail =>
                                            MkHead name env
                                              (type_record_hint reg current
                                                aliases ret)
                                              body tail
                                        end
                                    | Nil => NoHead
                                    end
                                | Nil => NoHead
                                end
                            end
                        | False => NoHead
                        end
                    end
                end
            end) (S (length Nat rest)) rest empty_rec_env
      end
  end;

def register_global (reg : RecReg) (owner : List Nat)
    (name : List Nat) (ri : Nat) : RecReg :=
  match reg with
  | MkRecReg _ recs names gs =>
      MkRecReg Z recs names
        (Cons RecBind (MkRecBind name ri owner) gs)
  end;

def cut_prefix (a : List Nat) (b : List Nat) : List Nat :=
  (fix go (xs : List Nat) (acc : List Nat) : List Nat :=
    match source_starts b xs with
    | True => reverse Nat acc
    | False =>
        match xs with
        | Nil => reverse Nat acc
        | Cons c rest => go(rest, Cons Nat c acc)
        end
    end) a (Nil Nat);

def rewrite_defs (reg0 : RecReg) (owner : List Nat)
    (aliases : ImpReg) (bare_atoms : List (List Nat))
    (src : List Nat) : Pair RecReg PrepResult :=
  (fix go (scan_fuel : Nat) (reg : RecReg) (xs : List Nat) (acc : List Nat)
      : Pair RecReg PrepResult :=
    match scan_fuel with
    | Z => MkPair RecReg PrepResult reg (PrepErr rec_code_malformed Z)
    | S remaining =>
        match xs with
        | Nil => MkPair RecReg PrepResult reg (PrepOk (reverse Nat acc))
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just p =>
                match p with
                | MkPair acc2 xs2 => go remaining reg xs2 acc2
                end
            | Nothing =>
                match source_is_ident_start c with
                | True =>
                    match source_take_ident xs with
                    | MkPair id after =>
                        match source_bytes_equal id w_def with
                        | True =>
                            match parse_def_header reg owner aliases xs with
                            | NoHead => go remaining reg after (emit acc id)
                            | MkHead name env mrec body tail =>
                                match rewrite_expr reg env owner aliases bare_atoms
                                        mrec body with
                                | RwErr e =>
                                    MkPair RecReg PrepResult reg (PrepErr e Z)
                                | RwOk body2 _ =>
                                    let header : List Nat := cut_prefix xs body in
                                    let a2 : List Nat := emit(emit acc header, body2) in
                                    let a3 : List Nat :=
                                      match tail with
                                      | Cons sc _ =>
                                          match eqNat sc ch_semi_p with
                                          | True => Cons Nat ch_semi_p a2
                                          | False => a2
                                          end
                                      | Nil => a2
                                      end in
                                    let tail2 : List Nat :=
                                      match tail with
                                      | Cons sc restt =>
                                          match eqNat sc ch_semi_p with
                                          | True => restt
                                          | False => tail
                                          end
                                      | Nil => tail
                                      end in
                                    let reg2 : RecReg :=
                                      match mrec with
                                      | Just hint => match hint with
                                        | MkPair ri _ => register_global reg owner name ri
                                        end
                                      | Nothing => reg
                                      end in
                                    go remaining reg2 tail2 a3
                                end
                            end
                        | False => go remaining reg after (emit acc id)
                        end
                    end
                | False => go remaining reg rest (Cons Nat c acc)
                end
            end
        end
    end) (S (length Nat src)) reg0 src (Nil Nat);

-- @export preprocess_records_reg; @doc docs/syntax.md
def preprocess_records_reg (owner : List Nat) (aliases : ImpReg)
    (reg0 : RecReg) (src : List Nat)
    : Pair RecReg (Pair ImpReg PrepResult) :=
  match orb(src_has_record_keyword src, rec_reg_has_recs reg0) with
  | False => MkPair RecReg (Pair ImpReg PrepResult) reg0
      (MkPair ImpReg PrepResult aliases (PrepOk src))
  | True =>
      let names : List (List Nat) := collect_decl_names src in
      let bare_atoms : List (List Nat) := record_bare_atoms src in
      let reg1 : RecReg :=
        match reg0 with
        | MkRecReg _tag recs old gs =>
            MkRecReg Z recs (append (List Nat) names old) gs
        end in
      match expand_record_decls reg1 owner src with
      | MkPair reg2 r1 =>
          match r1 with
          | PrepErr c d => MkPair RecReg (Pair ImpReg PrepResult) reg2
              (MkPair ImpReg PrepResult aliases (PrepErr c d))
          | PrepOk mid =>
              match rewrite_defs reg2 owner aliases bare_atoms mid with
              | MkPair reg3 result => match result with
                | PrepErr c d => MkPair RecReg (Pair ImpReg PrepResult) reg3
                    (MkPair ImpReg PrepResult aliases (PrepErr c d))
                | PrepOk output => MkPair RecReg (Pair ImpReg PrepResult) reg3
                    (MkPair ImpReg PrepResult
                      (record_generated_aliases owner aliases reg3 bare_atoms
                        output) (PrepOk output))
                end
              end
          end
      end
  end;

-- @entry preprocess_records
-- @export preprocess_records; @doc docs/syntax.md
def preprocess_records (src : List Nat) : PrepResult :=
  match preprocess_records_reg (Nil Nat)
      (MkImpReg (Nil (List Nat)) (Nil (Pair(List Nat, List Nat))))
      empty_rec_reg src with
  | MkPair _reg tagged => match tagged with
    | MkPair aliases result => match aliases with
      | MkImpReg names _bindings => match names with
        | Nil => result
        | Cons _first_alias _remaining_aliases => PrepErr rec_code_need_ty Z
        end
      end
    end
  end;
