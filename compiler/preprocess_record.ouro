-- Record sugar expands before lexing into ordinary inductive/accessor source accepted by the existing frontend.

import "preprocess_record_text.ouro";

def parse_record_fields (input : List Nat) (initial : List RecField) : RecParse :=
  (fix parse_record_fields (fuel : Nat) (xs : List Nat) (fs : List RecField) : RecParse :=
    match fuel with
    | Z => RecPErr rec_code_malformed
    | S remaining =>
        let xs1 : List Nat := skip_ws_p xs in
        match word_at w_end xs1 with
        | True =>
            let after : List Nat := skip_ws_p (source_drop_prefix w_end xs1) in
            match after with
            | Cons c rest =>
                match eqNat c ch_semi_p with
                | True =>
                    RecPOk (MkRecInfo(Z, Nil Nat, Nil Nat, reverse RecField fs))
                      (Nil Nat) rest
                | False =>
                    RecPOk (MkRecInfo(Z, Nil Nat, Nil Nat, reverse RecField fs))
                      (Nil Nat) after
                end
            | Nil =>
                RecPOk (MkRecInfo(Z, Nil Nat, Nil Nat, reverse RecField fs))
                  (Nil Nat) (Nil Nat)
            end
        | False =>
            match word_at w_constructor xs1 with
            | True =>
                match source_take_ident (skip_ws_p (source_drop_prefix w_constructor xs1)) with
                | MkPair ctor rest =>
                    match ctor with
                    | Nil => RecPErr rec_code_malformed
                    | Cons _ _ =>
                        match skip_ws_p rest with
                        | Cons c rest2 =>
                            match eqNat c ch_semi_p with
                            | True =>
                                match parse_record_fields remaining rest2 fs with
                                | RecPErr e => RecPErr e
                                | RecPOk ri sort tail =>
                                    match ri with
                                    | MkRecInfo _ n _ fs2 =>
                                        RecPOk (MkRecInfo Z n ctor fs2) sort tail
                                    end
                                end
                            | False => RecPErr rec_code_malformed
                            end
                        | Nil => RecPErr rec_code_malformed
                        end
                    end
                end
            | False =>
                match source_take_ident xs1 with
                | MkPair fld rest =>
                    match fld with
                    | Nil => RecPErr rec_code_malformed
                    | Cons _ _ =>
                        match field_named fld fs with
                        | True => RecPErr rec_code_dup
                        | False =>
                            match skip_ws_p rest with
                            | Cons c rest2 =>
                                match eqNat c ch_colon_p with
                                | True =>
                                    match take_until_char ch_semi_p rest2 with
                                    | MkPair ty rest3 =>
                                        match rest3 with
                                        | Cons sc rest4 =>
                                            match eqNat sc ch_semi_p with
                                            | True =>
                                                parse_record_fields remaining rest4
                                                  (Cons RecField
                                                    (MkRecField(fld, trim_left_bytes ty))
                                                    fs)
                                            | False => RecPErr rec_code_malformed
                                            end
                                        | Nil => RecPErr rec_code_malformed
                                        end
                                    end
                                | False => RecPErr rec_code_malformed
                                end
                            | Nil => RecPErr rec_code_malformed
                            end
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input initial;

def parse_record (src : List Nat) : RecParse :=
  match source_take_ident (skip_ws_p (source_drop_prefix w_record src)) with
  | MkPair name rest =>
      match name with
      | Nil => RecPErr rec_code_malformed
      | Cons _ _ =>
          match skip_ws_p rest with
          | Cons c rest2 =>
              match eqNat c ch_colon_p with
              | True =>
                  match take_until_word w_where rest2 with
                  | MkPair sort rest3 =>
                      match word_at w_where rest3 with
                      | False => RecPErr rec_code_malformed
                      | True =>
                          match parse_record_fields
                                  (source_drop_prefix w_where rest3)
                                  (Nil RecField) with
                          | RecPErr e => RecPErr e
                          | RecPOk ri _ tail =>
                              match ri with
                              | MkRecInfo _ _ ctor0 fs =>
                                  let ctor : List Nat :=
                                    match ctor0 with
                                    | Nil => append Nat w_Mk name
                                    | Cons _ _ => ctor0
                                    end in
                                  RecPOk (MkRecInfo Z name ctor fs)
                                    (trim_left_bytes sort) tail
                              end
                          end
                      end
                  end
              | False => RecPErr rec_code_malformed
              end
          | Nil => RecPErr rec_code_malformed
          end
      end
  end;

def collide_record (reg : RecReg) (ri : RecInfo) : Bool :=
  match reg with
  | MkRecReg _ _ names _ =>
      match ri with
      | MkRecInfo _ name ctor fs =>
          orb (name_in ctor names)
            ((fix go (xs : List RecField) : Bool :=
              match xs with
              | Nil => False
              | Cons f rest =>
                  match f with
                  | MkRecField n _ =>
                      orb(name_in(acc_name name n, names), go rest)
                  end
              end) fs)
      end
  end;

def register_record (reg : RecReg) (ri : RecInfo) : RecReg :=
  match reg with
  | MkRecReg _ recs names gs =>
      match ri with
      | MkRecInfo _ name ctor fs =>
          let names1 : List (List Nat) :=
            Cons (List Nat) ctor
              ((fix go (xs : List RecField) (acc : List (List Nat))
                  : List (List Nat) :=
                match xs with
                | Nil => acc
                | Cons f rest =>
                    match f with
                    | MkRecField n _ =>
                        go(rest, Cons(List Nat, acc_name name n, acc))
                    end
                end) fs names) in
          MkRecReg Z (append RecInfo recs (list1_recinfo ri))
            names1 gs
      end
  end;

def expand_record_decls (reg0 : RecReg) (src : List Nat)
    : Pair RecReg PrepResult :=
  (fix go (scan_fuel : Nat) (reg : RecReg) (xs : List Nat) (acc : List Nat)
      : Pair RecReg PrepResult :=
    match scan_fuel with
    | Z => MkPair RecReg PrepResult reg (PrepErr rec_code_malformed Z)
    | S remaining =>
        match xs with
        | Nil => MkPair RecReg PrepResult reg (PrepOk (reverse Nat acc))
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just p =>
                match p with
                | MkPair acc2 xs2 => go remaining reg xs2 acc2
                end
            | Nothing =>
                match source_is_ident_start c with
                | True =>
                    match source_take_ident xs with
                    | MkPair id after =>
                        match source_bytes_equal id w_record with
                        | True =>
                            match parse_record xs with
                            | RecPErr e => MkPair RecReg PrepResult reg (PrepErr e Z)
                            | RecPOk ri sort tail =>
                                match collide_record reg ri with
                                | True =>
                                    MkPair RecReg PrepResult reg
                                      (PrepErr rec_code_collide Z)
                                | False =>
                                    go remaining (register_record reg ri) tail
                                      (emit_record acc ri sort)
                                end
                            end
                        | False => go remaining reg after (emit acc id)
                        end
                    end
                | False => go remaining reg rest (Cons Nat c acc)
                end
            end
        end
    end) (S (length Nat src)) reg0 src (Nil Nat);

def take_until_comma_or_end (xs0 : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S remaining =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just copied =>
                match copied with
                | MkPair acc2 tail => go remaining tail acc2 depth
                end
            | Nothing =>
                match andb (eqNat depth Z)
                      (orb(eqNat c ch_comma_p, eqNat c ch_rbrace_p)) with
                | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
                | False => go remaining rest (Cons Nat c acc) (bump_depth c depth)
                end
            end
        end
    end) (S (length Nat xs0)) xs0 (Nil Nat) Z;

def all_seen (n : Nat) (seen : List Nat) : Bool :=
  (fix go (remaining : Nat) : Bool :=
    match remaining with
    | Z => True
    | S index => andb(memNat index seen, go index)
    end) n;

def lookup_val (idx : Nat) : List (Pair Nat (List Nat)) -> List Nat :=
  fix lookup_val (xs : List (Pair Nat (List Nat))) : List Nat :=
    match xs with
    | Nil => Nil Nat
    | Cons p rest =>
        match p with
        | MkPair i v =>
            match eqNat i idx with
            | True => v
            | False => lookup_val rest
            end
        end
    end;

def build_ctor_app (ctor : List Nat) (fs : List RecField)
    (vals : List (Pair Nat (List Nat))) : List Nat :=
  reverse Nat
    ((fix go (left : List RecField) (i : Nat) (acc : List Nat) : List Nat :=
      match left with
      | Nil => acc
      | Cons _ rest =>
          let a1 : List Nat := Cons Nat ch_space_p acc in
          let a2 : List Nat := Cons Nat ch_lparen_p a1 in
          let a3 : List Nat := emit(a2, lookup_val i vals) in
          go(rest, S i, Cons Nat ch_rparen_p a3)
      end) fs Z (emit(Nil Nat, ctor)));

def parse_literal_field_value (field : List Nat) (after : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match after with
  | Nil => Just(Pair(List Nat, List Nat), MkPair(List Nat, List Nat, field, Nil Nat))
  | Cons c rest =>
      match eqNat c ch_comma_p with
      | True => Just(Pair(List Nat, List Nat), MkPair(List Nat, List Nat, field, rest))
      | False =>
          match eqNat c ch_colon_p with
          | False => Nothing (Pair(List Nat, List Nat))
          | True =>
              match rest with
              | Nil => Nothing (Pair(List Nat, List Nat))
              | Cons equals value_src =>
                  match eqNat equals ch_eq_p with
                  | False => Nothing (Pair(List Nat, List Nat))
                  | True =>
                      match take_until_comma_or_end value_src with
                      | MkPair raw remainder =>
                          -- Keep a trailing comment's newline before generated parentheses.
                          let value : List Nat := skip_ws_p raw in
                          match value with
                          | Nil => Nothing (Pair(List Nat, List Nat))
                          | Cons _ _ =>
                              let next : List Nat := skip_ws_p remainder in
                              match next with
                              | Nil => Just(Pair(List Nat, List Nat),
                                  MkPair(List Nat, List Nat, raw, Nil Nat))
                              | Cons comma tail =>
                                  match eqNat comma ch_comma_p with
                                  | True => Just(Pair(List Nat, List Nat),
                                      MkPair(List Nat, List Nat, raw, tail))
                                  | False => Nothing (Pair(List Nat, List Nat))
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
  end;

def fill_literal_go (fs : List RecField) (ctor : List Nat) (n : Nat)
    (rewrite_value : Nat -> List Nat -> RewriteR)
    (input : List Nat) (initial_seen : List Nat) (initial_vals : List (Pair Nat (List Nat))) : RewriteR :=
  (fix fill_literal_go (fuel : Nat) (xs : List Nat) (seen : List Nat)
      (vals : List (Pair Nat (List Nat))) : RewriteR :=
    match fuel with
    | Z => RwErr rec_code_malformed
    | S remaining =>
        let xs1 : List Nat := skip_ws_p xs in
        match xs1 with
        | Nil =>
            match all_seen n seen with
            | False => RwErr rec_code_missing
            | True => RwOk(build_ctor_app ctor fs vals, Nil Nat)
            end
        | Cons c _ =>
            match eqNat c ch_rbrace_p with
            | True =>
                match all_seen n seen with
                | False => RwErr rec_code_missing
                | True => RwOk(build_ctor_app ctor fs vals, Nil Nat)
                end
            | False =>
                match source_take_ident xs1 with
                | MkPair fld rest =>
                    match fld with
                    | Nil => RwErr rec_code_malformed
                    | Cons _ _ =>
                        match parse_literal_field_value fld (skip_ws_p rest) with
                        | Nothing => RwErr rec_code_malformed
                        | Just parsed =>
                            match parsed with
                            | MkPair value tail =>
                                match find_field_idx fld fs with
                                | Nothing => RwErr rec_code_unknown
                                | Just idx =>
                                    match memNat idx seen with
                                    | True => RwErr rec_code_dup
                                    | False =>
                                        match rewrite_value idx value with
                                        | RwErr code => RwErr code
                                        | RwOk rewritten _ =>
                                            fill_literal_go remaining tail (Cons Nat idx seen)
                                              (Cons (Pair(Nat, List Nat))
                                                (MkPair Nat (List Nat) idx rewritten) vals)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input initial_seen initial_vals;

def fill_literal (fs : List RecField) (ctor : List Nat) (inner : List Nat)
    (rewrite_value : Nat -> List Nat -> RewriteR) : RewriteR :=
  fill_literal_go fs ctor (length RecField fs) rewrite_value inner (Nil Nat)
    (Nil (Pair(Nat, List Nat)));

inductive RecUpdateValue : Type :=
  | MkRecUpdateValue : List (List Nat) -> List Nat -> List Nat -> RecUpdateValue;

inductive RecUpdateParse : Type :=
  | RecUpdateErr : Nat -> RecUpdateParse
  | RecUpdateOk : List RecUpdateValue -> RecUpdateParse;

inductive RecUpdateBound : Type :=
  | MkRecUpdateBound : List (List Nat) -> List Nat -> List Nat -> List Nat -> RecUpdateBound;

inductive RecUpdateBind : Type :=
  | RecUpdateBindErr : Nat -> RecUpdateBind
  | RecUpdateBindOk : List RecUpdateBound -> RecUpdateBind;

inductive RecUpdateBuild : Type :=
  | RecUpdateBuildErr : Nat -> RecUpdateBuild
  | RecUpdateBuildOk : List Nat -> List (List Nat) -> RecUpdateBuild;

inductive RecUpdateFields : Type :=
  | RecUpdateFieldsErr : Nat -> RecUpdateFields
  | RecUpdateFieldsOk : List (Pair Nat (List Nat)) -> List (List Nat) -> RecUpdateFields;

def update_field_type : List RecField -> Nat -> Maybe (List Nat) :=
  fix update_field_type (fields : List RecField) (idx : Nat) : Maybe (List Nat) :=
  match fields with
  | Nil => Nothing (List Nat)
  | Cons f rest =>
      match idx with
      | Z => match f with | MkRecField _ ty => Just (List Nat) ty end
      | S next => update_field_type rest next
      end
  end;

def parse_update_path (input : List Nat)
    : Maybe (Pair (List (List Nat)) (List Nat)) :=
  (fix go (fuel : Nat) (xs : List Nat) (rev : List (List Nat))
      : Maybe (Pair (List (List Nat)) (List Nat)) :=
    match fuel with
    | Z => Nothing (Pair (List (List Nat)) (List Nat))
    | S remaining =>
        match source_take_ident (skip_ws_p xs) with
        | MkPair name rest =>
            match name with
            | Nil => Nothing (Pair (List (List Nat)) (List Nat))
            | Cons _ _ =>
                let path : List (List Nat) := Cons (List Nat) name rev in
                match skip_ws_p rest with
                | Cons dot after_dot =>
                    match eqNat dot ch_dot_p with
                    | True => go remaining after_dot path
                    | False => Just (Pair (List (List Nat)) (List Nat))
                        (MkPair (List (List Nat)) (List Nat)
                          (reverse (List Nat) path) (skip_ws_p rest))
                    end
                | Nil => Just (Pair (List (List Nat)) (List Nat))
                    (MkPair (List (List Nat)) (List Nat)
                      (reverse (List Nat) path) (Nil Nat))
                end
            end
        end
    end) (S (length Nat input)) input (Nil (List Nat));

def update_path_prefix : List (List Nat) -> List (List Nat) -> Bool :=
  fix update_path_prefix (prefix : List (List Nat)) (path : List (List Nat)) : Bool :=
  match prefix with
  | Nil => True
  | Cons head rest =>
      match path with
      | Nil => False
      | Cons current tail =>
          andb(source_bytes_equal head current, update_path_prefix rest tail)
      end
  end;

def update_path_conflicts (path : List (List Nat))
    : List (List (List Nat)) -> Bool :=
  fix update_path_conflicts (seen : List (List (List Nat))) : Bool :=
  match seen with
  | Nil => False
  | Cons old rest =>
      orb(update_path_prefix path old,
        orb(update_path_prefix old path, update_path_conflicts rest))
  end;

def resolve_update_path (reg : RecReg) (initial_ri : Nat)
    (path : List (List Nat)) : Maybe (List Nat) :=
  (fix go (segments : List (List Nat)) (ri : Nat) : Maybe (List Nat) :=
    match segments with
    | Nil => Nothing (List Nat)
    | Cons field rest =>
        match reg with
        | MkRecReg _ records _ _ =>
            match nth_rec records ri with
            | Nothing => Nothing (List Nat)
            | Just info =>
                match info with
                | MkRecInfo _ _ _ fields =>
                    match find_field_idx field fields with
                    | Nothing => Nothing (List Nat)
                    | Just idx =>
                        match update_field_type fields idx with
                        | Nothing => Nothing (List Nat)
                        | Just ty =>
                            match rest with
                            | Nil => Just (List Nat) ty
                            | Cons _ _ =>
                                match type_to_rec reg ty with
                                | Nothing => Nothing (List Nat)
                                | Just child => go rest child
                                end
                            end
                        end
                    end
                end
            end
        end
    end) path initial_ri;

def parse_update_fields (reg : RecReg) (ri : Nat)
    (input : List Nat) : RecUpdateParse :=
  (fix go (fuel : Nat) (xs : List Nat) (seen : List (List (List Nat)))
      (values : List RecUpdateValue) : RecUpdateParse :=
    match fuel with
    | Z => RecUpdateErr rec_code_malformed
    | S remaining =>
        match skip_ws_p xs with
        | Nil =>
            match seen with
            | Nil => RecUpdateErr rec_code_malformed
            | Cons _ _ => RecUpdateOk(reverse RecUpdateValue values)
            end
        | Cons _ _ =>
            match parse_update_path xs with
            | Nothing => RecUpdateErr rec_code_malformed
            | Just parsed =>
                match parsed with
                | MkPair path rest =>
                    match rest with
                    | Cons colon after_colon =>
                        match after_colon with
                        | Cons equals rhs =>
                            match andb(eqNat colon ch_colon_p, eqNat equals ch_eq_p) with
                            | False => RecUpdateErr rec_code_malformed
                            | True =>
                                match take_until_comma_or_end rhs with
                                | MkPair raw tail =>
                                    match skip_ws_p raw with
                                    | Nil => RecUpdateErr rec_code_malformed
                                    | Cons _ _ =>
                                        match resolve_update_path reg ri path with
                                        | Nothing => RecUpdateErr rec_code_unknown
                                        | Just ty =>
                                            match update_path_conflicts path seen with
                                            | True => RecUpdateErr rec_code_dup
                                            | False =>
                                                let more : List RecUpdateValue :=
                                                  Cons RecUpdateValue
                                                    (MkRecUpdateValue path ty raw) values in
                                                let seen2 : List (List (List Nat)) :=
                                                  Cons (List (List Nat)) path seen in
                                                match skip_ws_p tail with
                                                | Nil => RecUpdateOk(reverse RecUpdateValue more)
                                                | Cons comma after_comma =>
                                                    match eqNat comma ch_comma_p with
                                                    | True => go remaining after_comma seen2 more
                                                    | False => RecUpdateErr rec_code_malformed
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        | Nil => RecUpdateErr rec_code_malformed
                        end
                    | Nil => RecUpdateErr rec_code_malformed
                    end
                end
            end
        end
    end) (S (length Nat input)) input
      (Nil (List (List Nat))) (Nil RecUpdateValue);

def source_ident_used (name : List Nat) (input : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S remaining =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go remaining (source_skip_line rest)
            | False =>
                match eqNat c ch_dq_p with
                | True => go remaining (source_skip_string rest)
                | False =>
                    match source_is_ident_start c with
                    | True =>
                        match source_take_ident xs with
                        | MkPair ident tail =>
                            match source_bytes_equal ident name with
                            | True => True
                            | False => go remaining tail
                            end
                        end
                    | False => go remaining rest
                    end
                end
            end
        end
    end) (S (length Nat input)) input;

def fresh_update_name (input : List Nat) (used : List (List Nat))
    : Maybe (List Nat) :=
  (fix go (fuel : Nat) (candidate : List Nat) : Maybe (List Nat) :=
    match fuel with
    | Z => Nothing (List Nat)
    | S remaining =>
        match orb(source_ident_used candidate input, name_in candidate used) with
        | True => go remaining (append Nat candidate s_uscore)
        | False => Just (List Nat) candidate
        end
    end) (S (add (length Nat input) (length (List Nat) used)))
      ([95, 95, 111, 117, 114, 111, 95, 117, 112, 100, 97, 116, 101] : List Nat);

def bind_update_fields (input : List Nat) (initial_used : List (List Nat))
    (values : List RecUpdateValue)
    (rewrite_value : List Nat -> List Nat -> RewriteR) : RecUpdateBind :=
  (fix go (remaining : List RecUpdateValue) (used : List (List Nat))
      : RecUpdateBind :=
    match remaining with
    | Nil => RecUpdateBindOk (Nil RecUpdateBound)
    | Cons value rest =>
        match value with
        | MkRecUpdateValue path ty rhs =>
            match fresh_update_name input used with
            | Nothing => RecUpdateBindErr rec_code_malformed
            | Just binder =>
                match rewrite_value ty rhs with
                | RwErr code => RecUpdateBindErr code
                | RwOk rewritten _ =>
                    match go rest (Cons (List Nat) binder used) with
                    | RecUpdateBindErr code => RecUpdateBindErr code
                    | RecUpdateBindOk tail =>
                        RecUpdateBindOk
                          (Cons RecUpdateBound
                            (MkRecUpdateBound path binder ty rewritten) tail)
                    end
                end
            end
        end
    end) values initial_used;

def update_bound_names : List RecUpdateBound -> List (List Nat) :=
  fix update_bound_names (updates : List RecUpdateBound) : List (List Nat) :=
  match updates with
  | Nil => Nil (List Nat)
  | Cons value rest =>
      match value with
      | MkRecUpdateBound _ binder _ _ =>
          Cons (List Nat) binder (update_bound_names rest)
      end
  end;

def update_direct_value (field : List Nat)
    : List RecUpdateBound -> Maybe (List Nat) :=
  fix update_direct_value (updates : List RecUpdateBound) : Maybe (List Nat) :=
  match updates with
  | Nil => Nothing (List Nat)
  | Cons value rest =>
      match value with
      | MkRecUpdateBound path binder _ _ =>
          match path with
          | Nil => update_direct_value rest
          | Cons head tail =>
              match andb(source_bytes_equal head field,
                    match tail with | Nil => True | Cons _ _ => False end) with
              | True => Just (List Nat) binder
              | False => update_direct_value rest
              end
          end
      end
  end;

def update_nested_values (field : List Nat)
    : List RecUpdateBound -> List RecUpdateBound :=
  fix update_nested_values (updates : List RecUpdateBound) : List RecUpdateBound :=
  match updates with
  | Nil => Nil RecUpdateBound
  | Cons value rest =>
      match value with
      | MkRecUpdateBound path binder ty rhs =>
          match path with
          | Nil => update_nested_values rest
          | Cons head tail =>
              match tail with
              | Nil => update_nested_values rest
              | Cons _ _ =>
                  match source_bytes_equal head field with
                  | False => update_nested_values rest
                  | True =>
                      Cons RecUpdateBound
                        (MkRecUpdateBound tail binder ty rhs)
                        (update_nested_values rest)
                  end
              end
          end
      end
  end;

def wrap_update_let (binder : List Nat) (ty : List Nat)
    (value : List Nat) (body : List Nat) : List Nat :=
  append Nat ([108, 101, 116, 32] : List Nat)
    (append Nat binder
      (append Nat s_colonsp
        (append Nat ty
          (append Nat ([32, 58, 61, 32] : List Nat)
            (append Nat value
              (append Nat ([32, 105, 110, 32] : List Nat) body))))));

def wrap_update_values : List RecUpdateBound -> List Nat -> List Nat :=
  fix wrap_update_values (updates : List RecUpdateBound) (body : List Nat)
      : List Nat :=
  match updates with
  | Nil => body
  | Cons value rest =>
      match value with
      | MkRecUpdateBound _ binder ty rhs =>
          wrap_update_let binder ty rhs (wrap_update_values rest body)
      end
  end;

def build_updated_record (reg : RecReg) (source : List Nat)
    (initial_ri : Nat) (initial_base : List Nat)
    (initial_updates : List RecUpdateBound) (initial_used : List (List Nat))
    : RecUpdateBuild :=
  (fix build (fuel : Nat) (ri : Nat) (base : List Nat)
      (updates : List RecUpdateBound) (used : List (List Nat))
      : RecUpdateBuild :=
    match fuel with
    | Z => RecUpdateBuildErr rec_code_malformed
    | S remaining =>
        match reg with
        | MkRecReg _ records _ _ =>
            match nth_rec records ri with
            | Nothing => RecUpdateBuildErr rec_code_unknown
            | Just info =>
                match info with
                | MkRecInfo _ rec_name ctor fields =>
                    let results : RecUpdateFields :=
                      (fix fields_go (todo : List RecField) (idx : Nat)
                          (current_used : List (List Nat)) : RecUpdateFields :=
                        match todo with
                        | Nil => RecUpdateFieldsOk
                            (Nil (Pair Nat (List Nat))) current_used
                        | Cons field rest =>
                            match field with
                            | MkRecField field_name field_ty =>
                                let accessor : List Nat :=
                                  append Nat (acc_name rec_name field_name)
                                    (Cons Nat ch_space_p base) in
                                let nested : List RecUpdateBound :=
                                  update_nested_values field_name updates in
                                let chosen : RecUpdateBuild :=
                                  match update_direct_value field_name updates with
                                  | Just binder => RecUpdateBuildOk binder current_used
                                  | Nothing =>
                                      match nested with
                                      | Nil => RecUpdateBuildOk accessor current_used
                                      | Cons _ _ =>
                                          match type_to_rec reg field_ty with
                                          | Nothing => RecUpdateBuildErr rec_code_unknown
                                          | Just child_ri =>
                                              match fresh_update_name source current_used with
                                              | Nothing => RecUpdateBuildErr rec_code_malformed
                                              | Just child_name =>
                                                  match build remaining child_ri child_name nested
                                                        (Cons (List Nat) child_name current_used) with
                                                  | RecUpdateBuildErr code => RecUpdateBuildErr code
                                                  | RecUpdateBuildOk constructed next_used =>
                                                      RecUpdateBuildOk
                                                        (wrap_update_let child_name field_ty
                                                          accessor constructed) next_used
                                                  end
                                              end
                                          end
                                      end
                                  end in
                                match chosen with
                                | RecUpdateBuildErr code => RecUpdateFieldsErr code
                                | RecUpdateBuildOk value next_used =>
                                    match fields_go rest (S idx) next_used with
                                    | RecUpdateFieldsErr code => RecUpdateFieldsErr code
                                    | RecUpdateFieldsOk tail used_after =>
                                        RecUpdateFieldsOk
                                          (Cons (Pair Nat (List Nat))
                                            (MkPair Nat (List Nat) idx value) tail)
                                          used_after
                                    end
                                end
                            end
                        end) fields Z used in
                    match results with
                    | RecUpdateFieldsErr code => RecUpdateBuildErr code
                    | RecUpdateFieldsOk values final_used =>
                        RecUpdateBuildOk (build_ctor_app ctor fields values) final_used
                    end
                end
            end
        end
    end) (S (length Nat source)) initial_ri initial_base initial_updates initial_used;

def expand_record_update (reg : RecReg) (expected : Maybe Nat)
    (inner : List Nat) (source : List Nat)
    (rewrite_value : Maybe Nat -> List Nat -> RewriteR) : RewriteR :=
  match expected with
  | Nothing => RwErr rec_code_need_ty
  | Just ri =>
      match reg with
      | MkRecReg _ records names _ =>
          match nth_rec records ri with
          | Nothing => RwErr rec_code_need_ty
          | Just info =>
              match info with
              | MkRecInfo _ rec_name _ _ =>
                  match take_until_word w_with inner with
                  | MkPair base after =>
                      match word_at w_with after with
                      | False => RwErr rec_code_malformed
                      | True =>
                          match skip_ws_p base with
                          | Nil => RwErr rec_code_malformed
                          | Cons _ _ =>
                              match parse_update_fields reg ri
                                      (source_drop_prefix w_with after) with
                              | RecUpdateErr code => RwErr code
                              | RecUpdateOk values =>
                                  match fresh_update_name source names with
                                  | Nothing => RwErr rec_code_malformed
                                  | Just base_name =>
                                      match rewrite_value (Just Nat ri) base with
                                      | RwErr code => RwErr code
                                      | RwOk rewritten_base _ =>
                                          match bind_update_fields source
                                                (Cons (List Nat) base_name names) values
                                                (fun (ty : List Nat) (rhs : List Nat) =>
                                                  rewrite_value (type_to_rec reg ty) rhs) with
                                          | RecUpdateBindErr code => RwErr code
                                          | RecUpdateBindOk bound =>
                                              let used : List (List Nat) :=
                                                append (List Nat) (update_bound_names bound)
                                                  (Cons (List Nat) base_name names) in
                                              match build_updated_record reg source ri base_name
                                                    bound used with
                                              | RecUpdateBuildErr code => RwErr code
                                              | RecUpdateBuildOk constructed _ =>
                                                  let lowered : List Nat :=
                                                    wrap_update_let base_name rec_name rewritten_base
                                                      (wrap_update_values bound constructed) in
                                                  RwOk(Cons Nat ch_lparen_p
                                                    (append Nat lowered (n1p ch_rparen_p)), Nil Nat)
                                              end
                                          end
                                      end
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
  end;

inductive RecLocalParse : Type :=
  | RecLocalNone : RecLocalParse
  | RecLocalOk : List Nat -> List Nat -> Maybe Nat -> List Nat -> List Nat -> List Nat -> RecLocalParse;

def source_prefix_before_tail (whole : List Nat) (tail : List Nat) : List Nat :=
  (fix go (xs : List Nat) (acc : List Nat) : List Nat :=
    match eqNat (length Nat xs) (length Nat tail) with
    | True => reverse Nat acc
    | False =>
        match xs with
        | Nil => reverse Nat acc
        | Cons c rest => go rest (Cons Nat c acc)
        end
    end) whole (Nil Nat);

inductive RecLocalBoundary : Type :=
  | RecLocalBoundaryNone : RecLocalBoundary
  | RecLocalBoundaryAt : List Nat -> List Nat -> List Nat -> RecLocalBoundary;

def open_in_tail (after_open : List Nat) : Maybe (List Nat) :=
  match source_take_ident (skip_ws_p after_open) with
  | MkPair alias after_alias =>
      match alias with
      | Nil => Nothing (List Nat)
      | Cons _ _ =>
          match source_take_ident (skip_ws_p after_alias) with
          | MkPair keyword after_in =>
              match source_bytes_equal keyword (n2p 105 110) with
              | True => Just (List Nat) after_in
              | False => Nothing (List Nat)
              end
          end
      end
  end;

def local_end_opener (name : List Nat) : Bool :=
  orb(source_bytes_equal name (n2p 100 111),
    orb(source_bytes_equal name (n5p 109 97 116 99 104),
      source_bytes_equal name (n6p 104 97 110 100 108 101)));

def local_fallible_after (after_let : List Nat) : Bool :=
  match skip_ws_p after_let with
  | Nil => False
  | Cons marker rest =>
      match eqNat marker 63 with
      | False => False
      | True =>
          match skip_ws_p rest with
          | Nil => False
          | Cons opening _ => eqNat opening ch_lparen_p
          end
      end
  end;

def take_local_boundary (input : List Nat) : RecLocalBoundary :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat)
      (depth : Nat) (nested_lets : Nat) (end_depth : Nat) : RecLocalBoundary :=
    match fuel with
    | Z => RecLocalBoundaryNone
    | S remaining =>
        match xs with
        | Nil => RecLocalBoundaryNone
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just copied =>
                match copied with
                | MkPair next_acc next =>
                    go remaining next next_acc depth nested_lets end_depth
                end
            | Nothing =>
                match andb(eqNat depth Z,
                      andb(eqNat end_depth Z, eqNat c ch_semi_p)) with
                | True =>
                    match nested_lets with
                    | Z =>
                        RecLocalBoundaryAt (reverse Nat acc) (n1p ch_semi_p) rest
                    | S _ =>
                        go remaining rest (Cons Nat c acc) depth nested_lets end_depth
                    end
                | False =>
                    match source_is_ident_start c with
                    | False =>
                        go remaining rest (Cons Nat c acc) (bump_depth c depth)
                          nested_lets end_depth
                    | True =>
                        match source_take_ident xs with
                        | MkPair name after =>
                            let next_acc : List Nat := emit acc name in
                            match eqNat depth Z with
                            | False =>
                                go remaining after next_acc depth nested_lets end_depth
                            | True =>
                                match end_depth with
                                | S previous =>
                                    match local_end_opener name with
                                    | True =>
                                        go remaining after next_acc depth nested_lets
                                          (S end_depth)
                                    | False =>
                                        match source_bytes_equal name w_end with
                                        | True =>
                                            go remaining after next_acc depth nested_lets
                                              previous
                                        | False =>
                                            go remaining after next_acc depth nested_lets
                                              end_depth
                                        end
                                    end
                                | Z =>
                                    match local_end_opener name with
                                    | True =>
                                        go remaining after next_acc depth nested_lets (S Z)
                                    | False =>
                                        match source_bytes_equal name (n2p 105 110) with
                                        | True =>
                                            match nested_lets with
                                            | Z => RecLocalBoundaryAt (reverse Nat acc)
                                                (n2p 105 110) after
                                            | S previous =>
                                                go remaining after next_acc depth previous Z
                                            end
                                        | False =>
                                            match source_bytes_equal name
                                                  (n4p 111 112 101 110) with
                                            | True =>
                                                match open_in_tail after with
                                                | Just after_in =>
                                                    go remaining after_in
                                                      (emit acc
                                                        (source_prefix_before_tail xs after_in))
                                                      depth nested_lets Z
                                                | Nothing =>
                                                    go remaining after next_acc depth nested_lets Z
                                                end
                                            | False =>
                                                match source_bytes_equal name w_let_p with
                                                | False =>
                                                    go remaining after next_acc depth nested_lets Z
                                                | True =>
                                                    match local_fallible_after after with
                                                    | True =>
                                                        go remaining after next_acc depth nested_lets Z
                                                    | False =>
                                                        match skip_ws_p after with
                                                        | Cons brace _ =>
                                                            match eqNat brace ch_lbrace_p with
                                                            | True =>
                                                                go remaining after next_acc depth
                                                                  nested_lets Z
                                                            | False =>
                                                                go remaining after next_acc depth
                                                                  (S nested_lets) Z
                                                            end
                                                        | Nil =>
                                                            go remaining after next_acc depth
                                                              (S nested_lets) Z
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input (Nil Nat) Z Z Z;

def parse_scoped_local (reg : RecReg) (input : List Nat) : RecLocalParse :=
  match source_take_ident (skip_ws_p input) with
  | MkPair keyword after_let =>
      match source_bytes_equal keyword w_let_p with
      | False => RecLocalNone
      | True =>
          match source_take_ident (skip_ws_p after_let) with
          | MkPair binder after_binder =>
              match binder with
              | Nil => RecLocalNone
              | Cons _ _ =>
                  match take_until_coloneq after_binder with
                  | MkPair header assignment =>
                      match assignment with
                      | Nil => RecLocalNone
                      | Cons colon after_colon =>
                          match after_colon with
                          | Nil => RecLocalNone
                          | Cons equals rhs =>
                              match andb(eqNat colon ch_colon_p, eqNat equals ch_eq_p) with
                              | False => RecLocalNone
                              | True =>
                                  let expected : Maybe Nat :=
                                    match skip_ws_p header with
                                    | Cons first ty =>
                                        match eqNat first ch_colon_p with
                                        | True => type_to_rec reg ty
                                        | False => Nothing Nat
                                        end
                                    | Nil => Nothing Nat
                                    end in
                                  match take_local_boundary rhs with
                                  | RecLocalBoundaryNone => RecLocalNone
                                  | RecLocalBoundaryAt value separator body =>
                                      RecLocalOk binder
                                        (source_prefix_before_tail input rhs)
                                        expected value separator body
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
  end;

inductive RecAscription : Type :=
  | RecAscriptionNone : RecAscription
  | RecAscriptionOk : List Nat -> List Nat -> Nat -> List Nat -> List Nat -> RecAscription;

def parse_direct_record_ascription (reg : RecReg) (input : List Nat)
    : RecAscription :=
  match skip_ws_p input with
  | Cons opening _ =>
      match eqNat opening ch_lparen_p with
      | False => RecAscriptionNone
      | True =>
          match take_until_char ch_lparen_p input with
          | MkPair before opening_source =>
              match opening_source with
              | Cons _ inside =>
                  match take_until_char ch_rparen_p inside with
                  | MkPair content closing =>
                      match closing with
                      | Cons paren _ =>
                          match eqNat paren ch_rparen_p with
                          | False => RecAscriptionNone
                          | True =>
                              match take_until_char ch_colon_p content with
                              | MkPair value annotation =>
                                  match annotation with
                                  | Cons colon ty =>
                                      match eqNat colon ch_colon_p with
                                      | False => RecAscriptionNone
                                      | True =>
                                          match matching_brace (skip_ws_p value) with
                                          | Nothing => RecAscriptionNone
                                          | Just braced =>
                                              match braced with
                                              | MkPair _ after_brace =>
                                                  match skip_ws_p after_brace with
                                                  | Cons _ _ => RecAscriptionNone
                                                  | Nil =>
                                                      match type_to_rec reg ty with
                                                      | Nothing => RecAscriptionNone
                                                      | Just ri =>
                                                          RecAscriptionOk
                                                            (append Nat before (n1p ch_lparen_p))
                                                            value ri
                                                            (append Nat annotation (n1p ch_rparen_p))
                                                            (source_drop_prefix (n1p ch_rparen_p) closing)
                                                      end
                                                  end
                                              end
                                          end
                                      end
                                  | Nil => RecAscriptionNone
                                  end
                              end
                          end
                      | Nil => RecAscriptionNone
                      end
                  end
              | Nil => RecAscriptionNone
              end
          end
      end
  | Nil => RecAscriptionNone
  end;

def grouped_local_body (input : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match input with
  | Nil => Nothing (Pair (List Nat) (List Nat))
  | Cons opening rest =>
      match eqNat opening ch_lparen_p with
      | False => Nothing (Pair (List Nat) (List Nat))
      | True =>
          match take_until_char ch_rparen_p rest with
          | MkPair content closing =>
              match closing with
              | Nil => Nothing (Pair (List Nat) (List Nat))
              | Cons closer tail =>
                  match eqNat closer ch_rparen_p with
                  | False => Nothing (Pair (List Nat) (List Nat))
                  | True =>
                      match source_take_ident (skip_ws_p content) with
                      | MkPair keyword _ =>
                          match source_bytes_equal keyword w_let_p with
                          | False => Nothing (Pair (List Nat) (List Nat))
                          | True =>
                              match take_until_char ch_comma_p content with
                              | MkPair _ after_comma =>
                                  match after_comma with
                                  | Nil =>
                                      Just (Pair (List Nat) (List Nat))
                                        (MkPair (List Nat) (List Nat) content tail)
                                  | Cons _ _ => Nothing (Pair (List Nat) (List Nat))
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
  end;

-- Nested expansion and suffix scans each consume an explicit input-sized bound.
def rewrite_expr (reg : RecReg) (env : RecEnv) (initial_expected : Maybe Nat)
    (input : List Nat) : RewriteR :=
  (fix rewrite_expr (depth_fuel : Nat) (current_env : RecEnv)
      (expected : Maybe Nat) (xs0 : List Nat) : RewriteR :=
    match depth_fuel with
    | Z => RwErr rec_code_malformed
    | S depth_left =>
        match parse_scoped_local reg xs0 with
        | RecLocalOk binder prefix binding_expected rhs separator body =>
            match rewrite_expr depth_left current_env binding_expected rhs with
            | RwErr code => RwErr code
            | RwOk rewritten_rhs _ =>
                let body_env : RecEnv :=
                  match binding_expected with
                  | Just ri => env_add current_env binder ri
                  | Nothing => env_mask current_env reg binder
                  end in
                match rewrite_expr depth_left body_env expected body with
                | RwErr code => RwErr code
                | RwOk rewritten_body _ =>
                    RwOk(append Nat prefix
                      (append Nat rewritten_rhs
                        (append Nat separator rewritten_body)), Nil Nat)
                end
            end
        | RecLocalNone =>
        (fix go (scan_fuel : Nat) (xs : List Nat) (acc : List Nat) : RewriteR :=
          match scan_fuel with
          | Z => RwErr rec_code_malformed
          | S scan_left =>
              match xs with
              | Nil => RwOk(reverse Nat acc, Nil Nat)
              | Cons c rest =>
                  match source_copy_comment_or_string acc xs with
                  | Just p =>
                      match p with
                      | MkPair acc2 xs2 => go scan_left xs2 acc2
                      end
                  | Nothing =>
                      match eqNat c ch_lbrace_p with
                      | True =>
                          match matching_brace xs with
                          | Nothing => RwErr rec_code_malformed
                          | Just br =>
                              match br with
                              | MkPair body tail =>
                                  match top_has_with (strip_braces body) with
                                  | True =>
                                      let brace_expected : Maybe Nat :=
                                        match skip_ws_p (reverse Nat acc) with
                                        | Nil => expected
                                        | Cons _ _ => Nothing Nat
                                        end in
                                      match expand_record_update reg brace_expected
                                              (strip_braces body) xs0
                                              (fun (m : Maybe Nat) (value : List Nat) =>
                                                rewrite_expr depth_left current_env m value) with
                                      | RwErr code => RwErr code
                                      | RwOk update _ =>
                                          match rewrite_expr depth_left current_env
                                                  (Nothing Nat) update with
                                          | RwErr code => RwErr code
                                          | RwOk expanded _ =>
                                              go scan_left tail (emit acc expanded)
                                          end
                                      end
                                  | False =>
                                      match orb(top_has_assign (strip_braces body),
                                          top_starts_pun (strip_braces body)) with
                                      | False => go scan_left tail (emit acc body)
                                      | True =>
                                          let brace_expected : Maybe Nat :=
                                            match skip_ws_p (reverse Nat acc) with
                                            | Nil => expected
                                            | Cons _ _ => Nothing Nat
                                            end in
                                          match brace_expected with
                                          | Nothing => RwErr rec_code_need_ty
                                          | Just ri =>
                                              match reg with
                                              | MkRecReg _ recs _ _ =>
                                                  match nth_rec recs ri with
                                                  | Nothing => RwErr rec_code_need_ty
                                                  | Just info =>
                                                      match info with
                                                      | MkRecInfo _ _ ctor fs =>
                                                          match fill_literal fs ctor
                                                                  (strip_braces body)
                                                                  (fun (idx : Nat) (value : List Nat) =>
                                                                    match update_field_type fs idx with
                                                                    | Nothing => RwErr rec_code_unknown
                                                                    | Just ty =>
                                                                        rewrite_expr depth_left
                                                                          current_env (type_to_rec reg ty)
                                                                          value
                                                                    end) with
                                                          | RwErr e => RwErr e
                                                          | RwOk lit _ =>
                                                              match rewrite_expr depth_left current_env
                                                                      (Nothing Nat) lit with
                                                              | RwErr e => RwErr e
                                                              | RwOk lit2 _ =>
                                                                  go scan_left tail (emit acc lit2)
                                                              end
                                                          end
                                                      end
                                                  end
                                              end
                                          end
                                      end
                                  end
                              end
                          end
                      | False =>
                          match eqNat c ch_lparen_p with
                          | True =>
                              match parse_direct_record_ascription reg xs with
                              | RecAscriptionOk prefix value ri annotation tail =>
                                  match rewrite_expr depth_left current_env (Just Nat ri) value with
                                  | RwErr code => RwErr code
                                  | RwOk rewritten _ =>
                                      go scan_left tail
                                        (emit acc
                                          (append Nat prefix
                                            (append Nat rewritten annotation)))
                                  end
                              | RecAscriptionNone =>
                                  match grouped_local_body xs with
                                  | Nothing => go scan_left rest (Cons Nat c acc)
                                  | Just grouped =>
                                      match grouped with
                                      | MkPair content tail =>
                                          let group_expected : Maybe Nat :=
                                            match skip_ws_p (reverse Nat acc) with
                                            | Nil => expected
                                            | Cons _ _ => Nothing Nat
                                            end in
                                          match rewrite_expr depth_left current_env
                                                group_expected content with
                                          | RwErr code => RwErr code
                                          | RwOk rewritten _ =>
                                              let wrapped : List Nat :=
                                                Cons Nat ch_lparen_p
                                                  (append Nat rewritten (n1p ch_rparen_p)) in
                                              go scan_left tail (emit acc wrapped)
                                          end
                                      end
                                  end
                              end
                          | False =>
                          match source_is_ident_start c with
                          | True =>
                              match source_take_ident xs with
                              | MkPair id after =>
                                  match source_bytes_equal id w_let_p with
                                  | True =>
                                      match skip_ws_p after with
                                      | Cons brace _ =>
                                          match eqNat brace ch_lbrace_p with
                                          | True =>
                                              match take_until_char ch_lbrace_p after with
                                              | MkPair trivia block_start =>
                                                  match matching_brace block_start with
                                                  | Nothing => RwErr rec_code_malformed
                                                  | Just block =>
                                                      match block with
                                                      | MkPair body tail =>
                                                          let block_expected : Maybe Nat :=
                                                            match skip_ws_p (reverse Nat acc) with
                                                            | Nil => expected
                                                            | Cons _ _ => Nothing Nat
                                                            end in
                                                          match rewrite_expr depth_left current_env block_expected
                                                                  (strip_braces body) with
                                                          | RwErr code => RwErr code
                                                          | RwOk inner _ =>
                                                              let a1 : List Nat := emit(emit acc id, trivia) in
                                                              let a2 : List Nat := emit
                                                                (Cons Nat ch_lbrace_p a1) inner in
                                                              go scan_left tail
                                                                (Cons Nat ch_rbrace_p a2)
                                                          end
                                                      end
                                                  end
                                              end
                                          | False => go scan_left after (emit acc id)
                                          end
                                      | Nil => go scan_left after (emit acc id)
                                      end
                                  | False =>
                                  match after with
                                  | Cons d after2 =>
                                      match eqNat d ch_dot_p with
                                      | True =>
                                          match source_take_ident after2 with
                                          | MkPair fld after3 =>
                                              match fld with
                                              | Nil => RwErr rec_code_proj
                                              | Cons _ _ =>
                                                  match env_lookup current_env reg id with
                                                  | Nothing => RwErr rec_code_proj
                                                  | Just ri =>
                                                      match reg with
                                                      | MkRecReg _ recs _ _ =>
                                                          match nth_rec recs ri with
                                                          | Nothing => RwErr rec_code_proj
                                                          | Just info =>
                                                              match info with
                                                              | MkRecInfo _ rname _ rfs =>
                                                                  match find_field_idx
                                                                          fld rfs with
                                                                  | Nothing =>
                                                                      RwErr rec_code_proj
                                                                  | Just _ =>
                                                                      let a1 : List Nat :=
                                                                        emit acc
                                                                          (acc_name rname fld) in
                                                                      go scan_left after3
                                                                        (emit(Cons Nat ch_space_p a1, id))
                                                                  end
                                                              end
                                                          end
                                                      end
                                                  end
                                              end
                                          end
                                      | False => go scan_left after (emit acc id)
                                      end
                                  | Nil => go scan_left after (emit acc id)
                                  end
                                  end
                              end
                          | False => go scan_left rest (Cons Nat c acc)
                          end
                          end
                      end
                  end
              end
          end) (S (length Nat xs0)) xs0 (Nil Nat)
        end
    end) (S (length Nat input)) env initial_expected input;

def parse_param_env (reg : RecReg) (env : RecEnv) (seg : List Nat) : RecEnv :=
  match take_until_char ch_colon_p seg with
  | MkPair before after =>
      match after with
      | Cons _ ty0 =>
          match type_to_rec reg ty0 with
          | Nothing => env
          | Just ri =>
              (fix go (scan_fuel : Nat) (xs : List Nat) (e : RecEnv) : RecEnv :=
                match scan_fuel with
                | Z => e
                | S remaining =>
                    let xs1 : List Nat := skip_ws_p xs in
                    match xs1 with
                    | Nil => e
                    | Cons c rest =>
                        match source_is_ident_start c with
                        | True =>
                            match source_take_ident xs1 with
                            | MkPair id rest2 => go remaining rest2 (env_add e id ri)
                            end
                        | False => go remaining rest e
                        end
                    end
                end) (S (length Nat before)) before env
          end
      | Nil => env
      end
  end;

def parse_def_header (reg : RecReg) (src : List Nat) : DefHead :=
  match source_take_ident (skip_ws_p (source_drop_prefix w_def src)) with
  | MkPair name rest =>
      match name with
      | Nil => NoHead
      | Cons _ _ =>
          (fix go (scan_fuel : Nat) (xs : List Nat) (env : RecEnv) : DefHead :=
            match scan_fuel with
            | Z => NoHead
            | S remaining =>
                let xs1 : List Nat := skip_ws_p xs in
                match xs1 with
                | Nil => NoHead
                | Cons c rest2 =>
                    match eqNat c ch_lparen_p with
                    | True =>
                        match take_until_char ch_rparen_p rest2 with
                        | MkPair inside afterp =>
                            let env2 : RecEnv := parse_param_env reg env inside in
                            match afterp with
                            | Cons _ r => go remaining r env2
                            | Nil => NoHead
                            end
                        end
                    | False =>
                        match eqNat c ch_colon_p with
                        | True =>
                            match take_until_coloneq rest2 with
                            | MkPair ret rest3 =>
                                match rest3 with
                                | Cons _ rest4 =>
                                    match rest4 with
                                    | Cons _ body0 =>
                                        match take_until_char ch_semi_p body0 with
                                        | MkPair body tail =>
                                            MkHead name env (type_to_rec reg ret)
                                              body tail
                                        end
                                    | Nil => NoHead
                                    end
                                | Nil => NoHead
                                end
                            end
                        | False => NoHead
                        end
                    end
                end
            end) (S (length Nat rest)) rest empty_rec_env
      end
  end;

def register_global (reg : RecReg) (name : List Nat) (ri : Nat) : RecReg :=
  match reg with
  | MkRecReg _ recs names gs =>
      MkRecReg Z recs names (Cons RecBind (MkRecBind name ri) gs)
  end;

def cut_prefix (a : List Nat) (b : List Nat) : List Nat :=
  (fix go (xs : List Nat) (acc : List Nat) : List Nat :=
    match source_starts b xs with
    | True => reverse Nat acc
    | False =>
        match xs with
        | Nil => reverse Nat acc
        | Cons c rest => go(rest, Cons Nat c acc)
        end
    end) a (Nil Nat);

def rewrite_defs (reg0 : RecReg) (src : List Nat) : Pair RecReg PrepResult :=
  (fix go (scan_fuel : Nat) (reg : RecReg) (xs : List Nat) (acc : List Nat)
      : Pair RecReg PrepResult :=
    match scan_fuel with
    | Z => MkPair RecReg PrepResult reg (PrepErr rec_code_malformed Z)
    | S remaining =>
        match xs with
        | Nil => MkPair RecReg PrepResult reg (PrepOk (reverse Nat acc))
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just p =>
                match p with
                | MkPair acc2 xs2 => go remaining reg xs2 acc2
                end
            | Nothing =>
                match source_is_ident_start c with
                | True =>
                    match source_take_ident xs with
                    | MkPair id after =>
                        match source_bytes_equal id w_def with
                        | True =>
                            match parse_def_header reg xs with
                            | NoHead => go remaining reg after (emit acc id)
                            | MkHead name env mrec body tail =>
                                match rewrite_expr reg env mrec body with
                                | RwErr e =>
                                    MkPair RecReg PrepResult reg (PrepErr e Z)
                                | RwOk body2 _ =>
                                    let header : List Nat := cut_prefix xs body in
                                    let a2 : List Nat := emit(emit acc header, body2) in
                                    let a3 : List Nat :=
                                      match tail with
                                      | Cons sc _ =>
                                          match eqNat sc ch_semi_p with
                                          | True => Cons Nat ch_semi_p a2
                                          | False => a2
                                          end
                                      | Nil => a2
                                      end in
                                    let tail2 : List Nat :=
                                      match tail with
                                      | Cons sc restt =>
                                          match eqNat sc ch_semi_p with
                                          | True => restt
                                          | False => tail
                                          end
                                      | Nil => tail
                                      end in
                                    let reg2 : RecReg :=
                                      match mrec with
                                      | Just ri => register_global reg name ri
                                      | Nothing => reg
                                      end in
                                    go remaining reg2 tail2 a3
                                end
                            end
                        | False => go remaining reg after (emit acc id)
                        end
                    end
                | False => go remaining reg rest (Cons Nat c acc)
                end
            end
        end
    end) (S (length Nat src)) reg0 src (Nil Nat);

-- @export preprocess_records_reg; @doc docs/syntax.md
def preprocess_records_reg (reg0 : RecReg) (src : List Nat)
    : Pair RecReg PrepResult :=
  match orb(src_has_record_keyword src, rec_reg_has_recs reg0) with
  | False => MkPair RecReg PrepResult reg0 (PrepOk src)
  | True =>
      let names : List (List Nat) := collect_decl_names src in
      let reg1 : RecReg :=
        match reg0 with
        | MkRecReg _tag recs old gs =>
            MkRecReg Z recs (append (List Nat) names old) gs
        end in
      match expand_record_decls reg1 src with
      | MkPair reg2 r1 =>
          match r1 with
          | PrepErr c d => MkPair RecReg PrepResult reg2 (PrepErr c d)
          | PrepOk mid => rewrite_defs reg2 mid
          end
      end
  end;

-- @entry preprocess_records
-- @export preprocess_records; @doc docs/syntax.md
def preprocess_records (src : List Nat) : PrepResult :=
  match preprocess_records_reg empty_rec_reg src with
  | MkPair _reg r => r
  end;
