-- Explicit primitive identities shared by checking and native lowering.
-- This leaf model deliberately does not import the declaration checker or a
-- backend. Core references remain CConst IDs; spelling is decoded only at an
-- intrinsic declaration. A same-named axiom is never a primitive binding.
--
-- Machine types and operations remain opaque to conversion. Checked pure
-- String operations reduce over resolved byte literals and checked roles.
-- Runtime A has no eliminator to A. Runtime pure/bind/loop construct actions;
-- only execution runs them. The loop tests a U8 condition (zero stops) before
-- each step; it has no structural termination claim. CFix is unchanged.
--
-- Word widths are 8,32,64,32,64 for U8,U32,U64,I32,USize on Windows x64.
-- I32 alone is signed. Wrapping add/sub/mul keep low bits; right shift is
-- arithmetic for I32 and logical otherwise. Shift counts are U32 and masked
-- by width-1. Checked add/sub/mul reject mathematical range overflow. Checked
-- div/rem reject zero and the I32 MIN/-1 pair; otherwise division truncates
-- toward zero and a nonzero remainder has the dividend's sign. They return
-- Maybe word, never a trapping pure value. Native unchecked divide is not a
-- registered pure operation. Nat conversions preserve mathematical Nat:
-- from_nat is checked, to_nat interprets I32 as its unsigned bit pattern.
-- Narrow.wrap truncates, zext extends unsigned bits, sext extends I32's sign,
-- reinterpret preserves equal-width bits, checked conversion checks the
-- numeric destination range (including negative I32 to unsigned rejection).
--
-- Raw operations are explicit unsafe runtime actions, except typed null.
-- add.wrap adds a byte offset modulo 2^64; casts preserve address bits. None
-- establishes bounds, alignment, ownership, lifetime, or a managed root.
-- Load/store only support a separately validated raw storage type. They do
-- not accept arbitrary proof values through the generic Core signature.
-- RawFn S is distinct from a closure. A call adapter requires a concrete,
-- nondependent machine signature S ending in Runtime R; there is no generic
-- (S : Type) -> RawFn S -> S primitive. Unknown calls conservatively MayGc.
-- NoGc on an extern is an explicit unsafe contract, not a foreign-code proof;
-- checking transitive NoGc bodies belongs to the later call-graph pass.
--
-- String denotes a length-based sequence of bytes, including NUL and 255.
-- length/byte_at/slice offsets count bytes. byte_at outside the string is zero;
-- slice clamps its bounds. of_char_codes uses each Nat modulo 256. String
-- equality/order/search operate on bytes. Decimal of_nat has no sign. These
-- contracts describe the new intrinsic path, not the NUL-based legacy host.
-- index reports the first match; an empty pattern matches at byte zero.
-- split preserves empty fields; a separator above 255 never matches.
-- replace scans nonoverlapping matches and an empty pattern leaves input
-- unchanged. tokens splits on ASCII space, tab, LF and CR, omitting empties.
-- Result roles use checked inductive identities and constructor order:
-- Nat=Z,S; Bool=True,False; Unit=unit; List=Nil,Cons; Maybe=Nothing,Just;
-- Pair has one constructor. No source name grants one of these roles.

import "core.ouro";

inductive PrimitiveWord : Type :=
  | PrimitiveWordU8 : PrimitiveWord | PrimitiveWordU32 : PrimitiveWord
  | PrimitiveWordU64 : PrimitiveWord | PrimitiveWordI32 : PrimitiveWord
  | PrimitiveWordUSize : PrimitiveWord;

inductive PrimitiveWordOp : Type :=
  | PrimitiveAddWrap : PrimitiveWordOp | PrimitiveSubWrap : PrimitiveWordOp
  | PrimitiveMulWrap : PrimitiveWordOp | PrimitiveBitAnd : PrimitiveWordOp
  | PrimitiveBitOr : PrimitiveWordOp | PrimitiveBitXor : PrimitiveWordOp
  | PrimitiveShiftLeft : PrimitiveWordOp | PrimitiveShiftRight : PrimitiveWordOp
  | PrimitiveWordEqual : PrimitiveWordOp | PrimitiveWordLess : PrimitiveWordOp
  | PrimitiveAddChecked : PrimitiveWordOp | PrimitiveSubChecked : PrimitiveWordOp
  | PrimitiveMulChecked : PrimitiveWordOp | PrimitiveDivChecked : PrimitiveWordOp
  | PrimitiveRemChecked : PrimitiveWordOp;

inductive PrimitiveConversion : Type :=
  | PrimitiveNarrowWrap : PrimitiveConversion | PrimitiveZeroExtend : PrimitiveConversion
  | PrimitiveSignExtend : PrimitiveConversion | PrimitiveReinterpret : PrimitiveConversion
  | PrimitiveConvertChecked : PrimitiveConversion;

inductive PrimitiveStringOp : Type :=
  | PrimitiveStringConcat : PrimitiveStringOp | PrimitiveStringLength : PrimitiveStringOp
  | PrimitiveStringByteAt : PrimitiveStringOp | PrimitiveStringSlice : PrimitiveStringOp
  | PrimitiveStringEqual : PrimitiveStringOp | PrimitiveStringOfNat : PrimitiveStringOp
  | PrimitiveStringToCodes : PrimitiveStringOp | PrimitiveStringOfCodes : PrimitiveStringOp
  | PrimitiveStringStarts : PrimitiveStringOp | PrimitiveStringEnds : PrimitiveStringOp
  | PrimitiveStringContains : PrimitiveStringOp | PrimitiveStringIndex : PrimitiveStringOp
  | PrimitiveStringSplit : PrimitiveStringOp | PrimitiveStringReplace : PrimitiveStringOp
  | PrimitiveStringLessEqual : PrimitiveStringOp | PrimitiveStringTokens : PrimitiveStringOp;

inductive PrimitiveId : Type :=
  | PrimitiveU8Type : PrimitiveId | PrimitiveU32Type : PrimitiveId
  | PrimitiveU64Type : PrimitiveId | PrimitiveI32Type : PrimitiveId
  | PrimitiveUSizeType : PrimitiveId | PrimitiveRawPtrType : PrimitiveId
  | PrimitiveRuntimeType : PrimitiveId | PrimitiveRawFnType : PrimitiveId
  | PrimitiveStringType : PrimitiveId
  | PrimitiveWordOperation : PrimitiveWord -> PrimitiveWordOp -> PrimitiveId
  | PrimitiveWordConversion : PrimitiveWord -> PrimitiveWord -> PrimitiveConversion -> PrimitiveId
  | PrimitiveWordFromNat : PrimitiveWord -> PrimitiveId
  | PrimitiveWordToNat : PrimitiveWord -> PrimitiveId
  | PrimitiveStringOperation : PrimitiveStringOp -> PrimitiveId
  | PrimitiveRuntimePure : PrimitiveId | PrimitiveRuntimeBind : PrimitiveId
  | PrimitiveRuntimeLoop : PrimitiveId | PrimitiveRawNull : PrimitiveId
  | PrimitiveRawLoad : PrimitiveId | PrimitiveRawStore : PrimitiveId
  | PrimitiveRawAddWrap : PrimitiveId | PrimitiveRawCast : PrimitiveId
  | PrimitiveRawToBits : PrimitiveId | PrimitiveRawFromBits : PrimitiveId
  | PrimitiveFnCall : PrimitiveId
  | PrimitiveStdoutWrite : PrimitiveId | PrimitiveStderrWrite : PrimitiveId
  | PrimitiveStdoutFlush : PrimitiveId | PrimitiveProcessExit : PrimitiveId
  | PrimitiveArgv : PrimitiveId | PrimitiveEnvGet : PrimitiveId
  | PrimitiveTimeNow : PrimitiveId
  | PrimitiveStdinReadLine : PrimitiveId | PrimitiveStdinReadBytes : PrimitiveId
  | PrimitiveFileRead : PrimitiveId | PrimitiveFileWrite : PrimitiveId
  | PrimitiveFileKind : PrimitiveId
  | PrimitiveFileExists : PrimitiveId | PrimitiveFileIsDirectory : PrimitiveId
  | PrimitiveFileRealpath : PrimitiveId
  | PrimitiveDirectoryList : PrimitiveId | PrimitiveDirectoryListable : PrimitiveId
  | PrimitiveDirectoryCreate : PrimitiveId | PrimitivePathRemove : PrimitiveId
  | PrimitiveFileCopy : PrimitiveId
  | PrimitiveFileRename : PrimitiveId
  | PrimitiveFileReplace : PrimitiveId
  | PrimitiveFileTemp : PrimitiveId | PrimitiveFileTempIn : PrimitiveId
  | PrimitiveProcessCapture : PrimitiveId | PrimitiveHttpPost : PrimitiveId
  | PrimitiveProcessInherit : PrimitiveId
  | PrimitiveProcessBounded : PrimitiveId;

-- The third field is the previously checked declaration type, not a body.
-- A checker supplies canonical type identity bindings; transparent aliases
-- are handled by its bounded, pure normalizer and ordinary conversion check.
inductive PrimitiveResolved : Type :=
  | PrimitiveResolvedAs : Nat -> PrimitiveId -> CoreTerm -> PrimitiveResolved;

inductive PrimitiveRole : Type :=
  | PrimitiveNatRole : PrimitiveRole | PrimitiveBoolRole : PrimitiveRole
  | PrimitiveUnitRole : PrimitiveRole | PrimitiveListRole : PrimitiveRole
  | PrimitiveMaybeRole : PrimitiveRole | PrimitivePairRole : PrimitiveRole
  | PrimitiveRangeBoundRole : PrimitiveRole | PrimitiveRangeRole : PrimitiveRole;

-- ind-ID, parameter count, index count, full family type, full constructor
-- types in ordinal order. Build this view from an already checked IndDecl;
-- validation checks every field and constructor, not only the family head.
inductive PrimitiveInductiveShape : Type :=
  | PrimitiveInductiveOf : Nat -> Nat -> Nat -> CoreTerm -> List CoreTerm -> PrimitiveInductiveShape;
inductive PrimitiveRoleBinding : Type :=
  | PrimitiveRoleOf : PrimitiveRole -> PrimitiveInductiveShape -> PrimitiveRoleBinding;

inductive PrimitiveGc : Type :=
  | PrimitiveNoGc : PrimitiveGc | PrimitiveMayGc : PrimitiveGc;
inductive PrimitiveExecution : Type :=
  | PrimitiveTypeOnly : PrimitiveExecution | PrimitivePureValue : PrimitiveExecution
  | PrimitiveRuntimeAction : PrimitiveExecution;

inductive PrimitiveTarget : Type := | PrimitiveWindowsX64 : PrimitiveTarget;
inductive PrimitiveAbi : Type := | PrimitiveWin64 : PrimitiveAbi;

-- Pointer pointees and function signatures remain in metadata after ABI
-- classification. Aggregates, managed values and dependent parameters are
-- not scalar ABI values. Unit is represented by Nothing only in result position.
inductive PrimitiveAbiValue : Type :=
  | PrimitiveAbiWord : PrimitiveWord -> PrimitiveAbiValue
  | PrimitiveAbiPointer : CoreTerm -> PrimitiveAbiValue
  | PrimitiveAbiFunction : CoreTerm -> PrimitiveAbiValue;
inductive PrimitiveAbiSignature : Type :=
  | PrimitiveAbiSignatureOf : List PrimitiveAbiValue -> Maybe PrimitiveAbiValue -> PrimitiveAbiSignature;

-- Raw target/ABI/DLL/symbol byte strings are checked before a CheckedExtern
-- is built. DLL and symbol bytes are nonempty ASCII without NUL; target and
-- ABI spellings are exact. Only fixed-arity Windows x64 is supported here.
inductive ExternRequest : Type :=
  | ExternRequestOf : List Nat -> List Nat -> List Nat -> List Nat -> Bool -> PrimitiveGc -> ExternRequest;
inductive CheckedExtern : Type :=
  | CheckedExternOf : PrimitiveTarget -> PrimitiveAbi -> List Nat -> List Nat
      -> PrimitiveAbiSignature -> PrimitiveGc -> CheckedExtern;
inductive PrimitiveBinding : Type :=
  | PrimitiveIntrinsicBinding : PrimitiveId -> PrimitiveExecution -> PrimitiveGc -> Maybe CoreTerm -> PrimitiveBinding
  | PrimitiveExternBinding : CheckedExtern -> PrimitiveBinding;

-- Layout fields are ordered by offset, never overlap, and have unique IDs.
-- Size is positive, <=2^31-1 and a multiple of a power-of-two alignment <=4096.
-- Natural layouts align each field and the aggregate; packed layouts may
-- lower field alignment explicitly. No by-value aggregate FFI is implied.
inductive PrimitiveRawField : Type :=
  | PrimitiveRawFieldAt : Nat -> Nat -> PrimitiveAbiValue -> PrimitiveRawField;
inductive PrimitiveRawLayout : Type :=
  | PrimitiveRawLayoutOf : Nat -> Nat -> Bool -> List PrimitiveRawField -> PrimitiveRawLayout;
inductive PrimitiveCheckedLayout : Type :=
  | PrimitiveLayoutChecked : PrimitiveRawLayout -> PrimitiveCheckedLayout;

inductive PrimitiveLayoutFault : Type :=
  | PrimitiveLayoutSize : PrimitiveLayoutFault | PrimitiveLayoutAlignment : PrimitiveLayoutFault
  | PrimitiveLayoutFieldRange : Nat -> PrimitiveLayoutFault
  | PrimitiveLayoutFieldAlignment : Nat -> PrimitiveLayoutFault
  | PrimitiveLayoutFieldOverlap : Nat -> PrimitiveLayoutFault
  | PrimitiveLayoutDuplicateField : Nat -> PrimitiveLayoutFault;

inductive PrimitiveError : Type :=
  | PrimitiveResourceExhausted : PrimitiveError | PrimitiveUnknownKey : PrimitiveError
  | PrimitiveMissingType : PrimitiveId -> PrimitiveError
  | PrimitiveDuplicateType : PrimitiveId -> PrimitiveError
  | PrimitiveDuplicateName : Nat -> PrimitiveError
  | PrimitiveInvalidTypeBinding : Nat -> PrimitiveError
  | PrimitiveMissingRole : PrimitiveRole -> PrimitiveError
  | PrimitiveDuplicateRole : PrimitiveRole -> PrimitiveError
  | PrimitiveInvalidRole : PrimitiveRole -> PrimitiveError
  | PrimitiveUnsupportedTarget : PrimitiveError | PrimitiveUnsupportedAbi : PrimitiveError
  | PrimitiveInvalidExternName : PrimitiveError | PrimitiveVariadicExtern : PrimitiveError
  | PrimitiveDependentAbi : PrimitiveError | PrimitiveUnsupportedAbiType : PrimitiveError
  | PrimitiveRuntimeResultRequired : PrimitiveError | PrimitiveInvalidFunctionPointer : PrimitiveError
  | PrimitiveSpecializationRequired : PrimitiveError | PrimitiveUnexpectedSpecialization : PrimitiveError
  | PrimitiveInvalidConversion : PrimitiveError
  | PrimitiveInvalidLayout : PrimitiveLayoutFault -> PrimitiveError;
