-- Representation annotations bind runtime roles to checked inductive identities.
-- Spelling selects a contract; names and constructor names grant no authority.

import "primitive_check.ouro",
  "../std/types.ouro",
  "primitive_model.ouro",
  "primitive_contracts.ouro",
  "primitive_registry_base.ouro",
  "file_check_model.ouro",
  "file_elab_term.ouro",
  "file_check_environment.ouro",
  "file_check_result.ouro";

def primitive_role_keys : List (Pair PrimitiveRole (List Nat)) :=
    ([ MkPair PrimitiveRole (List Nat) PrimitiveNatRole
        ([111, 117, 114, 111, 46, 110, 97, 116] : List Nat)
    , MkPair PrimitiveRole (List Nat) PrimitiveBoolRole
        ([111, 117, 114, 111, 46, 98, 111, 111, 108] : List Nat)
    , MkPair PrimitiveRole (List Nat) PrimitiveUnitRole
        ([111, 117, 114, 111, 46, 117, 110, 105, 116] : List Nat)
    , MkPair PrimitiveRole (List Nat) PrimitiveListRole
        ([111, 117, 114, 111, 46, 108, 105, 115, 116] : List Nat)
    , MkPair PrimitiveRole (List Nat) PrimitiveMaybeRole
        ([111, 117, 114, 111, 46, 109, 97, 121, 98, 101] : List Nat)
    , MkPair PrimitiveRole (List Nat) PrimitivePairRole
        ([111, 117, 114, 111, 46, 112, 97, 105, 114] : List Nat)
    , MkPair PrimitiveRole (List Nat) PrimitiveRangeBoundRole
        ([111, 117, 114, 111, 46, 114, 97, 110, 103, 101, 45, 98, 111, 117, 110, 100] : List Nat)
    , MkPair PrimitiveRole (List Nat) PrimitiveRangeRole
        ([111, 117, 114, 111, 46, 114, 97, 110, 103, 101] : List Nat)
    ] : List (Pair(PrimitiveRole, List Nat)));

def primitive_role_decode (fuel : Nat) (key : List Nat) : Either PrimitiveError PrimitiveRole :=
    primitive_bind Unit PrimitiveRole (primitive_fuel fuel) (fun (_budget : Unit) =>
      (fix find (remaining : Nat) (entries : List (Pair PrimitiveRole (List Nat)))
          : Either PrimitiveError PrimitiveRole :=
        match entries with
        | Nil => Left PrimitiveError PrimitiveRole PrimitiveUnknownKey
        | Cons entry rest =>
            match remaining with
            | Z => Left PrimitiveError PrimitiveRole PrimitiveResourceExhausted
            | S next =>
                match entry with
                | MkPair role bytes =>
                    match primitive_bytes_equal key bytes with
                    | True => Right PrimitiveError PrimitiveRole role
                    | False => find next rest
                    end
                end
            end
        end) fuel primitive_role_keys);

def primitive_roles_environment : List Entry -> List PrimitiveRoleBinding :=
  fix collect (entries : List Entry) : List PrimitiveRoleBinding :=
    match entries with
    | Nil => Nil PrimitiveRoleBinding
    | Cons entry rest =>
        match entry with
        | MkEntry _ _ _ => collect rest
        | MkIndEntry _ _ => collect rest
        | MkBoundEntry _ _ _ => collect rest
        | MkRoleEntry role => Cons PrimitiveRoleBinding role (collect rest)
        end
    end;

def primitive_inductive_shape (decl : IndDecl) : PrimitiveInductiveShape :=
    match decl with
    | MkIndDecl name params indices sort ctors =>
        PrimitiveInductiveOf name (length Param params) (length CoreTerm indices)
          (mk_pis(params_types params, mk_pis(indices, CSort sort)))
          (map Ctor CoreTerm (fun (ctor : Ctor) => match ctor with | MkCtor _ typ => typ end) ctors)
    end;

def primitive_checked_role_indexed (fuel : Nat) (sig : CheckEnvironment) (name : Nat) (key : List Nat)
    : CheckResult PrimitiveRoleBinding :=
    let registry_fuel : Nat := primitive_check_budget fuel in
    check_bind PrimitiveRole PrimitiveRoleBinding
      (check_from_primitive(PrimitiveRole, primitive_role_decode registry_fuel key))
      (fun (role : PrimitiveRole) =>
        match check_environment_ind name sig with
        | Nothing => CheckErr PrimitiveRoleBinding
            (CheckMalformedCore (CheckUnknownInductive name))
        | Just declaration =>
            let binding : PrimitiveRoleBinding := PrimitiveRoleOf(role, primitive_inductive_shape declaration) in
            let added : List PrimitiveRoleBinding := [binding] in
            check_map Unit PrimitiveRoleBinding (fun (_checked : Unit) => binding)
              (check_from_primitive Unit
                (primitive_validate_roles registry_fuel (primitive_normalizer_indexed sig)
                  (append PrimitiveRoleBinding (primitive_roles_environment (check_environment_entries sig))
                    added)))
        end);
