import "preprocess_record_decls.ouro";

inductive RecUpdateValue : Type :=
  | MkRecUpdateValue : List (List Nat) -> List Nat -> List Nat -> RecUpdateValue;

inductive RecUpdateParse : Type :=
  | RecUpdateErr : Nat -> RecUpdateParse
  | RecUpdateOk : List RecUpdateValue -> RecUpdateParse;

inductive RecUpdateBound : Type :=
  | MkRecUpdateBound : List (List Nat) -> List Nat -> List Nat -> List Nat -> RecUpdateBound;

inductive RecUpdateBind : Type :=
  | RecUpdateBindErr : Nat -> RecUpdateBind
  | RecUpdateBindOk : List RecUpdateBound -> RecUpdateBind;

inductive RecUpdateBuild : Type :=
  | RecUpdateBuildErr : Nat -> RecUpdateBuild
  | RecUpdateBuildOk : List Nat -> List (List Nat) -> RecUpdateBuild;

inductive RecUpdateFields : Type :=
  | RecUpdateFieldsErr : Nat -> RecUpdateFields
  | RecUpdateFieldsOk : List (Pair Nat (List Nat)) -> List (List Nat) -> RecUpdateFields;

def update_field_type : List RecField -> Nat -> Maybe (List Nat) :=
  fix update_field_type (fields : List RecField) (idx : Nat) : Maybe (List Nat) :=
  match fields with
  | Nil => Nothing (List Nat)
  | Cons f rest =>
      match idx with
      | Z => match f with | MkRecField _ ty => Just (List Nat) ty end
      | S next => update_field_type rest next
      end
  end;

def parse_update_path (input : List Nat)
    : Maybe (Pair (List (List Nat)) (List Nat)) :=
  (fix go (fuel : Nat) (xs : List Nat) (rev : List (List Nat))
      : Maybe (Pair (List (List Nat)) (List Nat)) :=
    match fuel with
    | Z => Nothing (Pair (List (List Nat)) (List Nat))
    | S remaining =>
        match source_take_ident (skip_ws_p xs) with
        | MkPair name rest =>
            match name with
            | Nil => Nothing (Pair (List (List Nat)) (List Nat))
            | Cons _ _ =>
                let path : List (List Nat) := Cons (List Nat) name rev in
                match skip_ws_p rest with
                | Cons dot after_dot =>
                    match eqNat dot ch_dot_p with
                    | True => go remaining after_dot path
                    | False => Just (Pair (List (List Nat)) (List Nat))
                        (MkPair (List (List Nat)) (List Nat)
                          (reverse (List Nat) path) (skip_ws_p rest))
                    end
                | Nil => Just (Pair (List (List Nat)) (List Nat))
                    (MkPair (List (List Nat)) (List Nat)
                      (reverse (List Nat) path) (Nil Nat))
                end
            end
        end
    end) (S (length Nat input)) input (Nil (List Nat));

def update_path_prefix : List (List Nat) -> List (List Nat) -> Bool :=
  fix update_path_prefix (prefix : List (List Nat)) (path : List (List Nat)) : Bool :=
  match prefix with
  | Nil => True
  | Cons head rest =>
      match path with
      | Nil => False
      | Cons current tail =>
          andb(source_bytes_equal head current, update_path_prefix rest tail)
      end
  end;

def update_path_conflicts (path : List (List Nat))
    : List (List (List Nat)) -> Bool :=
  fix update_path_conflicts (seen : List (List (List Nat))) : Bool :=
  match seen with
  | Nil => False
  | Cons old rest =>
      orb(update_path_prefix path old,
        orb(update_path_prefix old path, update_path_conflicts rest))
  end;

def resolve_update_path (reg : RecReg) (initial_ri : Nat)
    (path : List (List Nat)) : Maybe (List Nat) :=
  (fix go (segments : List (List Nat)) (ri : Nat) : Maybe (List Nat) :=
    match segments with
    | Nil => Nothing (List Nat)
    | Cons field rest =>
        match reg with
        | MkRecReg _ records _ _ =>
            match nth_rec records ri with
            | Nothing => Nothing (List Nat)
            | Just info =>
                match info with
                | MkRecInfo _ _ _ fields =>
                    match find_field_idx field fields with
                    | Nothing => Nothing (List Nat)
                    | Just idx =>
                        match update_field_type fields idx with
                        | Nothing => Nothing (List Nat)
                        | Just ty =>
                            match rest with
                            | Nil => Just (List Nat) ty
                            | Cons _ _ =>
                                match type_to_rec reg ty with
                                | Nothing => Nothing (List Nat)
                                | Just child => go rest child
                                end
                            end
                        end
                    end
                end
            end
        end
    end) path initial_ri;

def parse_update_fields (reg : RecReg) (ri : Nat)
    (input : List Nat) : RecUpdateParse :=
  (fix go (fuel : Nat) (xs : List Nat) (seen : List (List (List Nat)))
      (values : List RecUpdateValue) : RecUpdateParse :=
    match fuel with
    | Z => RecUpdateErr rec_code_malformed
    | S remaining =>
        match skip_ws_p xs with
        | Nil =>
            match seen with
            | Nil => RecUpdateErr rec_code_malformed
            | Cons _ _ => RecUpdateOk(reverse RecUpdateValue values)
            end
        | Cons _ _ =>
            match parse_update_path xs with
            | Nothing => RecUpdateErr rec_code_malformed
            | Just parsed =>
                match parsed with
                | MkPair path rest =>
                    match rest with
                    | Cons colon after_colon =>
                        match after_colon with
                        | Cons equals rhs =>
                            match andb(eqNat colon ch_colon_p, eqNat equals ch_eq_p) with
                            | False => RecUpdateErr rec_code_malformed
                            | True =>
                                match take_until_comma_or_end rhs with
                                | MkPair raw tail =>
                                    match skip_ws_p raw with
                                    | Nil => RecUpdateErr rec_code_malformed
                                    | Cons _ _ =>
                                        match resolve_update_path reg ri path with
                                        | Nothing => RecUpdateErr rec_code_unknown
                                        | Just ty =>
                                            match update_path_conflicts path seen with
                                            | True => RecUpdateErr rec_code_dup
                                            | False =>
                                                let more : List RecUpdateValue :=
                                                  Cons RecUpdateValue
                                                    (MkRecUpdateValue path ty raw) values in
                                                let seen2 : List (List (List Nat)) :=
                                                  Cons (List (List Nat)) path seen in
                                                match skip_ws_p tail with
                                                | Nil => RecUpdateOk(reverse RecUpdateValue more)
                                                | Cons comma after_comma =>
                                                    match eqNat comma ch_comma_p with
                                                    | True => go remaining after_comma seen2 more
                                                    | False => RecUpdateErr rec_code_malformed
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        | Nil => RecUpdateErr rec_code_malformed
                        end
                    | Nil => RecUpdateErr rec_code_malformed
                    end
                end
            end
        end
    end) (S (length Nat input)) input
      (Nil (List (List Nat))) (Nil RecUpdateValue);

def source_ident_used (name : List Nat) (input : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S remaining =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go remaining (source_skip_line rest)
            | False =>
                match eqNat c ch_dq_p with
                | True => go remaining (source_skip_string rest)
                | False =>
                    match source_is_ident_start c with
                    | True =>
                        match source_take_ident xs with
                        | MkPair ident tail =>
                            match source_bytes_equal ident name with
                            | True => True
                            | False => go remaining tail
                            end
                        end
                    | False => go remaining rest
                    end
                end
            end
        end
    end) (S (length Nat input)) input;

def fresh_update_name (input : List Nat) (used : List (List Nat))
    : Maybe (List Nat) :=
  (fix go (fuel : Nat) (candidate : List Nat) : Maybe (List Nat) :=
    match fuel with
    | Z => Nothing (List Nat)
    | S remaining =>
        match orb(source_ident_used candidate input, name_in candidate used) with
        | True => go remaining (append Nat candidate s_uscore)
        | False => Just (List Nat) candidate
        end
    end) (S (add (length Nat input) (length (List Nat) used)))
      ([95, 95, 111, 117, 114, 111, 95, 117, 112, 100, 97, 116, 101] : List Nat);

def bind_update_fields (input : List Nat) (initial_used : List (List Nat))
    (values : List RecUpdateValue)
    (rewrite_value : List Nat -> List Nat -> RewriteR) : RecUpdateBind :=
  (fix go (remaining : List RecUpdateValue) (used : List (List Nat))
      : RecUpdateBind :=
    match remaining with
    | Nil => RecUpdateBindOk (Nil RecUpdateBound)
    | Cons value rest =>
        match value with
        | MkRecUpdateValue path ty rhs =>
            match fresh_update_name input used with
            | Nothing => RecUpdateBindErr rec_code_malformed
            | Just binder =>
                match rewrite_value ty rhs with
                | RwErr code => RecUpdateBindErr code
                | RwOk rewritten _ =>
                    match go rest (Cons (List Nat) binder used) with
                    | RecUpdateBindErr code => RecUpdateBindErr code
                    | RecUpdateBindOk tail =>
                        RecUpdateBindOk
                          (Cons RecUpdateBound
                            (MkRecUpdateBound path binder ty rewritten) tail)
                    end
                end
            end
        end
    end) values initial_used;

def update_bound_names : List RecUpdateBound -> List (List Nat) :=
  fix update_bound_names (updates : List RecUpdateBound) : List (List Nat) :=
  match updates with
  | Nil => Nil (List Nat)
  | Cons value rest =>
      match value with
      | MkRecUpdateBound _ binder _ _ =>
          Cons (List Nat) binder (update_bound_names rest)
      end
  end;

def update_direct_value (field : List Nat)
    : List RecUpdateBound -> Maybe (List Nat) :=
  fix update_direct_value (updates : List RecUpdateBound) : Maybe (List Nat) :=
  match updates with
  | Nil => Nothing (List Nat)
  | Cons value rest =>
      match value with
      | MkRecUpdateBound path binder _ _ =>
          match path with
          | Nil => update_direct_value rest
          | Cons head tail =>
              match andb(source_bytes_equal head field,
                    match tail with | Nil => True | Cons _ _ => False end) with
              | True => Just (List Nat) binder
              | False => update_direct_value rest
              end
          end
      end
  end;

def update_nested_values (field : List Nat)
    : List RecUpdateBound -> List RecUpdateBound :=
  fix update_nested_values (updates : List RecUpdateBound) : List RecUpdateBound :=
  match updates with
  | Nil => Nil RecUpdateBound
  | Cons value rest =>
      match value with
      | MkRecUpdateBound path binder ty rhs =>
          match path with
          | Nil => update_nested_values rest
          | Cons head tail =>
              match tail with
              | Nil => update_nested_values rest
              | Cons _ _ =>
                  match source_bytes_equal head field with
                  | False => update_nested_values rest
                  | True =>
                      Cons RecUpdateBound
                        (MkRecUpdateBound tail binder ty rhs)
                        (update_nested_values rest)
                  end
              end
          end
      end
  end;

def wrap_update_let (binder : List Nat) (ty : List Nat)
    (value : List Nat) (body : List Nat) : List Nat :=
  append Nat ([108, 101, 116, 32] : List Nat)
    (append Nat binder
      (append Nat s_colonsp
        (append Nat ty
          (append Nat ([32, 58, 61, 32] : List Nat)
            (append Nat value
              (append Nat ([32, 105, 110, 32] : List Nat) body))))));

def wrap_update_values : List RecUpdateBound -> List Nat -> List Nat :=
  fix wrap_update_values (updates : List RecUpdateBound) (body : List Nat)
      : List Nat :=
  match updates with
  | Nil => body
  | Cons value rest =>
      match value with
      | MkRecUpdateBound _ binder ty rhs =>
          wrap_update_let binder ty rhs (wrap_update_values rest body)
      end
  end;

def build_updated_record (reg : RecReg) (source : List Nat)
    (initial_ri : Nat) (initial_base : List Nat)
    (initial_updates : List RecUpdateBound) (initial_used : List (List Nat))
    : RecUpdateBuild :=
  (fix build (fuel : Nat) (ri : Nat) (base : List Nat)
      (updates : List RecUpdateBound) (used : List (List Nat))
      : RecUpdateBuild :=
    match fuel with
    | Z => RecUpdateBuildErr rec_code_malformed
    | S remaining =>
        match reg with
        | MkRecReg _ records _ _ =>
            match nth_rec records ri with
            | Nothing => RecUpdateBuildErr rec_code_unknown
            | Just info =>
                match info with
                | MkRecInfo _ rec_name ctor fields =>
                    let results : RecUpdateFields :=
                      (fix fields_go (todo : List RecField) (idx : Nat)
                          (current_used : List (List Nat)) : RecUpdateFields :=
                        match todo with
                        | Nil => RecUpdateFieldsOk
                            (Nil (Pair Nat (List Nat))) current_used
                        | Cons field rest =>
                            match field with
                            | MkRecField field_name field_ty =>
                                let accessor : List Nat :=
                                  append Nat (acc_name rec_name field_name)
                                    (Cons Nat ch_space_p base) in
                                let nested : List RecUpdateBound :=
                                  update_nested_values field_name updates in
                                let chosen : RecUpdateBuild :=
                                  match update_direct_value field_name updates with
                                  | Just binder => RecUpdateBuildOk binder current_used
                                  | Nothing =>
                                      match nested with
                                      | Nil => RecUpdateBuildOk accessor current_used
                                      | Cons _ _ =>
                                          match type_to_rec reg field_ty with
                                          | Nothing => RecUpdateBuildErr rec_code_unknown
                                          | Just child_ri =>
                                              match fresh_update_name source current_used with
                                              | Nothing => RecUpdateBuildErr rec_code_malformed
                                              | Just child_name =>
                                                  match build remaining child_ri child_name nested
                                                        (Cons (List Nat) child_name current_used) with
                                                  | RecUpdateBuildErr code => RecUpdateBuildErr code
                                                  | RecUpdateBuildOk constructed next_used =>
                                                      RecUpdateBuildOk
                                                        (wrap_update_let child_name field_ty
                                                          accessor constructed) next_used
                                                  end
                                              end
                                          end
                                      end
                                  end in
                                match chosen with
                                | RecUpdateBuildErr code => RecUpdateFieldsErr code
                                | RecUpdateBuildOk value next_used =>
                                    match fields_go rest (S idx) next_used with
                                    | RecUpdateFieldsErr code => RecUpdateFieldsErr code
                                    | RecUpdateFieldsOk tail used_after =>
                                        RecUpdateFieldsOk
                                          (Cons (Pair Nat (List Nat))
                                            (MkPair Nat (List Nat) idx value) tail)
                                          used_after
                                    end
                                end
                            end
                        end) fields Z used in
                    match results with
                    | RecUpdateFieldsErr code => RecUpdateBuildErr code
                    | RecUpdateFieldsOk values final_used =>
                        RecUpdateBuildOk (build_ctor_app ctor fields values) final_used
                    end
                end
            end
        end
    end) (S (length Nat source)) initial_ri initial_base initial_updates initial_used;

def expand_record_update (reg : RecReg) (expected : Maybe Nat)
    (inner : List Nat) (source : List Nat)
    (rewrite_value : Maybe Nat -> List Nat -> RewriteR) : RewriteR :=
  match expected with
  | Nothing => RwErr rec_code_need_ty
  | Just ri =>
      match reg with
      | MkRecReg _ records names _ =>
          match nth_rec records ri with
          | Nothing => RwErr rec_code_need_ty
          | Just info =>
              match info with
              | MkRecInfo _ rec_name _ _ =>
                  match take_until_word w_with inner with
                  | MkPair base after =>
                      match word_at w_with after with
                      | False => RwErr rec_code_malformed
                      | True =>
                          match skip_ws_p base with
                          | Nil => RwErr rec_code_malformed
                          | Cons _ _ =>
                              match parse_update_fields reg ri
                                      (source_drop_prefix w_with after) with
                              | RecUpdateErr code => RwErr code
                              | RecUpdateOk values =>
                                  match fresh_update_name source names with
                                  | Nothing => RwErr rec_code_malformed
                                  | Just base_name =>
                                      match rewrite_value (Just Nat ri) base with
                                      | RwErr code => RwErr code
                                      | RwOk rewritten_base _ =>
                                          match bind_update_fields source
                                                (Cons (List Nat) base_name names) values
                                                (fun (ty : List Nat) (rhs : List Nat) =>
                                                  rewrite_value (type_to_rec reg ty) rhs) with
                                          | RecUpdateBindErr code => RwErr code
                                          | RecUpdateBindOk bound =>
                                              let used : List (List Nat) :=
                                                append (List Nat) (update_bound_names bound)
                                                  (Cons (List Nat) base_name names) in
                                              match build_updated_record reg source ri base_name
                                                    bound used with
                                              | RecUpdateBuildErr code => RwErr code
                                              | RecUpdateBuildOk constructed _ =>
                                                  let lowered : List Nat :=
                                                    wrap_update_let base_name rec_name rewritten_base
                                                      (wrap_update_values bound constructed) in
                                                  RwOk(Cons Nat ch_lparen_p
                                                    (append Nat lowered (n1p ch_rparen_p)), Nil Nat)
                                              end
                                          end
                                      end
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
  end;
