-- Large Nat literals use closed, typed bit applications rather than copied successor spines.
import "lower_support.ouro",
  "lower_named.ouro",
  "lower_spread.ouro";

def literal_nat_family (env : LowerEnv) : Maybe Nat :=
    match find_matching_ind ([0, 1] : List Nat) (env_ctors env) with
    | Nothing => Nothing Nat
    | Just chosen => match chosen with
        | MkPair family parameters =>
            match andb (eqNat parameters 0) (memNat family (env_indIds env)) with
            | True => match lookup_decl_type env family with
                | Nothing => Nothing Nat
                | Just kind => match is_ssort kind with
                    | True => Just Nat family
                    | False => Nothing Nat
                    end
                end
            | False => Nothing Nat
            end
        end
    end;

def literal_nat_fresh (env : LowerEnv) (self : Maybe Nat)
    (locals : List (Pair Nat Surface)) : Nat :=
    let self_max : Nat := match self with | Nothing => 0 | Just name => name end in
    S (maxNat self_max
      (maxNat (named_locals_max locals)
        (maxNat (spread_max_names (env_constIds env))
          (maxNat (spread_max_names (env_indIds env))
            (spread_max_names (map CtorInfo Nat ctor_nameId (env_ctors env)))))));

-- Powers are descending; their construction and consumption share the lowering budget.
def literal_nat_places (fuel : Nat) (value : Nat)
    : Maybe (Pair Nat (List Nat)) :=
    (fix collect (remaining : Nat) (place : Nat) (places : List Nat)
        : Maybe (Pair Nat (List Nat)) :=
      match compiler_le_nat place value with
      | False => Just (Pair Nat (List Nat)) (MkPair Nat (List Nat) remaining places)
      | True => match remaining with
          | Z => Nothing (Pair Nat (List Nat))
          | S next => collect next (add place place) (Cons Nat place places)
          end
      end) fuel 1 (Nil Nat);

-- D0 f x = f (f x); D1 f x = S (f (f x)). The prior function occurs once.
def literal_nat_digit (family : Nat) (fresh : Nat) (odd : Bool) : Surface :=
    let argument : Nat := S fresh in
    let typ : Surface := SInd family in
    let twice : Surface := SApp (SVar fresh) (SApp (SVar fresh) (SVar argument)) in
    SLam fresh (SPi argument typ typ)
      (SLam argument typ
        (match odd with
         | False => twice
         | True => SApp (SConstruct family 1 0) twice
         end));

def literal_nat_function (fuel : Nat) (family : Nat) (fresh : Nat)
    (value : Nat) (places : List Nat) : Maybe Surface :=
    (fix build (remaining : Nat) (names : Nat) (rest : List Nat)
        (number : Nat) (function : Surface) : Maybe Surface :=
      match rest with
      | Nil => match eqNat number 0 with
          | True => Just Surface function
          | False => Nothing Surface
          end
      | Cons place tail => match remaining with
          | Z => Nothing Surface
          | S next =>
              let odd : Bool := compiler_le_nat place number in
              let reduced : Nat := match odd with
                | True => sub number place
                | False => number
                end in
              build next (S (S names)) tail reduced
                (SApp (literal_nat_digit family names odd) function)
          end
      end) fuel (S fresh) places value (SLam fresh (SInd family) (SVar fresh));

def lower_nat_literal (fuel : Nat) (env : LowerEnv) (self : Maybe Nat)
    (locals : List (Pair Nat Surface)) (value : Nat) : Surface :=
    match compiler_le_nat value 255 with
    | True => lower_nat_env env value
    | False => match literal_nat_family env with
        | Nothing => lower_nat_env env value
        | Just family => match literal_nat_places fuel value with
            | Nothing => hole0
            | Just collected => match collected with
                | MkPair remaining places =>
                    match literal_nat_function remaining family
                        (literal_nat_fresh env self locals) value places with
                    | Nothing => hole0
                    | Just function => SApp function (SConstruct family 0 0)
                    end
                end
            end
        end
    end;
