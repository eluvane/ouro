-- Back-end text emission is deliberately boring: kernel terms are already checked before this stage runs.

-- @entry pieces_to_c

import "../std/data.ouro";
import "base.ouro";
import "core.ouro";
import "erasure.ouro";
import "jsir.ouro";
import "extract.ouro";
import "print_c.ouro";

-- A type alias is erased only when its checked CoreTerm is structurally
-- type-valued. The fixed point below handles aliases of earlier or later
-- aliases without guessing from extracted JErr values.
def is_type_core_with (known : List Nat)
    : CoreTerm -> List BEntry -> Bool :=
  fix is_type_core_with (t : CoreTerm) (ctx : List BEntry) : Bool :=
    match t with
    | CSort _ => True
    | CPi _ _ => True
    | CInd _ => True
    | CRel i => is_type_arg_rel i ctx
    | CConst n => memNat n known
    | CApp f _ => is_type_core_with f ctx
    | CLam ann body =>
        is_type_core_with body
          (Cons BEntry (MkB Z (is_sort_ann ann)) ctx)
    | CLetIn _ ty body =>
        is_type_core_with body
          (Cons BEntry (MkB Z (is_sort_ann ty)) ctx)
    | CConstruct _ _ _ => False
    | CStrBytes _ _ => False
    | CStrLit _ _ => False
    | CCase _ _ _ _ => False
    | CFix _ _ _ _ _ => False
    end;

def type_global_step (pieces : List (Pair Nat CoreTerm))
    (known : List Nat) : List Nat :=
  (fix go (xs : List (Pair Nat CoreTerm)) (acc : List Nat) : List Nat :=
    match xs with
    | Nil => acc
    | Cons p rest =>
        match p with
        | MkPair name body =>
            match andb
                (is_type_core_with acc body (Nil BEntry))
                (notb (memNat name acc)) with
            | True => go rest (Cons Nat name acc)
            | False => go rest acc
            end
        end
    end) pieces known;

def type_globals (fuel : Nat) (pieces : List (Pair Nat CoreTerm))
    : List Nat :=
  (fix go (remaining : Nat) (known : List Nat) : List Nat :=
    match remaining with
    | Z => known
    | S remaining' =>
        let next : List Nat := type_global_step pieces known in
        match eqNat (length Nat next) (length Nat known) with
        | True => next
        | False => go remaining' next
        end
    end) fuel (Nil Nat);

def extract_pieces_with (types : List Nat)
    : List (Pair Nat CoreTerm) -> List (Pair Nat JsIR) :=
  fix extract_pieces_with (xs : List (Pair Nat CoreTerm))
      : List (Pair Nat JsIR) :=
    match xs with
    | Nil => Nil (Pair Nat JsIR)
    | Cons p rest =>
        match p with
        | MkPair name body =>
            Cons (Pair Nat JsIR)
              (MkPair Nat JsIR name (extract_term_with types body))
              (extract_pieces_with rest)
        end
    end;

-- Extraction over every checked body: CoreTerm to JsIR, name ids kept.
def extract_pieces (cores : List (Pair Nat CoreTerm))
    : List (Pair Nat JsIR) :=
  extract_pieces_with (type_globals fuel1k cores) cores;

-- Kernel terms to C text. The name table is empty because interned strings do
-- not cross the seam yet, so bodies come out named by id and the export table
-- comes out empty.
def pieces_to_c (cores : List (Pair Nat CoreTerm)) : List Nat :=
  print_c_module_named (extract_pieces cores)
    (Nil (Pair Nat (List Nat))) (Nil Nat);
