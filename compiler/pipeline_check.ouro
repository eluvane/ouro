-- Declaration-aware checker plan over exact emitted bodies.

import "pipeline_abi.ouro",
  "pipeline_surface.ouro",
  "file_check_model.ouro",
  "file_check_environment.ouro",
  "source_text.ouro",
  "primitive_model.ouro";

inductive PlanPiView : Type :=
  | PlanNotPi : PlanPiView
  | PlanPi : CoreTerm -> CoreTerm -> PlanPiView;

inductive PlanSortView : Type :=
  | PlanNotSort : PlanSortView
  | PlanSort : Nat -> PlanSortView;

inductive ParamBuild : Type :=
  | ParamBuildErr : ParamBuild
  | ParamBuildOk : List Param -> CoreTerm -> ParamBuild;

inductive IndexBuild : Type :=
  | IndexBuildErr : IndexBuild
  | IndexBuildOk : List CoreTerm -> Nat -> IndexBuild;

inductive IndBuild : Type :=
  | IndBuildErr : Nat -> IndBuild
  | IndBuildOk : IndDecl -> IndBuild;

inductive DefinitionBuild : Type :=
  | DefinitionBuildErr : Nat -> DefinitionBuild
  | DefinitionBuildOk : List FileItem -> List (Pair Nat CoreTerm)
      -> DefinitionBuild;

inductive CheckPlan : Type :=
  | CheckPlanErr : Nat -> CheckPlan
  | CheckPlanOk : List FileItem -> CheckPlan;

def plan_pi_view (t : CoreTerm) : PlanPiView :=
    match t with
    | CPi dom cod => PlanPi dom cod
    | CRel _ => PlanNotPi
    | CSort _ => PlanNotPi
    | CLam _ _ => PlanNotPi
    | CApp _ _ => PlanNotPi
    | CLetIn _ _ _ => PlanNotPi
    | CConst _ => PlanNotPi
    | CInd _ => PlanNotPi
    | CConstruct _ _ _ => PlanNotPi
    | CCase _ _ _ _ => PlanNotPi
    | CFix _ _ _ _ _ => PlanNotPi
    | CStrBytes _ _ => PlanNotPi
    | CStrLit _ _ => PlanNotPi
    end;

def plan_sort_view (t : CoreTerm) : PlanSortView :=
    match t with
    | CSort u => PlanSort u
    | CRel _ => PlanNotSort
    | CPi _ _ => PlanNotSort
    | CLam _ _ => PlanNotSort
    | CApp _ _ => PlanNotSort
    | CLetIn _ _ _ => PlanNotSort
    | CConst _ => PlanNotSort
    | CInd _ => PlanNotSort
    | CConstruct _ _ _ => PlanNotSort
    | CCase _ _ _ _ => PlanNotSort
    | CFix _ _ _ _ _ => PlanNotSort
    | CStrBytes _ _ => PlanNotSort
    | CStrLit _ _ => PlanNotSort
    end;

def plan_elaborate
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (fuel : Nat) (env : LowerEnv) (expr : Expr) : CoreTerm :=
    elaborate fuel
      (rewrite_dummy_anns (lower_expr_env2 env (Nothing Surface) expr))
      (Nil Nat);

def build_params : List (Pair Nat Expr) -> CoreTerm -> ParamBuild :=
  fix build_params (params : List (Pair Nat Expr)) (family : CoreTerm)
      : ParamBuild :=
    match params with
    | Nil => ParamBuildOk(Nil Param, family)
    | Cons p rest =>
        match p with
        | MkPair name _ =>
            match plan_pi_view family with
            | PlanNotPi => ParamBuildErr
            | PlanPi dom cod =>
                match build_params rest cod with
                | ParamBuildErr => ParamBuildErr
                | ParamBuildOk built tail =>
                    ParamBuildOk(Cons Param (MkParam name dom) built, tail)
                end
            end
        end
    end;

def build_indices : CoreTerm -> IndexBuild :=
  fix build_indices (family : CoreTerm) : IndexBuild :=
    match family with
    | CPi dom cod =>
        match build_indices cod with
        | IndexBuildErr => IndexBuildErr
        | IndexBuildOk indices sort =>
            IndexBuildOk(Cons CoreTerm dom indices, sort)
        end
    | CSort sort => IndexBuildOk(Nil CoreTerm, sort)
    | CRel _ => IndexBuildErr
    | CLam _ _ => IndexBuildErr
    | CApp _ _ => IndexBuildErr
    | CLetIn _ _ _ => IndexBuildErr
    | CConst _ => IndexBuildErr
    | CInd _ => IndexBuildErr
    | CConstruct _ _ _ => IndexBuildErr
    | CCase _ _ _ _ => IndexBuildErr
    | CFix _ _ _ _ _ => IndexBuildErr
    | CStrBytes _ _ => IndexBuildErr
    | CStrLit _ _ => IndexBuildErr
    end;

def build_ctors
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (fuel : Nat) (env : LowerEnv) (params : List (Pair Nat Expr))
  : List (Pair Nat Expr) -> List Ctor :=
  fix build_ctors (ctors : List (Pair Nat Expr)) : List Ctor :=
    match ctors with
    | Nil => Nil Ctor
    | Cons c rest =>
        match c with
        | MkPair name ty =>
            Cons Ctor
              (MkCtor name
                (plan_elaborate lower_expr_env2 elaborate fuel env
                  (mk_pi_chain params ty)))
              (build_ctors rest)
        end
    end;

def checked_implicit_prefix : Nat -> List Param -> Bool :=
  fix checked_implicit_prefix (remaining : Nat) (params : List Param) : Bool :=
    match remaining with
    | Z => True
    | S next =>
        match params with
        | Nil => False
        | Cons param rest =>
            match param with
            | MkParam _ domain =>
                match plan_sort_view domain with
                | PlanSort level =>
                    andb(eqNat level Z, checked_implicit_prefix next rest)
                | PlanNotSort => False
                end
            end
        end
    end;

def build_ind_decl
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (fuel : Nat) (env : LowerEnv) (name : Nat)
  (params : List (Pair Nat Expr)) (family : Expr)
  (ctors : List (Pair Nat Expr)) (marked : Nat) : IndBuild :=
    let full_family : CoreTerm :=
      plan_elaborate lower_expr_env2 elaborate fuel env
        (mk_pi_chain params family) in
    match build_params params full_family with
    | ParamBuildErr => IndBuildErr name
    | ParamBuildOk built_params index_family =>
        match build_indices index_family with
        | IndexBuildErr => IndBuildErr name
        | IndexBuildOk indices sort =>
            match andb (checked_implicit_prefix marked built_params)
                (orb(eqNat marked Z, eqNat(length CoreTerm indices, Z))) with
            | False => IndBuildErr name
            | True =>
                IndBuildOk
                  (MkIndDecl name built_params indices sort
                    (build_ctors lower_expr_env2 elaborate fuel env params ctors))
            end
        end
    end;

def effect_axioms
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (fuel : Nat) (env : LowerEnv) (params : List (Pair Nat Expr))
  : List (Pair Nat Expr) -> List FileItem :=
  fix effect_axioms (ops : List (Pair Nat Expr)) : List FileItem :=
    match ops with
    | Nil => Nil FileItem
    | Cons op rest =>
        match op with
        | MkPair name ty =>
            Cons FileItem
              (FAxiom name
                (plan_elaborate lower_expr_env2 elaborate fuel env
                  (mk_pi_chain params ty)))
              (effect_axioms rest)
        end
    end;

def effect_name_member (name : Nat) : List (Pair Nat Expr) -> Bool :=
  fix effect_name_member (ops : List (Pair Nat Expr)) : Bool :=
    match ops with
    | Nil => False
    | Cons op rest =>
        match op with
        | MkPair op_name _ =>
            orb(eqNat name op_name, effect_name_member rest)
        end
    end;

def drop_effect_cores (ops : List (Pair Nat Expr))
    : List (Pair Nat CoreTerm) -> List (Pair Nat CoreTerm) :=
  fix drop_effect_cores (cores : List (Pair Nat CoreTerm))
      : List (Pair Nat CoreTerm) :=
    match cores with
    | Nil => Nil (Pair Nat CoreTerm)
    | Cons core rest =>
        match core with
        | MkPair name _ =>
            match effect_name_member name ops with
            | True => drop_effect_cores rest
            | False =>
                Cons(Pair Nat CoreTerm, core, drop_effect_cores rest)
            end
        end
    end;

def plan_string (st : InternState) (id : Nat) : Maybe (List Nat) :=
    match st with
    | MkIntern _ _ strings _ =>
        (fix find (remaining : List (Pair (List Nat) Nat)) : Maybe (List Nat) :=
          match remaining with
          | Nil => Nothing (List Nat)
          | Cons item rest =>
              match item with
              | MkPair bytes current =>
                  match eqNat current id with
                  | True => Just(List Nat, bytes)
                  | False => find rest
                  end
              end
          end) strings
    end;

def plan_extern_gc (bytes : List Nat) : Maybe PrimitiveGc :=
    match source_bytes_equal(bytes, [109, 97, 121, 103, 99] : List Nat) with
    | True => Just PrimitiveGc PrimitiveMayGc
    | False =>
        match source_bytes_equal(bytes, [110, 111, 103, 99] : List Nat) with
        | True => Just PrimitiveGc PrimitiveNoGc
        | False => Nothing PrimitiveGc
        end
    end;

def plan_extern_request (st : InternState) (metadata : List Nat) : Maybe ExternRequest :=
    match eqNat(length Nat metadata, 5) with
    | False => Nothing ExternRequest
    | True =>
        match plan_string(st, compiler_nth_nat 0 metadata) with
        | Nothing => Nothing ExternRequest
        | Just target =>
            match plan_string(st, compiler_nth_nat 1 metadata) with
            | Nothing => Nothing ExternRequest
            | Just abi =>
                match plan_string(st, compiler_nth_nat 2 metadata) with
                | Nothing => Nothing ExternRequest
                | Just library =>
                    match plan_string(st, compiler_nth_nat 3 metadata) with
                    | Nothing => Nothing ExternRequest
                    | Just symbol =>
                        match plan_string(st, compiler_nth_nat 4 metadata) with
                        | Nothing => Nothing ExternRequest
                        | Just policy =>
                            match plan_extern_gc policy with
                            | Nothing => Nothing ExternRequest
                            | Just gc => Just ExternRequest
                                (ExternRequestOf target abi library symbol False gc)
                            end
                        end
                    end
                end
            end
        end
    end;

def build_definitions
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (fuel : Nat) (env : LowerEnv) (st : InternState)
  : List Decl -> List (Pair Nat CoreTerm) -> DefinitionBuild :=
  fix build_definitions (decls : List Decl)
      (cores : List (Pair Nat CoreTerm)) : DefinitionBuild :=
    match decls with
    | Nil => DefinitionBuildOk(Nil FileItem, cores)
    | Cons decl rest =>
        match decl with
        | DDef name ty _body =>
            match cores with
            | Nil => DefinitionBuildErr name
            | Cons pair core_rest =>
                match pair with
                | MkPair core_name body =>
                    match eqNat name core_name with
                    | False => DefinitionBuildErr name
                    | True =>
                        match build_definitions rest core_rest with
                        | DefinitionBuildErr detail => DefinitionBuildErr detail
                        | DefinitionBuildOk built remaining =>
                            DefinitionBuildOk
                              (Cons FileItem
                                (FDef name
                                  (plan_elaborate lower_expr_env2 elaborate
                                    fuel env ty)
                                  body)
                                built)
                              remaining
                        end
                    end
                end
            end
        | DAxiom name ty =>
            match build_definitions rest cores with
            | DefinitionBuildErr detail => DefinitionBuildErr detail
            | DefinitionBuildOk built remaining =>
                DefinitionBuildOk
                  (Cons FileItem
                    (FAxiom name
                      (plan_elaborate lower_expr_env2 elaborate fuel env ty))
                    built)
                  remaining
            end
        | DInductive name params family ctors marked =>
            match build_ind_decl lower_expr_env2 elaborate fuel env name
              params family ctors marked with
            | IndBuildErr detail => DefinitionBuildErr detail
            | IndBuildOk ind =>
                match build_definitions rest cores with
                | DefinitionBuildErr detail => DefinitionBuildErr detail
                | DefinitionBuildOk built remaining =>
                    DefinitionBuildOk(Cons FileItem (FInd ind) built, remaining)
                end
            end
        | DEffect _ params ops =>
            match build_definitions(rest, drop_effect_cores ops cores) with
            | DefinitionBuildErr detail => DefinitionBuildErr detail
            | DefinitionBuildOk built remaining =>
                DefinitionBuildOk
                  (append FileItem
                    (effect_axioms lower_expr_env2 elaborate fuel env params ops)
                    built)
                  remaining
            end
        | DImport _ => build_definitions rest cores
        | DIntrinsic name ty key specialization =>
            match plan_string st key with
            | Nothing => DefinitionBuildErr name
            | Just bytes =>
                match build_definitions rest cores with
                | DefinitionBuildErr detail => DefinitionBuildErr detail
                | DefinitionBuildOk built remaining =>
                    DefinitionBuildOk
                      (Cons FileItem
                        (FIntrinsic name
                          (plan_elaborate lower_expr_env2 elaborate fuel env ty) bytes
                          (mapMaybe Expr CoreTerm
                            (plan_elaborate lower_expr_env2 elaborate fuel env) specialization))
                        built) remaining
                end
            end
        | DExtern name ty metadata =>
            match plan_extern_request st metadata with
            | Nothing => DefinitionBuildErr name
            | Just request =>
                match build_definitions rest cores with
                | DefinitionBuildErr detail => DefinitionBuildErr detail
                | DefinitionBuildOk built remaining =>
                    DefinitionBuildOk
                      (Cons FileItem
                        (FExtern name (plan_elaborate lower_expr_env2 elaborate fuel env ty) request)
                        built) remaining
                end
            end
        | DRepresentation name key =>
            match plan_string st key with
            | Nothing => DefinitionBuildErr name
            | Just bytes =>
                match build_definitions rest cores with
                | DefinitionBuildErr detail => DefinitionBuildErr detail
                | DefinitionBuildOk built remaining =>
                    DefinitionBuildOk
                      (Cons FileItem (FRepresentation name bytes) built) remaining
                end
            end
        end
    end;

def definition_names : List Decl -> List Nat :=
  fix definition_names (decls : List Decl) : List Nat :=
    match decls with
    | Nil => Nil Nat
    | Cons decl rest =>
        match decl with
        | DDef name _ _ => Cons Nat name (definition_names rest)
        | DAxiom _ _ => definition_names rest
        | DInductive _ _ _ _ _ => definition_names rest
        | DEffect _ _ _ => definition_names rest
        | DImport _ => definition_names rest
        | DIntrinsic _ _ _ _ => definition_names rest
        | DExtern _ _ _ => definition_names rest
        | DRepresentation _ _ => definition_names rest
        end
    end;

def filter_definition_cores (names : List Nat)
    : List (Pair Nat CoreTerm) -> List (Pair Nat CoreTerm) :=
    -- Derive membership from this name list; the ordered cores remain intact.
    -- Repeated linear membership scans retained quadratic temporary graphs.
    let index : EntryIndex :=
      (fix collect (remaining : List Nat) (tree : EntryIndex) : EntryIndex :=
        match remaining with
        | Nil => tree
        | Cons name rest => collect(rest, entry_index_insert name EntryIndexReserved tree)
        end) names EntryIndexEmpty in
  fix filter_definition_cores (cores : List (Pair Nat CoreTerm))
      : List (Pair Nat CoreTerm) :=
    match cores with
    | Nil => Nil (Pair Nat CoreTerm)
    | Cons core rest =>
        match core with
        | MkPair name _ =>
            match entry_index_lookup name index with
            | Just _ => Cons (Pair Nat CoreTerm) core
                (filter_definition_cores rest)
            | Nothing => filter_definition_cores rest
            end
        end
    end;

def build_check_plan
  (lower_expr_env2 : LowerEnv -> Maybe Surface -> Expr -> Surface)
  (elaborate : Nat -> Surface -> List Nat -> CoreTerm)
  (fuel : Nat) (env : LowerEnv) (st : InternState) (decls : List Decl)
  (cores : List (Pair Nat CoreTerm)) : CheckPlan :=
    match build_definitions lower_expr_env2 elaborate fuel env st decls
      (filter_definition_cores(definition_names decls, cores)) with
    | DefinitionBuildErr detail => CheckPlanErr detail
    | DefinitionBuildOk items remaining =>
        match remaining with
        | Nil => CheckPlanOk items
        | Cons pair _ =>
            match pair with
            | MkPair name _ => CheckPlanErr name
            end
        end
    end;
