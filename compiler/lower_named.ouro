-- Named calls elaborate to ordinary checked lets and applications.

import "lower_fallible.ouro",
  "lower_implicit.ouro";

inductive NamedDomain : Type :=
  | NamedDomainOf : Nat -> Surface -> NamedDomain;

inductive NamedValue : Type :=
  | NamedValueOf : Nat -> Nat -> Surface -> Surface -> NamedValue;

def named_head : Expr -> Maybe Nat :=
  fix go (term : Expr) : Maybe Nat :=
    match term with
    | ESpan _ _ inner => go inner
    | EVar name => Just Nat name
    | EHole _ => Nothing Nat | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat | ERange _ _ _ => Nothing Nat | EApp _ _ => Nothing Nat
    | ELam _ _ _ => Nothing Nat | EPi _ _ _ => Nothing Nat
    | ELet _ _ _ _ => Nothing Nat | EAscribe _ _ => Nothing Nat
    | EMatch _ _ => Nothing Nat | EFix _ _ _ _ => Nothing Nat
    | EEffectRow _ _ => Nothing Nat | EPerform _ _ => Nothing Nat
    | EDo _ => Nothing Nat | EHandle _ _ => Nothing Nat
    | EBranch _ _ _ => Nothing Nat | ENoBranch => Nothing Nat
    | EBinder _ _ _ => Nothing Nat | ENoBinder => Nothing Nat
    | EMultiMatch _ _ => Nothing Nat | EStr _ => Nothing Nat
    | EDoBind _ _ => Nothing Nat | EList _ => Nothing Nat
    | EListSpread _ _ => Nothing Nat
    | EFallible _ _ _ _ => Nothing Nat | EOpen _ _ => Nothing Nat
    | ENamedCall _ _ => Nothing Nat
    end;

def named_formal_domains (locals : List (Pair Nat Surface))
    (params : List DefParam) (signature : Surface)
    : Maybe (List NamedDomain) :=
  (fix go (items : List DefParam) (type_part : Surface)
      (seen_binders : List Nat) (seen_labels : List Nat)
      : Maybe (List NamedDomain) :=
    match items with
    | Nil => Just (List NamedDomain) (Nil NamedDomain)
    | Cons param rest =>
        match param with
        | DefParamOf label binder default =>
            match default with
            | Just _ => Nothing (List NamedDomain)
            | Nothing =>
                match implicit_pi_view type_part with
                | NoImplicitPi => Nothing (List NamedDomain)
                | ImplicitPi actual domain codomain =>
                    let dependent : Bool :=
                      (fix any (names : List Nat) : Bool :=
                        match names with
                        | Nil => False
                        | Cons name tail =>
                            orb(surface_mentions_name fuel1k name domain,
                              any tail)
                        end) seen_binders in
                    match andb(notb(eqNat label Z),
                        andb(notb(memNat(label, seen_labels)),
                          andb(eqNat actual binder,
                            andb(notb dependent,
                              notb(surface_hint_has_placeholder
                                locals fuel1k domain))))) with
                    | False => Nothing (List NamedDomain)
                    | True =>
                        match go rest codomain
                            (Cons Nat binder seen_binders)
                            (Cons Nat label seen_labels) with
                        | Nothing => Nothing (List NamedDomain)
                        | Just tail =>
                            Just (List NamedDomain)
                              (Cons NamedDomain
                                (NamedDomainOf label domain) tail)
                        end
                    end
                end
            end
        end
    end) params signature (Nil Nat) (Nil Nat);

def named_domain (label : Nat) : List NamedDomain -> Maybe Surface :=
  fix go (domains : List NamedDomain) : Maybe Surface :=
    match domains with
    | Nil => Nothing Surface
    | Cons item rest =>
        match item with
        | NamedDomainOf current domain =>
            match eqNat current label with
            | True => Just Surface domain
            | False => go rest
            end
        end
    end;

def named_label_at : Nat -> List NamedDomain -> Maybe Nat :=
  fix go (index : Nat) (domains : List NamedDomain) : Maybe Nat :=
    match domains with
    | Nil => Nothing Nat
    | Cons item rest =>
        match index with
        | Z =>
            match item with
            | NamedDomainOf label _ => Just Nat label
            end
        | S next => go next rest
        end
    end;

def named_temp_for (label : Nat) : List NamedValue -> Maybe Nat :=
  fix go (values : List NamedValue) : Maybe Nat :=
    match values with
    | Nil => Nothing Nat
    | Cons item rest =>
        match item with
        | NamedValueOf current temp _ _ =>
            match eqNat current label with
            | True => Just Nat temp
            | False => go rest
            end
        end
    end;

def named_locals_max : List (Pair Nat Surface) -> Nat :=
  fix go (locals : List (Pair Nat Surface)) : Nat :=
    match locals with
    | Nil => Z
    | Cons pair rest =>
        match pair with
        | MkPair name ty =>
            maxNat name (maxNat (fallible_max_var ty) (go rest))
        end
    end;

def named_values_max : List NamedValue -> Nat :=
  fix go (values : List NamedValue) : Nat :=
    match values with
    | Nil => Z
    | Cons item rest =>
        match item with
        | NamedValueOf _ temp domain value =>
            maxNat temp (maxNat (fallible_max_var domain)
              (maxNat (fallible_max_var value) (go rest)))
        end
    end;

def named_assign_temps (first : Nat) (items : List NamedValue)
    : List NamedValue :=
  (fix go (remaining : List NamedValue) (next : Nat) : List NamedValue :=
    match remaining with
    | Nil => Nil NamedValue
    | Cons item rest =>
        match item with
        | NamedValueOf label _ domain value =>
            Cons NamedValue (NamedValueOf label next domain value)
              (go rest (S next))
        end
    end) items first;

def named_apply_order (domains : List NamedDomain)
    (values : List NamedValue) (function : Surface) : Maybe Surface :=
  (fix go (items : List NamedDomain) (term : Surface) : Maybe Surface :=
    match items with
    | Nil => Just Surface term
    | Cons item rest =>
        match item with
        | NamedDomainOf label _ =>
            match named_temp_for label values with
            | Nothing => Nothing Surface
            | Just temp => go rest (SApp term (SVar temp))
            end
        end
    end) domains function;

def named_wrap_values : List NamedValue -> Surface -> Surface :=
  fix go (values : List NamedValue) (body : Surface) : Surface :=
    match values with
    | Nil => body
    | Cons item rest =>
        match item with
        | NamedValueOf _ temp domain value =>
            SLet temp value domain (go rest body)
        end
    end;

def lower_named_call
    (lower_run : Nat -> LowerEnv -> Maybe Surface -> Maybe Nat ->
      List (Pair Nat Surface) -> LowerMode -> LowerVal)
    (fuel : Nat) (env : LowerEnv) (fixSelf : Maybe Nat)
    (locals : List (Pair Nat Surface)) (head : Expr)
    (rows : List (Pair Nat Expr)) : Surface :=
  match named_head head with
  | Nothing => hole0
  | Just name =>
      match resolve_var_fix env fixSelf locals name with
      | SConst resolved =>
          match eqNat resolved name with
          | False => hole0
          | True =>
              match lookup_def_info name (env_defInfos env) with
              | Nothing => hole0
              | Just info =>
                  match def_info_prefix info with
                  | S _ => hole0
                  | Z =>
                      match lookup_decl_type env name with
                      | Nothing => hole0
                      | Just signature =>
                          match named_formal_domains locals
                              (def_info_params info) signature with
                          | Nothing => hole0
                          | Just domains =>
                              match eqNat(length (Pair Nat Expr) rows,
                                  length NamedDomain domains) with
                              | False => hole0
                              | True =>
                                  let values : Maybe (List NamedValue) :=
                                    (fix collect (items : List (Pair Nat Expr))
                                        (seen : List Nat) (position : Nat)
                                        (named_seen : Bool)
                                        : Maybe (List NamedValue) :=
                                      match items with
                                      | Nil => Just (List NamedValue) (Nil NamedValue)
                                      | Cons row rest =>
                                          match row with
                                          | MkPair supplied argument =>
                                              match andb named_seen (eqNat supplied Z) with
                                              | True => Nothing (List NamedValue)
                                              | False =>
                                              let label : Maybe Nat :=
                                                match supplied with
                                                | Z => named_label_at position domains
                                                | S _ => Just Nat supplied
                                                end in
                                              match label with
                                              | Nothing => Nothing (List NamedValue)
                                              | Just chosen =>
                                                  match orb(eqNat chosen Z,
                                                      memNat(chosen, seen)) with
                                                  | True => Nothing (List NamedValue)
                                                  | False =>
                                                      match named_domain chosen domains with
                                                      | Nothing => Nothing (List NamedValue)
                                                      | Just domain =>
                                                          let value : Surface :=
                                                            vsurf_or_hole
                                                              (lower_run fuel env
                                                                (Just Surface domain)
                                                                fixSelf locals
                                                                (LExpr argument)) in
                                                          match collect rest
                                                              (Cons Nat chosen seen)
                                                              (S position)
                                                              (orb named_seen
                                                                (notb(eqNat supplied Z))) with
                                                          | Nothing =>
                                                              Nothing (List NamedValue)
                                                          | Just tail =>
                                                              Just (List NamedValue)
                                                                (Cons NamedValue
                                                                  (NamedValueOf chosen
                                                                    Z domain value)
                                                                  tail)
                                                          end
                                                      end
                                                  end
                                              end
                                              end
                                          end
                                      end) rows (Nil Nat) Z False in
                                  match values with
                                  | Nothing => hole0
                                  | Just supplied =>
                                      let self_max : Nat :=
                                        match fixSelf with
                                        | Nothing => Z
                                        | Just id => id
                                        end in
                                      let fresh : Nat :=
                                        S (maxNat self_max
                                          (maxNat (fallible_max_var signature)
                                            (maxNat (named_locals_max locals)
                                              (named_values_max supplied)))) in
                                      let bound : List NamedValue :=
                                        named_assign_temps fresh supplied in
                                      match named_apply_order domains bound
                                          (SConst name) with
                                      | Nothing => hole0
                                      | Just applied =>
                                          named_wrap_values bound applied
                                      end
                                  end
                              end
                          end
                      end
                  end
              end
          end
      | SVar _ => hole0 | SSort _ => hole0 | SPi _ _ _ => hole0
      | SLam _ _ _ => hole0 | SApp _ _ => hole0 | SLet _ _ _ _ => hole0
      | SInd _ => hole0 | SConstruct _ _ _ => hole0
      | SCase _ _ _ _ => hole0 | SFix _ _ _ _ _ => hole0
      | SHole _ => hole0 | SEffectRow _ => hole0
      | SPerform _ _ => hole0 | SStr _ _ => hole0
      end
  end;
