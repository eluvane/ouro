-- Record sugar expands before lexing into ordinary inductive/accessor source accepted by the existing frontend.

import "source_text.ouro",
  "../std/data.ouro",
  "../std/natx.ouro",
  "base.ouro",
  "path.ouro",
  "pipeline_abi.ouro";

inductive RecEnv : Type :=
  | MkRecEnv : List RecBind -> RecEnv;

inductive RecParse : Type :=
  | RecPErr : Nat -> RecParse
  | RecPOk : RecInfo -> List Nat -> List Nat -> RecParse;

inductive RewriteR : Type :=
  | RwErr : Nat -> RewriteR
  | RwOk : List Nat -> List Nat -> RewriteR;

inductive DefHead : Type :=
  | NoHead : DefHead
  | MkHead : List Nat -> RecEnv -> Maybe (Pair Nat (List Nat)) ->
      List Nat -> List Nat -> DefHead;

-- @export empty_rec_reg; @doc docs/syntax.md
def empty_rec_reg : RecReg :=
  MkRecReg(Z, Nil RecInfo, Nil (List Nat), Nil RecBind);

-- Keep the next helper outside the public-export window of empty_rec_reg.

def empty_rec_owner_scope : RecOwnerScope :=
  MkRecOwnerScope
    (MkImpReg (Nil (List Nat)) (Nil (Pair (List Nat) (List Nat)))
      (Nil ImpRule)) (Nil (List Nat));


def empty_rec_env : RecEnv := MkRecEnv (Nil RecBind);

def rec_code_malformed : Nat := S Z;
def rec_code_dup : Nat := 2;
def rec_code_need_ty : Nat := 3;
def rec_code_missing : Nat := 4;
def rec_code_unknown : Nat := 5;
def rec_code_collide : Nat := 6;
def rec_code_proj : Nat := 7;

def ch_lf_p : Nat := source_ch_lf;
def ch_space_p : Nat := source_ch_space;
def ch_dq_p : Nat := source_ch_double_quote;
def ch_lparen_p : Nat := 40;
def ch_rparen_p : Nat := 41;
def ch_comma_p : Nat := 44;
def ch_dot_p : Nat := 46;
def ch_colon_p : Nat := 58;
def ch_semi_p : Nat := 59;
def ch_eq_p : Nat := 61;
def ch_lbrace_p : Nat := 123;
def ch_rbrace_p : Nat := 125;
def ch_lbrack_p : Nat := 91;
def ch_rbrack_p : Nat := 93;

def n1p (a : Nat) : List Nat := ([a] : List Nat);
def list1_recinfo (ri : RecInfo) : List RecInfo := ([ri] : List RecInfo);
def n2p (a : Nat) (b : Nat) : List Nat := Cons Nat a (n1p b);
def n3p (a : Nat) (b : Nat) (c : Nat) : List Nat := Cons Nat a (n2p b c);
def n4p (a : Nat) (b : Nat) (c : Nat) (d : Nat) : List Nat := Cons Nat a (n3p b c d);
def n5p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) : List Nat :=
  Cons Nat a (n4p b c d e);
def n6p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) : List Nat :=
  Cons Nat a (n5p b c d e f);
def n7p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) (g : Nat)
    : List Nat := Cons Nat a (n6p b c d e f g);
def n9p (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat) (g : Nat)
    (h : Nat) (i : Nat) : List Nat := Cons Nat a (Cons Nat b (n7p c d e f g h i));

def word_at (w : List Nat) (src : List Nat) : Bool := source_word_at w src;

def w_record : List Nat := n6p 114 101 99 111 114 100;
def w_where : List Nat := n5p 119 104 101 114 101;
def w_end : List Nat := n3p 101 110 100;
def w_constructor : List Nat :=
  Cons Nat 99 (Cons Nat 111 (n9p 110 115 116 114 117 99 116 111 114));
def w_def : List Nat := n3p 100 101 102;
def w_let_p : List Nat := n3p 108 101 116;
def w_axiom : List Nat := n5p 97 120 105 111 109;
def w_inductive : List Nat := n9p 105 110 100 117 99 116 105 118 101;
def w_effect : List Nat := n6p 101 102 102 101 99 116;
def w_intrinsic_p : List Nat := n9p 105 110 116 114 105 110 115 105 99;
def w_extern_p : List Nat := n6p 101 120 116 101 114 110;
def w_with : List Nat := n4p 119 105 116 104;
def w_Mk : List Nat := n2p 77 107;
def s_uscore : List Nat := n1p 95;
def s_inductive : List Nat :=
  Cons Nat 105 (n9p 110 100 117 99 116 105 118 101 32);
def s_colonsp : List Nat := n3p 32 58 32;
def s_arrow : List Nat := n4p 32 45 62 32;
def s_semi_nl : List Nat := n2p 59 10;
def s_defsp : List Nat := n4p 100 101 102 32;
def s_lp_p_colon : List Nat := n6p 32 40 112 32 58 32;
def s_rp_colon : List Nat := n4p 41 32 58 32;
def s_coloneqbar : List Nat := n7p 32 58 61 10 32 32 124;
def s_sp_bar_sp : List Nat := n2p 32 32;
def s_matchp : List Nat :=
  Cons Nat 32 (Cons Nat 58 (Cons Nat 61 (Cons Nat 32
    (n6p 109 97 116 99 104 32))));
def s_with_bar : List Nat := n7p 112 32 119 105 116 104 32;
def s_bar_sp : List Nat := n2p 124 32;
def s_arrow_end : List Nat := n4p 32 61 62 32;
def s_end_semi : List Nat := n6p 32 101 110 100 59 10;

def skip_ws_p (src : List Nat) : List Nat := source_skip_ws src;

def field_named (n : List Nat) : List RecField -> Bool :=
  fix field_named (fs : List RecField) : Bool :=
    match fs with
    | Nil => False
    | Cons f rest =>
        match f with
        | MkRecField fn _ => orb(source_bytes_equal n fn, field_named rest)
        end
    end;

def find_rec_idx (n : List Nat) (xs : List RecInfo) : Maybe Nat :=
  (fix go (rest : List RecInfo) (index : Nat) : Maybe Nat :=
    match rest with
    | Nil => Nothing Nat
    | Cons r tail =>
      match r with
      | MkRecInfo _ rn _ _ _ =>
        match source_bytes_equal n rn with
        | True => Just Nat index
        | False => go(tail, S index)
        end
      end
    end) xs Z;

def nth_rec : List RecInfo -> Nat -> Maybe RecInfo :=
  fix nth_rec (xs : List RecInfo) (i : Nat) : Maybe RecInfo :=
    match xs with
    | Nil => Nothing RecInfo
    | Cons r rest =>
        match i with
        | Z => Just RecInfo r
        | S i' => nth_rec rest i'
        end
    end;

def find_field_idx (n : List Nat) (fields : List RecField) : Maybe Nat :=
  (fix go (rest : List RecField) (index : Nat) : Maybe Nat :=
    match rest with
    | Nil => Nothing Nat
    | Cons f tail =>
      match f with
      | MkRecField fn _ =>
        match source_bytes_equal n fn with
        | True => Just Nat index
        | False => go(tail, S index)
        end
      end
    end) fields Z;

def env_lookup (env : RecEnv) (reg : RecReg) (n : List Nat) : Maybe Nat :=
  match env with
  | MkRecEnv bs =>
      (fix go (xs : List RecBind) : Maybe Nat :=
        match xs with
        | Nil =>
            match reg with
            | MkRecReg _ _ _ gs =>
                (fix go2 (ys : List RecBind) : Maybe Nat :=
                  match ys with
                  | Nil => Nothing Nat
                  | Cons b rest =>
                      match b with
                      | MkRecBind bn bi _ =>
                          match source_bytes_equal n bn with
                          | True => Just Nat bi
                          | False => go2 rest
                          end
                      end
                  end) gs
            end
        | Cons b rest =>
            match b with
            | MkRecBind bn bi _ =>
                match source_bytes_equal n bn with
                | True =>
                    match reg with
                    | MkRecReg _ recs _ _ =>
                        match eqNat bi (length RecInfo recs) with
                        | True => Nothing Nat
                        | False => Just Nat bi
                        end
                    end
                | False => go rest
                end
            end
        end) bs
  end;

def env_add (env : RecEnv) (n : List Nat) (i : Nat) : RecEnv :=
  match env with
  | MkRecEnv bs => MkRecEnv (Cons RecBind (MkRecBind n i (Nil Nat)) bs)
  end;

def env_mask (env : RecEnv) (reg : RecReg) (n : List Nat) : RecEnv :=
  match reg with
  | MkRecReg _ recs _ _ => env_add env n (length RecInfo recs)
  end;

def trim_bytes (xs : List Nat) : List Nat :=
  let drop_l : List Nat :=
    (fix go (ys : List Nat) : List Nat :=
      match ys with
      | Nil => Nil Nat
      | Cons c rest =>
          match source_is_ws c with
          | True => go rest
          | False => ys
          end
      end) xs in
  reverse Nat
    ((fix go (ys : List Nat) : List Nat :=
      match ys with
      | Nil => Nil Nat
      | Cons c rest =>
          match source_is_ws c with
          | True => go rest
          | False => ys
          end
      end) (reverse Nat drop_l));

def trim_left_bytes : List Nat -> List Nat :=
  fix trim_left_bytes (xs : List Nat) : List Nat :=
    match xs with
    | Nil => Nil Nat
    | Cons c rest =>
        match source_is_ws c with
        | True => trim_left_bytes rest
        | False => xs
        end
    end;

-- Import preprocessing creates this separator only for a declared alias.
-- Keep the whole atom for emitted references; the short member is only a
-- record-shape hint and module resolution still checks its owner.
def record_marker_parts (atom : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match source_take_ident atom with
  | MkPair alias after =>
      match after with
      | Cons mark suffix =>
          match eqNat mark 64 with
          | False => Nothing (Pair (List Nat) (List Nat))
          | True => match source_take_ident suffix with
            | MkPair member tail =>
                match member with
                | Nil => Nothing (Pair (List Nat) (List Nat))
                | Cons _ _ => match tail with
                  | Nil => Just (Pair (List Nat) (List Nat))
                      (MkPair (List Nat) (List Nat) alias member)
                  | Cons _ _ => Nothing (Pair (List Nat) (List Nat))
                  end
                end
            end
          end
      | Nil => Nothing (Pair (List Nat) (List Nat))
      end
  end;

def record_take_atom (src : List Nat) : Pair (List Nat) (List Nat) :=
  match source_take_ident src with
  | MkPair id after => match after with
    | Cons mark suffix => match eqNat mark 64 with
      | False => MkPair (List Nat) (List Nat) id after
      | True => match source_take_ident suffix with
        | MkPair member tail =>
            MkPair (List Nat) (List Nat)
              (append Nat id (Cons Nat mark member)) tail
        end
      end
    | Nil => MkPair (List Nat) (List Nat) id after
    end
  end;

-- A bare generated name may bind a local parameter or a declaration. Such
-- names make record sugar emit a compiler-owned alias for its actual owner.
def record_bare_atoms (src : List Nat) : List (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (in_record : Bool)
      (acc : List (List Nat))
      : List (List Nat) :=
    match fuel with
    | Z => acc
    | S remaining => match xs with
      | Nil => acc
      | Cons c rest =>
          match source_is_comment xs with
          | True => go remaining (source_skip_line rest) in_record acc
          | False => match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
            | True => go remaining (source_skip_literal xs) in_record acc
            | False => match source_is_ident_start c with
              | False => go remaining rest in_record acc
              | True => match record_take_atom xs with
                | MkPair atom after =>
                    let next_record : Bool :=
                      match source_bytes_equal atom w_record with
                      | True => True
                      | False => match source_bytes_equal atom w_end with
                        | True => False
                        | False => in_record
                        end
                      end in
                    let next : List Nat :=
                      match andb(in_record,
                          source_bytes_equal atom w_constructor) with
                      | False => after
                      | True => match source_take_ident (skip_ws_p after) with
                        | MkPair _ tail => tail
                        end
                      end in
                    match record_marker_parts atom with
                    | Just _ => go remaining next next_record acc
                    | Nothing => go remaining next next_record
                        (Cons (List Nat) atom acc)
                    end
                end
              end
            end
          end
      end
    end) (S (length Nat src)) src False (Nil (List Nat));

def record_qualifier (name : List Nat) : List Nat :=
  match record_marker_parts (trim_bytes name) with
  | Nothing => Nil Nat
  | Just parts => match parts with
    | MkPair alias _ => append Nat alias ([64] : List Nat)
    end
  end;

def record_alias_target (current : List Nat) (aliases : ImpReg)
    (alias : List Nat) : Maybe (List Nat) :=
  match aliases with
  | MkImpReg _ bindings _ =>
      (fix find (rest : List (Pair (List Nat) (List Nat)))
          : Maybe (List Nat) :=
        match rest with
        | Nil => Nothing (List Nat)
        | Cons binding tail => match binding with
          | MkPair name spelling =>
              match source_bytes_equal name alias with
              | True => Just (List Nat) (canon_path current spelling)
              | False => find tail
              end
          end
        end) bindings
  end;

def record_alias_for_owner (current : List Nat) (aliases : ImpReg)
    (owner : List Nat) : Maybe (List Nat) :=
  match aliases with
  | MkImpReg _ bindings _ =>
      (fix find (rest : List (Pair (List Nat) (List Nat)))
          : Maybe (List Nat) :=
        match rest with
        | Nil => Nothing (List Nat)
        | Cons binding tail => match binding with
          | MkPair alias spelling =>
              match source_bytes_equal (canon_path current spelling) owner with
              | True => Just (List Nat)
                  (append Nat alias ([64] : List Nat))
              | False => find tail
              end
          end
        end) bindings
  end;

def record_owner_prefix (reg : RecReg) (current : List Nat)
    (aliases : ImpReg) (index : Nat) : Maybe (List Nat) :=
  match reg with
  | MkRecReg _ recs _ _ => match nth_rec recs index with
    | Nothing => Nothing (List Nat)
    | Just info => match info with
      | MkRecInfo owner _ _ _ _ =>
          match source_bytes_equal owner current with
          | True => Just (List Nat) (Nil Nat)
          | False => match record_alias_for_owner current aliases owner with
            | Just qualifier => Just (List Nat) qualifier
            | Nothing => Just (List Nat) (Nil Nat)
            end
          end
      end
    end
  end;

def record_internal_alias (index : Nat) (suffix : Nat) : List Nat :=
  append Nat ([95, 111, 117, 114, 111, 95, 114, 95] : List Nat)
    (append Nat
      (map Nat Nat (fun (digit : Nat) => add 48 digit) (to_digits index))
      (Cons Nat 95
        (map Nat Nat (fun (digit : Nat) => add 48 digit)
          (to_digits suffix))));

def record_fresh_alias (index : Nat) (bare_atoms : List (List Nat))
    (aliases : ImpReg) : Maybe (List Nat) :=
  match aliases with
  | MkImpReg names _ _ =>
      (fix choose (fuel : Nat) (suffix : Nat) : Maybe (List Nat) :=
        match fuel with
        | Z => Nothing (List Nat)
        | S remaining =>
            let candidate : List Nat := record_internal_alias index suffix in
            match orb(name_in candidate bare_atoms, name_in candidate names) with
            | True => choose remaining (S suffix)
            | False => Just (List Nat) candidate
            end
        end) (S (add (length (List Nat) bare_atoms)
          (length (List Nat) names))) Z
  end;

def record_type_alias (index : Nat) (suffix : Nat) : List Nat :=
  append Nat ([95, 111, 117, 114, 111, 95, 116, 95] : List Nat)
    (append Nat
      (map Nat Nat (fun (digit : Nat) => add 48 digit) (to_digits index))
      (Cons Nat 95
        (map Nat Nat (fun (digit : Nat) => add 48 digit)
          (to_digits suffix))));

def record_fresh_type_alias (index : Nat) (bare_atoms : List (List Nat))
    (aliases : ImpReg) : Maybe (List Nat) :=
  match aliases with
  | MkImpReg names _ _ =>
      (fix choose (fuel : Nat) (suffix : Nat) : Maybe (List Nat) :=
        match fuel with
        | Z => Nothing (List Nat)
        | S remaining =>
            let candidate : List Nat := record_type_alias index suffix in
            match orb(name_in candidate bare_atoms, name_in candidate names) with
            | True => choose remaining (S suffix)
            | False => Just (List Nat) candidate
            end
        end) (S (add (length (List Nat) bare_atoms)
          (length (List Nat) names))) Z
  end;

def record_atomic_type (ty : List Nat) : Maybe (List Nat) :=
  match record_take_atom (skip_ws_p ty) with
  | MkPair atom rest => match atom with
    | Nil => Nothing (List Nat)
    | Cons _ _ => match skip_ws_p rest with
      | Nil => Just (List Nat) atom
      | Cons _ _ => Nothing (List Nat)
      end
    end
  end;

def record_field_type_index (fields : List RecField) (ty : List Nat)
    : Maybe Nat :=
  (fix go (remaining : List RecField) (index : Nat) : Maybe Nat :=
    match remaining with
    | Nil => Nothing Nat
    | Cons field tail => match field with
      | MkRecField _ candidate =>
          match source_bytes_equal candidate ty with
          | True => Just Nat index
          | False => go tail (S index)
          end
      end
    end) fields Z;

def record_type_marker (reg : RecReg) (aliases : ImpReg)
    (bare_atoms : List (List Nat)) (index : Nat) (ty : List Nat)
    : Maybe (List Nat) :=
  match record_atomic_type ty with
  | Nothing => Nothing (List Nat)
  | Just _ => match reg with
    | MkRecReg _ recs _ _ => match nth_rec recs index with
      | Nothing => Nothing (List Nat)
      | Just info => match info with
        | MkRecInfo _ _ _ fields _ =>
            match record_field_type_index fields ty with
            | Nothing => Nothing (List Nat)
            | Just field_index => match record_fresh_type_alias index bare_atoms aliases with
              | Nothing => Nothing (List Nat)
              | Just alias => Just (List Nat)
                  (append Nat alias (Cons Nat 64
                    (Cons Nat 116
                      (map Nat Nat (fun (digit : Nat) => add 48 digit)
                        (to_digits field_index)))))
              end
            end
        end
      end
    end
  end;

def record_path_suffix (dirs : List (List Nat))
    (target : List (List Nat))
    : Pair (List (List Nat)) (List (List Nat)) :=
  (fix go (left : List (List Nat)) (right : List (List Nat))
      : Pair (List (List Nat)) (List (List Nat)) :=
    match left with
    | Nil => MkPair (List (List Nat)) (List (List Nat)) left right
    | Cons segment more => match right with
      | Nil => MkPair (List (List Nat)) (List (List Nat)) left right
      | Cons other tail =>
          match source_bytes_equal segment other with
          | True => go more tail
          | False => MkPair (List (List Nat)) (List (List Nat)) left right
          end
      end
    end) dirs target;

def record_parent_segments : List (List Nat) -> List (List Nat) :=
  fix go (dirs : List (List Nat)) : List (List Nat) :=
    match dirs with
    | Nil => Nil (List Nat)
    | Cons _ rest => Cons (List Nat) ([46, 46] : List Nat) (go rest)
    end;

def record_relative_path (current : List Nat) (target : List Nat)
    : List Nat :=
  match record_path_suffix (drop_last (split_segs current))
      (split_segs target) with
  | MkPair parents suffix =>
      join_segs (append (List Nat) (record_parent_segments parents) suffix)
  end;

def record_marker_present (alias : List Nat) (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S remaining => match xs with
      | Nil => False
      | Cons c rest =>
          match source_is_comment xs with
          | True => go remaining (source_skip_line rest)
          | False => match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
            | True => go remaining (source_skip_literal xs)
            | False => match source_is_ident_start c with
              | False => go remaining rest
              | True => match record_take_atom xs with
                | MkPair atom after => match record_marker_parts atom with
                  | Nothing => go remaining after
                  | Just parts => match parts with
                    | MkPair prefix _ => match source_bytes_equal prefix alias with
                      | True => True
                      | False => go remaining after
                      end
                    end
                  end
                end
              end
            end
          end
      end
    end) (S (length Nat src)) src;

def record_grant_members (info : RecInfo) : List (List Nat) :=
  match info with
  | MkRecInfo _ name ctor fields _ =>
      Cons (List Nat) name (Cons (List Nat) ctor
        (map RecField (List Nat) (fun (field : RecField) =>
          match field with
          | MkRecField label _ => append Nat name (append Nat s_uscore label)
          end)
          fields))
  end;

def record_grants_for (alias : List Nat) (owner : List Nat)
    (members : List (List Nat)) (src : List Nat) : List ImpRule :=
  (fix go (fuel : Nat) (xs : List Nat) : List ImpRule :=
    match fuel with
    | Z => Nil ImpRule
    | S remaining => match xs with
      | Nil => Nil ImpRule
      | Cons c rest =>
          match source_is_comment xs with
          | True => go remaining (source_skip_line rest)
          | False => match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
            | True => go remaining (source_skip_literal xs)
            | False => match source_is_ident_start c with
              | False => go remaining rest
              | True => match record_take_atom xs with
                | MkPair atom after =>
                    let tail : List ImpRule := go remaining after in
                    match record_marker_parts atom with
                    | Nothing => tail
                    | Just parts => match parts with
                      | MkPair prefix member =>
                          match andb(source_bytes_equal prefix alias,
                              name_in member members) with
                          | True => Cons ImpRule
                              (ImpRecordGrant atom owner member) tail
                          | False => tail
                          end
                      end
                    end
                end
              end
            end
          end
      end
    end) (S (length Nat src)) src;

def record_atom_present (wanted : List Nat) (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => False
    | S remaining => match xs with
      | Nil => False
      | Cons c rest => match source_is_comment xs with
        | True => go remaining (source_skip_line rest)
        | False => match orb(eqNat c ch_dq_p, source_is_raw_start xs) with
          | True => go remaining (source_skip_literal xs)
          | False => match source_is_ident_start c with
            | False => go remaining rest
            | True => match record_take_atom xs with
              | MkPair atom after => match source_bytes_equal atom wanted with
                | True => True
                | False => go remaining after
                end
              end
            end
          end
        end
      end
    end) (S (length Nat src)) src;

def record_field_type_grants (reg : RecReg) (aliases : ImpReg)
    (bare_atoms : List (List Nat)) (index : Nat) (info : RecInfo)
    (src : List Nat) : List ImpRule :=
  match info with
  | MkRecInfo owner _ _ fields _ =>
      (fix go (remaining : List RecField) : List ImpRule :=
        match remaining with
        | Nil => Nil ImpRule
        | Cons field rest => match field with
          | MkRecField _ ty =>
              let tail : List ImpRule := go rest in
              match record_type_marker reg aliases bare_atoms index ty with
              | Nothing => tail
              | Just marker => match record_atom_present marker src with
                | False => tail
                | True => match record_atomic_type ty with
                  | Nothing => tail
                  | Just atom => Cons ImpRule
                      (ImpFieldTypeGrant marker owner atom) tail
                  end
                end
              end
          end
        end) fields
  end;
