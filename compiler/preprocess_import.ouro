-- Import qualification retains a marker for compiler-owned module resolution.
-- Expression opens remain in source for parser-owned scope boundaries.

-- @entry preprocess_imports
-- @export empty_imp_reg; @doc docs/syntax.md
-- @export imports_maybe_needed; @doc docs/syntax.md
-- @export preprocess_imports; @doc docs/syntax.md
-- @export preprocess_imports_reg; @doc docs/syntax.md

import "source_text.ouro",
  "lexer.ouro",
  "../std/data.ouro",
  "base.ouro",
  "pipeline_abi.ouro";

def empty_imp_reg : ImpReg :=
  MkImpReg (Nil (List Nat)) (Nil (Pair(List Nat, List Nat)));

def imp_code_malformed : Nat := S Z;
def imp_code_dup : Nat := 2;
def imp_code_unknown : Nat := 3;
def imp_code_badname : Nat := 4;
def imp_code_raw_marker : Nat := 5;

def ch_dq_i : Nat := source_ch_double_quote;
def ch_dot_i : Nat := 46;
def ch_marker_i : Nat := 64;
def ch_semi_i : Nat := 59;

def n1i (a : Nat) : List Nat := ([a] : List Nat);
def n2i (a : Nat) (b : Nat) : List Nat := Cons Nat a (n1i b);
def n3i (a : Nat) (b : Nat) (c : Nat) : List Nat := Cons Nat a (n2i b c);
def n4i (a : Nat) (b : Nat) (c : Nat) (d : Nat) : List Nat :=
  Cons Nat a (n3i b c d);
def n5i (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) : List Nat :=
  Cons Nat a (n4i b c d e);
def n6i (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) (f : Nat)
    : List Nat := Cons Nat a (n5i b c d e f);

def w_import : List Nat := n6i 105 109 112 111 114 116;
def w_as : List Nat := n2i 97 115;
def w_open : List Nat := n4i 111 112 101 110;
def w_in : List Nat := n2i 105 110;
def w_def_i : List Nat := n3i 100 101 102;
def w_let : List Nat := n3i 108 101 116;
def w_fun : List Nat := n3i 102 117 110;
def w_end_i : List Nat := n3i 101 110 100;
def w_Type : List Nat := n4i 84 121 112 101;
def w_intrinsic_i : List Nat := ([105, 110, 116, 114, 105, 110, 115, 105, 99] : List Nat);
def w_extern_i : List Nat := n6i 101 120 116 101 114 110;
def w_representation_i : List Nat :=
  ([114, 101, 112, 114, 101, 115, 101, 110, 116, 97, 116, 105, 111, 110] : List Nat);

def skip_ws_i (input : List Nat) : List Nat := source_skip_ws input;

def reserved_alias (n : List Nat) : Bool :=
  orb (source_bytes_equal n w_as)
    (orb (source_bytes_equal n w_open)
      (orb (source_bytes_equal n w_import)
        (orb (source_bytes_equal n w_in)
          (orb (source_bytes_equal n w_def_i)
            (orb (source_bytes_equal n w_let)
              (orb (source_bytes_equal n w_fun)
                (orb (source_bytes_equal n w_end_i)
                  (orb (source_bytes_equal n w_Type)
                    (orb (source_bytes_equal n w_intrinsic_i)
                      (orb (source_bytes_equal n w_extern_i)
                        (source_bytes_equal n w_representation_i)))))))))));

-- Validate the alias before extending the registry; zero means valid.
def import_alias_error (alias : List Nat) (aliases : List (List Nat)) : Nat :=
    match alias with
    | Nil => imp_code_malformed
    | Cons _ _ =>
        match reserved_alias alias with
        | True => imp_code_badname
        | False =>
            match name_in alias aliases with
            | True => imp_code_dup
            | False => Z
            end
        end
    end;

-- A legacy alias must stay on a single import. Otherwise erasing `as Alias`
-- would accidentally grant meaning to an alias inside a parser-owned group.
def import_single_alias_error (alias : List Nat) (aliases : List (List Nat))
    (after : List Nat) : Nat :=
    match source_starts(n1i 44, skip_ws_i after) with
    | True => imp_code_malformed
    | False => import_alias_error alias aliases
    end;

def copy_ws_i (acc : List Nat) (src : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (xs : List Nat) (a : List Nat) (comment : Bool) : Pair (List Nat) (List Nat) :=
    match xs with
    | Nil => MkPair(List Nat, List Nat, a, Nil Nat)
    | Cons c rest =>
        match comment with
        | True => go(rest, Cons Nat c a, notb (eqNat c source_ch_lf))
        | False =>
            match source_is_ws c with
            | True => go rest (Cons Nat c a) False
            | False =>
                match source_is_comment xs with
                | True => go rest (Cons Nat c a) True
                | False => MkPair(List Nat, List Nat, a, xs)
                end
            end
        end
    end) src acc False;

def imports_maybe_needed (src : List Nat) : Bool :=
  (fix go (fuel : Nat) (xs : List Nat) : Bool :=
    match fuel with
    | Z => True
    | S remaining =>
        match xs with
        | Nil => False
        | Cons c rest =>
            match source_is_comment xs with
            | True => go(remaining, source_skip_line rest)
            | False =>
                match eqNat c ch_marker_i with
                | True => True
                | False => match eqNat c ch_dq_i with
                | True => go(remaining, source_skip_string rest)
                | False =>
                    match source_is_raw_start xs with
                    | True => go(remaining, source_skip_literal xs)
                    | False =>
                    match source_word_at w_open xs with
                    | True => True
                    | False =>
                        match source_word_at w_as xs with
                        | True => True
                        | False =>
                            match source_is_ident_start c with
                            | True =>
                                match source_take_ident xs with
                                | MkPair _ after => go remaining after
                                end
                            | False => go remaining rest
                            end
                        end
                    end
                    end
                end
                end
            end
        end
    end) (S (length Nat src)) src;

def import_path_spelling (src : List Nat) : Maybe (List Nat) :=
  match source_is_raw_start src with
  | True =>
      match source_take_raw src with
      | Nothing => Nothing (List Nat)
      | Just parsed => match parsed with
        | MkPair path _ => Just(List Nat, path)
        end
      end
  | False =>
      match src with
      | Nil => Nothing (List Nat)
      | Cons quote rest =>
          match eqNat quote ch_dq_i with
          | False => Nothing (List Nat)
          | True =>
              match take_string (S (length Nat rest)) rest (Nil Nat) with
              | StrErr => Nothing (List Nat)
              | StrOk path _ => Just(List Nat, path)
              end
          end
      end
  end;

def import_mask_byte (byte : Nat) : Nat :=
  match orb(eqNat byte source_ch_lf, eqNat byte source_ch_cr) with
  | True => byte
  | False => source_ch_space
  end;

-- Erased import aliases and top-level opens use equal-length whitespace;
-- expression opens remain in place for lexical module resolution.
def import_mask_consumed (acc : List Nat) (before : List Nat)
    (after : List Nat) : List Nat :=
  source_emit_reversed acc
    (map Nat Nat import_mask_byte
      (take Nat (sub (length Nat before) (length Nat after)) before));

def import_copy_consumed (acc : List Nat) (before : List Nat)
    (after : List Nat) : List Nat :=
  source_emit_reversed acc
    (take Nat (sub (length Nat before) (length Nat after)) before);

-- @bound(cyclo <= 77)
def preprocess_imports_reg (reg0 : ImpReg) (src : List Nat)
    : Pair ImpReg ImpPrep :=
  match imports_maybe_needed src with
  | False => MkPair ImpReg ImpPrep reg0 (ImpOk src)
  | True =>
      (fix go (fuel : Nat) (aliases : List (List Nat))
          (bindings : List (Pair (List Nat) (List Nat)))
          (xs : List Nat) (acc : List Nat)
          : Pair ImpReg ImpPrep :=
        match fuel with
        | Z => MkPair(ImpReg, ImpPrep, MkImpReg aliases bindings,
            ImpErr imp_code_malformed Z)
        | S remaining =>
            match xs with
            | Nil =>
                MkPair(ImpReg, ImpPrep, MkImpReg aliases bindings,
                  ImpOk (reverse Nat acc))
            | Cons c rest =>
                match source_copy_comment_or_string acc xs with
                | Just p =>
                    match p with
                    | MkPair acc2 xs2 => go remaining aliases bindings xs2 acc2
                    end
                | Nothing =>
                    match source_word_at w_import xs with
                    | True =>
                        let after_kw : List Nat := source_drop_prefix w_import xs in
                        match copy_ws_i(source_emit_reversed acc w_import, after_kw) with
                        | MkPair acc2 xs2 =>
                            match import_path_spelling xs2 with
                            | Nothing =>
                                MkPair ImpReg ImpPrep (MkImpReg aliases bindings)
                                  (ImpErr imp_code_malformed Z)
                            | Just spelling =>
                              match source_copy_literal acc2 xs2 with
                              | Nothing =>
                                  MkPair ImpReg ImpPrep (MkImpReg aliases bindings)
                                    (ImpErr imp_code_malformed Z)
                              | Just sp => match sp with
                                | MkPair acc3 xs3 =>
                                    match copy_ws_i acc3 xs3 with
                                    | MkPair acc4 xs4 =>
                                        match source_word_at w_as xs4 with
                                        | False =>
                                            go remaining aliases bindings xs4 acc4
                                        | True =>
                                            let xs5 : List Nat :=
                                              skip_ws_i (source_drop_prefix w_as xs4) in
                                            match source_take_ident xs5 with
                                            | MkPair alias xs6 =>
                                                match import_single_alias_error alias aliases xs6 with
                                                | Z =>
                                                    go remaining (Cons (List Nat) alias aliases)
                                                      (Cons (Pair(List Nat, List Nat))
                                                        (MkPair(List Nat, List Nat, alias, spelling))
                                                        bindings) xs6
                                                      (import_mask_consumed acc4 xs4 xs6)
                                                | S code =>
                                                    MkPair ImpReg ImpPrep (MkImpReg aliases bindings)
                                                      (ImpErr(S code, Z))
                                                end
                                            end
                                        end
                                    end
                                end
                              end
                            end
                        end
                    | False =>
                        match source_word_at w_open xs with
                        | True =>
                            let xs2 : List Nat :=
                              skip_ws_i (source_drop_prefix w_open xs) in
                            match source_take_ident xs2 with
                            | MkPair alias xs3 =>
                                match alias with
                                | Nil =>
                                    MkPair ImpReg ImpPrep (MkImpReg aliases bindings)
                                      (ImpErr imp_code_malformed Z)
                                | Cons _ _ =>
                                    match name_in alias aliases with
                                    | False =>
                                        MkPair ImpReg ImpPrep (MkImpReg aliases bindings)
                                          (ImpErr imp_code_unknown Z)
                                    | True =>
                                        let xs4 : List Nat := skip_ws_i xs3 in
                                        match source_word_at w_in xs4 with
                                        | True =>
                                            go remaining aliases bindings
                                              (skip_ws_i (source_drop_prefix w_in xs4))
                                              (import_copy_consumed acc xs
                                                (skip_ws_i (source_drop_prefix w_in xs4)))
                                        | False =>
                                            match xs4 with
                                            | Cons sc xs5 =>
                                                match eqNat sc ch_semi_i with
                                                | True => go remaining aliases bindings xs5
                                                    (import_mask_consumed acc xs xs5)
                                                | False =>
                                                    MkPair ImpReg ImpPrep
                                                      (MkImpReg aliases bindings)
                                                      (ImpErr imp_code_malformed Z)
                                                end
                                            | Nil =>
                                                MkPair ImpReg ImpPrep
                                                  (MkImpReg aliases bindings)
                                                  (ImpErr imp_code_malformed Z)
                                            end
                                        end
                                    end
                                end
                            end
                        | False =>
                            match source_is_ident_start c with
                            | True =>
                                match source_take_ident xs with
                                | MkPair id after =>
                                    match after with
                                    | Cons d after2 =>
                                        match andb (eqNat d ch_dot_i)
                                              (name_in id aliases) with
                                        | True =>
                                            match source_take_ident after2 with
                                            | MkPair fld after3 =>
                                                match fld with
                                                | Nil =>
                                                    MkPair ImpReg ImpPrep
                                                      (MkImpReg aliases bindings)
                                                      (ImpErr imp_code_malformed Z)
                                                | Cons _ _ =>
                                                    go remaining aliases bindings after3
                                                      (source_emit_reversed
                                                        (Cons Nat ch_marker_i
                                                          (source_emit_reversed acc id)) fld)
                                                end
                                            end
                                        | False =>
                                            go remaining aliases bindings after
                                              (source_emit_reversed acc id)
                                        end
                                    | Nil =>
                                        go remaining aliases bindings after
                                          (source_emit_reversed acc id)
                                    end
                                end
                            | False =>
                                match eqNat c ch_marker_i with
                                | True => MkPair ImpReg ImpPrep (MkImpReg aliases bindings)
                                    (ImpErr imp_code_raw_marker Z)
                                | False => go remaining aliases bindings rest (Cons Nat c acc)
                                end
                            end
                        end
                    end
                end
            end
        end) (S (length Nat src))
          (match reg0 with | MkImpReg a _ => a end)
          (match reg0 with | MkImpReg _ b => b end)
          src (Nil Nat)
  end;

def preprocess_imports (src : List Nat) : ImpPrep :=
  match preprocess_imports_reg empty_imp_reg src with
  | MkPair _ r => r
  end;
