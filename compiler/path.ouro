-- Import paths are resolved against the importing file, not the process cwd, so cache keys are reproducible.

-- @entry canon_path

import "../std/data.ouro";
import "base.ouro";

def slash : Nat := 47;
def dot : Nat := 46;

-- Segments of a path, in order. Carries the segment under construction beside
-- the ones already closed, because a separator is only recognised after the
-- characters that precede it have been folded.
def split_go : List Nat -> Pair (List Nat) (List (List Nat)) :=
  fix split_go (cs : List Nat) : Pair (List Nat) (List (List Nat)) :=
    match cs with
    | Nil => MkPair (List Nat) (List (List Nat)) (Nil Nat) (Nil (List Nat))
    | Cons c cs' =>
        match split_go cs' with
        | MkPair cur segs =>
            match eqNat c slash with
            | True =>
                MkPair (List Nat) (List (List Nat)) (Nil Nat)
                  (Cons (List Nat) cur segs)
            | False => MkPair (List Nat) (List (List Nat)) (Cons Nat c cur) segs
            end
        end
    end;

def split_segs (p : List Nat) : List (List Nat) :=
  match split_go p with
  | MkPair cur segs => Cons (List Nat) cur segs
  end;

def is_empty_seg (s : List Nat) : Bool :=
  match s with
  | Nil => True
  | Cons _ _ => False
  end;

def is_dot (s : List Nat) : Bool :=
  match s with
  | Nil => False
  | Cons a t =>
      match t with
      | Nil => eqNat a dot
      | Cons _ _ => False
      end
  end;

def is_dotdot (s : List Nat) : Bool :=
  match s with
  | Nil => False
  | Cons a t =>
      match t with
      | Nil => False
      | Cons b t2 =>
          match t2 with
          | Nil => andb (eqNat a dot) (eqNat b dot)
          | Cons _ _ => False
          end
      end
  end;

-- Every segment but the last: the directory the importing file sits in.
def drop_last : List (List Nat) -> List (List Nat) :=
  fix drop_last (ss : List (List Nat)) : List (List Nat) :=
    match ss with
    | Nil => Nil (List Nat)
    | Cons s ss' =>
        match ss' with
        | Nil => Nil (List Nat)
        | Cons _ _ => Cons (List Nat) s (drop_last ss')
        end
    end;

-- The stack is held reversed so ".." pops without walking to the end. Popping
-- an empty stack yields an empty stack: a path that climbs above the root is
-- the host's problem, and it will fail to find the unit.
def apply_seg (stk : List (List Nat)) (s : List Nat) : List (List Nat) :=
  match orb (is_empty_seg s) (is_dot s) with
  | True => stk
  | False =>
      match is_dotdot s with
      | True =>
          match stk with
          | Nil => Nil (List Nat)
          | Cons _ t => t
          end
      | False => Cons (List Nat) s stk
      end
  end;

def apply_segs (stk : List (List Nat)) (ss : List (List Nat))
    : List (List Nat) :=
  (fix go (remaining : List (List Nat)) (stack : List (List Nat))
      : List (List Nat) :=
    match remaining with
    | Nil => stack
    | Cons segment rest => go rest (apply_seg stack segment)
    end) ss stk;

def join_segs : List (List Nat) -> List Nat :=
  fix join_segs (ss : List (List Nat)) : List Nat :=
    match ss with
    | Nil => Nil Nat
    | Cons s ss' =>
        match ss' with
        | Nil => s
        | Cons _ _ => append Nat s (Cons Nat slash (join_segs ss'))
        end
    end;

-- Reversing a segment stack: reverse from std/data.ouro is on List A, and a stack of
-- segments is a List (List Nat), which it handles once instantiated.
def canon_path (base : List Nat) (spelling : List Nat) : List Nat :=
  join_segs
    (reverse (List Nat)
      (apply_segs (reverse (List Nat) (drop_last (split_segs base)))
        (split_segs spelling)));
