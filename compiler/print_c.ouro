-- C emission targets the runtime ABI, not just text; JsIR tags must match extract.ouro and ouro_rt.h.
-- Binders become top-level C functions because closures are represented by explicit environment cells.

-- @entry print_c_module
-- @entry print_c_module_named

import "../std/data.ouro";
import "base.ouro";
import "jsir.ouro";

def divmod10_go : Nat -> Nat -> Nat -> Pair Nat Nat :=
  fix divmod10_go (fuel : Nat) (n : Nat) (q : Nat) : Pair Nat Nat :=
    match fuel with
    | Z => MkPair Nat Nat q n
    | S fuel' =>
        match compiler_lt_nat n ten with
        | True => MkPair Nat Nat q n
        | False => divmod10_go fuel' (sub n ten) (S q)
        end
    end;

def divmod10 (n : Nat) : Pair Nat Nat := divmod10_go n n Z;

def showNat_go : Nat -> Nat -> List Nat -> List Nat :=
  fix showNat_go (fuel : Nat) (n : Nat) (acc : List Nat) : List Nat :=
    match fuel with
    | Z => acc
    | S fuel' =>
        match divmod10 n with
        | MkPair q r =>
            let acc2 : List Nat := Cons Nat (add r 48) acc in
            match q with
            | Z => acc2
            | S _ => showNat_go fuel' q acc2
            end
        end
    end;

def showNat (n : Nat) : List Nat :=
    match n with
    | Z => [48]
    | S _ => showNat_go n n (Nil Nat)
    end;

def s1 (a : Nat) : List Nat := [a];

def s2 (a : Nat) (b : Nat) : List Nat := [a, b];

def s3 (a : Nat) (b : Nat) (c : Nat) : List Nat :=
    [a, b, c];

def s4 (a : Nat) (b : Nat) (c : Nat) (d : Nat) : List Nat :=
    [a, b, c, d];

def s5 (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : Nat) : List Nat :=
    [a, b, c, d, e];

def c_fuel : List Nat :=
  (append Nat (s5 47 42 102 117 101) (append Nat (s4 108 42 47 117) (append Nat (s5 110 100 101 102 105) (s3 110 101 100))));

def c_hdr : List Nat :=
  (append Nat (s5 35 105 110 99 108) (append Nat (s5 117 100 101 32 34) (append Nat (s5 111 117 114 111 95) (append Nat (s5 114 116 46 104 34) (s1 10)))));

def c_fwd_g : List Nat :=
  (append Nat (s5 115 116 97 116 105) (append Nat (s5 99 32 111 117 114) (append Nat (s5 111 95 118 32 42) (append Nat (s5 111 117 114 111 95) (s1 103)))));

def c_fwd_end : List Nat :=
  (append Nat (s5 40 118 111 105 100) (s3 41 59 10));

def c_cache : List Nat :=
  (append Nat (s5 115 116 97 116 105) (append Nat (s5 99 32 111 117 114) (append Nat (s5 111 95 118 32 42) (append Nat (s5 111 117 114 111 95) (s1 99)))));

def c_semi_lf : List Nat :=
  (s2 59 10);

def c_g_open : List Nat :=
  (append Nat (s5 40 118 111 105 100) (append Nat (s5 41 123 111 117 114) (append Nat (s5 111 95 101 110 118) (append Nat (s5 32 42 101 110 118) (append Nat (s5 61 48 59 40 118) (append Nat (s5 111 105 100 41 101) (append Nat (s5 110 118 59 105 102) (append Nat (s5 40 111 117 114 111) (s2 95 99)))))))));

def c_g_mid : List Nat :=
  (append Nat (s5 61 61 48 41 123)
    (append Nat (s5 111 117 114 111 95)
      (append Nat (s5 115 116 97 116 105)
        (append Nat (s5 99 95 98 101 103)
          (append Nat (s5 105 110 40 41 59)
            (append Nat (s5 111 117 114 111 95) (s1 99)))))));

def c_g_eq : List Nat :=
  (s1 61);

def c_g_ret : List Nat :=
  (append Nat (s5 59 111 117 114 111)
    (append Nat (s5 95 115 116 97 116)
      (append Nat (s5 105 99 95 101 110)
        (append Nat (s5 100 40 41 59 125)
          (append Nat (s5 114 101 116 117 114)
            (append Nat (s5 110 32 111 117 114) (s3 111 95 99)))))));

def c_g_end : List Nat :=
  (s3 59 125 10);

def c_f_open : List Nat :=
  (append Nat (s5 115 116 97 116 105) (append Nat (s5 99 32 111 117 114) (append Nat (s5 111 95 118 32 42) (append Nat (s5 111 117 114 111 95) (s1 102)))));

def c_f_sig : List Nat :=
  (append Nat (s5 40 111 117 114 111) (append Nat (s5 95 101 110 118 32) (append Nat (s5 42 101 110 118 48) (append Nat (s5 44 111 117 114 111) (append Nat (s5 95 118 32 42 97) (append Nat (s5 114 103 41 123 111) (append Nat (s5 117 114 111 95 101) (append Nat (s5 110 118 32 42 101) (append Nat (s5 110 118 61 111 117) (append Nat (s5 114 111 95 99 111) (append Nat (s5 110 115 40 97 114) (append Nat (s5 103 44 101 110 118) (append Nat (s5 48 41 59 40 118) (append Nat (s5 111 105 100 41 101) (append Nat (s5 110 118 59 114 101) (s5 116 117 114 110 32))))))))))))))));

def c_f_end : List Nat :=
  (s3 59 125 10);

def c_get : List Nat :=
  (append Nat (s5 111 117 114 111 95) (append Nat (s5 103 101 116 40 101) (s3 110 118 44)));

def c_rparen : List Nat :=
  (s1 41);

def c_comma : List Nat :=
  (s1 44);

def c_app : List Nat :=
  (append Nat (s5 111 117 114 111 95) (s4 97 112 112 40));

def c_ctor : List Nat :=
  (append Nat (s5 111 117 114 111 95) (s5 99 116 111 114 40));

def c_arr : List Nat :=
  (append Nat (s5 40 111 117 114 111) (append Nat (s5 95 118 32 42 91) (s3 93 41 123)));

def c_arr_end : List Nat :=
  (s2 125 41);

def c_zero_args : List Nat :=
  (s5 44 48 44 48 41);

def c_clos : List Nat :=
  (append Nat (s5 111 117 114 111 95) (append Nat (s5 99 108 111 115 40) (append Nat (s5 111 117 114 111 95) (s1 102))));

def c_env_end : List Nat :=
  (s5 44 101 110 118 41);

def c_fix : List Nat :=
  (append Nat (s5 111 117 114 111 95) (append Nat (s5 102 105 120 40 111) (s5 117 114 111 95 102)));

-- A zero-arity branch is not a lambda, so inlining it into the branch array
-- would evaluate it on every visit to the match. It becomes a thunk instead;
-- the thunk body does not cons its argument, so variable indices are unchanged.
def c_thunk : List Nat :=
  (append Nat (s5 111 117 114 111 95) (append Nat (s5 116 104 117 110 107) (append Nat (s5 40 111 117 114 111) (s2 95 116))));

def c_t_open : List Nat :=
  (append Nat (s5 115 116 97 116 105) (append Nat (s5 99 32 111 117 114) (append Nat (s5 111 95 118 32 42) (append Nat (s5 111 117 114 111 95) (s1 116)))));

def c_t_sig : List Nat :=
  (append Nat (s5 40 111 117 114 111) (append Nat (s5 95 101 110 118 32) (append Nat (s5 42 101 110 118 44) (append Nat (s5 111 117 114 111 95) (append Nat (s5 118 32 42 97 114) (append Nat (s5 103 41 123 40 118) (append Nat (s5 111 105 100 41 97) (append Nat (s5 114 103 59 40 118) (append Nat (s5 111 105 100 41 101) (append Nat (s5 110 118 59 114 101) (s5 116 117 114 110 32)))))))))));

def c_err : List Nat :=
  (append Nat (s5 111 117 114 111 95) (s4 101 114 114 40));

def c_g_call : List Nat :=
  (append Nat (s5 111 117 114 111 95) (s1 103));

def c_call_end : List Nat :=
  (s2 40 41);

def c_case : List Nat :=
  (append Nat (s5 111 117 114 111 95) (s5 99 97 115 101 40));

-- The export table carries the module name, so translation units emitted for
-- different modules define disjoint external symbols and can be linked into
-- one binary. An empty name reproduces the single-module form byte for byte.
def c_exp_count_open : List Nat :=
  (append Nat (s5 105 110 116 32 111) (append Nat (s5 117 114 111 95 101) (append Nat (s5 120 112 111 114 116) (append Nat (s5 95 99 111 117 110) (s1 116)))));

def c_exp_count_sig : List Nat :=
  (append Nat (s5 40 118 111 105 100) (append Nat (s5 41 123 114 101 116) (s4 117 114 110 32)));

def c_exp_count_end : List Nat :=
  (s3 59 125 10);

def c_exp_name_open : List Nat :=
  (append Nat (s5 99 111 110 115 116) (append Nat (s5 32 99 104 97 114) (append Nat (s5 32 42 111 117 114) (append Nat (s5 111 95 101 120 112) (append Nat (s5 111 114 116 95 110) (s3 97 109 101))))));

def c_exp_sw_sig : List Nat :=
  (append Nat (s5 40 105 110 116 32) (append Nat (s5 105 41 123 115 119) (append Nat (s5 105 116 99 104 40) (s3 105 41 123))));

def c_exp_name_end : List Nat :=
  (append Nat (s5 125 114 101 116 117) (append Nat (s5 114 110 32 34 34) (s3 59 125 10)));

def c_exp_val_open : List Nat :=
  (append Nat (s5 111 117 114 111 95) (append Nat (s5 118 32 42 111 117) (append Nat (s5 114 111 95 101 120) (append Nat (s5 112 111 114 116 95) (s5 118 97 108 117 101)))));

def c_exp_val_end : List Nat :=
  (append Nat (s5 125 114 101 116 117) (append Nat (s5 114 110 32 48 59) (s2 125 10)));

def c_case_kw : List Nat :=
  (s5 99 97 115 101 32);

def c_ret_str : List Nat :=
  (append Nat (s5 58 32 114 101 116) (s5 117 114 110 32 34));

def c_str_end : List Nat :=
  (s3 34 59 10);

def c_ret_g : List Nat :=
  (append Nat (s5 58 32 114 101 116) (append Nat (s5 117 114 110 32 111) (s5 117 114 111 95 103)));

def c_ret_g_end : List Nat :=
  (s4 40 41 59 10);

-- Position of a binder in the stack = ouro_get index. Absent id yields the
-- stack length, which ouro_get rejects at runtime (fail-closed).
def index_of : List Nat -> Nat -> Nat :=
  fix index_of (xs : List Nat) (n : Nat) : Nat :=
    match xs with
    | Nil => Z
    | Cons x xs' =>
        match eqNat x n with
        | True => Z
        | False => S (index_of xs' n)
        end
    end;

-- Saturated constructor application folds back into one JCtor, the only
-- shape C can build directly.
def reshape_ctor_app (j : JsIR) : Maybe JsIR :=
    match extract_collect_apps j (Nil JsIR) with
    | MkPair base spine =>
        match base with
        | JCtor ind tag cargs =>
            Just JsIR (JCtor ind tag (append JsIR cargs spine))
        | JVar _ => Nothing JsIR
        | JGlob _ => Nothing JsIR
        | JLam _ _ => Nothing JsIR
        | JApp _ _ => Nothing JsIR
        | JSwitch _ _ _ => Nothing JsIR
        | JFix _ _ _ => Nothing JsIR
        | JLet _ _ _ => Nothing JsIR
        | JErr _ => Nothing JsIR
        | JStr _ => Nothing JsIR
        | JStrBytes _ => Nothing JsIR
        end
    end;

-- Function names come from the position in the tree, not from binder ids:
-- extract.ouro restarts its name counter per match arm, so sibling arms share
-- ids (both arms of std append bind the same id). Each index is terminated by
-- '_', which keeps the encoding injective.
def show_path : List Nat -> List Nat :=
  fix show_path (p : List Nat) : List Nat :=
    match p with
    | Nil => Nil Nat
    | Cons i p' =>
        append Nat (showNat i) (append Nat (s1 95) (show_path p'))
    end;

def emit_fn (path : List Nat) (body : List Nat) : List Nat :=
    append Nat c_f_open
      (append Nat (show_path path)
        (append Nat c_f_sig (append Nat body c_f_end)));

def emit_clos (path : List Nat) : List Nat :=
    append Nat c_clos (append Nat (show_path path) c_env_end);

def emit_fix (path : List Nat) : List Nat :=
    append Nat c_fix (append Nat (show_path path) c_env_end);

def emit_thunk (path : List Nat) : List Nat :=
    append Nat c_thunk (append Nat (show_path path) c_env_end);

def emit_tfn (path : List Nat) (body : List Nat) : List Nat :=
    append Nat c_t_open
      (append Nat (show_path path)
        (append Nat c_t_sig (append Nat body c_f_end)));

-- Branch arity is encoded by the branch itself: extract.ouro emits one lambda
-- per bound field, so a non-lambda branch binds nothing.
def is_lam (j : JsIR) : Bool :=
    match j with
    | JVar _ => False
    | JGlob _ => False
    | JLam _ _ => True
    | JApp _ _ => False
    | JCtor _ _ _ => False
    | JSwitch _ _ _ => False
    | JFix _ _ _ => False
    | JLet _ _ _ => False
    | JErr _ => False
    | JStr _ => False
    | JStrBytes _ => False
    end;

-- Expression mode. Never crosses a binder, so the stack is fixed; the path
-- grows with each descent and must match emit_defs_work step for step.
inductive EMode : Type :=
  | EIr : List Nat -> List Nat -> JsIR -> EMode
  | EArgs : List Nat -> List Nat -> Nat -> List JsIR -> EMode
  | EBranches : List Nat -> List Nat -> Nat -> List JsIR -> EMode;

-- The transitional C emitter accepts resolved Core bytes too. Three-digit
-- octal escapes keep quotes, backslashes, NUL and adjacent digits unambiguous.
def c_divmod8 (value : Nat) : Pair Nat Nat :=
    (fix divide (fuel : Nat) (remaining : Nat) (quotient : Nat) : Pair Nat Nat :=
      match fuel with
      | Z => MkPair Nat Nat quotient remaining
      | S next => match compiler_lt_nat remaining 8 with
          | True => MkPair Nat Nat quotient remaining
          | False => divide next (sub remaining 8) (S quotient)
          end
      end) value value 0;

def c_escape_octet (byte : Nat) : List Nat :=
    match c_divmod8 byte with
    | MkPair quotient low => match c_divmod8 quotient with
        | MkPair high middle => [92, add 48 high, add 48 middle, add 48 low]
        end
    end;

def c_escape_bytes : List Nat -> List Nat :=
  fix escape (bytes : List Nat) : List Nat :=
    match bytes with
    | Nil => [34, 41]
    | Cons byte rest => append Nat (c_escape_octet byte) (escape rest)
    end;

def emit_work : Nat -> EMode -> List Nat :=
  fix emit_work (fuel : Nat) (m : EMode) : List Nat :=
    match fuel with
    | Z => c_fuel
    | S fuel' =>
        match m with
        | EIr stack path j =>
            match j with
            | JVar n =>
                append Nat c_get
                  (append Nat (showNat (index_of stack n)) c_rparen)
            | JGlob n =>
                append Nat c_g_call (append Nat (showNat n) c_call_end)
            | JStr n =>
                append Nat c_g_call (append Nat (showNat n) c_call_end)
            | JStrBytes bytes =>
                append Nat ([111, 117, 114, 111, 95, 115, 116, 114, 40, 34] : List Nat)
                  (c_escape_bytes bytes)
            | JErr code =>
                append Nat c_err (append Nat (showNat code) c_rparen)
            | JLam _n _body => emit_clos path
            | JLet _n val _body =>
                append Nat c_app
                  (append Nat (emit_clos path)
                    (append Nat c_comma
                      (append Nat
                        (emit_work fuel' (EIr stack (Cons Nat Z path) val))
                        c_rparen)))
            | JFix _fid _params _body => emit_fix path
            | JCtor _ind tag args =>
                match args with
                | Nil =>
                    append Nat c_ctor (append Nat (showNat tag) c_zero_args)
                | Cons a0 as0 =>
                    append Nat c_ctor
                      (append Nat (showNat tag)
                        (append Nat c_comma
                          (append Nat (showNat (length JsIR (Cons JsIR a0 as0)))
                            (append Nat c_comma
                              (append Nat c_arr
                                (append Nat
                                  (emit_work fuel'
                                    (EArgs stack path Z (Cons JsIR a0 as0)))
                                  c_arr_end))))))
                end
            | JApp f a =>
                match reshape_ctor_app (JApp f a) with
                | Just k => emit_work fuel' (EIr stack path k)
                | Nothing =>
                    append Nat c_app
                      (append Nat
                        (emit_work fuel' (EIr stack (Cons Nat Z path) f))
                        (append Nat c_comma
                          (append Nat
                            (emit_work fuel'
                              (EIr stack (Cons Nat (S Z) path) a))
                            c_rparen)))
                end
            | JSwitch scrut _ars bs =>
                match bs with
                | Nil =>
                    append Nat c_case
                      (append Nat
                        (emit_work fuel' (EIr stack (Cons Nat Z path) scrut))
                        c_zero_args)
                | Cons b0 bs0 =>
                    append Nat c_case
                      (append Nat
                        (emit_work fuel' (EIr stack (Cons Nat Z path) scrut))
                        (append Nat c_comma
                          (append Nat (showNat (length JsIR (Cons JsIR b0 bs0)))
                            (append Nat c_comma
                              (append Nat c_arr
                                (append Nat
                                  (emit_work fuel'
                                    (EBranches stack path (S Z)
                                      (Cons JsIR b0 bs0)))
                                  c_arr_end))))))
                end
            end
        | EArgs stack path i xs =>
            match xs with
            | Nil => Nil Nat
            | Cons x xs' =>
                match xs' with
                | Nil => emit_work fuel' (EIr stack (Cons Nat i path) x)
                | Cons y ys =>
                    append Nat
                      (emit_work fuel' (EIr stack (Cons Nat i path) x))
                      (append Nat c_comma
                        (emit_work fuel'
                          (EArgs stack path (S i) (Cons JsIR y ys))))
                end
            end
        | EBranches stack path i xs =>
            match xs with
            | Nil => Nil Nat
            | Cons x xs' =>
                match xs' with
                | Nil =>
                    match is_lam x with
                    | True => emit_work fuel' (EIr stack (Cons Nat i path) x)
                    | False => emit_thunk (Cons Nat i path)
                    end
                | Cons y ys =>
                    match is_lam x with
                    | True =>
                        append Nat
                          (emit_work fuel' (EIr stack (Cons Nat i path) x))
                          (append Nat c_comma
                            (emit_work fuel'
                              (EBranches stack path (S i) (Cons JsIR y ys))))
                    | False =>
                        append Nat (emit_thunk (Cons Nat i path))
                          (append Nat c_comma
                            (emit_work fuel'
                              (EBranches stack path (S i) (Cons JsIR y ys))))
                    end
                end
            end
        end
    end;

def big_fuel : Nat := mul (mul (mul ten ten) (mul ten ten)) (mul ten ten);

-- A fix parameter chain binds exactly like nested lambdas, so emit_defs_work
-- reuses its own JLam case instead of walking the parameter list separately.
def lams_of_params : List Nat -> JsIR -> JsIR :=
  fix lams_of_params (ps : List Nat) (body : JsIR) : JsIR :=
    match ps with
    | Nil => body
    | Cons p ps' => JLam p (lams_of_params ps' body)
    end;

-- Definition mode. Walks the same tree as emit_work with the same path steps
-- and emits one top-level function per binder. Inner functions come out before
-- the function that references them, so no forward declarations are needed.
inductive DMode : Type :=
  | DIr : List Nat -> List Nat -> JsIR -> DMode
  | DList : List Nat -> List Nat -> Nat -> List JsIR -> DMode
  | DBranches : List Nat -> List Nat -> Nat -> List JsIR -> DMode;

def emit_defs_work : Nat -> DMode -> List Nat :=
  fix emit_defs_work (fuel : Nat) (m : DMode) : List Nat :=
    match fuel with
    | Z => c_fuel
    | S fuel' =>
        match m with
        | DIr stack path j =>
            match j with
            | JVar _ => Nil Nat
            | JGlob _ => Nil Nat
            | JStr _ => Nil Nat
            | JStrBytes _ => Nil Nat
            | JErr _ => Nil Nat
            | JLam n body =>
                let inner : List Nat := Cons Nat n stack in
                let bpath : List Nat := Cons Nat Z path in
                append Nat (emit_defs_work fuel' (DIr inner bpath body))
                  (emit_fn path (emit_work big_fuel (EIr inner bpath body)))
            | JLet n val body =>
                let inner : List Nat := Cons Nat n stack in
                let bpath : List Nat := Cons Nat (S Z) path in
                append Nat
                  (emit_defs_work fuel' (DIr stack (Cons Nat Z path) val))
                  (append Nat (emit_defs_work fuel' (DIr inner bpath body))
                    (emit_fn path
                      (emit_work big_fuel (EIr inner bpath body))))
            | JApp f a =>
                match reshape_ctor_app (JApp f a) with
                | Just k => emit_defs_work fuel' (DIr stack path k)
                | Nothing =>
                    append Nat
                      (emit_defs_work fuel' (DIr stack (Cons Nat Z path) f))
                      (emit_defs_work fuel'
                        (DIr stack (Cons Nat (S Z) path) a))
                end
            | JCtor _ind _tag args =>
                emit_defs_work fuel' (DList stack path Z args)
            | JSwitch scrut _ars bs =>
                append Nat
                  (emit_defs_work fuel' (DIr stack (Cons Nat Z path) scrut))
                  (emit_defs_work fuel' (DBranches stack path (S Z) bs))
            | JFix fid params body =>
                emit_defs_work fuel'
                  (DIr (Cons Nat fid stack) path (lams_of_params params body))
            end
        | DList stack path i xs =>
            match xs with
            | Nil => Nil Nat
            | Cons x xs' =>
                append Nat
                  (emit_defs_work fuel' (DIr stack (Cons Nat i path) x))
                  (emit_defs_work fuel' (DList stack path (S i) xs'))
            end
        | DBranches stack path i xs =>
            match xs with
            | Nil => Nil Nat
            | Cons x xs' =>
                match is_lam x with
                | True =>
                    append Nat
                      (emit_defs_work fuel' (DIr stack (Cons Nat i path) x))
                      (emit_defs_work fuel' (DBranches stack path (S i) xs'))
                | False =>
                    append Nat
                      (emit_defs_work fuel' (DIr stack (Cons Nat i path) x))
                      (append Nat
                        (emit_tfn (Cons Nat i path)
                          (emit_work big_fuel (EIr stack (Cons Nat i path) x)))
                        (emit_defs_work fuel'
                          (DBranches stack path (S i) xs')))
                end
            end
        end
    end;

def emit_fwd (id : Nat) : List Nat :=
    append Nat c_fwd_g (append Nat (showNat id) c_fwd_end);

def emit_fwds : List (Pair Nat JsIR) -> List Nat :=
  fix emit_fwds (pieces : List (Pair Nat JsIR)) : List Nat :=
    match pieces with
    | Nil => Nil Nat
    | Cons p ps =>
        match p with
        | MkPair id _ir => append Nat (emit_fwd id) (emit_fwds ps)
        end
    end;

-- Root path is the global id, so function names cannot collide across pieces.
def emit_global (id : Nat) (ir : JsIR) : List Nat :=
    let root : List Nat := [id] in
    append Nat (emit_defs_work big_fuel (DIr (Nil Nat) root ir))
      (append Nat c_cache
        (append Nat (showNat id)
          (append Nat c_semi_lf
            (append Nat c_fwd_g
              (append Nat (showNat id)
                (append Nat c_g_open
                  (append Nat (showNat id)
                    (append Nat c_g_mid
                      (append Nat (showNat id)
                        (append Nat c_g_eq
                          (append Nat
                            (emit_work big_fuel (EIr (Nil Nat) root ir))
                            (append Nat c_g_ret
                              (append Nat (showNat id) c_g_end)))))))))))));

def emit_globals : List (Pair Nat JsIR) -> List Nat :=
  fix emit_globals (pieces : List (Pair Nat JsIR)) : List Nat :=
    match pieces with
    | Nil => Nil Nat
    | Cons p ps =>
        match p with
        | MkPair id ir =>
            append Nat (emit_global id ir) (emit_globals ps)
        end
    end;

def lookup_name : List (Pair Nat (List Nat)) -> Nat -> List Nat :=
  fix lookup_name (names : List (Pair Nat (List Nat))) (n : Nat) : List Nat :=
    match names with
    | Nil => Nil Nat
    | Cons p ps =>
        match p with
        | MkPair id codes =>
            match eqNat id n with
            | True => codes
            | False => lookup_name ps n
            end
        end
    end;

-- Missing/empty name → cN dialect.
def export_name (names : List (Pair Nat (List Nat))) (n : Nat) : List Nat :=
    match lookup_name names n with
    | Nil => append Nat (s1 99) (showNat n)
    | Cons c cs => Cons Nat c cs
    end;

def emit_export_names (names : List (Pair Nat (List Nat)))
    : List (Pair Nat JsIR) -> Nat -> List Nat :=
  fix emit_export_names (pieces : List (Pair Nat JsIR)) (i : Nat) : List Nat :=
    match pieces with
    | Nil => Nil Nat
    | Cons p ps =>
        match p with
        | MkPair id _ir =>
            append Nat c_case_kw
              (append Nat (showNat i)
                (append Nat c_ret_str
                  (append Nat (export_name names id)
                    (append Nat c_str_end
                      (emit_export_names ps (S i))))))
        end
    end;

def emit_export_vals : List (Pair Nat JsIR) -> Nat -> List Nat :=
  fix emit_export_vals (pieces : List (Pair Nat JsIR)) (i : Nat) : List Nat :=
    match pieces with
    | Nil => Nil Nat
    | Cons p ps =>
        match p with
        | MkPair id _ir =>
            append Nat c_case_kw
              (append Nat (showNat i)
                (append Nat c_ret_g
                  (append Nat (showNat id)
                    (append Nat c_ret_g_end (emit_export_vals ps (S i))))))
        end
    end;

def emit_exports (names : List (Pair Nat (List Nat))) (pieces : List (Pair Nat JsIR))
    (modname : List Nat) : List Nat :=
    append Nat c_exp_count_open
      (append Nat modname
        (append Nat c_exp_count_sig
          (append Nat (showNat (length (Pair Nat JsIR) pieces))
            (append Nat c_exp_count_end
              (append Nat c_exp_name_open
                (append Nat modname
                  (append Nat c_exp_sw_sig
                    (append Nat (emit_export_names names pieces Z)
                      (append Nat c_exp_name_end
                        (append Nat c_exp_val_open
                          (append Nat modname
                            (append Nat c_exp_sw_sig
                              (append Nat (emit_export_vals pieces Z)
                                c_exp_val_end)))))))))))));

def print_c_module_named (pieces : List (Pair Nat JsIR))
    (names : List (Pair Nat (List Nat))) (modname : List Nat) : List Nat :=
    append Nat c_hdr
      (append Nat (emit_fwds pieces)
        (append Nat (emit_globals pieces) (emit_exports names pieces modname)));

def print_c_module (pieces : List (Pair Nat JsIR)) (names : List (Pair Nat (List Nat))) : List Nat :=
    print_c_module_named pieces names (Nil Nat);
