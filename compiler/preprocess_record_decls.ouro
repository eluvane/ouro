-- Record sugar expands before lexing into ordinary inductive/accessor source accepted by the existing frontend.

import "preprocess_record_text.ouro";

def parse_record_fields (input : List Nat) (initial : List RecField) : RecParse :=
  (fix parse_record_fields (fuel : Nat) (xs : List Nat) (fs : List RecField) : RecParse :=
    match fuel with
    | Z => RecPErr rec_code_malformed
    | S remaining =>
        let xs1 : List Nat := skip_ws_p xs in
        match word_at w_end xs1 with
        | True =>
            let after : List Nat := skip_ws_p (source_drop_prefix w_end xs1) in
            match after with
            | Cons c rest =>
                match eqNat c ch_semi_p with
                | True =>
                    RecPOk (MkRecInfo(Nil Nat, Nil Nat, Nil Nat, reverse RecField fs,
                      empty_rec_owner_scope))
                      (Nil Nat) rest
                | False =>
                    RecPOk (MkRecInfo(Nil Nat, Nil Nat, Nil Nat, reverse RecField fs,
                      empty_rec_owner_scope))
                      (Nil Nat) after
                end
            | Nil =>
                RecPOk (MkRecInfo(Nil Nat, Nil Nat, Nil Nat, reverse RecField fs,
                  empty_rec_owner_scope))
                  (Nil Nat) (Nil Nat)
            end
        | False =>
            match word_at w_constructor xs1 with
            | True =>
                match source_take_ident (skip_ws_p (source_drop_prefix w_constructor xs1)) with
                | MkPair ctor rest =>
                    match ctor with
                    | Nil => RecPErr rec_code_malformed
                    | Cons _ _ =>
                        match skip_ws_p rest with
                        | Cons c rest2 =>
                            match eqNat c ch_semi_p with
                            | True =>
                                match parse_record_fields remaining rest2 fs with
                                | RecPErr e => RecPErr e
                                | RecPOk ri sort tail =>
                                    match ri with
                                    | MkRecInfo _ n _ fs2 imports =>
                                        RecPOk (MkRecInfo (Nil Nat) n ctor fs2 imports) sort tail
                                    end
                                end
                            | False => RecPErr rec_code_malformed
                            end
                        | Nil => RecPErr rec_code_malformed
                        end
                    end
                end
            | False =>
                match source_take_ident xs1 with
                | MkPair fld rest =>
                    match fld with
                    | Nil => RecPErr rec_code_malformed
                    | Cons _ _ =>
                        match field_named fld fs with
                        | True => RecPErr rec_code_dup
                        | False =>
                            match skip_ws_p rest with
                            | Cons c rest2 =>
                                match eqNat c ch_colon_p with
                                | True =>
                                    match take_until_char ch_semi_p rest2 with
                                    | MkPair ty rest3 =>
                                        match rest3 with
                                        | Cons sc rest4 =>
                                            match eqNat sc ch_semi_p with
                                            | True =>
                                                parse_record_fields remaining rest4
                                                  (Cons RecField
                                                    (MkRecField(fld, trim_left_bytes ty))
                                                    fs)
                                            | False => RecPErr rec_code_malformed
                                            end
                                        | Nil => RecPErr rec_code_malformed
                                        end
                                    end
                                | False => RecPErr rec_code_malformed
                                end
                            | Nil => RecPErr rec_code_malformed
                            end
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input initial;

def parse_record (src : List Nat) : RecParse :=
  match source_take_ident (skip_ws_p (source_drop_prefix w_record src)) with
  | MkPair name rest =>
      match name with
      | Nil => RecPErr rec_code_malformed
      | Cons _ _ =>
          match skip_ws_p rest with
          | Cons c rest2 =>
              match eqNat c ch_colon_p with
              | True =>
                  match take_until_word w_where rest2 with
                  | MkPair sort rest3 =>
                      match word_at w_where rest3 with
                      | False => RecPErr rec_code_malformed
                      | True =>
                          match parse_record_fields
                                  (source_drop_prefix w_where rest3)
                                  (Nil RecField) with
                          | RecPErr e => RecPErr e
                          | RecPOk ri _ tail =>
                              match ri with
                              | MkRecInfo _ _ ctor0 fs imports =>
                                  let ctor : List Nat :=
                                    match ctor0 with
                                    | Nil => append Nat w_Mk name
                                    | Cons _ _ => ctor0
                                    end in
                                  RecPOk (MkRecInfo (Nil Nat) name ctor fs imports)
                                    (trim_left_bytes sort) tail
                              end
                          end
                      end
                  end
              | False => RecPErr rec_code_malformed
              end
          | Nil => RecPErr rec_code_malformed
          end
      end
  end;

def collide_record (reg : RecReg) (ri : RecInfo) : Bool :=
  match reg with
  | MkRecReg _ _ names _ =>
      match ri with
      | MkRecInfo _ name ctor fs _ =>
          orb (name_in ctor names)
            ((fix go (xs : List RecField) : Bool :=
              match xs with
              | Nil => False
              | Cons f rest =>
                  match f with
                  | MkRecField n _ =>
                      orb(name_in(acc_name name n, names), go rest)
                  end
              end) fs)
      end
  end;

def register_record (reg : RecReg) (owner : List Nat) (aliases : ImpReg)
    (owner_names : List (List Nat))
    (ri : RecInfo) : RecReg :=
  match reg with
  | MkRecReg _ recs names gs =>
      match ri with
      | MkRecInfo _ name ctor fs _ =>
          let names1 : List (List Nat) :=
            Cons (List Nat) ctor
              ((fix go (xs : List RecField) (acc : List (List Nat))
                  : List (List Nat) :=
                match xs with
                | Nil => acc
                | Cons f rest =>
                    match f with
                    | MkRecField n _ =>
                        go(rest, Cons(List Nat, acc_name name n, acc))
                    end
                end) fs names) in
          MkRecReg Z (append RecInfo recs
            (list1_recinfo (MkRecInfo owner name ctor fs
              (MkRecOwnerScope aliases owner_names))))
            names1 gs
      end
  end;

def expand_record_decls (reg0 : RecReg) (owner : List Nat) (aliases : ImpReg)
    (owner_names : List (List Nat))
    (src : List Nat)
    : Pair RecReg PrepResult :=
  (fix go (scan_fuel : Nat) (reg : RecReg) (xs : List Nat) (acc : List Nat)
      : Pair RecReg PrepResult :=
    match scan_fuel with
    | Z => MkPair RecReg PrepResult reg (PrepErr rec_code_malformed Z)
    | S remaining =>
        match xs with
        | Nil => MkPair RecReg PrepResult reg (PrepOk (reverse Nat acc))
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just p =>
                match p with
                | MkPair acc2 xs2 => go remaining reg xs2 acc2
                end
            | Nothing =>
                match source_is_ident_start c with
                | True =>
                    match source_take_ident xs with
                    | MkPair id after =>
                        match source_bytes_equal id w_record with
                        | True =>
                            match parse_record xs with
                            | RecPErr e => MkPair RecReg PrepResult reg (PrepErr e Z)
                            | RecPOk ri sort tail =>
                                match collide_record reg ri with
                                | True =>
                                    MkPair RecReg PrepResult reg
                                      (PrepErr rec_code_collide Z)
                                | False =>
                                    go remaining
                                      (register_record reg owner aliases owner_names ri) tail
                                      (emit_record acc ri sort)
                                end
                            end
                        | False => go remaining reg after (emit acc id)
                        end
                    end
                | False => go remaining reg rest (Cons Nat c acc)
                end
            end
        end
    end) (S (length Nat src)) reg0 src (Nil Nat);

def take_until_comma_or_end (xs0 : List Nat)
    : Pair (List Nat) (List Nat) :=
  (fix go (fuel : Nat) (xs : List Nat) (acc : List Nat) (depth : Nat)
      : Pair (List Nat) (List Nat) :=
    match fuel with
    | Z => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
    | S remaining =>
        match xs with
        | Nil => MkPair(List Nat, List Nat, reverse Nat acc, Nil Nat)
        | Cons c rest =>
            match source_copy_comment_or_string acc xs with
            | Just copied =>
                match copied with
                | MkPair acc2 tail => go remaining tail acc2 depth
                end
            | Nothing =>
                match andb (eqNat depth Z)
                      (orb(eqNat c ch_comma_p, eqNat c ch_rbrace_p)) with
                | True => MkPair(List Nat, List Nat, reverse Nat acc, xs)
                | False => go remaining rest (Cons Nat c acc) (bump_depth c depth)
                end
            end
        end
    end) (S (length Nat xs0)) xs0 (Nil Nat) Z;

def all_seen (n : Nat) (seen : List Nat) : Bool :=
  (fix go (remaining : Nat) : Bool :=
    match remaining with
    | Z => True
    | S index => andb(memNat index seen, go index)
    end) n;

def lookup_val (idx : Nat) : List (Pair Nat (List Nat)) -> List Nat :=
  fix lookup_val (xs : List (Pair Nat (List Nat))) : List Nat :=
    match xs with
    | Nil => Nil Nat
    | Cons p rest =>
        match p with
        | MkPair i v =>
            match eqNat i idx with
            | True => v
            | False => lookup_val rest
            end
        end
    end;

def build_ctor_app (ctor : List Nat) (fs : List RecField)
    (vals : List (Pair Nat (List Nat))) : List Nat :=
  reverse Nat
    ((fix go (left : List RecField) (i : Nat) (acc : List Nat) : List Nat :=
      match left with
      | Nil => acc
      | Cons _ rest =>
          let a1 : List Nat := Cons Nat ch_space_p acc in
          let a2 : List Nat := Cons Nat ch_lparen_p a1 in
          let a3 : List Nat := emit(a2, lookup_val i vals) in
          go(rest, S i, Cons Nat ch_rparen_p a3)
      end) fs Z (emit(Nil Nat, ctor)));

def parse_literal_field_value (field : List Nat) (after : List Nat)
    : Maybe (Pair (List Nat) (List Nat)) :=
  match after with
  | Nil => Just(Pair(List Nat, List Nat), MkPair(List Nat, List Nat, field, Nil Nat))
  | Cons c rest =>
      match eqNat c ch_comma_p with
      | True => Just(Pair(List Nat, List Nat), MkPair(List Nat, List Nat, field, rest))
      | False =>
          match eqNat c ch_colon_p with
          | False => Nothing (Pair(List Nat, List Nat))
          | True =>
              match rest with
              | Nil => Nothing (Pair(List Nat, List Nat))
              | Cons equals value_src =>
                  match eqNat equals ch_eq_p with
                  | False => Nothing (Pair(List Nat, List Nat))
                  | True =>
                      match take_until_comma_or_end value_src with
                      | MkPair raw remainder =>
                          -- Keep a trailing comment's newline before generated parentheses.
                          let value : List Nat := skip_ws_p raw in
                          match value with
                          | Nil => Nothing (Pair(List Nat, List Nat))
                          | Cons _ _ =>
                              let next : List Nat := skip_ws_p remainder in
                              match next with
                              | Nil => Just(Pair(List Nat, List Nat),
                                  MkPair(List Nat, List Nat, raw, Nil Nat))
                              | Cons comma tail =>
                                  match eqNat comma ch_comma_p with
                                  | True => Just(Pair(List Nat, List Nat),
                                      MkPair(List Nat, List Nat, raw, tail))
                                  | False => Nothing (Pair(List Nat, List Nat))
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
  end;

def fill_literal_go (fs : List RecField) (ctor : List Nat) (n : Nat)
    (rewrite_value : Nat -> List Nat -> RewriteR)
    (input : List Nat) (initial_seen : List Nat) (initial_vals : List (Pair Nat (List Nat))) : RewriteR :=
  (fix fill_literal_go (fuel : Nat) (xs : List Nat) (seen : List Nat)
      (vals : List (Pair Nat (List Nat))) : RewriteR :=
    match fuel with
    | Z => RwErr rec_code_malformed
    | S remaining =>
        let xs1 : List Nat := skip_ws_p xs in
        match xs1 with
        | Nil =>
            match all_seen n seen with
            | False => RwErr rec_code_missing
            | True => RwOk(build_ctor_app ctor fs vals, Nil Nat)
            end
        | Cons c _ =>
            match eqNat c ch_rbrace_p with
            | True =>
                match all_seen n seen with
                | False => RwErr rec_code_missing
                | True => RwOk(build_ctor_app ctor fs vals, Nil Nat)
                end
            | False =>
                match source_take_ident xs1 with
                | MkPair fld rest =>
                    match fld with
                    | Nil => RwErr rec_code_malformed
                    | Cons _ _ =>
                        match parse_literal_field_value fld (skip_ws_p rest) with
                        | Nothing => RwErr rec_code_malformed
                        | Just parsed =>
                            match parsed with
                            | MkPair value tail =>
                                match find_field_idx fld fs with
                                | Nothing => RwErr rec_code_unknown
                                | Just idx =>
                                    match memNat idx seen with
                                    | True => RwErr rec_code_dup
                                    | False =>
                                        match rewrite_value idx value with
                                        | RwErr code => RwErr code
                                        | RwOk rewritten _ =>
                                            fill_literal_go remaining tail (Cons Nat idx seen)
                                              (Cons (Pair(Nat, List Nat))
                                                (MkPair Nat (List Nat) idx rewritten) vals)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end) (S (length Nat input)) input initial_seen initial_vals;

def fill_literal (fs : List RecField) (ctor : List Nat) (inner : List Nat)
    (rewrite_value : Nat -> List Nat -> RewriteR) : RewriteR :=
  fill_literal_go fs ctor (length RecField fs) rewrite_value inner (Nil Nat)
    (Nil (Pair(Nat, List Nat)));
