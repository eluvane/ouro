-- Named core is the last frontend form before de Bruijn lowering into the kernel-facing CoreTerm.

import "../std/data.ouro",
  "base.ouro";

inductive CaseInfo : Type :=
  | MkCaseInfo : Nat -> Nat -> List Nat -> CaseInfo;

inductive Surface : Type :=
  | SVar       : Nat -> Surface
  | SSort      : Nat -> Surface
  | SPi        : Nat -> Surface -> Surface -> Surface
  | SLam       : Nat -> Surface -> Surface -> Surface
  | SApp       : Surface -> Surface -> Surface
  | SLet       : Nat -> Surface -> Surface -> Surface -> Surface
  | SConst     : Nat -> Surface
  | SInd       : Nat -> Surface
  | SConstruct : Nat -> Nat -> Nat -> Surface
  | SCase      : CaseInfo -> Surface -> Surface -> List Surface -> Surface
  | SFix       : Nat -> Nat -> Nat -> Surface -> Surface -> Surface
  | SHole      : Nat -> Surface
  | SEffectRow : Surface -> Surface
  | SPerform   : Nat -> List Surface -> Surface
  | SStr       : Nat -> Nat -> Surface;

-- The kernel term: what elaboration produces and extraction consumes.
-- CStrLit carries an unresolved (string-id, String-const-id); tag 11.
-- CStrBytes carries resolved bytes and the String type ID; tag 12.
-- Parsing keeps interned IDs; declaration plans resolve them before checking.
-- The checker and normalizer reject unresolved literals.
inductive CoreTerm : Type :=
  | CRel       : Nat -> CoreTerm
  | CSort      : Nat -> CoreTerm
  | CPi        : CoreTerm -> CoreTerm -> CoreTerm
  | CLam       : CoreTerm -> CoreTerm -> CoreTerm
  | CApp       : CoreTerm -> CoreTerm -> CoreTerm
  | CLetIn     : CoreTerm -> CoreTerm -> CoreTerm -> CoreTerm
  | CConst     : Nat -> CoreTerm
  | CInd       : Nat -> CoreTerm
  | CConstruct : Nat -> Nat -> Nat -> CoreTerm
  | CCase      : CaseInfo -> CoreTerm -> CoreTerm -> List CoreTerm -> CoreTerm
  | CFix       : Nat -> Nat -> Nat -> CoreTerm -> CoreTerm -> CoreTerm
  | CStrLit    : Nat -> Nat -> CoreTerm
  | CStrBytes  : List Nat -> Nat -> CoreTerm;

-- Shared sort view for declaration checking and type-argument erasure.
def core_sort_level (t : CoreTerm) : Maybe Nat :=
    match t with
    | CSort u => Just Nat u
    | CRel _ => Nothing Nat
    | CPi _ _ => Nothing Nat
    | CLam _ _ => Nothing Nat
    | CApp _ _ => Nothing Nat
    | CLetIn _ _ _ => Nothing Nat
    | CConst _ => Nothing Nat
    | CInd _ => Nothing Nat
    | CConstruct _ _ _ => Nothing Nat
    | CStrBytes _ _ => Nothing Nat
    | CStrLit _ _ => Nothing Nat
    | CCase _ _ _ _ => Nothing Nat
    | CFix _ _ _ _ _ => Nothing Nat
    end;

def surface_names : List (Pair Nat Surface) -> List Nat :=
  fix surface_names (xs : List (Pair Nat Surface)) : List Nat :=
    match xs with
    | Nil => Nil Nat
    | Cons p xs' =>
        match p with
        | MkPair name _ => Cons Nat name (surface_names xs')
        end
    end;
