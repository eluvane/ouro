-- Pure helpers and canonical primitive contracts. Kept separate from the
-- leaf ADT model so declaration and AST consumers need not load the catalog.
import "primitive_model.ouro";

-- One byte radix; extended primitive codes retain their existing offsets.
def primitive_byte_base : Nat := 256;

def primitive_word_code (word : PrimitiveWord) : Nat :=
    match word with | PrimitiveWordU8 => 0 | PrimitiveWordU32 => 1
    | PrimitiveWordU64 => 2 | PrimitiveWordI32 => 3 | PrimitiveWordUSize => 4 end;
def primitive_word_equal (a : PrimitiveWord) (b : PrimitiveWord) : Bool :=
    eqNat (primitive_word_code a) (primitive_word_code b);
def primitive_word_bits (word : PrimitiveWord) : Nat :=
    match word with | PrimitiveWordU8 => 8 | PrimitiveWordU32 => 32
    | PrimitiveWordU64 => 64 | PrimitiveWordI32 => 32 | PrimitiveWordUSize => 64 end;
def primitive_word_size (word : PrimitiveWord) : Nat :=
    match word with | PrimitiveWordU8 => 1 | PrimitiveWordU32 => 4
    | PrimitiveWordU64 => 8 | PrimitiveWordI32 => 4 | PrimitiveWordUSize => 8 end;
def primitive_word_type (word : PrimitiveWord) : PrimitiveId :=
    match word with | PrimitiveWordU8 => PrimitiveU8Type | PrimitiveWordU32 => PrimitiveU32Type
    | PrimitiveWordU64 => PrimitiveU64Type | PrimitiveWordI32 => PrimitiveI32Type
    | PrimitiveWordUSize => PrimitiveUSizeType end;
def primitive_role_code (role : PrimitiveRole) : Nat :=
    match role with | PrimitiveNatRole => 0 | PrimitiveBoolRole => 1 | PrimitiveUnitRole => 2
    | PrimitiveListRole => 3 | PrimitiveMaybeRole => 4 | PrimitivePairRole => 5 end;

def primitive_word_checked (op : PrimitiveWordOp) : Bool :=
    match op with
    | PrimitiveAddChecked => True | PrimitiveSubChecked => True | PrimitiveMulChecked => True
    | PrimitiveDivChecked => True | PrimitiveRemChecked => True
    | PrimitiveAddWrap => False | PrimitiveSubWrap => False | PrimitiveMulWrap => False
    | PrimitiveBitAnd => False | PrimitiveBitOr => False | PrimitiveBitXor => False
    | PrimitiveShiftLeft => False | PrimitiveShiftRight => False
    | PrimitiveWordEqual => False | PrimitiveWordLess => False end;
def primitive_word_shift (op : PrimitiveWordOp) : Bool :=
    match op with | PrimitiveShiftLeft => True | PrimitiveShiftRight => True
    | PrimitiveAddWrap => False | PrimitiveSubWrap => False | PrimitiveMulWrap => False
    | PrimitiveBitAnd => False | PrimitiveBitOr => False | PrimitiveBitXor => False
    | PrimitiveWordEqual => False | PrimitiveWordLess => False
    | PrimitiveAddChecked => False | PrimitiveSubChecked => False | PrimitiveMulChecked => False
    | PrimitiveDivChecked => False | PrimitiveRemChecked => False end;
def primitive_word_comparison (op : PrimitiveWordOp) : Bool :=
    match op with | PrimitiveWordEqual => True | PrimitiveWordLess => True
    | PrimitiveAddWrap => False | PrimitiveSubWrap => False | PrimitiveMulWrap => False
    | PrimitiveBitAnd => False | PrimitiveBitOr => False | PrimitiveBitXor => False
    | PrimitiveShiftLeft => False | PrimitiveShiftRight => False
    | PrimitiveAddChecked => False | PrimitiveSubChecked => False | PrimitiveMulChecked => False
    | PrimitiveDivChecked => False | PrimitiveRemChecked => False end;

def primitive_type_signature (id : PrimitiveId) : Maybe CoreTerm :=
    match id with
    | PrimitiveU8Type => Just CoreTerm (CSort 0) | PrimitiveU32Type => Just CoreTerm (CSort 0)
    | PrimitiveU64Type => Just CoreTerm (CSort 0) | PrimitiveI32Type => Just CoreTerm (CSort 0)
    | PrimitiveUSizeType => Just CoreTerm (CSort 0) | PrimitiveStringType => Just CoreTerm (CSort 0)
    | PrimitiveRawPtrType => Just CoreTerm (CPi (CSort 0) (CSort 0))
    | PrimitiveRuntimeType => Just CoreTerm (CPi (CSort 0) (CSort 0))
    | PrimitiveRawFnType => Just CoreTerm (CPi (CSort 0) (CSort 0))
    | PrimitiveWordOperation _ _ => Nothing CoreTerm | PrimitiveWordConversion _ _ _ => Nothing CoreTerm
    | PrimitiveWordFromNat _ => Nothing CoreTerm | PrimitiveWordToNat _ => Nothing CoreTerm
    | PrimitiveStringOperation _ => Nothing CoreTerm | PrimitiveRuntimePure => Nothing CoreTerm
    | PrimitiveRuntimeBind => Nothing CoreTerm | PrimitiveRuntimeLoop => Nothing CoreTerm
    | PrimitiveRawNull => Nothing CoreTerm | PrimitiveRawLoad => Nothing CoreTerm
    | PrimitiveRawStore => Nothing CoreTerm | PrimitiveRawAddWrap => Nothing CoreTerm
    | PrimitiveRawCast => Nothing CoreTerm | PrimitiveRawToBits => Nothing CoreTerm
    | PrimitiveRawFromBits => Nothing CoreTerm | PrimitiveFnCall => Nothing CoreTerm
    | PrimitiveStdoutWrite => Nothing CoreTerm | PrimitiveStderrWrite => Nothing CoreTerm
    | PrimitiveStdoutFlush => Nothing CoreTerm | PrimitiveProcessExit => Nothing CoreTerm
    | PrimitiveArgv => Nothing CoreTerm | PrimitiveEnvGet => Nothing CoreTerm
    | PrimitiveTimeNow => Nothing CoreTerm
    | PrimitiveFileKind => Nothing CoreTerm
    | PrimitiveFileExists => Nothing CoreTerm | PrimitiveFileIsDirectory => Nothing CoreTerm
    | PrimitiveDirectoryCreate => Nothing CoreTerm | PrimitivePathRemove => Nothing CoreTerm
    | PrimitiveFileCopy => Nothing CoreTerm
    | PrimitiveFileRename => Nothing CoreTerm
    | PrimitiveFileReplace => Nothing CoreTerm
    | PrimitiveFileRealpath => Nothing CoreTerm
    | PrimitiveFileTemp => Nothing CoreTerm | PrimitiveFileTempIn => Nothing CoreTerm
    | PrimitiveProcessInherit => Nothing CoreTerm
    | PrimitiveProcessBounded => Nothing CoreTerm
    | PrimitiveProcessCapture => Nothing CoreTerm | PrimitiveHttpPost => Nothing CoreTerm
    | PrimitiveStdinReadLine => Nothing CoreTerm | PrimitiveStdinReadBytes => Nothing CoreTerm
    | PrimitiveFileRead => Nothing CoreTerm | PrimitiveFileWrite => Nothing CoreTerm
    | PrimitiveDirectoryList => Nothing CoreTerm | PrimitiveDirectoryListable => Nothing CoreTerm end;

def primitive_execution (id : PrimitiveId) : PrimitiveExecution :=
    match primitive_type_signature id with | Just _ => PrimitiveTypeOnly
    | Nothing => match id with
      | PrimitiveRuntimePure => PrimitiveRuntimeAction | PrimitiveRuntimeBind => PrimitiveRuntimeAction
      | PrimitiveRuntimeLoop => PrimitiveRuntimeAction | PrimitiveRawLoad => PrimitiveRuntimeAction
      | PrimitiveRawStore => PrimitiveRuntimeAction | PrimitiveRawAddWrap => PrimitiveRuntimeAction
      | PrimitiveRawCast => PrimitiveRuntimeAction | PrimitiveRawToBits => PrimitiveRuntimeAction
      | PrimitiveRawFromBits => PrimitiveRuntimeAction | PrimitiveFnCall => PrimitiveRuntimeAction
      | PrimitiveStdoutWrite => PrimitiveRuntimeAction | PrimitiveStderrWrite => PrimitiveRuntimeAction
      | PrimitiveStdoutFlush => PrimitiveRuntimeAction | PrimitiveProcessExit => PrimitiveRuntimeAction
      | PrimitiveArgv => PrimitiveRuntimeAction | PrimitiveEnvGet => PrimitiveRuntimeAction
      | PrimitiveTimeNow => PrimitiveRuntimeAction
      | PrimitiveFileKind => PrimitiveRuntimeAction
      | PrimitiveFileExists => PrimitiveRuntimeAction | PrimitiveFileIsDirectory => PrimitiveRuntimeAction
      | PrimitiveDirectoryCreate => PrimitiveRuntimeAction | PrimitivePathRemove => PrimitiveRuntimeAction
      | PrimitiveFileCopy => PrimitiveRuntimeAction
      | PrimitiveFileRename => PrimitiveRuntimeAction
      | PrimitiveFileReplace => PrimitiveRuntimeAction
    | PrimitiveFileRealpath => PrimitiveRuntimeAction
      | PrimitiveFileTemp => PrimitiveRuntimeAction | PrimitiveFileTempIn => PrimitiveRuntimeAction
      | PrimitiveProcessInherit => PrimitiveRuntimeAction
      | PrimitiveProcessBounded => PrimitiveRuntimeAction
    | PrimitiveProcessCapture => PrimitiveRuntimeAction | PrimitiveHttpPost => PrimitiveRuntimeAction
      | PrimitiveStdinReadLine => PrimitiveRuntimeAction | PrimitiveStdinReadBytes => PrimitiveRuntimeAction
      | PrimitiveFileRead => PrimitiveRuntimeAction | PrimitiveFileWrite => PrimitiveRuntimeAction
      | PrimitiveDirectoryList => PrimitiveRuntimeAction | PrimitiveDirectoryListable => PrimitiveRuntimeAction
      | PrimitiveRawNull => PrimitivePureValue | PrimitiveWordOperation _ _ => PrimitivePureValue
      | PrimitiveWordConversion _ _ _ => PrimitivePureValue | PrimitiveWordFromNat _ => PrimitivePureValue
      | PrimitiveWordToNat _ => PrimitivePureValue | PrimitiveStringOperation _ => PrimitivePureValue
      | PrimitiveU8Type => PrimitiveTypeOnly | PrimitiveU32Type => PrimitiveTypeOnly
      | PrimitiveU64Type => PrimitiveTypeOnly | PrimitiveI32Type => PrimitiveTypeOnly
      | PrimitiveUSizeType => PrimitiveTypeOnly | PrimitiveRawPtrType => PrimitiveTypeOnly
      | PrimitiveRuntimeType => PrimitiveTypeOnly | PrimitiveRawFnType => PrimitiveTypeOnly
      | PrimitiveStringType => PrimitiveTypeOnly end end;

-- Conservative allocation contracts. A Maybe result can allocate a Just;
-- pure strings/Nat and runtime combinators can allocate managed values.
def primitive_gc (id : PrimitiveId) : PrimitiveGc :=
    match id with
    | PrimitiveWordOperation _ op => match primitive_word_checked op with
      | True => PrimitiveMayGc | False => PrimitiveNoGc end
    | PrimitiveWordConversion _ _ mode => match mode with
      | PrimitiveConvertChecked => PrimitiveMayGc | PrimitiveNarrowWrap => PrimitiveNoGc
      | PrimitiveZeroExtend => PrimitiveNoGc | PrimitiveSignExtend => PrimitiveNoGc
      | PrimitiveReinterpret => PrimitiveNoGc end
    | PrimitiveWordFromNat _ => PrimitiveMayGc | PrimitiveWordToNat _ => PrimitiveMayGc
    | PrimitiveStringOperation _ => PrimitiveMayGc | PrimitiveRuntimePure => PrimitiveMayGc
    | PrimitiveRuntimeBind => PrimitiveMayGc | PrimitiveRuntimeLoop => PrimitiveMayGc
    | PrimitiveFnCall => PrimitiveMayGc
    | PrimitiveStdoutWrite => PrimitiveMayGc | PrimitiveStderrWrite => PrimitiveMayGc
    | PrimitiveStdoutFlush => PrimitiveMayGc | PrimitiveProcessExit => PrimitiveMayGc
    | PrimitiveArgv => PrimitiveMayGc | PrimitiveEnvGet => PrimitiveMayGc
    | PrimitiveTimeNow => PrimitiveMayGc
    | PrimitiveFileKind => PrimitiveMayGc
    | PrimitiveFileExists => PrimitiveMayGc | PrimitiveFileIsDirectory => PrimitiveMayGc
    | PrimitiveDirectoryCreate => PrimitiveMayGc | PrimitivePathRemove => PrimitiveMayGc
    | PrimitiveFileCopy => PrimitiveMayGc
    | PrimitiveFileRename => PrimitiveMayGc
    | PrimitiveFileReplace => PrimitiveMayGc
    | PrimitiveFileRealpath => PrimitiveMayGc
    | PrimitiveFileTemp => PrimitiveMayGc | PrimitiveFileTempIn => PrimitiveMayGc
    | PrimitiveProcessInherit => PrimitiveMayGc
    | PrimitiveProcessBounded => PrimitiveMayGc
    | PrimitiveProcessCapture => PrimitiveMayGc | PrimitiveHttpPost => PrimitiveMayGc
    | PrimitiveStdinReadLine => PrimitiveMayGc | PrimitiveStdinReadBytes => PrimitiveMayGc
    | PrimitiveFileRead => PrimitiveMayGc | PrimitiveFileWrite => PrimitiveMayGc
    | PrimitiveDirectoryList => PrimitiveMayGc | PrimitiveDirectoryListable => PrimitiveMayGc
    | PrimitiveRawNull => PrimitiveNoGc
    | PrimitiveRawLoad => PrimitiveNoGc | PrimitiveRawStore => PrimitiveNoGc
    | PrimitiveRawAddWrap => PrimitiveNoGc | PrimitiveRawCast => PrimitiveNoGc
    | PrimitiveRawToBits => PrimitiveNoGc | PrimitiveRawFromBits => PrimitiveNoGc
    | PrimitiveU8Type => PrimitiveNoGc | PrimitiveU32Type => PrimitiveNoGc
    | PrimitiveU64Type => PrimitiveNoGc | PrimitiveI32Type => PrimitiveNoGc
    | PrimitiveUSizeType => PrimitiveNoGc | PrimitiveRawPtrType => PrimitiveNoGc
    | PrimitiveRuntimeType => PrimitiveNoGc | PrimitiveRawFnType => PrimitiveNoGc
    | PrimitiveStringType => PrimitiveNoGc end;

def primitive_bind (A : Type) (B : Type) (value : Either PrimitiveError A)
    (next : A -> Either PrimitiveError B) : Either PrimitiveError B :=
    match value with | Left err => Left PrimitiveError B err | Right result => next result end;
def primitive_map (A : Type) (B : Type) (f : A -> B)
    (value : Either PrimitiveError A) : Either PrimitiveError B :=
    primitive_bind A B value (fun (result : A) => Right PrimitiveError B (f result));
def primitive_require (condition : Bool) (err : PrimitiveError) : Either PrimitiveError Unit :=
    match condition with | True => Right PrimitiveError Unit MkUnit | False => Left PrimitiveError Unit err end;

def primitive_default_fuel : Nat := mul 16 primitive_byte_base;
def primitive_max_fuel : Nat := mul primitive_byte_base primitive_byte_base;
def primitive_max_offset : Nat :=
    add (mul 127 (mul primitive_byte_base (mul primitive_byte_base primitive_byte_base))) (sub (mul primitive_byte_base (mul primitive_byte_base primitive_byte_base)) 1);

-- Structural equality for normalized signature skeletons. This is not term
-- conversion: executable forms do not match, even when textually identical.
inductive PrimitiveShape : Type :=
  | PrimitiveShapeAtom : Nat -> Nat -> PrimitiveShape
  | PrimitiveShapePair : Nat -> CoreTerm -> CoreTerm -> PrimitiveShape
  | PrimitiveShapeOther : PrimitiveShape;

def primitive_shape (term : CoreTerm) : PrimitiveShape :=
    match term with | CSort id => PrimitiveShapeAtom 0 id | CRel id => PrimitiveShapeAtom 1 id
    | CConst id => PrimitiveShapeAtom 2 id | CInd id => PrimitiveShapeAtom 3 id
    | CPi a b => PrimitiveShapePair 4 a b | CApp a b => PrimitiveShapePair 5 a b
    | CLam _ _ => PrimitiveShapeOther | CLetIn _ _ _ => PrimitiveShapeOther
    | CConstruct _ _ _ => PrimitiveShapeOther | CCase _ _ _ _ => PrimitiveShapeOther
    | CFix _ _ _ _ _ => PrimitiveShapeOther | CStrBytes _ _ => PrimitiveShapeOther
                                            | CStrLit _ _ => PrimitiveShapeOther end;

def primitive_shape_equal : Nat -> CoreTerm -> CoreTerm -> Either PrimitiveError Bool :=
  fix primitive_shape_equal (fuel : Nat) (a : CoreTerm) (b : CoreTerm) : Either PrimitiveError Bool :=
    match fuel with | Z => Left PrimitiveError Bool PrimitiveResourceExhausted
    | S next => match primitive_shape a, primitive_shape b with
      | PrimitiveShapeAtom at x, PrimitiveShapeAtom bt y =>
          Right PrimitiveError Bool (andb (eqNat at bt) (eqNat x y))
      | PrimitiveShapePair at a1 a2, PrimitiveShapePair bt b1 b2 =>
          match eqNat at bt with | False => Right PrimitiveError Bool False
          | True => primitive_bind Bool Bool (primitive_shape_equal next a1 b1)
          (fun (same : Bool) => match same with | False => Right PrimitiveError Bool False
            | True => primitive_shape_equal next a2 b2 end) end
      | PrimitiveShapeAtom _ _, PrimitiveShapePair _ _ _ => Right PrimitiveError Bool False
      | PrimitiveShapeAtom _ _, PrimitiveShapeOther => Right PrimitiveError Bool False
      | PrimitiveShapePair _ _ _, PrimitiveShapeAtom _ _ => Right PrimitiveError Bool False
      | PrimitiveShapePair _ _ _, PrimitiveShapeOther => Right PrimitiveError Bool False
      | PrimitiveShapeOther, PrimitiveShapeAtom _ _ => Right PrimitiveError Bool False
      | PrimitiveShapeOther, PrimitiveShapePair _ _ _ => Right PrimitiveError Bool False
      | PrimitiveShapeOther, PrimitiveShapeOther => Right PrimitiveError Bool False end end;

-- Stable intrinsic key spellings are data, shared with diagnostics and tests.
def primitive_word_name (value : PrimitiveWord) : List Nat :=
    match value with
    | PrimitiveWordU8 => ([117, 56] : List Nat)
    | PrimitiveWordU32 => ([117, 51, 50] : List Nat)
    | PrimitiveWordU64 => ([117, 54, 52] : List Nat)
    | PrimitiveWordI32 => ([105, 51, 50] : List Nat)
    | PrimitiveWordUSize => ([117, 115, 105, 122, 101] : List Nat) end;

def primitive_word_op_name (value : PrimitiveWordOp) : List Nat :=
    match value with
    | PrimitiveAddWrap => ([97, 100, 100, 46, 119, 114, 97, 112] : List Nat)
    | PrimitiveSubWrap => ([115, 117, 98, 46, 119, 114, 97, 112] : List Nat)
    | PrimitiveMulWrap => ([109, 117, 108, 46, 119, 114, 97, 112] : List Nat)
    | PrimitiveBitAnd => ([97, 110, 100] : List Nat)
    | PrimitiveBitOr => ([111, 114] : List Nat)
    | PrimitiveBitXor => ([120, 111, 114] : List Nat)
    | PrimitiveShiftLeft => ([115, 104, 108] : List Nat)
    | PrimitiveShiftRight => ([115, 104, 114] : List Nat)
    | PrimitiveWordEqual => ([101, 113] : List Nat)
    | PrimitiveWordLess => ([108, 116] : List Nat)
    | PrimitiveAddChecked => ([97, 100, 100, 46, 99, 104, 101, 99, 107, 101, 100] : List Nat)
    | PrimitiveSubChecked => ([115, 117, 98, 46, 99, 104, 101, 99, 107, 101, 100] : List Nat)
    | PrimitiveMulChecked => ([109, 117, 108, 46, 99, 104, 101, 99, 107, 101, 100] : List Nat)
    | PrimitiveDivChecked => ([100, 105, 118, 46, 99, 104, 101, 99, 107, 101, 100] : List Nat)
    | PrimitiveRemChecked => ([114, 101, 109, 46, 99, 104, 101, 99, 107, 101, 100] : List Nat) end;

def primitive_conversion_name (value : PrimitiveConversion) : List Nat :=
    match value with
    | PrimitiveNarrowWrap => ([110, 97, 114, 114, 111, 119, 46, 119, 114, 97, 112] : List Nat)
    | PrimitiveZeroExtend => ([122, 101, 120, 116] : List Nat)
    | PrimitiveSignExtend => ([115, 101, 120, 116] : List Nat)
    | PrimitiveReinterpret => ([114, 101, 105, 110, 116, 101, 114, 112, 114, 101, 116] : List Nat)
    | PrimitiveConvertChecked => ([99, 104, 101, 99, 107, 101, 100] : List Nat) end;

def primitive_string_op_name (value : PrimitiveStringOp) : List Nat :=
    match value with
    | PrimitiveStringConcat => ([99, 111, 110, 99, 97, 116] : List Nat)
    | PrimitiveStringLength => ([108, 101, 110, 103, 116, 104] : List Nat)
    | PrimitiveStringByteAt => ([98, 121, 116, 101, 95, 97, 116] : List Nat)
    | PrimitiveStringSlice => ([115, 108, 105, 99, 101] : List Nat)
    | PrimitiveStringEqual => ([101, 113] : List Nat)
    | PrimitiveStringOfNat => ([111, 102, 95, 110, 97, 116] : List Nat)
    | PrimitiveStringToCodes => ([116, 111, 95, 99, 104, 97, 114, 95, 99, 111, 100, 101, 115] : List Nat)
    | PrimitiveStringOfCodes => ([111, 102, 95, 99, 104, 97, 114, 95, 99, 111, 100, 101, 115] : List Nat)
    | PrimitiveStringStarts => ([115, 116, 97, 114, 116, 115] : List Nat)
    | PrimitiveStringEnds => ([101, 110, 100, 115] : List Nat)
    | PrimitiveStringContains => ([99, 111, 110, 116, 97, 105, 110, 115] : List Nat)
    | PrimitiveStringIndex => ([105, 110, 100, 101, 120] : List Nat)
    | PrimitiveStringSplit => ([115, 112, 108, 105, 116] : List Nat)
    | PrimitiveStringReplace => ([114, 101, 112, 108, 97, 99, 101] : List Nat)
    | PrimitiveStringLessEqual => ([108, 101] : List Nat)
    | PrimitiveStringTokens => ([116, 111, 107, 101, 110, 115] : List Nat) end;

def primitive_join_key (a : List Nat) (b : List Nat) : List Nat :=
    append Nat a (Cons Nat 46 b);
def primitive_key_prefix : List Nat := ([111, 117, 114, 111] : List Nat);
def primitive_runtime_key : List Nat := primitive_join_key primitive_key_prefix ([114, 117, 110, 116, 105, 109, 101] : List Nat);
def primitive_raw_key : List Nat := primitive_join_key primitive_key_prefix ([114, 97, 119] : List Nat);
def primitive_string_key : List Nat := primitive_join_key primitive_key_prefix ([115, 116, 114, 105, 110, 103] : List Nat);
def primitive_convert_key : List Nat := primitive_join_key primitive_key_prefix ([99, 111, 110, 118, 101, 114, 116] : List Nat);
def primitive_word_key (word : PrimitiveWord) : List Nat := primitive_join_key primitive_key_prefix (primitive_word_name word);

-- Sharing the family prefixes also keeps strict checking of this dispatch
-- bounded: numeric byte literals elaborate to structural Nat in the seed.
def primitive_key (id : PrimitiveId) : List Nat :=
    match id with
    | PrimitiveU8Type => primitive_word_key PrimitiveWordU8
    | PrimitiveU32Type => primitive_word_key PrimitiveWordU32
    | PrimitiveU64Type => primitive_word_key PrimitiveWordU64
    | PrimitiveI32Type => primitive_word_key PrimitiveWordI32
    | PrimitiveUSizeType => primitive_word_key PrimitiveWordUSize
    | PrimitiveRawPtrType => primitive_join_key primitive_key_prefix ([114, 97, 119, 95, 112, 116, 114] : List Nat)
    | PrimitiveRuntimeType => primitive_runtime_key
    | PrimitiveRawFnType => primitive_join_key primitive_key_prefix ([114, 97, 119, 95, 102, 110] : List Nat)
    | PrimitiveStringType => primitive_string_key
    | PrimitiveRuntimePure => primitive_join_key primitive_runtime_key ([112, 117, 114, 101] : List Nat)
    | PrimitiveRuntimeBind => primitive_join_key primitive_runtime_key ([98, 105, 110, 100] : List Nat)
    | PrimitiveRuntimeLoop => primitive_join_key primitive_runtime_key ([108, 111, 111, 112] : List Nat)
    | PrimitiveRawNull => primitive_join_key primitive_raw_key ([110, 117, 108, 108] : List Nat)
    | PrimitiveRawLoad => primitive_join_key primitive_raw_key ([108, 111, 97, 100] : List Nat)
    | PrimitiveRawStore => primitive_join_key primitive_raw_key ([115, 116, 111, 114, 101] : List Nat)
    | PrimitiveRawAddWrap => primitive_join_key primitive_raw_key ([97, 100, 100, 46, 119, 114, 97, 112] : List Nat)
    | PrimitiveRawCast => primitive_join_key primitive_raw_key ([99, 97, 115, 116] : List Nat)
    | PrimitiveRawToBits => primitive_join_key primitive_raw_key ([116, 111, 95, 98, 105, 116, 115] : List Nat)
    | PrimitiveRawFromBits => primitive_join_key primitive_raw_key ([102, 114, 111, 109, 95, 98, 105, 116, 115] : List Nat)
    | PrimitiveFnCall => primitive_join_key primitive_key_prefix ([102, 110, 46, 99, 97, 108, 108] : List Nat)
    | PrimitiveStdoutWrite => primitive_join_key primitive_runtime_key ([115, 116, 100, 111, 117, 116, 46, 119, 114, 105, 116, 101] : List Nat)
    | PrimitiveStderrWrite => primitive_join_key primitive_runtime_key ([115, 116, 100, 101, 114, 114, 46, 119, 114, 105, 116, 101] : List Nat)
    | PrimitiveStdoutFlush => primitive_join_key primitive_runtime_key ([115, 116, 100, 111, 117, 116, 46, 102, 108, 117, 115, 104] : List Nat)
    | PrimitiveProcessExit => primitive_join_key primitive_runtime_key ([101, 120, 105, 116] : List Nat)
    | PrimitiveArgv => primitive_join_key primitive_runtime_key ([97, 114, 103, 118] : List Nat)
    | PrimitiveEnvGet => primitive_join_key primitive_runtime_key ([101, 110, 118, 95, 103, 101, 116] : List Nat)
    | PrimitiveTimeNow => primitive_join_key primitive_key_prefix ([116, 105, 109, 101, 46, 110, 111, 119] : List Nat)
    | PrimitiveFileKind => primitive_join_key primitive_key_prefix ([102, 115, 46, 107, 105, 110, 100] : List Nat)
    | PrimitiveFileExists => primitive_join_key primitive_key_prefix ([102, 115, 46, 101, 120, 105, 115, 116, 115] : List Nat)
    | PrimitiveFileIsDirectory => primitive_join_key primitive_key_prefix ([102, 115, 46, 105, 115, 95, 100, 105, 114] : List Nat)
    | PrimitiveDirectoryCreate => primitive_join_key primitive_key_prefix ([102, 115, 46, 109, 107, 100, 105, 114] : List Nat)
    | PrimitivePathRemove => primitive_join_key primitive_key_prefix ([102, 115, 46, 114, 101, 109, 111, 118, 101] : List Nat)
    | PrimitiveFileCopy => primitive_join_key primitive_key_prefix ([102, 115, 46, 99, 111, 112, 121, 95, 102, 105, 108, 101] : List Nat)
    | PrimitiveFileRename => primitive_join_key primitive_key_prefix ([102, 115, 46, 114, 101, 110, 97, 109, 101] : List Nat)
    | PrimitiveFileReplace => primitive_join_key primitive_key_prefix ([102, 115, 46, 114, 101, 112, 108, 97, 99, 101, 95, 102, 105, 108, 101] : List Nat)
    | PrimitiveFileRealpath => primitive_join_key primitive_key_prefix ([102, 115, 46, 114, 101, 97, 108, 112, 97, 116, 104] : List Nat)
    | PrimitiveFileTemp => primitive_join_key primitive_key_prefix ([102, 115, 46, 116, 101, 109, 112, 95, 102, 105, 108, 101] : List Nat)
    | PrimitiveFileTempIn => primitive_join_key primitive_key_prefix ([102, 115, 46, 116, 101, 109, 112, 95, 102, 105, 108, 101, 95, 105, 110] : List Nat)
    | PrimitiveProcessInherit => primitive_join_key primitive_key_prefix ([112,114,111,99,101,115,115,46,105,110,104,101,114,105,116] : List Nat)
    | PrimitiveProcessBounded => primitive_join_key primitive_key_prefix ([112,114,111,99,101,115,115,46,99,97,112,116,117,114,101,95,98,111,117,110,100,101,100] : List Nat)
    | PrimitiveProcessCapture => primitive_join_key primitive_key_prefix ([112, 114, 111, 99, 101, 115, 115, 46, 99, 97, 112, 116, 117, 114, 101] : List Nat)
    | PrimitiveHttpPost => primitive_join_key primitive_key_prefix ([104, 116, 116, 112, 46, 112, 111, 115, 116] : List Nat)
    | PrimitiveStdinReadLine => primitive_join_key primitive_runtime_key ([115, 116, 100, 105, 110, 46, 114, 101, 97, 100, 95, 108, 105, 110, 101] : List Nat)
    | PrimitiveStdinReadBytes => primitive_join_key primitive_runtime_key ([115, 116, 100, 105, 110, 46, 114, 101, 97, 100, 95, 98, 121, 116, 101, 115] : List Nat)
    | PrimitiveFileRead => primitive_join_key primitive_key_prefix ([102, 115, 46, 114, 101, 97, 100, 95, 102, 105, 108, 101] : List Nat)
    | PrimitiveFileWrite => primitive_join_key primitive_key_prefix ([102, 115, 46, 119, 114, 105, 116, 101, 95, 102, 105, 108, 101] : List Nat)
    | PrimitiveDirectoryList => primitive_join_key primitive_key_prefix ([102, 115, 46, 108, 105, 115, 116, 95, 100, 105, 114] : List Nat)
    | PrimitiveDirectoryListable => primitive_join_key primitive_key_prefix ([102, 115, 46, 108, 105, 115, 116, 97, 98, 108, 101] : List Nat)
    | PrimitiveWordOperation word op => primitive_join_key (primitive_word_key word) (primitive_word_op_name op)
    | PrimitiveWordConversion source dest mode => primitive_join_key primitive_convert_key
        (primitive_join_key (primitive_word_name source)
          (primitive_join_key (primitive_word_name dest) (primitive_conversion_name mode)))
    | PrimitiveWordFromNat word => primitive_join_key (primitive_word_key word)
        ([102, 114, 111, 109, 95, 110, 97, 116, 46, 99, 104, 101, 99, 107, 101, 100] : List Nat)
    | PrimitiveWordToNat word => primitive_join_key (primitive_word_key word) ([116, 111, 95, 110, 97, 116, 46, 98, 105, 116, 115] : List Nat)
    | PrimitiveStringOperation op => primitive_join_key primitive_string_key (primitive_string_op_name op) end;

def primitive_bytes_equal : List Nat -> List Nat -> Bool :=
  fix primitive_bytes_equal (a : List Nat) (b : List Nat) : Bool :=
    match a, b with | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
    | Cons x xs, Cons y ys => andb (eqNat x y) (primitive_bytes_equal xs ys) end;

def primitive_op_code (op : PrimitiveWordOp) : Nat :=
    match op with
    | PrimitiveAddWrap => 0 | PrimitiveSubWrap => 1 | PrimitiveMulWrap => 2
    | PrimitiveBitAnd => 3 | PrimitiveBitOr => 4 | PrimitiveBitXor => 5
    | PrimitiveShiftLeft => 6 | PrimitiveShiftRight => 7
    | PrimitiveWordEqual => 8 | PrimitiveWordLess => 9
    | PrimitiveAddChecked => 10 | PrimitiveSubChecked => 11 | PrimitiveMulChecked => 12
    | PrimitiveDivChecked => 13 | PrimitiveRemChecked => 14 end;

def primitive_conversion_code (mode : PrimitiveConversion) : Nat :=
    match mode with | PrimitiveNarrowWrap => 0 | PrimitiveZeroExtend => 1 | PrimitiveSignExtend => 2
    | PrimitiveReinterpret => 3 | PrimitiveConvertChecked => 4 end;

def primitive_string_code (op : PrimitiveStringOp) : Nat :=
    match op with | PrimitiveStringConcat => 0 | PrimitiveStringLength => 1 | PrimitiveStringByteAt => 2
    | PrimitiveStringSlice => 3 | PrimitiveStringEqual => 4 | PrimitiveStringOfNat => 5
    | PrimitiveStringToCodes => 6 | PrimitiveStringOfCodes => 7 | PrimitiveStringStarts => 8
    | PrimitiveStringEnds => 9 | PrimitiveStringContains => 10 | PrimitiveStringIndex => 11
    | PrimitiveStringSplit => 12 | PrimitiveStringReplace => 13 | PrimitiveStringLessEqual => 14
    | PrimitiveStringTokens => 15 end;

-- A bounded ordinal of the closed enum, used only for equality. It is not a
-- serialized symbol/ABI identity. The catalog tests cover every combination
-- and guard against overlapping ranges when the enum grows. Equality does
-- not construct or inspect source-spelling byte strings.
def primitive_id_code (id : PrimitiveId) : Nat :=
    match id with
    | PrimitiveU8Type => 0 | PrimitiveU32Type => 1 | PrimitiveU64Type => 2
    | PrimitiveI32Type => 3 | PrimitiveUSizeType => 4 | PrimitiveRawPtrType => 5
    | PrimitiveRuntimeType => 6 | PrimitiveRawFnType => 7 | PrimitiveStringType => 8
    | PrimitiveRuntimePure => 9 | PrimitiveRuntimeBind => 10 | PrimitiveRuntimeLoop => 11
    | PrimitiveRawNull => 12 | PrimitiveRawLoad => 13 | PrimitiveRawStore => 14
    | PrimitiveRawAddWrap => 15 | PrimitiveRawCast => 16 | PrimitiveRawToBits => 17
    | PrimitiveRawFromBits => 18 | PrimitiveFnCall => 19
    | PrimitiveStdoutWrite => 246 | PrimitiveStderrWrite => 247
    | PrimitiveStdoutFlush => 248 | PrimitiveProcessExit => 249
    | PrimitiveArgv => 250 | PrimitiveEnvGet => 251 | PrimitiveTimeNow => 252
    | PrimitiveStdinReadLine => 253 | PrimitiveStdinReadBytes => 254
    | PrimitiveFileRead => 255 | PrimitiveFileWrite => primitive_byte_base
    | PrimitiveFileKind => add primitive_byte_base 1
    | PrimitiveFileExists => add primitive_byte_base 4 | PrimitiveFileIsDirectory => add primitive_byte_base 5
    | PrimitiveFileRealpath => add primitive_byte_base 9
    | PrimitiveDirectoryList => add primitive_byte_base 2 | PrimitiveDirectoryListable => add primitive_byte_base 3
    | PrimitiveDirectoryCreate => add primitive_byte_base 6 | PrimitivePathRemove => add primitive_byte_base 7
    | PrimitiveFileCopy => add primitive_byte_base 8
    | PrimitiveFileRename => add primitive_byte_base 14
    | PrimitiveFileReplace => add primitive_byte_base 17
    | PrimitiveFileTemp => add primitive_byte_base 10 | PrimitiveFileTempIn => add primitive_byte_base 11
    | PrimitiveProcessCapture => add primitive_byte_base 12 | PrimitiveHttpPost => add primitive_byte_base 13
    | PrimitiveProcessInherit => add primitive_byte_base 15
    | PrimitiveProcessBounded => add primitive_byte_base 16
    | PrimitiveWordOperation word op => add 20 (add (mul 15 (primitive_word_code word)) (primitive_op_code op))
    | PrimitiveWordFromNat word => add 95 (primitive_word_code word)
    | PrimitiveWordToNat word => add 100 (primitive_word_code word)
    | PrimitiveWordConversion source dest mode => add 105
        (add (mul 25 (primitive_word_code source)) (add (mul 5 (primitive_word_code dest)) (primitive_conversion_code mode)))
    | PrimitiveStringOperation op => add 230 (primitive_string_code op) end;

def primitive_id_equal (a : PrimitiveId) (b : PrimitiveId) : Bool :=
    eqNat (primitive_id_code a) (primitive_id_code b);
def primitive_binding (id : PrimitiveId) (specialization : Maybe CoreTerm) : PrimitiveBinding :=
    PrimitiveIntrinsicBinding id (primitive_execution id) (primitive_gc id) specialization;

def primitive_words : List PrimitiveWord := ([PrimitiveWordU8, PrimitiveWordU32, PrimitiveWordU64, PrimitiveWordI32, PrimitiveWordUSize] : List PrimitiveWord);
def primitive_word_ops : List PrimitiveWordOp := ([PrimitiveAddWrap, PrimitiveSubWrap, PrimitiveMulWrap, PrimitiveBitAnd, PrimitiveBitOr, PrimitiveBitXor, PrimitiveShiftLeft, PrimitiveShiftRight, PrimitiveWordEqual, PrimitiveWordLess, PrimitiveAddChecked, PrimitiveSubChecked, PrimitiveMulChecked, PrimitiveDivChecked, PrimitiveRemChecked] : List PrimitiveWordOp);
def primitive_conversions : List PrimitiveConversion := ([PrimitiveNarrowWrap, PrimitiveZeroExtend, PrimitiveSignExtend, PrimitiveReinterpret, PrimitiveConvertChecked] : List PrimitiveConversion);
def primitive_string_ops : List PrimitiveStringOp := ([PrimitiveStringConcat, PrimitiveStringLength, PrimitiveStringByteAt, PrimitiveStringSlice, PrimitiveStringEqual, PrimitiveStringOfNat, PrimitiveStringToCodes, PrimitiveStringOfCodes, PrimitiveStringStarts, PrimitiveStringEnds, PrimitiveStringContains, PrimitiveStringIndex, PrimitiveStringSplit, PrimitiveStringReplace, PrimitiveStringLessEqual, PrimitiveStringTokens] : List PrimitiveStringOp);

def primitive_catalog : List PrimitiveId :=
    append PrimitiveId ([PrimitiveU8Type, PrimitiveU32Type, PrimitiveU64Type, PrimitiveI32Type, PrimitiveUSizeType, PrimitiveRawPtrType, PrimitiveRuntimeType, PrimitiveRawFnType, PrimitiveStringType, PrimitiveRuntimePure, PrimitiveRuntimeBind, PrimitiveRuntimeLoop, PrimitiveRawNull, PrimitiveRawLoad, PrimitiveRawStore, PrimitiveRawAddWrap, PrimitiveRawCast, PrimitiveRawToBits, PrimitiveRawFromBits, PrimitiveFnCall, PrimitiveStdoutWrite, PrimitiveStderrWrite, PrimitiveStdoutFlush, PrimitiveProcessExit, PrimitiveArgv, PrimitiveEnvGet, PrimitiveTimeNow, PrimitiveStdinReadLine, PrimitiveStdinReadBytes, PrimitiveFileRead, PrimitiveFileWrite, PrimitiveFileKind, PrimitiveFileExists, PrimitiveFileIsDirectory, PrimitiveFileRealpath, PrimitiveDirectoryList, PrimitiveDirectoryListable, PrimitiveDirectoryCreate, PrimitivePathRemove, PrimitiveFileCopy, PrimitiveFileTemp, PrimitiveFileTempIn, PrimitiveProcessCapture, PrimitiveHttpPost, PrimitiveFileRename, PrimitiveProcessInherit, PrimitiveProcessBounded, PrimitiveFileReplace] : List PrimitiveId)
      (append PrimitiveId
        (foldr PrimitiveWord (List PrimitiveId)
          (fun (word : PrimitiveWord) (tail : List PrimitiveId) =>
            append PrimitiveId (map PrimitiveWordOp PrimitiveId
              (fun (op : PrimitiveWordOp) => PrimitiveWordOperation word op) primitive_word_ops)
              (Cons PrimitiveId (PrimitiveWordFromNat word)
                (Cons PrimitiveId (PrimitiveWordToNat word) tail))) (Nil PrimitiveId) primitive_words)
        (append PrimitiveId
          (foldr PrimitiveWord (List PrimitiveId)
            (fun (source : PrimitiveWord) (tail : List PrimitiveId) =>
              foldr PrimitiveWord (List PrimitiveId)
                (fun (dest : PrimitiveWord) (rest : List PrimitiveId) =>
                  append PrimitiveId (map PrimitiveConversion PrimitiveId
                    (fun (mode : PrimitiveConversion) => PrimitiveWordConversion source dest mode)
                    primitive_conversions) rest) tail primitive_words) (Nil PrimitiveId) primitive_words)
          (map PrimitiveStringOp PrimitiveId
            (fun (op : PrimitiveStringOp) => PrimitiveStringOperation op) primitive_string_ops)));

def primitive_key_table : List (Pair PrimitiveId (List Nat)) :=
    map PrimitiveId (Pair PrimitiveId (List Nat))
      (fun (id : PrimitiveId) => MkPair PrimitiveId (List Nat) id (primitive_key id)) primitive_catalog;

def primitive_role_shape (role : PrimitiveRole) (id : Nat) : PrimitiveInductiveShape :=
    let ind : CoreTerm := CInd id in
    let applied : CoreTerm := CApp ind (CRel 0) in
    match role with
    | PrimitiveNatRole => PrimitiveInductiveOf id 0 0 (CSort 0) ([ind, CPi ind ind] : List CoreTerm)
    | PrimitiveBoolRole => PrimitiveInductiveOf id 0 0 (CSort 0) ([ind, ind] : List CoreTerm)
    | PrimitiveUnitRole => PrimitiveInductiveOf id 0 0 (CSort 0) ([ind] : List CoreTerm)
    | PrimitiveListRole => PrimitiveInductiveOf id 1 0 (CPi (CSort 0) (CSort 0))
        ([CPi (CSort 0) applied,
          CPi (CSort 0) (CPi (CRel 0) (CPi (CApp ind (CRel 1)) (CApp ind (CRel 2))))] : List CoreTerm)
    | PrimitiveMaybeRole => PrimitiveInductiveOf id 1 0 (CPi (CSort 0) (CSort 0))
        ([CPi (CSort 0) applied, CPi (CSort 0) (CPi (CRel 0) (CApp ind (CRel 1)))] : List CoreTerm)
    | PrimitivePairRole => PrimitiveInductiveOf id 2 0 (CPi (CSort 0) (CPi (CSort 0) (CSort 0)))
        ([CPi (CSort 0) (CPi (CSort 0) (CPi (CRel 1) (CPi (CRel 1)
          (CApp (CApp ind (CRel 3)) (CRel 2)))))] : List CoreTerm) end;

def primitive_role_id (binding : PrimitiveRoleBinding) : Nat :=
    match binding with | PrimitiveRoleOf _ shape => match shape with | PrimitiveInductiveOf id _ _ _ _ => id end end;
def primitive_role_kind (binding : PrimitiveRoleBinding) : PrimitiveRole :=
    match binding with | PrimitiveRoleOf role _ => role end;
def primitive_role_equal (a : PrimitiveRole) (b : PrimitiveRole) : Bool :=
    eqNat (primitive_role_code a) (primitive_role_code b);

def primitive_conversion_valid (source : PrimitiveWord) (dest : PrimitiveWord)
    (mode : PrimitiveConversion) : Bool :=
    let source_bits : Nat := primitive_word_bits source in
    let dest_bits : Nat := primitive_word_bits dest in
    match mode with
    | PrimitiveNarrowWrap => compiler_lt_nat dest_bits source_bits
    | PrimitiveZeroExtend => andb (notb (primitive_word_equal source PrimitiveWordI32))
        (compiler_lt_nat source_bits dest_bits)
    | PrimitiveSignExtend => andb (primitive_word_equal source PrimitiveWordI32) (eqNat dest_bits 64)
    | PrimitiveReinterpret => eqNat source_bits dest_bits
    | PrimitiveConvertChecked => notb (primitive_word_equal source dest) end;

-- Binary remainder validates its own bounds before subtraction or doubling.
-- Its bounded recursion reports exhaustion rather than fabricating a value.
def primitive_layout_remainder (value : Nat) (divisor : Nat) : Either PrimitiveError Nat :=
    primitive_bind Unit Nat (primitive_require (compiler_le_nat value primitive_max_offset)
      (PrimitiveInvalidLayout PrimitiveLayoutSize)) (fun (_ : Unit) =>
      primitive_bind Unit Nat (primitive_require
        (andb (compiler_lt_nat 0 divisor) (compiler_le_nat divisor primitive_max_offset))
        (PrimitiveInvalidLayout PrimitiveLayoutAlignment)) (fun (_ : Unit) =>
        (fix reduce (fuel : Nat) (step : Nat) : Either PrimitiveError Nat :=
          match fuel with | Z => Left PrimitiveError Nat PrimitiveResourceExhausted
          | S next => match compiler_lt_nat value step with | True => Right PrimitiveError Nat value
            | False => match compiler_lt_nat (sub primitive_max_offset step) step with
              | True => Right PrimitiveError Nat (sub value step)
              | False => primitive_map Nat Nat
                  (fun (rest : Nat) => match compiler_le_nat step rest with
                    | True => sub rest step | False => rest end) (reduce next (add step step)) end end end) 32 divisor));

def primitive_layout_divisible (value : Nat) (divisor : Nat) (failure : PrimitiveError)
    : Either PrimitiveError Unit :=
    primitive_bind Nat Unit (primitive_layout_remainder value divisor)
      (fun (rest : Nat) => primitive_require (eqNat rest 0) failure);

def primitive_layout_alignment (alignment : Nat) : Bool :=
    (fix power_of_two (fuel : Nat) (power : Nat) : Bool :=
      match fuel with | Z => False | S next => match eqNat alignment power with
        | True => True | False => power_of_two next (add power power) end end) 13 1;

def primitive_layout_field_alignment (packed : Bool) (alignment : Nat) (offset : Nat)
    (width : Nat) (id : Nat) : Either PrimitiveError Unit :=
    match packed with | True => Right PrimitiveError Unit MkUnit
    | False => primitive_bind Unit Unit
        (primitive_require (compiler_le_nat width alignment) (PrimitiveInvalidLayout (PrimitiveLayoutFieldAlignment id)))
        (fun (_ : Unit) => primitive_layout_divisible offset width (PrimitiveInvalidLayout (PrimitiveLayoutFieldAlignment id))) end;
