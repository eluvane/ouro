-- Sorted maps make generated tool output byte-reproducible; traversal order is key order.

import "assoc.ouro";
import "stringx.ouro";

def Map (V : Type) : Type := List (Pair String V);

def map_empty (V : Type) : Map V := Nil (Pair String V);

def map_null (V : Type) (m : Map V) : Bool :=
    nullb (Pair String V) m;

def map_size (V : Type) (m : Map V) : Nat :=
    length (Pair String V) m;

def map_get (V : Type) (k : String) (m : Map V) : Maybe V :=
    assoc_get String V str_eq k m;

def map_has (V : Type) (k : String) (m : Map V) : Bool :=
    match map_get V k m with
    | Nothing => False
    | Just _ => True
    end;

def map_get_or (V : Type) (d : V) (k : String) (m : Map V) : V :=
    fromMaybe V d (map_get V k m);

-- Replaces an existing key in place, otherwise inserts before the first
-- larger key, so the list stays sorted.
def map_insert (V : Type) (k : String) (v : V) : Map V -> Map V :=
    fix map_insert (m : Map V) : Map V :=
      match m with
      | Nil => Cons (Pair String V) (MkPair String V k v) (Nil (Pair String V))
      | Cons p rest =>
        match p with
        | MkPair k2 _ =>
          match str_eq k k2 with
          | True => Cons (Pair String V) (MkPair String V k v) rest
          | False =>
            match str_lt k k2 with
            | True => Cons (Pair String V) (MkPair String V k v) m
            | False => Cons (Pair String V) p (map_insert rest)
            end
          end
        end
      end;

def map_delete (V : Type) (k : String) (m : Map V) : Map V :=
    assoc_delete String V str_eq k m;

def map_keys (V : Type) (m : Map V) : List String :=
    assoc_keys String V m;

def map_values (V : Type) (m : Map V) : List V :=
    assoc_values String V m;

def map_pairs (V : Type) (m : Map V) : List (Pair String V) := m;

-- Later entries of the second map win, matching JSON-object override order.
-- Insert from the front of the override: foldr would apply the earliest
-- duplicate last and keep that stale value.
def map_union (V : Type) (a : Map V) (b : Map V) : Map V :=
    foldl (Pair String V) (Map V)
      (fun (acc : Map V) (p : Pair String V) =>
        match p with
        | MkPair k v => map_insert V k v acc
        end)
      a b;

def map_from_pairs (V : Type) (ps : List (Pair String V)) : Map V :=
    map_union V (map_empty V) ps;

def map_map (V : Type) (W : Type) (f : V -> W) (m : Map V) : Map W :=
    map (Pair String V) (Pair String W)
      (fun (p : Pair String V) =>
        match p with
        | MkPair k v => MkPair String W k (f v)
        end) m;

def map_filter (V : Type) (p : String -> V -> Bool) (m : Map V) : Map V :=
    filter (Pair String V)
      (fun (q : Pair String V) =>
        match q with
        | MkPair k v => p k v
        end) m;

def map_fold (V : Type) (B : Type) (f : String -> V -> B -> B) (z : B)
    (m : Map V) : B :=
    foldr (Pair String V) B
      (fun (p : Pair String V) (acc : B) =>
        match p with
        | MkPair k v => f k v acc
        end) z m;

def map_of_strings (ps : List (Pair String String)) : Map String :=
    map_from_pairs String ps;
