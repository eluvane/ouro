-- Bounded key=value config support for small tools.

import "map.ouro",
  "text.ouro";

inductive ConfigError : Type :=
  | ConfigMissing : String -> ConfigError
  | ConfigBadNat : String -> String -> ConfigError
  | ConfigBadBool : String -> String -> ConfigError;

def Config : Type := Map String;

def config_empty : Config := map_empty String;

def config_error_code (e : ConfigError) : String :=
    match e with
    | ConfigMissing _ => "missing"
    | ConfigBadNat _ _ => "bad_nat"
    | ConfigBadBool _ _ => "bad_bool"
    end;

def config_error_message (e : ConfigError) : String :=
    match e with
    | ConfigMissing key => str_concat "missing config key: " key
    | ConfigBadNat key got => str_cat4 "bad nat for " key ": " got
    | ConfigBadBool key got => str_cat4 "bad bool for " key ": " got
    end;

def config_line_payload (line : String) : Maybe (Pair String String) :=
    let clean : String := str_trim (str_before line "#") in
    match str_null clean with
    | True => Nothing (Pair String String)
    | False =>
      match str_split_first clean "=" with
      | Nothing => Nothing (Pair String String)
      | Just p =>
        match p with
        | MkPair key value =>
          Just (Pair String String)
            (MkPair(String, String, str_trim key, str_trim value))
        end
      end
    end;

def config_insert_line (line : String) (cfg : Config) : Config :=
    match config_line_payload line with
    | Nothing => cfg
    | Just p =>
      match p with
      | MkPair key value => map_insert String key value cfg
      end
    end;

def config_parse (text : String) : Config :=
    foldl String Config
      (fun (cfg : Config) (line : String) => config_insert_line line cfg)
      config_empty (str_lines text);

def config_from_string (text : String) : Config := config_parse text;

def config_get (cfg : Config) (key : String) : Maybe String :=
    map_get String key cfg;

def config_has (cfg : Config) (key : String) : Bool :=
    map_has String key cfg;

def config_get_or (cfg : Config) (key : String) (fallback : String) : String :=
    map_get_or String fallback key cfg;

def config_require (cfg : Config) (key : String) : Either ConfigError String :=
    match config_get cfg key with
    | Nothing => Left ConfigError String (ConfigMissing key)
    | Just value => Right ConfigError String value
    end;

def config_get_nat (cfg : Config) (key : String) : Either ConfigError Nat :=
    match config_require cfg key with
    | Left e => Left ConfigError Nat e
    | Right value =>
      match str_parse_nat value with
      | Nothing => Left ConfigError Nat (ConfigBadNat key value)
      | Just n => Right ConfigError Nat n
      end
    end;

def config_get_nat_or (cfg : Config) (key : String) (fallback : Nat) : Nat :=
    match config_get_nat cfg key with
    | Left _ => fallback
    | Right n => n
    end;

def config_get_bool (cfg : Config) (key : String) : Either ConfigError Bool :=
    match config_require cfg key with
    | Left e => Left ConfigError Bool e
    | Right value =>
      match str_parse_bool value with
      | Nothing => Left ConfigError Bool (ConfigBadBool key value)
      | Just b => Right ConfigError Bool b
      end
    end;

def config_get_bool_or (cfg : Config) (key : String) (fallback : Bool) : Bool :=
    match config_get_bool cfg key with
    | Left _ => fallback
    | Right b => b
    end;

def config_keys (cfg : Config) : List String :=
    map_keys String cfg;

def config_has_all (cfg : Config) (keys : List String) : Bool :=
    all String (fun (key : String) => config_has cfg key) keys;

def config_render_pair (p : Pair String String) : String :=
    match p with
    | MkPair key value => str_cat3 key "=" value
    end;

def config_render (cfg : Config) : String :=
    str_unlines (map(Pair String String, String, config_render_pair, map_pairs String cfg));

def config_merge (base : Config) (override : Config) : Config :=
    map_union String base override;

def config_from_pairs (pairs : List (Pair String String)) : Config :=
    map_from_pairs String pairs;
