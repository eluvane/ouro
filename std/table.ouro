-- Header-aware table helpers over the bounded CSV parser.

import "collections.ouro",
  "csv.ouro",
  "map.ouro";

def table_from_csv (text : String) : List (List String) :=
    csv_parse text;

def table_to_csv (rows : List (List String)) : String :=
    csv_print rows;

def table_header (rows : List (List String)) : List String :=
    csv_header rows;

def table_rows (rows : List (List String)) : List (List String) :=
    tail(List String, rows);

def table_cell (header : List String) (row : List String) (name : String)
    : Maybe String :=
    match csv_lookup_col header name with
    | Nothing => Nothing String
    | Just i => nth_maybe String i row
    end;

def table_record (header : List String) (row : List String) : Map String :=
    map_from_pairs(String, assoc_from_lists String String str_eq header row);

def table_records (rows : List (List String)) : List (Map String) :=
    match rows with
    | Nil => Nil (Map String)
    | Cons header body => map(List String, Map String, table_record header, body)
    end;

def table_lookup (row : Map String) (name : String) : Maybe String :=
    map_get String name row;

def table_col_named (rows : List (List String)) (name : String) : List String :=
    let header : List String := table_header rows in
    filter_map (List String) String
      (fun (row : List String) => table_cell header row name)
      (table_rows rows);

def table_require_col (header : List String) (name : String) : Either String Nat :=
    match csv_lookup_col header name with
    | Nothing => Left String Nat (str_concat "missing column: " name)
    | Just i => Right String Nat i
    end;

def table_project_row (header : List String) (names : List String)
    (row : List String) : List String :=
    map String String
      (fun (name : String) => fromMaybe String "" (table_cell header row name))
      names;

def table_project (rows : List (List String)) (names : List String)
    : List (List String) :=
    match rows with
    | Nil => Nil (List String)
    | Cons header body =>
      Cons (List String) names
        (map(List String, List String, table_project_row header names, body))
    end;

def table_count_rows (rows : List (List String)) : Nat :=
    length(List String, table_rows rows);
