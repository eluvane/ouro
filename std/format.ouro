-- Formatting helpers avoid giant Nat literals so extraction stays within small fuel bounds.

import "assoc.ouro";

def show_nat (n : Nat) : String :=
    prim_string_of_nat n;

def show_bool (b : Bool) : String :=
    match b with
    | True => "true"
    | False => "false"
    end;

def show_maybe (A : Type) (sh : A -> String) (m : Maybe A) : String :=
    match m with
    | Nothing => "none"
    | Just x => str_cat3 "just(" (sh x) ")"
    end;

def show_list (A : Type) (sh : A -> String) (xs : List A) : String :=
    str_cat3 "[" (str_join(", ", map A String sh xs)) "]";

def show_pair (A : Type) (B : Type) (sa : A -> String) (sb : B -> String) (p : Pair A B) : String :=
    match p with
    | MkPair a b => str_cat4("(", sa a, ", ", str_concat(sb b, ")"))
    end;

def pad_nat (n : Nat) (w : Nat) : String :=
    str_pad_left (show_nat n) w ch_zero;

def show_nat_base (n : Nat) (base : Nat) : String :=
    match ltb_nat base 2 with
    | True => show_nat n
    | False =>
      match ltb_nat 36 base with
      | False => show_nat n
      | True =>
        str_of_codes
          ((fix go (fuel : Nat) (x : Nat) (acc : List Nat) : List Nat :=
            match fuel with
            | Z => acc
            | S fuel2 =>
              match ltb_nat x base with
              | True => Cons Nat (hex_digit x) acc
              | False =>
                go(fuel2, div_nat x base, Cons Nat (hex_digit (mod_nat x base)) acc)
              end
            end) (S n) n (Nil Nat))
      end
    end;

def show_hex (n : Nat) : String :=
    str_concat("0x", show_nat_base n 16);

def show_bin (n : Nat) : String :=
    str_concat("0b", show_nat_base n 2);

def show_oct (n : Nat) : String :=
    str_concat("0o", show_nat_base n 8);

def indent (n : Nat) (s : String) : String :=
    str_concat(str_of_codes (replicate Nat ch_space n), s);

def unlines (xs : List String) : String :=
    str_join "\n" xs;

def lines_of (s : String) : List String :=
    str_lines s;

def quote_str (s : String) : String :=
    str_cat3 "\"" s "\"";

def kv_line (k : String) (v : String) : String :=
    str_cat3 k "=" v;

def show_assoc (xs : List (Pair String String)) : String :=
    unlines
      (map (Pair String String) String
        (fun (p : Pair String String) =>
          match p with
          | MkPair k v => kv_line k v
          end) xs);

def parse_kv_line (s : String) : Maybe (Pair String String) :=
    match str_index s "=" with
    | Nothing => Nothing (Pair String String)
    | Just i =>
      Just (Pair String String)
        (MkPair String String (str_slice s Z i)
          (str_slice(s, S i, sub(str_len s, S i))))
    end;

def parse_kv_table (s : String) : List (Pair String String) :=
    (fix go (ls : List String) (acc : List (Pair String String)) : List (Pair String String) :=
      match ls with
      | Nil => acc
      | Cons ln rest =>
        match parse_kv_line ln with
        | Nothing => go rest acc
        | Just p => go(rest, Cons (Pair String String) p acc)
        end
      end) (str_lines s) (Nil (Pair String String));

def lookup_table (table : String) (key : String) : Maybe String :=
    str_assoc_get(key, parse_kv_table table);

def count_lines (s : String) : Nat :=
    length(String, str_lines s);

def ends_nl (s : String) : Bool :=
    str_ends s "\n";

def ensure_nl (s : String) : String :=
    match ends_nl s with
    | True => s
    | False => str_concat s "\n"
    end;
