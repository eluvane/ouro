-- Schema-lite config validation and environment override helpers.

import "config.ouro";
import "io.ouro";
import "validation.ouro";

inductive ConfigKind : Type :=
  | ConfigAsString : ConfigKind
  | ConfigAsNat : ConfigKind
  | ConfigAsBool : ConfigKind;

inductive ConfigField : Type :=
  | MkConfigField : String -> ConfigKind -> ConfigField;

def configx_field (name : String) (kind : ConfigKind) : ConfigField :=
    MkConfigField name kind;

def configx_field_name (field : ConfigField) : String :=
    match field with
    | MkConfigField name _ => name
    end;

def configx_field_kind (field : ConfigField) : ConfigKind :=
    match field with
    | MkConfigField _ kind => kind
    end;

def configx_set (cfg : Config) (key : String) (value : String) : Config :=
    map_insert String key value cfg;

def configx_delete (cfg : Config) (key : String) : Config :=
    map_delete String key cfg;

def configx_with_default (cfg : Config) (key : String) (value : String) : Config :=
    match config_has cfg key with
    | True => cfg
    | False => configx_set cfg key value
    end;

def configx_overlay_pairs (cfg : Config) (pairs : List (Pair String String)) : Config :=
    config_merge cfg (config_from_pairs pairs);

def configx_validate_string (cfg : Config) (key : String) : Validation ConfigError Unit :=
    validation_map ConfigError String Unit (fun (_ : String) => MkUnit)
      (validation_from_result ConfigError String (config_require cfg key));

def configx_validate_nat (cfg : Config) (key : String) : Validation ConfigError Unit :=
    validation_map ConfigError Nat Unit (fun (_ : Nat) => MkUnit)
      (validation_from_result ConfigError Nat (config_get_nat cfg key));

def configx_validate_bool (cfg : Config) (key : String) : Validation ConfigError Unit :=
    validation_map ConfigError Bool Unit (fun (_ : Bool) => MkUnit)
      (validation_from_result ConfigError Bool (config_get_bool cfg key));

def configx_validate_field (cfg : Config) (field : ConfigField) : Validation ConfigError Unit :=
    match field with
    | MkConfigField key kind =>
      match kind with
      | ConfigAsString => configx_validate_string cfg key
      | ConfigAsNat => configx_validate_nat cfg key
      | ConfigAsBool => configx_validate_bool cfg key
      end
    end;

def configx_validate_schema (cfg : Config) : List ConfigField -> Validation ConfigError Unit :=
    fix configx_validate_schema (fields : List ConfigField) : Validation ConfigError Unit :=
      match fields with
      | Nil => valid ConfigError Unit MkUnit
      | Cons field rest => validation_and ConfigError (configx_validate_field cfg field) (configx_validate_schema rest)
      end;

def configx_required_keys (cfg : Config) (keys : List String) : Validation ConfigError Unit :=
    configx_validate_schema cfg (map String ConfigField (fun (key : String) => configx_field key ConfigAsString) keys);

def configx_env_override (cfg : Config) (key : String) (env_name : String) : IO Config :=
    do let! value := env_get env_name;
       match value with
       | Nothing => io_pure Config cfg
       | Just v => io_pure Config (configx_set cfg key v)
       end

def configx_env_overrides (cfg : Config)
    (pairs : List (Pair String String)) : IO Config :=
  (fix go (items : List (Pair String String))
      (current : Config) : IO Config :=
    match items with
    | Nil => io_pure Config current
    | Cons p rest =>
      match p with
      | MkPair key env_name =>
        do let! next := configx_env_override current key env_name;
           go rest next
      end
    end) pairs cfg;

def configx_render_errors (errors : List ConfigError) : String :=
    validation_render_errors ConfigError config_error_message errors;
