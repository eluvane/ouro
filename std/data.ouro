-- Small shared data types and list helpers that the compiler cones are allowed to import.

import "prelude.ouro";

-- Fold Maybe: default d on Nothing, f on Just.
-- @bound(nodes <= 39)
def maybe (A : Type) (B : Type) (d : B) (f : A -> B) (m : Maybe A) : B :=
    match m with
    | Nothing => d
    | Just x => f x
    end;

-- @minimal
-- @bound(nodes <= 25)
def fromMaybe (A : Type) (d : A) (m : Maybe A) : A :=
    match m with
    | Nothing => d
    | Just x => x
    end;

-- @bound(nodes <= 43)
def mapMaybe (A : Type) (B : Type) (f : A -> B) (m : Maybe A) : Maybe B :=
    match m with
    | Nothing => Nothing B
    | Just x => Just B (f x)
    end;

-- @bound(nodes <= 53)
def either (A : Type) (B : Type) (C : Type) (f : A -> C) (g : B -> C) (e : Either A B) : C :=
    match e with
    | Left a => f a
    | Right b => g b
    end;

-- @bound(nodes <= 59)
def mapLeft (A : Type) (B : Type) (C : Type) (f : A -> C) (e : Either A B) : Either C B :=
    match e with
    | Left a => Left C B (f a)
    | Right b => Right C B b
    end;

-- @bound(nodes <= 59)
def mapRight (A : Type) (B : Type) (C : Type) (f : B -> C) (e : Either A B) : Either A C :=
    match e with
    | Left a => Left A C a
    | Right b => Right A C (f b)
    end;

-- @bound(nodes <= 35)
def compareNat : Nat -> Nat -> Ordering :=
  fix compareNat (n : Nat) (m : Nat) : Ordering :=
    match n, m with
    | Z, Z => EQ
    | Z, S _ => LT
    | S _, Z => GT
    | S n', S m' => compareNat n' m'
    end;

-- @bound(nodes <= 23)
def maxNat (n : Nat) (m : Nat) : Nat :=
    match compareNat n m with
    | LT => m
    | EQ => n
    | GT => n
    end;

-- @bound(nodes <= 23)
def minNat (n : Nat) (m : Nat) : Nat :=
    match compareNat n m with
    | LT => n
    | EQ => n
    | GT => m
    end;

-- @bound(nodes <= 41)
def reverse (A : Type) : List A -> List A :=
    fix reverse (xs : List A) : List A :=
      match xs with
      | Nil => Nil A
      | Cons x xs' => append A (reverse xs') ([x] : List A)
      end;

-- @bound(nodes <= 56)
def filter (A : Type) (p : A -> Bool) : List A -> List A :=
    fix filter (xs : List A) : List A :=
      match xs with
      | Nil => Nil A
      | Cons x xs' =>
        match p x with
        | True => Cons A x (filter xs')
        | False => filter xs'
        end
      end;

-- @bound(nodes <= 96)
def zip (A : Type) (B : Type) : List A -> List B -> List (Pair A B) :=
    fix zip (xs : List A) : List B -> List (Pair A B) :=
      match xs with
      | Nil => fun (_ : List B) => Nil (Pair A B)
      | Cons x xs' =>
        fun (ys : List B) =>
          match ys with
          | Nil => Nil (Pair A B)
          | Cons y ys' => Cons (Pair A B) (MkPair A B x y) (zip xs' ys')
          end
      end;

-- @bound(nodes <= 50)
def elem (A : Type) (eq : A -> A -> Bool) (x : A) : List A -> Bool :=
    fix elem (xs : List A) : Bool :=
      match xs with
      | Nil => False
      | Cons y ys => orb (eq x y) (elem ys)
      end;

-- @bound(nodes <= 60)
def take (A : Type) : Nat -> List A -> List A :=
    fix take (n : Nat) : List A -> List A :=
      match n with
      | Z => fun (_ : List A) => Nil A
      | S n' =>
        fun (xs : List A) =>
          match xs with
          | Nil => Nil A
          | Cons x xs' => Cons A x (take n' xs')
          end
      end;

-- @bound(nodes <= 52)
def drop (A : Type) : Nat -> List A -> List A :=
    fix drop (n : Nat) : List A -> List A :=
      match n with
      | Z => fun (xs : List A) => xs
      | S n' =>
        fun (xs : List A) =>
          match xs with
          | Nil => Nil A
          | Cons _ xs' => drop n' xs'
          end
      end;
