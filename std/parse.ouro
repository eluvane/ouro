-- Parser combinators spend input-length fuel so malformed input cannot loop forever.

import "string.ouro";

inductive PRes (A : Type) : Type :=
  | PYes : A -> List Nat -> PRes A
  | PNo : List Nat -> PRes A;

def pok (A : Type) (x : A) (rest : List Nat) : PRes A :=
    PYes A x rest;

def pfail (A : Type) (rest : List Nat) : PRes A :=
    PNo A rest;

def pmap (A : Type) (B : Type) (f : A -> B) (r : PRes A) : PRes B :=
    match r with
    | PYes x rest => PYes B (f x) rest
    | PNo rest => PNo B rest
    end;

def pany (cs : List Nat) : PRes Nat :=
    match cs with
    | Nil => PNo Nat cs
    | Cons c rest => PYes Nat c rest
    end;

def psatisfy (p : Nat -> Bool) (cs : List Nat) : PRes Nat :=
    match cs with
    | Nil => PNo Nat cs
    | Cons c rest =>
      match p c with
      | True => PYes Nat c rest
      | False => PNo Nat cs
      end
    end;

def pchar (c : Nat) (cs : List Nat) : PRes Nat :=
    psatisfy(eq_nat c, cs);

def pdigit (cs : List Nat) : PRes Nat :=
    pmap Nat Nat digit_val (psatisfy is_digit cs);

def phex (cs : List Nat) : PRes Nat :=
    pmap Nat Nat digit_val (psatisfy is_hex cs);

def palpha (cs : List Nat) : PRes Nat :=
    psatisfy is_alpha cs;

def palnum (cs : List Nat) : PRes Nat :=
    psatisfy is_alnum cs;

def pws1 (cs : List Nat) : PRes Nat :=
    psatisfy is_ws cs;

def pstring (pat : List Nat) : List Nat -> PRes (List Nat) :=
    (fix pstring (want : List Nat) (cs : List Nat) : PRes (List Nat) :=
      match want with
      | Nil => PYes (List Nat) pat cs
      | Cons w ws =>
        match cs with
        | Nil => PNo(List Nat, cs)
        | Cons c rest =>
          match eq_nat w c with
          | True => pstring ws rest
          | False => PNo(List Nat, cs)
          end
        end
      end) pat;

def pstr (s : String) (cs : List Nat) : PRes String :=
    pmap(List Nat, String, fun (_ : List Nat) => s, pstring(str_codes s, cs));

-- Fuel is the remaining input length, so the caller supplies it.
def pmany_fuel (A : Type) (p : List Nat -> PRes A)
    : Nat -> List Nat -> PRes (List A) :=
    fix pmany_fuel (fuel : Nat) (cs : List Nat) : PRes (List A) :=
      match fuel with
      | Z => PYes(List A, Nil A, cs)
      | S fuel2 =>
        match p cs with
        | PNo _ => PYes(List A, Nil A, cs)
        | PYes x rest =>
          match pmany_fuel fuel2 rest with
          | PNo _r2 => PYes(List A, [x] : List A, rest)
          | PYes xs r2 => PYes(List A, Cons A x xs, r2)
          end
        end
      end;

def pmany (A : Type) (p : List Nat -> PRes A) (cs : List Nat)
    : PRes (List A) :=
    pmany_fuel A p (S (length Nat cs)) cs;

def pmany1 (A : Type) (p : List Nat -> PRes A) (cs : List Nat) : PRes (List A) :=
    match p cs with
    | PNo rest => PNo(List A, rest)
    | PYes x rest =>
      match pmany A p rest with
      | PNo _ => PYes(List A, [x] : List A, rest)
      | PYes xs r2 => PYes(List A, Cons A x xs, r2)
      end
    end;

def popt (A : Type) (p : List Nat -> PRes A) (cs : List Nat) : PRes (Maybe A) :=
    match p cs with
    | PYes x rest => PYes(Maybe A, Just A x, rest)
    | PNo _ => PYes(Maybe A, Nothing A, cs)
    end;

def pskip_ws (cs : List Nat) : PRes Unit :=
    match pmany Nat pws1 cs with
    | PYes _ rest => PYes Unit MkUnit rest
    | PNo rest => PYes Unit MkUnit rest
    end;

def pnat (cs : List Nat) : PRes Nat :=
    match pmany1 Nat pdigit cs with
    | PNo rest => PNo Nat rest
    | PYes ds rest => PYes Nat (from_digits (reverse_lin Nat ds)) rest
    end;

def pident (cs : List Nat) : PRes (List Nat) :=
    match psatisfy is_ident_start cs with
    | PNo rest => PNo(List Nat, rest)
    | PYes c rest =>
      match pmany Nat (psatisfy is_ident_cont) rest with
      | PNo _ => PYes(List Nat, [c] : List Nat, rest)
      | PYes cs2 r2 => PYes(List Nat, Cons Nat c cs2, r2)
      end
    end;

def psep_by (A : Type) (p : List Nat -> PRes A) (sep : List Nat -> PRes Nat) (cs : List Nat) : PRes (List A) :=
    match p cs with
    | PNo _ => PYes(List A, Nil A, cs)
    | PYes x rest =>
      match pmany A
        (fun (cs2 : List Nat) =>
          match sep cs2 with
          | PNo r => PNo A r
          | PYes _ r => p r
          end) rest with
      | PNo _ => PYes(List A, [x] : List A, rest)
      | PYes xs r2 => PYes(List A, Cons A x xs, r2)
      end
    end;

def pchoice (A : Type) (p : List Nat -> PRes A) (q : List Nat -> PRes A) (cs : List Nat) : PRes A :=
    match p cs with
    | PYes x rest => PYes A x rest
    | PNo _ => q cs
    end;

def pbetween (A : Type) (l : Nat) (r : Nat) (p : List Nat -> PRes A) (cs : List Nat) : PRes A :=
    match pchar l cs with
    | PNo rest => PNo A rest
    | PYes _ rest =>
      match p rest with
      | PNo r2 => PNo A r2
      | PYes x r2 =>
        match pchar r r2 with
        | PNo r3 => PNo A r3
        | PYes _ r3 => PYes A x r3
        end
      end
    end;

def peof (cs : List Nat) : PRes Unit :=
    match cs with
    | Nil => PYes Unit MkUnit cs
    | Cons _ _ => PNo Unit cs
    end;

def ptoken (A : Type) (p : List Nat -> PRes A) (cs : List Nat) : PRes A :=
    match pskip_ws cs with
    | PNo rest => PNo A rest
    | PYes _ rest =>
      match p rest with
      | PNo r2 => PNo A r2
      | PYes x r2 =>
        match pskip_ws r2 with
        | PNo _r3 => PYes A x r2
        | PYes _ r3 => PYes A x r3
        end
      end
    end;

def parse_nat (s : String) : Maybe Nat :=
    match pnat (str_codes s) with
    | PYes n rest =>
      match rest with
      | Nil => Just Nat n
      | Cons _ _ => Nothing Nat
      end
    | PNo _ => Nothing Nat
    end;

def parse_ident (s : String) : Maybe String :=
    match pident (str_codes s) with
    | PYes cs rest =>
      match rest with
      | Nil => Just(String, str_of_codes cs)
      | Cons _ _ => Nothing String
      end
    | PNo _ => Nothing String
    end;
