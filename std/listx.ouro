-- Extra list algorithms stay outside prelude to keep bootstrap cones small.

import "natx.ouro";

def concat_map (A : Type) (B : Type) (f : A -> List B) : List A -> List B :=
    fix concat_map (xs : List A) : List B :=
      match xs with
      | Nil => Nil B
      | Cons x xs2 => append B (f x) (concat_map xs2)
      end;

def flatten (A : Type) : List (List A) -> List A :=
    concat_map (List A) A (fun (ys : List A) => ys);

def nth (A : Type) (d : A) : Nat -> List A -> A :=
    fix nth (n : Nat) (xs : List A) : A :=
      match xs with
      | Nil => d
      | Cons x xs2 =>
        match n with
        | Z => x
        | S n2 => nth n2 xs2
        end
      end;

-- Left fold. prelude has foldr only, and a scanner that carries state through
-- a list of lines wants the accumulator threaded front to back.
def foldl (A : Type) (B : Type) (f : B -> A -> B)
    (acc : B) (xs : List A) : B :=
  (fix go (ys : List A) (state : B) : B :=
    match ys with
    | Nil => state
    | Cons x ys2 => go ys2 (f state x)
    end) xs acc;

def rev_append (A : Type) : List A -> List A -> List A :=
    fix rev_append (xs : List A) (acc : List A) : List A :=
      match xs with
      | Nil => acc
      | Cons x xs2 => rev_append xs2 (Cons A x acc)
      end;

def reverse_lin (A : Type) (xs : List A) : List A :=
    rev_append A xs (Nil A);

def last (A : Type) (d : A) : List A -> A :=
    fix last (xs : List A) : A :=
      match xs with
      | Nil => d
      | Cons x xs2 =>
        match xs2 with
        | Nil => x
        | Cons _ _ => last xs2
        end
      end;

def init (A : Type) : List A -> List A :=
    fix init (xs : List A) : List A :=
      match xs with
      | Nil => Nil A
      | Cons x xs2 =>
        match xs2 with
        | Nil => Nil A
        | Cons _ _ => Cons A x (init xs2)
        end
      end;

def any (A : Type) (p : A -> Bool) : List A -> Bool :=
    fix any (xs : List A) : Bool :=
      match xs with
      | Nil => False
      | Cons x xs2 => orb (p x) (any xs2)
      end;

def all (A : Type) (p : A -> Bool) : List A -> Bool :=
    fix all (xs : List A) : Bool :=
      match xs with
      | Nil => True
      | Cons x xs2 => andb (p x) (all xs2)
      end;

def find (A : Type) (p : A -> Bool) : List A -> Maybe A :=
    fix find (xs : List A) : Maybe A :=
      match xs with
      | Nil => Nothing A
      | Cons x xs2 =>
        match p x with
        | True => Just A x
        | False => find xs2
        end
      end;

def lookup (A : Type) (B : Type) (eq : A -> A -> Bool) (k : A) : List (Pair A B) -> Maybe B :=
    fix lookup (xs : List (Pair A B)) : Maybe B :=
      match xs with
      | Nil => Nothing B
      | Cons p xs2 =>
        match p with
        | MkPair a b =>
          match eq a k with
          | True => Just B b
          | False => lookup xs2
          end
        end
      end;

def span (A : Type) (p : A -> Bool) : List A -> Pair (List A) (List A) :=
    fix span (xs : List A) : Pair (List A) (List A) :=
      match xs with
      | Nil => MkPair (List A) (List A) (Nil A) (Nil A)
      | Cons x xs2 =>
        match p x with
        | False => MkPair (List A) (List A) (Nil A) xs
        | True =>
          match span xs2 with
          | MkPair ys zs => MkPair (List A) (List A) (Cons A x ys) zs
          end
        end
      end;

def break_list (A : Type) (p : A -> Bool) : List A -> Pair (List A) (List A) :=
    span A (fun (x : A) => notb (p x));

def take_while (A : Type) (p : A -> Bool) (xs : List A) : List A :=
    fst (List A) (List A) (span A p xs);

def drop_while (A : Type) (p : A -> Bool) (xs : List A) : List A :=
    snd (List A) (List A) (span A p xs);

def intersperse (A : Type) (sep : A) : List A -> List A :=
    fix intersperse (xs : List A) : List A :=
      match xs with
      | Nil => Nil A
      | Cons x xs2 =>
        match xs2 with
        | Nil => ([x] : List A)
        | Cons _ _ => Cons A x (Cons A sep (intersperse xs2))
        end
      end;

def replicate (A : Type) (x : A) : Nat -> List A :=
    fix replicate (n : Nat) : List A :=
      match n with
      | Z => Nil A
      | S n2 => Cons A x (replicate n2)
      end;

def count_if (A : Type) (p : A -> Bool) : List A -> Nat :=
    fix count_if (xs : List A) : Nat :=
      match xs with
      | Nil => Z
      | Cons x xs2 =>
        match p x with
        | True => S (count_if xs2)
        | False => count_if xs2
        end
      end;

def partition (A : Type) (p : A -> Bool) : List A -> Pair (List A) (List A) :=
    fix partition (xs : List A) : Pair (List A) (List A) :=
      match xs with
      | Nil => MkPair (List A) (List A) (Nil A) (Nil A)
      | Cons x xs2 =>
        match partition xs2 with
        | MkPair ys zs =>
          match p x with
          | True => MkPair (List A) (List A) (Cons A x ys) zs
          | False => MkPair (List A) (List A) ys (Cons A x zs)
          end
        end
      end;

def unzip (A : Type) (B : Type) : List (Pair A B) -> Pair (List A) (List B) :=
    fix unzip (xs : List (Pair A B)) : Pair (List A) (List B) :=
      match xs with
      | Nil => MkPair (List A) (List B) (Nil A) (Nil B)
      | Cons p xs2 =>
        match p with
        | MkPair a b =>
          match unzip xs2 with
          | MkPair as_ bs =>
            MkPair (List A) (List B) (Cons A a as_) (Cons B b bs)
          end
        end
      end;

def nub (A : Type) (eq : A -> A -> Bool) (xs : List A) : List A :=
  (fix go (fuel : Nat) (ys : List A) : List A :=
    match fuel with
    | Z => Nil A
    | S fuel2 =>
      match ys with
      | Nil => Nil A
      | Cons x ys2 =>
          Cons A x
            (go fuel2 (filter A (fun (y : A) => notb (eq x y)) ys2))
      end
    end) (S (length A xs)) xs;

def insert_sorted (A : Type) (le : A -> A -> Bool) (x : A) : List A -> List A :=
    fix insert_sorted (xs : List A) : List A :=
      match xs with
      | Nil => ([x] : List A)
      | Cons y ys =>
        match le x y with
        | True => Cons A x xs
        | False => Cons A y (insert_sorted ys)
        end
      end;

def sort_insert (A : Type) (le : A -> A -> Bool) : List A -> List A :=
    fix sort_insert (xs : List A) : List A :=
      match xs with
      | Nil => Nil A
      | Cons x xs2 => insert_sorted A le x (sort_insert xs2)
      end;

def sort_nat (xs : List Nat) : List Nat :=
    sort_insert Nat leb_nat xs;

def inits (A : Type) : List A -> List (List A) :=
    fix inits (xs : List A) : List (List A) :=
      Cons (List A) (Nil A)
        (match xs with
         | Nil => Nil (List A)
         | Cons x xs2 =>
           map (List A) (List A) (fun (ys : List A) => Cons A x ys) (inits xs2)
         end);

def tails (A : Type) : List A -> List (List A) :=
    fix tails (xs : List A) : List (List A) :=
      Cons (List A) xs
        (match xs with
         | Nil => Nil (List A)
         | Cons _ xs2 => tails xs2
         end);

def is_prefix (A : Type) (eq : A -> A -> Bool) : List A -> List A -> Bool :=
    fix is_prefix (pre : List A) (xs : List A) : Bool :=
      match pre with
      | Nil => True
      | Cons p ps =>
        match xs with
        | Nil => False
        | Cons x xs2 => andb (eq p x) (is_prefix ps xs2)
        end
      end;

def is_suffix (A : Type) (eq : A -> A -> Bool) (suf : List A) (xs : List A) : Bool :=
    is_prefix A eq (reverse_lin A suf) (reverse_lin A xs);

def index_of (A : Type) (eq : A -> A -> Bool) (x : A)
    (xs : List A) : Maybe Nat :=
  (fix go (ys : List A) (i : Nat) : Maybe Nat :=
    match ys with
    | Nil => Nothing Nat
    | Cons y ys2 =>
      match eq x y with
      | True => Just Nat i
      | False => go ys2 (S i)
      end
    end) xs Z;

def update_nth (A : Type) (n : Nat) (x : A) : List A -> List A :=
    (fix update_nth (i : Nat) (xs : List A) : List A :=
      match xs with
      | Nil => Nil A
      | Cons y ys =>
        match i with
        | Z => Cons A x ys
        | S i2 => Cons A y (update_nth i2 ys)
        end
      end) n;

def zip_with (A : Type) (B : Type) (C : Type) (f : A -> B -> C) : List A -> List B -> List C :=
    fix zip_with (xs : List A) : List B -> List C :=
      match xs with
      | Nil => fun (_ : List B) => Nil C
      | Cons x xs2 =>
        fun (ys : List B) =>
          match ys with
          | Nil => Nil C
          | Cons y ys2 => Cons C (f x y) (zip_with xs2 ys2)
          end
      end;

def sum_nats : List Nat -> Nat :=
    foldr Nat Nat add Z;

def product_nats : List Nat -> Nat :=
    foldr Nat Nat mul (S Z);

def maximum_nat (d : Nat) : List Nat -> Nat :=
    foldr Nat Nat maxNat d;

def minimum_nat (d : Nat) : List Nat -> Nat :=
    foldr Nat Nat minNat d;

def mem (A : Type) (eq : A -> A -> Bool) (x : A) (xs : List A) : Bool :=
    elem A eq x xs;

def snoc (A : Type) (xs : List A) (x : A) : List A :=
    append A xs ([x] : List A);

def singleton (A : Type) (x : A) : List A :=
    ([x] : List A);

def nullb (A : Type) (xs : List A) : Bool :=
    match xs with
    | Nil => True
    | Cons _ _ => False
    end;

def head (A : Type) (d : A) (xs : List A) : A :=
    match xs with
    | Nil => d
    | Cons x _ => x
    end;

def tail (A : Type) (xs : List A) : List A :=
    match xs with
    | Nil => Nil A
    | Cons _ xs2 => xs2
    end;
