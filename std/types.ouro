-- Shared data declarations and checked representation identities. This module
-- has no executable helpers or runtime/platform imports.

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

representation Nat := "ouro.nat";

inductive Bool : Type :=
  | True : Bool
  | False : Bool;

representation Bool := "ouro.bool";

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

representation List := "ouro.list";

inductive Pair (A : Type) (B : Type) : Type :=
  | MkPair : A -> B -> Pair A B;

representation Pair := "ouro.pair";

inductive Maybe (A : Type) : Type :=
  | Nothing : Maybe A
  | Just : A -> Maybe A;

representation Maybe := "ouro.maybe";

inductive Either (A : Type) (B : Type) : Type :=
  | Left : A -> Either A B
  | Right : B -> Either A B;

inductive Ordering : Type :=
  | LT : Ordering
  | EQ : Ordering
  | GT : Ordering;

inductive Unit : Type :=
  | MkUnit : Unit;

representation Unit := "ouro.unit";
