-- Nat helpers are built from prelude primitives to avoid giant Peano literals.

import "data.ouro";

def eq_nat (n : Nat) (m : Nat) : Bool :=
    match compareNat n m with
    | EQ => True
    | LT => False
    | GT => False
    end;

def leb_nat (n : Nat) (m : Nat) : Bool :=
    match compareNat n m with
    | GT => False
    | LT => True
    | EQ => True
    end;

def ltb_nat (n : Nat) (m : Nat) : Bool :=
    match compareNat n m with
    | LT => True
    | EQ => False
    | GT => False
    end;

def geb_nat (n : Nat) (m : Nat) : Bool :=
    leb_nat m n;

def gtb_nat (n : Nat) (m : Nat) : Bool :=
    ltb_nat m n;

def neb_nat (n : Nat) (m : Nat) : Bool :=
    notb (eq_nat n m);

def pred (n : Nat) : Nat :=
    match n with
    | Z => Z
    | S n2 => n2
    end;

def max3 (a : Nat) (b : Nat) (c : Nat) : Nat :=
    maxNat(a, maxNat b c);

def min3 (a : Nat) (b : Nat) (c : Nat) : Nat :=
    minNat(a, minNat b c);

def clamp_nat (lo : Nat) (hi : Nat) (x : Nat) : Nat :=
    maxNat(lo, minNat hi x);

def evenb (n : Nat) : Bool :=
    (fix go (x : Nat) : Bool :=
      match x with
      | Z => True
      | S x2 =>
        match x2 with
        | Z => False
        | S x3 => go x3
        end
      end) n;

def oddb (n : Nat) : Bool :=
    notb (evenb n);

-- Each level doubles the divisor; unwinding selects quotient bits.
-- For positive divisors, n + 1 bounds the doubling depth and structural fuel.
def divmod_nat (n : Nat) (m : Nat) : Pair Nat Nat :=
    match m with
    | Z => MkPair Nat Nat Z n
    | S _ =>
      (fix divide (fuel : Nat) (divisor : Nat) (weight : Nat) : Pair Nat Nat :=
        match fuel with
        | Z => MkPair Nat Nat Z n
        | S fuel2 =>
          match ltb_nat n divisor with
          | True => MkPair Nat Nat Z n
          | False =>
            let remaining : Nat := sub n divisor in
            match ltb_nat remaining divisor with
            | True => MkPair Nat Nat weight remaining
            | False =>
              match divide fuel2 (add divisor divisor) (add weight weight) with
              | MkPair quotient remainder =>
                match ltb_nat remainder divisor with
                | True => MkPair Nat Nat quotient remainder
                | False => MkPair Nat Nat (add quotient weight) (sub remainder divisor)
                end
              end
            end
          end
        end) (S n) m (S Z)
    end;

def div_nat (n : Nat) (m : Nat) : Nat :=
    fst Nat Nat (divmod_nat n m);

def mod_nat (n : Nat) (m : Nat) : Nat :=
    snd Nat Nat (divmod_nat n m);

def pow_nat (base : Nat) (exp : Nat) : Nat :=
    (fix go (e : Nat) : Nat :=
      match e with
      | Z => S Z
      | S e2 => mul(base, go e2)
      end) exp;

def gcd_nat (a : Nat) (b : Nat) : Nat :=
  (fix go (fuel : Nat) (x : Nat) (y : Nat) : Nat :=
    match fuel with
    | Z => x
    | S fuel2 =>
      match y with
      | Z => x
      | S _ => go fuel2 y (mod_nat x y)
      end
    end) (S (add a b)) a b;

def lcm_nat (a : Nat) (b : Nat) : Nat :=
    match mul a b with
    | Z => Z
    | S p =>
      match gcd_nat a b with
      | Z => Z
      | S g => div_nat(S p, S g)
      end
    end;

def isqrt_nat (n : Nat) : Nat :=
    (fix go (fuel : Nat) (x : Nat) : Nat :=
      match fuel with
      | Z => x
      | S fuel2 =>
        match compareNat(mul x x, n) with
        | GT => go(fuel2, pred x)
        | EQ => x
        | LT =>
          match compareNat(mul(S x, S x), n) with
          | GT => x
          | EQ => S x
          | LT => go(fuel2, S x)
          end
        end
      end) (S n) Z;

def log2_nat (n : Nat) : Nat :=
    (fix go (fuel : Nat) (x : Nat) (acc : Nat) : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        match x with
        | Z => acc
        | S x2 =>
          match x2 with
          | Z => acc
          | S _ => go(fuel2, div_nat(x, S (S Z)), S acc)
          end
        end
      end) n n Z;

def fact_nat (n : Nat) : Nat :=
    (fix go (k : Nat) : Nat :=
      match k with
      | Z => S Z
      | S k2 => mul(S k2, go k2)
      end) n;

def fib_nat (n : Nat) : Nat :=
    (fix go (remaining : Nat) (current : Nat) (next : Nat) : Nat :=
      match remaining with
      | Z => current
      | S rest => go rest next (add current next)
      end) n Z (S Z);

def sum_range (lo : Nat) (hi : Nat) : Nat :=
    (fix go (fuel : Nat) (i : Nat) (acc : Nat) : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        match leb_nat i hi with
        | False => acc
        | True => go(fuel2, S i, add acc i)
        end
      end) (S (sub hi lo)) lo Z;

def digit_count (n : Nat) : Nat :=
    (fix go (fuel : Nat) (x : Nat) (acc : Nat) : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        match ltb_nat x 10 with
        | True => acc
        | False => go(fuel2, div_nat x 10, S acc)
        end
      end) (S n) n (S Z);

def nth_digit (n : Nat) (i : Nat) : Nat :=
    mod_nat(div_nat(n, pow_nat 10 i), 10);

def from_digits : List Nat -> Nat :=
  fix from_digits (ds : List Nat) : Nat :=
    match ds with
    | Nil => Z
    | Cons d rest => add(mul(from_digits rest, 10), mod_nat d 10)
    end;

def to_digits (n : Nat) : List Nat :=
    (fix go (fuel : Nat) (x : Nat) (acc : List Nat) : List Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        match ltb_nat x 10 with
        | True => Cons Nat x acc
        | False => go(fuel2, div_nat x 10, Cons Nat (mod_nat x 10) acc)
        end
      end) (S n) n (Nil Nat);

def abs_diff (a : Nat) (b : Nat) : Nat :=
    match compareNat a b with
    | LT => sub b a
    | EQ => Z
    | GT => sub a b
    end;

def sat_sub (a : Nat) (b : Nat) : Nat :=
    sub a b;

def inc (n : Nat) : Nat := S n;

def dec (n : Nat) : Nat := pred n;

def twice (n : Nat) : Nat := add n n;

def half (n : Nat) : Nat := div_nat(n, S (S Z));

def between (lo : Nat) (hi : Nat) (x : Nat) : Bool :=
    andb(leb_nat lo x, leb_nat x hi);

def coprime (a : Nat) (b : Nat) : Bool :=
    eq_nat(gcd_nat a b, S Z);

def eq_nat_list : List Nat -> List Nat -> Bool :=
    fix eq_nat_list (left : List Nat) (right : List Nat) : Bool :=
      match left with
      | Nil => match right with | Nil => True | Cons _ _ => False end
      | Cons x xs => match right with
        | Nil => False
        | Cons y ys => match eq_nat x y with
          | True => eq_nat_list xs ys
          | False => False
          end
        end
      end;
