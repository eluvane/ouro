-- Typed command specs, checked execution helpers, and shell-free plan rendering.

import "collections.ouro";
import "process.ouro";

inductive CommandSpec : Type :=
  | MkCommandSpec : String -> List String -> CommandSpec;

inductive ProcessPlan : Type :=
  | MkProcessPlan : List CommandSpec -> ProcessPlan;

def command_spec (program : String) (args : List String) : CommandSpec :=
    MkCommandSpec program args;

def command_program (cmd : CommandSpec) : String :=
    match cmd with
    | MkCommandSpec program _ => program
    end;

def command_args (cmd : CommandSpec) : List String :=
    match cmd with
    | MkCommandSpec _ args => args
    end;

def command_add_arg (cmd : CommandSpec) (arg : String) : CommandSpec :=
    MkCommandSpec (command_program cmd) (snoc String (command_args cmd) arg);

def command_add_args (cmd : CommandSpec) (args : List String) : CommandSpec :=
    MkCommandSpec (command_program cmd) (append String (command_args cmd) args);

def command_argv (cmd : CommandSpec) : List String :=
    Cons String (command_program cmd) (command_args cmd);

def command_render (cmd : CommandSpec) : String :=
    str_join " " (command_argv cmd);

def command_dry_run (cmd : CommandSpec) : String :=
    str_concat "dry-run: " (command_render cmd);

def process_run_spec (cmd : CommandSpec) : IO ProcResult :=
    process_run (command_program cmd) (command_args cmd);

def process_run_spec_checked (cmd : CommandSpec) : IO (Either ProcessError ProcResult) :=
    process_run_checked (command_program cmd) (command_args cmd);

-- Preserve both captured streams for any explicitly accepted exit status.
-- An empty list rejects every result, including exit status zero.
def process_run_expected_codes (cmd : CommandSpec) (expected : List Nat) : IO (Either ProcessError ProcResult) :=
    do let! result := process_run_spec cmd;
       match elem Nat eq_nat (proc_code result) expected with
       | True => io_pure (Either ProcessError ProcResult) (Right ProcessError ProcResult result)
       | False =>
         io_pure (Either ProcessError ProcResult)
           (Left ProcessError ProcResult
             (ProcessFailed (command_program cmd) (proc_code result) (proc_stderr result)))
       end

def process_stdout_checked (cmd : CommandSpec) : IO (Either ProcessError String) :=
    do let! result := process_run_spec_checked cmd;
       match result with
       | Left e => io_pure (Either ProcessError String) (Left ProcessError String e)
       | Right r => io_pure (Either ProcessError String) (Right ProcessError String (proc_stdout r))
       end

def process_require_empty_stderr (cmd : CommandSpec) (result : ProcResult) : Either ProcessError ProcResult :=
    match str_null (proc_stderr result) with
    | True => Right ProcessError ProcResult result
    | False => Left ProcessError ProcResult (ProcessFailed (command_program cmd) (proc_code result) (proc_stderr result))
       end;

def process_run_expected (cmd : CommandSpec) (expected : Nat) : IO (Either ProcessError ProcResult) :=
    process_run_expected_codes cmd [expected];

def process_run_quiet_checked (cmd : CommandSpec) : IO (Either ProcessError ProcResult) :=
    do let! result := process_run_spec_checked cmd;
       match result with
       | Left e => io_pure (Either ProcessError ProcResult) (Left ProcessError ProcResult e)
       | Right r => io_pure (Either ProcessError ProcResult) (process_require_empty_stderr cmd r)
       end

def process_plan_empty : ProcessPlan := MkProcessPlan (Nil CommandSpec);

def process_plan_add (plan : ProcessPlan) (cmd : CommandSpec) : ProcessPlan :=
    match plan with
    | MkProcessPlan cmds => MkProcessPlan (snoc CommandSpec cmds cmd)
    end;

def process_plan_commands (plan : ProcessPlan) : List CommandSpec :=
    match plan with
    | MkProcessPlan cmds => cmds
    end;

def process_plan_render (plan : ProcessPlan) : String :=
    str_join " | " (map CommandSpec String command_render (process_plan_commands plan));

def process_run_specs_checked : List CommandSpec -> IO (Either ProcessError (List ProcResult)) :=
    fix process_run_specs_checked (cmds : List CommandSpec) : IO (Either ProcessError (List ProcResult)) :=
      match cmds with
      | Nil => io_pure (Either ProcessError (List ProcResult)) (Right ProcessError (List ProcResult) (Nil ProcResult))
      | Cons cmd rest =>
        do let! first := process_run_spec_checked cmd;
           match first with
           | Left e => io_pure (Either ProcessError (List ProcResult)) (Left ProcessError (List ProcResult) e)
           | Right result =>
             do let! tail_results := process_run_specs_checked rest;
                match tail_results with
                | Left e => io_pure (Either ProcessError (List ProcResult)) (Left ProcessError (List ProcResult) e)
                | Right rs => io_pure (Either ProcessError (List ProcResult)) (Right ProcessError (List ProcResult) (Cons ProcResult result rs))
                end
           end
      end;

def process_run_plan_checked (plan : ProcessPlan) : IO (Either ProcessError (List ProcResult)) :=
    process_run_specs_checked (process_plan_commands plan);

def process_run_spec_inherited (command : CommandSpec) : IO (Either ProcessRunError Nat) :=
    process_run_inherited (command_program command) (command_args command);

def process_run_spec_inherited_checked (command : CommandSpec) : IO (Either ProcessRunError Nat) :=
    process_run_inherited_checked (command_program command) (command_args command);

def process_run_spec_captured_bounded (limits : ProcessCaptureLimits) (command : CommandSpec)
    : IO (Either ProcessCaptureError ProcessCaptureResult) :=
    process_run_captured_bounded limits (command_program command) (command_args command);

def process_run_spec_captured_bounded_with_input (limits : ProcessCaptureLimits) (command : CommandSpec) (input : String)
    : IO (Either ProcessCaptureError ProcessCaptureResult) :=
    process_run_captured_bounded_with_input limits (command_program command) (command_args command) input;
