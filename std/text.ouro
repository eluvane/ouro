-- Text-processing helpers for CLI and data programs.

import "char.ouro",
  "collections.ouro",
  "parse.ouro",
  "stringx.ouro";

def str_split_last (s : String) (sep : String) : Maybe (Pair String String) :=
    match str_null sep with
    | True => Nothing (Pair String String)
    | False =>
      match str_split_first(str_rev s, str_rev sep) with
      | Nothing => Nothing (Pair String String)
      | Just p =>
        match p with
        | MkPair after_rev before_rev =>
          Just (Pair String String)
            (MkPair(String, String, str_rev before_rev, str_rev after_rev))
        end
      end
    end;

def str_drop_prefix_or (s : String) (pre : String) : String :=
    fromMaybe String s (str_strip_prefix s pre);

def str_drop_suffix_or (s : String) (suf : String) : String :=
    fromMaybe String s (str_strip_suffix s suf);

def str_chomp (s : String) : String :=
    str_drop_suffix_or(str_drop_suffix_or s "\n", "\r");

def str_tokens (s : String) : List String :=
    prim_string_tokens s;

def str_lines_trimmed (s : String) : List String :=
    map String String str_trim (str_lines s);

def str_char_all (p : Nat -> Bool) (s : String) : Bool :=
    all Nat p (str_codes s);

def str_char_any (p : Nat -> Bool) (s : String) : Bool :=
    any Nat p (str_codes s);

def str_is_blank (s : String) : Bool :=
    str_char_all is_ws s;

def str_nonblank_lines (s : String) : List String :=
    filter(String, fun (line : String) => notb (str_is_blank line), str_lines s);

def str_is_digits (s : String) : Bool :=
    andb(notb (str_null s), str_char_all is_digit s);

def str_is_alpha_text (s : String) : Bool :=
    andb(notb (str_null s), str_char_all is_alpha s);

def str_is_alnum_text (s : String) : Bool :=
    andb(notb (str_null s), str_char_all is_alnum s);

def str_is_lower_text (s : String) : Bool :=
    str_eq(s, str_lower s);

def str_is_upper_text (s : String) : Bool :=
    str_eq(s, str_upper s);

def str_between (s : String) (left : String) (right : String) : Maybe String :=
    match str_split_first s left with
    | Nothing => Nothing String
    | Just first =>
      match first with
      | MkPair _ after_left =>
        match str_split_first after_left right with
        | Nothing => Nothing String
        | Just second =>
          match second with
          | MkPair inside _ => Just String inside
          end
        end
      end
    end;

def str_parse_nat (s : String) : Maybe Nat :=
    parse_nat (str_trim s);

def str_parse_bool (s : String) : Maybe Bool :=
    let t : String := str_lower (str_trim s) in
    match str_eq t "true" with
    | True => Just Bool True
    | False =>
      match str_eq t "false" with
      | True => Just Bool False
      | False =>
        match str_eq t "yes" with
        | True => Just Bool True
        | False =>
          match str_eq t "no" with
          | True => Just Bool False
          | False =>
            match str_eq t "on" with
            | True => Just Bool True
            | False =>
              match str_eq t "off" with
              | True => Just Bool False
              | False =>
                match str_eq t "1" with
                | True => Just Bool True
                | False =>
                  match str_eq t "0" with
                  | True => Just Bool False
                  | False => Nothing Bool
                  end
                end
              end
            end
          end
        end
      end
    end;
