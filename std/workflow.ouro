-- Small command workflow abstraction: args, config, validation, action, report.

import "cli.ouro";
import "configx.ouro";
import "process.ouro";
import "processx.ouro";
import "report.ouro";
import "workspace.ouro";

inductive CommandError : Type :=
  | CommandUsage : String -> CommandError
  | CommandValidation : List String -> CommandError
  | CommandProcess : ProcessError -> CommandError
  | CommandFs : FsError -> CommandError
  | CommandConfig : ConfigError -> CommandError
  | CommandMessage : String -> CommandError;

inductive CommandContext : Type :=
  | MkCommandContext : String -> Args -> Config -> CommandContext;

def CommandResult : Type := Either CommandError Report;

def command_context_program (ctx : CommandContext) : String :=
    match ctx with
    | MkCommandContext program _ _ => program
    end;

def command_context_args (ctx : CommandContext) : Args :=
    match ctx with
    | MkCommandContext _ args _ => args
    end;

def command_context_config (ctx : CommandContext) : Config :=
    match ctx with
    | MkCommandContext _ _ cfg => cfg
    end;

def command_context (program : String) (args : Args) (cfg : Config) : CommandContext :=
    MkCommandContext program args cfg;

def command_error_code (e : CommandError) : String :=
    match e with
    | CommandUsage _ => "usage"
    | CommandValidation _ => "validation"
    | CommandProcess _ => "process"
    | CommandFs _ => "filesystem"
    | CommandConfig _ => "config"
    | CommandMessage _ => "error"
    end;

def command_error_message (e : CommandError) : String :=
    match e with
    | CommandUsage text => text
    | CommandValidation errors => str_unlines errors
    | CommandProcess pe => process_error_message pe
    | CommandFs fe => fs_error_message fe
    | CommandConfig ce => config_error_message ce
    | CommandMessage text => text
    end;

def command_exit_code (e : CommandError) : Nat :=
    match e with
    | CommandUsage _ => 2
    | CommandValidation _ => 2
    | CommandProcess _ => 1
    | CommandFs _ => 1
    | CommandConfig _ => 2
    | CommandMessage _ => 1
    end;

def command_ok (r : Report) : CommandResult :=
    Right CommandError Report r;

def command_ok_message (message : String) : CommandResult :=
    command_ok (report_add "message" message report_empty);

def command_fail (e : CommandError) : CommandResult :=
    Left CommandError Report e;

def command_usage (program : String) (shape : String) : CommandResult :=
    command_fail (CommandUsage (cli_usage program shape));

def command_lift_fs (A : Type) (r : Either FsError A) : Either CommandError A :=
    match r with
    | Left e => Left CommandError A (CommandFs e)
    | Right x => Right CommandError A x
    end;

def command_lift_config (A : Type) (r : Either ConfigError A) : Either CommandError A :=
    match r with
    | Left e => Left CommandError A (CommandConfig e)
    | Right x => Right CommandError A x
    end;

def command_lift_process (A : Type) (r : Either ProcessError A) : Either CommandError A :=
    match r with
    | Left e => Left CommandError A (CommandProcess e)
    | Right x => Right CommandError A x
    end;

def command_lift_validation (v : Validation String Unit) : Either CommandError Unit :=
    match v with
    | Left errors => Left CommandError Unit (CommandValidation errors)
    | Right _ => Right CommandError Unit MkUnit
    end;

def command_report (ctx : CommandContext) (body : Report) : Report :=
    report_merge
      (report_add "program" (command_context_program ctx) report_empty)
      body;

def command_run_result (result : CommandResult) : IO Unit :=
    match result with
    | Right report =>
      do println (report_render report);
         exit 0
    | Left err =>
      do eprintln (command_error_message err);
         exit (command_exit_code err)
    end;
