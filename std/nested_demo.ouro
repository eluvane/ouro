-- Nested inductive demo for strict positivity under an inductive head.

inductive Nat : Type := | Z : Nat | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

inductive Tree : Type :=
  | leaf : Nat -> Tree
  | node : List Tree -> Tree;

def t0 : Tree := leaf Z;
def t1 : Tree := node ([t0] : List Tree);
