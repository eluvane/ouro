-- Thin wrappers over trusted runtime prims; semantic failures belong in runtime.ouro/docs/tcb.md.
-- Native IO/Unit lowering links the checked GC runtime through this import.

import "runtime.ouro";
import "../runtime/managed.ouro";

def io_unit : IO Unit := io_pure Unit MkUnit;

def print (s : String) : IO Unit := prim_stdout_write s;

def eprint (s : String) : IO Unit := prim_stderr_write s;

def println (s : String) : IO Unit :=
    do print (prim_string_concat s "\n");
       io_unit

def eprintln (s : String) : IO Unit :=
    do eprint (prim_string_concat s "\n");
       io_unit

def readLine : IO String := prim_stdin_read_line
def concat : String -> String -> String := prim_string_concat
def exit (n : Nat) : IO Unit := prim_exit n

def flush : IO Unit := prim_stdout_flush;

def argv : IO (List String) := prim_argv;

def env_get (k : String) : IO (Maybe String) := prim_env_get k;

def env_or (k : String) (fallback : String) : IO String :=
    do let! m := prim_env_get k;
       io_pure String (fromMaybe String fallback m)

def now : IO String := prim_time_now;

def proc_exec (cmd : String) (args : List String) : IO ProcResult :=
    prim_proc_exec cmd args;

def proc_code (r : ProcResult) : Nat :=
    match r with
    | MkProcResult c _ _ => c
    end;

def proc_stdout (r : ProcResult) : String :=
    match r with
    | MkProcResult _ out _ => out
    end;

def proc_stderr (r : ProcResult) : String :=
    match r with
    | MkProcResult _ _ err => err
    end;

def proc_ok (r : ProcResult) : Bool :=
    match proc_code r with
    | Z => True
    | S _ => False
    end;


def io_when (b : Bool) (act : IO Unit) : IO Unit :=
    match b with
    | True => act
    | False => io_unit
    end;

def io_unless (b : Bool) (act : IO Unit) : IO Unit :=
    io_when (notb b) act;

-- Structural walk over the list, so no fuel argument is needed.
def io_foreach (A : Type) (f : A -> IO Unit) : List A -> IO Unit :=
    fix io_foreach (xs : List A) : IO Unit :=
      match xs with
      | Nil => io_unit
      | Cons x rest => io_bind Unit Unit (f x) (fun (_ : Unit) => io_foreach rest)
      end;

def io_fold (A : Type) (B : Type) (f : B -> A -> IO B)
    (acc : B) (xs : List A) : IO B :=
  (fix go (ys : List A) (state : B) : IO B :=
    match ys with
    | Nil => io_pure B state
    | Cons x rest =>
        io_bind B B (f state x) (fun (next : B) => go rest next)
    end) xs acc;

-- Nat literals are Peano chains the extractor walks step by step, so a big
-- constant is written as a product of small ones.
def read_chunk : Nat := mul 64 64;

-- Reads until a short chunk shows end of input. Fuel bounds the total to
-- read_chunk * read_all_fuel bytes.
def read_all_fuel : Nat := mul (add 128 128) (add 128 128);

def read_all_go : Nat -> String -> IO String :=
  fix read_all_go (fuel : Nat) (acc : String) : IO String :=
    match fuel with
    | Z => io_pure String acc
    | S fuel2 =>
        io_bind String String (prim_stdin_read_bytes read_chunk)
          (fun (chunk : String) =>
            match prim_string_length chunk with
            | Z => io_pure String acc
            | S _ => read_all_go fuel2 (prim_string_concat acc chunk)
            end)
    end;

def read_all : IO String := read_all_go read_all_fuel "";
