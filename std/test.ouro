-- User-level test helpers. A test program prints one line per case and exits nonzero on failure.

import "io.ouro";
import "string.ouro";

inductive Test : Type :=
  | MkTest : String -> Bool -> String -> Test;

def test_ok (name : String) : Test :=
    MkTest name True "";

def test_fail (name : String) (reason : String) : Test :=
    MkTest name False reason;

def assert_true (name : String) (b : Bool) : Test :=
    match b with
    | True => test_ok name
    | False => test_fail name "expected true"
    end;

def assert_eq (name : String) (got : String) (want : String) : Test :=
    match str_eq got want with
    | True => test_ok name
    | False => test_fail name (str_cat4 "got " got " want " want)
    end;

def test_line (t : Test) : String :=
    match t with
    | MkTest name ok reason =>
        match ok with
        | True => str_concat "ok " name
        | False =>
            match str_null reason with
            | True => str_concat "FAIL " name
            | False => str_cat3 "FAIL " name (str_concat " " reason)
            end
        end
    end;

def test_failed (t : Test) : Bool :=
    match t with
    | MkTest _ ok _ => notb ok
    end;

def test_report (t : Test) : IO Unit :=
    println (test_line t);

def test_run (ts : List Test) : IO Unit :=
    do io_foreach Test test_report ts;
       match any Test test_failed ts with
       | True => exit 1
       | False => exit 0
       end
