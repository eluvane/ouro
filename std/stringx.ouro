-- Tool-facing string helpers keep ordering and splitting deterministic across hosts.

import "string.ouro";
import "format.ouro";

def str_take (s : String) (n : Nat) : String :=
    str_slice s Z (minNat n (str_len s));

def str_drop (s : String) (n : Nat) : String :=
    match ltb_nat n (str_len s) with
    | True => str_slice s n (sub (str_len s) n)
    | False => str_empty
    end;

def str_repeat (s : String) : Nat -> String :=
    fix str_repeat (n : Nat) : String :=
      match n with
      | Z => str_empty
      | S n2 => str_concat s (str_repeat n2)
      end;

-- Byte-lexicographic order: shorter is smaller on a shared prefix.
def codes_le : List Nat -> List Nat -> Bool :=
  fix codes_le (a : List Nat) (b : List Nat) : Bool :=
    match a with
    | Nil => True
    | Cons x xs =>
      match b with
      | Nil => False
      | Cons y ys =>
        match compareNat x y with
        | LT => True
        | GT => False
        | EQ => codes_le xs ys
        end
      end
    end;

def str_le (a : String) (b : String) : Bool :=
    prim_string_le a b;

def str_lt (a : String) (b : String) : Bool :=
    andb (str_le a b) (notb (str_eq a b));

-- Index of the first pat occurrence at or after i.
def str_index_from (s : String) (pat : String) (i : Nat) : Maybe Nat :=
    match str_index (str_drop s i) pat with
    | Nothing => Nothing Nat
    | Just j => Just Nat (add i j)
    end;

-- Split at the first separator only: "a=b=c" on "=" gives ("a", "b=c").
def str_split_first (s : String) (sep : String) : Maybe (Pair String String) :=
    match str_index s sep with
    | Nothing => Nothing (Pair String String)
    | Just i =>
      Just (Pair String String)
        (MkPair String String (str_take s i)
          (str_drop s (add i (str_len sep))))
    end;

def str_before (s : String) (pat : String) : String :=
    match str_split_first s pat with
    | Nothing => s
    | Just p => fst String String p
    end;

def str_after (s : String) (pat : String) : String :=
    match str_split_first s pat with
    | Nothing => str_empty
    | Just p => snd String String p
    end;

-- Split on a multi-character separator. An empty separator yields the whole
-- string, matching str_replace's treatment of an empty pattern.
def str_split_str_go : Nat -> String -> String -> List String :=
  fix str_split_str_go (fuel : Nat) (s : String) (sep : String)
      : List String :=
    match fuel with
    | Z => ([ s ] : List String)
    | S fuel2 =>
      match str_split_first s sep with
      | Nothing => ([ s ] : List String)
      | Just p =>
        match p with
        | MkPair head rest =>
          Cons String head (str_split_str_go fuel2 rest sep)
        end
      end
    end;

def str_split_str (s : String) (sep : String) : List String :=
    match str_null sep with
    | True => ([ s ] : List String)
    | False => str_split_str_go (S (str_len s)) s sep
    end;

def str_strip_prefix (s : String) (pre : String) : Maybe String :=
    match str_starts s pre with
    | True => Just String (str_drop s (str_len pre))
    | False => Nothing String
    end;

def str_strip_suffix (s : String) (suf : String) : Maybe String :=
    match str_ends s suf with
    | True => Just String (str_take s (sub (str_len s) (str_len suf)))
    | False => Nothing String
    end;

def str_unlines (ls : List String) : String :=
    str_join "\n" ls;

def str_unwords (ws : List String) : String :=
    str_join " " ws;

def str_indent (n : Nat) (s : String) : String :=
    str_concat (str_repeat " " n) s;

def str_indent_lines (n : Nat) (s : String) : String :=
    str_unlines (map String String (str_indent n) (str_lines s));

-- Sorted, duplicate-free string list; used wherever tool output has to be
-- reproducible.
def str_sort (xs : List String) : List String :=
    sort_insert String str_le xs;

def str_sort_uniq (xs : List String) : List String :=
    nub String str_eq (str_sort xs);
