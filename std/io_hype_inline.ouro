-- Hype-surface demo: residual perform without a handler must still compile-fail.

import "io.ouro";

-- @entry main
-- Distinct family and operation names so the semantic declaration index is
-- strictly ordered. The compact `effect AskName : String` form interned the
-- same name twice and rejected the unit as ambiguous.
effect Ask where
  | AskName : String

def main : IO Unit :=
  handle
    do let! name := perform AskName;
        println (concat "hello " name);
        exit 0
  with
  | AskName k => k "Ouro"
  end
