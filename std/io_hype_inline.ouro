-- One-shot handler for a name request. An unhandled `perform` fails compilation.

import "io.ouro";

-- @entry main
-- The family and operation have distinct names to avoid a duplicate entry
-- in the declaration index.
effect Ask where
  | AskName : String

def main : IO Unit :=
  handle
    do let! name := perform AskName;
        println (concat "hello " name);
        exit 0
  with
  | AskName k => k "Ouro"
  end
