-- Current Windows image path, with explicit query and ownership failures.
-- Loaded spelling is preserved; this does not attest image identity or hashes.
import "io.ouro",
  "executable_model.ouro",
  "../runtime/platform/windows_executable.ouro";

-- Query the fully qualified current Windows image path as UTF-8 when run.
-- Preserve loaded spelling; truncation, conversion and cleanup failures are typed.
-- This path does not establish file identity or executable byte integrity.
def executable_path_checked : IO (Either ExecutablePathError String) :=
    windows_executable_path_checked;
