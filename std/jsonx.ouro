-- Practical JSON object/array getters and schema-lite decoders.

import "collections.ouro";
import "json.ouro";
import "text.ouro";

def jsonx_null : Json := JNull;

def jsonx_bool (b : Bool) : Json := JBool b;

def jsonx_num_string (n : String) : Json := JNum n;

def jsonx_num_nat (n : Nat) : Json := JNum (str_of_nat n);

def jsonx_string (s : String) : Json := JStr s;

def jsonx_array (xs : List Json) : Json := JArr xs;

def jsonx_object (xs : List (Pair String Json)) : Json := JObj xs;

def jsonx_as_string (j : Json) : Maybe String :=
    match j with
    | JStr s => Just String s
    | JNull => Nothing String
    | JBool _ => Nothing String
    | JNum _ => Nothing String
    | JArr _ => Nothing String
    | JObj _ => Nothing String
    end;

def jsonx_as_nat (j : Json) : Maybe Nat :=
    match j with
    | JNum s => str_parse_nat s
    | JNull => Nothing Nat
    | JBool _ => Nothing Nat
    | JStr _ => Nothing Nat
    | JArr _ => Nothing Nat
    | JObj _ => Nothing Nat
    end;

def jsonx_as_bool (j : Json) : Maybe Bool :=
    match j with
    | JBool b => Just Bool b
    | JNull => Nothing Bool
    | JNum _ => Nothing Bool
    | JStr _ => Nothing Bool
    | JArr _ => Nothing Bool
    | JObj _ => Nothing Bool
    end;

def jsonx_as_array (j : Json) : Maybe (List Json) :=
    match j with
    | JArr xs => Just (List Json) xs
    | JNull => Nothing (List Json)
    | JBool _ => Nothing (List Json)
    | JNum _ => Nothing (List Json)
    | JStr _ => Nothing (List Json)
    | JObj _ => Nothing (List Json)
    end;

def jsonx_as_object (j : Json) : Maybe (List (Pair String Json)) :=
    match j with
    | JObj xs => Just (List (Pair String Json)) xs
    | JNull => Nothing (List (Pair String Json))
    | JBool _ => Nothing (List (Pair String Json))
    | JNum _ => Nothing (List (Pair String Json))
    | JStr _ => Nothing (List (Pair String Json))
    | JArr _ => Nothing (List (Pair String Json))
    end;

def jsonx_obj_get_pairs (key : String) : List (Pair String Json) -> Maybe Json :=
    fix jsonx_obj_get_pairs (pairs : List (Pair String Json)) : Maybe Json :=
      match pairs with
      | Nil => Nothing Json
      | Cons p rest =>
        match p with
        | MkPair k v =>
          match str_eq k key with
          | True => Just Json v
          | False => jsonx_obj_get_pairs rest
          end
        end
      end;

def jsonx_get (j : Json) (key : String) : Maybe Json :=
    match j with
    | JObj pairs => jsonx_obj_get_pairs key pairs
    | JNull => Nothing Json
    | JBool _ => Nothing Json
    | JNum _ => Nothing Json
    | JStr _ => Nothing Json
    | JArr _ => Nothing Json
    end;

def jsonx_get_string (j : Json) (key : String) : Maybe String :=
    match jsonx_get j key with
    | Nothing => Nothing String
    | Just value => jsonx_as_string value
    end;

def jsonx_get_nat (j : Json) (key : String) : Maybe Nat :=
    match jsonx_get j key with
    | Nothing => Nothing Nat
    | Just value => jsonx_as_nat value
    end;

def jsonx_get_bool (j : Json) (key : String) : Maybe Bool :=
    match jsonx_get j key with
    | Nothing => Nothing Bool
    | Just value => jsonx_as_bool value
    end;

def jsonx_get_array (j : Json) (key : String) : Maybe (List Json) :=
    match jsonx_get j key with
    | Nothing => Nothing (List Json)
    | Just value => jsonx_as_array value
    end;

def jsonx_get_object (j : Json) (key : String) : Maybe (List (Pair String Json)) :=
    match jsonx_get j key with
    | Nothing => Nothing (List (Pair String Json))
    | Just value => jsonx_as_object value
    end;

def jsonx_array_at (j : Json) (index : Nat) : Maybe Json :=
    match j with
    | JArr xs => nth_maybe Json index xs
    | JNull => Nothing Json
    | JBool _ => Nothing Json
    | JNum _ => Nothing Json
    | JStr _ => Nothing Json
    | JObj _ => Nothing Json
    end;

def jsonx_path (j : Json) (path : List String) : Maybe Json :=
  (fix go (parts : List String) (current : Json) : Maybe Json :=
    match parts with
    | Nil => Just Json current
    | Cons key rest =>
      match jsonx_get current key with
      | Nothing => Nothing Json
      | Just next => go rest next
      end
    end) path j;

def jsonx_path_string (j : Json) (path : List String) : Maybe String :=
    match jsonx_path j path with
    | Nothing => Nothing String
    | Just value => jsonx_as_string value
    end;

def jsonx_path_bool (j : Json) (path : List String) : Maybe Bool :=
    match jsonx_path j path with
    | Nothing => Nothing Bool
    | Just value => jsonx_as_bool value
    end;

def jsonx_path_nat (j : Json) (path : List String) : Maybe Nat :=
    match jsonx_path j path with
    | Nothing => Nothing Nat
    | Just value => jsonx_as_nat value
    end;

def jsonx_object_keys (j : Json) : List String :=
    match j with
    | JObj pairs => map (Pair String Json) String (fun (p : Pair String Json) => fst String Json p) pairs
    | JNull => Nil String
    | JBool _ => Nil String
    | JNum _ => Nil String
    | JStr _ => Nil String
    | JArr _ => Nil String
    end;

def jsonx_string_pair (p : Pair String String) : Pair String Json :=
    match p with
    | MkPair key value => MkPair String Json key (JStr value)
    end;

def jsonx_object_from_strings (pairs : List (Pair String String)) : Json :=
    JObj (map (Pair String String) (Pair String Json) jsonx_string_pair pairs);

def jsonx_parse_or_null (text : String) : Json :=
    fromMaybe Json JNull (parse_json text);

def jsonx_render (j : Json) : String := json_print j;
