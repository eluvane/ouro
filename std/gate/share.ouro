-- Share gate arithmetic is pure so shell and CI wrappers cannot disagree about thresholds.

import "../pathx.ouro";
import "../parse.ouro";
import "../format.ouro";
import "../csv.ouro";

inductive CodeBucket : Type :=
  | BkOuro : CodeBucket
  | BkJsGenerated : CodeBucket
  | BkJsHost : CodeBucket
  | BkOcamlKernel : CodeBucket
  | BkOcamlRest : CodeBucket
  | BkShellPy : CodeBucket
  | BkSkip : CodeBucket;

def ext_of (path : String) : String :=
    path_ext path;

def is_ouro_ext (path : String) : Bool :=
    str_eq (ext_of path) ".ouro";

def is_js_ext (path : String) : Bool :=
    str_eq (ext_of path) ".js";

def is_ml_ext (path : String) : Bool :=
    orb (str_eq (ext_of path) ".ml") (str_eq (ext_of path) ".mli");

def is_sh_ext (path : String) : Bool :=
    str_eq (ext_of path) ".sh";

def is_py_ext (path : String) : Bool :=
    str_eq (ext_of path) ".py";

def is_code_ext (path : String) : Bool :=
    orb (is_ouro_ext path)
      (orb (is_js_ext path)
        (orb (is_ml_ext path)
          (orb (is_sh_ext path) (is_py_ext path))));

def bucket_of (path : String) : CodeBucket :=
    match path_skip_build path with
    | True => BkSkip
    | False =>
      match is_code_ext path with
      | False => BkSkip
      | True =>
        match is_ouro_ext path with
        | True => BkOuro
        | False =>
          match path_under "compiler/stage0/" path with
          | True => BkJsGenerated
          | False =>
            match is_js_ext path with
            | True => BkJsHost
            | False =>
              match path_under "lib/kernel/" path with
              | True => BkOcamlKernel
              | False =>
                match is_ml_ext path with
                | True => BkOcamlRest
                | False => BkShellPy
                end
              end
            end
          end
        end
      end
    end;

def bucket_name (b : CodeBucket) : String :=
    match b with
    | BkOuro => "ouro"
    | BkJsGenerated => "js_generated_stage0"
    | BkJsHost => "js_host"
    | BkOcamlKernel => "ocaml_kernel_tcb"
    | BkOcamlRest => "ocaml_rest"
    | BkShellPy => "shell_py"
    | BkSkip => "skip"
    end;

inductive ShareAcc : Type :=
  | MkShare : Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> ShareAcc;

def share_zero : ShareAcc :=
    MkShare Z Z Z Z Z Z Z;

def share_add (a : ShareAcc) (b : CodeBucket) (n : Nat) : ShareAcc :=
    match a with
    | MkShare ouro jsgen jshost kern rest shpy files =>
      match b with
      | BkOuro => MkShare (add ouro n) jsgen jshost kern rest shpy (S files)
      | BkJsGenerated => MkShare ouro (add jsgen n) jshost kern rest shpy (S files)
      | BkJsHost => MkShare ouro jsgen (add jshost n) kern rest shpy (S files)
      | BkOcamlKernel => MkShare ouro jsgen jshost (add kern n) rest shpy (S files)
      | BkOcamlRest => MkShare ouro jsgen jshost kern (add rest n) shpy (S files)
      | BkShellPy => MkShare ouro jsgen jshost kern rest (add shpy n) (S files)
      | BkSkip => a
      end
    end;

def share_total (a : ShareAcc) : Nat :=
    match a with
    | MkShare ouro jsgen jshost kern rest shpy _ =>
      add ouro (add jsgen (add jshost (add kern (add rest shpy))))
    end;

def share_ouro (a : ShareAcc) : Nat :=
    match a with
    | MkShare ouro _ _ _ _ _ _ => ouro
    end;

def share_non_ouro (a : ShareAcc) : Nat :=
    sub (share_total a) (share_ouro a);

-- ouro * 1000 / total, tenths of a percent. 10*10*10 avoids a 1000 numeral.
def share_tenths (ouro : Nat) (total : Nat) : Nat :=
    match total with
    | Z => Z
    | S _ => div_nat (mul ouro (mul 10 (mul 10 10))) total
    end;

-- 98.0 percent = 980 tenths. Also ouro >= 49 * non_ouro.
def share_floor_49x_tenths : Nat := 980;

def times_49 (n : Nat) : Nat :=
    add (mul n 32) (add (mul n 16) n);

def meets_49x (ouro : Nat) (non : Nat) : Bool :=
    leb_nat (times_49 non) ouro;

def meets_floor (ouro : Nat) (total : Nat) (floor_tenths : Nat) : Bool :=
    leb_nat floor_tenths (share_tenths ouro total);

def share_pass (a : ShareAcc) (floor_tenths : Nat) : Bool :=
    let ouro : Nat := share_ouro a in
    let total : Nat := share_total a in
    andb (meets_floor ouro total floor_tenths)
      (meets_49x ouro (share_non_ouro a));

def classify_one (path : String) (bytes : Nat) (a : ShareAcc) : ShareAcc :=
    share_add a (bucket_of path) bytes;

-- Fold a pre-parsed path|bytes table (one "path|n" line per file).
def classify_table (table : String) : ShareAcc :=
    (fix go (rows : List (List String)) (acc : ShareAcc) : ShareAcc :=
      match rows with
      | Nil => acc
      | Cons r rest =>
        match r with
        | Cons path rest2 =>
          match rest2 with
          | Cons nstr _ =>
            match parse_nat nstr with
            | Nothing => go rest acc
            | Just n => go rest (classify_one path n acc)
            end
          | Nil => go rest acc
          end
        | Nil => go rest acc
        end
      end) (pipe_parse table) share_zero;

def share_report (a : ShareAcc) : String :=
    match a with
    | MkShare ouro jsgen jshost kern rest shpy files =>
      unlines
        ([kv_line "ouro" (show_nat ouro), kv_line "js_generated_stage0" (show_nat jsgen), kv_line "js_host" (show_nat jshost), kv_line "ocaml_kernel_tcb" (show_nat kern), kv_line "ocaml_rest" (show_nat rest), kv_line "shell_py" (show_nat shpy), kv_line "files" (show_nat files), kv_line "total" (show_nat (share_total a)), kv_line "tenths" (show_nat (share_tenths ouro (share_total a)))])
    end;
