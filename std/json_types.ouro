-- JSON value constructors. Import this module to use values without the parser
-- or printer in `std/json.ouro`.
import "string_prims.ouro";

inductive Json : Type :=
  | JNull : Json
  | JBool : Bool -> Json
  | JNum : String -> Json
  | JStr : String -> Json
  | JArr : List Json -> Json
  | JObj : List (Pair String Json) -> Json;
