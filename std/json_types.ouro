-- JSON value constructors only. The parser/printer cone stays in json.ouro
-- so keep-importing the type does not harvest the 594-line implementation.
import "string_prims.ouro";

inductive Json : Type :=
  | JNull : Json
  | JBool : Bool -> Json
  | JNum : String -> Json
  | JStr : String -> Json
  | JArr : List Json -> Json
  | JObj : List (Pair String Json) -> Json;
