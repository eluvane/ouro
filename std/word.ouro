-- Word32 bit ops. Standalone emit binds the same names through ouro_fast.
-- The bodies also run in tools emitted without these bindings.

import "natx.ouro";

def n32 : Nat := mul 16 2;

private def word32_modulus : Nat := pow_nat 2 n32;

-- Visit the bits from highest to lowest so each operand loses a set bit
-- with one subtraction. After each step the remainder is below that weight.
private def word32_weights : List Nat :=
    (fix go (fuel : Nat) (weight : Nat) (weights : List Nat) : List Nat :=
      match fuel with
      | Z => weights
      | S rest => go rest (add weight weight) (Cons Nat weight weights)
      end) n32 1 (Nil Nat);

private def word32_bitwise (keep : Bool -> Bool -> Bool) (a : Nat) (b : Nat) : Nat :=
    (fix go (weights : List Nat) (x : Nat) (y : Nat) (acc : Nat) : Nat :=
      match weights with
      | Nil => acc
      | Cons weight rest =>
          let x_set : Bool := geb_nat x weight in
          let y_set : Bool := geb_nat y weight in
          go rest (if x_set then sub x weight else x)
            (if y_set then sub y weight else y)
            (if keep x_set y_set then add acc weight else acc)
      end) word32_weights (mod_nat a word32_modulus) (mod_nat b word32_modulus) Z;

def xor32 : Nat -> Nat -> Nat :=
  fun (a : Nat) (b : Nat) =>
    word32_bitwise (fun (x : Bool) (y : Bool) => if x then notb y else y) a b;

def and32 : Nat -> Nat -> Nat :=
  fun (a : Nat) (b : Nat) => word32_bitwise andb a b;

def or32 : Nat -> Nat -> Nat :=
  fun (a : Nat) (b : Nat) => word32_bitwise orb a b;

def add32 : Nat -> Nat -> Nat :=
  fun (a : Nat) (b : Nat) => mod_nat (add a b) word32_modulus;

def shl32 : Nat -> Nat -> Nat :=
  fun (a : Nat) (k : Nat) =>
    let n : Nat := mod_nat k n32 in
    match n with
    | Z => a
    | S _ => mod_nat (mul a (pow_nat 2 n)) word32_modulus
    end;

def shr32 : Nat -> Nat -> Nat :=
  fun (a : Nat) (k : Nat) =>
    let n : Nat := mod_nat k n32 in
    match n with
    | Z => a
    | S _ => div_nat a (pow_nat 2 n)
    end;

def rotr32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (k : Nat) =>
      let n : Nat := mod_nat k n32 in
      or32(shr32 a n, shl32(a, sub n32 n));

def not32 (n : Nat) : Nat :=
  sub (sub word32_modulus 1) (mod_nat n word32_modulus);

def w32_mask8 : Nat := 255;

def w32_of_bytes (a : Nat) (b : Nat) (c : Nat) (d : Nat) : Nat :=
    or32 (shl32(and32 a w32_mask8, 24))
      (or32 (shl32(and32 b w32_mask8, 16))
        (or32(shl32(and32 c w32_mask8, 8), and32 d w32_mask8)));

def w32_b0 (w : Nat) : Nat := and32(shr32 w 24, w32_mask8);
def w32_b1 (w : Nat) : Nat := and32(shr32 w 16, w32_mask8);
def w32_b2 (w : Nat) : Nat := and32(shr32 w 8, w32_mask8);
def w32_b3 (w : Nat) : Nat := and32 w w32_mask8;
