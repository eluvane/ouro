-- Word32 bit ops. Standalone emit binds the same names through ouro_fast.
-- Bodies below are total Peano fallbacks for check; they are not the
-- execution path for SHA-256. Not a kernel change.

import "natx.ouro";

def n32 : Nat := mul 16 2;

def xor32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (b : Nat) =>
    (fix go (fuel : Nat) (x : Nat) (y : Nat) (bit : Nat) (acc : Nat) : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        let xb : Nat := mod_nat x 2 in
        let yb : Nat := mod_nat y 2 in
        let bitv : Nat :=
          match eq_nat xb yb with
          | True => Z
          | False => bit
          end in
        go(fuel2, div_nat x 2, div_nat y 2, mul bit 2, add acc bitv)
      end) n32 a b 1 Z;

def and32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (b : Nat) =>
    (fix go (fuel : Nat) (x : Nat) (y : Nat) (bit : Nat) (acc : Nat) : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        let keep : Nat :=
          match andb(eq_nat(mod_nat x 2, 1), eq_nat(mod_nat y 2, 1)) with
          | True => bit
          | False => Z
          end in
        go(fuel2, div_nat x 2, div_nat y 2, mul bit 2, add acc keep)
      end) n32 a b 1 Z;

def or32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (b : Nat) =>
    (fix go (fuel : Nat) (x : Nat) (y : Nat) (bit : Nat) (acc : Nat) : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        let keep : Nat :=
          match orb(eq_nat(mod_nat x 2, 1), eq_nat(mod_nat y 2, 1)) with
          | True => bit
          | False => Z
          end in
        go(fuel2, div_nat x 2, div_nat y 2, mul bit 2, add acc keep)
      end) n32 a b 1 Z;

def add32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (b : Nat) =>
    (fix go (fuel : Nat) (x : Nat) (y : Nat) (carry : Nat) (bit : Nat) (acc : Nat)
        : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        let s : Nat := add(add(mod_nat x 2, mod_nat y 2), carry) in
        let keep : Nat :=
          match eq_nat(mod_nat s 2, 1) with
          | True => bit
          | False => Z
          end in
        go fuel2 (div_nat x 2) (div_nat y 2) (div_nat s 2) (mul bit 2)
          (add acc keep)
      end) n32 a b Z 1 Z;

def shl32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (k : Nat) =>
    (fix go (fuel : Nat) (x : Nat) : Nat :=
      match fuel with
      | Z => x
      | S fuel2 =>
        add32 x x |> go fuel2
      end) (mod_nat k n32) a;

def shr32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (k : Nat) =>
    (fix go (fuel : Nat) (x : Nat) : Nat :=
      match fuel with
      | Z => x
      | S fuel2 =>
        div_nat x 2 |> go fuel2
      end) (mod_nat k n32) a;

def rotr32 : Nat -> Nat -> Nat :=
  fun (a : Nat) =>
    fun (k : Nat) =>
      let n : Nat := mod_nat k n32 in
      or32(shr32 a n, shl32(a, sub n32 n));

def not32 (n : Nat) : Nat :=
  xor32(n, or32(shl32 1 31, sub(shl32 1 31, 1)));

def w32_mask8 : Nat := 255;

def w32_of_bytes (a : Nat) (b : Nat) (c : Nat) (d : Nat) : Nat :=
    or32 (shl32(and32 a w32_mask8, 24))
      (or32 (shl32(and32 b w32_mask8, 16))
        (or32(shl32(and32 c w32_mask8, 8), and32 d w32_mask8)));

def w32_b0 (w : Nat) : Nat := and32(shr32 w 24, w32_mask8);
def w32_b1 (w : Nat) : Nat := and32(shr32 w 16, w32_mask8);
def w32_b2 (w : Nat) : Nat := and32(shr32 w 8, w32_mask8);
def w32_b3 (w : Nat) : Nat := and32 w w32_mask8;
