-- Mutually dependent even/odd evidence encoded as one indexed family.

inductive Parity : Type := | EvenTag : Parity | OddTag : Parity;

inductive ParityEvidence : Parity -> Type :=
  | EvenZero : ParityEvidence EvenTag
  | EvenSucc : ParityEvidence OddTag -> ParityEvidence EvenTag
  | OddSucc : ParityEvidence EvenTag -> ParityEvidence OddTag;

def Even : Type := ParityEvidence EvenTag;
def Odd : Type := ParityEvidence OddTag;

def even0 : Even := EvenZero;
def odd1 : Odd := OddSucc even0;
def even2 : Even := EvenSucc odd1;
