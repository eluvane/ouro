-- Finite Nat ranges as bounded pull sources.

import "iter.ouro", "natx.ouro";

inductive NatRangeBound : Type :=
  | RangeExclusive : NatRangeBound
  | RangeInclusive : NatRangeBound;

representation NatRangeBound := "ouro.range-bound";

inductive NatRange : Type :=
  | MkNatRange : Nat -> Nat -> Nat -> NatRangeBound -> NatRange;

representation NatRange := "ouro.range";

inductive NatRangeError : Type :=
  | RangeZeroStep : NatRangeError;

inductive NatRangeCursor : Type :=
  | MkNatRangeCursor : NatRange -> Maybe Nat -> NatRangeCursor;

def nat_range_exclusive (start : Nat) (stop : Nat) : NatRange :=
    MkNatRange start stop 1 RangeExclusive;

def nat_range_inclusive (start : Nat) (stop : Nat) : NatRange :=
    MkNatRange start stop 1 RangeInclusive;

def nat_range_by (step : Nat) (range : NatRange)
    : Either NatRangeError NatRange :=
    match step with
    | Z => Left NatRangeError NatRange RangeZeroStep
    | S _ =>
        match range with
        | MkNatRange start stop _ bound =>
            Right NatRangeError NatRange
              (MkNatRange start stop step bound)
        end
    end;

def nat_range_at_stop (bound : NatRangeBound) : Bool :=
    match bound with
    | RangeExclusive => False
    | RangeInclusive => True
    end;

def nat_range_in_bounds (range : NatRange) (current : Nat) : Bool :=
    match range with
    | MkNatRange start stop _ bound =>
        match compareNat start stop with
        | LT =>
            andb (geb_nat current start)
              (match compareNat current stop with
               | LT => True
               | EQ => nat_range_at_stop bound
               | GT => False
               end)
        | GT =>
            andb (leb_nat current start)
              (match compareNat current stop with
               | LT => False
               | EQ => nat_range_at_stop bound
               | GT => True
               end)
        | EQ => andb (eq_nat current start) (nat_range_at_stop bound)
        end
    end;

-- Compare the step with the remaining distance before subtracting.
-- This prevents Nat's saturating subtraction from creating a false zero item.
def nat_range_next (range : NatRange) (current : Nat) : Maybe Nat :=
    match range with
    | MkNatRange start stop step _ =>
        match compareNat start stop with
        | LT =>
            match leb_nat step (sub stop current) with
            | True => Just Nat (add current step)
            | False => Nothing Nat
            end
        | GT =>
            match leb_nat step (sub current stop) with
            | True => Just Nat (sub current step)
            | False => Nothing Nat
            end
        | EQ => Nothing Nat
        end
    end;

def nat_range_pull (cursor : NatRangeCursor)
    : IterStep NatRangeCursor NatRangeError Nat :=
    match cursor with
    | MkNatRangeCursor range position =>
        match range with
        | MkNatRange _ _ step _ =>
            match step with
            | Z => IterFail NatRangeCursor NatRangeError Nat RangeZeroStep
            | S _ =>
                match position with
                | Nothing => IterDone NatRangeCursor NatRangeError Nat
                | Just current =>
                    match nat_range_in_bounds range current with
                    | False => IterDone NatRangeCursor NatRangeError Nat
                    | True =>
                        IterYield NatRangeCursor NatRangeError Nat current
                          (MkNatRangeCursor range
                            (nat_range_next range current))
                    end
                end
            end
        end
    end;

def iter_from_nat_range (range : NatRange)
    : Either NatRangeError
        (Iterator NatRangeCursor NatRangeError Nat) :=
    match range with
    | MkNatRange start _ step _ =>
        match step with
        | Z =>
            Left NatRangeError (Iterator NatRangeCursor NatRangeError Nat)
              RangeZeroStep
        | S _ =>
            Right NatRangeError (Iterator NatRangeCursor NatRangeError Nat)
              (MkIterator NatRangeCursor NatRangeError Nat
                (MkNatRangeCursor range (Just Nat start)) nat_range_pull)
        end
    end;
