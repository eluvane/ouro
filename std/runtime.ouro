-- Runtime surface: checked String identities and composable Runtime actions.
-- Streams, exit, startup, clock and binary files have checked native adapters.

import "data.ouro",
  "string_prims.ouro",
  "../runtime/native_types.ouro",
  "../runtime/platform/windows_stderr.ouro",
  "../runtime/platform/windows_startup.ouro",
  "../runtime/platform/windows_text.ouro",
  "../runtime/platform/windows_clock.ouro",
  "../runtime/platform/windows_stdin.ouro",
  "../runtime/platform/windows_file_managed.ouro",
  "../runtime/platform/windows_fs_copy.ouro",
  "../runtime/platform/windows_directory_managed.ouro",
  "../runtime/platform/windows_realpath.ouro",
  "../runtime/platform/windows_temp.ouro",
  "../runtime/platform/windows_process_managed.ouro",
  "../runtime/platform/windows_process_inherit.ouro",
  "../runtime/platform/windows_process_bounded.ouro";

-- Linear, non-recursive JSON string decode from an opening quote. The Nat is
-- the first byte after the closing quote, or the failure position.
axiom prim_json_string_parse : String -> Nat -> Pair (Maybe String) Nat;

inductive ProcResult : Type :=
  | MkProcResult : Nat -> String -> String -> ProcResult;

-- IO and raw system actions share one checked effect constructor.
def IO (A : Type) : Type := Runtime A;
def io_pure (A : Type) (value : A) : IO A := runtime_pure A value;
def io_bind (A : Type) (B : Type) (action : IO A) (next : A -> IO B) : IO B :=
    runtime_bind A B action next;

intrinsic prim_stdout_write : String -> IO Unit := "ouro.runtime.stdout.write";
intrinsic prim_stderr_write : String -> IO Unit := "ouro.runtime.stderr.write";
-- Native line input consumes at most 8191 bytes, removes LF and preserves CR.
intrinsic prim_stdin_read_line : IO String := "ouro.runtime.stdin.read_line";
-- Reads at most n bytes; a short result means end of input.
-- Native input preserves NUL and runs only when the action is invoked.
-- Conversion, allocation, read and cleanup failures terminate with status 73.
intrinsic prim_stdin_read_bytes : Nat -> IO String := "ouro.runtime.stdin.read_bytes";
intrinsic prim_stdout_flush : IO Unit := "ouro.runtime.stdout.flush";
intrinsic prim_exit : Nat -> IO Unit := "ouro.runtime.exit";
-- Native argv retains argv[0] and empty arguments as strict UTF-8 strings.
intrinsic prim_argv : IO (List String) := "ouro.runtime.argv";
-- A missing variable or empty name returns Nothing; an empty value is Just "".
-- Native lookup rejects NUL in a name, malformed Unicode and size changes
-- between the sizing call and read with the standard host failure exit 73.
intrinsic prim_env_get : String -> IO (Maybe String) := "ouro.runtime.env_get";
-- Native files preserve all content bytes. Invalid paths and failed IO exit 73.
intrinsic prim_fs_read_file : String -> IO String := "ouro.fs.read_file";
intrinsic prim_fs_write_file : String -> String -> IO Unit := "ouro.fs.write_file";
-- Native predicates query current Win32 attributes when the action runs.
-- Missing/ordinary query errors return False; invalid encoding and cleanup exit 73.
intrinsic prim_fs_exists : String -> IO Bool := "ouro.fs.exists";
intrinsic prim_fs_is_dir : String -> IO Bool := "ouro.fs.is_dir";
intrinsic prim_fs_list_dir : String -> IO (List String) := "ouro.fs.list_dir";
intrinsic prim_fs_listable : String -> IO Bool := "ouro.fs.listable";
-- No-follow kind: 0 missing/error, 1 regular file, 2 directory,
-- 3 symlink/reparse/other.
-- Native paths are strict UTF-8; invalid path storage/encoding and cleanup fail with 73.
intrinsic prim_fs_kind : String -> IO Nat := "ouro.fs.kind";
-- Realpath follows links and returns normalized UTF-8 on each action execution.
-- Empty paths and OS unavailability return empty. Native malformed text, raw
-- allocation, incomplete conversion/fill and cleanup failures exit 73.
intrinsic prim_fs_realpath : String -> IO String := "ouro.fs.realpath";
-- Directory create (parents included) and non-recursive path removal.
-- Unit does not confirm the postcondition; use checked filesystem wrappers.
-- Native paths use strict UTF-8. Empty paths do nothing; invalid parameters,
-- encoding, raw allocation and cleanup failures exit 73. Other OS errors return Unit.
intrinsic prim_fs_mkdir : String -> IO Unit := "ouro.fs.mkdir";
intrinsic prim_fs_remove : String -> IO Unit := "ouro.fs.remove";
-- Creates a private, unique empty file; caller owns removal. Empty = failure.
intrinsic prim_fs_temp_file : IO String := "ouro.fs.temp_file";
-- Same contract in an existing caller-authorized directory.
intrinsic prim_fs_temp_file_in : String -> IO String := "ouro.fs.temp_file_in";
-- Native copy uses strict UTF-8 paths and overwrites through CopyFileW.
-- Invalid paths, failed copies and raw cleanup failures exit 73.
intrinsic prim_fs_copy_file : String -> String -> IO Unit := "ouro.fs.copy_file";
-- Same-volume replacement: zero means success; nonzero is the OS error.
-- Failure keeps the source and destination. No cross-volume copy is attempted.
intrinsic prim_fs_rename : String -> String -> IO Nat := "ouro.fs.rename";
-- Capture keeps binary stdout/stderr separate and launches the explicit argv.
intrinsic prim_process_capture : String -> List String -> IO (Pair Nat (Pair String String))
    := "ouro.process.capture";

-- The pair is (OS error, child exit); OS error zero denotes a completed wait.
intrinsic prim_process_inherit : String -> List String -> IO (Pair Nat Nat)
    := "ouro.process.inherit";

-- Limits: timeout ms, memory MiB, CPU count, stdout bytes, stderr bytes.
-- Reply: kind, detail, measured peak Job commit bytes, exact byte streams.
intrinsic prim_process_capture_bounded : String -> List String ->
    Pair String (Pair Nat (Pair Nat (Pair Nat (Pair Nat Nat)))) ->
    IO (Pair Nat (Pair Nat (Pair Nat (Pair String String)))) := "ouro.process.capture_bounded";

def prim_proc_exec (command : String) (arguments : List String) : IO ProcResult :=
    io_bind (Pair(Nat, Pair String String)) ProcResult
      (prim_process_capture command arguments)
      (fun (result : Pair Nat (Pair String String)) =>
        match result with | MkPair status streams =>
          match streams with | MkPair output error =>
            io_pure(ProcResult, MkProcResult status output error)
          end
        end);
-- UTC Unix-epoch milliseconds, rounded down and rendered as decimal.
-- Reading occurs when the action runs; native platform failures exit 73.
intrinsic prim_time_now : IO String := "ouro.time.now";
