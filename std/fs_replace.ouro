-- Source replacement returns the OS verdict, including partial failure codes.
-- Callers own distinct source/stage/empty-backup ordinary files on one volume
-- and must verify the resulting files before deleting the recovery file.
import "fs.ouro",
  "natx.ouro",
  "string_prims.ouro",
  "../runtime/platform/windows_fs_replace.ouro";

-- Separate from std/runtime so the compiler's closed primitive catalog can
-- bootstrap before a consumer declares this newly added operation.
intrinsic prim_fs_replace_file : String -> String -> String -> IO Nat := "ouro.fs.replace_file";

inductive FsReplaceResult : Type :=
  | FsReplaced : FsReplaceResult
  | FsReplaceFailed : Nat -> FsReplaceResult;

def fs_replace_file (source : String) (stage : String) (backup : String) : IO FsReplaceResult :=
    match orb (eq_nat(prim_string_length source, 0))
          (orb (eq_nat(prim_string_length stage, 0))
               (eq_nat(prim_string_length backup, 0))) with
    | True => io_pure(FsReplaceResult, FsReplaceFailed 87)
    | False => do let! status := prim_fs_replace_file source stage backup;
        io_pure FsReplaceResult (match eq_nat status 0 with
          | True => FsReplaced | False => FsReplaceFailed status end)
    end
