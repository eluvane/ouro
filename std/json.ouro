-- Parse and print JSON. Prefixed helper names reduce collisions in plain imports.

import "char.ouro",
  "listx.ouro",
  "string_prims.ouro",
  "json_types.ouro",
  "utf8_scalar.ouro";

inductive ParseR : Type :=
  | POk : Json -> Nat -> ParseR
  | PErr : Nat -> ParseR;

inductive ParseHead : Type :=
  | PHReady : ParseR -> ParseHead
  | PHArray : Nat -> ParseHead
  | PHObject : Nat -> ParseHead
  | PHError : Nat -> ParseHead;

def eqNat (n : Nat) (m : Nat) : Bool :=
    eq_nat n m;

def lebNat (n : Nat) (m : Nat) : Bool :=
    leb_nat n m;

-- Host byte lookup is constant time on a compact string.  parse_json compacts
-- once before walking, instead of restarting from a linked-list head for every
-- indexed byte. Arithmetic increments keep offsets compact across repeated reads.
-- Each read of an offset built with S must walk its constructor chain.
def json_ch_at (s : String) (i : Nat) : Nat := prim_string_byte_at s i;

def skip_ws : Nat -> String -> Nat -> Nat :=
  fix skip_ws (fuel : Nat) (s : String) (i : Nat) : Nat :=
    match fuel with
    | Z => i
    | S fuel' =>
        let c : Nat := json_ch_at s i in
        match is_ws c with
        | True => skip_ws fuel' s (add 1 i)
        | False => i
        end
    end;

def starts_with_at (s : String) (i : Nat) (pat : List Nat) : Bool :=
    (fix go (ps : List Nat) (j : Nat) : Bool :=
        match ps with
        | Nil => True
        | Cons p rest =>
            match eqNat(json_ch_at(s, add i j), p) with
            | False => False
            | True => go(rest, S j)
            end
        end) pat Z;

def esc_codes : List Nat -> List Nat :=
  fix esc_codes (cs : List Nat) : List Nat :=
    match cs with
    | Nil => Nil Nat
    | Cons c rest =>
        if lebNat c 31 then
          if eqNat c ch_lf then Cons Nat ch_bslash (Cons Nat 110 (esc_codes rest))
          else if eqNat c ch_cr then Cons Nat ch_bslash (Cons Nat 114 (esc_codes rest))
          else if eqNat c ch_tab then Cons Nat ch_bslash (Cons Nat 116 (esc_codes rest))
          else if eqNat c 8 then Cons Nat ch_bslash (Cons Nat 98 (esc_codes rest))
          else if eqNat c 12 then Cons Nat ch_bslash (Cons Nat 102 (esc_codes rest))
          else match divmod_nat c 16 with
            | MkPair high low =>
                append Nat
                  ([ch_bslash, 117, 48, 48, hex_digit high, hex_digit low] : List Nat)
                  (esc_codes rest)
            end
        else if eqNat c ch_quote then Cons Nat ch_bslash (Cons Nat c (esc_codes rest))
        else if eqNat c ch_bslash then Cons Nat ch_bslash (Cons Nat c (esc_codes rest))
        else Cons Nat c (esc_codes rest)
    end;

def json_escape_str (s : String) : String :=
    prim_string_of_char_codes
      (Cons Nat ch_quote
        (append Nat (esc_codes (prim_string_to_char_codes s))
          ([ch_quote] : List Nat)));

-- Each slot holds twice as many fragments as the previous slot. Newer runs
-- have lower slots, so each merge puts the older run first.
private def JsonPrintParts : Type := List (Maybe String);

private def json_print_push : JsonPrintParts -> String -> JsonPrintParts :=
    fix push (parts : JsonPrintParts) (fragment : String) : JsonPrintParts :=
      match parts with
      | Nil => Cons (Maybe String) (Just String fragment) (Nil (Maybe String))
      | Cons part rest =>
        match part with
        | Nothing => Cons (Maybe String) (Just String fragment) rest
        | Just older =>
            Cons (Maybe String) (Nothing String) (push rest (prim_string_concat older fragment))
        end
      end;

private def json_print_finish : JsonPrintParts -> Maybe String -> String :=
    fix finish (parts : JsonPrintParts) (suffix : Maybe String) : String :=
      match parts with
      | Nil => fromMaybe String "" suffix
      | Cons part rest =>
        match part with
        | Nothing => finish rest suffix
        | Just older =>
          match suffix with
          | Nothing => finish rest part
          | Just newer => finish rest (Just String (prim_string_concat older newer))
          end
        end
      end;

def json_print_fuel : Nat -> Json -> String :=
  fix json_print_fuel (fuel : Nat) (j : Json) : String :=
    match fuel with
    | Z => "null"
    | S fuel' =>
        match j with
        | JNull => "null"
        | JBool b => match b with | True => "true" | False => "false" end
        | JNum s => s
        | JStr s => json_escape_str s
        | JArr xs =>
            let parts : JsonPrintParts :=
              (fix go (ys : List Json) (acc : JsonPrintParts) : JsonPrintParts :=
                match ys with
                | Nil => acc
                | Cons item rest =>
                    let next : JsonPrintParts := json_print_push acc (json_print_fuel fuel' item) in
                    match rest with
                    | Nil => next
                    | Cons _ _ => go rest (json_print_push next ",")
                    end
                end) xs (json_print_push (Nil (Maybe String)) "[") in
            json_print_finish (json_print_push parts "]") (Nothing String)
        | JObj kvs =>
            let parts : JsonPrintParts :=
              (fix go (ys : List (Pair String Json)) (acc : JsonPrintParts) : JsonPrintParts :=
                match ys with
                | Nil => acc
                | Cons field rest =>
                    let (MkPair key value) := field in
                    let named : JsonPrintParts := json_print_push acc (json_escape_str key) in
                    let next : JsonPrintParts :=
                      json_print_push (json_print_push named ":") (json_print_fuel fuel' value) in
                    match rest with
                    | Nil => next
                    | Cons _ _ => go rest (json_print_push next ",")
                    end
                end) kvs (json_print_push (Nil (Maybe String)) "{") in
            json_print_finish (json_print_push parts "}") (Nothing String)
        end
    end;

def ten : Nat := 10;

def json_print (j : Json) : String :=
    json_print_fuel(mul(mul ten ten, ten), j);

def json_unescape_char (c : Nat) : Maybe Nat :=
    (fix go (xs : List (Pair Nat Nat)) : Maybe Nat :=
      match xs with
      | Nil => Nothing Nat
      | Cons p rest =>
        match p with
        | MkPair code decoded =>
          match eqNat c code with
          | True => Just Nat decoded
          | False => go rest
          end
        end
      end)
    ([ MkPair Nat Nat 110 10
     , MkPair Nat Nat 116 9
     , MkPair Nat Nat 114 13
     , MkPair Nat Nat 34 34
     , MkPair Nat Nat 92 92
     , MkPair Nat Nat 47 47
     , MkPair Nat Nat 98 8
     , MkPair Nat Nat 102 12
     ] : List (Pair Nat Nat));

def decode_esc (s : String) (i : Nat) : Maybe (Pair Nat Nat) :=
    match json_unescape_char (json_ch_at s i) with
    | Nothing => Nothing (Pair Nat Nat)
    | Just ch => Just(Pair Nat Nat, MkPair Nat Nat ch (S i))
    end;

-- Four hex digits, with the first malformed or missing byte as the error.
def json_hex_quad (s : String) (start : Nat) : Pair (Maybe Nat) Nat :=
    (fix go (left : Nat) (i : Nat) (value : Nat) : Pair (Maybe Nat) Nat :=
      match left with
      | Z => MkPair(Maybe Nat, Nat, Just Nat value, i)
      | S left2 =>
        let c : Nat := json_ch_at s i in
        match is_hex c with
        | False => MkPair(Maybe Nat, Nat, Nothing Nat, i)
        | True => go(left2, S i, add(mul 16 value, digit_val c))
        end
      end) 4 start Z;

-- This encoder requires a validated Unicode scalar.
def json_scalar_utf8 (value : Nat) : List Nat :=
    utf8_scalar_bytes value;

-- Entry is the u after a backslash. A high surrogate requires an immediately
-- adjacent low-surrogate escape; lone lows and non-low partners are errors.
def json_unicode_escape (s : String) (i : Nat) : Pair (Maybe (List Nat)) Nat :=
    match json_hex_quad(s, S i) with
    | MkPair decoded next =>
      match decoded with
      | Nothing => MkPair(Maybe (List Nat), Nat, Nothing (List Nat), next)
      | Just value =>
        let byte_base : Nat := mul 16 16 in
        let high_start : Nat := mul 216 byte_base in
        let low_start : Nat := mul 220 byte_base in
        let surrogate_end : Nat := mul 224 byte_base in
        match andb(lebNat high_start value, ltb_nat value surrogate_end) with
        | False =>
          MkPair(Maybe (List Nat), Nat, Just(List Nat, json_scalar_utf8 value), next)
        | True =>
          match lebNat low_start value with
          | True => MkPair(Maybe (List Nat), Nat, Nothing (List Nat), i)
          | False =>
            match eqNat(json_ch_at s next, 92) with
            | False => MkPair(Maybe (List Nat), Nat, Nothing (List Nat), next)
            | True =>
              let low_u : Nat := S next in
              match eqNat(json_ch_at s low_u, 117) with
              | False => MkPair(Maybe (List Nat), Nat, Nothing (List Nat), low_u)
              | True =>
                match json_hex_quad(s, S low_u) with
                | MkPair low_decoded after_low =>
                  match low_decoded with
                  | Nothing => MkPair(Maybe (List Nat), Nat, Nothing (List Nat), after_low)
                  | Just low =>
                    match andb(lebNat low_start low, ltb_nat low surrogate_end) with
                    | False => MkPair(Maybe (List Nat), Nat, Nothing (List Nat), low_u)
                    | True =>
                      let scalar : Nat :=
                        add (mul byte_base byte_base)
                          (add(mul(32, mul(32, sub value high_start)), sub low low_start)) in
                      MkPair (Maybe (List Nat)) Nat
                        (Just(List Nat, json_scalar_utf8 scalar)) after_low
                    end
                  end
                end
              end
            end
          end
        end
      end
    end;

-- A balanced composition of byte builders keeps both scanning and final list
-- construction linear without relying on C tail-call optimization.
inductive JsonStringProgress : Type :=
  | JsonStringMore : Nat -> Nat -> (List Nat -> List Nat) -> JsonStringProgress
  | JsonStringEnd : Nat -> (List Nat -> List Nat) -> JsonStringProgress
  | JsonStringError : Nat -> JsonStringProgress;

private def json_string_plain_run (s : String) (len : Nat) (fuel : Nat)
    (start : Nat) (first : Nat) : JsonStringProgress :=
    let next : Nat := add 1 start in
    -- Fuel already excludes the first byte. Leave the next special byte to the decoder.
    let limit : Nat := minNat 63 (minNat fuel (sub len next)) in
    let after : Nat :=
      (fix scan (left : Nat) (cursor : Nat) : Nat :=
        match left with
        | Z => cursor
        | S rest =>
            let byte : Nat := json_ch_at s cursor in
            if lebNat byte 31 then cursor
            else if eqNat byte ch_quote then cursor
            else if eqNat byte ch_bslash then cursor
            else scan rest (add 1 cursor)
        end) limit next in
    if eqNat after next then JsonStringMore(fuel, next, fun (rest : List Nat) => Cons Nat first rest)
    else
      let bytes : List Nat := prim_string_to_char_codes (prim_string_slice s start (sub after start)) in
      JsonStringMore (sub fuel (sub after next)) after (fun (rest : List Nat) => append Nat bytes rest);

private def json_string_step_using (batch_plain_bytes : Bool)
    (fuel : Nat) (input : Pair String Nat) (i : Nat) : JsonStringProgress :=
      match input with
      | MkPair s len =>
        match fuel with
        | Z => JsonStringError (pred i)
        | S fuel2 =>
          match lebNat len i with
          | True => JsonStringError (pred i)
          | False =>
            let c : Nat := json_ch_at s i in
            match eqNat c ch_quote with
            | True =>
              JsonStringEnd(add i 1, fun (rest : List Nat) => rest)
            | False =>
              match lebNat c (pred ch_space) with
              | True => JsonStringError i
              | False =>
                match eqNat c ch_bslash with
                | False => if batch_plain_bytes then json_string_plain_run s len fuel2 i c
                  else JsonStringMore(fuel2, add i 1, fun (rest : List Nat) => Cons Nat c rest)
                | True =>
                  let escaped : Nat := add i 1 in
                  match lebNat len escaped with
                  | True => JsonStringError i
                  | False =>
                    let marker : Nat := json_ch_at s escaped in
                    match eqNat marker 117 with
                    | True =>
                      match json_unicode_escape s escaped with
                      | MkPair decoded next =>
                        match decoded with
                        | Nothing => JsonStringError next
                        | Just bytes =>
                          JsonStringMore fuel2 next (fun (rest : List Nat) => append Nat bytes rest)
                        end
                      end
                    | False =>
                      match json_unescape_char marker with
                      | Nothing => JsonStringError escaped
                      | Just byte =>
                        JsonStringMore fuel2 (S escaped) (fun (rest : List Nat) => Cons Nat byte rest)
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end;

def json_string_step (fuel : Nat) (input : Pair String Nat) (i : Nat) : JsonStringProgress :=
    json_string_step_using False fuel input i;

def json_string_join (prefix : List Nat -> List Nat) (result : JsonStringProgress) : JsonStringProgress :=
    match result with
    | JsonStringError offset => JsonStringError offset
    | JsonStringEnd next suffix => JsonStringEnd(next, fun (rest : List Nat) => prefix (suffix rest))
    | JsonStringMore fuel next suffix => JsonStringMore fuel next (fun (rest : List Nat) => prefix (suffix rest))
    end;

private def json_string_scan_tree_using (batch_plain_bytes : Bool)
    : Nat -> Pair String Nat -> Nat -> Nat -> JsonStringProgress :=
    fix scan (depth : Nat) (input : Pair String Nat) (fuel : Nat) (i : Nat) : JsonStringProgress :=
      match depth with
      | Z => json_string_step_using batch_plain_bytes fuel input i
      | S rest =>
        match scan rest input fuel i with
        | JsonStringError offset => JsonStringError offset
        | JsonStringEnd next bytes => JsonStringEnd next bytes
        | JsonStringMore remaining next prefix => json_string_join(prefix, scan rest input remaining next)
        end
      end;

def json_string_scan_tree : Nat -> Pair String Nat -> Nat -> Nat -> JsonStringProgress :=
    json_string_scan_tree_using False;

def json_string_scan_depth (fuel : Nat) : Nat :=
    (fix grow (guard : Nat) (span : Nat) (depth : Nat) : Nat :=
      match guard with
      | Z => depth
      | S rest => match lebNat fuel span with
          | True => depth
          | False => grow(rest, add span span, S depth)
          end
      end) fuel 1 0;

def json_string_scan : Nat -> Pair String Nat -> Nat -> List Nat -> Pair (Maybe String) Nat :=
    fun (fuel : Nat) => fun (input : Pair String Nat) => fun (i : Nat) => fun (acc : List Nat) =>
    match json_string_scan_tree_using True (json_string_scan_depth fuel) input fuel i with
    | JsonStringError offset => MkPair(Maybe String, Nat, Nothing String, offset)
    | JsonStringMore _ next _ => MkPair(Maybe String, Nat, Nothing String, pred next)
    | JsonStringEnd next bytes => MkPair (Maybe String) Nat
        (Just(String, prim_string_of_char_codes (rev_append Nat acc (bytes (Nil Nat))))) next
    end;

-- Start at the opening quote. Success returns the offset after the close.
-- Failure reports a byte offset. A missing close reports the last byte read.
-- Raw bytes of 32 or more retain their values. Unicode escapes must encode
-- valid scalars and can produce NUL.
def json_string_parse (s : String) (i : Nat) : Pair (Maybe String) Nat :=
    let len : Nat := prim_string_length s in
    match andb(ltb_nat i len, eqNat(json_ch_at s i, ch_quote)) with
    | False => MkPair(Maybe String, Nat, Nothing String, i)
    | True => json_string_scan(sub len i, MkPair String Nat s len, S i, Nil Nat)
    end;

def parse_string_lit (fuel : Nat) (s : String) (i0 : Nat) : ParseR :=
    match fuel with
    | Z => PErr i0
    | S _ =>
        match json_string_parse s i0 with
        | MkPair decoded next =>
            match decoded with
            | Nothing => PErr next
            | Just text => POk(JStr text, next)
            end
        end
    end;

def json_is_digit (c : Nat) : Bool :=
    andb(lebNat 48 c, lebNat c 57);

def json_consume_digits (s : String) (start : Nat) : Nat :=
    (fix go (fuel : Nat) (j : Nat) : Nat :=
      match fuel with
      | Z => j
      | S fuel2 =>
        match json_is_digit (json_ch_at s j) with
        | True => go(fuel2, add 1 j)
        | False => j
        end
      end) (sub (prim_string_length s) start) start;

def parse_num (s : String) (i : Nat) : ParseR :=
    let after_sign : Nat :=
      match eqNat(json_ch_at s i, 45) with
      | True => S i
      | False => i
      end in
    let first : Nat := json_ch_at s after_sign in
    match json_is_digit first with
    | False => PErr after_sign
    | True =>
      let after_int : Nat :=
        match eqNat first 48 with
        | True => S after_sign
        | False => json_consume_digits(s, S after_sign)
        end in
      let delimiter : Nat := json_ch_at s after_int in
      match andb(eqNat first 48, json_is_digit delimiter) with
      | True => PErr after_int
      | False =>
        match eqNat delimiter 46 with
        | False =>
          POk(JNum (prim_string_slice s i (sub after_int i)), after_int)
        | True =>
          let frac_start : Nat := S after_int in
          let after_frac : Nat := json_consume_digits s frac_start in
          match eqNat after_frac frac_start with
          | True => PErr frac_start
          | False =>
            POk(JNum (prim_string_slice s i (sub after_frac i)), after_frac)
          end
        end
      end
    end;

def parse_head (fuel : Nat) (s : String) (i0 : Nat) : ParseHead :=
    let i : Nat := skip_ws fuel s i0 in
    let c : Nat := json_ch_at s i in
    match eqNat c ch_quote with
    | True => PHReady (parse_string_lit fuel s i)
    | False => match eqNat c ch_lbrace with
      | True => PHObject i
      | False => match eqNat c ch_lbrack with
        | True => PHArray i
        | False => match orb (eqNat c ch_minus) (is_digit c) with
          | True => PHReady (parse_num s i)
          | False => match eqNat c 110 with
            | True => match starts_with_at s i ([110, 117, 108, 108] : List Nat) with
              | True => PHReady (POk(JNull, add i 4))
              | False => PHError i
              end
            | False => match eqNat c 116 with
              | True => match starts_with_at s i ([116, 114, 117, 101] : List Nat) with
                | True => PHReady (POk(JBool True, add i 4))
                | False => PHError i
                end
              | False => match eqNat c 102 with
                | True => match starts_with_at s i ([102, 97, 108, 115, 101] : List Nat) with
                  | True => PHReady (POk(JBool False, add i 5))
                  | False => PHError i
                  end
                | False => PHError i
                end
              end
            end
          end
        end
      end
    end;

def parse_val : Nat -> Nat -> String -> Nat -> ParseR :=
  fix parse_val (depth : Nat) (fuel : Nat) (s : String) (i0 : Nat) : ParseR :=
    match depth with
    | Z => PErr i0
    | S depth' =>
      match fuel with
      | Z => PErr i0
      | S fuel' =>
        match parse_head fuel s i0 with
        | PHReady r => r
        | PHArray i =>
            (fix go (f2 : Nat) (j0 : Nat) (acc : List Json) : ParseR :=
                match f2 with
                | Z => PErr j0
                | S f2' =>
                    let j : Nat := skip_ws fuel s j0 in
                    match eqNat(json_ch_at s j, 93) with
                    | True =>
                        match acc with
                        | Nil => POk(JArr (Nil Json), S j)
                        | Cons _ _ => PErr j
                        end
                    | False =>
                        match parse_val depth' fuel' s j with
                        | PErr e => PErr e
                        | POk v j2 =>
                            let j3 : Nat := skip_ws fuel s j2 in
                            match eqNat(json_ch_at s j3, 44) with
                            | True => go(f2', add 1 j3, Cons Json v acc)
                            | False =>
                                match eqNat(json_ch_at s j3, 93) with
                                | True =>
                                    POk(JArr (reverse(Json, Cons Json v acc)), S j3)
                                | False => PErr j3
                                end
                            end
                        end
                    end
                end) fuel (S i) (Nil Json)
        | PHObject i =>
            (fix go (f2 : Nat) (j0 : Nat)
                (acc : List (Pair String Json)) : ParseR :=
                match f2 with
                | Z => PErr j0
                | S f2' =>
                    let j : Nat := skip_ws fuel s j0 in
                    match eqNat(json_ch_at s j, 125) with
                    | True =>
                        match acc with
                        | Nil => POk(JObj (Nil (Pair String Json)), S j)
                        | Cons _ _ => PErr j
                        end
                    | False =>
                        match parse_string_lit fuel s j with
                        | PErr e => PErr e
                        | POk ks j1 =>
                            match ks with
                            | JStr k =>
                                let j2 : Nat := skip_ws fuel s j1 in
                                match eqNat(json_ch_at s j2, 58) with
                                | False => PErr j2
                                | True =>
                                    match parse_val depth' fuel' s (S j2) with
                                    | PErr e => PErr e
                                    | POk v j3 =>
                                        let j4 : Nat := skip_ws fuel s j3 in
                                        let acc' : List (Pair String Json) :=
                                          Cons (Pair String Json)
                                            (MkPair String Json k v) acc in
                                        match eqNat(json_ch_at s j4, 44) with
                                        | True => go f2' (S j4) acc'
                                        | False =>
                                            match eqNat(json_ch_at s j4, 125) with
                                            | True =>
                                                POk
                                                  (JObj
                                                    (reverse(Pair String Json, acc')))
                                                  (S j4)
                                            | False => PErr j4
                                            end
                                        end
                                    end
                                end
                            | JNull => PErr j
                            | JBool _ => PErr j
                            | JNum _ => PErr j
                            | JArr _ => PErr j
                            | JObj _ => PErr j
                            end
                        end
                    end
                end) fuel (S i) (Nil (Pair String Json))
        | PHError e => PErr e
        end
      end
    end;

-- Limit JSON nesting depth independently of string and array length.
def json_max_depth : Nat := mul 16 8;

def parse_json (s : String) : Maybe Json :=
    let len : Nat := prim_string_length s in
    let input : String := prim_string_slice s Z len in
    let fuel : Nat := mul(10, S len) in
    match parse_val json_max_depth fuel input Z with
    | PErr _ => Nothing Json
    | POk v i =>
        let i2 : Nat := skip_ws fuel input i in
        match lebNat len i2 with
        | True => Just Json v
        | False => Nothing Json
        end
    end;

def json_roundtrip_ok (s : String) : Bool :=
    match parse_json s with
    | Nothing => False
    | Just j => prim_string_eq(json_print j, s)
    end;
