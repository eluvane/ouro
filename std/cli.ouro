-- Typed command-line helpers built on std/args and std/text.

import "args.ouro";
import "collections.ouro";
import "text.ouro";

inductive CliError : Type :=
  | CliMissingOption : String -> CliError
  | CliBadNat : String -> String -> CliError
  | CliBadBool : String -> String -> CliError
  | CliMissingPositional : Nat -> String -> CliError
  | CliUsage : String -> CliError;

def cli_error_code (e : CliError) : String :=
    match e with
    | CliMissingOption _ => "missing_option"
    | CliBadNat _ _ => "bad_nat"
    | CliBadBool _ _ => "bad_bool"
    | CliMissingPositional _ _ => "missing_positional"
    | CliUsage _ => "usage"
    end;

def cli_error_message (e : CliError) : String :=
    match e with
    | CliMissingOption name => str_concat "missing required option --" name
    | CliBadNat name got => str_cat4 "invalid natural number for --" name ": " got
    | CliBadBool name got => str_cat4 "invalid boolean for --" name ": " got
    | CliMissingPositional i name =>
        str_cat4 "missing positional " (str_of_nat i) ": " name
    | CliUsage text => text
    end;

def cli_parse (bools : List String) (ws : List String) : Args :=
    args_parse_bools bools ws;

def cli_from_argv (bools : List String) (av : List String) : Args :=
    args_of_argv_bools bools av;

def cli_flag (a : Args) (name : String) : Bool :=
    args_flag a name;

def cli_opt (a : Args) (name : String) : Maybe String :=
    args_opt a name;

def cli_has_opt (a : Args) (name : String) : Bool :=
    match args_opt a name with
    | Nothing => False
    | Just _ => True
    end;

def cli_required (a : Args) (name : String) : Either CliError String :=
    match args_opt a name with
    | Nothing => Left CliError String (CliMissingOption name)
    | Just value => Right CliError String value
    end;

def cli_required_nat (a : Args) (name : String) : Either CliError Nat :=
    match cli_required a name with
    | Left e => Left CliError Nat e
    | Right value =>
      match str_parse_nat value with
      | Nothing => Left CliError Nat (CliBadNat name value)
      | Just n => Right CliError Nat n
      end
    end;

def cli_optional_nat (a : Args) (name : String) (fallback : Nat)
    : Either CliError Nat :=
    match args_opt a name with
    | Nothing => Right CliError Nat fallback
    | Just value =>
      match str_parse_nat value with
      | Nothing => Left CliError Nat (CliBadNat name value)
      | Just n => Right CliError Nat n
      end
    end;

def cli_required_bool (a : Args) (name : String) : Either CliError Bool :=
    match cli_required a name with
    | Left e => Left CliError Bool e
    | Right value =>
      match str_parse_bool value with
      | Nothing => Left CliError Bool (CliBadBool name value)
      | Just b => Right CliError Bool b
      end
    end;

def cli_optional_bool (a : Args) (name : String) (fallback : Bool)
    : Either CliError Bool :=
    match args_opt a name with
    | Nothing => Right CliError Bool fallback
    | Just value =>
      match str_parse_bool value with
      | Nothing => Left CliError Bool (CliBadBool name value)
      | Just b => Right CliError Bool b
      end
    end;

def cli_pos (a : Args) (i : Nat) : Maybe String :=
    nth_maybe String i (args_positional a);

def cli_pos_or (a : Args) (i : Nat) (fallback : String) : String :=
    fromMaybe String fallback (cli_pos a i);

def cli_required_pos (a : Args) (i : Nat) (name : String)
    : Either CliError String :=
    match cli_pos a i with
    | Nothing => Left CliError String (CliMissingPositional i name)
    | Just value => Right CliError String value
    end;

def cli_usage (program : String) (shape : String) : String :=
    str_cat3 "usage: " program (str_concat " " shape);

def cli_error_block (program : String) (shape : String) (e : CliError) : String :=
    str_unlines ([cli_error_message e, cli_usage program shape] : List String);
