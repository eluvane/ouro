-- Practical collection helpers layered over the small prelude/listx core.

import "listx.ouro",
  "result.ouro";

def nth_maybe (A : Type) : Nat -> List A -> Maybe A :=
    fix nth_maybe (n : Nat) (xs : List A) : Maybe A :=
      match n with
      | Z =>
        match xs with
        | Nil => Nothing A
        | Cons x _ => Just A x
        end
      | S n2 =>
        match xs with
        | Nil => Nothing A
        | Cons _ rest => nth_maybe n2 rest
        end
      end;

def list_get_or (A : Type) (fallback : A) (i : Nat) (xs : List A) : A :=
    nth A fallback i xs;

def filter_map (A : Type) (B : Type) (f : A -> Maybe B) : List A -> List B :=
    fix filter_map (xs : List A) : List B :=
      match xs with
      | Nil => Nil B
      | Cons x rest =>
        match f x with
        | Nothing => filter_map rest
        | Just y => Cons B y (filter_map rest)
        end
      end;

def map_indexed (A : Type) (B : Type) (f : Nat -> A -> B)
    (xs : List A) : List B :=
  (fix go (ys : List A) (index : Nat) : List B :=
    match ys with
    | Nil => Nil B
    | Cons x rest => Cons(B, f index x, go(rest, S index))
    end) xs Z;

def indexed (A : Type) (xs : List A) : List (Pair Nat A) :=
    map_indexed(A, Pair Nat A, fun (i : Nat) (x : A) => MkPair Nat A i x, xs);

def find_index (A : Type) (p : A -> Bool) (xs : List A) : Maybe Nat :=
  (fix go (ys : List A) (index : Nat) : Maybe Nat :=
    match ys with
    | Nil => Nothing Nat
    | Cons x rest =>
      match p x with
      | True => Just Nat index
      | False => go(rest, S index)
      end
    end) xs Z;

def split_at (A : Type) (n : Nat) (xs : List A) : Pair (List A) (List A) :=
    MkPair(List A, List A, take A n xs, drop A n xs);

def chunks_of (A : Type) (n : Nat) (xs : List A) : List (List A) :=
    match n with
    | Z => Nil (List A)
    | S _ =>
      (fix chunks_of_go (fuel : Nat) (ys : List A) : List (List A) :=
        match fuel with
        | Z => Nil (List A)
        | S fuel2 =>
          match ys with
          | Nil => Nil (List A)
          | Cons _ _ => Cons(List A, take A n ys, chunks_of_go(fuel2, drop A n ys))
          end
        end) (S (length A xs)) xs
    end;

-- Complete overlapping windows; width zero has no windows.
def list_windows (A : Type) (width : Nat) (xs : List A) : List (List A) :=
    match width with
    | Z => Nil (List A)
    | S _ =>
      (fix go (remaining : List A) : List (List A) :=
        match remaining with
        | Nil => Nil (List A)
        | Cons _ rest =>
            let window : List A := take A width remaining in
            match eqNat (length A window) width with
            | False => Nil (List A)
            | True => Cons (List A) window (go rest)
            end
        end) xs
    end;

-- The initial state is the first result, even for an empty input.
def list_scan (A : Type) (S : Type) (step : S -> A -> S)
    (initial : S) (xs : List A) : List S :=
  (fix go (remaining : List A) (state : S) : List S :=
    match remaining with
    | Nil => ([state] : List S)
    | Cons x rest =>
        let next : S := step state x in
        Cons S state (go rest next)
    end) xs initial;

def list_map_accum (A : Type) (S : Type) (B : Type)
    (step : S -> A -> Pair S B) (initial : S) (xs : List A)
    : Pair S (List B) :=
  (fix go (remaining : List A) (state : S) : Pair S (List B) :=
    match remaining with
    | Nil => MkPair S (List B) state (Nil B)
    | Cons x rest =>
        match step state x with
        | MkPair next value =>
            match go rest next with
            | MkPair final values =>
                MkPair S (List B) final (Cons B value values)
            end
        end
    end) xs initial;

def list_eq (A : Type) (eq : A -> A -> Bool) : List A -> List A -> Bool :=
    fix list_eq (xs : List A) (ys : List A) : Bool :=
      match xs with
      | Nil =>
        match ys with
        | Nil => True
        | Cons _ _ => False
        end
      | Cons x rest_x =>
        match ys with
        | Nil => False
        | Cons y rest_y => andb(eq x y, list_eq rest_x rest_y)
        end
      end;

def list_count (A : Type) (eq : A -> A -> Bool) (x : A) (xs : List A) : Nat :=
    count_if A (fun (y : A) => eq x y) xs;

def list_remove (A : Type) (eq : A -> A -> Bool) (x : A) : List A -> List A :=
    filter(A, fun (y : A) => notb (eq x y));

def list_take_last (A : Type) (n : Nat) (xs : List A) : List A :=
    drop A (sub(length A xs, n)) xs;

def list_drop_last (A : Type) (n : Nat) (xs : List A) : List A :=
    take A (sub(length A xs, n)) xs;

def adjacent_pairs (A : Type) : List A -> List (Pair A A) :=
    fun (xs : List A) =>
      match xs with
      | Nil => Nil (Pair A A)
      | Cons x rest =>
        (fix adjacent_pairs_go (ys : List A) (previous : A) : List (Pair A A) :=
          match ys with
          | Nil => Nil (Pair A A)
          | Cons y rest2 =>
              Cons(Pair A A, MkPair A A previous y,
                adjacent_pairs_go rest2 y)
          end) rest x
      end;

def dedup_adjacent (A : Type) (eq : A -> A -> Bool) : List A -> List A :=
    fun (xs : List A) =>
      match xs with
      | Nil => Nil A
      | Cons x rest =>
        Cons A x
          ((fix go (ys : List A) (previous : A) : List A :=
            match ys with
            | Nil => Nil A
            | Cons y rest2 =>
              match eq previous y with
              | True => go rest2 previous
              | False => Cons A y (go rest2 y)
              end
            end) rest x)
      end;

-- Keys and elements retain first-seen order; eq must identify equivalent keys.
def list_group_by (A : Type) (K : Type) (eq : K -> K -> Bool)
    (key : A -> K) (xs : List A) : List (Pair K (List A)) :=
    let groups : List (Pair K (List A)) :=
      foldl A (List (Pair K (List A)))
        (fun (groups : List (Pair K (List A))) (x : A) =>
          let group_key : K := key x in
          (fix insert (remaining : List (Pair K (List A)))
              : List (Pair K (List A)) :=
            match remaining with
            | Nil =>
                ([MkPair K (List A) group_key ([x] : List A)]
                  : List (Pair K (List A)))
            | Cons group rest =>
                match group with
                | MkPair prior members =>
                    match eq prior group_key with
                    | True =>
                        Cons (Pair K (List A))
                          (MkPair K (List A) prior (Cons A x members)) rest
                    | False => Cons (Pair K (List A)) group (insert rest)
                    end
                end
            end) groups)
        (Nil (Pair K (List A))) xs in
    map (Pair K (List A)) (Pair K (List A))
      (fun (group : Pair K (List A)) =>
        match group with
        | MkPair group_key members =>
            MkPair K (List A) group_key (reverse_lin A members)
        end) groups;

def partition_map (A : Type) (L : Type) (R : Type) (f : A -> Either L R)
    : List A -> Pair (List L) (List R) :=
    fix partition_map (xs : List A) : Pair (List L) (List R) :=
      match xs with
      | Nil => MkPair(List L, List R, Nil L, Nil R)
      | Cons x rest =>
        let out : Pair (List L) (List R) := partition_map rest in
        match f x with
        | Left l => MkPair(List L, List R, Cons L l (fst(List L, List R, out)), snd(List L, List R, out))
        | Right r => MkPair(List L, List R, fst(List L, List R, out), Cons R r (snd(List L, List R, out)))
        end
      end;

def list_collect_results (E : Type) (A : Type)
    : List (Either E A) -> Either E (List A) :=
    fix list_collect_results (xs : List (Either E A)) : Either E (List A) :=
      match xs with
      | Nil => Right(E, List A, Nil A)
      | Cons r rest =>
        match r with
        | Left e => Left E (List A) e
        | Right x =>
          match list_collect_results rest with
          | Left e => Left E (List A) e
          | Right ys => Right(E, List A, Cons A x ys)
          end
        end
      end;

def list_traverse_result (E : Type) (A : Type) (B : Type)
    (f : A -> Either E B) (xs : List A) : Either E (List B) :=
    (fix go (remaining : List A) : Either E (List B) :=
      match remaining with
      | Nil => Right E (List B) (Nil B)
      | Cons x rest =>
          match f x with
          | Left error => Left E (List B) error
          | Right value =>
              match go rest with
              | Left error => Left E (List B) error
              | Right values =>
                  Right E (List B) (Cons B value values)
              end
          end
      end) xs;

def list_try_fold_result (E : Type) (A : Type) (S : Type)
    (step : S -> A -> Either E S) (initial : S) (xs : List A)
    : Either E S :=
  (fix go (remaining : List A) (state : S) : Either E S :=
    match remaining with
    | Nil => Right E S state
    | Cons x rest =>
        match step state x with
        | Left error => Left E S error
        | Right next => go rest next
        end
    end) xs initial;

def list_try_fold_maybe (A : Type) (S : Type)
    (step : S -> A -> Maybe S) (initial : S) (xs : List A) : Maybe S :=
  (fix go (remaining : List A) (state : S) : Maybe S :=
    match remaining with
    | Nil => Just S state
    | Cons x rest =>
        match step state x with
        | Nothing => Nothing S
        | Just next => go rest next
        end
    end) xs initial;

def list_traverse_maybe (A : Type) (B : Type) (f : A -> Maybe B) : List A -> Maybe (List B) :=
    fix list_traverse_maybe (xs : List A) : Maybe (List B) :=
      match xs with
      | Nil => Just (List B) (Nil B)
      | Cons x rest =>
        match f x with
        | Nothing => Nothing (List B)
        | Just y =>
          match list_traverse_maybe rest with
          | Nothing => Nothing (List B)
          | Just ys => Just (List B) (Cons B y ys)
          end
        end
      end;
