-- Prelude stays tiny so every tool cone can import it without widening the TCB surface.

import "types.ouro";

-- @bound(nodes <= 26)
def add : Nat -> Nat -> Nat :=
  fix add (n : Nat) (m : Nat) : Nat :=
    match n with | Z => m | S n' => S (add n' m) end;

-- @bound(nodes <= 28)
def mul : Nat -> Nat -> Nat :=
  fix mul (n : Nat) (m : Nat) : Nat :=
    match n with | Z => Z | S n' => add(m, mul n' m) end;

-- @bound(nodes <= 52)
def map (A : Type) (B : Type) (f : A -> B) : List A -> List B :=
    fix map (xs : List A) : List B :=
      match xs with
      | Nil => Nil B
      | Cons x xs' => Cons(B, f x, map xs')
      end;

-- @bound(nodes <= 54)
def append (A : Type) : List A -> List A -> List A :=
    fix append (xs : List A) : List A -> List A :=
      match xs with
      | Nil => fun (ys : List A) => ys
      | Cons x xs' => fun (ys : List A) => Cons A x (append xs' ys)
      end;

-- @bound(nodes <= 28)
def length (A : Type) : List A -> Nat :=
    fix length (xs : List A) : Nat :=
      match xs with
      | Nil => Z
      | Cons _ xs' => S (length xs')
      end;

-- @bound(nodes <= 50)
def foldr (A : Type) (B : Type) (f : A -> B -> B) (z : B) : List A -> B :=
    fix foldr (xs : List A) : B :=
      match xs with
      | Nil => z
      | Cons x xs' => f(x, foldr xs')
      end;

-- @minimal
-- @bound(nodes <= 27)
def fst (A : Type) (B : Type) (p : Pair A B) : A :=
    match p with | MkPair a _ => a end;

-- @minimal
-- @bound(nodes <= 27)
def snd (A : Type) (B : Type) (p : Pair A B) : B :=
    match p with | MkPair _ b => b end;

-- @bound(nodes <= 30)
def sub : Nat -> Nat -> Nat :=
  fix sub (n : Nat) (m : Nat) : Nat :=
    match n with
    | Z => Z
    | S n' =>
      match m with
      | Z => n
      | S m' => sub n' m'
      end
    end;

-- @minimal
-- @bound(nodes <= 17)
def andb (x : Bool) (y : Bool) : Bool :=
    match x with
    | True => y
    | False => False
    end;

-- @minimal
-- @bound(nodes <= 17)
def orb (x : Bool) (y : Bool) : Bool :=
    match x with
    | True => True
    | False => y
    end;

-- @minimal
-- @bound(nodes <= 13)
def notb (x : Bool) : Bool :=
    match x with
    | True => False
    | False => True
    end;
