-- Empty has no constructors; branchless matches are the kernel coverage case for contradiction.

inductive Empty : Type := ;

-- @minimal
-- @bound(nodes <= 9)
def Not (A : Type) : Type := A -> Empty;

-- Branchless match on Empty (no ctors).
def ex_falso (A : Type) (e : Empty) : A := match e with end;

inductive And (A : Type) (B : Type) : Type :=
  | Conj : A -> B -> And A B;

-- @bound(nodes <= 39)
def and_comm (A : Type) (B : Type) (h : And A B) : And B A :=
    match h with
    | Conj a b => Conj B A b a
    end;

-- @bound(nodes <= 71)
def and_assoc (A : Type) (B : Type) (C : Type) (h : And A (And B C)) : And (And A B) C :=
    match h with
    | Conj a hbc =>
      match hbc with
      | Conj b c => Conj(And A B, C, Conj A B a b, c)
      end
    end;

inductive Or (A : Type) (B : Type) : Type :=
  | Inl : A -> Or A B
  | Inr : B -> Or A B;

-- @bound(nodes <= 45)
def or_comm (A : Type) (B : Type) (h : Or A B) : Or B A :=
    match h with
    | Inl a => Inr B A a
    | Inr b => Inl B A b
    end;

-- @bound(nodes <= 97)
def or_assoc (A : Type) (B : Type) (C : Type) (h : Or A (Or B C)) : Or (Or A B) C :=
    match h with
    | Inl a => Inl(Or A B, C, Inl A B a)
    | Inr hbc =>
      match hbc with
      | Inl b => Inl(Or A B, C, Inr A B b)
      | Inr c => Inr (Or A B) C c
      end
    end;

-- @minimal
-- @bound(nodes <= 25)
def modus_ponens (A : Type) (B : Type) (a : A) (f : A -> B) : B := f a;

-- @bound(nodes <= 49)
def curry (A : Type) (B : Type) (C : Type) (f : And A B -> C) (a : A) (b : B) : C :=
    f (Conj A B a b);

-- @bound(nodes <= 47)
def uncurry (A : Type) (B : Type) (C : Type) (f : A -> B -> C) (h : And A B) : C :=
    match h with
    | Conj a b => f a b
    end;

-- Dependent Sigma: parameter types may mention earlier params.
inductive Exists (A : Type) (P : A -> Type) : Type :=
  | MkExists : (x : A) -> P x -> Exists A P;
