-- Hex/Base64 helpers are total over Nat byte codes; invalid decode input returns Nothing.

import "parse.ouro";

def n256 : Nat := mul 16 16;
def n65536 : Nat := mul n256 n256;
def n4096 : Nat := mul n256 16;
def n262144 : Nat := mul n65536 4;

def hex_encode_byte (b : Nat) : List Nat :=
  let q : Nat := mod_nat b n256 in
  ([hex_digit (div_nat q 16), hex_digit (mod_nat b 16)] : List Nat);

def hex_encode : List Nat -> List Nat :=
    concat_map Nat Nat hex_encode_byte;

def hex_encode_str (s : String) : String :=
    str_of_codes (hex_encode (str_codes s));

def hex_nibble (c : Nat) : Maybe Nat :=
    match is_hex c with
    | True => Just(Nat, digit_val c)
    | False => Nothing Nat
    end;

def hex_decode : List Nat -> Maybe (List Nat) :=
    fix hex_decode (cs : List Nat) : Maybe (List Nat) :=
      match cs with
      | Nil => Just(List Nat, Nil Nat)
      | Cons a rest =>
        match rest with
        | Nil => Nothing (List Nat)
        | Cons b rest2 =>
          match hex_nibble a with
          | Nothing => Nothing (List Nat)
          | Just hi =>
            match hex_nibble b with
            | Nothing => Nothing (List Nat)
            | Just lo =>
              match hex_decode rest2 with
              | Nothing => Nothing (List Nat)
              | Just xs => Just(List Nat, Cons Nat (add(mul hi 16, lo)) xs)
              end
            end
          end
        end
      end;

def hex_decode_str (s : String) : Maybe String :=
    match hex_decode (str_codes (str_filter is_hex s)) with
    | Nothing => Nothing String
    | Just cs => Just(String, str_of_codes cs)
    end;

def b64_alphabet : String :=
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

def b64_char (n : Nat) : Nat :=
    nth(Nat, ch_A, mod_nat n 64, str_codes b64_alphabet);

def b64_val (c : Nat) : Maybe Nat :=
    index_of Nat eq_nat c (str_codes b64_alphabet);

def b64_pad : Nat := 61;

def b64_quad (n : Nat) (c2 : Nat) (c3 : Nat) : List Nat :=
    ([b64_char (div_nat n n262144), b64_char (mod_nat(div_nat n n4096, 64)), c2, c3] : List Nat);

def pack3 (a : Nat) (b : Nat) (c : Nat) : List Nat :=
    let n : Nat := add (mul(mod_nat a n256, n65536))
                     (add(mul(mod_nat b n256, n256), mod_nat c n256)) in
    b64_quad(n, b64_char (mod_nat(div_nat n 64, 64)), b64_char (mod_nat n 64));

def b64_encode : List Nat -> List Nat :=
    fix b64_encode (bs : List Nat) : List Nat :=
      match bs with
      | Nil => Nil Nat
      | Cons a rest =>
        match rest with
        | Nil =>
          b64_quad (mul(mod_nat a n256, n65536)) b64_pad b64_pad
        | Cons b rest2 =>
          match rest2 with
          | Nil =>
            let n : Nat := add(mul(mod_nat a n256, n65536), mul(mod_nat b n256, n256)) in
            b64_quad n (b64_char (mod_nat(div_nat n 64, 64))) b64_pad
          | Cons c rest3 =>
            append(Nat, pack3 a b c, b64_encode rest3)
          end
        end
      end;

def b64_encode_str (s : String) : String :=
    str_of_codes (b64_encode (str_codes s));

def xor_byte (a : Nat) (b : Nat) : Nat :=
    (fix go (fuel : Nat) (x : Nat) (y : Nat) (bit : Nat) (acc : Nat) : Nat :=
      match fuel with
      | Z => acc
      | S fuel2 =>
        let xb : Nat := mod_nat x 2 in
        let yb : Nat := mod_nat y 2 in
        let bitv : Nat := match eq_nat xb yb with | True => 0 | False => bit end in
        go(fuel2, div_nat x 2, div_nat y 2, mul bit 2, add acc bitv)
      end) 8 (mod_nat a n256) (mod_nat b n256) 1 Z;

def xor_bytes : List Nat -> List Nat -> List Nat :=
    zip_with Nat Nat Nat xor_byte;

def bytes_eq : List Nat -> List Nat -> Bool :=
    fix bytes_eq (a : List Nat) (b : List Nat) : Bool :=
      match a with
      | Nil =>
        match b with
        | Nil => True
        | Cons _ _ => False
        end
      | Cons x xs =>
        match b with
        | Nil => False
        | Cons y ys => andb(eq_nat x y, bytes_eq xs ys)
        end
      end;
