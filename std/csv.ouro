-- CSV support is deliberately bounded: comma fields plus one quote pair, no full RFC state machine.

import "format.ouro";

-- Separator is std/char.ouro's ch_comma; imports flatten into one namespace,
-- so redefining it here would emit the same global twice.

inductive CsvCell : Type :=
  | MkCell : String -> CsvCell;

inductive CsvRow : Type :=
  | MkRow : List String -> CsvRow;

inductive CsvTable : Type :=
  | MkTable : List (List String) -> CsvTable;

def csv_unescape (s : String) : String :=
    match andb(str_starts s "\"", str_ends s "\"") with
    | False => s
    | True =>
      let inner : String := str_slice s 1 (sub(str_len s, 2)) in
      str_replace inner "\"\"" "\""
    end;

def csv_escape (s : String) : String :=
    match orb(str_contains s ",", orb(str_contains s "\"", str_contains s "\n")) with
    | False => s
    | True => str_cat3 "\"" (str_replace s "\"" "\"\"") "\""
    end;

def csv_split_row (s : String) : List String :=
    (fix go (fuel : Nat) (cs : List Nat) (cur : List Nat) (in_q : Bool) (acc : List String) : List String :=
      match fuel with
      | Z => reverse_lin(String, Cons String (str_of_codes (reverse_lin Nat cur)) acc)
      | S fuel2 =>
        match cs with
        | Nil => reverse_lin(String, Cons String (str_of_codes (reverse_lin Nat cur)) acc)
        | Cons c rest =>
          match in_q with
          | True =>
            match eq_nat c ch_quote with
            | True =>
              match rest with
              | Cons c2 rest2 =>
                match eq_nat c2 ch_quote with
                | True => go fuel2 rest2 (Cons Nat ch_quote cur) True acc
                | False => go fuel2 rest cur False acc
                end
              | Nil => go fuel2 rest cur False acc
              end
            | False => go fuel2 rest (Cons Nat c cur) True acc
            end
          | False =>
            match eq_nat c ch_quote with
            | True => go fuel2 rest cur True acc
            | False =>
              match eq_nat c ch_comma with
              | True =>
                go fuel2 rest (Nil Nat) False
                  (Cons String (str_of_codes (reverse_lin Nat cur)) acc)
              | False => go fuel2 rest (Cons Nat c cur) False acc
              end
            end
          end
        end
      end) (S (str_len s)) (str_codes s) (Nil Nat) False (Nil String);

def csv_parse (s : String) : List (List String) :=
    map String (List String) csv_split_row
      (filter(String, fun (ln : String) => notb (str_null (str_trim ln)), str_lines s));

def csv_join_row (cols : List String) : String :=
    str_join(",", map String String csv_escape cols);

def csv_print (rows : List (List String)) : String :=
    unlines (map (List String) String csv_join_row rows);

def csv_col (rows : List (List String)) (i : Nat) : List String :=
    map(List String, String, fun (r : List String) => nth String "" i r, rows);

def csv_header (rows : List (List String)) : List String :=
    match rows with
    | Nil => Nil String
    | Cons h _ => h
    end;

def csv_lookup_col (header : List String) (name : String) : Maybe Nat :=
    index_of String str_eq name header;

def csv_get (rows : List (List String)) (row : Nat) (col : Nat) : String :=
    nth String "" col (nth(List String, Nil String, row, rows));

def csv_nrows (rows : List (List String)) : Nat :=
    length(List String, rows);

def csv_ncols (rows : List (List String)) : Nat :=
    match rows with
    | Nil => Z
    | Cons r _ => length String r
    end;

def tsv_split_row (s : String) : List String :=
    str_split s 9;

def tsv_parse (s : String) : List (List String) :=
    map String (List String) tsv_split_row
      (filter(String, fun (ln : String) => notb (str_null ln), str_lines s));

def tsv_print (rows : List (List String)) : String :=
    unlines (map(List String, String, str_join "\t", rows));

def pipe_parse (s : String) : List (List String) :=
    map String (List String)
      (fun (ln : String) => str_split ln ch_pipe)
      (filter(String, fun (ln : String) => notb (str_null ln), str_lines s));

def pipe_lookup (table : String) (key : String) : Maybe String :=
    (fix go (rows : List (List String)) : Maybe String :=
      match rows with
      | Nil => Nothing String
      | Cons r rest =>
        match r with
        | Cons k vs =>
          match str_eq k key with
          | True => Just(String, str_join "|" vs)
          | False => go rest
          end
        | Nil => go rest
        end
      end) (pipe_parse table);
