-- SHA-256 digests and HMAC-SHA256 message authentication in Ouro.
-- Both use the 32-bit operations in `std/word.ouro`.

import "word.ouro",
  "bytes.ouro";

def n64 : Nat := mul 32 2;
def n48 : Nat := add 32 16;
def n56 : Nat := add n48 8;
def b80 : Nat := mul 16 8;
def b36 : Nat := add 32 22;
def b5c : Nat := add 64 28;

def sha256_h0_hex : String :=
    "6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19";

def sha256_k_hex : String :=
    "";

def pack_words : List Nat -> List Nat :=
  fix pack_words (bs : List Nat) : List Nat :=
    match bs with
    | Nil => Nil Nat
    | Cons a rest =>
      match rest with
      | Nil => Nil Nat
      | Cons b rest2 =>
        match rest2 with
        | Nil => Nil Nat
        | Cons c rest3 =>
          match rest3 with
          | Nil => Nil Nat
          | Cons d rest4 =>
            Cons(Nat, w32_of_bytes a b c d, pack_words rest4)
          end
        end
      end
    end;

def words_of_hex (hex : String) : List Nat :=
    match hex_decode (str_codes hex) with
    | Nothing => Nil Nat
    | Just bs => pack_words bs
    end;

def sha256_k : List Nat := words_of_hex sha256_k_hex;
def sha256_iv : List Nat := words_of_hex sha256_h0_hex;

def take_fuel (A : Type) : Nat -> List A -> List A :=
  fix take_fuel (n : Nat) (xs : List A) : List A :=
    match n with
    | Z => Nil A
    | S n2 =>
      match xs with
      | Nil => Nil A
      | Cons x rest => Cons A x (take_fuel n2 rest)
      end
    end;

def drop_fuel (A : Type) : Nat -> List A -> List A :=
  fix drop_fuel (n : Nat) (xs : List A) : List A :=
    match n with
    | Z => xs
    | S n2 =>
      match xs with
      | Nil => Nil A
      | Cons _ rest => drop_fuel n2 rest
      end
    end;

def be64_len (bitlen : Nat) : List Nat :=
    [ Z
    , Z
    , Z
    , Z
    , w32_b0 bitlen
    , w32_b1 bitlen
    , w32_b2 bitlen
    , w32_b3 bitlen
    ];

def sha256_pad (bs : List Nat) : List Nat :=
    let n : Nat := length Nat bs in
    let with1 : List Nat := append Nat bs [b80] in
    let rem : Nat := mod_nat(length Nat with1, n64) in
    let zeros : Nat :=
      match leb_nat rem n56 with
      | True => sub n56 rem
      | False => add(sub n64 rem, n56)
      end in
    append(Nat, append Nat with1 (replicate Nat Z zeros), be64_len (mul n 8));

def ch32 (e : Nat) (f : Nat) (g : Nat) : Nat :=
    xor32(and32 e f, and32(not32 e, g));

def maj32 (a : Nat) (b : Nat) (c : Nat) : Nat :=
    xor32(xor32(and32 a b, and32 a c), and32 b c);

def sig0 (x : Nat) : Nat :=
    xor32(xor32(rotr32 x 7, rotr32 x 18), shr32 x 3);

def sig1 (x : Nat) : Nat :=
    xor32(xor32(rotr32 x 17, rotr32 x 19), shr32 x 10);

def sum0 (x : Nat) : Nat :=
    xor32(xor32(rotr32 x 2, rotr32 x 13), rotr32 x 22);

def sum1 (x : Nat) : Nat :=
    xor32(xor32(rotr32 x 6, rotr32 x 11), rotr32 x 25);

inductive ShaSt : Type :=
  | MkSha : Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> ShaSt;

def sha_from_list (xs : List Nat) : ShaSt :=
    MkSha (nth Nat Z Z xs) (nth Nat Z 1 xs) (nth Nat Z 2 xs)
      (nth Nat Z 3 xs) (nth Nat Z 4 xs) (nth Nat Z 5 xs)
      (nth Nat Z 6 xs) (nth Nat Z 7 xs);

def sha_to_bytes (st : ShaSt) : List Nat :=
    match st with
    | MkSha a b c d e f g h =>
      append Nat
        (append Nat
          [ w32_b0 a
          , w32_b1 a
          , w32_b2 a
          , w32_b3 a
          , w32_b0 b
          , w32_b1 b
          , w32_b2 b
          , w32_b3 b
          , w32_b0 c
          , w32_b1 c
          , w32_b2 c
          , w32_b3 c
          , w32_b0 d
          , w32_b1 d
          , w32_b2 d
          , w32_b3 d
          ]
          [ w32_b0 e
          , w32_b1 e
          , w32_b2 e
          , w32_b3 e
          , w32_b0 f
          , w32_b1 f
          , w32_b2 f
          , w32_b3 f
          ])
        [ w32_b0 g
        , w32_b1 g
        , w32_b2 g
        , w32_b3 g
        , w32_b0 h
        , w32_b1 h
        , w32_b2 h
        , w32_b3 h
        ]
    end;

def w_at (ws : List Nat) (i : Nat) : Nat := nth Nat Z i ws;

def w_extend (w0 : List Nat) : List Nat :=
    -- Backward offsets before the start of a short schedule select its first word.
    let first : Nat := head Nat Z w0 in
    (fix go (fuel : Nat) (recent : List Nat) : List Nat :=
      match fuel with
      | Z => reverse_lin Nat recent
      | S fuel2 =>
        let s0 : Nat := sig0 (nth Nat first 14 recent) in
        let s1 : Nat := sig1 (nth Nat first 1 recent) in
        let wt : Nat :=
          add32 (add32(nth Nat first 15 recent, s0))
            (add32(nth Nat first 6 recent, s1)) in
        go(fuel2, Cons Nat wt recent)
      end) n48 (reverse_lin Nat w0);

def sha_round (k : Nat) (w : Nat) (st : ShaSt) : ShaSt :=
    match st with
    | MkSha a b c d e f g h =>
      let t1 : Nat := h |> add32 (sum1 e) |> add32 (ch32 e f g) |> add32 k |> add32 w in
      let t2 : Nat := add32(sum0 a, maj32 a b c) in
      MkSha (add32 t1 t2) a b c (add32 d t1) e f g
    end;

def sha_compress (st : ShaSt) (block : List Nat) : ShaSt :=
    let w : List Nat := w_extend (pack_words block) in
    let mid : ShaSt :=
      (fix go (fuel : Nat) (keys : List Nat) (words : List Nat) (cur : ShaSt) : ShaSt :=
        match fuel with
        | Z => cur
        | S fuel2 =>
          go fuel2 (tail Nat keys) (tail Nat words)
            (sha_round(head Nat Z keys, head Nat Z words, cur))
        end) n64 sha256_k w st in
    match st with
    | MkSha a0 b0 c0 d0 e0 f0 g0 h0 =>
      match mid with
      | MkSha a b c d e f g h =>
        MkSha (add32 a0 a) (add32 b0 b) (add32 c0 c) (add32 d0 d)
          (add32 e0 e) (add32 f0 f) (add32 g0 g) (add32 h0 h)
      end
    end;

def sha_blocks : Nat -> List Nat -> ShaSt -> ShaSt :=
  fix sha_blocks (fuel : Nat) (bs : List Nat) (st : ShaSt) : ShaSt :=
    match fuel with
    | Z => st
    | S fuel2 =>
      match bs with
      | Nil => st
      | Cons _ _ =>
        sha_blocks fuel2 (drop_fuel Nat n64 bs)
          (sha_compress(st, take_fuel Nat n64 bs))
      end
    end;

def sha256_bytes (bs : List Nat) : List Nat :=
    let padded : List Nat := sha256_pad bs in
    let blocks : Nat := add(1, div_nat(length Nat padded, n64)) in
    sha_to_bytes (sha_blocks blocks padded (sha_from_list sha256_iv));

def sha256 (s : String) : String :=
    str_of_codes (hex_encode (sha256_bytes (str_codes s)));

def key_block (key : List Nat) : List Nat :=
    let k : List Nat :=
      match leb_nat(length Nat key, n64) with
      | True => key
      | False => sha256_bytes key
      end in
    append Nat k (replicate Nat Z (sub(n64, length Nat k)));

def hmac_sha256_bytes (key : List Nat) (msg : List Nat) : List Nat :=
    let k : List Nat := key_block key in
    let ipad : List Nat := zip_with Nat Nat Nat xor_byte k (replicate Nat b36 n64) in
    let opad : List Nat := zip_with Nat Nat Nat xor_byte k (replicate Nat b5c n64) in
    sha256_bytes (append Nat opad (sha256_bytes (append Nat ipad msg)));

def hmac_sha256 (key : String) (msg : String) : String :=
    str_of_codes (hex_encode (hmac_sha256_bytes(str_codes key, str_codes msg)));

-- Count failures retain the attempted total byte count.
inductive Sha256StreamError : Type :=
  | Sha256StreamInvalidState : Sha256StreamError
  | Sha256StreamByteLimitExceeded : Nat -> Sha256StreamError;

-- A stream state stores the total byte count, eight hash words, and a binary tail
-- of at most 63 bytes. Update and finalization check the state shape.
-- A directly constructed state relies on the caller to supply the correct hash history.
inductive Sha256Stream : Type :=
  | Sha256StreamOf : Nat -> ShaSt -> String -> Sha256Stream;

-- The existing length encoder retains only 32 bit-length bits.
def sha256_stream_byte_limit : Nat := pow_nat 2 29;

def sha256_stream_init : Sha256Stream :=
    Sha256StreamOf Z (sha_from_list sha256_iv) "";

def sha256_stream_error_code (cause : Sha256StreamError) : String :=
    match cause with
    | Sha256StreamInvalidState => "sha256_stream_invalid_state"
    | Sha256StreamByteLimitExceeded _ => "sha256_stream_byte_limit"
    end;

def sha256_stream_error_message (cause : Sha256StreamError) : String :=
    match cause with
    | Sha256StreamInvalidState => "SHA-256 stream state has invalid words, count or tail"
    | Sha256StreamByteLimitExceeded count =>
      str_cat3 "SHA-256 stream byte count " (str_of_nat count) " must be below 536870912"
    end;

private def sha256_stream_words_valid (hash : ShaSt) : Bool :=
    match hash with
    | MkSha a b c d e f g h =>
      let limit : Nat := mul n65536 n65536 in
      andb (andb(ltb_nat a limit, ltb_nat b limit))
        (andb (andb(ltb_nat c limit, ltb_nat d limit))
          (andb (andb(ltb_nat e limit, ltb_nat f limit))
            (andb(ltb_nat g limit, ltb_nat h limit))))
    end;

private def sha256_stream_checked_count (state : Sha256Stream)
    : Either Sha256StreamError Nat :=
    match state with
    | Sha256StreamOf count hash tail =>
      if ltb_nat count sha256_stream_byte_limit then
        if andb (sha256_stream_words_valid hash)
            (andb(ltb_nat (str_len tail) n64, eq_nat (str_len tail) (mod_nat count n64))) then
          Right Sha256StreamError Nat count
        else Left Sha256StreamError Nat Sha256StreamInvalidState
      else Left Sha256StreamError Nat (Sha256StreamByteLimitExceeded count)
    end;

private def sha256_stream_advance (count : Nat) (bytes : Nat)
    : Either Sha256StreamError Nat :=
    let total : Nat := add count bytes in
    if ltb_nat total sha256_stream_byte_limit then Right Sha256StreamError Nat total
    else Left Sha256StreamError Nat (Sha256StreamByteLimitExceeded total);

-- Only complete 64-byte blocks become byte lists; the residual tail stays packed.
private def sha256_stream_feed (total : Nat) (chunk : String)
    : Nat -> Nat -> ShaSt -> String -> Either Sha256StreamError Sha256Stream :=
    fix feed (blocks : Nat) (offset : Nat) (hash : ShaSt) (tail : String)
        : Either Sha256StreamError Sha256Stream :=
      let needed : Nat := sub n64 (str_len tail) in
      let remaining : Nat := sub (str_len chunk) offset in
      if ltb_nat remaining needed then
        Right Sha256StreamError Sha256Stream (Sha256StreamOf total hash
          (str_concat tail (str_slice chunk offset remaining)))
      else
        match blocks with
        | Z => Left Sha256StreamError Sha256Stream Sha256StreamInvalidState
        | S rest =>
          let block : String := str_concat tail (str_slice chunk offset needed) in
          feed rest (add offset needed) (sha_compress hash (str_codes block)) ""
        end;

-- Append exact binary bytes, including NUL; reject invalid state or total >= 512 MiB.
def sha256_stream_update (state : Sha256Stream) (chunk : String)
    : Either Sha256StreamError Sha256Stream :=
    match state with
    | Sha256StreamOf _ hash tail =>
      let? (Left, Right) : Either Sha256StreamError Sha256Stream do
        let count : Nat := (sha256_stream_checked_count state)?;
        let total : Nat := (sha256_stream_advance count (str_len chunk))?;
        let updated : Sha256Stream :=
          (sha256_stream_feed total chunk (div_nat (add (str_len tail) (str_len chunk)) n64)
            Z hash tail)?;
        updated
      end
    end;

-- Return lowercase hex without consuming the immutable state.
def sha256_stream_final (state : Sha256Stream) : Either Sha256StreamError String :=
    match state with
    | Sha256StreamOf _ hash tail =>
      let? (Left, Right) : Either Sha256StreamError String do
        let count : Nat := (sha256_stream_checked_count state)?;
        let with1 : List Nat := append Nat (str_codes tail) [b80];
        let rem : Nat := length Nat with1;
        let zeros : Nat :=
          if leb_nat rem n56 then sub n56 rem else add (sub n64 rem) n56;
        -- Padding includes the length of blocks already compressed.
        let padded : List Nat :=
          append Nat (append Nat with1 (replicate Nat Z zeros)) (be64_len (mul count 8));
        str_of_codes (hex_encode (sha_to_bytes (sha_blocks 2 padded hash)))
      end
    end;
