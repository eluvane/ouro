-- Practical table transforms layered over header-aware CSV tables.

import "table.ouro";
import "validation.ouro";

def tablex_filter_rows (rows : List (List String)) (p : List String -> Bool) : List (List String) :=
    match rows with
    | Nil => Nil (List String)
    | Cons header body => Cons (List String) header (filter (List String) p body)
    end;

def tablex_map_rows (rows : List (List String)) (f : List String -> List String) : List (List String) :=
    match rows with
    | Nil => Nil (List String)
    | Cons header body => Cons (List String) header (map (List String) (List String) f body)
    end;

def tablex_filter_records (rows : List (List String)) (p : Map String -> Bool) : List (Map String) :=
    filter (Map String) p (table_records rows);

def tablex_map_records (A : Type) (rows : List (List String)) (f : Map String -> A) : List A :=
    map (Map String) A f (table_records rows);

def tablex_has_column (header : List String) (name : String) : Bool :=
    match table_require_col header name with
    | Left _ => False
    | Right _ => True
    end;

def tablex_require_column (header : List String) (name : String) : Validation String Unit :=
    match table_require_col header name with
    | Left msg => invalid String Unit msg
    | Right _ => valid String Unit MkUnit
    end;

def tablex_validate_columns (header : List String) : List String -> Validation String Unit :=
    fix tablex_validate_columns (names : List String) : Validation String Unit :=
      match names with
      | Nil => valid String Unit MkUnit
      | Cons name rest => validation_and String (tablex_require_column header name) (tablex_validate_columns rest)
      end;

def tablex_project_required (rows : List (List String)) (names : List String) : Validation String (List (List String)) :=
    let header : List String :=
      match rows with
      | Nil => Nil String
      | Cons first _ => first
      end in
    match tablex_validate_columns header names with
    | Left errors => Left (List String) (List (List String)) errors
    | Right _ => Right (List String) (List (List String)) (table_project rows names)
    end;

def tablex_record_get_or (row : Map String) (name : String) (fallback : String) : String :=
    fromMaybe String fallback (table_lookup row name);

def tablex_row_matches (header : List String) (name : String) (want : String) (row : List String) : Bool :=
    match table_cell header row name with
    | Nothing => False
    | Just got => str_eq got want
    end;

def tablex_select_where_eq (rows : List (List String)) (name : String) (want : String) : List (List String) :=
    match rows with
    | Nil => Nil (List String)
    | Cons header body =>
      Cons (List String) header
        (filter (List String) (tablex_row_matches header name want) body)
    end;

def tablex_count_where (rows : List (List String)) (name : String) (want : String) : Nat :=
    table_count_rows (tablex_select_where_eq rows name want);

def tablex_csv_project (text : String) (names : List String) : String :=
    table_to_csv (table_project (table_from_csv text) names);

def tablex_csv_project_required (text : String) (names : List String) : Validation String String :=
    validation_map String (List (List String)) String table_to_csv
      (tablex_project_required (table_from_csv text) names);
