-- Tactics are data only; this module does not add proof automation to the kernel.

inductive Lst (A : Type) : Type :=
  | Nil : Lst A
  | Cons : A -> Lst A -> Lst A;

inductive Bool : Type :=
  | True : Bool
  | False : Bool;

-- @minimal
-- @bound(nodes <= 17)
def andb (x : Bool) (y : Bool) : Bool :=
    match x with | True => y | False => False end;

-- @minimal
-- @bound(nodes <= 17)
def orb (x : Bool) (y : Bool) : Bool :=
    match x with | True => True | False => y end;

inductive Ty : Type :=
  | Closed : Ty
  | Base : Ty
  | Arrow : Ty -> Ty -> Ty;

-- @bound(nodes <= 64)
def eqTy : Ty -> Ty -> Bool :=
  fix eqTy (a : Ty) : Ty -> Bool :=
    match a with
    | Closed =>
      fun (b : Ty) =>
        match b with | Closed => True | Base => False | Arrow _ _ => False end
    | Base =>
      fun (b : Ty) =>
        match b with | Base => True | Closed => False | Arrow _ _ => False end
    | Arrow a1 a2 =>
      fun (b : Ty) =>
        match b with
        | Arrow b1 b2 => andb (eqTy a1 b1) (eqTy a2 b2)
        | Closed => False
        | Base => False
        end
    end;

inductive Goal : Type :=
  | MkGoal : Lst Ty -> Ty -> Goal;

inductive Result (A : Type) : Type :=
  | Ok : A -> Result A
  | Fail : Result A;

inductive Tactic : Type :=
  | Intro : Tactic
  | Exact : Ty -> Tactic
  | Apply : Ty -> Tactic
  | Assumption : Tactic
  | Then : Tactic -> Tactic -> Tactic;

-- @bound(nodes <= 34)
def inCtx (t : Ty) : Lst Ty -> Bool :=
    fix inCtx (xs : Lst Ty) : Bool :=
      match xs with
      | Nil => False
      | Cons h tl => orb (eqTy t h) (inCtx tl)
      end;

-- Target a->b: extend context with a, target b.
-- @bound(nodes <= 39)
def introStep (g : Goal) : Result Goal :=
    match g with
    | MkGoal ctx target =>
      match target with
      | Arrow a b => Ok Goal (MkGoal (Cons Ty a ctx) b)
      | Base => Fail Goal
      | Closed => Fail Goal
      end
    end;

-- @bound(nodes <= 33)
def assumptionStep (g : Goal) : Result Goal :=
    match g with
    | MkGoal ctx target =>
      match inCtx target ctx with
      | True => Ok Goal (MkGoal ctx Closed)
      | False => Fail Goal
      end
    end;

-- @bound(nodes <= 37)
def exactStep (t : Ty) (g : Goal) : Result Goal :=
    match g with
    | MkGoal ctx target =>
      match eqTy t target with
      | True => Ok Goal (MkGoal ctx Closed)
      | False => Fail Goal
      end
    end;

-- If f : a->b and b matches target, remaining subgoal is a.
-- @bound(nodes <= 49)
def applyStep (f : Ty) (g : Goal) : Result Goal :=
    match g with
    | MkGoal ctx target =>
      match f with
      | Arrow a b =>
        match eqTy b target with
        | True => Ok Goal (MkGoal ctx a)
        | False => Fail Goal
        end
      | Base => Fail Goal
      | Closed => Fail Goal
      end
    end;

-- @bound(nodes <= 35)
def bind (r : Result Goal) (k : Goal -> Result Goal) : Result Goal :=
    match r with
    | Ok g => k g
    | Fail => Fail Goal
    end;

-- Interpret one tactic; Then sequences.
-- @bound(nodes <= 58)
def runStep : Tactic -> Goal -> Result Goal :=
  fix runStep (t : Tactic) : Goal -> Result Goal :=
    fun (g : Goal) =>
      match t with
      | Intro => introStep g
      | Assumption => assumptionStep g
      | Exact ty => exactStep ty g
      | Apply ty => applyStep ty g
      | Then t1 t2 => bind (runStep t1 g) (fun (g2 : Goal) => runStep t2 g2)
      end;

-- @bound(nodes <= 31)
def seq (t1 : Tactic) (t2 : Tactic) (g : Goal) : Result Goal :=
    bind (runStep t1 g) (fun (g2 : Goal) => runStep t2 g2);

-- @minimal
-- @bound(nodes <= 19)
def isSolved (g : Goal) : Bool :=
    match g with
    | MkGoal _ target =>
      match target with | Closed => True | Base => False | Arrow _ _ => False end
    end;

-- Demo: Base -> Base by intro; assumption.
-- @minimal
-- @bound(nodes <= 13)
def demoGoal : Goal := MkGoal (Nil Ty) (Arrow Base Base);
-- @minimal
-- @bound(nodes <= 7)
def demoScript : Tactic := Then Intro Assumption;
-- @minimal
-- @bound(nodes <= 9)
def demoResult : Result Goal := runStep demoScript demoGoal;
