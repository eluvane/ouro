-- Exclusive creation of one final directory using the Windows native backend.
import "io.ouro",
  "fs_create_model.ouro",
  "../runtime/platform/windows_fs_create.ouro";

-- Create only the final directory. Existing files/directories and missing
-- parents are errors. No exists/mkdir-p fallback, retry, removal or rollback.
-- A cleanup error retains whether the directory was already created.
def fs_create_dir_exclusive_checked (path : String) : IO (Either FsCreateDirError Unit) :=
    windows_fs_create_checked path;
