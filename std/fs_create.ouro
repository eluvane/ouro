import "io.ouro",
  "fs_create_model.ouro",
  "../runtime/platform/windows_fs_create.ouro";

-- Create only the final directory on the Windows native backend. The parent
-- must exist and the target must be absent. The operation makes one creation
-- attempt. A cleanup error records whether that attempt created the directory.
def fs_create_dir_exclusive_checked (path : String) : IO (Either FsCreateDirError Unit) :=
    windows_fs_create_checked path;
