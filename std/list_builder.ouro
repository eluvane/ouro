import "listx.ouro";

-- Persistent builder with reversed storage. Push is constant time;
-- finish restores insertion order in linear time.
inductive ListBuilder (A : Type) : Type :=
  | MkListBuilder : List A -> ListBuilder A;

def list_builder_empty (A : Type) : ListBuilder A :=
    MkListBuilder A (Nil A);

def list_builder_push (A : Type) (value : A)
    (builder : ListBuilder A) : ListBuilder A :=
    match builder with
    | MkListBuilder reversed => MkListBuilder A (Cons A value reversed)
    end;

def list_builder_finish (A : Type) (builder : ListBuilder A) : List A :=
    match builder with
    | MkListBuilder reversed => reverse_lin A reversed
    end;
