-- Pure UTF-8 encoding shared by source literals and JSON decoding.

import "natx.ouro";

-- Unicode scalars exclude surrogate code points and values above U+10FFFF.
def utf8_scalar_valid (value : Nat) : Bool :=
    let byte_group : Nat := mul 16 16 in
    let word_group : Nat := mul 16 byte_group in
    let plane : Nat := mul 16 word_group in
    let surrogate_start : Nat :=
        add(mul 13 word_group, mul 8 byte_group) in
    let surrogate_end : Nat := mul 14 word_group in
    andb(ltb_nat value (mul 17 plane),
      orb(ltb_nat value surrogate_start, leb_nat surrogate_end value));

-- The caller must first establish utf8_scalar_valid value.
def utf8_scalar_bytes (value : Nat) : List Nat :=
    match leb_nat value 127 with
    | True => [value]
    | False =>
      match ltb_nat(value, mul 32 64) with
      | True =>
        let high : Nat := div_nat value 64 in
        [add 192 high, add(128, sub(value, mul high 64))]
      | False =>
        let group : Nat := mul 64 64 in
        match ltb_nat(value, mul 16 group) with
        | True =>
          let high : Nat := div_nat value group in
          let rest : Nat := sub(value, mul high group) in
          let middle : Nat := div_nat rest 64 in
          [add 224 high, add 128 middle, add(128, sub(rest, mul middle 64))]
        | False =>
          let wide_group : Nat := mul 64 group in
          let high : Nat := div_nat value wide_group in
          let rest : Nat := sub(value, mul high wide_group) in
          let middle : Nat := div_nat rest group in
          let low : Nat := sub(rest, mul middle group) in
          let third : Nat := div_nat low 64 in
          [add 240 high, add 128 middle, add 128 third, add(128, sub(low, mul third 64))]
        end
      end
    end;

-- Reject invalid scalars instead of encoding an out-of-range byte sequence.
def utf8_scalar_checked (value : Nat) : Maybe (List Nat) :=
    match utf8_scalar_valid value with
    | True => Just(List Nat, utf8_scalar_bytes value)
    | False => Nothing (List Nat)
    end;
