-- String operations delegate byte semantics to trusted runtime primitives.

import "char.ouro",
  "listx.ouro",
  "runtime.ouro";

def str_len (s : String) : Nat :=
    prim_string_length s;

def str_eq (a : String) (b : String) : Bool :=
    prim_string_eq a b;

def str_concat (a : String) (b : String) : String :=
    prim_string_concat a b;

def str_cat3 (a : String) (b : String) (c : String) : String :=
    prim_string_concat(a, prim_string_concat b c);

def str_cat4 (a : String) (b : String) (c : String) (d : String) : String :=
    prim_string_concat(str_cat3 a b c, d);

def str_slice (s : String) (i : Nat) (n : Nat) : String :=
    prim_string_slice s i n;

def str_codes (s : String) : List Nat :=
    prim_string_to_char_codes s;

def str_of_codes (cs : List Nat) : String :=
    prim_string_of_char_codes cs;

def str_of_nat (n : Nat) : String :=
    prim_string_of_nat n;

def str_empty : String := "";

def str_null (s : String) : Bool :=
    eq_nat(str_len s, Z);

def str_head (s : String) : Nat :=
    prim_string_byte_at s Z;

def str_tail (s : String) : String :=
    match str_len s with
    | Z => s
    | S n => str_slice s (S Z) n
    end;

def str_cons (c : Nat) (s : String) : String :=
    str_concat(str_of_codes ([c] : List Nat), s);

def str_snoc (s : String) (c : Nat) : String :=
    str_concat(s, str_of_codes ([c] : List Nat));

def str_rev (s : String) : String :=
    str_of_codes (reverse_lin(Nat, str_codes s));

def str_starts (s : String) (pre : String) : Bool :=
    prim_string_starts s pre;

def str_ends (s : String) (suf : String) : Bool :=
    prim_string_ends s suf;

def str_contains (s : String) (pat : String) : Bool :=
    prim_string_contains s pat;

def str_index (s : String) (pat : String) : Maybe Nat :=
    prim_string_index s pat;

def str_count (s : String) (pat : String) : Nat :=
    match str_null pat with
    | True => Z
    | False =>
      let s_len : Nat := str_len s in
      let pat_len : Nat := str_len pat in
      match ltb_nat s_len pat_len with
      | True => Z
      | False =>
        (fix go (fuel : Nat) (i : Nat) (count : Nat) : Nat :=
          match fuel with
          | Z => count
          | S fuel2 =>
            match str_eq(str_slice s i pat_len, pat) with
            | True => go(fuel2, S i, S count)
            | False => go fuel2 (S i) count
            end
          end) (S (sub s_len pat_len)) Z Z
      end
    end;

def str_map (f : Nat -> Nat) (s : String) : String :=
    str_of_codes (map Nat Nat f (str_codes s));

def str_filter (p : Nat -> Bool) (s : String) : String :=
    str_of_codes (filter Nat p (str_codes s));

def str_lower (s : String) : String :=
    str_map to_lower s;

def str_upper (s : String) : String :=
    str_map to_upper s;

def str_ltrim (s : String) : String :=
    str_of_codes (drop_while Nat is_ws (str_codes s));

def str_rtrim (s : String) : String :=
    str_of_codes (reverse_lin(Nat, drop_while Nat is_ws (reverse_lin(Nat, str_codes s))));

def str_trim (s : String) : String :=
    str_rtrim (str_ltrim s);

def str_pad_left (s : String) (w : Nat) (c : Nat) : String :=
    match ltb_nat(str_len s, w) with
    | True => str_concat(str_of_codes (replicate Nat c (sub(w, str_len s))), s)
    | False => s
    end;

def str_pad_right (s : String) (w : Nat) (c : Nat) : String :=
    match ltb_nat(str_len s, w) with
    | True => str_concat(s, str_of_codes (replicate Nat c (sub(w, str_len s))))
    | False => s
    end;

def split_on (sep : Nat) : List Nat -> List (List Nat) :=
    fix split_on (cs : List Nat) : List (List Nat) :=
      match cs with
      | Nil => Cons(List Nat, Nil Nat, Nil (List Nat))
      | Cons c rest =>
        match eq_nat c sep with
        | True => Cons(List Nat, Nil Nat, split_on rest)
        | False =>
          match split_on rest with
          | Nil => Cons(List Nat, [c] : List Nat, Nil (List Nat))
          | Cons hd tl => Cons(List Nat, Cons Nat c hd, tl)
          end
        end
      end;

def str_split (s : String) (sep : Nat) : List String :=
    prim_string_split s sep;

def str_lines (s : String) : List String :=
    str_split s ch_lf;

def str_words (s : String) : List String :=
    filter(String, fun (w : String) => notb (str_null w), str_split s ch_space);

def str_join (sep : String) : List String -> String :=
    fun (xs : List String) =>
      str_of_codes
        (flatten Nat
          (intersperse (List Nat) (str_codes sep)
            (map String (List Nat) str_codes xs)));

def str_replace (s : String) (pat : String) (rep : String) : String :=
    prim_string_replace s pat rep;
