-- Higher-level checked filesystem helpers built from std/fs.

import "config.ouro";
import "fs.ouro";

def fsx_read_text (path : String) : IO (Either FsError String) :=
    fs_read_checked path;

def fsx_write_text (path : String) (content : String) : IO (Either FsError Unit) :=
    fs_write_checked path content;

def fsx_read_lines (path : String) : IO (Either FsError (List String)) :=
    io_bind (Either FsError String) (Either FsError (List String)) (fs_read_checked path)
      (fun (res : Either FsError String) =>
        match res with
        | Left e => fs_err (List String) e
        | Right text => fs_ok (List String) (str_lines text)
        end);

def fsx_write_lines (path : String) (lines : List String)
    : IO (Either FsError Unit) :=
    fs_write_checked path (str_unlines lines);

def fsx_append_line (path : String) (line : String) : IO (Either FsError Unit) :=
    fs_append_checked path (str_concat line "\n");

def fsx_remove_if_exists (path : String) : IO (Either FsError Unit) :=
    match fs_nonempty_path path with
    | Left e => fs_err Unit e
    | Right _ =>
      io_bind Bool (Either FsError Unit) (fs_exists path)
        (fun (exists : Bool) =>
          match exists with
          | False => fs_ok Unit MkUnit
          | True =>
            io_bind Unit (Either FsError Unit) (fs_remove path)
              (fun (_ : Unit) =>
                io_bind Bool (Either FsError Unit) (fs_exists path)
                  (fun (still_exists : Bool) =>
                    match still_exists with
                    | False => fs_ok Unit MkUnit
                    | True => fs_err Unit (FsOperationFailed "remove" path)
                    end))
          end)
    end;

def fsx_list_matching (dir : String) (p : String -> Bool)
    : IO (Either FsError (List String)) :=
    io_bind (Either FsError (List String)) (Either FsError (List String))
      (fs_list_checked dir)
      (fun (res : Either FsError (List String)) =>
        match res with
        | Left e => fs_err (List String) e
        | Right names => fs_ok (List String) (filter String p names)
        end);

def fsx_list_full_matching (dir : String) (p : String -> Bool)
    : IO (Either FsError (List String)) :=
    io_bind (Either FsError (List String)) (Either FsError (List String))
      (fs_list_checked dir)
      (fun (res : Either FsError (List String)) =>
        match res with
        | Left e => fs_err (List String) e
        | Right names =>
          fs_ok (List String)
            (filter String p (map String String (fs_child dir) names))
        end);

def fsx_read_config (path : String) : IO (Either FsError Config) :=
    io_bind (Either FsError String) (Either FsError Config) (fs_read_checked path)
      (fun (res : Either FsError String) =>
        match res with
        | Left e => fs_err Config e
        | Right text => fs_ok Config (config_parse text)
        end);

def fsx_write_config (path : String) (cfg : Config) : IO (Either FsError Unit) :=
    fs_write_checked path (config_render cfg);

def fsx_read_nonempty (path : String) : IO (Either FsError String) :=
    io_bind (Either FsError String) (Either FsError String) (fs_read_checked path)
      (fun (res : Either FsError String) =>
        match res with
        | Left e => fs_err String e
        | Right text =>
          match str_null text with
          | True => fs_err String (FsOperationFailed "read_nonempty" path)
          | False => fs_ok String text
          end
        end);
