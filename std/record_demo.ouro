-- Record demo is restricted to forms the direct packaged frontend already accepts.

inductive Nat : Type := | Z : Nat | S : Nat -> Nat;

record Point : Type where
  x : Nat;
  y : Nat;
end;

def origin : Point := { x := Z, y := Z };

def get_x (p : Point) : Nat := p.x;
def get_y (p : Point) : Nat := p.y;

def swap (p : Point) : Point := { x := p.y, y := p.x };
