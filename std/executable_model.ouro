-- Typed current-image path results. Numeric last-error capture is not assumed.
import "string.ouro",
  "natx.ouro";

-- Current-image query and ownership errors without a numeric Windows last-error.
-- Cleanup failure retains the prior typed error when one occurred.
inductive ExecutablePathError : Type :=
  | ExecutablePathConstantsFailed : ExecutablePathError
  | ExecutablePathAllocationFailed : ExecutablePathError
  | ExecutablePathQueryFailed : ExecutablePathError
  | ExecutablePathTruncated : ExecutablePathError
  | ExecutablePathInvalidPath : ExecutablePathError
  | ExecutablePathConversionFailed : ExecutablePathError
  | ExecutablePathInvalidCount : ExecutablePathError
  | ExecutablePathCleanupFailed : Maybe ExecutablePathError -> ExecutablePathError;

-- Stable diagnostic category for an executable-path failure.
def executable_path_error_code (error : ExecutablePathError) : String :=
    match error with
    | ExecutablePathConstantsFailed => "executable_path_constants"
    | ExecutablePathAllocationFailed => "executable_path_allocation"
    | ExecutablePathQueryFailed => "executable_path_query"
    | ExecutablePathTruncated => "executable_path_truncated"
    | ExecutablePathInvalidPath => "executable_path_invalid"
    | ExecutablePathConversionFailed => "executable_path_conversion"
    | ExecutablePathInvalidCount => "executable_path_count"
    | ExecutablePathCleanupFailed _ => "executable_path_cleanup"
    end;

-- Render an executable-path diagnostic, including a prior cleanup cause.
def executable_path_error_message (error : ExecutablePathError) : String :=
    match error with
    | ExecutablePathConstantsFailed => "current executable path: machine-word constants unavailable"
    | ExecutablePathAllocationFailed => "current executable path: buffer allocation failed"
    | ExecutablePathQueryFailed => "current executable path: GetModuleFileNameW failed"
    | ExecutablePathTruncated => "current executable path: path exceeds the UTF-16 buffer"
    | ExecutablePathInvalidPath => "current executable path: invalid terminated UTF-16 path"
    | ExecutablePathConversionFailed => "current executable path: UTF-8 conversion failed"
    | ExecutablePathInvalidCount => "current executable path: invalid UTF-8 byte count"
    | ExecutablePathCleanupFailed previous => match previous with
      | Nothing => "current executable path: buffer release failed after a successful query"
      | Just cause => str_concat("current executable path: buffer release failed after ", executable_path_error_code cause)
      end
    end;

-- The returned length excludes the terminator; nSize includes its storage.
def executable_path_query_length (actual : Nat) (capacity : Nat) : Either ExecutablePathError Nat :=
    match eq_nat actual 0 with
    | True => Left ExecutablePathError Nat ExecutablePathQueryFailed
    | False => match ltb_nat actual capacity with
      | True => Right ExecutablePathError Nat actual
      | False => Left ExecutablePathError Nat ExecutablePathTruncated
      end
    end;

def executable_path_byte_length (actual : Nat) (capacity : Nat) : Either ExecutablePathError Nat :=
    match andb(ltb_nat 0 actual, leb_nat actual capacity) with
    | True => Right ExecutablePathError Nat actual
    | False => Left ExecutablePathError Nat ExecutablePathInvalidCount
    end;

-- Preserve loaded spelling and every byte; only empty/NUL paths are rejected.
def executable_path_value (value : String) : Either ExecutablePathError String :=
    match orb(eq_nat(str_len value, 0), str_contains(value, str_of_codes ([0] : List Nat))) with
    | True => Left ExecutablePathError String ExecutablePathInvalidPath
    | False => Right ExecutablePathError String value
    end;

-- A release failure never becomes Right, even after a successful query.
def executable_path_released (result : Either ExecutablePathError String) (released : Bool)
    : Either ExecutablePathError String :=
    match released with
    | True => result
    | False => Left ExecutablePathError String (ExecutablePathCleanupFailed
        (match result with | Left error => Just ExecutablePathError error | Right _ => Nothing ExecutablePathError end))
    end;
