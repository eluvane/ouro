-- JSON-RPC framing is byte-exact: Content-Length counts the body after the blank header line.
-- Malformed envelopes decode to neutral fields so servers can still return protocol errors.

import "json.ouro",
  "map.ouro",
  "parse.ouro",
  "string_prims.ouro";

def rpc_crlf : String := "\r\n";

def rpc_header_end : String := "\r\n\r\n";

def rpc_len_key : String := "Content-Length:";

-- The space after the colon is what the base protocol specifies, and some
-- clients match the header literally; on the way in rpc_content_len trims, so
-- headers without it are still accepted.
def rpc_frame (body : String) : String :=
    str_cat4 (str_concat rpc_len_key " ") (prim_string_of_nat (str_len body))
      rpc_header_end body;

def rpc_send_json (j : Json) : String := rpc_frame (json_print j);

-- Content-Length from a header block, whichever line carries it.
def rpc_content_len (header : String) : Maybe Nat :=
    foldr String (Maybe Nat)
      (fun (line : String) (acc : Maybe Nat) =>
        match acc with
        | Just n => Just Nat n
        | Nothing =>
          match str_strip_prefix(str_trim line, rpc_len_key) with
          | Nothing => Nothing Nat
          | Just v => parse_nat (str_trim v)
          end
        end)
      (Nothing Nat) (str_split_str header rpc_crlf);

-- First complete message and the unconsumed remainder.
def rpc_take (buf : String) : Maybe (Pair String String) :=
    match str_index buf rpc_header_end with
    | Nothing => Nothing (Pair String String)
    | Just i =>
      let header : String := str_take buf i in
      let rest : String := str_drop(buf, add(i, str_len rpc_header_end)) in
      match rpc_content_len header with
      | Nothing => Nothing (Pair String String)
      | Just n =>
        match ltb_nat(str_len rest, n) with
        | True => Nothing (Pair String String)
        | False =>
          Just (Pair String String)
            (MkPair(String, String, str_take rest n, str_drop rest n))
        end
      end
    end;

-- Object fields and array elements of a value that may be neither.
def json_pairs (j : Json) : List (Pair String Json) :=
    match j with
    | JObj kvs => kvs
    | JNull => Nil (Pair String Json)
    | JBool _ => Nil (Pair String Json)
    | JNum _ => Nil (Pair String Json)
    | JStr _ => Nil (Pair String Json)
    | JArr _ => Nil (Pair String Json)
    end;

-- Envelope accessors. A missing or mistyped field reads as the neutral value
-- rather than failing, because a server must answer malformed input too.
def json_obj_get (j : Json) (k : String) : Maybe Json :=
    assoc_get String Json str_eq k (json_pairs j);

def json_items (j : Json) : List Json :=
    match j with
    | JArr xs => xs
    | JNull => Nil Json
    | JBool _ => Nil Json
    | JNum _ => Nil Json
    | JStr _ => Nil Json
    | JObj _ => Nil Json
    end;

def json_str_or (j : Json) (d : String) : String :=
    match j with
    | JStr s => s
    | JNull => d
    | JBool _ => d
    | JNum _ => d
    | JArr _ => d
    | JObj _ => d
    end;

def json_nat_or (j : Json) (d : Nat) : Nat :=
    match j with
    | JNum s => fromMaybe Nat d (parse_nat s)
    | JNull => d
    | JBool _ => d
    | JStr _ => d
    | JArr _ => d
    | JObj _ => d
    end;

def json_field_str (j : Json) (k : String) (d : String) : String :=
    maybe Json String d (fun (v : Json) => json_str_or v d) (json_obj_get j k);

def json_field_nat (j : Json) (k : String) (d : Nat) : Nat :=
    maybe Json Nat d (fun (v : Json) => json_nat_or v d) (json_obj_get j k);

def json_field (j : Json) (k : String) : Json :=
    fromMaybe Json JNull (json_obj_get j k);

def json_num (n : Nat) : Json := JNum (prim_string_of_nat n);

def rpc_method (msg : Json) : String := json_field_str msg "method" "";

def rpc_params (msg : Json) : Json := json_field msg "params";

def rpc_id (msg : Json) : Json := json_field msg "id";

-- A notification is a request without an id.
def rpc_is_notification (msg : Json) : Bool :=
    match json_field msg "id" with
    | JNull => True
    | JBool _ => False
    | JNum _ => False
    | JStr _ => False
    | JArr _ => False
    | JObj _ => False
    end;

def rpc_obj (fields : List (Pair String Json)) : Json := JObj fields;

def rpc_version_field : Pair String Json :=
    MkPair String Json "jsonrpc" (JStr "2.0");

def rpc_result (id : Json) (result : Json) : Json :=
    let fields : List (Pair String Json) :=
      [ rpc_version_field
      , MkPair String Json "id" id
      , MkPair String Json "result" result
      ] in
    rpc_obj fields;

def rpc_error_obj (code : Json) (msg : String) : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "code" code
      , MkPair String Json "message" (JStr msg)
      ] in
    rpc_obj fields;

def rpc_error (id : Json) (code : Json) (msg : String) : Json :=
    let fields : List (Pair String Json) :=
      [ rpc_version_field
      , MkPair String Json "id" id
      , MkPair String Json "error" (rpc_error_obj code msg)
      ] in
    rpc_obj fields;

def rpc_notify (method : String) (params : Json) : Json :=
    let fields : List (Pair String Json) :=
      [ rpc_version_field
      , MkPair String Json "method" (JStr method)
      , MkPair String Json "params" params
      ] in
    rpc_obj fields;

def rpc_request (id : Json) (method : String) (params : Json) : Json :=
    let fields : List (Pair String Json) :=
      [ rpc_version_field
      , MkPair String Json "id" id
      , MkPair String Json "method" (JStr method)
      , MkPair String Json "params" params
      ] in
    rpc_obj fields;

-- Standard JSON-RPC error codes (LSP uses the same numbers). They are
-- negative and Nat is not, so they stay JSON numbers written out in full.
def rpc_err_parse : Json := JNum "-32700";

def rpc_err_invalid_request : Json := JNum "-32600";

def rpc_err_method_not_found : Json := JNum "-32601";

def rpc_err_invalid_params : Json := JNum "-32602";

def rpc_err_internal : Json := JNum "-32603";
