-- ASCII predicates only; Unicode stays a String/runtime concern.

import "natx.ouro";

def ch_nul : Nat := 0;
def ch_tab : Nat := 9;
def ch_lf : Nat := 10;
def ch_cr : Nat := 13;
def ch_space : Nat := 32;
def ch_bang : Nat := 33;
def ch_quote : Nat := 34;
def ch_hash : Nat := 35;
def ch_dollar : Nat := 36;
def ch_percent : Nat := 37;
def ch_amp : Nat := 38;
def ch_squote : Nat := 39;
def ch_lparen : Nat := 40;
def ch_rparen : Nat := 41;
def ch_star : Nat := 42;
def ch_plus : Nat := 43;
def ch_comma : Nat := 44;
def ch_minus : Nat := 45;
def ch_dot : Nat := 46;
def ch_slash : Nat := 47;
def ch_zero : Nat := 48;
def ch_nine : Nat := 57;
def ch_colon : Nat := 58;
def ch_semi : Nat := 59;
def ch_lt : Nat := 60;
def ch_eq : Nat := 61;
def ch_gt : Nat := 62;
def ch_qmark : Nat := 63;
def ch_at : Nat := 64;
def ch_A : Nat := 65;
def ch_Z : Nat := 90;
def ch_lbrack : Nat := 91;
def ch_bslash : Nat := 92;
def ch_rbrack : Nat := 93;
def ch_caret : Nat := 94;
def ch_under : Nat := 95;
def ch_tick : Nat := 96;
def ch_a : Nat := 97;
def ch_z : Nat := 122;
def ch_lbrace : Nat := 123;
def ch_pipe : Nat := 124;
def ch_rbrace : Nat := 125;
def ch_tilde : Nat := 126;
def ch_del : Nat := 127;

def is_nul (c : Nat) : Bool := eq_nat c ch_nul;
def is_tab (c : Nat) : Bool := eq_nat c ch_tab;
def is_lf (c : Nat) : Bool := eq_nat c ch_lf;
def is_cr (c : Nat) : Bool := eq_nat c ch_cr;
def is_space (c : Nat) : Bool := eq_nat c ch_space;

def is_ws (c : Nat) : Bool :=
    orb (eq_nat c ch_space)
      (orb (eq_nat c ch_tab)
        (orb (eq_nat c ch_lf) (eq_nat c ch_cr)));

def is_digit (c : Nat) : Bool :=
    between ch_zero ch_nine c;

def is_upper (c : Nat) : Bool :=
    between ch_A ch_Z c;

def is_lower (c : Nat) : Bool :=
    between ch_a ch_z c;

def is_alpha (c : Nat) : Bool :=
    orb (is_upper c) (is_lower c);

def is_alnum (c : Nat) : Bool :=
    orb (is_alpha c) (is_digit c);

def is_hex (c : Nat) : Bool :=
    orb (is_digit c)
      (orb (between 65 70 c) (between 97 102 c));

def is_oct (c : Nat) : Bool :=
    between ch_zero 55 c;

def is_bin (c : Nat) : Bool :=
    orb (eq_nat c ch_zero) (eq_nat c 49);

def is_punct (c : Nat) : Bool :=
    orb (between 33 47 c)
      (orb (between 58 64 c)
        (orb (between 91 96 c) (between 123 126 c)));

def is_graph (c : Nat) : Bool :=
    between 33 126 c;

def is_print (c : Nat) : Bool :=
    between ch_space 126 c;

def is_cntrl (c : Nat) : Bool :=
    orb (leb_nat c 31) (eq_nat c ch_del);

def is_ascii (c : Nat) : Bool :=
    leb_nat c ch_del;

def is_ident_start (c : Nat) : Bool :=
    orb (is_alpha c) (eq_nat c ch_under);

-- Letters, digits, `_`, and `'` — the same continuation set as the lexer.
def is_ident_cont (c : Nat) : Bool :=
    orb (is_ident_start c) (orb (is_digit c) (eq_nat c ch_squote));

def is_snake (c : Nat) : Bool :=
    orb (is_ident_cont c) (eq_nat c ch_under);

def to_lower (c : Nat) : Nat :=
    match is_upper c with
    | True => add c 32
    | False => c
    end;

def to_upper (c : Nat) : Nat :=
    match is_lower c with
    | True => sub c 32
    | False => c
    end;

def digit_val (c : Nat) : Nat :=
    match is_digit c with
    | True => sub c ch_zero
    | False =>
      match between 65 70 c with
      | True => add (sub c 65) 10
      | False =>
        match between 97 102 c with
        | True => add (sub c 97) 10
        | False => 0
        end
      end
    end;

def hex_digit (n : Nat) : Nat :=
    match ltb_nat n 10 with
    | True => add ch_zero n
    | False => add 97 (sub n 10)
    end;

def hex_digit_upper (n : Nat) : Nat :=
    to_upper (hex_digit n);

def eq_char_ci (a : Nat) (b : Nat) : Bool :=
    eq_nat (to_lower a) (to_lower b);
