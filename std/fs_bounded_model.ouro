import "string.ouro", "natx.ouro";

inductive FsBoundedReadError : Type :=
  | FsBoundedReadInvalidPath : FsBoundedReadError
  | FsBoundedReadPathTooLong : FsBoundedReadError
  | FsBoundedReadTooLarge : Nat -> Nat -> FsBoundedReadError
  | FsBoundedReadUnsafeEntry : FsBoundedReadError
  | FsBoundedReadChanged : FsBoundedReadError
  | FsBoundedReadOsError : String -> Nat -> FsBoundedReadError;

def fs_bounded_read_error_code (error : FsBoundedReadError) : String :=
    match error with
    | FsBoundedReadInvalidPath => "fs_bounded_read_invalid_path"
    | FsBoundedReadPathTooLong => "fs_bounded_read_path_too_long"
    | FsBoundedReadTooLarge _ _ => "fs_bounded_read_too_large"
    | FsBoundedReadUnsafeEntry => "fs_bounded_read_unsafe_entry"
    | FsBoundedReadChanged => "fs_bounded_read_changed"
    | FsBoundedReadOsError _ _ => "fs_bounded_read_os"
    end;

def fs_bounded_read_error_message (error : FsBoundedReadError) : String :=
    match error with
    | FsBoundedReadInvalidPath => "bounded file read: empty or NUL-containing path"
    | FsBoundedReadPathTooLong => "bounded file read: path exceeds native path storage"
    | FsBoundedReadTooLarge cap size => str_cat4 "bounded file read: size " (str_of_nat size)
        " exceeds byte cap " (str_of_nat cap)
    | FsBoundedReadUnsafeEntry => "bounded file read: directory or final reparse point"
    | FsBoundedReadChanged => "bounded file read: file length changed while reading"
    | FsBoundedReadOsError phase status => str_cat4 "bounded file read: " phase
        " OS status=" (str_of_nat status)
    end;

def fs_bounded_read_path_length (path : String) (capacity : Nat) : Either FsBoundedReadError Nat :=
    let bytes : Nat := str_len path in
    match eq_nat bytes 0 with
    | True => Left FsBoundedReadError Nat FsBoundedReadInvalidPath
    | False => match leb_nat bytes capacity with
      | False => Left FsBoundedReadError Nat FsBoundedReadPathTooLong
      | True => match elem Nat eq_nat 0 (str_codes path) with
        | True => Left FsBoundedReadError Nat FsBoundedReadInvalidPath
        | False => Right FsBoundedReadError Nat bytes
        end end end;

def fs_bounded_read_length (cap : Nat) (size : Nat) : Either FsBoundedReadError Nat :=
    match leb_nat size cap with
    | True => Right FsBoundedReadError Nat size
    | False => Left FsBoundedReadError Nat (FsBoundedReadTooLarge cap size)
    end;
