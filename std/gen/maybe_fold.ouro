-- Generated: Type-level Maybe fold skeleton.
inductive GenMaybe : Type :=
  | GenNothing : GenMaybe
  | GenJust : Type -> GenMaybe;

def gen_maybe : Type -> (Type -> Type) -> GenMaybe -> Type :=
  fun (d : Type) =>
    fun (f : Type -> Type) =>
      fun (m : GenMaybe) =>
        match m with
        | GenNothing => d
        | GenJust x => f x
        end;
