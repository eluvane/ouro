-- Bounded line-oriented data processing over in-memory text.

import "collections.ouro",
  "csv.ouro",
  "fsx.ouro",
  "report.ouro",
  "text.ouro";

inductive LineRecord : Type :=
  | MkLineRecord : Nat -> String -> LineRecord;

def line_record_number (r : LineRecord) : Nat :=
    match r with
    | MkLineRecord n _ => n
    end;

def line_record_text (r : LineRecord) : String :=
    match r with
    | MkLineRecord _ text => text
    end;

def lines_from_text (text : String) : List String := str_lines text;

def lines_to_text (lines : List String) : String := str_unlines lines;

def line_nonblank (line : String) : Bool := notb (str_is_blank line);

def line_is_comment (prefix : String) (line : String) : Bool :=
    str_starts(str_trim line, prefix);

def line_without_comments (prefix : String) (lines : List String) : List String :=
    filter String (fun (line : String) => notb (line_is_comment prefix line)) lines;

def line_nonblank_only (lines : List String) : List String :=
    filter String line_nonblank lines;

def line_data_lines (comment_prefix : String) (lines : List String) : List String :=
    line_nonblank_only (line_without_comments comment_prefix lines);

def line_number_from (start : Nat) (lines : List String) : List LineRecord :=
    map_indexed String LineRecord
      (fun (i : Nat) (line : String) => MkLineRecord(add start i, line))
      lines;

def line_number (lines : List String) : List LineRecord :=
    line_number_from 1 lines;

def line_map (f : String -> String) (lines : List String) : List String :=
    map String String f lines;

def line_filter (p : String -> Bool) (lines : List String) : List String :=
    filter String p lines;

def line_fold (A : Type) (f : A -> String -> A) (z : A) (lines : List String) : A :=
    foldl String A f z lines;

def line_count (lines : List String) : Nat := length String lines;

def line_count_where (p : String -> Bool) (lines : List String) : Nat :=
    count_if String p lines;

def line_take (n : Nat) (lines : List String) : List String := take String n lines;

def line_drop (n : Nat) (lines : List String) : List String := drop String n lines;

def line_head (n : Nat) (lines : List String) : List String := line_take n lines;

def line_tail (n : Nat) (lines : List String) : List String := list_take_last String n lines;

def line_chunks (n : Nat) (lines : List String) : List (List String) :=
    chunks_of String n lines;

def line_fields_ws (line : String) : List String := str_tokens line;

def line_fields_char (sep : Nat) (line : String) : List String := str_split line sep;

def line_field_ws_or (fallback : String) (index : Nat) (line : String) : String :=
    nth String fallback index (line_fields_ws line);

def line_field_csv_or (fallback : String) (index : Nat) (line : String) : String :=
    nth String fallback index (csv_split_row line);

def line_parse_nat_fields (line : String) : List Nat :=
    filter_map String Nat str_parse_nat (line_fields_ws line);

def line_nat_values (lines : List String) : List Nat :=
    concat_map String Nat line_parse_nat_fields lines;

def line_transform_text (f : List String -> List String) (text : String) : String :=
    lines_to_text (f (lines_from_text text));

def line_read_stdin : IO (List String) :=
    do let! text := read_all;
       io_pure(List String, lines_from_text text)

def line_process_stdin (f : List String -> List String) : IO String :=
    do let! lines := line_read_stdin;
       io_pure(String, lines_to_text (f lines))

def line_print_stdin (f : List String -> List String) : IO Unit :=
    do let! text := line_process_stdin f;
       println text

def line_read_file_checked (path : String) : IO (Either FsError (List String)) :=
    fsx_read_lines path;

def line_transform_file_checked (src : String) (dst : String) (f : List String -> List String) : IO (Either FsError Unit) :=
    do let! input := fsx_read_lines src;
       match input with
       | Left e => fs_err Unit e
       | Right lines => fsx_write_lines(dst, f lines)
       end

def line_report (label : String) (lines : List String) : Report :=
    report_add_nat "lines" (line_count lines)
      (report_add "label" label report_empty);

def line_transform_report (input_lines : List String) (output_lines : List String) : Report :=
    report_add_nat "input_lines" (line_count input_lines)
      (report_add_nat "output_lines" (line_count output_lines) report_empty);
