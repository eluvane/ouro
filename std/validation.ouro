-- Accumulating validation helpers over Either (List E) A.

import "result.ouro",
  "text.ouro";

def Validation (E : Type) (A : Type) : Type := Either(List E, A);

def valid (E : Type) (A : Type) (x : A) : Validation E A :=
    Right (List E) A x;

def invalid_many (E : Type) (A : Type) (errors : List E) : Validation E A :=
    Left (List E) A errors;

def invalid (E : Type) (A : Type) (error : E) : Validation E A :=
    invalid_many E A ([error] : List E);

def validation_is_valid (E : Type) (A : Type) (v : Validation E A) : Bool :=
    match v with
    | Left _ => False
    | Right _ => True
    end;

def validation_errors (E : Type) (A : Type) (v : Validation E A) : List E :=
    match v with
    | Left errors => errors
    | Right _ => Nil E
    end;

def validation_map (E : Type) (A : Type) (B : Type) (f : A -> B) (v : Validation E A) : Validation E B :=
    match v with
    | Left errors => Left (List E) B errors
    | Right x => Right(List E, B, f x)
    end;

def validation_map_error (E : Type) (F : Type) (A : Type) (f : E -> F) (v : Validation E A) : Validation F A :=
    match v with
    | Left errors => Left(List F, A, map E F f errors)
    | Right x => Right (List F) A x
    end;

def validation_apply (E : Type) (A : Type) (B : Type) (vf : Validation E (A -> B)) (vx : Validation E A) : Validation E B :=
    match vf with
    | Left ef =>
      match vx with
      | Left ex => Left(List E, B, append E ef ex)
      | Right _ => Left (List E) B ef
      end
    | Right f =>
      match vx with
      | Left ex => Left (List E) B ex
      | Right x => Right(List E, B, f x)
      end
    end;

def validation_map2 (E : Type) (A : Type) (B : Type) (C : Type) (f : A -> B -> C) (va : Validation E A) (vb : Validation E B) : Validation E C :=
    validation_apply E B C (validation_map E A (B -> C) f va) vb;

def validation_and (E : Type) (left : Validation E Unit) (right : Validation E Unit) : Validation E Unit :=
    validation_map2 E Unit Unit Unit (fun (_ : Unit) (_ : Unit) => MkUnit) left right;

def validation_collect (E : Type) (A : Type) : List (Validation E A) -> Validation E (List A) :=
    fix validation_collect (xs : List (Validation E A)) : Validation E (List A) :=
      match xs with
      | Nil => Right(List E, List A, Nil A)
      | Cons v rest =>
        match v with
        | Left es =>
          match validation_collect rest with
          | Left more => Left(List E, List A, append E es more)
          | Right _ => Left(List E, List A, es)
          end
        | Right x =>
          match validation_collect rest with
          | Left more => Left(List E, List A, more)
          | Right ys => Right(List E, List A, Cons A x ys)
          end
        end
      end;

def validation_collect_unit (E : Type) (xs : List (Validation E Unit)) : Validation E Unit :=
    validation_map E (List Unit) Unit (fun (_ : List Unit) => MkUnit)
      (validation_collect E Unit xs);

def validation_require (E : Type) (error : E) (condition : Bool) : Validation E Unit :=
    match condition with
    | True => valid E Unit MkUnit
    | False => invalid E Unit error
    end;

def validation_require_present (E : Type) (A : Type) (error : E) (m : Maybe A) : Validation E A :=
    match m with
    | Nothing => invalid E A error
    | Just x => valid E A x
    end;

def validation_require_nonempty (error : String) (value : String) : Validation String String :=
    match str_null (str_trim value) with
    | True => invalid String String error
    | False => valid String String value
    end;

def validation_from_result (E : Type) (A : Type) (r : Either E A) : Validation E A :=
    match r with
    | Left e => invalid E A e
    | Right x => valid E A x
    end;

def validation_to_result (E : Type) (A : Type) (v : Validation E A) : Either (List E) A := v;

def validation_render_errors (E : Type) (show : E -> String) (errors : List E) : String :=
    str_unlines (map E String show errors);

def validation_render (E : Type) (A : Type) (show : E -> String) (ok : A -> String) (v : Validation E A) : String :=
    match v with
    | Left errors => validation_render_errors E show errors
    | Right x => ok x
    end;
