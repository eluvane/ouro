-- Small reporting and timing helpers for CLI/data tools.

import "format.ouro",
  "io.ouro",
  "text.ouro";

inductive Duration : Type :=
  | MkDuration : Nat -> Duration;

def duration_ms (d : Duration) : Nat :=
    match d with
    | MkDuration n => n
    end;

def duration_zero : Duration := MkDuration Z;

def duration_between (start_ms : Nat) (finish_ms : Nat) : Duration :=
    MkDuration (sub finish_ms start_ms);

def duration_show_ms (d : Duration) : String :=
    str_concat(show_nat (duration_ms d), "ms");

def time_now_string : IO String := now;

def time_nat_or_zero (m : Maybe Nat) : Nat :=
    fromMaybe Nat Z m;

def time_now_nat : IO (Maybe Nat) :=
    do let! stamp := now;
       io_pure(Maybe Nat, str_parse_nat stamp)

def time_elapsed (A : Type) (act : IO A) : IO (Pair Duration A) :=
    do let! start := time_now_nat;
       let! value := act;
       let! finish := time_now_nat;
       io_pure (Pair Duration A)
         (MkPair Duration A
           (duration_between(time_nat_or_zero start, time_nat_or_zero finish))
           value)

def Report : Type := List (Pair String String);

def report_empty : Report := Nil (Pair String String);

def report_pair (key : String) (value : String) : Pair String String :=
    MkPair String String key value;

def report_add (key : String) (value : String) (r : Report) : Report :=
    snoc(Pair String String, r, report_pair key value);

def report_add_nat (key : String) (value : Nat) (r : Report) : Report :=
    report_add key (show_nat value) r;

def report_add_bool (key : String) (value : Bool) (r : Report) : Report :=
    report_add key (show_bool value) r;

def report_add_duration (key : String) (value : Duration) (r : Report) : Report :=
    report_add key (duration_show_ms value) r;

def report_merge (a : Report) (b : Report) : Report :=
    append (Pair String String) a b;

def report_render_pair (p : Pair String String) : String :=
    match p with
    | MkPair key value => kv_line key value
    end;

def report_render (r : Report) : String :=
    str_unlines (map (Pair String String) String report_render_pair r);

def report_section (title : String) (body : String) : String :=
    str_unlines ([str_cat3 "== " title " ==", body] : List String);

def report_status (ok : Bool) : String :=
    match ok with
    | True => "ok"
    | False => "fail"
    end;

def report_summary (ok : Nat) (warn : Nat) (err : Nat) : Report :=
    report_add_nat "error" err
      (report_add_nat "warn" warn
        (report_add_nat "ok" ok report_empty));

def report_from_pairs (pairs : List (Pair String String)) : Report := pairs;
