-- Numeric helpers for small data-processing programs.

import "collections.ouro";
import "natx.ouro";
import "string.ouro";

def nat_eq (a : Nat) (b : Nat) : Bool := eq_nat a b;

def nat_ne (a : Nat) (b : Nat) : Bool := neb_nat a b;

def nat_lt (a : Nat) (b : Nat) : Bool := ltb_nat a b;

def nat_le (a : Nat) (b : Nat) : Bool := leb_nat a b;

def nat_gt (a : Nat) (b : Nat) : Bool := gtb_nat a b;

def nat_ge (a : Nat) (b : Nat) : Bool := geb_nat a b;

def nat_compare (a : Nat) (b : Nat) : Ordering := compareNat a b;

def nat_min (a : Nat) (b : Nat) : Nat := minNat a b;

def nat_max (a : Nat) (b : Nat) : Nat := maxNat a b;

def nat_clamp (lo : Nat) (hi : Nat) (x : Nat) : Nat :=
    clamp_nat lo hi x;

def nat_nonzero (n : Nat) : Bool :=
    match n with
    | Z => False
    | S _ => True
    end;

def nat_div_checked (n : Nat) (m : Nat) : Either String Nat :=
    match m with
    | Z => Left String Nat "division by zero"
    | S _ => Right String Nat (div_nat n m)
    end;

def nat_mod_checked (n : Nat) (m : Nat) : Either String Nat :=
    match m with
    | Z => Left String Nat "modulo by zero"
    | S _ => Right String Nat (mod_nat n m)
    end;

def nat_range_count_go (start : Nat) (count : Nat) : List Nat :=
  (fix go (remaining : Nat) (current : Nat) : List Nat :=
    match remaining with
    | Z => Nil Nat
    | S rest => Cons Nat current (go rest (S current))
    end) count start;

def nat_range_count (start : Nat) (count : Nat) : List Nat :=
    nat_range_count_go start count;

def nat_range_closed (lo : Nat) (hi : Nat) : List Nat :=
    match leb_nat lo hi with
    | False => Nil Nat
    | True => nat_range_count lo (S (sub hi lo))
    end;

def nat_sum (xs : List Nat) : Nat := sum_nats xs;

def nat_product (xs : List Nat) : Nat := product_nats xs;

def nat_min_list (fallback : Nat) (xs : List Nat) : Nat :=
    minimum_nat fallback xs;

def nat_max_list (fallback : Nat) (xs : List Nat) : Nat :=
    maximum_nat fallback xs;

def nat_count (p : Nat -> Bool) (xs : List Nat) : Nat :=
    count_if Nat p xs;

def nat_mean_floor (xs : List Nat) : Nat :=
    let n : Nat := length Nat xs in
    match n with
    | Z => Z
    | S _ => div_nat (nat_sum xs) n
    end;
