-- Syntax-surface bad fixture: proven style (import/alias/open/`;;`/list/public `_`).
-- Retired style unused/shadow greps (LINT038/LINT039) must not fire; language lint owns those smells.

import "a.ouro" as lowerAlias;
import "a.ouro" as Good;
open Good;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive PairNat : Type :=
  | MkPairNat : Nat -> Nat -> PairNat;

-- @export public_drop; @doc docs/api/syntax_surface.md
def public_drop (p : PairNat) : Nat :=
  match p with | MkPairNat _ _ => Z end;

def shadow_param (x : Nat) (x : Nat) : Nat := x;
def unused_local : Nat := let temp : Nat := Z in Z;
def untyped_list := [Z];
def noisy_sep : Nat := Z;;
