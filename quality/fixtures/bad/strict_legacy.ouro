inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Point : Type :=
  | MkPoint : Nat -> Nat -> Point;

def Point_x (p : Point) : Nat := match p with | MkPoint x y => x end;
def placeholder : Nat := _;
def old_list : List Nat := Cons Nat Z (Cons Nat (S Z) (Nil Nat));
def nested_flow : Nat := S (S (S (S Z)));
def old_do : IO Nat := do x <- io_pure Nat Z; io_pure Nat x;
