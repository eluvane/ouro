-- @entry demo_total
inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def add : Nat -> Nat -> Nat :=
  fix add (n : Nat) (m : Nat) : Nat :=
    match n with
    | Z => m
    | S n' => S (add n' m)
    end;

def length (A : Type) : List A -> Nat :=
  fix length (xs : List A) : Nat :=
    match xs with
    | Nil => Z
    | Cons _ xs' => S (length xs')
    end;

def map (A : Type) (B : Type) (f : A -> B) : List A -> List B :=
  fix map (xs : List A) : List B :=
    match xs with
    | Nil => Nil B
    | Cons x xs' => Cons(B, f x, map xs')
    end;

def demo_total : Nat :=
  add(length(Nat, Cons Nat Z (Cons(Nat, S Z, Nil Nat))), S (S Z));
