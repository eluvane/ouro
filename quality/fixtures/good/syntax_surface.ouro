-- Syntax-surface good fixture: explicit imports, typed literals, no shadowing.

import "a.ouro" as Good;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive PairNat : Type :=
  | MkPairNat : Nat -> Nat -> PairNat;

-- @export public_keep; @doc docs/api/syntax_surface.md
def public_keep (p : PairNat) : Nat :=
  match p with | MkPairNat left right => left end;

def typed_list : List Nat := [Z, S Z];
def used_local (x : Nat) : Nat := let y : Nat := x in y;
def discard_local : Nat := let _temp : Nat := Z in Z;
def local_open_demo : Nat := open Good in Z;
def one_separator : Nat := Z;
