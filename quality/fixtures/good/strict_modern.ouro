-- Strict-quality good fixture: compact modern surface, no suppressions.

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

record Point : Type where
  x : Nat;
  y : Nat;
end;

def origin : Point := { x := Z, y := Z };
def get_x (p : Point) : Nat := p.x;
def small_list : List Nat := [Z, S Z];
def four : Nat := 4;
def piped : Nat := Z |> S |> S;
def cons_tail (x : Nat) (xs : List Nat) : List Nat := Cons Nat x xs;
-- Non-annotation mentions must not be treated as public API markers.
-- The extractor recognizes the text @export inside metadata lines.
def export_marker_text : String := "@export";
