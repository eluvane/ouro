<%--
Project_Footer - The footer below the Ouro documentation chapters.
--%>
<Define:Project_Footer tag="footer" class="project-footer">
  <div>
    <strong><%= this.args.site.name %></strong>
    <span>Experimental dependently typed language and toolchain</span>
  </div>
  <a href="<%= this.args.site.github_url %>" target="_blank" rel="noreferrer">GitHub ↗</a>
</Define:Project_Footer>
