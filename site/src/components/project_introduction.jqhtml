<%--
Project_Introduction - Ouro documentation overview and chapter list.
--%>
<Define:Project_Introduction>
  <section
    id="introduction"
    class="docs-home__hero"
    data-search-section
    aria-labelledby="introduction-title"
  >
    <h1 id="introduction-title">
      Ouro Documentation
    </h1>
    <p>A concise guide to the language, toolchain, runtime, and trust boundary.</p>
  </section>

  <section aria-labelledby="chapters-title">
    <h2 id="chapters-title">Chapters</h2>
    <ol class="docs-list">
      <% for (const chapter of this.args.chapters) { %>
        <li>
          <a
            href="#<%= chapter.id %>"
            data-search-link
          ><%= chapter.label %></a>
        </li>
      <% } %>
    </ol>
  </section>
</Define:Project_Introduction>
