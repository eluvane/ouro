<%--
Documentation_App - The Ouro documentation shell.

ARGS:
  $site - project metadata from src/site.config.js
--%>
<Define:Documentation_App class="docs-layout">
  <%
    const chapters = [
      { id: 'introduction', label: 'Introduction' },
      { id: 'getting-started', label: 'Getting Started' },
      { id: 'language-syntax', label: 'Language Syntax' },
      { id: 'dependent-functions', label: 'Dependent Functions' },
      { id: 'inductive-data', label: 'Inductive Data' },
      { id: 'pattern-matching', label: 'Pattern Matching' },
      { id: 'modules-imports', label: 'Modules & Imports' },
      { id: 'effects-io', label: 'Effects & IO' },
      { id: 'check-evaluate', label: 'Check & Evaluate' },
      { id: 'native-builds', label: 'Native Builds' },
      { id: 'formatter-linter', label: 'Formatter & Linter' },
      { id: 'analyzer', label: 'Analyzer' },
      { id: 'tests', label: 'Tests' },
      { id: 'packages', label: 'Packages' },
      { id: 'documentation', label: 'Documentation' },
      { id: 'lsp-vscode', label: 'LSP & VS Code' },
      { id: 'architecture-kernel', label: 'Architecture & Kernel' },
      { id: 'stability-roadmap', label: 'Stability & Roadmap' },
    ];
  %>

  <a class="skip-link" href="#docs-content">Skip to documentation</a>

  <aside class="docs-sidebar" aria-label="Ouro documentation chapters">
    <header class="docs-sidebar__header">
      <a class="site-brand" href="<%= this.args.site.home_url %>" aria-label="Ouro home"><%= this.args.site.name %></a>
    </header>

    <nav class="docs-sidebar__nav" aria-label="Table of contents">
      <% for (const chapter of chapters) { %>
        <a
          class="Docs_Nav__item"
          href="#<%= chapter.id %>"
          data-nav-link
          data-search-link
          @click=this.close_navigation
        ><%= chapter.label %></a>
      <% } %>
    </nav>
  </aside>

  <button
    class="sidebar-backdrop"
    type="button"
    aria-label="Close navigation"
    @click=this.close_navigation
  ></button>

  <div class="docs-main">
    <header class="docs-header">
      <button
        $sid="menu_toggle"
        class="navigation-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        @click=this.toggle_navigation
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <a class="mobile-brand" href="<%= this.args.site.home_url %>" aria-label="Ouro home">
        <%= this.args.site.name %>
      </a>

      <label id="docs-search" class="docs-header__search">
        <span class="sr-only">Search Ouro documentation</span>
        <input
          $sid="search_input"
          type="search"
          placeholder="Search Ouro documentation..."
          autocomplete="off"
          aria-keyshortcuts="/"
          @pointerdown=this.set_search_origin
          @focus=this.focus_search
          @blur=this.blur_search
          @input=this.search_docs
        />
        <kbd class="docs-search__shortcut" aria-hidden="true">/</kbd>
      </label>

      <span $sid="search_status" class="sr-only" aria-live="polite"></span>

      <button
        $sid="search_toggle"
        class="search-toggle"
        type="button"
        aria-label="Open search"
        aria-controls="docs-search"
        aria-expanded="false"
        @click=this.toggle_search
      >
        <svg class="search-toggle__open" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 4 4" />
        </svg>
        <svg class="search-toggle__close" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M6 18 18 6" />
        </svg>
      </button>

      <a
        class="github-link"
        href="<%= this.args.site.github_url %>"
        target="_blank"
        rel="noreferrer"
        aria-label="View Ouro on GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.3 11.3 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" />
        </svg>
      </a>
    </header>

    <main id="docs-content" class="docs-content">
      <Project_Introduction />
      <Quick_Start_Guide />
      <Feature_Reference />

      <section $sid="empty_state" class="empty-state" hidden>
        <h2>No results found</h2>
        <p>Try another term or press Escape to clear the search.</p>
      </section>
    </main>
  </div>
</Define:Documentation_App>
