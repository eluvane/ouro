<%-- Site_App - minimal Ouro landing page. --%>
<Define:Site_App>
  <header class="site-header">
    <a class="site-brand" href="<%= this.args.site.home_url %>" aria-label="Ouro home">
      <%= this.args.site.name %>
    </a>

    <nav class="site-header__actions" aria-label="Project links">
      <a class="site-docs-link" href="<%= this.args.site.docs_url %>">Documentation</a>
      <a
        class="github-link"
        href="<%= this.args.site.github_url %>"
        target="_blank"
        rel="noreferrer"
        aria-label="View Ouro on GitHub"
      >
        <span class="site-icon site-icon--github" aria-hidden="true"></span>
      </a>
    </nav>
  </header>

  <main class="site-intro">
    <h1>Learn Ouro.<br />Build something real.</h1>
  </main>
</Define:Site_App>
