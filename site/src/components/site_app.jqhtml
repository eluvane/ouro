<%-- Site_App - minimal Ouro landing page. --%>
<Define:Site_App>
  <header class="site-header">
    <a class="site-brand" href="<%= this.args.site.home_url %>" aria-label="Ouro home">
      <%= this.args.site.name %>
    </a>

    <nav class="site-header__actions" aria-label="Project links">
      <a class="site-docs-link" href="<%= this.args.site.docs_url %>">Documentation</a>
      <a
        class="github-link"
        href="<%= this.args.site.github_url %>"
        target="_blank"
        rel="noreferrer"
        aria-label="View Ouro on GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.3 11.3 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" />
        </svg>
      </a>
    </nav>
  </header>

  <main class="site-intro">
    <h1>Learn Ouro.<br />Build something real.</h1>
  </main>
</Define:Site_App>
