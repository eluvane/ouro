-- The lexer drops comments, so docs are scanned from source text before parsing.
-- Only a contiguous comment run above a top-level declaration becomes public API docs.

import "../std/stringx.ouro";
import "../std/pathx.ouro";
import "../std/map.ouro";

-- kind ("def"), name, signature up to `:=`, doc lines, 1-based source line.
-- The line is what the editor integration jumps to; rendering ignores it.
inductive Decl : Type :=
  | MkDecl : String -> String -> String -> List String -> Nat -> Decl;

def decl_kind (d : Decl) : String :=
    match d with
    | MkDecl k _ _ _ _ => k
    end;

def decl_name (d : Decl) : String :=
    match d with
    | MkDecl _ n _ _ _ => n
    end;

def decl_sig (d : Decl) : String :=
    match d with
    | MkDecl _ _ s _ _ => s
    end;

def decl_docs (d : Decl) : List String :=
    match d with
    | MkDecl _ _ _ ds _ => ds
    end;

def decl_line (d : Decl) : Nat :=
    match d with
    | MkDecl _ _ _ _ n => n
    end;

-- module path, module-level doc lines, declarations in source order.
inductive ModDoc : Type :=
  | MkModDoc : String -> List String -> List Decl -> ModDoc;

def mod_path (m : ModDoc) : String :=
    match m with
    | MkModDoc p _ _ => p
    end;

def mod_docs (m : ModDoc) : List String :=
    match m with
    | MkModDoc _ ds _ => ds
    end;

def mod_decls (m : ModDoc) : List Decl :=
    match m with
    | MkModDoc _ _ xs => xs
    end;

def doc_kinds : List String :=
    [ "def", "axiom", "inductive", "record", "effect", "intrinsic", "extern" ];

-- A comment line is `--` at the start of the line; `-- @entry` and the like
-- are markers for other tools, not prose.
def doc_is_comment (line : String) : Bool :=
    str_starts line "--";

def doc_comment_text (line : String) : String :=
    str_trim (str_drop line 2);

def doc_is_marker (line : String) : Bool :=
    str_starts (doc_comment_text line) "@";

def doc_kind_at (line : String) : Maybe String :=
    find String (fun (kind : String) => str_starts line (str_concat kind " "))
      doc_kinds;

-- The declared name is what follows the keyword up to the first delimiter.
def doc_name_stops : List String := [ " ", "(", ":", "{" ];

def doc_first_stop (rest : String) : Nat :=
    foldl String Nat
      (fun (acc : Nat) (stop : String) =>
        match str_index rest stop with
        | Nothing => acc
        | Just i => minNat acc i
        end)
      (str_len rest) doc_name_stops;

def doc_name_of (line : String) (kind : String) : String :=
    let rest : String := str_drop line (S (str_len kind)) |> str_trim in
    str_trim (str_take rest (doc_first_stop rest));

-- The signature is the declaration up to `:=`, with the trailing `;` of a
-- one-line body dropped. Multi-line declarations keep only their first line,
-- which is enough to see the arity and the result type.
def doc_sig_of (line : String) : String :=
    let cut : String := str_before (str_rtrim line) ":=" in
    let sig : String := str_rtrim cut in
    match str_ends sig ";" with
    | True => str_rtrim (str_take sig (sub (str_len sig) (S Z)))
    | False => sig
    end;

-- Scanner state: the pending doc run, the module doc (first run in the file,
-- taken only when the file opens with a comment), the declarations so far, and
-- the number of lines consumed.
inductive Scan : Type :=
  | MkScan : List String -> Maybe (List String) -> List Decl -> Nat -> Scan;

def scan_pending (s : Scan) : List String :=
    match s with
    | MkScan p _ _ _ => p
    end;

def scan_header (s : Scan) : Maybe (List String) :=
    match s with
    | MkScan _ h _ _ => h
    end;

def scan_decls (s : Scan) : List Decl :=
    match s with
    | MkScan _ _ ds _ => ds
    end;

-- 1-based number of the line about to be scanned.
def scan_at (s : Scan) : Nat :=
    match s with
    | MkScan _ _ _ n => n
    end;

def scan_empty : Scan :=
    MkScan (Nil String) (Nothing (List String)) (Nil Decl) (S Z);

def scan_add_doc (s : Scan) (text : String) : Scan :=
    MkScan (snoc String (scan_pending s) text) (scan_header s) (scan_decls s)
      (S (scan_at s));

def scan_skip (s : Scan) : Scan :=
    MkScan (Nil String) (scan_header s) (scan_decls s) (S (scan_at s));

-- A blank line closes the run. If nothing has been declared yet and no header
-- was taken, that run was the module header.
def scan_close (s : Scan) : Scan :=
    match scan_header s with
    | Just _ => scan_skip s
    | Nothing =>
        match scan_decls s with
        | Nil =>
            MkScan (Nil String) (Just (List String) (scan_pending s))
              (scan_decls s) (S (scan_at s))
        | Cons _ _ => scan_skip s
        end
    end;

def scan_decl_line (s : Scan) (line : String) (kind : String) : Scan :=
    MkScan (Nil String) (scan_header s)
      (snoc Decl (scan_decls s)
        (MkDecl kind (doc_name_of line kind) (doc_sig_of line)
          (scan_pending s) (scan_at s)))
      (S (scan_at s));

-- A marker comment (`-- @entry`) stays in the file but does not join the
-- pending prose run. Advance the line counter only.
def scan_keep (s : Scan) : Scan :=
    MkScan (scan_pending s) (scan_header s) (scan_decls s) (S (scan_at s));

def scan_comment (s : Scan) (line : String) : Scan :=
    match doc_is_marker line with
    | True => scan_keep s
    | False => scan_add_doc s (doc_comment_text line)
    end;

def scan_source (s : Scan) (line : String) : Scan :=
    match str_null (str_trim line) with
    | True => scan_close s
    | False =>
        match doc_kind_at line with
        | Just kind => scan_decl_line s line kind
        | Nothing => scan_skip s
        end
    end;

-- One line: comment, blank, declaration, or anything else (which also closes
-- a run, so a comment inside a body cannot attach to the next declaration).
def scan_line (s : Scan) (line : String) : Scan :=
    match doc_is_comment line with
    | True => scan_comment s line
    | False => scan_source s line
    end;

def doc_module (path : String) (text : String) : ModDoc :=
    let s : Scan := foldl String Scan scan_line scan_empty (str_lines text) in
    MkModDoc path (fromMaybe (List String) (Nil String) (scan_header s))
      (scan_decls s);

-- Rendering. One file per module, one section per declaration, signatures in
-- fenced blocks so the Markdown stays readable in a plain editor too.
def doc_section (d : Decl) : String :=
    let head : String := str_cat4 "## " (decl_kind d) " " (decl_name d) in
    let body : String :=
      str_cat3 "```" (str_concat "\n" (decl_sig d))
        (str_concat "\n" "```") in
    let prose : String := str_join " " (decl_docs d) in
    match str_null prose with
    | True => str_cat3 head "\n\n" body
    | False => str_cat4 head "\n\n" body (str_concat "\n\n" prose)
    end;

def doc_render (m : ModDoc) : String :=
    let head : String := str_concat "# " (mod_path m) in
    let prose : String := str_join " " (mod_docs m) in
    let intro : String :=
      match str_null prose with
      | True => head
      | False => str_cat3 head "\n\n" prose
      end in
    str_cat4 intro "\n\n"
      (str_cat3 "Declarations: " (show_nat (length Decl (mod_decls m))) ".")
      (str_cat3 "\n\n"
        (str_join "\n\n" (map Decl String doc_section (mod_decls m))) "\n");

-- Output paths: the module path with separators folded into underscores, so
-- std/gate/share.ouro and std/share.ouro cannot collide.
def doc_out_name (path : String) : String :=
    -- A drive colon must not become an NTFS alternate-stream separator.
    let portable : String := str_replace (path_from_host path) ":" "_" in
    str_concat (str_replace (str_before portable ".ouro") "/" "_") ".md";

def doc_index_name : String := "README.md";

def doc_index_row (m : ModDoc) : String :=
    let link : String :=
      str_cat4 "- [" (mod_path m) "](" (str_concat (doc_out_name (mod_path m)) ")") in
    str_cat4 link " — " (show_nat (length Decl (mod_decls m)))
      " declarations";

def doc_index (ms : List ModDoc) : String :=
    let head : String := "# Ouro standard library API" in
    let intro : String :=
      "Generated by `tools/doc.ouro` from the doc comments in the modules themselves; run `sh scripts/doc_suite.sh` after editing them." in
    str_cat4 head "\n\n"
      (str_concat intro "\n\n")
      (str_concat (str_join "\n" (map ModDoc String doc_index_row ms)) "\n");
