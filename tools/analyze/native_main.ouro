import "native_executor.ouro";

def native_analyze_fail (error : NativeAnalyzeRunError) : IO Unit :=
    do match error with
       | NativeAnalyzeRunExecution cause =>
           let (MkPair output errors) := native_analyze_executor_streams cause in
           do print (native_analyze_failure_output output);
              eprint errors
       | NativeAnalyzeRunArgs _ => io_unit
       | NativeAnalyzeRunInput _ => io_unit
       | NativeAnalyzeRunPolicy _ => io_unit
       end;
       eprintln (str_concat "ANALYZE_FAIL: " (native_analyze_run_message error));
       exit 2;

-- Caller-supplied limits use the same checked policy as the standalone entry.
def native_analyze_start_with_policy (policy : NativeAnalyzePolicy) (words : List String) : IO Unit :=
    match native_analyze_policy_checked policy with
    | Left error => native_analyze_fail (NativeAnalyzeRunPolicy error)
    | Right _ => match native_analyze_parse words with
      | Left error => native_analyze_fail (NativeAnalyzeRunArgs error)
      | Right request => match! native_analyze_root_directory "." with
        | Left error => native_analyze_fail (NativeAnalyzeRunInput (NativeAnalyzeRootFailure error))
        | Right caller => match! native_analyze_repo_root caller with
          | Left error => native_analyze_fail (NativeAnalyzeRunInput (NativeAnalyzeRootFailure error))
          | Right root => match! native_analyze_discover root caller request with
            | Left error => native_analyze_fail (NativeAnalyzeRunInput error)
            | Right sources => do let! located := executable_path_checked;
                match! native_analyze_execute_native policy located root
                  caller request sources with
                | Left error => native_analyze_fail error
                | Right process => do print (proc_stdout process);
                    eprint (proc_stderr process);
                    exit (proc_code process)
                end
            end
          end
        end
      end
    end;

-- @entry main
-- The entry selects provisional 120s worker limits and Windows Job commit caps.
-- Retained RSS budgets and native IO acceptance require separate evidence.
def main : IO Unit :=
    match! argv with
    | Nil => native_analyze_fail (NativeAnalyzeRunArgs "missing executable argument")
    | Cons _ arguments => native_analyze_start_with_policy native_analyze_entry_policy arguments
    end;
