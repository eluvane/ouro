-- Property checks are bounded and deterministic so they can run inside strict
-- gates. Each check is requested by a `@property` directive: no-holes,
-- exhaustive, terminates.

-- @entry analyze_property

import "../../std/data.ouro",
  "../../std/listx.ouro",
  "../../std/natx.ouro",
  "ast.ouro";

-- hole id under no-holes; empty match under exhaustive; missing constructor
-- under exhaustive; fix name recursing without a structural guard under
-- terminates.
inductive PropIssue : Type :=
  | INoHoles : Nat -> PropIssue
  | IExhaustiveEmpty : Nat -> PropIssue
  | IExhaustiveMissing : Nat -> PropIssue
  | IAlwaysTerminates : Nat -> PropIssue;

-- no-holes, exhaustive, terminates.
inductive PropWants : Type :=
  | MkPropWants : Bool -> Bool -> Bool -> PropWants;

def prop_want_holes (w : PropWants) : Bool :=
    match w with | MkPropWants h _ _ => h end;

def prop_want_exhaustive (w : PropWants) : Bool :=
    match w with | MkPropWants _ e _ => e end;

def prop_want_terminates (w : PropWants) : Bool :=
    match w with | MkPropWants _ _ t => t end;

def prop_wants_any (w : PropWants) : Bool :=
    orb (prop_want_holes w)
      (orb(prop_want_exhaustive w, prop_want_terminates w));

def prop_inil : List PropIssue := [];

def prop_icons (i : PropIssue) (is : List PropIssue) : List PropIssue :=
    Cons PropIssue i is;

def prop_append (xs : List PropIssue) (ys : List PropIssue) : List PropIssue :=
    append PropIssue xs ys;

def prop_when (want : Bool) (xs : List PropIssue) : List PropIssue :=
    match want with
    | True => xs
    | False => prop_inil
    end;

def prop_owner_of (ctor : Nat) (sig : List (Pair Nat Nat)) : Maybe Nat :=
    lookup Nat Nat eq_nat ctor sig;

def prop_ctors_of (ind : Nat) (sig : List (Pair Nat Nat)) : List Nat :=
    map (Pair Nat Nat) Nat (fun (p : Pair Nat Nat) => fst Nat Nat p)
      (filter (Pair Nat Nat)
        (fun (p : Pair Nat Nat) => eq_nat(snd Nat Nat p, ind)) sig);

-- Empty match, or constructors of the first arm's inductive that have no
-- arm. Arms on constructors the unit does not declare are left alone.
def prop_exhaustive (sig : List (Pair Nat Nat)) (branches : Ast)
    : List PropIssue :=
    match ast_arm_ctors branches with
    | Nil => prop_icons(IExhaustiveEmpty Z, prop_inil)
    | Cons first _ =>
        match prop_owner_of first sig with
        | Nothing => prop_inil
        | Just ind =>
            map Nat PropIssue (fun (c : Nat) => IExhaustiveMissing c)
              (filter Nat
                (fun (c : Nat) => notb (mem Nat eq_nat c (ast_arm_ctors branches)))
                (prop_ctors_of ind sig))
        end
    end;

def prop_node (w : PropWants) (sig : List (Pair Nat Nat)) (a : Ast)
    : List PropIssue :=
    match a with
    | AHole id => prop_when(prop_want_holes w, prop_icons(INoHoles id, prop_inil))
    | AMatch _ branches =>
        prop_when(prop_want_exhaustive w, prop_exhaustive sig branches)
    | AFix r binders _ body =>
        prop_when (prop_want_terminates w)
          (match ast_recursion_unguarded r binders body with
           | True => prop_icons(IAlwaysTerminates r, prop_inil)
           | False => prop_inil
           end)
    | AVar _ => prop_inil
    | ASort _ => prop_inil
    | ANatLit _ => prop_inil
    | AStr _ => prop_inil
    | AApp _ _ => prop_inil
    | ALam _ _ _ => prop_inil
    | APi _ _ _ => prop_inil
    | ALet _ _ _ _ => prop_inil
    | AAscribe _ _ => prop_inil
    | ABinder _ _ _ => prop_inil
    | ANoBinder => prop_inil
    | ABranch _ _ _ _ => prop_inil
    | ANoBranch => prop_inil
    | APerform _ _ => prop_inil
    | AHandle _ _ => prop_inil
    | AClause _ _ _ _ => prop_inil
    | ANoClause => prop_inil
    | ADo _ => prop_inil
    | AList _ => prop_inil
    end;

def prop_walk (w : PropWants) (sig : List (Pair Nat Nat)) : Ast -> List PropIssue :=
  fun (root : Ast) =>
    (fix prop_walk (fuel : Nat) (a : Ast) : List PropIssue :=
      match fuel with
      | Z => prop_inil
      | S remaining =>
          let descend (child : Ast) : List PropIssue := prop_walk remaining child in
          prop_append (prop_node w sig a)
            (concat_map Ast PropIssue descend (ast_children a))
      end) (ast_size root) root;

-- sig: constructor/owner pairs declared in the unit.
def analyze_property (w : PropWants) (sig : List (Pair Nat Nat)) (a : Ast)
    : List PropIssue :=
    match prop_wants_any w with
    | False => prop_inil
    | True => prop_walk w sig a
    end;
