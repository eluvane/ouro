-- Shared analyzer-runner types; source helpers must agree with strict_quality_firewall.py.

import "../../std/io.ouro";
import "../../std/string.ouro";
import "../../std/stringx.ouro";
import "../../std/pathx.ouro";
import "../../std/char.ouro";
import "../../std/data.ouro";
import "hash.ouro";

inductive AFile : Type :=
  | MkAFile : String -> Nat -> Bool -> Bool -> Bool -> AFile;

def AFile_path (f : AFile) : String :=
  match f with | MkAFile p _ _ _ _ => p end;
def AFile_layer (f : AFile) : Nat :=
  match f with | MkAFile _ n _ _ _ => n end;
def AFile_trusted (f : AFile) : Bool :=
  match f with | MkAFile _ _ b _ _ => b end;
def AFile_compiler_internal (f : AFile) : Bool :=
  match f with | MkAFile _ _ _ b _ => b end;
def AFile_std_runtime (f : AFile) : Bool :=
  match f with | MkAFile _ _ _ _ b => b end;

inductive AEdge : Type :=
  | MkAEdge : Nat -> Nat -> String -> Nat -> Nat -> Bool -> Bool -> AEdge;

def AEdge_src (e : AEdge) : Nat :=
  match e with | MkAEdge n _ _ _ _ _ _ => n end;
def AEdge_dst (e : AEdge) : Nat :=
  match e with | MkAEdge _ n _ _ _ _ _ => n end;
def AEdge_target (e : AEdge) : String :=
  match e with | MkAEdge _ _ s _ _ _ _ => s end;
def AEdge_line (e : AEdge) : Nat :=
  match e with | MkAEdge _ _ _ n _ _ _ => n end;
def AEdge_col (e : AEdge) : Nat :=
  match e with | MkAEdge _ _ _ _ n _ _ => n end;
def AEdge_allow_layer (e : AEdge) : Bool :=
  match e with | MkAEdge _ _ _ _ _ b _ => b end;
def AEdge_allow_trust (e : AEdge) : Bool :=
  match e with | MkAEdge _ _ _ _ _ _ b => b end;

-- name, file, line, col, kind, entry, public API, API-checked, axiom,
-- export, certain-dead branch, namespace, owner, signature hash.
inductive ADecl : Type :=
  | MkADecl : String -> Nat -> Nat -> Nat -> Nat ->
      Bool -> Bool -> Bool -> Bool -> Bool -> Bool ->
      String -> String -> List Nat -> ADecl;

def ADecl_name (d : ADecl) : String :=
  match d with | MkADecl n _ _ _ _ _ _ _ _ _ _ _ _ _ => n end;
def ADecl_file (d : ADecl) : Nat :=
  match d with | MkADecl _ n _ _ _ _ _ _ _ _ _ _ _ _ => n end;
def ADecl_line (d : ADecl) : Nat :=
  match d with | MkADecl _ _ n _ _ _ _ _ _ _ _ _ _ _ => n end;
def ADecl_col (d : ADecl) : Nat :=
  match d with | MkADecl _ _ _ n _ _ _ _ _ _ _ _ _ _ => n end;
def ADecl_kind (d : ADecl) : Nat :=
  match d with | MkADecl _ _ _ _ n _ _ _ _ _ _ _ _ _ => n end;
def ADecl_is_entry (d : ADecl) : Bool :=
  match d with | MkADecl _ _ _ _ _ b _ _ _ _ _ _ _ _ => b end;
def ADecl_is_public_api (d : ADecl) : Bool :=
  match d with | MkADecl _ _ _ _ _ _ b _ _ _ _ _ _ _ => b end;
def ADecl_is_api_checked (d : ADecl) : Bool :=
  match d with | MkADecl _ _ _ _ _ _ _ b _ _ _ _ _ _ => b end;
def ADecl_is_axiom (d : ADecl) : Bool :=
  match d with | MkADecl _ _ _ _ _ _ _ _ b _ _ _ _ _ => b end;
def ADecl_is_export (d : ADecl) : Bool :=
  match d with | MkADecl _ _ _ _ _ _ _ _ _ b _ _ _ _ => b end;
def ADecl_certain_dead (d : ADecl) : Bool :=
  match d with | MkADecl _ _ _ _ _ _ _ _ _ _ b _ _ _ => b end;
def ADecl_ns (d : ADecl) : String :=
  match d with | MkADecl _ _ _ _ _ _ _ _ _ _ _ s _ _ => s end;
def ADecl_owner (d : ADecl) : String :=
  match d with | MkADecl _ _ _ _ _ _ _ _ _ _ _ _ s _ => s end;
def ADecl_sig_hash (d : ADecl) : List Nat :=
  match d with | MkADecl _ _ _ _ _ _ _ _ _ _ _ _ _ h => h end;

inductive ARef : Type :=
  | MkARef : Nat -> Nat -> ARef;
def ARef_src (r : ARef) : Nat :=
  match r with | MkARef s _ => s end;
def ARef_dst (r : ARef) : Nat :=
  match r with | MkARef _ d => d end;

inductive ASupp : Type :=
  | MkASupp : String -> Nat -> Nat -> Nat ->
      Bool -> Bool -> Bool -> Bool -> Bool -> Bool -> ASupp;
def ASupp_code (s : ASupp) : String :=
  match s with | MkASupp c _ _ _ _ _ _ _ _ _ => c end;
def ASupp_file (s : ASupp) : Nat :=
  match s with | MkASupp _ n _ _ _ _ _ _ _ _ => n end;
def ASupp_line (s : ASupp) : Nat :=
  match s with | MkASupp _ _ n _ _ _ _ _ _ _ => n end;
def ASupp_col (s : ASupp) : Nat :=
  match s with | MkASupp _ _ _ n _ _ _ _ _ _ => n end;
def ASupp_broad (s : ASupp) : Bool :=
  match s with | MkASupp _ _ _ _ b _ _ _ _ _ => b end;
def ASupp_has_reason (s : ASupp) : Bool :=
  match s with | MkASupp _ _ _ _ _ b _ _ _ _ => b end;
def ASupp_scope_file (s : ASupp) : Bool :=
  match s with | MkASupp _ _ _ _ _ _ b _ _ _ => b end;
def ASupp_known (s : ASupp) : Bool :=
  match s with | MkASupp _ _ _ _ _ _ _ b _ _ => b end;
def ASupp_forbidden (s : ASupp) : Bool :=
  match s with | MkASupp _ _ _ _ _ _ _ _ b _ => b end;
def ASupp_used (s : ASupp) : Bool :=
  match s with | MkASupp _ _ _ _ _ _ _ _ _ b => b end;

inductive ABase : Type :=
  | MkABase : String -> String -> List Nat -> String -> String -> ABase;
def ABase_path (b : ABase) : String :=
  match b with | MkABase p _ _ _ _ => p end;
def ABase_name (b : ABase) : String :=
  match b with | MkABase _ n _ _ _ => n end;
def ABase_sig_hash (b : ABase) : List Nat :=
  match b with | MkABase _ _ h _ _ => h end;
def ABase_use_intent (b : ABase) : String :=
  match b with | MkABase _ _ _ _ s => s end;

inductive ADiag : Type :=
  | MkADiag : String -> String -> String -> String ->
      Nat -> Nat -> Nat -> String -> String -> String -> Bool -> ADiag;
def ADiag_code (d : ADiag) : String :=
  match d with | MkADiag c _ _ _ _ _ _ _ _ _ _ => c end;
def ADiag_severity (d : ADiag) : String :=
  match d with | MkADiag _ s _ _ _ _ _ _ _ _ _ => s end;
def ADiag_analyzer (d : ADiag) : String :=
  match d with | MkADiag _ _ s _ _ _ _ _ _ _ _ => s end;
def ADiag_rule (d : ADiag) : String :=
  match d with | MkADiag _ _ _ s _ _ _ _ _ _ _ => s end;
def ADiag_file (d : ADiag) : Nat :=
  match d with | MkADiag _ _ _ _ n _ _ _ _ _ _ => n end;
def ADiag_line (d : ADiag) : Nat :=
  match d with | MkADiag _ _ _ _ _ n _ _ _ _ _ => n end;
def ADiag_col (d : ADiag) : Nat :=
  match d with | MkADiag _ _ _ _ _ _ n _ _ _ _ => n end;
def ADiag_message (d : ADiag) : String :=
  match d with | MkADiag _ _ _ _ _ _ _ s _ _ _ => s end;
def ADiag_hint (d : ADiag) : String :=
  match d with | MkADiag _ _ _ _ _ _ _ _ s _ _ => s end;
def ADiag_witness (d : ADiag) : String :=
  match d with | MkADiag _ _ _ _ _ _ _ _ _ s _ => s end;
def ADiag_suppressed (d : ADiag) : Bool :=
  match d with | MkADiag _ _ _ _ _ _ _ _ _ _ b => b end;

inductive AOpts : Type :=
  | MkAOpts : Nat -> String -> Bool -> Nat -> AOpts;
def o_bits (o : AOpts) : Nat := match o with | MkAOpts n _ _ _ => n end;
def o_base (o : AOpts) : String := match o with | MkAOpts _ s _ _ => s end;
def o_bexp (o : AOpts) : Bool := match o with | MkAOpts _ _ b _ => b end;
def o_xbits (o : AOpts) : Nat := match o with | MkAOpts _ _ _ n => n end;

def pow2 : Nat -> Nat :=
  fix pow2 (i : Nat) : Nat :=
    match i with
    | Z => S Z
    | S i' => mul (S (S Z)) (pow2 i')
    end;

def has_bit (n : Nat) (i : Nat) : Bool :=
  oddb (div_nat n (pow2 i));

def or_bit (n : Nat) (i : Nat) : Nat :=
  match has_bit n i with
  | True => n
  | False => add n (pow2 i)
  end;

def o_set (o : AOpts) (i : Nat) : AOpts :=
  MkAOpts (or_bit (o_bits o) i) (o_base o) (o_bexp o) (o_xbits o);

def o_set_x (o : AOpts) (i : Nat) : AOpts :=
  MkAOpts (o_bits o) (o_base o) (o_bexp o) (or_bit (o_xbits o) i);

def o_set_base (o : AOpts) (p : String) : AOpts :=
  MkAOpts (o_bits o) p True (o_xbits o);

def o_clear_base (o : AOpts) : AOpts :=
  MkAOpts (o_bits o) "" False (o_xbits o);

def kind_def : Nat := Z;
def kind_ctor : Nat := S Z;
def kind_module : Nat := 2;
def kind_branch : Nat := 3;

def a_byte_span : Nat := 256;
def no_idx : Nat := add 20 (mul a_byte_span a_byte_span);

-- Only the families this runner owns get a bit; the structured families are
-- flags of ouro-analyze-drive and are accepted here without effect.
def b_strict : Nat := Z;
def b_fix : Nat := S Z;
def b_dead : Nat := 2;
def b_dump : Nat := 3;
def b_light : Nat := 4;
def b_heavy : Nat := 5;
def b_fmt : Nat := 6;
def b_trust : Nat := 7;
-- Extra-bit field stays small so Peano pow2 stays tiny.
def xb_local : Nat := Z;
def xb_arch : Nat := S Z;

def opts_off : AOpts :=
  MkAOpts Z "quality/api_surface.tsv" False Z;

def o_strict (o : AOpts) : Bool := has_bit (o_bits o) b_strict;
def o_fix (o : AOpts) : Bool := has_bit (o_bits o) b_fix;
def o_dead (o : AOpts) : Bool := has_bit (o_bits o) b_dead;
def o_dump (o : AOpts) : Bool := has_bit (o_bits o) b_dump;
def o_light (o : AOpts) : Bool := has_bit (o_bits o) b_light;
def o_heavy (o : AOpts) : Bool := has_bit (o_bits o) b_heavy;

def on_fmt (o : AOpts) : Bool := orb (o_light o) (has_bit (o_bits o) b_fmt);
def on_trust (o : AOpts) : Bool := orb (o_heavy o) (has_bit (o_bits o) b_trust);
def o_local (o : AOpts) : Bool := has_bit (o_xbits o) xb_local;
def o_arch (o : AOpts) : Bool := has_bit (o_xbits o) xb_arch;

def drop_cr_cs (cs : List Nat) : List Nat :=
  filter Nat (fun (c : Nat) => notb (eq_nat c ch_cr)) cs;

def strip_cr (s : String) : String :=
  str_of_codes (drop_cr_cs (str_codes s));

def skip_ws_line (cs : List Nat) : List Nat :=
  drop_while Nat is_ws cs;

def rtrim_cs (cs : List Nat) : List Nat :=
  reverse Nat (skip_ws_line (reverse Nat cs));

def take_ident_cs (cs : List Nat) : Pair (List Nat) String :=
  match cs with
  | Nil => MkPair (List Nat) String (Nil Nat) ""
  | Cons c _ =>
      match is_ident_start c with
      | False => MkPair (List Nat) String cs ""
      | True =>
          match span Nat is_ident_cont cs with
          | MkPair name rest =>
              MkPair (List Nat) String rest (str_of_codes name)
          end
      end
  end;

def take_ident (s : String) : Pair String String :=
  match take_ident_cs (str_codes s) with
  | MkPair rest name => MkPair String String name (str_of_codes rest)
  end;

def collapse_ws_cs (cs : List Nat) : List Nat :=
  (fix go (xs : List Nat) (sp : Bool) (acc : List Nat) : List Nat :=
    match xs with
    | Nil => reverse Nat acc
    | Cons c rest =>
        match is_ws c with
        | True =>
            match sp with
            | True => go rest True acc
            | False => go rest True (Cons Nat ch_space acc)
            end
        | False => go rest False (Cons Nat c acc)
        end
    end) cs False (Nil Nat);

def codes_next_eq (want : Nat) (xs : List Nat) : Bool :=
  match xs with
  | Cons n _ => eq_nat n want
  | Nil => False
  end;

def codes_start_pair (first : Nat) (second : Nat) (c : Nat)
    (rest : List Nat) : Bool :=
  andb (eq_nat c first) (codes_next_eq second rest);

def cut_assign_or_comment_cs (cs : List Nat) : List Nat :=
  (fix go (xs : List Nat) (acc : List Nat) : List Nat :=
    match xs with
    | Nil => reverse Nat acc
    | Cons c rest =>
        match codes_start_pair ch_colon ch_eq c rest with
        | True => reverse Nat acc
        | False =>
            match codes_start_pair ch_minus ch_minus c rest with
            | True => reverse Nat acc
            | False => go rest (Cons Nat c acc)
            end
        end
    end) cs (Nil Nat);

def normalize_signature_cs (cs : List Nat) : List Nat :=
  rtrim_cs (collapse_ws_cs (cut_assign_or_comment_cs (skip_ws_line cs)));

def ns_rows : List (Pair String String) :=
  [ MkPair String String "std/" "std"
  , MkPair String String "compiler/" "compiler"
  , MkPair String String "tools/analyze/" "analyze"
  , MkPair String String "tests/analyze/" "analyze"
  , MkPair String String "samples/" "samples"
  , MkPair String String "test/" "test"
  ];

def ns_of_path (p : String) : String :=
  match find (Pair String String)
    (fun (row : Pair String String) =>
      match row with
      | MkPair prefix _ => str_starts p prefix
      end)
    ns_rows with
  | Nothing => "other"
  | Just row =>
      match row with
      | MkPair _ name => name
      end
  end;

def name_in (name : String) : List String -> Bool :=
  elem String str_eq name;

def starts_any (p : String) : List String -> Bool :=
  any String (fun (prefix : String) => str_starts p prefix);

def contains_any (p : String) : List String -> Bool :=
  any String (fun (infix : String) => str_contains p infix);

def fixture_prefixes : List String :=
  [ "test/"
  , "tests/"
  , "quality/fixtures/"
  , "samples/bench/synthesis/"
  , "samples/examples/future/"
  , "samples/examples/bad_"
  ];

def fixture_infixes : List String := [ "/test/", "/tests/", "/quality/fixtures/" ];

def fixture_exact : List String := [ "samples/tutorial/04_holes.ouro" ];

def is_fixture (p : String) : Bool :=
  orb (starts_any p fixture_prefixes)
    (orb (contains_any p fixture_infixes) (name_in p fixture_exact));

inductive LayerRule : Type :=
  | LayerPrefix : String -> Nat -> LayerRule
  | LayerExact : String -> Nat -> LayerRule;

def layer_rule_matches (p : String) (rule : LayerRule) : Bool :=
  match rule with
  | LayerPrefix prefix _ => str_starts p prefix
  | LayerExact path _ => str_eq p path
  end;

def layer_rule_value (rule : LayerRule) : Nat :=
  match rule with
  | LayerPrefix _ n => n
  | LayerExact _ n => n
  end;

-- First match wins: std, then the kernel file, then the rest of compiler.
def file_layer_rules : List LayerRule :=
  [ LayerPrefix "std/" Z
  , LayerExact "compiler/kernel.ouro" Z
  , LayerPrefix "compiler/" (S Z)
  , LayerPrefix "tools/analyze/" 2
  , LayerPrefix "tests/analyze/" 2
  ];

def file_layer_of (p : String) : Nat :=
  match find LayerRule (layer_rule_matches p) file_layer_rules with
  | Nothing => 3
  | Just rule => layer_rule_value rule
  end;

def classify_file (p : String) : AFile :=
  MkAFile p (file_layer_of p)
    (str_eq p "compiler/kernel.ouro")
    (str_starts p "compiler/") (str_starts p "std/");

