-- @entry main
import "bounded_report.ouro",
  "../../std/io.ouro",
  "../../std/json.ouro",
  "../../std/text.ouro";

def bounded_report_input_limit : Nat := mul(64, mul(mul 32 32, mul 32 32));

def bounded_report_fail (message : String) : IO Unit :=
    do eprintln (str_concat "ANALYZE_REPORT_FAIL: " message);
       exit 2

def bounded_report_run (count : Nat) : IO Unit :=
    if ltb_nat bounded_report_input_limit count then bounded_report_fail "input byte limit exceeded"
    else do let! text := prim_stdin_read_bytes (S count);
            if notb (eq_nat(count, str_len text)) then bounded_report_fail "incomplete or excess stdin bytes"
            else match parse_json text with
            | Nothing => bounded_report_fail "malformed JSON request"
            | Just value => match bounded_report_decode value with
              | Nothing => bounded_report_fail "invalid provider request"
              | Just request => let (MkPair response code) := bounded_report_result request in
                  do println (json_print response);
                     exit code
              end
            end

def main : IO Unit :=
    match! prim_argv with
    | Cons _ rest => match rest with
      | Cons flag rest2 => match rest2 with
        | Cons bytes rest3 =>
            if andb(str_eq flag "--input-bytes", nullb String rest3) then
              match str_parse_nat bytes with
              | Nothing => bounded_report_fail "invalid stdin byte count"
              | Just count => bounded_report_run count
              end
            else bounded_report_fail "usage: ouro-analyze-report --input-bytes N"
        | Nil => bounded_report_fail "usage: ouro-analyze-report --input-bytes N"
        end
      | Nil => bounded_report_fail "usage: ouro-analyze-report --input-bytes N"
      end
    | Nil => bounded_report_fail "usage: ouro-analyze-report --input-bytes N"
    end
