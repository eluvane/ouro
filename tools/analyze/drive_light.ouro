-- Drive wiring for the light family cores: effects, match, cfg, dataflow,
-- semantic, and property. Maps each core's issues to findings anchored at
-- the owning definition.

import "../../std/data.ouro",
  "../../std/listx.ouro",
  "../../std/natx.ouro",
  "../../std/string_prims.ouro",
  "../../compiler/pipeline_abi.ouro",
  "policy_ids.ouro",
  "unit.ouro",
  "finding.ouro",
  "drive_env.ouro",
  "effects.ouro",
  "match_cover.ouro",
  "cfg.ouro",
  "dataflow.ouro",
  "semantic.ouro",
  "property.ouro";

-- Literals above this are magic numbers unless a definition names them.
def sem_magic_threshold : Nat := 10;

-- Lambda nesting deeper than this is reported.
def sem_lambda_limit : Nat := 3;

def eff_finding (e : DriveEnv) (d : DefInfo) (i : EffIssue) : Finding :=
    match i with
    | IPureHole n => finding_at "OURO-EFF001" d (hole_witness e n " under @pure")
    | IConstRebind n =>
        finding_at "OURO-EFF002" d (drive_cat("rebinds ", env_name e n))
    | IUnhandledPerform op =>
        finding_at "OURO-EFF003" d
          (drive_cat3 "perform " (env_name e op) " outside any handle")
    | IHandleMissingOp op =>
        finding_at "OURO-EFF004" d
          (drive_cat("handle has no clause for ", env_name e op))
    | IDiscardedCont op =>
        finding_at "OURO-EFF005" d
          (drive_cat3 "clause " (env_name e op) " binds its continuation to _")
    | IPureEffect op =>
        finding_at "OURO-EFF006" d
          (drive_cat3 "perform " (env_name e op) " under @pure")
    end;

def match_finding (e : DriveEnv) (d : DefInfo) (i : MatchIssue) : Finding :=
    match i with
    | IPartialMatch ctor =>
        finding_at "OURO-MATCH001" d
          (drive_cat("missing constructor ", env_name e ctor))
    | IDeadBranch ctor =>
        finding_at "OURO-MATCH002" d
          (drive_cat("duplicate branch for ", env_name e ctor))
    end;

def cfg_finding (e : DriveEnv) (d : DefInfo) (i : CfgIssue) : Finding :=
    match i with
    | IEmptyMatch _ => finding_at "OURO-CFG001" d "match with no arms"
    | ITrivialMatch c =>
        finding_at "OURO-CFG002" d
          (drive_cat3 "single arm " (env_name e c) " binds nothing")
    | IUncheckedRecursion r =>
        finding_at "OURO-CFG003" d
          (drive_cat3 "fix " (env_name e r) " recurses without matching a parameter")
    | IUnreachableBranch c =>
        finding_at "OURO-CFG004" d
          (drive_cat("arm repeats constructor ", env_name e c))
    end;

def df_finding (e : DriveEnv) (d : DefInfo) (i : DfIssue) : Finding :=
    match i with
    | IUnusedParam n =>
        finding_at "OURO-DF001" d
          (drive_cat3 "parameter " (env_name e n) " is never read")
    | IDeadStore n =>
        finding_at "OURO-DF002" d (drive_cat3 "let " (env_name e n) " is never used")
    | IAlias n =>
        finding_at "OURO-DF003" d (drive_cat3 "let " (env_name e n) " aliases a name")
    | IHoleFlow n =>
        finding_at "OURO-DF004" d (hole_witness e n " in a value position")
    end;

def sem_finding (d : DefInfo) (i : SemIssue) : Finding :=
    match i with
    | IMagicNat n =>
        finding_at "OURO-SEM001" d (drive_cat("literal ", drive_nat n))
    | IComplexScrut _ =>
        finding_at "OURO-SEM002" d "scrutinee nests a match, let, fix, handle, or do"
    | ILambdaNest depth =>
        finding_at "OURO-SEM003" d
          (drive_cat3 "lambda nesting depth " (drive_nat depth)
            (drive_cat(" exceeds ", drive_nat sem_lambda_limit)))
    | IPartialEq _ =>
        finding_at "OURO-SEM004" d "one-arm match returns a Bool constructor"
    | IOddIdentity n =>
        finding_at "OURO-SEM005" d
          (drive_cat(drive_nat n, " parameters are never mentioned by the body"))
    end;

def prop_finding (e : DriveEnv) (d : DefInfo) (i : PropIssue) : Finding :=
    match i with
    | INoHoles n =>
        finding_at "OURO-PROP001" d (hole_witness e n " under @property no-holes")
    | IExhaustiveEmpty _ =>
        finding_at "OURO-PROP002" d "match with no arms under @property exhaustive"
    | IExhaustiveMissing c =>
        finding_at "OURO-PROP003" d
          (drive_cat("missing constructor ", env_name e c))
    | IAlwaysTerminates r =>
        finding_at "OURO-PROP004" d
          (drive_cat3 "fix " (env_name e r) " recurses without a structural guard")
    end;

def prop_wants_of (e : DriveEnv) (d : DefInfo) : PropWants :=
    MkPropWants (property_wants e d "no-holes") (property_wants e d "exhaustive")
      (property_wants e d "terminates");

def bool_ids_of (e : DriveEnv) : List Nat :=
    unit_ids_of(env_intern e, ["True", "False"] : List String);

def effects_findings (e : DriveEnv) (d : DefInfo) : List Finding :=
    map EffIssue Finding (eff_finding e d)
      (analyze_effects(info_ast d, def_is_pure d, env_cap e, env_layer e));

def match_findings (e : DriveEnv) (d : DefInfo) : List Finding :=
    map MatchIssue Finding (match_finding e d)
      (analyze_match_ast(env_ctors e, env_ctor_like e, info_ast d));

def cfg_findings (e : DriveEnv) (d : DefInfo) : List Finding :=
    map CfgIssue Finding (cfg_finding e d)
      (analyze_cfg (env_ctor_like e) (types_dependent (env_types e))
        (types_uninhabited (env_types e)) (info_ast d));

def dataflow_findings (e : DriveEnv) (d : DefInfo) : List Finding :=
    map(DfIssue, Finding, df_finding e d, analyze_dataflow(env_discards e, info_ast d));

-- Parser combinators nest lambdas by construction. Lambda nesting is a
-- smell only when the definition asked for a complexity review.
def sem_keep (d : DefInfo) (i : SemIssue) : Bool :=
    match i with
    | ILambdaNest _ => has_anno("complexity", info_annos d)
    | IMagicNat _ => True
    | IComplexScrut _ => True
    | IPartialEq _ => True
    | IOddIdentity _ => True
    end;

def semantic_findings (e : DriveEnv) (d : DefInfo) : List Finding :=
    map SemIssue Finding (sem_finding d)
      (filter SemIssue (sem_keep d)
        (analyze_semantic sem_magic_threshold sem_lambda_limit
          (unit_id_of(env_intern e, "S")) (bool_ids_of e) (env_discards e)
          (info_ast d)));

def property_findings (e : DriveEnv) (d : DefInfo) : List Finding :=
    map PropIssue Finding (prop_finding e d)
      (analyze_property(prop_wants_of e d, env_ctors e, info_ast d));

def light_family_runners : List (Pair String (DriveEnv -> DefInfo -> List Finding)) :=
  [ runner fam_effects effects_findings
  , runner fam_match match_findings
  , runner fam_cfg cfg_findings
  , runner fam_dataflow dataflow_findings
  , runner fam_semantic semantic_findings
  , runner fam_property property_findings
  ];
