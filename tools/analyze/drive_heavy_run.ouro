-- Thin keep-import surface for drive_heavy. Family cores stay skip-harvested
-- unless this file is the selected root.
import "drive_heavy.ouro",
  "unit.ouro";


def heavy_run_table : List (Pair String (DriveEnv -> DefInfo -> List Finding)) :=
    heavy_family_runners;


def heavy_dup_findings (fams : List String) (e : DriveEnv) (defs : List UnitDef)
    : List Finding :=
    dup_findings fams e defs;


def heavy_orphan_findings (fams : List String) (e : DriveEnv) : List Finding :=
    orphan_findings fams e;
