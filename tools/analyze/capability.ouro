-- Call-site capability policy. Interned prim/host-fast ids, not name spelling
-- inside the core. Layer decides who may call what.

-- @entry analyze_capability

import "../../std/data.ouro",
  "../../std/listx.ouro",
  "../../std/string_prims.ouro",
  "ast.ouro",
  "policy_ids.ouro";

inductive CapIssue : Type :=
  | IPrimFs : Nat -> CapIssue
  | IPrimProc : Nat -> CapIssue
  | IPrimHttp : Nat -> CapIssue
  | IHostFastPeano : Nat -> CapIssue;

def cap_icons (i : CapIssue) (is : List CapIssue) : List CapIssue :=
    Cons CapIssue i is;
def cap_inil : List CapIssue := [];
def cap_append_issues (xs : List CapIssue) (ys : List CapIssue) : List CapIssue :=
    append CapIssue xs ys;

def call_issue (ly : Layer) (ids : CapIds) (n : Nat) : List CapIssue :=
    match mem_id(n, cap_proc ids) with
    | True =>
        match layer_allows_proc ly with
        | True => cap_inil
        | False => cap_icons(IPrimProc n, cap_inil)
        end
    | False =>
        match mem_id(n, cap_http ids) with
        | True =>
            match layer_allows_http ly with
            | True => cap_inil
            | False => cap_icons(IPrimHttp n, cap_inil)
            end
        | False =>
            match mem_id(n, cap_fs ids) with
            | True =>
                match layer_allows_fs ly with
                | True => cap_inil
                | False => cap_icons(IPrimFs n, cap_inil)
                end
            | False => cap_inil
            end
        end
    end;

def cap_walk_list (go : Ast -> List CapIssue) : List Ast -> List CapIssue :=
  concat_map Ast CapIssue go;

def analyze_cap_go (ly : Layer) (ids : CapIds) : Ast -> List CapIssue :=
  fun (root : Ast) =>
    (fix analyze_cap_go (fuel : Nat) (a : Ast) : List CapIssue :=
      match fuel with
      | Z => cap_inil
      | S remaining =>
          let descend (child : Ast) : List CapIssue := analyze_cap_go remaining child in
          match a with
          | AVar n => call_issue ly ids n
          | AApp f x =>
              let headIss : List CapIssue :=
                match head_id f with
                | Nothing => cap_inil
                | Just n => call_issue ly ids n
                end in
              cap_append_issues headIss
                (cap_append_issues(descend f, descend x))
          | AFix n binders ret body =>
              let peano : List CapIssue :=
                match mem_id(n, cap_fast ids) with
                | True => cap_icons(IHostFastPeano n, cap_inil)
                | False => cap_inil
                end in
              cap_append_issues peano
                (cap_append_issues (descend binders)
                  (cap_append_issues(descend ret, descend body)))
          | ALam _ ann body =>
              cap_append_issues(descend ann, descend body)
          | APi _ dom cod =>
              cap_append_issues(descend dom, descend cod)
          | ALet _ ann v body =>
              cap_append_issues (descend ann)
                (cap_append_issues(descend v, descend body))
          | AAscribe e t =>
              cap_append_issues(descend e, descend t)
          | ABinder _ ty rest =>
              cap_append_issues(descend ty, descend rest)
          | ABranch _ _ body rest =>
              cap_append_issues(descend body, descend rest)
          | AMatch s b =>
              cap_append_issues(descend s, descend b)
          | AHandle inner cls =>
              cap_append_issues(descend inner, descend cls)
          | AClause _ _ body rest =>
              cap_append_issues(descend body, descend rest)
          | APerform n args =>
              cap_append_issues(call_issue ly ids n, cap_walk_list descend args)
          | ADo xs => cap_walk_list descend xs
          | AList xs => cap_walk_list descend xs
          | AListSpread _ _ => cap_walk_list descend (ast_children a)
          | AStr _ => cap_inil
          | AHole _ => cap_inil
          | ASort _ => cap_inil
          | ANatLit _ => cap_inil
          | ARange _ _ _ => cap_inil
          | ANoBinder => cap_inil
          | ANoBranch => cap_inil
          | ANoClause => cap_inil
          end
      end) (ast_size root) root;

def analyze_capability (a : Ast) (ly : Layer) (ids : CapIds) : List CapIssue :=
    analyze_cap_go ly ids a;
