-- Line-oriented extraction is deliberate: analyzer fixtures use source markers that the parser discards.

import "../../std/pathx.ouro",
  "model.ouro",
  "extract_tokens.ouro",
  "../../std/fs.ouro",
  "../quality/import_scan.ouro";

inductive LineRule : Type :=
  | LineKw : Nat -> List Nat -> Nat -> LineRule
  | LineChar : Nat -> Nat -> LineRule;

def line_kind_rules : List LineRule :=
  [ LineKw 105 kw_import_cs (S Z)
  , LineKw 105 kw_inductive_cs 4
  , LineKw 100 kw_def_cs 2
  , LineKw 97 kw_axiom_cs 3
  , LineKw 114 kw_record_cs 5
  , LineKw 101 kw_effect_cs 6
  , LineChar ch_pipe 7
  ];

def line_kind (trimmed : List Nat) : Nat :=
  match trimmed with
  | Nil => Z
  | Cons c _ =>
      match find LineRule
        (fun (rule : LineRule) =>
          match rule with
          | LineKw first kw _ =>
              andb(eq_nat c first, codes_start_word kw trimmed)
          | LineChar first _ => eq_nat c first
          end)
        line_kind_rules with
      | Nothing => Z
      | Just rule =>
          match rule with
          | LineKw _ _ kind => kind
          | LineChar _ kind => kind
          end
      end
  end;

def parse_kw_name_cs (line : List Nat) (word : List Nat)
    : Maybe (Pair String Nat) :=
  let trimmed : List Nat := drop_while Nat is_ws line in
  match codes_start_word word trimmed with
  | False => Nothing (Pair String Nat)
  | True =>
      let rest : List Nat :=
        drop_while Nat is_ws (drop Nat (length Nat word) trimmed) in
      match take_ident_cs rest with
      | MkPair _ name =>
          match str_null name with
          | True => Nothing (Pair String Nat)
          | False =>
              Just (Pair String Nat)
                (MkPair String Nat name
                  (S (sub(length Nat line, length Nat rest))))
          end
      end
  end;

def parse_ctor_cs (line : List Nat) : Maybe (Pair String Nat) :=
  let trimmed : List Nat := drop_while Nat is_ws line in
  match trimmed with
  | Cons p after_pipe =>
      match eq_nat p ch_pipe with
      | False => Nothing (Pair String Nat)
      | True =>
          let rest : List Nat := drop_while Nat is_ws after_pipe in
          match take_ident_cs rest with
          | MkPair after name =>
              match str_null name with
              | True => Nothing (Pair String Nat)
              | False =>
                  match drop_while Nat is_ws after with
                  | Cons c _ =>
                      match eq_nat c ch_colon with
                      | False => Nothing (Pair String Nat)
                      | True =>
                          Just (Pair String Nat)
                            (MkPair String Nat name
                              (S (sub (length Nat line)
                                (length Nat rest))))
                      end
                  | Nil => Nothing (Pair String Nat)
                  end
              end
          end
      end
  | Nil => Nothing (Pair String Nat)
  end;

def pat_ouro_analyze_cs : List Nat :=
  [111, 117, 114, 111, 45, 97, 110, 97, 108, 121, 122, 101, 58];
def pat_entry_cs : List Nat := [64, 101, 110, 116, 114, 121];
def pat_analyze_entry_cs : List Nat :=
  [111, 117, 114, 111, 45, 97, 110, 97, 108, 121, 122, 101, 58,
    101, 110, 116, 114, 121];
def pat_export_cs : List Nat := [64, 101, 120, 112, 111, 114, 116];
def pat_public_cs : List Nat := [45, 45, 32, 112, 117, 98, 108, 105, 99];
def pat_api_root_cs : List Nat :=
  [111, 117, 114, 111, 45, 97, 110, 97, 108, 121, 122, 101, 58,
    97, 112, 105, 45, 114, 111, 111, 116];
def pat_allow_layer_cs : List Nat :=
  [111, 117, 114, 111, 45, 97, 110, 97, 108, 121, 122, 101, 58,
    97, 108, 108, 111, 119, 45, 108, 97, 121, 101, 114, 45, 105, 109,
    112, 111, 114, 116];
def pat_allow_trust_cs : List Nat :=
  [111, 117, 114, 111, 45, 97, 110, 97, 108, 121, 122, 101, 58,
    97, 108, 108, 111, 119, 45, 116, 114, 117, 115, 116, 45, 105, 109,
    112, 111, 114, 116];
def pat_ouro_lint_cs : List Nat :=
  [111, 117, 114, 111, 45, 108, 105, 110, 116, 58];

def take_code (s : String) : Pair String String :=
  match span Nat
    (fun (c : Nat) =>
      orb(is_alnum c, orb(eq_nat c ch_under, eq_nat c ch_minus)))
    (str_codes s) with
  | MkPair code rest =>
      MkPair(String, String, str_of_codes code, str_of_codes rest)
  end;

def skip_tag_sep (cs : List Nat) : List Nat :=
  drop_while Nat
    (fun (c : Nat) =>
      orb (is_ws c)
        (orb (eq_nat c ch_slash)
          (orb(eq_nat c ch_comma, eq_nat c ch_pipe))))
    cs;

-- A marker may name several roots. Stop at another annotation or punctuation.
-- Fuel is first: take_ident_cs does not expose a smaller Rel of `cs`.
def tagged_name_list : List Nat -> List String -> Pair (List Nat) (List String) :=
  fun (cs : List Nat) (found : List String) =>
    (fix go (fuel : Nat) (xs : List Nat) (acc : List String)
        : Pair (List Nat) (List String) :=
      match fuel with
      | Z => MkPair(List Nat, List String, xs, acc)
      | S fuel' =>
          let rest : List Nat := skip_tag_sep xs in
          match take_ident_cs rest with
          | MkPair more name =>
              match str_null name with
              | True => MkPair(List Nat, List String, more, acc)
              | False => go fuel' more (Cons String name acc)
              end
          end
      end) (S (length Nat cs)) cs found;

def tagged_names (line : String) (tag : String) : List String :=
  (fix go (fuel : Nat) (s : String) (acc : List String) : List String :=
    match fuel with
    | Z => reverse String acc
    | S fuel' =>
        match str_index s tag with
        | Nothing => reverse String acc
        | Just i =>
            let offset : Nat := add(i, str_len tag) in
            let rest_text : String := str_drop s offset in
            let rest0 : List Nat := str_codes rest_text in
            match tagged_name_list rest0 acc with
            | MkPair more found => go fuel' (str_of_codes more) found
            end
        end
    end) (mul n8 n8) line (Nil String);

def policy_layer_rows : List (Pair String Nat) :=
  [ MkPair String Nat "layer=0" Z
  , MkPair String Nat "layer=1" (S Z)
  , MkPair String Nat "layer=2" 2
  , MkPair String Nat "layer=3" 3
  , MkPair String Nat "layer=4" 4
  ];

def policy_layer_of (line : String) (cur : Nat) : Nat :=
  match find (Pair String Nat)
    (fun (row : Pair String Nat) =>
      match row with
      | MkPair mark _ => str_contains line mark
      end)
    policy_layer_rows with
  | Nothing => cur
  | Just row =>
      match row with
      | MkPair _ n => n
      end
  end;

def policy_flag (line : String) (yes : String) (no : String) (cur : Bool) : Bool :=
  match str_contains line yes with
  | True => True
  | False =>
      match str_contains line no with
      | True => False
      | False => cur
      end
  end;

def apply_policy (f : AFile) (line : String) : AFile :=
  match str_contains line "ouro-analyze:" with
  | False => f
  | True =>
      let layer : Nat :=
        policy_layer_of(line, AFile_layer f) in
      let trusted : Bool :=
        policy_flag line "trusted=true" "trusted=false" (AFile_trusted f) in
      let ci : Bool :=
        policy_flag line "compiler-internal=true" "compiler-internal=false"
          (AFile_compiler_internal f) in
      let sr : Bool :=
        policy_flag line "std-runtime=true" "std-runtime=false"
          (AFile_std_runtime f) in
      MkAFile (AFile_path f) layer trusted ci sr
  end;

inductive FileAcc : Type :=
  | MkFileAcc : AFile -> List AEdge -> List ADecl -> String ->
      List String -> List String -> String -> List (List Nat) ->
      List (Pair Nat (List Nat)) -> FileAcc;

def FileAcc_file (a : FileAcc) : AFile :=
  match a with | MkFileAcc f _ _ _ _ _ _ _ _ => f end;
def FileAcc_edges (a : FileAcc) : List AEdge :=
  match a with | MkFileAcc _ e _ _ _ _ _ _ _ => e end;
def FileAcc_decls (a : FileAcc) : List ADecl :=
  match a with | MkFileAcc _ _ d _ _ _ _ _ _ => d end;
def FileAcc_last_ind (a : FileAcc) : String :=
  match a with | MkFileAcc _ _ _ s _ _ _ _ _ => s end;
def FileAcc_entries (a : FileAcc) : List String :=
  match a with | MkFileAcc _ _ _ _ e _ _ _ _ => e end;
def FileAcc_exports (a : FileAcc) : List String :=
  match a with | MkFileAcc _ _ _ _ _ e _ _ _ => e end;
def FileAcc_src (a : FileAcc) : String :=
  match a with | MkFileAcc _ _ _ _ _ _ src _ _ => src end;
def FileAcc_lines (a : FileAcc) : List (List Nat) :=
  match a with | MkFileAcc _ _ _ _ _ _ _ lines _ => lines end;
def FileAcc_supp_lines (a : FileAcc) : List (Pair Nat (List Nat)) :=
  match a with | MkFileAcc _ _ _ _ _ _ _ _ supps => supps end;

def FileAcc_put_decl (acc : FileAcc) (d : ADecl) (last_ind : String)
    : FileAcc :=
  MkFileAcc (FileAcc_file acc) (FileAcc_edges acc)
    (Cons ADecl d (FileAcc_decls acc)) last_ind
    (FileAcc_entries acc) (FileAcc_exports acc) (FileAcc_src acc)
    (FileAcc_lines acc) (FileAcc_supp_lines acc);

def path_is_std (path : String) : Bool :=
  str_starts path "std/";

def allow_layer_entry : String := "@allow-layer-import";
def allow_trust_entry : String := "@allow-trust-import";

def FileAcc_allow_layer (a : FileAcc) : Bool :=
  name_in(allow_layer_entry, FileAcc_entries a);
def FileAcc_allow_trust (a : FileAcc) : Bool :=
  name_in(allow_trust_entry, FileAcc_entries a);

def clear_allow_entries (entries : List String) : List String :=
  filter String
    (fun (name : String) =>
      andb (notb (str_eq name allow_layer_entry))
        (notb (str_eq name allow_trust_entry)))
    entries;

inductive ImportAt : Type :=
  | MkImportAt : String -> Nat -> Nat -> Nat -> ImportAt;

def ImportAt_path (site : ImportAt) : String :=
  match site with | MkImportAt path _ _ _ => path end;
def ImportAt_decl_line (site : ImportAt) : Nat :=
  match site with | MkImportAt _ n _ _ => n end;
def ImportAt_line (site : ImportAt) : Nat :=
  match site with | MkImportAt _ _ n _ => n end;
def ImportAt_col (site : ImportAt) : Nat :=
  match site with | MkImportAt _ _ _ n => n end;

def import_at (src : String) (row : ScannedImport) : ImportAt :=
  match row with
  | MkScannedImport path _ declaration_byte quote_byte _ _ =>
      match import_scan_place src declaration_byte with
      | MkPair declaration_line _ =>
          match import_scan_place src quote_byte with
          | MkPair line col => MkImportAt path declaration_line line (sub(col, S Z))
          end
      end
  end;

-- Public API is the `-- public` marker, an API root, a std path, or an axiom;
-- `@export` is recorded separately and is a promise, not a reachability root.
def add_def (acc : FileAcc) (cs : List Nat) (line_no : Nat)
    (name : String) (col : Nat) (is_ax : Bool) (marked_pub : Bool)
    (api_root : Bool) : FileAcc :=
  let path : String := AFile_path (FileAcc_file acc) in
  let pub : Bool :=
    orb(marked_pub, orb(api_root, path_is_std path)) in
  let ex : Bool := name_in(name, FileAcc_exports acc) in
  let public : Bool := orb is_ax pub in
  let api_checked : Bool := andb(notb is_ax, pub) in
  let sig_hash : List Nat :=
    match api_checked with
    | True => fnv1a64_codes (normalize_signature_cs cs)
    | False => w64_zero
    end in
  let d : ADecl :=
    MkADecl name Z line_no col kind_def
      (orb(name_in(name, FileAcc_entries acc), fe_seam name))
      public api_checked
      is_ax ex False (ns_of_path path) ""
      sig_hash in
  FileAcc_put_decl acc d (FileAcc_last_ind acc);

def add_ind (acc : FileAcc) (line_no : Nat) (name : String) (col : Nat)
    (marked_pub : Bool) (api_root : Bool) : FileAcc :=
  let path : String := AFile_path (FileAcc_file acc) in
  let pub : Bool := orb(marked_pub, orb(api_root, path_is_std path)) in
  let d : ADecl :=
    MkADecl name Z line_no col kind_def
      (name_in(name, FileAcc_entries acc)) pub False False
      (name_in(name, FileAcc_exports acc)) False (ns_of_path path) ""
      w64_zero in
  FileAcc_put_decl acc d name;

def add_ctor (acc : FileAcc) (line_no : Nat) (name : String) (col : Nat)
    : FileAcc :=
  let path : String := AFile_path (FileAcc_file acc) in
  let d : ADecl :=
    MkADecl name Z line_no col kind_ctor
      (name_in(name, FileAcc_entries acc))
      (path_is_std path) False False
      (name_in(name, FileAcc_exports acc)) False
      (ns_of_path path)
      (FileAcc_last_ind acc) w64_zero in
  FileAcc_put_decl acc d (FileAcc_last_ind acc);

inductive DeclStep : Type :=
  | DsDef : DeclStep
  | DsAxiom : DeclStep
  | DsType : DeclStep
  | DsCtor : DeclStep
  | DsSkip : DeclStep;

def decl_step_rows : List (Pair Nat DeclStep) :=
  [ MkPair Nat DeclStep 2 DsDef
  , MkPair Nat DeclStep 3 DsAxiom
  , MkPair Nat DeclStep 4 DsType
  , MkPair Nat DeclStep 5 DsType
  , MkPair Nat DeclStep 6 DsType
  , MkPair Nat DeclStep 7 DsCtor
  ];

def decl_step_of (kind : Nat) : DeclStep :=
  match lookup Nat DeclStep eq_nat kind decl_step_rows with
  | Nothing => DsSkip
  | Just step => step
  end;

def type_kw_rows : List (Pair Nat (List Nat)) :=
  [ MkPair Nat (List Nat) 4 kw_inductive_cs
  , MkPair Nat (List Nat) 5 kw_record_cs
  , MkPair Nat (List Nat) 6 kw_effect_cs
  ];

def type_kw_of (kind : Nat) : List Nat :=
  match lookup Nat (List Nat) eq_nat kind type_kw_rows with
  | Nothing => kw_effect_cs
  | Just word => word
  end;

def step_import (acc : FileAcc) (site : ImportAt) : FileAcc :=
  let e : AEdge :=
    MkAEdge Z no_idx
      (path_resolve_from_file(AFile_path (FileAcc_file acc), ImportAt_path site))
      (ImportAt_line site) (ImportAt_col site)
      (FileAcc_allow_layer acc) (FileAcc_allow_trust acc) in
  MkFileAcc (FileAcc_file acc)
    (Cons AEdge e (FileAcc_edges acc))
    (FileAcc_decls acc) (FileAcc_last_ind acc)
    (clear_allow_entries (FileAcc_entries acc))
    (FileAcc_exports acc) (FileAcc_src acc) (FileAcc_lines acc)
    (FileAcc_supp_lines acc);

def step_named (acc0 : FileAcc) (cs : List Nat) (line_no : Nat)
    (is_axiom : Bool) : FileAcc :=
  let word : List Nat :=
    match is_axiom with
    | True => kw_axiom_cs
    | False => kw_def_cs
    end in
  match parse_kw_name_cs cs word with
  | Nothing => acc0
  | Just p =>
      match p with
      | MkPair name col =>
          add_def acc0 cs line_no name col is_axiom
            (codes_contains pat_public_cs cs)
            (codes_contains pat_api_root_cs cs)
      end
  end;

def step_type (acc0 : FileAcc) (cs : List Nat) (line_no : Nat)
    (kind : Nat) : FileAcc :=
  match parse_kw_name_cs(cs, type_kw_of kind) with
  | Nothing => acc0
  | Just p =>
      match p with
      | MkPair name col =>
          add_ind acc0 line_no name col
            (codes_contains pat_public_cs cs)
            (codes_contains pat_api_root_cs cs)
      end
  end;

def step_ctor (acc0 : FileAcc) (cs : List Nat) (line_no : Nat) : FileAcc :=
  match parse_ctor_cs cs with
  | Nothing => acc0
  | Just p =>
      match p with
      | MkPair name col => add_ctor acc0 line_no name col
      end
  end;

def step_decl (acc0 : FileAcc) (cs : List Nat)
    (line_no : Nat) (kind : Nat) : FileAcc :=
  match decl_step_of kind with
  | DsDef => step_named acc0 cs line_no False
  | DsAxiom => step_named acc0 cs line_no True
  | DsType => step_type acc0 cs line_no kind
  | DsCtor => step_ctor acc0 cs line_no
  | DsSkip => acc0
  end;

def step_line (acc : FileAcc) (cs0 : List Nat) (line_no : Nat)
    (sites : List ImportAt) (has_import_decl : Bool) : FileAcc :=
  let trimmed : List Nat := drop_while Nat is_ws cs0 in
  let raw_kind : Nat := line_kind trimmed in
  let kind : Nat :=
    match andb(eq_nat(raw_kind, S Z), notb has_import_decl) with
    | True => Z
    | False => raw_kind
    end in
  let is_marker_line : Bool :=
    match trimmed with
    | Cons c1 rest => codes_start_pair ch_minus ch_minus c1 rest
    | Nil => False
    end in
  let has_policy : Bool :=
    match is_marker_line with
    | True => codes_contains pat_ouro_analyze_cs cs0
    | False => False
    end in
  let has_supp : Bool :=
    match is_marker_line with
    | True => codes_contains pat_ouro_lint_cs cs0
    | False => False
    end in
  let has_at : Bool :=
    match is_marker_line with
    | True => codes_has ch_at cs0
    | False => False
    end in
  let has_entry : Bool :=
    match has_at with
    | True => codes_contains pat_entry_cs cs0
    | False => False
    end in
  let has_analyze_entry : Bool :=
    match has_policy with
    | True => codes_contains pat_analyze_entry_cs cs0
    | False => False
    end in
  let has_export : Bool :=
    match has_at with
    | True => codes_contains pat_export_cs cs0
    | False => False
    end in
  let relevant : Bool :=
    orb (notb (eq_nat kind Z))
      (orb has_policy
        (orb(has_supp, orb(has_entry,
          orb(has_analyze_entry, orb(has_export, notb (nullb ImportAt sites))))))) in
  match relevant with
  | False => acc
  | True =>
      let cs : List Nat :=
        match codes_has ch_cr cs0 with
        | True => drop_cr_cs cs0
        | False => cs0
        end in
      let line : String :=
        match orb has_policy
          (orb(has_entry, orb has_analyze_entry has_export)) with
        | True => str_of_codes cs
        | False => ""
        end in
      let f2 : AFile :=
        match has_policy with
        | True => apply_policy(FileAcc_file acc, line)
        | False => FileAcc_file acc
        end in
      let ents0 : List String :=
        match orb has_entry has_analyze_entry with
        | False => FileAcc_entries acc
        | True =>
            append String (FileAcc_entries acc)
              (append String
                (match has_entry with
                 | True => tagged_names line "@entry"
                 | False => Nil String
                 end)
                (match has_analyze_entry with
                 | True => tagged_names line "ouro-analyze:entry"
                 | False => Nil String
                  end))
        end in
      let ents1 : List String :=
        match has_policy with
        | False => ents0
        | True =>
            match codes_contains pat_allow_layer_cs cs with
            | True => Cons String allow_layer_entry ents0
            | False => ents0
            end
        end in
      let ents2 : List String :=
        match has_policy with
        | False => ents1
        | True =>
            match codes_contains pat_allow_trust_cs cs with
            | True => Cons String allow_trust_entry ents1
            | False => ents1
            end
        end in
      let ents : List String :=
        match orb(has_policy, orb(eq_nat(kind, S Z), notb (nullb ImportAt sites))) with
        | True => ents2
        | False => clear_allow_entries ents2
        end in
      let exps : List String :=
        match has_export with
        | False => FileAcc_exports acc
        | True =>
            append(String, FileAcc_exports acc, tagged_names line "@export")
        end in
      let supps : List (Pair Nat (List Nat)) :=
        match has_supp with
        | False => FileAcc_supp_lines acc
        | True =>
            Cons (Pair(Nat, List Nat))
              (MkPair Nat (List Nat) line_no cs)
              (FileAcc_supp_lines acc)
        end in
      let acc0 : FileAcc :=
        MkFileAcc f2 (FileAcc_edges acc) (FileAcc_decls acc)
          (FileAcc_last_ind acc) ents exps (FileAcc_src acc)
          (FileAcc_lines acc) supps in
      foldl ImportAt FileAcc step_import
        (step_decl acc0 cs line_no kind) sites
  end;

def extract_go (acc : FileAcc) (ls : List (List Nat))
    (sites : List ImportAt) (n : Nat) : FileAcc :=
  (fix go (xs : List (List Nat)) (pending : List ImportAt)
      (a : FileAcc) (k : Nat) : FileAcc :=
    match xs with
    | Nil => a
    | Cons ln rest =>
        match span ImportAt
          (fun (site : ImportAt) => eq_nat(ImportAt_line site, k))
          pending with
        | MkPair on_line after =>
            let has_decl : Bool :=
              any ImportAt
                (fun (site : ImportAt) => eq_nat(ImportAt_decl_line site, k))
                pending in
            go(rest, after, step_line a ln k on_line has_decl, S k)
        end
    end) ls sites acc n;

def extract_file (path : String) (src : String)
    : Either ImportScanError FileAcc :=
  match scan_source_imports src with
  | Left error => Left ImportScanError FileAcc error
  | Right imports =>
      let lines : List (List Nat) := split_on(ch_lf, str_codes src) in
      let sites : List ImportAt :=
        map ScannedImport ImportAt (import_at src) imports in
      Right ImportScanError FileAcc
        (extract_go
          (MkFileAcc (classify_file path) (Nil AEdge) (Nil ADecl) ""
            (Nil String) (Nil String) src lines
            (Nil (Pair(Nat, List Nat))))
          lines sites (S Z))
  end;
