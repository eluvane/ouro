-- Drive wiring for the smell families: simplify, perf, naming, and errors.
-- Resolves the names each core keys on in the unit's intern table and maps
-- the cores' issues to findings anchored at the owning definition.

import "../../std/data.ouro";
import "../../std/listx.ouro";
import "../../std/natx.ouro";
import "string_prims.ouro";
import "unit.ouro";
import "finding.ouro";
import "drive_env.ouro";
import "policy_ids.ouro";
import "simplify.ouro";
import "perf.ouro";
import "naming.ouro";
import "errors.ouro";

-- Smallest literal reported inside a fix body: the extracted runtime rebuilds
-- an inline numeral as a Peano chain on every evaluation, and below this the
-- chain is shorter than the closure that would name it.
def perf_literal_threshold : Nat := 8;

def perf_compare_names : List String :=
  [ "eq_nat", "eqNat", "ltb_nat", "leb_nat", "ltbNat", "lebNat", "compareNat" ];

-- Heads that copy their first value argument: appending to it inside a loop
-- is quadratic.
def perf_append_names : List String :=
  [ "append", "snoc", "concat", "str_concat", "prim_string_concat" ];

-- Conversions that allocate a structure proportional to their argument.
def perf_conversion_names : List String :=
  [ "prim_string_to_char_codes", "prim_string_of_char_codes", "str_codes"
  , "ncodes", "length", "reverse" ];

def errh_failure_success_names : List (Pair String String) :=
  [ MkPair String String "Left" "Right", MkPair String String "Fail" "Ok" ];

def simp_finding (e : DriveEnv) (d : DefInfo) (i : SimpIssue) : Finding :=
    match i with
    | IBoolIdentity _ =>
        finding_at "OURO-SIMP001" d "match on a Bool returns its scrutinee"
    | IBoolNegation _ =>
        finding_at "OURO-SIMP002" d "match on a Bool negates its scrutinee"
    | IIdenticalArms n =>
        finding_at "OURO-SIMP003" d
          (drive_cat (drive_nat n) " arms share one body")
    | IEtaLambda x =>
        finding_at "OURO-SIMP004" d
          (drive_cat3 "lambda over " (env_name e x) " only forwards its argument")
    | IDoubleNot _ => finding_at "OURO-SIMP005" d "notb applied to notb"
    | IConstBoolOperand op lit =>
        finding_at "OURO-SIMP006" d
          (drive_cat3 (env_name e op) " with operand " (env_name e lit))
    | IRewrapIdentity n =>
        finding_at "OURO-SIMP007" d
          (drive_cat3 "all " (drive_nat n) " arms rebuild their own constructor")
    end;

def perf_finding (e : DriveEnv) (d : DefInfo) (i : PerfIssue) : Finding :=
    match i with
    | ILiteralInLoop r n =>
        finding_at "OURO-PERF001" d
          (drive_cat3 "literal " (drive_nat n) (drive_cat " inside fix " (env_name e r)))
    | IAccumulatorAppend r h p =>
        finding_at "OURO-PERF002" d
          (drive_cat3 (env_name e h) " on parameter "
            (drive_cat3 (env_name e p) " feeds fix " (env_name e r)))
    | ILengthCompare kind =>
        finding_at "OURO-PERF003" d
          (match kind with
           | Z => "length compared with 0 or 1"
           | S _ => "match on length reads no count"
           end)
    | IRepeatedConversion h v n =>
        finding_at "OURO-PERF004" d
          (drive_cat3 (env_name e h) " "
            (drive_cat3 (env_name e v) " evaluated "
              (drive_cat (drive_nat n) " times on one path")))
    | IStrictBoolOperand op =>
        finding_at "OURO-PERF005" d
          (drive_cat (env_name e op) " operand nests control flow or a recursive call")
    end;

def name_finding (e : DriveEnv) (d : DefInfo) (i : NameIssue) : Finding :=
    match i with
    | IUsedDiscard x =>
        finding_at "OURO-NAME001" d
          (drive_cat3 "binder " (env_name e x) " is spelt as a discard but read")
    | IShortName _ => finding_at "OURO-NAME002" d "one-character definition name"
    | ICapitalDef _ =>
        finding_at "OURO-NAME003" d "value definition spelt with a capital initial"
    end;

def errh_finding (e : DriveEnv) (d : DefInfo) (i : ErrIssue) : Finding :=
    match i with
    | IStringError _ => finding_at "OURO-ERR001" d "result type is Either String"
    | IErrorToSuccess f s =>
        finding_at "OURO-ERR002" d
          (drive_cat3 "arm " (env_name e f)
            (drive_cat " drops its payload and returns " (env_name e s)))
    | IIgnoredResult x =>
        finding_at "OURO-ERR003" d
          (match x with
           | Z => "io_bind over an Either binds its result to _"
           | S _ =>
               drive_cat3 "io_bind over an Either binds its result to "
                 (env_name e x) ", which is never read"
           end)
    end;

def simp_ids_of (e : DriveEnv) : SimpIds :=
    let st : InternState := env_intern e in
    MkSimpIds (unit_id_of st "True") (unit_id_of st "False") (unit_id_of st "notb")
      (unit_id_of st "andb") (unit_id_of st "orb");

def perf_ids_of (e : DriveEnv) : PerfIds :=
    let st : InternState := env_intern e in
    MkPerfIds (unit_id_of st "length") (unit_id_of st "Z") (unit_id_of st "S")
      (unit_ids_of st perf_compare_names) (unit_ids_of st perf_append_names)
      (unit_ids_of st perf_conversion_names)
      (unit_ids_of st (["andb", "orb"] : List String))
      (map (Pair Nat Nat) Nat (fst Nat Nat) (env_ctors e));

-- Constructor pairs both of whose names the unit mentions.
def errh_pairs_of (st : InternState) : List (Pair Nat Nat) :=
    concat_map (Pair String String) (Pair Nat Nat)
      (fun (p : Pair String String) =>
        match p with
        | MkPair f s =>
            let fid : Nat := unit_id_of st f in
            let sid : Nat := unit_id_of st s in
            match orb (eq_nat fid Z) (eq_nat sid Z) with
            | True => Nil (Pair Nat Nat)
            | False => ([MkPair Nat Nat fid sid] : List (Pair Nat Nat))
            end
        end)
      errh_failure_success_names;

def errh_ids_of (e : DriveEnv) : ErrIds :=
    let st : InternState := env_intern e in
    MkErrIds (unit_id_of st "Either") (unit_id_of st "String") (unit_id_of st "IO")
      (unit_id_of st "io_bind") (unit_id_of st "io_pure") (errh_pairs_of st);

-- Each runner resolves its ids when applied to the unit and returns the
-- per-definition step: an intern lookup converts the name and scans the
-- table, which is far too costly to repeat for every definition.
def simplify_findings (e : DriveEnv) : DefInfo -> List Finding :=
    let ids : SimpIds := simp_ids_of e in
    fun (d : DefInfo) =>
      map SimpIssue Finding (simp_finding e d)
        (analyze_simplify ids (env_ctor_like e) (info_id d) (info_ast d));

def perf_findings (e : DriveEnv) : DefInfo -> List Finding :=
    let ids : PerfIds := perf_ids_of e in
    fun (d : DefInfo) =>
      map PerfIssue Finding (perf_finding e d)
        (analyze_perf ids (env_ctor_like e) perf_literal_threshold (info_ast d));

-- Identity elimination and its demos keep the type-theory spelling.
def nm_conventional_def (name : String) : Bool :=
    orb (prim_string_eq name "J") (prim_string_eq name "J_id");

def nm_keep_issue (d : DefInfo) (i : NameIssue) : Bool :=
    match i with
    | IUsedDiscard _ => True
    | IShortName _ => notb (nm_conventional_def (info_name d))
    | ICapitalDef _ => notb (nm_conventional_def (info_name d))
    end;

def naming_findings (e : DriveEnv) : DefInfo -> List Finding :=
    let inductives : List Nat :=
      map (Pair Nat Nat) Nat (fst Nat Nat) (types_lines (env_types e)) in
    fun (d : DefInfo) =>
      map NameIssue Finding (name_finding e d)
        (filter NameIssue (nm_keep_issue d)
          (analyze_naming (env_discards e) inductives (unit_name_codes (env_intern e))
            (unit_name_codes (env_intern e) (info_id d)) (info_ast d)));

-- Std and samples keep `Either String` as the current checked-arith and
-- demo channel. A bare Either String in tools still reports.
def errh_report_string (ly : Layer) : Bool :=
    match ly with
    | LyStd => False
    | LyStdIo => False
    | LyStdHttp => False
    | LyStdWord => False
    | LySamples => False
    | LyCompiler => True
    | LyAnalyze => True
    | LyTools => True
    | LyKernel => True
    | LyOther => True
    end;

def errh_keep_issue (ly : Layer) (i : ErrIssue) : Bool :=
    match i with
    | IStringError _ => errh_report_string ly
    | IErrorToSuccess _ _ => True
    | IIgnoredResult _ => True
    end;

def errors_findings (e : DriveEnv) : DefInfo -> List Finding :=
    let ids : ErrIds := errh_ids_of e in
    fun (d : DefInfo) =>
      map ErrIssue Finding (errh_finding e d)
        (filter ErrIssue (errh_keep_issue (env_layer e))
          (analyze_errors ids (env_discards e) (info_ast d)));

-- Constructor spellings are a property of the inductive, so the finding is
-- anchored at the `inductive` line and named after the owner.
-- Type-theory and indexed-family constructors keep their conventional
-- spellings; a made-up lowercase name in a fixture still reports.
def nm_conventional_ctor (name : String) : Bool :=
    orb (prim_string_eq name "refl")
      (orb (prim_string_eq name "tt")
        (orb (prim_string_eq name "acc")
          (orb (prim_string_eq name "leaf")
            (orb (prim_string_eq name "node")
              (orb (prim_string_eq name "vnil") (prim_string_eq name "vcons"))))));

def ctor_name_finding (e : DriveEnv) (p : Pair Nat Nat) : List Finding :=
    match p with
    | MkPair ctor owner =>
        match nm_conventional_ctor (env_name e ctor) with
        | True => Nil Finding
        | False =>
            match nm_ctor_misspelt (unit_name_codes (env_intern e) ctor) with
            | False => Nil Finding
            | True =>
                [MkFinding "OURO-NAME004" (types_line_of (env_types e) owner)
                  (env_name e owner)
                  (drive_cat3 "constructor " (env_name e ctor)
                    " starts with a lowercase letter or underscore")]
            end
        end
    end;

-- Unit-wide: evaluation is strict, so a disabled family is skipped by the
-- match rather than handed a computed result to drop.
def ctor_name_findings (fams : List String) (e : DriveEnv) : List Finding :=
    match fam_on fams fam_naming with
    | False => Nil Finding
    | True => concat_map (Pair Nat Nat) Finding (ctor_name_finding e) (env_ctors e)
    end;
