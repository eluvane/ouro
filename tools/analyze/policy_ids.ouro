-- Shared layer and interned-name policy for effect/capability/extract cores.

-- @entry layer_allows_proc
-- @entry layer_allows_http
-- @entry layer_allows_fs
-- @entry layer_is_std
-- @entry last_id

import "../../std/data.ouro",
  "../../std/natx.ouro";

inductive Layer : Type :=
  | LyStd : Layer
  | LyStdIo : Layer
  | LyStdHttp : Layer
  | LyStdWord : Layer
  | LyCompiler : Layer
  | LyAnalyze : Layer
  | LyTools : Layer
  | LySamples : Layer
  | LyKernel : Layer
  | LyOther : Layer;

-- underscore, pure, process prims, HTTP prims, fs prims, host-fast
-- names, IO, kernel names.
inductive CapIds : Type :=
  | MkCap : Nat -> Nat -> List Nat -> List Nat -> List Nat -> List Nat -> Nat
      -> List Nat -> CapIds;

def cap_under (c : CapIds) : Nat :=
    match c with | MkCap n _ _ _ _ _ _ _ => n end;

def cap_pure (c : CapIds) : Nat :=
    match c with | MkCap _ n _ _ _ _ _ _ => n end;

def cap_proc (c : CapIds) : List Nat :=
    match c with | MkCap _ _ n _ _ _ _ _ => n end;

def cap_http (c : CapIds) : List Nat :=
    match c with | MkCap _ _ _ n _ _ _ _ => n end;

def cap_fs (c : CapIds) : List Nat :=
    match c with | MkCap _ _ _ _ xs _ _ _ => xs end;

def cap_fast (c : CapIds) : List Nat :=
    match c with | MkCap _ _ _ _ _ xs _ _ => xs end;

def cap_io (c : CapIds) : Nat :=
    match c with | MkCap _ _ _ _ _ _ n _ => n end;

def cap_kern (c : CapIds) : List Nat :=
    match c with | MkCap _ _ _ _ _ _ _ xs => xs end;

def mem_id (target : Nat) : List Nat -> Bool :=
    elem Nat eq_nat target;

def last_id : List Nat -> Maybe Nat :=
  fix last_id (xs : List Nat) : Maybe Nat :=
    match xs with
    | Nil => Nothing Nat
    | Cons n rest =>
        match rest with
        | Nil => Just Nat n
        | Cons _ _ => last_id rest
        end
    end;

def layer_is_std (ly : Layer) : Bool :=
    match ly with
    | LyStd => True
    | LyStdIo => True
    | LyStdHttp => True
    | LyStdWord => True
    | LyCompiler => False
    | LyAnalyze => False
    | LyTools => False
    | LySamples => False
    | LyKernel => False
    | LyOther => False
    end;

def layer_allows_proc (ly : Layer) : Bool :=
    match ly with
    | LyStdIo => True
    | LyStdHttp => True
    | LyTools => True
    | LySamples => True
    | LyStd => False
    | LyStdWord => False
    | LyCompiler => False
    | LyAnalyze => False
    | LyKernel => False
    | LyOther => False
    end;

def layer_allows_http (ly : Layer) : Bool :=
    match ly with
    | LySamples => True
    | LyStdHttp => True
    | LyStd => False
    | LyStdIo => False
    | LyStdWord => False
    | LyCompiler => False
    | LyAnalyze => False
    | LyTools => False
    | LyKernel => False
    | LyOther => False
    end;

def layer_allows_fs (ly : Layer) : Bool :=
    match ly with
    | LyStdIo => True
    | LyTools => True
    | LySamples => True
    | LyStd => False
    | LyStdHttp => False
    | LyStdWord => False
    | LyCompiler => False
    | LyAnalyze => False
    | LyKernel => False
    | LyOther => False
    end;
