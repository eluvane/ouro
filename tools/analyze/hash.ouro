-- FNV-1a output matches the Python baseline generator byte-for-byte.

import "../../compiler/canonical_hash.ouro";
import "../../std/string.ouro";
import "../../std/bytes.ouro";
import "../../std/word.ouro";

def n8 : Nat := 8;
def n16 : Nat := 16;

def w64_zero : List Nat := [Z, Z, Z, Z, Z, Z, Z, Z];

-- Host offset UINT64_C(1469598103934665603) = 0x14650fb0739d0383.
-- This is the truncated constant api_baseline_regen.py and the analyzer use,
-- not the textbook FNV-1a 64 offset 0xcbf29ce484222325.
def fnv1a64_codes (cs : List Nat) : List Nat :=
  canonical_hash_bytes (canonical_hash_codes cs);

def w64_eq : List Nat -> List Nat -> Bool :=
  fix w64_eq (xs : List Nat) (ys : List Nat) : Bool :=
    match xs with
    | Nil =>
        match ys with
        | Nil => True
        | Cons _ _ => False
        end
    | Cons x xr =>
        match ys with
        | Nil => False
        | Cons y yr =>
            match eq_nat x y with
            | False => False
            | True => w64_eq xr yr
            end
        end
    end;

-- Recur on the remaining-byte Nat first. A two-arg fix with the list first
-- fails the structural checker: padding calls pass a fresh Nil, not a
-- smaller Rel, which the host reports as a type mismatch.
def parse_hex64_cs : List Nat -> Nat -> List Nat :=
  fun (xs : List Nat) (left : Nat) =>
    (fix go (n : Nat) (cs : List Nat) : List Nat :=
      match n with
      | Z => Nil Nat
      | S n' =>
          match cs with
          | Nil => Cons Nat Z (go n' (Nil Nat))
          | Cons lo rest =>
              match rest with
              | Nil => Cons Nat (digit_val lo) (go n' (Nil Nat))
              | Cons hi rest2 =>
                  Cons Nat (add (mul (digit_val hi) n16) (digit_val lo))
                    (go n' rest2)
              end
          end
      end) left xs;

def parse_hex64 (s : String) : List Nat :=
  parse_hex64_cs
    (reverse Nat (filter Nat is_hex (str_codes s)))
    n8;

def hex64_show (w : List Nat) : String :=
  str_of_codes (hex_encode (reverse Nat w));
