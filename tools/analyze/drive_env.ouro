-- Vocabulary shared by the drive and its per-family wiring modules: family
-- names, the per-unit environment, the per-definition record, annotation
-- helpers, and the finding constructor that anchors a code to a definition.

-- @entry layer_name

import "../../std/data.ouro";
import "../../std/listx.ouro";
import "../../std/string_prims.ouro";
import "../../compiler/pipeline_abi.ouro";
import "policy_ids.ouro";
import "unit.ouro";
import "finding.ouro";
import "runtime_contracts.ouro";

def fam_effects : String := "effects";
def fam_capability : String := "capability";
def fam_extract : String := "extract";
def fam_match : String := "match";
def fam_cfg : String := "cfg";
def fam_dataflow : String := "dataflow";
def fam_semantic : String := "semantic";
def fam_property : String := "property";
def fam_absint : String := "absint";
def fam_symexec : String := "symexec";
def fam_taint : String := "taint";
def fam_contracts : String := "contracts";
def fam_metrics : String := "metrics";
def fam_duplication : String := "duplication";
def fam_trust : String := "trust";
def fam_simplify : String := "simplify";
def fam_perf : String := "perf";
def fam_naming : String := "naming";
def fam_errors : String := "errors";

def fam_on (fams : List String) (fam : String) : Bool :=
    elem String prim_string_eq fam fams;

def drive_cat (a : String) (b : String) : String := prim_string_concat a b;

def drive_cat3 (a : String) (b : String) (c : String) : String :=
    prim_string_concat a (prim_string_concat b c);

def drive_nat (n : Nat) : String := prim_string_of_nat n;

-- intern table, capability ids, inductive shapes, constructor-like ids,
-- discard ids, marks, layer, file-level annotations, unit is trusted.
inductive DriveEnv : Type :=
  | MkDriveEnv : InternState -> CapIds -> UnitTypes -> List Nat
      -> List Nat -> UnitMarks -> Layer -> List CtrAnno -> Bool -> DriveEnv;

def env_intern (e : DriveEnv) : InternState :=
    match e with | MkDriveEnv st _ _ _ _ _ _ _ _ => st end;

def env_cap (e : DriveEnv) : CapIds :=
    match e with | MkDriveEnv _ ids _ _ _ _ _ _ _ => ids end;

def env_types (e : DriveEnv) : UnitTypes :=
    match e with | MkDriveEnv _ _ types _ _ _ _ _ _ => types end;

def env_ctors (e : DriveEnv) : List (Pair Nat Nat) := types_ctors (env_types e);

def env_ctor_like (e : DriveEnv) : List Nat :=
    match e with | MkDriveEnv _ _ _ cl _ _ _ _ _ => cl end;

def env_discards (e : DriveEnv) : List Nat :=
    match e with | MkDriveEnv _ _ _ _ ds _ _ _ _ => ds end;

def env_marks (e : DriveEnv) : UnitMarks :=
    match e with | MkDriveEnv _ _ _ _ _ m _ _ _ => m end;

def env_layer (e : DriveEnv) : Layer :=
    match e with | MkDriveEnv _ _ _ _ _ _ ly _ _ => ly end;

def env_file_annos (e : DriveEnv) : List CtrAnno :=
    match e with | MkDriveEnv _ _ _ _ _ _ _ annos _ => annos end;

def env_trusted (e : DriveEnv) : Bool :=
    match e with | MkDriveEnv _ _ _ _ _ _ _ _ trusted => trusted end;

def env_name (e : DriveEnv) (id : Nat) : String := unit_name (env_intern e) id;

-- line, name id, name, body, annotations of the block above, public.
inductive DefInfo : Type :=
  | MkDefInfo : Nat -> Nat -> String -> Ast -> List CtrAnno -> Bool -> DefInfo;

def info_line (d : DefInfo) : Nat :=
    match d with | MkDefInfo l _ _ _ _ _ => l end;

def info_id (d : DefInfo) : Nat :=
    match d with | MkDefInfo _ n _ _ _ _ => n end;

def info_name (d : DefInfo) : String :=
    match d with | MkDefInfo _ _ s _ _ _ => s end;

def info_ast (d : DefInfo) : Ast :=
    match d with | MkDefInfo _ _ _ a _ _ => a end;

def info_annos (d : DefInfo) : List CtrAnno :=
    match d with | MkDefInfo _ _ _ _ annos _ => annos end;

def info_public (d : DefInfo) : Bool :=
    match d with | MkDefInfo _ _ _ _ _ p => p end;

def finding_at (code : String) (d : DefInfo) (witness : String) : Finding :=
    MkFinding code (info_line d) (info_name d) witness;

def layer_override (src : String) (fallback : Layer) : Layer :=
    match prim_string_contains src "ouro-analyze:layer=std" with
    | True => LyStd
    | False =>
        match prim_string_contains src "ouro-analyze:layer=samples" with
        | True => LySamples
        | False =>
            match prim_string_contains src "ouro-analyze:layer=io" with
            | True => LyStdIo
            | False => fallback
            end
        end
    end;

def layer_name (ly : Layer) : String :=
    match ly with
    | LyStd => "std"
    | LyStdIo => "std-io"
    | LyStdHttp => "std-http"
    | LyStdWord => "std-word"
    | LyCompiler => "compiler"
    | LyAnalyze => "analyze"
    | LyTools => "tools"
    | LySamples => "samples"
    | LyKernel => "kernel"
    | LyOther => "other"
    end;

def def_info (e : DriveEnv) (d : UnitDef) : DefInfo :=
    MkDefInfo (unit_def_line d) (unit_def_name d) (env_name e (unit_def_name d))
      (unit_def_ast d) (ctr_parse_annos (unit_def_notes d))
      (mem Nat eq_nat (unit_def_name d) (marks_public (env_marks e)));

def anno_named (name : String) (a : CtrAnno) : Bool :=
    prim_string_eq (ctr_anno_name a) name;

def annos_named (name : String) (annos : List CtrAnno) : List CtrAnno :=
    filter CtrAnno (anno_named name) annos;

def has_anno (name : String) (annos : List CtrAnno) : Bool :=
    any CtrAnno (anno_named name) annos;

-- `@property WORD ...` directives mentioning `word`, on the definition or at
-- file level.
def property_wants (e : DriveEnv) (d : DefInfo) (word : String) : Bool :=
    any CtrAnno
      (fun (a : CtrAnno) =>
        andb (anno_named "property" a) (prim_string_contains (ctr_anno_text a) word))
      (append CtrAnno (info_annos d) (env_file_annos e));

def def_is_pure (d : DefInfo) : Bool := has_anno "pure" (info_annos d);

def hole_witness (e : DriveEnv) (n : Nat) (tail : String) : String :=
    match n with
    | Z => drive_cat "anonymous hole" tail
    | S _ => drive_cat3 "hole ?" (env_name e n) tail
    end;

def from_layer (e : DriveEnv) (n : Nat) (verb : String) : String :=
    drive_cat3 (env_name e n) verb (layer_name (env_layer e));

def runner (fam : String) (run : DriveEnv -> DefInfo -> List Finding)
    : Pair String (DriveEnv -> DefInfo -> List Finding) :=
    MkPair String (DriveEnv -> DefInfo -> List Finding) fam run;
