-- Minimality checks prefer small, named shapes over clever one-off
-- expressions. A `@minimal` definition claims that none of the rewrites this
-- core knows would make it smaller: no hole, no let that merely aliases a
-- variable or literal, no one-arm match that binds nothing, no match on a
-- literal or constructor application.

-- @entry minimal_issues
-- @entry minimal_score
-- @entry minimal_fingerprint

import "../../std/data.ouro";
import "../../std/listx.ouro";
import "../../std/natx.ouro";
import "ast.ouro";

-- nodes, nodes without ascription types, holes.
inductive MinScore : Type :=
  | MkMinScore : Nat -> Nat -> Nat -> MinScore;

def min_score_nodes (s : MinScore) : Nat :=
    match s with | MkMinScore n _ _ => n end;

-- hole (id); let aliasing a variable or literal (bound name); one-arm match
-- binding nothing (arm ctor); match on a literal or constructor application
-- (head ctor or Z).
inductive MinIssue : Type :=
  | IMinHole : Nat -> MinIssue
  | IMinAlias : Nat -> MinIssue
  | IMinTrivialMatch : Nat -> MinIssue
  | IMinConstantScrutinee : Nat -> MinIssue;

def min_inil : List MinIssue := [];

def min_icons (i : MinIssue) (is : List MinIssue) : List MinIssue :=
    Cons MinIssue i is;

def min_append (xs : List MinIssue) (ys : List MinIssue) : List MinIssue :=
    append MinIssue xs ys;

def min_add (a : MinScore) (b : MinScore) : MinScore :=
    match a with
    | MkMinScore n1 s1 h1 =>
        match b with
        | MkMinScore n2 s2 h2 => MkMinScore (add n1 n2) (add s1 s2) (add h1 h2)
        end
    end;

def min_sum : List MinScore -> MinScore :=
  fix min_sum (xs : List MinScore) : MinScore :=
    match xs with
    | Nil => MkMinScore Z Z Z
    | Cons s rest => min_add s (min_sum rest)
    end;

def min_node (s : MinScore) : MinScore :=
    match s with
    | MkMinScore n st h => MkMinScore (S n) (S st) h
    end;

-- Ascription types count as nodes but not as stripped nodes.
def minimal_score : Ast -> MinScore :=
  fun (root : Ast) =>
    (fix minimal_score (fuel : Nat) (a : Ast) : MinScore :=
      match fuel with
      | Z => MkMinScore Z Z Z
      | S remaining =>
          let descend : Ast -> MinScore :=
            fun (child : Ast) => minimal_score remaining child in
          match a with
          | AHole _ => MkMinScore (S Z) (S Z) (S Z)
          | AAscribe e t =>
              match descend e with
              | MkMinScore ne se he =>
                  match descend t with
                  | MkMinScore nt _ ht => MkMinScore (S (add ne nt)) se (add he ht)
                  end
              end
          | AVar _ => MkMinScore (S Z) (S Z) Z
          | ASort _ => MkMinScore (S Z) (S Z) Z
          | ANatLit _ => MkMinScore (S Z) (S Z) Z
          | AStr _ => MkMinScore (S Z) (S Z) Z
          | ANoBinder => MkMinScore (S Z) (S Z) Z
          | ANoBranch => MkMinScore (S Z) (S Z) Z
          | ANoClause => MkMinScore (S Z) (S Z) Z
          | AApp _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | ALam _ _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | APi _ _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | ALet _ _ _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | ABinder _ _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | AFix _ _ _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | ABranch _ _ _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | AMatch _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | APerform _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | AHandle _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | AClause _ _ _ _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | ADo _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          | AList _ => min_node (min_sum (map Ast MinScore descend (ast_children a)))
          end
      end) (ast_size root) root;

-- Separator between sibling fingerprints; larger than every tag.
def min_sep : Nat := add ast_tag_count (S Z);

-- Shape fingerprint: constructor tags in preorder with sibling separators;
-- names, literals, and ascription types do not contribute.
def minimal_fingerprint : Ast -> List Nat :=
  fun (root : Ast) =>
    (fix minimal_fingerprint (fuel : Nat) (a : Ast) : List Nat :=
      match fuel with
      | Z => Nil Nat
      | S remaining =>
          let descend : Ast -> List Nat :=
            fun (child : Ast) => minimal_fingerprint remaining child in
          match a with
          | AAscribe e _ => descend e
          | AVar _ => [ast_tag a]
          | AHole _ => [ast_tag a]
          | ASort _ => [ast_tag a]
          | ANatLit _ => [ast_tag a]
          | AStr _ => [ast_tag a]
          | ANoBinder => [ast_tag a]
          | ANoBranch => [ast_tag a]
          | ANoClause => [ast_tag a]
          | AApp _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | ALam _ _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | APi _ _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | ALet _ _ _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | ABinder _ _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | AFix _ _ _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | ABranch _ _ _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | AMatch _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | APerform _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | AHandle _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | AClause _ _ _ _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | ADo _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          | AList _ => Cons Nat (ast_tag a) (concat_map Ast Nat (fun (k : Ast) => Cons Nat min_sep (descend k)) (ast_children a))
          end
      end) (ast_size root) root;

def min_is_alias (v : Ast) : Bool :=
    let core : Ast := ast_peel_ascribe v in
    orb (ast_is tag_var core) (orb (ast_is tag_nat core) (ast_is tag_str core));

-- A scrutinee that is a literal or a constructor application decides at
-- compile time; a bare constructor variable such as `Z` does too.
def min_constant_scrut (ctor_like : List Nat) (s : Ast) : Maybe Nat :=
    let core : Ast := ast_peel_ascribe s in
    match orb (ast_is tag_nat core) (orb (ast_is tag_str core) (ast_is tag_list core)) with
    | True => Just Nat Z
    | False =>
        match ast_app_head core with
        | Nothing => Nothing Nat
        | Just h =>
            match mem Nat eq_nat h ctor_like with
            | True => Just Nat h
            | False => Nothing Nat
            end
        end
    end;

def min_trivial_arm (branches : Ast) : Maybe Nat :=
    match branches with
    | ABranch ctor binders _ rest =>
        match andb (ast_is tag_no_branch rest) (nullb Nat binders) with
        | True => Just Nat ctor
        | False => Nothing Nat
        end
    | ANoBranch => Nothing Nat
    | AVar _ => Nothing Nat
    | AHole _ => Nothing Nat
    | ASort _ => Nothing Nat
    | ANatLit _ => Nothing Nat
    | AStr _ => Nothing Nat
    | AApp _ _ => Nothing Nat
    | ALam _ _ _ => Nothing Nat
    | APi _ _ _ => Nothing Nat
    | ALet _ _ _ _ => Nothing Nat
    | AAscribe _ _ => Nothing Nat
    | ABinder _ _ _ => Nothing Nat
    | ANoBinder => Nothing Nat
    | AFix _ _ _ _ => Nothing Nat
    | AMatch _ _ => Nothing Nat
    | APerform _ _ => Nothing Nat
    | AHandle _ _ => Nothing Nat
    | AClause _ _ _ _ => Nothing Nat
    | ANoClause => Nothing Nat
    | ADo _ => Nothing Nat
    | AList _ => Nothing Nat
    end;

def min_maybe_issue (m : Maybe Nat) (mk : Nat -> MinIssue) : List MinIssue :=
    match m with
    | Nothing => min_inil
    | Just n => min_icons (mk n) min_inil
    end;

def min_node_issues (ctor_like : List Nat) (a : Ast) : List MinIssue :=
    match a with
    | AHole id => min_icons (IMinHole id) min_inil
    | ALet id _ v _ =>
        match andb (min_is_alias v) (notb (eq_nat id Z)) with
        | True => min_icons (IMinAlias id) min_inil
        | False => min_inil
        end
    | AMatch scrut branches =>
        min_append
          (min_maybe_issue (min_trivial_arm branches) (fun (c : Nat) => IMinTrivialMatch c))
          (min_maybe_issue (min_constant_scrut ctor_like scrut)
            (fun (c : Nat) => IMinConstantScrutinee c))
    | AVar _ => min_inil
    | ASort _ => min_inil
    | ANatLit _ => min_inil
    | AStr _ => min_inil
    | AApp _ _ => min_inil
    | ALam _ _ _ => min_inil
    | APi _ _ _ => min_inil
    | AAscribe _ _ => min_inil
    | ABinder _ _ _ => min_inil
    | ANoBinder => min_inil
    | AFix _ _ _ _ => min_inil
    | ABranch _ _ _ _ => min_inil
    | ANoBranch => min_inil
    | APerform _ _ => min_inil
    | AHandle _ _ => min_inil
    | AClause _ _ _ _ => min_inil
    | ANoClause => min_inil
    | ADo _ => min_inil
    | AList _ => min_inil
    end;

def min_walk (ctor_like : List Nat) : Ast -> List MinIssue :=
  fun (root : Ast) =>
    (fix min_walk (fuel : Nat) (a : Ast) : List MinIssue :=
      match fuel with
      | Z => min_inil
      | S remaining =>
          let descend : Ast -> List MinIssue :=
            fun (child : Ast) => min_walk remaining child in
          min_append (min_node_issues ctor_like a)
            (concat_map Ast MinIssue descend (ast_children a))
      end) (ast_size root) root;

-- ctor_like: ids the unit recognises as constructors.
def minimal_issues (ctor_like : List Nat) (a : Ast) : List MinIssue :=
    min_walk ctor_like a;
