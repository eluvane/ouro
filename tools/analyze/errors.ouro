-- Error-handling hygiene: raw String error channels, failure arms that answer
-- with success while dropping the error, and checked results bound to a
-- discard. The rules read declared types and explicit type arguments; they
-- never infer a type the source does not spell out.

-- @entry analyze_errors

import "../../std/data.ouro",
  "../../std/listx.ouro",
  "../../std/natx.ouro",
  "ast.ouro",
  "dataflow.ouro";

-- Either, String, IO, io_bind, io_pure, and the failure/success constructor
-- pairs (Left/Right, Fail/Ok); a missing name is Z and matches nothing.
inductive ErrIds : Type :=
  | MkErrIds : Nat -> Nat -> Nat -> Nat -> Nat -> List (Pair Nat Nat)
      -> List Nat -> ErrIds;

def errh_either (i : ErrIds) : Nat :=
    match i with | MkErrIds e _ _ _ _ _ _ => e end;

def errh_string (i : ErrIds) : Nat :=
    match i with | MkErrIds _ s _ _ _ _ _ => s end;

def errh_io (i : ErrIds) : Nat :=
    match i with | MkErrIds _ _ io _ _ _ _ => io end;

def errh_bind (i : ErrIds) : Nat :=
    match i with | MkErrIds _ _ _ b _ _ _ => b end;

def errh_pure (i : ErrIds) : Nat :=
    match i with | MkErrIds _ _ _ _ p _ _ => p end;

def errh_pairs (i : ErrIds) : List (Pair Nat Nat) :=
    match i with | MkErrIds _ _ _ _ _ ps _ => ps end;

def errh_bind_labels (i : ErrIds) : List Nat :=
    match i with | MkErrIds _ _ _ _ _ _ labels => labels end;

-- result type is Either String (Z); failure arm drops its payload and
-- returns the success constructor (failure, success); io_bind over an Either
-- binds the result to a discard (binder).
inductive ErrIssue : Type :=
  | IStringError : Nat -> ErrIssue
  | IErrorToSuccess : Nat -> Nat -> ErrIssue
  | IIgnoredResult : Nat -> ErrIssue;

def errh_inil : List ErrIssue := [];

def errh_one (i : ErrIssue) : List ErrIssue := Cons ErrIssue i errh_inil;

def errh_append (xs : List ErrIssue) (ys : List ErrIssue) : List ErrIssue :=
    append ErrIssue xs ys;

def errh_four : Nat := 4;

def errh_head_of (a : Ast) : Nat :=
    match ast_app_head a with
    | Just h => h
    | Nothing => Z
    end;

def errh_is_call_of (h : Nat) (a : Ast) : Bool :=
    match h with
    | Z => False
    | S _ => andb(ast_is(tag_app, ast_peel_ascribe a), eq_nat(errh_head_of a, h))
    end;

def errh_either_string (ids : ErrIds) (t : Ast) : Bool :=
    match eq_nat(errh_string ids, Z) with
    | True => False
    | False =>
        match errh_is_call_of(errh_either ids, t) with
        | False => False
        | True =>
            match ast_args t with
            | Nil => False
            | Cons e _ => eq_nat(ast_var_or_zero e, errh_string ids)
            end
        end
    end;

-- `IO (Either String A)` is the host error channel. Only a bare
-- `Either String` result is the untyped-error smell.
def errh_type_issues (ids : ErrIds) (a : Ast) : List ErrIssue :=
    match ast_declared_type a with
    | Nothing => errh_inil
    | Just t =>
        let result : Ast := ast_result_type t in
        match errh_is_call_of(errh_io ids, result) with
        | True => errh_inil
        | False =>
            match errh_either_string ids result with
            | True => errh_one (IStringError Z)
            | False => errh_inil
            end
        end
    end;

-- Every payload binder is a wildcard, a discard, or never read.
def errh_drops_payload (discards : List Nat) (m : AstArm) : Bool :=
    all Nat (fun (id : Nat) =>
      match id with
      | Z => True
      | S _ =>
          orb (mem Nat eq_nat id discards)
            (notb (ast_occurs(id, ast_arm_body m)))
      end) (ast_arm_binders m);

-- Head of the value an arm evaluates to, through lets, do-blocks, and
-- io_pure; Z when the arm branches again or performs.
def errh_result_head (ids : ErrIds) : Ast -> Nat :=
  fun (root : Ast) =>
    (fix errh_result_head (fuel : Nat) (a : Ast) : Nat :=
      match fuel with
      | Z => Z
      | S remaining =>
          let descend (child : Ast) : Nat := errh_result_head remaining child in
          match a with
          | AAscribe e _ => descend e
          | ALet _ _ _ body => descend body
          | ADo xs =>
              match xs with
              | Nil => Z
              | Cons x rest =>
                  match rest with
                  | Nil => descend x
                  | Cons _ _ => descend (ADo rest)
                  end
              end
          | AApp _ _ =>
              match errh_is_call_of(errh_pure ids, a) with
              | False => errh_head_of a
              | True =>
                  match reverse(Ast, ast_args a) with
                  | Nil => Z
                  | Cons last _ => descend last
                  end
              end
          | AVar v => v
          | AHole _ => Z
          | ASort _ => Z
          | ANatLit _ => Z
          | AStr _ => Z
          | ALam _ _ _ => Z
          | APi _ _ _ => Z
          | ABinder _ _ _ => Z
          | ANoBinder => Z
          | AFix _ _ _ _ => Z
          | ABranch _ _ _ _ => Z
          | ANoBranch => Z
          | AMatch _ _ => Z
          | APerform _ _ => Z
          | AHandle _ _ => Z
          | AClause _ _ _ _ => Z
          | ANoClause => Z
          | AList _ => Z
          | ANamedCall _ _ => Z
          end
      end) (ast_size root) root;

def errh_success_of (pairs : List (Pair Nat Nat)) (failure : Nat) : Nat :=
    match failure with
    | Z => Z
    | S _ =>
        match lookup Nat Nat eq_nat failure pairs with
        | Just s => s
        | Nothing => Z
        end
    end;

-- `| Left _ => Right T x`: the failure is not propagated, logged, or
-- inspected; the caller sees a success it cannot tell from a real one.
def errh_arm_issue (ids : ErrIds) (discards : List Nat) (m : AstArm) : List ErrIssue :=
    let s : Nat := errh_success_of(errh_pairs ids, ast_arm_ctor m) in
    match s with
    | Z => errh_inil
    | S _ =>
        match andb (errh_drops_payload discards m)
          (eq_nat(errh_result_head(ids, ast_arm_body m), s)) with
        | True => errh_one (IErrorToSuccess(ast_arm_ctor m, s))
        | False => errh_inil
        end
    end;

def errh_match_issues (ids : ErrIds) (discards : List Nat) (branches : Ast) : List ErrIssue :=
    match ast_arms branches with
    | Nothing => errh_inil
    | Just arms => concat_map AstArm ErrIssue (errh_arm_issue ids discards) arms
    end;

def errh_discarded (discards : List Nat) (x : Nat) (body : Ast) : Bool :=
    match x with
    | Z => True
    | S _ =>
        orb (mem Nat eq_nat x discards)
          (match df_count_uses x body with
           | Z => True
           | S _ => False
           end)
    end;

-- `io_bind (Either E A) B act (fun (_ : Either E A) => k)`: the checked result
-- is bound and never looked at, so the failure is silently dropped.
def errh_bind_issue (ids : ErrIds) (discards : List Nat) (a : Ast) : List ErrIssue :=
    match errh_is_call_of(errh_bind ids, a) with
    | False => errh_inil
    | True =>
        let args : List Ast := ast_args a in
        match eq_nat(length Ast args, errh_four) with
        | False => errh_inil
        | True =>
            match args with
            | Nil => errh_inil
            | Cons ty rest =>
                match errh_is_call_of(errh_either ids, ty) with
                | False => errh_inil
                | True =>
                    match reverse Ast rest with
                    | Nil => errh_inil
                    | Cons k _ =>
                        match ast_peel_ascribe k with
                        | ALam x _ body =>
                            match errh_discarded discards x body with
                            | True => errh_one (IIgnoredResult x)
                            | False => errh_inil
                            end
                        | AVar _ => errh_inil
                        | AHole _ => errh_inil
                        | ASort _ => errh_inil
                        | ANatLit _ => errh_inil
                        | AStr _ => errh_inil
                        | AApp _ _ => errh_inil
                        | APi _ _ _ => errh_inil
                        | ALet _ _ _ _ => errh_inil
                        | AAscribe _ _ => errh_inil
                        | ABinder _ _ _ => errh_inil
                        | ANoBinder => errh_inil
                        | AFix _ _ _ _ => errh_inil
                        | ABranch _ _ _ _ => errh_inil
                        | ANoBranch => errh_inil
                        | AMatch _ _ => errh_inil
                        | APerform _ _ => errh_inil
                        | AHandle _ _ => errh_inil
                        | AClause _ _ _ _ => errh_inil
                        | ANoClause => errh_inil
                        | ADo _ => errh_inil
                        | AList _ => errh_inil
                        | ANamedCall _ _ => errh_inil
                        end
                    end
                end
            end
        end
    end;

def errh_ordered_rows : List Nat -> List (Pair Nat Ast) -> Maybe (List Ast) :=
  fix errh_ordered_rows (labels : List Nat) (seen : List (Pair Nat Ast))
      : Maybe (List Ast) :=
    match labels with
    | Nil => Just(List Ast, Nil Ast)
    | Cons label rest =>
        match lookup Nat Ast eq_nat label seen with
        | Nothing => Nothing (List Ast)
        | Just value =>
            match errh_ordered_rows rest seen with
            | Nothing => Nothing (List Ast)
            | Just tail => Just(List Ast, Cons Ast value tail)
            end
        end
    end;

-- This rule knows io_bind's four public labels. The analyzer never treats an
-- arbitrary named-call source order as a positional argument order.
def errh_named_rows (labels : List Nat) : List (Pair Nat Ast)
    -> Maybe (List Ast) :=
  fun (initial_rows : List (Pair Nat Ast)) =>
  (fix go (rows : List (Pair Nat Ast)) (position : Nat) (named : Bool)
      (seen : List (Pair Nat Ast)) : Maybe (List Ast) :=
    match rows with
    | Nil => errh_ordered_rows labels seen
    | Cons row rest =>
        match row with
        | MkPair label value =>
            let target : Nat :=
              match label with
              | Z => match andb (notb named) (ltb_nat position errh_four) with
                  | True => nth Nat Z position labels
                  | False => Z
                  end
              | S _ => match mem Nat eq_nat label labels with
                  | True => label
                  | False => Z
                  end
              end in
            match target with
            | Z => Nothing (List Ast)
            | S _ =>
                match lookup Nat Ast eq_nat target seen with
                | Just _ => Nothing (List Ast)
                | Nothing => go rest
                    (match label with | Z => S position | S _ => position end)
                    (orb named (notb(eq_nat label Z)))
                    (Cons(Pair Nat Ast, MkPair Nat Ast target value, seen))
                end
            end
        end
    end) initial_rows Z False (Nil (Pair Nat Ast));

def errh_named_bind_issue (ids : ErrIds) (discards : List Nat)
    (bound : List Nat) (head : Ast) (rows : List (Pair Nat Ast))
    : List ErrIssue :=
    let labels : List Nat := errh_bind_labels ids in
    let valid : Bool := andb (eq_nat(length Nat labels, errh_four))
      (andb (all Nat (fun (id : Nat) => notb(eq_nat id Z)) labels)
        (eq_nat(length Nat (nub Nat eq_nat labels), errh_four))) in
    match andb valid (notb(mem Nat eq_nat (errh_bind ids) bound)) with
    | False => errh_inil
    | True =>
        match ast_app_head head with
        | Nothing => errh_inil
        | Just callee =>
          match andb(notb(eq_nat callee Z), eq_nat callee (errh_bind ids)) with
          | False => errh_inil
          | True =>
            match errh_named_rows labels rows with
            | Nothing => errh_inil
            | Just ordered =>
                errh_bind_issue ids discards
                  (foldl Ast Ast (fun (f : Ast) (arg : Ast) => AApp f arg)
                    head ordered)
            end
          end
        end
    end;

def errh_node_issues (ids : ErrIds) (discards : List Nat)
    (bound : List Nat) (a : Ast) : List ErrIssue :=
    match a with
    | AMatch _ branches => errh_match_issues ids discards branches
    | AApp _ _ => errh_bind_issue ids discards a
    | AVar _ => errh_inil
    | AHole _ => errh_inil
    | ASort _ => errh_inil
    | ANatLit _ => errh_inil
    | AStr _ => errh_inil
    | ALam _ _ _ => errh_inil
    | APi _ _ _ => errh_inil
    | ALet _ _ _ _ => errh_inil
    | AAscribe _ _ => errh_inil
    | ABinder _ _ _ => errh_inil
    | ANoBinder => errh_inil
    | AFix _ _ _ _ => errh_inil
    | ABranch _ _ _ _ => errh_inil
    | ANoBranch => errh_inil
    | APerform _ _ => errh_inil
    | AHandle _ _ => errh_inil
    | AClause _ _ _ _ => errh_inil
    | ANoClause => errh_inil
    | ADo _ => errh_inil
    | AList _ => errh_inil
    | ANamedCall head rows => errh_named_bind_issue ids discards bound head rows
    end;

def errh_walk (ids : ErrIds) (discards : List Nat) : Ast -> List ErrIssue :=
  fun (root : Ast) =>
    (fix errh_walk (fuel : Nat) (a : Ast) (bound : List Nat) : List ErrIssue :=
      match fuel with
      | Z => errh_inil
      | S remaining =>
          let descend (child : Ast) (names : List Nat) : List ErrIssue :=
            errh_walk remaining child names in
          let children : List ErrIssue :=
            match a with
            | ALam id ann body =>
                errh_append(descend ann bound, descend body (Cons Nat id bound))
            | APi id dom cod =>
                errh_append(descend dom bound, descend cod (Cons Nat id bound))
            | ALet id ann value body =>
                errh_append(descend ann bound,
                  errh_append(descend value bound, descend body (Cons Nat id bound)))
            | ABinder id ty rest =>
                errh_append(descend ty bound, descend rest (Cons Nat id bound))
            | AFix id binders ret body =>
                let scoped : List Nat :=
                  append Nat (ast_binder_ids binders) (Cons Nat id bound) in
                errh_append(descend binders (Cons Nat id bound),
                  errh_append(descend ret scoped, descend body scoped))
            | ABranch _ names body rest =>
                errh_append(descend body (append Nat names bound), descend rest bound)
            | AClause _ names body rest =>
                errh_append(descend body (append Nat names bound), descend rest bound)
            | AVar _ => errh_inil
            | AHole _ => errh_inil
            | ASort _ => errh_inil
            | ANatLit _ => errh_inil
            | AStr _ => errh_inil
            | ANoBinder => errh_inil
            | ANoBranch => errh_inil
            | ANoClause => errh_inil
            | AApp _ _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            | AAscribe _ _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            | AMatch _ _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            | APerform _ _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            | AHandle _ _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            | ADo _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            | AList _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            | ANamedCall _ _ => concat_map Ast ErrIssue
                (fun (child : Ast) => descend child bound) (ast_children a)
            end in
          let here : List ErrIssue := errh_node_issues ids discards bound a in
          errh_append here children
      end) (ast_size root) root (Nil Nat);

-- discards: ids whose source spelling starts with `_`.
def analyze_errors (ids : ErrIds) (discards : List Nat) (a : Ast) : List ErrIssue :=
    errh_append(errh_type_issues ids a, errh_walk ids discards (ast_core_body a));
