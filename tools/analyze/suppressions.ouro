-- Suppression policy is fail-closed: forbidden trust/architecture diagnostics
-- are never source-suppressible. The host parses the source suppression
-- comments into facts with interned code ids; this core only decides. Spans
-- are host record ids the caller maps back to source positions.

-- @entry analyze_suppressions
-- @entry suppression_known

import "../../std/data.ouro";
import "../../std/listx.ouro";
import "../../std/natx.ouro";

-- span, code id (`supp_code_all` for a wildcard), reason id (Z when the
-- comment gives none), scope, used, allowed.
inductive Suppression : Type :=
  | MkSuppression : Nat -> Nat -> Nat -> Nat -> Bool -> Bool -> Suppression;

inductive SuppIssue : Type :=
  | ISuppBroad : Nat -> SuppIssue
  | ISuppMissingReason : Nat -> SuppIssue
  | ISuppUnknown : Nat -> SuppIssue
  | ISuppUnused : Nat -> SuppIssue
  | ISuppForbidden : Nat -> SuppIssue
  | ISuppScopeTooWide : Nat -> SuppIssue;

def supp_span (s : Suppression) : Nat :=
    match s with | MkSuppression span _ _ _ _ _ => span end;

def supp_code (s : Suppression) : Nat :=
    match s with | MkSuppression _ code _ _ _ _ => code end;

def supp_reason (s : Suppression) : Nat :=
    match s with | MkSuppression _ _ reason _ _ _ => reason end;

def supp_scope (s : Suppression) : Nat :=
    match s with | MkSuppression _ _ _ scope _ _ => scope end;

def supp_used (s : Suppression) : Bool :=
    match s with | MkSuppression _ _ _ _ used _ => used end;

def supp_allowed (s : Suppression) : Bool :=
    match s with | MkSuppression _ _ _ _ _ allowed => allowed end;

def supp_issue_span (i : SuppIssue) : Nat :=
    match i with
    | ISuppBroad span => span
    | ISuppMissingReason span => span
    | ISuppUnknown span => span
    | ISuppUnused span => span
    | ISuppForbidden span => span
    | ISuppScopeTooWide span => span
    end;

-- The wildcard code disables every rule.
def supp_code_all : Nat := Z;

-- Scopes: the next line, the whole file or module, everything.
def supp_scope_line : Nat := S Z;
def supp_scope_file : Nat := 2;
def supp_scope_all : Nat := 3;

def suppression_known (code : Nat) (known : List Nat) : Bool :=
    mem Nat eq_nat code known;

def supp_broad (s : Suppression) : Bool :=
    orb (eq_nat (supp_code s) supp_code_all) (eq_nat (supp_scope s) supp_scope_all);

-- A wildcard names no code, so it cannot be an unknown one.
def supp_unknown (known : List Nat) (s : Suppression) : Bool :=
    andb (notb (supp_broad s)) (notb (suppression_known (supp_code s) known));

def supp_flag (b : Bool) (i : SuppIssue) : List SuppIssue :=
    match b with
    | True => ([i] : List SuppIssue)
    | False => Nil SuppIssue
    end;

def supp_issues (known : List Nat) (max_scope : Nat) (s : Suppression)
    : List SuppIssue :=
    let span : Nat := supp_span s in
    append SuppIssue (supp_flag (supp_broad s) (ISuppBroad span))
      (append SuppIssue (supp_flag (eq_nat (supp_reason s) Z) (ISuppMissingReason span))
        (append SuppIssue (supp_flag (supp_unknown known s) (ISuppUnknown span))
          (append SuppIssue (supp_flag (notb (supp_used s)) (ISuppUnused span))
            (append SuppIssue (supp_flag (notb (supp_allowed s)) (ISuppForbidden span))
              (supp_flag (ltb_nat max_scope (supp_scope s)) (ISuppScopeTooWide span))))));

def analyze_suppressions (known : List Nat) (max_scope : Nat)
    (supps : List Suppression) : List SuppIssue :=
    concat_map Suppression SuppIssue (supp_issues known max_scope) supps;
