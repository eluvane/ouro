-- Thin keep-import surface for drive_smells. Smell cores stay skip-harvested
-- unless this file is the selected root.
import "drive_smells.ouro";


def smell_simplify (e : DriveEnv) : DefInfo -> List Finding :=
    simplify_findings e;


def smell_perf (e : DriveEnv) : DefInfo -> List Finding :=
    perf_findings e;


def smell_naming (e : DriveEnv) : DefInfo -> List Finding :=
    naming_findings e;


def smell_errors (e : DriveEnv) : DefInfo -> List Finding :=
    errors_findings e;


def smell_ctor_names (fams : List String) (e : DriveEnv) : List Finding :=
    ctor_name_findings fams e;
