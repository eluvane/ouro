-- Public-surface policy over host facts. The host computes the signature
-- fingerprints and reads the baseline; this core only decides. Spans are host
-- record ids the caller maps back to source positions.

-- @entry analyze_api_surface

import "../../std/data.ouro",
  "../../std/listx.ouro",
  "../../std/natx.ouro";

-- span, name id, exported (public and API-checked), baseline row present,
-- fingerprint differs from the baseline row, baseline row marks the
-- definition internal-only, baseline row carries namespace and use-intent.
inductive ApiDecl : Type :=
  | MkApiDecl : Nat -> Nat -> Bool -> Bool -> Bool -> Bool -> Bool -> ApiDecl;

-- The duplicate issue names the span of the other export with the same name.
inductive ApiIssue : Type :=
  | IApiNewExport : Nat -> ApiIssue
  | IApiDuplicate : Nat -> Nat -> ApiIssue
  | IApiAbiChanged : Nat -> ApiIssue
  | IApiPublicInternal : Nat -> ApiIssue
  | IApiSurfaceGrowth : Nat -> ApiIssue;

def api_span (d : ApiDecl) : Nat :=
    match d with | MkApiDecl span _ _ _ _ _ _ => span end;

def api_name (d : ApiDecl) : Nat :=
    match d with | MkApiDecl _ name _ _ _ _ _ => name end;

def api_exported (d : ApiDecl) : Bool :=
    match d with | MkApiDecl _ _ exported _ _ _ _ => exported end;

def api_baselined (d : ApiDecl) : Bool :=
    match d with | MkApiDecl _ _ _ baselined _ _ _ => baselined end;

def api_drift (d : ApiDecl) : Bool :=
    match d with | MkApiDecl _ _ _ _ drift _ _ => drift end;

def api_internal_only (d : ApiDecl) : Bool :=
    match d with | MkApiDecl _ _ _ _ _ internal _ => internal end;

def api_has_metadata (d : ApiDecl) : Bool :=
    match d with | MkApiDecl _ _ _ _ _ _ metadata => metadata end;

def api_issue_span (i : ApiIssue) : Nat :=
    match i with
    | IApiNewExport span => span
    | IApiDuplicate span _ => span
    | IApiAbiChanged span => span
    | IApiPublicInternal span => span
    | IApiSurfaceGrowth span => span
    end;

def api_flag (b : Bool) (i : ApiIssue) : List ApiIssue :=
    match b with
    | True => ([i] : List ApiIssue)
    | False => Nil ApiIssue
    end;

def api_new (d : ApiDecl) : Bool :=
    andb(api_exported d, notb (api_baselined d));

-- Another export with the same name; the baseline accepts the pairs it
-- already lists, so only a new export is reported as a duplicate.
def api_duplicate_of (decls : List ApiDecl) (d : ApiDecl) : Maybe ApiDecl :=
    find ApiDecl
      (fun (other : ApiDecl) =>
        andb (api_exported other)
          (andb (eq_nat(api_name other, api_name d))
            (notb (eq_nat(api_span other, api_span d)))))
      decls;

def api_duplicate_issue (decls : List ApiDecl) (d : ApiDecl) : List ApiIssue :=
    match api_new d with
    | False => Nil ApiIssue
    | True =>
        match api_duplicate_of decls d with
        | Nothing => Nil ApiIssue
        | Just other => ([IApiDuplicate(api_span d, api_span other)] : List ApiIssue)
        end
    end;

def api_issues (decls : List ApiDecl) (d : ApiDecl) : List ApiIssue :=
    let span : Nat := api_span d in
    let listed : Bool := andb(api_exported d, api_baselined d) in
    append ApiIssue (api_flag(api_new d, IApiNewExport span))
      (append ApiIssue (api_duplicate_issue decls d)
        (append ApiIssue (api_flag(andb(listed, api_drift d), IApiAbiChanged span))
          (append ApiIssue
            (api_flag(andb(listed, api_internal_only d), IApiPublicInternal span))
            (api_flag (andb(api_new d, notb (api_has_metadata d)))
              (IApiSurfaceGrowth span)))));

def analyze_api_surface (decls : List ApiDecl) : List ApiIssue :=
    concat_map ApiDecl ApiIssue (api_issues decls) decls;
