-- Standalone runner for the structured families over real-frontend units.
-- Must not be imported by tools/analyze/main.ouro: that cone plus the parser
-- dies in ouro_rt. Stays off std/fs, std/args, and std/string because they
-- pull std/char, whose character names collide with the lexer's.

-- @entry main

import "../../std/io.ouro";
import "drive.ouro";

-- flags without the leading dashes, scopes.
inductive DriveArgs : Type :=
  | MkDriveArgs : List String -> List String -> DriveArgs;

def drive_flags (a : DriveArgs) : List String :=
    match a with | MkDriveArgs fs _ => fs end;

def drive_scopes (a : DriveArgs) : List String :=
    match a with | MkDriveArgs _ ss => ss end;

def strip_dashes (s : String) : String :=
    prim_string_slice s 2 (sub (prim_string_length s) 2);

-- `--scope P` and positional arguments are scopes; `--api-baseline P` is a
-- base-runner option the bounded wrapper forwards, so its value is skipped.
def parse_drive_args : List String -> List String -> List String -> DriveArgs :=
  fix go (xs : List String) (flags : List String) (scopes : List String)
      : DriveArgs :=
    match xs with
    | Nil => MkDriveArgs flags scopes
    | Cons a rest =>
        match prim_string_eq a "--scope" with
        | True =>
            match rest with
            | Nil => MkDriveArgs flags scopes
            | Cons p more => go more flags (snoc String scopes p)
            end
        | False =>
            match prim_string_eq a "--api-baseline" with
            | True =>
                match rest with
                | Nil => MkDriveArgs flags scopes
                | Cons _ more => go more flags scopes
                end
            | False =>
                match prim_string_starts a "--" with
                | True => go rest (snoc String flags (strip_dashes a)) scopes
                | False => go rest flags (snoc String scopes a)
                end
            end
        end
    end;

def has_flag (a : DriveArgs) (name : String) : Bool :=
    elem String prim_string_eq name (drive_flags a);

-- One code-review profile; the canonical family filter below removes repeats.
-- Keep the public wrapper's expansion in sync with this native union.
def style_families : List String :=
    [ fam_dataflow, fam_metrics, fam_simplify, fam_perf, fam_naming ];

def enable_prefix : String := "enable-";

-- `enable-<family>` names one family; the unions (all, light, heavy, strict)
-- mirror drive.ouro. Flags the base runner owns alone (format, deadcode) name
-- no drive family; trust runs in both binaries.
def flag_families (flag : String) : List String :=
    match prim_string_eq flag "enable-all" with
    | True => all_families
    | False =>
        match prim_string_eq flag "enable-light" with
        | True => light_families
        | False =>
            match prim_string_eq flag "enable-heavy" with
            | True => heavy_families
            | False =>
                match prim_string_eq flag "enable-strict" with
                | True => strict_families
                | False =>
                    match prim_string_eq flag "enable-style" with
                    | True => style_families
                    | False =>
                        match prim_string_starts flag enable_prefix with
                        | True =>
                            let n : Nat := prim_string_length enable_prefix in
                            singleton String
                              (prim_string_slice flag n (sub (prim_string_length flag) n))
                        | False => Nil String
                        end
                    end
                end
            end
        end
    end;

-- Enabled families in the canonical banner order.
def families_of (a : DriveArgs) : List String :=
    let wanted : List String :=
      concat_map String String flag_families (drive_flags a) in
    filter String (fun (f : String) => elem String prim_string_eq f wanted)
      all_families;

def include_fix (a : DriveArgs) : Bool := has_flag a "include-fixtures";

def join_comma : List String -> String :=
  fix join_comma (xs : List String) : String :=
    match xs with
    | Nil => ""
    | Cons x rest =>
        match rest with
        | Nil => x
        | Cons _ _ => concat x (concat "," (join_comma rest))
        end
    end;

def ch_slash_code : Nat := 47;
def ch_backslash_code : Nat := 92;

def norm_path (p : String) : String :=
    prim_string_of_char_codes
      (map Nat Nat
        (fun (c : Nat) =>
          match eqNat c ch_backslash_code with
          | True => ch_slash_code
          | False => c
          end)
        (prim_string_to_char_codes p));

def fixture_prefixes : List String :=
  [ "test/"
  , "tests/"
  , "quality/fixtures/"
  , "samples/bench/synthesis/"
  , "samples/examples/future/"
  , "samples/examples/bad_"
  ];

def fixture_infixes : List String := [ "/test/", "/tests/", "/quality/fixtures/" ];

def fixture_exact : List String := [ "samples/tutorial/04_holes.ouro" ];

def is_fixture (p : String) : Bool :=
    orb (any String (fun (prefix : String) => prim_string_starts p prefix)
          fixture_prefixes)
      (orb (any String (fun (infix : String) => prim_string_contains p infix)
             fixture_infixes)
        (elem String prim_string_eq p fixture_exact));

def keep_path (inc : Bool) (p : String) : Bool :=
    match inc with
    | True => True
    | False => notb (is_fixture p)
    end;

def skip_dir_names : List String :=
    [ ".", "..", "_build", "_cache", "_opam", "_tools", ".git", "node_modules" ];

def skip_dir (name : String) : Bool :=
    elem String prim_string_eq name skip_dir_names;

def child (dir : String) (name : String) : String :=
    match prim_string_length dir with
    | Z => name
    | S _ =>
        match prim_string_eq dir "." with
        | True => name
        | False => concat dir (concat "/" name)
        end
    end;

def walk_go : Nat -> Bool -> List String -> List String -> IO (List String) :=
  fix walk_go (fuel : Nat) (inc : Bool) (pending : List String)
      (acc : List String) : IO (List String) :=
    match fuel with
    | Z => io_pure (List String) acc
    | S fuel2 =>
        match pending with
        | Nil => io_pure (List String) acc
        | Cons p rest =>
            io_bind Bool (List String) (prim_fs_is_dir p)
              (fun (isdir : Bool) =>
                match isdir with
                | False =>
                    match andb (prim_string_ends p ".ouro") (keep_path inc p) with
                    | True => walk_go fuel2 inc rest (Cons String p acc)
                    | False => walk_go fuel2 inc rest acc
                    end
                | True =>
                    io_bind (List String) (List String) (prim_fs_list_dir p)
                      (fun (names : List String) =>
                        let kids : List String :=
                          map String String (child p)
                            (filter String
                              (fun (n : String) => notb (skip_dir n)) names) in
                        walk_go fuel2 inc (append String kids rest) acc)
                end)
        end
    end;

def scan_root (inc : Bool) (root : String) : IO (List String) :=
    walk_go (mul 128 128) inc (singleton String (norm_path root)) (Nil String);

def root_missing (root : String) : IO Nat :=
    io_bind Bool Nat (prim_fs_exists root)
      (fun (ex : Bool) =>
        match ex with
        | True => io_pure Nat Z
        | False =>
            io_bind Unit Nat
              (eprintln (concat "ANALYZE_FAIL: missing scope " root))
              (fun (_ : Unit) => io_pure Nat (S Z))
        end);

def missing_roots (roots : List String) : IO Nat :=
    io_fold String Nat
      (fun (n : Nat) (root : String) =>
        io_bind Nat Nat (root_missing root)
          (fun (m : Nat) => io_pure Nat (add n m)))
      Z roots;

def default_scopes : List String :=
    ["std", "compiler", "tools/analyze", "samples"];

def scopes_of (a : DriveArgs) : List String :=
    match drive_scopes a with
    | Nil => default_scopes
    | Cons x xs => Cons String x xs
    end;

def gather_paths (inc : Bool) (scopes : List String) : IO (List String) :=
    io_bind (List String) (List String)
      (io_fold String (List String)
        (fun (acc : List String) (root : String) =>
          io_bind (List String) (List String) (scan_root inc root)
            (fun (more : List String) =>
              io_pure (List String) (append String acc more)))
        (Nil String) scopes)
      (fun (paths : List String) =>
        io_pure (List String) (sort_insert String prim_string_le paths));

-- findings, rejected units.
inductive DriveTally : Type :=
  | MkTally : Nat -> Nat -> DriveTally;

def tally_findings (t : DriveTally) : Nat :=
    match t with | MkTally n _ => n end;

def tally_rejected (t : DriveTally) : Nat :=
    match t with | MkTally _ r => r end;

def tally_add (a : DriveTally) (b : DriveTally) : DriveTally :=
    MkTally (add (tally_findings a) (tally_findings b))
      (add (tally_rejected a) (tally_rejected b));

def emit_findings (path : String) (fs : List Finding) : IO DriveTally :=
    io_bind Unit DriveTally
      (io_foreach Finding
        (fun (f : Finding) => println (show_finding path f)) fs)
      (fun (_ : Unit) => io_pure DriveTally (MkTally (length Finding fs) Z));

def emit_source (fams : List String) (path : String) (src : String)
    : IO DriveTally :=
    match drive_findings fams path src with
    | DriveRejected why =>
        io_bind Unit DriveTally
          (eprintln (concat path
            (concat ": structured analyzer could not build the unit: " why)))
          (fun (_ : Unit) => io_pure DriveTally (MkTally Z (S Z)))
    | DriveFindings fs => emit_findings path fs
    end;

def emit_file (fams : List String) (path : String) : IO DriveTally :=
    io_bind Bool DriveTally (prim_fs_exists path)
      (fun (ex : Bool) =>
        match ex with
        | False =>
            io_bind Unit DriveTally
              (eprintln (concat path ": path not found"))
              (fun (_ : Unit) => io_pure DriveTally (MkTally Z (S Z)))
        | True =>
            io_bind String DriveTally (prim_fs_read_file path)
              (fun (src : String) => emit_source fams path src)
        end);

def run_scopes (fams : List String) (paths : List String) : IO DriveTally :=
    io_fold String DriveTally
      (fun (acc : DriveTally) (path : String) =>
        io_bind DriveTally DriveTally (emit_file fams path)
          (fun (more : DriveTally) => io_pure DriveTally (tally_add acc more)))
      (MkTally Z Z) paths;

def of_nat (n : Nat) : String := prim_string_of_nat n;

def banner (fams : List String) (files : Nat) (t : DriveTally) : String :=
    concat "ANALYZE_DRIVE files=" (concat (of_nat files)
      (concat " findings=" (concat (of_nat (tally_findings t))
        (concat " rejected=" (concat (of_nat (tally_rejected t))
          (concat " families=" (join_comma fams)))))));

def finish (fams : List String) (files : Nat) (t : DriveTally) : IO Unit :=
    io_bind Unit Unit (println (banner fams files t))
      (fun (_ : Unit) =>
        match add (tally_findings t) (tally_rejected t) with
        | Z => exit Z
        | S _ => exit (S Z)
        end);

def run_families (a : DriveArgs) (fams : List String) : IO Unit :=
    io_bind Nat Unit (missing_roots (scopes_of a))
      (fun (missing : Nat) =>
        match missing with
        | S _ => exit 2
        | Z =>
            io_bind (List String) Unit
              (gather_paths (include_fix a) (scopes_of a))
              (fun (paths : List String) =>
                io_bind DriveTally Unit (run_scopes fams paths)
                  (fun (t : DriveTally) => finish fams (length String paths) t))
        end);

def start (argv : List String) : IO Unit :=
    let a : DriveArgs :=
      parse_drive_args (tail String argv) (Nil String) (Nil String) in
    match families_of a with
    | Nil => exit Z
    | Cons f more => run_families a (Cons String f more)
    end;

def main : IO Unit :=
    io_bind (List String) Unit prim_argv start;
