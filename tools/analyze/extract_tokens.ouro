-- Token-level helpers shared by the line-oriented analyzer extractor.

import "model.ouro";


def codes_contains (pat : List Nat) : List Nat -> Bool :=
  fix codes_contains (cs : List Nat) : Bool :=
    match is_prefix Nat eq_nat pat cs with
    | True => True
    | False =>
        match cs with
        | Nil => False
        | Cons _ rest => codes_contains rest
        end
    end;

def codes_start_word (word : List Nat) (cs : List Nat) : Bool :=
  match is_prefix Nat eq_nat word cs with
  | False => False
  | True =>
      match drop Nat (length Nat word) cs with
      | Nil => True
      | Cons c _ => notb (is_ident_cont c)
      end
  end;

def codes_has (want : Nat) : List Nat -> Bool :=
  elem Nat eq_nat want;

def kw_import_cs : List Nat := [105, 109, 112, 111, 114, 116];
def kw_def_cs : List Nat := [100, 101, 102];
def kw_axiom_cs : List Nat := [97, 120, 105, 111, 109];
def kw_inductive_cs : List Nat := [105, 110, 100, 117, 99, 116, 105, 118, 101];
def kw_record_cs : List Nat := [114, 101, 99, 111, 114, 100];
def kw_effect_cs : List Nat := [101, 102, 102, 101, 99, 116];
