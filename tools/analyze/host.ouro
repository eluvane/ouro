-- Analyzer host logic assembles facts and policy results; individual analyzer cores stay pure.

-- @entry analyze_exit_clean
-- @entry analyze_exit_findings
-- @entry analyze_exit_usage
-- @entry analyzer_rule_count
-- @entry strict_rule_count
-- @entry default_profile
-- The two enumerations below are the dispatch surface this file exists to
-- name, so every profile and rule constructor is a root.
-- @entry AnalyzeProfile
-- @entry AnalyzeRule

import "../../std/data.ouro";

def analyze_exit_clean : Nat := Z;

def analyze_exit_findings : Nat := S Z;

def analyze_exit_usage : Nat := 2;

inductive AnalyzeProfile : Type :=
  | ProfileStandard : AnalyzeProfile
  | ProfileStrict : AnalyzeProfile
  | ProfilePedantic : AnalyzeProfile;

inductive AnalyzeRule : Type :=
  | RuleMinimal : AnalyzeRule
  | RuleCfg : AnalyzeRule
  | RuleDataflow : AnalyzeRule
  | RuleEffects : AnalyzeRule
  | RuleTaint : AnalyzeRule
  | RuleSemantic : AnalyzeRule
  | RuleComplexity : AnalyzeRule
  | RuleAbi : AnalyzeRule
  | RuleContracts : AnalyzeRule
  | RuleFormat : AnalyzeRule
  | RuleArchitecture : AnalyzeRule
  | RuleDeadcode : AnalyzeRule
  | RuleDuplication : AnalyzeRule
  | RuleApiSurface : AnalyzeRule
  | RuleTrust : AnalyzeRule
  | RuleSuppressions : AnalyzeRule
  | RuleCapability : AnalyzeRule
  | RuleExtract : AnalyzeRule
  | RuleMatch : AnalyzeRule;

def default_profile : AnalyzeProfile := ProfileStandard;

def analyzer_rule_count : Nat :=
  19;

-- Strict mode runs the regular project-owned checks plus the six policy passes.
def strict_rule_count : Nat := analyzer_rule_count;
