import "../../std/string_prims.ouro",
  "../../std/listx.ouro";

def analyze_fixture_prefixes : List String :=
  [ "test/"
  , "tests/"
  , "quality/fixtures/"
  , "samples/bench/synthesis/"
  , "samples/examples/future/"
  , "samples/examples/bad_"
  ];

def analyze_fixture_infixes : List String := [ "/test/", "/tests/", "/quality/fixtures/" ];

def analyze_fixture_exact : List String := [ "samples/tutorial/04_holes.ouro" ];

def analyze_is_fixture (p : String) : Bool :=
    orb (any String (fun (prefix : String) => prim_string_starts p prefix)
          analyze_fixture_prefixes)
      (orb (any String (fun (infix : String) => prim_string_contains p infix)
             analyze_fixture_infixes)
        (elem String prim_string_eq p analyze_fixture_exact));

def analyze_keep_path (include_fixtures : Bool) (path : String) : Bool :=
    if include_fixtures then True else notb (analyze_is_fixture path);
