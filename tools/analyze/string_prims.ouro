-- Host string primitives without std/runtime.ouro. That module also imports
-- the Windows platform cone; analyzer cores must stay off it or check OOM.
-- This file also stays off std/char and std/string: their character names
-- collide with the lexer vocabulary used by unit.ouro.

import "../../std/data.ouro";

intrinsic String : Type := "ouro.string";

intrinsic prim_string_concat : String -> String -> String := "ouro.string.concat";
intrinsic prim_string_length : String -> Nat := "ouro.string.length";
intrinsic prim_string_byte_at : String -> Nat -> Nat := "ouro.string.byte_at";
intrinsic prim_string_slice : String -> Nat -> Nat -> String := "ouro.string.slice";
intrinsic prim_string_eq : String -> String -> Bool := "ouro.string.eq";
intrinsic prim_string_of_nat : Nat -> String := "ouro.string.of_nat";
intrinsic prim_string_to_char_codes : String -> List Nat := "ouro.string.to_char_codes";
intrinsic prim_string_of_char_codes : List Nat -> String := "ouro.string.of_char_codes";
intrinsic prim_string_starts : String -> String -> Bool := "ouro.string.starts";
intrinsic prim_string_ends : String -> String -> Bool := "ouro.string.ends";
intrinsic prim_string_contains : String -> String -> Bool := "ouro.string.contains";
intrinsic prim_string_index : String -> String -> Maybe Nat := "ouro.string.index";
intrinsic prim_string_split : String -> Nat -> List String := "ouro.string.split";
intrinsic prim_string_replace : String -> String -> String -> String := "ouro.string.replace";
intrinsic prim_string_le : String -> String -> Bool := "ouro.string.le";
intrinsic prim_string_tokens : String -> List String := "ouro.string.tokens";
