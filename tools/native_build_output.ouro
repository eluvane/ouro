-- Verify a private staging file before same-directory executable replacement.
-- A fatal runtime error or interruption can leave staging behind, but cannot
-- expose a partially written destination. Typed failures check staging cleanup.
import "../std/fsx.ouro";

def native_build_slash : Nat := 47;
def native_build_backslash : Nat := 92;

def native_build_is_sep (c : Nat) : Bool :=
    orb(eq_nat c native_build_slash, eq_nat c native_build_backslash);

def native_build_last_sep : List Nat -> Nat -> Maybe Nat :=
  fix go (cs : List Nat) (i : Nat) : Maybe Nat :=
    match cs with
    | Nil => Nothing Nat
    | Cons c rest =>
      match go(rest, S i) with
      | Just later => Just Nat later
      | Nothing =>
        match native_build_is_sep c with
        | True => Just Nat i
        | False => Nothing Nat
        end
      end
    end;

def native_build_dirname (path : String) : String :=
    match native_build_last_sep(prim_string_to_char_codes path, 0) with
    | Nothing => "."
    | Just index =>
      match orb (eq_nat index 0)
          (andb(eq_nat index 2, prim_string_eq(prim_string_slice path 1 1, ":"))) with
      | True => prim_string_slice path 0 (S index)
      | False => prim_string_slice path 0 index
      end
    end;

def native_build_output_cleanup (scratch : String) (error : FsError)
    : IO (Either FsError Unit) :=
    do let! removed := fsx_remove_if_exists scratch;
       match removed with
       | Left cleanup => fs_err Unit
           (FsOperationFailed
             (str_cat3(fs_error_message error, "; cleanup: ", fs_error_message cleanup))
             scratch)
       | Right _ => fs_err Unit error
       end

def native_build_commit_checked (output : String) (scratch : String) (content : String)
    : IO (Either FsError Unit) :=
    do let! loaded := fs_read_checked scratch;
       match loaded with
       | Left e => native_build_output_cleanup scratch e
       | Right written =>
           match prim_string_eq written content with
           | False => native_build_output_cleanup scratch
               (FsOperationFailed "verify staged output" output)
           | True =>
               do let! renamed := fs_rename_checked scratch output;
                  match renamed with
                  | Left e => native_build_output_cleanup scratch e
                  | Right _ => fs_ok Unit MkUnit
                  end
           end
       end

def native_build_stage_checked (output : String) (scratch : String) (content : String)
    : IO (Either FsError Unit) :=
    -- The private file already exists beside output. Write through the checked
    -- API, then verify bytes and every cleanup result before replacement.
    do let! ready := fs_check_file scratch;
       match ready with
       | Left e => native_build_output_cleanup scratch e
       | Right _ =>
           do let! wrote := fs_write_checked scratch content;
              match wrote with
              | Left e => native_build_output_cleanup scratch e
              | Right _ => native_build_commit_checked output scratch content
              end
       end

def native_build_publish_checked (output : String) (content : String)
    : IO (Either FsError Unit) :=
    match fs_nonempty_path output with
    | Left e => fs_err Unit e
    | Right _ =>
        do let! isdir := fs_is_dir output;
           match isdir with
           | True => fs_err(Unit, FsExpectedFile output)
           | False =>
               let directory : String := native_build_dirname output in
               do let! made := fs_mkdir_p_checked directory;
                  match made with
                  | Left e => fs_err Unit e
                  | Right _ =>
                      do let! scratch := prim_fs_temp_file_in directory;
                         match prim_string_eq scratch "" with
                         | True => fs_err(Unit, FsOperationFailed "temp_file" directory)
                         | False => native_build_stage_checked output scratch content
                         end
                  end
           end
    end;
