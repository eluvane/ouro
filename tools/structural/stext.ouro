-- Byte-level text utilities used by the structural lexer.
-- Pure leaf: shared byte facts only; no IO or JSON.

import "../quality/byte_space.ouro";
import "../../std/string.ouro";

-- Python str.isspace over the ASCII range, including \v \f and \x1c-\x1f.
-- The parity corpus has no other whitespace outside strings and comments.

def st_is_digit (c : Nat) : Bool :=
    andb (leb_nat 48 c) (leb_nat c 57);

def st_is_alpha (c : Nat) : Bool :=
    orb (andb (leb_nat 65 c) (leb_nat c 90)) (andb (leb_nat 97 c) (leb_nat c 122));

def st_is_alnum (c : Nat) : Bool :=
    orb (st_is_alpha c) (st_is_digit c);

-- Literal byte match of pat at pos; short inputs never match.
def st_starts_at (s : String) (pos : Nat) (pat : String) : Bool :=
    (fix go (fuel : Nat) (i : Nat) : Bool :=
      match fuel with
      | Z => True
      | S fuel2 =>
          match eq_nat (prim_string_byte_at s (add pos i)) (prim_string_byte_at pat i) with
          | True => go fuel2 (add i 1)
          | False => False
          end
      end) (prim_string_length pat) 0;

-- Expected UTF-8 sequence length from the lead byte; 0 means the byte can
-- never start a sequence (lone continuation, overlong C0/C1, F5 and above).
def st_utf8_len (lead : Nat) : Nat :=
    match ltb_nat lead 128 with
    | True => 1
    | False => match andb (leb_nat 194 lead) (leb_nat lead 223) with
      | True => 2
      | False => match andb (leb_nat 224 lead) (leb_nat lead 239) with
        | True => 3
        | False => match andb (leb_nat 240 lead) (leb_nat lead 244) with
          | True => 4
          | False => 0
          end
        end
      end
    end;

-- Python str.split() with no separator: ASCII blank runs, empties dropped.
