-- Thin stdin JSON driver for st_lex. Symbols, findings, and reports stay
-- on the Python owner. Request and result stay in the lex/json/io cone.

-- @entry main

import "lex.ouro";
import "../quality/json_report.ouro";
import "../../std/json.ouro";
import "../../std/io.ouro";

def lex_field (j : Json) (key : String) : Maybe String :=
    match qr_get j key with
    | Nothing => Nothing String
    | Just value => qr_as_str value
    end;

def lex_jstr (k : String) (s : String) : Pair String Json :=
    MkPair String Json k (JStr s);

def lex_jnat (k : String) (n : Nat) : Pair String Json :=
    MkPair String Json k (JNum (prim_string_of_nat n));

def lex_tok_json (t : STTok) : Json :=
    JObj
      [ lex_jstr "value" (st_tok_value t)
      , lex_jnat "start" (st_tok_start t)
      , lex_jnat "end" (st_tok_end t)
      , lex_jnat "line" (st_tok_line t)
      ];

def lex_comment_json (c : Pair Nat String) : Json :=
    match c with
    | MkPair line text =>
        JObj [ lex_jnat "line" line, lex_jstr "text" text ]
    end;

def lex_error_json (message : String) : Json :=
    JObj [ lex_jstr "error" message ];

def lex_ok_json (tokens : List STTok) (comments : List (Pair Nat String)) : Json :=
    JObj
      [ MkPair String Json "tokens"
          (JArr (map STTok Json lex_tok_json tokens))
      , MkPair String Json "comments"
          (JArr (map (Pair Nat String) Json lex_comment_json comments))
      ];

def lex_reply (code : Nat) (j : Json) : IO Unit :=
    do println (json_print j);
       exit code

def lex_request (request : Json) : IO Unit :=
    match lex_field request "source" with
    | Nothing => lex_reply 2 (lex_error_json "request source must be a string")
    | Just source =>
        match lex_field request "language" with
        | Nothing => lex_reply 2 (lex_error_json "request language must be a string")
        | Just language =>
            match st_lex source language with
            | Left error => lex_reply 0 (lex_error_json (st_lex_error_message error))
            | Right result =>
                match result with
                | MkPair tokens comments => lex_reply 0 (lex_ok_json tokens comments)
                end
            end
        end
    end;

def main : IO Unit :=
    do let! text := read_all;
       match parse_json text with
       | Nothing => lex_reply 2 (lex_error_json "malformed request JSON")
       | Just request => lex_request request
       end
