-- Adapt native subprocess outcomes to the existing framed LSP model.
import "lsp_model.ouro",
  "../std/json_types.ouro",
  "native_sibling_model.ouro",
  "../std/process.ouro";

def lsp_check_process_limits : ProcessCaptureLimits := native_sibling_limits (mul(30, mul 10 100));

def lsp_format_process_limits : ProcessCaptureLimits := native_sibling_limits (mul(10, mul 10 100));

def lsp_process_diagnostic (code : String) (message : String) : List Json :=
    [diag_of code (JNum "1") 0 0 message];

def lsp_process_fail_message (result : ProcResult) (output : String) : String :=
    match str_null (str_trim output) with
    | True => str_concat("native checker exited ", prim_string_of_nat (proc_code result))
    | False => str_trim output
    end;

def lsp_process_checked_diagnostics (path : String) (result : ProcResult) : List Json :=
    let output : String := str_concat(proc_stdout result, proc_stderr result) in
    let parsed : List Json := diags_of_output path output in
    match nullb Json parsed with
    | False => parsed
    | True => match proc_ok result with
      | True => match native_sibling_check_ok result with
        | True => Nil Json
        | False => lsp_process_diagnostic "CHECK_PROTOCOL" "native checker exited 0 without a successful CHECK_OK verdict"
        end
      | False =>
        -- A failed check must never look clean. Imported-module or `<input>`
        -- lines are projected away from this URI; still publish CHECK_FAIL.
        lsp_process_diagnostic("CHECK_FAIL", lsp_process_fail_message result output)
      end
    end;

def lsp_process_diagnostics (path : String) (result : Either NativeSiblingError ProcResult) : List Json :=
    match result with
    | Left error => lsp_process_diagnostic("TOOL_ERROR", native_sibling_error_message error)
    | Right process => lsp_process_checked_diagnostics path process
    end;

def lsp_process_format (text : String) (result : Either NativeSiblingError ProcResult) : Json :=
    match result with
    | Left _ => JNull
    | Right process => match proc_ok process with
      | True => format_edits(text, proc_stdout process)
      | False => JNull
      end
    end;
