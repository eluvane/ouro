-- Resolve the loaded image once, then execute the fixed sibling with no shell.
import "native_sibling_model.ouro";
import "../std/executable.ouro";

def native_sibling_run (limits : ProcessCaptureLimits) (name : String) (arguments : List String)
    : IO (Either NativeSiblingError ProcResult) :=
    do let! located := executable_path_checked;
       match located with
       | Left error => io_pure (Either NativeSiblingError ProcResult)
           (Left NativeSiblingError ProcResult (NativeSiblingImageError error))
       | Right image => match native_sibling_command image name arguments with
         | Left error => io_pure (Either NativeSiblingError ProcResult)
             (Left NativeSiblingError ProcResult error)
         | Right command =>
             do let! captured := process_run_spec_captured_bounded limits command;
                io_pure (Either NativeSiblingError ProcResult) (match captured with
                  | Left error => Left NativeSiblingError ProcResult
                      (NativeSiblingProcessError (command_program command) error)
                  | Right result => Right NativeSiblingError ProcResult (process_capture_proc_result result)
                  end)
         end
       end
