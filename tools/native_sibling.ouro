-- Resolve the loaded image once, then execute the fixed sibling with no shell.
-- Hosted C-host suites set OURO_TEST_CHECK / OURO_PKG_CHECK /
-- OURO_HOSTED_COMPILER_WRAPPER to scripts/ouro1.sh so coil.exe is not required.
import "native_sibling_model.ouro";
import "../std/executable.ouro";
import "../std/io.ouro";

def native_hosted_first (left : Maybe String) (right : IO (Maybe String))
    : IO (Maybe String) :=
    match left with
    | Just path => io_pure (Maybe String) (Just String path)
    | Nothing => right
    end;

def native_hosted_compiler_wrapper : IO (Maybe String) :=
    do let! test_check := prim_env_get "OURO_TEST_CHECK";
       let! pkg_check := native_hosted_first test_check (prim_env_get "OURO_PKG_CHECK");
       native_hosted_first pkg_check (prim_env_get "OURO_HOSTED_COMPILER_WRAPPER")

def native_hosted_command (name : String) (arguments : List String)
    : IO (Maybe (Pair String (List String))) :=
    match str_eq name "coil.exe" with
    | True =>
        do let! wrapper := native_hosted_compiler_wrapper;
           match wrapper with
           | Nothing => io_pure (Maybe (Pair String (List String)))
               (Nothing (Pair String (List String)))
           | Just path => io_pure (Maybe (Pair String (List String)))
               (Just (Pair String (List String))
                 (MkPair String (List String) "sh" (Cons String path arguments)))
           end
    | False =>
        match str_eq name "ouro-fmt.exe" with
        | True =>
            do let! fmt := prim_env_get "OURO_HOSTED_FMT";
               match fmt with
               | Nothing => io_pure (Maybe (Pair String (List String)))
                   (Nothing (Pair String (List String)))
               | Just path => io_pure (Maybe (Pair String (List String)))
                   (Just (Pair String (List String))
                     (MkPair String (List String) path arguments))
               end
        | False => io_pure (Maybe (Pair String (List String)))
            (Nothing (Pair String (List String)))
        end
    end;

def native_sibling_run (limits : ProcessCaptureLimits) (name : String) (arguments : List String)
    : IO (Either NativeSiblingError ProcResult) :=
    do let! hosted := native_hosted_command name arguments;
       match hosted with
       | Just spec => match spec with
         | MkPair program argv =>
             do let! result := proc_exec program argv;
                io_pure (Either NativeSiblingError ProcResult)
                  (Right NativeSiblingError ProcResult result)
         end
       | Nothing =>
           do let! located := executable_path_checked;
              match located with
              | Left error => io_pure (Either NativeSiblingError ProcResult)
                  (Left NativeSiblingError ProcResult (NativeSiblingImageError error))
              | Right image => match native_sibling_command image name arguments with
                | Left error => io_pure (Either NativeSiblingError ProcResult)
                    (Left NativeSiblingError ProcResult error)
                | Right command =>
                    do let! captured := process_run_spec_captured_bounded limits command;
                       io_pure (Either NativeSiblingError ProcResult) (match captured with
                         | Left error => Left NativeSiblingError ProcResult
                             (NativeSiblingProcessError (command_program command) error)
                         | Right result => Right NativeSiblingError ProcResult
                             (process_capture_proc_result result)
                         end)
                end
              end
       end
