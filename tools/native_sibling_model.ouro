-- Tool subprocess policy without imports from the compiler or build driver.
import "../std/executable_model.ouro";
import "../std/processx.ouro";

inductive NativeSiblingError : Type :=
  | NativeSiblingImageError : ExecutablePathError -> NativeSiblingError
  | NativeSiblingParentError : String -> NativeSiblingError
  | NativeSiblingProcessError : String -> ProcessCaptureError -> NativeSiblingError;

def native_sibling_error_message (error : NativeSiblingError) : String :=
    match error with
    | NativeSiblingImageError cause => executable_path_error_message cause
    | NativeSiblingParentError image => str_concat "current executable path has no parent directory: " image
    | NativeSiblingProcessError program cause => str_cat3 program ": " (process_capture_error_message cause)
    end;

def native_sibling_last_separator : List Nat -> Nat -> Maybe Nat :=
  fix scan (codes : List Nat) (index : Nat) : Maybe Nat :=
    match codes with
    | Nil => Nothing Nat
    | Cons code rest => match scan rest (S index) with
      | Just later => Just Nat later
      | Nothing => match orb (eq_nat code 47) (eq_nat code 92) with
        | True => Just Nat index
        | False => Nothing Nat
        end
      end
    end;

-- Every caller supplies a fixed sibling basename. Preserve the OS prefix,
-- including drive, UNC and extended path spelling, without normalization.
def native_sibling_path (image : String) (name : String) : Maybe String :=
    match native_sibling_last_separator (str_codes image) 0 with
    | Nothing => Nothing String
    | Just index => Just String (str_concat (str_slice image 0 (S index)) name)
    end;

def native_sibling_command (image : String) (name : String) (arguments : List String)
    : Either NativeSiblingError CommandSpec :=
    match native_sibling_path image name with
    | Nothing => Left NativeSiblingError CommandSpec (NativeSiblingParentError image)
    | Just program => Right NativeSiblingError CommandSpec (command_spec program arguments)
    end;

def native_sibling_capture_bytes : Nat := mul 16 (mul (mul 32 32) (mul 32 32));

-- Provisional policy; runtime measurements are still required.
def native_sibling_limits (timeout_ms : Nat) : ProcessCaptureLimits :=
    ProcessCaptureLimitsOf timeout_ms (mul 3 (mul 32 32)) 1
      native_sibling_capture_bytes native_sibling_capture_bytes;

def native_sibling_check_args (path : String) : List String := ["check", path];

def native_sibling_format_args (path : String) : List String := [path];

def native_sibling_check_ok (result : ProcResult) : Bool :=
    let combined : String := str_concat (proc_stdout result) (proc_stderr result) in
    andb (proc_ok result)
      (andb (str_contains combined "CHECK_OK") (notb (str_contains combined "CHECK_FAIL")));
