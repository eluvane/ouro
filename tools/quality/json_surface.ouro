-- Thin keep-import surface for parse_json / jsonx getters. The json and
-- jsonx implementation cones stay skip-harvested unless this file is selected.
import "../../std/json.ouro",
  "../../std/jsonx.ouro",
  "../../std/json_types.ouro";


def gate_parse_json (s : String) : Maybe Json :=
    parse_json s;


def gate_jsonx_as_string (j : Json) : Maybe String :=
    jsonx_as_string j;


def gate_jsonx_as_array (j : Json) : Maybe (List Json) :=
    jsonx_as_array j;


def gate_jsonx_path (j : Json) (path : List String) : Maybe Json :=
    jsonx_path j path;


def gate_jsonx_get_string (j : Json) (key : String) : Maybe String :=
    jsonx_get_string j key;


def gate_jsonx_get_bool (j : Json) (key : String) : Maybe Bool :=
    jsonx_get_bool j key;


def gate_jsonx_get_array (j : Json) (key : String) : Maybe (List Json) :=
    jsonx_get_array j key;


def gate_json_print (j : Json) : String :=
    json_print j;
