-- Source publication owns private stage/recovery files and verifies every
-- byte transition. Rewrite applicability and compiler acceptance are callers'
-- responsibilities; successful filesystem IO does not establish either.
import "source.ouro",
  "../native_build_output.ouro",
  "../../std/fs_replace.ouro";

def quality_source_read (path : String) : IO (Either FsError String) :=
    do let! result := quality_read_file path;
       match result with
       | Left error => fs_err(String, FsOperationFailed(quality_input_message error, path))
       | Right text => fs_ok String text
       end

def quality_source_matches (path : String) (expected : String) : IO (Either FsError Unit) :=
    do let! loaded := quality_source_read path;
       match loaded with
       | Left error => fs_err Unit error
       | Right actual => match prim_string_eq actual expected with
         | True => fs_ok Unit MkUnit
         | False => fs_err(Unit, FsOperationFailed "source bytes changed" path)
         end
       end

def quality_source_cleanup (stage : String) (backup : String) (result : Either FsError Unit)
    : IO (Either FsError Unit) :=
    do let! first := fsx_remove_if_exists stage;
       let! second := fsx_remove_if_exists backup;
       match first, second with
       | Right _, Right _ => io_pure(Either FsError Unit, result)
       | Left error, Right _ => fs_err Unit error
       | Right _, Left error => fs_err Unit error
       | Left first_error, Left second_error => fs_err Unit
           (FsOperationFailed (str_cat3 (fs_error_message first_error) "; cleanup: "
             (fs_error_message second_error)) backup)
       end

def quality_source_recovery_error (source : String) (stage : String) (backup : String) (reason : String)
    : IO (Either FsError Unit) :=
    fs_err Unit (FsOperationFailed
      (str_cat4 reason "; recovery retained at " backup (str_concat "; stage=" stage)) source);

def quality_source_restore (source : String) (stage : String) (backup : String)
    (expected : String) (reason : String)
    : IO (Either FsError Unit) :=
    do let! original := quality_source_matches backup expected;
       match original with
       | Left error => quality_source_recovery_error source stage backup
           (str_cat3 reason "; cannot verify recovery: " (fs_error_message error))
       | Right _ =>
           do let! restored := fs_rename_checked backup source;
              match restored with
              | Left error => quality_source_recovery_error source stage backup
                  (str_cat3 reason "; restore: " (fs_error_message error))
              | Right _ =>
                  do let! verified := quality_source_matches source expected;
                     match verified with
                     | Left error => quality_source_recovery_error source stage backup
                         (str_cat3 reason "; restore verification: " (fs_error_message error))
                     | Right _ => quality_source_cleanup stage backup
                         (Left FsError Unit (FsOperationFailed(str_concat reason "; original restored", source)))
                     end
              end
       end

-- Only a reported commit, or Windows' documented move-to-backup partial
-- failure, establishes that backup is the prior source. Preserve a concurrent
-- new source instead of overwriting it during recovery.
def quality_source_recover (source : String) (stage : String) (backup : String)
    (expected : String) (candidate : String) (status : Nat) (reason : String) : IO (Either FsError Unit) :=
    do let! original := quality_source_matches source expected;
       match original with
       | Right _ => quality_source_cleanup stage backup (Left FsError Unit (FsOperationFailed reason source))
       | Left _ =>
           match orb(eq_nat status 0, eq_nat(status, add(mul 11 100, 77))) with
           | False => quality_source_recovery_error source stage backup reason
           | True =>
               do let! exists := fs_exists source;
                  match exists with
                  | False => quality_source_restore source stage backup expected reason
                  | True =>
                      do let! installed := quality_source_matches source candidate;
                         match installed with
                         | Right _ => quality_source_restore source stage backup expected reason
                         | Left _ => quality_source_recovery_error source stage backup
                             (str_concat reason "; current source changed or is unreadable")
                         end
                  end
           end
       end

def quality_source_committed (source : String) (stage : String) (backup : String)
    (expected : String) (candidate : String) : IO (Either FsError Unit) :=
    do let! installed := quality_source_matches source candidate;
       let! saved := quality_source_matches backup expected;
       let! stage_exists := fs_exists stage;
       let failed : IO (Either FsError Unit) :=
           quality_source_recover source stage backup expected candidate 0 "verify source replacement" in
       match installed with
       | Left _ => failed
       | Right _ => match saved with
         | Left _ => failed
         | Right _ => match stage_exists with
           | False => quality_source_cleanup stage backup (Right FsError Unit MkUnit)
           | True => failed end end
       end

def quality_source_commit (source : String) (stage : String) (backup : String)
    (expected : String) (candidate : String) : IO (Either FsError Unit) :=
    do let! original := quality_source_matches source expected;
       match original with
       | Left error => quality_source_cleanup stage backup (Left FsError Unit error)
       | Right _ =>
           do let! result := fs_replace_file source stage backup;
              match result with
              | FsReplaced => quality_source_committed source stage backup expected candidate
              | FsReplaceFailed status => quality_source_recover source stage backup expected candidate status
                  (str_concat("replace status=", prim_string_of_nat status))
              end
       end

def quality_source_stage (source : String) (stage : String) (backup : String)
    (expected : String) (candidate : String) : IO (Either FsError Unit) :=
    -- Both private files already exist. Stage through the checked write API,
    -- then verify bytes before the replace transaction.
    do let! ready := quality_source_matches stage "";
       let! recovery := quality_source_matches backup "";
       match ready with
       | Left error => quality_source_cleanup stage backup (Left FsError Unit error)
       | Right _ => match recovery with
         | Left error => quality_source_cleanup stage backup (Left FsError Unit error)
         | Right _ =>
           do let! wrote := fs_write_checked stage candidate;
              match wrote with
              | Left error => quality_source_cleanup stage backup (Left FsError Unit error)
              | Right _ =>
                  do let! verified := quality_source_matches stage candidate;
                     match verified with
                     | Left error => quality_source_cleanup stage backup (Left FsError Unit error)
                     | Right _ => quality_source_commit source stage backup expected candidate
                     end
              end
         end
       end

def quality_source_reserve_backup (source : String) (stage : String)
    (expected : String) (candidate : String) : IO (Either FsError Unit) :=
    do let! backup := prim_fs_temp_file_in (native_build_dirname source);
       match prim_string_eq backup "" with
       | True => native_build_output_cleanup(stage, FsOperationFailed "reserve source recovery" source)
       | False => quality_source_stage source stage backup expected candidate
       end

def quality_write_source_checked (source : String) (expected : String) (candidate : String)
    : IO (Either FsError Unit) :=
    do let! original := quality_source_matches source expected;
       match original with
       | Left error => fs_err Unit error
       | Right _ =>
           match prim_string_eq expected candidate with
           | True => fs_ok Unit MkUnit
           | False =>
               do let! stage := prim_fs_temp_file_in (native_build_dirname source);
                  match prim_string_eq stage "" with
                  | True => fs_err(Unit, FsOperationFailed "reserve source stage" source)
                  | False => quality_source_reserve_backup source stage expected candidate
                  end
           end
       end
