-- Checked source selection for the strict and Clippy compatibility commands.
-- Scope policy lives here; callers only validate the complete result protocol.

-- @entry main

import "source.ouro",
  "../strict/walk.ouro",
  "../../std/json.ouro";

def qi_relative (root : String) (path : String) : String :=
    prim_string_slice(path, S (prim_string_length root), prim_string_length path);

def qi_generated (path : String) : Bool :=
    any String (prim_string_contains path) [ "compiler/stage0/", "/generated/", ".generated." ];

def qi_keep (root : String) (mode : String) (fixtures : Bool) (absolute : String) : Bool :=
    let path : String := qi_relative root absolute in
    match prim_string_eq mode "strict" with
    | True => andb(notb (qi_generated path), orb(fixtures, notb (st_strict_fixture path)))
    | False => orb fixtures (notb (any String (prim_string_contains path)
        [ "_build/", "quality/fixtures/", "/bad/", "/good/" ]))
    end;

def qi_under (root : String) (path : String) : Bool :=
    orb(prim_string_eq root path, prim_string_starts(path, concat root "/"));

-- Check links and kinds before canonicalization; resolving first would hide a
-- link supplied as a root. Canonical roots also make path-based policy stable
-- across ./ and ../ spellings and overlapping scopes.
def qi_roots (root : String) : List String -> List String
    -> IO (Either QualityInputError (List String)) :=
  fix go (pending : List String) (acc : List String)
      : IO (Either QualityInputError (List String)) :=
    match pending with
    | Nil => io_pure (Either(QualityInputError, List String))
        (Right(QualityInputError, List String, reverse_lin String acc))
    | Cons path rest =>
        do let! kind := prim_fs_kind path;
           match orb(eq_nat kind 1, eq_nat kind 2) with
           | False => io_pure (Either(QualityInputError, List String))
               (Left(QualityInputError, List String, QualityInvalidInput path))
           | True =>
               do let! resolved := prim_fs_realpath path;
                  let canonical : String := quality_normalize_path resolved in
                  match andb(ltb_nat(Z, prim_string_length canonical), qi_under root canonical) with
                  | False => io_pure (Either(QualityInputError, List String))
                      (Left(QualityInputError, List String, QualityInvalidInput path))
                  | True => go(rest, Cons String canonical acc)
                  end
           end
    end;

def qi_report_string_items : List String -> String -> IO Unit :=
  fix emit (values : List String) (separator : String) : IO Unit :=
    match values with
    | Nil => io_pure Unit MkUnit
    | Cons value rest =>
        do print separator;
           print (json_escape_str value);
           emit rest ","
    end;

def qi_report_strings (values : List String) : IO Unit :=
    do print "[";
       qi_report_string_items values "";
       print "]"

-- The checked inventory is complete before output starts. Stream the fixed
-- schema with the existing JSON string encoder: assembling every array suffix
-- into a compact String copies O(n^2) bytes on a process-lifetime C-host heap.
-- A failed process never makes a partial stream a successful report.
def qi_report (mode : String) (fixtures : Bool) (root : String)
    (scopes : List String) (files : List String) : IO Unit :=
    do print "{\"kind\":\"ouro.quality-inputs.v1\",\"mode\":";
       print (json_escape_str mode);
       print ",\"include_fixtures\":";
       print (match fixtures with | True => "true" | False => "false" end);
       print ",\"root\":";
       print (json_escape_str root);
       print ",\"scopes\":";
       qi_report_strings scopes;
       print ",\"files\":";
       qi_report_strings files;
       println ",\"complete\":true}"

def qi_fail (error : QualityInputError) : IO Unit :=
    do eprintln (quality_input_message error); exit 1

def qi_scan (mode : String) (fixtures : Bool) (root : String) (scopes : List String) : IO Unit :=
    do let! checked := qi_roots root scopes (Nil String);
       match checked with
       | Left error => qi_fail error
       | Right roots =>
           do let! selected := quality_inventory(st_skip_mode mode, qi_keep root mode fixtures, roots);
              match selected with
              | Left error => qi_fail error
              | Right files => qi_report mode fixtures root scopes files
              end
       end

def qi_start (mode : String) (fixtures : Bool) (root : String) (scopes : List String) : IO Unit :=
    do let! kind := prim_fs_kind root;
       match eq_nat kind 2 with
       | False => qi_fail (QualityInvalidInput root)
       | True =>
           do let! resolved := prim_fs_realpath root;
              let canonical : String := quality_normalize_path resolved in
              match prim_string_length canonical with
              | Z => qi_fail (QualityInvalidInput root)
              | S _ => qi_scan mode fixtures canonical scopes
              end
       end

def qi_usage : IO Unit :=
    do eprintln "usage: ouro-quality-inputs (strict|clippy) (include|exclude) ROOT SCOPE...";
       exit 2

def qi_args (values : List String) : IO Unit :=
    match values with
    | Nil => qi_usage
    | Cons mode rest =>
        match rest with
        | Nil => qi_usage
        | Cons visibility more =>
            match more with
            | Nil => qi_usage
            | Cons root scopes =>
                match scopes with
                | Nil => qi_usage
                | Cons _ _ =>
                    match andb (elem String prim_string_eq mode [ "strict", "clippy" ])
                        (elem String prim_string_eq visibility [ "include", "exclude" ]) with
                    | True => qi_start mode (prim_string_eq visibility "include") root scopes
                    | False => qi_usage
                    end
                end
            end
        end
    end;

def main : IO Unit :=
    do let! values := prim_argv;
       match values with | Nil => qi_usage | Cons _ rest => qi_args rest end
