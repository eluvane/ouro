-- Ordered import operands for source-oriented quality tools.
-- The declaration parser remains the acceptance authority.

import "text.ouro",
  "../../compiler/source_text.ouro";

inductive ImportScanError : Type :=
  | ImportScanFailure : Nat -> ImportScanError;

-- Decoded path, optional alias, declaration start, literal [first, past),
-- and optional alias start. Offsets are UTF-8 byte offsets.
inductive ScannedImport : Type :=
  | MkScannedImport : String -> Maybe String -> Nat -> Nat -> Nat -> Maybe Nat
      -> ScannedImport;

inductive ImportScanStep : Type :=
  | ImportScanOk : Nat -> List ScannedImport -> ImportScanStep
  | ImportScanBad : Nat -> ImportScanStep;

def import_scan_place (source : String) (offset : Nat) : Pair Nat Nat :=
  qt_line_col(source, offset);

-- C-host search stops at NUL. Native search uses the full byte length.
private def import_scan_nul_stops (byte : Nat) : Bool :=
  match prim_string_index (prim_string_of_char_codes ([byte, ch_lf] : List Nat)) "\n" with
  | Nothing => True
  | Just _ => False
  end;

private def import_scan_find_from (source : String) (start : Nat)
    (matches : Nat -> Nat -> Bool) : Maybe Nat :=
  let size : Nat := prim_string_length source in
  (fix find (fuel : Nat) (pos : Nat) : Maybe Nat :=
    match fuel with
    | Z => Nothing Nat
    | S remaining =>
        if ltb_nat pos size then
          let byte : Nat := prim_string_byte_at source pos in
          if matches pos byte then Just(Nat, pos)
          else
            let stopped : Bool := if is_nul byte then import_scan_nul_stops byte else False in
            if stopped then Nothing Nat else find remaining (add pos 1)
        else Nothing Nat
    end) (add(sub size start, 1)) start;

def import_scan_comment_past (source : String) (start : Nat) : Nat :=
  match import_scan_find_from source start (fun (_ : Nat) (byte : Nat) => is_lf byte) with
  | Nothing => prim_string_length source
  | Just at => add at 1
  end;

def import_scan_trivia (source : String) (start : Nat) : Nat :=
  (fix go (fuel : Nat) (pos : Nat) : Nat :=
    match fuel with
    | Z => pos
    | S remaining =>
        if ltb_nat(pos, prim_string_length source) then
          if is_ws (prim_string_byte_at source pos) then go(remaining, add pos 1)
          else
            if qt_starts_at source pos "--" then
              go(remaining, import_scan_comment_past source pos)
            else pos
        else pos
    end) (add(prim_string_length source, 1)) start;

-- Skip a complete quoted region, including escaped quotes. This is also used
-- for character-like source regions so `import` inside one is never harvested.
def import_scan_quote_past (source : String) (start : Nat) : Maybe Nat :=
  let quote : Nat := prim_string_byte_at source start in
  let size : Nat := prim_string_length source in
  (fix go (fuel : Nat) (pos : Nat) : Maybe Nat :=
    match fuel with
    | Z => Nothing Nat
    | S remaining =>
        if ltb_nat pos size then
          let byte : Nat := prim_string_byte_at source pos in
          if eq_nat byte ch_bslash then
            if ltb_nat(add pos 1, size) then go(remaining, add pos 2) else Nothing Nat
          else if eq_nat byte quote then Just(Nat, add pos 1) else go(remaining, add pos 1)
        else Nothing Nat
    end) (S size) (S start);

def import_scan_raw_start (source : String) (start : Nat) : Bool :=
  qt_starts_at source start "r#\"";

def import_scan_literal_past (source : String) (start : Nat) : Maybe Nat :=
  if import_scan_raw_start source start then
    match import_scan_find_from source (add start 3)
      (fun (pos : Nat) (byte : Nat) =>
        if eq_nat byte ch_quote then qt_starts_at source pos "\"#" else False) with
    | Nothing => Nothing Nat
    | Just at => Just(Nat, add at 2)
    end
  else import_scan_quote_past source start;

-- Ordinary escapes retain the compiler lexer's byte behavior; braced Unicode
-- escapes use its shared scalar decoder below.
def import_scan_escaped (byte : Nat) (acc : List Nat) : List Nat :=
  source_string_escape_byte byte acc;

def import_scan_decoded (source : String) (first : Nat) (past : Nat)
    : Maybe String :=
  let close : Nat := sub(past, 1) in
  (fix go (fuel : Nat) (pos : Nat) (acc : List Nat) : Maybe String :=
    match fuel with
    | Z => Nothing String
    | S remaining =>
        if ltb_nat pos close then
          let byte : Nat := prim_string_byte_at source pos in
          if eq_nat byte ch_bslash then
            if ltb_nat(add pos 1, close) then
              let escaped : Nat := prim_string_byte_at(source, add pos 1) in
              if
                andb(eq_nat escaped 117,
                  andb(ltb_nat(add pos 2, close),
                    eq_nat(prim_string_byte_at source (add pos 2), ch_lbrace))) then
                let raw : List Nat := prim_string_to_char_codes
                  (prim_string_slice source (add pos 2)
                    (sub close (add pos 2))) in
                match source_unicode_braced raw with
                | Nothing => Nothing String
                | Just parsed => let (MkPair bytes rest) := parsed in
                  go(remaining,
                    add(add pos 2, sub(length Nat raw, length Nat rest)),
                    append Nat (reverse Nat bytes) acc)
                end
              else
                go(remaining, add pos 2,
                  import_scan_escaped escaped acc)
            else Nothing String
          else go(remaining, add pos 1, Cons Nat byte acc)
        else Just(String, prim_string_of_char_codes(reverse Nat acc))
    end) (add(sub past first, 1)) (add first 1) (Nil Nat);

def import_scan_literal_decoded (source : String) (first : Nat) (past : Nat)
    : Maybe String :=
  if import_scan_raw_start source first then
    Just(String,
      prim_string_slice source (add first 3) (sub(past, add first 5)))
  else import_scan_decoded source first past;

def import_scan_at_byte (source : String) (pos : Nat) (byte : Nat) : Bool :=
  andb(ltb_nat(pos, prim_string_length source),
    eq_nat(prim_string_byte_at source pos, byte));

def import_scan_group (source : String) (declaration : Nat) (first : Nat)
    (collected : List ScannedImport) : ImportScanStep :=
  (fix go (fuel : Nat) (quote : Nat) (first_path : Bool)
      (acc : List ScannedImport) : ImportScanStep :=
    match fuel with
    | Z => ImportScanBad quote
    | S remaining =>
        match import_scan_literal_past source quote with
        | Nothing => ImportScanBad quote
        | Just past => match import_scan_literal_decoded source quote past with
          | Nothing => ImportScanBad quote
          | Just path =>
              let after : Nat := import_scan_trivia source past in
              let plain : ScannedImport :=
                MkScannedImport(path, Nothing String, declaration, quote, past,
                  Nothing Nat) in
              if import_scan_at_byte source after ch_comma then
                let next : Nat := import_scan_trivia(source, add after 1) in
                if import_scan_at_byte source next ch_semi then
                  ImportScanOk(add next 1, Cons ScannedImport plain acc)
                else
                  if
                    orb(import_scan_at_byte source next ch_quote,
                      import_scan_raw_start source next) then
                    go remaining next False (Cons ScannedImport plain acc)
                  else ImportScanBad next
              else
                if qt_at_word source after "as" then
                  if first_path then
                    let alias_start : Nat := import_scan_trivia(source, add after 2) in
                    match qt_ident_at source alias_start with
                    | Nothing => ImportScanBad alias_start
                    | Just alias =>
                        let alias_past : Nat := qt_ident_end source alias_start in
                        let next : Nat := import_scan_trivia source alias_past in
                        if import_scan_at_byte source next ch_comma then ImportScanBad next
                        else
                          let row : ScannedImport :=
                            MkScannedImport(path, Just(String, alias), declaration,
                              quote, past, Just(Nat, alias_start)) in
                          if import_scan_at_byte source next ch_semi then
                            ImportScanOk(add next 1, Cons ScannedImport row acc)
                          else ImportScanOk(next, Cons ScannedImport row acc)
                    end
                  else ImportScanBad after
                else
                  if import_scan_at_byte source after ch_semi then
                    ImportScanOk(add after 1, Cons ScannedImport plain acc)
                  else ImportScanOk(after, Cons ScannedImport plain acc)
          end
        end
    end) (add(prim_string_length source, 1)) first True collected;

private def import_scan_marker (source : String) (pos : Nat) (byte : Nat) : Bool :=
  if eq_nat byte ch_minus then qt_starts_at source pos "--"
  else if eq_nat byte 114 then import_scan_raw_start source pos
  else if eq_nat byte 105 then qt_starts_at source pos "import"
  else orb(eq_nat byte ch_quote, eq_nat byte ch_squote);

-- The gap has no quotes or comments: the forward walk consumed those first.
-- Carry the previous code byte across comments so their punctuation cannot
-- become a projection, while `N. -- comment\n import` remains qualified.
def import_scan_after_projection (source : String) (cursor : Nat) (start : Nat)
    (prior_dot : Bool) : Bool :=
  (fix before (fuel : Nat) (pos : Nat) : Bool :=
    match fuel with
    | Z => prior_dot
    | S remaining => if ltb_nat cursor pos then
        let previous : Nat := sub(pos, 1) in
        let byte : Nat := prim_string_byte_at source previous in
        if is_ws byte then before remaining previous else eq_nat byte ch_dot
      else prior_dot
    end) (add(sub start cursor, 1)) start;

def scan_source_imports (input : String)
    : Either ImportScanError (List ScannedImport) :=
  -- Byte indexing is constant time on a flat host string.
  let source : String := prim_string_slice input 0 (prim_string_length input) in
  (fix walk (fuel : Nat) (cursor : Nat) (prior_dot : Bool)
      (acc : List ScannedImport)
      : Either ImportScanError (List ScannedImport) :=
    match fuel with
    | Z => Left ImportScanError (List ScannedImport)
        (ImportScanFailure cursor)
    | S remaining =>
        match import_scan_find_from source cursor (import_scan_marker source) with
        | Nothing => Right ImportScanError (List ScannedImport) (reverse ScannedImport acc)
        | Just pos =>
            let projected : Bool :=
              import_scan_after_projection source cursor pos prior_dot in
            if qt_starts_at source pos "--" then
              walk remaining (import_scan_comment_past source pos)
                projected acc
            else
              if
                orb(qt_starts_quote source pos,
                  import_scan_raw_start source pos) then
                match import_scan_literal_past source pos with
                | Nothing => Left ImportScanError (List ScannedImport)
                    (ImportScanFailure pos)
                | Just past => walk remaining past False acc
                end
              else
                if
                  andb(qt_at_word source pos "import",
                    notb projected) then
                  let quote : Nat := import_scan_trivia(source, add pos 6) in
                  if
                    orb(import_scan_at_byte source quote ch_quote,
                      import_scan_raw_start source quote) then
                    match import_scan_group source pos quote acc with
                    | ImportScanBad at => Left ImportScanError (List ScannedImport)
                        (ImportScanFailure at)
                    | ImportScanOk past gathered =>
                        walk remaining past False gathered
                    end
                  else
                    Left ImportScanError (List ScannedImport)
                      (ImportScanFailure quote)
                else walk remaining (add pos 1) False acc
        end
    end) (add(prim_string_length source, 1)) 0 False (Nil ScannedImport);
