-- Stable ordering for quality inventories without quadratic insertion or
-- membership scans. Binary runs keep list work bounded by O(n log n).
-- This leaf is also usable inside the compiler lexer import cone.
import "../../std/collections.ouro";

def quality_merge_sorted (A : Type) (le : A -> A -> Bool) : List A -> List A -> List A :=
  fix merge (left : List A) (right : List A) : List A :=
    match left with
    | Nil => right
    | Cons item rest =>
        (fix before (pending : List A) : List A :=
          match pending with
          | Nil => left
          | Cons other more => match le item other with
            | True => Cons A item (merge rest pending)
            | False => Cons A other (before more)
            end
          end) right
    end;

def quality_sort_push (A : Type) (le : A -> A -> Bool)
    : List (Maybe (List A)) -> List A -> List (Maybe (List A)) :=
  fix carry (bins : List (Maybe (List A))) (run : List A) : List (Maybe (List A)) :=
    match bins with
    | Nil => [Just(List A, run)]
    | Cons slot rest => match slot with
      | Nothing => Cons(Maybe (List A), Just(List A, run), rest)
      | Just previous => Cons (Maybe (List A)) (Nothing (List A))
          (carry(rest, quality_merge_sorted A le previous run))
      end
    end;

def quality_sort_finish (A : Type) (le : A -> A -> Bool)
    : List (Maybe (List A)) -> List A -> List A :=
  fix gather (bins : List (Maybe (List A))) (acc : List A) : List A :=
    match bins with
    | Nil => acc
    | Cons slot rest => match slot with
      | Nothing => gather rest acc
      | Just previous => gather(rest, quality_merge_sorted A le previous acc)
      end
    end;

def quality_sort (A : Type) (le : A -> A -> Bool) (values : List A) : List A :=
    quality_sort_finish A le
      ((fix collect (remaining : List A) (bins : List (Maybe (List A))) : List (Maybe (List A)) :=
          match remaining with
          | Nil => bins
          | Cons value rest => collect(rest, quality_sort_push A le bins [value])
          end) values []) [];
