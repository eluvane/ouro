-- File IO for quality JSON rows. Types, loaders, and report shaping live in
-- registry_model.ouro so Clippy core/scan can stay off std/io.

import "registry_model.ouro",
  "../../std/json_types.ouro",
  "source.ouro",
  "../../std/fs.ouro";

def qr_read_object_text (path : String) : IO (Either String Json) :=
    do let! loaded := quality_read_file path;
       match loaded with
       | Left e => io_pure (Either String Json)
           (Left String Json (quality_input_message e))
       | Right text => match qr_parse_object text with
         | Nothing => io_pure (Either String Json)
             (Left String Json (prim_string_concat "unreadable JSON " path))
         | Just value => io_pure (Either String Json)
             (Right String Json value)
         end
       end

def qr_read_object (path : String) : IO (Either String Json) :=
    do let! kind := prim_fs_kind path;
       match eq_nat kind 1 with
       | False => io_pure (Either String Json)
           (Left String Json (prim_string_concat "unreadable JSON " path))
       | True => qr_read_object_text path
       end

def qr_write_text (path : String) (body : String) : IO (Either String Unit) :=
    do let! wrote := fs_write_checked path body;
       match wrote with
       | Left e => io_pure (Either String Unit)
           (Left String Unit (fs_error_message e))
       | Right u => io_pure(Either String Unit, Right String Unit u)
       end

def qr_write_json (path : String) (j : Json) : IO (Either String Unit) :=
    qr_write_text(path, qr_dumps j);

def qr_is_file (path : String) : IO Bool :=
    do let! kind := prim_fs_kind path;
       io_pure(Bool, eq_nat kind 1)
