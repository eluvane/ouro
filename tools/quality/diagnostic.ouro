-- Common transport for rule results. Detection stays with each existing rule
-- owner. Locations and edit ranges are UTF-8 byte positions; zero line/column
-- means unknown, never a claim of a precise compiler span.
-- This leaf deliberately shares no std/char or compiler parser namespace.

import "../../std/string_prims.ouro";

inductive QualityLevel : Type :=
  | QualityAllow : QualityLevel
  | QualityWarn : QualityLevel
  | QualityDeny : QualityLevel
  | QualityForbid : QualityLevel;

def quality_level_name (level : QualityLevel) : String :=
    match level with
    | QualityAllow => "allow"
    | QualityWarn => "warn"
    | QualityDeny => "deny"
    | QualityForbid => "forbid"
    end;

def quality_level_parse (name : String) : Maybe QualityLevel :=
    match prim_string_eq name "allow" with
    | True => Just QualityLevel QualityAllow
    | False => match prim_string_eq name "warn" with
      | True => Just QualityLevel QualityWarn
      | False => match prim_string_eq name "deny" with
        | True => Just QualityLevel QualityDeny
        | False => match prim_string_eq name "forbid" with
          | True => Just QualityLevel QualityForbid
          | False => Nothing QualityLevel end end end
    end;

-- Legacy info is visible and nonblocking, like warn. Its original display
-- label remains available to compatibility renderers. Fatal maps to forbid,
-- including the prohibition on source-level suppression.
def quality_legacy_level (name : String) : Maybe QualityLevel :=
    match prim_string_eq name "info" with
    | True => Just QualityLevel QualityWarn
    | False => match prim_string_eq name "warning" with
      | True => Just QualityLevel QualityWarn
      | False => match prim_string_eq name "error" with
        | True => Just QualityLevel QualityDeny
        | False => match prim_string_eq name "fatal" with
          | True => Just QualityLevel QualityForbid
          | False => quality_level_parse name end end end
    end;

def quality_level_blocks (level : QualityLevel) (suppressed : Bool) : Bool :=
    match level with
    | QualityAllow => False
    | QualityWarn => False
    | QualityDeny => notb suppressed
    | QualityForbid => True
    end;

def quality_level_suppressible (level : QualityLevel) (registered : Bool) : Bool :=
    match level with
    | QualityForbid => False
    | QualityAllow => registered
    | QualityWarn => registered
    | QualityDeny => registered
    end;

-- The stable ID selects a registry row. Owner and rule identify the existing
-- implementation; neither a path nor a fixture name determines the rule ID.
inductive QualityRule : Type :=
  | MkQualityRule : String -> String -> String -> QualityRule;

def quality_rule_id (rule : QualityRule) : String :=
    match rule with | MkQualityRule code _ _ => code end;

def quality_rule_owner (rule : QualityRule) : String :=
    match rule with | MkQualityRule _ owner _ => owner end;

def quality_rule_name (rule : QualityRule) : String :=
    match rule with | MkQualityRule _ _ name => name end;

inductive QualityLocation : Type :=
  | MkQualityLocation : String -> Nat -> Nat -> QualityLocation;

def quality_location_path (location : QualityLocation) : String :=
    match location with | MkQualityLocation path _ _ => path end;

def quality_location_line (location : QualityLocation) : Nat :=
    match location with | MkQualityLocation _ line _ => line end;

def quality_location_column (location : QualityLocation) : Nat :=
    match location with | MkQualityLocation _ _ column => column end;

-- A proposed edit is not permission to write. Only the owning fix pipeline
-- can establish applicability, convergence, candidate checks and publication.
inductive QualityApplicability : Type :=
  | QualityNoEdit : QualityApplicability
  | QualitySuggestedEdit : QualityApplicability
  | QualityMechanicalEdit : QualityApplicability;

inductive QualityEdit : Type :=
  | MkQualityEdit : Nat -> Nat -> String -> QualityEdit;

def quality_edit_start (edit : QualityEdit) : Nat :=
    match edit with | MkQualityEdit start _ _ => start end;

def quality_edit_end (edit : QualityEdit) : Nat :=
    match edit with | MkQualityEdit _ finish _ => finish end;

def quality_edit_text (edit : QualityEdit) : String :=
    match edit with | MkQualityEdit _ _ text => text end;

-- Message, evidence and hint retain the owner's original wording. Related
-- edits belong to this same diagnostic ID, rather than a second rule table.
inductive QualityAdvice : Type :=
  | MkQualityAdvice : String -> String -> String -> QualityApplicability
      -> List QualityEdit -> QualityAdvice;

def quality_advice_message (advice : QualityAdvice) : String :=
    match advice with | MkQualityAdvice message _ _ _ _ => message end;

def quality_advice_evidence (advice : QualityAdvice) : String :=
    match advice with | MkQualityAdvice _ evidence _ _ _ => evidence end;

def quality_advice_hint (advice : QualityAdvice) : String :=
    match advice with | MkQualityAdvice _ _ hint _ _ => hint end;

def quality_advice_applicability (advice : QualityAdvice) : QualityApplicability :=
    match advice with | MkQualityAdvice _ _ _ applicability _ => applicability end;

def quality_advice_edits (advice : QualityAdvice) : List QualityEdit :=
    match advice with | MkQualityAdvice _ _ _ _ edits => edits end;

inductive QualityDiagnostic : Type :=
  | MkQualityDiagnostic : QualityRule -> QualityLevel -> QualityLocation
      -> QualityAdvice -> Bool -> QualityDiagnostic;

def quality_diagnostic_rule (diagnostic : QualityDiagnostic) : QualityRule :=
    match diagnostic with | MkQualityDiagnostic rule _ _ _ _ => rule end;

def quality_diagnostic_level (diagnostic : QualityDiagnostic) : QualityLevel :=
    match diagnostic with | MkQualityDiagnostic _ level _ _ _ => level end;

def quality_diagnostic_location (diagnostic : QualityDiagnostic) : QualityLocation :=
    match diagnostic with | MkQualityDiagnostic _ _ location _ _ => location end;

def quality_diagnostic_advice (diagnostic : QualityDiagnostic) : QualityAdvice :=
    match diagnostic with | MkQualityDiagnostic _ _ _ advice _ => advice end;

def quality_diagnostic_suppressed (diagnostic : QualityDiagnostic) : Bool :=
    match diagnostic with | MkQualityDiagnostic _ _ _ _ suppressed => suppressed end;

def quality_diagnostic_blocks (diagnostic : QualityDiagnostic) : Bool :=
    quality_level_blocks (quality_diagnostic_level diagnostic)
      (quality_diagnostic_suppressed diagnostic);

def quality_text_location (location : QualityLocation) : String :=
    prim_string_concat (quality_location_path location)
      (prim_string_concat ":" (prim_string_concat
        (prim_string_of_nat (quality_location_line location))
        (prim_string_concat(":", prim_string_of_nat (quality_location_column location)))));

-- The label is explicit because public commands retain info/warning/error
-- spellings while the policy contract uses allow/warn/deny/forbid.
def quality_text_head (label : String) (diagnostic : QualityDiagnostic) : String :=
    let rule : QualityRule := quality_diagnostic_rule diagnostic in
    prim_string_concat (quality_text_location (quality_diagnostic_location diagnostic))
      (prim_string_concat ": " (prim_string_concat label
        (prim_string_concat "[" (prim_string_concat (quality_rule_id rule)
          (prim_string_concat "] " (prim_string_concat (quality_rule_owner rule)
            (prim_string_concat "/" (prim_string_concat (quality_rule_name rule)
              (prim_string_concat ": "
                (quality_advice_message (quality_diagnostic_advice diagnostic)))))))))));

def quality_text_details (diagnostic : QualityDiagnostic) : String :=
    let advice : QualityAdvice := quality_diagnostic_advice diagnostic in
    prim_string_concat "\n  hint: " (prim_string_concat (quality_advice_hint advice)
      (prim_string_concat("\n  witness: ", quality_advice_evidence advice)));

def quality_text_analyzer (label : String) (diagnostic : QualityDiagnostic) : String :=
    prim_string_concat(quality_text_head label diagnostic, quality_text_details diagnostic);
