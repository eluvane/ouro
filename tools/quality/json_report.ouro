-- JSON accessors and Python json.dumps(indent=2, sort_keys=True) rendering.

import "../../std/json.ouro",
  "text.ouro",
  "order.ouro";

def qr_pairs (j : Json) : List (Pair String Json) :=
    match j with
    | JObj xs => xs
    | JNull => []
    | JBool _ => []
    | JNum _ => []
    | JStr _ => []
    | JArr _ => []
    end;

def qr_items (j : Json) : List Json :=
    match j with
    | JArr xs => xs
    | JNull => []
    | JBool _ => []
    | JNum _ => []
    | JStr _ => []
    | JObj _ => []
    end;

def qr_get (j : Json) (k : String) : Maybe Json :=
    lookup String Json prim_string_eq k (qr_pairs j);

def qr_get_or (j : Json) (k : String) (fallback : Json) : Json :=
    match qr_get j k with
    | Nothing => fallback
    | Just value => value
    end;

def qr_as_str (j : Json) : Maybe String :=
    match j with
    | JStr s => Just String s
    | JNull => Nothing String
    | JBool _ => Nothing String
    | JNum _ => Nothing String
    | JArr _ => Nothing String
    | JObj _ => Nothing String
    end;

def qr_as_bool (j : Json) : Maybe Bool :=
    match j with
    | JBool b => Just Bool b
    | JNull => Nothing Bool
    | JNum _ => Nothing Bool
    | JStr _ => Nothing Bool
    | JArr _ => Nothing Bool
    | JObj _ => Nothing Bool
    end;

def qr_str_or (j : Json) (k : String) (fallback : String) : String :=
    match qr_as_str (qr_get_or j k JNull) with
    | Nothing => fallback
    | Just s => s
    end;

def qr_bool_or (j : Json) (k : String) (fallback : Bool) : Bool :=
    match qr_as_bool (qr_get_or j k JNull) with
    | Nothing => fallback
    | Just b => b
    end;

def qr_arr (j : Json) (k : String) : List Json :=
    qr_items (qr_get_or j k (JArr []));

def qr_obj (j : Json) (k : String) : Json :=
    let value : Json := qr_get_or j k (JObj []) in
    match value with
    | JObj _ => value
    | JNull => JObj []
    | JBool _ => JObj []
    | JNum _ => JObj []
    | JStr _ => JObj []
    | JArr _ => JObj []
    end;

def qr_is_obj (j : Json) : Bool :=
    match j with
    | JObj _ => True
    | JNull => False
    | JBool _ => False
    | JNum _ => False
    | JStr _ => False
    | JArr _ => False
    end;

def qr_parse_object (text : String) : Maybe Json :=
    match parse_json text with
    | Nothing => Nothing Json
    | Just value => match qr_is_obj value with
      | True => Just Json value
      | False => Nothing Json
      end
    end;

def qr_pair_le (a : Pair String Json) (b : Pair String Json) : Bool :=
    prim_string_le(fst String Json a, fst String Json b);

def qr_sort_pairs (xs : List (Pair String Json)) : List (Pair String Json) :=
    quality_sort (Pair String Json) qr_pair_le xs;

def qr_spaces (n : Nat) : String :=
    (fix go (fuel : Nat) (acc : String) : String :=
      match fuel with
      | Z => acc
      | S fuel2 => go(fuel2, prim_string_concat acc "  ")
      end) n "";

def qr_pretty_scalar (j : Json) : String :=
    match j with
    | JNull => "null"
    | JBool b => match b with
      | True => "true"
      | False => "false"
      end
    | JNum s => s
    | JStr s => qt_py_escape s
    | JArr _ => "[]"
    | JObj _ => "{}"
    end;

def qr_pretty : Nat -> Nat -> Json -> String :=
  fix render (fuel : Nat) (indent : Nat) (j : Json) : String :=
    match fuel with
    | Z => qr_pretty_scalar j
    | S fuel2 =>
        match j with
        | JNull => "null"
        | JBool b => qr_pretty_scalar (JBool b)
        | JNum s => s
        | JStr s => qt_py_escape s
        | JArr xs => match xs with
          | Nil => "[]"
          | Cons _ _ =>
              let inner : Nat := add indent 1 in
              let pad : String := qr_spaces inner in
              let close : String := qr_spaces indent in
              let body : String :=
                (fix items (ys : List Json) (first : Bool) (acc : String) : String :=
                  match ys with
                  | Nil => acc
                  | Cons y rest =>
                      let prefix : String := match first with
                        | True => "[\n"
                        | False => ",\n"
                        end in
                      let chunk : String := qt_cat3 prefix pad (render fuel2 inner y) in
                      items rest False (prim_string_concat acc chunk)
                  end) xs True "" in
              qt_cat3 body "\n" (prim_string_concat close "]")
          end
        | JObj xs => match xs with
          | Nil => "{}"
          | Cons _ _ =>
              let inner : Nat := add indent 1 in
              let pad : String := qr_spaces inner in
              let close : String := qr_spaces indent in
              let body : String :=
                (fix items (ys : List (Pair String Json)) (first : Bool) (acc : String)
                    : String :=
                  match ys with
                  | Nil => acc
                  | Cons pair rest =>
                      match pair with
                      | MkPair key value =>
                          let prefix : String := match first with
                            | True => "{\n"
                            | False => ",\n"
                            end in
                          let head : String := qt_cat4 prefix pad (qt_py_escape key) ": " in
                          let chunk : String := prim_string_concat head
                            (render fuel2 inner value) in
                          items rest False (prim_string_concat acc chunk)
                      end
                  end) (qr_sort_pairs xs) True "" in
              qt_cat3 body "\n" (prim_string_concat close "}")
          end
        end
    end;

def qr_dumps (j : Json) : String :=
    prim_string_concat(qr_pretty (add(mul 16 16, 1)) 0 j, "\n");

def qr_jstr (k : String) (v : String) : Pair String Json :=
    MkPair String Json k (JStr v);

def qr_jnum (k : String) (n : Nat) : Pair String Json :=
    MkPair String Json k (JNum (prim_string_of_nat n));

def qr_jbool (k : String) (b : Bool) : Pair String Json :=
    MkPair String Json k (JBool b);

def qr_jnull (k : String) : Pair String Json :=
    MkPair String Json k JNull;

def qr_jarr (k : String) (xs : List Json) : Pair String Json :=
    MkPair String Json k (JArr xs);

def qr_jobj (k : String) (xs : List (Pair String Json)) : Pair String Json :=
    MkPair String Json k (JObj xs);

def qr_maybe_str (k : String) (value : Maybe String) : Pair String Json :=
    match value with
    | Nothing => qr_jnull k
    | Just s => qr_jstr k s
    end;

def qr_str_items (xs : List String) : List Json :=
    map String Json JStr xs;
