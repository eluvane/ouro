-- Shared registry types, lookup, JSON row shaping, and code checks.
-- File IO stays in registry.ouro so Clippy core/scan can stay off std/io
-- and the Windows platform modules.

import "diagnostic.ouro";
import "../../std/json_types.ouro";
import "json_report.ouro";
import "../../std/collections.ouro";

inductive QrPlace : Type :=
  | MkQrPlace : String -> Nat -> Nat -> QrPlace;

def qr_place_path (p : QrPlace) : String :=
    match p with | MkQrPlace path _ _ => path end;

def qr_place_line (p : QrPlace) : Nat :=
    match p with | MkQrPlace _ line _ => line end;

def qr_place_col (p : QrPlace) : Nat :=
    match p with | MkQrPlace _ _ col => col end;

inductive QrDiag : Type :=
  | MkQrDiag : String -> List (Pair String String) -> String -> String
      -> String -> List String -> List String -> String -> String -> Bool
      -> QrDiag;

def qr_diag_code (d : QrDiag) : String :=
    match d with | MkQrDiag code _ _ _ _ _ _ _ _ _ => code end;

def qr_diag_levels (d : QrDiag) : List (Pair String String) :=
    match d with | MkQrDiag _ levels _ _ _ _ _ _ _ _ => levels end;

def qr_diag_title (d : QrDiag) : String :=
    match d with | MkQrDiag _ _ title _ _ _ _ _ _ _ => title end;

def qr_diag_rationale (d : QrDiag) : String :=
    match d with | MkQrDiag _ _ _ rationale _ _ _ _ _ _ => rationale end;

def qr_diag_replacement (d : QrDiag) : String :=
    match d with | MkQrDiag _ _ _ _ replacement _ _ _ _ _ => replacement end;

def qr_diag_docs (d : QrDiag) : List String :=
    match d with | MkQrDiag _ _ _ _ _ docs _ _ _ _ => docs end;

def qr_diag_fixtures (d : QrDiag) : List String :=
    match d with | MkQrDiag _ _ _ _ _ _ fixtures _ _ _ => fixtures end;

def qr_diag_analyzer (d : QrDiag) : String :=
    match d with | MkQrDiag _ _ _ _ _ _ _ analyzer _ _ => analyzer end;

def qr_diag_rule (d : QrDiag) : String :=
    match d with | MkQrDiag _ _ _ _ _ _ _ _ rule _ => rule end;

def qr_diag_suppressible (d : QrDiag) : Bool :=
    match d with | MkQrDiag _ _ _ _ _ _ _ _ _ flag => flag end;

inductive QrClippy : Type :=
  | MkQrClippy : String -> String -> String -> String -> String
      -> List (Pair String String) -> QrClippy;

def qr_clip_id (r : QrClippy) : String :=
    match r with | MkQrClippy rid _ _ _ _ _ => rid end;

def qr_clip_family (r : QrClippy) : String :=
    match r with | MkQrClippy _ family _ _ _ _ => family end;

def qr_clip_title (r : QrClippy) : String :=
    match r with | MkQrClippy _ _ title _ _ _ => title end;

def qr_clip_message (r : QrClippy) : String :=
    match r with | MkQrClippy _ _ _ message _ _ => message end;

def qr_clip_fix (r : QrClippy) : String :=
    match r with | MkQrClippy _ _ _ _ repl _ => repl end;

def qr_clip_levels (r : QrClippy) : List (Pair String String) :=
    match r with | MkQrClippy _ _ _ _ _ levels => levels end;

inductive QrFinding : Type :=
  | MkQrFinding : String -> String -> QrPlace -> String -> String
      -> String -> String -> String -> Maybe String -> QrFinding;

def qr_find_code (f : QrFinding) : String :=
    match f with | MkQrFinding code _ _ _ _ _ _ _ _ => code end;

def qr_find_level (f : QrFinding) : String :=
    match f with | MkQrFinding _ level _ _ _ _ _ _ _ => level end;

def qr_find_place (f : QrFinding) : QrPlace :=
    match f with | MkQrFinding _ _ place _ _ _ _ _ _ => place end;

def qr_find_message (f : QrFinding) : String :=
    match f with | MkQrFinding _ _ _ message _ _ _ _ _ => message end;

def qr_find_fix (f : QrFinding) : String :=
    match f with | MkQrFinding _ _ _ _ repl _ _ _ _ => repl end;

def qr_find_owner (f : QrFinding) : String :=
    match f with | MkQrFinding _ _ _ _ _ owner _ _ _ => owner end;

def qr_find_rule (f : QrFinding) : String :=
    match f with | MkQrFinding _ _ _ _ _ _ rule _ _ => rule end;

def qr_find_witness (f : QrFinding) : String :=
    match f with | MkQrFinding _ _ _ _ _ _ _ witness _ => witness end;

def qr_find_mark (f : QrFinding) : Maybe String :=
    match f with | MkQrFinding _ _ _ _ _ _ _ _ mark => mark end;

def qr_find_path (f : QrFinding) : String :=
    qr_place_path (qr_find_place f);

def qr_find_line (f : QrFinding) : Nat :=
    qr_place_line (qr_find_place f);

def qr_find_col (f : QrFinding) : Nat :=
    qr_place_col (qr_find_place f);

def qr_with_mark (f : QrFinding) (mark : Maybe String) : QrFinding :=
    MkQrFinding (qr_find_code f) (qr_find_level f) (qr_find_place f)
      (qr_find_message f) (qr_find_fix f) (qr_find_owner f) (qr_find_rule f)
      (qr_find_witness f) mark;

inductive QrIssue : Type :=
  | MkQrIssue : String -> String -> List String -> QrIssue;

def qr_issue_reason (i : QrIssue) : String :=
    match i with | MkQrIssue reason _ _ => reason end;

def qr_issue_path (i : QrIssue) : String :=
    match i with | MkQrIssue _ path _ => path end;

def qr_issue_codes (i : QrIssue) : List String :=
    match i with | MkQrIssue _ _ codes => codes end;

inductive QrDebt : Type :=
  | MkQrDebt : String -> String -> String -> List String -> Nat
      -> Maybe Nat -> String -> String -> String -> QrDebt;

def qr_debt_id (e : QrDebt) : String :=
    match e with | MkQrDebt eid _ _ _ _ _ _ _ _ => eid end;

def qr_debt_code (e : QrDebt) : String :=
    match e with | MkQrDebt _ code _ _ _ _ _ _ _ => code end;

def qr_debt_glob (e : QrDebt) : String :=
    match e with | MkQrDebt _ _ glob _ _ _ _ _ _ => glob end;

def qr_debt_profiles (e : QrDebt) : List String :=
    match e with | MkQrDebt _ _ _ profiles _ _ _ _ _ => profiles end;

inductive QrConfig : Type :=
  | MkQrConfig : List String -> List String -> List QrDiag
      -> List (Pair String QrDiag) -> List String -> Json -> QrConfig;

def qr_cfg_profiles (c : QrConfig) : List String :=
    match c with | MkQrConfig profiles _ _ _ _ _ => profiles end;

def qr_cfg_levels (c : QrConfig) : List String :=
    match c with | MkQrConfig _ levels _ _ _ _ => levels end;

def qr_cfg_diags (c : QrConfig) : List QrDiag :=
    match c with | MkQrConfig _ _ diags _ _ _ => diags end;

def qr_cfg_map (c : QrConfig) : List (Pair String QrDiag) :=
    match c with | MkQrConfig _ _ _ mp _ _ => mp end;

def qr_cfg_scopes (c : QrConfig) : List String :=
    match c with | MkQrConfig _ _ _ _ scopes _ => scopes end;

def qr_cfg_semantics (c : QrConfig) : Json :=
    match c with | MkQrConfig _ _ _ _ _ sem => sem end;

def qr_lookup_diag (mp : List (Pair String QrDiag)) (code : String) : Maybe QrDiag :=
    lookup String QrDiag prim_string_eq code mp;

def qr_lookup_clip (mp : List (Pair String QrClippy)) (code : String) : Maybe QrClippy :=
    lookup String QrClippy prim_string_eq code mp;

def qr_norm_path (path : String) : String :=
    prim_string_replace path "\\" "/";

def qr_rel (root : String) (path : String) : String :=
    let a : String := qr_norm_path root in
    let b : String := qr_norm_path path in
    match prim_string_eq a b with
    | True => b
    | False =>
        let prefix : String := prim_string_concat a "/" in
        match prim_string_starts b prefix with
        | True => prim_string_slice b (prim_string_length prefix)
            (sub (prim_string_length b) (prim_string_length prefix))
        | False => b
        end
    end;

def qr_child (root : String) (rel : String) : String :=
    match prim_string_length root with
    | Z => rel
    | S _ => prim_string_concat root (prim_string_concat "/" rel)
    end;

def qr_level_ok (name : String) : Bool :=
    elem String prim_string_eq name ["allow", "warn", "deny", "forbid"];

def qr_clip_level_ok (name : String) : Bool :=
    elem String prim_string_eq name ["allow", "info", "warn", "deny", "fatal"];

def qr_assoc_get (xs : List (Pair String String)) (k : String) : Maybe String :=
    lookup String String prim_string_eq k xs;

def qr_assoc_or (xs : List (Pair String String)) (k : String) (fallback : String) : String :=
    match qr_assoc_get xs k with
    | Nothing => fallback
    | Just v => v
    end;

def qr_profile_level (mp : List (Pair String QrDiag)) (code : String) (profile : String) : String :=
    match qr_lookup_diag mp code with
    | Nothing => "deny"
    | Just item =>
        let levels : List (Pair String String) := qr_diag_levels item in
        let raw : String := match qr_assoc_get levels profile with
          | Just v => v
          | Nothing => qr_assoc_or levels "project" "warn"
          end in
        match qr_level_ok raw with
        | True => raw
        | False => "deny"
        end
    end;

def qr_clip_level (mp : List (Pair String QrClippy)) (code : String) (profile : String) : String :=
    match qr_lookup_clip mp code with
    | Nothing => "warn"
    | Just item =>
        let levels : List (Pair String String) := qr_clip_levels item in
        match qr_assoc_get levels profile with
        | Just v => v
        | Nothing => qr_assoc_or levels "project" "warn"
        end
    end;

def qr_strict_rank (level : String) : Nat :=
    match prim_string_eq level "allow" with
    | True => 0
    | False => match prim_string_eq level "warn" with
      | True => 1
      | False => match prim_string_eq level "deny" with
        | True => 2
        | False => match prim_string_eq level "forbid" with
          | True => 3
          | False => 2
          end
        end
      end
    end;

def qr_clip_rank (level : String) : Nat :=
    match prim_string_eq level "allow" with
    | True => 0
    | False => match prim_string_eq level "info" with
      | True => 1
      | False => match prim_string_eq level "warn" with
        | True => 2
        | False => match prim_string_eq level "deny" with
          | True => 3
          | False => match prim_string_eq level "fatal" with
            | True => 4
            | False => 3
            end
          end
        end
      end
    end;

def qr_strict_blocks (f : QrFinding) : Bool :=
    match qr_find_mark f with
    | Just _ => False
    | Nothing => leb_nat 2 (qr_strict_rank (qr_find_level f))
    end;

def qr_clip_blocks (f : QrFinding) : Bool :=
    match prim_string_eq (qr_find_level f) "fatal" with
    | True => True
    | False => match qr_find_mark f with
      | Just _ => False
      | Nothing => leb_nat 3 (qr_clip_rank (qr_find_level f))
      end
    end;

def qr_lower_code (code : String) : String :=
    qt_to_lower code;

def qr_mk_finding (mp : List (Pair String QrDiag)) (profile : String) (code : String)
    (place : QrPlace) (message : String) (witness : String) : QrFinding :=
    match qr_lookup_diag mp code with
    | Nothing =>
        MkQrFinding code (qr_profile_level mp code profile) place message
          "Apply the documented replacement." "quality" (qr_lower_code code)
          witness (Nothing String)
    | Just item =>
        let replacement : String := match prim_string_length (qr_diag_replacement item) with
          | Z => "Apply the documented replacement."
          | S _ => qr_diag_replacement item
          end in
        let analyzer : String := match prim_string_length (qr_diag_analyzer item) with
          | Z => "quality"
          | S _ => qr_diag_analyzer item
          end in
        let rule : String := match prim_string_length (qr_diag_rule item) with
          | Z => qr_lower_code code
          | S _ => qr_diag_rule item
          end in
        MkQrFinding code (qr_profile_level mp code profile) place message
          replacement analyzer rule witness (Nothing String)
    end;

def qr_mk_clip (mp : List (Pair String QrClippy)) (profile : String) (code : String)
    (place : QrPlace) (witness : String) (suffix : String) : QrFinding :=
    match qr_lookup_clip mp code with
    | Nothing =>
        MkQrFinding code "warn" place code "" "clippy" code (qt_strip witness)
          (Nothing String)
    | Just item =>
        let message : String := match prim_string_length suffix with
          | Z => qr_clip_message item
          | S _ => prim_string_concat (qr_clip_message item)
              (prim_string_concat " " suffix)
          end in
        MkQrFinding code (qr_clip_level mp code profile) place message
          (qr_clip_fix item) (qr_clip_family item) (qr_clip_title item)
          (qt_strip witness) (Nothing String)
    end;

def qr_string_list (xs : List Json) : List String :=
    reverse_lin String
      ((fix go (ys : List Json) (acc : List String) : List String :=
        match ys with
        | Nil => acc
        | Cons j rest => match qr_as_str j with
          | Nothing => go rest acc
          | Just s => go rest (Cons String s acc)
          end
        end) xs []);

def qr_level_pairs (j : Json) : List (Pair String String) :=
    reverse_lin (Pair String String)
      ((fix go (xs : List (Pair String Json)) (acc : List (Pair String String))
          : List (Pair String String) :=
        match xs with
        | Nil => acc
        | Cons pair rest => match pair with
          | MkPair k v => match qr_as_str v with
            | Nothing => go rest acc
            | Just s => go rest (Cons (Pair String String)
                (MkPair String String k s) acc)
            end
          end
        end) (qr_pairs j) []);

def qr_load_diag (item : Json) : Maybe QrDiag :=
    match qr_as_str (qr_get_or item "code" JNull) with
    | Nothing => Nothing QrDiag
    | Just code =>
        Just QrDiag
          (MkQrDiag code (qr_level_pairs (qr_obj item "levels"))
            (qr_str_or item "title" "")
            (qr_str_or item "rationale" "")
            (qr_str_or item "replacement" "")
            (qr_string_list (qr_arr item "docs"))
            (qr_string_list (qr_arr item "fixtures"))
            (qr_str_or item "analyzer" "")
            (qr_str_or item "rule" "")
            (qr_bool_or item "suppressible" False))
    end;

def qr_load_diags (items : List Json) : Pair (List QrDiag) (List (Pair String QrDiag)) :=
    (fix go (xs : List Json) (rev : List QrDiag) (mp : List (Pair String QrDiag))
        : Pair (List QrDiag) (List (Pair String QrDiag)) :=
      match xs with
      | Nil => MkPair (List QrDiag) (List (Pair String QrDiag))
          (reverse_lin QrDiag rev) (reverse_lin (Pair String QrDiag) mp)
      | Cons item rest => match qr_load_diag item with
        | Nothing => go rest rev mp
        | Just d => go rest (Cons QrDiag d rev)
            (Cons (Pair String QrDiag)
              (MkPair String QrDiag (qr_diag_code d) d) mp)
        end
      end) items [] [];

def qr_default_scopes : List String :=
    ["std", "compiler", "tools/analyze", "tools", "samples"];

def qr_load_config (root : Json) : QrConfig :=
    let loaded : Pair (List QrDiag) (List (Pair String QrDiag)) :=
      qr_load_diags (qr_arr root "diagnostics") in
    match loaded with
    | MkPair diags mp =>
        let scopes : List String := qr_string_list (qr_arr root "project_scopes") in
        MkQrConfig (qr_string_list (qr_arr root "profiles"))
          (qr_string_list (qr_arr root "levels")) diags mp
          (match scopes with | Nil => qr_default_scopes | Cons _ _ => scopes end)
          (qr_get_or root "profile_semantics" JNull)
    end;

def qr_load_clip_rule (item : Json) : Maybe QrClippy :=
    match qr_as_str (qr_get_or item "id" JNull) with
    | Nothing => Nothing QrClippy
    | Just rid => match prim_string_length rid with
      | Z => Nothing QrClippy
      | S _ => Just QrClippy
          (MkQrClippy rid (qr_str_or item "family" "")
            (qr_str_or item "title" "")
            (qr_str_or item "message" "")
            (qr_str_or item "fix" "")
            (qr_level_pairs (qr_obj item "levels")))
      end
    end;

def qr_load_clip_rules (items : List Json) : List (Pair String QrClippy) :=
    reverse_lin (Pair String QrClippy)
      ((fix go (xs : List Json) (acc : List (Pair String QrClippy))
          : List (Pair String QrClippy) :=
        match xs with
        | Nil => acc
        | Cons item rest => match qr_load_clip_rule item with
          | Nothing => go rest acc
          | Just rule => go rest (Cons (Pair String QrClippy)
              (MkPair String QrClippy (qr_clip_id rule) rule) acc)
          end
        end) items []);

def qr_fnmatch (name : String) (pat : String) : Bool :=
    (fix go (fuel : Nat) (n : String) (p : String) : Bool :=
      match fuel with
      | Z => False
      | S fuel2 =>
          let nlen : Nat := prim_string_length n in
          let plen : Nat := prim_string_length p in
          match plen with
          | Z => eq_nat nlen 0
          | S prest =>
              let pc : Nat := prim_string_byte_at p 0 in
              match eq_nat pc 42 with
              | True =>
                  orb (go fuel2 n (prim_string_slice p 1 prest))
                    (match nlen with
                     | Z => False
                     | S nrest => go fuel2 (prim_string_slice n 1 nrest) p
                     end)
              | False => match nlen with
                | Z => False
                | S nrest =>
                    let ok : Bool := match eq_nat pc 63 with
                      | True => True
                      | False => eq_nat pc (prim_string_byte_at n 0)
                      end in
                    match ok with
                    | True => go fuel2 (prim_string_slice n 1 nrest)
                        (prim_string_slice p 1 prest)
                    | False => False
                    end
                end
              end
          end
      end) (add (add (prim_string_length name) (prim_string_length pat)) 2)
      name pat;

def qr_parse_nat_field (j : Json) (k : String) : Maybe Nat :=
    match qr_get j k with
    | Nothing => Nothing Nat
    | Just v => match v with
      | JNum s => qt_parse_nat s
      | JNull => Nothing Nat
      | JBool _ => Nothing Nat
      | JStr s => qt_parse_nat s
      | JArr _ => Nothing Nat
      | JObj _ => Nothing Nat
      end
    end;

def qr_load_debt_entry (item : Json) (idx : Nat) : QrDebt :=
    let eid : String := match qr_as_str (qr_get_or item "id" JNull) with
      | Just s => s
      | Nothing => prim_string_concat "debt[" (prim_string_concat
          (prim_string_of_nat idx) "]")
      end in
    let minc : Maybe Nat := match qr_get item "min_count" with
      | Nothing => qr_parse_nat_field item "max_count"
      | Just _ => qr_parse_nat_field item "min_count"
      end in
    MkQrDebt eid (qr_str_or item "code" "") (qr_str_or item "path_glob" "")
      (match qr_string_list (qr_arr item "profiles") with
       | Nil => ["project", "strict", "compiler", "release"]
       | Cons h t => Cons String h t
       end)
      (match qr_parse_nat_field item "max_count" with
       | Nothing => 0
       | Just n => n
       end)
      minc (qr_str_or item "reason" "") (qr_str_or item "replacement" "")
      (qr_str_or item "tracking" "");

def qr_load_debt_entries (items : List Json) : List QrDebt :=
    reverse_lin QrDebt
      ((fix go (xs : List Json) (idx : Nat) (acc : List QrDebt) : List QrDebt :=
        match xs with
        | Nil => acc
        | Cons item rest => go rest (add idx 1)
            (Cons QrDebt (qr_load_debt_entry item idx) acc)
        end) items 0 []);

def qr_debt_hit (e : QrDebt) (f : QrFinding) (profile : String) : Bool :=
    match prim_string_eq (qr_find_code f) (qr_debt_code e) with
    | False => False
    | True => match qr_fnmatch (qr_find_path f) (qr_debt_glob e) with
      | False => False
      | True => elem String prim_string_eq profile (qr_debt_profiles e)
      end
    end;

def qr_inc_at (xs : List Nat) (idx : Nat) : List Nat :=
    reverse_lin Nat
      ((fix go (ys : List Nat) (i : Nat) (acc : List Nat) : List Nat :=
        match ys with
        | Nil => acc
        | Cons n rest =>
            let v : Nat := match eq_nat i idx with
              | True => add n 1
              | False => n
              end in
            go rest (add i 1) (Cons Nat v acc)
        end) xs 0 []);

def qr_apply_debt (findings : List QrFinding) (entries : List QrDebt) (profile : String)
    : Pair (List QrFinding) (List Nat) :=
    let zeros : List Nat := map QrDebt Nat (fun (_ : QrDebt) => 0) entries in
    (fix go (fs : List QrFinding) (usage : List Nat) (rev : List QrFinding)
        : Pair (List QrFinding) (List Nat) :=
      match fs with
      | Nil => MkPair (List QrFinding) (List Nat)
          (reverse_lin QrFinding rev) usage
      | Cons f rest =>
          (fix search (es : List QrDebt) (idx : Nat) : Pair (List QrFinding) (List Nat) :=
            match es with
            | Nil => go rest usage (Cons QrFinding f rev)
            | Cons e more => match qr_debt_hit e f profile with
              | True => go rest (qr_inc_at usage idx)
                  (Cons QrFinding (qr_with_mark f (Just String (qr_debt_id e))) rev)
              | False => search more (add idx 1)
              end
            end) entries 0
      end) findings zeros [];

def qr_finding_le (a : QrFinding) (b : QrFinding) : Bool :=
    match prim_string_eq (qr_find_path a) (qr_find_path b) with
    | False => prim_string_le (qr_find_path a) (qr_find_path b)
    | True => match eq_nat (qr_find_line a) (qr_find_line b) with
      | False => leb_nat (qr_find_line a) (qr_find_line b)
      | True => match eq_nat (qr_find_col a) (qr_find_col b) with
        | False => leb_nat (qr_find_col a) (qr_find_col b)
        | True => prim_string_le (qr_find_code a) (qr_find_code b)
        end
      end
    end;

def qr_sort_findings (xs : List QrFinding) : List QrFinding :=
    quality_sort QrFinding qr_finding_le xs;

def qr_finding_json (f : QrFinding) (blocking : Bool) (mark_key : String) : Json :=
    JObj
      [ qr_maybe_str mark_key (qr_find_mark f)
      , qr_jstr "analyzer" (qr_find_owner f)
      , qr_jbool "blocking" blocking
      , qr_jstr "code" (qr_find_code f)
      , qr_jnum "column" (qr_find_col f)
      , qr_jstr "level" (qr_find_level f)
      , qr_jnum "line" (qr_find_line f)
      , qr_jstr "message" (qr_find_message f)
      , qr_jstr "path" (qr_find_path f)
      , qr_jstr "replacement" (qr_find_fix f)
      , qr_jstr "rule" (qr_find_rule f)
      , qr_jstr "witness" (qr_find_witness f)
      ];

def qr_clip_finding_json (f : QrFinding) : Json :=
    JObj
      [ qr_jnum "column" (qr_find_col f)
      , qr_jstr "family" (qr_find_owner f)
      , qr_jstr "fix" (qr_find_fix f)
      , qr_jnum "line" (qr_find_line f)
      , qr_jstr "message" (qr_find_message f)
      , qr_jstr "path" (qr_find_path f)
      , qr_jstr "rule_id" (qr_find_code f)
      , qr_jstr "severity" (qr_find_level f)
      , qr_maybe_str "suppressed_by" (qr_find_mark f)
      , qr_jstr "title" (qr_find_rule f)
      , qr_jstr "witness" (qr_find_witness f)
      ];

def qr_issue_json (i : QrIssue) : Json :=
    let base : List (Pair String Json) :=
      [ qr_jstr "path" (qr_issue_path i)
      , qr_jstr "reason" (qr_issue_reason i)
      ] in
    match qr_issue_codes i with
    | Nil => JObj base
    | Cons _ _ => JObj (Cons (Pair String Json)
        (qr_jarr "codes" (qr_str_items (qr_issue_codes i))) base)
    end;

def qr_count_mark (xs : List QrFinding) : Nat :=
    length QrFinding
      (filter QrFinding (fun (f : QrFinding) =>
        match qr_find_mark f with | Nothing => False | Just _ => True end) xs);

def qr_visible (xs : List QrFinding) : List QrFinding :=
    filter QrFinding (fun (f : QrFinding) =>
      match qr_find_mark f with | Nothing => True | Just _ => False end) xs;

def qr_text_finding (f : QrFinding) : String :=
    let place : QrPlace := qr_find_place f in
    let loc : QualityLocation :=
      MkQualityLocation (qr_place_path place) (qr_place_line place)
        (qr_place_col place) in
    let rule : QualityRule :=
      MkQualityRule (qr_find_code f) (qr_find_owner f) (qr_find_rule f) in
    let advice : QualityAdvice :=
      MkQualityAdvice (qr_find_message f) (qr_find_witness f) (qr_find_fix f)
        QualityNoEdit [] in
    let level : QualityLevel := match quality_legacy_level (qr_find_level f) with
      | Just lv => lv
      | Nothing => QualityDeny
      end in
    let d : QualityDiagnostic :=
      MkQualityDiagnostic rule level loc advice False in
    quality_text_head (qr_find_level f) d;

def qr_print_finding_lines (f : QrFinding) (fix_label : String) : List String :=
    let head : String := qr_text_finding f in
    let fixl : String := prim_string_concat "  " (prim_string_concat fix_label
      (prim_string_concat ": " (qr_find_fix f))) in
    match prim_string_length (qr_find_witness f) with
    | Z => [head, fixl]
    | S _ => [head, fixl, prim_string_concat "  witness: " (qr_find_witness f)]
    end;

def qr_sarif_region (f : QrFinding) : Json :=
    JObj [qr_jnum "startColumn" (qr_find_col f), qr_jnum "startLine" (qr_find_line f)];

def qr_sarif_location (f : QrFinding) : Json :=
    JObj
      [ qr_jobj "physicalLocation"
          [ qr_jobj "artifactLocation" [qr_jstr "uri" (qr_find_path f)]
          , qr_jobj "region" (qr_pairs (qr_sarif_region f))
          ]
      ];

def qr_sarif_result (f : QrFinding) (error : Bool) (tail : String) : Json :=
    let level : String := match error with
      | True => "error"
      | False => "warning"
      end in
    JObj
      [ qr_jstr "level" level
      , qr_jarr "locations" [qr_sarif_location f]
      , qr_jobj "message" [qr_jstr "text" (prim_string_concat (qr_find_message f) tail)]
      , qr_jstr "ruleId" (qr_find_code f)
      ];

def qr_strict_sarif_rule (mp : List (Pair String QrDiag)) (code : String) : Json :=
    match qr_lookup_diag mp code with
    | Nothing =>
        JObj
          [ qr_jobj "help" [qr_jstr "text" "Apply the documented replacement."]
          , qr_jstr "id" code
          , qr_jstr "name" code
          , qr_jobj "shortDescription" [qr_jstr "text" code]
          ]
    | Just item =>
        let help : String := match prim_string_length (qr_diag_replacement item) with
          | Z => "Apply the documented replacement."
          | S _ => qr_diag_replacement item
          end in
        let name : String := match prim_string_length (qr_diag_rule item) with
          | Z => code
          | S _ => qr_diag_rule item
          end in
        let title : String := match prim_string_length (qr_diag_title item) with
          | Z => code
          | S _ => qr_diag_title item
          end in
        JObj
          [ qr_jobj "help" [qr_jstr "text" help]
          , qr_jstr "id" code
          , qr_jstr "name" name
          , qr_jobj "shortDescription" [qr_jstr "text" title]
          ]
    end;

def qr_unique_codes (xs : List String) : List String :=
    dedup_adjacent String prim_string_eq (quality_sort String prim_string_le xs);

def qr_fixture_codes (diags : List QrDiag) : List String :=
    qr_unique_codes
      (filter_map QrDiag String (fun (d : QrDiag) =>
        match qr_diag_fixtures d with
        | Nil => Nothing String
        | Cons _ _ => Just String (qr_diag_code d)
        end) diags);

def qr_finding_codes (xs : List QrFinding) : List String :=
    qr_unique_codes (map QrFinding String qr_find_code xs);

def qr_union_codes (a : List String) (b : List String) : List String :=
    qr_unique_codes (append String a b);

def qr_migration_status (f : QrFinding) : String :=
    match qr_find_mark f with
    | Just _ => "debt"
    | Nothing => match qr_strict_blocks f with
      | True => "blocking"
      | False => "nonblocking"
      end
    end;

def qr_migration_lines (findings : List QrFinding) : List String :=
    let head : List String :=
      [ "# Ouro strict-quality migration report"
      , ""
      , "This report is deterministic: path, line, code, current level, replacement."
      , ""
      ] in
    match findings with
    | Nil => append String head
        ["No strict-quality findings in the selected production scope."]
    | Cons _ _ =>
        append String head
          ((fix go (xs : List QrFinding) (acc : List String) : List String :=
            match xs with
            | Nil => reverse_lin String acc
            | Cons f rest =>
                let loc : String := qt_cat4 (qr_find_path f) ":"
                  (prim_string_of_nat (qr_find_line f))
                  (prim_string_concat ":" (prim_string_of_nat (qr_find_col f))) in
                let bullet : String := qt_cat4 "- `" loc "` `"
                  (qt_cat4 (qr_find_code f) "` `" (qr_find_level f) "` ") in
                let line1 : String := qt_cat3 bullet (qr_migration_status f)
                  (prim_string_concat ": " (qr_find_message f)) in
                let line2 : String := prim_string_concat "  - replacement: "
                  (qr_find_fix f) in
                let acc2 : List String := match qr_find_mark f with
                  | Nothing => Cons String line2 (Cons String line1 acc)
                  | Just mark => Cons String
                      (prim_string_concat "  - debt: `"
                        (prim_string_concat mark "`"))
                      (Cons String line2 (Cons String line1 acc))
                  end in
                go rest acc2
            end) findings [])
    end;

def qr_expected_profiles : List String :=
    ["baseline", "project", "strict", "compiler", "release"];

def qr_expected_levels : List String :=
    ["allow", "warn", "deny", "forbid"];

def qr_list_eq (a : List String) (b : List String) : Bool :=
    (fix go (xs : List String) (ys : List String) : Bool :=
      match xs with
      | Nil => match ys with | Nil => True | Cons _ _ => False end
      | Cons x xr => match ys with
        | Nil => False
        | Cons y yr => match prim_string_eq x y with
          | False => False
          | True => go xr yr
          end
        end
      end) a b;

def qr_is_az (c : Nat) : Bool :=
    andb (leb_nat 65 c) (leb_nat c 90);

def qr_is_digit (c : Nat) : Bool :=
    andb (leb_nat 48 c) (leb_nat c 57);

def qr_code_suffix_ok (rest : String) : Bool :=
    let len : Nat := prim_string_length rest in
    match ltb_nat len 4 with
    | True => False
    | False =>
        (fix go (fuel : Nat) (i : Nat) : Bool :=
          match fuel with
          | Z => False
          | S fuel2 => match eq_nat i len with
            | True => False
            | False =>
                let c : Nat := prim_string_byte_at rest i in
                match qr_is_az c with
                | True => go fuel2 (add i 1)
                | False => match qr_is_digit c with
                  | False => False
                  | True =>
                      match eq_nat (sub len i) 3 with
                      | False => False
                      | True => qt_chars_all qr_is_digit
                          (prim_string_slice rest i (sub len i))
                      end
                  end
                end
            end
          end) (add len 1) 0
    end;

def qr_code_ok (code : String) : Bool :=
    match prim_string_starts code "OURO-" with
    | False => False
    | True => qr_code_suffix_ok (qt_drop_prefix code "OURO-")
    end;

def qr_clip_id_ok (code : String) : Bool :=
    match prim_string_starts code "OURO-CLIPPY-" with
    | False => False
    | True =>
        let rest : String := qt_drop_prefix code "OURO-CLIPPY-" in
        match qt_find rest "-" with
        | Nothing => False
        | Just dash =>
            let fam : String := prim_string_slice rest 0 dash in
            let num : String := prim_string_slice rest (add dash 1)
              (sub (prim_string_length rest) (add dash 1)) in
            match andb (ltb_nat 0 (prim_string_length fam)) (eq_nat (prim_string_length num) 3) with
            | False => False
            | True =>
                andb (qt_chars_all qr_is_az fam)
                  (qt_chars_all qr_is_digit num)
            end
        end
    end;

def qr_is_abs (p : String) : Bool :=
    orb (prim_string_starts p "/")
      (andb (ltb_nat 1 (prim_string_length p))
        (prim_string_eq (prim_string_slice p 1 1) ":"));

def qr_resolve (root : String) (value : String) : String :=
    match qr_is_abs value with
    | True => qr_norm_path value
    | False => qr_child root value
    end;
