-- Shared ASCII whitespace contract used by quality scanners and the structural lexer.
import "../../std/string_prims.ouro";
import "../../std/natx.ouro";

def byte_is_space (c : Nat) : Bool :=
    orb (orb (eq_nat c 32) (orb (eq_nat c 9) (orb (eq_nat c 10) (eq_nat c 13))))
      (orb (orb (eq_nat c 11) (eq_nat c 12))
        (orb (orb (eq_nat c 28) (eq_nat c 29)) (orb (eq_nat c 30) (eq_nat c 31))));

def byte_skip_space (s : String) : Nat -> Nat -> Nat :=
    fix skip (fuel : Nat) (p : Nat) : Nat :=
      match fuel with
      | Z => p
      | S fuel2 => match ltb_nat p (prim_string_length s) with
        | False => p
        | True => match byte_is_space (prim_string_byte_at s p) with
          | True => skip fuel2 (add p 1)
          | False => p
          end
        end
      end;
