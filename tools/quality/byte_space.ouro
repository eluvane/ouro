-- Shared byte classification used by quality scanners and the structural lexer.
import "../../std/string_prims.ouro",
  "../../std/char.ouro";

def byte_is_space : Nat -> Bool :=
    let vertical_tab : Nat := 11 in
    let form_feed : Nat := 12 in
    let file_separator : Nat := 28 in
    let group_separator : Nat := 29 in
    let record_separator : Nat := 30 in
    let unit_separator : Nat := 31 in
    fun (c : Nat) => if is_ws c then True
      else
        orb (orb(eq_nat c vertical_tab, eq_nat c form_feed))
          (orb(orb(eq_nat c file_separator, eq_nat c group_separator),
            orb(eq_nat c record_separator, eq_nat c unit_separator)));

def byte_skip_space (s : String) : Nat -> Nat -> Nat :=
    fix skip (fuel : Nat) (p : Nat) : Nat :=
      match fuel with
      | Z => p
      | S fuel2 => if ltb_nat(p, prim_string_length s) then
          if byte_is_space (prim_string_byte_at s p) then skip(fuel2, add p 1) else p
        else p
      end;

-- Expected UTF-8 sequence length from the lead byte; 0 means the byte can
-- never start a sequence (lone continuation, overlong C0/C1, F5 and above).
def byte_utf8_width (lead : Nat) : Nat :=
    if ltb_nat lead 128 then 1
    else
      if andb(leb_nat 194 lead, leb_nat lead 223) then 2
      else
        if andb(leb_nat 224 lead, leb_nat lead 239) then 3
        else if andb(leb_nat 240 lead, leb_nat lead 244) then 4 else 0;
