-- Typed quality input failures. This leaf stays off std/io, platform, and
-- JSON so compiler-frontend Clippy units can report inventory errors without
-- pulling the reporting cone.

import "../../std/string_prims.ouro";

inductive QualityInputError : Type :=
  | QualityInvalidInput : String -> QualityInputError
  | QualityExpectedFile : String -> QualityInputError
  | QualityUnreadableDirectory : String -> QualityInputError
  | QualityWalkExhausted : String -> QualityInputError
  | QualityImportExhausted : String -> QualityInputError
  | QualityNoSources : QualityInputError;

def quality_input_message (e : QualityInputError) : String :=
    match e with
    | QualityInvalidInput path =>
        prim_string_concat "missing or unsafe quality input: " path
    | QualityExpectedFile path =>
        prim_string_concat "expected a regular quality source file: " path
    | QualityUnreadableDirectory path =>
        prim_string_concat "cannot enumerate quality directory: " path
    | QualityWalkExhausted path =>
        prim_string_concat "quality inventory budget exhausted before: " path
    | QualityImportExhausted path =>
        prim_string_concat "quality import budget exhausted before: " path
    | QualityNoSources => "quality scope contains no selected source files"
    end;
