import "../../std/listx.ouro", "../../std/string_prims.ouro";

private inductive PathQueueData : Type :=
  | MkPathQueue : List String -> List String -> PathQueueData;

def PathQueue : Type := PathQueueData;

def path_queue_from (paths : List String) : PathQueue := MkPathQueue paths [];

def path_queue_empty (queue : PathQueue) : Bool :=
    let (MkPathQueue front back) := queue in
    andb (nullb String front) (nullb String back);

-- Traversal order is front followed by back in reverse order.
def path_queue_extend (queue : PathQueue) (paths : List String) : PathQueue :=
    match paths with
    | Nil => queue
    | Cons _ _ =>
        let (MkPathQueue front back) := queue in
        if andb (nullb String front) (nullb String back) then path_queue_from paths
        else MkPathQueue front (rev_append String paths back)
    end;

inductive PathQueueStep : Type :=
  | PathQueueEnd : PathQueueStep
  | PathQueueItem : String -> PathQueue -> PathQueueStep;

def path_queue_take (queue : PathQueue) : PathQueueStep :=
    let (MkPathQueue front back) := queue in
    match front with
    | Cons path rest => PathQueueItem path (MkPathQueue rest back)
    | Nil => match reverse_lin String back with
      | Nil => PathQueueEnd
      | Cons path rest => PathQueueItem path (path_queue_from rest)
      end
    end;
