import "../std/fs.ouro",
  "../std/natx.ouro",
  "../std/string.ouro";

private def selftest_fs_fail (prefix : String) (error : FsError) : IO Unit :=
    do eprintln (str_concat prefix (fs_error_message error));
       exit (S Z)

def selftest_fs_require (prefix : String) (action : IO (Either FsError Unit)) : IO Unit :=
    match! action with
    | Left error => selftest_fs_fail prefix error
    | Right _ => io_unit
    end

def selftest_fs_read (prefix : String) (path : String) : IO String :=
    match! fs_read_checked path with
    | Left error => do selftest_fs_fail prefix error;
                       io_pure String ""
    | Right text => io_pure String text
    end


def selftest_suite_exit (suite : String) (display_out : String) (rows : Nat)
    (failures : Nat) : IO Unit :=
    let count : String := prim_string_of_nat rows in
    if eq_nat failures Z then
      do println (str_cat3 suite ": PASS rows=" (str_cat3 count " out=" display_out));
         exit Z
    else
      do eprintln (str_cat3 suite ": FAIL rows="
           (str_cat3 count " failures=" (prim_string_of_nat failures)));
         exit (S Z)
