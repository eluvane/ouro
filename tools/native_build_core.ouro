-- Shared source loading, canonical checking and native output publication.
-- Command entry points own messages and exit status; this module returns errors.
import "../compiler/native/diagnostics.ouro";
import "../compiler/native/managed_stdio_compile.ouro";
import "../compiler/checked_program_output.ouro";
import "../std/io.ouro";
import "native_build_args.ouro";
import "native_build_output.ouro";
import "collect_core.ouro";

def native_build_doctor_text : String :=
    "ouro native-build\ntarget: x86_64-windows\nbackend: native\nlegacy-c: rejected\n";

def native_build_codes_eq : List Nat -> List Nat -> Bool :=
  fix go (left : List Nat) (right : List Nat) : Bool :=
    match left, right with
    | Nil, Nil => True
    | Cons x xs, Cons y ys => andb (eq_nat x y) (go xs ys)
    | Nil, Cons _ _ => False
    | Cons _ _, Nil => False
    end;

def native_build_str_eq (left : String) (right : String) : Bool :=
    native_build_codes_eq (prim_string_to_char_codes left)
      (prim_string_to_char_codes right);

def native_build_limits : MirLimits := native_compiler_limits;

def native_build_fuel : Nat := native_build_default_fuel;

def native_build_normalize_codes : List Nat -> List Nat :=
  fix go (cs : List Nat) : List Nat :=
    match cs with
    | Nil => ([] : List Nat)
    | Cons c rest =>
      Cons Nat
        (match eq_nat c native_build_backslash with
         | True => native_build_slash
         | False => c
         end)
        (go rest)
    end;

def native_build_normalize (path : String) : String :=
    prim_string_of_char_codes
      (native_build_normalize_codes (prim_string_to_char_codes path));

def NativeBuildFiles : Type := List (Pair (List Nat) (List Nat));

inductive NativeBuildFailure : Type :=
  | NativeBuildFilesystem : FsError -> NativeBuildFailure
  | NativeBuildCollection : String -> NativeBuildFailure
  | NativeBuildConfiguration : NativeBuildError -> NativeBuildFailure
  | NativeBuildSource : NativeSourceError -> NativeBuildFailure;

def native_build_error_message (error : NativeBuildFailure) : String :=
    match error with
    | NativeBuildFilesystem failure => fs_error_message failure
    | NativeBuildCollection message => message
    | NativeBuildConfiguration message => message
    | NativeBuildSource failure => managed_driver_source_error failure
    end;

-- NativeBuildRequest is a public constructor. Validate the backend and target
-- for direct core callers as well as for parsed command-line requests.
def native_build_validate_request (request : NativeBuildRequest) : Either NativeBuildFailure Unit :=
    match native_build_parse_backend (native_build_request_backend request) with
    | Left error => Left NativeBuildFailure Unit (NativeBuildConfiguration error)
    | Right _ => match native_build_parse_target (native_build_request_target request) with
      | Left error => Left NativeBuildFailure Unit (NativeBuildConfiguration error)
      | Right _ => Right NativeBuildFailure Unit MkUnit
      end
    end;

def native_build_read_files : List String -> IO (Either FsError (List (Pair (List Nat) (List Nat)))) :=
  fix read_files (paths : List String) : IO (Either FsError (List (Pair (List Nat) (List Nat)))) :=
    match paths with
    | Nil =>
        fs_ok (List (Pair (List Nat) (List Nat)))
          (Nil (Pair (List Nat) (List Nat)))
    | Cons path rest =>
        do let! source := fs_read_checked path;
           match source with
           | Left e => fs_err (List (Pair (List Nat) (List Nat))) e
           | Right text =>
               do let! remaining := read_files rest;
                  match remaining with
                  | Left e => fs_err (List (Pair (List Nat) (List Nat))) e
                  | Right tail =>
                      fs_ok (List (Pair (List Nat) (List Nat)))
                        (Cons (Pair (List Nat) (List Nat))
                          (MkPair (List Nat) (List Nat)
                            (prim_string_to_char_codes (native_build_normalize path))
                            (prim_string_to_char_codes text))
                          tail)
                  end
           end
    end;

def native_build_load_source (source : String)
    : IO (Either NativeBuildFailure (Pair String NativeBuildFiles)) :=
    let root : String := collect_path_normalize source in
    do let! collected := collect_walk collect_fuel (Nil String) (Nil String) root;
       match collected with
       | ColErr error => io_pure (Either NativeBuildFailure (Pair String NativeBuildFiles))
           (Left NativeBuildFailure (Pair String NativeBuildFiles) (NativeBuildCollection error))
       | ColOk units => match units with
         | Nil => io_pure (Either NativeBuildFailure (Pair String NativeBuildFiles))
             (Left NativeBuildFailure (Pair String NativeBuildFiles) (NativeBuildCollection "empty source closure"))
         | Cons _ _ =>
             do let! loaded := native_build_read_files units;
                match loaded with
                | Left error => io_pure (Either NativeBuildFailure (Pair String NativeBuildFiles))
                    (Left NativeBuildFailure (Pair String NativeBuildFiles) (NativeBuildFilesystem error))
                | Right files => io_pure (Either NativeBuildFailure (Pair String NativeBuildFiles))
                    (Right NativeBuildFailure (Pair String NativeBuildFiles) (MkPair String NativeBuildFiles root files))
                end
         end
       end

def native_build_check_files (fuel : Nat) (root : String) (files : NativeBuildFiles)
    : CompResult CheckedProgram :=
    compile_checked_units fuel (prim_string_to_char_codes (native_build_normalize root)) files;

def native_build_check_source (source : String) (fuel : Nat)
    : IO (Either NativeBuildFailure CheckedProgram) :=
    do let! loaded := native_build_load_source source;
       match loaded with
       | Left error => io_pure (Either NativeBuildFailure CheckedProgram)
           (Left NativeBuildFailure CheckedProgram error)
       | Right input => match input with
         | MkPair root files => match native_build_check_files fuel root files with
           | CErr error => io_pure (Either NativeBuildFailure CheckedProgram)
               (Left NativeBuildFailure CheckedProgram (NativeBuildSource (NativeSourceCheckError error)))
           | COk checked => io_pure (Either NativeBuildFailure CheckedProgram)
               (Right NativeBuildFailure CheckedProgram checked)
           end
         end
       end

def native_build_publish_image (output : String) (image : NativeImage)
    : IO (Either NativeBuildFailure Unit) :=
    match image with
    | NativeImageOf pe _ => match pe with
      | PeImageFile bytes _ =>
          do let! published := native_build_publish_checked output (prim_string_of_char_codes bytes);
             match published with
             | Left error => io_pure (Either NativeBuildFailure Unit)
                 (Left NativeBuildFailure Unit (NativeBuildFilesystem error))
             | Right _ => io_pure (Either NativeBuildFailure Unit) (Right NativeBuildFailure Unit MkUnit)
             end
      end
    end;

def native_build_compile_files (request : NativeBuildRequest) (root : String)
    (files : NativeBuildFiles) : IO (Either NativeBuildFailure Unit) :=
    match native_build_validate_request request with
    | Left error => io_pure (Either NativeBuildFailure Unit)
        (Left NativeBuildFailure Unit error)
    | Right _ => match native_compile_units_auto (native_build_request_fuel request) native_build_limits
        (prim_string_to_char_codes (native_build_request_entry request))
        (prim_string_to_char_codes (native_build_normalize root)) files with
      | Left error => io_pure (Either NativeBuildFailure Unit)
          (Left NativeBuildFailure Unit (NativeBuildSource error))
      | Right image => native_build_publish_image (native_build_request_out request) image
      end
    end;

def native_build_compile_units_checked (request : NativeBuildRequest) (paths : List String)
    : IO (Either NativeBuildFailure Unit) :=
    do let! loaded := native_build_read_files paths;
       match loaded with
       | Left error => io_pure (Either NativeBuildFailure Unit)
           (Left NativeBuildFailure Unit (NativeBuildFilesystem error))
       | Right files => native_build_compile_files request (native_build_request_source request) files
       end

def native_build_compile_checked (request : NativeBuildRequest)
    : IO (Either NativeBuildFailure Unit) :=
    do let! loaded := native_build_load_source (native_build_request_source request);
       match loaded with
       | Left error => io_pure (Either NativeBuildFailure Unit) (Left NativeBuildFailure Unit error)
       | Right input => match input with
         | MkPair root files => native_build_compile_files request root files
         end
       end

def native_build_dump_checked (fuel : Nat) (output : String) (checked : CheckedProgram)
    : IO (Either NativeBuildFailure Unit) :=
    match checked_program_dump fuel checked with
    | CErr error => io_pure (Either NativeBuildFailure Unit)
        (Left NativeBuildFailure Unit (NativeBuildSource (NativeSourceCheckError error)))
    | COk bytes =>
        do let! published := native_build_publish_checked output (prim_string_of_char_codes bytes);
           match published with
           | Left error => io_pure (Either NativeBuildFailure Unit)
               (Left NativeBuildFailure Unit (NativeBuildFilesystem error))
           | Right _ => io_pure (Either NativeBuildFailure Unit) (Right NativeBuildFailure Unit MkUnit)
           end
    end;
