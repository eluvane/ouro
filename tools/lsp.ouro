-- LSP IO shell: protocol decisions stay in model; this file owns stdio, subprocesses, and import reads.
-- Diagnostics run on open/change/save. Unsaved buffers are checked via a
-- private scratch with imports rewritten relative to the document.

-- @entry main

import "lsp_process_model.ouro",
  "native_sibling.ouro",
  "../std/io.ouro",
  "../std/natx.ouro",
  "quality/json_surface.ouro",
  "quality/path_queue.ouro",
  "../std/fs.ouro",
  "../std/pathx.ouro";

-- Read headers one byte at a time. A larger read can block past the
-- header terminator while it waits for body bytes.
def lsp_header_fuel : Nat := mul 64 64;

-- Full-sync messages may be larger than one retained source document because
-- JSON escaping and envelope fields add bytes.  Reject before asking the host
-- reader to allocate the body.
def lsp_max_frame_bytes : Nat := mul lsp_kib lsp_kib;

private def lsp_header_chunk_bytes : Nat := 64;

private def lsp_header_nul : String := str_of_codes [0];

def lsp_read_header (fuel : Nat) (prefix : String) : IO (Maybe String) :=
    -- A terminator may start in the previous chunk.
    let overlap : Nat := sub (str_len rpc_header_end) 1 in
    let chunk_room : Nat := sub lsp_header_chunk_bytes (S overlap) in
    (fix read (remaining : Nat) (tail : String) (room : Nat) (pieces : List String)
        : IO (Maybe String) :=
      match remaining with
      | Z => io_pure (Maybe String) (Nothing String)
      | S rest =>
          if str_ends tail rpc_header_end then
            match pieces with
            | Nil => io_pure (Maybe String) (Just String tail)
            | Cons _ _ => io_pure (Maybe String)
                (Just String (lsp_concat_runs (reverse_lin String (Cons String tail pieces))))
            end
          else
            do let! byte := prim_stdin_read_bytes (S Z);
               if str_null byte then io_pure (Maybe String) (Nothing String)
               else match room with
                 | S spare => read rest (str_concat tail byte) spare pieces
                 | Z =>
                     -- The C host stops suffix matching at NUL. Keep that byte in the tail.
                     if str_contains tail lsp_header_nul then
                       read rest (str_concat tail byte) Z pieces
                     else
                       let cut : Nat := sub (str_len tail) overlap in
                       read rest (str_concat (str_drop tail cut) byte) chunk_room
                         (Cons String (str_take tail cut) pieces)
               end
      end) fuel prefix (sub lsp_header_chunk_bytes (str_len prefix)) [];

-- Return a body only when the frame length is valid and every byte is read.
def lsp_read_message : IO (Maybe String) :=
    match! lsp_read_header lsp_header_fuel "" with
    | Nothing => io_pure(Maybe String, Nothing String)
    | Just h =>
        match rpc_content_len h with
        | Nothing => io_pure(Maybe String, Nothing String)
        | Just n =>
            if leb_nat n lsp_max_frame_bytes then
              do let! body := prim_stdin_read_bytes n;
                 if eq_nat(str_len body, n) then io_pure(Maybe String, Just String body)
                 else io_pure(Maybe String, Nothing String)
            else io_pure(Maybe String, Nothing String)
        end
    end

def lsp_send (j : Json) : IO Unit :=
    do print (rpc_send_json j);
       flush

def lsp_reply (msg : Json) (result : Json) : IO Unit :=
    if lsp_message_is_notification msg then io_unit else lsp_send (rpc_result(rpc_id msg, result));

def lsp_keep (st : Lsp) : IO (Pair Lsp Bool) :=
    io_pure(Pair Lsp Bool, MkPair Lsp Bool st True);

private def lsp_reply_keep (st : Lsp) (msg : Json) (result : Json) : IO (Pair Lsp Bool) :=
    do lsp_reply msg result;
       lsp_keep st

def lsp_stop (st : Lsp) : IO (Pair Lsp Bool) :=
    io_pure(Pair Lsp Bool, MkPair Lsp Bool st False);

-- OURO_ROOT is set by scripts/ouro1.sh and by the editor launcher after its
-- explicit trust check.  It is the authorization boundary; document URIs do
-- not get to enlarge it.
def lsp_workspace_root : IO String :=
    match! prim_env_get "OURO_ROOT" with
    | Nothing => io_pure String ""
    | Just path =>
        do let! kind := prim_fs_kind path;
           if eq_nat(kind, S (S Z)) then prim_fs_realpath path else io_pure String ""
    end

private def lsp_resolved_under (root : String) (path : String) : Bool :=
    andb (notb (str_null path)) (path_under root path);

def lsp_existing_file (root : String) (path : String) : IO (Maybe String) :=
    (if str_null root then io_pure(Maybe String, Nothing String)
    else
      do let! kind := prim_fs_kind path;
         if eq_nat(kind, S Z) then
           do let! resolved := prim_fs_realpath path;
              if lsp_resolved_under root resolved then
                io_pure(Maybe String, Just String resolved)
              else io_pure(Maybe String, Nothing String)
         else io_pure(Maybe String, Nothing String));

-- Unsaved new documents need not exist yet.  Their existing parent is
-- canonicalized, while existing files also reject final-component links and
-- reparse points through prim_fs_kind.
def lsp_document_path (root : String) (uri : String) : IO (Maybe String) :=
    match uri_file_path uri with
    | Nothing => io_pure(Maybe String, Nothing String)
    | Just path =>
        do let! kind := prim_fs_kind path;
           if eq_nat(kind, S Z) then lsp_existing_file root path
           else
             if eq_nat kind Z then
               do let! parent := prim_fs_realpath (path_dirname path);
                  if lsp_resolved_under root parent then
                    io_pure (Maybe String)
                      (Just(String, path_normalize path))
                  else io_pure(Maybe String, Nothing String)
             else io_pure(Maybe String, Nothing String)
    end;

-- Imports are relative to their owning document.  Absolute spellings are not
-- portable workspace dependencies, and every resolved target must be a
-- canonical regular file below the authorized root.
def lsp_import_path (root : String) (origin : String) (spelling : String)
    : IO (Maybe String) :=
    if orb(str_null spelling, path_is_abs spelling) then io_pure(Maybe String, Nothing String)
    else lsp_existing_file(root, path_resolve_from_file origin spelling);

def lsp_scratch (root : String) : IO String :=
    let requested : String := fs_child root "_build" in
    do let! kind := prim_fs_kind requested;
       (if eq_nat(kind, S (S Z)) then
         do let! dir := prim_fs_realpath requested;
            if lsp_resolved_under root dir then
              do let! scratch := prim_fs_temp_file_in dir;
                 if str_null scratch then io_pure String ""
                 else
                   do let! resolved := prim_fs_realpath scratch;
                      if lsp_resolved_under dir resolved then io_pure String resolved
                      else
                        do fs_remove scratch;
                           io_pure String ""
            else io_pure String ""
       else io_pure String "")

private def lsp_publish_diagnostic_rows (uri : String) (rows : List Json) : IO Unit :=
    lsp_send (rpc_notify "textDocument/publishDiagnostics" (publish_params uri rows));

private def lsp_run_checker (path : String) : IO (Either NativeSiblingError ProcResult) :=
    native_sibling_run lsp_check_process_limits "coil.exe" (native_sibling_check_args path);

private def lsp_publish_checked (uri : String) (path : String) (text : String)
    (result : Either NativeSiblingError ProcResult) : IO Unit :=
    lsp_publish_diagnostic_rows uri (lsp_diagnostics_utf16 text (lsp_process_diagnostics path result));

def lsp_clear (uri : String) : IO Unit :=
    lsp_publish_diagnostic_rows uri (Nil Json);

-- Diagnostics invoke the shipped checker after workspace path authorization.
def lsp_publish (root : String) (uri : String) (text : String) : IO Unit :=
    match! lsp_document_path root uri with
    | Nothing => lsp_clear uri
    | Just path =>
        do let! result := lsp_run_checker path;
           lsp_publish_checked uri path text result
    end

def lsp_rewrite_import_path (root : String) (origin : String) (token : FxTok)
    : IO String :=
    match lsp_import_spelling token with
    | Nothing => io_pure(String, fx_tok_text token)
    | Just spelling =>
        match! lsp_import_path root origin spelling with
        | Nothing => io_pure String
            "\"__ouro_lsp_rejected_import__.ouro\""
        | Just path =>
            io_pure String
              (gate_json_print (JStr (str_concat("../", path_relative root path))))
        end
    end

def lsp_rewrite_import_tokens (root : String) (origin : String) (text : String)
    (tokens : List FxTok) (cursor : Nat) : IO String :=
  (fix rewrite (pending : List FxTok) (start : Nat) (pieces : List String) : IO String :=
    match pending with
    | Nil =>
        let suffix : String := str_slice text start (sub(str_len text, start)) in
        match pieces with
        | Nil => io_pure String suffix
        | Cons _ _ => io_pure (String, str_concat (lsp_concat_runs (reverse_lin String pieces)) suffix)
        end
    | Cons token rest =>
        do let! rewritten := lsp_rewrite_import_path root origin token;
           let gap : String := str_slice text start (sub(fx_tok_start token, start)) in
           rewrite rest (fx_tok_end token) (Cons String rewritten (Cons String gap pieces))
    end) tokens cursor [];

def lsp_rewrite_imports (root : String) (origin : String) (text : String)
    : IO String :=
    lsp_rewrite_import_tokens root origin text (lsp_import_tokens text) Z

def lsp_write (path : String) (text : String) : IO Bool :=
    match! fs_write_checked path text with
    | Left e =>
        do eprintln (str_cat3 path ": " (fs_error_message e));
           io_pure Bool False
    | Right _ => io_pure Bool True
    end

def lsp_publish_buf_run (uri : String) (text : String) (scratch : String) : IO Unit :=
    do let! wrote := lsp_write scratch text;
       (if wrote then
         do let! result := lsp_run_checker scratch;
            fs_remove scratch;
            lsp_publish_checked uri scratch text result
       else
         do fs_remove scratch;
            lsp_publish_diagnostic_rows uri
              (lsp_process_diagnostic "TOOL_ERROR" "could not write checker scratch file"))

def lsp_publish_buf (root : String) (uri : String) (origin : String)
    (text : String) : IO Unit :=
    do let! scratch := lsp_scratch root;
       if str_null scratch then
         lsp_publish_diagnostic_rows uri
           (lsp_process_diagnostic "TOOL_ERROR" "could not create checker scratch file")
       else
         do let! rewritten := lsp_rewrite_imports root origin text;
            lsp_publish_buf_run uri rewritten scratch

def lsp_index_fuel : Nat := mul 64 64;

def lsp_read_text (path : String) : IO (Maybe String) :=
    match! fs_read_checked path with
    | Left e =>
        match e with
        | FsMissing _ => io_pure(Maybe String, Nothing String)
        | FsEmptyPath => io_pure(Maybe String, Nothing String)
        | FsExpectedFile _ => io_pure(Maybe String, Nothing String)
        | FsExpectedDirectory _ => io_pure(Maybe String, Nothing String)
        | FsOperationFailed _ _ =>
            do eprintln (str_cat3 path ": " (fs_error_message e));
               io_pure(Maybe String, Nothing String)
        end
    | Right text => io_pure(Maybe String, Just String text)
    end

def lsp_import_paths (root : String) (origin : String) : List String -> IO (List String) :=
  fix lsp_import_paths
      (spellings : List String) : IO (List String) :=
    match spellings with
    | Nil => io_pure(List String, Nil String)
    | Cons spelling rest =>
        do let! safe := lsp_import_path root origin spelling;
           let! more := lsp_import_paths rest;
           match safe with
           | Nothing => io_pure(List String, more)
           | Just path => io_pure(List String, Cons String path more)
           end
    end;

private def lsp_index_imports (root : String) (entry : LspModuleIndex) (seen : List String)
    : IO (List String) :=
    let (MkLspModuleIndex path _ _ imports) := entry in
    do let! authorized := lsp_import_paths root path imports;
       io_pure (List String,
         filter String (fun (p : String) => notb (str_set_mem p seen)) authorized);

def lsp_index_step (root : String) (entry : LspModuleIndex) (seen : List String)
    (pending : List String) : IO (List String) :=
    do let! more := lsp_index_imports root entry seen;
       io_pure (List String) (append String pending more);

private def lsp_add_symbol_group (symbols : List Sym) (groups : List (List Sym)) : List (List Sym) :=
    match symbols with
    | Nil => groups
    | Cons _ _ => Cons (List Sym) symbols groups
    end;

private def lsp_finish_index (groups : List (List Sym)) (entries : List LspModuleIndex)
    : IO (Pair (List Sym) (List LspModuleIndex)) :=
    io_pure(Pair (List Sym) (List LspModuleIndex),
      MkPair (List Sym) (List LspModuleIndex) (lsp_symbols_from_groups groups) entries);

private def lsp_index_walk (mode : LspIndexMode) (fuel : Nat) (root : String) (acc : List Sym)
    (seen : List String) (pending : List String) (cache : List LspModuleIndex)
    : IO (Pair (List Sym) (List LspModuleIndex)) :=
  (fix go (remaining : Nat) (groups : List (List Sym))
      (visited : List String) (pending_paths : PathQueue) (entries : List LspModuleIndex)
      : IO (Pair (List Sym) (List LspModuleIndex)) :=
    match remaining with
    | Z => lsp_finish_index groups entries
    | S next =>
        match path_queue_take pending_paths with
        | PathQueueEnd => lsp_finish_index groups entries
        | PathQueueItem path rest =>
            if str_set_mem path visited then go next groups visited rest entries
            else
              let seen_after : List String := Cons String path visited in
              match! lsp_read_text path with
              | Nothing => go next groups seen_after rest entries
              | Just text =>
                  let (MkPair entry next_cache) := lsp_module_index_for mode path text entries in
                  do let! more := lsp_index_imports root entry seen_after;
                     go next (lsp_add_symbol_group (lsp_module_symbols entry) groups)
                       seen_after (path_queue_extend rest more) next_cache
              end
        end
    end) fuel (lsp_add_symbol_group acc []) seen (path_queue_from pending) cache;

def lsp_index_go (remember : Bool) (fuel : Nat) (root : String) (acc : List Sym)
    (seen : List String) (pending : List String) (cache : List LspModuleIndex)
    : IO (Pair (List Sym) (List LspModuleIndex)) :=
    lsp_index_walk (if remember then LspIndexRemember else LspIndexUncached)
      fuel root acc seen pending cache;

private def lsp_index_cache (mode : LspIndexMode) (st : Lsp) : List LspModuleIndex :=
    match mode with
    | LspIndexUncached => []
    | LspIndexReuse => lsp_navigation_cache st
    | LspIndexRemember => lsp_navigation_cache st
    | LspIndexDocument _ => lsp_navigation_cache st
    end;

-- The open buffer is the source of truth for the document itself, so hover
-- works on unsaved edits; imported files are read from disk.
-- The caller authorizes the document path for this request.
private def lsp_index_at (mode : LspIndexMode) (st : Lsp) (path : String) (text : String)
    : IO (Pair (List Sym) (List LspModuleIndex)) :=
    let (MkPair entry next_cache) := lsp_module_index_for mode path text (lsp_index_cache mode st) in
    let seen : List String := [path] in
    do let! pending := lsp_index_imports (lsp_root st) entry seen;
       lsp_index_walk mode lsp_index_fuel (lsp_root st) (lsp_module_symbols entry)
         seen pending next_cache

private def lsp_index_with (mode : LspIndexMode) (st : Lsp) (uri : String)
    : IO (Pair (List Sym) (List LspModuleIndex)) :=
    match! lsp_document_path(lsp_root st, uri) with
    | Nothing =>
        let cache : List LspModuleIndex := lsp_index_cache mode st in
        io_pure(Pair (List Sym) (List LspModuleIndex),
          MkPair (List Sym) (List LspModuleIndex) (Nil Sym) cache)
    | Just path => lsp_index_at mode st path (lsp_text st uri)
    end

def lsp_index (st : Lsp) (uri : String) : IO (List Sym) :=
    do let! result := lsp_index_with LspIndexUncached st uri;
       let (MkPair symbols _) := result in
       io_pure (List Sym) symbols

def lsp_word_of (st : Lsp) (msg : Json) : String :=
    let params : Json := rpc_params msg in
    word_at (lsp_text(st, lsp_doc_uri params)) (lsp_pos_line params)
      (lsp_pos_char params);

def lsp_store_document (st : Lsp) (uri : String) (text : String)
    : IO (Pair Lsp Bool) :=
    match! lsp_document_path(lsp_root st, uri) with
    | Nothing =>
        do lsp_clear uri;
           lsp_keep st
    | Just origin =>
        match lsp_put_checked st uri text with
        | Nothing =>
            do lsp_clear uri;
               lsp_keep st
        | Just st2 =>
            do lsp_publish_buf (lsp_root st) uri origin text;
               lsp_keep st2
        end
    end

def on_did_open (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let params : Json := rpc_params msg in
    let uri : String := lsp_doc_uri params in
    let text : String :=
      json_field_str (json_field params "textDocument") "text" "" in
    lsp_store_document st uri text

-- Full sync: the first change carries the whole document.
def on_did_change (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let params : Json := rpc_params msg in
    let uri : String := lsp_doc_uri params in
    let changes : List Json := json_items (json_field params "contentChanges") in
    let text : String :=
      json_field_str(head Json JNull changes, "text", lsp_text st uri) in
    (if map_has String uri (lsp_docs st) then lsp_store_document st uri text else lsp_keep st)

def on_did_save (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let uri : String := lsp_doc_uri (rpc_params msg) in
    do lsp_publish(lsp_root st, uri, lsp_text st uri);
       lsp_keep st

def on_did_close (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let uri : String := lsp_doc_uri (rpc_params msg) in
    do lsp_clear uri;
       lsp_keep (lsp_drop st uri)

def on_sym (st : Lsp) (msg : Json) (ok : Sym -> Json) : IO (Pair Lsp Bool) :=
    do let! index := lsp_index_with LspIndexRemember st (lsp_doc_uri (rpc_params msg));
       let (MkPair syms cache) := index in
       let result : Json := match sym_find(lsp_word_of st msg, syms) with
         | Nothing => JNull
         | Just s => ok s
         end in
       lsp_reply_keep (lsp_with_navigation_cache st cache) msg result

def on_completion (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let params : Json := rpc_params msg in
    let uri : String := lsp_doc_uri params in
    match! lsp_document_path(lsp_root st, uri) with
    | Nothing => lsp_reply_keep st msg (JArr (Nil Json))
    | Just path =>
        let text : String := lsp_text st uri in
        do let! index := lsp_index_at LspIndexRemember st path text;
           let (MkPair syms cache) := index in
           let result : Json := completion_result text
             (lsp_pos_line params) (lsp_pos_char params) syms in
           lsp_reply_keep (lsp_with_navigation_cache st cache) msg result
    end

-- Formatting delegates to the sibling formatter (see tools/lsp_model.ouro for
-- why it is not linked in). The buffer is written to a scratch file first, so
-- unsaved edits are formatted and no import of the document is needed.
def lsp_fmt_run (st : Lsp) (msg : Json) (text : String) (scratch : String) : IO (Pair Lsp Bool) :=
    do let! wrote := lsp_write scratch text;
       (if wrote then
         do let! result := native_sibling_run lsp_format_process_limits "ouro-fmt.exe" (native_sibling_format_args scratch);
            fs_remove scratch;
            match result with
            | Left error => eprintln (str_concat("ouro-lsp: ", native_sibling_error_message error))
            | Right _ => io_unit
            end;
            lsp_reply_keep st msg (lsp_process_format text result)
       else
         do fs_remove scratch;
            lsp_reply_keep st msg JNull)

def on_formatting (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let uri : String := lsp_doc_uri (rpc_params msg) in
    match! lsp_document_path(lsp_root st, uri) with
    | Nothing => lsp_reply_keep st msg JNull
    | Just _ =>
        do let! scratch := lsp_scratch (lsp_root st);
           if str_null scratch then lsp_reply_keep st msg JNull
           else lsp_fmt_run st msg (lsp_text st uri) scratch
    end

def on_document_symbol (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let uri : String := lsp_doc_uri (rpc_params msg) in
    match! lsp_document_path(lsp_root st, uri) with
    | Nothing => lsp_reply_keep st msg (JArr (Nil Json))
    | Just path =>
        do let! index := lsp_index_with (LspIndexDocument path) st uri;
           let (MkPair syms _) := index in
           lsp_reply_keep st msg (JArr (document_symbol_items syms))
    end

def workspace_symbols (st : Lsp) (uris : List String)
    (acc : List Sym) : IO (List Sym) :=
    let mode : LspIndexMode := match uris with
      | Nil => LspIndexUncached
      | Cons _ rest => if nullb String rest then LspIndexReuse else LspIndexRemember
      end in
    (fix go (remaining : List String) (groups : List (List Sym)) (state : Lsp) : IO (List Sym) :=
      match remaining with
      | Nil => io_pure(List Sym, lsp_symbols_from_groups groups)
      | Cons uri rest =>
          do let! index := lsp_index_with mode state uri;
             let (MkPair more cache) := index in
             go rest (lsp_add_symbol_group more groups) (lsp_with_navigation_cache state cache)
      end) uris (lsp_add_symbol_group acc []) st;


def on_workspace_symbol (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let query : String := json_field_str (rpc_params msg) "query" "" in
    let uris : List String := map_keys(String, lsp_docs st) in
    do let! syms := workspace_symbols st uris (Nil Sym);
       lsp_reply_keep st msg (workspace_symbol_result query syms)

def on_prepare_rename (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let params : Json := rpc_params msg in
    lsp_reply_keep st msg
      (prepare_rename_result (lsp_text(st, lsp_doc_uri params))
        (lsp_pos_line params) (lsp_pos_char params));

def on_rename (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let params : Json := rpc_params msg in
    let uri : String := lsp_doc_uri params in
    let text : String := lsp_text st uri in
    let new_name : String := json_field_str params "newName" "" in
    lsp_reply_keep st msg (rename_at uri text (lsp_pos_line params) (lsp_pos_char params) new_name);

-- An imported file changed on disk. Recheck every open buffer, not the
-- saved path: a dirty editor still owns diagnostics for that URI, while
-- the checker reads imported files from disk through the scratch rewrite.
def lsp_republish_open (st : Lsp) (uri : String) : IO Unit :=
    match! lsp_document_path(lsp_root st, uri) with
    | Nothing => lsp_clear uri
    | Just origin =>
        lsp_publish_buf(lsp_root st, uri, origin, lsp_text st uri)
    end

def on_watched_files (st : Lsp) (_msg : Json) : IO (Pair Lsp Bool) :=
    do io_foreach String (lsp_republish_open st)
         (map_keys(String, lsp_docs st));
       lsp_keep st

def on_unknown (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    (if lsp_message_is_notification msg then lsp_keep st
    else
      do lsp_send (rpc_error (rpc_id msg) rpc_err_method_not_found
                     (str_concat("unsupported method: ", rpc_method msg)));
         lsp_keep st);

-- Split dispatch into two trees to avoid generated C path collisions
-- along a long chain of False arms.
def lsp_dispatch_more (st : Lsp) (msg : Json) (m : String) : IO (Pair Lsp Bool) :=
    if str_eq m "textDocument/documentSymbol" then on_document_symbol st msg
    else
      if str_eq m "workspace/symbol" then on_workspace_symbol st msg
      else
        if str_eq m "textDocument/prepareRename" then on_prepare_rename st msg
        else
          if str_eq m "textDocument/rename" then on_rename st msg
          else
            if str_eq m "workspace/didChangeWatchedFiles" then on_watched_files st msg
            else on_unknown st msg;

def lsp_dispatch (st : Lsp) (msg : Json) : IO (Pair Lsp Bool) :=
    let m : String := rpc_method msg in
    (if str_eq m "initialize" then
      do lsp_reply msg lsp_initialize_result;
                 lsp_keep st
    else
      if str_eq m "initialized" then lsp_keep st
      else
        if str_eq m "shutdown" then
          do lsp_reply msg JNull;
                     lsp_keep (lsp_shutdown st)
        else
          if str_eq m "exit" then lsp_stop st
          else
            if str_eq m "textDocument/didOpen" then on_did_open st msg
            else
              if str_eq m "textDocument/didChange" then on_did_change st msg
              else
                if str_eq m "textDocument/didSave" then on_did_save st msg
                else
                  if str_eq m "textDocument/didClose" then on_did_close st msg
                  else
                    if str_eq m "textDocument/hover" then on_sym st msg hover_result
                    else
                      if str_eq m "textDocument/definition" then
                        on_sym st msg location_result
                      else
                        if str_eq m "textDocument/completion" then
                          on_completion st msg
                        else
                          if str_eq m "textDocument/formatting" then
                            on_formatting st msg
                          else lsp_dispatch_more st msg m);

-- A body that is not JSON gets the standard parse error, with a null id
-- because there is no id to read.
def lsp_handle_body (st : Lsp) (body : String) : IO (Pair Lsp Bool) :=
    match gate_parse_json body with
    | Nothing =>
        do lsp_send (rpc_error JNull rpc_err_parse "invalid JSON");
           lsp_keep st
    | Just msg => if lsp_message_valid msg then lsp_dispatch st msg
      else
        do lsp_send (rpc_error (lsp_message_error_id msg)
             rpc_err_invalid_request "invalid JSON-RPC request");
           lsp_keep st
    end;

def lsp_byte_span : Nat := 256;
def lsp_loop_fuel : Nat := mul lsp_byte_span lsp_byte_span;

def lsp_loop : Nat -> Lsp -> IO Lsp :=
  fix lsp_loop (fuel : Nat) (st : Lsp) : IO Lsp :=
    match fuel with
    | Z => io_pure Lsp st
    | S fuel2 =>
        do let! msg := lsp_read_message;
           let! next :=
             match msg with
             | Nothing => lsp_stop st
             | Just body => lsp_handle_body st body
             end;
           let (MkPair st2 go) := next in
           if go then lsp_loop fuel2 st2 else io_pure Lsp st2
    end;

-- Exit with status 0 after shutdown and 1 otherwise.
-- The same rule applies when the client closes the pipe.
def main : IO Unit :=
    do let! root := lsp_workspace_root;
       let! st := lsp_loop(lsp_loop_fuel, lsp_with_root lsp_empty root);
       exit (match lsp_down st with | True => Z | False => S Z end)
