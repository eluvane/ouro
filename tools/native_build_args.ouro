-- Native Windows build argument helpers. No compiler imports.

import "../std/string.ouro",
  "../std/pathx.ouro";

def NativeBuildError : Type := String;

def native_build_doctor_text : String :=
    "ouro native-build\ntarget: x86_64-windows\nbackend: native\nlegacy-c: rejected\n";

def native_build_backend_native : String := "native";
def native_build_backend_legacy_c : String := "legacy-c";
def native_build_default_target : String := "x86_64-windows";
def native_build_default_entry : String := "main";
-- Match the existing positional producer's build budget; check is separate.
def native_build_fuel_scale : Nat := 1000;
def native_build_default_fuel : Nat := mul 200 native_build_fuel_scale;
def native_build_check_default_fuel : Nat := mul 160 100;

inductive NativeBuildRequest : Type :=
  | MkNativeBuildRequest : String -> String -> String -> String -> String -> Nat
      -> NativeBuildRequest;

def native_build_request_backend (request : NativeBuildRequest) : String :=
    match request with
    | MkNativeBuildRequest backend _ _ _ _ _ => backend
    end;

def native_build_request_target (request : NativeBuildRequest) : String :=
    match request with
    | MkNativeBuildRequest _ target _ _ _ _ => target
    end;

def native_build_request_source (request : NativeBuildRequest) : String :=
    match request with
    | MkNativeBuildRequest _ _ source _ _ _ => source
    end;

def native_build_request_out (request : NativeBuildRequest) : String :=
    match request with
    | MkNativeBuildRequest _ _ _ output _ _ => output
    end;

def native_build_request_entry (request : NativeBuildRequest) : String :=
    match request with
    | MkNativeBuildRequest _ _ _ _ entry _ => entry
    end;

def native_build_request_fuel (request : NativeBuildRequest) : Nat :=
    match request with
    | MkNativeBuildRequest _ _ _ _ _ fuel => fuel
    end;

def native_build_err_backend (backend : String) : NativeBuildError :=
    str_concat "native-build: unsupported backend: " backend;

def native_build_err_target (target : String) : NativeBuildError :=
    str_concat "native-build: unsupported target: " target;

def native_build_default_out (source : String) : String :=
    path_join
      ([ "_build"
       , "native"
       , str_concat(path_stem source, ".exe")
       ] : List String);

def native_build_resolve_out (source : String) (output : String) : String :=
    match str_null output with
    | True => native_build_default_out source
    | False => output
    end;

def native_build_resolve_entry (entry : String) : String :=
    match str_null entry with
    | True => native_build_default_entry
    | False => entry
    end;

-- "legacy-c" is a known name and is rejected. It must not select native.
def native_build_parse_backend (backend : String) : Either NativeBuildError String :=
    match str_eq backend native_build_backend_native with
    | True => Right NativeBuildError String native_build_backend_native
    | False =>
        match str_eq backend native_build_backend_legacy_c with
        | True =>
            Left NativeBuildError String
              (native_build_err_backend native_build_backend_legacy_c)
        | False => Left NativeBuildError String (native_build_err_backend backend)
        end
    end;

def native_build_parse_target (target : String) : Either NativeBuildError String :=
    match str_null target with
    | True => Right NativeBuildError String native_build_default_target
    | False =>
        match str_eq target native_build_default_target with
        | True => Right NativeBuildError String native_build_default_target
        | False => Left NativeBuildError String (native_build_err_target target)
        end
    end;

def native_build_parse (backend : String) (target : String) (source : String)
    (output : String) (entry : String) : Either NativeBuildError NativeBuildRequest :=
    match native_build_parse_backend backend with
    | Left err => Left NativeBuildError NativeBuildRequest err
    | Right accepted_backend =>
        match native_build_parse_target target with
        | Left err => Left NativeBuildError NativeBuildRequest err
        | Right accepted_target =>
            Right NativeBuildError NativeBuildRequest
              (MkNativeBuildRequest
                accepted_backend
                accepted_target
                source
                (native_build_resolve_out source output)
                (native_build_resolve_entry entry)
                native_build_default_fuel)
        end
    end;
