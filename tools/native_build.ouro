-- Transitional positional producer; coil owns the public command grammar.
-- Explicit units and the output path protocol remain available to bootstrap.
import "native_build_core.ouro";

def native_build_usage : String :=
    "usage: ouro-native-build ROOT.ouro OUT.exe [UNIT.ouro ...]";

def native_build_die (code : Nat) (message : String) : IO Unit :=
    do eprintln (prim_string_concat "native-build: " message);
       exit code

-- Positional output is literal: an empty OUT must fail publication instead of
-- selecting the public CLI's default filename.
def native_build_positional_request (source : String) (output : String) : NativeBuildRequest :=
    MkNativeBuildRequest native_build_backend_native native_build_default_target
      source output native_build_default_entry native_build_fuel;

def native_build_finish (output : String) (result : Either NativeBuildFailure Unit) : IO Unit :=
    match result with
    | Left error => native_build_die 1 (native_build_error_message error)
    | Right _ => println output
    end;

def native_build_compile_units (root : String) (output : String) (paths : List String) : IO Unit :=
    do let! result := native_build_compile_units_checked (native_build_positional_request root output) paths;
       native_build_finish output result

def native_build_compile (source : String) (output : String) : IO Unit :=
    do let! result := native_build_compile_checked (native_build_positional_request source output);
       native_build_finish output result

def native_build_doctor : IO Unit := print native_build_doctor_text;

-- @entry main
def main : IO Unit :=
    do let! argv := prim_argv;
       match argv with
       | Cons _ rest =>
           match rest with
           | Cons source more =>
               match native_build_str_eq source "doctor" with
               | True => native_build_doctor
               | False =>
                 match native_build_str_eq source "legacy-c" with
                 | True => native_build_die 2 "legacy-c is rejected"
                 | False =>
                   match more with
                   | Cons output leftover =>
                       match leftover with
                       | Nil => native_build_compile source output
                       | Cons _ _ => native_build_compile_units source output leftover
                       end
                   | Nil => native_build_die 2 native_build_usage
                   end
                 end
               end
           | Nil => native_build_die 2 native_build_usage
           end
       | Nil => native_build_die 2 native_build_usage
       end
