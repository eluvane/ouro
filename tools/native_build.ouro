-- Transitional positional producer; coil owns the public command grammar.
-- Explicit units and the output path protocol remain available to bootstrap.
-- `--coil-dispatch` keeps the public coil launcher off the compiler cone.
import "native_build_core.ouro",
  "native_cli_args.ouro",
  "../compiler/native/mir_model.ouro",
  "../compiler/pipeline_abi.ouro",
  "../compiler/checked_program.ouro",
  "../std/process.ouro";

def native_build_usage : String :=
    "usage: ouro-native-build ROOT.ouro OUT.exe [UNIT.ouro ...]";

def native_build_die (code : Nat) (message : String) : IO Unit :=
    do eprintln (prim_string_concat "native-build: " message);
       exit code

-- Positional output is literal: an empty OUT must fail publication instead of
-- selecting the public CLI's default filename.
def native_build_positional_request (source : String) (output : String) : NativeBuildRequest :=
    MkNativeBuildRequest native_build_backend_native native_build_default_target
      source output native_build_default_entry native_build_fuel;

def native_build_finish (output : String) (result : Either NativeBuildFailure Unit) : IO Unit :=
    match result with
    | Left error => native_build_die(1, native_build_error_message error)
    | Right _ => println output
    end;

def native_build_compile_units (root : String) (output : String) (paths : List String) : IO Unit :=
    do let! result := native_build_compile_units_checked(native_build_positional_request root output, paths);
       native_build_finish output result

def native_build_compile (source : String) (output : String) : IO Unit :=
    do let! result := native_build_compile_checked (native_build_positional_request source output);
       native_build_finish output result

def native_build_doctor : IO Unit := print native_build_doctor_text;

def coil_build_fail (error : NativeBuildFailure) : IO Unit :=
    coil_fail(1, native_build_error_message error);

def coil_run_finish (result : Either ProcessRunError Nat) : IO Unit :=
    match result with
    | Left error => coil_fail(1, process_run_error_message error)
    | Right code => exit code
    end;

def coil_run (request : NativeBuildRequest) (arguments : List String) : IO Unit :=
    do let! built := native_build_compile_checked request;
       match built with
       | Left error => coil_build_fail error
       | Right _ =>
           do let! result := process_run_inherited(native_build_request_out request, arguments);
              coil_run_finish result
       end

def coil_check_output (fuel : Nat) (artifact : Maybe String)
    (checked : CheckedProgram) : IO Unit :=
    match artifact with
    | Nothing => println "CHECK_OK"
    | Just output =>
        do let! written := native_build_dump_checked fuel output checked;
           match written with
           | Left error => coil_build_fail error
           | Right _ => println "CHECK_OK"
           end
    end;

def coil_execute (command : NativeCliCommand) : IO Unit :=
    match command with
    | NativeCliDoctor => native_build_doctor
    | NativeCliCheck source fuel artifact =>
        do let! checked := native_build_check_source source fuel;
           match checked with
           | Left error => coil_build_fail error
           | Right program => coil_check_output fuel artifact program
           end
    | NativeCliBuild request =>
        do let! built := native_build_compile_checked request;
           match built with
           | Left error => coil_build_fail error
           | Right _ => println (native_build_request_out request)
           end
    | NativeCliRun request arguments => coil_run request arguments
    end;

def coil_dispatch_words (words : List String) : IO Unit :=
    match words with
    | Nil => coil_fail(2, native_cli_error_message NativeCliMissingCommand)
    | Cons _ _ => match native_cli_parse words with
      | Left error =>
          do eprintln (str_concat("coil: ", native_cli_error_message error));
             eprint native_cli_usage;
             exit 2
      | Right command => coil_execute command
      end
    end;

-- @entry main
def main : IO Unit :=
    do let! argv := prim_argv;
       match argv with
       | Cons _ rest =>
           match rest with
           | Cons source more =>
               match native_build_str_eq source "--coil-dispatch" with
               | True => coil_dispatch_words more
               | False =>
               match native_build_str_eq source "doctor" with
               | True => native_build_doctor
               | False =>
                 match native_build_str_eq source "legacy-c" with
                 | True => native_build_die 2 "legacy-c is rejected"
                 | False =>
                   match more with
                   | Cons output leftover =>
                       match leftover with
                       | Nil => native_build_compile source output
                       | Cons _ _ => native_build_compile_units source output leftover
                       end
                   | Nil => native_build_die 2 native_build_usage
                   end
                 end
               end
               end
           | Nil => native_build_die 2 native_build_usage
           end
       | Nil => native_build_die 2 native_build_usage
       end
