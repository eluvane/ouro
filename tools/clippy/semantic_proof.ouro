-- Closed semantic proof vocabulary shared by rule predicates and reporting.
-- Requirements are not confidence scores. Missing, contradictory, duplicated,
-- unknown or disproven evidence invalidates the entire proof. Source ordinals
-- are NOT byte spans; absent exact spans forbid all semantic automatic edits.
import "../../compiler/semantic_scope.ouro";

inductive CmRequirement : Type :=
  | CmOwnerResolved : CmRequirement
  | CmSubjectKnown : CmRequirement
  | CmCalleeResolved : CmRequirement
  | CmTraversalComplete : CmRequirement
  | CmSameValue : CmRequirement
  | CmTotalComparison : CmRequirement
  | CmCheckedProducer : CmRequirement
  | CmNoObservation : CmRequirement
  | CmFailurePath : CmRequirement
  | CmNoRecovery : CmRequirement
  | CmZeroExit : CmRequirement
  | CmSuccessConstructor : CmRequirement
  | CmOutsideOwner : CmRequirement
  | CmPureExpression : CmRequirement
  | CmMeaningfulCost : CmRequirement
  | CmSameArguments : CmRequirement
  | CmSameRegion : CmRequirement
  | CmKnownArguments : CmRequirement
  | CmSameStructure : CmRequirement
  | CmContractAgreement : CmRequirement;

def cm_requirement_id (fact : CmRequirement) : Nat :=
    match fact with
    | CmOwnerResolved => 0
    | CmSubjectKnown => 1
    | CmCalleeResolved => 2
    | CmTraversalComplete => 3
    | CmSameValue => 4
    | CmTotalComparison => 5
    | CmCheckedProducer => 6
    | CmNoObservation => 7
    | CmFailurePath => 8
    | CmNoRecovery => 9
    | CmZeroExit => 10
    | CmSuccessConstructor => 11
    | CmOutsideOwner => 12
    | CmPureExpression => 13
    | CmMeaningfulCost => 14
    | CmSameArguments => 15
    | CmSameRegion => 16
    | CmKnownArguments => 17
    | CmSameStructure => 18
    | CmContractAgreement => 19
    end;

inductive CmProofKind : Type :=
  | CmReflexiveProof : CmProofKind
  | CmIrreflexiveProof : CmProofKind
  | CmRawReadProof : CmProofKind
  | CmRawWriteProof : CmProofKind
  | CmRawProcessProof : CmProofKind
  | CmFailureExitProof : CmProofKind
  | CmFailureSuccessProof : CmProofKind
  | CmIgnoredResultProof : CmProofKind
  | CmRepeatedWorkProof : CmProofKind
  | CmRepeatedTraversalProof : CmProofKind
  | CmDuplicateProof : CmProofKind;

def cm_proof_rule (kind : CmProofKind) : String :=
    match kind with
    | CmReflexiveProof => "OURO-CLIPPY-LOGIC-001"
    | CmIrreflexiveProof => "OURO-CLIPPY-LOGIC-002"
    | CmRawReadProof => "OURO-CLIPPY-CHECKED-001"
    | CmRawWriteProof => "OURO-CLIPPY-CHECKED-002"
    | CmRawProcessProof => "OURO-CLIPPY-CHECKED-003"
    | CmFailureExitProof => "OURO-CLIPPY-ERROR-001"
    | CmFailureSuccessProof => "OURO-CLIPPY-ERROR-003"
    | CmIgnoredResultProof => "OURO-CLIPPY-CHECKED-006"
    | CmRepeatedWorkProof => "OURO-CLIPPY-PERF-001"
    | CmRepeatedTraversalProof => "OURO-CLIPPY-PERF-002"
    | CmDuplicateProof => "OURO-CLIPPY-MAINT-007"
    end;

def cm_requirements (kind : CmProofKind) : List CmRequirement :=
    append CmRequirement [CmOwnerResolved, CmSubjectKnown, CmTraversalComplete]
      (match kind with
      | CmReflexiveProof => [CmCalleeResolved, CmSameValue, CmTotalComparison, CmKnownArguments]
      | CmIrreflexiveProof => [CmCalleeResolved, CmSameValue, CmTotalComparison, CmKnownArguments]
      | CmRawReadProof => [CmCalleeResolved, CmOutsideOwner]
      | CmRawWriteProof => [CmCalleeResolved, CmOutsideOwner]
      | CmRawProcessProof => [CmCalleeResolved, CmOutsideOwner]
      | CmFailureExitProof => [CmCalleeResolved, CmCheckedProducer, CmFailurePath, CmNoRecovery, CmZeroExit]
      | CmFailureSuccessProof => [CmCheckedProducer, CmFailurePath, CmNoRecovery, CmSuccessConstructor]
      | CmIgnoredResultProof => [CmCheckedProducer, CmNoObservation]
      | CmRepeatedWorkProof => [CmCalleeResolved, CmPureExpression, CmMeaningfulCost, CmSameArguments, CmSameRegion, CmKnownArguments]
      | CmRepeatedTraversalProof => [CmCalleeResolved, CmPureExpression, CmMeaningfulCost, CmSameArguments, CmSameRegion, CmKnownArguments]
      | CmDuplicateProof => [CmSameStructure, CmContractAgreement]
      end);

inductive CmEvidence : Type :=
  | CmEvidenceOf : CmRequirement -> Maybe Bool -> CmEvidence;
def cm_evidence_id (evidence : CmEvidence) : Nat :=
    match evidence with | CmEvidenceOf fact _ => cm_requirement_id fact end;
def cm_established (evidence : CmEvidence) : Bool :=
    match evidence with | CmEvidenceOf _ value => match value with
      | Nothing => False | Just yes => yes end end;
def cm_known_fact (fact : CmRequirement) (yes : Bool) : CmEvidence :=
    CmEvidenceOf fact (Just Bool yes);

-- kind, owner module, owner declaration, subject ordinal, branch, effect epoch,
-- optional exact source-byte range, evidence, explanation. No AST/source clones.
inductive CmSemanticProof : Type :=
  | CmSemanticProofOf : CmProofKind -> Nat -> Nat -> Nat -> Nat -> Nat
      -> Maybe (Pair Nat Nat) -> List CmEvidence -> String -> CmSemanticProof;
def cm_proof_kind (proof : CmSemanticProof) : CmProofKind :=
    match proof with | CmSemanticProofOf value _ _ _ _ _ _ _ _ => value end;
def cm_proof_node (proof : CmSemanticProof) : Nat :=
    match proof with | CmSemanticProofOf _ _ _ value _ _ _ _ _ => value end;
def cm_proof_evidence (proof : CmSemanticProof) : List CmEvidence :=
    match proof with | CmSemanticProofOf _ _ _ _ _ _ _ value _ => value end;
def cm_proof_message (proof : CmSemanticProof) : String :=
    match proof with | CmSemanticProofOf _ _ _ _ _ _ _ _ value => value end;

def cm_evidence_unique : List CmEvidence -> List Nat -> Bool :=
  fix go (evidence : List CmEvidence) (seen : List Nat) : Bool :=
    match evidence with
    | Nil => True
    | Cons fact rest => andb (notb (elem Nat eq_nat (cm_evidence_id fact) seen))
        (go rest (Cons Nat (cm_evidence_id fact) seen)) end;

def cm_proof_valid (proof : CmSemanticProof) : Bool :=
    let evidence : List CmEvidence := cm_proof_evidence proof in
    andb (cm_evidence_unique evidence [])
      (andb (all CmEvidence cm_established evidence)
        (all CmRequirement (fun (required : CmRequirement) =>
          any CmEvidence (fun (present : CmEvidence) =>
            eq_nat (cm_requirement_id required) (cm_evidence_id present)) evidence)
          (cm_requirements (cm_proof_kind proof))));

def cm_proof_owned (decl : ScDecl) (proof : CmSemanticProof) : Bool :=
    match proof with | CmSemanticProofOf _ module_id owner _ _ _ _ _ _ =>
      andb (eq_nat module_id (sc_decl_module decl)) (eq_nat owner (sc_decl_name decl)) end;

-- This constructor binds evidence to the current owner and execution region.
-- Only consumers of a COMPLETED traversal may publish its result.
def cm_proof_for (kind : CmProofKind) (owner : ScDecl) (node : Nat)
    (branch : Nat) (epoch : Nat) (facts : List CmEvidence) (message : String) : CmSemanticProof :=
    CmSemanticProofOf kind (sc_decl_module owner) (sc_decl_name owner) node branch epoch
      (Nothing (Pair Nat Nat))
      (append CmEvidence [cm_known_fact CmOwnerResolved True, cm_known_fact CmSubjectKnown True,
        cm_known_fact CmTraversalComplete True] facts) message;
