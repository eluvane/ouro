-- Closed semantic proof vocabulary shared by rule predicates and reporting.
-- Requirements are not confidence scores. Missing, contradictory, duplicated,
-- unknown or disproven evidence invalidates the entire proof. Source ordinals
-- are NOT byte spans; absent exact spans forbid all semantic automatic edits.
import "../../compiler/semantic_scope.ouro",
  "semantic_collection_proof.ouro",
  "semantic_quality_kinds.ouro";

inductive CmRequirement : Type :=
  | CmOwnerResolved : CmRequirement
  | CmSubjectKnown : CmRequirement
  | CmCalleeResolved : CmRequirement
  | CmTraversalComplete : CmRequirement
  | CmSameValue : CmRequirement
  | CmTotalComparison : CmRequirement
  | CmCheckedProducer : CmRequirement
  | CmNoObservation : CmRequirement
  | CmFailurePath : CmRequirement
  | CmNoRecovery : CmRequirement
  | CmZeroExit : CmRequirement
  | CmSuccessConstructor : CmRequirement
  | CmOutsideOwner : CmRequirement
  | CmPureExpression : CmRequirement
  | CmMeaningfulCost : CmRequirement
  | CmSameArguments : CmRequirement
  | CmSameRegion : CmRequirement
  | CmKnownArguments : CmRequirement
  | CmSameStructure : CmRequirement
  | CmContractAgreement : CmRequirement
  | CmNeutralOperand : CmRequirement
  | CmErasingOperand : CmRequirement
  | CmZeroDivisor : CmRequirement
  | CmNaturalOrderInvariant : CmRequirement
  | CmInvertedBounds : CmRequirement
  | CmEmptyText : CmRequirement
  | CmBooleanIdentity : CmRequirement
  | CmBooleanAbsorber : CmRequirement
  | CmZeroCount : CmRequirement
  | CmProducerLineage : CmRequirement
  | CmSameOperation : CmRequirement
  | CmInvolution : CmRequirement
  | CmIdempotence : CmRequirement
  | CmExactArity : CmRequirement
  | CmEqualBounds : CmRequirement
  | CmExtremumIdentity : CmRequirement
  | CmTrivialExponent : CmRequirement
  | CmUnchangedReplacement : CmRequirement
  | CmIndexOutsideText : CmRequirement
  | CmFixedConstructor : CmRequirement
  | CmTypeArgumentsAgree : CmRequirement
  | CmLengthPreserved : CmRequirement
  | CmAllocationAvoided : CmRequirement
  | CmCountDominance : CmRequirement
  | CmBoundsContainment : CmRequirement
  | CmComplementaryOperands : CmRequirement
  | CmCallbackSkipped : CmRequirement
  | CmIdentityCallback : CmRequirement
  | CmMatchDominates : CmRequirement
  | CmResultRoundTrip : CmRequirement
  | CmTotalCallbacks : CmRequirement
  | CmCollectionEquivalence : CmRequirement
  | CmCollectionLawEstablished : CmRequirement
  | CmProducerUnbound : CmRequirement
  | CmDynamicInput : CmRequirement;

def cm_requirement_id (fact : CmRequirement) : Nat :=
    match fact with
    | CmOwnerResolved => 0
    | CmSubjectKnown => 1
    | CmCalleeResolved => 2
    | CmTraversalComplete => 3
    | CmSameValue => 4
    | CmTotalComparison => 5
    | CmCheckedProducer => 6
    | CmNoObservation => 7
    | CmFailurePath => 8
    | CmNoRecovery => 9
    | CmZeroExit => 10
    | CmSuccessConstructor => 11
    | CmOutsideOwner => 12
    | CmPureExpression => 13
    | CmMeaningfulCost => 14
    | CmSameArguments => 15
    | CmSameRegion => 16
    | CmKnownArguments => 17
    | CmSameStructure => 18
    | CmContractAgreement => 19
    | CmNeutralOperand => 20
    | CmErasingOperand => 21
    | CmZeroDivisor => 22
    | CmNaturalOrderInvariant => 23
    | CmInvertedBounds => 24
    | CmEmptyText => 25
    | CmBooleanIdentity => 26
    | CmBooleanAbsorber => 27
    | CmZeroCount => 28
    | CmProducerLineage => 29
    | CmSameOperation => 30
    | CmInvolution => 31
    | CmIdempotence => 32
    | CmExactArity => 33
    | CmEqualBounds => 34
    | CmExtremumIdentity => 35
    | CmTrivialExponent => 36
    | CmUnchangedReplacement => 37
    | CmIndexOutsideText => 38
    | CmFixedConstructor => 39
    | CmTypeArgumentsAgree => 40
    | CmLengthPreserved => 41
    | CmAllocationAvoided => 42
    | CmCountDominance => 43
    | CmBoundsContainment => 44
    | CmComplementaryOperands => 45
    | CmCallbackSkipped => 46
    | CmIdentityCallback => 47
    | CmMatchDominates => 48
    | CmResultRoundTrip => 49
    | CmTotalCallbacks => 50
    | CmCollectionEquivalence => 51
    | CmCollectionLawEstablished => 52
    | CmProducerUnbound => 53
    | CmDynamicInput => 54
    end;

inductive CmProofKind : Type :=
  | CmReflexiveProof : CmProofKind
  | CmIrreflexiveProof : CmProofKind
  | CmRawReadProof : CmProofKind
  | CmRawWriteProof : CmProofKind
  | CmRawProcessProof : CmProofKind
  | CmFailureExitProof : CmProofKind
  | CmFailureSuccessProof : CmProofKind
  | CmIgnoredResultProof : CmProofKind
  | CmRepeatedWorkProof : CmProofKind
  | CmRepeatedTraversalProof : CmProofKind
  | CmDuplicateProof : CmProofKind
  | CmNeutralNatProof : CmProofKind
  | CmErasingNatProof : CmProofKind
  | CmZeroDivisorProof : CmProofKind
  | CmConstantNatOrderProof : CmProofKind
  | CmInvertedBoundsProof : CmProofKind
  | CmEmptyConcatProof : CmProofKind
  | CmIdentityBoolProof : CmProofKind
  | CmAbsorbingBoolProof : CmProofKind
  | CmZeroListCountProof : CmProofKind
  | CmDoubleNotProof : CmProofKind
  | CmIdempotentNormalizeProof : CmProofKind
  | CmDoubleReverseProof : CmProofKind
  | CmDegenerateClampProof : CmProofKind
  | CmExtremumOperandProof : CmProofKind
  | CmTrivialPowerProof : CmProofKind
  | CmUnchangedReplaceProof : CmProofKind
  | CmEmptySearchProof : CmProofKind
  | CmTextByteBoundsProof : CmProofKind
  | CmEmptySliceProof : CmProofKind
  | CmTextSliceBoundsProof : CmProofKind
  | CmReflexiveSearchProof : CmProofKind
  | CmKnownResultTestProof : CmProofKind
  | CmKnownResultDefaultProof : CmProofKind
  | CmExtremumAbsorptionProof : CmProofKind
  | CmKnownMaybeDefaultProof : CmProofKind
  | CmLengthReverseProof : CmProofKind
  | CmLengthAppendProof : CmProofKind
  | CmDominatedTakeProof : CmProofKind
  | CmDropAfterTakeProof : CmProofKind
  | CmContainedClampProof : CmProofKind
  | CmClampedRangeProof : CmProofKind
  | CmBooleanComplementProof : CmProofKind
  | CmResultMapFailureProof : CmProofKind
  | CmResultMapErrorSuccessProof : CmProofKind
  | CmResultBindFailureProof : CmProofKind
  | CmResultRecoverySuccessProof : CmProofKind
  | CmResultFoldKnownProof : CmProofKind
  | CmMaybeMapNothingProof : CmProofKind
  | CmMaybeFoldKnownProof : CmProofKind
  | CmResultToMaybeKnownProof : CmProofKind
  | CmResultFromMaybeKnownProof : CmProofKind
  | CmResultDefaultFailureProof : CmProofKind
  | CmMaybeDefaultNothingProof : CmProofKind
  | CmResultMap2FailureProof : CmProofKind
  | CmResultUnitFailureProof : CmProofKind
  | CmResultUnitIdempotentProof : CmProofKind
  | CmMaybeResultRoundTripProof : CmProofKind
  | CmResultMapIdentityProof : CmProofKind
  | CmResultMapErrorIdentityProof : CmProofKind
  | CmMaybeMapIdentityProof : CmProofKind
  | CmResultPathTestProof : CmProofKind
  | CmResultPathDefaultProof : CmProofKind
  | CmCollectionProof : CmCollectionLaw -> CmProofKind
  | CmQualityProof : CmQualityKind -> CmProofKind;

def cm_proof_rule (kind : CmProofKind) : String :=
    match kind with
    | CmReflexiveProof => "OURO-CLIPPY-LOGIC-001"
    | CmIrreflexiveProof => "OURO-CLIPPY-LOGIC-002"
    | CmRawReadProof => "OURO-CLIPPY-CHECKED-001"
    | CmRawWriteProof => "OURO-CLIPPY-CHECKED-002"
    | CmRawProcessProof => "OURO-CLIPPY-CHECKED-003"
    | CmFailureExitProof => "OURO-CLIPPY-ERROR-001"
    | CmFailureSuccessProof => "OURO-CLIPPY-ERROR-003"
    | CmIgnoredResultProof => "OURO-CLIPPY-CHECKED-006"
    | CmRepeatedWorkProof => "OURO-CLIPPY-PERF-001"
    | CmRepeatedTraversalProof => "OURO-CLIPPY-PERF-002"
    | CmDuplicateProof => "OURO-CLIPPY-MAINT-007"
    | CmNeutralNatProof => "OURO-CLIPPY-REDUNDANT-008"
    | CmErasingNatProof => "OURO-CLIPPY-LOGIC-010"
    | CmZeroDivisorProof => "OURO-CLIPPY-LOGIC-007"
    | CmConstantNatOrderProof => "OURO-CLIPPY-LOGIC-008"
    | CmInvertedBoundsProof => "OURO-CLIPPY-LOGIC-009"
    | CmEmptyConcatProof => "OURO-CLIPPY-REDUNDANT-009"
    | CmIdentityBoolProof => "OURO-CLIPPY-REDUNDANT-010"
    | CmAbsorbingBoolProof => "OURO-CLIPPY-LOGIC-011"
    | CmZeroListCountProof => "OURO-CLIPPY-REDUNDANT-011"
    | CmDoubleNotProof => "OURO-CLIPPY-REDUNDANT-012"
    | CmIdempotentNormalizeProof => "OURO-CLIPPY-PERF-003"
    | CmDoubleReverseProof => "OURO-CLIPPY-PERF-004"
    | CmDegenerateClampProof => "OURO-CLIPPY-LOGIC-012"
    | CmExtremumOperandProof => "OURO-CLIPPY-REDUNDANT-013"
    | CmTrivialPowerProof => "OURO-CLIPPY-REDUNDANT-014"
    | CmUnchangedReplaceProof => "OURO-CLIPPY-REDUNDANT-015"
    | CmEmptySearchProof => "OURO-CLIPPY-LOGIC-013"
    | CmTextByteBoundsProof => "OURO-CLIPPY-LOGIC-014"
    | CmEmptySliceProof => "OURO-CLIPPY-REDUNDANT-016"
    | CmTextSliceBoundsProof => "OURO-CLIPPY-LOGIC-015"
    | CmReflexiveSearchProof => "OURO-CLIPPY-LOGIC-019"
    | CmKnownResultTestProof => "OURO-CLIPPY-REDUNDANT-017"
    | CmKnownResultDefaultProof => "OURO-CLIPPY-REDUNDANT-018"
    | CmExtremumAbsorptionProof => "OURO-CLIPPY-REDUNDANT-019"
    | CmKnownMaybeDefaultProof => "OURO-CLIPPY-REDUNDANT-020"
    | CmLengthReverseProof => "OURO-CLIPPY-PERF-005"
    | CmLengthAppendProof => "OURO-CLIPPY-PERF-006"
    | CmDominatedTakeProof => "OURO-CLIPPY-PERF-007"
    | CmDropAfterTakeProof => "OURO-CLIPPY-LOGIC-016"
    | CmContainedClampProof => "OURO-CLIPPY-REDUNDANT-021"
    | CmClampedRangeProof => "OURO-CLIPPY-LOGIC-017"
    | CmBooleanComplementProof => "OURO-CLIPPY-LOGIC-018"
    | CmResultMapFailureProof => "OURO-CLIPPY-REDUNDANT-101"
    | CmResultMapErrorSuccessProof => "OURO-CLIPPY-REDUNDANT-102"
    | CmResultBindFailureProof => "OURO-CLIPPY-REDUNDANT-103"
    | CmResultRecoverySuccessProof => "OURO-CLIPPY-REDUNDANT-104"
    | CmResultFoldKnownProof => "OURO-CLIPPY-REDUNDANT-105"
    | CmMaybeMapNothingProof => "OURO-CLIPPY-REDUNDANT-106"
    | CmMaybeFoldKnownProof => "OURO-CLIPPY-REDUNDANT-107"
    | CmResultToMaybeKnownProof => "OURO-CLIPPY-REDUNDANT-108"
    | CmResultFromMaybeKnownProof => "OURO-CLIPPY-REDUNDANT-109"
    | CmResultDefaultFailureProof => "OURO-CLIPPY-REDUNDANT-110"
    | CmMaybeDefaultNothingProof => "OURO-CLIPPY-REDUNDANT-111"
    | CmResultMap2FailureProof => "OURO-CLIPPY-REDUNDANT-112"
    | CmResultUnitFailureProof => "OURO-CLIPPY-REDUNDANT-113"
    | CmResultUnitIdempotentProof => "OURO-CLIPPY-REDUNDANT-114"
    | CmMaybeResultRoundTripProof => "OURO-CLIPPY-REDUNDANT-115"
    | CmResultMapIdentityProof => "OURO-CLIPPY-REDUNDANT-116"
    | CmResultMapErrorIdentityProof => "OURO-CLIPPY-REDUNDANT-117"
    | CmMaybeMapIdentityProof => "OURO-CLIPPY-REDUNDANT-118"
    | CmResultPathTestProof => "OURO-CLIPPY-REDUNDANT-119"
    | CmResultPathDefaultProof => "OURO-CLIPPY-REDUNDANT-120"
    | CmCollectionProof law => cc_rule law
    | CmQualityProof law => cm_quality_rule law
    end;

-- Shared call/producer obligations are explicit sets, never confidence scores.
def cm_operand_requirements (fact : CmRequirement) : List CmRequirement :=
    [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, fact];
def cm_composition_requirements (facts : List CmRequirement) : List CmRequirement :=
    append CmRequirement
      [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity,
       CmProducerLineage, CmSameRegion] facts;

def cm_result_constructor_requirements : List CmRequirement :=
    cm_composition_requirements [CmFixedConstructor, CmTypeArgumentsAgree];
def cm_result_callback_requirements : List CmRequirement :=
    append CmRequirement cm_result_constructor_requirements [CmCallbackSkipped];
def cm_result_identity_requirements : List CmRequirement :=
    append CmRequirement (cm_operand_requirements CmIdentityCallback)
      [CmTypeArgumentsAgree, CmContractAgreement];
def cm_result_path_requirements : List CmRequirement :=
    [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity,
     CmCheckedProducer, CmProducerLineage, CmSameRegion, CmMatchDominates,
     CmFixedConstructor];

def cm_requirements (kind : CmProofKind) : List CmRequirement :=
    append CmRequirement [CmOwnerResolved, CmSubjectKnown, CmTraversalComplete]
      (match kind with
      | CmReflexiveProof => [CmCalleeResolved, CmSameValue, CmTotalComparison, CmKnownArguments]
      | CmIrreflexiveProof => [CmCalleeResolved, CmSameValue, CmTotalComparison, CmKnownArguments]
      | CmRawReadProof => [CmCalleeResolved, CmOutsideOwner]
      | CmRawWriteProof => [CmCalleeResolved, CmOutsideOwner]
      | CmRawProcessProof => [CmCalleeResolved, CmOutsideOwner]
      | CmFailureExitProof => [CmCalleeResolved, CmCheckedProducer, CmFailurePath, CmNoRecovery, CmZeroExit]
      | CmFailureSuccessProof => [CmCheckedProducer, CmFailurePath, CmNoRecovery, CmSuccessConstructor]
      | CmIgnoredResultProof => [CmCheckedProducer, CmNoObservation]
      | CmRepeatedWorkProof => [CmCalleeResolved, CmPureExpression, CmMeaningfulCost, CmSameArguments, CmSameRegion, CmKnownArguments]
      | CmRepeatedTraversalProof => [CmCalleeResolved, CmPureExpression, CmMeaningfulCost, CmSameArguments, CmSameRegion, CmKnownArguments]
      | CmDuplicateProof => [CmSameStructure, CmContractAgreement]
      | CmNeutralNatProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmNeutralOperand]
      | CmErasingNatProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmErasingOperand]
      | CmZeroDivisorProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmZeroDivisor]
      | CmConstantNatOrderProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmNaturalOrderInvariant]
      | CmInvertedBoundsProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmInvertedBounds]
      | CmEmptyConcatProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmEmptyText]
      | CmIdentityBoolProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmBooleanIdentity]
      | CmAbsorbingBoolProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmBooleanAbsorber]
      | CmZeroListCountProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmZeroCount]
      | CmDoubleNotProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmSameOperation, CmProducerLineage, CmSameRegion, CmInvolution]
      | CmIdempotentNormalizeProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmSameOperation, CmProducerLineage, CmSameRegion, CmMeaningfulCost, CmIdempotence]
      | CmDoubleReverseProof => [CmCalleeResolved, CmKnownArguments, CmPureExpression, CmExactArity, CmSameOperation, CmProducerLineage, CmSameRegion, CmMeaningfulCost, CmInvolution]
      | CmDegenerateClampProof => cm_operand_requirements CmEqualBounds
      | CmExtremumOperandProof => cm_operand_requirements CmExtremumIdentity
      | CmTrivialPowerProof => cm_operand_requirements CmTrivialExponent
      | CmUnchangedReplaceProof => cm_operand_requirements CmUnchangedReplacement
      | CmEmptySearchProof => cm_operand_requirements CmEmptyText
      | CmTextByteBoundsProof => cm_operand_requirements CmIndexOutsideText
      | CmEmptySliceProof => cm_operand_requirements CmZeroCount
      | CmTextSliceBoundsProof => cm_operand_requirements CmIndexOutsideText
      | CmReflexiveSearchProof => cm_operand_requirements CmSameValue
      | CmKnownResultTestProof => cm_composition_requirements [CmFixedConstructor, CmTypeArgumentsAgree]
      | CmKnownResultDefaultProof => cm_composition_requirements [CmFixedConstructor, CmTypeArgumentsAgree]
      | CmExtremumAbsorptionProof => cm_composition_requirements [CmSameValue]
      | CmKnownMaybeDefaultProof => cm_composition_requirements [CmFixedConstructor, CmTypeArgumentsAgree]
      | CmLengthReverseProof => cm_composition_requirements [CmLengthPreserved, CmAllocationAvoided, CmMeaningfulCost, CmTypeArgumentsAgree]
      | CmLengthAppendProof => cm_composition_requirements [CmAllocationAvoided, CmMeaningfulCost, CmTypeArgumentsAgree]
      | CmDominatedTakeProof => cm_composition_requirements [CmCountDominance, CmMeaningfulCost, CmTypeArgumentsAgree]
      | CmDropAfterTakeProof => cm_composition_requirements [CmCountDominance, CmTypeArgumentsAgree]
      | CmContainedClampProof => cm_composition_requirements [CmBoundsContainment]
      | CmClampedRangeProof => cm_composition_requirements [CmBoundsContainment]
      | CmBooleanComplementProof => cm_composition_requirements [CmComplementaryOperands]
      | CmResultMapFailureProof => cm_result_callback_requirements
      | CmResultMapErrorSuccessProof => cm_result_callback_requirements
      | CmResultBindFailureProof => cm_result_callback_requirements
      | CmResultRecoverySuccessProof => cm_result_callback_requirements
      | CmResultFoldKnownProof => cm_result_callback_requirements
      | CmMaybeMapNothingProof => cm_result_callback_requirements
      | CmMaybeFoldKnownProof => cm_result_constructor_requirements
      | CmResultToMaybeKnownProof => cm_result_constructor_requirements
      | CmResultFromMaybeKnownProof => cm_result_constructor_requirements
      | CmResultDefaultFailureProof => cm_result_constructor_requirements
      | CmMaybeDefaultNothingProof => cm_result_constructor_requirements
      | CmResultMap2FailureProof => cm_result_callback_requirements
      | CmResultUnitFailureProof => cm_result_constructor_requirements
      | CmResultUnitIdempotentProof => cm_composition_requirements [CmIdempotence, CmTypeArgumentsAgree]
      | CmMaybeResultRoundTripProof => cm_composition_requirements [CmResultRoundTrip, CmTypeArgumentsAgree]
      | CmResultMapIdentityProof => cm_result_identity_requirements
      | CmResultMapErrorIdentityProof => cm_result_identity_requirements
      | CmMaybeMapIdentityProof => cm_result_identity_requirements
      | CmResultPathTestProof => cm_result_path_requirements
      | CmResultPathDefaultProof => cm_result_path_requirements
      | CmCollectionProof _ => cm_composition_requirements
          [CmContractAgreement, CmTypeArgumentsAgree, CmMeaningfulCost,
           CmAllocationAvoided, CmTotalCallbacks, CmCollectionEquivalence]
      | CmQualityProof law => cm_composition_requirements
          (append CmRequirement
            [CmTypeArgumentsAgree, CmCollectionLawEstablished, CmProducerUnbound, CmDynamicInput]
            (match cm_quality_cost_required law with
             | True => [CmMeaningfulCost] | False => [] end))
      end);

inductive CmEvidence : Type :=
  | CmEvidenceOf : CmRequirement -> Maybe Bool -> CmEvidence;
def cm_evidence_id (evidence : CmEvidence) : Nat :=
    match evidence with | CmEvidenceOf fact _ => cm_requirement_id fact end;
def cm_established (evidence : CmEvidence) : Bool :=
    match evidence with | CmEvidenceOf _ value => match value with
      | Nothing => False | Just yes => yes end end;
def cm_known_fact (fact : CmRequirement) (yes : Bool) : CmEvidence :=
    CmEvidenceOf(fact, Just Bool yes);

-- kind, owner module, owner declaration, subject ordinal, branch, effect epoch,
-- optional exact source-byte range, evidence, explanation. No AST/source clones.
inductive CmSemanticProof : Type :=
  | CmSemanticProofOf : CmProofKind -> Nat -> Nat -> Nat -> Nat -> Nat
      -> Maybe (Pair Nat Nat) -> List CmEvidence -> String -> CmSemanticProof;
def cm_proof_kind (proof : CmSemanticProof) : CmProofKind :=
    match proof with | CmSemanticProofOf value _ _ _ _ _ _ _ _ => value end;
def cm_proof_node (proof : CmSemanticProof) : Nat :=
    match proof with | CmSemanticProofOf _ _ _ value _ _ _ _ _ => value end;
def cm_proof_evidence (proof : CmSemanticProof) : List CmEvidence :=
    match proof with | CmSemanticProofOf _ _ _ _ _ _ _ value _ => value end;
def cm_proof_message (proof : CmSemanticProof) : String :=
    match proof with | CmSemanticProofOf _ _ _ _ _ _ _ _ value => value end;

def cm_evidence_unique : List CmEvidence -> List Nat -> Bool :=
  fix go (evidence : List CmEvidence) (seen : List Nat) : Bool :=
    match evidence with
    | Nil => True
    | Cons fact rest => andb (notb (elem Nat eq_nat (cm_evidence_id fact) seen))
        (go(rest, Cons Nat (cm_evidence_id fact) seen)) end;

def cm_proof_valid (proof : CmSemanticProof) : Bool :=
    let evidence : List CmEvidence := cm_proof_evidence proof in
    andb (cm_evidence_unique evidence [])
      (andb (all CmEvidence cm_established evidence)
        (all CmRequirement (fun (required : CmRequirement) =>
          any CmEvidence (fun (present : CmEvidence) =>
            eq_nat(cm_requirement_id required, cm_evidence_id present)) evidence)
          (cm_requirements (cm_proof_kind proof))));

def cm_proof_owned (decl : ScDecl) (proof : CmSemanticProof) : Bool :=
    match proof with | CmSemanticProofOf _ module_id owner _ _ _ _ _ _ =>
      andb(eq_nat(module_id, sc_decl_module decl), eq_nat(owner, sc_decl_name decl)) end;

-- This constructor binds evidence to the current owner and execution region.
-- Only consumers of a COMPLETED traversal may publish its result.
def cm_proof_for (kind : CmProofKind) (owner : ScDecl) (node : Nat)
    (branch : Nat) (epoch : Nat) (facts : List CmEvidence) (message : String) : CmSemanticProof :=
    CmSemanticProofOf kind (sc_decl_module owner) (sc_decl_name owner) node branch epoch
      (Nothing (Pair Nat Nat))
      (append CmEvidence [cm_known_fact CmOwnerResolved True, cm_known_fact CmSubjectKnown True,
        cm_known_fact CmTraversalComplete True] facts) message;
