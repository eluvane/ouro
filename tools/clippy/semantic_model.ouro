-- Compact shared semantic facts. No source strings, Expr clones or ASTs are
-- stored in facts. Value aliases share an identity; lexical binders do not.
import "semantic_contracts.ouro";
import "semantic_proof.ouro";
import "structural_rules.ouro";
import "structural_model.ouro";
import "../../std/natx.ouro";
import "../../compiler/semantic_scope.ouro";

-- Values: 0 unknown, 1 local value, 2 global value, 3 Nat, 4 String,
-- 5 small list, 6 call result, 7 failure, 8 success, 9 lambda, 10 recursion.
-- 14 must-observe checked result. Its ID is the producer, shared by aliases.
-- An IO wrapper is not an executed result; obligations activate on execution.
inductive CmValue : Type :=
  | CmValueOf : Nat -> Nat -> Nat -> Bool -> Bool -> Bool -> CmValue;

def cm_value_kind (item : CmValue) : Nat :=
    match item with | CmValueOf value _ _ _ _ _ => value end;

def cm_value_id (item : CmValue) : Nat :=
    match item with | CmValueOf _ value _ _ _ _ => value end;

def cm_value_result (item : CmValue) : Nat :=
    match item with | CmValueOf _ _ value _ _ _ => value end;

def cm_value_io (item : CmValue) : Bool :=
    match item with | CmValueOf _ _ _ value _ _ => value end;

def cm_value_taint (item : CmValue) : Bool :=
    match item with | CmValueOf _ _ _ _ value _ => value end;

def cm_value_constant (item : CmValue) : Bool :=
    match item with | CmValueOf _ _ _ _ _ value => value end;

def cm_unknown (id : Nat) : CmValue := CmValueOf 0 id 0 False False False;
def cm_local_value (id : Nat) (result : Nat) : CmValue :=
    CmValueOf 1 id (mod_nat result 10) (leb_nat 10 result) False False;
def cm_value_key (value : CmValue) : String :=
    prim_string_concat (prim_string_of_nat (cm_value_kind value))
      (prim_string_concat ":" (prim_string_concat (prim_string_of_nat (cm_value_id value))
        (prim_string_concat ":" (prim_string_concat (prim_string_of_nat (cm_value_result value))
          (match cm_value_io value with | True => ":io" | False => ":value" end)))));
def cm_unwrap_io (value : CmValue) : CmValue :=
    match value with | CmValueOf kind id result _ taint constant =>
      CmValueOf kind id result False taint constant end;

def cm_as_io (value : CmValue) : CmValue :=
    match value with | CmValueOf kind id result _ taint constant =>
      CmValueOf kind id result True taint constant end;

inductive ClippyBindingFact : Type :=
  | CmBinding : Nat -> Nat -> CmValue -> ClippyBindingFact;

def cm_binding_name (item : ClippyBindingFact) : Nat :=
    match item with | CmBinding value _ _ => value end;

def cm_binding_id (item : ClippyBindingFact) : Nat :=
    match item with | CmBinding _ value _ => value end;

def cm_binding_value (item : ClippyBindingFact) : CmValue :=
    match item with | CmBinding _ _ value => value end;

inductive ClippyCallFact : Type :=
  | CmCall : Nat -> Nat -> Nat -> Nat -> Nat -> Bool -> Nat -> List CmValue -> Bool -> ClippyCallFact;

def cm_call_node (item : ClippyCallFact) : Nat :=
    match item with | CmCall value _ _ _ _ _ _ _ _ => value end;

def cm_call_callee (item : ClippyCallFact) : Nat :=
    match item with | CmCall _ value _ _ _ _ _ _ _ => value end;

def cm_call_branch (item : ClippyCallFact) : Nat :=
    match item with | CmCall _ _ value _ _ _ _ _ _ => value end;

def cm_call_epoch (item : ClippyCallFact) : Nat :=
    match item with | CmCall _ _ _ value _ _ _ _ _ => value end;

def cm_call_role (item : ClippyCallFact) : Nat :=
    match item with | CmCall _ _ _ _ value _ _ _ _ => value end;

def cm_call_pure (item : ClippyCallFact) : Bool :=
    match item with | CmCall _ _ _ _ _ value _ _ _ => value end;

def cm_call_cost (item : ClippyCallFact) : Nat :=
    match item with | CmCall _ _ _ _ _ _ value _ _ => value end;

def cm_call_args (item : ClippyCallFact) : List CmValue :=
    match item with | CmCall _ _ _ _ _ _ _ value _ => value end;

def cm_call_recursive (item : ClippyCallFact) : Bool :=
    match item with | CmCall _ _ _ _ _ _ _ _ value => value end;

-- Flow kinds: 1 created, 2 bound, 3 matched, 4 propagated, 5 discarded,
-- 6 rendered, 7 lost, 8 failure converted to success, 9 explicit fallback.
inductive ClippyResultFlow : Type :=
  | CmFlow : Nat -> Nat -> Nat -> ClippyResultFlow;

inductive ClippyTraversalFact : Type :=
  | CmTraversal : Nat -> Nat -> Nat -> String -> ClippyTraversalFact;
inductive ClippyRecursionFact : Type :=
  | CmRecursion : Nat -> Nat -> List CmValue -> ClippyRecursionFact;
inductive ClippyWrapperFact : Type :=
  | CmWrapper : Nat -> Nat -> List Nat -> Bool -> ClippyWrapperFact;

inductive CmEvent : Type :=
  | CmCallEvent : ClippyCallFact -> CmEvent
  | CmBindEvent : ClippyBindingFact -> CmEvent
  | CmUseEvent : Nat -> CmEvent
  | CmFlowEvent : ClippyResultFlow -> CmEvent
  | CmTraversalEvent : ClippyTraversalFact -> CmEvent
  | CmRecursionEvent : ClippyRecursionFact -> CmEvent
  | CmWrapperEvent : ClippyWrapperFact -> CmEvent
  | CmFinding : CmSemanticProof -> CmEvent
  | CmToken : Nat -> Nat -> CmEvent;

inductive CmState : Type :=
  | CmStateOf : Nat -> Nat -> List CmEvent -> CmState;

def cm_fresh (item : CmState) : Nat :=
    match item with | CmStateOf value _ _ => value end;

def cm_epoch (item : CmState) : Nat :=
    match item with | CmStateOf _ value _ => value end;

def cm_events (item : CmState) : List CmEvent :=
    match item with | CmStateOf _ _ value => value end;

def cm_event (event : CmEvent) (state : CmState) : CmState :=
    match state with | CmStateOf fresh epoch events =>
      CmStateOf fresh epoch (Cons CmEvent event events) end;
def cm_next (state : CmState) : CmState :=
    match state with | CmStateOf fresh epoch events => CmStateOf (add fresh 1) epoch events end;
def cm_barrier (state : CmState) : CmState :=
    match state with | CmStateOf fresh epoch events => CmStateOf fresh (add epoch 1) events end;
def cm_token (alpha : Nat) (exact : Nat) (state : CmState) : CmState :=
    cm_event (CmToken alpha exact) state;
def cm_tag (tag : Nat) (state : CmState) : CmState := cm_token tag tag state;
def cm_finding (proof : CmSemanticProof) (state : CmState) : CmState :=
    match cm_proof_valid proof with
    | True => cm_event (CmFinding proof) state | False => state end;

inductive CmContext : Type :=
  | CmContextOf : ScDecl -> List ClippyBindingFact -> Nat -> Bool -> Maybe Nat -> Bool -> Bool -> Nat -> CmContext;

def cm_owner (item : CmContext) : ScDecl :=
    match item with | CmContextOf value _ _ _ _ _ _ _ => value end;

def cm_env (item : CmContext) : List ClippyBindingFact :=
    match item with | CmContextOf _ value _ _ _ _ _ _ => value end;

def cm_branch (item : CmContext) : Nat :=
    match item with | CmContextOf _ _ value _ _ _ _ _ => value end;

def cm_error_arm (item : CmContext) : Bool :=
    match item with | CmContextOf _ _ _ value _ _ _ _ => value end;

def cm_self (item : CmContext) : Maybe Nat :=
    match item with | CmContextOf _ _ _ _ value _ _ _ => value end;

def cm_policy (item : CmContext) : Bool :=
    match item with | CmContextOf _ _ _ _ _ value _ _ => value end;

def cm_context_env (ctx : CmContext) (env : List ClippyBindingFact) : CmContext :=
    match ctx with | CmContextOf owner _ branch error self policy subject epoch =>
      CmContextOf owner env branch error self policy subject epoch end;
def cm_context_arm (ctx : CmContext) (branch : Nat) (error : Bool) : CmContext :=
    match ctx with | CmContextOf owner env _ outer self policy subject epoch =>
      CmContextOf owner env branch (orb outer error) self policy subject epoch end;
def cm_context_self (ctx : CmContext) (self : Nat) : CmContext :=
    match ctx with | CmContextOf owner env branch error _ policy subject epoch =>
      CmContextOf owner env branch error (Just Nat self) policy subject epoch end;

def cm_binding_lookup (name : Nat) : List ClippyBindingFact -> Maybe ClippyBindingFact :=
  fix go (env : List ClippyBindingFact) : Maybe ClippyBindingFact :=
    match env with
    | Nil => Nothing ClippyBindingFact
    | Cons binding rest => match eq_nat name (cm_binding_name binding) with
      | True => Just ClippyBindingFact binding
      | False => go rest
      end
    end;

-- Emit alpha/exact binder tokens once, assigning a fresh identity even when a
-- spelling shadows another binder. Alias VALUES retain their original keys.
def cm_bind (name : Nat) (value : CmValue) (ctx : CmContext) (state : CmState)
    : Pair CmContext CmState :=
    let id : Nat := cm_fresh state in
    let binding : ClippyBindingFact := CmBinding name id value in
    MkPair CmContext CmState
      (cm_context_env ctx (Cons ClippyBindingFact binding (cm_env ctx)))
      (cm_event (CmBindEvent binding) (cm_token id name (cm_next state)));

def cm_bind_names : List Nat -> Bool -> CmContext -> CmState -> Pair CmContext CmState :=
  fix go (names : List Nat) (taint : Bool) (ctx : CmContext) (state : CmState)
      : Pair CmContext CmState :=
    match names with
    | Nil => MkPair CmContext CmState ctx state
    | Cons name rest =>
        let value : CmValue := CmValueOf 1 (cm_fresh state) 0 False taint False in
        match cm_bind name value ctx state with
        | MkPair bound updated => go rest taint bound updated
        end
    end;

def cm_checked (value : CmValue) : Bool :=
    andb (eq_nat (cm_value_kind value) 14)
      (andb (eq_nat (cm_value_result value) 1) (notb (cm_value_io value)));

def cm_args_key (arguments : List CmValue) : String :=
    (fix go (args : List CmValue) (out : String) : String :=
      match args with
      | Nil => out
      | Cons value rest => go rest (prim_string_concat out
          (prim_string_concat ";" (cm_value_key value)))
      end) arguments "";

def cm_args_dynamic (arguments : List CmValue) : Bool :=
    any CmValue (fun (value : CmValue) => notb (cm_value_constant value)) arguments;

def cm_last_value (arguments : List CmValue) : CmValue :=
    (fix go (args : List CmValue) (last : CmValue) : CmValue :=
      match args with
      | Nil => last
      | Cons value rest => go rest value
      end) arguments (cm_unknown 0);

def cm_type_annotation (unit : ClippySemanticUnit) (ctx : CmContext) (ty : Maybe Expr)
    : Either QualityInputError Nat :=
    match ty with
    | Nothing => Right QualityInputError Nat 0
    | Just term => cm_type_class unit cm_type_alias_fuel
        (map ClippyBindingFact Nat cm_binding_name (cm_env ctx)) term
    end;

-- Executable names must resolve. Dynamic local calls remain dynamic (and
-- effectful); an unbound name cannot silently become a lexical call guess.
def cm_variable (unit : ClippySemanticUnit) (apis : CmApiIndex)
    (ctx : CmContext) (name : Nat) (state : CmState)
    : Either QualityInputError (Pair CmValue CmState) :=
    match cm_binding_lookup name (cm_env ctx) with
    | Just binding => Right QualityInputError (Pair CmValue CmState)
        (MkPair CmValue CmState (cm_binding_value binding)
          (cm_event (CmUseEvent (cm_binding_id binding))
            (cm_token (cm_binding_id binding) name (cm_tag 101 state))))
    | Nothing => match cm_api_lookup name apis with
      | Nothing => Left QualityInputError (Pair CmValue CmState)
          (QualityInvalidInput (prim_string_concat "unresolved executable declaration: " (cm_name (cm_intern unit) name)))
      | Just api => Right QualityInputError (Pair CmValue CmState)
          (MkPair CmValue CmState
            (CmValueOf 2 name
              (match eq_nat (cm_api_arity api) 0 with
               | True => mod_nat (cm_api_result api) 10 | False => 0 end)
              (andb (eq_nat (cm_api_arity api) 0) (leb_nat 10 (cm_api_result api))) False True)
            (cm_tag name (cm_tag 102 state)))
      end
    end;

-- Entering a lambda/fix body is a new execution region, not an immediate
-- continuation of an enclosing failure arm. Preserve captures, not path facts.
def cm_context_region (ctx : CmContext) (branch : Nat) : CmContext :=
    match ctx with | CmContextOf owner env _ _ self policy _ _ =>
      CmContextOf owner env branch False self policy False 0 end;

-- A Left pattern alone says nothing about failure: Either is also a sum type.
def cm_subject_checked (ctx : CmContext) : Bool :=
    match ctx with | CmContextOf _ _ _ _ _ _ checked _ => checked end;

def cm_context_subject (ctx : CmContext) (value : CmValue) : CmContext :=
    match ctx with | CmContextOf owner env branch error self policy _ epoch =>
      CmContextOf owner env branch error self policy (cm_checked value) epoch end;

-- Explicit success of a newly checked operation is a recovery boundary.
def cm_context_pattern (ctx : CmContext) (role : Nat) : CmContext :=
    match ctx with | CmContextOf owner env branch outer self policy subject epoch =>
      CmContextOf owner env branch
        (match andb subject (eq_nat role 11) with
         | True => False | False => orb outer (andb subject (eq_nat role 10)) end)
        self policy False epoch end;

-- Observation/escape belongs to VALUE identity, never to a binder spelling.
def cm_observe (kind : Nat) (node : Nat) (value : CmValue) (state : CmState) : CmState :=
    match eq_nat (cm_value_kind value) 14 with
    | False => state
    | True => cm_event (CmFlowEvent (CmFlow node kind (cm_value_id value))) state
    end;

def cm_execute (node : Nat) (value : CmValue) (state : CmState) : CmState :=
    match cm_checked value with
    | False => state
    | True => cm_observe 1 node value state
    end;

-- A failure-path proof is valid only before an intervening effect/recovery
-- boundary. Epoch equality is constant-time and reused by exit/Result rules.
def cm_error_epoch (ctx : CmContext) : Nat :=
    match ctx with | CmContextOf _ _ _ _ _ _ _ epoch => epoch end;

def cm_context_failure_epoch (ctx : CmContext) (epoch : Nat) : CmContext :=
    match ctx with | CmContextOf owner env branch error self policy subject _ =>
      CmContextOf owner env branch error self policy subject epoch end;

def cm_unrecovered_error (ctx : CmContext) (state : CmState) : Bool :=
    andb (cm_error_arm ctx) (eq_nat (cm_error_epoch ctx) (cm_epoch state));

-- An identity for an unavailable value is not an equivalence proof.
def cm_value_known (value : CmValue) : Bool :=
    notb (eq_nat (cm_value_kind value) 0);
