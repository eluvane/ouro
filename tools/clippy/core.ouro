-- Reporting helpers only. Diagnostic decisions belong to the compiler-owned
-- structural/semantic worker; lexical text is used solely to anchor messages
-- and read explicit suppression directives.
import "../quality/registry_model.ouro";
import "../../std/collections.ouro";

def cg_add (xs : List QrFinding) (f : QrFinding) : List QrFinding :=
    Cons QrFinding f xs;

def cg_place (path : String) (line : Nat) (col : Nat) : QrPlace :=
    MkQrPlace path (qt_min1 line) (qt_min1 col);

def cg_hit (mp : List (Pair String QrClippy)) (profile : String)
    (code : String) (path : String) (line : Nat) (col : Nat)
    (witness : String) (suffix : String) : QrFinding :=
    match qr_lookup_clip mp code with
    | Nothing =>
        MkQrFinding code "fatal" (cg_place path line col)
          (qt_cat3 "Unregistered native Clippy rule: " code "; analysis is incomplete.")
          "Restore the rule inventory matching this native executable and rerun; do not suppress this failure."
          "clippy" code (qt_strip witness) (Nothing String)
    | Just _ => qr_mk_clip mp profile code (cg_place path line col) witness suffix
    end;

def cg_code (line : String) : String :=
    qt_code_before_comment line;

def cg_def_name (header : String) : Maybe String :=
    let i : Nat := qt_skip_ws header 0 in
    match qt_at_word header i "def" with
    | False => Nothing String
    | True => qt_ident_at header (qt_skip_ws header (add i 3))
    end;

def cg_word_col (s : String) (word : String) : Nat :=
    match qt_find s word with
    | Nothing => 1
    | Just i => add i 1
    end;


def cg_unique (xs : List String) : List String :=
    dedup_adjacent String prim_string_eq
      (quality_sort String prim_string_le xs);


inductive CgDef : Type :=
  | MkCgDef : String -> Nat -> CgDef;

def cg_def_name_of (d : CgDef) : String :=
    match d with | MkCgDef name _ => name end;

def cg_def_line (d : CgDef) : Nat :=
    match d with | MkCgDef _ line => line end;

-- One source-line pass, no body copies and no per-definition source rescans.
-- This is an approximate owner anchor, never a semantic expression span.
def cg_iter_defs (lines : List String) : List CgDef :=
    (fix go (remaining : List String) (line : Nat) (rev : List CgDef) : List CgDef :=
      match remaining with
      | Nil => reverse_lin CgDef rev
      | Cons text rest => match cg_def_name (cg_code text) with
        | Nothing => go rest (add line 1) rev
        | Just name => go rest (add line 1) (Cons CgDef (MkCgDef name line) rev)
        end
      end) lines 1 [];
