-- Native owner for scripts/clippy_grade_firewall.py.
-- This unit stays on the core/registry/json cone. Frontend proofs come from
-- the already-built compiler/semantic companion and its source snapshot.

import "scan_surface.ouro",
  "session_wire.ouro",
  "process_surface.ouro",
  "../strict/walk.ouro",
  "../quality/input_error.ouro",
  "../quality/registry.ouro",
  "../../std/io.ouro",
  "../../std/json_types.ouro",
  "../../std/listx.ouro";

def cg_cat3 (a : String) (b : String) (c : String) : String :=
    prim_string_concat(a, prim_string_concat b c);

def cg_cat4 (a : String) (b : String) (c : String) (d : String) : String :=
    prim_string_concat(a, cg_cat3 b c d);

def cg_default_report : String :=
    "_build/quality/clippy-grade-firewall.json";

def cg_default_sarif : String :=
    "_build/quality/clippy-grade-firewall.sarif";

inductive CgOpts : Type :=
  | MkCgOpts : String -> List String -> String -> Bool -> String -> String
      -> Bool -> Bool -> Bool -> Bool -> CgOpts;

def cg_opts0 : CgOpts :=
    MkCgOpts "project" (Nil String) "" False cg_default_report cg_default_sarif
      False False False False;

def cg_o_profile (o : CgOpts) : String :=
    match o with | MkCgOpts p _ _ _ _ _ _ _ _ _ => p end;

def cg_o_scopes (o : CgOpts) : List String :=
    match o with | MkCgOpts _ s _ _ _ _ _ _ _ _ => s end;

def cg_o_root (o : CgOpts) : String :=
    match o with | MkCgOpts _ _ r _ _ _ _ _ _ _ => r end;

def cg_o_fixtures (o : CgOpts) : Bool :=
    match o with | MkCgOpts _ _ _ f _ _ _ _ _ _ => f end;

def cg_o_report (o : CgOpts) : String :=
    match o with | MkCgOpts _ _ _ _ r _ _ _ _ _ => r end;

def cg_o_sarif (o : CgOpts) : String :=
    match o with | MkCgOpts _ _ _ _ _ s _ _ _ _ => s end;

def cg_o_warn (o : CgOpts) : Bool :=
    match o with | MkCgOpts _ _ _ _ _ _ w _ _ _ => w end;

def cg_o_list (o : CgOpts) : Bool :=
    match o with | MkCgOpts _ _ _ _ _ _ _ l _ _ => l end;

def cg_o_validate (o : CgOpts) : Bool :=
    match o with | MkCgOpts _ _ _ _ _ _ _ _ v _ => v end;

def cg_o_companion (o : CgOpts) : Bool :=
    match o with | MkCgOpts _ _ _ _ _ _ _ _ _ c => c end;

def cg_set_profile (o : CgOpts) (v : String) : CgOpts :=
    match o with
    | MkCgOpts _ s r f a b w l d c => MkCgOpts v s r f a b w l d c
    end;

def cg_add_scope (o : CgOpts) (v : String) : CgOpts :=
    match o with
    | MkCgOpts p s r f a b w l d c =>
        MkCgOpts p (snoc String s v) r f a b w l d c
    end;

def cg_set_sroot (o : CgOpts) (v : String) : CgOpts :=
    match o with
    | MkCgOpts p s _ f a b w l d c => MkCgOpts p s v f a b w l d c
    end;

def cg_set_fix (o : CgOpts) : CgOpts :=
    match o with
    | MkCgOpts p s r _ a b w l d c => MkCgOpts p s r True a b w l d c
    end;

def cg_set_report (o : CgOpts) (v : String) : CgOpts :=
    match o with
    | MkCgOpts p s r f _ b w l d c => MkCgOpts p s r f v b w l d c
    end;

def cg_set_sarif (o : CgOpts) (v : String) : CgOpts :=
    match o with
    | MkCgOpts p s r f a _ w l d c => MkCgOpts p s r f a v w l d c
    end;

def cg_set_warn (o : CgOpts) : CgOpts :=
    match o with
    | MkCgOpts p s r f a b _ l d c => MkCgOpts p s r f a b True l d c
    end;

def cg_set_list (o : CgOpts) : CgOpts :=
    match o with
    | MkCgOpts p s r f a b w _ d c => MkCgOpts p s r f a b w True d c
    end;

def cg_set_validate (o : CgOpts) : CgOpts :=
    match o with
    | MkCgOpts p s r f a b w l _ c => MkCgOpts p s r f a b w l True c
    end;

def cg_set_companion (o : CgOpts) : CgOpts :=
    match o with
    | MkCgOpts p s r f a b w l d _ => MkCgOpts p s r f a b w l d True
    end;

def cg_worker_name : String :=
    "ouro-clippy-structural";

def cg_is_sep (c : Nat) : Bool :=
    orb(eq_nat c 47, eq_nat c 92);

def cg_last_sep : List Nat -> Nat -> Maybe Nat :=
  fix go (cs : List Nat) (i : Nat) : Maybe Nat :=
    match cs with
    | Nil => Nothing Nat
    | Cons c rest =>
        match go(rest, add i 1) with
        | Just later => Just Nat later
        | Nothing => match cg_is_sep c with
          | True => Just Nat i
          | False => Nothing Nat
          end
        end
    end;

def cg_dirname (path : String) : String :=
    match cg_last_sep(prim_string_to_char_codes path, 0) with
    | Nothing => "."
    | Just index =>
        match orb (eq_nat index 0)
            (andb (eq_nat index 2)
              (prim_string_eq(prim_string_slice path 1 1, ":"))) with
        | True => prim_string_slice path 0 (add index 1)
        | False => prim_string_slice path 0 index
        end
    end;

def cg_join (dir : String) (name : String) : String :=
    match prim_string_length dir with
    | Z => name
    | S last => match cg_is_sep (prim_string_byte_at dir last) with
      | True => prim_string_concat dir name
      | False => prim_string_concat(dir, prim_string_concat "/" name)
      end
    end;

def cg_missing_worker : String :=
    prim_string_concat "structural companion unavailable: expected "
      (prim_string_concat cg_worker_name " next to the firewall image");

def cg_choose_worker (windows : String) (base : String) (win : Bool) (posix : Bool)
    : Either QualityInputError String :=
    match win with
    | True => Right QualityInputError String windows
    | False => match posix with
      | True => Right QualityInputError String base
      | False => Left QualityInputError String (QualityInvalidInput cg_missing_worker)
      end
    end;

def cg_pick_worker (base : String) : IO (Either QualityInputError String) :=
    let windows : String := prim_string_concat base ".exe" in
    do let! win := prim_fs_exists windows;
       let! posix := prim_fs_exists base;
       io_pure(Either QualityInputError String, cg_choose_worker windows base win posix)

def cg_locate_worker : IO (Either QualityInputError String) :=
    do let! argv := prim_argv;
       cg_pick_worker (cg_join(cg_dirname (nth String "" 0 argv), cg_worker_name))

def cg_worker_fail (result : ProcResult) : String :=
    match prim_string_length (proc_stderr result) with
    | Z => prim_string_concat "structural companion failed with status "
        (prim_string_of_nat (proc_code result))
    | S _ => proc_stderr result
    end;

def cg_worker_reply (result : ProcResult) : Either QualityInputError (Pair String (List CgSProof)) :=
    match andb(proc_ok result, eq_nat(prim_string_length (proc_stderr result), 0)) with
    | False => Left QualityInputError (Pair(String, List CgSProof))
        (QualityInvalidInput (cg_worker_fail result))
    | True => scan_parse_reply (proc_stdout result)
    end;

def cg_process_fail (error : String) : String :=
    error;

def cg_worker_recycle : Nat := cg_session_max_roots;

def cg_take_paths (n : Nat) (xs : List String) : List String :=
    cg_session_take n xs;

def cg_drop_paths (n : Nat) (xs : List String) : List String :=
    cg_session_drop n xs;

def cg_structural_query (worker : String) (source_root : String) (path : String)
    : IO (Either QualityInputError (Pair String (List CgSProof))) :=
    do let! ran := cg_run_checked worker [source_root, qr_rel source_root path];
       io_pure (Either(QualityInputError, Pair(String, List CgSProof)))
         (match ran with
          | Left error => Left QualityInputError (Pair(String, List CgSProof))
              (QualityInvalidInput (cg_process_fail error))
          | Right result => cg_worker_reply result
          end)

-- Validate the completed option set so flag order cannot weaken a profile.
-- Advisory mode is a compatibility feature, not permission for incomplete
-- analysis or for strict/release to return success on blocking findings.
def cg_validate_opts (opts : CgOpts) : Either QualityInputError CgOpts :=
    match elem String prim_string_eq (cg_o_profile opts) scan_expected_profiles with
    | False => Left QualityInputError CgOpts
        (QualityInvalidInput (prim_string_concat("unknown profile: ", cg_o_profile opts)))
    | True =>
        match andb (cg_o_warn opts)
            (elem String prim_string_eq (cg_o_profile opts)
              ([ "strict", "release" ] : List String)) with
        | True => Left QualityInputError CgOpts
            (QualityInvalidInput "--warn-only is not permitted with strict or release")
        | False =>         match andb(cg_o_list opts, cg_o_validate opts) with
          | True => Left QualityInputError CgOpts
              (QualityInvalidInput "--list-rules and --validate-rules are mutually exclusive")
          | False => match andb (cg_o_companion opts)
                (orb(cg_o_warn opts, orb(cg_o_list opts, cg_o_validate opts))) with
            | True => Left QualityInputError CgOpts
                (QualityInvalidInput "--lint-companion cannot be combined with --warn-only, --list-rules, or --validate-rules")
            | False => Right QualityInputError CgOpts opts
            end
          end
        end
    end;

def cg_parse : List String -> CgOpts -> Either QualityInputError CgOpts :=
  fix go (ws : List String) (acc : CgOpts) : Either QualityInputError CgOpts :=
    match ws with
    | Nil => cg_validate_opts acc
    | Cons w rest =>
        match prim_string_eq w "--include-fixtures" with
        | True => go(rest, cg_set_fix acc)
        | False => match prim_string_eq w "--warn-only" with
          | True => go(rest, cg_set_warn acc)
          | False => match prim_string_eq w "--list-rules" with
            | True => go(rest, cg_set_list acc)
            | False => match prim_string_eq w "--validate-rules" with
              | True => go(rest, cg_set_validate acc)
              | False => match prim_string_eq w "--lint-companion" with
                | True => go(rest, cg_set_companion acc)
                | False =>
                  match rest with
                  | Nil => Left QualityInputError CgOpts
                      (QualityInvalidInput (prim_string_concat "missing value for " w))
                  | Cons v more =>
                      match prim_string_length v with
                      | Z => Left QualityInputError CgOpts (QualityInvalidInput (prim_string_concat "empty value for " w))
                      | S _ =>
                          match prim_string_eq w "--profile" with
                          | True => go(more, cg_set_profile acc v)
                          | False => match prim_string_eq w "--scope" with
                            | True => go(more, cg_add_scope acc v)
                            | False => match prim_string_eq w "--source-root" with
                              | True => go(more, cg_set_sroot acc v)
                              | False => match prim_string_eq w "--report" with
                                | True => go(more, cg_set_report acc v)
                                | False => match prim_string_eq w "--sarif" with
                                  | True => go(more, cg_set_sarif acc v)
                                  | False => Left QualityInputError CgOpts
                                      (QualityInvalidInput (prim_string_concat "unknown option " w))
                                  end
                                end
                              end
                            end
                          end
                      end
                  end
                end
              end
            end
          end
        end
    end;

def cg_fail (msg : String) : IO Unit :=
    do eprintln (prim_string_concat "CLIPPY_GRADE_FIREWALL: FAIL " msg);
       exit 1

def cg_print_inv : List String -> IO Unit :=
  fix go (xs : List String) : IO Unit :=
    match xs with
    | Nil => io_pure Unit MkUnit
    | Cons issue rest =>
        do eprintln (prim_string_concat "RULE_INVENTORY_ISSUE " issue);
           go rest
    end;

def cg_print_findings : List QrFinding -> IO Unit :=
  fix go (xs : List QrFinding) : IO Unit :=
    match xs with
    | Nil => io_pure Unit MkUnit
    | Cons f rest =>
        match qr_find_mark f with
        | Just _ => go rest
        | Nothing =>
            do quality_print_lines (qr_print_finding_lines f "fix");
               go rest
        end
    end;

def cg_list_rules (mp : List (Pair String QrClippy)) (profile : String)
    : IO Unit :=
    let codes : List String :=
      quality_sort String prim_string_le
        (map (Pair String QrClippy) String
          (fun (p : Pair String QrClippy) => fst String QrClippy p) mp) in
    (fix go (xs : List String) : IO Unit :=
      match xs with
      | Nil => io_pure Unit MkUnit
      | Cons code rest =>
          match qr_lookup_clip mp code with
          | Nothing => cg_fail (prim_string_concat "rule inventory lost rule: " code)
          | Just item =>
              do println (prim_string_concat
                    (cg_cat4 code "\t" (qr_clip_family item) "\t")
                    (cg_cat3 (qr_clip_level mp code profile) "\t"
                      (qr_clip_title item)));
                 go rest
          end
      end) codes;

def cg_sarif (root : String) (source_root : String)
    (findings : List QrFinding) : Json :=
    JObj
      [ qr_jarr "runs"
          [ JObj
              [ qr_jobj "properties"
                  [ qr_jstr("sourceRoot", qr_rel root source_root) ]
              , qr_jarr "results"
                  (map QrFinding Json (fun (f : QrFinding) =>
                    qr_sarif_result f (qr_clip_blocks f)
                      (prim_string_concat(" Fix: ", qr_find_fix f)))
                    (qr_visible findings))
              , qr_jobj "tool"
                  [ qr_jobj "driver"
                      [ qr_jstr "name" "ouro-clippy-grade-firewall" ]
                  ]
              ]
          ]
      , qr_jstr "version" "2.1.0"
      ];

def cg_report_json (root : String) (source_root : String) (opts : CgOpts)
    (scopes : List String) (files : Nat) (mp : List (Pair String QrClippy))
    (findings : List QrFinding) (issues : List String) : Json :=
    let visible : List QrFinding := qr_visible findings in
    let blocking : List QrFinding :=
      filter QrFinding qr_clip_blocks findings in
    let passed : Bool := match blocking with
      | Nil => match issues with | Nil => True | Cons _ _ => False end
      | Cons _ _ => False
      end in
    JObj
      [ qr_jnum("diagnostics_blocking", length QrFinding blocking)
      , qr_jnum("diagnostics_total", length QrFinding visible)
      , qr_jnum("family_count", length(String, scan_families mp))
      , qr_jarr("findings", map QrFinding Json qr_clip_finding_json findings)
      , qr_jnum "files_scanned" files
      , qr_jstr "kind" "ouro.clippy-grade-firewall-report.v1"
      , qr_jbool "pass" passed
      , qr_jstr("profile", cg_o_profile opts)
      , qr_jnum("rule_count", length(Pair String QrClippy, mp))
      , qr_jarr("scopes", qr_str_items scopes)
      , qr_jstr("source_root", qr_rel root source_root)
      , qr_jarr("validation_issues", qr_str_items issues)
      , qr_jbool("warn_only", cg_o_warn opts)
      ];

def cg_verify_paths (root : String) : List String -> IO Unit :=
  fix go (paths : List String) : IO Unit :=
    match paths with
    | Nil => io_pure Unit MkUnit
    | Cons path rest =>
        do let! kind := prim_fs_kind path;
           match eq_nat kind 1 with
           | False => cg_fail (prim_string_concat("unreadable ", qr_rel root path))
           | True => go rest
           end
    end;

-- The host seam releases captured wire bytes and decoder temporaries after
-- one process. Completed findings, not source/proof histories, survive it.
def cg_scan_chunk_request
    (request : Pair String (Pair String (List String)))
    (state : Pair CgWireConfig (List QrFinding))
    : IO (Either QualityInputError (Pair (List QrFinding) Nat)) :=
    match request with
    | MkPair worker selected => match selected with
      | MkPair source_root paths => match state with
        | MkPair config acc => match paths with
          | Nil => io_pure (Either(QualityInputError, Pair(List QrFinding, Nat)))
              (Left QualityInputError (Pair(List QrFinding, Nat)) cg_wire_error)
          | Cons path rest => match rest with
            | Nil =>
                do let! one := cg_structural_query worker source_root path;
                   io_pure (Either(QualityInputError, Pair(List QrFinding, Nat)))
                     (match one with
                      | Left error => match config with
                        | MkCgWireConfig mp profile root _ =>
                            Right QualityInputError (Pair(List QrFinding, Nat))
                              (MkPair (List QrFinding) Nat
                                (append QrFinding (scan_file mp profile root source_root path ""
                                  (Left QualityInputError (List CgSProof) error)) acc) 1)
                        end
                      | Right snapshot => match snapshot with
                        | MkPair text proofs => match config with
                          | MkCgWireConfig mp profile root _ =>
                              Right QualityInputError (Pair(List QrFinding, Nat))
                                (MkPair (List QrFinding) Nat
                                  (append QrFinding
                                    (scan_file mp profile root source_root path text
                                      (Right QualityInputError (List CgSProof) proofs)) acc) 1)
                          end
                        end
                      end)
            | Cons _ _ =>
                let relative : List String := map String String (qr_rel source_root) paths in
                do let! ran := cg_run_checked worker
                     (Cons String "--session" (Cons String source_root relative));
                   io_pure (Either(QualityInputError, Pair(List QrFinding, Nat)))
                     (match ran with
                      | Left error => Left QualityInputError (Pair(List QrFinding, Nat))
                          (QualityInvalidInput (cg_process_fail error))
                      | Right result => match andb (leb_nat(proc_code result, 1))
                          (eq_nat(prim_string_length (proc_stderr result), 0)) with
                        | False => Left QualityInputError (Pair(List QrFinding, Nat))
                            (QualityInvalidInput (cg_worker_fail result))
                        | True => match cg_wire_session config relative (proc_stdout result) acc with
                          | Left error => Left QualityInputError (Pair(List QrFinding, Nat)) error
                          | Right reply => match reply with
                            | MkCgWireResult found count passed => match eq_nat (proc_code result)
                                (match passed with | True => 0 | False => 1 end) with
                              | False => Left QualityInputError (Pair(List QrFinding, Nat))
                                  (QualityInvalidInput (cg_worker_fail result))
                              | True => Right QualityInputError (Pair(List QrFinding, Nat))
                                  (MkPair (List QrFinding) Nat found count)
                              end
                            end
                          end
                        end
                      end)
            end
          end
        end
      end
    end;

def cg_scan_many (worker : String) (mp : List (Pair String QrClippy))
    (profile : String) (root : String) (source_root : String)
    (paths : List String) (acc : List QrFinding) : IO (List QrFinding) :=
    let config : CgWireConfig := MkCgWireConfig mp profile root source_root in
    (fix go (fuel : Nat) (pending : List String) (found : List QrFinding)
        : IO (List QrFinding) :=
      match pending with
      | Nil => io_pure(List QrFinding, qr_sort_findings found)
      | Cons _ _ => match fuel with
        | Z =>
            do let! _e := cg_fail "semantic session supervisor made no progress";
               io_pure(List QrFinding, Nil QrFinding)
        | S remaining =>
            let chunk : List String := cg_take_paths cg_worker_recycle pending in
            do let! _v := cg_verify_paths root chunk;
               let! reply := cg_scan_chunk_request
                 (MkPair String (Pair(String, List String)) worker
                   (MkPair String (List String) source_root chunk))
                 (MkPair CgWireConfig (List QrFinding) config found);
               match reply with
               | Left error =>
                   do let! _e := cg_fail (prim_string_concat "semantic session failed: "
                        (quality_input_message error));
                      io_pure(List QrFinding, Nil QrFinding)
               | Right result => match result with
                 | MkPair next count => match andb (ltb_nat 0 count)
                     (leb_nat(count, length String chunk)) with
                   | False =>
                       do let! _e := cg_fail "semantic session returned an invalid completion count";
                          io_pure(List QrFinding, Nil QrFinding)
                   | True => go remaining (cg_drop_paths count pending) next
                   end
                 end
               end
        end
      end) (length String paths) paths acc;

def cg_status_line (root : String) (opts : CgOpts) (files : Nat)
    (mp : List (Pair String QrClippy)) (blocking : List QrFinding)
    (passed : Bool) (report_path : String) : String :=
    cg_cat3 "CLIPPY_GRADE_FIREWALL: "
      (match passed with | True => "PASS" | False => "FAIL" end)
      (cg_cat3 " profile=" (cg_o_profile opts)
        (cg_cat3 " files=" (prim_string_of_nat files)
          (cg_cat3 " blocking="
            (prim_string_of_nat (length QrFinding blocking))
            (cg_cat3 " rules="
              (prim_string_of_nat (length(Pair String QrClippy, mp)))
              (prim_string_concat(" report=", qr_rel root report_path))))));

def cg_emit (root : String) (source_root : String) (opts : CgOpts)
    (scopes : List String) (files : List String)
    (mp : List (Pair String QrClippy)) (findings : List QrFinding)
    (issues : List String) : IO Unit :=
    let report_path : String := qr_resolve(root, cg_o_report opts) in
    let sarif_path : String := qr_resolve(root, cg_o_sarif opts) in
    let blocking : List QrFinding :=
      filter QrFinding qr_clip_blocks findings in
    let passed : Bool := match blocking with
      | Nil => match issues with | Nil => True | Cons _ _ => False end
      | Cons _ _ => False
      end in
    let fatal : Bool := any QrFinding (fun (finding : QrFinding) =>
      orb (prim_string_eq(qr_find_level finding, "fatal"))
        (notb (qr_clip_level_ok (qr_find_level finding)))) findings in
    let advisory : Bool := andb (cg_o_warn opts)
      (andb(notb fatal, match issues with | Nil => True | Cons _ _ => False end)) in
    let file_count : Nat := length String files in
    do let! _w1 := qr_write_json report_path
         (cg_report_json root source_root opts scopes file_count
           mp findings issues);
       let! _w2 := qr_write_json sarif_path
         (cg_sarif root source_root findings);
       let! _p1 := cg_print_findings findings;
       let! _p2 := cg_print_inv issues;
       let! _p3 := println (cg_status_line root opts file_count
         mp blocking passed report_path);
       match orb advisory passed with
       | True => exit 0
       | False => exit 1
       end

def cg_lint_emit (f : QrFinding) : Bool :=
    match qr_find_mark f with
    | Just _ => False
    | Nothing =>
        notb (orb (prim_string_eq(qr_find_level f, "allow"))
          (prim_string_eq(qr_find_level f, "info")))
    end;

def cg_print_lint_findings : List QrFinding -> IO Unit :=
  fix go (xs : List QrFinding) : IO Unit :=
    match xs with
    | Nil => io_pure Unit MkUnit
    | Cons f rest =>
        match cg_lint_emit f with
        | False => go rest
        | True =>
            do quality_print_lines (qr_print_finding_lines f "fix");
               go rest
        end
    end;

def cg_emit_companion (findings : List QrFinding) (issues : List String)
    : IO Unit :=
    do let! _p1 := cg_print_lint_findings findings;
       let! _p2 := cg_print_inv issues;
       match issues with
       | Cons _ _ => exit 1
       | Nil => match filter QrFinding cg_lint_emit findings with
         | Nil => exit 0
         | Cons _ _ => exit 1
         end
       end

def cg_resolve_companion_file (root : String) (value : String)
    : IO (Either QualityInputError String) :=
    do let! direct := qr_is_file value;
       match direct with
       | True =>
           do let! resolved := prim_fs_realpath value;
              io_pure (Either QualityInputError String)
                (match prim_string_length resolved with
                 | Z => Left QualityInputError String (QualityInvalidInput value)
                 | S _ => Right QualityInputError String (quality_normalize_path resolved)
                 end)
       | False =>
           let candidate : String := qr_resolve root value in
           do let! exists := qr_is_file candidate;
              match exists with
              | False => io_pure (Either QualityInputError String)
                  (Left QualityInputError String (QualityExpectedFile value))
              | True =>
                  do let! resolved := prim_fs_realpath candidate;
                     io_pure (Either QualityInputError String)
                       (match prim_string_length resolved with
                        | Z => Left QualityInputError String (QualityInvalidInput value)
                        | S _ => Right QualityInputError String
                            (quality_normalize_path resolved)
                        end)
              end
       end

def cg_resolve_companion_files (root : String)
    : List String -> List String
    -> IO (Either QualityInputError (List String)) :=
  fix go (pending : List String) (acc : List String)
      : IO (Either QualityInputError (List String)) :=
    match pending with
    | Nil => io_pure (Either(QualityInputError, List String))
        (Right(QualityInputError, List String, reverse_lin String acc))
    | Cons path rest =>
        do let! got := cg_resolve_companion_file root path;
           match got with
           | Left err => io_pure (Either(QualityInputError, List String))
               (Left QualityInputError (List String) err)
           | Right canonical => go(rest, Cons String canonical acc)
           end
    end;

def cg_companion_root (root : String) (path : String) : String :=
    match st_under root path with
    | True => root
    | False => cg_dirname path
    end;

def cg_companion_prefix (root : String) (source_root : String)
    : List String -> List String :=
  fix go (paths : List String) : List String :=
    match paths with
    | Nil => Nil String
    | Cons path rest => match prim_string_eq(source_root, cg_companion_root root path) with
      | False => Nil String
      | True => Cons String path (go rest)
      end
    end;

-- Different external directories have different dependency namespaces.
-- Group only contiguous requests sharing an already canonical source root.
def cg_scan_companion (worker : String) (mp : List (Pair String QrClippy))
    (profile : String) (root : String) (paths : List String)
    (acc : List QrFinding) : IO (List QrFinding) :=
    (fix go (fuel : Nat) (pending : List String) (found : List QrFinding)
        : IO (List QrFinding) :=
      match pending with
      | Nil => io_pure(List QrFinding, qr_sort_findings found)
      | Cons first _ => match fuel with
        | Z =>
            do let! _e := cg_fail "semantic source-root grouping made no progress";
               io_pure(List QrFinding, Nil QrFinding)
        | S remaining =>
            let source_root : String := cg_companion_root root first in
            let group : List String := cg_companion_prefix root source_root pending in
            do let! next := cg_scan_many worker mp profile root source_root group found;
               go remaining (cg_drop_paths(length String group, pending)) next
        end
      end) (length String paths) paths acc;

def cg_run_companion (worker : String) (root : String) (opts : CgOpts)
    (mp : List (Pair String QrClippy)) (issues : List String) : IO Unit :=
    match cg_o_scopes opts with
    | Nil => cg_fail "lint companion requires at least one --scope file"
    | Cons _ _ =>
        do let! files := cg_resolve_companion_files root (cg_o_scopes opts)
             (Nil String);
           match files with
           | Left err => cg_fail (quality_input_message err)
           | Right paths =>
               do let! findings := cg_scan_companion worker mp (cg_o_profile opts)
                    root paths (Nil QrFinding);
                  cg_emit_companion findings issues
           end
    end;

def cg_run_files (worker : String) (root : String)
    (source_root : String) (opts : CgOpts) (scopes : List String)
    (mp : List (Pair String QrClippy)) (issues : List String)
    (files : List String) : IO Unit :=
    match filter String (fun (path : String) => notb (st_under source_root path)) files with
    | Cons outside _ => cg_fail (cg_cat4 (qr_rel root outside)
        " is outside the declared source root: " (qr_rel root source_root) "; analysis did not run")
    | Nil =>
        do let! findings := cg_scan_many worker mp (cg_o_profile opts)
             root source_root files (Nil QrFinding);
           cg_emit root source_root opts scopes files mp findings issues
    end;

def cg_run_firewall (worker : String) (root : String)
    (opts : CgOpts) (mp : List (Pair String QrClippy)) (issues : List String)
    : IO Unit :=
    let scopes : List String := match cg_o_scopes opts with
      | Nil => ([ "std", "compiler", "tools/analyze", "tools", "samples" ]
        : List String)
      | Cons h t => Cons String h t
      end in
    let source_root : String := match prim_string_length (cg_o_root opts) with
      | Z => root
      | S _ => qr_resolve(root, cg_o_root opts)
      end in
    do let! kind := prim_fs_kind source_root;
       match eq_nat kind 2 with
       | False => cg_fail (prim_string_concat "source root is not a directory: " source_root)
       | True =>
           do let! roots := st_roots root ([source_root] : List String)
                (Nil String);
              match roots with
              | Left err => cg_fail (quality_input_message err)
              | Right checked => match checked with
                | Nil => cg_fail "source root resolution was incomplete"
                | Cons canonical rest => match rest with
                  | Cons _ _ => cg_fail "source root resolution returned multiple roots"
                  | Nil =>
                      do let! collected := st_collect root "clippy" (cg_o_fixtures opts)
                           (map String String (qr_resolve root) scopes);
                         match collected with
                         | Left err => cg_fail (prim_string_concat
                             "native quality inventory failed: " (quality_input_message err))
                         | Right files => cg_run_files worker root canonical opts scopes mp issues files
                         end
                  end
                end
              end
       end

def cg_run (worker : String) (root : String) (opts : CgOpts)
    (mp : List (Pair String QrClippy)) (issues : List String) : IO Unit :=
    match cg_o_companion opts with
    | True => cg_run_companion worker root opts mp issues
    | False => cg_run_firewall worker root opts mp issues
    end;

-- Only compact rules and validation issues survive into worker supervision.
def cg_load_inventory (root : String) (_request : Unit)
    : IO (Either String (Pair (List (Pair String QrClippy)) (List String))) :=
    do let! loaded := qr_read_object (scan_rules_path root);
       match loaded with
       | Left err => io_pure (Either(String, Pair(List (Pair String QrClippy), List String)))
           (Left String (Pair(List (Pair String QrClippy), List String)) err)
       | Right obj =>
           let mp : List (Pair String QrClippy) := scan_load_rules obj in
           io_pure (Either(String, Pair(List (Pair String QrClippy), List String)))
             (Right String (Pair(List (Pair String QrClippy), List String))
               (MkPair (List (Pair String QrClippy)) (List String)
                 mp (scan_validate_registry obj mp)))
       end

def cg_start (root : String) (opts : CgOpts) : IO Unit :=
    do let! loaded := cg_load_inventory root MkUnit;
       match loaded with
       | Left err => cg_fail (prim_string_concat "unreadable rule inventory "
           (prim_string_concat (qr_rel(root, scan_rules_path root))
             (prim_string_concat ": " err)))
       | Right inventory => match inventory with
         | MkPair mp issues =>
           match issues with
           | Cons _ _ =>
               do cg_print_inv issues;
                  cg_fail "invalid rule inventory; analysis did not run"
           | Nil => match cg_o_list opts with
             | True => cg_list_rules(mp, cg_o_profile opts)
             | False => match cg_o_validate opts with
               | True => exit 0
               | False =>
                   do let! worker := cg_locate_worker;
                      match worker with
                      | Left err => cg_fail (quality_input_message err)
                      | Right path => cg_run path root opts mp issues
                      end
               end
             end
           end
         end
       end

def main : IO Unit :=
    do let! argv := prim_argv;
       match cg_parse(tail String argv, cg_opts0) with
       | Left err => cg_fail (quality_input_message err)
       | Right opts =>
           do let! root := quality_repo_root;
              match root with
              | Left err => cg_fail (quality_input_message err)
              | Right canonical => cg_start canonical opts
              end
       end
