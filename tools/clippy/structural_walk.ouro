-- One bounded body walk. Types are inspected when bindings are introduced,
-- never reinterpreted as executable expressions by the Clippy rule layer.

import "structural_match.ouro",
  "../../compiler/source_spans.ouro",
  "../../std/listx.ouro";

def cg_s_visit_list
    (visit : List CgSBinding -> Expr -> CgSState -> Either QualityInputError CgSState)
    (env : List CgSBinding) : List Expr -> CgSState -> Either QualityInputError CgSState :=
  fix go (xs : List Expr) (s : CgSState) : Either QualityInputError CgSState :=
    match xs with
    | Nil => Right QualityInputError CgSState s
    | Cons x rest => match visit env x s with
      | Left error => Left QualityInputError CgSState error
      | Right s2 => go rest s2
      end
    end;

def cg_s_visit_rows
    (visit : List CgSBinding -> Expr -> CgSState -> Either QualityInputError CgSState)
    (env : List CgSBinding)
    : List (Pair (List (Pair Nat (List Nat))) Expr) -> CgSState -> Either QualityInputError CgSState :=
  fix go (rows : List (Pair (List (Pair Nat (List Nat))) Expr)) (s : CgSState)
      : Either QualityInputError CgSState :=
    match rows with
    | Nil => Right QualityInputError CgSState s
    | Cons row rest => match row with
      | MkPair pats body =>
          let names : List Nat := concat_map (Pair(Nat, List Nat)) Nat
            (snd(Nat, List Nat)) pats in
          match cg_s_bind_names names env s with
          | MkPair env2 s2 => match visit env2 body s2 with
            | Left error => Left QualityInputError CgSState error
            | Right s3 => go rest s3
            end
          end
      end
    end;

def cg_s_visit_clauses
    (visit : List CgSBinding -> Expr -> CgSState -> Either QualityInputError CgSState)
    (env : List CgSBinding)
    : List (Pair Nat (Pair (List Nat) Expr)) -> CgSState -> Either QualityInputError CgSState :=
  fix go (clauses : List (Pair Nat (Pair (List Nat) Expr))) (s : CgSState)
      : Either QualityInputError CgSState :=
    match clauses with
    | Nil => Right QualityInputError CgSState s
    | Cons clause rest => match clause with
      | MkPair _ payload => match payload with
        | MkPair names body => match cg_s_bind_names names env s with
          | MkPair env2 s2 => match visit env2 body s2 with
            | Left error => Left QualityInputError CgSState error
            | Right s3 => go rest s3
            end
          end
        end
      end
    end;

-- A do binding enters scope only after its RHS. Sibling handler clauses and
-- match arms instead start from the original outer scope.
def cg_s_do_name : Expr -> Maybe Nat :=
  fix cg_s_do_name (e : Expr) : Maybe Nat :=
    match e with
    | ESpan _ _ inner => cg_s_do_name inner
    | EFallible _ _ _ _ => Nothing Nat
    | EDoBind n _ => Just Nat n
    | EVar _ => Nothing Nat
    | EHole _ => Nothing Nat
    | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat
    | EApp _ _ => Nothing Nat
    | ELam _ _ _ => Nothing Nat
    | EPi _ _ _ => Nothing Nat
    | ELet _ _ _ _ => Nothing Nat
    | EAscribe _ _ => Nothing Nat
    | EMatch _ _ => Nothing Nat
    | EFix _ _ _ _ => Nothing Nat
    | EEffectRow _ _ => Nothing Nat
    | EPerform _ _ => Nothing Nat
    | EDo _ => Nothing Nat
    | EHandle _ _ => Nothing Nat
    | EBranch _ _ _ => Nothing Nat
    | ENoBranch => Nothing Nat
    | EBinder _ _ _ => Nothing Nat
    | ENoBinder => Nothing Nat
    | EMultiMatch _ _ => Nothing Nat
    | EStr _ => Nothing Nat
    | EList _ => Nothing Nat
    end;

def cg_s_visit_do
    (visit : List CgSBinding -> Expr -> CgSState -> Either QualityInputError CgSState)
    : List Expr -> List CgSBinding -> CgSState -> Either QualityInputError CgSState :=
  fix go (xs : List Expr) (env : List CgSBinding) (s : CgSState) : Either QualityInputError CgSState :=
    match xs with
    | Nil => Right QualityInputError CgSState s
    | Cons x rest => match visit env x s with
      | Left error => Left QualityInputError CgSState error
      | Right s2 => match cg_s_do_name x with
        | Nothing => go rest env s2
        | Just name => match cg_s_bind name (Nothing Nat) env s2 with
          | MkPair env2 s3 => go rest env2 s3
          end
        end
      end
    end;

def cg_s_telescope (c : CgSCatalog)
    : Nat -> Expr -> List CgSBinding -> CgSState
      -> Either QualityInputError (Pair (List CgSBinding) CgSState) :=
  fix go (fuel : Nat) (binders : Expr) (env : List CgSBinding) (s : CgSState)
      : Either QualityInputError (Pair (List CgSBinding) CgSState) :=
    match fuel with
    | Z => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "telescope fact traversal exhausted")
    | S fuel2 => match binders with
      | EBinder name ty rest => match cg_s_bind name (cg_s_type_enum c env ty) env s with
        | MkPair env2 s2 => go fuel2 rest env2 s2
        end
      | ENoBinder => Right QualityInputError (Pair(List CgSBinding, CgSState))
          (MkPair (List CgSBinding) CgSState env s)
      | EVar _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EHole _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | ESort _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | ENat _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EApp _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | ELam _ _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EPi _ _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | ELet _ _ _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EAscribe _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EMatch _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EFix _ _ _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EEffectRow _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EPerform _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EDo _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EHandle _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EBranch _ _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | ENoBranch => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EMultiMatch _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EStr _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EDoBind _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | EList _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      | ESpan _ _ inner => go fuel2 inner env s
      | EFallible _ _ _ _ => Left(QualityInputError, Pair(List CgSBinding, CgSState), QualityInvalidInput "invalid compiler telescope")
      end
    end;

-- A signature annotation is a type boundary. Do not erase it to manufacture
-- an identity-let recommendation, even when its text looks redundant.
def cg_s_annotated (ann : Maybe Expr) : Bool :=
    match ann with | Nothing => False | Just _ => True end;

def cg_s_visit (c : CgSCatalog) (owner : Nat)
    : Nat -> List CgSBinding -> Expr -> CgSState -> Either QualityInputError CgSState :=
  fix walk (fuel : Nat) (env : List CgSBinding) (e : Expr) (state : CgSState)
      : Either QualityInputError CgSState :=
    match fuel with
    | Z => Left QualityInputError CgSState (QualityInvalidInput "expression fact traversal exhausted")
    | S fuel2 =>
        let s : CgSState := cg_s_tick state in
        let node : Nat := cg_s_nodes s in
        let visit : List CgSBinding -> Expr -> CgSState -> Either QualityInputError CgSState :=
          fun (env2 : List CgSBinding) => fun (e2 : Expr) => fun (s2 : CgSState) =>
            walk fuel2 env2 e2 s2 in
        match e with
        | EVar _ => Right QualityInputError CgSState s
        | EHole _ => Right QualityInputError CgSState s
        | ESort _ => Right QualityInputError CgSState s
        | ENat _ => Right QualityInputError CgSState s
        | EStr _ => Right QualityInputError CgSState s
        | EApp f x => cg_s_visit_list visit env ([f, x] : List Expr) s
        | ELam name ann body => match cg_s_bind name (cg_s_annotation c env ann) env s with
          | MkPair env2 s2 => visit env2 body s2
          end
        | EPi _ _ _ => Right QualityInputError CgSState s
        | ELet name ann value body => match visit env value s with
          | Left error => Left QualityInputError CgSState error
          | Right s2 =>
              let identity : Nat := cg_s_fresh s2 in
              let kind : Maybe Nat := match ann with
                | Nothing => cg_s_value_enum c env value
                | Just ty => cg_s_type_enum c env ty
                end in
              match cg_s_bind name kind env s2 with
              | MkPair env2 s3 => visit env2 body
                  (cg_s_record s3 (CgSLet owner node name identity
                    (cg_s_annotated ann) (cg_s_returns name body)))
              end
          end
        | EAscribe term _ => visit env term s
        | EMatch scrut branches => match visit env scrut s with
          | Left error => Left QualityInputError CgSState error
          | Right s2 => match cg_s_match_inventory c env scrut with
            | Nothing => visit env branches s2
            | Just inventory => match inventory with
              | MkPair enum_id ctors => match cg_s_branch_summary c env ctors fuel2 branches
                  (MkCgSArms(0, Nil Nat, Nothing CgSAtom, True)) with
                | Left error => Left QualityInputError CgSState error
                | Right summary => visit env branches
                    (cg_s_record(s2, cg_s_match_fact owner node enum_id ctors summary))
                end
              end
            end
          end
        | EFix name binders _ body => match cg_s_bind name (Nothing Nat) env s with
          | MkPair recursive_env s2 => match cg_s_telescope c fuel2 binders recursive_env s2 with
            | Left error => Left QualityInputError CgSState error
            | Right scoped => match scoped with
              | MkPair env2 s3 => visit env2 body s3
              end
            end
          end
        | EEffectRow inner _ => visit env inner s
        | EPerform _ args => cg_s_visit_list visit env args s
        | EDo statements => cg_s_visit_do visit statements env s
        | EHandle inner clauses => match visit env inner s with
          | Left error => Left QualityInputError CgSState error
          | Right s2 => cg_s_visit_clauses visit env clauses s2
          end
        | EBranch pats body rest => match pats with
          | Nil => Left QualityInputError CgSState (QualityInvalidInput "empty compiler branch pattern")
          | Cons _ names => match cg_s_bind_names names env s with
            | MkPair env2 s2 => match visit env2 body s2 with
              | Left error => Left QualityInputError CgSState error
              | Right s3 => visit env rest s3
              end
            end
          end
        | ENoBranch => Right QualityInputError CgSState s
        | EBinder _ _ _ => Left QualityInputError CgSState (QualityInvalidInput "telescope outside a fixpoint")
        | ENoBinder => Right QualityInputError CgSState s
        | EMultiMatch scruts rows => match cg_s_visit_list visit env scruts s with
          | Left error => Left QualityInputError CgSState error
          | Right s2 =>
              let summarized : CgSState := match scruts with
                | Nil => s2
                | Cons scrut rest => match rest with
                  | Cons _ _ => s2
                  | Nil => match cg_s_match_inventory c env scrut with
                    | Nothing => s2
                    | Just inventory => match inventory with
                      | MkPair enum_id ctors => cg_s_record s2
                          (cg_s_match_fact owner node enum_id ctors
                            (cg_s_row_summary c env ctors rows
                              (MkCgSArms(0, Nil Nat, Nothing CgSAtom, True))))
                      end
                    end
                  end
                end in
              cg_s_visit_rows visit env rows summarized
          end
        | EDoBind _ rhs => visit env rhs s
        | EList values => cg_s_visit_list visit env values s
        -- A span wrapper is not a node: keep the unwrapped tree's ordinals.
        | ESpan first past inner =>
            match span_peel fuel2 (Just(Pair Nat Nat, MkPair Nat Nat first past)) inner with
            | MkPair span core => match walk fuel2 env core
                (cg_s_with_span span state) with
              | Left error => Left QualityInputError CgSState error
              | Right after => Right QualityInputError CgSState (cg_s_with_span(cg_s_span state, after))
              end
            end
        | EFallible container _ _ body =>
            cg_s_visit_list visit env
              [container, fallible_analysis_body fuel2 body] s
        end
    end;

def cg_s_build (fuel : Nat) (ds : List Decl) : Either QualityInputError CgSState :=
    let catalog : CgSCatalog := cg_s_catalog ds in
    (fix go (decls : List Decl) (s : CgSState) : Either QualityInputError CgSState :=
      match decls with
      | Nil => Right QualityInputError CgSState s
      | Cons d rest => match d with
        | DDef name _ body _ _ => match cg_s_visit catalog name fuel (Nil CgSBinding) body s with
          | Left error => Left QualityInputError CgSState error
          | Right s2 => go rest s2
          end
        | DAxiom _ _ => go rest s
        | DInductive _ _ _ _ _ => go rest s
        | DEffect _ _ _ => go rest s
        | DImport _ => go rest s
        | DIntrinsic _ _ _ _ => go rest s
        | DExtern _ _ _ => go rest s
        | DRepresentation _ _ => go rest s
        end
      end) ds cg_s_walk0;
