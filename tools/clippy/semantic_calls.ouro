-- Call and result transfer functions. Every call has a resolved declaration
-- or a local value identity; unknown local functions form an effect barrier.
import "semantic_model.ouro";
import "../../std/natx.ouro";
import "../../compiler/semantic_scope.ouro";

def cm_is_self (ctx : CmContext) (callee : CmValue) : Bool :=
    match cm_self ctx with
    | Nothing => False
    | Just id => andb (eq_nat (cm_value_kind callee) 1) (eq_nat id (cm_value_id callee))
    end;

def cm_call_result_base (node : Nat) (api : CmApi) (args : List CmValue) : CmValue :=
    let role : Nat := cm_contract_role (cm_api_contract api) in
    match eq_nat role 9 with
    | True => cm_as_io (cm_last_value args)
    | False => CmValueOf
        (match eq_nat role 10 with | True => 7 | False =>
          match eq_nat role 11 with | True => 8 | False =>
            match orb (cm_contract_observe (cm_api_contract api)) (cs_required (cm_api_summary api)) with
            | True => 14 | False => 6 end end end)
        node (mod_nat (cm_api_result api) 10) (leb_nat 10 (cm_api_result api))
        (any CmValue cm_value_taint args) False
    end;

-- Identity contracts transfer the SAME value lineage, not a newly guessed
-- checked producer. Ignoring the returned alias remains an ignored-result bug.
def cm_call_result (node : Nat) (api : CmApi) (args : List CmValue) : CmValue :=
    match cs_result (cm_api_summary api) with
    | CsArgumentResult position => match cs_complete (cm_api_summary api) with
      | True => nth CmValue (cm_unknown node) position args
      | False => cm_call_result_base node api args end
    | CsUnknownResult => cm_call_result_base node api args
    | CsRequiredResult => cm_call_result_base node api args
    | CsSourceResult => cm_call_result_base node api args
    | CsSuccessResult => cm_call_result_base node api args
    | CsFailureResult => cm_call_result_base node api args
    | CsPolicyResult => cm_call_result_base node api args
    end;

def cm_arg_at (index : Nat) (args : List CmValue) : CmValue :=
    nth CmValue (cm_unknown 0) index args;

def cm_proven_callback (apis : CmApiIndex) (value : CmValue) : Bool :=
    match eq_nat (cm_value_kind value) 2 with
    | False => False
    | True => match cm_api_lookup (cm_value_id value) apis with
      | Nothing => False
      | Just api => cm_contract_pure (cm_api_contract api)
      end
    end;

def cm_call_purity (apis : CmApiIndex) (api : CmApi) (args : List CmValue) : Bool :=
    let contract : CmContract := cm_api_contract api in
    orb (orb (cm_contract_pure contract) (cs_pure (cm_api_summary api)))
      (orb (eq_nat (sc_decl_kind (cm_api_decl api)) 3)
        (andb (eq_nat (cm_contract_role contract) 20)
          (cm_proven_callback apis (cm_arg_at (sub (length CmValue args) 2) args))));

-- Reflexivity is restricted to registered total Nat/String comparison APIs.
-- Floating-point/custom predicates, same-spelled callees and distinct values
-- cannot enter this rule. Evidence uses the complete argument value identity.
def cm_logic_call (ctx : CmContext) (call : ClippyCallFact) (logic_state : CmState) : CmState :=
    match cm_call_args call with
    | Nil => logic_state
    | Cons a rest => match rest with
      | Nil => logic_state
      | Cons b extra => match andb (nullb CmValue extra)
          (andb (andb (cm_value_known a) (cm_value_known b))
            (prim_string_eq (cm_value_key a) (cm_value_key b))) with
        | False => logic_state
        | True => match cm_call_role call with
          | Z => logic_state
          | S _ => match eq_nat (cm_call_role call) 25 with
            | True => cm_finding (cm_proof_for CmReflexiveProof (cm_owner ctx)
                (cm_call_node call) (cm_call_branch call) (cm_call_epoch call)
                [cm_known_fact CmCalleeResolved True, cm_known_fact CmSameValue True,
                 cm_known_fact CmTotalComparison True, cm_known_fact CmKnownArguments True]
                "registered total equality compares one known value with itself; replace the always-true condition") logic_state
            | False => match eq_nat (cm_call_role call) 26 with
              | True => cm_finding (cm_proof_for CmIrreflexiveProof (cm_owner ctx)
                  (cm_call_node call) (cm_call_branch call) (cm_call_epoch call)
                  [cm_known_fact CmCalleeResolved True, cm_known_fact CmSameValue True,
                   cm_known_fact CmTotalComparison True, cm_known_fact CmKnownArguments True]
                  "registered strict Nat ordering compares one known value with itself; replace the always-false condition") logic_state
              | False => logic_state
              end
            end
          end
        end
      end
    end;

def cm_boundary_call (unit : ClippySemanticUnit) (ctx : CmContext)
    (call : ClippyCallFact) (state : CmState) : CmState :=
    let role : Nat := cm_call_role call in
    let node : Nat := cm_call_node call in
    let owned : Bool := cm_boundary unit (cm_owner ctx) role in
    let state1 : CmState := match owned with
      | True => state
      | False => match eq_nat role 1 with
        | True => cm_finding (cm_proof_for CmRawReadProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmOutsideOwner True]
            "raw filesystem read crosses its declared owner boundary; use the checked read API") state
        | False => match eq_nat role 2 with
          | True => cm_finding (cm_proof_for CmRawWriteProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmOutsideOwner True]
            "raw filesystem write crosses its declared owner boundary; use the checked write API") state
          | False => match eq_nat role 3 with
            | True => cm_finding (cm_proof_for CmRawProcessProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmOutsideOwner True]
            "raw process launch crosses its declared owner boundary; use the checked process API") state
            | False => state
            end
          end
        end
      end in
    match andb (notb (cm_policy ctx)) (andb (cm_unrecovered_error ctx state) (eq_nat role 4)) with
    | False => state1
    | True =>
        let code : CmValue := cm_last_value (cm_call_args call) in
        match andb (eq_nat (cm_value_kind code) 3) (eq_nat (cm_value_id code) 0) with
        | False => state1
        | True => cm_finding (cm_proof_for CmFailureExitProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmCheckedProducer True,
             cm_known_fact CmFailurePath True, cm_known_fact CmNoRecovery True,
             cm_known_fact CmZeroExit True]
            "the resolved exit API receives zero on a checked failure arm; preserve the failure exit status") state1
        end
    end;

def cm_apply_call (unit : ClippySemanticUnit) (apis : CmApiIndex)
    (ctx : CmContext) (node : Nat) (callee : CmValue) (args : List CmValue)
    (state : CmState) : Either QualityInputError (Pair CmValue CmState) :=
    let argc : Nat := length CmValue args in
    match eq_nat (cm_value_kind callee) 2 with
    | False =>
        let observed : CmState := foldl CmValue CmState
          (fun (next : CmState) (value : CmValue) => cm_observe 4 node value next) state args in
        let recursive : Bool := cm_is_self ctx callee in
        let call : ClippyCallFact := CmCall node (cm_value_id callee) (cm_branch ctx)
          (cm_epoch observed) 0 False 0 args recursive in
        Right QualityInputError (Pair CmValue CmState)
          (MkPair CmValue CmState
            (CmValueOf (match recursive with | True => 10 | False => 6 end) node
              0 False (any CmValue cm_value_taint args) False)
            (cm_barrier (cm_event (CmCallEvent call) observed)))
    | True => match cm_api_lookup (cm_value_id callee) apis with
      | Nothing => Left QualityInputError (Pair CmValue CmState) (QualityInvalidInput "resolved call lost declaration metadata")
      | Just api =>
        let observed : CmState := (fix observe (values : List CmValue) (position : Nat)
            (next : CmState) : CmState := match values with
          | Nil => next
          | Cons value rest => observe rest (add position 1)
              (match orb (notb (eq_nat argc (cm_api_arity api)))
                  (cs_argument_escapes (cm_api_summary api) position) with
               | True => cm_observe 4 node value next | False => next end)
          end) args 0 state in
        match ltb_nat argc (cm_api_arity api) with
        | True => Right QualityInputError (Pair CmValue CmState)
            (MkPair CmValue CmState (cm_unknown node) observed)
        | False => match eq_nat argc (cm_api_arity api) with
          | False => Right QualityInputError (Pair CmValue CmState)
              (MkPair CmValue CmState (cm_unknown node) (cm_barrier observed))
          | True =>
            let contract : CmContract := cm_api_contract api in
            let direct_role : Nat := cm_contract_role contract in
            let role : Nat := match eq_nat direct_role 0 with
              | True => cs_work_role (cm_api_summary api) | False => direct_role end in
            let pure : Bool := cm_call_purity apis api args in
            let call : ClippyCallFact := CmCall node (sc_decl_name (cm_api_decl api))
              (cm_branch ctx) (cm_epoch observed) role pure (match cs_cost (cm_api_summary api) with
                | Just cost => cost | Nothing => cm_contract_cost contract end) args False in
            let value : CmValue := cm_call_result node api args in
            let updated : CmState := cm_event (CmCallEvent call)
              (cm_logic_call ctx call (cm_boundary_call unit ctx call observed)) in
            let flowed : CmState := cm_execute node value updated in
            let rendered : CmState := match andb (elem Nat eq_nat role [5,6])
                (any CmValue cm_value_taint args) with
              | True => cm_event (CmFlowEvent (CmFlow node 6 (cm_value_id (cm_last_value args)))) flowed
              | False => flowed
              end in
            Right QualityInputError (Pair CmValue CmState) (MkPair CmValue CmState value
              (match pure with | True => rendered | False => cm_barrier rendered end))
        end
      end
      end
    end;

-- Only the TERMINAL value of a failure arm establishes conversion to success.
-- Intermediate Right values that are subsequently mapped back to Left do not.
def cm_arm_outcome (ctx : CmContext) (node : Nat) (value : CmValue) (state : CmState) : CmState :=
    match cm_unrecovered_error ctx state with
    | False => state
    | True => match cm_policy ctx with
      | True => cm_event (CmFlowEvent (CmFlow node 9 (cm_value_id value))) state
      | False =>
          let converted : Bool := eq_nat (cm_value_kind value) 8 in
          match converted with
          | False => state
          | True => cm_finding (cm_proof_for CmFailureSuccessProof (cm_owner ctx) node
              (cm_branch ctx) (cm_epoch state)
              [cm_known_fact CmCheckedProducer True, cm_known_fact CmFailurePath True,
               cm_known_fact CmNoRecovery True, cm_known_fact CmSuccessConstructor True]
              "a checked failure arm returns success without recovery; propagate the failure or make the recovery contract explicit")
              (cm_event (CmFlowEvent (CmFlow node 8 (cm_value_id value))) state)
          end
      end
    end;
