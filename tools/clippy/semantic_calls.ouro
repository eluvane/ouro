-- Call and result transfer functions. Every call has a resolved declaration
-- or a local value identity; unknown local functions form an effect barrier.
import "semantic_model.ouro",
  "semantic_result_identity.ouro",
  "../../std/natx.ouro",
  "../../compiler/semantic_scope.ouro";

def cm_is_self (ctx : CmContext) (callee : CmValue) : Bool :=
    match cm_self ctx with
    | Nothing => False
    | Just id => andb(eq_nat(cm_value_kind callee, 1), eq_nat(id, cm_value_id callee))
    end;

def cm_call_result_base (node : Nat) (api : CmApi) (args : List CmValue) : CmValue :=
    let role : Nat := cm_contract_role (cm_api_contract api) in
    match eq_nat role 9 with
    | True => cm_as_io (cm_last_value args)
    | False => CmValueOf
        (match eq_nat role 10 with | True => 7 | False =>
          match eq_nat role 11 with | True => 8 | False =>
            match orb(cm_contract_observe (cm_api_contract api), cs_required (cm_api_summary api)) with
            | True => 14 | False => 6 end end end)
        node (mod_nat(cm_api_result api, 10)) (leb_nat(10, cm_api_result api))
        (any CmValue cm_value_taint args) False
    end;

-- Identity contracts transfer the SAME value lineage, not a newly guessed
-- checked producer. Ignoring the returned alias remains an ignored-result bug.
def cm_call_result (node : Nat) (api : CmApi) (args : List CmValue) : CmValue :=
    match cs_result (cm_api_summary api) with
    | CsArgumentResult position => match cs_complete (cm_api_summary api) with
      | True => nth CmValue (cm_unknown node) position args
      | False => cm_call_result_base node api args end
    | CsUnknownResult => cm_call_result_base node api args
    | CsRequiredResult => cm_call_result_base node api args
    | CsSourceResult => cm_call_result_base node api args
    | CsSuccessResult => cm_call_result_base node api args
    | CsFailureResult => cm_call_result_base node api args
    | CsPolicyResult => cm_call_result_base node api args
    end;

def cm_arg_at (index : Nat) (args : List CmValue) : CmValue :=
    nth CmValue (cm_unknown 0) index args;

def cm_proven_callback (apis : CmApiIndex) (value : CmValue) : Bool :=
    match eq_nat(cm_value_kind value, 2) with
    | False => False
    | True => match cm_api_lookup(cm_value_id value, apis) with
      | Nothing => False
      | Just api => cm_contract_pure (cm_api_contract api)
      end
    end;

def cm_call_purity (apis : CmApiIndex) (api : CmApi) (args : List CmValue) : Bool :=
    let contract : CmContract := cm_api_contract api in
    orb (cm_result_call_pure apis (cm_result_role api) args)
      (orb (orb(cm_contract_pure contract, cs_pure (cm_api_summary api)))
        (orb (eq_nat(sc_decl_kind (cm_api_decl api), 3))
          (andb (eq_nat(cm_contract_role contract, 20))
            (cm_proven_callback(apis, cm_arg_at(sub(length CmValue args, 2), args))))));

-- Reflexivity is restricted to registered total Nat/String comparison APIs.
-- Floating-point/custom predicates, same-spelled callees and distinct values
-- cannot enter this rule. Evidence uses the complete argument value identity.
def cm_logic_call (ctx : CmContext) (call : ClippyCallFact) (logic_state : CmState) : CmState :=
    match cm_call_args call with
    | Nil => logic_state
    | Cons a rest => match rest with
      | Nil => logic_state
      | Cons b extra => match andb (nullb CmValue extra)
          (andb (andb(cm_value_known a, cm_value_known b))
            (prim_string_eq(cm_value_key a, cm_value_key b))) with
        | False => logic_state
        | True => match cm_call_role call with
          | Z => logic_state
          | S _ => match eq_nat(cm_call_role call, 25) with
            | True => cm_finding (cm_proof_for CmReflexiveProof (cm_owner ctx)
                (cm_call_node call) (cm_call_branch call) (cm_call_epoch call)
                [cm_known_fact CmCalleeResolved True, cm_known_fact CmSameValue True,
                 cm_known_fact CmTotalComparison True, cm_known_fact CmKnownArguments True]
                "registered total equality compares one known value with itself; replace the always-true condition") logic_state
            | False => match eq_nat(cm_call_role call, 26) with
              | True => cm_finding (cm_proof_for CmIrreflexiveProof (cm_owner ctx)
                  (cm_call_node call) (cm_call_branch call) (cm_call_epoch call)
                  [cm_known_fact CmCalleeResolved True, cm_known_fact CmSameValue True,
                   cm_known_fact CmTotalComparison True, cm_known_fact CmKnownArguments True]
                  "registered strict Nat ordering compares one known value with itself; replace the always-false condition") logic_state
              | False => logic_state
              end
            end
          end
        end
      end
    end;

-- Operation laws consume the already-resolved call and value facts. These are
-- review-only diagnostics: a value identity does not authorize deleting effects.
def cm_law_same (a : CmValue) (b : CmValue) : Bool :=
    andb (andb(cm_value_known a, cm_value_known b))
      (prim_string_eq(cm_value_key a, cm_value_key b));

def cm_law_nat (expected : Nat) (value : CmValue) : Bool :=
    andb (notb (cm_value_io value))
      (andb(eq_nat(cm_value_kind value, 3), eq_nat(cm_value_id value, expected)));

-- An absent pool entry is NOT the empty string. cm_string's display fallback
-- must not be used as literal evidence.
def cm_law_empty_text (intern : InternState) (value : CmValue) : Bool :=
    match andb(eq_nat(cm_value_kind value, 4), notb (cm_value_io value)) with
    | False => False
    | True => match intern with | MkIntern _ _ strings _ =>
        any (Pair(List Nat, Nat)) (fun (entry : Pair (List Nat) Nat) =>
          match entry with | MkPair bytes id =>
            andb(eq_nat(id, cm_value_id value), nullb Nat bytes) end) strings
        end
    end;

def cm_law_bool (apis : CmApiIndex) (role : Nat) (value : CmValue) : Bool :=
    match andb(eq_nat(cm_value_kind value, 2), notb (cm_value_io value)) with
    | False => False
    | True => match cm_api_lookup(cm_value_id value, apis) with
      | Nothing => False
      | Just api => andb (eq_nat(sc_decl_kind (cm_api_decl api), 3))
          (andb (eq_nat(cm_api_arity api, 0))
            (eq_nat(cm_contract_role (cm_api_contract api), role)))
      end
    end;

def cm_call_law (kind : CmProofKind) (premise : CmRequirement) (arity : Nat)
    (established : Bool) (message : String) (ctx : CmContext)
    (call : ClippyCallFact) (state : CmState) : CmState :=
    match established with
    | False => state
    | True => cm_finding (cm_proof_for kind (cm_owner ctx) (cm_call_node call)
        (cm_call_branch call) (cm_call_epoch call)
        [cm_known_fact(CmCalleeResolved, notb (eq_nat(cm_call_role call, 0))),
         cm_known_fact CmKnownArguments (all CmValue
           (fun (value : CmValue) => andb(cm_value_known value, notb (cm_value_io value)))
           (cm_call_args call)),
         cm_known_fact(CmPureExpression, cm_call_pure call),
         cm_known_fact(CmExactArity, eq_nat(length(CmValue, cm_call_args call), arity)),
         cm_known_fact premise established] message) state
    end;

def cm_nat_operand_laws (ctx : CmContext) (call : ClippyCallFact) (state : CmState) : CmState :=
    let a : CmValue := cm_arg_at(0, cm_call_args call) in
    let b : CmValue := cm_arg_at(1, cm_call_args call) in
    let role : Nat := cm_call_role call in
    let a_zero : Bool := cm_law_nat 0 a in
    let b_zero : Bool := cm_law_nat 0 b in
    let a_one : Bool := cm_law_nat 1 a in
    let b_one : Bool := cm_law_nat 1 b in
    let zero_divisor : Bool := andb(elem Nat eq_nat role [30,31], b_zero) in
    let erased : Bool := orb (andb(eq_nat role 29, orb a_zero b_zero))
        (orb (andb(eq_nat role 28, orb(a_zero, cm_law_same a b)))
          (andb(eq_nat role 31, b_one))) in
    let neutral : Bool := orb (andb(eq_nat role 27, orb a_zero b_zero))
        (orb (andb(eq_nat role 28, b_zero))
          (orb (andb(eq_nat role 29, orb a_one b_one))
            (andb(eq_nat role 30, b_one)))) in
    -- One diagnosis per arithmetic site; an erasing law takes precedence over
    -- a neutral law at intersections such as sub 0 0 and mul 0 1.
    match zero_divisor with
    | True => cm_call_law CmZeroDivisorProof CmZeroDivisor 2 True
        "the registered Nat division/remainder API has a proven zero divisor; division returns zero and remainder returns the dividend by definition, not a mathematical quotient/remainder; review the divisor or make the intended zero case explicit"
        ctx call state
    | False => match erased with
      | True => cm_call_law CmErasingNatProof CmErasingOperand 2 True
          "the registered Nat operation is proven to return zero independently of the remaining value; review the operands and preserve their evaluation before simplifying"
          ctx call state
      | False => cm_call_law CmNeutralNatProof CmNeutralOperand 2 neutral
          "a proven neutral operand makes the registered Nat operation return the other operand unchanged; review the surrounding evaluation before removing the operation"
          ctx call state
      end
    end;

def cm_nat_bound_laws (ctx : CmContext) (call : ClippyCallFact) (state : CmState) : CmState :=
    let a : CmValue := cm_arg_at(0, cm_call_args call) in
    let b : CmValue := cm_arg_at(1, cm_call_args call) in
    let role : Nat := cm_call_role call in
    let constant_order : Bool := orb
        (andb(eq_nat role 26, andb(cm_law_nat 0 b, notb (cm_law_same a b))))
        (andb(eq_nat role 32, orb(cm_law_nat 0 a, cm_law_same a b))) in
    let ordered : CmState := cm_call_law CmConstantNatOrderProof CmNaturalOrderInvariant 2 constant_order
        "the registered Nat ordering is constant: no Nat is below zero, zero is at most every Nat, and a Nat is at most itself; review the condition"
        ctx call state in
    let inverted : Bool := andb (elem Nat eq_nat role [33,34])
        (andb (andb (andb(eq_nat(cm_value_kind a, 3), notb (cm_value_io a)))
            (andb(eq_nat(cm_value_kind b, 3), notb (cm_value_io b))))
          (ltb_nat(cm_value_id b, cm_value_id a))) in
    cm_call_law CmInvertedBoundsProof CmInvertedBounds 3 inverted
      "the registered clamp/range API receives a lower bound greater than its upper bound; clamp returns the lower bound and membership is always false; review the interval rather than automatically swapping arguments"
      ctx call ordered;

def cm_bool_operand_laws (apis : CmApiIndex) (ctx : CmContext)
    (call : ClippyCallFact) (state : CmState) : CmState :=
    let role : Nat := cm_call_role call in
    match elem Nat eq_nat role [35,36] with
    | False => state
    | True =>
        let a : CmValue := cm_arg_at(0, cm_call_args call) in
        let b : CmValue := cm_arg_at(1, cm_call_args call) in
        let identity_role : Nat := match eq_nat role 35 with | True => 38 | False => 39 end in
        let absorber_role : Nat := match eq_nat role 35 with | True => 39 | False => 38 end in
        let absorbing : Bool := orb(cm_law_bool apis absorber_role a, cm_law_bool apis absorber_role b) in
        match absorbing with
        | True => cm_call_law CmAbsorbingBoolProof CmBooleanAbsorber 2 True
            "a resolved Boolean constructor makes the registered conjunction/disjunction constant; review the condition while retaining argument evaluation"
            ctx call state
        | False => cm_call_law CmIdentityBoolProof CmBooleanIdentity 2
            (orb (cm_law_same a b)
              (orb(cm_law_bool apis identity_role a, cm_law_bool apis identity_role b)))
            "the registered Boolean operation returns the same value by a proven identity or idempotence law; review the condition before simplifying"
            ctx call state
        end
    end;

def cm_collection_operand_laws (intern : InternState) (ctx : CmContext)
    (call : ClippyCallFact) (state : CmState) : CmState :=
    let role : Nat := cm_call_role call in
    let args : List CmValue := cm_call_args call in
    let concatenation : Bool := andb (eq_nat role 21)
        (orb (cm_law_empty_text(intern, cm_arg_at 0 args))
          (cm_law_empty_text(intern, cm_arg_at 1 args))) in
    let text_state : CmState := cm_call_law CmEmptyConcatProof CmEmptyText 2 concatenation
        "the registered string concatenation has a proven empty-string operand; the other string is unchanged; preserve evaluation when removing the concatenation"
        ctx call state in
    cm_call_law CmZeroListCountProof CmZeroCount 3
      (andb(elem Nat eq_nat role [40,41], cm_law_nat(0, cm_arg_at 1 args)))
      "the registered list take/drop count is proven zero; take returns an empty list and drop returns its input unchanged; review the count and retain input evaluation"
      ctx call text_state;

-- Literal ordering is deliberately narrower than a guessed range analysis.
-- A dynamic Nat, a missing fact or an IO-wrapped literal cannot establish it.
def cm_law_nat_le (a : CmValue) (b : CmValue) : Bool :=
    andb (andb(eq_nat(cm_value_kind a, 3), eq_nat(cm_value_kind b, 3)))
      (andb (andb(notb (cm_value_io a), notb (cm_value_io b)))
        (leb_nat(cm_value_id a, cm_value_id b)));

-- The intern pool stores character codes. Byte-index contracts require the
-- byte length of the reconstructed string, not the number of character codes.
-- Missing intern entries stay Nothing and never stand for an empty literal.
def cm_law_text_size (intern : InternState) (value : CmValue) : Maybe Nat :=
    match andb(eq_nat(cm_value_kind value, 4), notb (cm_value_io value)) with
    | False => Nothing Nat
    | True => match intern with | MkIntern _ _ strings _ =>
        (fix go (entries : List (Pair (List Nat) Nat)) : Maybe Nat :=
          match entries with
          | Nil => Nothing Nat
          | Cons entry rest => match entry with | MkPair codes id =>
              match eq_nat(id, cm_value_id value) with
              | True => Just(Nat, prim_string_length (prim_string_of_char_codes codes))
              | False => go rest
              end
            end
          end) strings
        end
    end;

def cm_law_text_outside (intern : InternState) (text : CmValue) (index : CmValue) : Bool :=
    match andb(eq_nat(cm_value_kind index, 3), notb (cm_value_io index)) with
    | False => False
    | True => match cm_law_text_size intern text with
      | Nothing => False
      | Just size => leb_nat(size, cm_value_id index)
      end
    end;

def cm_extremum_operand_laws (ctx : CmContext) (call : ClippyCallFact) (state : CmState) : CmState :=
    let role : Nat := cm_call_role call in
    let a : CmValue := cm_arg_at(0, cm_call_args call) in
    let b : CmValue := cm_arg_at(1, cm_call_args call) in
    match eq_nat role 33 with
    | True => cm_call_law CmDegenerateClampProof CmEqualBounds 3 (cm_law_same a b)
        "the resolved Nat clamp has identical lower and upper value identities and returns that bound for every input; review the interval and preserve input evaluation"
        ctx call state
    | False => match elem Nat eq_nat role [44,45] with
      | True => cm_call_law CmExtremumOperandProof CmExtremumIdentity 2
          (orb(cm_law_same a b, orb(cm_law_nat 0 a, cm_law_nat 0 b)))
          "the resolved Nat minimum/maximum has equal operands or a zero boundary: minimum with zero is zero, maximum with zero is the other value; review the operands before simplifying"
          ctx call state
      | False => cm_call_law CmTrivialPowerProof CmTrivialExponent 2
          (andb (eq_nat role 46) (orb (cm_law_nat 1 a)
            (orb(cm_law_nat 0 b, cm_law_nat 1 b))))
          "the resolved Nat power has exponent zero or one, or base one; exponent zero returns one even when the base is zero; preserve argument evaluation when simplifying"
          ctx call state
      end
    end;

def cm_text_operand_laws (intern : InternState) (ctx : CmContext)
    (call : ClippyCallFact) (state : CmState) : CmState :=
    let role : Nat := cm_call_role call in
    let args : List CmValue := cm_call_args call in
    let text : CmValue := cm_arg_at 0 args in
    let second : CmValue := cm_arg_at 1 args in
    let third : CmValue := cm_arg_at 2 args in
    match eq_nat role 47 with
    | True => cm_call_law CmUnchangedReplaceProof CmUnchangedReplacement 3
        (cm_law_same second third)
        "the resolved text replacement uses the same known value for the needle and replacement and cannot change the text; retain original argument evaluation when removing the scan"
        ctx call state
    | False => match eq_nat role 48 with
      | True => match cm_law_empty_text intern second with
        | True => cm_call_law CmEmptySearchProof CmEmptyText 2 True
            "the resolved starts/ends/contains predicate searches for an explicitly present empty string and is always true; review the search term"
            ctx call state
        | False => cm_call_law CmReflexiveSearchProof CmSameValue 2 (cm_law_same text second)
            "the resolved starts/ends/contains predicate searches a string for the same semantic value and is always true; review the operands"
            ctx call state
        end
      | False => match eq_nat role 49 with
        | True => cm_call_law CmTextByteBoundsProof CmIndexOutsideText 2
            (cm_law_text_outside intern text second)
            "the resolved byte lookup has an index at or beyond the proven literal byte length and returns the out-of-range sentinel zero; review the index, not a guessed character count"
            ctx call state
        | False => match eq_nat role 50 with
          | False => state
          | True => match cm_law_nat 0 third with
            | True => cm_call_law CmEmptySliceProof CmZeroCount 3 True
                "the resolved string slice receives a zero byte count and always returns empty text; review the count while preserving evaluation"
                ctx call state
            | False => cm_call_law CmTextSliceBoundsProof CmIndexOutsideText 3
                (andb (cm_law_text_outside intern text second)
                  (andb(eq_nat(cm_value_kind third, 3), notb (cm_value_io third))))
                "the resolved string slice starts at or beyond the proven literal byte length with a positive count and returns empty text; the third argument is a count, not an end offset"
                ctx call state
            end
          end
        end
      end
    end;

def cm_operand_laws (unit : ClippySemanticUnit) (apis : CmApiIndex)
    (ctx : CmContext) (call : ClippyCallFact) (state : CmState) : CmState :=
    cm_text_operand_laws (cm_intern unit) ctx call
      (cm_extremum_operand_laws ctx call
        (cm_collection_operand_laws (cm_intern unit) ctx call
          (cm_bool_operand_laws apis ctx call
            (cm_nat_bound_laws ctx call (cm_nat_operand_laws ctx call state)))));


def cm_boundary_call (unit : ClippySemanticUnit) (ctx : CmContext)
    (call : ClippyCallFact) (state : CmState) : CmState :=
    let role : Nat := cm_call_role call in
    let node : Nat := cm_call_node call in
    let owned : Bool := cm_boundary unit (cm_owner ctx) role in
    let state1 : CmState := match owned with
      | True => state
      | False => match eq_nat role 1 with
        | True => cm_finding (cm_proof_for CmRawReadProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmOutsideOwner True]
            "raw filesystem read crosses its declared owner boundary; use the checked read API") state
        | False => match eq_nat role 2 with
          | True => cm_finding (cm_proof_for CmRawWriteProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmOutsideOwner True]
            "raw filesystem write crosses its declared owner boundary; use the checked write API") state
          | False => match eq_nat role 3 with
            | True => cm_finding (cm_proof_for CmRawProcessProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmOutsideOwner True]
            "raw process launch crosses its declared owner boundary; use the checked process API") state
            | False => state
            end
          end
        end
      end in
    match andb(notb (cm_policy ctx), andb(cm_unrecovered_error ctx state, eq_nat role 4)) with
    | False => state1
    | True =>
        let code : CmValue := cm_last_value (cm_call_args call) in
        match andb(eq_nat(cm_value_kind code, 3), eq_nat(cm_value_id code, 0)) with
        | False => state1
        | True => cm_finding (cm_proof_for CmFailureExitProof (cm_owner ctx) node
            (cm_branch ctx) (cm_epoch state)
            [cm_known_fact CmCalleeResolved True, cm_known_fact CmCheckedProducer True,
             cm_known_fact CmFailurePath True, cm_known_fact CmNoRecovery True,
             cm_known_fact CmZeroExit True]
            "the resolved exit API receives zero on a checked failure arm; preserve the failure exit status") state1
        end
    end;

def cm_apply_call (unit : ClippySemanticUnit) (apis : CmApiIndex)
    (ctx : CmContext) (node : Nat) (callee : CmValue) (args : List CmValue)
    (state : CmState) : Either QualityInputError (Pair CmValue CmState) :=
    let argc : Nat := length CmValue args in
    match eq_nat(cm_value_kind callee, 2) with
    | False =>
        let observed : CmState := foldl CmValue CmState
          (fun (next : CmState) (value : CmValue) => cm_observe 4 node value next) state args in
        let recursive : Bool := cm_is_self ctx callee in
        let call : ClippyCallFact := CmCall node (cm_value_id callee) (cm_branch ctx)
          (cm_epoch observed) 0 False 0 args recursive in
        Right QualityInputError (Pair CmValue CmState)
          (MkPair CmValue CmState
            (CmValueOf (match recursive with | True => 10 | False => 6 end) node
              0 False (any CmValue cm_value_taint args) False)
            (cm_barrier (cm_event(CmCallEvent call, observed))))
    | True => match cm_api_lookup(cm_value_id callee, apis) with
      | Nothing => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "resolved call lost declaration metadata")
      | Just api =>
        let observed : CmState := (fix observe (values : List CmValue) (position : Nat)
            (next : CmState) : CmState := match values with
          | Nil => next
          | Cons value rest => observe rest (add position 1)
              (match orb (notb (eq_nat(argc, cm_api_arity api)))
                  (andb (cs_argument_escapes(cm_api_summary api, position))
                    (notb (cm_result_alias_argument apis api args position))) with
               | True => cm_observe 4 node value next | False => next end)
          end) args 0 state in
        match ltb_nat(argc, cm_api_arity api) with
        | True => Right QualityInputError (Pair CmValue CmState)
            (MkPair CmValue CmState (cm_unknown node) observed)
        | False => match eq_nat(argc, cm_api_arity api) with
          | False => Right QualityInputError (Pair CmValue CmState)
              (MkPair(CmValue, CmState, cm_unknown node, cm_barrier observed))
          | True =>
            let contract : CmContract := cm_api_contract api in
            let direct_role : Nat := cm_contract_role contract in
            let role : Nat := match eq_nat direct_role 0 with
              | True => cs_work_role (cm_api_summary api) | False => direct_role end in
            let pure : Bool := cm_call_purity apis api args in
            let call : ClippyCallFact := CmCall node (sc_decl_name (cm_api_decl api))
              (cm_branch ctx) (cm_epoch observed) role pure (match cs_cost (cm_api_summary api) with
                | Just cost => cost | Nothing => cm_contract_cost contract end) args False in
            let value : CmValue := match cm_result_identity_transfer apis role args with
              | Just alias => alias | Nothing => cm_call_result node api args end in
            let updated : CmState := cm_event (CmCallEvent call)
              (cm_result_identity_law apis ctx call
                (cm_operand_laws unit apis ctx call
                  (cm_logic_call ctx call (cm_boundary_call unit ctx call observed)))) in
            let flowed : CmState := cm_execute node value updated in
            let rendered : CmState := match andb (elem Nat eq_nat role [5,6])
                (any CmValue cm_value_taint args) with
              | True => cm_event(CmFlowEvent (CmFlow node 6 (cm_value_id (cm_last_value args))), flowed)
              | False => flowed
              end in
            Right QualityInputError (Pair CmValue CmState) (MkPair CmValue CmState value
              (match pure with | True => rendered | False => cm_barrier rendered end))
        end
      end
      end
    end;

-- Only the TERMINAL value of a failure arm establishes conversion to success.
-- Intermediate Right values that are subsequently mapped back to Left do not.
def cm_arm_outcome (ctx : CmContext) (node : Nat) (value : CmValue) (state : CmState) : CmState :=
    match cm_unrecovered_error ctx state with
    | False => state
    | True => match cm_policy ctx with
      | True => cm_event(CmFlowEvent (CmFlow node 9 (cm_value_id value)), state)
      | False =>
          let converted : Bool := eq_nat(cm_value_kind value, 8) in
          match converted with
          | False => state
          | True => cm_finding (cm_proof_for CmFailureSuccessProof (cm_owner ctx) node
              (cm_branch ctx) (cm_epoch state)
              [cm_known_fact CmCheckedProducer True, cm_known_fact CmFailurePath True,
               cm_known_fact CmNoRecovery True, cm_known_fact CmSuccessConstructor True]
              "a checked failure arm returns success without recovery; propagate the failure or make the recovery contract explicit")
              (cm_event(CmFlowEvent (CmFlow node 8 (cm_value_id value)), state))
          end
      end
    end;
