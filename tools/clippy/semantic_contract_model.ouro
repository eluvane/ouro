-- Snapshot-local function contracts. Unknown is explicit in every property;
-- these summaries are not acceptance certificates or permission to delete APIs.
import "../../compiler/semantic_scope.ouro";

inductive CsStatus : Type :=
  | CsPending : CsStatus | CsActive : CsStatus | CsComplete : CsStatus
  | CsUnsupported : CsStatus | CsCycle : CsStatus | CsDepth : CsStatus
  | CsBudget : CsStatus;

inductive CsEffect : Type :=
  | CsUnknownEffect : CsEffect | CsPure : CsEffect | CsReadOnly : CsEffect
  | CsAllocation : CsEffect | CsFilesystemRead : CsEffect
  | CsFilesystemWrite : CsEffect | CsProcess : CsEffect
  | CsReporting : CsEffect | CsMutation : CsEffect;

inductive CsResult : Type :=
  | CsUnknownResult : CsResult | CsRequiredResult : CsResult
  | CsArgumentResult : Nat -> CsResult | CsSourceResult : CsResult
  | CsSuccessResult : CsResult | CsFailureResult : CsResult
  | CsPolicyResult : CsResult;

inductive CsOrigin : Type :=
  | CsUnknownOrigin : CsOrigin | CsArgumentOrigin : Nat -> CsOrigin
  | CsLiteralOrigin : Nat -> Nat -> CsOrigin
  | CsDelegateOrigin : Nat -> List Nat -> CsOrigin;

inductive CsArgument : Type :=
  | CsUnknownArgument : CsArgument | CsIgnoredArgument : CsArgument
  | CsReturnedArgument : CsArgument | CsForwardedArgument : Nat -> CsArgument;

-- module, declaration, completion, effects, result behavior, return origin,
-- argument observations, cost, mutation, inherited work operation.
inductive CsFunctionContract : Type :=
  | CsContract : Nat -> Nat -> CsStatus -> CsEffect -> CsResult -> CsOrigin
      -> List CsArgument -> Maybe Nat -> Maybe Bool -> Nat -> CsFunctionContract;

def cs_status (c : CsFunctionContract) : CsStatus :=
    match c with | CsContract _ _ value _ _ _ _ _ _ _ => value end;
def cs_effect (c : CsFunctionContract) : CsEffect :=
    match c with | CsContract _ _ _ value _ _ _ _ _ _ => value end;
def cs_result (c : CsFunctionContract) : CsResult :=
    match c with | CsContract _ _ _ _ value _ _ _ _ _ => value end;
def cs_arguments (c : CsFunctionContract) : List CsArgument :=
    match c with | CsContract _ _ _ _ _ _ value _ _ _ => value end;
def cs_cost (c : CsFunctionContract) : Maybe Nat :=
    match c with | CsContract _ _ _ _ _ _ _ value _ _ => value end;
def cs_mutation (c : CsFunctionContract) : Maybe Bool :=
    match c with | CsContract _ _ _ _ _ _ _ _ value _ => value end;
def cs_work_role (c : CsFunctionContract) : Nat :=
    match c with | CsContract _ _ _ _ _ _ _ _ _ value => value end;

def cs_complete (c : CsFunctionContract) : Bool :=
    match cs_status c with
    | CsComplete => True | CsPending => False | CsActive => False
    | CsUnsupported => False | CsCycle => False | CsDepth => False | CsBudget => False end;

def cs_pure (c : CsFunctionContract) : Bool :=
    andb (cs_complete c) (match cs_effect c with
      | CsPure => True | CsUnknownEffect => False | CsReadOnly => False
      | CsAllocation => False | CsFilesystemRead => False | CsFilesystemWrite => False
      | CsProcess => False | CsReporting => False | CsMutation => False end);

def cs_required (c : CsFunctionContract) : Bool :=
    andb (cs_complete c) (match cs_result c with
      | CsRequiredResult => True | CsUnknownResult => False | CsArgumentResult _ => False
      | CsSourceResult => False | CsSuccessResult => False | CsFailureResult => False
      | CsPolicyResult => False end);

def cs_unknown (decl : ScDecl) (status : CsStatus) : CsFunctionContract :=
    CsContract (sc_decl_module decl) (sc_decl_name decl) status CsUnknownEffect
      CsUnknownResult CsUnknownOrigin [] (Nothing Nat) (Nothing Bool) 0;

-- Return and ignore are NOT observations. An unknown callee remains a possible
-- escape, suppressing an unobserved-result claim rather than guessing its intent.
def cs_argument_escapes (c : CsFunctionContract) (position : Nat) : Bool :=
    match cs_complete c with
    | False => True
    | True => match nth CsArgument CsUnknownArgument position (cs_arguments c) with
      | CsIgnoredArgument => False | CsReturnedArgument => False
      | CsUnknownArgument => True | CsForwardedArgument _ => True end
    end;
