-- Extra consumers at the existing producer join. This module has no AST input.
import "semantic_calls.ouro";

-- These roles are assigned only by the canonical declaration registry.
def cm_quality_consumer_arity (role : Nat) : Nat :=
    match elem Nat eq_nat role [18,43,55,62] with
    | True => 2
    | False => match eq_nat role 61 with | True => 4 | False => 3 end
    end;

def cm_quality_replicate (outer : ClippyCallFact) : Maybe CmQualityKind :=
    let role : Nat := cm_call_role outer in
    match eq_nat role 18 with
    | True => Just CmQualityKind CmLengthReplicate
    | False => match eq_nat role 55 with
      | True => Just CmQualityKind CmNullReplicate
      | False => match elem Nat eq_nat role [56,57] with
        | True => Just CmQualityKind CmEndpointReplicate
        | False => match eq_nat role 43 with
          | True => Just CmQualityKind CmReverseReplicate
          | False => match andb (elem Nat eq_nat role [40,41])
              (notb (cm_law_nat(0, cm_arg_at(1, cm_call_args outer)))) with
            | True => Just CmQualityKind CmBoundedReplicate
            | False => match eq_nat role 61 with
              | True => Just CmQualityKind CmNthReplicate
              | False => Nothing CmQualityKind
              end
            end
          end
        end
      end
    end;

def cm_quality_singleton (outer : ClippyCallFact) : Maybe CmQualityKind :=
    let role : Nat := cm_call_role outer in
    match elem Nat eq_nat role [18,55] with
    | True => Just CmQualityKind CmSingletonSize
    | False => match orb (elem Nat eq_nat role [56,57])
        (andb(eq_nat role 61, cm_law_nat(0, cm_arg_at(2, cm_call_args outer)))) with
      | True => Just CmQualityKind CmSingletonEndpoint
      | False => match eq_nat role 62 with
        | True => Just CmQualityKind CmSingletonTail
        | False => match eq_nat role 43 with
          | True => Just CmQualityKind CmSingletonReverse
          | False => Nothing CmQualityKind
          end
        end
      end
    end;

def cm_quality_prefix (outer : ClippyCallFact) (inner : ClippyCallFact) : Maybe CmQualityKind :=
    let role : Nat := cm_call_role outer in
    let before : CmValue := cm_arg_at(1, cm_call_args inner) in
    let after : CmValue := cm_arg_at(1, cm_call_args outer) in
    match cm_value_positive_nat before with
    | False => Nothing CmQualityKind
    | True => match eq_nat role 55 with
      | True => Just CmQualityKind CmNullTake
      | False => match eq_nat role 56 with
        | True => Just CmQualityKind CmHeadTake
        | False => match andb (eq_nat role 40)
            (andb(cm_value_positive_nat after, ltb_nat(cm_value_id after, cm_value_id before))) with
          | True => Just CmQualityKind CmTightenTake
          | False => Nothing CmQualityKind
          end
        end
      end
    end;

def cm_quality_select (outer : ClippyCallFact) (inner : ClippyCallFact) : Maybe CmQualityKind :=
    let role : Nat := cm_call_role outer in
    let producer : Nat := cm_call_role inner in
    match eq_nat producer 58 with
    | True => cm_quality_replicate outer
    | False => match eq_nat producer 60 with
      | True => cm_quality_singleton outer
      | False => match eq_nat producer 40 with
        | True => cm_quality_prefix outer inner
        | False => match eq_nat producer 43 with
          | True => match eq_nat role 55 with
            | True => Just CmQualityKind CmNullReverse
            | False => match elem Nat eq_nat role [56,57] with
              | True => Just CmQualityKind CmEndpointReverse
              | False => Nothing CmQualityKind
              end
            end
          | False => match eq_nat producer 59 with
            | True => match eq_nat role 18 with
              | True => Just CmQualityKind CmLengthIntersperse
              | False => match eq_nat role 55 with
                | True => Just CmQualityKind CmNullIntersperse
                | False => match elem Nat eq_nat role [56,57] with
                  | True => Just CmQualityKind CmEndpointIntersperse
                  | False => Nothing CmQualityKind
                  end
                end
              end
            | False => match andb(eq_nat producer 21, eq_nat role 55) with
              | True => Just CmQualityKind CmNullAppend
              | False => match andb (eq_nat producer 41)
                  (andb (eq_nat role 41)
                    (andb (cm_value_positive_nat (cm_arg_at(1, cm_call_args inner)))
                      (cm_value_positive_nat (cm_arg_at(1, cm_call_args outer))))) with
                | True => Just CmQualityKind CmNestedDrop
                | False => Nothing CmQualityKind
                end
              end
            end
          end
        end
      end
    end;

def cm_quality_message (kind : CmQualityKind) : String :=
    match kind with
    | CmNullReverse => "reversal preserves emptiness; test the original list without constructing a reversal"
    | CmEndpointReverse => "reversal exchanges head and last, including the empty-list default; query the opposite endpoint of the original list"
    | CmNullAppend => "an appended list is empty exactly when both inputs are empty; test both inputs without constructing their append"
    | CmLengthReplicate => "replicate has exactly the supplied count of elements; use that count without materializing the list"
    | CmNullReplicate => "replicate is empty exactly when its count is zero; test the count without materializing the list"
    | CmEndpointReplicate => "a nonempty replicate has its payload at both endpoints; select the payload for a positive count and the original default for zero"
    | CmReverseReplicate => "all elements of replicate are equal; its reversal cannot change the list"
    | CmBoundedReplicate => "take/drop of an unbound replicate can adjust its count instead: take uses the minimum, drop the saturating difference"
    | CmNthReplicate => "indexed lookup of replicate returns the payload below the count and the original default otherwise; avoid materializing the list"
    | CmLengthIntersperse => "intersperse has length saturating-subtract(2*n, 1), where n is the original length; measure the original without allocating separators"
    | CmNullIntersperse => "intersperse preserves emptiness; test the original list without allocating separators"
    | CmEndpointIntersperse => "intersperse preserves both endpoints and the empty-list default; query the original list"
    | CmNullTake => "a take with a proven positive count preserves emptiness; test the original list without copying its prefix"
    | CmHeadTake => "a take with a proven positive count preserves head and its empty-list default; query the original list"
    | CmTightenTake => "the outer positive take count is strictly smaller than the inner count; take the smaller prefix directly from the original list"
    | CmNestedDrop => "two positive literal drop offsets compose by addition; express the combined offset with one drop; no allocation or asymptotic saving is claimed"
    | CmSingletonSize => "the known singleton has length one and is nonempty regardless of its payload"
    | CmSingletonEndpoint => "head, last or zero-index lookup of the known singleton returns its payload; the eager default must still be evaluated"
    | CmSingletonTail => "the known singleton has an empty tail of the same element type"
    | CmSingletonReverse => "reversal cannot change the known singleton; retain the singleton without reversing it"
    end;

-- Cost depends on the traversed input, not on a dynamic type or separator.
-- Replication at zero and appending a constant left side stay outside these laws.
def cm_quality_dynamic (inner : ClippyCallFact) : Bool :=
    let args : List CmValue := cm_call_args inner in
    match eq_nat(cm_call_role inner, 58) with
    | True => andb (notb (cm_law_nat(0, cm_arg_at 2 args)))
        (orb (notb (cm_value_constant (cm_arg_at 1 args)))
          (notb (cm_value_constant (cm_arg_at 2 args))))
    | False => match elem Nat eq_nat (cm_call_role inner) [21,60] with
      | True => notb (cm_value_constant (cm_arg_at 1 args))
      | False => notb (cm_value_constant (cm_last_value args))
      end
    end;

-- The caller supplies the existing composition proof constructor, including
-- known arguments, arity, purity, lineage, branch and effect-epoch obligations.
def cm_quality_pair
    (emit : CmProofKind -> Nat -> Nat -> List CmEvidence -> String -> List CgSProof)
    (outer : ClippyCallFact) (inner : ClippyCallFact) (temporary : Bool) : List CgSProof :=
    match cm_quality_select outer inner with
    | Nothing => []
    | Just kind =>
        let inner_arity : Nat := match elem Nat eq_nat (cm_call_role inner) [43,60] with
          | True => 2 | False => 3 end in
        let facts : List CmEvidence :=
            [cm_known_fact CmTypeArgumentsAgree
               (cm_law_same(cm_arg_at(0, cm_call_args outer), cm_arg_at(0, cm_call_args inner))),
             cm_known_fact CmCollectionLawEstablished
               (eq_nat(cm_value_kind (cm_last_value (cm_call_args outer)), 6)),
             cm_known_fact CmProducerUnbound temporary,
             cm_known_fact(CmDynamicInput, cm_quality_dynamic inner)] in
        let cost : List CmEvidence := match cm_quality_cost_required kind with
          | False => []
          | True => [cm_known_fact CmMeaningfulCost
              (andb (eq_nat(cm_call_cost inner, 1))
                (orb(notb (eq_nat(cm_call_role outer, 43)), eq_nat(cm_call_cost outer, 1))))]
          end in
        emit (CmQualityProof kind) (cm_quality_consumer_arity (cm_call_role outer)) inner_arity
          (append CmEvidence facts cost)
          (prim_string_concat (cm_quality_message kind)
            "; review required: preserve original argument evaluation, defaults and ownership; no automatic edit")
    end;
