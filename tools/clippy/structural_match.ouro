-- Match summaries contain only facts proven by a closed local enum inventory.
-- Unknown/imported/indexed types and effectful expressions are not equivalent
-- merely because the source text looks alike.

import "structural_model.ouro",
  "../../std/natx.ouro";

inductive CgSArms : Type :=
  | MkCgSArms : Nat -> List Nat -> Maybe CgSAtom -> Bool -> CgSArms;

def cg_s_unknown_arm (s : CgSArms) : CgSArms :=
    match s with | MkCgSArms n ids atom _ =>
      MkCgSArms (add n 1) ids atom False end;

def cg_s_arm (c : CgSCatalog) (env : List CgSBinding) (expected : List Nat)
    (pats : List Nat) (body : Expr) (s : CgSArms) : CgSArms :=
    match pats with
    | Nil => cg_s_unknown_arm s
    | Cons ctor binders => match binders with
      | Cons _ _ => cg_s_unknown_arm s
      | Nil => match cg_s_lookup ctor env with
        | Just _ => cg_s_unknown_arm s
        | Nothing => match s with
          | MkCgSArms n seen first comparable =>
              let atom : Maybe CgSAtom := cg_s_atom c env body in
              let same : Bool := match n with
                | Z => cg_s_maybe_equal atom atom
                | S _ => cg_s_maybe_equal first atom
                end in
              let first2 : Maybe CgSAtom := match n with
                | Z => atom
                | S _ => first
                end in
              MkCgSArms (add n 1) (Cons Nat ctor seen) first2
                (andb comparable (andb same
                  (andb (elem Nat eq_nat ctor expected)
                    (notb (elem Nat eq_nat ctor seen)))))
          end
        end
      end
    end;

def cg_s_branch_summary (c : CgSCatalog) (env : List CgSBinding) (expected : List Nat)
    : Nat -> Expr -> CgSArms -> Either QualityInputError CgSArms :=
  fix go (fuel : Nat) (branches : Expr) (s : CgSArms) : Either QualityInputError CgSArms :=
    match fuel with
    | Z => Left QualityInputError CgSArms (QualityInvalidInput "branch fact traversal exhausted")
    | S fuel2 => match branches with
      | EBranch pats body rest => go fuel2 rest (cg_s_arm c env expected pats body s)
      | ENoBranch => Right QualityInputError CgSArms s
      | EVar _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EHole _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | ESort _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | ENat _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EApp _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | ELam _ _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EPi _ _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | ELet _ _ _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EAscribe _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EMatch _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EFix _ _ _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EEffectRow _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EPerform _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EDo _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EHandle _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EBinder _ _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | ENoBinder => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EMultiMatch _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EStr _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EDoBind _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EList _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EListSpread _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | ESpan _ _ inner => go fuel2 inner s
      | EFallible _ _ _ _ => Left QualityInputError CgSArms (QualityInvalidInput "invalid compiler branch spine")
      | EOpen _ _ => Left QualityInputError CgSArms (QualityInvalidInput "unresolved module open in compiler branch spine")
      end
    end;

def cg_s_row_summary (c : CgSCatalog) (env : List CgSBinding) (expected : List Nat)
    : List (Pair (List (Pair Nat (List Nat))) Expr) -> CgSArms -> CgSArms :=
  fix go (rows : List (Pair (List (Pair Nat (List Nat))) Expr)) (s : CgSArms) : CgSArms :=
    match rows with
    | Nil => s
    | Cons row rest => match row with
      | MkPair pats body => match pats with
        | Nil => go(rest, cg_s_unknown_arm s)
        | Cons pat more => match more with
          | Cons _ _ => go(rest, cg_s_unknown_arm s)
          | Nil => match pat with
            | MkPair ctor binders => go rest
                (cg_s_arm c env expected (Cons Nat ctor binders) body s)
            end
          end
        end
      end
    end;

def cg_s_match_fact (owner : Nat) (node : Nat) (enum_id : Nat)
    (expected : List Nat) (summary : CgSArms) : CgSFact :=
    match summary with
    | MkCgSArms count _ atom comparable =>
        CgSMatch owner node enum_id count atom
          (andb comparable (andb (ltb_nat 1 count)
            (eq_nat(count, length Nat expected))))
    end;

-- An enum-typed local/constructor is a value, never an effectful scrutinee.
-- The enum identity was captured at binding introduction, before later shadowing.
def cg_s_match_inventory (c : CgSCatalog) (env : List CgSBinding) (scrut : Expr)
    : Maybe (Pair Nat (List Nat)) :=
    match cg_s_value_enum c env scrut with
    | Nothing => Nothing (Pair(Nat, List Nat))
    | Just enum_id => match lookup Nat (List Nat) eq_nat enum_id (cg_s_enums c) with
      | Nothing => Nothing (Pair(Nat, List Nat))
      | Just ctors => Just(Pair(Nat, List Nat), MkPair Nat (List Nat) enum_id ctors)
      end
    end;
