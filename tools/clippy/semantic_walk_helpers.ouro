-- Shared transfer helpers. The visitor is passed in; no helper reparses or
-- walks an expression a second time to decide a rule.
import "semantic_calls.ouro",
  "../../std/listx.ouro",
  "../../compiler/semantic_scope.ouro";

def cm_return (value : CmValue) (state : CmState) : Either QualityInputError (Pair CmValue CmState) :=
    Right(QualityInputError, Pair CmValue CmState, MkPair CmValue CmState value state);

-- Discard is recorded, not diagnosed immediately: another alias may observe
-- the same value later. The final consumer joins producer/observation facts.
def cm_discard (node : Nat) (value : CmValue) (state : CmState) : CmState :=
    cm_observe 5 node value (cm_execute node value state);

def cm_visit_args
    (visit : CmContext -> Bool -> Expr -> CmState -> Either QualityInputError (Pair CmValue CmState))
    (ctx : CmContext) : List Expr -> CmState -> List CmValue
    -> Either QualityInputError (Pair (List CmValue) CmState) :=
  fix go (args : List Expr) (state : CmState) (rev : List CmValue)
      : Either QualityInputError (Pair (List CmValue) CmState) :=
    match args with
    | Nil => Right QualityInputError (Pair(List CmValue, CmState))
        (MkPair(List CmValue, CmState, reverse_lin CmValue rev, state))
    | Cons term rest => match visit ctx False term state with
      | Left error => Left QualityInputError (Pair(List CmValue, CmState)) error
      | Right step => match step with
        | MkPair value updated => go rest updated (Cons CmValue value rev)
        end
      end
    end;

def cm_visit_do
    (visit : CmContext -> Bool -> Expr -> CmState -> Either QualityInputError (Pair CmValue CmState))
    (terminal : Bool) : List Expr -> CmContext -> CmState
    -> Either QualityInputError (Pair CmValue CmState) :=
  fix go (statements : List Expr) (ctx : CmContext) (state : CmState)
      : Either QualityInputError (Pair CmValue CmState) :=
    match statements with
    | Nil => cm_return(cm_unknown (cm_fresh state), state)
    | Cons term rest =>
        let last : Bool := match rest with | Nil => True | Cons _ _ => False end in
        match do_bind_of term with
        | Just binding => match binding with
          | MkPair name action => match visit ctx False action state with
            | Left error => Left QualityInputError (Pair CmValue CmState) error
            | Right step => match step with
              | MkPair value updated =>
                  let unwrapped : CmValue := cm_unwrap_io(cm_fresh updated, value) in
                  match cm_bind name unwrapped ctx
                      (cm_execute(cm_fresh updated, unwrapped, cm_io_barrier(value, cm_tag 220 updated))) with
                  | MkPair bound next => go rest bound
                      (cm_event (CmFlowEvent (CmFlow (cm_fresh updated) 2
                        (cm_value_id unwrapped))) next)
                  end
              end
            end
          end
        | Nothing => match visit ctx (andb terminal last) term state with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with
            | MkPair value updated => match last with
              | True => cm_return value updated
              | False => go rest ctx (cm_discard (cm_fresh state)
                  (cm_unwrap_io(cm_fresh state, value)) (cm_io_barrier value updated))
              end
            end
          end
        end
    end;

-- Pattern heads belong to the compiler constructor namespace (lower_env),
-- not the executable local-variable namespace. Only that declaration's
-- registered constructor role can establish a failure arm.
def cm_pattern (unit : ClippySemanticUnit) (apis : CmApiIndex)
    (ctx : CmContext) (ctor : Nat) (names : List Nat) (state : CmState)
    : Either QualityInputError (Pair CmContext CmState) :=
    match sc_lookup_global(ctor, cm_index unit) with
    | Nothing => Left(QualityInputError, Pair CmContext CmState, QualityInvalidInput "unresolved pattern constructor")
    | Just decl => match eq_nat(sc_decl_kind decl, 3) with
      | False => Left(QualityInputError, Pair CmContext CmState, QualityInvalidInput "pattern is not a constructor declaration")
      | True => match cm_api_lookup ctor apis with
        | Nothing => Left(QualityInputError, Pair CmContext CmState, QualityInvalidInput "constructor metadata unavailable")
        | Just api =>
            let role : Nat := cm_contract_role (cm_api_contract api) in
            let failed : Bool := andb(cm_subject_checked ctx, eq_nat role 10) in
            let selected : CmState := match andb(cm_subject_checked ctx, elem Nat eq_nat role [10,11]) with
              | False => state
              | True => cm_event (CmFlowEvent (CmFlow (cm_branch ctx) 22 role))
                  (cm_event(CmFlowEvent (CmFlow(cm_branch ctx, 23, cm_epoch state)), state))
              end in
            Right QualityInputError (Pair CmContext CmState)
              (cm_bind_names names failed
                (match failed with
                 | True => cm_context_failure_epoch(cm_context_pattern ctx role, cm_epoch state)
                 | False => cm_context_pattern ctx role end)
                (cm_tag(ctor, cm_tag(length Nat names, cm_tag 230 selected))))
        end
      end
    end;

def cm_patterns (unit : ClippySemanticUnit) (apis : CmApiIndex)
    : List (Pair Nat (List Nat)) -> CmContext -> CmState
    -> Either QualityInputError (Pair CmContext CmState) :=
  fix go (patterns : List (Pair Nat (List Nat))) (ctx : CmContext) (state : CmState)
      : Either QualityInputError (Pair CmContext CmState) :=
    match patterns with
    | Nil => Right(QualityInputError, Pair CmContext CmState, MkPair CmContext CmState ctx state)
    | Cons pattern rest => match pattern with
      | MkPair ctor names => match cm_pattern unit apis ctx ctor names state with
        | Left error => Left QualityInputError (Pair CmContext CmState) error
        | Right scoped => match scoped with
          | MkPair bound updated => go rest bound updated
          end
        end
      end
    end;

def cm_visit_rows (unit : ClippySemanticUnit) (apis : CmApiIndex)
    (visit : CmContext -> Bool -> Expr -> CmState -> Either QualityInputError (Pair CmValue CmState))
    (ctx : CmContext) (terminal : Bool)
    : List (Pair (List (Pair Nat (List Nat))) Expr) -> CmState
    -> Either QualityInputError (Pair CmValue CmState) :=
  fix go (rows : List (Pair (List (Pair Nat (List Nat))) Expr)) (state : CmState)
      : Either QualityInputError (Pair CmValue CmState) :=
    match rows with
    | Nil => cm_return(cm_unknown (cm_fresh state), cm_barrier (cm_tag 231 state))
    | Cons row rest => match row with
      | MkPair patterns body =>
          let branch : Nat := cm_fresh state in
          match cm_patterns unit apis patterns
              (cm_context_arm ctx branch False) (cm_next (cm_barrier state)) with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right scoped => match scoped with
            | MkPair bound updated => match visit bound terminal body updated with
              | Left error => Left QualityInputError (Pair CmValue CmState) error
              | Right step => match step with
                | MkPair value next => go rest (match terminal with
                    | True => cm_arm_outcome bound branch value (cm_observe 4 branch value next) | False => next end)
                end
              end
            end
          end
      end
    end;

def cm_visit_handlers (_unit : ClippySemanticUnit)
    (visit : CmContext -> Bool -> Expr -> CmState -> Either QualityInputError (Pair CmValue CmState))
    (ctx : CmContext) : List (Pair Nat (Pair (List Nat) Expr)) -> CmState
    -> Either QualityInputError (Pair CmValue CmState) :=
  fix go (clauses : List (Pair Nat (Pair (List Nat) Expr))) (state : CmState)
      : Either QualityInputError (Pair CmValue CmState) :=
    match clauses with
    | Nil => cm_return(cm_unknown (cm_fresh state), cm_barrier state)
    | Cons clause rest => match clause with
      | MkPair operation payload => match payload with
        | MkPair names body =>
          -- `pure` is a reserved handler clause, not a global operation.
          -- Unknown effect ops still visit the clause body so analysis
          -- completes instead of aborting the selected file.
          match cm_bind_names names False
              (cm_context_region(ctx, cm_fresh state))
              (cm_next (cm_tag(operation, cm_barrier state))) with
            | MkPair bound updated => match visit bound True body updated with
              | Left error => Left QualityInputError (Pair CmValue CmState) error
              | Right step => match step with | MkPair _ next => go rest next end
              end
            end
        end
      end
    end;
