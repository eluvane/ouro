-- Closed collection-law identities; the canonical policy remains in the JSON registry.
import "../../compiler/semantic_scope.ouro";

inductive CmQualityKind : Type :=
  | CmNullReverse : CmQualityKind
  | CmEndpointReverse : CmQualityKind
  | CmNullAppend : CmQualityKind
  | CmLengthReplicate : CmQualityKind
  | CmNullReplicate : CmQualityKind
  | CmEndpointReplicate : CmQualityKind
  | CmReverseReplicate : CmQualityKind
  | CmBoundedReplicate : CmQualityKind
  | CmNthReplicate : CmQualityKind
  | CmLengthIntersperse : CmQualityKind
  | CmNullIntersperse : CmQualityKind
  | CmEndpointIntersperse : CmQualityKind
  | CmNullTake : CmQualityKind
  | CmHeadTake : CmQualityKind
  | CmTightenTake : CmQualityKind
  | CmNestedDrop : CmQualityKind
  | CmSingletonSize : CmQualityKind
  | CmSingletonEndpoint : CmQualityKind
  | CmSingletonTail : CmQualityKind
  | CmSingletonReverse : CmQualityKind;

def cm_quality_rule (kind : CmQualityKind) : String :=
    match kind with
    | CmNullReverse => "OURO-CLIPPY-COLLECTION-001"
    | CmEndpointReverse => "OURO-CLIPPY-COLLECTION-002"
    | CmNullAppend => "OURO-CLIPPY-COLLECTION-003"
    | CmLengthReplicate => "OURO-CLIPPY-COLLECTION-004"
    | CmNullReplicate => "OURO-CLIPPY-COLLECTION-005"
    | CmEndpointReplicate => "OURO-CLIPPY-COLLECTION-006"
    | CmReverseReplicate => "OURO-CLIPPY-COLLECTION-007"
    | CmBoundedReplicate => "OURO-CLIPPY-COLLECTION-008"
    | CmNthReplicate => "OURO-CLIPPY-COLLECTION-009"
    | CmLengthIntersperse => "OURO-CLIPPY-COLLECTION-010"
    | CmNullIntersperse => "OURO-CLIPPY-COLLECTION-011"
    | CmEndpointIntersperse => "OURO-CLIPPY-COLLECTION-012"
    | CmNullTake => "OURO-CLIPPY-COLLECTION-013"
    | CmHeadTake => "OURO-CLIPPY-COLLECTION-014"
    | CmTightenTake => "OURO-CLIPPY-COLLECTION-015"
    | CmNestedDrop => "OURO-CLIPPY-COLLECTION-016"
    | CmSingletonSize => "OURO-CLIPPY-COLLECTION-017"
    | CmSingletonEndpoint => "OURO-CLIPPY-COLLECTION-018"
    | CmSingletonTail => "OURO-CLIPPY-COLLECTION-019"
    | CmSingletonReverse => "OURO-CLIPPY-COLLECTION-020"
    end;

def cm_quality_cost_required (kind : CmQualityKind) : Bool :=
    match kind with
    | CmNullReverse => True
    | CmEndpointReverse => True
    | CmNullAppend => True
    | CmLengthReplicate => True
    | CmNullReplicate => True
    | CmEndpointReplicate => True
    | CmReverseReplicate => True
    | CmBoundedReplicate => True
    | CmNthReplicate => True
    | CmLengthIntersperse => True
    | CmNullIntersperse => True
    | CmEndpointIntersperse => True
    | CmNullTake => True
    | CmHeadTake => True
    | CmTightenTake => True
    | CmNestedDrop => False
    | CmSingletonSize => False
    | CmSingletonEndpoint => False
    | CmSingletonTail => False
    | CmSingletonReverse => False
    end;
