-- Thin keep-import surface for std/process. The process cone stays
-- skip-harvested unless this file is the selected root.
import "../../std/processx.ouro",
  "../../std/process.ouro",
  "../../std/io.ouro";


def cg_run_checked (cmd : String) (cmd_args : List String)
    : IO (Either String ProcResult) :=
    -- Status 1 carries a complete session with rejected source files. Keep its
    -- stdout so the caller can validate every frame and the matching footer.
    do let! ran := process_run_expected_codes(command_spec cmd cmd_args, [0, 1]);
       match ran with
       | Left error =>
           io_pure (Either String ProcResult)
             (Left String ProcResult (process_error_message error))
       | Right result =>
           io_pure (Either String ProcResult)
             (Right String ProcResult result)
       end
