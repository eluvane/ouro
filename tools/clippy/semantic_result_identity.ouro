-- Scalar Result laws at the existing resolved-call transfer boundary.
import "semantic_result_roles.ouro";

def cm_result_identity_law (apis : CmApiIndex) (ctx : CmContext)
    (call : ClippyCallFact) (state : CmState) : CmState :=
    let role : Nat := cm_call_role call in
    match cm_result_identity_transfer apis role (cm_call_args call) with
    | Nothing => state
    | Just _ =>
        let kind : CmProofKind := match eq_nat role 201 with
          | True => CmResultMapIdentityProof
          | False => match eq_nat role 212 with
            | True => CmMaybeMapIdentityProof | False => CmResultMapErrorIdentityProof end
          end in
        cm_finding (cm_proof_for kind (cm_owner ctx) (cm_call_node call)
          (cm_call_branch call) (cm_call_epoch call)
          [cm_known_fact(CmCalleeResolved, elem Nat eq_nat role [201,202,203,212]),
           cm_known_fact CmKnownArguments (all CmValue (fun (value : CmValue) =>
             andb(cm_value_known value, notb (cm_value_io value))) (cm_call_args call)),
           cm_known_fact(CmPureExpression, cm_call_pure call),
           cm_known_fact CmExactArity
             (eq_nat(length(CmValue, cm_call_args call), cm_result_arity role)),
           cm_known_fact CmIdentityCallback True,
           cm_known_fact CmTypeArgumentsAgree True,
           cm_known_fact CmContractAgreement True]
          "the resolved Result/Maybe map invokes a complete pure unary identity callback with unchanged input/output types; review using the original result while preserving evaluation and the checked-result observation obligation") state
    end;

-- Passing a result through an identity map must not discharge the original
-- must-observe obligation. Other arguments and unknown callbacks still escape.
def cm_result_alias_argument (apis : CmApiIndex) (api : CmApi)
    (args : List CmValue) (position : Nat) : Bool :=
    match cm_result_identity_transfer apis (cm_result_role api) args with
    | Nothing => False
    | Just _ => eq_nat(position, cm_result_subject_slot (cm_result_role api))
    end;
