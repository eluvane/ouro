-- Shared worker policy. Allocation epochs and process recycling are distinct.
import "../../std/listx.ouro",
  "../../std/string_prims.ouro";

def cg_session_version : String := "ouro.clippy-session.v2";

def cg_session_epoch_roots : Nat := 2;

def cg_session_max_roots : Nat := 128;

def cg_session_cache_rows : Nat := 128;

def cg_session_kib : Nat := mul 32 32;

def cg_session_cache_bytes : Nat := mul(8, mul cg_session_kib cg_session_kib);

def cg_session_large_root_kib : Nat := 256;

def cg_session_large_root_bytes : Nat := mul cg_session_large_root_kib cg_session_kib;

def cg_session_heap_mib : Nat := 256;

def cg_session_heap_bytes : Nat := mul(cg_session_heap_mib, mul cg_session_kib cg_session_kib);

-- A small retained heap can still make later root work expensive: compiler
-- intern pools are shared linear tables. Bound cross-root vocabulary as well.
def cg_session_intern_limit : Nat := mul 32 32;

def cg_session_intern_full (names : Nat) (strings : Nat) : Bool :=
    notb (ltb_nat(add names strings, cg_session_intern_limit));

-- This is retained input size, not a claim about the allocator's object size.
-- The runtime watermark independently accounts for copied survivor versions.
def cg_session_recycle (roots : Nat) (cache_bytes : Nat)
    (large_root : Bool) (heap_bytes : Nat) : Bool :=
    orb (notb (ltb_nat roots cg_session_max_roots))
      (orb (notb (ltb_nat cache_bytes cg_session_cache_bytes))
        (orb(large_root, notb (ltb_nat heap_bytes cg_session_heap_bytes))));

def cg_session_take : Nat -> List String -> List String :=
  fix go (count : Nat) (paths : List String) : List String :=
    match count with
    | Z => Nil String
    | S remaining => match paths with
      | Nil => Nil String
      | Cons path rest => Cons String path (go remaining rest)
      end
    end;

def cg_session_drop : Nat -> List String -> List String :=
  fix go (count : Nat) (paths : List String) : List String :=
    match count with
    | Z => paths
    | S remaining => match paths with
      | Nil => Nil String
      | Cons _ rest => go remaining rest
      end
    end;
