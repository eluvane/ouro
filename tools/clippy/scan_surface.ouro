-- Thin keep-import surface for scan.ouro. The 608-line scan cone stays
-- skip-harvested unless this file is the selected root.
import "scan.ouro",
  "scan_types.ouro",
  "../quality/input_error.ouro",
  "../quality/registry.ouro",
  "../../std/json_types.ouro";

def scan_rules_path (root : String) : String :=
    cg_rules_path root;

def scan_load_rules (root : Json) : List (Pair String QrClippy) :=
    cg_load_rules root;

def scan_expected_profiles : List String :=
    cg_expected_profiles;

def scan_families (mp : List (Pair String QrClippy)) : List String :=
    cg_families mp;

def scan_validate_registry (value : Json) (mp : List (Pair String QrClippy))
    : List String :=
    cg_validate_registry value mp;

def scan_parse_reply (text : String)
    : Either QualityInputError (Pair String (List CgSProof)) :=
    cg_s_parse_reply text;

def scan_file (mp : List (Pair String QrClippy)) (profile : String)
    (root : String) (source_root : String) (path : String) (text : String)
    (proofs : Either QualityInputError (List CgSProof)) : List QrFinding :=
    cg_scan_file mp profile root source_root path text proofs;
