-- Closed collection laws. This is a proof vocabulary, not a second rule
-- registry or a replacement for numeric API contract roles.
import "../../std/string_prims.ouro";

inductive CmCollectionLaw : Type :=
  | CcLengthMap : CmCollectionLaw
  | CcLengthFilter : CmCollectionLaw
  | CcMapMap : CmCollectionLaw
  | CcLengthTake : CmCollectionLaw
  | CcMapFilter : CmCollectionLaw
  | CcFilterMap : CmCollectionLaw
  | CcTakeMap : CmCollectionLaw
  | CcDropMap : CmCollectionLaw
  | CcNarrowTake : CmCollectionLaw
  | CcDropTakeWindow : CmCollectionLaw
  | CcReverseAppend : CmCollectionLaw
  | CcLeftAppend : CmCollectionLaw
  | CcMapReverse : CmCollectionLaw
  | CcFilterReverse : CmCollectionLaw
  | CcReverseMap : CmCollectionLaw
  | CcReverseFilter : CmCollectionLaw
  | CcFilterFilter : CmCollectionLaw
  | CcTrimSide : CmCollectionLaw
  | CcSideTrim : CmCollectionLaw
  | CcCaseAbsorption : CmCollectionLaw;

def cc_laws : List CmCollectionLaw :=
    [CcLengthMap, CcLengthFilter, CcMapMap, CcLengthTake,
     CcMapFilter, CcFilterMap, CcTakeMap, CcDropMap,
     CcNarrowTake, CcDropTakeWindow, CcReverseAppend, CcLeftAppend,
     CcMapReverse, CcFilterReverse, CcReverseMap, CcReverseFilter,
     CcFilterFilter, CcTrimSide, CcSideTrim, CcCaseAbsorption];

def cc_rule (law : CmCollectionLaw) : String :=
    match law with
    | CcLengthMap => "OURO-CLIPPY-PERF-008"
    | CcLengthFilter => "OURO-CLIPPY-PERF-009"
    | CcMapMap => "OURO-CLIPPY-PERF-010"
    | CcLengthTake => "OURO-CLIPPY-PERF-011"
    | CcMapFilter => "OURO-CLIPPY-PERF-012"
    | CcFilterMap => "OURO-CLIPPY-PERF-013"
    | CcTakeMap => "OURO-CLIPPY-PERF-014"
    | CcDropMap => "OURO-CLIPPY-PERF-015"
    | CcNarrowTake => "OURO-CLIPPY-PERF-016"
    | CcDropTakeWindow => "OURO-CLIPPY-PERF-017"
    | CcReverseAppend => "OURO-CLIPPY-PERF-018"
    | CcLeftAppend => "OURO-CLIPPY-PERF-019"
    | CcMapReverse => "OURO-CLIPPY-PERF-020"
    | CcFilterReverse => "OURO-CLIPPY-PERF-021"
    | CcReverseMap => "OURO-CLIPPY-PERF-022"
    | CcReverseFilter => "OURO-CLIPPY-PERF-023"
    | CcFilterFilter => "OURO-CLIPPY-REDUNDANT-022"
    | CcTrimSide => "OURO-CLIPPY-REDUNDANT-023"
    | CcSideTrim => "OURO-CLIPPY-REDUNDANT-024"
    | CcCaseAbsorption => "OURO-CLIPPY-REDUNDANT-025"
    end;

def cc_message (law : CmCollectionLaw) : String :=
    match law with
    | CcLengthMap => "length consumes a temporary map with a proven total callback; measure the original list without building mapped cells"
    | CcLengthFilter => "length consumes a temporary filter with a proven total predicate; count matching elements directly with count_if"
    | CcMapMap => "two total maps build a temporary intermediate list; compose their callbacks in one map"
    | CcLengthTake => "length consumes a temporary positive take; use a count-bounded length scan, not a full-list length that could do more work"
    | CcMapFilter => "map consumes a temporary total filter; combine selection and mapping in one traversal without the filtered intermediate"
    | CcFilterMap => "filter consumes a temporary total map; fuse the traversal and evaluate the mapper exactly once for each element"
    | CcTakeMap => "positive take consumes a temporary total map; take the prefix before mapping to avoid mapping discarded elements"
    | CcDropMap => "positive drop consumes a temporary total map; drop the prefix before mapping to avoid mapping discarded elements"
    | CcNarrowTake => "the outer positive take has a strictly smaller proven bound; take that bound directly from the original list instead of copying a larger temporary prefix"
    | CcDropTakeWindow => "positive drop discards part of a larger temporary take; take the remaining count after dropping the original prefix"
    | CcReverseAppend => "reverse consumes a temporary append with a dynamic left input; rev_append of the right input onto the reversed left input avoids the appended intermediate"
    | CcLeftAppend => "a temporary append is copied again as the left operand of append; associate append to the right to copy the original left input once"
    | CcMapReverse => "a total map consumes a temporary reversal; a forward accumulator traversal can map and prepend without the reversed intermediate"
    | CcFilterReverse => "a total filter consumes a temporary reversal; a forward accumulator traversal can select and prepend without the reversed intermediate"
    | CcReverseMap => "reverse consumes a temporary total map; map and prepend in one accumulator traversal instead of allocating mapped cells twice"
    | CcReverseFilter => "reverse consumes a temporary total filter; select and prepend in one accumulator traversal instead of allocating filtered cells twice"
    | CcFilterFilter => "the same proven total predicate filters its own result with the same element type; retain the first filter instead of testing and copying its survivors again"
    | CcTrimSide => "full trim consumes a temporary left or right trim; full trim already removes both boundaries, so retain only the full trim"
    | CcSideTrim => "left or right trim consumes a fully trimmed result; the additional boundary normalization cannot change it"
    | CcCaseAbsorption => "the registered ASCII upper/lower normalization consumes the opposite case normalization; the outer normalization determines the final case, making the temporary inner normalization redundant"
    end;
