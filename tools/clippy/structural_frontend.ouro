-- One compiler-owned source preparation, lex, parse, and fact build per file.
-- There is no textual fallback and no Python semantic decision at this boundary.
-- Import/type inference outside the local structural slice is not claimed here.

import "structural_walk.ouro",
  "../../compiler/lexer.ouro",
  "../../compiler/lexer_intern.ouro",
  "../../compiler/token.ouro",
  "../../compiler/parser.ouro",
  "../../compiler/source_spans.ouro",
  "../../compiler/preprocess_import.ouro",
  "../../compiler/preprocess_record.ouro",
  "../../std/collections.ouro";

inductive CgSUnit : Type :=
  | MkCgSUnit : InternState -> Nat -> CgSState -> Maybe TokenSpans -> CgSUnit;

def cg_s_with_spans (spans : Maybe TokenSpans) (unit : CgSUnit) : CgSUnit :=
    let (MkCgSUnit intern count state _) := unit in
    MkCgSUnit intern count state spans;

-- Byte positions of the snapshot. Absent when preprocessing rewrote the text,
-- because token indexes then address the rewritten stream, not the file.
def cg_s_source_spans (source : String) : Maybe TokenSpans :=
    let codes : List Nat := prim_string_to_char_codes source in
    let (MkPair aliases imported) := preprocess_imports_reg empty_imp_reg codes in
    match imported with
  | ImpErr _ _ => Nothing TokenSpans
  | ImpOk prepared => let (MkPair _ tagged) :=
      preprocess_records_reg (Nil Nat)
        aliases empty_rec_reg prepared in
    let (MkPair _ result) := tagged in
    match result with
  | PrepErr _ _ => Nothing TokenSpans
  | PrepOk expanded => if list_eq Nat eq_nat expanded codes then
      let fuel : Nat := add(length Nat expanded, cg_s_lex_fuel_pad) in
      let lexed : LexSpanned := lex_spanned fuel expanded empty_intern in
      match lex_spanned_result lexed with
      | LexOk _ _ => Just(TokenSpans, lex_spanned_tokens lexed)
      | LexMalformed _ => Nothing TokenSpans
      | LexExhausted _ => Nothing TokenSpans
      end
    else Nothing TokenSpans
  end
    end;

def cg_s_parse_expanded (codes : List Nat) : Either QualityInputError CgSUnit :=
    let fuel : Nat := add(length Nat codes, cg_s_lex_fuel_pad) in
    match lex_all_import fuel codes with
    | LexMalformed _ => Left QualityInputError CgSUnit (QualityInvalidInput "compiler lexer rejected malformed source")
    | LexExhausted _ => Left QualityInputError CgSUnit (QualityInvalidInput "compiler lexer exhausted its traversal budget")
    | LexOk tokens intern =>
        let token_count : Nat := length Token tokens in
        match parse_file parse_spanned fuel tokens 0 with
        | PErr position => Left QualityInputError CgSUnit
            (QualityInvalidInput (prim_string_concat "compiler parser failed at preprocessed token "
              (prim_string_of_nat position)))
        | POk decls remaining _ =>
          let complete : Bool := is_eof (peek remaining) in
          if complete then
            match cg_s_build fuel decls with
            | Left error => Left QualityInputError CgSUnit
                (QualityInvalidInput (prim_string_concat "structural facts incomplete: "
                  (quality_input_message error)))
            | Right facts => Right QualityInputError CgSUnit
                (MkCgSUnit intern token_count facts (Nothing TokenSpans))
            end
          else
            Left QualityInputError CgSUnit (QualityInvalidInput "compiler parser left an incomplete source unit")
        end
    end;

-- The compiler parser does not accept `_` as a binder. Discard-let fixtures
-- and the lexical REDUNDANT-007 / CHECKED-006 rules still use `let _ :=`.
-- Rewrite only that binder so the companion can return proofs; real parse
-- failures stay FRONTEND-001. Lexical scanners keep the original source.
def cg_s_rewrite_discard_binders (source : String) : String :=
    prim_string_replace
      (prim_string_replace source "let _ :=" "let cg_s_discard :=")
      "let _:=" "let cg_s_discard :=";

def cg_s_frontend_source (source : String) : Either QualityInputError CgSUnit :=
    let (MkPair aliases imported) :=
      preprocess_imports_reg empty_imp_reg
        (prim_string_to_char_codes source) in
    match imported with
  | ImpErr code position => Left QualityInputError CgSUnit
      (QualityInvalidInput (prim_string_concat "compiler import preprocessing failed: code "
        (prim_string_concat (prim_string_of_nat code)
          (prim_string_concat("; detail ", prim_string_of_nat position)))))
  | ImpOk prepared => let (MkPair _ tagged) :=
      preprocess_records_reg (Nil Nat)
        aliases empty_rec_reg prepared in
    let (MkPair _ result) := tagged in
    match result with
  | PrepErr code position => Left QualityInputError CgSUnit
      (QualityInvalidInput (prim_string_concat "compiler record preprocessing failed: code "
        (prim_string_concat (prim_string_of_nat code)
          (prim_string_concat("; detail ", prim_string_of_nat position)))))
  | PrepOk expanded => match cg_s_parse_expanded expanded with
    | Left error => Left QualityInputError CgSUnit error
    | Right unit => Right QualityInputError CgSUnit
        (cg_s_with_spans(cg_s_source_spans source, unit))
    end
  end
    end;

def cg_s_frontend (source : String) : Either QualityInputError CgSUnit :=
    match cg_s_frontend_source source with
    | Right unit => Right QualityInputError CgSUnit unit
    | Left error =>
        let rewritten : String := cg_s_rewrite_discard_binders source in
        if prim_string_eq rewritten source then Left QualityInputError CgSUnit error
        else
          match cg_s_frontend_source rewritten with
          | Left retry_error => Left QualityInputError CgSUnit retry_error
          | Right unit => Right QualityInputError CgSUnit
              (cg_s_with_spans(Nothing TokenSpans, unit))
          end
    end;

-- Clippy semantic-unit parse. Lives here so semantic_unit.ouro does not
-- keep-import lexer/preprocess when it is the selected file.
-- Nothing lets the caller reuse both the token tail and the intern table.
def cm_discard_changes : List Token -> Bool -> LexerIntern -> Maybe (Pair (List Token) LexerIntern) :=
  fix go (tokens : List Token) (after_let : Bool) (intern : LexerIntern)
      : Maybe (Pair (List Token) LexerIntern) :=
    match tokens with
    | Nil => Nothing (Pair (List Token) LexerIntern)
    | Cons token rest =>
        let keep := fun (next : Bool) =>
          match go rest next intern with
          | Nothing => Nothing (Pair (List Token) LexerIntern)
          | Just changed => let (MkPair tail_tokens final) := changed in
            Just (Pair (List Token) LexerIntern)
              (MkPair (List Token) LexerIntern (Cons Token token tail_tokens) final)
          end in
        match token with
        | TKeyword k => keep (eq_nat k kwLet)
        | TExclam => keep after_let
        | THole hole => if after_let then
            match hole with
            | Just _ => keep False
            | Nothing => let (MkIntern _ fresh _ _) := lexer_intern_state intern in
              let (MkPair id updated) :=
                lexer_intern_ident intern
                  (prim_string_to_char_codes (prim_string_concat "$clippy-discard#"
                    (prim_string_of_nat fresh))) in
              let tail_result := (go rest False updated ??
                MkPair (List Token) LexerIntern rest updated) in
              let (MkPair tail_tokens final) := tail_result in
              Just (Pair (List Token) LexerIntern)
                (MkPair (List Token) LexerIntern (Cons Token (TIdent id) tail_tokens) final)
            end
          else keep False
        | TIdent _ => keep False
        | TNat _ => keep False
        | TType _ => keep False
        | TColon => keep False
        | TColonEq => keep False
        | TArrow => keep False
        | TFatArrow => keep False
        | TBar => keep False
        | TLparen => keep False
        | TRparen => keep False
        | TSemi => keep False
        | TString _ => keep False
        | TByteString _ => keep False
        | TComma => keep False
        | TBraceL => keep False
        | TBraceR => keep False
        | TEof => keep False
        | TBind => keep False
        | TPipe => keep False
        | TBracketL => keep False
        | TBracketR => keep False
        | TDotDot => keep False
        | TDotDotEq => keep False
        | TCoalesce => keep False
        end
    end;

def cm_discard_tokens (tokens : List Token) (after_let : Bool) (intern : LexerIntern)
    : Pair (List Token) LexerIntern :=
    cm_discard_changes tokens after_let intern ?? MkPair (List Token) LexerIntern tokens intern;

-- Preprocess scratch dies in its own heap context. Lex then starts from the
-- expanded bytes instead of retaining both graphs until the parse returns.
def cm_prepare_expanded (source : String) (_pad : Unit)
    : Either QualityInputError (Pair (List Nat) ImpReg) :=
    let (MkPair aliases imported) :=
      preprocess_imports_reg empty_imp_reg
      (prim_string_to_char_codes source) in
    match imported with
    | ImpErr _code position => Left QualityInputError (Pair (List Nat) ImpReg)
        (QualityInvalidInput (prim_string_concat("import preprocessing failed: ", prim_string_of_nat position)))
    | ImpOk prepared => let (MkPair _ tagged) :=
        preprocess_records_reg (Nil Nat)
          aliases empty_rec_reg prepared in
      let (MkPair recorded result) := tagged in
      match result with
      | PrepErr _code position => Left QualityInputError (Pair (List Nat) ImpReg)
          (QualityInvalidInput (prim_string_concat("record preprocessing failed: ", prim_string_of_nat position)))
      | PrepOk expanded => Right QualityInputError (Pair (List Nat) ImpReg)
          (MkPair (List Nat) ImpReg expanded recorded)
      end
    end;

def cm_lex_expanded (expanded : List Nat) (intern : LexerIntern)
    : Either QualityInputError (Pair (List Token) LexerIntern) :=
    let fuel : Nat := add(length Nat expanded, cg_s_lex_fuel_pad) in
    match lex_go_carried_with next_import_token_indexed fuel expanded intern (Nil Token) with
    | IndexedLexMalformed _ => Left QualityInputError (Pair (List Token) LexerIntern)
        (QualityInvalidInput "compiler lexer rejected source")
    | IndexedLexExhausted _ => Left QualityInputError (Pair (List Token) LexerIntern)
        (QualityInvalidInput "compiler lexer exhausted")
    | IndexedLexOk raw lexed => Right QualityInputError (Pair (List Token) LexerIntern)
        (cm_discard_tokens raw False lexed)
    end;

-- Span wrappers are only for the selected root. An import's signature harvest
-- does not read token ranges, and wrapping every subexpression retains the
-- position comparisons for the whole file.
def cm_parse_indexed (spanned : Bool) (source : String) (intern : LexerIntern)
    : Either QualityInputError (Pair ParsedFile (Pair LexerIntern ImpReg)) :=
    match cm_prepare_expanded source MkUnit with
    | Left error => Left QualityInputError (Pair(ParsedFile, Pair LexerIntern ImpReg)) error
    | Right prepared => let (MkPair expanded recorded) := prepared in
      let fuel : Nat := add(length Nat expanded, cg_s_lex_fuel_pad) in
      match cm_lex_expanded expanded intern with
      | Left error => Left QualityInputError (Pair(ParsedFile, Pair LexerIntern ImpReg)) error
      | Right lexed => let (MkPair tokens updated) := lexed in
        let parsed : ParseResult ParsedFile := if spanned then
            parse_file_visibility parse_spanned fuel tokens 0
          else parse_file_visibility parse fuel tokens 0 in
        match parsed with
      | PErr position => Left QualityInputError (Pair(ParsedFile, Pair LexerIntern ImpReg))
          (QualityInvalidInput (prim_string_concat("compiler parser failed at token ", prim_string_of_nat position)))
      | POk file remaining _ =>
          let complete : Bool := is_eof (peek remaining) in
          if complete then
            Right QualityInputError (Pair(ParsedFile, Pair LexerIntern ImpReg))
              (MkPair ParsedFile (Pair LexerIntern ImpReg) file
                (MkPair LexerIntern ImpReg updated recorded))
          else
            Left(QualityInputError, Pair(ParsedFile, Pair LexerIntern ImpReg), QualityInvalidInput "incomplete parsed source")
        end
        end
        end;

def cm_parse_with_aliases (source : String) (intern : InternState)
    : Either QualityInputError (Pair ParsedFile (Pair InternState ImpReg)) :=
    match cm_parse_indexed True source (lexer_intern_from intern) with
    | Left error => Left QualityInputError (Pair ParsedFile (Pair InternState ImpReg)) error
    | Right parsed => let (MkPair file metadata) := parsed in
      let (MkPair indexed aliases) := metadata in
      Right QualityInputError (Pair ParsedFile (Pair InternState ImpReg))
        (MkPair ParsedFile (Pair InternState ImpReg) file
          (MkPair InternState ImpReg (lexer_intern_state indexed) aliases))
    end;

def cm_parse (source : String) (intern : InternState)
    : Either QualityInputError (Pair (List Decl) InternState) :=
    match cm_parse_with_aliases source intern with
    | Left error => Left QualityInputError (Pair(List Decl, InternState)) error
    | Right parsed => let (MkPair file metadata) := parsed in
      let (MkParsedFile decls _) := file in
      let (MkPair lexed _) := metadata in
      Right QualityInputError (Pair(List Decl, InternState))
        (MkPair (List Decl) InternState decls lexed)
    end;
