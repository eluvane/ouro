-- Production decoder. Cursor offsets, never magic-string searches, delimit
-- snapshots. Only findings survive the root-local decode/report seam.
import "scan.ouro",
  "session_policy.ouro",
  "../quality/text.ouro";

inductive CgWireCursor : Type :=
  | CgWireAt : String -> Nat -> CgWireCursor;

inductive CgWireConfig : Type :=
  | MkCgWireConfig : List (Pair String QrClippy) -> String -> String -> String -> CgWireConfig;

inductive CgWireRootResult : Type :=
  | MkCgWireRootResult : CgWireCursor -> List QrFinding -> Bool -> CgWireRootResult;

inductive CgWireSnapshot : Type :=
  | CgWireReport : String -> List CgSProof -> CgWireCursor -> CgWireSnapshot
  | CgWireRejected : CgWireCursor -> CgWireSnapshot;

inductive CgWireResult : Type :=
  | MkCgWireResult : List QrFinding -> Nat -> Bool -> CgWireResult;

def cg_wire_error : QualityInputError :=
    QualityInvalidInput "incomplete or inconsistent semantic session protocol";

def cg_wire_left (cursor : CgWireCursor) : Nat :=
    match cursor with | CgWireAt text offset => sub(prim_string_length text, offset) end;

private def cg_wire_lf (cursor : CgWireCursor) : Either QualityInputError Nat :=
    let (CgWireAt text start) := cursor in
    (fix go (fuel : Nat) (offset : Nat) : Either QualityInputError Nat :=
      match fuel with
      | Z => Left QualityInputError Nat cg_wire_error
      | S remaining => if eq_nat(prim_string_byte_at text offset, 10) then
          Right QualityInputError Nat offset
        else go(remaining, S offset)
      end) (cg_wire_left cursor) start;

def cg_wire_line (cursor : CgWireCursor)
    : Either QualityInputError (Pair String CgWireCursor) :=
    let (CgWireAt text start) := cursor in
    match cg_wire_lf cursor with
    | Left error => Left QualityInputError (Pair String CgWireCursor) error
    | Right line_end => Right QualityInputError (Pair String CgWireCursor)
        (MkPair String CgWireCursor (prim_string_slice text start (sub line_end start))
          (CgWireAt(text, S line_end)))
    end;

def cg_wire_expect (expected : String) (cursor : CgWireCursor)
    : Either QualityInputError CgWireCursor :=
    match cg_wire_line cursor with
    | Left error => Left QualityInputError CgWireCursor error
    | Right row => let (MkPair value next) := row in
      if prim_string_eq value expected then Right QualityInputError CgWireCursor next
      else Left QualityInputError CgWireCursor cg_wire_error
    end;

def cg_wire_number (limit : Nat) (cursor : CgWireCursor)
    : Either QualityInputError (Pair Nat CgWireCursor) :=
    match cg_wire_line cursor with
    | Left error => Left QualityInputError (Pair Nat CgWireCursor) error
    | Right row => let (MkPair text next) := row in
      if
        leb_nat (prim_string_length text)
        (prim_string_length (prim_string_of_nat limit)) then
        match cg_s_nat text with
        | Nothing => Left QualityInputError (Pair Nat CgWireCursor) cg_wire_error
        | Just count => if leb_nat count limit then
            Right QualityInputError (Pair Nat CgWireCursor)
              (MkPair Nat CgWireCursor count next)
          else Left QualityInputError (Pair Nat CgWireCursor) cg_wire_error
        end
      else Left QualityInputError (Pair Nat CgWireCursor) cg_wire_error
    end;

def cg_wire_blob (cursor : CgWireCursor)
    : Either QualityInputError (Pair String CgWireCursor) :=
    match cg_wire_number(cg_wire_left cursor, cursor) with
    | Left error => Left QualityInputError (Pair String CgWireCursor) error
    | Right row => let (MkPair size next) := row in
      let (CgWireAt text offset) := next in
      let finish : Nat := add offset size in
      if
        andb (ltb_nat(finish, prim_string_length text))
          (eq_nat(prim_string_byte_at text finish, 10)) then
        Right QualityInputError (Pair String CgWireCursor)
          (MkPair String CgWireCursor (prim_string_slice text offset size)
            (CgWireAt(text, S finish)))
      else Left QualityInputError (Pair String CgWireCursor) cg_wire_error
    end;

def cg_wire_skip_lines : Nat -> CgWireCursor -> Either QualityInputError CgWireCursor :=
  fix go (count : Nat) (cursor : CgWireCursor) : Either QualityInputError CgWireCursor :=
    match count with
    | Z => Right QualityInputError CgWireCursor cursor
    | S remaining => match cg_wire_lf cursor with
      | Left error => Left QualityInputError CgWireCursor error
      | Right line_end => let (CgWireAt text _) := cursor in
        go remaining (CgWireAt(text, S line_end))
      end
    end;

-- Framing uses LF. Proof rows use the same decoding as standalone replies.
private def cg_wire_read_proofs (source_size : Nat) (count : Nat)
    (records : CgWireCursor) (next : CgWireCursor)
    : Either QualityInputError (List CgSProof) :=
    let (CgWireAt text start) := records in
    let (CgWireAt _ finish) := next in
    let rows : String := prim_string_slice text start (sub finish start) in
    cg_s_take_proofs source_size count (qt_split_lines rows) (Nil CgSProof);

def cg_wire_snapshot_end (cursor : CgWireCursor)
    : Either QualityInputError CgWireSnapshot :=
    let? (Left, Right) : Either QualityInputError CgWireSnapshot do
      let status : CgWireCursor := (cg_wire_expect cg_s_protocol cursor)?;
      let row : Pair String CgWireCursor := (cg_wire_line status)?;
      (let (MkPair value body) := row in
       if prim_string_eq value "error" then
         let? (Left, Right) : Either QualityInputError CgWireSnapshot do
           let failure : Pair String CgWireCursor := (cg_wire_line body)?;
           (let (MkPair message next) := failure in
            if ltb_nat(0, prim_string_length message) then
              Right QualityInputError CgWireSnapshot (CgWireRejected next)
            else Left QualityInputError CgWireSnapshot cg_wire_error)?
         end
       else if prim_string_eq value "ok" then
         let? (Left, Right) : Either QualityInputError CgWireSnapshot do
           let snapshot : Pair String CgWireCursor := (cg_wire_blob body)?;
           let source : String := fst String CgWireCursor snapshot;
           let after_source : CgWireCursor := snd String CgWireCursor snapshot;
           let counted : Pair Nat CgWireCursor := (cg_wire_number cg_s_proof_budget after_source)?;
           (let (MkPair count records) := counted in
            match count with
            | Z => Right QualityInputError CgWireSnapshot
                (CgWireReport source (Nil CgSProof) records)
            | S _ => let? (Left, Right) : Either QualityInputError CgWireSnapshot do
                let next : CgWireCursor := (cg_wire_skip_lines(mul count 6, records))?;
                let proofs : List CgSProof :=
                  (cg_wire_read_proofs (prim_string_length source) count records next)?;
                CgWireReport source proofs next
              end
            end)?
         end
       else Left QualityInputError CgWireSnapshot cg_wire_error)?
    end;

def cg_wire_findings (config : CgWireConfig) (path : String) (source : String)
    (proofs : Either QualityInputError (List CgSProof)) : List QrFinding :=
    let (MkCgWireConfig mp profile root source_root) := config in
    cg_scan_file mp profile root source_root (qr_child source_root path) source proofs;

-- Required pure two-argument arena seam: no source/proof array survives.
def cg_wire_scan_request (request : Pair String CgWireCursor) (config : CgWireConfig)
    : Either QualityInputError CgWireRootResult :=
    let (MkPair path cursor) := request in
    match cg_wire_snapshot_end cursor with
    | Left error => Left QualityInputError CgWireRootResult error
    | Right framed => match framed with
      | CgWireReport source proofs next => Right QualityInputError CgWireRootResult
          (MkCgWireRootResult next (cg_wire_findings config path source
            (Right QualityInputError (List CgSProof) proofs)) True)
      | CgWireRejected next => let (CgWireAt text start) := cursor in
        let (CgWireAt _ finish) := next in
        match cg_s_parse_reply
          (prim_string_slice text start (sub finish start)) with
        | Left error => Right QualityInputError CgWireRootResult
            (MkCgWireRootResult next (cg_wire_findings config path ""
              (Left QualityInputError (List CgSProof) error)) False)
        | Right _ => Left QualityInputError CgWireRootResult cg_wire_error
        end
      end
    end;

def cg_wire_trailer (cursor : CgWireCursor) (completed : Nat)
    (pending : List String) (passed : Bool) : Either QualityInputError Unit :=
    let status : String := if passed then
        match pending with | Nil => "ok" | Cons _ _ => "recycle" end
      else "error" in
    if ltb_nat 0 completed then
      match cg_wire_number completed cursor with
      | Left error => Left QualityInputError Unit error
      | Right row => let (MkPair reported next) := row in
        if eq_nat reported completed then
          match cg_wire_expect status next with
          | Left error => Left QualityInputError Unit error
          | Right final => if eq_nat(cg_wire_left final, 0) then Right QualityInputError Unit MkUnit
            else Left QualityInputError Unit cg_wire_error
          end
        else Left QualityInputError Unit cg_wire_error
      end
    else Left QualityInputError Unit cg_wire_error;

def cg_wire_roots (config : CgWireConfig)
    : List String -> Nat -> CgWireCursor -> List QrFinding -> Bool
    -> Either QualityInputError CgWireResult :=
  fix go (paths : List String) (completed : Nat) (cursor : CgWireCursor)
      (acc : List QrFinding) (passed : Bool) : Either QualityInputError CgWireResult :=
    match cg_wire_line cursor with
    | Left error => Left QualityInputError CgWireResult error
    | Right row => let (MkPair marker next) := row in
      if prim_string_eq marker "done" then
        match cg_wire_trailer next completed paths passed with
        | Left error => Left QualityInputError CgWireResult error
        | Right _ => Right QualityInputError CgWireResult
            (MkCgWireResult acc completed passed)
        end
      else
        if prim_string_eq marker "root" then
          match paths with
          | Nil => Left QualityInputError CgWireResult cg_wire_error
          | Cons path rest => match cg_wire_number completed next with
            | Left error => Left QualityInputError CgWireResult error
            | Right numbered => let (MkPair id named) := numbered in
              if eq_nat id completed then
                match cg_wire_blob named with
                | Left error => Left QualityInputError CgWireResult error
                | Right identified => let (MkPair actual body) := identified in
                  if prim_string_eq actual path then
                    match cg_wire_scan_request(MkPair String CgWireCursor path body, config) with
                    | Left error => Left QualityInputError CgWireResult error
                    | Right scanned => let (MkCgWireRootResult after found valid) := scanned in
                      go rest (S completed) after
                        (append QrFinding found acc) (andb passed valid)
                    end
                  else Left QualityInputError CgWireResult cg_wire_error
                end
              else Left QualityInputError CgWireResult cg_wire_error
            end
          end
        else Left QualityInputError CgWireResult cg_wire_error
    end;

def cg_wire_session (config : CgWireConfig) (paths : List String) (text : String)
    (acc : List QrFinding) : Either QualityInputError CgWireResult :=
    match paths with
    | Nil => Left QualityInputError CgWireResult cg_wire_error
    | Cons _ _ => let? (Left, Right) : Either QualityInputError CgWireResult do
        let cursor : CgWireCursor := (cg_wire_expect(cg_session_version, CgWireAt text 0))?;
        let path_count : Nat := length String paths;
        let row : Pair Nat CgWireCursor := (cg_wire_number path_count cursor)?;
        (let (MkPair count next) := row in
         if eq_nat count path_count then cg_wire_roots config paths 0 next acc True
         else Left QualityInputError CgWireResult cg_wire_error)?
      end
    end;
