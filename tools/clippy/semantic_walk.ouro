-- One bounded semantic traversal per declaration. Pure/type expressions are
-- kept separate from execution effects. Tokens preserve literals, globals,
-- constructors, argument order, annotations and alpha-renamable local IDs.
import "semantic_walk_helpers.ouro",
  "structural_model.ouro",
  "../../std/natx.ouro",
  "../../compiler/semantic_scope.ouro",
  "../../compiler/source_spans.ouro";

def cm_parameter (unit : ClippySemanticUnit) (ctx : CmContext) (name : Nat)
    (ann : Maybe Expr) (state : CmState) : Either QualityInputError (Pair CmContext CmState) :=
    match cm_type_annotation unit ctx ann with
    | Left error => Left QualityInputError (Pair CmContext CmState) error
    | Right result =>
        let callable : Bool := match ann with
          | Nothing => False | Just ty => ltb_nat(0, sc_pi_arity ty) end in
        let value : CmValue := CmValueOf (match callable with | True => 12 | False => 1 end)
          (cm_fresh state) (mod_nat result 10) (leb_nat 10 result) False False in
        Right(QualityInputError, Pair CmContext CmState, cm_bind name value ctx state)
    end;

def cm_visit (unit : ClippySemanticUnit) (apis : CmApiIndex)
    : Nat -> CmContext -> Bool -> Bool -> Expr -> CmState
    -> Either QualityInputError (Pair CmValue CmState) :=
  fix walk (fuel : Nat) (ctx : CmContext) (type_only : Bool) (terminal : Bool)
      (term : Expr) (state : CmState) : Either QualityInputError (Pair CmValue CmState) :=
    match fuel with
    | Z => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "semantic expression traversal exhausted")
    | S remaining => match notb (leb_nat(cm_fresh state, cm_node_inventory_limit)) with
      | True => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "semantic node inventory exhausted")
      | False =>
        let node : Nat := cm_fresh state in
        let s : CmState := cm_next state in
        let visit : CmContext -> Bool -> Expr -> CmState -> Either QualityInputError (Pair CmValue CmState) :=
          fun (scope : CmContext) => fun (tail : Bool) => fun (child : Expr) => fun (next : CmState) =>
            walk remaining scope type_only tail child next in
        let types : CmContext -> Expr -> CmState -> Either QualityInputError (Pair CmValue CmState) :=
          fun (scope : CmContext) => fun (child : Expr) => fun (next : CmState) =>
            walk remaining scope True False child next in
        match term with
        | EVar name => cm_variable unit apis ctx name s
        | EHole _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "unresolved expression hole in semantic input")
        | ESort level => cm_return(CmValueOf 13 level 0 False False True, cm_tag(level, cm_tag 103 s))
        | ENat literal => cm_return(CmValueOf 3 literal 0 False False True, cm_tag(literal, cm_tag 104 s))
        | EStr literal => cm_return(CmValueOf 4 literal 0 False False True, cm_tag(literal, cm_tag 105 s))
        | EApp _ _ => match sc_spine term [] with
          | MkPair head args => match visit ctx False head (cm_tag(length Expr args, cm_tag 106 s)) with
            | Left error => Left QualityInputError (Pair CmValue CmState) error
            | Right head_step => match head_step with
              | MkPair callee s2 => match cm_visit_args visit ctx args s2 [] with
                | Left error => Left QualityInputError (Pair CmValue CmState) error
                | Right arg_step => match arg_step with
                  | MkPair values s3 => match type_only with
                    | True => cm_return(cm_unknown node, s3)
                    | False => cm_apply_call unit apis ctx node callee values s3 end
                  end
                end
              end
            end
          end
        | ELam name ann body =>
            let annotated : Either QualityInputError (Pair CmValue CmState) := match ann with
              | Nothing => cm_return(cm_unknown node, cm_tag(0, cm_tag 107 s))
              | Just ty => types ctx ty (cm_tag(1, cm_tag 107 s)) end in
            match annotated with
            | Left error => Left QualityInputError (Pair CmValue CmState) error
            | Right step => match step with
              | MkPair _ s2 => match cm_parameter unit ctx name ann s2 with
                | Left error => Left QualityInputError (Pair CmValue CmState) error
                | Right scoped => match scoped with
                  | MkPair bound s3 => match visit(cm_context_region bound node, True, body, cm_barrier s3) with
                    | Left error => Left QualityInputError (Pair CmValue CmState) error
                    | Right body_step => match body_step with
                      | MkPair returned s4 => cm_return (CmValueOf 9 node 0 False False False)
                          (cm_barrier (cm_tag(207, cm_observe 4 node returned s4)))
                      end
                    end
                  end
                end
              end
            end
        | EPi name ty body => match types ctx ty (cm_tag 108 s) with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with
            | MkPair _ s2 => match cm_bind name (cm_unknown (cm_fresh s2)) ctx s2 with
              | MkPair bound s3 => types bound body s3 end
            end
          end
        | ELet name ann value body =>
            let annotated : Either QualityInputError (Pair CmValue CmState) := match ann with
              | Nothing => cm_return(cm_unknown node, cm_tag(0, cm_tag 109 s))
              | Just ty => types ctx ty (cm_tag(1, cm_tag 109 s)) end in
            match annotated with
            | Left error => Left QualityInputError (Pair CmValue CmState) error
            | Right a => match a with
              | MkPair _ s2 => match visit ctx False value s2 with
                | Left error => Left QualityInputError (Pair CmValue CmState) error
                | Right step => match step with
                  | MkPair produced s3 => match cm_bind name produced ctx s3 with
                    | MkPair bound s4 => visit bound terminal body (cm_event(CmFlowEvent (CmFlow node 2 (cm_value_id produced)), s4))
                    end
                  end
                end
              end
            end
        | EAscribe value ty => match types ctx ty (cm_tag 110 s) with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with | MkPair _ s2 => visit ctx terminal value s2 end end
        | EMatch scrut branches => match visit ctx False scrut (cm_tag 111 s) with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with
            | MkPair value s2 =>
                let checked : Bool := andb(notb type_only, cm_checked value) in
                let match_ctx : CmContext := match checked with
                  | True => cm_context_arm ctx node False | False => ctx end in
                let flowed : CmState := cm_observe 3 node value (cm_barrier s2) in
                visit (cm_context_subject match_ctx value) terminal branches
                  (match checked with
                   | True => cm_event(CmFlowEvent (CmFlow node 20 (cm_value_id value)), flowed)
                   | False => flowed end)
            end
          end
        | EFix name binders result body =>
            let identity : Nat := cm_fresh s in
            match cm_bind(name, cm_local_value identity 0, ctx, cm_tag 112 s) with
            | MkPair recursive s2 =>
                let self_ctx : CmContext := cm_context_self recursive identity in
                (fix telescope (budget : Nat) (bs : Expr) (scope : CmContext) (next : CmState)
                    : Either QualityInputError (Pair CmValue CmState) :=
                  match budget with
                  | Z => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "semantic telescope traversal exhausted")
                  | S less => match bs with
                    | EBinder param ty rest => match types scope ty (cm_tag 212 next) with
                      | Left error => Left QualityInputError (Pair CmValue CmState) error
                      | Right typed => match typed with
                        | MkPair _ t => match cm_parameter unit scope param (Just Expr ty) t with
                          | Left error => Left QualityInputError (Pair CmValue CmState) error
                          | Right scoped => match scoped with | MkPair bound t2 => telescope less rest bound t2 end
                          end
                        end
                      end
                    | ENoBinder => match types scope result (cm_tag 213 next) with
                      | Left error => Left QualityInputError (Pair CmValue CmState) error
                      | Right typed => match typed with
                        | MkPair _ t => match visit(cm_context_region scope node, True, body, cm_barrier t) with
                          | Left error => Left QualityInputError (Pair CmValue CmState) error
                          | Right checked => match checked with
                            | MkPair returned t2 => cm_return (CmValueOf 9 node 0 False False False)
                              (cm_barrier (cm_tag(214, cm_observe 4 node returned t2))) end
                          end
                        end
                      end
                    | EVar _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EHole _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | ESort _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | ENat _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EApp _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | ELam _ _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EPi _ _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | ELet _ _ _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EAscribe _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EMatch _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EFix _ _ _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EEffectRow _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EPerform _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EDo _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EHandle _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EBranch _ _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | ENoBranch => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EMultiMatch _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EStr _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EDoBind _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EList _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EListSpread _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | ESpan _ _ inner => telescope less inner scope next
                    | EFallible _ _ _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "invalid semantic telescope")
                    | EOpen _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "unresolved module open in semantic telescope")
                    end
                  end) remaining binders self_ctx s2
            end
        | EEffectRow value effects =>
            let tagged : CmState := foldl Nat CmState (fun (next : CmState) (effect_id : Nat) => cm_tag effect_id next)
              (cm_tag(length Nat effects, cm_tag 113 s)) effects in
            types ctx value tagged
        | EPerform operation args => match cm_variable unit apis ctx operation (cm_tag 114 s) with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right head => match head with
            | MkPair callee s2 => match cm_visit_args visit ctx args s2 [] with
              | Left error => Left QualityInputError (Pair CmValue CmState) error
              | Right step => match step with
                | MkPair values s3 => cm_apply_call unit apis ctx node callee values (cm_barrier s3) end
              end
            end
          end
        | EDo statements =>
            match cm_visit_do visit terminal statements ctx (cm_tag(length Expr statements, cm_tag 115 s)) with
            | Left error => Left QualityInputError (Pair CmValue CmState) error
            | Right step => match step with
              | MkPair value updated => match eq_nat(cm_epoch s, cm_epoch updated) with
                | True => cm_return value updated
                | False =>
                    -- A do block's sampled payload is not stable across replays.
                    cm_return (CmValueOf (match eq_nat(cm_value_kind value, 14) with
                        | True => 14 | False => 6 end)
                      node (cm_value_result value) True (cm_value_taint value) False)
                      (cm_observe 4 node value updated)
                end
              end
            end
        | EHandle value handlers => match visit ctx False value (cm_tag 116 s) with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with
            | MkPair _ s2 => cm_visit_handlers unit visit ctx handlers (cm_barrier s2) end
          end
        | EBranch pattern body rest => match pattern with
          | Nil => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "empty semantic pattern")
          | Cons ctor names =>
              let entered : CmState := cm_barrier (cm_tag 117 s) in
              let linked : CmState := match andb(notb type_only, cm_subject_checked ctx) with
                | True => cm_event(CmFlowEvent (CmFlow node 21 (cm_branch ctx)), entered)
                | False => entered end in
              match cm_pattern unit apis (cm_context_arm ctx node False) ctor names linked with
            | Left error => Left QualityInputError (Pair CmValue CmState) error
            | Right scoped => match scoped with
              | MkPair bound s2 => match visit bound terminal body s2 with
                | Left error => Left QualityInputError (Pair CmValue CmState) error
                | Right step => match step with
                  | MkPair value s3 => visit ctx terminal rest (cm_barrier (match andb(terminal, notb type_only) with
                      | True => cm_arm_outcome bound node value (cm_observe 4 node value s3) | False => s3 end))
                  end
                end
              end
            end
          end
        | ENoBranch => cm_return(cm_unknown node, cm_tag 118 s)
        | EBinder _ _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "telescope outside semantic fixpoint")
        | ENoBinder => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "telescope outside semantic fixpoint")
        | EMultiMatch scruts rows => match cm_visit_args visit ctx scruts (cm_tag(length Expr scruts, cm_tag 119 s)) [] with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with
            | MkPair values s2 =>
                let flowed : CmState := foldl CmValue CmState (fun (next : CmState) (value : CmValue) =>
                  cm_observe 3 node value next) s2 values in
                cm_visit_rows unit apis visit (cm_context_subject(ctx, cm_unknown node)) (andb(terminal, notb type_only)) rows flowed
            end
          end
        | EDoBind _ _ => Left(QualityInputError, Pair CmValue CmState, QualityInvalidInput "effect binder outside semantic do block")
        | EList elements => match cm_visit_args visit ctx elements (cm_tag(length Expr elements, cm_tag 120 s)) [] with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with
            | MkPair values s2 => cm_return (CmValueOf 5 node 0 False (any CmValue cm_value_taint values)
                (andb(leb_nat(length CmValue values, 8), all CmValue cm_value_constant values)))
                (foldl CmValue CmState (fun (next : CmState) (value : CmValue) => cm_observe 4 node value next) s2 values)
            end
          end
        | EListSpread elements tail => match cm_visit_args visit ctx (append Expr elements [tail]) (cm_tag(S (length Expr elements), cm_tag 120 s)) [] with
          | Left error => Left QualityInputError (Pair CmValue CmState) error
          | Right step => match step with
            | MkPair values s2 => cm_return (CmValueOf 5 node 0 False (any CmValue cm_value_taint values)
                (andb(leb_nat(length CmValue values, 8), all CmValue cm_value_constant values)))
                (foldl CmValue CmState (fun (next : CmState) (value : CmValue) => cm_observe 4 node value next) s2 values)
            end
          end
        | EFallible container _ _ body =>
            match types ctx container s with
            | Left error => Left QualityInputError (Pair CmValue CmState) error
            | Right typed => match typed with
              | MkPair _ after_type =>
                  match visit ctx terminal (fallible_analysis_body remaining body)
                      after_type with
                  | Left error => Left QualityInputError (Pair CmValue CmState) error
                  | Right walked => match walked with
                    | MkPair _ after_body => cm_return(cm_unknown node, after_body)
                    end
                  end
              end
            end
        -- A span wrapper is not a node: keep the unwrapped tree's ordinals.
        -- Nested wrappers share one visit so fuel stays the unwrapped tree's.
        | ESpan first past inner =>
            match span_peel remaining (Just(Pair Nat Nat, MkPair Nat Nat first past)) inner with
            | MkPair span core => match walk remaining ctx type_only terminal core
                (cm_with_span span state) with
              | Left error => Left QualityInputError (Pair CmValue CmState) error
              | Right stepped => match stepped with
                | MkPair value next => Right QualityInputError (Pair CmValue CmState)
                    (MkPair CmValue CmState value (cm_with_span(cm_span state, next)))
                end
              end
            end
        | EOpen _ inner => walk remaining ctx type_only terminal inner state
        end
      end
    end;
