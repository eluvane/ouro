def cm_contract_key (row : CmContract) : String :=
    prim_string_concat (cm_contract_module row)
      (prim_string_concat "#" (cm_contract_name row));

-- Configuration checks, not semantic name inference. Operation roles make
-- raw and checked mutually exclusive. Effects and recovery cannot contradict
-- a purity/must-observe promise. Empty owners are reserved for intrinsic ABI IDs.
def cm_contract_consistent (row : CmContract) : Bool :=
    let role : Nat := cm_contract_role row in
    andb (notb (andb (cm_contract_pure row) (elem Nat eq_nat role [1,2,3,4,5,6,7,8,23,24])))
      (andb (notb (andb (cm_contract_policy row) (elem Nat eq_nat role [8,23,24])))
        (match eq_nat (prim_string_length (cm_contract_module row)) 0 with
         | False => True
         | True => prim_string_starts (cm_contract_name row) "ouro." end));

def cm_validate_contracts (rows : List CmContract) : Either QualityInputError Unit :=
    (fix go (remaining : List CmContract) (keys : List String) : Either QualityInputError Unit :=
      match remaining with
      | Nil => Right QualityInputError Unit MkUnit
      | Cons row rest =>
          let module_path : String := cm_contract_module row in
          let key : String := cm_contract_key row in
          let canonical : String := prim_string_of_char_codes
            (canon_path (Nil Nat) (prim_string_to_char_codes module_path)) in
          match orb (elem String prim_string_eq key keys)
              (orb (eq_nat (prim_string_length (cm_contract_name row)) 0)
                (orb (notb (prim_string_eq canonical module_path))
                  (orb (ltb_nat 26 (cm_contract_role row))
                    (orb (ltb_nat 1 (cm_contract_cost row))
                      (notb (cm_contract_consistent row)))))) with
          | True => Left QualityInputError Unit (QualityInvalidInput (prim_string_concat "malformed semantic API registry: " key))
          | False => go rest (Cons String key keys)
          end
      end) rows [];

def cm_contract_for (unit : ClippySemanticUnit) (decl : ScDecl) : CmContract :=
    let module_path : String := cm_string (cm_intern unit) (sc_decl_module decl) in
    let name : String := cm_name (cm_intern unit) (sc_decl_name decl) in
    let intrinsic_key : String := match sc_decl_intrinsic decl with
      | Nothing => ""
      | Just id => cm_string (cm_intern unit) id
      end in
    (fix go (rows : List CmContract) : CmContract :=
      match rows with
      | Nil => CmContractOf module_path name 0 False 0 False
      | Cons row rest =>
          let same : Bool := match eq_nat (prim_string_length (cm_contract_module row)) 0 with
            | True => andb (notb (eq_nat (prim_string_length intrinsic_key) 0))
                (andb (prim_string_eq intrinsic_key (cm_contract_name row))
                  (elem String prim_string_eq module_path
                    ["std/runtime.ouro", "std/string_prims.ouro", "runtime/native_types.ouro"]))
            | False => andb (prim_string_eq module_path (cm_contract_module row))
                (prim_string_eq name (cm_contract_name row))
            end in
          match same with | True => row | False => go rest end
      end) cm_contracts;

def cm_registered_name (intern : InternState) (text : String) : Maybe Nat :=
    match intern with | MkIntern identifiers _ _ _ =>
      (fix go (names : List (Pair (List Nat) Nat)) : Maybe Nat :=
        match names with
        | Nil => Nothing Nat
        | Cons item rest => match item with | MkPair codes id =>
          match prim_string_eq text (prim_string_of_char_codes codes) with
          | True => Just Nat id | False => go rest end end
        end) identifiers
    end;

def cm_validate_contract_bindings (unit : ClippySemanticUnit) (rows : List CmContract) : Either QualityInputError Unit :=
    (fix go (remaining : List CmContract) : Either QualityInputError Unit :=
      match remaining with
      | Nil => Right QualityInputError Unit MkUnit
      | Cons row rest =>
          let owner : String := cm_contract_module row in
          -- Harvest stubs are `MkSrcUnit id Nil`. Keep-imported skip
          -- paths still carry import stubs (`Cons`). A Nil skip-path
          -- unit is not harvested, so its contracts are not identities
          -- for this selected file. Test units that are not skip paths
          -- stay loaded even with empty declaration lists.
          let loaded : Bool := any SrcUnit (fun (source_unit : SrcUnit) => match source_unit with
            | MkSrcUnit id decls =>
                andb (prim_string_eq owner (cm_string (cm_intern unit) id))
                  (orb (match decls with
                        | Nil => False
                        | Cons _ _ => True
                        end)
                    (notb (cm_skip_import_path owner)))
            end) (cm_units unit) in
          match orb (eq_nat (prim_string_length owner) 0) (notb loaded) with
          | True => go rest
          | False =>
              let valid : Bool := match cm_registered_name (cm_intern unit) (cm_contract_name row) with
                | Nothing => False
                | Just name => match sc_lookup_global name (cm_index unit) with
                  | Nothing => False
                  | Just decl => prim_string_eq owner (cm_string (cm_intern unit) (sc_decl_module decl)) end
                end in
              match valid with
              | True => go rest
              | False => Left QualityInputError Unit (QualityInvalidInput (prim_string_concat "stale or ambiguous semantic API registry identity: " (cm_contract_key row)))
              end
          end
      end) rows;

-- Explicit owner classifications, not basenames or directory-prefix exemptions.
-- Owners still receive ignored-result and error-loss diagnostics. Only the raw
-- primitive/overwrite boundary rules consult this table.
-- Class 1 owns filesystem policy, 2 process policy, 3 ABI compatibility.
inductive ClippyBoundaryFact : Type :=
  | CmBoundary : String -> Nat -> ClippyBoundaryFact;

def cm_boundaries : List ClippyBoundaryFact :=
    [ CmBoundary "std/fs.ouro" 1
    , CmBoundary "std/fsx.ouro" 1
    , CmBoundary "std/fs_create.ouro" 1
    , CmBoundary "std/fs_replace.ouro" 1
    , CmBoundary "tools/quality/source.ouro" 1
    , CmBoundary "std/process.ouro" 2
    , CmBoundary "std/processx.ouro" 2
    , CmBoundary "std/runtime.ouro" 3
    , CmBoundary "std/io.ouro" 3
    ];

def cm_boundary (unit : ClippySemanticUnit) (owner : ScDecl) (role : Nat) : Bool :=
    let module_path : String := cm_string (cm_intern unit) (sc_decl_module owner) in
    any ClippyBoundaryFact (fun (item : ClippyBoundaryFact) => match item with
      | CmBoundary path kind => andb (prim_string_eq path module_path)
          (orb (eq_nat kind 3)
            (orb (andb (eq_nat kind 1) (elem Nat eq_nat role [1,2,7,8]))
              (andb (eq_nat kind 2) (eq_nat role 3))))
      end) cm_boundaries;

-- Result classes: 0 unknown/ordinary, 1 Either, 2 Maybe; +10 for an IO action.
-- Follow only type-level aliases, with a closed budget. A local type parameter
-- is never resolved as a same-spelled global type.
def cm_type_class (unit : ClippySemanticUnit) : Nat -> List Nat -> Expr -> Either QualityInputError Nat :=
  fix go (fuel : Nat) (locals : List Nat) (term : Expr) : Either QualityInputError Nat :=
    match fuel with
    | Z => Left QualityInputError Nat (QualityInvalidInput "semantic type-alias traversal exhausted")
    | S remaining => match term with
      | EPi name _ result => go remaining (Cons Nat name locals) result
      | ELam name _ body => go remaining (Cons Nat name locals) body
      | EEffectRow result _ => go remaining locals result
      | EAscribe value _ => go remaining locals value
      | EVar name => match elem Nat eq_nat name locals with
        | True => Right QualityInputError Nat 0
        | False => match sc_lookup_global name (cm_index unit) with
          | Nothing => Left QualityInputError Nat (QualityInvalidInput (prim_string_concat "unresolved result type: "
              (cm_name (cm_intern unit) name)))
          | Just decl =>
              let role : Nat := cm_contract_role (cm_contract_for unit decl) in
              match eq_nat role 12 with
              | True => Right QualityInputError Nat 1
              | False => match eq_nat role 13 with
                | True => Right QualityInputError Nat 2
                | False => match sc_decl_body decl with
                  | Nothing => Right QualityInputError Nat 0
                  | Just body => match sc_type_result remaining (sc_decl_type decl) with
                    | Left error => Left QualityInputError Nat
                        (QualityInvalidInput (sc_error_message error))
                    | Right result => match result with
                      | ESort _ => go remaining locals body
                      | EVar _ => Right QualityInputError Nat 0
                      | EHole _ => Right QualityInputError Nat 0
                      | ENat _ => Right QualityInputError Nat 0
                      | EApp _ _ => Right QualityInputError Nat 0
                      | ELam _ _ _ => Right QualityInputError Nat 0
                      | EPi _ _ _ => Right QualityInputError Nat 0
                      | ELet _ _ _ _ => Right QualityInputError Nat 0
                      | EAscribe _ _ => Right QualityInputError Nat 0
                      | EMatch _ _ => Right QualityInputError Nat 0
                      | EFix _ _ _ _ => Right QualityInputError Nat 0
                      | EEffectRow _ _ => Right QualityInputError Nat 0
                      | EPerform _ _ => Right QualityInputError Nat 0
                      | EDo _ => Right QualityInputError Nat 0
                      | EHandle _ _ => Right QualityInputError Nat 0
                      | EBranch _ _ _ => Right QualityInputError Nat 0
                      | ENoBranch => Right QualityInputError Nat 0
                      | EBinder _ _ _ => Right QualityInputError Nat 0
                      | ENoBinder => Right QualityInputError Nat 0
                      | EMultiMatch _ _ => Right QualityInputError Nat 0
                      | EStr _ => Right QualityInputError Nat 0
                      | EDoBind _ _ => Right QualityInputError Nat 0
                      | EList _ => Right QualityInputError Nat 0
                      end
                    end
                  end
                end
              end
          end
        end
      | EApp _ _ => match sc_spine term [] with
        | MkPair head arguments => match head with
          | EVar name => match elem Nat eq_nat name locals with
            | True => Right QualityInputError Nat 0
            | False => match sc_lookup_global name (cm_index unit) with
              | Nothing => Left QualityInputError Nat (QualityInvalidInput (prim_string_concat "unresolved applied result type: "
                  (cm_name (cm_intern unit) name)))
              | Just decl =>
                  let role : Nat := cm_contract_role (cm_contract_for unit decl) in
                  match eq_nat role 14 with
                  | True => match arguments with
                    | Cons payload more => match more with
                      | Cons _ _ => Left QualityInputError Nat (QualityInvalidInput "malformed IO result type")
                      | Nil => match go remaining locals payload with
                        | Left error => Left QualityInputError Nat error
                        | Right value => Right QualityInputError Nat (add 10 value)
                        end
                      end
                    | Nil => Left QualityInputError Nat (QualityInvalidInput "missing IO result type")
                    end
                  | False => go remaining locals head
                  end
              end
            end
          | EHole _ => Right QualityInputError Nat 0
          | ESort _ => Right QualityInputError Nat 0
          | ENat _ => Right QualityInputError Nat 0
          | EApp _ _ => Right QualityInputError Nat 0
          | ELam _ _ _ => Right QualityInputError Nat 0
          | EPi _ _ _ => Right QualityInputError Nat 0
          | ELet _ _ _ _ => Right QualityInputError Nat 0
          | EAscribe _ _ => Right QualityInputError Nat 0
          | EMatch _ _ => Right QualityInputError Nat 0
          | EFix _ _ _ _ => Right QualityInputError Nat 0
          | EEffectRow _ _ => Right QualityInputError Nat 0
          | EPerform _ _ => Right QualityInputError Nat 0
          | EDo _ => Right QualityInputError Nat 0
          | EHandle _ _ => Right QualityInputError Nat 0
          | EBranch _ _ _ => Right QualityInputError Nat 0
          | ENoBranch => Right QualityInputError Nat 0
          | EBinder _ _ _ => Right QualityInputError Nat 0
          | ENoBinder => Right QualityInputError Nat 0
          | EMultiMatch _ _ => Right QualityInputError Nat 0
          | EStr _ => Right QualityInputError Nat 0
          | EDoBind _ _ => Right QualityInputError Nat 0
          | EList _ => Right QualityInputError Nat 0
          end
        end
      | EHole _ => Right QualityInputError Nat 0
      | ESort _ => Right QualityInputError Nat 0
      | ENat _ => Right QualityInputError Nat 0
      | ELet _ _ _ _ => Right QualityInputError Nat 0
      | EMatch _ _ => Right QualityInputError Nat 0
      | EFix _ _ _ _ => Right QualityInputError Nat 0
      | EPerform _ _ => Right QualityInputError Nat 0
      | EDo _ => Right QualityInputError Nat 0
      | EHandle _ _ => Right QualityInputError Nat 0
      | EBranch _ _ _ => Right QualityInputError Nat 0
      | ENoBranch => Right QualityInputError Nat 0
      | EBinder _ _ _ => Right QualityInputError Nat 0
      | ENoBinder => Right QualityInputError Nat 0
      | EMultiMatch _ _ => Right QualityInputError Nat 0
      | EStr _ => Right QualityInputError Nat 0
      | EDoBind _ _ => Right QualityInputError Nat 0
      | EList _ => Right QualityInputError Nat 0
      end
    end;

inductive CmApi : Type :=
  | CmApiOf : ScDecl -> CmContract -> Nat -> Nat -> CsFunctionContract -> CmApi;

def cm_api_decl (item : CmApi) : ScDecl :=
    match item with | CmApiOf value _ _ _ _ => value end;

def cm_api_contract (item : CmApi) : CmContract :=
    match item with | CmApiOf _ value _ _ _ => value end;

def cm_api_arity (item : CmApi) : Nat :=
    match item with | CmApiOf _ _ value _ _ => value end;

def cm_api_result (item : CmApi) : Nat :=
    match item with | CmApiOf _ _ _ value _ => value end;

def cm_api_summary (item : CmApi) : CsFunctionContract :=
    match item with | CmApiOf _ _ _ _ value => value end;

def cm_api_with_summary (item : CmApi) (summary : CsFunctionContract) : CmApi :=
    match item with | CmApiOf decl contract arity result _ =>
      CmApiOf decl contract arity result summary end;

-- Registered properties are independent: a checked operation can have an
-- unknown effect. Unknown effects never become pure through a wrapper.
def cm_seed_summary (decl : ScDecl) (contract : CmContract) : CsFunctionContract :=
    let role : Nat := cm_contract_role contract in
    let pure : Bool := cm_contract_pure contract in
    match orb pure (orb (notb (eq_nat role 0)) (cm_contract_policy contract)) with
    | False => cs_unknown decl CsPending
    | True =>
        let effects : CsEffect := match pure with
          | True => CsPure
          | False => match elem Nat eq_nat role [1,7,23] with
            | True => CsFilesystemRead
            | False => match elem Nat eq_nat role [2,8] with
              | True => CsFilesystemWrite
              | False => match elem Nat eq_nat role [3,4] with
                | True => CsProcess
                | False => match elem Nat eq_nat role [5,6] with
                  | True => CsReporting | False => CsUnknownEffect end
                end
              end
            end
          end in
        let result : CsResult := match elem Nat eq_nat role [8,23,24] with
          | True => CsRequiredResult
          | False => match eq_nat role 10 with
            | True => CsFailureResult
            | False => match eq_nat role 11 with
              | True => CsSuccessResult
              | False => match cm_contract_policy contract with
                | True => CsPolicyResult | False => CsUnknownResult end
              end
            end
          end in
        CsContract (sc_decl_module decl) (sc_decl_name decl) CsComplete effects result
          CsUnknownOrigin [] (Just Nat (cm_contract_cost contract))
          (match pure with | True => Just Bool False | False => Nothing Bool end)
          (match elem Nat eq_nat role [15,16,17,18,19,20,22] with | True => role | False => 0 end)
    end;

inductive CmApiIndex : Type :=
  | CmApiEmpty : CmApiIndex
  | CmApiNode : CmApi -> CmApiIndex -> CmApiIndex -> CmApiIndex;

-- Harvested compiler signatures may name types that the skip+keep cone
-- does not load. Classify those as ordinary (0) instead of failing the
-- selected file. Missing Either/IO proof on a skipped type is a skip
-- bug; checked APIs live in std/ and stay harvestable.
def cm_build_apis (unit : ClippySemanticUnit) : ScIndex -> Either QualityInputError CmApiIndex :=
  fix go (index : ScIndex) : Either QualityInputError CmApiIndex :=
    match index with
    | ScEmpty => Right QualityInputError CmApiIndex CmApiEmpty
    | ScNode decl left right =>
      let result : Nat := match cm_type_class unit cm_type_alias_fuel [] (sc_decl_type decl) with
        | Right class => class
        | Left _ => 0
        end in
      match go left with
      | Left error => Left QualityInputError CmApiIndex error
      | Right l => match go right with
        | Left error => Left QualityInputError CmApiIndex error
        | Right r => Right QualityInputError CmApiIndex (CmApiNode
            (CmApiOf decl (cm_contract_for unit decl)
              (sc_pi_arity (sc_decl_type decl)) result
              (cm_seed_summary decl (cm_contract_for unit decl))) l r)
        end
      end
    end;

def cm_api_lookup (name : Nat) : CmApiIndex -> Maybe CmApi :=
  fix go (index : CmApiIndex) : Maybe CmApi :=
    match index with
    | CmApiEmpty => Nothing CmApi
    | CmApiNode item left right => match compareNat name (sc_decl_name (cm_api_decl item)) with
      | EQ => Just CmApi item
      | LT => go left
      | GT => go right
      end
    end;

-- These roles promise an observable checked failure. Generic Either/Maybe,
-- probes and user functions do not inherit this obligation from their names.
def cm_contract_observe (contract : CmContract) : Bool :=
    elem Nat eq_nat (cm_contract_role contract) [8,23,24];
