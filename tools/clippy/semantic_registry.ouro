-- Explicit API contracts keyed by canonical declaration provenance or by the
-- compiler's intrinsic ABI identity. Names alone never establish a contract.
-- Unknown higher-order callees are effect barriers, not assumed pure.
import "semantic_contract_model.ouro";
import "semantic_unit.ouro";
import "../../std/natx.ouro";
import "../../compiler/path.ouro";
import "../../compiler/semantic_scope.ouro";
import "structural_model.ouro";

-- Roles: 0 ordinary; 1 raw read; 2 raw write; 3 raw process; 4 exit;
-- 5 stdout; 6 stderr; 7 exists; 8 checked overwrite;
-- 9 io_pure; 10 failure constructor; 11 success constructor;
-- 12 Either; 13 Maybe; 14 IO; 15 parse; 16 normalize; 17 convert;
-- 18 length; 19 traversal; 20 intermediate collection; 21 append;
-- 22 nonconstant recursive work; 23 checked read; 24 checked operation; 25 reflexive equality; 26 irreflexive order.
-- Cost/purity/default policy are independent.

inductive CmContract : Type :=
  | CmContractOf : String -> String -> Nat -> Bool -> Nat -> Bool -> CmContract;

def cm_contract_module (item : CmContract) : String :=
    match item with | CmContractOf value _ _ _ _ _ => value end;

def cm_contract_name (item : CmContract) : String :=
    match item with | CmContractOf _ value _ _ _ _ => value end;

def cm_contract_role (item : CmContract) : Nat :=
    match item with | CmContractOf _ _ value _ _ _ => value end;

def cm_contract_pure (item : CmContract) : Bool :=
    match item with | CmContractOf _ _ _ value _ _ => value end;

def cm_contract_cost (item : CmContract) : Nat :=
    match item with | CmContractOf _ _ _ _ value _ => value end;

def cm_contract_policy (item : CmContract) : Bool :=
    match item with | CmContractOf _ _ _ _ _ value => value end;

