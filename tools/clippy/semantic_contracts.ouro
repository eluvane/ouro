-- Bounded composition of pass-through summaries within the current snapshot.
-- One immutable balanced cache per semantic unit; never a process-global cache.
-- A source edit creates a fresh unit/cache. Unsupported bodies do not get a
-- weaker name/text-based contract. These facts do not prove wrapper removability.
import "semantic_registry.ouro",
  "semantic_origins.ouro",
  "../../compiler/semantic_scope.ouro";

def cs_parameter_facts (arity : Nat) (returned : Maybe Nat) : List CsArgument :=
    (fix go (remaining : Nat) (position : Nat) : List CsArgument :=
      match remaining with
      | Z => []
      | S less => Cons CsArgument (match returned with
          | Nothing => CsIgnoredArgument
          | Just arg => match eq_nat arg position with
            | True => CsReturnedArgument | False => CsIgnoredArgument end end)
          (go(less, add position 1))
      end) arity 0;

def cs_direct_contract (api : CmApi) (origin : CsOrigin) : CsFunctionContract :=
    let decl : ScDecl := cm_api_decl api in
    match origin with
    | CsArgumentOrigin arg => CsContract (sc_decl_module decl) (sc_decl_name decl)
        CsComplete CsPure (CsArgumentResult arg) origin
        (cs_parameter_facts(cm_api_arity api, Just Nat arg)) (Just Nat 0) (Just Bool False) 0
    | CsLiteralOrigin _ _ => CsContract (sc_decl_module decl) (sc_decl_name decl)
        CsComplete CsPure CsUnknownResult origin
        (cs_parameter_facts(cm_api_arity api, Nothing Nat)) (Just Nat 0) (Just Bool False) 0
    | CsUnknownOrigin => cs_unknown decl CsUnsupported
    | CsDelegateOrigin _ _ => cs_unknown decl CsUnsupported
    end;

-- Functional update copies only the search path, never all declarations/ASTs.
def cs_cache_put (name : Nat) (summary : CsFunctionContract) : CmApiIndex -> CmApiIndex :=
  fix go (index : CmApiIndex) : CmApiIndex :=
    match index with
    | CmApiEmpty => CmApiEmpty
    | CmApiNode api left right => match compareNat(name, sc_decl_name (cm_api_decl api)) with
      | EQ => CmApiNode (cm_api_with_summary api summary) left right
      | LT => CmApiNode api (go left) right
      | GT => CmApiNode api left (go right) end
    end;

-- cache, remaining expansion budget, computed, hits, edges, unavailable.
inductive CsAnalysis : Type :=
  | CsAnalysisOf : CmApiIndex -> Nat -> Nat -> Nat -> Nat -> Nat -> CsAnalysis;
def cs_cache (state : CsAnalysis) : CmApiIndex :=
    match state with | CsAnalysisOf value _ _ _ _ _ => value end;
def cs_computed (state : CsAnalysis) : Nat :=
    match state with | CsAnalysisOf _ _ value _ _ _ => value end;
def cs_hits (state : CsAnalysis) : Nat :=
    match state with | CsAnalysisOf _ _ _ value _ _ => value end;
def cs_expansions (state : CsAnalysis) : Nat :=
    match state with | CsAnalysisOf _ _ _ _ value _ => value end;
def cs_unavailable (state : CsAnalysis) : Nat :=
    match state with | CsAnalysisOf _ _ _ _ _ value => value end;
def cs_save (name : Nat) (contract : CsFunctionContract) (state : CsAnalysis) : CsAnalysis :=
    match state with | CsAnalysisOf cache budget computed hits edges unavailable =>
      CsAnalysisOf (cs_cache_put name contract cache) budget computed hits edges unavailable end;
def cs_hit (state : CsAnalysis) : CsAnalysis :=
    match state with | CsAnalysisOf cache budget computed hits edges unavailable =>
      CsAnalysisOf cache budget computed (add hits 1) edges unavailable end;
def cs_fail (api : CmApi) (status : CsStatus) (state : CsAnalysis) : CsAnalysis :=
    match cs_save(sc_decl_name (cm_api_decl api), cs_unknown(cm_api_decl api, status), state) with
    | CsAnalysisOf cache budget computed hits edges unavailable =>
        CsAnalysisOf cache budget computed hits edges (add unavailable 1) end;

def cs_compose (api : CmApi) (callee : CmApi) (origin : CsOrigin) : CsFunctionContract :=
    let decl : ScDecl := cm_api_decl api in
    let inner : CsFunctionContract := cm_api_summary callee in
    match cs_complete inner with
    | False => cs_unknown(decl, cs_status inner)
    | True => CsContract (sc_decl_module decl) (sc_decl_name decl) CsComplete
        (cs_effect inner) (cs_result inner) origin (cs_arguments inner)
        (cs_cost inner) (cs_mutation inner) (cs_work_role inner)
    end;

-- Depth is per chain; the expansion budget is shared by every demand. Completed
-- contracts are memoized, including unsupported bodies. A cycle/depth/budget
-- failure remains unknown and cannot be consumed as an optimization proof.
def cs_infer : Nat -> Nat -> CsAnalysis -> CsAnalysis :=
  fix go (depth : Nat) (name : Nat) (state : CsAnalysis) : CsAnalysis :=
    match cm_api_lookup(name, cs_cache state) with
    | Nothing => state
    | Just api => match cs_status (cm_api_summary api) with
      | CsComplete => cs_hit state | CsUnsupported => cs_hit state
      | CsCycle => cs_hit state | CsDepth => cs_hit state | CsBudget => cs_hit state
      | CsActive => cs_fail api CsCycle state
      | CsPending => match depth with
        | Z => cs_fail api CsDepth state
        | S less => match state with
          | CsAnalysisOf cache budget computed hits edges unavailable => match budget with
            | Z => cs_fail api CsBudget state
            | S remaining =>
                let next : CsAnalysis := cs_save name (cs_unknown(cm_api_decl api, CsActive))
                  (CsAnalysisOf cache remaining (add computed 1) hits edges unavailable) in
                match eq_nat(sc_decl_kind (cm_api_decl api), 0) with
                | False => cs_fail api CsUnsupported next
                | True =>
                    let origin : CsOrigin := match sc_decl_body (cm_api_decl api) with
                      | Nothing => cs_origin (cm_api_summary api)
                      | Just body => cs_local_origin cm_type_alias_fuel (cm_api_arity api) 0 [] body end in
                    match origin with
                    | CsUnknownOrigin => cs_fail api CsUnsupported next
                    | CsArgumentOrigin _ => cs_save name (cs_direct_contract api origin) next
                    | CsLiteralOrigin _ _ => cs_save name (cs_direct_contract api origin) next
                    | CsDelegateOrigin target arguments =>
                        match andb (eq_nat(length Nat arguments, cm_api_arity api))
                            (cs_ordered_arguments arguments 0) with
                        | False => cs_fail api CsUnsupported next
                        | True => match cm_api_lookup(target, cs_cache next) with
                          | Nothing => cs_fail api CsUnsupported next
                          | Just callee => match eq_nat(cm_api_arity callee, length Nat arguments) with
                            | False => cs_fail api CsUnsupported next
                            | True =>
                                let expanded : CsAnalysis := match next with
                                  | CsAnalysisOf table fuel count cached steps missing =>
                                      CsAnalysisOf table fuel count cached (add steps 1) missing end in
                                let resolved : CsAnalysis := go less target expanded in
                                match cm_api_lookup(target, cs_cache resolved) with
                                | Nothing => cs_fail api CsUnsupported resolved
                                | Just completed => cs_save name (cs_compose api completed origin) resolved
                                end
                            end
                          end
                        end
                    end
                end
            end
          end
        end
      end
    end;

-- Root declarations have priority. Captured imports then cover calls inside
-- non-delegating root bodies without spending the budget on every signature.
def cs_analyze (unit : ClippySemanticUnit) (apis : CmApiIndex) (budget : Nat) (depth : Nat) : CsAnalysis :=
    let roots : CsAnalysis := foldl ScDecl CsAnalysis (fun (state : CsAnalysis) (decl : ScDecl) =>
      match eq_nat(sc_decl_module decl, cm_entry unit) with
      | True => cs_infer depth (sc_decl_name decl) state | False => state end)
      (CsAnalysisOf apis budget 0 0 0 0) (cm_declarations unit) in
    foldl CsOriginFact CsAnalysis (fun (state : CsAnalysis) (fact : CsOriginFact) =>
      match fact with | CsOriginOf _ name _ => cs_infer depth name state end)
      roots (cm_origins unit);
