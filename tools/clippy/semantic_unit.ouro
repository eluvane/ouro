-- Clippy's single-read, single-parse compilation-unit loader. The compiler's
-- lexer, parser, canonical import paths and graph resolver own the input ABI.
-- No failed frontend stage can be replaced by a textual approximation.

import "structural_frontend.ouro",
  "../../compiler/lexer_intern.ouro",
  "intern_surface.ouro",
  "session_policy.ouro",
  "semantic_origins.ouro",
  "../../compiler/pipeline_abi.ouro",
  "../../compiler/parser_file.ouro",
  "../../compiler/parser_parse.ouro",
  "../../compiler/semantic_scope.ouro",
  "../../compiler/import_resolve.ouro",
  "../../compiler/import_paths.ouro",
  "../../compiler/module_registry.ouro",
  "../../compiler/source_text.ouro",
  "../../compiler/canonical_hash.ouro",
  "../../std/natx.ouro",
  "../quality/source.ouro",
  "../quality/input_error.ouro";
import "../../compiler/file_check_environment.ouro" as FileIndex;

def cm_pool_text (pool : List (Pair (List Nat) Nat)) (id : Nat) : String :=
    (fix go (xs : List (Pair (List Nat) Nat)) : String :=
      match xs with
      | Nil => ""
      | Cons p rest => let (MkPair bytes key) := p in
        if eq_nat id key then prim_string_of_char_codes bytes else go rest
      end) pool;

def cm_name (intern : InternState) (id : Nat) : String :=
    match intern with | MkIntern ids _ _ _ => cm_pool_text ids id end;

def cm_string (intern : InternState) (id : Nat) : String :=
    match intern with | MkIntern _ _ strings _ => cm_pool_text strings id end;

-- Import IDs become canonical identities in the same shared string pool.
def cm_canon_imports (path : String) : List Decl -> LexerIntern
    -> Pair (List Decl) LexerIntern :=
  let base : List Nat := prim_string_to_char_codes path in
  fun (decls : List Decl) (intern : LexerIntern) =>
    canonicalize_import_declarations LexerIntern base lexer_intern_string
      (fun (state : LexerIntern) (id : Nat) =>
        prim_string_to_char_codes (cm_string (lexer_intern_state state) id)) intern decls;

def cm_import_ids (decls : List Decl) : List Nat :=
    concat_map Decl Nat
      (fun (decl : Decl) => if let DImport id := (decl : Decl) then [id] else Nil Nat) decls;

inductive CmResolvedImports : Type :=
  | CmResolvedImportsOf : List ModuleAliasUnit -> List ModuleMember -> CmResolvedImports;

def cm_empty_resolved_imports : CmResolvedImports :=
    CmResolvedImportsOf (Nil ModuleAliasUnit) (Nil ModuleMember);

private def cm_qualified_members (entry : Nat) (aliases : List ModuleAliasUnit)
    (symbols : List ScDecl) (units : List SrcUnit) : List ModuleMember :=
    let targets : List Nat := map (Pair (List Nat) Nat) Nat
      (fun (binding : Pair (List Nat) Nat) =>
        let (MkPair _ target) := binding in target)
      (module_aliases_for entry aliases) in
    match targets with
    | Nil => Nil ModuleMember
    | Cons _ _ =>
        (fix collect (remaining : List ScDecl) : List ModuleMember :=
          match remaining with
          | Nil => Nil ModuleMember
          | Cons decl rest =>
              let owner : Nat := sc_decl_module decl in
              if memNat owner targets then
                let name : Nat := sc_decl_name decl in
                Cons ModuleMember
                  (MkModuleMember owner name name (notb (module_is_private owner name units)))
                  (collect rest)
              else collect rest
          end) symbols
    end;

inductive ClippySemanticUnit : Type :=
  | CmUnit : InternState -> Nat -> String -> List SrcUnit -> List ScDecl -> ScIndex -> List Decl -> Nat -> List CsOriginFact -> CmResolvedImports -> ClippySemanticUnit;

def cm_intern (item : ClippySemanticUnit) : InternState :=
    match item with | CmUnit value _ _ _ _ _ _ _ _ _ => value end;

def cm_entry (item : ClippySemanticUnit) : Nat :=
    match item with | CmUnit _ value _ _ _ _ _ _ _ _ => value end;

def cm_source (item : ClippySemanticUnit) : String :=
    match item with | CmUnit _ _ value _ _ _ _ _ _ _ => value end;

def cm_units (item : ClippySemanticUnit) : List SrcUnit :=
    match item with | CmUnit _ _ _ value _ _ _ _ _ _ => value end;

def cm_declarations (item : ClippySemanticUnit) : List ScDecl :=
    match item with | CmUnit _ _ _ _ value _ _ _ _ _ => value end;

def cm_index (item : ClippySemanticUnit) : ScIndex :=
    match item with | CmUnit _ _ _ _ _ value _ _ _ _ => value end;

def cm_root_decls (item : ClippySemanticUnit) : List Decl :=
    match item with | CmUnit _ _ _ _ _ _ value _ _ _ => value end;

def cm_origins (item : ClippySemanticUnit) : List CsOriginFact :=
    match item with | CmUnit _ _ _ _ _ _ _ _ value _ => value end;

def cm_resolved_imports (item : ClippySemanticUnit) : CmResolvedImports :=
    match item with | CmUnit _ _ _ _ _ _ _ _ _ value => value end;

-- Qualified references use the compiler's alias, selected-edge and direct
-- owner decision. An unresolved marker never falls back to a short name.
def cm_global_name (unit : ClippySemanticUnit) (name : Nat) : Maybe Nat :=
    let st : InternState := cm_intern unit in
    let atom : List Nat := name_of_id st name in
    match module_split_marker atom with
    | Nothing => Just Nat name
    | Just _ =>
        let (CmResolvedImportsOf aliases members) := cm_resolved_imports unit in
        match module_field_decision (cm_units unit) (Nil ModuleExports)
              aliases st (cm_entry unit) atom members False with
          | ModuleAbsent => Nothing Nat
          | ModuleAmbiguous => Nothing Nat
          | ModuleFound resolved => Just Nat resolved
        end
    end;

-- Executable visibility is relative to its source owner. Typed signatures keep
-- the full declaration index, including a public alias's private target type.
def cm_decl_visible (owner : Nat) (decl : ScDecl) (units : List SrcUnit) : Bool :=
    let target : Nat := sc_decl_module decl in
    if eq_nat owner target then True
    else notb (module_is_private target (sc_decl_name decl) units);

def cm_global_decl (unit : ClippySemanticUnit) (name : Nat) : Maybe ScDecl :=
    match cm_global_name unit name with
    | Nothing => Nothing ScDecl
    | Just resolved => sc_lookup_global(resolved, cm_index unit)
    end;

def cm_import_stubs (ids : List Nat) : List Decl :=
    map Nat Decl (fun (id : Nat) => DImport id) ids;

-- Imported signatures only need arity and the result spine. Parameter
-- domains are the bulk of a compiler cone and are not read after harvest.
def cm_compact_fuel : Nat := mul 64 64;

private def cm_compact_signature (keep_result : Bool) : Nat -> Expr -> Expr :=
  fix go (fuel : Nat) (term : Expr) : Expr :=
    match fuel with
    | Z => ESort 0
    | S left => match term with
      | EPi name _ rest => EPi name (ESort 0) (go left rest)
      | ELam name _ body => ELam name (Nothing Expr) (go left body)
      | ESpan _ _ inner => go left inner
      | EOpen _ inner => go left inner
      | EAscribe value _ => go left value
      | EEffectRow result _ =>
          let compact : Expr := go left result in
          if keep_result then EEffectRow compact (Nil Nat) else compact
      | EApp head arg => if keep_result then EApp (go left head) (go left arg) else ESort 0
      | EVar name => if keep_result then EVar name else ESort 0
      | EHole hole => if keep_result then EHole hole else ESort 0
      | ESort level => ESort level
      | ENat _ => ESort 0
      | ERange _ _ _ => ESort 0
      | ELet _ _ _ _ => ESort 0
      | EMatch _ _ => ESort 0
      | EFix _ _ _ _ => ESort 0
      | EPerform _ _ => ESort 0
      | EDo _ => ESort 0
      | EHandle _ _ => ESort 0
      | EBranch _ _ _ => ESort 0
      | ENoBranch => ESort 0
      | EBinder _ _ _ => ESort 0
      | ENoBinder => ESort 0
      | EMultiMatch _ _ => ESort 0
      | EStr _ => ESort 0
      | EDoBind _ _ => ESort 0
      | EList _ => ESort 0
      | EListSpread _ _ => ESort 0
      | EFallible _ _ _ _ => ESort 0
      | ENamedCall _ _ => ESort 0
      | EIf _ _ _ => ESort 0
      | EIfLet _ _ _ _ => ESort 0
      | ECoalesce _ _ => ESort 0
      end
    end;

def cm_compact_type : Nat -> Expr -> Expr :=
    cm_compact_signature True;

private def cm_is_sort_zero (term : Expr) : Bool :=
    if let ESort level := (term : Expr) then eq_nat level 0 else False;

private def cm_compact_pi_matches (term : Expr) (result_matches : Expr -> Bool) : Bool :=
    if let EPi name domain result := (term : Expr) then
      andb (eq_nat name 1)
        (andb (cm_is_sort_zero domain)
          (andb (result_matches result) (eq_nat (sc_pi_arity term) 1)))
    else False;

def cm_compact_contracts : Bool :=
    let sample : Expr := EPi 1 (EVar 9) (EVar 2) in
    cm_compact_pi_matches (cm_compact_type cm_compact_fuel sample)
      (fun (result : Expr) => if let EVar name := (result : Expr) then eq_nat name 2 else False);

def cm_strip_symbol (item : ScDecl) : ScDecl :=
    let (ScDeclOf name owner kind parent signature _ prim) := item in
    ScDeclOf name owner kind parent (cm_compact_type cm_compact_fuel signature) (Nothing Expr) prim;

-- Non-std imports keep the Pi spine and a validated nullary constructor's parent.
-- Other result spines push one lint root over the 8 GiB cap. Checked
-- Either/IO APIs live in std/ and keep cm_compact_type.
def cm_keep_result_spine (path : String) : Bool :=
    prim_string_starts path "std/";

def cm_arity_path_contracts : Bool :=
    andb (cm_keep_result_spine "std/io.ouro")
      (notb (cm_keep_result_spine "compiler/lexer.ouro"));

def cm_compact_arity : Nat -> Expr -> Expr :=
    cm_compact_signature False;

def cm_strip_arity (item : ScDecl) : ScDecl :=
    let (ScDeclOf name owner kind parent signature _ prim) := item in
    ScDeclOf name owner kind parent
      (if cg_s_nullary_constructor_parent item then EVar parent
        else cm_compact_arity cm_compact_fuel signature) (Nothing Expr) prim;

def cm_compiler_arity_contracts : Bool :=
    let sample : Expr := EPi 1 (EVar 9) (EApp (EVar 4) (EVar 5)) in
    cm_compact_pi_matches (cm_compact_arity cm_compact_fuel sample) cm_is_sort_zero;

def cm_import_symbols (decls : List ScDecl) : List ScDecl :=
    map ScDecl ScDecl cm_strip_symbol decls;

def cm_import_arity (decls : List ScDecl) : List ScDecl :=
    map ScDecl ScDecl cm_strip_arity decls;

def cm_parsed_decls (file : ParsedFile) : List Decl :=
    match file with | MkParsedFile decls _ => decls end;

def cm_parsed_private (file : ParsedFile) : List Nat :=
    match file with | MkParsedFile _ names => names end;

inductive CmHarvest : Type :=
  | MkHarvest : InternState -> List ScDecl -> List Nat -> ParsedFile -> List CsOriginFact -> CmHarvest;

-- Finish one parsed file. Imports keep signatures and compact origins; the
-- selected file keeps bodies. This helper is unwrapped. The host arena seam wraps
-- cm_load_file below so leave() drops imported function graphs.
def cm_after_parse_indexed (path : String) (module_id : Nat) (keep_bodies : Bool)
    (file : ParsedFile) (intern : LexerIntern) : Pair CmHarvest LexerIntern :=
    let (MkPair canonical updated) := cm_canon_imports path (cm_parsed_decls file) intern in
    let flat : InternState := lexer_intern_state updated in
    let imports : List Nat := cm_import_ids canonical in
    let raw : List ScDecl := sc_declarations module_id canonical in
    let harvest : CmHarvest := if keep_bodies then
        MkHarvest flat raw imports (MkParsedFile canonical (cm_parsed_private file)) []
      else
        MkHarvest flat
          (if cm_keep_result_spine path then cm_import_symbols raw else cm_import_arity raw) imports
          (MkParsedFile (cm_import_stubs imports) (cm_parsed_private file))
          (cs_capture_origins raw) in
    MkPair CmHarvest LexerIntern harvest updated;

def cm_after_parse (path : String) (module_id : Nat) (keep_bodies : Bool)
    (file : ParsedFile) (intern : InternState) : CmHarvest :=
    let (MkPair harvest _) :=
      cm_after_parse_indexed path module_id keep_bodies file (lexer_intern_from intern) in
    harvest;

-- Dependency identity includes the frontend mode, canonical path, length and
-- exact-byte hash. Immutable dependency bytes verify equality even on a hash
-- collision; root snapshots never enter this bounded cache. Hits reuse harvest facts only; the
-- selected file is still parsed and rules still run. Intern ids stay valid
-- only inside one worker process that grows one intern table.
inductive CmCachedFile : Type :=
  | MkCmCachedFile : String -> Nat -> List Nat -> String -> CmHarvest -> CmCachedFile;

inductive CmParseCache : Type :=
  | MkCmParseCache : List CmCachedFile -> CmParseCache;

inductive CmCacheLookup : Type :=
  | CmCacheHit : CmHarvest -> CmCacheLookup
  | CmCacheMiss : CmCacheLookup
  | CmCacheStale : CmCacheLookup;

def cm_cache0 : CmParseCache :=
    MkCmParseCache (Nil CmCachedFile);

def cm_cache_reset (cache : CmParseCache) : CmParseCache :=
    let (MkCmParseCache _) := cache in
    cm_cache0;

def cm_content_hash (src : String) : List Nat :=
    canonical_hash_bytes (canonical_hash_codes (prim_string_to_char_codes src));

def cm_hash_eq (left : List Nat) (right : List Nat) : Bool :=
    eq_nat_list left right;

def cm_cache_row_ok (row : CmCachedFile) : Bool :=
    let (MkCmCachedFile canonical _ hash _ _) := row in
    andb (ltb_nat(0, prim_string_length canonical))
      (eq_nat(length Nat hash, 8));

def cm_cache_identity (canonical : String) : String :=
    prim_string_concat "ouro.clippy.harvest.v3/compiler-parser/signatures-origins:" canonical;

def cm_cache_get (cache : CmParseCache) (canonical : String) : Maybe CmCachedFile :=
    let identity : String := cm_cache_identity canonical in
    (fix go (rows : List CmCachedFile) : Maybe CmCachedFile :=
      match rows with
      | Nil => Nothing CmCachedFile
      | Cons row rest => let (MkCmCachedFile key _ _ _ _) := row in
        if prim_string_eq(key, identity) then Just CmCachedFile row else go rest
      end) (match cache with | MkCmParseCache rows => rows end);

def cm_cache_lookup (cache : CmParseCache) (canonical : String) (src : String)
    : CmCacheLookup :=
    match cm_cache_get cache canonical with
    | Nothing => CmCacheMiss
    | Just row => if cm_cache_row_ok row then
        let (MkCmCachedFile _ stored_len stored_hash stored_source harvest) := row in
        if andb (eq_nat(stored_len, prim_string_length src)) (prim_string_eq stored_source src) then
          if cm_hash_eq(stored_hash, cm_content_hash src) then CmCacheHit harvest
          else CmCacheStale
        else CmCacheStale
      else CmCacheStale
    end;

-- Cached facts never retain historical intern spines or imported bodies.
-- Symbols are already signature-only; share that list with the unit instead of
-- cloning it into the cache. The current session's intern table is attached
-- again on a cache hit.
def cm_cache_harvest (harvest : CmHarvest) : CmHarvest :=
    let (MkHarvest _ symbols imports file origins) := harvest in
    MkHarvest empty_intern
      symbols imports
      (MkParsedFile (cm_import_stubs imports) (cm_parsed_private file)) origins;

def cm_cache_bytes (cache : CmParseCache) : Nat :=
    (fix go (rows : List CmCachedFile) : Nat :=
      match rows with
      | Nil => 0
      | Cons row rest => let (MkCmCachedFile _ size _ _ _) := row in
        add(size, go rest)
      end) (match cache with | MkCmParseCache rows => rows end);

def cm_cache_without (canonical : String) (rows : List CmCachedFile)
    : List CmCachedFile :=
    let identity : String := cm_cache_identity canonical in
    filter CmCachedFile (fun (row : CmCachedFile) => let (MkCmCachedFile key _ _ _ _) := row in
      notb (prim_string_eq(key, identity))) rows;

def cm_cache_trim : Nat -> Nat -> List CmCachedFile -> List CmCachedFile :=
  fix go (slots : Nat) (bytes : Nat) (rows : List CmCachedFile)
      : List CmCachedFile :=
    match slots with
    | Z => Nil CmCachedFile
    | S remaining => match rows with
      | Nil => Nil CmCachedFile
      | Cons row rest => let (MkCmCachedFile _ size _ _ _) := row in
        if leb_nat size bytes then Cons CmCachedFile row (go remaining (sub bytes size) rest)
        else go remaining bytes rest
      end
    end;

def cm_cache_put (cache : CmParseCache) (canonical : String) (src : String)
    (harvest : CmHarvest) : CmParseCache :=
    let (MkCmParseCache rows) := cache in
    let current : List CmCachedFile := cm_cache_without canonical rows in
    let size : Nat := prim_string_length src in
    if leb_nat size cg_session_cache_bytes then
      MkCmParseCache (cm_cache_trim cg_session_cache_rows
        cg_session_cache_bytes (Cons CmCachedFile
          (MkCmCachedFile (cm_cache_identity canonical) size (cm_content_hash src) src
            (cm_cache_harvest harvest)) current))
    else MkCmParseCache current;

def cm_cache_contracts : Bool :=
    let src : String := "def n : Nat := Z;" in
    let other : String := "def n : Nat := S Z;" in
    let canonical : String := "std/cache_contract.ouro" in
    let harvest : CmHarvest :=
      MkHarvest(empty_intern, Nil ScDecl, Nil Nat,
        MkParsedFile (Nil Decl) (Nil Nat), Nil CsOriginFact) in
    let cache : CmParseCache :=
      cm_cache_put cm_cache0 canonical src harvest in
    let hit : Bool := if let CmCacheHit _ := (cm_cache_lookup cache canonical src : CmCacheLookup) then
        True
      else False in
    let miss : Bool := if let CmCacheMiss := (cm_cache_lookup cm_cache0 canonical src : CmCacheLookup) then
        True
      else False in
    let stale : Bool := if let CmCacheStale := (cm_cache_lookup cache canonical other : CmCacheLookup) then
        True
      else False in
    let reset : Bool := if let CmCacheMiss :=
        (cm_cache_lookup (cm_cache_reset cache) canonical src : CmCacheLookup) then
        True
      else False in
    andb(hit, andb(miss, andb stale reset));

-- Native-tool build metadata scopes this two-argument import harvest.
-- Type-alias following on imports stays unknown.
def cm_load_file (req : Pair String String) (intern : LexerIntern)
    : Either QualityInputError (Pair CmHarvest LexerIntern) :=
    let (MkPair path source) := req in
    match cm_parse_indexed False source intern with
    | Left error => Left QualityInputError (Pair CmHarvest LexerIntern) error
    | Right parsed => let (MkPair file metadata) := parsed in
      let (MkPair lexed _) := metadata in
      let (MkPair module_id updated) :=
        lexer_intern_string lexed
          (prim_string_to_char_codes path) in
      Right QualityInputError (Pair CmHarvest LexerIntern)
        (cm_after_parse_indexed path module_id False file updated)
    end;

def cm_load_file_cached (req : Pair String String) (intern : LexerIntern)
    (cache : CmParseCache) : Either QualityInputError (Pair CmHarvest (Pair LexerIntern CmParseCache)) :=
    let (MkPair path source) := req in
    if let CmCacheHit harvest := (cm_cache_lookup cache path source : CmCacheLookup) then
      let (MkHarvest _ symbols imports decls origins) := harvest in
      Right QualityInputError (Pair CmHarvest (Pair LexerIntern CmParseCache))
        (MkPair CmHarvest (Pair LexerIntern CmParseCache)
          (MkHarvest (lexer_intern_state intern) symbols imports decls origins)
          (MkPair LexerIntern CmParseCache intern cache))
    else
      match cm_load_file req intern with
      | Left error => Left QualityInputError (Pair CmHarvest (Pair LexerIntern CmParseCache)) error
      | Right loaded => let (MkPair harvest updated) := loaded in
          Right QualityInputError (Pair CmHarvest (Pair LexerIntern CmParseCache))
            (MkPair CmHarvest (Pair LexerIntern CmParseCache) harvest
              (MkPair LexerIntern CmParseCache updated (cm_cache_put cache path source harvest)))
      end;

def cm_load_file_flat (req : Pair String String) (intern : InternState)
    : Either QualityInputError CmHarvest :=
    match cm_load_file req (lexer_intern_from intern) with
    | Left error => Left QualityInputError CmHarvest error
    | Right loaded => let (MkPair harvest _) := loaded in
      Right QualityInputError CmHarvest harvest
    end;

def cm_load_file_cached_flat (req : Pair String String) (intern : InternState)
    (cache : CmParseCache) : Either QualityInputError (Pair CmHarvest CmParseCache) :=
    match cm_load_file_cached req (lexer_intern_from intern) cache with
    | Left error => Left QualityInputError (Pair CmHarvest CmParseCache) error
    | Right loaded => let (MkPair harvest state) := loaded in
      let (MkPair _ next_cache) := state in
      Right QualityInputError (Pair CmHarvest CmParseCache)
        (MkPair CmHarvest CmParseCache harvest next_cache)
    end;

-- The selected root and compiler imports keep signatures, including multi-hop
-- compiler modules. Runtime platform sources and the listed implementation
-- cones stay stubbed unless this root asked for them directly: harvesting
-- that cone in one process exceeds the 8 GiB lint address-space cap. A missing
-- file is still an input error.
def cm_path_in (path : String) (rows : List String) : Bool :=
    (fix go (rest : List String) : Bool :=
      match rest with
      | Nil => False
      | Cons row more =>
          if prim_string_eq path row then True else go more
      end) rows;

def cm_keep_import_paths : List String :=
    [ "compiler/kernel_core.ouro"
    , "compiler/base.ouro"
    , "compiler/pipeline_abi.ouro"
    , "compiler/core.ouro"
    , "compiler/checked_program.ouro"
    , "compiler/native/image_types.ouro"
    , "compiler/source_text.ouro"
    , "compiler/ast.ouro"
    , "compiler/parser_file.ouro"
    , "compiler/parser_parse.ouro"
    ];

def cm_keep_import_path (path : String) : Bool :=
    cm_path_in path cm_keep_import_paths;

def cm_skip_analyze_paths : List String :=
    [ "tools/analyze/effects.ouro"
       , "tools/analyze/capability.ouro"
       , "tools/analyze/extract_leak.ouro"
       , "tools/analyze/match_cover.ouro"
       , "tools/analyze/cfg.ouro"
       , "tools/analyze/dataflow.ouro"
       , "tools/analyze/semantic.ouro"
       , "tools/analyze/property.ouro"
       , "tools/analyze/absint.ouro"
       , "tools/analyze/symexec.ouro"
       , "tools/analyze/taint.ouro"
       , "tools/analyze/contracts.ouro"
       , "tools/analyze/complexity.ouro"
       , "tools/analyze/bounds.ouro"
       , "tools/analyze/minimal.ouro"
       , "tools/analyze/duplication.ouro"
       , "tools/analyze/trust.ouro"
       , "tools/analyze/simplify.ouro"
       , "tools/analyze/perf.ouro"
       , "tools/analyze/naming.ouro"
       , "tools/analyze/errors.ouro"
       ];

def cm_skip_analyze_family (path : String) : Bool :=
    cm_path_in path cm_skip_analyze_paths;

def cm_skip_impl_paths : List String :=
    [ "tools/analyze/model.ouro"
       , "std/json.ouro"
       , "std/jsonx.ouro"
       , "std/format.ouro"
       , "tools/native_build_output.ouro"
       , "tools/repo_gate/workflow_checks.ouro"
       , "tools/repo_gate/policy.ouro"
       , "tools/analyze/architecture.ouro"
       , "tools/analyze/deadcode.ouro"
       , "tools/analyze/suppressions.ouro"
       , "tools/analyze/api_surface.ouro"
       , "tools/analyze/format.ouro"
       , "tools/fix/basic_rules.ouro"
       , "tools/fix/rules.ouro"
       , "tools/clippy/structural_frontend.ouro"
       , "tools/repo_gate/checks.ouro"
       , "tools/repo_gate/parity_closure.ouro"
       , "tools/ci_gate/host_bound.ouro"
       , "tools/analyze/drive_light.ouro"
       , "tools/analyze/drive_heavy.ouro"
       , "tools/analyze/drive_smells.ouro"
       , "tools/analyze/unit.ouro"
       , "tools/analyze/drive.ouro"
       , "tools/clippy/scan.ouro"
       ];

def cm_skip_impl_path (path : String) : Bool :=
    cm_path_in path cm_skip_impl_paths;

def cm_skip_exact_paths : List String :=
    [ "std/process.ouro"
    , "std/collections.ouro"
    , "std/pathx.ouro"
    ];

def cm_skip_import_path (path : String) : Bool :=
    if cm_keep_import_path path then False
    else
      orb (prim_string_starts path "runtime/platform/")
        (orb (cm_path_in path cm_skip_exact_paths)
          (orb (cm_skip_analyze_family path)
            (cm_skip_impl_path path)));

def cm_skip_import_for (entry : String) (path : String) : Bool :=
    if
      andb (prim_string_starts entry "runtime/")
        (prim_string_starts path "runtime/platform/") then
      False
    else cm_skip_import_path path;

def cm_import_bound_contracts : Bool :=
    andb (cm_skip_import_path "runtime/platform/windows_fs.ouro")
      (andb (notb (cm_skip_import_path "compiler/lower_nat.ouro"))
        (andb (notb (cm_skip_import_path "compiler/transitive_types.ouro"))
          (andb (notb (cm_skip_import_path "compiler/lexer.ouro"))
            (notb (cm_skip_import_for "runtime/managed.ouro"
              "runtime/platform/windows_x64.ouro")))));

-- Canonical path IDs stay stable as this load extends the intern table.
-- The count includes skipped stubs, which do not spend the read budget.
private def CmLoadedFiles : Type := Pair FileIndex.EntryIndex Nat;

private def cm_no_loaded_files : CmLoadedFiles :=
    MkPair FileIndex.EntryIndex Nat FileIndex.EntryIndexEmpty Z;

private def cm_mark_loaded_file (id : Nat) (files : CmLoadedFiles) : CmLoadedFiles :=
    let (MkPair index count) := files in
    MkPair FileIndex.EntryIndex Nat (FileIndex.entry_index_insert id FileIndex.EntryIndexReserved index) (add count 1);

-- Paths are repository-relative compiler canonical paths. The caller anchors
-- disk reads to an already resolved repository root. Source text is retained
-- only for the selected file, to give the reporting process that SAME snapshot.
private def cm_load_pending_indexed (root : String) (entry : Nat) (canonical_entry : Maybe String)
    : Nat -> Nat -> List Nat -> CmLoadedFiles
    -> LexerIntern -> List SrcUnit -> List ScDecl -> String -> List Decl
    -> CmParseCache -> List Nat -> List CsOriginFact -> ImpReg
    -> IO (Either QualityInputError
        (Pair ClippySemanticUnit (Pair InternState CmParseCache))) :=
  let entry_path (intern : InternState) : String :=
    match canonical_entry with
    | Just path => path
    | Nothing => cm_string intern entry
    end in
  fix go (fuel : Nat) (file_budget : Nat) (pending : List Nat) (loaded : CmLoadedFiles)
    (indexed : LexerIntern) (units : List SrcUnit) (symbols : List ScDecl)
      (source : String) (root_decls : List Decl) (cache : CmParseCache)
      (keep : List Nat) (origins : List CsOriginFact) (root_aliases : ImpReg)
      : IO (Either QualityInputError
        (Pair ClippySemanticUnit (Pair InternState CmParseCache))) :=
    let intern : InternState := lexer_intern_state indexed in
    let (MkPair file_index file_count) := loaded in
    match pending with
    | Nil => io_pure (Either QualityInputError
        (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
        (match resolve_import_paths_fuel cm_import_graph_fuel units entry with
         | RErr code detail => Left QualityInputError
             (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
             (QualityInvalidInput (prim_string_concat "compiler import graph failed: "
               (prim_string_concat (prim_string_of_nat code)
                 (prim_string_concat(" at ", cm_string intern detail)))))
         | ROk _ => match sc_index_sorted (quality_sort ScDecl
             (fun (a : ScDecl) (b : ScDecl) => leb_nat(sc_decl_name a, sc_decl_name b)) symbols) with
           | Left error => Left QualityInputError
               (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
               (QualityInvalidInput (sc_error_message error))
            | Right index =>
                let path : List Nat := prim_string_to_char_codes (entry_path intern) in
                let files : List (Pair (List Nat) ImpReg) :=
                  [MkPair (List Nat) ImpReg path root_aliases] in
                match module_alias_units intern files with
                | RErr code detail => Left QualityInputError
                    (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                    (QualityInvalidInput (prim_string_concat
                      "compiler import aliases failed: "
                      (prim_string_concat (prim_string_of_nat code)
                        (prim_string_concat(" at ", prim_string_of_nat detail)))))
                | ROk aliases =>
                    let members : List ModuleMember := cm_qualified_members entry aliases symbols units in
                    Right QualityInputError
                      (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                      (MkPair ClippySemanticUnit (Pair InternState CmParseCache)
                        (CmUnit intern entry source units symbols index root_decls
                          file_count origins
                          (CmResolvedImportsOf aliases members))
                        (MkPair InternState CmParseCache intern cache))
                end
           end
         end)
    | Cons id rest => match fuel with
      | Z => io_pure (Either QualityInputError
          (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
          (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
            (QualityInvalidInput "semantic source queue traversal exhausted"))
      | S remaining => match FileIndex.entry_index_lookup id file_index with
        | Just _ =>
          go remaining file_budget rest loaded indexed units symbols
            source root_decls cache keep origins root_aliases
        | Nothing =>
          match file_budget with
          | Z => io_pure (Either QualityInputError
              (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
              (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                (QualityInvalidInput "semantic source inventory exhausted"))
          | S files_remaining =>
              let path : String := cm_string intern id in
              if
                andb (notb (eq_nat id entry))
                  (andb (cm_skip_import_for (entry_path intern) path)
                    (notb (elem Nat eq_nat id keep))) then
                go remaining file_budget rest (cm_mark_loaded_file id loaded) indexed
                  (Cons SrcUnit (mk_src_unit id (Nil Decl) (Nil Nat)) units)
                  symbols source root_decls cache keep origins root_aliases
              else
                match! quality_read_file (quality_child root path) with
                | Left error => io_pure (Either QualityInputError
                    (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
                    (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache)) error)
                | Right text =>
                    if eq_nat id entry then
                      match cm_parse_indexed True text indexed with
                      | Left error => io_pure (Either QualityInputError
                          (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
                          (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                            (QualityInvalidInput (prim_string_concat path
                              (prim_string_concat(": ", quality_input_message error)))))
                      | Right parsed => let (MkPair decls metadata) := parsed in
                        let (MkPair lexed aliases) := metadata in
                        let (MkPair harvest updated) :=
                          cm_after_parse_indexed path id True decls lexed in
                        let (MkHarvest _ file_symbols imports file _) := harvest in
                        go remaining files_remaining
                          (append Nat imports rest) (cm_mark_loaded_file id loaded)
                          updated (Cons SrcUnit (mk_src_unit id (cm_import_stubs imports) (cm_parsed_private file)) units)
                          (append ScDecl file_symbols symbols)
                          text (cm_parsed_decls file) cache imports origins aliases
                      end
                    else
                      match cm_load_file_cached (MkPair String String path text) indexed cache with
                      | Left error => io_pure (Either QualityInputError
                          (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
                          (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                            (QualityInvalidInput (prim_string_concat path
                              (prim_string_concat(": ", quality_input_message error)))))
                      | Right loaded_file => let (MkPair harvested next) := loaded_file in
                        let (MkPair updated next_cache) := next in
                        let (MkHarvest _ file_symbols imports file captured) :=
                          harvested in
                        go remaining files_remaining
                          (append Nat imports rest) (cm_mark_loaded_file id loaded)
                          updated (Cons SrcUnit (mk_src_unit id (cm_import_stubs imports) (cm_parsed_private file)) units)
                          (append ScDecl file_symbols symbols)
                          source root_decls next_cache keep
                          (append CsOriginFact captured origins) root_aliases
                      end
                end
          end
        end
      end
    end;

def cm_load_pending (root : String) (entry : Nat) (fuel : Nat) (file_budget : Nat)
    (pending : List Nat) (loaded : List Nat)
    : LexerIntern -> List SrcUnit -> List ScDecl -> String -> List Decl
    -> CmParseCache -> List Nat -> List CsOriginFact -> ImpReg
    -> IO (Either QualityInputError (Pair ClippySemanticUnit (Pair InternState CmParseCache))) :=
    let files : CmLoadedFiles := foldl Nat CmLoadedFiles
      (fun (state : CmLoadedFiles) (id : Nat) => cm_mark_loaded_file id state)
      cm_no_loaded_files loaded in
    cm_load_pending_indexed root entry (Nothing String) fuel file_budget pending files;

def cm_load_cached (root : String) (relative : String) (intern : InternState)
    (cache : CmParseCache)
    : IO (Either QualityInputError
        (Pair ClippySemanticUnit (Pair InternState CmParseCache))) :=
    -- Keep derived indexes in this root's arena, outside the retained session state.
    let canonical : List Nat := load_canon_path (Nil Nat) (prim_string_to_char_codes relative) in
    let (MkPair entry next) := lexer_intern_string (lexer_intern_from intern) canonical in
    -- The path remains valid while import parsing adds strings to the intern table.
    cm_load_pending_indexed root entry (Just String (prim_string_of_char_codes canonical))
      cm_load_queue_fuel cm_file_budget ([entry] : List Nat) cm_no_loaded_files
      next (Nil SrcUnit) (Nil ScDecl) "" (Nil Decl) cache
       (Nil Nat) (Nil CsOriginFact) empty_imp_reg;

def cm_load (root : String) (relative : String) : IO (Either QualityInputError ClippySemanticUnit) :=
    do let! loaded := cm_load_cached root relative empty_intern cm_cache0;
       io_pure (Either QualityInputError ClippySemanticUnit)
         (match loaded with
          | Left error => Left QualityInputError ClippySemanticUnit error
          | Right pair => let (MkPair unit _) := pair in
            Right QualityInputError ClippySemanticUnit unit
          end)
