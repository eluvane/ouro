-- Clippy's single-read, single-parse compilation-unit loader. The compiler's
-- lexer, parser, canonical import paths and graph resolver own the input ABI.
-- No failed frontend stage can be replaced by a textual approximation.

import "structural_frontend.ouro",
  "intern_surface.ouro",
  "session_policy.ouro",
  "semantic_origins.ouro",
  "../../compiler/pipeline_abi.ouro",
  "../../compiler/parser_file.ouro",
  "../../compiler/parser_parse.ouro",
  "../../compiler/semantic_scope.ouro",
  "../../compiler/import_resolve.ouro",
  "../../compiler/module_registry.ouro",
  "../../compiler/canonical_hash.ouro",
  "../quality/source.ouro",
  "../quality/input_error.ouro";

def cm_pool_text (pool : List (Pair (List Nat) Nat)) (id : Nat) : String :=
    (fix go (xs : List (Pair (List Nat) Nat)) : String :=
      match xs with
      | Nil => ""
      | Cons p rest => match p with
        | MkPair bytes key => match eq_nat id key with
          | True => prim_string_of_char_codes bytes
          | False => go rest
          end
        end
      end) pool;

def cm_name (intern : InternState) (id : Nat) : String :=
    match intern with | MkIntern ids _ _ _ => cm_pool_text ids id end;

def cm_string (intern : InternState) (id : Nat) : String :=
    match intern with | MkIntern _ _ strings _ => cm_pool_text strings id end;

-- Import IDs become canonical identities in the same shared string pool.
def cm_canon_imports (path : String) : List Decl -> InternState
    -> Pair (List Decl) InternState :=
  let path_codes : List Nat := prim_string_to_char_codes path in
  fix go (decls : List Decl) (intern : InternState)
      : Pair (List Decl) InternState :=
    match decls with
    | Nil => MkPair(List Decl, InternState, Nil Decl, intern)
    | Cons decl rest =>
        let transformed : Pair Decl InternState := match decl with
          | DImport spelling =>
              match load_intern_string intern (load_canon_path path_codes
              (prim_string_to_char_codes (cm_string intern spelling))) with
            | MkPair canonical updated => MkPair Decl InternState (DImport canonical) updated
            end
          | DDef _ _ _ _ _ => MkPair Decl InternState decl intern
          | DAxiom _ _ => MkPair Decl InternState decl intern
          | DInductive _ _ _ _ _ => MkPair Decl InternState decl intern
          | DEffect _ _ _ => MkPair Decl InternState decl intern
          | DIntrinsic _ _ _ _ => MkPair Decl InternState decl intern
          | DExtern _ _ _ => MkPair Decl InternState decl intern
          | DRepresentation _ _ => MkPair Decl InternState decl intern
          end in
        match transformed with
        | MkPair head updated => match go rest updated with
          | MkPair tail_decls final => MkPair (List Decl) InternState
              (Cons Decl head tail_decls) final
          end
        end
    end;

def cm_import_ids (decls : List Decl) : List Nat :=
    concat_map Decl Nat (fun (decl : Decl) => match decl with
      | DImport id => [id]
      | DDef _ _ _ _ _ => Nil Nat
      | DAxiom _ _ => Nil Nat
      | DInductive _ _ _ _ _ => Nil Nat
      | DEffect _ _ _ => Nil Nat
      | DIntrinsic _ _ _ _ => Nil Nat
      | DExtern _ _ _ => Nil Nat
      | DRepresentation _ _ => Nil Nat
      end) decls;

-- Validate only the import projection with the compiler-owned resolver. Its
-- normal compilation API also flattens every local declaration into one list;
-- semantic units already retain indexed declarations and never use that list.
-- Passing imports alone preserves missing-module/cycle errors without repeatedly
-- copying the growing declaration accumulator on every module completion.
def cm_graph_units (units : List SrcUnit) : List SrcUnit :=
    map SrcUnit SrcUnit (fun (unit : SrcUnit) => match unit with
      | MkSrcUnit name _ => mk_src_unit name
          (map(Nat, Decl, fun (id : Nat) => DImport id,
            cm_import_ids (src_unit_decls unit))) []
      end) units;

inductive CmResolvedImports : Type :=
  | CmResolvedImportsOf : List ModuleAliasUnit -> List ModuleMember -> CmResolvedImports;

def cm_empty_resolved_imports : CmResolvedImports :=
    CmResolvedImportsOf (Nil ModuleAliasUnit) (Nil ModuleMember);

inductive ClippySemanticUnit : Type :=
  | CmUnit : InternState -> Nat -> String -> List SrcUnit -> List ScDecl -> ScIndex -> List Decl -> Nat -> List CsOriginFact -> CmResolvedImports -> ClippySemanticUnit;

def cm_intern (item : ClippySemanticUnit) : InternState :=
    match item with | CmUnit value _ _ _ _ _ _ _ _ _ => value end;

def cm_entry (item : ClippySemanticUnit) : Nat :=
    match item with | CmUnit _ value _ _ _ _ _ _ _ _ => value end;

def cm_source (item : ClippySemanticUnit) : String :=
    match item with | CmUnit _ _ value _ _ _ _ _ _ _ => value end;

def cm_units (item : ClippySemanticUnit) : List SrcUnit :=
    match item with | CmUnit _ _ _ value _ _ _ _ _ _ => value end;

def cm_declarations (item : ClippySemanticUnit) : List ScDecl :=
    match item with | CmUnit _ _ _ _ value _ _ _ _ _ => value end;

def cm_index (item : ClippySemanticUnit) : ScIndex :=
    match item with | CmUnit _ _ _ _ _ value _ _ _ _ => value end;

def cm_root_decls (item : ClippySemanticUnit) : List Decl :=
    match item with | CmUnit _ _ _ _ _ _ value _ _ _ => value end;

def cm_origins (item : ClippySemanticUnit) : List CsOriginFact :=
    match item with | CmUnit _ _ _ _ _ _ _ _ value _ => value end;

def cm_resolved_imports (item : ClippySemanticUnit) : CmResolvedImports :=
    match item with | CmUnit _ _ _ _ _ _ _ _ _ value => value end;

-- Qualified references use the compiler's alias, selected-edge and direct
-- owner decision. An unresolved marker never falls back to a short name.
def cm_global_name (unit : ClippySemanticUnit) (name : Nat) : Maybe Nat :=
    let st : InternState := cm_intern unit in
    let atom : List Nat := name_of_id st name in
    match module_split_marker atom with
    | Nothing => Just Nat name
    | Just _ =>
        match cm_resolved_imports unit with
        | CmResolvedImportsOf aliases members =>
          match module_field_decision (cm_units unit) (Nil ModuleExports)
                aliases st (cm_entry unit) atom members False with
            | ModuleAbsent => Nothing Nat
            | ModuleAmbiguous => Nothing Nat
            | ModuleFound resolved => Just Nat resolved
          end
        end
    end;

-- Executable visibility is relative to its source owner. Typed signatures keep
-- the full declaration index, including a public alias's private target type.
def cm_decl_visible (owner : Nat) (decl : ScDecl) (units : List SrcUnit) : Bool :=
    orb (eq_nat(owner, sc_decl_module decl))
      (notb (module_is_private (sc_decl_module decl) (sc_decl_name decl) units));

def cm_global_decl (unit : ClippySemanticUnit) (name : Nat) : Maybe ScDecl :=
    match cm_global_name unit name with
    | Nothing => Nothing ScDecl
    | Just resolved => sc_lookup_global(resolved, cm_index unit)
    end;

def cm_import_stubs (ids : List Nat) : List Decl :=
    map Nat Decl (fun (id : Nat) => DImport id) ids;

def cm_strip_symbol (item : ScDecl) : ScDecl :=
    match item with
    | ScDeclOf name owner kind parent signature _ prim =>
        ScDeclOf name owner kind parent signature (Nothing Expr) prim
    end;

def cm_import_symbols (decls : List ScDecl) : List ScDecl :=
    map ScDecl ScDecl cm_strip_symbol decls;

def cm_parsed_decls (file : ParsedFile) : List Decl :=
    match file with | MkParsedFile decls _ => decls end;

def cm_parsed_private (file : ParsedFile) : List Nat :=
    match file with | MkParsedFile _ names => names end;

inductive CmHarvest : Type :=
  | MkHarvest : InternState -> List ScDecl -> List Nat -> ParsedFile -> List CsOriginFact -> CmHarvest;

-- Finish one parsed file. Imports keep signatures and compact origins; the
-- selected file keeps bodies. This helper is unwrapped. The host arena seam wraps
-- cm_load_file below so leave() drops imported function graphs.
def cm_after_parse (path : String) (module_id : Nat) (keep_bodies : Bool)
    (file : ParsedFile) (intern : InternState) : CmHarvest :=
    match cm_canon_imports path (cm_parsed_decls file) intern with
    | MkPair canonical updated =>
        let imports : List Nat := cm_import_ids canonical in
        let raw : List ScDecl := sc_declarations module_id canonical in
        match keep_bodies with
        | True => MkHarvest updated raw imports
            (MkParsedFile canonical (cm_parsed_private file)) []
        | False => MkHarvest updated (cm_import_symbols raw) imports
            (MkParsedFile (cm_import_stubs imports) (cm_parsed_private file))
            (cs_capture_origins raw)
        end
    end;

-- Dependency identity includes the frontend mode, canonical path, length and
-- exact-byte hash. Immutable dependency bytes verify equality even on a hash
-- collision; root snapshots never enter this bounded cache. Hits reuse harvest facts only; the
-- selected file is still parsed and rules still run. Intern ids stay valid
-- only inside one worker process that grows one intern table.
inductive CmCachedFile : Type :=
  | MkCmCachedFile : String -> Nat -> List Nat -> String -> CmHarvest -> CmCachedFile;

inductive CmParseCache : Type :=
  | MkCmParseCache : List CmCachedFile -> CmParseCache;

inductive CmCacheLookup : Type :=
  | CmCacheHit : CmHarvest -> CmCacheLookup
  | CmCacheMiss : CmCacheLookup
  | CmCacheStale : CmCacheLookup;

def cm_cache0 : CmParseCache :=
    MkCmParseCache (Nil CmCachedFile);

def cm_cache_reset (cache : CmParseCache) : CmParseCache :=
    match cache with
    | MkCmParseCache _ => cm_cache0
    end;

def cm_content_hash (src : String) : List Nat :=
    canonical_hash_bytes (canonical_hash_codes (prim_string_to_char_codes src));

def cm_hash_eq (left : List Nat) (right : List Nat) : Bool :=
    (fix go (xs : List Nat) (ys : List Nat) : Bool :=
      match xs with
      | Nil => match ys with | Nil => True | Cons _ _ => False end
      | Cons x xr => match ys with
        | Nil => False
        | Cons y yr => match eq_nat x y with
          | False => False
          | True => go xr yr
          end
        end
      end) left right;

def cm_cache_row_ok (row : CmCachedFile) : Bool :=
    match row with
    | MkCmCachedFile canonical _ hash _ _ =>
        andb (ltb_nat(0, prim_string_length canonical))
          (eq_nat(length Nat hash, 8))
    end;

def cm_cache_identity (canonical : String) : String :=
    prim_string_concat "ouro.clippy.harvest.v3/compiler-parser/signatures-origins:" canonical;

def cm_cache_get (cache : CmParseCache) (canonical : String) : Maybe CmCachedFile :=
    (fix go (rows : List CmCachedFile) : Maybe CmCachedFile :=
      match rows with
      | Nil => Nothing CmCachedFile
      | Cons row rest => match row with
        | MkCmCachedFile key _ _ _ _ => match prim_string_eq(key, cm_cache_identity canonical) with
          | True => Just CmCachedFile row
          | False => go rest
          end
        end
      end) (match cache with | MkCmParseCache rows => rows end);

def cm_cache_lookup (cache : CmParseCache) (canonical : String) (src : String)
    : CmCacheLookup :=
    match cm_cache_get cache canonical with
    | Nothing => CmCacheMiss
    | Just row => match cm_cache_row_ok row with
      | False => CmCacheStale
      | True => match row with
        | MkCmCachedFile _ stored_len stored_hash stored_source harvest =>
            match andb (eq_nat(stored_len, prim_string_length src))
                (andb (cm_hash_eq(stored_hash, cm_content_hash src))
                  (prim_string_eq stored_source src)) with
            | True => CmCacheHit harvest
            | False => CmCacheStale
            end
        end
      end
    end;

-- Cached facts never retain historical intern spines or imported bodies.
-- The current session's intern table is attached again on a cache hit.
def cm_cache_harvest (harvest : CmHarvest) : CmHarvest :=
    match harvest with
    | MkHarvest _ symbols imports file origins => MkHarvest empty_intern
        (cm_import_symbols symbols) imports
        (MkParsedFile (cm_import_stubs imports) (cm_parsed_private file)) origins
    end;

def cm_cache_bytes (cache : CmParseCache) : Nat :=
    (fix go (rows : List CmCachedFile) : Nat :=
      match rows with
      | Nil => 0
      | Cons row rest => match row with
        | MkCmCachedFile _ size _ _ _ => add(size, go rest)
        end
      end) (match cache with | MkCmParseCache rows => rows end);

def cm_cache_without (canonical : String) (rows : List CmCachedFile)
    : List CmCachedFile :=
    filter CmCachedFile (fun (row : CmCachedFile) => match row with
      | MkCmCachedFile key _ _ _ _ => notb (prim_string_eq(key, cm_cache_identity canonical))
      end) rows;

def cm_cache_trim : Nat -> Nat -> List CmCachedFile -> List CmCachedFile :=
  fix go (slots : Nat) (bytes : Nat) (rows : List CmCachedFile)
      : List CmCachedFile :=
    match slots with
    | Z => Nil CmCachedFile
    | S remaining => match rows with
      | Nil => Nil CmCachedFile
      | Cons row rest => match row with
        | MkCmCachedFile _ size _ _ _ => match leb_nat size bytes with
          | False => go remaining bytes rest
          | True => Cons CmCachedFile row (go remaining (sub bytes size) rest)
          end
        end
      end
    end;

def cm_cache_put (cache : CmParseCache) (canonical : String) (src : String)
    (harvest : CmHarvest) : CmParseCache :=
    match cache with
    | MkCmParseCache rows =>
        let current : List CmCachedFile := cm_cache_without canonical rows in
        let size : Nat := prim_string_length src in
        match leb_nat size cg_session_cache_bytes with
        | False => MkCmParseCache current
        | True => MkCmParseCache (cm_cache_trim cg_session_cache_rows
            cg_session_cache_bytes (Cons CmCachedFile
              (MkCmCachedFile (cm_cache_identity canonical) size (cm_content_hash src) src
                (cm_cache_harvest harvest)) current))
        end
    end;

def cm_cache_contracts : Bool :=
    let src : String := "def n : Nat := Z;" in
    let other : String := "def n : Nat := S Z;" in
    let canonical : String := "std/cache_contract.ouro" in
    let harvest : CmHarvest :=
      MkHarvest(empty_intern, Nil ScDecl, Nil Nat,
        MkParsedFile (Nil Decl) (Nil Nat), Nil CsOriginFact) in
    let cache : CmParseCache :=
      cm_cache_put cm_cache0 canonical src harvest in
    let hit : Bool := match cm_cache_lookup cache canonical src with
      | CmCacheHit _ => True
      | CmCacheMiss => False
      | CmCacheStale => False
      end in
    let miss : Bool := match cm_cache_lookup cm_cache0 canonical src with
      | CmCacheMiss => True
      | CmCacheHit _ => False
      | CmCacheStale => False
      end in
    let stale : Bool := match cm_cache_lookup cache canonical other with
      | CmCacheStale => True
      | CmCacheHit _ => False
      | CmCacheMiss => False
      end in
    let reset : Bool := match cm_cache_lookup (cm_cache_reset cache) canonical src with
      | CmCacheMiss => True
      | CmCacheHit _ => False
      | CmCacheStale => False
      end in
    andb(hit, andb(miss, andb stale reset));

-- Native-tool build metadata scopes this two-argument import harvest.
-- Type-alias following on imports stays unknown.
def cm_load_file (req : Pair String String) (intern : InternState)
    : Either QualityInputError CmHarvest :=
    match req with
    | MkPair path source =>
        match cm_parse_with_aliases source intern with
        | Left error => Left QualityInputError CmHarvest error
        | Right parsed => match parsed with
          | MkPair file metadata => match metadata with
            | MkPair lexed _ => match load_intern_string lexed
                (prim_string_to_char_codes path) with
              | MkPair module_id updated =>
                  Right QualityInputError CmHarvest
                    (cm_after_parse path module_id False file updated)
              end
            end
          end
        end
    end;

def cm_load_file_cached (req : Pair String String) (intern : InternState)
    (cache : CmParseCache) : Either QualityInputError (Pair CmHarvest CmParseCache) :=
    match req with
    | MkPair path source =>
        match cm_cache_lookup cache path source with
        | CmCacheHit harvest =>
            match harvest with
            | MkHarvest _ symbols imports decls origins =>
                Right QualityInputError (Pair CmHarvest CmParseCache)
                  (MkPair CmHarvest CmParseCache
                    (MkHarvest intern symbols imports decls origins) cache)
            end
        | CmCacheMiss =>
            match cm_load_file req intern with
            | Left error => Left QualityInputError (Pair CmHarvest CmParseCache) error
            | Right harvest =>
                Right QualityInputError (Pair CmHarvest CmParseCache)
                  (MkPair CmHarvest CmParseCache harvest
                    (cm_cache_put cache path source harvest))
            end
        | CmCacheStale =>
            match cm_load_file req intern with
            | Left error => Left QualityInputError (Pair CmHarvest CmParseCache) error
            | Right harvest =>
                Right QualityInputError (Pair CmHarvest CmParseCache)
                  (MkPair CmHarvest CmParseCache harvest
                    (cm_cache_put cache path source harvest))
            end
        end
    end;

-- Paths are repository-relative compiler canonical paths. The caller anchors
-- disk reads to an already resolved repository root. Source text is retained
-- only for the selected file, to give the reporting process that SAME snapshot.
def cm_load_pending (root : String) (entry : Nat) : Nat -> Nat -> List Nat -> List Nat
    -> InternState -> List SrcUnit -> List ScDecl -> String -> List Decl
    -> CmParseCache -> List CsOriginFact -> ImpReg
    -> IO (Either QualityInputError
        (Pair ClippySemanticUnit (Pair InternState CmParseCache))) :=
  fix go (fuel : Nat) (file_budget : Nat) (pending : List Nat) (loaded : List Nat)
      (intern : InternState) (units : List SrcUnit) (symbols : List ScDecl)
      (source : String) (root_decls : List Decl) (cache : CmParseCache)
      (origins : List CsOriginFact) (root_aliases : ImpReg)
      : IO (Either QualityInputError
        (Pair ClippySemanticUnit (Pair InternState CmParseCache))) :=
    match pending with
    | Nil => io_pure (Either QualityInputError
        (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
        (match resolve_imports_fuel cm_import_graph_fuel (cm_graph_units units) entry with
         | RErr code detail => Left QualityInputError
             (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
             (QualityInvalidInput (prim_string_concat "compiler import graph failed: "
               (prim_string_concat (prim_string_of_nat code)
                 (prim_string_concat(" at ", cm_string intern detail)))))
         | ROk _ => match sc_index_sorted (quality_sort ScDecl
             (fun (a : ScDecl) (b : ScDecl) => leb_nat(sc_decl_name a, sc_decl_name b)) symbols) with
           | Left error => Left QualityInputError
               (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
               (QualityInvalidInput (sc_error_message error))
            | Right index =>
                let path : List Nat := prim_string_to_char_codes(cm_string intern entry) in
                let files : List (Pair (List Nat) ImpReg) :=
                  [MkPair (List Nat) ImpReg path root_aliases] in
                match module_alias_units intern files with
                | RErr code detail => Left QualityInputError
                    (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                    (QualityInvalidInput (prim_string_concat
                      "compiler import aliases failed: "
                      (prim_string_concat (prim_string_of_nat code)
                        (prim_string_concat(" at ", prim_string_of_nat detail)))))
                | ROk aliases =>
                    let members : List ModuleMember := map ScDecl ModuleMember
                      (fun (decl : ScDecl) => MkModuleMember
                        (sc_decl_module decl) (sc_decl_name decl)
                        (sc_decl_name decl)
                        (notb (module_is_private (sc_decl_module decl)
                          (sc_decl_name decl) units))) symbols in
                    Right QualityInputError
                      (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                      (MkPair ClippySemanticUnit (Pair InternState CmParseCache)
                        (CmUnit intern entry source units symbols index root_decls
                          (length Nat loaded) origins
                          (CmResolvedImportsOf aliases members))
                        (MkPair InternState CmParseCache intern cache))
                end
           end
         end)
    | Cons id rest => match fuel with
      | Z => io_pure (Either QualityInputError
          (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
          (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
            (QualityInvalidInput "semantic source queue traversal exhausted"))
      | S remaining => match elem Nat eq_nat id loaded with
      | True => go remaining file_budget rest loaded intern units symbols
          source root_decls cache origins root_aliases
      | False => match file_budget with
        | Z => io_pure (Either QualityInputError
            (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
            (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
              (QualityInvalidInput "semantic source inventory exhausted"))
        | S files_remaining =>
            let path : String := cm_string intern id in
            do let! input := quality_read_file (quality_child root path);
               match input with
               | Left error => io_pure (Either QualityInputError
                   (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
                   (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache)) error)
               | Right text =>
                   match eq_nat id entry with
                   | True => match cm_parse_with_aliases text intern with
                     | Left error => io_pure (Either QualityInputError
                         (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
                         (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                           (QualityInvalidInput (prim_string_concat path
                             (prim_string_concat(": ", quality_input_message error)))))
                     | Right parsed => match parsed with
                       | MkPair decls metadata => match metadata with
                         | MkPair lexed aliases => match cm_after_parse path id True decls lexed with
                           | MkHarvest updated file_symbols imports file _ =>
                               go remaining files_remaining
                                 (append Nat imports rest) (Cons Nat id loaded)
                                 updated (Cons SrcUnit (mk_src_unit id (cm_import_stubs imports) (cm_parsed_private file)) units)
                                 (append ScDecl file_symbols symbols)
                                 text (cm_parsed_decls file) cache origins aliases
                           end
                         end
                       end
                     end
                   | False => match cm_load_file_cached (MkPair String String path text) intern cache with
                     | Left error => io_pure (Either QualityInputError
                         (Pair(ClippySemanticUnit, Pair InternState CmParseCache)))
                         (Left QualityInputError (Pair(ClippySemanticUnit, Pair InternState CmParseCache))
                           (QualityInvalidInput (prim_string_concat path
                             (prim_string_concat(": ", quality_input_message error)))))
                     | Right loaded_file => match loaded_file with
                       | MkPair harvested next_cache => match harvested with
                         | MkHarvest updated file_symbols imports file captured =>
                             go remaining files_remaining
                               (append Nat imports rest) (Cons Nat id loaded)
                               updated (Cons SrcUnit (mk_src_unit id (cm_import_stubs imports) (cm_parsed_private file)) units)
                               (append ScDecl file_symbols symbols)
                               source root_decls next_cache
                               (append CsOriginFact captured origins) root_aliases
                         end
                       end
                     end
                   end
               end
        end
      end
      end
    end;

def cm_load_cached (root : String) (relative : String) (intern : InternState)
    (cache : CmParseCache)
    : IO (Either QualityInputError
        (Pair ClippySemanticUnit (Pair InternState CmParseCache))) :=
    match load_intern_string intern (load_canon_path (Nil Nat)
        (prim_string_to_char_codes relative)) with
    | MkPair entry next => cm_load_pending root entry cm_load_queue_fuel cm_file_budget
        ([entry] : List Nat) (Nil Nat) next (Nil SrcUnit) (Nil ScDecl) "" (Nil Decl) cache
         (Nil CsOriginFact) empty_imp_reg
    end;

def cm_load (root : String) (relative : String) : IO (Either QualityInputError ClippySemanticUnit) :=
    do let! loaded := cm_load_cached root relative empty_intern cm_cache0;
       io_pure (Either QualityInputError ClippySemanticUnit)
         (match loaded with
          | Left error => Left QualityInputError ClippySemanticUnit error
          | Right pair => match pair with
            | MkPair unit _ => Right QualityInputError ClippySemanticUnit unit
            end
          end)
