-- Compact source origins captured before an imported body leaves its parse arena.
-- Only declaration identities, parameter positions and literal IDs escape.
import "semantic_contract_model.ouro",
  "structural_model.ouro",
  "../../compiler/semantic_scope.ouro";

-- Resolve local aliases to parameter positions. Only unchanged local values
-- enter delegation proofs; call arguments, literals, branches and casts do not.
def cs_local_argument (env : List (Pair Nat Nat)) : Expr -> Maybe Nat :=
  fix cs_local_argument (term : Expr) : Maybe Nat :=
    match term with
    | ESpan _ _ inner => cs_local_argument inner
    | EOpen _ inner => cs_local_argument inner
    | ENamedCall _ _ => Nothing Nat
    | EVar name => sc_lookup_local name env
    | EHole _ => Nothing Nat
    | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat
    | EApp _ _ => Nothing Nat
    | ELam _ _ _ => Nothing Nat
    | EPi _ _ _ => Nothing Nat
    | ELet _ _ _ _ => Nothing Nat
    | EAscribe _ _ => Nothing Nat
    | EMatch _ _ => Nothing Nat
    | EFix _ _ _ _ => Nothing Nat
    | EEffectRow _ _ => Nothing Nat
    | EPerform _ _ => Nothing Nat
    | EDo _ => Nothing Nat
    | EHandle _ _ => Nothing Nat
    | EBranch _ _ _ => Nothing Nat
    | ENoBranch  => Nothing Nat
    | EBinder _ _ _ => Nothing Nat
    | ENoBinder  => Nothing Nat
    | EMultiMatch _ _ => Nothing Nat
    | EStr _ => Nothing Nat
    | EDoBind _ _ => Nothing Nat
    | EList _ => Nothing Nat
    | EListSpread _ _ => Nothing Nat
    | EFallible _ _ _ _ => Nothing Nat
    end;

def cs_argument_positions (env : List (Pair Nat Nat)) : List Expr -> Maybe (List Nat) :=
  fix go (args : List Expr) : Maybe (List Nat) :=
    match args with
    | Nil => Just(List Nat, [])
    | Cons arg rest => match cs_local_argument env arg with
      | Nothing => Nothing (List Nat)
      | Just position => match go rest with
        | Nothing => Nothing (List Nat)
        | Just positions => Just(List Nat, Cons Nat position positions) end
      end
    end;

-- The initial lambdas are the declaration telescope, not nested executions.
-- Aliases are harmless only after that telescope has been completely consumed.
def cs_local_origin : Nat -> Nat -> Nat -> List (Pair Nat Nat) -> Expr -> CsOrigin :=
  fix go (fuel : Nat) (parameters : Nat) (position : Nat)
      (env : List (Pair Nat Nat)) (term : Expr) : CsOrigin :=
    match fuel with
    | Z => CsUnknownOrigin
    | S less => match parameters with
      | S remaining => match term with
        | ELam name _ body => go less remaining (add position 1)
            (Cons(Pair Nat Nat, MkPair Nat Nat name position, env)) body
        | EVar _ => CsUnknownOrigin
        | EHole _ => CsUnknownOrigin
        | ESort _ => CsUnknownOrigin
        | ENat _ => CsUnknownOrigin
        | EApp _ _ => CsUnknownOrigin
        | EPi _ _ _ => CsUnknownOrigin
        | ELet _ _ _ _ => CsUnknownOrigin
        | EAscribe _ _ => CsUnknownOrigin
        | EMatch _ _ => CsUnknownOrigin
        | EFix _ _ _ _ => CsUnknownOrigin
        | EEffectRow _ _ => CsUnknownOrigin
        | EPerform _ _ => CsUnknownOrigin
        | EDo _ => CsUnknownOrigin
        | EHandle _ _ => CsUnknownOrigin
        | EBranch _ _ _ => CsUnknownOrigin
        | ENoBranch  => CsUnknownOrigin
        | EBinder _ _ _ => CsUnknownOrigin
        | ENoBinder  => CsUnknownOrigin
        | EMultiMatch _ _ => CsUnknownOrigin
        | EStr _ => CsUnknownOrigin
        | EDoBind _ _ => CsUnknownOrigin
        | EList _ => CsUnknownOrigin
        | EListSpread _ _ => CsUnknownOrigin
        | ESpan _ _ inner => go less parameters position env inner
        | EFallible _ _ _ _ => CsUnknownOrigin
        | EOpen _ inner => go less parameters position env inner
        | ENamedCall _ _ => CsUnknownOrigin
        end
      | Z => match term with
        | EVar name => match sc_lookup_local name env with
          | Nothing => CsUnknownOrigin | Just arg => CsArgumentOrigin arg end
        | ENat value => CsLiteralOrigin 1 value
        | EStr value => CsLiteralOrigin 2 value
        | ELet name annotation value body => match annotation with
          | Just _ => CsUnknownOrigin
          | Nothing => match cs_local_argument env value with
            | Nothing => CsUnknownOrigin
            | Just arg => go less 0 position
                (Cons(Pair Nat Nat, MkPair Nat Nat name arg, env)) body
            end
          end
        | EApp _ _ => match sc_spine term [] with
          | MkPair head args => match head with
            | EVar name => match sc_lookup_local name env with
              | Just _ => CsUnknownOrigin
              | Nothing => match cs_argument_positions env args with
                | Nothing => CsUnknownOrigin
                | Just positions => CsDelegateOrigin name positions end
              end
            | EHole _ => CsUnknownOrigin
            | ESort _ => CsUnknownOrigin
            | ENat _ => CsUnknownOrigin
            | EApp _ _ => CsUnknownOrigin
            | ELam _ _ _ => CsUnknownOrigin
            | EPi _ _ _ => CsUnknownOrigin
            | ELet _ _ _ _ => CsUnknownOrigin
            | EAscribe _ _ => CsUnknownOrigin
            | EMatch _ _ => CsUnknownOrigin
            | EFix _ _ _ _ => CsUnknownOrigin
            | EEffectRow _ _ => CsUnknownOrigin
            | EPerform _ _ => CsUnknownOrigin
            | EDo _ => CsUnknownOrigin
            | EHandle _ _ => CsUnknownOrigin
            | EBranch _ _ _ => CsUnknownOrigin
            | ENoBranch  => CsUnknownOrigin
            | EBinder _ _ _ => CsUnknownOrigin
            | ENoBinder  => CsUnknownOrigin
            | EMultiMatch _ _ => CsUnknownOrigin
            | EStr _ => CsUnknownOrigin
            | EDoBind _ _ => CsUnknownOrigin
            | EList _ => CsUnknownOrigin
            | EListSpread _ _ => CsUnknownOrigin
            | ESpan _ _ _ => CsUnknownOrigin
            | EFallible _ _ _ _ => CsUnknownOrigin
            | EOpen _ _ => CsUnknownOrigin
            | ENamedCall _ _ => CsUnknownOrigin
            end
          end
        | EDo statements => match statements with
          | Cons action rest => match rest with
            | Nil => go less 0 position env action
            | Cons _ _ => CsUnknownOrigin end
          | Nil => CsUnknownOrigin end
        | EHole _ => CsUnknownOrigin
        | ESort _ => CsUnknownOrigin
        | ELam _ _ _ => CsUnknownOrigin
        | EPi _ _ _ => CsUnknownOrigin
        | EAscribe _ _ => CsUnknownOrigin
        | EMatch _ _ => CsUnknownOrigin
        | EFix _ _ _ _ => CsUnknownOrigin
        | EEffectRow _ _ => CsUnknownOrigin
        | EPerform _ _ => CsUnknownOrigin
        | EHandle _ _ => CsUnknownOrigin
        | EBranch _ _ _ => CsUnknownOrigin
        | ENoBranch  => CsUnknownOrigin
        | EBinder _ _ _ => CsUnknownOrigin
        | ENoBinder  => CsUnknownOrigin
        | EMultiMatch _ _ => CsUnknownOrigin
        | EDoBind _ _ => CsUnknownOrigin
        | EList _ => CsUnknownOrigin
        | EListSpread _ _ => CsUnknownOrigin
        | ESpan _ _ inner => go less 0 position env inner
        | EFallible _ _ _ _ => CsUnknownOrigin
        | EOpen _ inner => go less 0 position env inner
        | ENamedCall _ _ => CsUnknownOrigin
        end
      end
    end;

def cs_ordered_arguments : List Nat -> Nat -> Bool :=
  fix go (args : List Nat) (expected : Nat) : Bool :=
    match args with
    | Nil => True
    | Cons arg rest => andb(eq_nat arg expected, go(rest, add expected 1)) end;

-- Unknown bodies are omitted; they cannot acquire a summary on a cache hit.
def cs_capture_origins (decls : List ScDecl) : List CsOriginFact :=
    concat_map ScDecl CsOriginFact (fun (decl : ScDecl) =>
      match eq_nat(sc_decl_kind decl, 0) with
      | False => []
      | True => match sc_decl_body decl with
        | Nothing => []
        | Just body =>
            let origin : CsOrigin := cs_local_origin cm_type_alias_fuel
              (sc_pi_arity (sc_decl_type decl)) 0 [] body in
            match origin with
            | CsUnknownOrigin => []
            | CsArgumentOrigin _ => [CsOriginOf(sc_decl_module decl, sc_decl_name decl, origin)]
            | CsLiteralOrigin _ _ => [CsOriginOf(sc_decl_module decl, sc_decl_name decl, origin)]
            | CsDelegateOrigin _ positions => match andb
                (eq_nat(length Nat positions, sc_pi_arity (sc_decl_type decl)))
                (cs_ordered_arguments positions 0) with
              | True => [CsOriginOf(sc_decl_module decl, sc_decl_name decl, origin)]
              | False => [] end
            end
        end
      end) decls;
