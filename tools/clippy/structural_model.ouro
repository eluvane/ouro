-- Local structural facts over compiler-owned Expr/Decl, not source spellings.
-- Interned names are spelling ids. CgSBinding supplies a fresh lexical identity;
-- the same spelling in another scope is never evidence of the same value.
-- This first slice deliberately does not infer imported types, call purity,
-- indexed elimination, public ownership, or permission to edit an API.

import "../quality/order.ouro",
  "../quality/input_error.ouro",
  "../../compiler/ast.ouro",
  "../../std/string_prims.ouro",
  "../../std/listx.ouro";

-- Named budgets used by the structural/semantic companion. Products of
-- small literals keep C emit below clang's compound-literal nest limit;
-- a whole-body 4096 Peano tower is 4098 nested `(ouro_v *[]){` braces.
def cg_s_lex_fuel_pad : Nat := mul 32 32;
def cg_s_k : Nat := 1000;
def cg_s_build_fuel : Nat := mul 100 cg_s_k;
def cm_type_alias_fuel : Nat := 256;
def cm_visit_fuel : Nat := mul 64 64;
def cm_analyze_depth : Nat := 16;
def cm_node_inventory_limit : Nat := mul(mul 5 100, cg_s_k);
def cm_body_tag : Nat := 300;
def cm_import_graph_fuel : Nat := mul cg_s_k cg_s_k;
def cm_load_queue_fuel : Nat := mul 100 cg_s_k;
def cm_file_budget : Nat := mul 64 64;

inductive CgSAtom : Type :=
  | CgSLocal : Nat -> Nat -> CgSAtom
  | CgSNat : Nat -> CgSAtom
  | CgSString : Nat -> CgSAtom
  | CgSConstructor : Nat -> Nat -> CgSAtom;

inductive CgSBinding : Type :=
  | MkCgSBinding : Nat -> Nat -> Maybe Nat -> CgSBinding;

inductive CgSCatalog : Type :=
  | MkCgSCatalog : List (Pair Nat (List Nat)) -> List (Pair Nat Nat) -> CgSCatalog;

-- Facts carry proof inputs, not rule ids, severities, source rewrites, or AST
-- copies. Node ordinals identify expressions within this one parsed unit.
inductive CgSFact : Type :=
  | CgSLet : Nat -> Nat -> Nat -> Nat -> Bool -> Bool -> CgSFact
  | CgSMatch : Nat -> Nat -> Nat -> Nat -> Maybe CgSAtom -> Bool -> CgSFact;

def cg_s_node (fact : CgSFact) : Nat :=
    match fact with
    | CgSLet _ node _ _ _ _ => node
    | CgSMatch _ node _ _ _ _ => node
    end;

-- The last two fields are the innermost enclosing token span and the span
-- recorded for each fact node.
inductive CgSState : Type :=
  | MkCgSState : Nat -> Nat -> List CgSFact -> Maybe (Pair Nat Nat)
      -> List (Pair Nat (Pair Nat Nat)) -> CgSState;

def cg_s_walk0 : CgSState :=
    MkCgSState(1, 0, Nil CgSFact, Nothing (Pair Nat Nat), Nil (Pair(Nat, Pair Nat Nat)));

def cg_s_fresh (s : CgSState) : Nat :=
    match s with | MkCgSState n _ _ _ _ => n end;

def cg_s_nodes (s : CgSState) : Nat :=
    match s with | MkCgSState _ n _ _ _ => n end;

def cg_s_facts (s : CgSState) : List CgSFact :=
    match s with | MkCgSState _ _ fs _ _ => reverse_lin CgSFact fs end;

def cg_s_span (s : CgSState) : Maybe (Pair Nat Nat) :=
    match s with | MkCgSState _ _ _ span _ => span end;

def cg_s_spans (s : CgSState) : List (Pair Nat (Pair Nat Nat)) :=
    match s with | MkCgSState _ _ _ _ table => table end;

def cg_s_with_span (span : Maybe (Pair Nat Nat)) (s : CgSState) : CgSState :=
    match s with | MkCgSState n visited fs _ table => MkCgSState n visited fs span table end;

def cg_s_tick (s : CgSState) : CgSState :=
    match s with | MkCgSState n visited fs span table => MkCgSState n (add visited 1) fs span table end;

def cg_s_record (s : CgSState) (f : CgSFact) : CgSState :=
    match s with | MkCgSState n visited fs span table =>
      MkCgSState n visited (Cons CgSFact f fs) span
        (match span with
         | Nothing => table
         | Just range => Cons(Pair(Nat, Pair Nat Nat), MkPair(Nat, Pair Nat Nat, cg_s_node f, range), table)
         end) end;

def cg_s_lookup (name : Nat) : List CgSBinding -> Maybe CgSBinding :=
  fix go (env : List CgSBinding) : Maybe CgSBinding :=
    match env with
    | Nil => Nothing CgSBinding
    | Cons b rest => match b with
      | MkCgSBinding spelling _ _ => match eq_nat name spelling with
        | True => Just CgSBinding b
        | False => go rest
        end
      end
    end;

def cg_s_bind (name : Nat) (kind : Maybe Nat) (env : List CgSBinding)
    (s : CgSState) : Pair (List CgSBinding) CgSState :=
    match s with
    | MkCgSState next visited fs span table =>
        MkPair (List CgSBinding) CgSState
          (Cons CgSBinding (MkCgSBinding name next kind) env)
          (MkCgSState (add next 1) visited fs span table)
    end;

def cg_s_bind_names : List Nat -> List CgSBinding -> CgSState
    -> Pair (List CgSBinding) CgSState :=
  fix go (names : List Nat) (env : List CgSBinding) (s : CgSState)
      : Pair (List CgSBinding) CgSState :=
    match names with
    | Nil => MkPair (List CgSBinding) CgSState env s
    | Cons name rest => match cg_s_bind name (Nothing Nat) env s with
      | MkPair env2 s2 => go rest env2 s2
      end
    end;

def cg_s_atom_equal (a : CgSAtom) (b : CgSAtom) : Bool :=
    match a with
    | CgSLocal _ x => match b with
      | CgSLocal _ y => eq_nat x y
      | CgSNat _ => False
      | CgSString _ => False
      | CgSConstructor _ _ => False
      end
    | CgSNat x => match b with
      | CgSLocal _ _ => False
      | CgSNat y => eq_nat x y
      | CgSString _ => False
      | CgSConstructor _ _ => False
      end
    | CgSString x => match b with
      | CgSLocal _ _ => False
      | CgSNat _ => False
      | CgSString y => eq_nat x y
      | CgSConstructor _ _ => False
      end
    | CgSConstructor t x => match b with
      | CgSLocal _ _ => False
      | CgSNat _ => False
      | CgSString _ => False
      | CgSConstructor u y => andb(eq_nat t u, eq_nat x y)
      end
    end;

def cg_s_maybe_equal (a : Maybe CgSAtom) (b : Maybe CgSAtom) : Bool :=
    match a with
    | Nothing => False
    | Just x => match b with
      | Nothing => False
      | Just y => cg_s_atom_equal x y
      end
    end;

def cg_s_enums (c : CgSCatalog) : List (Pair Nat (List Nat)) :=
    match c with | MkCgSCatalog es _ => es end;

def cg_s_ctors (c : CgSCatalog) : List (Pair Nat Nat) :=
    match c with | MkCgSCatalog _ cs => cs end;

-- A local constructor is eligible only if its declaration proves a closed,
-- parameter-free enum. A name such as True, Left, Ok, or Error proves nothing.
def cg_s_var_atom (c : CgSCatalog) (env : List CgSBinding) (n : Nat)
    : Maybe CgSAtom :=
    match cg_s_lookup n env with
    | Just b => match b with
      | MkCgSBinding _ identity _ => Just(CgSAtom, CgSLocal n identity)
      end
    | Nothing => match lookup Nat Nat eq_nat n (cg_s_ctors c) with
      | Nothing => Nothing CgSAtom
      | Just enum_id => Just(CgSAtom, CgSConstructor enum_id n)
      end
    end;

-- No application, effect, ascription, or unknown global is called pure.
def cg_s_atom (c : CgSCatalog) (env : List CgSBinding)
    : Expr -> Maybe CgSAtom :=
  fix cg_s_atom (e : Expr) : Maybe CgSAtom :=
    match e with
    | ESpan _ _ inner => cg_s_atom inner
    | EFallible _ _ _ _ => Nothing CgSAtom
    | EVar n => cg_s_var_atom c env n
    | EHole _ => Nothing CgSAtom
    | ESort _ => Nothing CgSAtom
    | ENat n => Just(CgSAtom, CgSNat n)
    | EApp _ _ => Nothing CgSAtom
    | ELam _ _ _ => Nothing CgSAtom
    | EPi _ _ _ => Nothing CgSAtom
    | ELet _ _ _ _ => Nothing CgSAtom
    | EAscribe _ _ => Nothing CgSAtom
    | EMatch _ _ => Nothing CgSAtom
    | EFix _ _ _ _ => Nothing CgSAtom
    | EEffectRow _ _ => Nothing CgSAtom
    | EPerform _ _ => Nothing CgSAtom
    | EDo _ => Nothing CgSAtom
    | EHandle _ _ => Nothing CgSAtom
    | EBranch _ _ _ => Nothing CgSAtom
    | ENoBranch => Nothing CgSAtom
    | EBinder _ _ _ => Nothing CgSAtom
    | ENoBinder => Nothing CgSAtom
    | EMultiMatch _ _ => Nothing CgSAtom
    | EStr n => Just(CgSAtom, CgSString n)
    | EDoBind _ _ => Nothing CgSAtom
    | EList _ => Nothing CgSAtom
    end;

def cg_s_type_name (c : CgSCatalog) (env : List CgSBinding) (n : Nat) : Maybe Nat :=
    match cg_s_lookup n env with
    | Just _ => Nothing Nat
    | Nothing => match lookup Nat (List Nat) eq_nat n (cg_s_enums c) with
      | Nothing => Nothing Nat
      | Just _ => Just Nat n
      end
    end;

def cg_s_type_enum (c : CgSCatalog) (env : List CgSBinding) : Expr -> Maybe Nat :=
  fix cg_s_type_enum (ty : Expr) : Maybe Nat :=
    match ty with
    | ESpan _ _ inner => cg_s_type_enum inner
    | EFallible _ _ _ _ => Nothing Nat
    | EVar n => cg_s_type_name c env n
    | EHole _ => Nothing Nat
    | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat
    | EApp _ _ => Nothing Nat
    | ELam _ _ _ => Nothing Nat
    | EPi _ _ _ => Nothing Nat
    | ELet _ _ _ _ => Nothing Nat
    | EAscribe _ _ => Nothing Nat
    | EMatch _ _ => Nothing Nat
    | EFix _ _ _ _ => Nothing Nat
    | EEffectRow _ _ => Nothing Nat
    | EPerform _ _ => Nothing Nat
    | EDo _ => Nothing Nat
    | EHandle _ _ => Nothing Nat
    | EBranch _ _ _ => Nothing Nat
    | ENoBranch => Nothing Nat
    | EBinder _ _ _ => Nothing Nat
    | ENoBinder => Nothing Nat
    | EMultiMatch _ _ => Nothing Nat
    | EStr _ => Nothing Nat
    | EDoBind _ _ => Nothing Nat
    | EList _ => Nothing Nat
    end;

def cg_s_annotation (c : CgSCatalog) (env : List CgSBinding) (ann : Maybe Expr)
    : Maybe Nat :=
    match ann with
    | Nothing => Nothing Nat
    | Just ty => cg_s_type_enum c env ty
    end;

def cg_s_value_enum (c : CgSCatalog) (env : List CgSBinding) : Expr -> Maybe Nat :=
  fix cg_s_value_enum (e : Expr) : Maybe Nat :=
    match e with
    | ESpan _ _ inner => cg_s_value_enum inner
    | EFallible _ _ _ _ => Nothing Nat
    | EVar n => match cg_s_lookup n env with
      | Just b => match b with | MkCgSBinding _ _ kind => kind end
      | Nothing => lookup Nat Nat eq_nat n (cg_s_ctors c)
      end
    | EHole _ => Nothing Nat
    | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat
    | EApp _ _ => Nothing Nat
    | ELam _ _ _ => Nothing Nat
    | EPi _ _ _ => Nothing Nat
    | ELet _ _ _ _ => Nothing Nat
    | EAscribe _ _ => Nothing Nat
    | EMatch _ _ => Nothing Nat
    | EFix _ _ _ _ => Nothing Nat
    | EEffectRow _ _ => Nothing Nat
    | EPerform _ _ => Nothing Nat
    | EDo _ => Nothing Nat
    | EHandle _ _ => Nothing Nat
    | EBranch _ _ _ => Nothing Nat
    | ENoBranch => Nothing Nat
    | EBinder _ _ _ => Nothing Nat
    | ENoBinder => Nothing Nat
    | EMultiMatch _ _ => Nothing Nat
    | EStr _ => Nothing Nat
    | EDoBind _ _ => Nothing Nat
    | EList _ => Nothing Nat
    end;

def cg_s_returns (name : Nat) : Expr -> Bool :=
  fix cg_s_returns (e : Expr) : Bool :=
    match e with
    | ESpan _ _ inner => cg_s_returns inner
    | EFallible _ _ _ _ => False
    | EVar n => eq_nat name n
    | EHole _ => False
    | ESort _ => False
    | ENat _ => False
    | EApp _ _ => False
    | ELam _ _ _ => False
    | EPi _ _ _ => False
    | ELet _ _ _ _ => False
    | EAscribe _ _ => False
    | EMatch _ _ => False
    | EFix _ _ _ _ => False
    | EEffectRow _ _ => False
    | EPerform _ _ => False
    | EDo _ => False
    | EHandle _ _ => False
    | EBranch _ _ _ => False
    | ENoBranch => False
    | EBinder _ _ _ => False
    | ENoBinder => False
    | EMultiMatch _ _ => False
    | EStr _ => False
    | EDoBind _ _ => False
    | EList _ => False
    end;

def cg_s_nullary_ctor (name : Nat) (p : Pair Nat Expr) : Bool :=
    cg_s_returns(name, snd Nat Expr p);

-- Count spelling identities once. Ambiguous local declarations never supply
-- a constructor/type identity, even when their textual names look familiar.
def cg_s_decl_ids (d : Decl) : List Nat :=
    match d with
    | DDef n _ _ _ _ => [n]
    | DAxiom n _ => [n]
    | DInductive n _ _ cs _ => Cons Nat n (map(Pair Nat Expr, Nat, fst Nat Expr, cs))
    | DEffect n _ ops => Cons Nat n (map(Pair Nat Expr, Nat, fst Nat Expr, ops))
    | DImport _ => ([] : List Nat)
    | DIntrinsic n _ _ _ => [n]
    | DExtern n _ _ => [n]
    | DRepresentation _ _ => ([] : List Nat)
    end;

def cg_s_duplicate_ids : List Nat -> List Nat :=
  fix go (ids : List Nat) : List Nat :=
    match ids with
    | Nil => Nil Nat
    | Cons n rest => match rest with
      | Nil => Nil Nat
      | Cons m _ => match eq_nat n m with
        | True => Cons Nat n (go rest)
        | False => go rest
        end
      end
    end;

def cg_s_closed_sort : Expr -> Bool :=
  fix cg_s_closed_sort (e : Expr) : Bool :=
    match e with
    | ESpan _ _ inner => cg_s_closed_sort inner
    | EFallible _ _ _ _ => False
    | EVar _ => False
    | EHole _ => False
    | ESort _ => True
    | ENat _ => False
    | EApp _ _ => False
    | ELam _ _ _ => False
    | EPi _ _ _ => False
    | ELet _ _ _ _ => False
    | EAscribe _ _ => False
    | EMatch _ _ => False
    | EFix _ _ _ _ => False
    | EEffectRow _ _ => False
    | EPerform _ _ => False
    | EDo _ => False
    | EHandle _ _ => False
    | EBranch _ _ _ => False
    | ENoBranch => False
    | EBinder _ _ _ => False
    | ENoBinder => False
    | EMultiMatch _ _ => False
    | EStr _ => False
    | EDoBind _ _ => False
    | EList _ => False
    end;

def cg_s_catalog (ds : List Decl) : CgSCatalog :=
    let ambiguous : List Nat := cg_s_duplicate_ids
      (quality_sort Nat leb_nat (concat_map Decl Nat cg_s_decl_ids ds)) in
    let enums : List (Pair Nat (List Nat)) :=
      concat_map Decl (Pair(Nat, List Nat)) (fun (d : Decl) =>
        match d with
        | DInductive n params kind ctors _ =>
            match params with
            | Cons _ _ => Nil (Pair(Nat, List Nat))
            | Nil => match andb (andb(cg_s_closed_sort kind, notb (elem Nat eq_nat n ambiguous)))
                (all (Pair Nat Expr) (fun (ctor : Pair Nat Expr) =>
                  andb (cg_s_nullary_ctor n ctor)
                    (notb (elem Nat eq_nat (fst Nat Expr ctor) ambiguous))) ctors) with
              | False => Nil (Pair(Nat, List Nat))
              | True => Cons (Pair(Nat, List Nat)) (MkPair Nat (List Nat) n
                  (map(Pair Nat Expr, Nat, fst Nat Expr, ctors)))
                  (Nil (Pair(Nat, List Nat)))
              end
            end
        | DDef _ _ _ _ _ => Nil (Pair(Nat, List Nat))
        | DAxiom _ _ => Nil (Pair(Nat, List Nat))
        | DEffect _ _ _ => Nil (Pair(Nat, List Nat))
        | DImport _ => Nil (Pair(Nat, List Nat))
        | DIntrinsic _ _ _ _ => Nil (Pair(Nat, List Nat))
        | DExtern _ _ _ => Nil (Pair(Nat, List Nat))
        | DRepresentation _ _ => Nil (Pair(Nat, List Nat))
        end) ds in
    MkCgSCatalog enums
      (concat_map (Pair(Nat, List Nat)) (Pair Nat Nat)
        (fun (p : Pair Nat (List Nat)) => match p with
          | MkPair name ctors => map Nat (Pair Nat Nat)
              (fun (ctor : Nat) => MkPair Nat Nat ctor name) ctors
          end) enums);
