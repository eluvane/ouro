import "../std/stringx.ouro",
  "../std/pathx.ouro",
  "../compiler/source_text.ouro";

-- URIs. Only file: URIs are supported; percent escapes are decoded because
-- editors send drive letters as %3A.
def uri_hex (c : Nat) : Nat :=
    if is_digit c then sub c ch_zero
    else if is_upper c then add(sub c ch_A, 10) else add(sub c ch_a, 10);

def uri_decode_codes : Nat -> List Nat -> List Nat :=
  fix uri_decode_codes (fuel : Nat) (cs : List Nat) : List Nat :=
    match fuel with
    | Z => cs
    | S fuel2 =>
        match cs with
        | Nil => Nil Nat
        | Cons c rest =>
            if eq_nat c ch_percent then
              match rest with
              | Nil => ([c] : List Nat)
              | Cons h1 rest2 =>
                  match rest2 with
                  | Nil => ([c, h1] : List Nat)
                  | Cons h2 rest3 =>
                      Cons Nat (add(mul(uri_hex h1, 16), uri_hex h2))
                        (uri_decode_codes fuel2 rest3)
                  end
              end
            else Cons Nat c (uri_decode_codes fuel2 rest)
        end
    end;

def uri_decode (s : String) : String :=
    str_of_codes (uri_decode_codes(S (str_len s), str_codes s));

-- Percent escapes must be complete hexadecimal bytes.  NUL is rejected
-- because host filesystem APIs interpret it as a terminator rather than as a
-- path byte.
def uri_codes_valid : List Nat -> Bool :=
  fix uri_codes_valid (cs : List Nat) : Bool :=
    match cs with
    | Nil => True
    | Cons c rest =>
        if eq_nat c ch_percent then
          match rest with
          | Nil => False
          | Cons h1 rest2 =>
              match rest2 with
              | Nil => False
              | Cons h2 rest3 =>
                  andb (andb(is_hex h1, is_hex h2))
                    (andb
                      (notb (eq_nat(add(mul(uri_hex h1, 16), uri_hex h2), Z)))
                      (uri_codes_valid rest3))
              end
          end
        else andb(notb (eq_nat c Z), uri_codes_valid rest)
    end;

def uri_windows_drive_path (p : String) : String :=
    if andb(str_starts p "/", path_has_drive (str_drop(p, S Z))) then str_drop(p, S Z) else p;

def uri_file_path (uri : String) : Maybe String :=
    if let Just rest := str_strip_prefix uri "file://" then
      if andb (uri_codes_valid (str_codes rest))
        (andb (notb (str_contains rest "#")) (notb (str_contains rest "?"))) then
        let path : String := uri_windows_drive_path (uri_decode rest) in
        if path_is_abs path then Just(String, path_normalize path) else Nothing String
      else Nothing String
    else Nothing String;

def uri_path_byte (byte : Nat) : String :=
    if
      orb(is_alnum byte,
      elem Nat eq_nat byte ([45, 46, 95, 126, 47, 58] : List Nat)) then
      str_of_codes [byte]
    else
      let high : Nat := div_nat byte 16 in
      str_cat3 "%" (str_slice "0123456789ABCDEF" high 1)
        (str_slice "0123456789ABCDEF" (sub(byte, mul high 16)) 1);

def path_to_uri (path : String) : String :=
    let normalized : String := path_from_host path in
    let encoded : String := str_join ""
      (map Nat String uri_path_byte (str_codes normalized)) in
    if str_starts normalized "/" then str_concat "file://" encoded else str_cat3 "file://" "/" encoded;

-- A following str_lines segment proves that this line ended with LF.
-- Only then can a final CR belong to CRLF.
def lsp_line_at (lines : List String) (line : Nat) : String :=
    match drop String line lines with
    | Nil => ""
    | Cons text rest => match rest with
      | Nil => text
      | Cons _ _ => (str_strip_suffix text "\r" ?? text)
      end
    end;

-- After canonical UTF-8 decoding, the lead byte determines both position widths.
def lsp_decoded_widths (lead : Nat) : Pair Nat Nat :=
    if ltb_nat lead 128 then MkPair Nat Nat 1 1
    else
      if ltb_nat lead 224 then MkPair Nat Nat 2 1
      else if ltb_nat lead 240 then MkPair Nat Nat 3 1 else MkPair Nat Nat 4 2;

private def lsp_convert_column (widths : Nat -> Pair Nat Nat)
    (byte_limit : Nat -> Nat) (source_line : String) (column : Nat)
    (round_up : Bool) : Maybe Nat :=
    if eq_nat column Z then Just Nat Z
    else
      let size : Nat := str_len source_line in
      let prefix : String :=
        if ltb_nat column size then
          let limit : Nat := byte_limit column in
          if ltb_nat limit size then str_slice source_line Z limit else source_line
        else source_line in
      (fix convert (fuel : Nat) (codes : List Nat) (left : Nat)
          (offset : Nat) : Maybe Nat :=
        match fuel with
        | Z => Nothing Nat
        | S fuel2 => match left with
          | Z => Just Nat offset
          | S _ => match codes with
            | Nil => Just Nat offset
            | Cons lead _ => match source_take_scalar codes with
              | Nothing => Nothing Nat
              | Just parsed => match parsed, widths lead with
                | MkPair _ rest, MkPair input_width output_width =>
                    if ltb_nat left input_width then
                      Just Nat (if round_up then add offset output_width else offset)
                    else
                      convert fuel2 rest (sub left input_width)
                        (add offset output_width)
                end
              end
            end
          end
        end) (S size) (str_codes prefix) column Z;

def lsp_byte_column (source_line : String) (character : Nat) : Maybe Nat :=
    -- Earlier UTF-16 units need at most three bytes each. The last scalar can need four.
    lsp_convert_column
      (fun (lead : Nat) => let (MkPair bytes units) := lsp_decoded_widths lead in
        MkPair Nat Nat units bytes)
      (fun (units : Nat) => S (mul units 3))
      source_line character False;

def lsp_utf16_column (source_line : String) (column : Nat)
    (round_up : Bool) : Maybe Nat :=
    -- A scalar crossing the byte column can extend three bytes past it.
    lsp_convert_column lsp_decoded_widths (fun (bytes : Nat) => add bytes 3)
      source_line column round_up;
