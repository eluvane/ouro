-- Pure LSP model; hover uses the same doc scanner as ouro doc so editor and generated reference agree.
-- Formatting is delegated to the CLI to avoid namespace collisions and keep editor output identical.

import "doc_model.ouro",
  "../std/json_types.ouro",
  "../std/jsonrpc.ouro",
  "../std/pathx.ouro",
  "fix/lex.ouro",
  "../compiler/source_text.ouro";

-- Documents the client has open, their aggregate byte size, the canonical
-- workspace root authorized by the launcher, and whether shutdown was
-- requested.  The root is never taken from an untrusted document URI.
inductive Lsp : Type :=
  | MkLsp : Map String -> Nat -> String -> Bool -> Lsp;

def lsp_docs (s : Lsp) : Map String :=
    match s with
    | MkLsp d _ _ _ => d
    end;

def lsp_docs_bytes (s : Lsp) : Nat :=
    match s with
    | MkLsp _ n _ _ => n
    end;

def lsp_root (s : Lsp) : String :=
    match s with
    | MkLsp _ _ root _ => root
    end;

def lsp_down (s : Lsp) : Bool :=
    match s with
    | MkLsp _ _ _ b => b
    end;

def lsp_empty : Lsp := MkLsp (map_empty String) Z "" False;

def lsp_with_root (s : Lsp) (root : String) : Lsp :=
    MkLsp(lsp_docs s, lsp_docs_bytes s, root, lsp_down s);

-- Frames have their own larger cap in lsp.ouro.  Keeping an individual
-- source buffer below 512 KiB and all open buffers below 2 MiB prevents a
-- normal full-sync client from retaining attacker-selected memory forever.
def lsp_kib : Nat := mul 32 32;

def lsp_max_document_bytes : Nat := mul(mul 64 8, lsp_kib);

def lsp_max_open_bytes : Nat := mul 4 lsp_max_document_bytes;

def lsp_put_checked (s : Lsp) (uri : String) (text : String) : Maybe Lsp :=
    let old : String := map_get_or String "" uri (lsp_docs s) in
    let total : Nat :=
      add(sub(lsp_docs_bytes s, str_len old), str_len text) in
    match andb (leb_nat(str_len text, lsp_max_document_bytes))
      (leb_nat total lsp_max_open_bytes) with
    | False => Nothing Lsp
    | True =>
        Just Lsp
          (MkLsp (map_insert String uri text (lsp_docs s)) total
            (lsp_root s) (lsp_down s))
    end;

def lsp_drop (s : Lsp) (uri : String) : Lsp :=
    let old : String := map_get_or String "" uri (lsp_docs s) in
    MkLsp (map_delete String uri (lsp_docs s))
      (sub(lsp_docs_bytes s, str_len old)) (lsp_root s) (lsp_down s);

def lsp_shutdown (s : Lsp) : Lsp :=
    MkLsp(lsp_docs s, lsp_docs_bytes s, lsp_root s, True);

def lsp_text (s : Lsp) (uri : String) : String :=
    map_get_or String "" uri (lsp_docs s);

-- URIs. Only file: URIs are supported; percent escapes are decoded because
-- editors send drive letters as %3A.
def uri_hex (c : Nat) : Nat :=
    match is_digit c with
    | True => sub c ch_zero
    | False =>
        match is_upper c with
        | True => add(sub c ch_A, 10)
        | False => add(sub c ch_a, 10)
        end
    end;

def uri_decode_codes : Nat -> List Nat -> List Nat :=
  fix uri_decode_codes (fuel : Nat) (cs : List Nat) : List Nat :=
    match fuel with
    | Z => cs
    | S fuel2 =>
        match cs with
        | Nil => Nil Nat
        | Cons c rest =>
            match eq_nat c ch_percent with
            | False => Cons Nat c (uri_decode_codes fuel2 rest)
            | True =>
                match rest with
                | Nil => ([c] : List Nat)
                | Cons h1 rest2 =>
                    match rest2 with
                    | Nil => ([c, h1] : List Nat)
                    | Cons h2 rest3 =>
                        Cons Nat (add(mul(uri_hex h1, 16), uri_hex h2))
                          (uri_decode_codes fuel2 rest3)
                    end
                end
            end
        end
    end;

def uri_decode (s : String) : String :=
    str_of_codes (uri_decode_codes(S (str_len s), str_codes s));

-- Percent escapes must be complete hexadecimal bytes.  NUL is rejected
-- because host filesystem APIs interpret it as a terminator rather than as a
-- path byte.
def uri_codes_valid : List Nat -> Bool :=
  fix uri_codes_valid (cs : List Nat) : Bool :=
    match cs with
    | Nil => True
    | Cons c rest =>
        match eq_nat c ch_percent with
        | False => andb(notb (eq_nat c Z), uri_codes_valid rest)
        | True =>
            match rest with
            | Nil => False
            | Cons h1 rest2 =>
                match rest2 with
                | Nil => False
                | Cons h2 rest3 =>
                    andb (andb(is_hex h1, is_hex h2))
                      (andb
                        (notb (eq_nat(add(mul(uri_hex h1, 16), uri_hex h2), Z)))
                        (uri_codes_valid rest3))
                end
            end
        end
    end;

def uri_windows_drive_path (p : String) : String :=
    match andb(str_starts p "/", path_has_drive (str_drop(p, S Z))) with
    | True => str_drop(p, S Z)
    | False => p
    end;

def uri_file_path (uri : String) : Maybe String :=
    match str_strip_prefix uri "file://" with
    | Nothing => Nothing String
    | Just rest =>
        match andb (uri_codes_valid (str_codes rest))
          (andb (notb (str_contains rest "#"))
            (notb (str_contains rest "?"))) with
        | False => Nothing String
        | True =>
            let path : String := uri_windows_drive_path (uri_decode rest) in
            match path_is_abs path with
            | True => Just(String, path_normalize path)
            | False => Nothing String
            end
        end
    end;

def path_to_uri (path : String) : String :=
    match str_starts path "/" with
    | True => str_concat "file://" path
    | False => str_cat3 "file://" "/" path
    end;

-- Positions. LSP counts lines and characters from zero.
def lsp_pos (line : Nat) (character : Nat) : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "line" (json_num line)
      , MkPair String Json "character" (json_num character) ] in
    JObj fields;

def lsp_range (l1 : Nat) (c1 : Nat) (l2 : Nat) (c2 : Nat) : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "start" (lsp_pos l1 c1)
      , MkPair String Json "end" (lsp_pos l2 c2) ] in
    JObj fields;

def lsp_pos_line (params : Json) : Nat :=
    json_field_nat (json_field params "position") "line" Z;

def lsp_pos_char (params : Json) : Nat :=
    json_field_nat (json_field params "position") "character" Z;

def lsp_doc_uri (params : Json) : String :=
    json_field_str (json_field params "textDocument") "uri" "";

-- The identifier under the cursor: walk left to the start of the word, then
-- right to its end. Out-of-range positions give the empty string.
def word_start : Nat -> List Nat -> Nat -> Nat :=
  fix word_start (fuel : Nat) (cs : List Nat) (i : Nat) : Nat :=
    match fuel with
    | Z => i
    | S fuel2 =>
        match i with
        | Z => Z
        | S i2 =>
            match is_ident_cont (nth Nat ch_space i2 cs) with
            | True => word_start fuel2 cs i2
            | False => i
            end
        end
    end;

def word_end : Nat -> List Nat -> Nat -> Nat :=
  fix word_end (fuel : Nat) (cs : List Nat) (i : Nat) : Nat :=
    match fuel with
    | Z => i
    | S fuel2 =>
        match ltb_nat(i, length Nat cs) with
        | False => i
        | True =>
            match is_ident_cont (nth Nat ch_space i cs) with
            | True => word_end fuel2 cs (S i)
            | False => i
            end
        end
    end;

def word_in_line (line : String) (col : Nat) : String :=
    let cs : List Nat := str_codes line in
    let n : Nat := length Nat cs in
    match ltb_nat(col, S n) with
    | False => ""
    | True =>
        let i : Nat := word_start(S n, cs, minNat col n) in
        let j : Nat := word_end (S n) cs i in
        str_slice line i (sub j i)
    end;

def word_at (text : String) (line : Nat) (col : Nat) : String :=
    word_in_line(nth String "" line (str_lines text), col);

-- Completion uses the prefix up to the cursor, not the whole identifier.
def prefix_in_line (line : String) (col : Nat) : String :=
    let cs : List Nat := str_codes line in
    let n : Nat := length Nat cs in
    match ltb_nat(col, S n) with
    | False => ""
    | True =>
        let i : Nat := word_start(S n, cs, minNat col n) in
        str_slice line i (sub(minNat col n, i))
    end;

def prefix_at (text : String) (line : Nat) (col : Nat) : String :=
    prefix_in_line(nth String "" line (str_lines text), col);

-- Hover and definition both answer from the declarations of the document and
-- the files it imports, which lsp.ouro collects. A declaration keeps the file
-- it came from so definition can point at another module.
inductive Sym : Type :=
  | MkSym : String -> Decl -> Sym;

def sym_path (s : Sym) : String :=
    match s with
    | MkSym p _ => p
    end;

def sym_decl (s : Sym) : Decl :=
    match s with
    | MkSym _ d => d
    end;

def syms_of_module (path : String) (text : String) : List Sym :=
    map Decl Sym (fun (d : Decl) => MkSym path d)
      (mod_decls (doc_module path text));

def sym_find (name : String) (syms : List Sym) : Maybe Sym :=
    find Sym (fun (s : Sym) => str_eq(decl_name (sym_decl s), name)) syms;

-- Hover value: the signature in a fenced block, then the doc comment.
def hover_markup (s : Sym) : String :=
    let d : Decl := sym_decl s in
    let code : String :=
      str_cat4("```ouro", "\n", decl_sig d, str_concat "\n" "```") in
    let prose : String := str_join(" ", decl_docs d) in
    let origin : String :=
      str_cat3 "_" (str_cat3(sym_path s, ":", prim_string_of_nat (decl_line d))) "_" in
    match str_null prose with
    | True => str_cat3 code "\n\n" origin
    | False => str_cat4 code "\n\n" prose (str_concat "\n\n" origin)
    end;

def hover_result (s : Sym) : Json :=
    let contents : List (Pair String Json) :=
      [ MkPair String Json "kind" (JStr "markdown")
      , MkPair String Json "value" (JStr (hover_markup s)) ] in
    let fields : List (Pair String Json) :=
      [ MkPair String Json "contents" (JObj contents) ] in
    JObj fields;

-- LSP CompletionItemKind: Function=3, Class=7, Interface=8, Constant=21, Struct=22.
def completion_kind_rows : List (Pair String Nat) :=
  [ MkPair String Nat "axiom" 21
  , MkPair String Nat "inductive" 7
  , MkPair String Nat "record" 22
  , MkPair String Nat "effect" 8
  ];

def completion_kind_num (kind : String) : Nat :=
  match lookup String Nat str_eq kind completion_kind_rows with
  | Nothing => 3
  | Just n => n
  end;

def completion_matches (prefix : String) (s : Sym) : Bool :=
    str_starts(decl_name (sym_decl s), prefix);

def completion_item (s : Sym) : Json :=
    let d : Decl := sym_decl s in
    let fields : List (Pair String Json) :=
      [ MkPair String Json "label" (JStr (decl_name d))
      , MkPair String Json "kind" (json_num (completion_kind_num (decl_kind d)))
      , MkPair String Json "detail" (JStr (decl_sig d))
      , MkPair String Json "insertText" (JStr (decl_name d))
      , MkPair String Json "documentation" (JStr (str_join(" ", decl_docs d))) ] in
    JObj fields;

-- Only an explicit, simple top-level result annotation supplies a family.
-- Other expression contexts keep the existing name-prefix completion.
def completion_expected_family (source_line : String) (line : Nat)
    (col : Nat) (prefix : String) (tokens : List FxTok)
    : Maybe String :=
    match ltb_nat(col, S (str_len source_line)) with
    | False => Nothing String
    | True =>
        let start_col : Nat := sub(col, str_len prefix) in
        let before : List FxTok :=
          filter FxTok
            (fun (token : FxTok) =>
              andb(eq_nat(fx_tok_line token, line),
                ltb_nat(fx_tok_col token, start_col)))
            tokens in
        match before with
        | Cons keyword (Cons name (Cons colon
            (Cons family (Cons assign Nil)))) =>
            let assign_end : Nat :=
              add(fx_tok_col assign, str_len(fx_tok_text assign)) in
            let header_ok : Bool := andb(fx_is_word keyword "def",
              andb(fx_tok_bol keyword,
                andb(fx_is_ident name,
                  andb(fx_is_word colon ":",
                    andb(fx_is_ident family,
                      fx_is_word assign ":="))))) in
            let gap_ok : Bool :=
              andb(leb_nat assign_end start_col,
                str_null (str_trim (str_slice source_line
                  assign_end (sub(start_col, assign_end))))) in
            match andb(header_ok, gap_ok) with
            | True => Just(String, fx_tok_text family)
            | False => Nothing String
            end
        | _ => Nothing String
        end
    end;

-- A simple constructor type ends in its family. Parentheses or other
-- expression syntax make the declaration too ambiguous for this editor hint.
def completion_ctor_type (family : String) (tokens : List FxTok)
    : Maybe (Pair Bool (List FxTok)) :=
    (fix scan (remaining : List FxTok) (count : Nat)
        (arrow : Bool) (last_family : Bool)
        : Maybe (Pair Bool (List FxTok)) :=
      match remaining with
      | Nil => Nothing (Pair Bool (List FxTok))
      | Cons token rest =>
          match orb(fx_is_word token "|", fx_is_word token ";") with
          | True =>
              match andb(last_family,
                orb(eq_nat count (S Z), arrow)) with
              | True =>
                  Just(Pair Bool (List FxTok),
                    MkPair Bool (List FxTok)
                      (eq_nat count (S Z)) remaining)
              | False => Nothing (Pair Bool (List FxTok))
              end
          | False =>
              match fx_is_ident token with
              | True => scan rest (S count) arrow
                  (fx_is_word token family)
              | False =>
                  match andb(fx_is_word token "->",
                    notb(eq_nat count Z)) with
                  | True => scan rest (S count) True False
                  | False => Nothing (Pair Bool (List FxTok))
                  end
              end
          end
      end) tokens Z False False;

-- One shared arm budget also bounds duplicate-name comparisons.
def completion_ctor_arms (family : String) (tokens : List FxTok)
    : Maybe (List String) :=
    (fix scan (fuel : Nat) (remaining : List FxTok)
        (seen : List String) (names : List String)
        : Maybe (List String) :=
      match fuel with
      | Z => Nothing (List String)
      | S fuel2 =>
          match remaining with
          | Cons bar (Cons name (Cons colon after_colon)) =>
              match andb(fx_is_word bar "|",
                andb(fx_is_ident name, fx_is_word colon ":")) with
              | False => Nothing (List String)
              | True =>
                  match elem String str_eq (fx_tok_text name) seen with
                  | True => Nothing (List String)
                  | False =>
                      match completion_ctor_type family after_colon with
                      | Nothing => Nothing (List String)
                      | Just parsed =>
                          match parsed with
                          | MkPair nullary after_type =>
                              let names2 : List String :=
                                match nullary with
                                | True => Cons String (fx_tok_text name) names
                                | False => names
                                end in
                              match after_type with
                              | Nil => Nothing (List String)
                              | Cons separator _ =>
                                  match fx_is_word separator "|" with
                                  | True => scan fuel2 after_type
                                      (Cons String (fx_tok_text name) seen) names2
                                  | False =>
                                      match fx_is_word separator ";" with
                                      | True => Just(List String, reverse String names2)
                                      | False => Nothing (List String)
                                      end
                                  end
                              end
                          end
                      end
                  end
              end
          | _ => Nothing (List String)
          end
      end) fx_fuel_arms tokens (Nil String) (Nil String);

def completion_ctor_decl (family : String) (tokens : List FxTok)
    : Maybe (List String) :=
    match tokens with
    | Cons _ (Cons colon (Cons universe (Cons assign arms))) =>
        match andb(fx_is_word colon ":",
          andb(fx_is_word universe "Type", fx_is_word assign ":=")) with
        | True => completion_ctor_arms family arms
        | False => Nothing (List String)
        end
    | _ => Nothing (List String)
    end;

-- Count earlier same-named local families, including malformed declarations.
-- Duplicates and incomplete declarations produce no constructor suggestions.
def completion_ctor_matches (family : String) (line : Nat)
    (tokens : List FxTok) : List (Maybe (List String)) :=
    (fix scan (remaining : List FxTok) : List (Maybe (List String)) :=
      match remaining with
      | Nil => Nil (Maybe (List String))
      | Cons token rest =>
          match andb(fx_is_word token "inductive",
            andb(fx_tok_bol token, ltb_nat(fx_tok_line token, line))) with
          | False => scan rest
          | True =>
              match rest with
              | Nil => scan rest
              | Cons name _ =>
                  match andb(fx_is_ident name, fx_is_word name family) with
                  | False => scan rest
                  | True =>
                      Cons (Maybe (List String))
                        (completion_ctor_decl family rest) (scan rest)
                  end
              end
          end
      end) tokens;

def completion_local_ctors (tokens : List FxTok) (line : Nat) (family : String)
    : List String :=
    match completion_ctor_matches family line tokens with
    | Nil => Nil String
    | Cons candidate rest =>
        match rest with
        | Cons _ _ => Nil String
        | Nil =>
            match candidate with
            | Nothing => Nil String
            | Just names => names
            end
        end
    end;

def completion_ctor_item (family : String) (name : String) : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "label" (JStr name)
      , MkPair String Json "kind" (json_num 4)
      , MkPair String Json "detail"
          (JStr (str_concat "constructor of " family))
      , MkPair String Json "insertText" (JStr name) ] in
    JObj fields;

def completion_result (text : String) (line : Nat) (col : Nat)
    (syms : List Sym) : Json :=
    let source_line : String := nth String "" line (str_lines text) in
    let prefix : String := prefix_in_line source_line col in
    let ordinary : List Json := map Sym Json completion_item
      (filter Sym (fun (s : Sym) => completion_matches prefix s) syms) in
    let trimmed_source : String := str_trim source_line in
    let constructors : List Json :=
      match andb(str_starts(trimmed_source, "def"),
        is_ws (prim_string_byte_at trimmed_source 3)) with
      | False => Nil Json
      | True =>
          let token_line : Nat := S line in
          let tokens : List FxTok := fx_lex text in
          match completion_expected_family source_line token_line col prefix tokens with
          | Nothing => Nil Json
          | Just family =>
              map String Json (completion_ctor_item family)
                (filter String (fun (name : String) => str_starts(name, prefix))
                  (completion_local_ctors tokens token_line family))
          end
      end in
    JArr (append Json constructors ordinary);

def location_result (s : Sym) : Json :=
    let line : Nat := sub(decl_line (sym_decl s), S Z) in
    let fields : List (Pair String Json) :=
      [ MkPair String Json "uri" (JStr (path_to_uri (sym_path s)))
      , MkPair String Json "range" (lsp_range line Z line Z) ] in
    JObj fields;

-- SymbolInformation-shaped so document and workspace symbol share one item.
def document_symbol_item (s : Sym) : Json :=
    let d : Decl := sym_decl s in
    let fields : List (Pair String Json) :=
      [ MkPair String Json "name" (JStr (decl_name d))
      , MkPair String Json "kind" (json_num (completion_kind_num (decl_kind d)))
      , MkPair String Json "location" (location_result s) ] in
    JObj fields;

def document_symbol_here (path : String) (s : Sym) : Bool :=
    str_ends(sym_path s, path);

def document_symbol_result (path : String) (syms : List Sym) : Json :=
    JArr (map Sym Json document_symbol_item
      (filter Sym (fun (s : Sym) => document_symbol_here path s) syms));

def workspace_symbol_match (query : String) (s : Sym) : Bool :=
    str_contains(decl_name (sym_decl s), query);

def workspace_symbol_result (query : String) (syms : List Sym) : Json :=
    JArr (map Sym Json document_symbol_item
      (filter Sym (fun (s : Sym) => workspace_symbol_match query s) syms));

def prepare_rename_result (text : String) (line : Nat) (col : Nat) : Json :=
    let w : String := word_at text line col in
    match str_null w with
    | True => JNull
    | False =>
        let ln : String := nth String "" line (str_lines text) in
        let cs : List Nat := str_codes ln in
        let n : Nat := length Nat cs in
        let i : Nat := word_start(S n, cs, minNat col n) in
        let j : Nat := word_end (S n) cs i in
        lsp_range line i line j
    end;

-- Textual rename over identifier tokens in the open buffer only. Not
-- type-aware: a same-named token in another binding is rewritten too.
def rename_in_line_go : Nat -> String -> List Nat -> Nat -> String -> String
    -> String :=
  fix rename_in_line_go (fuel : Nat) (line : String) (cs : List Nat) (i : Nat)
      (from : String) (to : String) : String :=
    match fuel with
    | Z => ""
    | S fuel2 =>
        let n : Nat := length Nat cs in
        match ltb_nat i n with
        | False => ""
        | True =>
            match is_ident_cont (nth Nat ch_space i cs) with
            | False =>
                str_concat (str_slice line i (S Z))
                  (rename_in_line_go fuel2 line cs (S i) from to)
            | True =>
                let i0 : Nat := word_start (S n) cs i in
                let j : Nat := word_end (S n) cs i0 in
                let tok : String := str_slice line i0 (sub j i0) in
                let piece : String :=
                  match str_eq tok from with
                  | True => to
                  | False => tok
                  end in
                str_concat(piece, rename_in_line_go fuel2 line cs j from to)
            end
        end
    end;

def rename_in_line (line : String) (from : String) (to : String) : String :=
    match str_null from with
    | True => line
    | False =>
        let cs : List Nat := str_codes line in
        rename_in_line_go (S (length Nat cs)) line cs Z from to
    end;

-- str_lines retains a trailing empty segment, so joining preserves newlines.
def rename_text (text : String) (from : String) (to : String) : String :=
    str_join "\n"
      (map String String (fun (ln : String) => rename_in_line ln from to)
        (str_lines text));

-- Formatting and rename share the existing whole-document replacement range.
def format_edits (text : String) (out : String) : Json :=
    let lines : Nat := length(String, str_lines text) in
    let fields : List (Pair String Json) :=
      [ MkPair String Json "range" (lsp_range Z Z (S lines) Z)
      , MkPair String Json "newText" (JStr out) ] in
    let edits : List Json := [ JObj fields ] in
    JArr edits;

def rename_result (uri : String) (old_text : String) (new_text : String) : Json :=
    let changes : List (Pair String Json) :=
      [ MkPair String Json uri (format_edits old_text new_text) ] in
    let fields : List (Pair String Json) :=
      [ MkPair String Json "changes" (JObj changes) ] in
    JObj fields;

-- Capabilities: full document sync (1), hover, definition, completion,
-- formatting, document/workspace symbols, and textual rename.
def lsp_capabilities : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "textDocumentSync" (json_num (S Z))
      , MkPair String Json "hoverProvider" (JBool True)
      , MkPair String Json "definitionProvider" (JBool True)
      , MkPair String Json "completionProvider" (JBool True)
      , MkPair String Json "documentFormattingProvider" (JBool True)
      , MkPair String Json "documentSymbolProvider" (JBool True)
      , MkPair String Json "workspaceSymbolProvider" (JBool True)
      , MkPair String Json "renameProvider" (JBool True) ] in
    JObj fields;

def lsp_server_info : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "name" (JStr "ouro-lsp")
      , MkPair String Json "version" (JStr "0.1.0") ] in
    JObj fields;

def lsp_initialize_result : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "capabilities" lsp_capabilities
      , MkPair String Json "serverInfo" lsp_server_info ] in
    JObj fields;

-- Diagnostics come from the checker's own output, so the editor shows exactly
-- what `ouro1 check` reports. Two shapes matter:
--   OURO-LIST-001 error path/file.ouro:2:18 message
--   CHECK_FAIL: front end rejected the input
-- Anything else (hints, internal CErr traces) is not a positioned diagnostic
-- and is dropped rather than guessed at.
def diag_of (code : String) (sev : Json) (line : Nat) (col : Nat)
    (msg : String) : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "range" (lsp_range line col line (S col))
      , MkPair String Json "severity" sev
      , MkPair String Json "code" (JStr code)
      , MkPair String Json "source" (JStr "ouro1")
      , MkPair String Json "message" (JStr msg) ] in
    JObj fields;

def diag_sev_of (word : String) : Json :=
    match str_eq word "warning" with
    | True => JNum "2"
    | False => JNum "1"
    end;

-- A trailing "file:line:col" token. The path may itself contain colons, so the
-- last two fields win and the rest is the path.
inductive Loc : Type :=
  | MkLoc : String -> Nat -> Nat -> Loc;

-- Zero-based, saturating: the compiler counts from one.
def loc_parse (tok : String) : Maybe Loc :=
    let parts : List String := str_split_str tok ":" in
    let n : Nat := length String parts in
    match ltb_nat n 3 with
    | True => Nothing Loc
    | False =>
        let col : Maybe Nat := parse_nat (nth String "" (sub n 1) parts) in
        let line : Maybe Nat := parse_nat (nth String "" (sub n 2) parts) in
        let path : String :=
          str_join(":", take String (sub n 2) parts) in
        match line with
        | Nothing => Nothing Loc
        | Just l =>
            match col with
            | Nothing => Nothing Loc
            | Just c => Just(Loc, MkLoc(path, sub(l, S Z), sub(c, S Z)))
            end
        end
    end;

def diag_of_ouro_line (line : String) : Maybe (Pair Loc Json) :=
    let ws : List String := str_words line in
    match ltb_nat(length String ws, 3) with
    | True => Nothing (Pair Loc Json)
    | False =>
        match loc_parse (nth String "" 2 ws) with
        | Nothing => Nothing (Pair Loc Json)
        | Just l =>
            match l with
            | MkLoc _ source_line col =>
                Just (Pair Loc Json)
                  (MkPair Loc Json l
                    (diag_of (nth String "" Z ws)
                      (diag_sev_of (nth String "" (S Z) ws))
                      source_line col (str_join(" ", drop String 3 ws))))
            end
        end
    end;

def diag_of_fail_line (line : String) : Maybe (Pair Loc Json) :=
    match str_strip_prefix line "CHECK_FAIL:" with
    | Nothing => Nothing (Pair Loc Json)
    | Just msg =>
        Just (Pair Loc Json)
          (MkPair Loc Json (MkLoc "" Z Z)
            (diag_of "CHECK_FAIL" (JNum "1") Z Z (str_trim msg)))
    end;

def diag_of_line (line : String) : Maybe (Pair Loc Json) :=
    match str_starts line "OURO-" with
    | True => diag_of_ouro_line line
    | False => diag_of_fail_line (str_trim line)
    end;

-- Keep only what belongs to the file being checked: LSP publishes per URI, and
-- a diagnostic in an imported module is not attached to this document. An
-- unpositioned CHECK_FAIL has no path and belongs to the file that was checked.
-- Failed checks with no remaining local diagnostic still publish CHECK_FAIL.
def diag_here (path : String) (l : Loc) : Bool :=
    match l with
    | MkLoc p _ _ =>
        match str_null p with
        | True => True
        | False => str_ends path p
        end
    end;

def diag_keep (path : String) (m : Maybe (Pair Loc Json)) : List Json :=
    match m with
    | Nothing => Nil Json
    | Just p =>
        match p with
        | MkPair l j =>
            match diag_here path l with
            | True => ([j] : List Json)
            | False => Nil Json
            end
        end
    end;

def diags_of_output (path : String) (out : String) : List Json :=
    concat_map String Json
      (fun (line : String) => diag_keep(path, diag_of_line line))
      (str_lines out);

def publish_params (uri : String) (ds : List Json) : Json :=
    let fields : List (Pair String Json) :=
      [ MkPair String Json "uri" (JStr uri)
      , MkPair String Json "diagnostics" (JArr ds) ] in
    JObj fields;

-- Keep path spans so unsaved-buffer rewriting preserves groups, aliases,
-- comments and every non-import byte. The lexer keeps quoted text opaque.
def lsp_import_tokens (text : String) : List FxTok :=
    (fix scan (tokens : List FxTok) (path_expected : Bool) (comma_expected : Bool)
        : List FxTok :=
      match tokens with
      | Nil => Nil FxTok
      | Cons token rest =>
          match andb(path_expected, fx_is_kind token fx_k_str) with
          | True => Cons FxTok token (scan rest False True)
          | False => scan rest
              (orb (fx_has_code token fx_c_import)
                (andb(comma_expected, fx_has_code token fx_c_comma))) False
          end
      end) (fx_lex text) False False;

-- Import paths use the compiler's braced Unicode scalar decoder.
def lsp_import_decode : List Nat -> List Nat -> Maybe String :=
  fun (input : List Nat) (initial : List Nat) =>
    (fix decode (fuel : Nat) (codes : List Nat) (acc : List Nat)
        : Maybe String :=
      match fuel with
      | Z => Nothing String
      | S remaining =>
          match codes with
          | Nil => Nothing String
          | Cons code rest =>
              match eq_nat code ch_quote with
              | True => match rest with
                  | Nil => Just(String, str_of_codes (reverse Nat acc))
                  | Cons _ _ => Nothing String
                  end
              | False => match eq_nat code ch_bslash with
                  | False => decode(remaining, rest, Cons Nat code acc)
                  | True => match rest with
                      | Nil => Nothing String
                      | Cons escaped after =>
                          let braced : Bool := match after with
                            | Nil => False
                            | Cons brace _ => eq_nat brace 123
                            end in
                          match andb(eq_nat escaped 117, braced) with
                          | True => match source_unicode_braced after with
                            | Nothing => Nothing String
                            | Just parsed => match parsed with
                              | MkPair bytes tail => decode(remaining, tail,
                                  append Nat (reverse Nat bytes) acc)
                              end
                            end
                          | False =>
                              match lookup Nat Nat eq_nat escaped
                                [ MkPair Nat Nat 110 ch_lf, MkPair Nat Nat 116 ch_tab
                                , MkPair Nat Nat 114 ch_cr, MkPair Nat Nat ch_quote ch_quote
                                , MkPair Nat Nat ch_bslash ch_bslash ] with
                              | Just decoded => decode(remaining, after,
                                  Cons Nat decoded acc)
                              | Nothing => decode(remaining, after,
                                  Cons Nat escaped (Cons Nat ch_bslash acc))
                              end
                          end
                      end
                  end
              end
          end
      end) (S (length Nat input)) input initial;

def lsp_import_spelling (token : FxTok) : Maybe String :=
    let spelling : List Nat := str_codes (fx_tok_text token) in
    match source_is_raw_start spelling with
    | True => match source_take_raw spelling with
      | Nothing => Nothing String
      | Just parsed => match parsed with
        | MkPair bytes tail => match tail with
          | Nil => Just(String, str_of_codes bytes)
          | Cons _ _ => Nothing String
          end
        end
      end
    | False => match spelling with
      | Nil => Nothing String
      | Cons quote rest =>
          match eq_nat quote ch_quote with
          | False => Nothing String
          | True => lsp_import_decode(rest, Nil Nat)
          end
      end
    end;

def imports_of (text : String) : List String :=
    concat_map FxTok String
      (fun (token : FxTok) => match lsp_import_spelling token with
        | Nothing => Nil String
        | Just path => [path]
        end) (lsp_import_tokens text);
