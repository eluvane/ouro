-- Command entry for the shared bounded import collector.

-- @entry main

import "../std/args.ouro";
import "collect_core.ouro";

def print_units : List String -> IO Unit :=
  io_foreach String println;

def main : IO Unit :=
    do let! argv := prim_argv;
       match args_positional (args_of_argv argv) with
       | Nil =>
           do eprintln "usage: ouro-collect FILE.ouro";
              exit 2
       | Cons file _ =>
           do let! r := collect_walk collect_fuel (Nil String) (Nil String)
                         file;
              match r with
              | ColErr e => do eprintln e; exit (S Z)
              | ColOk us => do print_units us; exit Z
              end
       end
