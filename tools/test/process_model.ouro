-- Pure native test subprocess policy. Infrastructure errors are never exits.
import "../native_sibling_model.ouro",
  "../../std/fs.ouro";

inductive NativeTestProcessError : Type :=
  | NativeTestSiblingError : NativeSiblingError -> NativeTestProcessError
  | NativeTestCaptureError : String -> ProcessCaptureError -> NativeTestProcessError
  | NativeTestInputError : String -> FsError -> NativeTestProcessError;

def test_process_error_message (error : NativeTestProcessError) : String :=
    str_concat "TEST_PROCESS_ERROR " (match error with
    | NativeTestSiblingError cause => native_sibling_error_message cause
    | NativeTestCaptureError program cause => str_cat3 program ": " (process_capture_error_message cause)
    | NativeTestInputError path cause => str_cat3 path ": " (fs_error_message cause)
    end);

-- Provisional: one observed full check took 1400 seconds. Runtime fixtures
-- previously had no deadline; the 300-second limit is new, pending measurement.
def test_compile_limits : ProcessCaptureLimits := native_sibling_limits (mul(mul 18 100, mul 10 100));
def test_runtime_limits : ProcessCaptureLimits := native_sibling_limits (mul(300, mul 10 100));
-- The recursive user runner checks, builds and runs one fixture in sequence.
def test_nested_limits : ProcessCaptureLimits := native_sibling_limits (mul(mul 40 100, mul 10 100));

def test_check_arguments (path : String) (suite : Bool) : List String :=
    match suite with
    | False => ["check", path]
    | True => ["check", path, "999999"]
    end;

def test_build_arguments (path : String) (bin : String) : List String :=
    ["build", path, "--out", bin];

def test_binary_path (out : String) (name : String) : String :=
    fs_child(out, str_concat name ".exe");

def test_process_output (outcome : Either NativeTestProcessError ProcResult) : String :=
    match outcome with
    | Left error => str_concat(test_process_error_message error, "\n")
    | Right result => str_concat(proc_stdout result, proc_stderr result)
    end;

def test_process_exit_is (outcome : Either NativeTestProcessError ProcResult) (expected : Nat) : Bool :=
    match outcome with
    | Left _ => False
    | Right result => eq_nat(proc_code result, expected)
    end;

def test_process_rejected (result : ProcResult) (diagnostic : String) : Bool :=
    let output : String := str_concat(proc_stdout result, proc_stderr result) in
    andb (eq_nat(proc_code result, 1))
      (andb(notb (str_contains output "CHECK_OK"), str_contains output diagnostic));

def test_discovery_pruned (path : String) : Bool :=
    any String (fun (part : String) => elem String str_eq part
      (["_build", "_cache", "_opam", "_tools", ".git", "bad", "future", "fixtures", "bench"] : List String))
      (str_split(path_from_host path, 47));

def test_discovery_selected (path : String) : Bool :=
    andb(str_ends path "_test.ouro", notb (test_discovery_pruned path));
