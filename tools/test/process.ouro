-- Fixed native checker/build sibling and exact captured fixture stdin.
import "process_model.ouro";
import "../native_sibling.ouro";

def test_run_sibling (limits : ProcessCaptureLimits) (name : String) (arguments : List String)
    : IO (Either NativeTestProcessError ProcResult) :=
    do let! result := native_sibling_run limits name arguments;
       io_pure (Either NativeTestProcessError ProcResult) (match result with
       | Left error => Left NativeTestProcessError ProcResult (NativeTestSiblingError error)
       | Right process => Right NativeTestProcessError ProcResult process
       end)

def test_check_process (path : String) (suite : Bool)
    : IO (Either NativeTestProcessError ProcResult) :=
    test_run_sibling test_compile_limits "coil.exe" (test_check_arguments path suite)

def test_build_process (path : String) (bin : String)
    : IO (Either NativeTestProcessError ProcResult) :=
    test_run_sibling test_compile_limits "coil.exe" (test_build_arguments path bin)

def test_run_process (limits : ProcessCaptureLimits) (bin : String) (arguments : List String) (input : String)
    : IO (Either NativeTestProcessError ProcResult) :=
    do let! result := process_run_spec_captured_bounded_with_input limits (command_spec bin arguments) input;
       io_pure (Either NativeTestProcessError ProcResult) (match result with
       | Left error => Left NativeTestProcessError ProcResult (NativeTestCaptureError bin error)
       | Right captured => Right NativeTestProcessError ProcResult (process_capture_proc_result captured)
       end)

-- The retained recursive row exercises this loaded standalone runner.
def test_run_self (limits : ProcessCaptureLimits) (arguments : List String)
    : IO (Either NativeTestProcessError ProcResult) :=
    do let! located := executable_path_checked;
       match located with
       | Left error => io_pure (Either NativeTestProcessError ProcResult)
           (Left NativeTestProcessError ProcResult
             (NativeTestSiblingError (NativeSiblingImageError error)))
       | Right image => test_run_process limits image arguments ""
       end

def test_run_input_file (bin : String) (path : String)
    : IO (Either NativeTestProcessError ProcResult) :=
    do let! input := fs_read_checked path;
       match input with
       | Left error => io_pure (Either NativeTestProcessError ProcResult)
           (Left NativeTestProcessError ProcResult (NativeTestInputError path error))
       | Right bytes => test_run_process test_runtime_limits bin [] bytes
       end
