-- Repository-owned native test-suite case data shared by ouro-test suite modes.

import "../../std/stringx.ouro", "../quality/order.ouro", "../../std/collections.ouro";

inductive SuiteGolden : Type :=
  | SuiteGoldenRequired : SuiteGolden
  | SuiteGoldenOptional : SuiteGolden
  | SuiteGoldenNone : SuiteGolden;

inductive SuiteFixture : Type :=
  | MkSuiteFixture : String -> String -> Nat -> SuiteGolden -> SuiteFixture;

def suite_fixture_name (c : SuiteFixture) : String :=
    match c with | MkSuiteFixture name _ _ _ => name end;

def suite_fixture_path (c : SuiteFixture) : String :=
    match c with | MkSuiteFixture _ path _ _ => path end;

def suite_fixture_exit (c : SuiteFixture) : Nat :=
    match c with | MkSuiteFixture _ _ code _ => code end;

def suite_fixture_golden (c : SuiteFixture) : SuiteGolden :=
    match c with | MkSuiteFixture _ _ _ golden => golden end;

-- Keep the resource-heavy source-spans fixture in its own process. The other
-- fixtures retain inventory order across fifteen round-robin shards.
def compiler_suite_regular (fixtures : List SuiteFixture) : List SuiteFixture :=
    take(SuiteFixture, sub(length SuiteFixture fixtures, 1), fixtures);

def compiler_suite_isolated (fixtures : List SuiteFixture) : List SuiteFixture :=
    drop(SuiteFixture, sub(length SuiteFixture fixtures, 1), fixtures);

def compiler_suite_shard_go (wanted : Nat) : List SuiteFixture -> Nat -> List SuiteFixture :=
  fix compiler_suite_shard_go (fixtures : List SuiteFixture) (index : Nat) : List SuiteFixture :=
    match fixtures with
    | Nil => Nil SuiteFixture
    | Cons fixture rest =>
        let next : Nat := match eq_nat index 14 with | True => Z | False => S index end in
        let remaining : List SuiteFixture := compiler_suite_shard_go rest next in
        if eq_nat wanted index then Cons SuiteFixture fixture remaining else remaining
    end;

def compiler_suite_shards (fixtures : List SuiteFixture) : List (List SuiteFixture) :=
    let empty_shards : List (List SuiteFixture) := replicate (List SuiteFixture) (Nil SuiteFixture) 15 in
    let regular : List (List SuiteFixture) :=
      (fix distribute (remaining : List SuiteFixture) (visited : List (List SuiteFixture))
        (pending : List (List SuiteFixture)) : List (List SuiteFixture) :=
        match remaining with
        | Nil => append (List SuiteFixture) (reverse_lin (List SuiteFixture) visited) pending
        | Cons fixture rest => match pending with
          | Nil => reverse_lin (List SuiteFixture) visited
          | Cons shard more =>
              let updated : List (List SuiteFixture) :=
                Cons (List SuiteFixture) (Cons SuiteFixture fixture shard) visited in
              match more with
              | Nil => distribute rest (Nil (List SuiteFixture)) (reverse_lin (List SuiteFixture) updated)
              | Cons _ _ => distribute rest updated more
              end
          end
        end) (compiler_suite_regular fixtures) (Nil (List SuiteFixture)) empty_shards in
    append (List SuiteFixture) (map (List SuiteFixture) (List SuiteFixture) (reverse_lin SuiteFixture) regular)
      [compiler_suite_isolated fixtures];

-- The C host's string order stops at NUL. Break ties using the full bytes.
private def compiler_suite_key_le (left : String) (right : String) : Bool :=
    if str_le left right then
      if str_le right left then
        if str_eq left right then True else codes_le (str_codes left) (str_codes right)
      else True
    else False;

private def compiler_suite_sorted_keys_unique : List String -> Bool :=
    fix unique (keys : List String) : Bool :=
      match keys with
      | Nil => True
      | Cons first rest => match rest with
        | Nil => True
        | Cons second _ => if str_eq first second then False else unique rest
        end
      end;

private def compiler_suite_regular_balanced (lengths : List Nat) : Bool :=
    match lengths with
    | Nil => False
    | Cons first rest =>
        let smallest : Nat := minimum_nat first rest in
        if eq_nat smallest Z then False else leb_nat(maximum_nat first rest, S smallest)
    end;

def compiler_suite_partition_valid (fixtures : List SuiteFixture)
    (shards : List (List SuiteFixture)) : Bool :=
    let paths : List String := quality_sort String compiler_suite_key_le
      (map SuiteFixture String suite_fixture_path fixtures) in
    let names : List String := quality_sort String compiler_suite_key_le
      (map SuiteFixture String suite_fixture_name fixtures) in
    let selected : List String := quality_sort String compiler_suite_key_le
      (concat_map (List SuiteFixture) String
        (fun (items : List SuiteFixture) => map SuiteFixture String suite_fixture_path items) shards) in
    let shard_lengths : List Nat := map (List SuiteFixture) Nat
      (length SuiteFixture) shards in
    let regular_lengths : List Nat := take(Nat, 15, shard_lengths) in
    let isolated : List SuiteFixture := nth (List SuiteFixture) (Nil SuiteFixture) 15 shards in
    let isolated_valid : Bool := match isolated with
      | Cons fixture rest => andb (str_eq(suite_fixture_name fixture, "source_spans"))
          (nullb SuiteFixture rest)
      | Nil => False
      end in
    andb (notb (nullb SuiteFixture fixtures))
      (andb (eq_nat(length(List SuiteFixture, shards), 16))
        (andb (compiler_suite_sorted_keys_unique names)
          (andb (compiler_suite_sorted_keys_unique paths)
            (andb (list_eq String str_eq paths selected)
              (andb isolated_valid
                (compiler_suite_regular_balanced regular_lengths))))));

private def compiler_suite_select (shard : String) (fixtures : List SuiteFixture)
    (numbered : Nat -> Maybe (List SuiteFixture))
    : Maybe (List SuiteFixture) :=
    if str_eq shard "all" then Just(List SuiteFixture, fixtures)
    else
      (fix select (names : List String) (index : Nat) : Maybe (List SuiteFixture) :=
        match names with
        | Nil => Nothing (List SuiteFixture)
        | Cons name rest => if str_eq shard name then numbered index else select(rest, S index)
        end) ["1/16", "2/16", "3/16", "4/16", "5/16", "6/16", "7/16", "8/16", "9/16", "10/16", "11/16", "12/16", "13/16", "14/16", "15/16", "16/16"] Z;

def compiler_suite_selection (shard : String) (fixtures : List SuiteFixture)
    : Maybe (List SuiteFixture) :=
    compiler_suite_select shard fixtures (fun (index : Nat) => Just(List SuiteFixture,
      (if eq_nat index 15 then compiler_suite_isolated fixtures
       else compiler_suite_shard_go index (compiler_suite_regular fixtures) Z)));

def compiler_suite_selection_from_partition (shard : String) (fixtures : List SuiteFixture)
    (partition : List (List SuiteFixture)) : Maybe (List SuiteFixture) :=
    compiler_suite_select shard fixtures
      (fun (index : Nat) => nth_maybe (List SuiteFixture) index partition);

def compiler_suite_shard_option_unique (argv : List String) : Bool :=
    leb_nat (count_if String (fun (word : String) =>
      orb(str_eq word "--shard", str_starts word "--shard=")) (tail String argv)) 1;

def runtime_io_suite_fixtures (root : String) : List SuiteFixture :=
    ([ MkSuiteFixture "io_prims" (str_concat root "/io_prims.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "strings" (str_concat root "/strings.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "data" (str_concat root "/data.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "crypto" (str_concat root "/crypto.ouro") Z SuiteGoldenRequired
     ] : List SuiteFixture);

def user_test_suite_fixtures (root : String) : List SuiteFixture :=
    ([ MkSuiteFixture "helpers" (str_concat root "/helpers.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "success" (str_concat root "/success.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "selected_declaration" (str_concat root "/selected_declaration.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "test_demo" "samples/examples/test_demo.ouro" Z SuiteGoldenOptional
     , MkSuiteFixture("failure", str_concat root "/failure.ouro", S Z, SuiteGoldenRequired)
     , MkSuiteFixture "repo_gate_recursion" "tests/repo_gate_recursion_tests.ouro" Z SuiteGoldenNone
     , MkSuiteFixture "repo_gate_boundary" "tests/repo_gate_boundary_tests.ouro" Z SuiteGoldenNone
     , MkSuiteFixture "pkg_scanners" "tests/pkg_scanner_tests.ouro" Z SuiteGoldenNone
     ] : List SuiteFixture);

