-- Repository-owned native test-suite case data shared by ouro-test suite modes.

import "../../std/stringx.ouro";

inductive SuiteGolden : Type :=
  | SuiteGoldenRequired : SuiteGolden
  | SuiteGoldenOptional : SuiteGolden
  | SuiteGoldenNone : SuiteGolden;

inductive SuiteFixture : Type :=
  | MkSuiteFixture : String -> String -> Nat -> SuiteGolden -> SuiteFixture;

def suite_fixture_name (c : SuiteFixture) : String :=
    match c with | MkSuiteFixture name _ _ _ => name end;

def suite_fixture_path (c : SuiteFixture) : String :=
    match c with | MkSuiteFixture _ path _ _ => path end;

def suite_fixture_exit (c : SuiteFixture) : Nat :=
    match c with | MkSuiteFixture _ _ code _ => code end;

def suite_fixture_golden (c : SuiteFixture) : SuiteGolden :=
    match c with | MkSuiteFixture _ _ _ golden => golden end;

-- Round-robin selection retains inventory order within each of eight shards.
def compiler_suite_shard_go (wanted : Nat) : List SuiteFixture -> Nat -> List SuiteFixture :=
  fix compiler_suite_shard_go (fixtures : List SuiteFixture) (index : Nat) : List SuiteFixture :=
    match fixtures with
    | Nil => Nil SuiteFixture
    | Cons fixture rest =>
        let next : Nat := match eq_nat index 7 with | True => Z | False => S index end in
        let remaining : List SuiteFixture := compiler_suite_shard_go rest next in
        match eq_nat wanted index with
        | True => Cons SuiteFixture fixture remaining
        | False => remaining
        end
    end;

def compiler_suite_shards (fixtures : List SuiteFixture) : List (List SuiteFixture) :=
    map Nat (List SuiteFixture) (fun (index : Nat) =>
      compiler_suite_shard_go index fixtures Z) [0, 1, 2, 3, 4, 5, 6, 7];

def compiler_suite_partition_valid (fixtures : List SuiteFixture)
    (shards : List (List SuiteFixture)) : Bool :=
    let paths : List String := map SuiteFixture String suite_fixture_path fixtures in
    let names : List String := map SuiteFixture String suite_fixture_name fixtures in
    let selected : List String := concat_map (List SuiteFixture) String
      (fun (items : List SuiteFixture) => map SuiteFixture String suite_fixture_path items) shards in
    let path_count : Nat := length String paths in
    let shard_lengths : List Nat := map (List SuiteFixture) Nat
      (length SuiteFixture) shards in
    andb (notb (nullb SuiteFixture fixtures))
      (andb (eq_nat (length (List SuiteFixture) shards) 8)
        (andb (eq_nat (length String names) (length String (nub String str_eq names)))
          (andb (eq_nat path_count (length String selected))
            (andb (eq_nat path_count (length String (nub String str_eq paths)))
              (andb (all String (fun (path : String) =>
                eq_nat (count_if String (str_eq path) selected) 1) paths)
                (all Nat (fun (left_len : Nat) =>
                  all Nat (fun (right_len : Nat) =>
                    leb_nat left_len (S right_len)) shard_lengths) shard_lengths))))));

def compiler_suite_selection (shard : String) (fixtures : List SuiteFixture)
    : Maybe (List SuiteFixture) :=
    match str_eq shard "all" with
    | True => Just (List SuiteFixture) fixtures
    | False =>
        (fix select (names : List String) (index : Nat) : Maybe (List SuiteFixture) :=
          match names with
          | Nil => Nothing (List SuiteFixture)
          | Cons name rest => match str_eq shard name with
            | True => Just (List SuiteFixture) (compiler_suite_shard_go index fixtures Z)
            | False => select rest (S index)
            end
          end) ["1/8", "2/8", "3/8", "4/8", "5/8", "6/8", "7/8", "8/8"] Z
    end;

def compiler_suite_shard_option_unique (argv : List String) : Bool :=
    leb_nat (count_if String (fun (word : String) =>
      orb (str_eq word "--shard") (str_starts word "--shard=")) (tail String argv)) 1;

def runtime_io_suite_fixtures (root : String) : List SuiteFixture :=
    ([ MkSuiteFixture "io_prims" (str_concat root "/io_prims.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "strings" (str_concat root "/strings.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "data" (str_concat root "/data.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "crypto" (str_concat root "/crypto.ouro") Z SuiteGoldenRequired
     ] : List SuiteFixture);

def user_test_suite_fixtures (root : String) : List SuiteFixture :=
    ([ MkSuiteFixture "helpers" (str_concat root "/helpers.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "success" (str_concat root "/success.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "selected_declaration" (str_concat root "/selected_declaration.ouro") Z SuiteGoldenRequired
     , MkSuiteFixture "test_demo" "samples/examples/test_demo.ouro" Z SuiteGoldenOptional
     , MkSuiteFixture "failure" (str_concat root "/failure.ouro") (S Z) SuiteGoldenRequired
     , MkSuiteFixture "repo_gate_recursion" "tests/repo_gate_recursion_tests.ouro" Z SuiteGoldenNone
     , MkSuiteFixture "repo_gate_boundary" "tests/repo_gate_boundary_tests.ouro" Z SuiteGoldenNone
     , MkSuiteFixture "pkg_scanners" "tests/pkg_scanner_tests.ouro" Z SuiteGoldenNone
     ] : List SuiteFixture);

