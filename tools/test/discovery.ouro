-- User test discovery: explicit files stay literal; directories select tests.
import "process_model.ouro";

def test_discover_walk : Nat -> List String -> List String -> IO (Either FsError (List String)) :=
  fix walk (fuel : Nat) (todo : List String) (found : List String) : IO (Either FsError (List String)) :=
    match todo with
    | Nil => io_pure (Either FsError (List String)) (Right FsError (List String) (reverse String found))
    | Cons path rest => match fuel with
      | Z => io_pure (Either FsError (List String))
          (Left FsError (List String) (FsOperationFailed "test discovery inventory limit" path))
      | S left => match test_discovery_pruned path with
        | True => walk left rest found
        | False =>
            do let! directory := fs_is_dir path;
               match directory with
               | True =>
                   do let! listed := fs_list_checked path;
                      match listed with
                      | Left error => io_pure (Either FsError (List String)) (Left FsError (List String) error)
                      | Right names => walk left
                          (append String (map String String (fs_child path) (sort_insert String str_le names)) rest) found
                      end
               | False =>
                   do let! checked := fs_check_file path;
                      match checked with
                      | Left error => io_pure (Either FsError (List String)) (Left FsError (List String) error)
                      | Right _ => walk left rest (match test_discovery_selected path with
                        | True => Cons String path found | False => found end)
                      end
               end
        end
      end
    end;

def test_discover_inputs : List String -> IO (Either FsError (List String)) :=
  fix discover (paths : List String) : IO (Either FsError (List String)) :=
    match paths with
    | Nil => io_pure (Either FsError (List String)) (Right FsError (List String) [])
    | Cons path rest =>
        do let! directory := fs_is_dir path;
           let! selected := match directory with
             | True => test_discover_walk fs_walk_fuel [path] []
             | False => io_pure (Either FsError (List String)) (Right FsError (List String) [path])
             end;
           match selected with
           | Left error => io_pure (Either FsError (List String)) (Left FsError (List String) error)
           | Right files =>
               do let! later := discover rest;
                  io_pure (Either FsError (List String)) (match later with
                  | Left error => Left FsError (List String) error
                  | Right tail => Right FsError (List String) (append String files tail)
                  end)
           end
    end;

def test_discover (paths : List String) : IO (Either FsError (List String)) :=
    test_discover_inputs (match paths with | Nil => ["."] | Cons _ _ => paths end)
