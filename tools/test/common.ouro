-- Shared driver and text helpers for the user and repository test modes.

import "../../std/fs.ouro",
  "process.ouro";

def golden_of (p : String) : String :=
    fs_child(path_dirname p, str_concat(path_stem p, ".golden"));

def check_ok (out : String) (err : String) : Bool :=
    str_contains(str_concat out err, "CHECK_OK");

def check_result_ok (result : ProcResult) : Bool :=
    native_sibling_check_ok result;

def strip_cr (s : String) : String :=
    str_replace s "\r" "";

def load_out : IO String :=
    do let! m := env_get "OURO_TEST_OUT";
       io_pure(String, fromMaybe String "_build/ouro_test" m)
