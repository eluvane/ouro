-- Authoritative repository sample-suite inventory. Keep execution policy explicit.

import "suites.ouro";

inductive SampleCase : Type :=
  | MkSampleCase : String -> String -> Bool -> String -> Bool ->
      Maybe String -> Nat -> Maybe String -> String -> SampleCase;


def sample_case_slug (c : SampleCase) : String :=
    match c with | MkSampleCase slug _ _ _ _ _ _ _ _ => slug end;


def sample_case_path (c : SampleCase) : String :=
    match c with | MkSampleCase _ path _ _ _ _ _ _ _ => path end;


def sample_case_accept (c : SampleCase) : Bool :=
    match c with | MkSampleCase _ _ accept _ _ _ _ _ _ => accept end;


def sample_case_diagnostic (c : SampleCase) : String :=
    match c with | MkSampleCase _ _ _ diagnostic _ _ _ _ _ => diagnostic end;


def sample_case_run (c : SampleCase) : Bool :=
    match c with | MkSampleCase _ _ _ _ run _ _ _ _ => run end;


def sample_case_stdin (c : SampleCase) : Maybe String :=
    match c with | MkSampleCase _ _ _ _ _ stdin _ _ _ => stdin end;


def sample_case_exit (c : SampleCase) : Nat :=
    match c with | MkSampleCase _ _ _ _ _ _ code _ _ => code end;


def sample_case_golden (c : SampleCase) : Maybe String :=
    match c with | MkSampleCase _ _ _ _ _ _ _ golden _ => golden end;


def sample_case_success_suffix (c : SampleCase) : String :=
    match c with | MkSampleCase _ _ _ _ _ _ _ _ suffix => suffix end;


-- Alternate native builds and check-only cases independently. Both shards keep
-- inventory order, and new cases automatically belong to exactly one shard.
def sample_suite_alternate (first : Bool)
    : List SampleCase -> Bool -> Bool -> List SampleCase :=
  fix sample_suite_alternate (cases : List SampleCase) (run_turn : Bool)
      (check_turn : Bool) : List SampleCase :=
    match cases with
    | Nil => Nil SampleCase
    | Cons c rest =>
        let runnable : Bool := sample_case_run c in
        let turn : Bool := match runnable with
          | True => run_turn | False => check_turn end in
        let selected : Bool := match first with
          | True => turn | False => notb turn end in
        let next_run : Bool := match runnable with
          | True => notb run_turn | False => run_turn end in
        let next_check : Bool := match runnable with
          | True => check_turn | False => notb check_turn end in
        let remaining : List SampleCase :=
          sample_suite_alternate rest next_run next_check in
        match selected with
        | True => Cons SampleCase c remaining
        | False => remaining
        end
    end;


