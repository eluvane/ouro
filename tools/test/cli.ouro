-- Everyday ouro-test CLI: known names, complete values, and empty discovery.

import "../../std/args.ouro";
import "../../std/map.ouro";

def test_cli_bools : List String :=
    ([ "help", "list", "suite-probe-failure" ] : List String);

def test_no_tests_found : String :=
    "test: no tests found";

def test_cli_option_names (args : Args) : List String :=
    map_keys String (args_opts args);

def test_cli_options_valid (args : Args) (names : List String) : Bool :=
    all String (fun (name : String) =>
      andb (str_set_mem name names)
        (notb (str_null (args_opt_or args name ""))))
      (test_cli_option_names args);

def test_cli_flags_valid (args : Args) (names : List String) : Bool :=
    all String (fun (flag : String) => str_set_mem flag names) (args_flags args);

def test_cli_known (raw : List String) (args : Args) (flags : List String)
    (options : List String) (allow_pos : Bool) : Bool :=
    andb (args_argv_options_complete test_cli_bools raw)
      (andb (test_cli_flags_valid args flags)
        (andb (test_cli_options_valid args options)
          (orb allow_pos (nullb String (args_positional args)))));

def test_user_cli_valid (raw : List String) (args : Args) : Bool :=
    test_cli_known raw args ([ "help" ] : List String)
      ([ "out" ] : List String) True;

def test_native_suite_cli_valid (raw : List String) (args : Args)
    (options : List String) : Bool :=
    test_cli_known raw args
      ([ "list", "suite-probe-failure" ] : List String) options False;

def test_user_suite_cli_valid (raw : List String) (args : Args) : Bool :=
    test_native_suite_cli_valid raw args
      ([ "native-suite", "out", "fixtures" ] : List String);

def test_resolve_out (args : Args) (fallback : String) : String :=
    args_opt_or args "out" fallback;
