-- Line harvest and tiny source rewrites. Lexer already imports std/char;
-- reuse those codes instead of redeclaring them in this flat cone.
--
-- Lines are split and comment-stripped by host string primitives; only the
-- short keyword prefix of a line is walked as a code list. The heap is
-- process-lifetime, so a per-character Ouro loop over every file of an import
-- cone costs gigabytes before the first warning prints.

import "../std/io.ouro",
  "../std/listx.ouro",
  "../compiler/lexer.ouro",
  "quality/import_scan.ouro";

def ncodes (s : String) : List Nat := prim_string_to_char_codes s;
def nstr (cs : List Nat) : String := prim_string_of_char_codes cs;

def nat1 (c : Nat) : List Nat := singleton Nat c;

def comment_open : String := "--";
def module_kw_text : String := "module";

def src_lines (src : String) : List String := prim_string_split src ch_lf;

-- Declaration harvesting scans only line heads, so it stops at the first
-- `--` even inside a string literal.
def strip_comment (line : String) : String :=
    match prim_string_index line comment_open with
    | Nothing => line
    | Just k => prim_string_slice line Z k
    end;

def line_codes (line : String) : List Nat := ncodes (strip_comment line);

-- Each harvest pass needs only the suffix. Building a whitespace prefix allocates on every line.
def skip_ws_n (xs : List Nat) : List Nat :=
  (fix go (remaining : List Nat) : List Nat :=
    match remaining with
    | Nil => remaining
    | Cons c rest =>
      if source_is_ws c then go rest else remaining
    end) xs;

def take_ident_n (xs : List Nat) : Pair (List Nat) (List Nat) :=
    match xs with
    | Nil => MkPair(List Nat, List Nat, Nil Nat, Nil Nat)
    | Cons c _ =>
        if source_is_ident_start c then span Nat source_is_ident_char xs
        else MkPair(List Nat, List Nat, Nil Nat, xs)
    end;

def starts_n (pat : List Nat) (xs : List Nat) : Bool :=
  source_starts pat xs;

def drop_n (pat : List Nat) (xs : List Nat) : List Nat :=
  source_drop_prefix pat xs;

def kw_private_n : List Nat := [112, 114, 105, 118, 97, 116, 101];

def declaration_line (text : List Nat) : List Nat :=
  if source_word_at kw_private_n text then skip_ws_n (drop_n kw_private_n text) else text;

def public_declaration_line (text : List Nat) (pending : Bool)
    : Pair Bool (Pair Bool (List Nat)) :=
  let line : List Nat := skip_ws_n text in
  let prefixed : Bool := source_word_at kw_private_n line in
  let body : List Nat := if prefixed then skip_ws_n (drop_n kw_private_n line) else line in
  let hidden : Bool := orb(pending, prefixed) in
  match body with
  | Nil => MkPair Bool (Pair Bool (List Nat)) hidden
      (MkPair Bool (List Nat) hidden (Nil Nat))
  | Cons _ _ => if starts_n [45, 45] body then
      MkPair Bool (Pair Bool (List Nat)) hidden
        (MkPair Bool (List Nat) hidden (Nil Nat))
    else
      MkPair Bool (Pair Bool (List Nat)) False
        (MkPair Bool (List Nat) hidden body)
  end;

-- Stops at the first hit; std elem folds the whole list through a strict orb.
def mem_str (x : String) : List String -> Bool :=
    any String (prim_string_eq x);

-- Dedup insert: linear per call, so only for short lists such as paths.
-- Harvested names are consed without dedup; every consumer tests membership.
def snoc_str (xs : List String) (x : String) : List String :=
    if mem_str x xs then xs else Cons String x xs;

def kw_def : List Nat := ncodes "def";
def kw_axiom : List Nat := ncodes "axiom";
def kw_intrinsic : List Nat := ncodes "intrinsic";
def kw_extern : List Nat := ncodes "extern";
def kw_ind : List Nat := ncodes "inductive";
def kw_rec : List Nat := ncodes "record";
def kw_mod : List Nat := ncodes "module";
def kw_where : List Nat := ncodes "where";
def kw_end : List Nat := ncodes "end";

def harvest_kws : List (List Nat) :=
  [ kw_def, kw_axiom, kw_ind, kw_rec, kw_intrinsic, kw_extern ];

def harvest_from_kw (t : List Nat) (kw : List Nat) (acc : List String) : List String :=
  let (MkPair name _) := take_ident_n (skip_ws_n (drop_n kw t)) in
  match name with
  | Nil => acc
  | Cons _ _ => Cons String (nstr name) acc
  end;

-- `name :` at the start of a trimmed line: record fields and ctor binders.
def harvest_colon_name (t : List Nat) (acc : List String) : List String :=
    let (MkPair name after) := take_ident_n t in
    match name with
    | Nil => acc
    | Cons _ _ =>
        match skip_ws_n after with
        | Cons d _ =>
            if eqNat d ch_colon then Cons String (nstr name) acc else acc
        | Nil => acc
        end
    end;

def harvest_ctor (t : List Nat) (acc : List String) : List String :=
  match t with
  | Cons c rest =>
      if eqNat c ch_bar then harvest_colon_name(skip_ws_n rest, acc) else acc
  | Nil => acc
  end;

-- Every `| Name :` segment of a line: constructors of a one-line inductive.
def harvest_bars : List Nat -> List String -> List String :=
  fix harvest_bars (xs : List Nat) (acc : List String) : List String :=
    match xs with
    | Nil => acc
    | Cons c rest =>
        if eqNat c ch_bar then harvest_bars(rest, harvest_colon_name(skip_ws_n rest, acc))
        else harvest_bars rest acc
    end;

def harvest_kw_line (t : List Nat) (acc : List String) : List String :=
  match find (List Nat) (fun (kw : List Nat) => source_word_at kw t) harvest_kws with
  | Nothing => harvest_ctor t acc
  | Just kw =>
      if starts_n kw_ind t then harvest_bars(t, harvest_from_kw t kw acc) else harvest_from_kw t kw acc
  end;

def harvest_line (ln : String) (acc : List String) : List String :=
  harvest_kw_line(declaration_line (skip_ws_n (line_codes ln)), acc);

def harvest_names (src : String) : List String :=
  foldl String (List String)
    (fun (acc : List String) (ln : String) => harvest_line ln acc)
    (Nil String) (src_lines src);

def has_semi (t : List Nat) : Bool := elem Nat eqNat ch_semi t;

-- Inside an `inductive` declaration until its closing `;`. Effect operations
-- and record fields also use `| name :` / `name :` lines and must stay out.
def harvest_ctor_step (t : List Nat) (in_ind : Bool) (acc : List String)
    : Pair Bool (List String) :=
    if orb(in_ind, starts_n kw_ind t) then
      MkPair(Bool, List String, notb (has_semi t), harvest_bars t acc)
    else MkPair Bool (List String) False acc;

-- Constructor names only, one-line and multi-line inductives alike.
def harvest_ctor_names (src : String) : List String :=
  (fix go (ls : List String) (in_ind : Bool) (acc : List String)
      : List String :=
    match ls with
    | Nil => acc
    | Cons ln rest =>
        let (MkPair in_ind2 acc2) :=
          harvest_ctor_step (declaration_line (skip_ws_n (line_codes ln))) in_ind acc in
        go rest in_ind2 acc2
    end) (src_lines src) False (Nil String);

def harvest_public_symbols (src : String) : Pair (List String) (List String) :=
  (fix go (lines : List String) (pending : Bool) (in_ind : Bool)
      (hidden_ind : Bool) (names : List String) (ctors : List String)
      : Pair (List String) (List String) :=
    match lines with
    | Nil => MkPair (List String) (List String) names ctors
    | Cons line rest =>
        let (MkPair next entry) := public_declaration_line (line_codes line) pending in
        let (MkPair hidden body) := entry in
        let next_names : List String := match hidden with
          | True => names | False => harvest_kw_line body names end in
        let begins_ind : Bool := starts_n kw_ind body in
        if orb in_ind begins_ind then
          let ctor_hidden : Bool := match begins_ind with
            | True => hidden | False => hidden_ind end in
          go rest next (notb (has_semi body)) ctor_hidden next_names
            (match ctor_hidden with
             | True => ctors | False => harvest_bars body ctors end)
        else go rest next False False next_names ctors
    end) (src_lines src) False False False [] [];

def harvest_public_names (src : String) : List String :=
  fst (List String) (List String) (harvest_public_symbols src);

def harvest_public_ctor_names (src : String) : List String :=
  snd (List String) (List String) (harvest_public_symbols src);

def harvest_rec_step (t : List Nat) (in_rec : Bool) (acc : List String)
    : Pair Bool (List String) :=
    if starts_n kw_rec t then MkPair Bool (List String) True acc
    else
      if andb(in_rec, starts_n kw_end t) then MkPair Bool (List String) False acc
      else
        if in_rec then MkPair(Bool, List String, True, harvest_colon_name t acc)
        else MkPair Bool (List String) False acc;

-- Field names from `record R where x : T; ... end`. Record expand emits
-- accessors that bind every field and use one; those unused binders are
-- an artifact, not a smell in the surface program.
def harvest_record_fields (src : String) : List String :=
  (fix go (ls : List String) (in_rec : Bool) (acc : List String)
      : List String :=
    match ls with
    | Nil => acc
    | Cons ln rest =>
        let (MkPair in_rec2 acc2) :=
          harvest_rec_step (declaration_line (skip_ws_n (line_codes ln))) in_rec acc in
        go rest in_rec2 acc2
    end) (src_lines src) False (Nil String);

inductive LintLocalSymbols : Type :=
  | MkLintLocalSymbols : List String -> List String -> List String -> LintLocalSymbols;

def harvest_local_symbols (src : String) : LintLocalSymbols :=
  (fix go (lines : List String) (in_rec : Bool) (in_ind : Bool)
      (names : List String) (fields : List String) (ctors : List String)
      : LintLocalSymbols :=
    match lines with
    | Nil => MkLintLocalSymbols names fields ctors
    | Cons line rest =>
        let body : List Nat := declaration_line (skip_ws_n (line_codes line)) in
        let (MkPair next_rec next_fields) := harvest_rec_step body in_rec fields in
        let (MkPair next_ind next_ctors) := harvest_ctor_step body in_ind ctors in
        go rest next_rec next_ind (harvest_kw_line body names)
          next_fields next_ctors
    end) (src_lines src) False False [] [] [];

def harvest_import_paths (rows : List ScannedImport) : List String :=
  foldl ScannedImport (List String)
    (fun (acc : List String) (row : ScannedImport) =>
      let (MkScannedImport path _ _ _ _ _) := row in
      snoc_str acc path)
    (Nil String) rows;

def harvest_imports (src : String) : Either ImportScanError (List String) :=
  match scan_source_imports src with
  | Left e => Left ImportScanError (List String) e
  | Right rows => Right ImportScanError (List String) (harvest_import_paths rows)
  end;

def last_slash (cs : List Nat) : Maybe Nat :=
  (fix go (xs : List Nat) (i : Nat) (hit : Maybe Nat) : Maybe Nat :=
    match xs with
    | Nil => hit
    | Cons c rest =>
        if orb(eqNat c ch_slash, eqNat c ch_bs) then go(rest, S i, Just Nat i) else go rest (S i) hit
    end) cs Z (Nothing Nat);

def dirname (p : String) : String :=
    let codes : List Nat := ncodes p in
    match last_slash codes with
    | Nothing => "."
    | Just i =>
        match i with
        | Z => "/"
        | S _ => nstr (take Nat i codes)
        end
    end;

def resolve_import (from_file : String) (spell : String) : String :=
    match ncodes spell with
    | Cons c rest =>
        match orb (orb(eqNat c ch_slash, eqNat c ch_bs))
          (match rest with
           | Cons d _ => eqNat d ch_colon
           | Nil => False
           end) with
        | True => spell
        | False => concat(dirname from_file, concat "/" spell)
        end
    | Nil => spell
    end;

-- Qualifiers are file-local. Keep the resolved direct target beside each alias
-- so a transitive declaration with the same short name cannot impersonate it.
def lint_alias_targets (from_file : String) (rows : List ScannedImport)
    : List (Pair String String) :=
  foldl ScannedImport (List (Pair String String))
    (fun (acc : List (Pair String String)) (row : ScannedImport) =>
      let (MkScannedImport path alias _ _ _ _) := row in
      match alias with
      | Nothing => acc
      | Just name => Cons (Pair String String)
          (MkPair String String name (resolve_import from_file path)) acc
      end)
    (Nil (Pair String String)) rows;

def lint_qualified_for_path (path : String)
    (aliases : List (Pair String String)) (names : List String) : List String :=
  match names with
  | Nil => Nil String
  | Cons _ _ => concat_map (Pair String String) String
      (fun (binding : Pair String String) =>
        let (MkPair alias target) := binding in
        if prim_string_eq path target then
          let prefix : String := concat alias "@" in
          map String String (concat prefix) names
        else Nil String) aliases
  end;

def indent_of (cs : List Nat) : List Nat :=
  take_while Nat (fun (c : Nat) => orb(eqNat c ch_space, eqNat c ch_tab)) cs;

def rewrite_mod_def (pref : List Nat) (ln : List Nat) : List Nat :=
    let ind : List Nat := indent_of ln in
    let t : List Nat := skip_ws_n ln in
    let kw : List Nat :=
      if starts_n kw_def t then kw_def else kw_axiom in
    let (MkPair name after) := take_ident_n (skip_ws_n (drop_n kw t)) in
    append Nat ind
      (append Nat kw
        (Cons Nat ch_space
          (append Nat pref (Cons Nat ch_under (append Nat name after)))));

-- Output lines are consed in reverse and flattened once: appending each line
-- to the accumulator copied the whole prefix per line, quadratic in the file.
def expand_module_lines : List String -> List Nat -> List (List Nat)
    -> List (List Nat) :=
  fix go (ls : List String) (pref : List Nat) (acc : List (List Nat))
      : List (List Nat) :=
    match ls with
    | Nil => acc
    | Cons ln rest =>
        let raw : List Nat := ncodes ln in
        let t : List Nat := skip_ws_n (match prim_string_index ln comment_open with
          | Nothing => raw
          | Just k => ncodes (prim_string_slice ln Z k)
          end) in
        match andb (starts_n kw_mod t)
          (match pref with | Nil => True | Cons _ _ => False end) with
        | True =>
            let (MkPair name after) := take_ident_n (skip_ws_n (drop_n kw_mod t)) in
            match andb
              (match name with | Nil => False | Cons _ _ => True end)
              (starts_n(kw_where, skip_ws_n after)) with
            | True => go rest name acc
            | False => go rest pref (Cons (List Nat) raw acc)
            end
        | False =>
            match andb (starts_n kw_end t)
              (match pref with | Nil => False | Cons _ _ => True end) with
            | True => go rest (Nil Nat) acc
            | False =>
                match andb
                  (orb(starts_n kw_def t, starts_n kw_axiom t))
                  (match pref with | Nil => False | Cons _ _ => True end) with
                | True =>
                    go rest pref (Cons(List Nat, rewrite_mod_def pref raw, acc))
                | False => go rest pref (Cons (List Nat) raw acc)
                end
            end
        end
    end;

-- One `\n` after every line. The host splitter yields an empty last segment
-- for a file ending in a newline; dropping it keeps the text length stable.
def join_lines (rev_lines : List (List Nat)) : List Nat :=
  let body : List (List Nat) :=
    match rev_lines with
    | Nil => rev_lines
    | Cons last more =>
        match last with
        | Nil => more
        | Cons _ _ => rev_lines
        end
    end in
  concat_map (List Nat) Nat
    (fun (ln : List Nat) => append Nat ln (nat1 ch_lf))
    (reverse(List Nat, body));

-- module Name where ... end;  -> prefix inner def/axiom names with Name_
-- Files without the keyword anywhere (the common case) pass through untouched.
def expand_modules (src : List Nat) : List Nat :=
    let text : String := nstr src in
    if prim_string_contains text module_kw_text then
      join_lines (expand_module_lines(src_lines text, Nil Nat, Nil (List Nat)))
    else src;
