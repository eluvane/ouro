-- Cons/Nil span facts for OURO-LINT029. Imports only the fixer lexer so the
-- quality/json cone never sees compiler/base eqNat.

import "../fix/lex.ouro";

def st_opens (t : FxTok) : Bool :=
    fx_has_code t fx_c_open;

def st_closes (t : FxTok) : Bool :=
    fx_has_code t fx_c_close;

def st_group_go : List FxTok -> Nat -> List FxTok
    -> Maybe (Pair (List FxTok) (List FxTok)) :=
  fix go (ts : List FxTok) (depth : Nat) (acc : List FxTok)
      : Maybe (Pair (List FxTok) (List FxTok)) :=
    match ts with
    | Nil => Nothing (Pair (List FxTok) (List FxTok))
    | Cons t rest =>
        match st_opens t with
        | True => go rest (S depth) (Cons FxTok t acc)
        | False =>
            match st_closes t with
            | False => go rest depth (Cons FxTok t acc)
            | True =>
                match depth with
                | Z => Just (Pair (List FxTok) (List FxTok))
                    (MkPair (List FxTok) (List FxTok)
                      (reverse_lin FxTok (Cons FxTok t acc)) rest)
                | S d2 => go rest d2 (Cons FxTok t acc)
                end
            end
        end
    end;

def st_atom (ts : List FxTok) : Maybe (Pair (List FxTok) (List FxTok)) :=
    match ts with
    | Nil => Nothing (Pair (List FxTok) (List FxTok))
    | Cons t rest =>
        match st_opens t with
        | True => st_group_go rest Z ([t] : List FxTok)
        | False =>
            match fx_is_kind t fx_k_sym with
            | True => Nothing (Pair (List FxTok) (List FxTok))
            | False => Just (Pair (List FxTok) (List FxTok))
                (MkPair (List FxTok) (List FxTok) ([t] : List FxTok) rest)
            end
        end
    end;

def st_first_tok (ts : List FxTok) : FxTok :=
    head FxTok fx_no_tok ts;

def st_last_tok (ts : List FxTok) : FxTok :=
    last FxTok fx_no_tok ts;

def st_toks_end (ts : List FxTok) : Nat :=
    fx_tok_end (st_last_tok ts);

def st_toks_text (src : String) (ts : List FxTok) : String :=
    let from : Nat := fx_tok_start (st_first_tok ts) in
    str_slice src from (sub (st_toks_end ts) from);

def st_unparen (ts : List FxTok) : List FxTok :=
    match ts with
    | Nil => ts
    | Cons t rest =>
        match fx_is_word t "(" with
        | False => ts
        | True =>
            match fx_is_word (st_last_tok ts) ")" with
            | True => init FxTok rest
            | False => ts
            end
        end
    end;

inductive StChain : Type :=
  | MkStChain : Nat -> List FxTok -> StChain;

def st_chain_parse (bare_tail : Bool) (src : String) (ty : String)
    : Nat -> List FxTok -> Maybe StChain :=
  fix go (fuel : Nat) (ts : List FxTok) : Maybe StChain :=
    match fuel with
    | Z => Nothing StChain
    | S fuel2 =>
        match ts with
        | Nil => Nothing StChain
        | Cons h rest =>
            match st_atom rest with
            | Nothing => Nothing StChain
            | Just ty_at =>
                match ty_at with
                | MkPair ty_atom rest2 =>
                    match str_eq (st_toks_text src ty_atom) ty with
                    | False => Nothing StChain
                    | True =>
                        match fx_is_word h "Nil" with
                        | True => Just StChain
                            (MkStChain (st_toks_end ty_atom) rest2)
                        | False =>
                            match fx_is_word h "Cons" with
                            | False => Nothing StChain
                            | True =>
                                match st_atom rest2 with
                                | Nothing => Nothing StChain
                                | Just el_at =>
                                    match el_at with
                                    | MkPair _ rest3 =>
                                        match fx_is_word (st_first_tok rest3) "(" with
                                        | False =>
                                            match bare_tail with
                                            | False => Nothing StChain
                                            | True => go fuel2 rest3
                                            end
                                        | True =>
                                            match st_atom rest3 with
                                            | Nothing => Nothing StChain
                                            | Just tl_at =>
                                                match tl_at with
                                                | MkPair tl_atom rest4 =>
                                                    match go fuel2 (st_unparen tl_atom) with
                                                    | Nothing => Nothing StChain
                                                    | Just tail =>
                                                        match tail with
                                                        | MkStChain _ after =>
                                                            match after with
                                                            | Cons _ _ => Nothing StChain
                                                            | Nil => Just StChain
                                                                (MkStChain (st_toks_end tl_atom) rest4)
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end;

def st_plain_type (tokens : List FxTok) : Bool :=
    match tokens with
    | Nil => False
    | Cons token _ =>
        andb (fx_is_ident token)
          (notb (str_contains (fx_tok_text token) "."))
    end;

def st_literal_spans_go (src : String) (fuel : Nat) : List FxTok -> Nat
    -> List (Pair Nat Nat) -> List (Pair Nat Nat) :=
  fix go (tokens : List FxTok) (limit : Nat) (acc : List (Pair Nat Nat))
      : List (Pair Nat Nat) :=
    match tokens with
    | Nil => reverse_lin (Pair Nat Nat) acc
    | Cons token rest =>
        match andb (leb_nat limit (fx_tok_start token))
            (andb (eq_nat (fx_tok_code token) fx_c_cons) (st_plain_type rest)) with
        | False => go rest limit acc
        | True =>
            match st_chain_parse True src (fx_tok_text (st_first_tok rest)) fuel tokens with
            | Nothing => go rest limit acc
            | Just chain =>
                match chain with
                | MkStChain stop _ =>
                    go rest stop
                      (Cons (Pair Nat Nat)
                        (MkPair Nat Nat (fx_tok_start token) stop) acc)
                end
            end
        end
    end;

def st_literal_spans (src : String) : List (Pair Nat Nat) :=
    match str_contains src "Cons" with
    | False => Nil (Pair Nat Nat)
    | True =>
        let tokens : List FxTok := fx_lex src in
        st_literal_spans_go src (S (length FxTok tokens)) tokens Z
          (Nil (Pair Nat Nat))
    end;

def st_literal_lines : List String -> Nat -> List Nat -> List Nat :=
  fix go (lines : List String) (line : Nat) (acc : List Nat) : List Nat :=
    match lines with
    | Nil => reverse_lin Nat acc
    | Cons text rest =>
        match st_literal_spans text with
        | Nil => go rest (S line) acc
        | Cons _ _ => go rest (S line) (Cons Nat line acc)
        end
    end;

def st_empty_end (line : Nat) (last : FxTok) (tokens : List FxTok) : Maybe Nat :=
    match tokens with
    | Nil => Just Nat (fx_tok_end last)
    | Cons token rest =>
        match ltb_nat line (fx_tok_line token) with
        | True => Just Nat (fx_tok_end last)
        | False =>
            match fx_has_code token fx_c_semi with
            | False => Nothing Nat
            | True =>
                match rest with
                | Nil => Just Nat (fx_tok_end token)
                | Cons after _ =>
                    match ltb_nat line (fx_tok_line after) with
                    | True => Just Nat (fx_tok_end token)
                    | False => Nothing Nat
                    end
                end
            end
        end
    end;

def st_empty_at (assignment : FxTok) (tokens : List FxTok) : Maybe Nat :=
    match fx_is_word assignment ":=" with
    | False => Nothing Nat
    | True =>
        match tokens with
        | Nil => Nothing Nat
        | Cons constructor rest =>
            match rest with
            | Nil => Nothing Nat
            | Cons type_name after =>
                let line : Nat := fx_tok_line assignment in
                match andb (fx_has_code constructor fx_c_nil)
                    (andb (st_plain_type ([type_name] : List FxTok))
                      (andb (eq_nat line (fx_tok_line constructor))
                        (eq_nat line (fx_tok_line type_name)))) with
                | False => Nothing Nat
                | True => st_empty_end line type_name after
                end
            end
        end
    end;

def st_empty_literal_spans (src : String) (closed_lines : List Nat)
    : List (Pair Nat Nat) :=
    match str_contains src "Nil" with
    | False => Nil (Pair Nat Nat)
    | True =>
        (fix go (tokens : List FxTok) (acc : List (Pair Nat Nat))
            : List (Pair Nat Nat) :=
          match tokens with
          | Nil => reverse_lin (Pair Nat Nat) acc
          | Cons token rest =>
              match st_empty_at token rest with
              | Nothing => go rest acc
              | Just finish =>
                  match mem Nat eq_nat (fx_tok_line token) closed_lines with
                  | True => go rest acc
                  | False =>
                      go rest (Cons (Pair Nat Nat)
                        (MkPair Nat Nat (fx_tok_start token) finish) acc)
                  end
              end
          end) (fx_lex src) (Nil (Pair Nat Nat))
    end;

def st_literal_merge : List (Pair Nat Nat) -> List (Pair Nat Nat)
    -> List (Pair Nat Nat) :=
  fix merge (chains : List (Pair Nat Nat)) (empty : List (Pair Nat Nat))
      : List (Pair Nat Nat) :=
    match chains with
    | Nil => empty
    | Cons chain rest =>
        (fix before (remaining : List (Pair Nat Nat)) : List (Pair Nat Nat) :=
          match remaining with
          | Nil => chains
          | Cons small more =>
              match leb_nat (fst Nat Nat chain) (fst Nat Nat small) with
              | True =>
                  Cons (Pair Nat Nat) chain
                    (merge rest (drop_while (Pair Nat Nat)
                      (fun (span : Pair Nat Nat) =>
                        ltb_nat (fst Nat Nat span) (snd Nat Nat chain))
                      remaining))
              | False => Cons (Pair Nat Nat) small (before more)
              end
          end) empty
    end;

def st_closed_literal_spans (src : String) : List (Pair Nat Nat) :=
    let closed : List Nat := st_literal_lines (str_lines src) (S Z) (Nil Nat) in
    st_literal_merge (st_literal_spans src) (st_empty_literal_spans src closed);
