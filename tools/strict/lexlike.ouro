-- Line-local recognizers that match the Python strict firewall regexes.

import "../quality/registry_model.ouro";

def st_reserved : List String :=
    ["Type", "Nat", "String", "List", "IO", "Unit", "Bool", "True", "False", "Nil", "Cons"];

def st_skip_indent (s : String) : Nat :=
    qt_skip_ws s 0;

def st_at_top (line : String) (word : String) : Bool :=
    qt_at_word line (st_skip_indent line) word;

def st_is_top_form (line : String) : Bool :=
    orb (st_at_top line "def")
      (orb (st_at_top line "inductive")
        (orb (st_at_top line "record")
          (orb(st_at_top line "axiom", st_at_top line "import"))));

def st_is_export_line (line : String) : Bool :=
    let low : String := qt_to_lower line in
    let i : Nat := st_skip_indent low in
    let after_comment : Nat := match qt_starts_at low i "--" with
      | False => i
      | True => qt_skip_ws(low, add i 2)
      end in
    orb (qt_starts_at low after_comment "@export")
      (orb (qt_starts_at low after_comment "@api")
        (qt_starts_at low after_comment "public-api"));

def st_word_search (s : String) (word : String) : Maybe Nat :=
    let slen : Nat := prim_string_length s in
    let wlen : Nat := prim_string_length word in
    (fix go (fuel : Nat) (i : Nat) : Maybe Nat :=
      match fuel with
      | Z => Nothing Nat
      | S fuel2 => match leb_nat(add i wlen, slen) with
        | False => Nothing Nat
        | True => match qt_at_word s i word with
          | True => Just Nat i
          | False => go(fuel2, add i 1)
          end
        end
      end) (add slen 1) 0;

def st_old_do_col (line : String) : Maybe Nat :=
    match st_word_search line "do" with
    | Nothing => Nothing Nat
    | Just dpos =>
        (fix go (fuel : Nat) (i : Nat) : Maybe Nat :=
          match fuel with
          | Z => Nothing Nat
          | S fuel2 => match ltb_nat(i, prim_string_length line) with
            | False => Nothing Nat
            | True =>
                let c : Nat := prim_string_byte_at line i in
                match eq_nat c 59 with
                | True => Nothing Nat
                | False => match qt_is_ident_start c with
                  | False => go(fuel2, add i 1)
                  | True =>
                      let stop : Nat := qt_ident_end(line, add i 1) in
                      let j : Nat := qt_skip_ws line stop in
                      match qt_starts_at line j "<-" with
                      | True => Just Nat dpos
                      | False => go fuel2 stop
                      end
                  end
                end
            end
          end) (add(prim_string_length line, 1)) (add dpos 2)
    end;

def st_pascal_ident (name : String) : Bool :=
    match prim_string_length name with
    | Z => False
    | S _ =>
        andb (qr_is_az (prim_string_byte_at name 0))
          (qt_chars_all qt_is_ident_cont name)
    end;

-- Binding-boundary ascription is the last `:` before `:=`, not the first
-- telescope annotation (`def f (x : Nat) : List Nat`).
def st_last_colon (s : String) : Maybe Nat :=
    (fix go (fuel : Nat) (i : Nat) (found : Maybe Nat) : Maybe Nat :=
      match fuel with
      | Z => found
      | S fuel2 => match ltb_nat(i, prim_string_length s) with
        | False => found
        | True => match eq_nat(prim_string_byte_at s i, 58) with
          | True => go(fuel2, add i 1, Just Nat i)
          | False => go fuel2 (add i 1) found
          end
        end
      end) (add(prim_string_length s, 1)) 0 (Nothing Nat);

def st_has_list_type (prefix : String) : Bool :=
    match st_last_colon prefix with
    | Nothing => False
    | Just i =>
        let j : Nat := qt_skip_ws(prefix, add i 1) in
        qt_at_word prefix j "List"
    end;

def st_open_alias (code : String) : Maybe String :=
    match st_at_top code "open" with
    | False => Nothing String
    | True =>
        let i : Nat := add(st_skip_indent code, 4) in
        qt_ident_at(code, qt_skip_ws code i)
    end;

def st_place (path : String) (line : Nat) (col : Nat) : QrPlace :=
    MkQrPlace(path, qt_min1 line, qt_min1 col);
