-- Source selection for the strict firewall. Policy matches
-- tools/quality/inventory.ouro without importing its `main`.

import "../quality/source.ouro",
  "../../std/listx.ouro";

def st_rel (root : String) (path : String) : String :=
    prim_string_slice(path, S (prim_string_length root), prim_string_length path);

def st_strict_fixture (path : String) : Bool :=
    let bad_name : Bool := match reverse_lin(String, prim_string_split path 47) with
      | Nil => False
      | Cons name _ => prim_string_starts name "bad_"
      end in
    orb (prim_string_eq path "samples/tutorial/04_holes.ouro")
      (orb (any String (fun (prefix : String) => prim_string_starts path prefix)
        [ "quality/fixtures/", "tests/analyze/", "samples/examples/future/",
          "samples/bench/synthesis/" ])
        (orb(prim_string_contains path "/bad/", bad_name)));

-- Hole and one-shot handler demos cannot complete the semantic worker
-- (unresolved holes, `pure` handler ops, or compact effect-name collisions).
-- Named files only; `--include-fixtures` still selects them.
def st_clippy_semantic_fixture (path : String) : Bool :=
    elem String prim_string_eq path
      [ "samples/bench/synthesis/s01_id.ouro"
      , "samples/bench/synthesis/s02_const.ouro"
      , "samples/bench/synthesis/s03_const_body.ouro"
      , "samples/bench/synthesis/s04_bool.ouro"
      , "samples/bench/synthesis/s05_nat.ouro"
      , "samples/bench/synthesis/s06_nil.ouro"
      , "samples/bench/synthesis/s07_cons.ouro"
      , "samples/bench/synthesis/s08_apply.ouro"
      , "samples/bench/synthesis/s09_intro3.ouro"
      , "samples/bench/synthesis/s10_pair.ouro"
      , "samples/bench/synthesis/s11_deep_assumption.ouro"
      , "samples/bench/synthesis/s12_global.ouro"
      , "samples/bench/synthesis/s13_flip.ouro"
      , "samples/bench/synthesis/s14_maybe.ouro"
      , "samples/bench/synthesis/s15_intro_ctor.ouro"
      , "samples/bench/synthesis/s16_impossible.ouro"
      , "samples/bench/synthesis/s17_need_arg.ouro"
      , "samples/bench/synthesis/s18_poly2.ouro"
      , "samples/bench/synthesis/s19_ho_impossible.ouro"
      , "samples/bench/synthesis/s20_mixed.ouro"
      , "samples/demo/04_pure_handler.ouro"
      , "samples/demo/05_effect_handler.ouro"
      , "samples/examples/effect_ask_handler.ouro"
      , "samples/examples/effect_ask_io.ouro"
      , "samples/examples/effect_demo.ouro"
      , "samples/examples/effect_nested_ask.ouro"
      , "samples/examples/future/holes_demo.ouro"
      , "samples/examples/future/metaprog.ouro"
      , "samples/examples/future/synthesis.ouro"
      , "samples/examples/handler_demo.ouro"
      , "samples/examples/io_handler_do_bind.ouro"
      , "samples/tutorial/04_holes.ouro"
      , "samples/tutorial/06_effects.ouro"
      ];

def st_generated (path : String) : Bool :=
    any String (prim_string_contains path)
      [ "compiler/stage0/", "/generated/", ".generated." ];

def st_keep_mode (root : String) (mode : String) (fixtures : Bool)
    (absolute : String) : Bool :=
    let path : String := st_rel root absolute in
    match prim_string_eq mode "strict" with
    | True =>
        andb (notb (st_generated path))
          (orb(fixtures, notb (st_strict_fixture path)))
    | False =>
        orb fixtures (notb (orb (st_clippy_semantic_fixture path)
          (any String (prim_string_contains path)
            [ "_build/", "quality/fixtures/", "/bad/", "/good/" ])))
    end;

def st_skip_mode (mode : String) (name : String) : Bool :=
    match prim_string_eq mode "strict" with
    | True =>
        elem String prim_string_eq name
          [ ".", "..", ".git", "_build", "_cache", "node_modules", "dist",
            "build", ".mypy_cache", ".pytest_cache" ]
    | False => elem String prim_string_eq name [ ".", ".." ]
    end;

def st_under (root : String) (path : String) : Bool :=
    orb (prim_string_eq root path)
      (prim_string_starts(path, prim_string_concat root "/"));

def st_roots (root : String) : List String -> List String
    -> IO (Either QualityInputError (List String)) :=
  fix go (pending : List String) (acc : List String)
      : IO (Either QualityInputError (List String)) :=
    match pending with
    | Nil => io_pure (Either(QualityInputError, List String))
        (Right(QualityInputError, List String, reverse_lin String acc))
    | Cons path rest =>
        do let! kind := prim_fs_kind path;
           match orb(eq_nat kind 1, eq_nat kind 2) with
           | False => io_pure (Either(QualityInputError, List String))
               (Left(QualityInputError, List String, QualityInvalidInput path))
           | True =>
               do let! resolved := prim_fs_realpath path;
                  let canonical : String := quality_normalize_path resolved in
                  match andb (ltb_nat(Z, prim_string_length canonical))
                      (st_under root canonical) with
                  | False => io_pure (Either(QualityInputError, List String))
                      (Left QualityInputError (List String)
                        (QualityInvalidInput path))
                  | True => go(rest, Cons String canonical acc)
                  end
           end
    end;

def st_collect (root : String) (mode : String) (fixtures : Bool)
    (scopes : List String) : IO (Either QualityInputError (List String)) :=
    do let! checked := st_roots root scopes (Nil String);
       match checked with
       | Left err => io_pure (Either(QualityInputError, List String))
           (Left QualityInputError (List String) err)
       | Right roots =>
           quality_inventory (st_skip_mode mode)
             (st_keep_mode root mode fixtures) roots
       end
