-- Registry, docs, debt, and fixture checks from strict_quality_firewall.py.

import "scan_more.ouro";
import "walk.ouro";
import "../quality/registry.ouro";

def st_analyzer_prefix : String := "tests/analyze/";

def st_issue (reason : String) (path : String) : QrIssue :=
    MkQrIssue reason path (Nil String);

def st_issue_codes (reason : String) (path : String) (codes : List String)
    : QrIssue :=
    MkQrIssue reason path codes;

def st_add_issue (xs : List QrIssue) (i : QrIssue) : List QrIssue :=
    Cons QrIssue i xs;

def st_cfg_path (root : String) : String :=
    qr_child root "quality/diagnostics.json";

def st_debt_path (root : String) : String :=
    qr_child root "quality/strict_debt_manifest.json";

def st_manifest_path (root : String) : String :=
    qr_child root "quality/fixtures/manifest.json";

def st_model_path (root : String) : String :=
    qr_child root "tools/analyze/model.ouro";

def st_doc_names : List String :=
    ["quality.md", "clippy_grade_firewall.md", "stability.md", "syntax.md"];

def st_required_tokens : List String :=
    ["allow", "warn", "deny", "forbid", "baseline", "project", "strict",
      "compiler", "release"];

def st_take_az (s : String) (start : Nat) : Nat :=
    (fix go (fuel : Nat) (i : Nat) : Nat :=
      match fuel with
      | Z => i
      | S fuel2 => match ltb_nat i (prim_string_length s) with
        | False => i
        | True => match qr_is_az (prim_string_byte_at s i) with
          | True => go fuel2 (add i 1)
          | False => i
          end
        end
      end) (add (prim_string_length s) 1) start;

def st_digits3 (s : String) (i : Nat) : Bool :=
    match leb_nat (add i 3) (prim_string_length s) with
    | False => False
    | True =>
        andb (qr_is_digit (prim_string_byte_at s i))
          (andb (qr_is_digit (prim_string_byte_at s (add i 1)))
            (qr_is_digit (prim_string_byte_at s (add i 2))))
    end;

def st_findall_codes (text : String) : List String :=
    reverse_lin String
      ((fix go (fuel : Nat) (i : Nat) (acc : List String) : List String :=
        match fuel with
        | Z => acc
        | S fuel2 => match ltb_nat (add i 8) (prim_string_length text) with
          | False => acc
          | True =>
              match prim_string_eq (prim_string_slice text i 5) "OURO-" with
              | False => go fuel2 (add i 1) acc
              | True =>
                  let letters : Nat := st_take_az text (add i 5) in
                  match andb (ltb_nat (add i 5) letters) (st_digits3 text letters) with
                  | False => go fuel2 (add i 1) acc
                  | True =>
                      let stop : Nat := add letters 3 in
                      go fuel2 stop (Cons String
                        (prim_string_slice text i (sub stop i)) acc)
                  end
              end
          end
        end) (add (prim_string_length text) 1) 0 []);

def st_missing_sorted (have : List String) (need : List String) : List String :=
    filter String (fun (c : String) =>
      notb (elem String prim_string_eq c have)) need;

def st_validate_item (root : String) (profiles : List String) (item : QrDiag)
    (seen : List String) : List QrIssue :=
    let code : String := qr_diag_code item in
    let cfg : String := st_cfg_path root in
    let acc0 : List QrIssue := match qr_code_ok code with
      | True => []
      | False => [st_issue (str_cat3 "invalid diagnostic code '" code "'") cfg]
      end in
    let acc1 : List QrIssue := match elem String prim_string_eq code seen with
      | False => acc0
      | True => st_add_issue acc0
          (st_issue (prim_string_concat "duplicate diagnostic code " code) cfg)
      end in
    let acc2 : List QrIssue :=
      (fix go (ps : List String) (out : List QrIssue) : List QrIssue :=
        match ps with
        | Nil => out
        | Cons profile rest =>
            let lvl : String := qr_assoc_or (qr_diag_levels item) profile "" in
            match qr_level_ok lvl with
            | True => go rest out
            | False => go rest (st_add_issue out
                (st_issue (str_cat3 code " missing/invalid level for " profile) cfg))
            end
        end) profiles acc1 in
    let acc3 : List QrIssue :=
      match prim_string_eq (qr_assoc_or (qr_diag_levels item) "forbid" "") "allow" with
      | False => acc2
      | True => st_add_issue acc2
          (st_issue (prim_string_concat code " has malformed forbid level") cfg)
      end in
    let has_forbid : Bool :=
      any (Pair String String) (fun (p : Pair String String) =>
        prim_string_eq (snd String String p) "forbid") (qr_diag_levels item) in
    let acc4 : List QrIssue :=
      match andb has_forbid (qr_diag_suppressible item) with
      | False => acc3
      | True =>
          match orb (prim_string_starts code "OURO-SUP")
              (orb (prim_string_starts code "OURO-TRUST")
                (prim_string_eq code "OURO-ARCH005")) with
          | False => acc3
          | True => st_add_issue acc3
              (st_issue (prim_string_concat code
                " is forbid-level but marked suppressible") cfg)
          end
      end in
    let acc5 : List QrIssue :=
      (fix go (fields : List (Pair String String)) (out : List QrIssue)
          : List QrIssue :=
        match fields with
        | Nil => out
        | Cons pair rest => match pair with
          | MkPair field value =>
              match ltb_nat 0 (prim_string_length (qt_strip value)) with
              | True => go rest out
              | False => go rest (st_add_issue out
                  (st_issue (str_cat3 code " missing diagnostic metadata " field) cfg))
              end
          end
        end)
        [ MkPair String String "title" (qr_diag_title item)
        , MkPair String String "rationale" (qr_diag_rationale item)
        , MkPair String String "replacement" (qr_diag_replacement item)
        ] acc4 in
    match qr_diag_docs item with
    | Nil => st_add_issue acc5
        (st_issue (prim_string_concat code " missing canonical docs") cfg)
    | Cons _ _ => acc5
    end;

def st_validate_docs_exist (root : String) (item : QrDiag) (acc : List QrIssue)
    : IO (List QrIssue) :=
    let cfg : String := st_cfg_path root in
    let code : String := qr_diag_code item in
    io_fold String (List QrIssue)
      (fun (out : List QrIssue) (doc : String) =>
        do let! ok := qr_is_file (qr_child root doc);
           match ok with
           | True => io_pure (List QrIssue) out
           | False => io_pure (List QrIssue)
               (st_add_issue out (st_issue
                 (str_cat3 code " references missing doc " doc) cfg))
           end)
      acc (qr_diag_docs item);

def st_validate_registry_rows (root : String) (cfg : QrConfig)
    : IO (List QrIssue) :=
    let path : String := st_cfg_path root in
    let acc0 : List QrIssue := match qr_list_eq (qr_cfg_profiles cfg) qr_expected_profiles with
      | True => []
      | False => [st_issue
          "quality profiles must be baseline/project/strict/compiler/release" path]
      end in
    let acc1 : List QrIssue := match qr_list_eq (qr_cfg_levels cfg) qr_expected_levels with
      | True => acc0
      | False => st_add_issue acc0
          (st_issue "lint levels must be allow/warn/deny/forbid" path)
      end in
    let acc2 : List QrIssue :=
      (fix go (xs : List QrDiag) (seen : List String) (out : List QrIssue)
          : List QrIssue :=
        match xs with
        | Nil => out
        | Cons item rest =>
            go rest (Cons String (qr_diag_code item) seen)
              (append QrIssue out (st_validate_item root (qr_cfg_profiles cfg) item seen))
        end) (qr_cfg_diags cfg) [] acc1 in
    io_fold QrDiag (List QrIssue)
      (fun (out : List QrIssue) (item : QrDiag) =>
        st_validate_docs_exist root item out)
      acc2 (qr_cfg_diags cfg);

def st_validate_known_codes (root : String) (mp : List (Pair String QrDiag))
    (model_text : String) : List QrIssue :=
    let model : String := st_model_path root in
    let known : List String := st_findall_codes model_text in
    let reg : List String := map (Pair String QrDiag) String
      (fun (p : Pair String QrDiag) => fst String QrDiag p) mp in
    let missing : List String :=
      quality_sort String prim_string_le (st_missing_sorted reg known) in
    let extra : List String :=
      quality_sort String prim_string_le
        (filter String (fun (c : String) =>
          andb (prim_string_starts c "OURO-LINT0")
            (notb (elem String prim_string_eq c known))) reg) in
    let acc0 : List QrIssue :=
      (fix go (xs : List String) (out : List QrIssue) : List QrIssue :=
        match xs with
        | Nil => out
        | Cons code rest => go rest (st_add_issue out (st_issue
            (prim_string_concat
              "known_codes entry lacks diagnostics registry row: " code) model))
        end) missing [] in
    (fix go (xs : List String) (out : List QrIssue) : List QrIssue :=
      match xs with
      | Nil => out
      | Cons code rest => go rest (st_add_issue out (st_issue
          (prim_string_concat
            "quality diagnostic not registered in tools/analyze/model.ouro known_codes: "
            code) model))
      end) extra acc0;

def st_canonical_docs (root : String) : List String :=
    map String String (fun (name : String) =>
      qr_rel root (qr_child (qr_child root "docs") name)) st_doc_names;

def st_validate_docs_mentions (root : String) (mp : List (Pair String QrDiag))
    (combined : String) : List QrIssue :=
    let quality_doc : String := "docs/quality.md" in
    let cfg : String := st_cfg_path root in
    let acc0 : List QrIssue :=
      (fix go (xs : List String) (out : List QrIssue) : List QrIssue :=
        match xs with
        | Nil => out
        | Cons token rest => match qt_contains combined token with
          | True => go rest out
          | False => go rest (st_add_issue out
              (st_issue (prim_string_concat "quality docs missing token " token)
                quality_doc))
          end
        end) st_required_tokens [] in
    let canon : List String := st_canonical_docs root in
    (fix go (xs : List (Pair String QrDiag)) (out : List QrIssue)
        : List QrIssue :=
      match xs with
      | Nil => out
      | Cons pair rest => match pair with
        | MkPair code item =>
            let strict_lvl : String :=
              qr_assoc_or (qr_diag_levels item) "strict" "allow" in
            match leb_nat 2 (qr_strict_rank strict_lvl) with
            | False => go rest out
            | True =>
                let hit : Bool := any String (fun (doc : String) =>
                  elem String prim_string_eq doc (qr_diag_docs item)) canon in
                match hit with
                | True => go rest out
                | False => go rest (st_add_issue out (st_issue
                    (prim_string_concat "strict diagnostic " (prim_string_concat
                      code " lacks canonical quality documentation")) cfg))
                end
            end
        end
      end) mp acc0;

def st_nth_usage (xs : List Nat) (idx : Nat) : Nat :=
    nth Nat 0 idx xs;
