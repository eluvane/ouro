-- Native owner for scripts/strict_quality_firewall.py (except --structural).

import "fixtures.ouro",
  "../../std/json_types.ouro";

def st_default_report : String :=
    "_build/quality/strict-quality-firewall.json";

def st_default_sarif : String :=
    "_build/quality/strict-quality-firewall.sarif";

def st_default_migration : String :=
    "_build/quality/migration-report.md";

def st_report_kind : String :=
    "ouro.strict-quality-firewall-report.v1";

inductive StOpts : Type :=
  | MkStOpts : String -> List String -> Bool -> Bool -> Bool -> Bool
      -> String -> String -> String -> Maybe String -> StOpts;

def st_opts_profile (o : StOpts) : String :=
    match o with | MkStOpts p _ _ _ _ _ _ _ _ _ => p end;

def st_opts_scopes (o : StOpts) : List String :=
    match o with | MkStOpts _ s _ _ _ _ _ _ _ _ => s end;

def st_opts_fixtures (o : StOpts) : Bool :=
    match o with | MkStOpts _ _ f _ _ _ _ _ _ _ => f end;

def st_opts_skip (o : StOpts) : Bool :=
    match o with | MkStOpts _ _ _ s _ _ _ _ _ _ => s end;

def st_opts_list (o : StOpts) : Bool :=
    match o with | MkStOpts _ _ _ _ l _ _ _ _ _ => l end;

def st_opts_report (o : StOpts) : String :=
    match o with | MkStOpts _ _ _ _ _ _ r _ _ _ => r end;

def st_opts_sarif (o : StOpts) : String :=
    match o with | MkStOpts _ _ _ _ _ _ _ s _ _ => s end;

def st_opts_migration (o : StOpts) : String :=
    match o with | MkStOpts _ _ _ _ _ _ _ _ m _ => m end;

def st_opts_scan (o : StOpts) : Maybe String :=
    match o with | MkStOpts _ _ _ _ _ _ _ _ _ s => s end;

def st_opts0 : StOpts :=
    MkStOpts "project" (Nil String) False False False False
      st_default_report st_default_sarif st_default_migration
      (Nothing String);

def st_set_profile (o : StOpts) (v : String) : StOpts :=
    match o with
    | MkStOpts _ s a b c d e f g h => MkStOpts v s a b c d e f g h
    end;

def st_add_scope (o : StOpts) (v : String) : StOpts :=
    match o with
    | MkStOpts p s a b c d e f g h =>
        MkStOpts p (snoc String s v) a b c d e f g h
    end;

def st_set_fixtures (o : StOpts) : StOpts :=
    match o with
    | MkStOpts p s _ b c d e f g h => MkStOpts p s True b c d e f g h
    end;

def st_set_skip (o : StOpts) : StOpts :=
    match o with
    | MkStOpts p s a _ c d e f g h => MkStOpts p s a True c d e f g h
    end;

def st_set_list (o : StOpts) : StOpts :=
    match o with
    | MkStOpts p s a b _ d e f g h => MkStOpts p s a b True d e f g h
    end;

def st_set_report (o : StOpts) (v : String) : StOpts :=
    match o with
    | MkStOpts p s a b c d _ f g h => MkStOpts p s a b c d v f g h
    end;

def st_set_sarif (o : StOpts) (v : String) : StOpts :=
    match o with
    | MkStOpts p s a b c d e _ g h => MkStOpts p s a b c d e v g h
    end;

def st_set_migration (o : StOpts) (v : String) : StOpts :=
    match o with
    | MkStOpts p s a b c d e f _ h => MkStOpts p s a b c d e f v h
    end;

def st_set_scan (o : StOpts) (v : String) : StOpts :=
    match o with
    | MkStOpts p s a b c d e f g _ =>
        MkStOpts p s a b c d e f g (Just String v)
    end;

inductive StParseError : Type :=
  | StParseMissingValue : String -> StParseError
  | StParseUnknownOption : String -> StParseError;

def st_parse_error_message (error : StParseError) : String :=
    match error with
    | StParseMissingValue word => prim_string_concat "missing value for " word
    | StParseUnknownOption word => prim_string_concat "unknown option " word
    end;

def st_parse : List String -> StOpts -> Either StParseError StOpts :=
  fix go (ws : List String) (acc : StOpts) : Either StParseError StOpts :=
    match ws with
    | Nil => Right StParseError StOpts acc
    | Cons w rest =>
        match prim_string_eq w "--include-fixtures" with
        | True => go(rest, st_set_fixtures acc)
        | False => match prim_string_eq w "--skip-fixture-check" with
          | True => go(rest, st_set_skip acc)
          | False => match prim_string_eq w "--list-diagnostics" with
            | True => go(rest, st_set_list acc)
            | False =>
                match rest with
                | Nil => Left StParseError StOpts (StParseMissingValue w)
                | Cons v more =>
                    match prim_string_eq w "--profile" with
                    | True => go(more, st_set_profile acc v)
                    | False => match prim_string_eq w "--scope" with
                      | True => go(more, st_add_scope acc v)
                      | False => match prim_string_eq w "--report" with
                        | True => go(more, st_set_report acc v)
                        | False => match prim_string_eq w "--sarif" with
                          | True => go(more, st_set_sarif acc v)
                          | False => match prim_string_eq w "--migration-report" with
                            | True => go(more, st_set_migration acc v)
                            | False => match prim_string_eq w "--scan-source" with
                              | True => go(more, st_set_scan acc v)
                              | False => Left StParseError StOpts
                                  (StParseUnknownOption w)
                              end
                            end
                          end
                        end
                      end
                    end
                end
            end
          end
        end
    end;

def st_fail (msg : String) : IO Unit :=
    do eprintln (prim_string_concat "STRICT_QUALITY_FIREWALL: FAIL " msg);
       exit 1

def st_fail_inv (msg : String) : IO Unit :=
    do eprintln (prim_string_concat "STRICT_QUALITY: FAIL " msg);
       exit 1

def st_print_findings : List QrFinding -> IO Unit :=
  fix go (xs : List QrFinding) : IO Unit :=
    match xs with
    | Nil => io_pure Unit MkUnit
    | Cons f rest =>
        match qr_find_mark f with
        | Just _ => go rest
        | Nothing =>
            do quality_print_lines (qr_print_finding_lines f "replacement");
               go rest
        end
    end;

def st_print_issues : List QrIssue -> IO Unit :=
  fix go (xs : List QrIssue) : IO Unit :=
    match xs with
    | Nil => io_pure Unit MkUnit
    | Cons i rest =>
        do eprintln (str_cat3 "STRICT_QUALITY_FIREWALL_ISSUE "
              (qr_issue_reason i) (prim_string_concat(" ", qr_issue_path i)));
           go rest
    end;

def st_list_diags (mp : List (Pair String QrDiag)) (profile : String)
    : IO Unit :=
    let codes : List String :=
      quality_sort String prim_string_le
        (map (Pair String QrDiag) String
          (fun (p : Pair String QrDiag) => fst String QrDiag p) mp) in
    (fix go (xs : List String) : IO Unit :=
      match xs with
      | Nil => io_pure Unit MkUnit
      | Cons code rest =>
          match qr_lookup_diag mp code with
          | Nothing => go rest
          | Just item =>
              do println (prim_string_concat
                    (str_cat4 code "\t" (qr_diag_analyzer item) "\t")
                    (str_cat3 (qr_profile_level mp code profile) "\t"
                      (qr_diag_title item)));
                 go rest
          end
      end) codes;

def st_sarif_rules (mp : List (Pair String QrDiag)) (codes : List String)
    : List Json :=
    map String Json (qr_strict_sarif_rule mp) codes;

def st_sarif_results (findings : List QrFinding) : List Json :=
    map QrFinding Json (fun (f : QrFinding) =>
      qr_sarif_result f (qr_strict_blocks f)
        (prim_string_concat(" Replacement: ", qr_find_fix f)))
      (qr_visible findings);

def st_strict_sarif (mp : List (Pair String QrDiag)) (findings : List QrFinding)
    : Json :=
    let codes : List String :=
      qr_union_codes (qr_finding_codes findings) (qr_fixture_codes
        (map (Pair String QrDiag) QrDiag
          (fun (p : Pair String QrDiag) => snd String QrDiag p) mp)) in
    JObj
      [ qr_jstr "$schema" "https://json.schemastore.org/sarif-2.1.0.json"
      , qr_jarr "runs"
          [ JObj
              [ qr_jarr("results", st_sarif_results findings)
              , qr_jobj "tool"
                  [ qr_jobj "driver"
                      [ qr_jstr "informationUri" "docs/quality.md"
                      , qr_jstr "name" "ouro-strict-quality-firewall"
                      , qr_jarr("rules", st_sarif_rules mp codes)
                      ]
                  ]
              ]
          ]
      , qr_jstr "version" "2.1.0"
      ];

def st_report_json (cfg : QrConfig) (profile : String) (scopes : List String)
    (files : Nat) (findings : List QrFinding) (issues : List QrIssue)
    (sarif_rel : String) (migration_rel : String) : Json :=
    let blocking : List QrFinding := st_blocking findings in
    let passed : Bool := match blocking with
      | Nil => match issues with | Nil => True | Cons _ _ => False end
      | Cons _ _ => False
      end in
    JObj
      [ qr_jnum("diagnostics_blocking", length QrFinding blocking)
      , qr_jnum("diagnostics_debt_allowed", qr_count_mark findings)
      , qr_jnum("diagnostics_total", length QrFinding findings)
      , qr_jarr "findings"
          (map QrFinding Json (fun (f : QrFinding) =>
            qr_finding_json f (qr_strict_blocks f) "allowed_by_debt") findings)
      , qr_jnum "files_scanned" files
      , qr_jarr("issues", map QrIssue Json qr_issue_json issues)
      , qr_jstr "kind" st_report_kind
      , qr_jbool "pass" passed
      , qr_jobj "policy"
          [ qr_jstr "debt"
              "strict legacy debt is allowed only through capped manifest entries with reason/replacement/tracking"
          , qr_jstr "fixtures"
              "bad fixtures must emit expected stable codes; good fixtures must stay clean"
          , qr_jobj("levels", qr_pairs (qr_cfg_semantics cfg))
          ]
      , qr_jstr "profile" profile
      , qr_jobj "reports"
          [ qr_jstr "migration" migration_rel
          , qr_jstr "sarif" sarif_rel
          ]
      , qr_jarr("scopes", qr_str_items scopes)
      ];

def st_root : IO String :=
    do let! env := prim_env_get "OURO_ROOT";
       let! cwd := prim_fs_realpath ".";
       io_pure String (match env with
         | Just value => quality_normalize_path value
         | Nothing => quality_normalize_path cwd
         end)

def st_load_cfg (root : String) (_request : Unit) : IO (Either String QrConfig) :=
    do let! loaded := qr_read_object (st_cfg_path root);
       match loaded with
       | Left err => io_pure (Either String QrConfig)
           (Left String QrConfig err)
       | Right obj => io_pure (Either String QrConfig)
           (Right String QrConfig (qr_load_config obj))
       end

def st_scan_many (mp : List (Pair String QrDiag)) (profile : String)
    (root : String) : List String -> List QrFinding
    -> IO (List QrFinding) :=
  fix go (paths : List String) (acc : List QrFinding)
      : IO (List QrFinding) :=
    match paths with
    | Nil => io_pure(List QrFinding, qr_sort_findings acc)
    | Cons path rest =>
        do let! scanned := st_scan_request
             (MkPair (List (Pair String QrDiag)) String mp profile)
             (MkPair String String root path);
           match scanned with
           | Left err =>
               io_bind Unit (List QrFinding)
                 (st_fail_inv (prim_string_concat "unreadable "
                   (prim_string_concat (qr_rel root path)
                     (prim_string_concat ": " err))))
                 (fun (_ : Unit) => io_pure(List QrFinding, acc))
           | Right findings => go(rest, append QrFinding acc findings)
           end
    end;

def st_scan_source_cmd (root : String) (cfg : QrConfig) (opts : StOpts)
    (display : String) : IO Unit :=
    do let! text := read_all;
       let path : String := qr_rel(root, qr_resolve root display) in
       match st_scan_source(qr_cfg_map cfg, st_opts_profile opts, path, text) with
       | Left error => st_fail (st_import_error_message path text error)
       | Right findings => println (qr_dumps (JArr
           (map QrFinding Json (fun (f : QrFinding) =>
             qr_finding_json f (qr_strict_blocks f) "allowed_by_debt") findings)))
       end

def st_status_line (root : String) (profile : String) (files : Nat)
    (findings : List QrFinding) (passed : Bool) (report_path : String)
    : String :=
    str_cat3 "STRICT_QUALITY_FIREWALL: "
      (match passed with | True => "PASS" | False => "FAIL" end)
      (str_cat3 " profile=" profile
        (str_cat3 " files=" (prim_string_of_nat files)
          (str_cat3 " blocking="
            (prim_string_of_nat (length(QrFinding, st_blocking findings)))
            (str_cat3 " debt="
              (prim_string_of_nat (qr_count_mark findings))
              (prim_string_concat(" report=", qr_rel root report_path))))));

def st_emit (root : String) (cfg : QrConfig) (opts : StOpts)
    (scopes : List String) (files : List String) (findings : List QrFinding)
    (issues : List QrIssue) : IO Unit :=
    let report_path : String := qr_resolve(root, st_opts_report opts) in
    let sarif_path : String := qr_resolve(root, st_opts_sarif opts) in
    let migration_path : String := qr_resolve(root, st_opts_migration opts) in
    let file_count : Nat := length String files in
    let body : Json :=
      st_report_json cfg (st_opts_profile opts) scopes file_count
        findings issues (qr_rel root sarif_path) (qr_rel root migration_path) in
    let passed : Bool := match st_blocking findings with
      | Nil => match issues with | Nil => True | Cons _ _ => False end
      | Cons _ _ => False
      end in
    do let! _w1 := qr_write_text migration_path
         (prim_string_concat(st_join_nl (qr_migration_lines findings), "\n"));
       let! _w2 := qr_write_json sarif_path
         (st_strict_sarif(qr_cfg_map cfg, findings));
       let! _w3 := qr_write_json report_path body;
       let! _p1 := st_print_findings findings;
       let! _p2 := st_print_issues issues;
       let! _p3 := println (st_status_line root (st_opts_profile opts)
         file_count findings passed report_path);
       match passed with
       | True => exit 0
       | False => exit 1
       end

def st_after_debt (root : String) (cfg : QrConfig) (opts : StOpts)
    (scopes : List String) (files : List String) (findings : List QrFinding)
    (items : List Json) (usage : List Nat) : IO Unit :=
    do let! reg_issues := st_registry_issues root cfg;
       let! fix_issues := match st_opts_skip opts with
         | True => io_pure(List QrIssue, Nil QrIssue)
         | False => st_fixture_issues root cfg
         end;
       st_emit root cfg opts scopes files findings
         (append QrIssue reg_issues
           (append QrIssue (st_debt_json_issues root items usage) fix_issues))

def st_after_scan (root : String) (cfg : QrConfig) (opts : StOpts)
    (scopes : List String) (files : List String) (raw : List QrFinding)
    : IO Unit :=
    do let! debtp := st_load_debt root;
       match debtp with
       | MkPair entries items =>
           match qr_apply_debt raw entries (st_opts_profile opts) with
           | MkPair findings usage =>
               st_after_debt root cfg opts scopes files findings items usage
           end
       end

def st_run_files (root : String) (cfg : QrConfig) (opts : StOpts)
    (scopes : List String) (files : List String) : IO Unit :=
    do let! raw := st_scan_many (qr_cfg_map cfg) (st_opts_profile opts)
         root files (Nil QrFinding);
       st_after_scan root cfg opts scopes files raw

def st_run (root : String) (cfg : QrConfig) (opts : StOpts) : IO Unit :=
    let scopes : List String := match st_opts_scopes opts with
      | Nil => qr_cfg_scopes cfg
      | Cons h t => Cons String h t
      end in
    do let! collected := st_collect root "strict" (st_opts_fixtures opts)
         (map String String (qr_resolve root) scopes);
       match collected with
       | Left err => st_fail_inv (quality_input_message err)
       | Right files => st_run_files root cfg opts scopes files
       end

def st_start (root : String) (opts : StOpts) : IO Unit :=
    do let! loaded := st_load_cfg root MkUnit;
       match loaded with
       | Left err => st_fail err
       | Right cfg =>
           match st_opts_list opts with
           | True => st_list_diags(qr_cfg_map cfg, st_opts_profile opts)
           | False =>
               match st_opts_scan opts with
               | Just display => st_scan_source_cmd root cfg opts display
               | Nothing => st_run root cfg opts
               end
           end
       end

def main : IO Unit :=
    do let! argv := prim_argv;
       let! root := st_root;
       match st_parse(tail String argv, st_opts0) with
       | Left err => st_fail (st_parse_error_message err)
       | Right opts => st_start root opts
       end
