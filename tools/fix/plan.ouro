-- Publication policy and deterministic edit transactions. Raw rule proposals
-- are retained for review/goldens; only this planner authorizes automatic work.
import "scan.ouro";
import "../quality/order.ouro";
import "../quality/diagnostic.ouro";
import "../../std/collections.ouro";

-- Applicability is a proof boundary, not a severity or a promise that merely
-- compiling the candidate establishes equivalence. Constructor/provider and
-- coverage/binder/let rewrites still lack compiler-owned identity certificates.
def fx_applicability (edit : FxEdit) : QualityApplicability :=
    let code : String := fx_edit_rule edit in
    match elem String str_eq code ["dup-import", "do-bind", "double-semi"] with
    | True => QualityMechanicalEdit
    | False => match elem String str_eq code
        ["dead-let", "identity-let", "list-literal", "peano-literal", "unused-binder", "unreachable-arm", "import-alias", "list-type", "nonrec-fix"] with
      | True => QualitySuggestedEdit
      | False => QualityNoEdit
      end
    end;

-- Only syntax repairs have independently verifiable certificates today. Other rule families
-- remain review-required until they supply their own preservation proofs.
def fx_edit_priority (edit : FxEdit) : Nat :=
    match elem String str_eq (fx_edit_rule edit) ["dup-import", "do-bind", "double-semi"] with
    | True => 0
    | False => 3
    end;

def fx_same_edit (a : FxEdit) (b : FxEdit) : Bool :=
    andb (eq_nat (fx_edit_start a) (fx_edit_start b))
      (andb (eq_nat (fx_edit_end a) (fx_edit_end b)) (str_eq (fx_edit_rep a) (fx_edit_rep b)));

-- Every gap in a removed fragment must be whitespace. Comment-looking bytes
-- INSIDE a complete string token are data. Removing comments/directives/docs
-- is never authorized, including in otherwise safe compound identity-let edits.
def fx_plain_fragment (text : String) : Bool :=
    (fix go (tokens : List FxTok) (previous : Nat) : Bool :=
      match tokens with
      | Nil => str_null (str_trim (fx_slice text previous (str_len text)))
      | Cons token rest => andb
          (str_null (str_trim (fx_slice text previous (fx_tok_start token))))
          (go rest (fx_tok_end token))
      end) (fx_lex text) 0;

def fx_edit_preserves_trivia (src : String) (edit : FxEdit) : Bool :=
    fx_plain_fragment (fx_slice src (fx_edit_start edit) (fx_edit_end edit));

def fx_machine_edit (edit : FxEdit) : Bool :=
    match fx_applicability edit with
    | QualityMechanicalEdit => True
    | QualitySuggestedEdit => False
    | QualityNoEdit => False
    end;

-- Compound edits have no transaction ID in the legacy proposal model. If
-- any edit of a rule touches trivia, keep that whole rule's proposals for review;
-- never apply half an identity-let/nonrec rewrite. The rule inventory is fixed
-- and small, so this does not introduce a source-size pairwise scan.
def fx_trivia_blocked (src : String) (proposals : List FxEdit) : List String :=
    dedup_adjacent String str_eq (quality_sort String prim_string_le
      (map FxEdit String fx_edit_rule
        (filter FxEdit (fun (edit : FxEdit) => notb (fx_edit_preserves_trivia src edit)) proposals)));

def fx_automatic_proposals (src : String) (proposals : List FxEdit) : List FxEdit :=
    let blocked : List String := fx_trivia_blocked src proposals in
    filter FxEdit (fun (edit : FxEdit) => andb (fx_machine_edit edit)
      (notb (elem String str_eq (fx_edit_rule edit) blocked))) proposals;

def fx_review_proposals (src : String) (proposals : List FxEdit) : List FxEdit :=
    let blocked : List String := fx_trivia_blocked src proposals in
    filter FxEdit (fun (edit : FxEdit) => orb (notb (fx_machine_edit edit))
      (elem String str_eq (fx_edit_rule edit) blocked)) proposals;

def fx_valid_edit (src : String) (edit : FxEdit) : Bool :=
    andb (leb_nat (fx_edit_start edit) (fx_edit_end edit))
      (andb (leb_nat (fx_edit_end edit) (str_len src))
        (match fx_applicability edit with
         | QualityNoEdit => False
         | QualitySuggestedEdit => True
         | QualityMechanicalEdit => True end));

inductive FxPlanError : Type :=
  | FxPlanConflict : String -> String -> FxPlanError
  | FxPlanInvalidEdit : FxPlanError
  | FxPlanNoImprove : FxPlanError
  | FxPlanNoSyntaxProof : FxPlanError
  | FxPlanProofDisagree : FxPlanError
  | FxPlanTriviaLost : FxPlanError
  | FxPlanProofNotDecreasing : FxPlanError
  | FxPlanDuplicateEdits : FxPlanError;

def fx_plan_error_message (error : FxPlanError) : String :=
    match error with
    | FxPlanConflict left right =>
        str_cat4 "conflicting automatic edits: " left " / " right
    | FxPlanInvalidEdit => "unknown rule or invalid automatic edit byte range"
    | FxPlanNoImprove => "automatic edit does not improve or change the source"
    | FxPlanNoSyntaxProof => "automatic edit has no syntax preservation proof"
    | FxPlanProofDisagree => "automatic edit disagrees with its syntax preservation proof"
    | FxPlanTriviaLost => "syntax proof would lose source trivia or has an invalid span"
    | FxPlanProofNotDecreasing => "syntax proof does not decrease the remaining syntax defects"
    | FxPlanDuplicateEdits => "transaction contains duplicate unnormalized edits"
    end;

-- Start order is used only inside a chosen priority class. Adjacent duplicate
-- proposals coalesce. Unequal same-point insertions and overlaps are errors,
-- not silent loser-dropping or guessed application order.
def fx_disjoint_checked : List FxEdit -> Maybe FxEdit -> List FxEdit
    -> Either FxPlanError (List FxEdit) :=
  fix go (remaining : List FxEdit) (previous : Maybe FxEdit) (rev : List FxEdit)
      : Either FxPlanError (List FxEdit) :=
    match remaining with
    | Nil => Right FxPlanError (List FxEdit) (reverse_lin FxEdit rev)
    | Cons edit rest => match previous with
      | Nothing => go rest (Just FxEdit edit) [edit]
      | Just last => match fx_same_edit last edit with
        | True => go rest previous rev
        | False => match orb (eq_nat (fx_edit_start last) (fx_edit_start edit))
            (ltb_nat (fx_edit_start edit) (fx_edit_end last)) with
          | True => Left FxPlanError (List FxEdit)
              (FxPlanConflict (fx_edit_rule last) (fx_edit_rule edit))
          | False => go rest (Just FxEdit edit) (Cons FxEdit edit rev)
          end
        end
      end
    end;

def fx_checked_plan (src : String) (proposals : List FxEdit) : Either FxPlanError (List FxEdit) :=
    match all FxEdit (fx_valid_edit src) proposals with
    | False => Left FxPlanError (List FxEdit) FxPlanInvalidEdit
    | True =>
        let automatic : List FxEdit := fx_automatic_proposals src proposals in
        match any FxEdit (fun (edit : FxEdit) =>
            str_eq (fx_slice src (fx_edit_start edit) (fx_edit_end edit)) (fx_edit_rep edit)) automatic with
        | True => Left FxPlanError (List FxEdit) FxPlanNoImprove
        | False => match automatic with
          | Nil => Right FxPlanError (List FxEdit) []
          | Cons first rest =>
              let priority : Nat := foldl FxEdit Nat (fun (best : Nat) (edit : FxEdit) =>
                match ltb_nat (fx_edit_priority edit) best with
                | True => fx_edit_priority edit | False => best end) (fx_edit_priority first) rest in
              fx_disjoint_checked (fx_sort_edits
                (filter FxEdit (fun (edit : FxEdit) => eq_nat priority (fx_edit_priority edit)) automatic))
                (Nothing FxEdit) []
          end
        end
    end;
