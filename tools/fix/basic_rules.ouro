-- Whole-file syntax rewrite rules for imports, aliases, binds, separators,
-- lists, and Peano towers. Each rule proposes byte-span edits.

import "scan.ouro";
import "../../std/format.ouro";

def fx_rule_dup_import : String := "dup-import";
def fx_rule_do_bind : String := "do-bind";
def fx_rule_semi : String := "double-semi";
def fx_rule_list : String := "list-literal";
def fx_rule_peano : String := "peano-literal";
def fx_rule_unused : String := "unused-binder";
def fx_rule_dead_let : String := "dead-let";
def fx_rule_arm : String := "unreachable-arm";
def fx_rule_alias : String := "import-alias";
def fx_rule_list_type : String := "list-type";
def fx_rule_nonrec_fix : String := "nonrec-fix";
def fx_byte_mod : Nat := 256;

def fx_edit1 (e : FxEdit) : List FxEdit :=
    [e];

def fx_quote (s : String) : String :=
    str_cat3 "`" s "`";

-- Skip through an optional "as Alias" to the terminating semicolon.
def fx_import_tail : Nat -> List FxTok -> String -> Maybe (Pair (Pair String FxTok) (List FxTok)) :=
  fix go (fuel : Nat) (ts : List FxTok) (alias : String)
      : Maybe (Pair (Pair String FxTok) (List FxTok)) :=
    match fuel with
    | Z => Nothing (Pair (Pair String FxTok) (List FxTok))
    | S fuel2 =>
        match ts with
        | Nil => Nothing (Pair (Pair String FxTok) (List FxTok))
        | Cons t rest =>
            match fx_is_word t ";" with
            | True => Just (Pair (Pair String FxTok) (List FxTok))
                        (MkPair (Pair String FxTok) (List FxTok)
                          (MkPair String FxTok alias t) rest)
            | False =>
                match fx_is_word t "as" with
                | True => go fuel2 rest alias
                | False =>
                    match andb (fx_is_ident t) (notb (fx_is_decl_start t)) with
                    | True => go fuel2 rest (fx_tok_text t)
                    | False => Nothing (Pair (Pair String FxTok) (List FxTok))
                    end
                end
            end
        end
    end;

-- Edits proposed at one token plus the updated set of seen import keys.
inductive FxHit : Type :=
  | MkFxHit : List FxEdit -> List String -> FxHit;

def fx_no_hit (seen : List String) : FxHit :=
    MkFxHit (Nil FxEdit) seen;

-- import "path" [as Alias]; repeated with the same spelling and alias is dropped.
def fx_import_hit (src : String) (t : FxTok) (rest : List FxTok) (seen : List String) : FxHit :=
    match rest with
    | Nil => fx_no_hit seen
    | Cons p rest2 =>
        match fx_is_kind p fx_k_str with
        | False => fx_no_hit seen
        | True =>
            match fx_import_tail (S fx_let_len) rest2 "" with
            | Nothing => fx_no_hit seen
            | Just found =>
                match found with
                | MkPair alias_semi after =>
                    match alias_semi with
                    | MkPair alias semi =>
                        let key : String := str_cat3 (fx_tok_text p) " " alias in
                        match elem String str_eq key seen with
                        | False => MkFxHit (Nil FxEdit) (Cons String key seen)
                        | True =>
                            MkFxHit
                              (fx_edit1 (fx_delete_edit src fx_rule_dup_import
                                (str_concat "duplicate import " (fx_tok_text p))
                                t semi (fx_maybe_head after)))
                              seen
                        end
                    end
                end
            end
        end
    end;

-- Rewrite the retired bind spelling to the maintained let! form.
def fx_do_bind_hit (t : FxTok) (prev : List FxTok) : List FxEdit :=
    match prev with
    | Nil => Nil FxEdit
    | Cons name prev2 =>
        match prev2 with
        | Nil => Nil FxEdit
        | Cons before _ =>
            match andb (fx_is_ident name)
                  (orb (fx_is_word before "do") (fx_is_word before ";")) with
            | False => Nil FxEdit
            | True =>
                fx_edit1 (MkFxEdit (fx_tok_start name) (fx_tok_end t)
                  (str_cat3 "let! " (fx_tok_text name) " :=")
                  fx_rule_do_bind (fx_tok_line t)
                  (str_cat3 "legacy bind " (fx_quote (str_concat (fx_tok_text name) " <-"))
                    " rewritten to let!"))
            end
        end
    end;

def fx_semi_hit (t : FxTok) (prev : List FxTok) : List FxEdit :=
    match prev with
    | Nil => Nil FxEdit
    | Cons before _ =>
        match fx_is_word before ";" with
        | False => Nil FxEdit
        | True =>
            fx_edit1 (MkFxEdit (fx_tok_end before) (fx_tok_end t) ""
              fx_rule_semi (fx_tok_line t) "redundant `;` removed")
        end
    end;

-- "[...] : List T" as a whole atom: the literal group alone.
def fx_ascribed_literal (src : String) (h : FxTok) (args : List FxTok) : Maybe String :=
    match fx_is_word h "[" with
    | False => Nothing String
    | True =>
        match st_group_go args Z ([h] : List FxTok) with
        | Nothing => Nothing String
        | Just grp_at =>
            match grp_at with
            | MkPair grp after =>
                match fx_is_word (fx_first_tok after) ":" with
                | True => Just String (fx_toks_text src grp)
                | False => Nothing String
                end
            end
        end
    end;

-- Element text inside a literal the fixer emits. The literal is always typed,
-- so an element that is exactly "Nil T" drops to [] and an element that
-- carries its own ascription loses it.
def fx_elem_text (src : String) (atom : List FxTok) : String :=
    let inner : List FxTok := st_unparen atom in
    match inner with
    | Nil => fx_atom_text src atom
    | Cons h args =>
        match fx_ascribed_literal src h args with
        | Just lit => lit
        | Nothing =>
            match fx_is_word h "Nil" with
            | False => fx_atom_text src atom
            | True =>
                match st_atom args with
                | Nothing => fx_atom_text src atom
                | Just ty_at =>
                    match ty_at with
                    | MkPair _ after =>
                        match after with
                        | Nil => "[]"
                        | Cons _ _ => fx_atom_text src atom
                        end
                    end
                end
            end
        end
    end;

-- Elements, end byte and remaining tokens of a constructor chain. Diagnostics
-- retain the syntax check for a bare tail; edits require atom-shaped tails.
inductive FxChain : Type :=
  | MkFxChain : List String -> Nat -> List FxTok -> FxChain;

def fx_chain_prepend (src : String) (elem : List FxTok) (tail : FxChain) : FxChain :=
    match tail with
    | MkFxChain elems stop after =>
        MkFxChain (Cons String (fx_elem_text src elem) elems) stop after
    end;

-- One Cons/Nil recognizer serves edits and diagnostic spans. The mode changes
-- applicability, never the meaning or shape of an automatically applied edit.
def fx_chain_parse (bare_tail : Bool) (src : String) (ty : String)
    : Nat -> List FxTok -> Maybe FxChain :=
  fix go (fuel : Nat) (ts : List FxTok) : Maybe FxChain :=
    match fuel with
    | Z => Nothing FxChain
    | S fuel2 =>
        match ts with
        | Nil => Nothing FxChain
        | Cons h rest =>
            match st_atom rest with
            | Nothing => Nothing FxChain
            | Just ty_at =>
                match ty_at with
                | MkPair ty_atom rest2 =>
                    match str_eq (fx_toks_text src ty_atom) ty with
                    | False => Nothing FxChain
                    | True =>
                        match fx_is_word h "Nil" with
                        | True => Just FxChain (MkFxChain (Nil String) (fx_toks_end ty_atom) rest2)
                        | False =>
                            match fx_is_word h "Cons" with
                            | False => Nothing FxChain
                            | True =>
                                match st_atom rest2 with
                                | Nothing => Nothing FxChain
                                | Just el_at =>
                                    match el_at with
                                    | MkPair el_atom rest3 =>
                                        match fx_is_word (fx_first_tok rest3) "(" with
                                        | False =>
                                            match bare_tail with
                                            | False => Nothing FxChain
                                            | True =>
                                                match go fuel2 rest3 with
                                                | Nothing => Nothing FxChain
                                                | Just tail => Just FxChain (fx_chain_prepend src el_atom tail)
                                                end
                                            end
                                        | True =>
                                            match st_atom rest3 with
                                            | Nothing => Nothing FxChain
                                            | Just tl_at =>
                                                match tl_at with
                                                | MkPair tl_atom rest4 =>
                                                    match go fuel2 (st_unparen tl_atom) with
                                                    | Nothing => Nothing FxChain
                                                    | Just tail =>
                                                        match tail with
                                                        | MkFxChain elems _ after =>
                                                            match after with
                                                            | Cons _ _ => Nothing FxChain
                                                            | Nil => Just FxChain (MkFxChain
                                                                (Cons String (fx_elem_text src el_atom) elems)
                                                                (fx_toks_end tl_atom) rest4)
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end;

def fx_chain_elems (src : String) (ty : String) (fuel : Nat) (ts : List FxTok)
    (acc : List String) : Maybe (List String) :=
    match fx_chain_parse False src ty fuel ts with
    | Nothing => Nothing (List String)
    | Just chain =>
        match chain with
        | MkFxChain elems _ after =>
            match after with
            | Cons _ _ => Nothing (List String)
            | Nil => Just (List String) (append String (reverse_lin String acc) elems)
            end
        end
    end;

-- Reversed prefix match of expected token texts against the reversed history.
def fx_prev_matches : List FxTok -> List FxTok -> Maybe (List FxTok) :=
  fix go (expected : List FxTok) (prev : List FxTok) : Maybe (List FxTok) :=
    match expected with
    | Nil => Just (List FxTok) prev
    | Cons e erest =>
        match prev with
        | Nil => Nothing (List FxTok)
        | Cons p prest =>
            match str_eq (fx_tok_text e) (fx_tok_text p) with
            | True => go erest prest
            | False => Nothing (List FxTok)
            end
        end
    end;

-- ": List T :=" immediately before the expression, so a bare literal is typed.
def fx_annotated_list (prev : List FxTok) (ty_atom : List FxTok) : Bool :=
    match prev with
    | Nil => False
    | Cons a prev2 =>
        match fx_is_word a ":=" with
        | False => False
        | True =>
            match fx_prev_matches (reverse_lin FxTok ty_atom) prev2 with
            | Nothing => False
            | Just prev3 =>
                match prev3 with
                | Nil => False
                | Cons l prev4 =>
                    match prev4 with
                    | Nil => False
                    | Cons c _ => andb (fx_is_word l "List") (fx_is_word c ":")
                    end
                end
            end
        end
    end;

def fx_list_text (annotated : Bool) (ty : String) (elems : List String) : String :=
    let lit : String := str_cat3 "[" (str_join ", " elems) "]" in
    match annotated with
    | True => lit
    | False => str_cat3 "(" lit (str_cat3 " : List " ty ")")
    end;

-- Span extended over enclosing parens when the rewrite is a single atom.
def fx_strip_parens (prev : List FxTok) (after : List FxTok) (start : Nat) (stop : Nat)
    : Pair Nat Nat :=
    match prev with
    | Nil => MkPair Nat Nat start stop
    | Cons p _ =>
        match after with
        | Nil => MkPair Nat Nat start stop
        | Cons n _ =>
            match andb (fx_is_word p "(") (fx_is_word n ")") with
            | True => MkPair Nat Nat (fx_tok_start p) (fx_tok_end n)
            | False => MkPair Nat Nat start stop
            end
        end
    end;

-- An element touching either bracket of an enclosing list literal takes its
-- type from that literal.
def fx_in_list_literal (prev : List FxTok) (after : List FxTok) : Bool :=
    orb (fx_is_word (fx_first_tok prev) "[") (fx_is_word (fx_first_tok after) "]");

-- "let name :=" directly before the expression, with no type annotation.
def fx_let_untyped (prev : List FxTok) : Maybe FxTok :=
    match prev with
    | Nil => Nothing FxTok
    | Cons a prev2 =>
        match prev2 with
        | Nil => Nothing FxTok
        | Cons name prev3 =>
            match prev3 with
            | Nil => Nothing FxTok
            | Cons l _ =>
                match andb (fx_is_word a ":=") (andb (fx_is_ident name) (fx_is_word l "let")) with
                | True => Just FxTok name
                | False => Nothing FxTok
                end
            end
        end
    end;

def fx_list_edit (src : String) (t : FxTok) (prev : List FxTok) (after : List FxTok)
    (ty_atom : List FxTok) (stop : Nat) (elems : List String) : List FxEdit :=
    let ty : String := fx_toks_text src ty_atom in
    match fx_let_untyped prev with
    | Just name =>
        let text : String := str_cat3 " : List " ty (str_concat " := " (fx_list_text True ty elems)) in
        fx_edit1 (MkFxEdit (fx_tok_end name) stop text fx_rule_list (fx_tok_line t)
          (str_cat3 "constructor chain rewritten as typed binding" text ""))
    | Nothing =>
        let typed : Bool := orb (fx_annotated_list prev ty_atom) (fx_in_list_literal prev after) in
        let text : String := fx_list_text typed ty elems in
        let span : Pair Nat Nat := fx_strip_parens prev after (fx_tok_start t) stop in
        fx_edit1 (MkFxEdit (fx_pair_fst span) (fx_pair_snd span) text fx_rule_list (fx_tok_line t)
          (str_cat3 "constructor chain rewritten as " text ""))
    end;

-- Cons T e1 (Cons T e2 (Nil T))  ->  [e1, e2]  (ascribed when no annotation)
def fx_cons_hit_fuel (fuel : Nat) (src : String) (t : FxTok) (rest : List FxTok) (prev : List FxTok) : List FxEdit :=
    match st_atom rest with
    | Nothing => Nil FxEdit
    | Just ty_at =>
        match ty_at with
        | MkPair ty_atom rest2 =>
            match st_atom rest2 with
            | Nothing => Nil FxEdit
            | Just el_at =>
                match el_at with
                | MkPair el_atom rest3 =>
                    match st_atom rest3 with
                    | Nothing => Nil FxEdit
                    | Just tl_at =>
                        match tl_at with
                        | MkPair tl_atom rest4 =>
                            match fx_chain_elems src (fx_toks_text src ty_atom) fuel
                                    (st_unparen tl_atom)
                                    ([fx_elem_text src el_atom] : List String) with
                            | Nothing => Nil FxEdit
                            | Just elems =>
                                fx_list_edit src t prev rest4 ty_atom (fx_toks_end tl_atom) elems
                            end
                        end
                    end
                end
            end
        end
    end;

def fx_cons_hit (src : String) (t : FxTok) (rest : List FxTok) (prev : List FxTok) : List FxEdit :=
    fx_cons_hit_fuel fx_byte_mod src t rest prev;

-- Nil T bound by an annotated or untyped let binding  ->  []
-- A bare Nil inside a user-written literal is left alone: the literal may be
-- the only thing that fixes its element type.
def fx_nil_hit (src : String) (t : FxTok) (rest : List FxTok) (prev : List FxTok) : List FxEdit :=
    match st_atom rest with
    | Nothing => Nil FxEdit
    | Just ty_at =>
        match ty_at with
        | MkPair ty_atom rest2 =>
            let bound : Bool := match fx_let_untyped prev with
              | Just _ => True
              | Nothing => fx_annotated_list prev ty_atom
              end in
            match bound with
            | False => Nil FxEdit
            | True => fx_list_edit src t prev rest2 ty_atom (fx_toks_end ty_atom) (Nil String)
            end
        end
    end;

-- Leaf of an S tower whose argument groups nest exactly.
def fx_tower_leaf : Nat -> List FxTok -> Nat -> Maybe (Pair Nat FxTok) :=
  fix go (fuel : Nat) (ts : List FxTok) (depth : Nat) : Maybe (Pair Nat FxTok) :=
    match fuel with
    | Z => Nothing (Pair Nat FxTok)
    | S fuel2 =>
        match ts with
        | Nil => Nothing (Pair Nat FxTok)
        | Cons h rest =>
            match fx_is_word h "S" with
            | True =>
                match st_atom rest with
                | Nothing => Nothing (Pair Nat FxTok)
                | Just arg_at =>
                    match arg_at with
                    | MkPair arg after =>
                        match after with
                        | Nil => go fuel2 (st_unparen arg) (S depth)
                        | Cons _ _ => Nothing (Pair Nat FxTok)
                        end
                    end
                end
            | False =>
                match rest with
                | Cons _ _ => Nothing (Pair Nat FxTok)
                | Nil =>
                    match andb (fx_is_ident h) (notb (fx_is_word h "S")) with
                    | True => Just (Pair Nat FxTok) (MkPair Nat FxTok depth h)
                    | False => Nothing (Pair Nat FxTok)
                    end
                end
            end
        end
    end;

def fx_pipes_s : Nat -> String -> String :=
  fix go (n : Nat) (acc : String) : String :=
    match n with
    | Z => acc
    | S n2 => go n2 (str_concat acc " |> S")
    end;

def fx_peano_edit (t : FxTok) (prev : List FxTok) (after : List FxTok) (stop : Nat)
    (depth : Nat) (leaf : FxTok) : List FxEdit :=
    match ltb_nat depth fx_let_len with
    | True => Nil FxEdit
    | False =>
        match fx_is_word leaf "Z" with
        | True =>
            let span : Pair Nat Nat := fx_strip_parens prev after (fx_tok_start t) stop in
            let text : String := show_nat depth in
            fx_edit1 (MkFxEdit (fx_pair_fst span) (fx_pair_snd span) text fx_rule_peano
              (fx_tok_line t) (str_cat3 "Peano tower rewritten as " text ""))
        | False =>
            let text : String := fx_pipes_s depth (fx_tok_text leaf) in
            fx_edit1 (MkFxEdit (fx_tok_start t) stop text fx_rule_peano (fx_tok_line t)
              (str_cat3 "successor tower rewritten as " text ""))
        end
    end;

-- S (S (S Z)) -> 3;  S (S (S n)) -> n |> S |> S |> S
def fx_succ_hit (t : FxTok) (rest : List FxTok) (prev : List FxTok) : List FxEdit :=
    match st_atom rest with
    | Nothing => Nil FxEdit
    | Just arg_at =>
        match arg_at with
        | MkPair arg after =>
            match fx_tower_leaf fx_fuel_small (st_unparen arg) (S Z) with
            | Nothing => Nil FxEdit
            | Just leaf_at =>
                match leaf_at with
                | MkPair depth leaf => fx_peano_edit t prev after (fx_toks_end arg) depth leaf
                end
            end
        end
    end;

-- Built-in names an import alias must not shadow.
def fx_reserved_aliases : List String :=
    [ "Type", "Nat", "String", "List", "IO", "Unit", "Bool", "True", "False", "Nil", "Cons" ];

def fx_capitalize (s : String) : Maybe String :=
    let c : Nat := str_head s in
    match is_lower c with
    | False => Nothing String
    | True => Just String (str_concat (str_of_codes ([sub c ch_space] : List Nat)) (str_tail s))
    end;

-- A bare occurrence of the alias anywhere except after "open" means the name
-- also lives as an ordinary binder, so renaming would be ambiguous.
def fx_alias_only_qualified (alias : String) : List FxTok -> Bool -> Bool :=
  fix go (ts : List FxTok) (after_open : Bool) : Bool :=
    match ts with
    | Nil => True
    | Cons t rest =>
        match andb (fx_is_word t alias) (notb after_open) with
        | True => False
        | False => go rest (orb (fx_is_word t "open") (fx_is_word t "as"))
        end
    end;

def fx_alias_taken (fixed : String) (all : List FxTok) : Bool :=
    let dotted : String := str_concat fixed "." in
    any FxTok (fun (t : FxTok) =>
      andb (fx_is_ident t)
        (orb (str_eq (fx_tok_text t) fixed) (str_starts (fx_tok_text t) dotted))) all;

-- Every token that spells the alias, bare or as a qualifier prefix.
def fx_alias_refs (alias : String) (fixed : String) (all : List FxTok) : List FxEdit :=
    let dotted : String := str_concat alias "." in
    concat_map FxTok FxEdit
      (fun (t : FxTok) =>
        match fx_is_word t alias with
        | True => fx_edit1 (MkFxEdit (fx_tok_start t) (fx_tok_end t) fixed fx_rule_alias (fx_tok_line t)
            (str_cat3 "import alias " (fx_quote alias) (str_concat " renamed to " (fx_quote fixed))))
        | False =>
            match andb (fx_is_ident t) (str_starts (fx_tok_text t) dotted) with
            | False => Nil FxEdit
            | True =>
                let tail_text : String := str_slice (fx_tok_text t) (str_len alias)
                  (sub (str_len (fx_tok_text t)) (str_len alias)) in
                fx_edit1 (MkFxEdit (fx_tok_start t) (fx_tok_end t) (str_concat fixed tail_text)
                  fx_rule_alias (fx_tok_line t)
                  (str_cat3 "qualified reference " (fx_quote (fx_tok_text t))
                    (str_concat " follows alias " (fx_quote fixed))))
            end
        end)
      all;

-- import "path" as alias;  with a lowercase alias  ->  PascalCase alias plus
-- every qualified reference, when the new name is free in the file.
def fx_alias_hit (all : List FxTok) (rest : List FxTok) (prev : List FxTok) : List FxEdit :=
    match rest with
    | Nil => Nil FxEdit
    | Cons alias_tok _ =>
        match prev with
        | Nil => Nil FxEdit
        | Cons p _ =>
            match andb (fx_is_kind p fx_k_str) (fx_is_ident alias_tok) with
            | False => Nil FxEdit
            | True =>
                let alias : String := fx_tok_text alias_tok in
                match fx_capitalize alias with
                | Nothing => Nil FxEdit
                | Just fixed =>
                    match orb (elem String str_eq fixed fx_reserved_aliases)
                          (orb (fx_alias_taken fixed all)
                            (notb (fx_alias_only_qualified alias all False))) with
                    | True => Nil FxEdit
                    | False => fx_alias_refs alias fixed all
                    end
                end
            end
        end
    end;

-- Depth-zero comma split of a bracket group's interior.
def fx_split_top_go : List FxTok -> Nat -> List FxTok -> List (List FxTok) -> List (List FxTok) :=
  fix go (ts : List FxTok) (depth : Nat) (cur : List FxTok) (acc : List (List FxTok))
      : List (List FxTok) :=
    match ts with
    | Nil => reverse_lin (List FxTok) (Cons (List FxTok) (reverse_lin FxTok cur) acc)
    | Cons t rest =>
        match andb (eqNat depth Z) (fx_is_word t ",") with
        | True => go rest depth (Nil FxTok) (Cons (List FxTok) (reverse_lin FxTok cur) acc)
        | False =>
            match fx_opens_bracket t with
            | True => go rest (S depth) (Cons FxTok t cur) acc
            | False =>
                match fx_closes_bracket t with
                | True => go rest (pred depth) (Cons FxTok t cur) acc
                | False => go rest depth (Cons FxTok t cur) acc
                end
            end
        end
    end;

def fx_split_top (ts : List FxTok) : List (List FxTok) :=
    fx_split_top_go ts Z (Nil FxTok) (Nil (List FxTok));

def fx_elem_is_string (el : List FxTok) : Bool :=
    match el with
    | Nil => False
    | Cons t rest =>
        match rest with
        | Nil => fx_is_kind t fx_k_str
        | Cons _ _ => False
        end
    end;

def fx_elem_is_nat (el : List FxTok) : Bool :=
    match el with
    | Nil => False
    | Cons t _ => orb (fx_is_kind t fx_k_num) (orb (fx_is_word t "Z") (fx_is_word t "S"))
    end;

-- Element type of a literal whose elements are all strings or all naturals.
def fx_literal_elem_type (elems : List (List FxTok)) : Maybe String :=
    match elems with
    | Nil => Nothing String
    | Cons _ _ =>
        match all (List FxTok) fx_elem_is_string elems with
        | True => Just String "String"
        | False =>
            match all (List FxTok) fx_elem_is_nat elems with
            | True => Just String "Nat"
            | False => Nothing String
            end
        end
    end;

-- let xs := ["a", "b"] in  ->  let xs : List String := ["a", "b"] in
def fx_bracket_hit (t : FxTok) (rest : List FxTok) (prev : List FxTok) : List FxEdit :=
    match fx_let_untyped prev with
    | Nothing => Nil FxEdit
    | Just name =>
        match st_group_go rest Z ([t] : List FxTok) with
        | Nothing => Nil FxEdit
        | Just grp_at =>
            match grp_at with
            | MkPair grp _ =>
                let interior : List FxTok := match grp with
                  | Nil => Nil FxTok
                  | Cons _ inner => init FxTok inner
                  end in
                match fx_literal_elem_type (fx_split_top interior) with
                | Nothing => Nil FxEdit
                | Just ty =>
                    fx_edit1 (MkFxEdit (fx_tok_end name) (fx_tok_end name)
                      (str_concat " : List " ty) fx_rule_list_type (fx_tok_line t)
                      (str_cat3 "list literal binding " (fx_quote (fx_tok_text name))
                        (str_cat3 " annotated as List " ty "")))
                end
            end
        end
    end;

def fx_simple_at (src : String) (all : List FxTok) (c : Nat) (t : FxTok) (rest : List FxTok)
    (prev : List FxTok) (seen : List String) : FxHit :=
    match eqNat c fx_c_succ with
    | True => MkFxHit (fx_succ_hit t rest prev) seen
    | False =>
    match eqNat c fx_c_open with
    | True =>
        match fx_is_word t "[" with
        | True => MkFxHit (fx_bracket_hit t rest prev) seen
        | False => fx_no_hit seen
        end
    | False =>
    match eqNat c fx_c_semi with
    | True => MkFxHit (fx_semi_hit t prev) seen
    | False =>
    match eqNat c fx_c_cons with
    | True => MkFxHit (fx_cons_hit src t rest prev) seen
    | False =>
    match eqNat c fx_c_nil with
    | True => MkFxHit (fx_nil_hit src t rest prev) seen
    | False =>
    match eqNat c fx_c_import with
    | True => fx_import_hit src t rest seen
    | False =>
    match eqNat c fx_c_as with
    | True => MkFxHit (fx_alias_hit all rest prev) seen
    | False =>
    match eqNat c fx_c_bind with
    | True => MkFxHit (fx_do_bind_hit t prev) seen
    | False => fx_no_hit seen
    end
    end
    end
    end
    end
    end
    end
    end;

def fx_simple_go (src : String) (all : List FxTok) : List FxTok -> List FxTok -> List String -> List FxEdit -> List FxEdit :=
  fix go (ts : List FxTok) (prev : List FxTok) (seen : List String) (acc : List FxEdit)
      : List FxEdit :=
    match ts with
    | Nil => acc
    | Cons t rest =>
        let c : Nat := fx_tok_code t in
        match c with
        | Z => go rest (Cons FxTok t prev) seen acc
        | S _ =>
            match fx_simple_at src all c t rest prev seen with
            | MkFxHit edits seen2 => go rest (Cons FxTok t prev) seen2 (append FxEdit edits acc)
            end
        end
    end;

-- Whole-file syntax rules: imports, aliases, legacy binds, separators, literals.
def fx_simple_rules (src : String) (ts : List FxTok) : List FxEdit :=
    fx_simple_go src ts ts (Nil FxTok) (Nil String) (Nil FxEdit);
