-- Autofix CLI: writes require complete constructor visibility, a converged
-- rewrite plan, and token-preserving canonical formatting. Check mode stays
-- fail-closed on drift or any unavailable prerequisite.

-- @entry main

import "pipeline.ouro",
  "../fmt_paths.ouro",
  "literal_spans.ouro",
  "scan.ouro",
  "candidate_check.ouro",
  "../collect_core.ouro",
  "../quality/source_write.ouro",
  "../quality/path_queue.ouro",
  "../selftest_fs.ouro",
  "../../std/io.ouro",
  "../../std/fs.ouro",
  "../../std/args.ouro",
  "../../std/collections.ouro",
  "../../std/stringx.ouro",
  "../../std/pathx.ouro";

-- Bounded import traversal steps, including already-seen queue entries.
-- Exhaustion is an error, never permission to rewrite with partial facts.
def fx_cone_fuel : Nat := 512;

inductive FxConeError : Type :=
  | FxImportRead : String -> String -> FxConeError
  | FxImportScan : String -> String -> FxConeError
  | FxImportBudget : FxConeError;

def fx_cone_error_message (e : FxConeError) : String :=
    match e with
    | FxImportRead path cause => str_cat4 "cannot read import " path ": " cause
    | FxImportScan path cause => str_cat4 "cannot scan imports in " path ": " cause
    | FxImportBudget => "constructor import traversal exhausted its budget"
    end;

-- Constructor names from the complete import cone. Empty queues succeed
-- even at zero fuel; every nonempty exhausted queue fails explicitly.
def fx_cone_go (fuel : Nat) (pending : List String) (seen : List String) (ctors : List String)
    : IO (Either FxConeError (List String)) :=
  (fix go (remaining : Nat) (queue : PathQueue) (visited : List String) (names : List String)
      : IO (Either FxConeError (List String)) :=
    match remaining with
    | Z => io_pure (Either(FxConeError, List String),
        if path_queue_empty queue then Right FxConeError (List String) names
        else Left FxConeError (List String) FxImportBudget)
    | S next =>
        match path_queue_take queue with
        | PathQueueEnd => io_pure (Either(FxConeError, List String))
            (Right FxConeError (List String) names)
        | PathQueueItem path rest =>
            let normalized : String := path_normalize path in
            if elem String str_eq normalized visited then go next rest visited names
            else
              match! fs_read_checked normalized with
              | Left e => io_pure (Either(FxConeError, List String))
                  (Left FxConeError (List String)
                    (FxImportRead(normalized, fs_error_message e)))
              | Right src => match import_paths src with
                | ColErr error => io_pure (Either(FxConeError, List String))
                    (Left(FxConeError, List String, FxImportScan normalized error))
                | ColOk imports =>
                  go next
                    (path_queue_extend rest
                      (map String String (fx_resolve_import normalized) imports))
                    (Cons String normalized visited)
                    (append String (fx_harvest_ctors src) names)
                end
              end
        end
    end) fuel (path_queue_from pending) seen ctors;

def fx_cone_ctors (path : String) (src : String) : IO (Either FxConeError (List String)) :=
    match import_paths src with
    | ColErr error => io_pure (Either(FxConeError, List String))
        (Left(FxConeError, List String, FxImportScan path error))
    | ColOk imports => fx_cone_go fx_cone_fuel
        (map String String (fx_resolve_import path) imports)
        ([path_normalize path] : List String)
        (Nil String)
    end;

def fx_count_text (edits : List FxEdit) : String :=
    let n : Nat := length FxEdit edits in
    str_cat3(prim_string_of_nat n, " edit", match eqNat(n, S Z) with | True => "" | False => "s" end);

def fx_change_text (edits : List FxEdit) : String :=
    match edits with
    | Nil => "formatting"
    | Cons _ _ => str_cat3 "fixes (" (fx_count_text edits) ")"
    end;

def fx_write (path : String) (original : String) (out : String) (edits : List FxEdit) : IO Bool :=
    match! quality_write_source_checked path original out with
    | Left e =>
        do eprintln (str_cat3 path ": " (fs_error_message e));
           io_pure Bool False
    | Right _ =>
        do println (str_cat3 "fixed " path (str_cat3 " (" (fx_change_text edits) ")"));
           println (str_unlines (fx_report path edits));
           io_pure Bool True
    end

def fx_changed (a : Args) (path : String) (original : String) (out : String) (edits : List FxEdit) : IO Bool :=
    (if args_flag a "check" then
      do eprintln (str_cat3 path ": needs " (fx_change_text edits));
         eprintln (str_unlines (fx_report path edits));
         io_pure Bool False
    else
      if args_flag a "write" then fx_write path original out edits
      else
        do print out;
           io_pure Bool True)

private def fx_checked_outcome_from (a : Args) (path : String) (src : String)
    (baseline : String) (outcome : FxOutcome) : IO Bool :=
    let (MkFxOutcome out edits) := outcome in
    match! fx_check_candidate path baseline out with
    | Left error =>
        do eprintln (fs_error_message error);
           io_pure Bool False
    | Right _ => if str_eq src out then
        if orb(args_flag a "check", args_flag a "write") then io_pure Bool True
        else do print out; io_pure Bool True
      else fx_changed a path src out edits
    end;

def fx_checked_outcome (a : Args) (path : String) (src : String) (outcome : FxOutcome) : IO Bool :=
    fx_checked_outcome_from a path src (fx_check_source src) outcome;

-- No class of edits can become a published candidate without a fresh
-- compiler-worker parse/resolve/type check. Verification uses the in-memory
-- snapshot; writes remain atomic and guarded by original-file identity.
-- The first transition starts at the original source.
private def fx_verify_classes (path : String) (baseline : String) (rounds : FxRoundTransitions)
    : IO (Either FsError Unit) :=
  (fix go (pending : FxRoundTransitions) (first : Maybe String) : IO (Either FsError Unit) :=
    match pending with
    | Nil => fs_ok Unit MkUnit
    | Cons transition rest => let (MkPair src out) := transition in
      let check_source : String := match first with
        | Nothing => fx_check_source src
        | Just original => original
        end in
      match! fx_check_candidate path check_source out with
      | Left error => io_pure(Either FsError Unit, Left FsError Unit error)
      | Right _ => go rest (Nothing String)
      end
    end) rounds (Just String baseline);

private def fx_loaded_converged (a : Args) (path : String) (src : String)
    (baseline : String) (ctors : List String) (converged : FxConverged) : IO Bool :=
    let rounds : FxRoundTransitions := fx_converged_rounds converged in
    match fx_format_converged_with_review converged ctors with
    | Left e =>
        do eprintln (str_cat3 path ": " (fx_prepare_error_message e));
           io_pure Bool False
    | Right formatted => let (MkPair outcome review) := formatted in
        do match review with
           | Nil => io_pure Unit MkUnit
           | Cons _ _ => do eprintln (str_cat3 path ": review-required suggestions (not applied): " (fx_count_text review));
                            eprintln (str_unlines (fx_report path review))
           end;
           match! fx_verify_classes path baseline rounds with
           | Left error => do eprintln (fs_error_message error); io_pure Bool False
           | Right _ => do let! changed := fx_checked_outcome_from a path src baseline outcome;
               io_pure(Bool, andb(changed, notb (andb(args_flag a "check", notb (nullb FxEdit review)))))
           end
    end;

def fx_loaded (a : Args) (path : String) (src : String) : IO Bool :=
    let initial : FxLexedSource := fx_lex_source src in
    let baseline : String := fx_check_source_lexed initial in
    match! fx_cone_ctors path baseline with
    | Left e =>
        do eprintln (str_cat3 path ": fix refused: " (fx_cone_error_message e));
           io_pure Bool False
    | Right ctors =>
        match fx_converge_lexed ctors initial with
        | Left e =>
            do eprintln (str_cat3 path ": " (fx_prepare_error_message e));
               io_pure Bool False
        | Right converged => fx_loaded_converged a path src baseline ctors converged
        end
    end

def fx_one (a : Args) (path : String) : IO Bool :=
    tool_apply_to_file (fx_loaded a) path;

def fx_run (a : Args) : IO Unit :=
    tool_run_paths "usage: ouro-fix [--check | --write] PATH..." (fx_one a) a;

-- Selftest inputs and expected rewrites come from the generated fixture root.
-- Each expected output must also be a fixpoint.

def fx_fixture_name (entry : String) : Maybe String :=
    if str_ends entry ".in" then Just(String, str_slice entry Z (sub(str_len entry, 3)))
    else Nothing String;

def fx_filter_map_string (f : String -> Maybe String) : List String -> List String :=
    filter_map String String f;

def fx_fixture_names (fixtures : String) : IO (List String) :=
    do let! entries := fs_list fixtures;
       io_pure(List String, str_sort (fx_filter_map_string fx_fixture_name entries))

def fx_selftest_lf (text : String) : String :=
    str_replace text "\r" "";

def fx_selftest_read (path : String) : IO String :=
    selftest_fs_read "FIX_SUITE: FAIL " path;

def fx_selftest_write (path : String) (content : String) : IO Unit :=
    selftest_fs_require "FIX_SUITE: FAIL " (fs_write_checked path content);

def fx_safety_report (ok : Bool) (row : Pair String Bool) : IO Bool :=
    let (MkPair name passed) := row in
    do if passed then println (str_concat "FIX_SAFE_OK " name)
      else eprintln (str_concat "FIX_SAFE_FAIL " name);
       io_pure(Bool, andb ok passed);

-- These exercise the production import reader and --write path, not a mock.
-- All materialized files are owned selftest output. A stale absent-target
-- fixture is a test failure rather than an opportunity to erase a file.
def fx_selftest_safety (out : String) : IO Bool :=
    let good_path : String := fs_child out "precision-good.ouro" in
    let anchor_path : String := fs_child out "precision-anchor.ouro" in
    let dep_path : String := fs_child out "precision-dep.ouro" in
    let leaf_path : String := fs_child out "precision-leaf.ouro" in
    let bad_path : String := fs_child out "precision-missing.ouro" in
    let grouped_bad_path : String := fs_child out "precision-grouped-missing.ouro" in
    let malformed_path : String := fs_child out "precision-malformed.ouro" in
    let good_src : String := "import -- before first\n  \"precision-anchor.ouro\", -- before second\n  \"precision-dep.ouro\",;\n" in
    let bad_src : String := "import \"precision-absent.ouro\";\ndef f : Nat:=0;\n" in
    let grouped_bad_src : String := "import \"precision-anchor.ouro\", \"precision-absent.ouro\";\ndef f : Nat:=0;\n" in
    let malformed_src : String := "import \"precision-anchor.ouro\", missing;\n" in
    let write_args : Args := args_of_argv_bools
      (["write"] : List String) (["ouro-fix", "--write"] : List String) in
    do fx_selftest_write good_path good_src;
       fx_selftest_write anchor_path "import \"precision-leaf.ouro\";\ninductive Anchor : Type :=\n  | anchor : Anchor;\n";
       fx_selftest_write dep_path
         "import \"precision-good.ouro\", \"precision-leaf.ouro\";\ninductive Flag : Type :=\n  | on : Flag\n  | off : Flag;\n";
       fx_selftest_write leaf_path "inductive Leaf : Type :=\n  | late : Leaf;\n";
       fx_selftest_write bad_path bad_src;
       fx_selftest_write grouped_bad_path grouped_bad_src;
       fx_selftest_write malformed_path malformed_src;
       let! absent_exists := fs_exists (fs_child out "precision-absent.ouro");
       let! empty := fx_cone_go(Z, Nil String, Nil String, ["on"] : List String);
       let! limited := fx_cone_go(Z, [good_path] : List String, Nil String, Nil String);
       let! duplicate_budget := fx_cone_go 4 [anchor_path, dep_path] [path_normalize good_path] [];
       let! visible := fx_cone_ctors good_path good_src;
       let! transitive := fx_cone_ctors (fs_child out "precision-nested.ouro")
         "import \"precision-good.ouro\";\n";
       let! malformed := fx_cone_ctors malformed_path malformed_src;
       let! transitive_malformed := fx_cone_ctors (fs_child out "precision-nested.ouro")
         "import \"precision-malformed.ouro\";\n";
       let! written := fx_one write_args bad_path;
       let! unchanged := fx_selftest_read bad_path;
       let! grouped_written := fx_one write_args grouped_bad_path;
       let! grouped_unchanged := fx_selftest_read grouped_bad_path;
       io_fold (Pair String Bool) Bool fx_safety_report True
         ([ MkPair String Bool "empty-cone-at-zero-budget"
              (match empty with
               | Left _ => False
               | Right names => elem String str_eq "on" names
               end)
          , MkPair String Bool "incomplete-cone-is-an-error"
              (match limited with
               | Left e => match e with
                 | FxImportBudget => True | FxImportRead _ _ => False | FxImportScan _ _ => False end
               | Right _ => False
               end)
          , MkPair String Bool "duplicate-cone-edge-spends-a-queue-step"
              (match duplicate_budget with
               | Left error => if let FxImportBudget := (error : FxConeError) then True else False
               | Right _ => False
               end)
          , MkPair String Bool "constructor-order-follows-the-breadth-first-cone"
              (match visible with
               | Left _ => False
               | Right names => list_eq String str_eq names ["late", "on", "off", "anchor"]
               end)
          , MkPair String Bool "cyclic-cone-keeps-lowercase-constructors"
              (match visible with
               | Left _ => False
               | Right names => andb (elem String str_eq "on" names)
                   (elem String str_eq "off" names)
               end)
          , MkPair String Bool "missing-import-never-writes"
              (andb(notb absent_exists, andb(notb written, str_eq bad_src unchanged)))
          , MkPair String Bool "transitive-group-keeps-lowercase-constructors"
              (match transitive with
               | Left _ => False
               | Right names => andb (elem String str_eq "on" names)
                   (elem String str_eq "off" names)
               end)
          , MkPair String Bool "malformed-root-import-is-an-error"
              (match malformed with
               | Left error => match error with
                 | FxImportScan path _ => str_eq path malformed_path
                 | FxImportRead _ _ => False | FxImportBudget => False end
               | Right _ => False
               end)
          , MkPair String Bool "malformed-transitive-import-is-an-error"
              (match transitive_malformed with
               | Left error => match error with
                 | FxImportScan path _ => str_eq(path, path_normalize malformed_path)
                 | FxImportRead _ _ => False | FxImportBudget => False end
               | Right _ => False
               end)
          , MkPair String Bool "missing-second-import-never-writes"
              (andb (notb absent_exists)
                (andb(notb grouped_written, str_eq grouped_bad_src grouped_unchanged)))
          ] : List (Pair String Bool))


def fx_fixture_issue (actual : String) (expected : String) (again : String) : String :=
    if str_eq actual expected then if str_eq again expected then "" else "idempotence" else "output";

def fx_selftest_fixture (fixtures : String) (out : String) (name : String) : IO Bool :=
    do let! source := fx_selftest_read (fs_child(fixtures, str_concat name ".in"));
       let! golden := fx_selftest_read (fs_child(fixtures, str_concat name ".golden"));
       let expected : String := fx_selftest_lf golden in
       let outcome : FxOutcome := fx_fix(Nil String, fx_selftest_lf source) in
       let actual : String := fx_outcome_text outcome in
       let again : String := fx_fix_string(Nil String, expected) in
       let issue : String := fx_fixture_issue actual expected again in
       do fx_selftest_write(fs_child(out, str_concat name ".out"), actual);
          fx_selftest_write(fs_child(out, str_concat name ".again"), again);
          fx_selftest_write (fs_child(out, str_concat name ".report"))
            (str_unlines (fx_report(name, fx_outcome_edits outcome)));
          (if str_null issue then
            do println (str_concat "FIX_OK " name);
                       io_pure Bool True
          else
            do eprintln (str_cat4 "FIX_FAIL " name " " issue);
                        io_pure Bool False)

def fx_selftest_and (fixtures : String) (out : String) (ok : Bool) (name : String) : IO Bool :=
    do let! one := fx_selftest_fixture fixtures out name;
       io_pure(Bool, andb ok one)

def run_fix_selftest (a : Args) : IO Unit :=
    let fixtures : String := args_opt_or a "fixtures" "_build/smith/fixtures/fix" in
    let out : String := args_opt_or a "out" "_build/fix_suite" in
    match! fs_mkdir_p_checked out with
    | Left e => do eprintln (str_concat("FIX_SUITE: FAIL ", fs_error_message e));
                   exit (S Z)
    | Right _ =>
        do let! names := fx_fixture_names fixtures;
           let! ok := io_fold String Bool (fx_selftest_and fixtures out) True names;
           let! safe := fx_selftest_safety out;
           match andb safe
               (andb(ok, match names with | Nil => False | Cons _ _ => True end)) with
           | True => do println (str_cat3 "FIX_SUITE: PASS rows="
                         (prim_string_of_nat (length String names)) (str_concat " out=" out));
                        exit Z
           | False => do eprintln (str_cat3 "FIX_SUITE: FAIL rows="
                         (prim_string_of_nat (length String names)) "");
                         exit (S Z)
           end
    end

def fx_switches : List String :=
    [ "check", "write", "selftest" ];

def fx_selftest_option_valid (a : Args) (name : String) : Bool :=
    andb (str_set_mem(name, ["out", "fixtures"] : List String))
      (notb (str_null (args_opt_or a name "")));

def fx_mode_args_valid (a : Args) : Bool :=
    if args_flag a "selftest" then
      andb (all String (fun (name : String) => str_eq name "selftest")
        (args_flags a))
        (andb (all String (fx_selftest_option_valid a)
          (map_keys(String, args_opts a)))
          (match args_positional a with | Nil => True | Cons _ _ => False end))
    else
      andb (notb (andb(args_flag a "check", args_flag a "write")))
        (andb (all String
          (fun (name : String) => str_set_mem(name, ["check", "write"] : List String))
          (args_flags a))
          (match map_keys(String, args_opts a) with
           | Nil => True
           | Cons _ _ => False
           end));

def fx_cli (argv : List String) : IO Unit :=
    let a : Args := args_of_argv_bools fx_switches argv in
    (if andb(args_argv_options_complete fx_switches argv, fx_mode_args_valid a) then
      if args_flag a "selftest" then run_fix_selftest a else fx_run a
    else
      do eprintln "fix: invalid arguments";
         eprintln "usage: ouro-fix [--check | --write] PATH...";
         exit 2);

def main : IO Unit :=
    do let! argv := prim_argv;
       if str_eq(nth String "" (S Z) argv, "--literal-spans") then
         fx_literal_run (tail(String, tail String argv))
       else fx_cli argv
