-- Structured certificates for the automatic syntax-only subset. Semantic
-- rewrites need compiler-owned binder/span/effect certificates and stay review
-- required. A rule ID and replacement string alone cannot authorize a round.
import "plan.ouro",
  "basic_rules.ouro";

inductive FxSyntaxProof : Type :=
  | FxDuplicateImportProof : String -> FxSyntaxProof
  | FxLegacyBindProof : String -> FxSyntaxProof
  | FxRedundantSeparatorProof : Nat -> FxSyntaxProof;
inductive FxCertifiedEdit : Type :=
  | FxCertified : FxSyntaxProof -> FxEdit -> FxCertifiedEdit;
def fx_certified_edit (proof : FxCertifiedEdit) : FxEdit :=
    match proof with | FxCertified _ edit => edit end;

private def fx_prepend_certificates (proof : FxSyntaxProof) (edits : List FxEdit)
    (rev : List FxCertifiedEdit) : List FxCertifiedEdit :=
    foldl FxEdit (List FxCertifiedEdit)
      (fun (acc : List FxCertifiedEdit) (edit : FxEdit) =>
        Cons FxCertifiedEdit (FxCertified proof edit) acc) rev edits;

-- The raw import scanner accepts loose tails and skips repeated `as` tokens.
-- Those clauses must not seed or receive duplicate-import certificates.
private def fx_import_has_syntax_proof (tokens : List FxTok) : Bool :=
    match tokens with
    | Nil => False
    | Cons path rest => if fx_is_kind path fx_k_str then
        match rest with
        | Nil => False
        | Cons clause after => if fx_is_word clause ";" then True
          else
            match after with
            | Nil => False
            | Cons alias tail => andb (fx_is_word clause "as")
                (andb (fx_is_ident alias)
                  (andb (notb (fx_is_word alias "as"))
                    (fx_is_word (fx_first_tok tail) ";")))
            end
        end
      else False
    end;

-- The token walker creates a certificate only at the corresponding grammar
-- pattern. Literal/comment bytes cannot be mistaken for syntax. Whole-fragment
-- trivia safety is independently checked by the planner before publication.
def fx_syntax_certificates (src : String) (tokens : List FxTok) : List FxCertifiedEdit :=
    (fix go (remaining : List FxTok) (previous : List FxTok) (imports : List String)
        (rev : List FxCertifiedEdit) : List FxCertifiedEdit :=
      match remaining with
      | Nil => reverse_lin FxCertifiedEdit rev
      | Cons token rest =>
          let history : List FxTok := Cons FxTok token previous in
          if fx_is_word token "import" then
            if fx_import_has_syntax_proof rest then
              let (MkFxHit edits seen) := fx_import_hit src token rest imports in
              go rest history seen (fx_prepend_certificates
                (FxDuplicateImportProof (fx_tok_text (fx_first_tok rest))) edits rev)
            else go rest history imports rev
          else
            let next : List FxCertifiedEdit :=
              if fx_is_word token "<-" then
                fx_prepend_certificates (FxLegacyBindProof (fx_tok_text (fx_first_tok previous)))
                  (fx_do_bind_hit token previous) rev
              else if fx_is_word token ";" then
                fx_prepend_certificates (FxRedundantSeparatorProof (fx_tok_start (fx_first_tok previous)))
                  (fx_semi_hit token previous) rev
              else rev in
            go rest history imports next
      end) tokens [] [] [];

-- Linear merge of sorted planned spans and freshly derived certificates.
-- Equal spans with another rule/replacement are NOT interchangeable proofs.
def fx_certificate_at (edit : FxEdit) : List FxCertifiedEdit -> List FxCertifiedEdit :=
  fix go (certificates : List FxCertifiedEdit) : List FxCertifiedEdit :=
    match certificates with
    | Nil => []
    | Cons certificate rest => match ltb_nat(fx_edit_start (fx_certified_edit certificate), fx_edit_start edit) with
      | True => go rest | False => certificates end
    end;

def fx_select_certificates : List FxEdit -> List FxCertifiedEdit -> Either FxPlanError (List FxCertifiedEdit) :=
  fix go (edits : List FxEdit) (certificates : List FxCertifiedEdit)
      : Either FxPlanError (List FxCertifiedEdit) :=
    match edits with
    | Nil => Right FxPlanError (List FxCertifiedEdit) []
    | Cons edit rest => match fx_certificate_at edit certificates with
      | Nil => Left FxPlanError (List FxCertifiedEdit) FxPlanNoSyntaxProof
      | Cons certificate more =>
          let proven : FxEdit := fx_certified_edit certificate in
          if andb(fx_same_edit edit proven, str_eq(fx_edit_rule edit, fx_edit_rule proven)) then
            match go rest more with
            | Left error => Left FxPlanError (List FxCertifiedEdit) error
            | Right tail => Right(FxPlanError, List FxCertifiedEdit, Cons FxCertifiedEdit certificate tail)
            end
          else Left FxPlanError (List FxCertifiedEdit) FxPlanProofDisagree
      end
    end;

-- The transaction retains ONE source snapshot, not one copy per edit. No disk
-- mutation happens here. The caller must still compiler-check before publish.
inductive FxTransactionProof : Type :=
  | FxTransaction : String -> String -> List FxCertifiedEdit -> FxTransactionProof;
def fx_transaction_source (proof : FxTransactionProof) : String :=
    match proof with | FxTransaction value _ _ => value end;
def fx_transaction_output (proof : FxTransactionProof) : String :=
    match proof with | FxTransaction _ value _ => value end;
def fx_transaction_edits (proof : FxTransactionProof) : List FxEdit :=
    match proof with | FxTransaction _ _ edits => map FxCertifiedEdit FxEdit fx_certified_edit edits end;

private def FxProofWithOutput : Type := Pair FxTransactionProof (Maybe FxLexedSource);

private def fx_certify_disjoint_using (lex : String -> List FxTok)
    (src : String) (edits : List FxEdit) : Either FxPlanError FxProofWithOutput :=
    match edits with
    | Nil => Right FxPlanError FxProofWithOutput
        (MkPair FxTransactionProof (Maybe FxLexedSource) (FxTransaction src src []) (Nothing FxLexedSource))
    | Cons _ _ =>
        let certificates : List FxCertifiedEdit := fx_syntax_certificates(src, lex src) in
        let sorted : List FxCertifiedEdit := quality_sort FxCertifiedEdit
          (fun (a : FxCertifiedEdit) (b : FxCertifiedEdit) =>
            fx_edit_before(fx_certified_edit a, fx_certified_edit b)) certificates in
        match fx_select_certificates edits sorted with
        | Left error => Left FxPlanError FxProofWithOutput error
        | Right selected => if
            all FxEdit (fun (edit : FxEdit) =>
              andb(fx_valid_edit src edit, fx_edit_preserves_trivia src edit)) edits then
            let out : String := fx_apply src edits in
            let before : Nat := length FxCertifiedEdit certificates in
            let output : FxLexedSource := fx_lex_source out in
            let after : Nat := length(FxCertifiedEdit, fx_syntax_certificates(out, fx_lexed_tokens output)) in
            if ltb_nat after before then
              Right FxPlanError FxProofWithOutput
                (MkPair FxTransactionProof (Maybe FxLexedSource)
                  (FxTransaction src out selected) (Just FxLexedSource output))
            else Left FxPlanError FxProofWithOutput FxPlanProofNotDecreasing
          else Left FxPlanError FxProofWithOutput FxPlanTriviaLost
        end
    end;

private def fx_certified_proof_only (checked : Either FxPlanError FxProofWithOutput)
    : Either FxPlanError FxTransactionProof :=
    match checked with
    | Left error => Left FxPlanError FxTransactionProof error
    | Right result => let (MkPair proof _) := result in Right FxPlanError FxTransactionProof proof
    end;

-- Disjointness is rechecked at the proof boundary, not merely assumed from
-- the caller's planner. Input must already be normalized and ordered.
private def fx_certify_transaction_using (lex : String -> List FxTok)
    (src : String) (edits : List FxEdit) : Either FxPlanError FxProofWithOutput :=
    match fx_disjoint_checked edits (Nothing FxEdit) [] with
    | Left error => Left FxPlanError FxProofWithOutput error
    | Right checked => if eq_nat(length FxEdit edits, length FxEdit checked) then
        fx_certify_disjoint_using lex src checked
      else Left FxPlanError FxProofWithOutput FxPlanDuplicateEdits
    end;

def fx_certify_transaction (src : String) (edits : List FxEdit) : Either FxPlanError FxTransactionProof :=
    fx_certified_proof_only (fx_certify_transaction_using fx_lex src edits);

private def fx_certify_lexed_using (source : FxLexedSource) (edits : List FxEdit)
    : Either FxPlanError FxProofWithOutput :=
    fx_certify_transaction_using (fun (_ : String) => fx_lexed_tokens source) (fx_lexed_text source) edits;

def fx_certify_lexed_transaction (source : FxLexedSource) (edits : List FxEdit)
    : Either FxPlanError FxTransactionProof :=
    fx_certified_proof_only (fx_certify_lexed_using source edits);

def fx_certify_lexed_transaction_with_output (source : FxLexedSource) (edits : List FxEdit)
    : Either FxPlanError (Pair FxTransactionProof FxLexedSource) :=
    match fx_certify_lexed_using source edits with
    | Left error => Left FxPlanError (Pair FxTransactionProof FxLexedSource) error
    | Right result =>
        let (MkPair proof output) := result in
        let snapshot : FxLexedSource := match output with | Nothing => source | Just scanned => scanned end in
        Right FxPlanError (Pair FxTransactionProof FxLexedSource) (MkPair FxTransactionProof FxLexedSource proof snapshot)
    end;

-- Stale source cannot reuse a certificate. Each fix round reparses/re-resolves
-- via the compiler companion and derives new certificates from its own snapshot.
def fx_transaction_matches (source : String) (proof : FxTransactionProof) : Bool :=
    str_eq(source, fx_transaction_source proof);
