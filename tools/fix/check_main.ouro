-- Isolated compiler check for a proposed source. The original root identity
-- is retained when candidate bytes arrive over a bounded stdin frame. Import
-- discovery uses the existing collector; acceptance belongs to the compiler.
import "../../std/text.ouro";
import "../../std/io.ouro";
import "../../std/fs.ouro";
import "../collect_core.ouro";
import "../../compiler/driver.ouro";
import "../../compiler/pipeline_abi.ouro";
import "../quality/source.ouro";

def fx_check_fuel_seconds : Nat := 60;
def fx_check_fuel_ms_scale : Nat := 1000;
def fx_check_fuel : Nat := mul fx_check_fuel_seconds fx_check_fuel_ms_scale;
def fx_check_byte_page : Nat := 128;
def fx_check_byte_unit : Nat := 256;

-- Total-unit bound as a literal countdown. Each distinct unit consumes one;
-- the 513th is refused before compilation. A literal decremented by match
-- stays exact; counting up with length would saturate at 64 on the C host,
-- which also silently disabled the previous post-collection check.
def fx_check_budget : Nat := 512;

-- Local import fold threading the total budget across siblings. Import
-- discovery still uses the shared import_paths; the shared collect_core
-- traversal is untouched so the build driver keeps its depth-only fuel.
def fx_after
    (walk : List String -> List String -> String -> Nat -> IO (Pair Col Nat))
    (seen : List String) (vis : List String) (path : String) (src : String)
    (budget : Nat) : IO (Pair Col Nat) :=
  match import_paths src with
  | ColErr error => io_pure (Pair Col Nat)
      (MkPair Col Nat
        (ColErr (str_concat error (str_concat " in " path))) budget)
  | ColOk imports =>
    do let! acc :=
         io_fold String (Pair Col Nat)
           (fun (st : Pair Col Nat) (i : String) =>
             match st with
             | MkPair col b => match col with
               | ColErr e => io_pure (Pair Col Nat) (MkPair Col Nat (ColErr e) b)
               | ColOk seen2 => walk seen2 vis i b
               end
             end)
           (MkPair Col Nat (ColOk seen) budget)
           (map String String (collect_path_resolve path) imports);
       match acc with
       | MkPair col b => match col with
         | ColErr e => io_pure (Pair Col Nat) (MkPair Col Nat (ColErr e) b)
         | ColOk seen2 => io_pure (Pair Col Nat)
             (MkPair Col Nat (ColOk (add_unit path seen2)) b)
         end
       end
  end;

def fx_file
    (walk : List String -> List String -> String -> Nat -> IO (Pair Col Nat))
    (seen : List String) (vis : List String) (path : String)
    (budget : Nat) : IO (Pair Col Nat) :=
  do let! ex := fs_exists path;
     match ex with
     | False => io_pure (Pair Col Nat)
         (MkPair Col Nat
           (ColErr (str_concat "collect_units: missing " path)) budget)
     | True =>
         do let! loaded := fs_read_checked path;
            match loaded with
            | Left e => io_pure (Pair Col Nat)
                (MkPair Col Nat
                  (ColErr (str_concat "collect_units: could not read "
                    (str_concat path (str_concat ": " (fs_error_message e)))))
                  budget)
            | Right src => fx_after walk seen vis path src budget
            end
     end

def fx_check_collect (root : String) (source : String)
    : Nat -> Nat -> List String -> List String -> String -> IO (Pair Col Nat) :=
  fix walk (fuel : Nat) (budget : Nat) (seen : List String) (visiting : List String)
      (spelling : String) : IO (Pair Col Nat) :=
    match fuel with
    | Z => io_pure (Pair Col Nat)
        (MkPair Col Nat (ColErr "fix check import budget exhausted") budget)
    | S remaining =>
        let path : String := collect_path_normalize spelling in
        match elem String str_eq path seen with
        | True => io_pure (Pair Col Nat) (MkPair Col Nat (ColOk seen) budget)
        | False => match elem String str_eq path visiting with
          | True => io_pure (Pair Col Nat)
              (MkPair Col Nat
                (ColErr (str_concat "fix check import cycle: " path)) budget)
          | False => match budget with
            | Z => io_pure (Pair Col Nat)
                (MkPair Col Nat (ColErr "fix check unit budget exhausted") Z)
            | S budget2 =>
                let next : List String -> List String -> String -> Nat -> IO (Pair Col Nat) :=
                  fun (known : List String) (active : List String) (target : String) (b : Nat) =>
                    walk remaining b known active target in
                let active : List String := Cons String path visiting in
                match str_eq path root with
                | True => fx_after next seen active path source budget2
                | False => fx_file next seen active path budget2
                end
            end
          end
        end
    end;

def FxCheckFiles : Type := List (Pair (List Nat) (List Nat));

def fx_check_read (root : String) (source : String)
    : List String -> IO (Either QualityInputError FxCheckFiles) :=
  fix read (paths : List String) : IO (Either QualityInputError FxCheckFiles) :=
    match paths with
    | Nil => io_pure (Either QualityInputError FxCheckFiles)
        (Right QualityInputError FxCheckFiles ([] : List (Pair (List Nat) (List Nat))))
    | Cons path rest =>
        do let! loaded := match str_eq path root with
           | True => io_pure (Either QualityInputError String) (Right QualityInputError String source)
           | False => quality_read_file path end;
           match loaded with
           | Left error => io_pure (Either QualityInputError FxCheckFiles) (Left QualityInputError FxCheckFiles error)
           | Right text =>
               do let! remaining := read rest;
                  io_pure (Either QualityInputError FxCheckFiles)
                    (match remaining with
                     | Left error => Left QualityInputError FxCheckFiles error
                     | Right files => Right QualityInputError FxCheckFiles
                         (Cons (Pair (List Nat) (List Nat))
                           (MkPair (List Nat) (List Nat) (prim_string_to_char_codes path)
                             (prim_string_to_char_codes text)) files)
                     end)
           end
    end;

def fx_check_fail (message : String) : IO Unit :=
    do eprintln (str_concat "fix check: " message); exit 1

def fx_check_usage : IO Unit :=
    do eprintln "usage: ouro-fix-check SOURCE STDIN_BYTES";
       eprintln "       ouro-fix-check SOURCE file PATH";
       exit 2

def fx_check_byte_budget (size : Nat) : Bool :=
    leb_nat size (mul fx_check_byte_page (mul fx_check_byte_unit fx_check_byte_unit))

def fx_check_loaded (root : String) (source : String) : IO Unit :=
    do let! collected := fx_check_collect root source collect_fuel fx_check_budget [] [] root;
       match collected with
       | MkPair col remaining => match col with
         | ColErr message => fx_check_fail message
         | ColOk paths => match paths with
           | Nil => fx_check_fail "empty import inventory"
           | Cons _ _ =>
               do let! loaded := fx_check_read root source paths;
                  match loaded with
                  | Left error => fx_check_fail (quality_input_message error)
                  | Right files => match compile_checked_units fx_check_fuel (prim_string_to_char_codes root) files with
                    | CErr error => match error with
                      | ErrCode code detail => fx_check_fail
                          (str_join ":" ["compiler rejected source", prim_string_of_nat code, prim_string_of_nat detail])
                      end
                    | COk _ => println (str_join "\t" ["ouro.fix-check.v1", prim_string_of_nat (str_len source),
                        prim_string_of_nat (sub fx_check_budget remaining), "complete"])
                    end
                  end
           end
         end
       end

def fx_check_source_text (root : String) (source : String) : IO Unit :=
    match fx_check_byte_budget (str_len source) with
    | False => fx_check_fail "source byte budget exhausted"
    | True => fx_check_loaded root source
    end

def fx_check_root (root : String) : IO (Either QualityInputError Unit) :=
    do let! original := quality_read_file root;
       match original with
       | Left error => io_pure (Either QualityInputError Unit)
           (Left QualityInputError Unit error)
       | Right _ => io_pure (Either QualityInputError Unit)
           (Right QualityInputError Unit MkUnit)
       end

def fx_check_stdin (root : String) (count : String) : IO Unit :=
    do let! ready := fx_check_root root;
       match ready with
       | Left error => fx_check_fail (quality_input_message error)
       | Right _ => match str_parse_nat count with
         | Nothing => fx_check_fail "invalid stdin byte count"
         | Just expected => match fx_check_byte_budget expected with
           | False => fx_check_fail "source byte budget exhausted"
           | True =>
               do let! text := prim_stdin_read_bytes (S expected);
                  match eq_nat expected (str_len text) with
                  | False => fx_check_fail "incomplete or excess stdin bytes"
                  | True => fx_check_loaded root text
                  end
           end
         end
       end

def fx_check_file (root : String) (candidate : String) : IO Unit :=
    do let! ready := fx_check_root root;
       match ready with
       | Left error => fx_check_fail (quality_input_message error)
       | Right _ =>
           do let! loaded := quality_read_file candidate;
              match loaded with
              | Left error => fx_check_fail (quality_input_message error)
              | Right text => fx_check_source_text root text
              end
       end

def main : IO Unit :=
    do let! argv := prim_argv;
       match eq_nat (length String argv) 3 with
       | True => fx_check_stdin (collect_path_normalize (nth String "" 1 argv))
           (nth String "" 2 argv)
       | False => match andb (eq_nat (length String argv) 4)
           (str_eq (nth String "" 2 argv) "file") with
         | True => fx_check_file (collect_path_normalize (nth String "" 1 argv))
             (collect_path_normalize (nth String "" 3 argv))
         | False => fx_check_usage
         end
       end
