-- Isolated compiler check for a proposed source. The original root identity
-- is retained when candidate bytes arrive over a bounded stdin frame. Import
-- discovery uses the existing collector; acceptance belongs to the compiler.
import "../../std/text.ouro",
  "../../std/io.ouro",
  "../../std/fs.ouro",
  "../collect_core.ouro",
  "../../compiler/driver.ouro",
  "../../compiler/pipeline_abi.ouro",
  "../quality/source.ouro";

def fx_check_fuel_seconds : Nat := 60;
def fx_check_fuel_ms_scale : Nat := 1000;
def fx_check_fuel : Nat := mul fx_check_fuel_seconds fx_check_fuel_ms_scale;
def fx_check_byte_page : Nat := 128;
def fx_check_byte_unit : Nat := 256;

-- Total-unit bound as a literal countdown. Each distinct unit consumes one;
-- the 513th is refused before compilation. A literal decremented by match
-- stays exact; counting up with length would saturate at 64 on the C host,
-- which also silently disabled the previous post-collection check.
def fx_check_budget : Nat := 512;

private inductive FxCapturedUnit : Type :=
  | FxCapturedSource : String -> String -> Bool -> FxCapturedUnit;

private def FxCapturedUnits : Type := List FxCapturedUnit;

private def FxCaptureResult : Type := Pair (Either String FxCapturedUnits) Nat;

private def fx_capture_result (units : Either String FxCapturedUnits) (budget : Nat) : IO FxCaptureResult :=
    io_pure FxCaptureResult (MkPair (Either String FxCapturedUnits) Nat units budget);

private def fx_capture_after
    (walk : FxCapturedUnits -> List String -> String -> Nat -> IO FxCaptureResult)
    (seen : FxCapturedUnits) (vis : List String) (path : String) (src : String)
    (regular : Bool) (budget : Nat) : IO FxCaptureResult :=
  match import_paths src with
  | ColErr error => fx_capture_result (Left String FxCapturedUnits (str_cat3 error " in " path)) budget
  | ColOk imports =>
    do let! acc :=
         io_fold String FxCaptureResult
           (fun (state : FxCaptureResult) (dependency : String) =>
             let (MkPair units remaining) := state in
             match units with
             | Left _ => io_pure FxCaptureResult state
             | Right captured => walk captured vis (collect_path_resolve path dependency) remaining
             end)
           (MkPair (Either String FxCapturedUnits) Nat (Right String FxCapturedUnits seen) budget) imports;
       let (MkPair units remaining) := acc in
       match units with
       | Left _ => io_pure FxCaptureResult acc
       | Right captured => fx_capture_result
           (Right String FxCapturedUnits (Cons FxCapturedUnit (FxCapturedSource path src regular) captured)) remaining
       end
  end;

private def fx_source_is_regular (path : String) : IO Bool :=
    do let! kind := prim_fs_kind path;
       io_pure Bool (eq_nat kind (S Z));

private def fx_capture_file
    (walk : FxCapturedUnits -> List String -> String -> Nat -> IO FxCaptureResult)
    (seen : FxCapturedUnits) (vis : List String) (path : String)
    (budget : Nat) : IO FxCaptureResult :=
  do let! ex := fs_exists path;
     (if ex then
       do let! regular := fx_source_is_regular path;
          match! fs_read_checked path with
          | Left e => fx_capture_result (Left String FxCapturedUnits
              (str_concat "collect_units: could not read " (str_cat3 path ": " (fs_error_message e)))) budget
          | Right src => fx_capture_after walk seen vis path src regular budget
          end
     else
       fx_capture_result (Left String FxCapturedUnits (str_concat "collect_units: missing " path)) budget);

private def fx_check_capture (root : String) (source : String)
    : Nat -> Nat -> FxCapturedUnits -> List String -> String -> IO FxCaptureResult :=
  fix walk (fuel : Nat) (budget : Nat) (seen : FxCapturedUnits) (visiting : List String)
      (spelling : String) : IO FxCaptureResult :=
    match fuel with
    | Z => fx_capture_result (Left String FxCapturedUnits "fix check import budget exhausted") budget
    | S remaining =>
        let path : String := collect_path_normalize spelling in
        if any FxCapturedUnit (fun (unit : FxCapturedUnit) =>
            match unit with | FxCapturedSource name _ _ => str_eq path name end) seen then
          fx_capture_result (Right String FxCapturedUnits seen) budget
        else
          if elem String str_eq path visiting then
            fx_capture_result (Left String FxCapturedUnits (str_concat "fix check import cycle: " path)) budget
          else
            match budget with
            | Z => fx_capture_result (Left String FxCapturedUnits "fix check unit budget exhausted") Z
            | S budget2 =>
                let next (known : FxCapturedUnits) (active : List String) (target : String)
                    (rest : Nat) : IO FxCaptureResult := walk remaining rest known active target in
                let active : List String := Cons String path visiting in
                if str_eq path root then fx_capture_after next seen active path source True budget2
                else fx_capture_file next seen active path budget2
            end
    end;

def FxCheckFiles : Type := List (Pair(List Nat, List Nat));

-- Report discovery failures first, then validate file kinds in dependency order.
private def fx_check_captured_files (root : String)
    : FxCapturedUnits -> IO (Either QualityInputError FxCheckFiles) :=
  fix prepare (units : FxCapturedUnits) : IO (Either QualityInputError FxCheckFiles) :=
    match units with
    | Nil => io_pure (Either QualityInputError FxCheckFiles)
        (Right QualityInputError FxCheckFiles (Nil (Pair (List Nat) (List Nat))))
    | Cons unit rest => let (FxCapturedSource path text regular) := unit in
        do let! current := if str_eq path root then io_pure Bool True else fx_source_is_regular path;
           if andb regular current then
               match! prepare rest with
               | Left error => io_pure (Either QualityInputError FxCheckFiles)
                   (Left QualityInputError FxCheckFiles error)
               | Right files => io_pure (Either QualityInputError FxCheckFiles)
                   (Right QualityInputError FxCheckFiles (Cons (Pair (List Nat) (List Nat))
                     (MkPair (List Nat) (List Nat) (prim_string_to_char_codes path)
                       (prim_string_to_char_codes text)) files))
               end
           else io_pure (Either QualityInputError FxCheckFiles)
               (Left QualityInputError FxCheckFiles (QualityExpectedFile path))
    end;

def fx_check_fail (message : String) : IO Unit :=
    do eprintln (str_concat "fix check: " message); exit 1

def fx_check_usage : IO Unit :=
    do eprintln "usage: ouro-fix-check SOURCE STDIN_BYTES";
       eprintln "       ouro-fix-check SOURCE file PATH";
       exit 2

def fx_check_byte_budget (size : Nat) : Bool :=
    leb_nat(size, mul(fx_check_byte_page, mul fx_check_byte_unit fx_check_byte_unit))

def fx_check_loaded (root : String) (source : String) : IO Unit :=
    do let! captured := fx_check_capture root source collect_fuel fx_check_budget
         (Nil FxCapturedUnit) (Nil String) root;
       (let (MkPair result remaining) := captured in
       match result with
       | Left message => fx_check_fail message
       | Right units => match units with
         | Nil => fx_check_fail "empty import inventory"
         | Cons _ _ =>
             match! fx_check_captured_files root (reverse_lin FxCapturedUnit units) with
             | Left error => fx_check_fail (quality_input_message error)
             | Right files => match compile_checked_units fx_check_fuel (prim_string_to_char_codes root) files with
               | CErr error => let (ErrCode code detail) := error in
                 fx_check_fail
                   (str_join ":" ["compiler rejected source", prim_string_of_nat code, prim_string_of_nat detail])
               | COk _ => println (str_join "\t" ["ouro.fix-check.v1", prim_string_of_nat (str_len source),
                   prim_string_of_nat (sub fx_check_budget remaining), "complete"])
               end
             end
         end
       end)

def fx_check_source_text (root : String) (source : String) : IO Unit :=
    (if fx_check_byte_budget (str_len source) then fx_check_loaded root source
    else fx_check_fail "source byte budget exhausted")

def fx_check_root (root : String) : IO (Either QualityInputError Unit) :=
    match! quality_read_file root with
    | Left error => io_pure (Either QualityInputError Unit)
        (Left QualityInputError Unit error)
    | Right _ => io_pure (Either QualityInputError Unit)
        (Right QualityInputError Unit MkUnit)
    end

def fx_check_stdin (root : String) (count : String) : IO Unit :=
    match! fx_check_root root with
    | Left error => fx_check_fail (quality_input_message error)
    | Right _ => match str_parse_nat count with
      | Nothing => fx_check_fail "invalid stdin byte count"
      | Just expected => if fx_check_byte_budget expected then
          do let! text := prim_stdin_read_bytes (S expected);
             if eq_nat(expected, str_len text) then fx_check_loaded root text
             else fx_check_fail "incomplete or excess stdin bytes"
        else fx_check_fail "source byte budget exhausted"
      end
    end

def fx_check_file (root : String) (candidate : String) : IO Unit :=
    match! fx_check_root root with
    | Left error => fx_check_fail (quality_input_message error)
    | Right _ =>
        match! quality_read_file candidate with
        | Left error => fx_check_fail (quality_input_message error)
        | Right text => fx_check_source_text root text
        end
    end

def main : IO Unit :=
    do let! argv := prim_argv;
       if eq_nat(length String argv, 3) then
         fx_check_stdin (collect_path_normalize (nth String "" 1 argv))
           (nth String "" 2 argv)
       else
         if
           andb (eq_nat(length String argv, 4))
             (str_eq(nth String "" 2 argv, "file")) then
           fx_check_file (collect_path_normalize (nth String "" 1 argv))
             (collect_path_normalize (nth String "" 3 argv))
         else fx_check_usage
