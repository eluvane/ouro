-- Thin keep-import surface for ouro-fix. The 808-line rules cone stays
-- skip-harvested unless this file is the selected root.
import "rules.ouro",
  "scan.ouro",
  "../../std/string.ouro";

def fx_apply_all_rules (src : String) (ctors : List String) (ts : List FxTok)
    : List FxEdit :=
    fx_all_rules src ctors ts;
