-- Syntax facts for the strict firewall's closed-list check. Recognition uses
-- the same Cons/Nil owner as edits; these spans are not compiler type facts.

import "../strict/literals.ouro";
import "basic_rules.ouro";
import "../../std/io.ouro";
import "../../std/text.ouro";

-- LINT029's retained span contract covers a plain type name. The generic
-- fixer also accepts composite type arguments; enabling that broader set as
-- a blocking lint would be a separate policy change, not migration parity.

def fx_literal_spans_go (src : String) (fuel : Nat) : List FxTok -> Nat
    -> List (Pair Nat Nat) -> List (Pair Nat Nat) :=
  fix go (tokens : List FxTok) (limit : Nat) (acc : List (Pair Nat Nat))
      : List (Pair Nat Nat) :=
    match tokens with
    | Nil => reverse_lin (Pair Nat Nat) acc
    | Cons token rest =>
        match andb (leb_nat limit (fx_tok_start token))
            (andb (eq_nat (fx_tok_code token) fx_c_cons) (st_plain_type rest)) with
        | False => go rest limit acc
        | True =>
            match fx_chain_parse True src (fx_tok_text (fx_first_tok rest)) fuel tokens with
            | Nothing => go rest limit acc
            | Just chain =>
                match chain with
                | MkFxChain _ stop _ => go rest stop
                    (Cons (Pair Nat Nat) (MkPair Nat Nat (fx_tok_start token) stop) acc)
                end
            end
        end
    end;

def fx_literal_spans (src : String) : List (Pair Nat Nat) :=
    -- A Cons token requires these exact bytes. This necessary condition skips
    -- whole-file and line-local lexing without substituting a text heuristic
    -- for the constructor recognizer when a candidate exists.
    match str_contains src "Cons" with
    | False => Nil (Pair Nat Nat)
    | True =>
        let tokens : List FxTok := fx_lex src in
        fx_literal_spans_go src (S (length FxTok tokens)) tokens Z (Nil (Pair Nat Nat))
    end;

-- Preserve the old line-local query separately from whole-source spans.
-- A multiline outer chain can contain a complete chain on a later line.
def fx_literal_lines : List String -> Nat -> List Nat -> List Nat :=
  fix go (lines : List String) (line : Nat) (acc : List Nat) : List Nat :=
    match lines with
    | Nil => reverse_lin Nat acc
    | Cons text rest =>
        match fx_literal_spans text with
        | Nil => go rest (S line) acc
        | Cons _ _ => go rest (S line) (Cons Nat line acc)
        end
    end;

-- The retained empty-list diagnostic points at := and accepts one plain
-- type name on the same line. The shared tokenizer excludes strings and
-- comments; a spelling inside either is not an empty-list expression.

def fx_empty_literal_at (assignment : FxTok) (tokens : List FxTok) : Maybe Nat :=
    match fx_is_word assignment ":=" with
    | False => Nothing Nat
    | True => match tokens with
      | Nil => Nothing Nat
      | Cons constructor rest => match rest with
        | Nil => Nothing Nat
        | Cons type_name after =>
            let line : Nat := fx_tok_line assignment in
            match andb (fx_has_code constructor fx_c_nil)
                (andb (st_plain_type [type_name])
                  (andb (eq_nat line (fx_tok_line constructor)) (eq_nat line (fx_tok_line type_name)))) with
            | False => Nothing Nat
            | True => st_empty_end line type_name after
            end
        end end
    end;

def fx_empty_literal_spans (src : String) (closed_lines : List Nat) : List (Pair Nat Nat) :=
    match str_contains src "Nil" with
    | False => []
    | True =>
        (fix go (tokens : List FxTok) (acc : List (Pair Nat Nat)) : List (Pair Nat Nat) :=
          match tokens with
          | Nil => reverse_lin (Pair Nat Nat) acc
          | Cons token rest =>
              match fx_empty_literal_at token rest with
              | Nothing => go rest acc
              | Just finish => match elem Nat eq_nat (fx_tok_line token) closed_lines with
                | True => go rest acc
                | False => go rest (Cons (Pair Nat Nat) (MkPair Nat Nat (fx_tok_start token) finish) acc)
                end
              end
          end) (fx_lex src) []
    end;

-- Both inputs are ordered. An enclosing Cons span already reports its whole
-- literal; retaining an inner Nil proposal would duplicate that finding and
-- violate the disjoint byte-span protocol. Merge in linear list work.

def fx_literal_span_json (span : Pair Nat Nat) : String :=
    match span with
    | MkPair start stop => str_cat4 "[" (str_of_nat start) ","
        (str_concat (str_of_nat stop) "]")
    end;

-- This fixed protocol contains only constants and natural numbers. It needs
-- no arbitrary-string escaping or a second JSON implementation in the lexer
-- cone. Its successful JSON stdout is the result, not stray worker output.
def fx_literal_report (src : String) : String :=
    let lines : List Nat := fx_literal_lines (str_lines src) (S Z) (Nil Nat) in
    let spans : List (Pair Nat Nat) :=
      st_literal_merge (fx_literal_spans src) (fx_empty_literal_spans src lines) in
    str_cat4 "{\"kind\":\"ouro.fix-literal-spans.v2\",\"input_bytes\":"
      (str_of_nat (str_len src)) ",\"spans\":["
      (str_cat4 (str_join "," (map (Pair Nat Nat) String fx_literal_span_json spans))
        "],\"closed_lines\":[" (str_join "," (map Nat String str_of_nat lines))
        "],\"complete\":true}");

def fx_literal_max_bytes : Nat := mul 128 (mul fx_byte_mod fx_byte_mod);

def fx_literal_fail : IO Unit :=
    do eprintln "fix literal spans: expected exact UTF-8 stdin byte length (maximum 8388608)";
       exit 2

def fx_literal_run_size (expected : Nat) : IO Unit :=
    match leb_nat expected fx_literal_max_bytes with
    | False => fx_literal_fail
    | True =>
        -- Like the LSP frame reader, request a bounded byte count. One extra
        -- byte detects overflow; short input also fails the exact length check.
        do let! src := prim_stdin_read_bytes (S expected);
           match eq_nat expected (str_len src) with
           | False => fx_literal_fail
           | True => println (fx_literal_report src)
           end
    end;

def fx_literal_run (values : List String) : IO Unit :=
    match values with
    | Nil => fx_literal_fail
    | Cons value rest =>
        match rest with
        | Cons _ _ => fx_literal_fail
        | Nil =>
            match str_parse_nat value with
            | Nothing => fx_literal_fail
            | Just expected => fx_literal_run_size expected
            end
        end
    end;
