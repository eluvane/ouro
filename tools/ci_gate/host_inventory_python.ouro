-- Complete disposition inventory for tracked repository Python tooling.
-- `host_kind` is the migration status: remove, migrate, thin-wrapper, or host-bound.

import "host_inventory_model.ouro";
import "host_inventory_observers.ouro";

def host_bound_python_a_to_f : List HostPath :=
    [ MkHostPath "migrate"
        "scripts/analyze_bounded.py"
        "analyzer-inventory-and-budget"
        (Just String "tools/quality/source.ouro") "partial" "not-removable"
        "the host runner owns source selection, skeletons, report aggregation and process budgets; native inventory does not replace these consumers"
        ([ "scripts/analyze_bounded.py", "tools/quality/source.ouro", "scripts/ouro1.sh", "docs/quality.md" ] : List String)
    , host_script
        "scripts/analyze_core_checks.py"
        "analyzer-core-check-pool"
        "parallel canonical frontend checks require host process-tree limits, timeouts, ordered logs, and serialized tool preparation"
        ([ "scripts/analyze_core_checks.py", "scripts/analyze_precision_suite.sh", "scripts/ourosmith/limits.py" ] : List String)
    , host_script
        "scripts/analyze_production_suite.py"
        "analyzer-production-sweep"
        "the nightly sweep drives one bounded native drive process per production source through the host subprocess budget runner, rebuilds the drive binary, and compares frontend rejections with quality/analyze_production.json"
        ([ "scripts/analyze_production_suite.py", "scripts/analyze_bounded.py", "quality/analyze_production.json", "docs/quality.md" ] : List String)
    , host_script
        "scripts/api_baseline_regen.py"
        "api-baseline-reference"
        "write-mode regeneration preserves maintainer metadata and synthesized rows while extracting signatures with regular expressions and hashing UTF-8 bytes; Ouro has no regex surface or attested byte-for-byte source-controlled baseline writer"
        ([ "scripts/api_baseline_regen.py", "tools/analyze/api_surface.ouro", "quality/api_surface.tsv", "docs/practical_stdlib.md" ] : List String)
    , host_script
        "scripts/apply_github_settings.py"
        "hosted-github-mutation"
        "GitHub settings mutation requires credentials, gh, network/API access, and follow-up hosted verification outside the current Ouro runtime boundary"
        ([ "scripts/apply_github_settings.py", "docs/ci.md", ".github/ISSUE_TEMPLATE/config.yml" ] : List String)
    , host_script
        "scripts/bench_suite.py"
        "host-benchmark"
        "benchmark evidence requires host wall-clock and platform/process metadata not provided with equivalent measurement semantics by Ouro"
        ([ "scripts/bench_suite.py", "docs/build.md" ] : List String)
    , host_script
        "scripts/bootstrap_compiler.py"
        "current-source-bootstrap"
        "the temporary C bootstrap needs private byte snapshots, bounded host processes, complete generated-C comparison, and atomic successor publication until native bootstrap owns those contracts"
        ([ "scripts/bootstrap_compiler.py", "scripts/bootstrap_compiler_test.py", "docs/build.md" ] : List String)
    , host_script
        "scripts/bootstrap_compiler_test.py"
        "current-source-bootstrap-regression"
        "host fixtures verify strict-check ordering, independent source snapshots, failure preservation, and bootstrap receipt identity"
        ([ "scripts/bootstrap_compiler_test.py", "scripts/build_cache_config_suite.py", "scripts/bootstrap_compiler.py" ] : List String)
    , host_script
        "scripts/bootstrap_inputs.py"
        "historical-bootstrap-inputs"
        "versioned historical inputs require exact archive inventory, SHA-256, safe private extraction, and deterministic archive reproduction before the native bootstrap replaces the C seed"
        ([ "scripts/bootstrap_inputs.py", "compiler/bootstrap/c-bootstrap-v1.json", "docs/build.md" ] : List String)
    , host_script
        "scripts/bootstrap_inputs_test.py"
        "historical-bootstrap-input-regression"
        "host archive fixtures exercise traversal, duplicate, link, missing-member, size, hash, historical-stage0, and reproduction failures"
        ([ "scripts/bootstrap_inputs_test.py", "scripts/build_cache_config_suite.py", "scripts/bootstrap_inputs.py" ] : List String)
    , host_script
        "scripts/build_cache_config_suite.py"
        "host-build-regression"
        "the suite constructs fake host compilers and validates Python build-driver cache and filesystem metadata behavior"
        ([ "scripts/build_cache_config_suite.py", "scripts/ouro_build.py", "scripts/ci_gate.py" ] : List String)
    , host_script
        "scripts/c_static_analysis_suite.py"
        "c-host-analysis"
        "GCC and Clang diagnostics, sanitizer runtimes, subprocess timeouts, and host-specific compiler discovery are outside the Ouro process and runtime surface"
        ([ "scripts/c_static_analysis_suite.py", "scripts/ci_gate.py", "docs/ci.md" ] : List String)
    , host_script
        "scripts/cache_parity_suite.py"
        "bootstrap-cache-parity"
        "cache parity launches frontend and module-cache bootstrap processes and compares generated artifacts across trusted host boundaries"
        ([ "scripts/cache_parity_suite.py", "docs/build.md", "scripts/ci_gate.py" ] : List String)
    , host_partial_script
        "scripts/ci_gate.py"
        "reference-full-ci"
        "tools/ci_gate/main.ouro#pr-native"
        "full PR readiness still composes specialized analyzers, cache parity, release packaging, bootstrap evidence, per-gate environment, and host-tool availability"
        ([ "scripts/ci_gate.py", "tools/ci_gate/main.ouro#pr-native", "docs/ci.md" ] : List String)
    , MkHostPath "migrate"
        "scripts/clippy_grade_firewall.py"
        "clippy-quality-owner"
        (Just String "tools/quality/inventory.ouro") "partial" "not-removable"
        "native inventory and split Clippy modules including main.ouro and structural_main.ouro are compiler-checked; the Python adapter remains the public CLI, profile launch, and JSON/SARIF host path"
        ([ "scripts/clippy_grade_firewall.py", "tools/clippy/main.ouro", "tools/clippy/structural_main.ouro", "tools/clippy/core.ouro", "quality/clippy_grade_rules.json", "quality/fixtures/clippy_grade/manifest.json", "docs/clippy_grade_firewall.md" ] : List String)
    , host_script
        "scripts/clippy_grade_suite.py"
        "quality-reference-suite"
        "the suite materializes JSON-embedded fixtures, launches the native firewall through the Python adapter when the entry cone can be built, and validates its rule-code report contract; it cannot retire independently of that host launch path"
        ([ "scripts/clippy_grade_suite.py", "scripts/clippy_grade_firewall.py", "tools/clippy/main.ouro", "quality/fixtures/clippy_grade/manifest.json", "docs/clippy_grade_firewall.md" ] : List String)
    , thin_script
        "scripts/docs_examples_gate.py"
        "legacy-docs-cli"
        "tools/repo_gate/main.ouro#docs-native"
        "legacy CLI, work directory, report kind, and report path remain direct public compatibility contracts"
        ([ "scripts/docs_examples_gate.py", "tools/repo_gate/main.ouro#docs-native", "scripts/ouro_native_repo_ci_suite.sh" ] : List String)
    , host_script
        "scripts/frontend_host_suite.py"
        "c-producer-host-regressions"
        "fresh Ouro emission, C compiler linking, process limits and caller-lifetime probes protect temporary C producer seams"
        ([ "scripts/frontend_host_suite.py", "scripts/frontend_security_suite.sh", "runtime/n1_host_selftest.c", "runtime/frontend_link_selftest.c", "docs/build.md" ] : List String)
    , host_script
        "scripts/frontend_regen.py"
        "bootstrap-frontend-regeneration"
        "regeneration invokes seed compilers, packing helpers, parallel host processes, and content-addressed bootstrap caches"
        ([ "scripts/frontend_regen.py", "docs/build.md", "scripts/stage_loop.py" ] : List String)
    ];

def host_bound_python_g_to_k : List HostPath :=
    [ host_script
        "scripts/generated_artifact_drift_check.py"
        "generated-artifact-reference"
        "the gate invokes bootstrap regeneration and stage-loop promotion paths and must remain independent until exact hash and promotion parity is proven"
        ([ "scripts/generated_artifact_drift_check.py", "docs/build.md", "docs/tcb.md" ] : List String)
    , host_script
        "scripts/generated_c_shard_cache_suite.py"
        "generated-c-cache-reference-suite"
        "fake compiler and generated-C cache behavior exercise the host build seam and imported Python sharding implementation"
        ([ "scripts/generated_c_shard_cache_suite.py", "scripts/generated_c_shards.py", "docs/build.md" ] : List String)
    , host_script
        "scripts/generated_c_shards.py"
        "generated-c-host-build"
        "generated-C sharding, dependency hashing, object plans, and host compiler integration belong to the unresolved native build boundary"
        ([ "scripts/generated_c_shards.py", "scripts/ouro_build.py", "scripts/stage_loop.py" ] : List String)
    , thin_script
        "scripts/github_project_gate.py"
        "legacy-project-cli"
        "tools/repo_gate/main.ouro#project-native"
        "legacy CLI/report compatibility and direct release callers remain after local policy moved to the native project gate"
        ([ "scripts/github_project_gate.py", "tools/repo_gate/main.ouro#project-native", "docs/ci.md" ] : List String)
    , host_script
        "scripts/github_project_hosted_probe.py"
        "hosted-project-probe"
        "hosted GitHub reachability depends on gh, checkout metadata, credentials, and network/API availability"
        ([ "scripts/github_project_hosted_probe.py", "docs/ci.md" ] : List String)
    , thin_script
        "scripts/github_workflow_gate.py"
        "legacy-workflow-cli"
        "tools/repo_gate/main.ouro#workflow-native"
        "legacy CLI/report compatibility remains for direct workflow and local callers after policy moved native"
        ([ "scripts/github_workflow_gate.py", "tools/repo_gate/main.ouro#workflow-native", "docs/ci.md" ] : List String)
    , host_script
        "scripts/host_tools.py"
        "bootstrap-host-adapter"
        "wrapper installation, executable permissions, bounded emission, and host failure recovery are bootstrap adapters without native host parity"
        ([ "scripts/host_tools.py", "scripts/build_tool.sh", "scripts/ouro1.sh" ] : List String)
    , host_script
        "scripts/kernel_hardening_suite.py"
        "compiler-hardening-orchestration"
        "the suite requires canonical Ouro laws, exact cache-mode receipts and the compiler boundary policy; process supervision and builds still use Python and C"
        ([ "scripts/kernel_hardening_suite.py", "scripts/kernel_profile.py", "docs/ci.md", "docs/tcb.md" ] : List String)
    , host_script
        "scripts/kernel_profile.py"
        "compiler-profile-host-measurement"
        "the profile measures exact canonical Ouro laws and the Ouro boundary gate; bounded process timing, source receipts, and build-cache supervision remain Python host functions"
        ([ "scripts/kernel_profile.py", "quality/kernel_budgets.json", "tests/compiler_retained_tests.ouro", "docs/ci.md" ] : List String)
    , host_script
        "scripts/kernel_profile_test.py"
        "compiler-profile-policy-tests"
        "negative tests keep missing laws, malformed reports, stale receipts, and exceeded resource budgets blocking while the profile adapter remains on Python"
        ([ "scripts/kernel_profile_test.py", "scripts/kernel_profile.py", "docs/ci.md" ] : List String)
    , host_script
        "scripts/kernel_scale.py"
        "compiler-scale-and-depth-host-measurement"
        "canonical Ouro probes own the scale and checked-API outcomes; Python builds exact sources, applies process limits and verifies complete source-bound result protocols"
        ([ "scripts/kernel_scale.py", "tests/compiler_scale_probe.ouro", "tests/compiler_depth_probe.ouro", "docs/ci.md" ] : List String)
    , host_script
        "scripts/kernel_scale_test.py"
        "compiler-scale-report-policy-selftest"
        "host tests reject incomplete, stale, malformed or over-budget scale and checked-API evidence before migration credit is granted; kernel_hardening_suite runs this module"
        ([ "scripts/kernel_scale.py", "scripts/kernel_scale_test.py", "scripts/kernel_hardening_suite.py", "docs/ci.md" ] : List String)
    ];

def host_bound_python_k_to_s : List HostPath :=
    [ host_script
        "scripts/language_speed_simplicity_suite.py"
        "host-shape-reference-suite"
        "the suite deliberately injects failing Python and probes shell/bootstrap process shape that a child Ouro process cannot reproduce faithfully"
        ([ "scripts/language_speed_simplicity_suite.py", "scripts/ci_gate.py", "scripts/python.sh" ] : List String)
    , host_script
        "scripts/memory_budget_suite.py"
        "host-memory-suite"
        "memory evidence requires OS process-tree peak RSS measurement and termination semantics unavailable in the Ouro runtime"
        ([ "scripts/memory_budget_suite.py", "scripts/memory_watch.py", "docs/build.md" ] : List String)
    , host_script
        "scripts/memory_watch.py"
        "host-memory-adapter"
        "cross-platform RSS collection uses resource, procfs, Windows APIs, signals, and process-tree termination"
        ([ "scripts/memory_watch.py", "scripts/memory_budget_suite.py", "quality/memory_baseline.json" ] : List String)
    , host_script
        "scripts/memory_watch_test.py"
        "host-memory-termination-regression"
        "Linux procfs and separate POSIX sessions verify that memory-limit termination reaches nested supervised processes"
        ([ "scripts/memory_watch_test.py", "scripts/memory_watch.py", "scripts/memory_budget_suite.py" ] : List String)
    , host_script
        "scripts/native_tool_build.py"
        "host-native-tool-build"
        "C emission/link caching, Windows quality-tool UTF-8 resources and atomic publication remain host build responsibilities"
        ([ "scripts/native_tool_build.py", "scripts/build_tool.sh", "scripts/build_cache_config_suite.py", "docs/build.md" ] : List String)
    , host_script
        "scripts/ouro_build.py"
        "host-build-driver"
        "incremental C compilation, ccache discovery, permissions, dependency files, and interruption-safe host caches remain bootstrap-bound"
        ([ "scripts/ouro_build.py", "scripts/ouro_seal.py", "scripts/bootstrap.sh", "docs/build.md" ] : List String)
    , host_script
        "scripts/ouro_seal.py"
        "project-seal-parser"
        "the build driver reads Ouro.seal on the host before any Ouro-native config path exists; the parser must stay in lockstep with tools/pkg/seal.ouro"
        ([ "scripts/ouro_seal.py", "scripts/ouro_build.py", "docs/pkg.md" ] : List String)
    , host_script
        "scripts/pack_frontend.py"
        "generated-c-packer"
        "textual generated-C ABI rewriting is required by bootstrap until the compiler emitter produces collision-free translation units directly"
        ([ "scripts/pack_frontend.py", "scripts/frontend_regen.py", "scripts/stage_loop.py" ] : List String)
    , host_script
        "scripts/perf_core_toolchain.py"
        "host-performance-report"
        "latency evidence requires host wall clock, subprocess accounting, environment metadata, and missing-tool observation"
        ([ "scripts/perf_core_toolchain.py", "docs/tooling.md", "docs/ci.md" ] : List String)
    , host_script
        "scripts/release_package.py"
        "release-packaging-reference"
        "deterministic tar.zst, tar.gz, and ZIP creation requires zstd/gzip/deflate, archive metadata and mode control, git-backed file selection, and streaming checksums; the Ouro stdlib exposes no archive or compression APIs"
        ([ "scripts/release_package.py", "docs/releasing.md", "docs/ci.md" ] : List String)
    , host_script
        "scripts/repo_support.py"
        "shared-python-host-library"
        "path, atomic JSON, and streaming hash helpers remain imported by active host-bound Python build, release, cache, and trust tools"
        ([ "scripts/repo_support.py", "scripts/ci_gate.py", "scripts/ouro_build.py" ] : List String)
    , host_script
        "scripts/selfhost_bootstrap_evidence.py"
        "bootstrap-evidence-reference"
        "evidence collection executes commands, snapshots git/platform/resources, and hashes bootstrap artifacts outside the native runtime boundary"
        ([ "scripts/selfhost_bootstrap_evidence.py", "scripts/ci_gate.py", "docs/build.md" ] : List String)
    , host_script
        "scripts/selfhost_module_cache.py"
        "bootstrap-module-cache"
        "the noncanonical sidecar cache depends on seed artifacts, import closure hashing, atomic host metadata, and generated bootstrap work"
        ([ "scripts/selfhost_module_cache.py", "scripts/frontend_regen.py", "scripts/stage_loop.py" ] : List String)
    ];

def host_bound_python_s_to_z : List HostPath :=
    [ host_script
        "scripts/selfhost_module_cache_suite.py"
        "bootstrap-cache-reference-suite"
        "fake seed/compiler execution validates the host module cache implementation and cannot retire independently of that host boundary"
        ([ "scripts/selfhost_module_cache_suite.py", "scripts/selfhost_module_cache.py", "docs/build.md" ] : List String)
    , host_script
        "scripts/stage_loop.py"
        "bootstrap-stage-loop"
        "seed execution, generated-C compilation, deterministic caches, fixpoint comparison, and atomic promotion remain host/bootstrap operations"
        ([ "scripts/stage_loop.py", "scripts/stage_loop.sh", "docs/build.md" ] : List String)
    , host_script
        "scripts/stage_loop_frontend_regen_suite.py"
        "stage-loop-reference-suite"
        "fake Ouro and C compiler processes validate frontend regeneration cache behavior inside the host stage-loop boundary"
        ([ "scripts/stage_loop_frontend_regen_suite.py", "scripts/stage_loop.py", "scripts/ci_gate.py" ] : List String)
    , host_script
        "scripts/stage_loop_generated_c_object_cache_suite.py"
        "stage-loop-reference-suite"
        "fake C compiler and promotion paths validate generated object cache behavior inside the host stage-loop boundary"
        ([ "scripts/stage_loop_generated_c_object_cache_suite.py", "scripts/stage_loop.py", "scripts/ci_gate.py" ] : List String)
    , host_script
        "scripts/structural_lex_parity.py"
        "structural-lex-parity"
        "compares native st_lex JSON tokens with the frozen Python lex oracle; missing native emit is unavailable, not a pass"
        ([ "scripts/structural_lex_parity.py", "tools/structural/lex_driver.ouro", "scripts/structural_quality_legacy.py", "quality/fixtures/structural_lex/manifest.json", "docs/quality.md" ] : List String)
    , MkHostPath "migrate"
        "scripts/structural_quality.py"
        "strict-structural-quality"
        (Nothing String) "none" "not-removable"
        "public launcher and compatibility re-exports over the frozen Python oracle; symbols, findings, and reports still lack native parity"
        ([ "scripts/strict_quality_firewall.py", "scripts/structural_quality_suite.py", "scripts/structural_quality_legacy.py", "docs/quality.md" ] : List String)
    , host_script
        "scripts/structural_quality_legacy.py"
        "frozen-structural-quality-oracle"
        "import-only live structural implementation kept as the lex/extraction oracle for structural_lex_parity; not a public CLI"
        ([ "scripts/structural_quality_legacy.py", "scripts/structural_lex_parity.py", "scripts/structural_quality.py", "docs/quality.md" ] : List String)
    , host_script
        "scripts/structural_quality_suite.py"
        "strict-structural-quality-suite"
        "fixtures exercise cross-language source adapters and fail-closed Git inventory beside the host-bound structural pass"
        ([ "scripts/structural_quality.py", "scripts/structural_lex_parity.py", "scripts/ci_gate.py", "docs/quality.md" ] : List String)
    , MkHostPath "migrate"
        "scripts/strict_quality_firewall.py"
        "strict-quality-owner"
        (Just String "tools/quality/inventory.ouro") "partial" "not-removable"
        "native inventory and Cons/Nil LINT029; Python owns other lints, profiles, registry/fixtures, suppressions, debt and reports"
        ([ "scripts/strict_quality_firewall.py", "tools/quality/inventory.ouro", "quality/strict_debt_manifest.json", "docs/quality.md" ] : List String)
    , MkHostPath "migrate"
        "scripts/syntax_quality_fix.py"
        "syntax-native-transport"
        (Just String "tools/fix/main.ouro") "partial" "not-removable"
        "native fix and inventory own rewrites, LINT029 and selection; Python retains bootstrap and checked worker transport, with no fallback"
        ([ "scripts/syntax_quality_fix.py", "scripts/syntax_quality_suite.py", "tools/fix/literal_spans.ouro", "quality/fixtures/manifest.json", "docs/quality.md" ] : List String)
    , host_script
        "scripts/syntax_quality_suite.py"
        "strict-quality-reference-suite"
        "the suite checks native fix CLI parity, literal/alias preservation, refusal and idempotence, plus retained host strict-firewall fixtures and reports"
        ([ "scripts/syntax_quality_suite.py", "scripts/syntax_quality_fix.py", "scripts/strict_quality_firewall.py", "quality/fixtures/manifest.json" ] : List String)
    , host_script
        "scripts/test_selfhost_bootstrap_evidence.py"
        "bootstrap-evidence-reference-suite"
        "the unittest module validates host command, temp directory, bounded log, and bootstrap report behavior; build_cache_config_suite runs this module"
        ([ "scripts/test_selfhost_bootstrap_evidence.py", "scripts/selfhost_bootstrap_evidence.py", "scripts/build_cache_config_suite.py" ] : List String)
    ];


def host_smith_path (relative : String) : HostPath :=
    host_script (str_concat "scripts/ourosmith/" relative)
      "smith-independent-test-system"
      "the host harness supervises Ouro Core generation and checking plus independent surface and tool expectations; process limits, exact receipts, seed replay, shrinking and fault builds still depend on Python"
      ([ "docs/ouro_smith.md", "quality/smith/strategies.json", "tests/compiler_smith_runner.ouro" ] : List String);


def host_bound_smith_paths : List HostPath :=
    Cons HostPath
      (host_script "scripts/ouro_smith.py" "smith-host-cli"
        "the CLI coordinates canonical Ouro checking and independently specified generated expectations; process budgets, input recovery and source-bound evidence still require the host harness"
        ([ "docs/ouro_smith.md", "scripts/ourosmith/validation.py", "quality/smith/strategies.json" ] : List String))
      (map String HostPath host_smith_path
        ([ "__init__.py"
        , "core/__init__.py", "core/run.py"
        , "checker_faults.py", "checker_fault_selftest.py"
        , "compiler_evidence.py", "compiler_evidence_test.py", "native.py", "native_selftest.py"
        , "corpus.py", "evidence.py", "exec_child.py", "faults.py", "host.py", "inventory.py"
        , "limits.py", "migration.py", "migration_contracts.py", "native_inputs.py"
        , "provenance.py", "report.py", "rng.py", "selftest.py", "producer_selftest.py"
        , "surface/__init__.py", "surface/analyzer.py", "surface/analyzer_lines.py"
        , "surface/backend.py", "surface/corpus.py", "surface/doc_contract.py", "surface/forms.py"
        , "surface/gen.py", "surface/inventory.py", "surface/io.py", "surface/library.py"
        , "surface/lint_contracts.py", "surface/manifest.py", "surface/mutate.py", "surface/parity.py", "surface/parser.py"
        , "surface/practical.py", "surface/run.py", "surface/text_contracts.py", "surface/tools.py"
        , "surface_faults.py", "validation.py", "windows_job.py"
        ] : List String));


def host_bound_python_paths : List HostPath :=
    append HostPath host_bound_python_a_to_f
      (append HostPath host_bound_python_g_to_k
        (append HostPath host_bound_python_k_to_s
          (append HostPath host_bound_python_s_to_z host_bound_smith_paths)));
