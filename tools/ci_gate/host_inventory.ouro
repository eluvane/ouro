def removed_smith_core_paths : List HostPath :=
    map String HostPath
      (fun (relative : String) =>
        removed_dead_script (str_concat "scripts/ourosmith/core/" relative)
          "retired-python-core-semantics"
          "Core generation and laws now execute as Ouro programs through the canonical checker; Python retains seed and receipt supervision without a second Core interpreter"
          ([ "tests/compiler_smith_runner.ouro", "tests/compiler_property_tests.ouro", "docs/ouro_smith.md" ] : List String))
      ([ "gen.py", "mutate.py", "nested.py", "oracles.py", "pyworker.py", "refnorm.py", "terms.py" ] : List String);


def host_bound_non_script_paths : List HostPath :=
    Nil HostPath;


def host_bound_paths : List HostPath :=
    append HostPath (append HostPath removed_script_paths removed_smith_core_paths)
      (append HostPath host_bound_python_paths
        (append HostPath host_bound_shell_paths host_bound_non_script_paths));
