-- Complete disposition inventory for tracked repository tooling.

import "host_inventory_python.ouro";

-- Shell paths are sorted exactly as `git ls-files '*.sh'` reports them.
def host_bound_shell_fixture_to_lsp : List HostPath :=
    [ host_script
        "quality/fixtures/structural_lex/heredoc.sh"
        "structural-lex-parity"
        "the fixture is a structural-lex corpus case for the host lex oracle and is not repository control-plane policy"
        ([ "quality/fixtures/structural_lex/heredoc.sh", "quality/fixtures/structural_lex/manifest.json", "scripts/structural_lex_parity.py", "docs/quality.md" ] : List String)
    , host_script
        "quality/fixtures/structural_lex/shell_ops.sh"
        "structural-lex-parity"
        "the fixture is a structural-lex corpus case for the host lex oracle and is not repository control-plane policy"
        ([ "quality/fixtures/structural_lex/shell_ops.sh", "quality/fixtures/structural_lex/manifest.json", "scripts/structural_lex_parity.py", "docs/quality.md" ] : List String)
    , host_script
        "quality/fixtures/structural_lex/unclosed_heredoc.sh"
        "structural-lex-parity"
        "the fixture is a structural-lex corpus case for the host lex oracle and is not repository control-plane policy"
        ([ "quality/fixtures/structural_lex/unclosed_heredoc.sh", "quality/fixtures/structural_lex/manifest.json", "scripts/structural_lex_parity.py", "docs/quality.md" ] : List String)
    , host_script
        "samples/bioinformatics/fixture_tool.sh"
        "external-process-sample-fixture"
        "the fixture deliberately proves shell/process integration for bioinformatics samples and is not repository control-plane policy"
        ([ "samples/bioinformatics/fixture_tool.sh", "samples/bioinformatics/hela_rnaseq.ouro", "samples/bioinformatics/variant_calling_support.ouro" ] : List String)
    , host_partial_script
        "scripts/analyze_precision_suite.sh"
        "analyzer-reference-suite"
        "tools/analyze/main.ouro"
        "exact packaged analyzer parity still requires Python-bounded subprocess execution, two native analyzer binaries, and shell repair of dropped nonzero exit semantics"
        ([ "scripts/analyze_precision_suite.sh", "scripts/analyze_bounded.py", "scripts/ouro1.sh", "tools/analyze/drive_main.ouro", "docs/quality.md" ] : List String)
    , host_script
        "scripts/bootstrap.sh"
        "bootstrap-launcher"
        "C bootstrap and Python-assisted build recovery are required before any Ouro-native build executable exists"
        ([ "scripts/bootstrap.sh", "docs/build.md" ] : List String)
    , host_script
        "scripts/build_tool.sh"
        "native-tool-build-launcher"
        "building Ouro-native tools still requires the existing host compiler, bootstrap recovery, generated C packing, and executable wrapper installation"
        ([ "scripts/build_tool.sh", "docs/build.md", "scripts/ouro_ci_gate.sh" ] : List String)
    , thin_script
        "scripts/coil.sh"
        "project-facing-ouro1-alias"
        "scripts/ouro1.sh"
        "coil only remaps verbs onto ouro1 and ouro1 pkg; bootstrap, generated binaries, and compiler checking stay on the existing dispatcher"
        ([ "scripts/coil.sh", "scripts/ouro1.sh", "docs/pkg.md", "docs/tooling.md" ] : List String)
    , thin_script
        "scripts/doc_suite.sh"
        "legacy-documentation-suite-cli"
        "tools/doc.ouro#selftest"
        "Python prepares declarations and independent expected pages; Ouro owns negative IO, files-from, regeneration, and API drift assertions"
        ([ "scripts/doc_suite.sh", "tools/doc.ouro#run_doc_selftest", "docs/tooling.md", "scripts/ourosmith/surface/doc_contract.py" ] : List String)
    , thin_host_script
        "scripts/emit_frontend.sh"
        "frontend-regeneration-launcher"
        "the wrapper only resolves Python and execs the host-bound frontend regeneration implementation"
        ([ "scripts/emit_frontend.sh", "scripts/frontend_regen.py", "docs/build.md" ] : List String)
    , thin_script
        "scripts/fix_suite.sh"
        "autofix-suite-cli"
        "tools/fix/main.ouro#selftest"
        "Python prepares independent rewrite specifications; Ouro owns exact-output, idempotence, and report assertions"
        ([ "scripts/fix_suite.sh", "tools/fix/main.ouro#run_fix_selftest", "scripts/ourosmith/surface/text_contracts.py", "docs/tooling.md" ] : List String)
    , thin_script
        "scripts/fmt_suite.sh"
        "legacy-formatter-suite-cli"
        "tools/fmt.ouro#selftest"
        "the wrapper now retains only compiler discovery, forced native build, output-path compatibility, and exec; Ouro owns fixture, idempotence, check/write, and tree-drift cases"
        ([ "scripts/fmt_suite.sh", "tools/fmt.ouro#run_fmt_selftest", "scripts/ourosmith/surface/text_contracts.py" ] : List String)
    , host_script
        "scripts/frontend_security_suite.sh"
        "bootstrap-compiler-boundary-suite"
        "the suite drives the public bootstrap compiler with malformed module suffixes and over-budget source; that boundary is still host-bound"
        ([ "scripts/frontend_security_suite.sh", "scripts/ci_gate.py", "docs/ci.md" ] : List String)
    , host_script
        "scripts/hygiene.sh"
        "bootstrap-trust-hygiene"
        "the script combines generated-artifact hashes, stage/bootstrap assertions, Python reference gates, and trust-sensitive source checks that require a reviewed split before migration"
        ([ "scripts/hygiene.sh", "docs/build.md", "docs/tcb.md" ] : List String)
    , thin_script
        "scripts/lines_suite.sh"
        "legacy-lines-suite-cli"
        "tools/lines.ouro#selftest"
        "the wrapper now retains only compiler discovery, native tool build, output-path compatibility, and exec; Ouro owns all eight cases and assertions"
        ([ "scripts/lines_suite.sh", "tools/lines.ouro#run_lines_selftest", "docs/tooling.md" ] : List String)
    , host_partial_script
        "scripts/lint_suite.sh"
        "mixed-lint-reference-suite"
        "tools/lint.ouro#selftest"
        "native lint fixture discovery, verdicts, and artifacts moved to Ouro; lint_suite compiler-checks split Clippy modules in chunks; reports stay host-owned because native scan is not claimed byte-identical with the retired regex owner"
        ([ "scripts/lint_suite.sh", "tools/lint.ouro#run_lint_selftest", "scripts/clippy_grade_firewall.py", "tools/clippy/core.ouro", "quality/fixtures/clippy_grade/manifest.json", "docs/quality.md" ] : List String)
    , host_script
        "scripts/lsp_suite.sh"
        "lsp-protocol-reference-suite"
        "scripted LSP validation requires subprocess stdin and bidirectional protocol driving, which the current Ouro process API explicitly lacks"
        ([ "scripts/lsp_suite.sh", "tools/lsp.ouro", "docs/practical_stdlib.md" ] : List String)
    , thin_host_script
        "scripts/native_gate_launcher.sh"
        "shared-native-gate-startup"
        "source freshness, checked rebuild, platform executable lookup, and exec remain host-bound; repository policy stays in Ouro"
        ([ "scripts/ouro_repo_gate.sh", "scripts/ouro_ci_gate.sh", "scripts/language_speed_simplicity_suite.py" ] : List String)
    ];


def host_bound_shell_ouro_to_test : List HostPath :=
    [ host_script
        "scripts/ouro1.sh"
        "canonical-bootstrap-dispatcher"
        "the command dispatcher still bridges bootstrap, generated binaries, checker compatibility, build fallback, and host-only bounded analysis"
        ([ "scripts/ouro1.sh", "docs/tooling.md", "docs/build.md" ] : List String)
    , thin_script
        "scripts/ouro_ci_gate.sh"
        "native-ci-launcher"
        "tools/ci_gate/main.ouro"
        "launcher must locate the checkout, build the native binary when stale, and exec it until bootstrap is native"
        ([ "scripts/ouro_ci_gate.sh", "tools/ci_gate/main.ouro", "scripts/build_tool.sh" ] : List String)
    , thin_script
        "scripts/ouro_native_repo_ci_suite.sh"
        "legacy-control-plane-selftest-cli"
        "tools/ci_gate/native_repo_selftest_main.ouro"
        "the wrapper now retains only Python/bootstrap discovery, output cleanup, forced native build, path compatibility, and exec; Ouro owns all 64 fixture, checker-regression, fail-closed inventory, manifest-validation, and parity assertions"
        ([ "scripts/ouro_native_repo_ci_suite.sh", "tools/ci_gate/native_repo_selftest.ouro", "tools/ci_gate/native_repo_selftest_main.ouro", "tools/ci_gate/gates.ouro" ] : List String)
    , thin_script
        "scripts/ouro_repo_gate.sh"
        "native-repository-gate-launcher"
        "tools/repo_gate/main.ouro"
        "launcher must locate the checkout, build the native binary when stale, and exec it until bootstrap is native"
        ([ "scripts/ouro_repo_gate.sh", "tools/repo_gate/main.ouro", "scripts/build_tool.sh" ] : List String)
    , host_script
        "scripts/parity_suite.sh"
        "bootstrap-compiler-parity"
        "host and self-host compiler production, stage binaries, generated C, and cache-disabled comparisons cross the bootstrap trust boundary"
        ([ "scripts/parity_suite.sh", "scripts/stage_loop.sh", "docs/build.md" ] : List String)
    , thin_host_script
        "scripts/perf_core_toolchain.sh"
        "performance-reference-launcher"
        "the wrapper only resolves Python and execs the host-bound timing collector"
        ([ "scripts/perf_core_toolchain.sh", "scripts/perf_core_toolchain.py", "docs/tooling.md" ] : List String)
    , host_script
        "scripts/pkg_suite.sh"
        "package-scenario-reference-suite"
        "stateful scenarios require per-command environment injection and scratch registry mutation not exposed by the current Ouro process API"
        ([ "scripts/pkg_suite.sh", "tools/pkg/main.ouro", "docs/pkg.md" ] : List String)
    , thin_host_script
        "scripts/process_stdin.sh"
        "subprocess-stdin-adapter"
        "the adapter performs only structured stdin redirection until Ouro proc_exec accepts typed stdin without a shell string"
        ([ "scripts/process_stdin.sh", "tools/test/sample_cases.ouro", "docs/practical_stdlib.md" ] : List String)
    , host_script
        "scripts/python.sh"
        "python-host-resolver"
        "source semantics and executable probing are required to reject the Windows Store python3 alias while active Python bootstrap/reference paths remain"
        ([ "scripts/python.sh", "scripts/bootstrap.sh", "docs/build.md" ] : List String)
    , thin_script
        "scripts/quickstart_smoke.sh"
        "legacy-quickstart-cli"
        "tools/ci_gate/main.ouro#quickstart-native"
        "the wrapper now preserves the documented command path and final summary only; native CI gate data owns the ordered check/eval/check/test sequence"
        ([ "scripts/quickstart_smoke.sh", "tools/ci_gate/gates.ouro#quickstart-native", "CONTRIBUTING.md", "scripts/ci_gate.py" ] : List String)
    , thin_script
        "scripts/runtime_io_suite.sh"
        "legacy-runtime-io-suite-cli"
        "tools/test/main.ouro#runtime-io-native-suite"
        "the wrapper now retains only compiler discovery, native suite build, output-path compatibility, and exec; Ouro owns all runtime cases and assertions"
        ([ "scripts/runtime_io_suite.sh", "tools/test/suites.ouro#runtime_io_suite_fixtures", "tools/test/main.ouro#run_runtime_io_native_suite" ] : List String)
    , thin_script
        "scripts/samples_suite.sh"
        "legacy-samples-suite-cli"
        "tools/test/main.ouro#samples-native-suite"
        "the wrapper now retains only compiler discovery, native suite build, stdin-adapter/output compatibility, and exec; Ouro owns all 58 cases and assertions"
        ([ "scripts/samples_suite.sh", "tools/test/sample_cases.ouro#sample_suite_cases", "tools/test/main.ouro#run_samples_native_suite", "scripts/process_stdin.sh" ] : List String)
    , thin_host_script
        "scripts/stage_loop.sh"
        "stage-loop-launcher"
        "the wrapper only applies the host stack setting, resolves Python, and execs the host-bound stage loop"
        ([ "scripts/stage_loop.sh", "scripts/stage_loop.py", "docs/build.md" ] : List String)
    , thin_script
        "scripts/test_suite.sh"
        "legacy-user-test-suite-cli"
        "tools/test/main.ouro#test-native-suite"
        "the wrapper now retains only compiler discovery, native suite build, output-path compatibility, and exec; Ouro owns preflights, fixture cases, nested lines evidence, and public command smoke"
        ([ "scripts/test_suite.sh", "tools/test/suites.ouro#user_test_suite_fixtures", "tools/test/main.ouro#run_user_test_native_suite" ] : List String)
    ];


def host_bound_shell_paths : List HostPath :=
    append HostPath host_bound_shell_fixture_to_lsp host_bound_shell_ouro_to_test;


def removed_script_paths : List HostPath :=
    [ removed_dead_script
        "scripts/core_artifact.py"
        "retired-json-core-codec"
        "the independent JSON replay API is retired; the historical schema remains archived data and canonical typed Core fixtures retain its semantic contracts"
        ([ "docs/kernel_core_artifact.md", "tests/compiler_retained_tests.ouro", "docs/tcb.md" ] : List String)
    , removed_dead_script
        "scripts/kernel_recheck.py"
        "retired-independent-python-checker"
        "the compiler-owned checker replaces independent replay authority; retained Ouro laws require exact rejection classes and normalization outcomes"
        ([ "compiler/file_elab.ouro", "tests/compiler_retained_tests.ouro", "docs/kernel_design.md" ] : List String)
    , removed_dead_script
        "scripts/kernel_differential_gate.py"
        "retired-cross-checker-comparison"
        "both compared semantic owners are retired; typed properties, retained laws, source fault injection, scale and depth contracts are required on the canonical Ouro checker"
        ([ "tests/compiler_property_tests.ouro", "tests/compiler_fault_tests.ouro", "scripts/kernel_scale.py", "docs/ci.md" ] : List String)
    , removed_dead_script
        "scripts/kernel_trust_boundary_gate.py"
        "retired-ocaml-boundary-policy"
        "the OCaml module boundary no longer exists; compiler-boundary checks the documented pure Ouro dependency closure and checked-value representation owners"
        ([ "tools/repo_gate/compiler_boundary.ouro", "tests/repo_gate_boundary_tests.ouro", "docs/tcb.md" ] : List String)
    , removed_dead_script
        "scripts/dune.sh"
        "retired-ocaml-build-launcher"
        "no active compiler or validation command invokes Dune or opam after the semantic owners and callers move to Ouro"
        ([ "scripts/ci_gate.py", "scripts/ouro_build.py", "docs/build.md" ] : List String)
    , removed_dead_script
        "scripts/gen_fe_link.py"
        "duplicate-linker-emitter"
        "ouro_build.ensure_fe_link owns the identical emission and banner; the bootstrap bundle preserves each historical runtime and linker pairing"
        ([ "scripts/ouro_build.py", "scripts/bootstrap.sh", "runtime/frontend_link.c" ] : List String)
    , removed_dead_script
        "scripts/env.sh"
        "unused-environment-helper"
        "the helper had no tracked caller after Python resolution was centralized and was deleted"
        ([ "scripts/python.sh", "CHANGELOG.md" ] : List String)
    , removed_replaced_script
        "scripts/ergonomics_suite.sh"
        "duplicate-manifest-suite"
        "tools/test/main.ouro#manifest-native-suite"
        "the ERGO manifest selection and verdict policy moved into the shared Ouro test runner"
        ([ "tools/test/main.ouro#run_manifest_native_suite", "scripts/ourosmith/native_inputs.py", "CHANGELOG.md" ] : List String)
    , removed_replaced_script
        "scripts/imports_suite.sh"
        "duplicate-manifest-suite"
        "tools/test/main.ouro#manifest-native-suite"
        "the IMP manifest selection and verdict policy moved into the shared Ouro test runner"
        ([ "tools/test/main.ouro#run_manifest_native_suite", "scripts/ourosmith/native_inputs.py", "CHANGELOG.md" ] : List String)
    , removed_dead_script
        "scripts/o8_rebuild.sh"
        "unused-build-wrapper"
        "the unreferenced rebuild alias duplicated maintained bootstrap/build entry points and was deleted"
        ([ "scripts/bootstrap.sh", "scripts/ouro_build.py", "CHANGELOG.md" ] : List String)
    , removed_dead_script
        "scripts/ouro_share_gate.sh"
        "unused-code-share-metric"
        "the byte-share metric was not a blocking gate, could not pass at its declared floor, and had no caller besides its own self-checks, so it was deleted"
        ([ "std/gate/share.ouro", "scripts/hygiene.sh", "CHANGELOG.md" ] : List String)
    , removed_replaced_script
        "scripts/quickstart_clone_smoke.sh"
        "duplicate-quickstart-suite"
        "tools/ci_gate/gates.ouro#quickstart-native"
        "the clone smoke implementation duplicated quickstart policy and had no remaining caller after the native route replaced it"
        ([ "tools/ci_gate/gates.ouro#quickstart-native", "scripts/quickstart_smoke.sh", "CHANGELOG.md" ] : List String)
    , removed_dead_script
        "scripts/selfhost_reduction_hotpath_suite.py"
        "orphaned-source-shape-suite"
        "the script had no tracked caller or gate; retaining an unexecuted source-shape oracle would provide false assurance"
        ([ "compiler/kernel_core.ouro", "compiler/file_elab_core.ouro", "CHANGELOG.md" ] : List String)
    , removed_dead_script
        "scripts/selfhost_structural_hotpath_suite.py"
        "orphaned-source-shape-suite"
        "the script had no tracked caller or gate; retaining an unexecuted source-shape oracle would provide false assurance"
        ([ "compiler/kernel_term.ouro", "compiler/file_elab_term.ouro", "CHANGELOG.md" ] : List String)
    , removed_dead_script
        "scripts/selfhost_typechecker_hotpath_suite.py"
        "orphaned-source-shape-suite"
        "the script had no tracked caller or gate; retaining an unexecuted source-shape oracle would provide false assurance"
        ([ "compiler/file_elab_infer.ouro", "compiler/kernel_term.ouro", "CHANGELOG.md" ] : List String)
    , removed_dead_script
        "scripts/split_parser.py"
        "unused-source-split-helper"
        "the helper had no tracked caller and duplicated maintained parser/source tooling, so it was deleted"
        ([ "compiler/parser_file.ouro", "CHANGELOG.md" ] : List String)
    ];


def removed_smith_core_paths : List HostPath :=
    map String HostPath
      (fun (relative : String) =>
        removed_dead_script (str_concat "scripts/ourosmith/core/" relative)
          "retired-python-core-semantics"
          "Core generation and laws now execute as Ouro programs through the canonical checker; Python retains seed and receipt supervision without a second Core interpreter"
          ([ "tests/compiler_smith_runner.ouro", "tests/compiler_property_tests.ouro", "docs/ouro_smith.md" ] : List String))
      ([ "gen.py", "mutate.py", "nested.py", "oracles.py", "pyworker.py", "refnorm.py", "terms.py" ] : List String);


def host_bound_non_script_paths : List HostPath :=
    Nil HostPath;


def host_bound_paths : List HostPath :=
    append HostPath (append HostPath removed_script_paths removed_smith_core_paths)
      (append HostPath host_bound_python_paths
        (append HostPath host_native_observers
          (append HostPath host_bound_shell_paths host_bound_non_script_paths)));
