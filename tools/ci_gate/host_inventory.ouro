        ([ "scripts/strict_quality_firewall.py", "scripts/structural_quality_suite.py", "docs/quality.md" ] : List String)
    , host_script
        "scripts/structural_quality_suite.py"
        "strict-structural-quality-suite"
        "fixtures exercise cross-language source adapters and fail-closed Git inventory beside the host-bound structural pass"
        ([ "scripts/structural_quality.py", "scripts/ci_gate.py", "docs/quality.md" ] : List String)
    , host_script
        "scripts/strict_quality_firewall.py"
        "strict-quality-reference"
        "the independent strict reference uses multiline regular expressions, suppression/debt manifests, and deterministic JSON, SARIF, and Markdown reports; Ouro has no regex engine or report-compatible replacement for this release gate"
        ([ "scripts/strict_quality_firewall.py", "quality/fixtures/manifest.json", "quality/strict_debt_manifest.json", "docs/quality.md" ] : List String)
    , host_script
        "scripts/syntax_quality_fix.py"
        "syntax-rewrite-reference"
        "the conservative fixer uses a regex plus token-span rewrite engine whose exact rewrite and idempotence behavior is not provided by the native formatter; migrating it without byte-for-byte parity could corrupt source"
        ([ "scripts/syntax_quality_fix.py", "scripts/syntax_quality_suite.py", "quality/fixtures/manifest.json", "docs/quality.md" ] : List String)
    , host_script
        "scripts/syntax_quality_suite.py"
        "strict-quality-reference-suite"
        "the suite validates the host token-span rewriter, idempotence, malformed fixture handling, and regex/SARIF strict-firewall reports; it remains coupled to those host references"
        ([ "scripts/syntax_quality_suite.py", "scripts/syntax_quality_fix.py", "scripts/strict_quality_firewall.py", "quality/fixtures/manifest.json" ] : List String)
    , host_script
        "scripts/test_selfhost_bootstrap_evidence.py"
        "bootstrap-evidence-reference-suite"
        "the unittest module validates host command, temp directory, bounded log, and bootstrap report behavior of a host-bound evidence collector"
        ([ "scripts/test_selfhost_bootstrap_evidence.py", "scripts/selfhost_bootstrap_evidence.py" ] : List String)
    ];


def host_smith_path (relative : String) : HostPath :=
    host_script (str_concat "scripts/ourosmith/" relative)
      "smith-independent-test-system"
      "the host harness supervises Ouro Core generation and checking plus independent surface and tool expectations; process limits, exact receipts, seed replay, shrinking and fault builds still depend on Python"
      ([ "docs/ouro_smith.md", "quality/smith/strategies.json", "tests/compiler_smith_runner.ouro" ] : List String);


def host_bound_smith_paths : List HostPath :=
    Cons HostPath
      (host_script "scripts/ouro_smith.py" "smith-host-cli"
        "the CLI coordinates canonical Ouro checking and independently specified generated expectations; process budgets, input recovery and source-bound evidence still require the host harness"
        ([ "docs/ouro_smith.md", "scripts/ourosmith/validation.py", "quality/smith/strategies.json" ] : List String))
      (map String HostPath host_smith_path
        ([ "__init__.py"
        , "core/__init__.py", "core/run.py"
        , "checker_faults.py", "checker_fault_selftest.py"
        , "compiler_evidence.py", "compiler_evidence_test.py", "native.py", "native_selftest.py"
        , "corpus.py", "evidence.py", "exec_child.py", "faults.py", "host.py", "inventory.py"
        , "limits.py", "migration.py", "migration_contracts.py", "native_inputs.py"
        , "provenance.py", "report.py", "rng.py", "selftest.py", "producer_selftest.py"
        , "surface/__init__.py", "surface/analyzer.py", "surface/analyzer_lines.py"
        , "surface/backend.py", "surface/corpus.py", "surface/doc_contract.py", "surface/forms.py"
        , "surface/gen.py", "surface/inventory.py", "surface/io.py", "surface/library.py"
        , "surface/lint_contracts.py", "surface/manifest.py", "surface/mutate.py", "surface/parity.py", "surface/parser.py"
        , "surface/practical.py", "surface/run.py", "surface/text_contracts.py", "surface/tools.py"
        , "surface_faults.py", "validation.py", "windows_job.py"
        ] : List String));


def host_bound_python_paths : List HostPath :=
    append HostPath host_bound_python_a_to_f
      (append HostPath host_bound_python_g_to_k
        (append HostPath host_bound_python_k_to_s
          (append HostPath host_bound_python_s_to_z host_bound_smith_paths)));

-- Shell paths are sorted exactly as `git ls-files '*.sh'` reports them.
def host_bound_shell_fixture_to_lsp : List HostPath :=
    [ host_script
        "samples/bioinformatics/fixture_tool.sh"
        "external-process-sample-fixture"
        "the fixture deliberately proves shell/process integration for bioinformatics samples and is not repository control-plane policy"
        ([ "samples/bioinformatics/fixture_tool.sh", "samples/bioinformatics/hela_rnaseq.ouro", "samples/bioinformatics/variant_calling_support.ouro" ] : List String)
    , host_partial_script
        "scripts/analyze_precision_suite.sh"
        "analyzer-reference-suite"
        "tools/analyze/main.ouro"
        "exact packaged analyzer parity still requires Python-bounded subprocess execution, two native analyzer binaries, and shell repair of dropped nonzero exit semantics"
        ([ "scripts/analyze_precision_suite.sh", "scripts/analyze_bounded.py", "scripts/ouro1.sh", "tools/analyze/drive_main.ouro", "docs/quality.md" ] : List String)
    , host_script
        "scripts/bootstrap.sh"
        "bootstrap-launcher"
        "C bootstrap and Python-assisted build recovery are required before any Ouro-native build executable exists"
        ([ "scripts/bootstrap.sh", "docs/build.md" ] : List String)
    , host_script
        "scripts/build_tool.sh"
        "native-tool-build-launcher"
        "building Ouro-native tools still requires the existing host compiler, bootstrap recovery, generated C packing, and executable wrapper installation"
        ([ "scripts/build_tool.sh", "docs/build.md", "scripts/ouro_ci_gate.sh" ] : List String)
    , thin_script
        "scripts/coil.sh"
        "project-facing-ouro1-alias"
        "scripts/ouro1.sh"
        "coil only remaps verbs onto ouro1 and ouro1 pkg; bootstrap, generated binaries, and compiler checking stay on the existing dispatcher"
        ([ "scripts/coil.sh", "scripts/ouro1.sh", "docs/pkg.md", "docs/tooling.md" ] : List String)
    , thin_script
        "scripts/doc_suite.sh"
        "legacy-documentation-suite-cli"
        "tools/doc.ouro#selftest"
        "Python prepares declarations and independent expected pages; Ouro owns negative IO, files-from, regeneration, and API drift assertions"
