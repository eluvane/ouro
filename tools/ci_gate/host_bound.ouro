-- Stable report over the complete Python/shell migration inventory.

import "host_inventory.ouro",
  "report.ouro",
  "../repo_gate/paths.ouro",
  "../quality/json_surface.ouro",
  "../../std/fsx.ouro",
  "../../std/json.ouro",
  "../../std/stringx.ouro",
  "../../std/format.ouro";


def host_json_kv (key : String) (value : Json) : Pair String Json :=
    MkPair String Json key value;


def host_string_json (s : String) : Json := JStr s;


def host_strings_json (xs : List String) : Json :=
    JArr (map String Json host_string_json xs);


def host_maybe_string_json (m : Maybe String) : Json :=
    match m with
    | Nothing => JNull
    | Just s => JStr s
    end;


def host_replacement_text (h : HostPath) : String :=
    host_replacement h ?? "null";


def host_path_json (h : HostPath) : Json :=
    JObj
      ([ host_json_kv("kind", JStr (host_kind h))
      , host_json_kv("migration_status", JStr (host_kind h))
      , host_json_kv("path", JStr (host_path h))
      , host_json_kv("role", JStr (host_role h))
      , host_json_kv("native_replacement", host_maybe_string_json (host_replacement h))
      , host_json_kv("parity_status", JStr (host_parity h))
      , host_json_kv("removal_eligibility", JStr (host_removal h))
      , host_json_kv("blocker", JStr (host_blocker h))
      , host_json_kv("evidence", host_strings_json (host_evidence h))
      ] : List (Pair String Json));


def host_bound_validation_json (passed : Bool) (report_path : String) : Json :=
    JObj
      ([ host_json_kv("profile", JStr "control-plane-native")
      , host_json_kv("status", JStr (match passed with | True => "pass" | False => "fail" end))
      , host_json_kv("report", JStr report_path)
      ] : List (Pair String Json));


def host_bound_report_json (passed : Bool) (validation_report : String) : Json :=
    JObj
      ([ host_json_kv("kind", JStr "ouro.host-bound-control-plane-report.v3")
      , host_json_kv("version", JStr "3")
      , host_json_kv("pass", JBool passed)
      , host_json_kv("validation", host_bound_validation_json passed validation_report)
      , host_json_kv("paths", JArr (map HostPath Json host_path_json host_bound_paths))
      , host_json_kv "policy_note"
          (JStr "Every tracked Python/shell path must be inventoried as remove, migrate, thin-wrapper, or host-bound. Host code is allowed only with concrete blockers/evidence; wrappers must contain no duplicated policy.")
      ] : List (Pair String Json));


def host_bound_report_string (passed : Bool) (validation_report : String) : String :=
    str_concat(json_print (host_bound_report_json passed validation_report), "\n");


def host_line (h : HostPath) : String :=
    str_join ""
      ([ "HOST_BOUND_PATH ", host_path h, " migration=", host_kind h,
         " role=", host_role h, " parity=", host_parity h,
         " removal=", host_removal h, " native=", host_replacement_text h ]
        : List String);


def host_bound_summary_text (report_path : String) : String :=
    str_unlines
      (Cons String
        (str_cat4 "HOST_BOUND_SUMMARY paths="
          (show_nat (length HostPath host_bound_paths)) " report=" report_path)
        (map HostPath String host_line host_bound_paths));


def ci_root_check (root : String) : IO Unit :=
    repo_require_root_directory "CI root is not a directory: " root;

def write_ci_result_report (profile : String) (result : CiResult) : IO Unit :=
    repo_write(ci_result_gate_report result, ci_result_report_string profile result)


-- Invalidate public results before starting children. A failed or interrupted
-- run cannot lend a previous success report to a consumer. Never remove a
-- directory supplied in place of a report file.
def ci_forget_report (path : String) : IO Unit :=
    match! fs_is_dir path with
    | True => do eprintln (str_concat "CI report is a directory: " path); exit 1
    | False =>
        match! fsx_remove_if_exists path with
        | Left error => do eprintln (fs_error_message error); exit 1
        | Right _ => io_unit
        end
    end


def internal_host_bound_argv : List String :=
    [ "ouro-ci-gate", "--profile", "host-bound" ];


def host_bound_bool_issue (ok : Bool) (reason : String) : List String :=
    match ok with
    | True => Nil String
    | False => [ reason ]
    end;


def host_bound_validation_issues (command_ok : Bool) (report_ok : Bool)
    (validation_report : String) : List String :=
    append String
      (host_bound_bool_issue command_ok
        "inventory consistency validation command failed")
      (host_bound_bool_issue report_ok
        (str_concat "required native validation report missing, malformed, or non-passing: "
          validation_report));


def host_bound_status (passed : Bool) : String :=
    match passed with
    | True => "pass"
    | False => "fail"
    end;


def host_bound_result (passed : Bool) (code : Nat) (log_path : String)
    (gate_report : String) (validation_report : String)
    (command_ok : Bool) (report_ok : Bool) : CiResult :=
    MkCiResult "host-bound-report" (host_bound_status passed)
      internal_host_bound_argv True True Z (Just Nat code) log_path gate_report
      (host_bound_validation_issues command_ok report_ok validation_report);


def json_string_field_eq (doc : Json) (key : String) (want : String) : Bool :=
    match gate_jsonx_get_string doc key with
    | Nothing => False
    | Just got => str_eq got want
    end;

-- JSON getters select the first matching key. Later duplicates can hide failure.
def host_bound_json_unique_object (doc : Json) : Bool :=
    if let JObj fields := doc then
      let keys : List String :=
        map (Pair String Json) String (fst String Json) fields in
      eq_nat(length String keys, length(String, nub String str_eq keys))
    else False;

def host_bound_json_empty_array (doc : Json) (key : String) : Bool :=
    match gate_jsonx_get_array doc key with
    | Nothing => False
    | Just values => nullb Json values
    end;

def host_bound_validation_metric_ok (metric : Json) : Bool :=
    match gate_jsonx_get_string metric "name" with
    | Nothing => False
    | Just _ => match gate_jsonx_get_string metric "value" with
      | Nothing => False
      | Just _ => host_bound_json_unique_object metric
      end
    end;

def host_bound_validation_gate_ok (gate : Json) : Bool :=
    match gate_jsonx_get_string gate "name" with
    | Nothing => False
    | Just _ => match gate_jsonx_get_bool gate "blocking" with
      | Nothing => False
      | Just _ => match gate_jsonx_get_array gate "metrics" with
        | Nothing => False
        | Just metrics =>
            andb (host_bound_json_unique_object gate)
              (andb (json_string_field_eq gate "status" "pass")
                (andb (host_bound_json_empty_array gate "issues")
                  (all Json host_bound_validation_metric_ok metrics)))
        end
      end
    end;

def host_bound_validation_report_text_ok (text : String) : Bool :=
    match gate_parse_json text with
    | Nothing => False
    | Just doc =>
      match gate_jsonx_get_bool doc "pass" with
      | Nothing => False
      | Just passed =>
        match gate_jsonx_get_array doc "gates" with
        | Nothing => False
        | Just gates =>
          andb passed
            (andb (notb (nullb Json gates))
              (andb (host_bound_json_unique_object doc)
                (andb (all Json host_bound_validation_gate_ok gates)
                  (andb (host_bound_json_empty_array doc "issues")
                    (andb (json_string_field_eq doc "kind"
                        "ouro.repo-gate-report.v1")
                      (andb (json_string_field_eq doc "version" "1")
                        (andb (json_string_field_eq doc "profile"
                            "control-plane-native")
                          (andb (json_string_field_eq doc "execution_backend"
                              "ouro-native-repo-gate")
                            (json_string_field_eq doc "execution_mode" "native")))))))))
        end
      end
    end;


def host_bound_validation_report_ok (validation_report : String) : IO Bool :=
    match! fs_read_checked validation_report with
    | Left _ => io_pure Bool False
    | Right text => io_pure(Bool, host_bound_validation_report_text_ok text)
    end


def host_bound_effective_code (command_ok : Bool) (report_ok : Bool)
    (code : Nat) : Nat :=
    match andb command_ok report_ok with
    | True => code
    | False =>
        match eq_nat code Z with
        | True => S Z
        | False => code
        end
    end;


def finish_host_bound_profile (profile : String) (out : String)
    (report_path : String) (validation_report : String)
    (command_ok : Bool) (report_ok : Bool) (code : Nat) : IO Unit :=
    let passed : Bool := andb command_ok report_ok in
    let effective_code : Nat :=
      host_bound_effective_code command_ok report_ok code in
    let log_path : String := fs_child out "host-bound.log" in
    let gate_report : String := fs_child out "host-bound-report.json" in
    let result : CiResult :=
      host_bound_result passed effective_code log_path gate_report validation_report
        command_ok report_ok in
    let summary_path : String := fs_child out "ci-summary.json" in
    do repo_write(report_path, host_bound_report_string passed validation_report);
       repo_write(log_path, str_concat(host_bound_summary_text report_path, "\n"));
       write_ci_result_report profile result;
       repo_write(summary_path, ci_report_string(profile, [ result ] : List CiResult));
       println (host_bound_summary_text report_path);
       println (ci_summary_text profile ([ result ] : List CiResult) summary_path);
       match passed with
       | True => exit 0
       | False => exit 1
       end


def run_host_bound_profile_with (profile : String) (root : String) (out : String)
    (validate : String -> String -> IO ProcResult) : IO Unit :=
    let report_path : String := fs_child out "host-bound.json" in
    let validation_out : String := fs_child out "inventory-validation" in
    let validation_report : String := fs_child validation_out "repo-gate.json" in
    do ci_root_check root;
       repo_mkdir out;
       io_foreach String ci_forget_report
         ([ fs_child out "ci-summary.json", report_path,
            fs_child out "host-bound-report.json", validation_report ] : List String);
       let! checked := validate root validation_out;
       let! report_ok := host_bound_validation_report_ok validation_report;
       finish_host_bound_profile profile out report_path validation_report
         (proc_ok checked) report_ok (proc_code checked)


def list_host_bound_profile : IO Unit :=
    do println "INFO host-bound-report internal host-bound control-plane inventory";
       exit 0
