-- Stable report over the complete Python/shell migration inventory.

import "host_inventory.ouro",
  "../../std/json.ouro",
  "../../std/stringx.ouro",
  "../../std/format.ouro";


def host_json_kv (key : String) (value : Json) : Pair String Json :=
    MkPair String Json key value;


def host_string_json (s : String) : Json := JStr s;


def host_strings_json (xs : List String) : Json :=
    JArr (map String Json host_string_json xs);


def host_maybe_string_json (m : Maybe String) : Json :=
    match m with
    | Nothing => JNull
    | Just s => JStr s
    end;


def host_replacement_text (h : HostPath) : String :=
    match host_replacement h with
    | Nothing => "null"
    | Just s => s
    end;


def host_path_json (h : HostPath) : Json :=
    JObj
      ([ host_json_kv("kind", JStr (host_kind h))
      , host_json_kv("migration_status", JStr (host_kind h))
      , host_json_kv("path", JStr (host_path h))
      , host_json_kv("role", JStr (host_role h))
      , host_json_kv("native_replacement", host_maybe_string_json (host_replacement h))
      , host_json_kv("parity_status", JStr (host_parity h))
      , host_json_kv("removal_eligibility", JStr (host_removal h))
      , host_json_kv("blocker", JStr (host_blocker h))
      , host_json_kv("evidence", host_strings_json (host_evidence h))
      ] : List (Pair String Json));


def host_bound_validation_json (passed : Bool) (report_path : String) : Json :=
    JObj
      ([ host_json_kv("profile", JStr "control-plane-native")
      , host_json_kv("status", JStr (match passed with | True => "pass" | False => "fail" end))
      , host_json_kv("report", JStr report_path)
      ] : List (Pair String Json));


def host_bound_report_json (passed : Bool) (validation_report : String) : Json :=
    JObj
      ([ host_json_kv("kind", JStr "ouro.host-bound-control-plane-report.v3")
      , host_json_kv("version", JStr "3")
      , host_json_kv("pass", JBool passed)
      , host_json_kv("validation", host_bound_validation_json passed validation_report)
      , host_json_kv("paths", JArr (map HostPath Json host_path_json host_bound_paths))
      , host_json_kv "policy_note"
          (JStr "Every tracked Python/shell path must be inventoried as remove, migrate, thin-wrapper, or host-bound. Host code is allowed only with concrete blockers/evidence; wrappers must contain no duplicated policy.")
      ] : List (Pair String Json));


def host_bound_report_string (passed : Bool) (validation_report : String) : String :=
    str_concat(json_print (host_bound_report_json passed validation_report), "\n");


def host_line (h : HostPath) : String :=
    str_join ""
      ([ "HOST_BOUND_PATH ", host_path h, " migration=", host_kind h,
         " role=", host_role h, " parity=", host_parity h,
         " removal=", host_removal h, " native=", host_replacement_text h ]
        : List String);


def host_bound_summary_text (report_path : String) : String :=
    str_unlines
      (Cons String
        (str_cat4 "HOST_BOUND_SUMMARY paths="
          (show_nat (length HostPath host_bound_paths)) " report=" report_path)
        (map HostPath String host_line host_bound_paths));
