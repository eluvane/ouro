-- Stable report model for the Ouro-native CI/task runner foundation.

import "../../std/json.ouro";
import "../../std/stringx.ouro";
import "../../std/format.ouro";

inductive CiResult : Type :=
  | MkCiResult : String -> String -> List String -> Bool -> Bool -> Nat -> Maybe Nat -> String -> String -> List String -> CiResult;


def ci_result_name (r : CiResult) : String :=
    match r with
    | MkCiResult name _ _ _ _ _ _ _ _ _ => name
    end;


def ci_result_status (r : CiResult) : String :=
    match r with
    | MkCiResult _ status _ _ _ _ _ _ _ _ => status
    end;


def ci_result_argv (r : CiResult) : List String :=
    match r with
    | MkCiResult _ _ argv _ _ _ _ _ _ _ => argv
    end;


def ci_result_required (r : CiResult) : Bool :=
    match r with
    | MkCiResult _ _ _ required _ _ _ _ _ _ => required
    end;


def ci_result_blocking (r : CiResult) : Bool :=
    match r with
    | MkCiResult _ _ _ _ blocking _ _ _ _ _ => blocking
    end;


def ci_result_elapsed (r : CiResult) : Nat :=
    match r with
    | MkCiResult _ _ _ _ _ elapsed _ _ _ _ => elapsed
    end;


def ci_result_code (r : CiResult) : Maybe Nat :=
    match r with
    | MkCiResult _ _ _ _ _ _ code _ _ _ => code
    end;


def ci_result_log (r : CiResult) : String :=
    match r with
    | MkCiResult _ _ _ _ _ _ _ log _ _ => log
    end;


def ci_result_gate_report (r : CiResult) : String :=
    match r with
    | MkCiResult _ _ _ _ _ _ _ _ report _ => report
    end;


def ci_result_issues (r : CiResult) : List String :=
    match r with
    | MkCiResult _ _ _ _ _ _ _ _ _ issues => issues
    end;


def ci_json_kv (key : String) (value : Json) : Pair String Json :=
    MkPair String Json key value;


def string_json (s : String) : Json := JStr s;


def strings_json (xs : List String) : Json :=
    JArr (map String Json string_json xs);


def maybe_nat_json (m : Maybe Nat) : Json :=
    match m with
    | Nothing => JNull
    | Just n => JNum (show_nat n)
    end;


def ci_result_json (r : CiResult) : Json :=
    JObj
      ([ ci_json_kv "name" (JStr (ci_result_name r))
      , ci_json_kv "status" (JStr (ci_result_status r))
      , ci_json_kv "execution_backend" (JStr "subprocess")
      , ci_json_kv "command_argv" (strings_json (ci_result_argv r))
      , ci_json_kv "required" (JBool (ci_result_required r))
      , ci_json_kv "blocking" (JBool (ci_result_blocking r))
      , ci_json_kv "elapsed_ms" (JNum (show_nat (ci_result_elapsed r)))
      , ci_json_kv "returncode" (maybe_nat_json (ci_result_code r))
      , ci_json_kv "output_log" (JStr (ci_result_log r))
      , ci_json_kv "gate_report" (JStr (ci_result_gate_report r))
      , ci_json_kv "issues" (strings_json (ci_result_issues r))
      ] : List (Pair String Json));


def ci_result_report_json (profile : String) (r : CiResult) : Json :=
    JObj
      ([ ci_json_kv "kind" (JStr "ouro.ci-gate-result.v1")
      , ci_json_kv "version" (JStr "1")
      , ci_json_kv "profile" (JStr profile)
      , ci_json_kv "execution_backend" (JStr "ouro-native-ci-gate")
      , ci_json_kv "gate" (ci_result_json r)
      ] : List (Pair String Json));


def ci_result_nonpass_blocking (r : CiResult) : Bool :=
    andb (ci_result_blocking r) (notb (str_eq (ci_result_status r) "pass"));


def ci_results_pass (rs : List CiResult) : Bool :=
  andb (notb (nullb CiResult rs))
    (all CiResult
      (fun (r : CiResult) => notb (ci_result_nonpass_blocking r)) rs);


def ci_collect_issue_lines (rs : List CiResult) : List String :=
  concat_map CiResult String
    (fun (r : CiResult) =>
      map String String
        (fun (issue : String) => str_cat4 (ci_result_name r) ": " issue "")
        (ci_result_issues r))
    rs;


def ci_execution_mode (profile : String) : String :=
    match str_eq profile "host-bound" with
    | True => "host-bound"
    | False => "native-orchestrator"
    end;


def ci_report_json (profile : String) (results : List CiResult) : Json :=
    JObj
      ([ ci_json_kv "kind" (JStr "ouro.ci-gate-report.v1")
      , ci_json_kv "version" (JStr "1")
      , ci_json_kv "profile" (JStr profile)
      , ci_json_kv "execution_backend" (JStr "ouro-native-ci-gate")
      , ci_json_kv "execution_mode" (JStr (ci_execution_mode profile))
      , ci_json_kv "pass" (JBool (ci_results_pass results))
      , ci_json_kv "gates" (JArr (map CiResult Json ci_result_json results))
      , ci_json_kv "issues" (strings_json (ci_collect_issue_lines results))
      , ci_json_kv "policy_note"
          (JStr "This Ouro-native runner is a parity-driven migration path. scripts/ci_gate.py remains the explicit compatibility/reference PR readiness runner until full parity is proven.")
      ] : List (Pair String Json));


def ci_report_string (profile : String) (results : List CiResult) : String :=
    str_concat (json_print (ci_report_json profile results)) "\n";


def ci_result_report_string (profile : String) (r : CiResult) : String :=
    str_concat (json_print (ci_result_report_json profile r)) "\n";


def ci_result_line (r : CiResult) : String :=
    str_cat4 "CI_GATE_RESULT " (ci_result_name r) " status="
      (str_cat4 (ci_result_status r) " required="
        (show_bool (ci_result_required r))
        (str_cat4 " blocking=" (show_bool (ci_result_blocking r))
          " elapsed_ms=" (show_nat (ci_result_elapsed r))));


def ci_summary_text (profile : String) (results : List CiResult) (report_path : String) : String :=
    str_unlines
      (append String
        ([ str_cat4 "CI_GATE_SUMMARY profile=" profile " pass="
            (str_cat3 (show_bool (ci_results_pass results)) " gates="
              (str_cat3 (show_nat (length CiResult results)) " report="
                report_path))
        ] : List String)
        (append String
          (map CiResult String ci_result_line results)
          (map String String
            (fun (issue : String) => str_concat "CI_GATE_ISSUE " issue)
            (ci_collect_issue_lines results))));
