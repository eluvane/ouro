-- Place ouro-repo-gate.exe beside the native host-bound worker.
-- @entry main
import "native_host_bound_model.ouro",
  "host_bound.ouro",
  "../native_sibling.ouro",
  "../../std/io.ouro";

def native_host_bound_usage : String :=
    "usage: ouro-ci-host-bound [--profile host-bound] [--root DIR] [--out DIR] [--list] [--fail-fast] [--quiet] [--echo-output]";

def native_host_bound_validate (root : String) (validation_out : String) : IO ProcResult :=
    do let! captured := native_sibling_run native_host_bound_limits native_host_bound_sibling
         (native_host_bound_validation_argv root validation_out);
       let result : ProcResult := native_host_bound_process_result captured in
       match captured with
       | Left _ => do eprint (proc_stderr result); io_pure ProcResult result
       | Right _ => io_pure ProcResult result
       end

def main : IO Unit :=
    do let! raw := argv;
       let a : Args := args_of_argv_bools native_host_bound_switches raw in
       match native_host_bound_cli_valid raw a with
       | False =>
           do eprintln "invalid native host-bound arguments";
              eprint (args_show a);
              eprintln native_host_bound_usage;
              exit 2
       | True =>
           match args_flag a "help" with
           | True => do eprintln native_host_bound_usage; exit 2
           | False =>
               match args_flag a "list" with
               | True => list_host_bound_profile
               | False =>
                   run_host_bound_profile_with "host-bound"
                     (args_opt_or a "root" ".")
                     (args_opt_or a "out" "_build/ouro_ci/host-bound")
                     native_host_bound_validate
               end
           end
       end
