-- Independent native acceptance observers, separate from quality rule owners.
-- Keep inventory modules below the structured analyzer's per-source budget.

import "host_inventory_model.ouro";

def host_native_observers : List HostPath :=
    [ host_script
        "scripts/fix_check_suite.py"
        "fix-compiler-check-observer"
        "independent public CLI tests verify full import checking, worker failures, source preservation and convergence"
        ([ "scripts/fix_suite.sh", "tools/fix/check_main.ouro", "tools/fix/candidate_check.ouro" ] : List String)
    , host_script
        "scripts/fs_read_suite.py"
        "source-read-observer"
        "independent host tests compare exact bytes and unreadable-input refusal through real runtime and analyzer binaries"
        ([ "scripts/runtime_io_suite.sh", "scripts/analyze_precision_suite.sh" ] : List String)
    , host_script
        "scripts/fs_replace_suite.py"
        "source-publication-observer"
        "independent host tests compare bytes, file identities, metadata and recovery states around real native filesystem operations and public fmt/fix CLIs"
        ([ "scripts/fix_suite.sh", "scripts/fmt_suite.sh", "scripts/runtime_io_suite.sh", "scripts/frontend_host_suite.py", "tests/quality_source_write_driver.ouro", "tools/quality/source_write.ouro" ] : List String)
    , host_script
        "scripts/frontend_native_async.py"
        "native-sleep-observer"
        "independent host tests measure OS timing and exact bytes for native sleep source faults"
        ([ "scripts/frontend_host_suite.py", "scripts/build_cache_config_suite.py", "tests/native_async_sleep_probe.ouro" ] : List String)
    , host_script
        "scripts/frontend_native_fs_create.py"
        "native-directory-observer"
        "independent host tests supervise concurrent directory creation and verify source faults, PE imports and filesystem results"
        ([ "scripts/frontend_host_suite.py", "scripts/build_cache_config_suite.py", "tests/native_fs_create_dir_probe.ouro" ] : List String)
    , host_script
        "scripts/frontend_native_process.py"
        "native-process-observer"
        "independent host tests inspect PE images, retain descendant handles and verify cancellation and raw process output"
        ([ "scripts/frontend_host_suite.py", "scripts/build_cache_config_suite.py", "tests/process_capture_bounded_tests.ouro" ] : List String)
    , host_script
        "scripts/native_suite_tools.py"
        "native-suite-image-observer"
        "host acceptance snapshots explicitly provisioned PE siblings and detects image changes during retained suites; separate build receipts establish source provenance"
        ([ "scripts/lsp_suite.sh", "scripts/pkg_suite.sh", "scripts/test_suite.sh", "scripts/samples_suite.sh", "scripts/build_cache_config_suite.py" ] : List String)
    , host_script
        "scripts/tool_preparation_suite.py"
        "tool-preparation-cache-observer"
        "host fixtures mock compiler emission and linking to check content invalidation, interrupted builds, companion receipts and ordered preparation without claiming native acceptance"
        ([ "scripts/tool_preparation_suite.py", "scripts/native_tool_build.py", "scripts/frontend_regen.py", "scripts/lint_suite.sh" ] : List String)
    , host_script
        "tests/clippy_semantic/session_protocol.py"
        "session-transport-observer"
        "host tests compare exact native snapshots and reject incomplete sessions; not a semantic or performance authority"
        ([ "scripts/lint_suite.sh", "tools/clippy/session.ouro" ] : List String)
    ];
