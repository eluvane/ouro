-- Row model and constructors for the repository's host tooling inventory.
-- `host_kind` is the migration status: remove, migrate, thin-wrapper, or host-bound.

import "../../std/string.ouro";

inductive HostPath : Type :=
  | MkHostPath : String -> String -> String -> Maybe String -> String -> String -> String -> List String -> HostPath;


def host_kind (h : HostPath) : String :=
    match h with
    | MkHostPath kind _ _ _ _ _ _ _ => kind
    end;


def host_path (h : HostPath) : String :=
    match h with
    | MkHostPath _ path _ _ _ _ _ _ => path
    end;


def host_role (h : HostPath) : String :=
    match h with
    | MkHostPath _ _ role _ _ _ _ _ => role
    end;


def host_replacement (h : HostPath) : Maybe String :=
    match h with
    | MkHostPath _ _ _ replacement _ _ _ _ => replacement
    end;


def host_parity (h : HostPath) : String :=
    match h with
    | MkHostPath _ _ _ _ parity _ _ _ => parity
    end;


def host_removal (h : HostPath) : String :=
    match h with
    | MkHostPath _ _ _ _ _ removal _ _ => removal
    end;


def host_blocker (h : HostPath) : String :=
    match h with
    | MkHostPath _ _ _ _ _ _ blocker _ => blocker
    end;


def host_evidence (h : HostPath) : List String :=
    match h with
    | MkHostPath _ _ _ _ _ _ _ evidence => evidence
    end;


def host_script (path : String) (role : String) (blocker : String)
    (evidence : List String) : HostPath :=
    MkHostPath "host-bound" path role (Nothing String) "none" "not-removable"
      blocker evidence;


def host_partial_script (path : String) (role : String) (replacement : String)
    (blocker : String) (evidence : List String) : HostPath :=
    MkHostPath "host-bound" path role (Just String replacement) "partial" "not-removable"
      blocker evidence;


def thin_script (path : String) (role : String) (replacement : String)
    (blocker : String) (evidence : List String) : HostPath :=
    MkHostPath "thin-wrapper" path role (Just String replacement) "full-wrapper" "wrapper-only"
      blocker evidence;


def thin_host_script (path : String) (role : String) (blocker : String)
    (evidence : List String) : HostPath :=
    MkHostPath "thin-wrapper" path role (Nothing String) "none" "wrapper-only"
      blocker evidence;


def removed_dead_script (path : String) (role : String) (reason : String)
    (evidence : List String) : HostPath :=
    MkHostPath "remove" path role (Nothing String) "none" "removable-now"
      reason evidence;


def removed_replaced_script (path : String) (role : String) (replacement : String)
    (reason : String) (evidence : List String) : HostPath :=
    MkHostPath "remove" path role (Just String replacement) "full" "removable-now"
      reason evidence;


-- Python paths are sorted exactly as `git ls-files '*.py'` reports them.
