-- Standalone entry for repository-control-plane fixture and retirement parity.

-- @entry main

import "native_repo_selftest.ouro";
import "../../std/args.ouro";
import "../../std/io.ouro";


def native_repo_selftest_switches : List String := [ "probe-failure" ];


def main : IO Unit :=
    do let! xs := argv;
       run_native_repo_ci_selftest
         (args_of_argv_bools native_repo_selftest_switches xs)
