-- Fixed native child policy; the reference CI entry keeps its shell route.
import "host_bound.ouro",
  "../native_sibling_model.ouro",
  "../../std/args.ouro",
  "../../std/process.ouro";

def native_host_bound_sibling : String := "ouro-repo-gate.exe";

def native_host_bound_validation_argv (root : String) (validation_out : String)
    : List String :=
    [ "--profile", "control-plane-native", "--root", root, "--out", validation_out ];

def native_host_bound_limits : ProcessCaptureLimits :=
    native_sibling_limits (mul(90, mul 100 100));

def native_host_bound_switches : List String :=
    [ "list", "fail-fast", "quiet", "echo-output", "help" ];

def native_host_bound_allowed_options : List String := [ "profile", "root", "out" ];

def native_host_bound_cli_valid (raw : List String) (a : Args) : Bool :=
    andb (args_argv_options_complete native_host_bound_switches raw)
      (andb (nullb(String, args_positional a))
        (andb (all String
            (fun (name : String) => elem String str_eq name native_host_bound_switches)
            (args_flags a))
          (andb (all String
              (fun (name : String) => elem String str_eq name native_host_bound_allowed_options)
              (map_keys(String, args_opts a)))
            (str_eq(args_opt_or a "profile" "host-bound", "host-bound")))));

-- A setup or capture failure cannot acquire the child's successful status.
def native_host_bound_process_result (captured : Either NativeSiblingError ProcResult)
    : ProcResult :=
    match captured with
    | Left error => MkProcResult 127 ""
        (str_concat(native_sibling_error_message error, "\n"))
    | Right child => child
    end;
