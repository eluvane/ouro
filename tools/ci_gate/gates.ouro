        ([ "--version" ] : List String)
        False
        False
        (Just String "optional host command is unavailable in this profile")
        ([ "selftest-unavailable" ] : List String)
    ];


def select_ci_gates (profile : String) (name : Maybe String) : List CiGate :=
    filter CiGate
      (fun (g : CiGate) =>
        andb (ci_gate_in_profile profile g) (ci_gate_matches_name name g))
      all_ci_gates;
