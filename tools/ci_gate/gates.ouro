        ([ "quickstart-native" ] : List String)
    , MkCiGate
        "doc-suite"
        "sh"
        ([ "scripts/doc_suite.sh" ] : List String)
        True
        True
        (Nothing String)
        ([ "suite-native" ] : List String)
    , MkCiGate
        "test-suite"
        "sh"
        ([ "scripts/test_suite.sh" ] : List String)
