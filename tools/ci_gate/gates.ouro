        ([ "retirement" ] : List String)
    , MkCiGate
        "host-bound-report"
        "sh"
        ([ "scripts/ouro_ci_gate.sh", "--profile", "host-bound", "--out", "{out}/host-bound" ] : List String)
        True
        True
        (Nothing String)
        ([ "control-plane-native", "retirement" ] : List String)
    , MkCiGate
        "native-retirement-fixtures"
        "sh"
        ([ "scripts/ouro_native_repo_ci_suite.sh" ] : List String)
        True
        True
        (Nothing String)
        ([ "control-plane-native", "retirement" ] : List String)
    , MkCiGate
        "quickstart-check-io"
        "sh"
        ([ "scripts/ouro1.sh", "check", "std/io.ouro" ] : List String)
        True
        True
        (Nothing String)
        ([ "quickstart-native" ] : List String)
    , MkCiGate
        "quickstart-eval-nat"
        "sh"
        ([ "scripts/ouro1.sh", "eval", "samples/examples/nat.ouro", "--eval", "add four two" ] : List String)
        True
        True
        (Nothing String)
        ([ "quickstart-native" ] : List String)
    , MkCiGate
        "quickstart-check-effects"
        "sh"
        ([ "scripts/ouro1.sh", "check", "samples/tutorial/06_effects.ouro" ] : List String)
        True
        True
        (Nothing String)
        ([ "quickstart-native" ] : List String)
    , MkCiGate
        "quickstart-test-demo"
        "sh"
        ([ "scripts/ouro1.sh", "test", "samples/examples/test_demo.ouro" ] : List String)
        True
        True
