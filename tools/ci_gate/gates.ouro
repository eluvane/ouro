-- CI gates are data: name, argv, required/blocking policy, optional availability, profiles.

import "../../std/stringx.ouro";
import "../../std/pathx.ouro";

inductive CiGate : Type :=
  | MkCiGate : String -> String -> List String -> Bool -> Bool -> Maybe String -> List String -> CiGate;


def ci_gate_name (g : CiGate) : String :=
    match g with
    | MkCiGate name _ _ _ _ _ _ => name
    end;


def ci_gate_program (g : CiGate) : String :=
    match g with
    | MkCiGate _ program _ _ _ _ _ => program
    end;


def ci_gate_args (g : CiGate) : List String :=
    match g with
    | MkCiGate _ _ args _ _ _ _ => args
    end;


def ci_gate_required (g : CiGate) : Bool :=
    match g with
    | MkCiGate _ _ _ required _ _ _ => required
    end;


def ci_gate_blocking (g : CiGate) : Bool :=
    match g with
    | MkCiGate _ _ _ _ blocking _ _ => blocking
    end;


def ci_gate_unavailable (g : CiGate) : Maybe String :=
    match g with
    | MkCiGate _ _ _ _ _ unavailable _ => unavailable
    end;


def ci_gate_profiles (g : CiGate) : List String :=
    match g with
    | MkCiGate _ _ _ _ _ _ profiles => profiles
    end;


def ci_gate_in_profile (profile : String) (g : CiGate) : Bool :=
    elem String str_eq profile (ci_gate_profiles g);


def ci_arg_replace (root : String) (out : String) (arg : String) : String :=
    str_replace (str_replace arg "{root}" root) "{out}" out;


def ci_gate_resolved_args (root : String) (out : String) (g : CiGate) : List String :=
    map String String (ci_arg_replace root out) (ci_gate_args g);


def ci_gate_argv (root : String) (out : String) (g : CiGate) : List String :=
    Cons String (ci_gate_program g) (ci_gate_resolved_args root out g);


def ci_gate_command_text (root : String) (out : String) (g : CiGate) : String :=
    str_join " " (ci_gate_argv root out g);


def ci_gate_matches_name (name : Maybe String) (g : CiGate) : Bool :=
    match name with
    | Nothing => True
    | Just n => str_eq n (ci_gate_name g)
    end;


def all_ci_gates : List CiGate :=
    [ MkCiGate
        "repo-gate-project"
        "sh"
        ([ "scripts/ouro_repo_gate.sh", "--profile", "project-native", "--root", "{root}", "--out", "{out}/repo-project" ] : List String)
        True
        True
        (Nothing String)
        ([ "smoke", "project", "project-native", "repo", "repo-native", "pr-native" ] : List String)
    , MkCiGate
        "repo-gate-docs"
        "sh"
        ([ "scripts/ouro_repo_gate.sh", "--profile", "docs-native", "--root", "{root}", "--out", "{out}/repo-docs" ] : List String)
        True
        True
        (Nothing String)
        ([ "docs", "docs-native", "repo", "repo-native", "pr-native" ] : List String)
    , MkCiGate
