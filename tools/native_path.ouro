import "../std/natx.ouro",
  "../std/string_prims.ouro";

def native_path_last_separator (is_separator : Nat -> Bool) : List Nat -> Nat -> Maybe Nat :=
  fix scan (codes : List Nat) (index : Nat) : Maybe Nat :=
    match codes with
    | Nil => Nothing Nat
    | Cons code rest => match scan(rest, S index) with
      | Just later => Just Nat later
      | Nothing => if is_separator code then Just Nat index else Nothing Nat
      end
    end;

def native_path_is_separator (code : Nat) : Bool :=
    orb(eq_nat code 47, eq_nat code 92);

def native_path_dirname (path : String) : String :=
    match native_path_last_separator native_path_is_separator (prim_string_to_char_codes path) 0 with
    | Nothing => "."
    | Just index =>
        if orb (eq_nat index 0)
            (andb(eq_nat index 2, prim_string_eq(prim_string_slice path 1 1, ":"))) then
          prim_string_slice path 0 (S index)
        else prim_string_slice path 0 index
    end;

def native_path_join (dir : String) (name : String) : String :=
    match prim_string_length dir with
    | Z => name
    | S last =>
        if native_path_is_separator (prim_string_byte_at dir last) then prim_string_concat dir name
        else prim_string_concat(dir, prim_string_concat "/" name)
    end;
