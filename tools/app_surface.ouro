-- Real acceptance CLI that composes practical stdlib layers into
-- file/data/config/process tools.

-- @entry main

import "../std/practical.ouro";
import "../std/fs_walk.ouro";
import "../std/process.ouro";
import "../std/json_types.ouro";
import "../std/json.ouro";
import "app_surface_lib.ouro";

def app_usage : String :=
    str_unlines
      ([ "usage: ouro-app-surface <command> ..."
       , ""
       , "commands:"
       , "  json validate PATH       parse JSON and emit a JSON validity report"
       , "  json minify PATH         parse JSON and emit compact JSON"
       , "  csv report PATH          parse CSV and emit row/column JSON report"
       , "  csv select PATH COLUMN   print a named CSV column"
       , "  csv tsv PATH COLS        project comma-separated COLS and emit TSV"
       , "  config normalize PATH    parse key=value config and print normalized form"
       , "  config report PATH       parse key=value config and emit JSON report"
       , "  fs scan PATH             checked deterministic workspace scan report"
       , "  run echo WORD            run echo with argv-list process execution"
       ] : List String);

def app_exit_success : Nat := Z;

def app_exit_failure : Nat := S Z;

def app_print_usage : IO Unit :=
    do process_out_line app_usage;
       process_exit app_exit_success

def app_fail (msg : String) : IO Unit :=
    do process_err_line (str_concat "error: " msg);
       process_exit app_exit_failure

def app_fail_usage (msg : String) : IO Unit :=
    do process_err_line (str_concat "error: " msg);
       process_err_line app_usage;
       process_exit app_exit_failure

def app_print_json_exit (code : Nat) (j : Json) : IO Unit :=
    do process_out_line (app_report_text j);
       process_exit code

def app_read_text (path : String) (k : String -> IO Unit) : IO Unit :=
    do let! read := fsx_read_text path;
       match read with
       | Left e => app_fail (fs_error_message e)
       | Right text => k text
       end

def app_need_pos (a : Args) (index : Nat) (name : String)
    (k : String -> IO Unit) : IO Unit :=
    match cli_required_pos a index name with
    | Left e => app_fail_usage (cli_error_message e)
    | Right value => k value
    end;

def app_json_validate_file (path : String) : IO Unit :=
    app_read_text path
      (fun (text : String) =>
        let report : Json := app_json_validate_report text in
        match parse_json text with
        | Nothing => app_print_json_exit app_exit_failure report
        | Just _ => app_print_json_exit app_exit_success report
        end);

def app_json_minify_file (path : String) : IO Unit :=
    app_read_text path
      (fun (text : String) =>
        match app_json_minify text with
        | Left e => app_fail (app_surface_error_message e)
        | Right out =>
            do process_out_line out;
               process_exit app_exit_success
        end);

def app_csv_report_file (path : String) : IO Unit :=
    app_read_text path
      (fun (text : String) =>
        app_print_json_exit app_exit_success
          (app_csv_report_json path (csv_parse text)));

def app_csv_select_file (path : String) (column : String) : IO Unit :=
    app_read_text path
      (fun (text : String) =>
        match app_csv_select_column (csv_parse text) column with
        | Left e => app_fail (app_surface_error_message e)
        | Right out =>
            do process_out_line out;
               process_exit app_exit_success
        end);

def app_csv_tsv_file (path : String) (columns : String) : IO Unit :=
    app_read_text path
      (fun (text : String) =>
        match app_tsv_from_csv_columns (csv_parse text) (str_split_str columns ",") with
        | Left e => app_fail (app_surface_error_message e)
        | Right out =>
            do process_out_line out;
               process_exit app_exit_success
        end);

def app_config_normalize_file (path : String) : IO Unit :=
    app_read_text path
      (fun (text : String) =>
        do process_out_line (app_config_normalize text);
           process_exit app_exit_success);

def app_config_report_file (path : String) : IO Unit :=
    app_read_text path
      (fun (text : String) =>
        app_print_json_exit app_exit_success
          (app_config_report_json (config_parse text)));

def app_fs_scan (root : String) : IO Unit :=
    do let! walked := fs_walk_checked root;
       match walked with
       | FsWalkComplete _ =>
           app_print_json_exit app_exit_success (app_fs_walk_report_json root walked)
       | FsWalkTruncated _ =>
           app_print_json_exit app_exit_failure (app_fs_walk_report_json root walked)
       | FsWalkUnreadable _ =>
           app_print_json_exit app_exit_failure (app_fs_walk_report_json root walked)
       | FsWalkUnsafe _ =>
           app_print_json_exit app_exit_failure (app_fs_walk_report_json root walked)
       end

def app_run_echo (word : String) : IO Unit :=
    let cmd : CommandSpec := command_spec "echo" ([word] : List String) in
    do let! result := process_run_spec cmd;
       app_print_json_exit (proc_code result) (app_proc_result_report cmd result)

def app_dispatch_json_sub (a : Args) (sub : String) : IO Unit :=
    match str_eq sub "validate" with
    | True =>
        app_need_pos a 2 "path"
          app_json_validate_file
    | False =>
      match str_eq sub "minify" with
      | True =>
          app_need_pos a 2 "path"
            app_json_minify_file
      | False => app_fail_usage (str_concat "unknown json command: " sub)
      end
    end;

def app_dispatch_csv_sub (a : Args) (sub : String) : IO Unit :=
    match str_eq sub "report" with
    | True =>
        app_need_pos a 2 "path"
          app_csv_report_file
    | False =>
      match str_eq sub "select" with
      | True =>
          app_need_pos a 2 "path"
            (fun (path : String) =>
              app_need_pos a 3 "column"
                (app_csv_select_file path))
      | False =>
        match str_eq sub "tsv" with
        | True =>
            app_need_pos a 2 "path"
              (fun (path : String) =>
                app_need_pos a 3 "columns"
                  (app_csv_tsv_file path))
        | False => app_fail_usage (str_concat "unknown csv command: " sub)
        end
      end
    end;

def app_dispatch_config_sub (a : Args) (sub : String) : IO Unit :=
    match str_eq sub "normalize" with
    | True =>
        app_need_pos a 2 "path"
          app_config_normalize_file
    | False =>
      match str_eq sub "report" with
      | True =>
          app_need_pos a 2 "path"
            app_config_report_file
      | False => app_fail_usage (str_concat "unknown config command: " sub)
      end
    end;

def app_dispatch_fs_sub (a : Args) (sub : String) : IO Unit :=
    match str_eq sub "scan" with
    | True =>
        app_need_pos a 2 "path" app_fs_scan
    | False => app_fail_usage (str_concat "unknown fs command: " sub)
    end;

def app_dispatch_run_sub (a : Args) (sub : String) : IO Unit :=
    match str_eq sub "echo" with
    | True =>
        app_need_pos a 2 "word" app_run_echo
    | False => app_fail_usage (str_concat "unknown run command: " sub)
    end;

def app_dispatch (a : Args) : IO Unit :=
    match args_flag a "help" with
    | True => app_print_usage
    | False =>
      app_need_pos a 0 "command"
        (fun (cmd : String) =>
          match str_eq cmd "json" with
          | True =>
              app_need_pos a 1 "json command"
                (app_dispatch_json_sub a)
          | False =>
            match str_eq cmd "csv" with
            | True =>
                app_need_pos a 1 "csv command"
                  (app_dispatch_csv_sub a)
            | False =>
              match str_eq cmd "config" with
              | True =>
                  app_need_pos a 1 "config command"
                    (app_dispatch_config_sub a)
              | False =>
                match str_eq cmd "fs" with
                | True =>
                    app_need_pos a 1 "fs command"
                      (app_dispatch_fs_sub a)
                | False =>
                  match str_eq cmd "run" with
                  | True =>
                      app_need_pos a 1 "run command"
                        (app_dispatch_run_sub a)
                  | False => app_fail_usage (str_concat "unknown command: " cmd)
                  end
                end
              end
            end
          end)
    end;

def main : IO Unit :=
    do let! av := process_argv;
       app_dispatch (cli_from_argv (["help"] : List String) av)
