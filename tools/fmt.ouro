-- Formatter CLI writes only when requested and only after token/fixpoint
-- validation; check mode keeps CI fail-closed on drift or unsafe candidates.

-- @entry main

import "fmt_pipeline.ouro",
  "fmt_paths.ouro",
  "quality/source_write.ouro",
  "fix/candidate_check.ouro",
  "selftest_fs.ouro",
  "../std/io.ouro",
  "../std/fs.ouro",
  "../std/args.ouro",
  "../std/format.ouro",
  "../std/processx.ouro";

def fmt_show_bool (b : Bool) : String :=
    show_bool b;

-- Exit status is the union over files, so one unformatted file fails the run
-- but every file still gets reported.
def fmt_write (path : String) (src : String) (out : String) : IO Bool :=
    (if str_eq src out then io_pure Bool True
    else
      match! fmt_check_candidate path src out with
      | Left e =>
          do eprintln (str_cat3 path ": " (fs_error_message e));
             io_pure Bool False
      | Right _ =>
          match! quality_write_source_checked path src out with
          | Left e =>
              do eprintln (str_cat3 path ": " (fs_error_message e));
                 io_pure Bool False
          | Right _ =>
              do println (concat "formatted " path);
                 io_pure Bool True
          end
      end)


def fmt_loaded (a : Args) (path : String) (src : String) : IO Bool :=
    match fmt_checked src with
    | Left e =>
        do eprintln (str_cat3 path ": " (fmt_error_message e));
           io_pure Bool False
    | Right out =>
        if args_flag a "check" then
          if str_eq src out then io_pure Bool True
          else
            do eprintln (concat path ": needs formatting");
               io_pure Bool False
        else
          if args_flag a "write" then fmt_write path src out
          else
            do print out;
               io_pure Bool True
    end


def fmt_one (a : Args) (path : String) : IO Bool :=
    tool_apply_to_file (fmt_loaded a) path;

def fmt_run (a : Args) : IO Unit :=
    tool_run_paths "usage: ouro-fmt [--check | --write] PATH..." (fmt_one a) a;

inductive FmtSelftestResult : Type :=
  | MkFmtSelftestResult : String -> Bool -> String -> FmtSelftestResult;


def fmt_selftest_result_name (r : FmtSelftestResult) : String :=
    match r with | MkFmtSelftestResult name _ _ => name end;


def fmt_selftest_result_pass (r : FmtSelftestResult) : Bool :=
    match r with | MkFmtSelftestResult _ passed _ => passed end;


def fmt_selftest_result_issue (r : FmtSelftestResult) : String :=
    match r with | MkFmtSelftestResult _ _ issue => issue end;


def fmt_selftest_lf (text : String) : String :=
    str_replace text "\r" "";


def fmt_selftest_read (path : String) : IO String :=
    selftest_fs_read "FMT_SUITE: FAIL " path;


def fmt_selftest_write (path : String) (content : String) : IO Unit :=
    do selftest_fs_require "FMT_SUITE: FAIL " (fs_write_checked path content);
       let! actual := fmt_selftest_read path;
       (if prim_string_eq actual content then io_unit
       else
         do eprintln (str_concat "FMT_SUITE: FAIL write verification: " path);
                     exit (S Z))


def fmt_selftest_mkdir (path : String) : IO Unit :=
    selftest_fs_require "FMT_SUITE: FAIL " (fs_mkdir_p_checked path);


def fmt_selftest_copy (src : String) (dst : String) : IO Unit :=
    selftest_fs_require "FMT_SUITE: FAIL " (fs_copy_checked src dst);


def fmt_selftest_failure (name : String) (issue : String) : IO FmtSelftestResult :=
    do eprintln (str_cat4 "FMT_FAIL " name " " issue);
       io_pure(FmtSelftestResult, MkFmtSelftestResult name False issue)


def fmt_selftest_success (name : String) : IO FmtSelftestResult :=
    do println (str_concat "FMT_OK " name);
       io_pure(FmtSelftestResult, MkFmtSelftestResult name True "")


def fmt_selftest_expected (probe_failure : Bool) (name : String) (golden : String)
    : String :=
    if andb(probe_failure, str_eq name "messy") then
      str_concat golden "deliberate selftest mismatch\n"
    else golden;


def fmt_selftest_fixture_issue (name : String) (source : String)
    (actual : String) (expected : String) (again_out : String) : String :=
    if str_eq actual expected then
      if str_eq again_out expected then
        if andb(str_eq name "messy", str_eq source actual) then "check-dirty exit=0" else ""
      else "idempotence"
    else "output";


def fmt_selftest_fixture (fixtures : String) (out : String) (probe_failure : Bool)
    (name : String) : IO FmtSelftestResult :=
    let src : String := fs_child(fixtures, str_concat name ".in") in
    let golden_path : String := fs_child(fixtures, str_concat name ".golden") in
    do let! source := fmt_selftest_read src;
       let! golden := fmt_selftest_read golden_path;
       let actual : String := fmt_selftest_lf (fmt_string source) in
       let again_out : String := fmt_selftest_lf (fmt_string golden) in
       let expected : String := fmt_selftest_expected probe_failure name golden in
       do fmt_selftest_write(fs_child(out, str_concat name ".out"), actual);
          fmt_selftest_write (fs_child(out, str_concat name ".diff"))
            (if str_eq actual expected then "" else "output mismatch\n");
          fmt_selftest_write(fs_child(out, str_concat name ".again"), again_out);
          fmt_selftest_write (fs_child(out, str_concat name ".idem"))
            (if str_eq again_out expected then "" else "idempotence mismatch\n");
          fmt_selftest_write (fs_child(out, str_concat name ".err"))
            (if andb(str_eq name "messy", notb (str_eq source actual)) then
                str_cat3 src ": needs formatting" "\n"
              else "");
          let issue : String := fmt_selftest_fixture_issue name source actual
            expected again_out in
          (if str_null issue then fmt_selftest_success name else fmt_selftest_failure name issue)


def fmt_selftest_multiline_row (row : Pair String String) : Bool :=
    let (MkPair source expected) := row in
    match fmt_checked source with
    | Left _ => False
    | Right actual =>
        match fmt_checked actual with
        | Left _ => False
        | Right again =>
            andb(str_eq actual expected, str_eq again actual)
        end
    end;


def fmt_selftest_multiline_calls : IO FmtSelftestResult :=
    let cases : List (Pair String String) :=
      [ MkPair String String
          "def value : Nat := add(\n      Z, -- keep this comment\n    -- comment stays put\n       S Z,\n   );\n"
          "def value : Nat := add(\n  Z, -- keep this comment\n    -- comment stays put\n  S Z,\n);\n"
       , MkPair String String
           "def spaced : Nat := add (\n      Z,\n       S Z,\n    );\n"
           "def spaced : Nat := add (\n  Z,\n  S Z,\n);\n"
      , MkPair String String
          "def text : String := join(\n    \"a,b := --\",\n       \"two\"\n   -- before close\n );\n"
          "def text : String := join(\n  \"a,b := --\",\n  \"two\"\n   -- before close\n);\n"
      , MkPair String String
          "def chosen : Nat :=\n  choose(\n        back := Z,\n      front := S Z,\n   );\n"
          "def chosen : Nat :=\n  choose(\n    back := Z,\n    front := S Z,\n  );\n"
      , MkPair String String
          "def nested : Nat := outer(\n      inner(\n      Z,\n      S Z,\n    ),\n  Z,\n);\n"
          "def nested : Nat := outer(\n      inner(\n      Z,\n      S Z,\n    ),\n  Z,\n);\n"
      , MkPair String String
          "def single : Nat := add(Z, S Z);\n"
          "def single : Nat := add(Z, S Z);\n"
      , MkPair String String
          "def unary : Nat := one(\n    Z\n   -- before close\n  );\n"
          "def unary : Nat := one(\n    Z\n   -- before close\n  );\n"
      , MkPair String String
          "def incomplete(\n    first,\n      second,\n  ) : Nat := first;\n"
          "def incomplete(\n    first,\n      second,\n  ) : Nat := first;\n"
      ] in
    if all (Pair String String) fmt_selftest_multiline_row cases then
      fmt_selftest_success "multiline_calls"
    else fmt_selftest_failure "multiline_calls" "layout-or-token-safety";


-- A raw CR in a quoted token must not be normalized by a line-oriented
-- candidate. Exercise the actual --write path and compare bytes afterwards.
def fmt_selftest_refusal (out : String) : IO Bool :=
    let path : String := fs_child out "token-refusal.in" in
    let source : String := "def text : String := \"a\rb\";\n" in
    let a : Args := args_of_argv_bools
      (["write"] : List String) (["ouro-fmt", "--write"] : List String) in
    do fmt_selftest_write path source;
       let! accepted := fmt_loaded a path source;
       let! after := fmt_selftest_read path;
       io_pure(Bool, andb(notb accepted, str_eq source after))


def fmt_selftest_write_case (fixtures : String) (out : String) : IO FmtSelftestResult :=
    let path : String := fs_child out "write.in" in
    let a : Args := args_of_argv_bools
      (["write"] : List String) (["ouro-fmt", "--write"] : List String) in
    do fmt_selftest_copy(fs_child fixtures "messy.in", path);
       let! source := fmt_selftest_read path;
       let! written := fmt_loaded a path source;
       let! actual := fmt_selftest_read path;
       let! golden := fmt_selftest_read (fs_child fixtures "messy.golden");
       let! safe := fmt_selftest_refusal out;
       let checked : Bool := str_eq(actual, fmt_string actual) in
       let passed : Bool := andb (andb written safe)
         (andb(checked, str_eq(fmt_selftest_lf actual, golden))) in
       do fmt_selftest_write (fs_child out "write.log")
            (if str_eq source actual then "" else str_cat3 "formatted " path "\n");
          fmt_selftest_write (fs_child out "write.diff")
            (if str_eq(fmt_selftest_lf actual, golden) then "" else "write mismatch\n");
          (if passed then fmt_selftest_success "write"
          else fmt_selftest_failure "write" "mode-or-token-safety")


def fmt_selftest_tree_files : IO (List String) :=
    do let! std_files := fs_walk_ouro "std";
       let! sample_files := fs_walk_ouro "samples";
       let! tool_files := fs_walk_ouro "tools";
       io_pure (List String)
         (str_sort (append String std_files (append String sample_files tool_files)))


def run_fmt_selftest_tree_prepare (out : String) : IO Unit :=
    do let! files := fmt_selftest_tree_files;
       fmt_selftest_write (fs_child out "tree.list")
         (str_concat(str_unlines files, "\n"));
       exit Z


def fmt_selftest_tree_row_count (out : String) : IO Nat :=
    do let! listing := fmt_selftest_read (fs_child out "tree.list");
       io_pure(Nat, length(String, str_lines (str_trim listing)))


def fmt_selftest_result_row (r : FmtSelftestResult) : String :=
    str_join "\t"
      ([ fmt_selftest_result_name r
       , fmt_show_bool (fmt_selftest_result_pass r)
       , fmt_selftest_result_issue r
       ] : List String);


def fmt_selftest_report (results : List FmtSelftestResult) : String :=
    str_concat
      (str_unlines
        (Cons String "name\tpass\tissue"
          (map FmtSelftestResult String fmt_selftest_result_row results))) "\n";


def fmt_selftest_failure_count (results : List FmtSelftestResult) : Nat :=
    count_if FmtSelftestResult
      (fun (r : FmtSelftestResult) => notb (fmt_selftest_result_pass r)) results;


def fmt_selftest_finish (out : String) (display_out : String)
    (results : List FmtSelftestResult) : IO Unit :=
    do fmt_selftest_write (fs_child out "selftest-report.tsv") (fmt_selftest_report results);
       selftest_suite_exit "FMT_SUITE" display_out (length FmtSelftestResult results)
         (fmt_selftest_failure_count results)


def fmt_selftest_result_path (out : String) (name : String) : String :=
    fs_child(out, str_concat(".selftest-", str_concat name ".result"));


def fmt_selftest_store_result (out : String) (result : FmtSelftestResult)
    : IO Unit :=
    fmt_selftest_write
      (fmt_selftest_result_path(out, fmt_selftest_result_name result))
      (str_concat(fmt_selftest_result_row result, "\n"))


def fmt_selftest_worker_finish (out : String) (result : FmtSelftestResult)
    : IO Unit :=
    do fmt_selftest_store_result out result;
       exit
         (if fmt_selftest_result_pass result then Z else S Z)


def run_fmt_selftest_tree_finalize (a : Args) : IO Unit :=
    let out : String := args_opt_or a "out" "_build/fmt_suite" in
    let passed : Bool := notb (args_flag a "tree-failed") in
    let result : FmtSelftestResult :=
      MkFmtSelftestResult "tree" passed
        (match passed with | True => "" | False => "unformatted" end) in
    do let! tree_rows := fmt_selftest_tree_row_count out;
       if passed then
         println
           (str_cat3 "FMT_OK tree files=" (prim_string_of_nat tree_rows) "")
       else eprintln "FMT_FAIL tree unformatted";
       fmt_selftest_worker_finish out result


def run_fmt_selftest_worker (a : Args) (name : String) : IO Unit :=
    let fixtures : String := args_opt_or a "fixtures" "_build/smith/fixtures/fmt" in
    let out : String := args_opt_or a "out" "_build/fmt_suite" in
    do fmt_selftest_mkdir out;
       (if str_eq name "write" then
         do let! result := fmt_selftest_write_case fixtures out;
                    fmt_selftest_worker_finish out result
       else
         if str_eq name "multiline_calls" then
           do let! result := fmt_selftest_multiline_calls;
                      fmt_selftest_worker_finish out result
         else
           do let! result := fmt_selftest_fixture fixtures out
                (args_flag a "selftest-probe-failure") name;
              fmt_selftest_worker_finish out result)


def fmt_selftest_parse_result (text : String) : FmtSelftestResult :=
    let fields : List String := str_split(str_trim text, 9) in
    MkFmtSelftestResult
      (nth String "" Z fields)
      (str_eq(nth String "" (S Z) fields, "true"))
      (nth String "" (S (S Z)) fields);


def fmt_selftest_worker_names : List String :=
    ["clean", "messy", "syntax_keep", "multiline_calls", "write"];

def fmt_selftest_worker_arguments (out : String) (fixtures : String)
    (probe_failure : Bool) (name : String) : List String :=
    append String
      [str_concat "--selftest-worker=" name, str_concat "--out=" out,
       str_concat "--fixtures=" fixtures]
      (if probe_failure then ["--selftest-probe-failure"] else []);

-- The compatibility read loop keeps literal paths and skips the final unterminated line.
def fmt_selftest_tree_lines (listing : String) : List String :=
    init String (str_lines listing);

def fmt_selftest_worker_result_valid (name : String) (code : Nat) (text : String) : Bool :=
    let result : FmtSelftestResult := fmt_selftest_parse_result text in
    let issue : String := fmt_selftest_result_issue result in
    andb (str_eq name (fmt_selftest_result_name result))
      (andb (str_eq text (str_concat(fmt_selftest_result_row result, "\n")))
        (andb (notb (str_contains issue "\n"))
          (andb (notb (str_contains issue "\r"))
            (eq_nat code (match fmt_selftest_result_pass result with
                          | True => Z | False => S Z end)))));

def fmt_selftest_tree_pass (passed : Bool) (result : ProcResult) : Bool :=
    andb passed (proc_ok result);

def fmt_selftest_load_results (out : String)
    : List String -> IO (List FmtSelftestResult) :=
  fix fmt_selftest_load_results (names : List String)
      : IO (List FmtSelftestResult) :=
    match names with
    | Nil => io_pure(List FmtSelftestResult, Nil FmtSelftestResult)
    | Cons name rest =>
        let path : String := fmt_selftest_result_path out name in
        do let! text := fmt_selftest_read path;
           fs_remove path;
           let! results := fmt_selftest_load_results rest;
           io_pure (List FmtSelftestResult)
             (Cons FmtSelftestResult (fmt_selftest_parse_result text) results)
    end;


def run_fmt_selftest_finalize (a : Args) : IO Unit :=
    let out : String := args_opt_or a "out" "_build/fmt_suite" in
    let display_out : String := args_opt_or a "display-out" out in
    do let! results := fmt_selftest_load_results out
         (append String fmt_selftest_worker_names ["tree"]);
       fmt_selftest_finish out display_out results


def fmt_selftest_orchestrator : String :=
    "exe=$1\nout=$2\ndisplay=$3\nprobe=$4\nlauncher=$5\nfixtures=$6\nrun_case() {\n  if [ \"$probe\" = true ]; then\n    \"$exe\" \"--selftest-worker=$1\" \"--out=$out\" \"--fixtures=$fixtures\" --selftest-probe-failure || :\n  else\n    \"$exe\" \"--selftest-worker=$1\" \"--out=$out\" \"--fixtures=$fixtures\" || :\n  fi\n}\nrun_case clean\nrun_case messy\nrun_case syntax_keep\nrun_case multiline_calls\nrun_case write\n\"$exe\" --selftest-tree-prepare \"--out=$out\" || exit 1\n: > \"$out/tree.log\"\ntree_failed=false\nwhile IFS= read -r path; do\n  \"$exe\" --check \"$path\" >> \"$out/tree.log\" 2>&1 || tree_failed=true\ndone < \"$out/tree.list\"\nif [ \"$tree_failed\" = true ]; then\n  \"$exe\" --selftest-tree-finalize --tree-failed \"--out=$out\" || :\nelse\n  \"$exe\" --selftest-tree-finalize \"--out=$out\" || :\nfi\nrm -f \"$launcher\"\n\"$exe\" --selftest-finalize \"--out=$out\" \"--display-out=$display\"\n";


def run_fmt_selftest_plan (a : Args) : IO Unit :=
    let out : String := args_opt_or a "out" "_build/fmt_suite" in
    let launcher : String := fs_child out ".fmt-selftest-launcher.sh" in
    do fmt_selftest_mkdir out;
       fmt_selftest_write launcher fmt_selftest_orchestrator;
       println (fmt_show_bool (args_flag a "selftest-probe-failure"));
       exit Z


def fmt_selftest_append (path : String) (content : String) : IO Unit :=
    do let! prior := fmt_selftest_read path;
       fmt_selftest_write path (str_concat prior content);

-- A failed child must not reuse a result from an earlier invocation.
def fmt_selftest_clear_result (out : String) (name : String) : IO Unit :=
    let path : String := fmt_selftest_result_path out name in
    do fs_remove path;
       let! remains := fs_exists path;
       (if remains then
         do eprintln (str_concat "FMT_SUITE: FAIL stale selftest result: " path);
                    exit (S Z)
       else io_unit);

def fmt_selftest_child_streams (result : ProcResult) : IO Unit :=
    do print (proc_stdout result);
       eprint (proc_stderr result);

def fmt_selftest_result_child (exe : String) (out : String) (name : String)
    (arguments : List String) : IO Unit :=
    do fmt_selftest_clear_result out name;
       let! result := process_run_spec (command_spec exe arguments);
       fmt_selftest_child_streams result;
       let! stored := fmt_selftest_read (fmt_selftest_result_path out name);
       (if fmt_selftest_worker_result_valid name (proc_code result) stored then io_unit
       else
         do eprintln (str_concat "FMT_SUITE: FAIL selftest result protocol: " name);
                     exit (S Z));

def fmt_selftest_run_workers (exe : String) (out : String) (fixtures : String)
    (probe_failure : Bool) : List String -> IO Unit :=
  fix fmt_selftest_run_workers (names : List String) : IO Unit :=
    match names with
    | Nil => io_unit
    | Cons name rest =>
        do fmt_selftest_result_child exe out name
             (fmt_selftest_worker_arguments out fixtures probe_failure name);
           fmt_selftest_run_workers rest
    end;

-- Check mode has no stdout. Separate captures retain the merged tree log order.
def fmt_selftest_run_tree (exe : String) (out : String)
    : List String -> Bool -> IO Bool :=
  fix fmt_selftest_run_tree (paths : List String) (passed : Bool) : IO Bool :=
    match paths with
    | Nil => io_pure Bool passed
    | Cons path rest =>
        do let! result := process_run_spec (command_spec exe ["--check", path]);
           fmt_selftest_append (fs_child out "tree.log")
             (str_concat (proc_stdout result) (proc_stderr result));
           fmt_selftest_run_tree rest (fmt_selftest_tree_pass passed result)
    end;

def run_fmt_selftest (exe : String) (a : Args) : IO Unit :=
    let fixtures : String := args_opt_or a "fixtures" "_build/smith/fixtures/fmt" in
    let out : String := args_opt_or a "out" "_build/fmt_suite" in
    let launcher : String := fs_child out ".fmt-selftest-launcher.sh" in
    do let! display_out := env_or "FMT_SUITE_DISPLAY_OUT" out;
       fmt_selftest_mkdir out;
       fmt_selftest_run_workers exe out fixtures
         (args_flag a "selftest-probe-failure") fmt_selftest_worker_names;
       let! prepared := process_run_spec
         (command_spec exe ["--selftest-tree-prepare", str_concat "--out=" out]);
       fmt_selftest_child_streams prepared;
       (if proc_ok prepared then
         do fmt_selftest_write (fs_child out "tree.log") "";
            let! listing := fmt_selftest_read (fs_child out "tree.list");
            let! passed := fmt_selftest_run_tree exe out (fmt_selftest_tree_lines listing) True;
            fmt_selftest_result_child exe out "tree"
              (append String ["--selftest-tree-finalize"]
                (append String (match passed with | True => [] | False => ["--tree-failed"] end)
                  [str_concat "--out=" out]));
            fs_remove launcher;
            let! finalized := process_run_spec
              (command_spec exe ["--selftest-finalize", str_concat "--out=" out,
                                 str_concat "--display-out=" display_out]);
            fmt_selftest_child_streams finalized;
            exit (proc_code finalized)
       else exit (S Z));

def fmt_switches : List String :=
    [ "check", "write", "selftest", "selftest-probe-failure", "selftest-finalize"
    , "selftest-tree-prepare", "selftest-tree-finalize", "selftest-plan"
    , "tree-failed" ];

def fmt_selftest_modes : List String :=
    [ "selftest", "selftest-plan", "selftest-finalize", "selftest-tree-prepare", "selftest-tree-finalize" ];

def fmt_options_valid (a : Args) (names : List String) : Bool :=
    all String (fun (name : String) => andb (str_set_mem name names)
      (notb (str_null (args_opt_or a name "")))) (map_keys(String, args_opts a));

def fmt_internal_args_valid (a : Args) (mode : String) : Bool :=
    let flags : List String := if str_eq mode "selftest-worker" then ["selftest-probe-failure"]
      else
        if str_eq mode "selftest-tree-finalize" then [mode, "tree-failed"]
        else
          match orb(str_eq mode "selftest", str_eq mode "selftest-plan") with
          | True => [mode, "selftest-probe-failure"] | False => [mode] end in
    let options : List String := if str_eq mode "selftest-worker" then
        ["selftest-worker", "out", "fixtures"]
      else
        if str_eq mode "selftest-finalize" then ["out", "display-out"]
        else
          match orb(str_eq mode "selftest", str_eq mode "selftest-plan") with
          | True => ["out", "fixtures"] | False => ["out"] end in
    andb (nullb(String, args_positional a))
      (andb (all(String, fun (flag : String) => str_set_mem flag flags, args_flags a))
        (fmt_options_valid a options));

def fmt_args_valid (a : Args) : Bool :=
    let modes : List String := filter String (args_flag a) fmt_selftest_modes in
    let selected : List String := match args_opt a "selftest-worker" with
      | Nothing => modes | Just _ => Cons String "selftest-worker" modes end in
    match selected with
    | Nil => andb (notb (andb(args_flag a "check", args_flag a "write")))
        (andb (all String (fun (flag : String) => str_set_mem flag ["check", "write"])
          (args_flags a)) (fmt_options_valid a []))
    | Cons mode rest => andb(nullb String rest, fmt_internal_args_valid a mode)
    end;

def fmt_cli_dispatch (argv : List String) (a : Args) : IO Unit :=
    match args_opt a "selftest-worker" with
       | Just name => run_fmt_selftest_worker a name
       | Nothing =>
           if args_flag a "selftest-plan" then run_fmt_selftest_plan a
           else
             if args_flag a "selftest-tree-prepare" then
               run_fmt_selftest_tree_prepare
                 (args_opt_or a "out" "_build/fmt_suite")
             else
               if args_flag a "selftest-tree-finalize" then run_fmt_selftest_tree_finalize a
               else
                 if args_flag a "selftest-finalize" then run_fmt_selftest_finalize a
                 else
                   if args_flag a "selftest" then run_fmt_selftest(nth String "" Z argv, a)
                   else fmt_run a
       end

def main : IO Unit :=
    do let! values := prim_argv;
       let a : Args := args_of_argv_bools fmt_switches values in
       if andb(args_argv_options_complete fmt_switches values, fmt_args_valid a) then
         fmt_cli_dispatch values a
       else
         do eprintln "fmt: invalid arguments";
                     eprintln "usage: ouro-fmt [--check | --write] PATH...";
                     exit 2
