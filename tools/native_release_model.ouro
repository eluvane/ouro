import "../std/crypto.ouro", "../std/pathx.ouro", "../std/collections.ouro";
import "../std/process.ouro" as Process exposing
  (process_directory_utf8_valid, process_directory_valid);

-- Caller-owned paths and hashes describe bytes, not accepted producer authority.
inductive NativeReleaseInput : Type :=
  | NativeReleaseInputOf : String -> String -> Nat -> String -> NativeReleaseInput;

inductive NativeReleasePlanError : Type :=
  | ReleaseEmptyInventory : NativeReleasePlanError
  | ReleaseInventoryMismatch : NativeReleasePlanError
  | ReleaseInvalidPath : String -> NativeReleasePlanError
  | ReleasePathConflict : String -> String -> NativeReleasePlanError
  | ReleaseInventoryOrder : String -> NativeReleasePlanError
  | ReleaseInvalidSource : String -> NativeReleasePlanError
  | ReleaseInvalidDigest : String -> NativeReleasePlanError
  | ReleaseUnsupportedBudget : Nat -> NativeReleasePlanError
  | ReleaseBudgetExceeded : String -> Nat -> Nat -> NativeReleasePlanError
  | ReleaseLengthMismatch : String -> Nat -> Nat -> NativeReleasePlanError
  | ReleaseDigestMismatch : String -> String -> String -> NativeReleasePlanError;

def native_release_name (input : NativeReleaseInput) : String :=
    match input with | NativeReleaseInputOf name _ _ _ => name end;

def native_release_plan_error_code (error : NativeReleasePlanError) : String :=
    match error with
    | ReleaseEmptyInventory => "release_empty_inventory"
    | ReleaseInventoryMismatch => "release_inventory_mismatch"
    | ReleaseInvalidPath _ => "release_invalid_path"
    | ReleasePathConflict _ _ => "release_path_conflict"
    | ReleaseInventoryOrder _ => "release_inventory_order"
    | ReleaseInvalidSource _ => "release_invalid_source"
    | ReleaseInvalidDigest _ => "release_invalid_digest"
    | ReleaseUnsupportedBudget _ => "release_unsupported_budget"
    | ReleaseBudgetExceeded _ _ _ => "release_budget_exceeded"
    | ReleaseLengthMismatch _ _ _ => "release_length_mismatch"
    | ReleaseDigestMismatch _ _ _ => "release_digest_mismatch"
    end;

-- The current SHA padding stores only 32 length bits; keep bit lengths below 2^32.
def native_release_sha256_limit : Nat := sha256_stream_byte_limit;

def native_release_digest_valid (digest : String) : Bool :=
    andb (eq_nat(str_len digest, 64))
      (all Nat (fun (byte : Nat) =>
        orb(andb(leb_nat 48 byte, leb_nat byte 57), andb(leb_nat 97 byte, leb_nat byte 102)))
        (str_codes digest));

def native_release_segment_valid (name : String) : Bool :=
    let base : String := str_lower (str_trim (head String "" (str_split name 46))) in
    andb (notb (str_null name))
      (andb (notb (elem String str_eq name [".", ".."]))
        (andb (notb (orb (str_ends name ".") (str_ends name " ")))
          (andb (notb (elem String str_eq base
            ["con", "prn", "aux", "nul", "conin$", "conout$", "com1", "com2", "com3", "com4", "com5",
             "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5",
             "lpt6", "lpt7", "lpt8", "lpt9", "com¹", "com²", "com³", "lpt¹", "lpt²", "lpt³"]))
            (all Nat (fun (byte : Nat) =>
              andb (leb_nat 32 byte) (notb (elem Nat eq_nat byte [34, 42, 47, 58, 60, 62, 63, 92, 124])))
              (str_codes name)))));

def native_release_path_valid (path : String) : Bool :=
    let parts : List String := path_split path in
    andb (notb (str_null path))
      (andb (notb (path_is_abs path))
        (andb (str_eq(path, path_join parts))
          (andb (process_directory_utf8_valid (str_codes path))
            (all String native_release_segment_valid parts))));

def native_release_path_conflict (left : String) (right : String) : Bool :=
    let first : String := str_lower left in
    let second : String := str_lower right in
    orb(path_under first second, path_under second first);

def native_release_plan_go : List String -> Nat -> List NativeReleaseInput -> List String
    -> Either NativeReleasePlanError Unit :=
  fix check (required : List String) (remaining : Nat) (inputs : List NativeReleaseInput)
      (seen : List String) : Either NativeReleasePlanError Unit :=
    match required, inputs with
    | Nil, Nil => Right NativeReleasePlanError Unit MkUnit
    | Nil, Cons _ _ => Left NativeReleasePlanError Unit ReleaseInventoryMismatch
    | Cons _ _, Nil => Left NativeReleasePlanError Unit ReleaseInventoryMismatch
    | Cons expected names, Cons input files => let (NativeReleaseInputOf name source bytes digest) :=
        input in
      if str_eq name expected then
        if native_release_path_valid name then
          match find String (native_release_path_conflict name) seen with
          | Just previous => Left NativeReleasePlanError Unit (ReleasePathConflict previous name)
          | Nothing => if
              all String (fun (previous : String) => prim_string_le previous name) seen then
              if process_directory_valid source then
                if native_release_digest_valid digest then
                  if leb_nat bytes remaining then
                    check names (sub remaining bytes) files (Cons String name seen)
                  else
                    Left NativeReleasePlanError Unit (ReleaseBudgetExceeded name bytes remaining)
                else Left NativeReleasePlanError Unit (ReleaseInvalidDigest name)
              else Left NativeReleasePlanError Unit (ReleaseInvalidSource name)
            else Left NativeReleasePlanError Unit (ReleaseInventoryOrder name)
          end
        else Left NativeReleasePlanError Unit (ReleaseInvalidPath name)
      else Left NativeReleasePlanError Unit ReleaseInventoryMismatch
    end;

def native_release_plan_checked (budget : Nat) (required : List String) (inputs : List NativeReleaseInput)
    : Either NativeReleasePlanError Unit :=
    if ltb_nat budget native_release_sha256_limit then
      match required with
      | Nil => Left NativeReleasePlanError Unit ReleaseEmptyInventory
      | Cons _ _ => native_release_plan_go required budget inputs ([] : List String)
      end
    else Left NativeReleasePlanError Unit (ReleaseUnsupportedBudget budget);

def native_release_content_checked (input : NativeReleaseInput) (content : String)
    : Either NativeReleasePlanError Unit :=
    let (NativeReleaseInputOf name _ bytes expected) := input in
    if ltb_nat bytes native_release_sha256_limit then
      if eq_nat (str_len content) bytes then
        let actual : String := sha256 content in
        if str_eq actual expected then Right NativeReleasePlanError Unit MkUnit
        else Left NativeReleasePlanError Unit (ReleaseDigestMismatch name expected actual)
      else Left NativeReleasePlanError Unit (ReleaseLengthMismatch name bytes (str_len content))
    else Left NativeReleasePlanError Unit (ReleaseUnsupportedBudget bytes);
