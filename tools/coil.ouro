-- Thin public launcher. Compilation stays in coil_execute / native-build so
-- Clippy can finish this entry without loading the compiler cone.
import "native_cli_args.ouro",
  "native_sibling_model.ouro",
  "../std/executable.ouro",
  "../std/process.ouro";

def coil_usage : String :=
    str_concat native_cli_usage "  coil fmt [--check | --write] PATH...\n  coil test [--out DIR] [PATH...]\n  coil lsp [SERVER_ARG ...]\n  coil pkg [PACKAGE_ARG ...]\n  coil analyze [ANALYZER_ARG ...]\n  coil toolchain rebuild --source DIR --out NEW_DIR --stages 3 --no-cache\n";

def coil_launch_sibling (name : String) (words : List String) : IO Unit :=
    do let! located := executable_path_checked;
       match native_sibling_command_checked located name words with
       | Left error => coil_fail(1, native_sibling_error_message error)
       | Right command =>
           match! process_run_spec_inherited command with
           | Left error => coil_fail(1, process_run_error_message error)
           | Right code => exit code
           end
       end;

def coil_launch_backend (words : List String) : IO Unit :=
    coil_launch_sibling "ouro-native-build.exe" (Cons String "--coil-dispatch" words);

def coil_launch_test (words : List String) : IO Unit :=
    match! native_cli_read_test_hosted_override with
    | Just name => coil_fail(1, str_concat "native test refuses hosted override: " name)
    | Nothing => coil_launch_sibling native_cli_test_sibling words
    end;

def coil_launch_toolchain (words : List String) : IO Unit :=
    match! native_cli_read_test_hosted_override with
    | Just name => coil_fail(1, str_concat "native toolchain refuses hosted override: " name)
    | Nothing => coil_launch_sibling native_cli_toolchain_sibling words
    end;

def coil_launch_lsp (words : List String) : IO Unit :=
    do let! test_check := prim_env_get "OURO_TEST_CHECK";
       let! pkg_check := prim_env_get "OURO_PKG_CHECK";
       let! compiler_wrapper := prim_env_get "OURO_HOSTED_COMPILER_WRAPPER";
       let! formatter := prim_env_get "OURO_HOSTED_FMT";
       match native_cli_lsp_hosted_override test_check pkg_check compiler_wrapper formatter with
       | Just name => coil_fail(1, str_concat "native lsp refuses hosted override: " name)
       | Nothing => coil_launch_sibling native_cli_lsp_sibling words
       end;

def coil_launch_pkg (words : List String) : IO Unit :=
    do let! test_check := prim_env_get "OURO_TEST_CHECK";
       let! pkg_check := prim_env_get "OURO_PKG_CHECK";
       let! compiler_wrapper := prim_env_get "OURO_HOSTED_COMPILER_WRAPPER";
       match native_cli_pkg_hosted_override test_check pkg_check compiler_wrapper with
       | Just name => coil_fail(1, str_concat "native pkg refuses hosted override: " name)
       | Nothing => coil_launch_sibling native_cli_pkg_sibling words
       end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match native_cli_analyze_words arguments with
       | Just words => coil_launch_sibling native_cli_analyze_sibling words
       | Nothing => match native_cli_toolchain_words arguments with
       | Just words => coil_launch_toolchain words
       | Nothing => match native_cli_pkg_words arguments with
       | Just words => coil_launch_pkg words
       | Nothing =>
         match native_cli_test_words arguments with
         | Just words => coil_launch_test words
         | Nothing => match native_cli_fmt_words arguments with
           | Just words => coil_launch_sibling native_cli_fmt_sibling words
           | Nothing => match native_cli_lsp_words arguments with
             | Just words => coil_launch_lsp words
             | Nothing => match arguments with
               | Nil => coil_fail(2, native_cli_error_message NativeCliMissingCommand)
               | Cons _ words => match native_cli_parse words with
                 | Left error =>
                     do eprintln (str_concat("coil: ", native_cli_error_message error));
                        eprint coil_usage;
                        exit 2
                 | Right command => match command with
                   | NativeCliDoctor => print native_build_doctor_text
                   | NativeCliCheck _ _ _ => coil_launch_backend words
                   | NativeCliBuild _ => coil_launch_backend words
                   | NativeCliRun _ _ => coil_launch_backend words
                   end
                 end
               end
             end
           end
         end
       end
       end
       end;
