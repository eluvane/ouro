-- Thin public launcher. Compilation stays in coil_execute / native-build so
-- Clippy can finish this entry without loading the compiler cone.
import "native_cli_args.ouro";
import "native_sibling_model.ouro";
import "../std/process.ouro";

def coil_backend_names : List String :=
    ["ouro-native-build.exe", "ouro-native-build"];

def coil_backend_path (image : String) : List String -> Maybe String :=
  fix go (names : List String) : Maybe String :=
    match names with
    | Nil => Nothing String
    | Cons name rest => match native_sibling_path image name with
      | Just path => Just String path
      | Nothing => go rest
      end
    end;

def coil_launch_backend (image : String) (words : List String) : IO Unit :=
    match coil_backend_path image coil_backend_names with
    | Nothing => coil_fail 1 "cannot resolve ouro-native-build sibling"
    | Just program =>
        do let! result := process_run_inherited program
             (Cons String "--coil-dispatch" words);
           match result with
           | Left error => coil_fail 1 (process_run_error_message error)
           | Right code => exit code
           end
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match arguments with
       | Nil => coil_fail 2 (native_cli_error_message NativeCliMissingCommand)
       | Cons image words => match native_cli_parse words with
         | Left error =>
             do eprintln (str_concat "coil: " (native_cli_error_message error));
                eprint native_cli_usage;
                exit 2
         | Right command => match command with
           | NativeCliDoctor => print native_build_doctor_text
           | NativeCliCheck _ _ _ => coil_launch_backend image words
           | NativeCliBuild _ => coil_launch_backend image words
           | NativeCliRun _ _ => coil_launch_backend image words
           end
         end
       end
