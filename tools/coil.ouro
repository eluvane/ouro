-- The first native project commands share the existing checked compiler path.
-- Foreground run uses the inherited-stream process and owned-job contract.
import "native_cli_args.ouro";
import "native_build_core.ouro";
import "../std/process.ouro";

def coil_fail (status : Nat) (message : String) : IO Unit :=
    do eprintln (str_concat "coil: " message);
       exit status

def coil_build_fail (error : NativeBuildFailure) : IO Unit :=
    coil_fail 1 (native_build_error_message error);

def coil_run_finish (result : Either ProcessRunError Nat) : IO Unit :=
    match result with
    | Left error => coil_fail 1 (process_run_error_message error)
    | Right code => exit code
    end;

def coil_run (request : NativeBuildRequest) (arguments : List String) : IO Unit :=
    do let! built := native_build_compile_checked request;
       match built with
       | Left error => coil_build_fail error
       | Right _ =>
           do let! result := process_run_inherited (native_build_request_out request) arguments;
              coil_run_finish result
       end

def coil_check_output (fuel : Nat) (artifact : Maybe String)
    (checked : CheckedProgram) : IO Unit :=
    match artifact with
    | Nothing => println "CHECK_OK"
    | Just output =>
        do let! written := native_build_dump_checked fuel output checked;
           match written with
           | Left error => coil_build_fail error
           | Right _ => println "CHECK_OK"
           end
    end;

def coil_execute (command : NativeCliCommand) : IO Unit :=
    match command with
    | NativeCliDoctor => print native_build_doctor_text
    | NativeCliCheck source fuel artifact =>
        do let! checked := native_build_check_source source fuel;
           match checked with
           | Left error => coil_build_fail error
           | Right program => coil_check_output fuel artifact program
           end
    | NativeCliBuild request =>
        do let! built := native_build_compile_checked request;
           match built with
           | Left error => coil_build_fail error
           | Right _ => println (native_build_request_out request)
           end
    | NativeCliRun request arguments => coil_run request arguments
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match arguments with
       | Nil => coil_fail 2 (native_cli_error_message NativeCliMissingCommand)
       | Cons _ words => match native_cli_parse words with
         | Left error =>
             do eprintln (str_concat "coil: " (native_cli_error_message error));
                eprint native_cli_usage;
                exit 2
         | Right command => coil_execute command
         end
       end
