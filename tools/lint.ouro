-- Ouro native lint CLI: family selection, process orchestration, and suite contracts.

-- @entry main

import "lint_worker.ouro";
import "../compiler/base.ouro";
import "../std/collections.ouro";

-- Native lint already blocks on every emitted finding. --deny makes that
-- contract explicit; it does not downgrade diagnostics or select a Python
-- gate. Style and semantic run as separate companion processes after the
-- shared inventory. After --, all remaining arguments are literal paths.
inductive LintFamily : Type :=
  | LintFamLanguage : LintFamily
  | LintFamStyle : LintFamily
  | LintFamSemantic : LintFamily;

def lint_family_name (f : LintFamily) : String :=
    match f with
    | LintFamLanguage => "language"
    | LintFamStyle => "style"
    | LintFamSemantic => "semantic"
    end;

def lint_parse_family (name : String) : Maybe LintFamily :=
    match prim_string_eq name "language" with
    | True => Just LintFamily LintFamLanguage
    | False => match prim_string_eq name "style" with
      | True => Just LintFamily LintFamStyle
      | False => match prim_string_eq name "semantic" with
        | True => Just LintFamily LintFamSemantic
        | False => Nothing LintFamily
        end
      end
    end;

def lint_known_profiles : List String :=
    [ "project", "strict", "release" ];

def lint_known_profile (name : String) : Bool :=
    elem String prim_string_eq name lint_known_profiles;

def lint_all_families : List LintFamily :=
    [ LintFamLanguage, LintFamStyle, LintFamSemantic ];

def lint_family_eq (a : LintFamily) (b : LintFamily) : Bool :=
    prim_string_eq (lint_family_name a) (lint_family_name b);

def lint_has_family (xs : List LintFamily) (f : LintFamily) : Bool :=
    elem LintFamily lint_family_eq f xs;

def lint_add_family (xs : List LintFamily) (f : LintFamily) : List LintFamily :=
    match lint_has_family xs f with
    | True => xs
    | False => append LintFamily xs ([f] : List LintFamily)
    end;

inductive LintArgError : Type :=
  | LintUnknownOption : String -> LintArgError
  | LintMissingValue : String -> LintArgError
  | LintUnknownProfile : String -> LintArgError
  | LintUnknownFamily : String -> LintArgError
  | LintMissingFamily : LintArgError;

def lint_arg_error_message (e : LintArgError) : String :=
    match e with
    | LintUnknownOption option => concat "unknown lint option: " option
    | LintMissingValue option => concat "missing value for " option
    | LintUnknownProfile name => concat "unknown lint profile: " name
    | LintUnknownFamily name => concat "unknown lint family: " name
    | LintMissingFamily => "missing lint family"
    end;

inductive LintRequest : Type :=
  | MkLintRequest : String -> List LintFamily -> List String -> LintRequest;

def lint_req_profile (r : LintRequest) : String :=
    match r with | MkLintRequest p _ _ => p end;

def lint_req_families (r : LintRequest) : List LintFamily :=
    match r with | MkLintRequest _ fs _ => fs end;

def lint_req_roots (r : LintRequest) : List String :=
    match r with | MkLintRequest _ _ xs => xs end;

def lint_finish_parse (profile : String) (explicit : Bool)
    (families : List LintFamily) (rev : List String)
    : Either LintArgError LintRequest :=
    match explicit with
    | False => Right LintArgError LintRequest
        (MkLintRequest profile lint_all_families (reverse_lin String rev))
    | True => match families with
      | Nil => Left LintArgError LintRequest LintMissingFamily
      | Cons _ _ => Right LintArgError LintRequest
          (MkLintRequest profile families (reverse_lin String rev))
      end
    end;

def lint_parse_args : List String -> String -> Bool -> List LintFamily
    -> List String -> Either LintArgError LintRequest :=
  fix go (args : List String) (profile : String) (explicit : Bool)
      (families : List LintFamily) (rev : List String)
      : Either LintArgError LintRequest :=
    match args with
    | Nil => lint_finish_parse profile explicit families rev
    | Cons arg rest =>
        match prim_string_eq arg "--" with
        | True => match lint_finish_parse profile explicit families rev with
          | Left e => Left LintArgError LintRequest e
          | Right req => Right LintArgError LintRequest
              (MkLintRequest (lint_req_profile req) (lint_req_families req)
                (append String (lint_req_roots req) rest))
          end
        | False =>
            match prim_string_eq arg "--deny" with
            | True => go rest profile explicit families rev
            | False =>
                match prim_string_eq arg "--profile" with
                | True => match rest with
                  | Nil => Left LintArgError LintRequest (LintMissingValue arg)
                  | Cons value more =>
                      match prim_string_length value with
                      | Z => Left LintArgError LintRequest (LintMissingValue arg)
                      | S _ => match lint_known_profile value with
                        | False => Left LintArgError LintRequest
                            (LintUnknownProfile value)
                        | True => go more value explicit families rev
                        end
                      end
                  end
                | False =>
                    match prim_string_eq arg "--family" with
                    | True => match rest with
                      | Nil => Left LintArgError LintRequest LintMissingFamily
                      | Cons value more =>
                          match prim_string_length value with
                          | Z => Left LintArgError LintRequest LintMissingFamily
                          | S _ => match lint_parse_family value with
                            | Nothing => Left LintArgError LintRequest
                                (LintUnknownFamily value)
                            | Just fam => go more profile True
                                (lint_add_family families fam) rev
                            end
                          end
                      end
                    | False =>
                        match prim_string_starts arg "--" with
                        | True => Left LintArgError LintRequest
                            (LintUnknownOption arg)
                        | False => go rest profile explicit families
                            (Cons String arg rev)
                        end
                    end
                end
            end
        end
    end;

def lint_is_sep (c : Nat) : Bool :=
    orb (eqNat c 47) (eqNat c 92);

def lint_last_sep : List Nat -> Nat -> Maybe Nat :=
  fix go (cs : List Nat) (i : Nat) : Maybe Nat :=
    match cs with
    | Nil => Nothing Nat
    | Cons c rest =>
        match go rest (add i 1) with
        | Just later => Just Nat later
        | Nothing => match lint_is_sep c with
          | True => Just Nat i
          | False => Nothing Nat
          end
        end
    end;

def lint_dirname (path : String) : String :=
    match lint_last_sep (prim_string_to_char_codes path) 0 with
    | Nothing => "."
    | Just index =>
        match orb (eqNat index 0)
            (andb (eqNat index 2)
              (prim_string_eq (prim_string_slice path 1 1) ":")) with
        | True => prim_string_slice path 0 (add index 1)
        | False => prim_string_slice path 0 index
        end
    end;

def lint_join (dir : String) (name : String) : String :=
    match prim_string_length dir with
    | Z => name
    | S last => match lint_is_sep (prim_string_byte_at dir last) with
      | True => concat dir name
      | False => concat dir (concat "/" name)
      end
    end;

def lint_choose_exe (windows : String) (base : String) (win : Bool) (posix : Bool)
    : Maybe String :=
    match win with
    | True => Just String windows
    | False => match posix with
      | True => Just String base
      | False => Nothing String
      end
    end;

def lint_pick_exe (base : String) : IO (Maybe String) :=
    let windows : String := concat base ".exe" in
    do let! win := prim_fs_exists windows;
       let! posix := prim_fs_exists base;
       io_pure (Maybe String) (lint_choose_exe windows base win posix)

def lint_env_exe (name : String) : IO (Either String (Maybe String)) :=
    do let! env := prim_env_get name;
       match env with
       | Nothing => io_pure (Either String (Maybe String))
           (Right String (Maybe String) (Nothing String))
       | Just path =>
           match prim_string_length path with
           | Z => io_pure (Either String (Maybe String))
               (Right String (Maybe String) (Nothing String))
           | S _ =>
               do let! exists := prim_fs_exists path;
                  io_pure (Either String (Maybe String))
                    (match exists with
                     | True => Right String (Maybe String) (Just String path)
                     | False => Left String (Maybe String)
                         (concat name (concat " is not an executable: " path))
                     end)
           end
       end

def lint_locate_companion (env_name : String) (sibling : String)
    (argv0 : String) : IO (Either String (Maybe String)) :=
    do let! env := lint_env_exe env_name;
       match env with
       | Left msg => io_pure (Either String (Maybe String))
           (Left String (Maybe String) (concat "LINT_FAIL: " msg))
       | Right found => match found with
         | Just path => io_pure (Either String (Maybe String))
             (Right String (Maybe String) (Just String path))
         | Nothing =>
             do let! sibling_exe := lint_pick_exe
                  (lint_join (lint_dirname argv0) sibling);
                io_pure (Either String (Maybe String))
                  (Right String (Maybe String) sibling_exe)
         end
       end

def lint_missing_companion (label : String) (sibling : String)
    (env_name : String) : String :=
    lint_cat4 "LINT_FAIL: " label
      " companion unavailable: expected "
      (lint_cat4 sibling " next to the lint image or " env_name
        " pointing at a built executable");

def lint_run_child (exe : String) (args : List String) : IO Nat :=
    do let! result := process_run_spec (command_spec exe args);
       print (proc_stdout result);
       eprint (proc_stderr result);
       io_pure Nat (lint_child_status result)

def lint_companion_paths (exe : String) (args_of : String -> List String)
    (paths : List String) : IO Nat :=
    io_fold String Nat
      (fun (status : Nat) (path : String) =>
        io_bind Nat Nat (lint_run_child exe (args_of path))
          (fun (next : Nat) => io_pure Nat (lint_join_status status next)))
      Z paths;

def lint_style_args (profile : String) (path : String) : List String :=
    (["--profile", profile, "--single-file", path] : List String);

def lint_semantic_args_many (profile : String) (paths : List String) : List String :=
    append String (["--lint-companion", "--profile", profile] : List String)
      (concat_map String String (fun (path : String) =>
        (["--scope", path] : List String)) paths);

-- The reporter owns source-root grouping and verified worker recycling.
-- Family selection remains outside this function; style-only never enters it.
def lint_semantic_companion_paths (exe : String) (profile : String)
    (paths : List String) : IO Nat :=
    (fix go (fuel : Nat) (pending : List String) (status : Nat) : IO Nat :=
      match pending with
      | Nil => io_pure Nat status
      | Cons _ _ => match fuel with
        | Z =>
            do let! _e := eprintln "LINT_FAIL: semantic supervisor made no progress";
               io_pure Nat 2
        | S remaining =>
            let chunk : List String := cg_session_take cg_session_max_roots pending in
            do let! next := lint_run_child exe (lint_semantic_args_many profile chunk);
               go remaining (cg_session_drop (length String chunk) pending)
                 (lint_join_status status next)
        end
      end) (length String paths) paths Z;

def lint_require_companion (wanted : Bool) (label : String) (sibling : String)
    (env_name : String) (argv0 : String)
    : IO (Either String (Maybe String)) :=
    match wanted with
    | False => io_pure (Either String (Maybe String))
        (Right String (Maybe String) (Nothing String))
    | True =>
        do let! located := lint_locate_companion env_name sibling argv0;
           io_pure (Either String (Maybe String))
             (match located with
              | Left msg => Left String (Maybe String) msg
              | Right found => match found with
                | Nothing => Left String (Maybe String)
                    (lint_missing_companion label sibling env_name)
                | Just path => Right String (Maybe String) (Just String path)
                end
              end)
    end;

def lint_family_language (wanted : Bool) (exe : String) (files : List String)
    : IO Nat :=
    match wanted with
    | False => io_pure Nat Z
    | True => lint_paths exe files
    end;

def lint_family_companion (wanted : Bool) (exe : Maybe String)
    (args_of : String -> List String) (files : List String) : IO Nat :=
    match wanted with
    | False => io_pure Nat Z
    | True => match exe with
      | Nothing => io_pure Nat (S Z)
      | Just path => lint_companion_paths path args_of files
      end
    end;

def lint_family_semantic (wanted : Bool) (exe : Maybe String)
    (profile : String) (files : List String) : IO Nat :=
    match wanted with
    | False => io_pure Nat Z
    | True => match exe with
      | Nothing => io_pure Nat (S Z)
      | Just path => lint_semantic_companion_paths path profile files
      end
    end;

def start (argv : List String) : IO Unit :=
    match lint_parse_args (tail String argv) "project" False
        (Nil LintFamily) (Nil String) with
    | Left e =>
        do eprintln (lint_arg_error_message e);
           exit 2
    | Right req =>
        let roots : List String :=
          match lint_req_roots req with
          | Nil => defaults
          | Cons root rest => Cons String root rest
          end in
        let families : List LintFamily := lint_req_families req in
        let profile : String := lint_req_profile req in
        let want_language : Bool := lint_has_family families LintFamLanguage in
        let want_style : Bool := lint_has_family families LintFamStyle in
        let want_semantic : Bool := lint_has_family families LintFamSemantic in
        do let! inventory := gather roots;
           match inventory with
           | Left e =>
               do eprintln (quality_input_message e);
                  exit 2
           | Right files =>
               let argv0 : String := nth String "" Z argv in
               do let! style := lint_require_companion want_style "style"
                    "ouro-lint-style" "OURO_LINT_STYLE_EXE" argv0;
                  match style with
                  | Left msg =>
                      do eprintln msg;
                         exit (S Z)
                  | Right style_exe =>
                      do let! semantic := lint_require_companion want_semantic
                           "semantic" "ouro-clippy-grade-firewall"
                           "OURO_LINT_SEMANTIC_EXE" argv0;
                         match semantic with
                         | Left msg =>
                             do eprintln msg;
                                exit (S Z)
                         | Right semantic_exe =>
                             do let! language_status :=
                                  lint_family_language want_language argv0 files;
                                let! style_status := lint_family_companion
                                  want_style style_exe (lint_style_args profile)
                                  files;
                                let! semantic_status := lint_family_semantic
                                  want_semantic semantic_exe profile files;
                                exit (lint_join_status language_status
                                  (lint_join_status style_status semantic_status))
                         end
                  end
           end
    end;

def lint_selftest_write (path : String) (body : String) : IO Unit :=
    do let! wrote := fs_write_checked path body;
       match wrote with
       | Left e =>
           do eprintln (concat "LINT_SUITE: FAIL " (fs_error_message e));
              exit (S Z)
       | Right _ => io_unit
       end;
       let! loaded := quality_read_file path;
       match loaded with
       | Left e =>
           do eprintln (concat "LINT_SUITE: FAIL " (quality_input_message e));
              exit (S Z)
       | Right actual =>
           match prim_string_eq actual body with
           | True => io_unit
           | False =>
               do eprintln (concat "LINT_SUITE: FAIL output readback differs: " path);
                  exit (S Z)
           end
       end

def lint_selftest_output_path (out : String) (label : String) (path : String)
    (suffix : String) : String :=
    quality_child out (lint_cat4 label "_" (lint_path_stem path) suffix);

def lint_selftest_case_pass (expect_findings : Bool) (r : ProcResult) : Bool :=
    match expect_findings with
    | True =>
        andb (eqNat (proc_code r) (S Z))
          (andb (notb (prim_string_eq (proc_stdout r) ""))
            (prim_string_eq (proc_stderr r) ""))
    | False =>
        andb (eqNat (proc_code r) Z)
          (andb (prim_string_eq (proc_stdout r) "")
            (prim_string_eq (proc_stderr r) ""))
    end;

def lint_selftest_case_finish (expect_findings : Bool) (path : String)
    (r : ProcResult) : IO Bool :=
    match lint_selftest_case_pass expect_findings r with
    | True => io_pure Bool True
    | False =>
        match expect_findings with
        | True =>
            do println (concat "MISS " path);
               io_pure Bool False
        | False =>
            do println (concat "FP " path);
               io_foreach String
                 (fun (line : String) => println (concat "  " line))
                 (prim_string_split (proc_stdout r) 10);
               io_pure Bool False
        end
    end;

def lint_selftest_write_result (stdout_path : String) (stderr_path : String)
    (result : ProcResult) : IO Unit :=
    match result with
    | MkProcResult _ stdout stderr =>
        do lint_selftest_write stdout_path stdout;
           lint_selftest_write stderr_path stderr
    end;

def lint_selftest_write_case (label : String) (out : String) (path : String)
    (result : ProcResult) : IO Unit :=
    lint_selftest_write_result
      (lint_selftest_output_path out label path ".out")
      (lint_selftest_output_path out label path ".err") result;

def lint_selftest_process_case (exe : String) (expect_findings : Bool)
    (label : String) (out : String) (path : String) : IO Bool :=
    do let! loaded := quality_read_file path;
       match loaded with
       | Left e =>
           do eprintln (concat "LINT_SUITE: FAIL " (quality_input_message e));
              io_pure Bool False
       | Right _ =>
           do let! result := process_run_spec (command_spec exe (["--single-file", path] : List String));
              lint_selftest_write_case label out path result;
              lint_selftest_case_finish expect_findings path result
       end

def lint_selftest_files (exe : String) (expect_findings : Bool) (label : String)
    (out : String) (paths : List String) : IO Nat :=
    io_fold String Nat
      (fun (failures : Nat) (path : String) =>
        io_bind Bool Nat
          (lint_selftest_process_case exe expect_findings label out path)
          (fun (passed : Bool) =>
            match passed with
            | True => io_pure Nat failures
            | False => io_pure Nat (S failures)
            end))
      Z paths;

def lint_selftest_paths (root : String)
    : IO (Either QualityInputError (List String)) :=
    do let! kind := prim_fs_kind root;
       match eqNat kind (S (S Z)) with
       | False => io_pure (Either QualityInputError (List String))
           (Left QualityInputError (List String) (QualityInvalidInput root))
       | True =>
           do let! listable := prim_fs_listable root;
              match listable with
              | False => io_pure (Either QualityInputError (List String))
                  (Left QualityInputError (List String) (QualityUnreadableDirectory root))
              | True =>
                  do let! names := prim_fs_list_dir root;
                     io_pure (Either QualityInputError (List String))
                       (Right QualityInputError (List String)
                         (map String String (quality_child root)
                           (filter String (fun (path : String) =>
                             prim_string_ends path ".ouro")
                             (sort_insert String prim_string_le names))))
              end
       end

def lint_selftest_group (exe : String) (expect_findings : Bool) (label : String)
    (root : String) (out : String) : IO Nat :=
    do let! loaded := lint_selftest_paths root;
       match loaded with
       | Left e =>
           do eprintln (concat "LINT_SUITE: FAIL " (quality_input_message e));
              io_pure Nat (S Z)
       | Right paths =>
           match paths with
           | Nil =>
               do eprintln (concat "LINT_SUITE: FAIL no fixtures under " root);
                  io_pure Nat (S Z)
           | Cons _ _ => lint_selftest_files exe expect_findings label out paths
           end
       end

def lint_arg_value (prefix : String) (fallback : String) : List String -> String :=
  fix lint_arg_value (xs : List String) : String :=
    match xs with
    | Nil => fallback
    | Cons x rest =>
        match prim_string_starts x prefix with
        | True =>
            let n : Nat := prim_string_length prefix in
            prim_string_slice x n (sub (prim_string_length x) n)
        | False => lint_arg_value rest
        end
    end;

def lint_cache_contracts : Bool :=
    let src : String := "def n : Nat := Z;" in
    let other : String := "def n : Nat := S Z;" in
    let canonical : String := "/tmp/lint-cache-contract.ouro" in
    let cached : LintCachedFile :=
      lint_make_cached canonical src [] ["n"] ["Z"] in
    let cache : LintHarvestCache :=
      lint_cache_put lint_cache0 canonical cached in
    let hit : Bool := match lint_cache_lookup cache canonical src with
      | LintCacheHit row => lint_cache_row_ok row
      | LintCacheMiss => False
      | LintCacheStale => False
      end in
    let miss : Bool := match lint_cache_lookup lint_cache0 canonical src with
      | LintCacheMiss => True
      | LintCacheHit _ => False
      | LintCacheStale => False
      end in
    let stale : Bool := match lint_cache_lookup cache canonical other with
      | LintCacheStale => True
      | LintCacheHit _ => False
      | LintCacheMiss => False
      end in
    let reset : Bool := match lint_cache_lookup (lint_cache_reset cache) canonical src with
      | LintCacheMiss => True
      | LintCacheHit _ => False
      | LintCacheStale => False
      end in
    andb (prim_string_eq lint_facts_kind "ouro.quality-facts.v1")
      (andb hit (andb miss (andb stale reset)));

def lint_parse_ok (args : List String) (profile : String)
    (families : List String) (roots : List String) : Bool :=
    match lint_parse_args args "project" False (Nil LintFamily) (Nil String) with
    | Left _ => False
    | Right req =>
        andb (prim_string_eq (lint_req_profile req) profile)
          (andb (eqNat (length LintFamily (lint_req_families req))
              (length String families))
            (andb (all LintFamily (fun (f : LintFamily) =>
                elem String prim_string_eq (lint_family_name f) families)
              (lint_req_families req))
              (eqNat (length String (lint_req_roots req)) (length String roots))))
    end;

def lint_parse_err (args : List String) (needle : String) : Bool :=
    match lint_parse_args args "project" False (Nil LintFamily) (Nil String) with
    | Right _ => False
    | Left e => prim_string_contains (lint_arg_error_message e) needle
    end;

def lint_parse_contracts : Bool :=
    andb (lint_parse_ok (Nil String) "project"
        (["language", "style", "semantic"] : List String) (Nil String))
      (andb (lint_parse_ok (["--deny", "--profile", "strict", "--family",
            "language", "tools/lint.ouro"] : List String) "strict"
          (["language"] : List String) (["tools/lint.ouro"] : List String))
        (andb (lint_parse_err (["--enable-no-such-rule"] : List String) "unknown lint option")
          (andb (lint_parse_err (["--profile"] : List String) "missing value")
            (andb (lint_parse_err (["--family"] : List String) "missing lint family")
              (andb (lint_parse_err (["--profile", "nightly"] : List String)
                  "unknown lint profile")
                (lint_parse_err (["--family", "frontend"] : List String)
                  "unknown lint family"))))));

def lint_semantic_contracts : Bool :=
    let paths : List String := ["std/data.ouro", "std/practical.ouro", "compiler/parser_parse.ouro"] in
    all Bool (fun (passed : Bool) => passed)
      [ list_eq String prim_string_eq (lint_semantic_args_many "project" paths)
          ["--lint-companion", "--profile", "project", "--scope", "std/data.ouro",
           "--scope", "std/practical.ouro", "--scope", "compiler/parser_parse.ouro"]
      , list_eq String prim_string_eq (cg_session_take 2 paths)
          ["std/data.ouro", "std/practical.ouro"]
      , list_eq String prim_string_eq (cg_session_drop 2 paths) ["compiler/parser_parse.ouro"]
      , eqNat cg_session_max_roots 128
      , notb (cg_session_recycle 2 0 False 0)
      , cg_session_recycle cg_session_max_roots 0 False 0
      , cg_session_recycle 2 cg_session_cache_bytes False 0
      , cg_session_recycle 2 0 True 0
      , cg_session_recycle 2 0 False cg_session_heap_bytes
      ];

def lint_process_contracts : Bool :=
    all Bool (fun (passed : Bool) => passed)
      [ eqNat (lint_child_status (MkProcResult Z "" "")) Z
      , eqNat (lint_child_status (MkProcResult Z "finding" "")) (S Z)
      , eqNat (lint_child_status (MkProcResult Z "" "failure")) (S Z)
      , eqNat (lint_child_status (MkProcResult (S Z) "" "")) (S Z)
      , eqNat (lint_child_status (MkProcResult 137 "" "crash")) 137
      , eqNat (lint_join_status Z (S Z)) (S Z)
      , eqNat (lint_join_status (S Z) Z) (S Z)
      , eqNat (lint_join_status (S Z) 137) 137
      , eqNat (lint_join_status 137 (S Z)) 137
      , eqNat (lint_join_status 137 139) 137
      , lint_cache_contracts
      , lint_parse_contracts
      , lint_semantic_contracts
      ];

def run_lint_selftest (argv : List String) : IO Unit :=
    let exe : String := nth String "" Z argv in
    let out : String := lint_arg_value "--out=" "_build/tmp/lint_suite" argv in
    let bad_root : String :=
      lint_arg_value "--bad-root=" "_build/smith/fixtures/lint/bad" argv in
    let good_root : String :=
      lint_arg_value "--good-root=" "_build/smith/fixtures/lint/good" argv in
    do prim_fs_mkdir out;
       let! listable := prim_fs_listable out;
       match listable with
       | False =>
           do eprintln (concat "LINT_SUITE: FAIL cannot create output directory: " out);
              exit (S Z)
       | True =>
           do match lint_process_contracts with
              | True => io_unit
              | False =>
                  do eprintln "LINT_SUITE: FAIL native process protocol";
                     exit (S Z)
              end;
              println "=== bad (must report) ===";
              let! bad := lint_selftest_group exe True "bad" bad_root out;
              println (concat "bad_miss=" (of_nat bad));
              println "=== good (must be clean) ===";
              let! good := lint_selftest_group exe False "good" good_root out;
              println (concat "good_fp=" (of_nat good));
              match add bad good with
              | Z => exit Z
              | S _ => exit (S Z)
              end
       end

def main : IO Unit :=
    do let! argv := prim_argv;
       match tail String argv with
       | Nil => start argv
       | Cons first rest =>
           match prim_string_eq first "--single-file" with
           | True => lint_single_file rest
           | False =>
               match prim_string_eq first "--batch-files" with
               | True => lint_batch_files rest
               | False =>
                   match prim_string_eq first "--selftest" with
                   | True => run_lint_selftest argv
                   | False => start argv
                   end
               end
           end
       end
