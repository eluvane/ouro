-- Thin keep-import surface for native_repo_selftest and repo_gate/main.
-- The parity cone stays skip-harvested unless this file is the selected root.
import "parity_closure.ouro";
import "report.ouro";

def selftest_extra_checks (profile : String) (root : String) : IO (List GateCheck) :=
    run_profile_extra_checks profile root;

def selftest_extra_names (profile : String) : List String :=
    profile_extra_check_names profile;
