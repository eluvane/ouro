-- Thin keep-import surface for native_repo_selftest. The checks cone stays
-- skip-harvested unless this file is the selected root.
import "checks.ouro";
import "report.ouro";

def selftest_profile_checks (profile : String) (root : String) : IO (List GateCheck) :=
    run_profile_checks profile root;

def selftest_smith_issues (text : String) : List GateIssue :=
    smith_strategy_issues text;
