-- Thin keep-import surface for workflow_checks. The 894-line parser cone
-- stays skip-harvested unless this file is the selected root.
import "workflow_checks.ouro";
import "report.ouro";


def wf_with_file_text (root : String) (rel : String)
    (issues : List GateIssue) (k : String -> List GateIssue)
    : IO (List GateIssue) :=
    workflow_with_file_text root rel issues k;


def wf_dangerous_patterns_check (root : String) : IO GateCheck :=
    workflow_dangerous_patterns_check root;


def wf_permissions_check (root : String) : IO GateCheck :=
    workflow_permissions_check root;


def wf_dangerous_issues_for_text (path : String) (text : String)
    (issues : List GateIssue) : List GateIssue :=
    workflow_dangerous_issues_for_text path text issues;


def wf_permission_issues_for_text (path : String) (text : String)
    (issues : List GateIssue) : List GateIssue :=
    workflow_permission_issues_for_text path text issues;
