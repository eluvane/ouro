-- Stable report model shared by the Ouro-native repository gate.

import "../../std/json.ouro";
import "../../std/stringx.ouro";
import "../../std/format.ouro";

inductive GateIssue : Type :=
  | MkGateIssue : String -> String -> GateIssue;

inductive GateMetric : Type :=
  | MkGateMetric : String -> String -> GateMetric;

inductive GateCheck : Type :=
  | MkGateCheck : String -> Bool -> List GateMetric -> List GateIssue -> GateCheck;
def gate_issue (reason : String) (path : String) : GateIssue :=
    MkGateIssue reason path;
def gate_metric (name : String) (value : String) : GateMetric :=
    MkGateMetric name value;
def issue_reason (i : GateIssue) : String :=
    match i with
    | MkGateIssue reason _ => reason
    end;
def issue_path (i : GateIssue) : String :=
    match i with
    | MkGateIssue _ path => path
    end;
def metric_name (m : GateMetric) : String :=
    match m with
    | MkGateMetric name _ => name
    end;
def metric_value (m : GateMetric) : String :=
    match m with
    | MkGateMetric _ value => value
    end;
def check_name (c : GateCheck) : String :=
    match c with
    | MkGateCheck name _ _ _ => name
    end;
def check_blocking (c : GateCheck) : Bool :=
    match c with
    | MkGateCheck _ blocking _ _ => blocking
    end;
def check_metrics (c : GateCheck) : List GateMetric :=
    match c with
    | MkGateCheck _ _ metrics _ => metrics
    end;
def check_issues (c : GateCheck) : List GateIssue :=
    match c with
    | MkGateCheck _ _ _ issues => issues
    end;
def check_pass (c : GateCheck) : Bool :=
    nullb GateIssue (check_issues c);
def check_status (c : GateCheck) : String :=
    match check_pass c with
    | True => "pass"
    | False => "fail"
    end;
def json_kv (key : String) (value : Json) : Pair String Json :=
    MkPair String Json key value;
def issue_json (i : GateIssue) : Json :=
    JObj
      ([ json_kv "reason" (JStr (issue_reason i))
      , json_kv "path" (JStr (issue_path i))
      ] : List (Pair String Json));
def metric_json (m : GateMetric) : Json :=
    JObj
      ([ json_kv "name" (JStr (metric_name m))
      , json_kv "value" (JStr (metric_value m))
      ] : List (Pair String Json));
def issues_json (issues : List GateIssue) : Json :=
    JArr (map GateIssue Json issue_json issues);
def metrics_json (metrics : List GateMetric) : Json :=
    JArr (map GateMetric Json metric_json metrics);
def check_json (c : GateCheck) : Json :=
    JObj
      ([ json_kv "name" (JStr (check_name c))
      , json_kv "status" (JStr (check_status c))
      , json_kv "blocking" (JBool (check_blocking c))
      , json_kv "metrics" (metrics_json (check_metrics c))
      , json_kv "issues" (issues_json (check_issues c))
      ] : List (Pair String Json));
def checks_pass (checks : List GateCheck) : Bool :=
  andb (notb (nullb GateCheck checks)) (all GateCheck check_pass checks);
def collect_issues (checks : List GateCheck) : List GateIssue :=
  concat_map GateCheck GateIssue check_issues checks;
def issue_count (checks : List GateCheck) : Nat :=
    length GateIssue (collect_issues checks);
def gate_report_json (profile : String) (checks : List GateCheck) : Json :=
    let ok : Bool := checks_pass checks in
    JObj
      ([ json_kv "kind" (JStr "ouro.repo-gate-report.v1")
      , json_kv "version" (JStr "1")
      , json_kv "profile" (JStr profile)
      , json_kv "execution_backend" (JStr "ouro-native-repo-gate")
      , json_kv "execution_mode" (JStr "native")
      , json_kv "pass" (JBool ok)
      , json_kv "gates" (JArr (map GateCheck Json check_json checks))
      , json_kv "issues" (issues_json (collect_issues checks))
      , json_kv "policy_note"
          (JStr "Ouro-native repository gates cover a growing parity subset; Python and shell gates remain explicit compatibility/reference validation until each path has parity evidence.")
      ] : List (Pair String Json));
def issue_line (i : GateIssue) : String :=
    str_cat4 "REPO_GATE_ISSUE " (issue_reason i) " " (issue_path i);
def check_line (c : GateCheck) : String :=
    str_cat4 "REPO_GATE_CHECK " (check_name c) " status="
      (str_cat3 (check_status c) " issues="
        (show_nat (length GateIssue (check_issues c))));
def gate_summary_text (profile : String) (checks : List GateCheck) (report_path : String) : String :=
    str_unlines
      (append String
        ([ str_cat4 "REPO_GATE_SUMMARY profile=" profile " pass="
            (str_cat3 (show_bool (checks_pass checks)) " issues="
              (str_cat3 (show_nat (issue_count checks)) " report="
                report_path))
        ] : List String)
        (append String
          (map GateCheck String check_line checks)
          (map GateIssue String issue_line (collect_issues checks))));
def gate_report_string (profile : String) (checks : List GateCheck) : String :=
    str_concat (json_print (gate_report_json profile checks)) "\n";
