-- Profile tags only. The inventory lists stay in policy.ouro so a selected
-- consumer can name GateProfile without keep-harvesting that cone.
import "../../std/stringx.ouro";


inductive GateProfile : Type :=
  | GpDocs : GateProfile
  | GpProject : GateProfile
  | GpWorkflow : GateProfile
  | GpFixture : GateProfile
  | GpControlPlane : GateProfile
  | GpCompilerBoundary : GateProfile
  | GpRepo : GateProfile;


def gate_profile_rows : List (Pair String GateProfile) :=
    [ MkPair String GateProfile "docs" GpDocs
    , MkPair String GateProfile "project" GpProject
    , MkPair String GateProfile "workflow" GpWorkflow
    , MkPair String GateProfile "fixture" GpFixture
    , MkPair String GateProfile "control-plane" GpControlPlane
    , MkPair String GateProfile "retirement" GpControlPlane
    , MkPair String GateProfile "compiler-boundary" GpCompilerBoundary
    ];


def gate_profile (name : String) : GateProfile :=
  match lookup String GateProfile str_eq name gate_profile_rows with
  | Nothing => GpRepo
  | Just profile => profile
  end;
