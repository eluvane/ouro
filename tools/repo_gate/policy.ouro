def fixture_required_files : List String :=
    [ "README.md", "docs/README.md", "docs/guide.md", ".github/workflows/fixture.yml" ];


def fixture_index_targets : List String :=
    [ "guide.md" ];


def fixture_retired_paths : List String :=
    [ "docs/retired.md" ];


def fixture_required_phrase_rows : List (Pair String (List String)) :=
    [ MkPair String (List String) "README.md" ([ "Fixture", "readme-example:" ] : List String)
    , MkPair String (List String) "docs/README.md" ([ "Fixture docs", "Guide" ] : List String)
    ];


def docs_check_names : List String :=
    [ "canonical-docs"
    , "markdown-inventory"
    , "docs-index-links"
    , "markdown-relative-links"
    , "documented-paths"
    , "readme-example-marker"
    , "active-syntax-docs"
    , "smith-strategies"
    , "sample-companion-pairs"
    , "generated-api-presence"
    ];


def project_check_names : List String :=
    [ "github-project-required-files"
    , "retired-paths"
    , "public-required-phrases"
    , "public-docs-wording"
    , "readme-shape"
    , "pull-request-template-shape"
    , "issue-forms-shape"
    ];


def workflow_check_names : List String :=
    [ "workflow-required-files"
    , "workflow-dangerous-patterns"
    , "workflow-permissions-sanity"
    ];


def fixture_check_names : List String :=
    [ "fixture-required-files"
    , "docs-index-links"
    , "markdown-relative-links"
    , "documented-paths"
    , "fixture-retired-paths"
    , "fixture-required-phrases"
    , "workflow-dangerous-patterns"
    , "workflow-permissions-sanity"
    ];


def repo_check_names : List String :=
    append String docs_check_names (append String project_check_names workflow_check_names);


def profile_check_names (profile : String) : List String :=
    match gate_profile profile with
    | GpDocs => docs_check_names
    | GpProject => project_check_names
    | GpWorkflow => workflow_check_names
    | GpFixture => fixture_check_names
    | GpControlPlane => repo_check_names
    | GpCompilerBoundary => compiler_boundary_check_names
    | GpRepo => repo_check_names
    end;
