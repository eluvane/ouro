-- Stable file and documentation inventories for repository-gate profiles.

import "../../std/stringx.ouro";
import "compiler_boundary.ouro";
import "policy_types.ouro";


def syntax_tokens : List String :=
    [ "|>"
    , "list literals"
    , "do let!"
    , "records"
    , "import aliases"
    , "local opens"
    ];


def smith_required_features : List String := [ "form:list", "form:record", "parity:imports" ];


def sample_roots : List String :=
    [ "samples/demo", "samples/examples", "samples/tutorial" ];


def public_patterns : List String :=
    [ "this pass"
    , "previous pass"
    , "engineering pass"
    , "coding agent"
    , "agents must"
    , "definition of done"
    , "hard stop"
    , "prompt"
    ];


def project_required_phrase_rows : List (Pair String (List String)) :=
    [ MkPair String (List String)
        "README.md"
        ([ "pre-1.0", "## Quick start", "samples/examples/nat.ouro", "docs/README.md" ] : List String)
    , MkPair String (List String)
        "CONTRIBUTING.md"
        ([ "## Build and test", "## Generated artifacts", "## Opening a pull request", "docs/rfc/" ] : List String)
    , MkPair String (List String)
        "SECURITY.md"
        ([ "Do not open a public issue", "Private Vulnerability Reporting" ] : List String)
    , MkPair String (List String)
        "CHANGELOG.md"
        ([ "## [Unreleased]" ] : List String)
    , MkPair String (List String)
        "docs/README.md"
        ([ "## Getting started"
        , "## Language"
        , "## Tooling and packages"
        , "## Quality"
        , "## Compiler and trust"
        , "## Contributing and maintenance"
        ] : List String)
    , MkPair String (List String)
        "docs/stability.md"
        ([ "pre-1.0", "breaking" ] : List String)
    , MkPair String (List String)
        "docs/releasing.md"
        ([ "SHA256SUMS", "scripts/release_package.py", "v<version>" ] : List String)
    , MkPair String (List String)
        "docs/quality.md"
        ([ "allow", "warn", "deny", "forbid", "migration" ] : List String)
    , MkPair String (List String)
        "docs/tcb.md"
        ([ "compiler/file_elab.ouro", "CheckedProgram", "Outside the checker" ] : List String)
    ];


