-- Native clock: a non-empty timestamp string, then exit 0.
import "../std/io.ouro";

def time_label (text : String) : String :=
    match prim_string_length text with
    | Z => "time-empty"
    | S _ => "time-ok"
    end;

-- @entry main
def main : IO Unit :=
  do let! now_text := now;
     println (time_label now_text);
     exit 0
