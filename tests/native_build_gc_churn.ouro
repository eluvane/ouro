-- Discarded string allocations on the native PE path. The first allocation
-- collects; later charges force another collection before exit.
import "../std/io.ouro";

def gc_churn_junk (n : Nat) : String :=
    prim_string_concat "gc" (prim_string_of_nat n);

def gc_churn_steps : Nat -> IO Unit :=
  fix go (remaining : Nat) : IO Unit :=
    match remaining with
    | Z => io_unit
    | S rest =>
        let unused : Nat := prim_string_length (gc_churn_junk remaining) in
        match unused with
        | Z => go rest
        | S _ => go rest
        end
    end;

-- @entry main
def main : IO Unit :=
  do gc_churn_steps (mul 16 32);
     println "gc-churn-ok";
     exit 0
