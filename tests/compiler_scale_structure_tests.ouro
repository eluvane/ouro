-- Delayed substitution and derived-index invariants cover open raw Core as well
-- as checked declaration consumers. These controls do not run large workloads.
import "compiler_property_scoped.ouro";
import "compiler_scale_fixtures.ouro";
import "../std/test.ouro";

def scale_repeated_subst : List CoreTerm -> CoreTerm -> Nat -> CoreTerm :=
  fix repeat (values : List CoreTerm) (term : CoreTerm) (cutoff : Nat) : CoreTerm :=
    match values with
    | Nil => term
    | Cons value rest => subst_rec (repeat rest term (S cutoff)) cutoff value
    end;

def scale_substitution_same (values : List CoreTerm) (term : CoreTerm) : Bool :=
    eqList (encode property_fuel (subst_many (length CoreTerm values) values term))
      (encode property_fuel (scale_repeated_subst values term Z));

def scale_substitution_values : Nat -> Nat -> List CoreTerm :=
  fix values (remaining : Nat) (seed : Nat) : List CoreTerm :=
    match remaining with
    | Z => []
    | S next => Cons CoreTerm (property_scoped 2 3 (property_seed seed 11))
        (values next (property_seed seed 13))
    end;

def scale_substitution_samples : Nat -> Nat -> Bool :=
  fix samples (remaining : Nat) (seed : Nat) : Bool :=
    match remaining with
    | Z => True
    | S next =>
        let values : List CoreTerm := scale_substitution_values (property_choice seed 5) seed in
        match scale_substitution_same values (property_scoped 3 7 (property_seed seed 17)) with
        | False => False
        | True => samples next (S seed)
        end
    end;

def scale_substitution_forms : List CoreTerm :=
    [ CRel 4, CSort 3, CConst 10, CInd 10, CConstruct 10 1 0
    , CStrBytes ([0, 255] : List Nat) 80, CStrLit 5 80
    , CPi (CRel 0) (CRel 2), CLam (CRel 1) (CRel 2), CApp (CRel 0) (CRel 1)
    , CLetIn (CRel 1) (CRel 0) (CRel 2)
    , CFix 77 0 1 (CPi (CRel 0) (CRel 2)) (CLam (CRel 1) (CRel 3))
    , CCase (MkCaseInfo 9 4 ([2, 3] : List Nat))
        (CLam (CRel 0) (CRel 2)) (CRel 1)
        ([CLam (CRel 1) (CRel 3), CRel 0] : List CoreTerm)
    ];

def scale_substitution_all_forms : List CoreTerm -> Bool :=
  fix all_forms (forms : List CoreTerm) : Bool :=
    match forms with
    | Nil => True
    | Cons term rest =>
        match scale_substitution_same ([CRel 1, CApp (CRel 0) property_nat] : List CoreTerm) term with
        | False => False | True => all_forms rest end
    end;

def scale_index_bound (lower : Maybe Nat) (upper : Maybe Nat) (key : Nat) : Bool :=
    andb (match lower with | Nothing => True | Just bound => ltNat bound key end)
      (match upper with | Nothing => True | Just bound => ltNat key bound end);

def scale_index_valid : EntryIndex -> Maybe Nat -> Maybe Nat -> Bool :=
  fix valid (tree : EntryIndex) (lower : Maybe Nat) (upper : Maybe Nat) : Bool :=
    match tree with
    | EntryIndexEmpty => True
    | EntryIndexNode height key _ left right =>
        andb (scale_index_bound lower upper key)
          (andb (eqNat height (S (maxNat (entry_index_height left) (entry_index_height right))))
            (andb (compiler_le_nat (entry_index_height left) (S (entry_index_height right)))
              (andb (compiler_le_nat (entry_index_height right) (S (entry_index_height left)))
                (andb (valid left lower (Just Nat key)) (valid right (Just Nat key) upper)))))
    end;

def scale_index_insert_keys (key : Nat -> Nat) : Nat -> EntryIndex -> EntryIndex :=
  fix insert (remaining : Nat) (tree : EntryIndex) : EntryIndex :=
    match remaining with
    | Z => tree
    | S next => insert next
        (entry_index_insert (key next) (EntryIndexActual (MkEntry (key next) (CSort next) (Nothing CoreTerm))) tree)
    end;

def scale_index_find_keys (key : Nat -> Nat) (tree : EntryIndex) : Nat -> Bool :=
  fix find (remaining : Nat) : Bool :=
    match remaining with
    | Z => True
    | S next => match entry_index_lookup (key next) tree with
        | Nothing => False
        | Just value => match value with
            | EntryIndexReserved => False
            | EntryIndexActual entry => match entry with
                | MkEntry name typ _ => andb (eqNat name (key next))
                    (andb (eqTerm property_fuel typ (CSort next)) (find next))
                | MkIndEntry _ _ => False | MkBoundEntry _ _ _ => False | MkRoleEntry _ => False
                end
            end
        end
    end;

def scale_index_order (key : Nat -> Nat) : Bool :=
    let count : Nat := mul 16 16 in
    let tree : EntryIndex := scale_index_insert_keys key count EntryIndexEmpty in
    andb (scale_index_valid tree (Nothing Nat) (Nothing Nat)) (scale_index_find_keys key tree count);

def scale_index_binding : PrimitiveBinding :=
    PrimitiveIntrinsicBinding PrimitiveU32Type PrimitiveTypeOnly PrimitiveNoGc (Nothing CoreTerm);

def scale_index_role : PrimitiveRoleBinding :=
    PrimitiveRoleOf PrimitiveNatRole (PrimitiveInductiveOf 10 0 0 (CSort 0) ([property_nat] : List CoreTerm));

def scale_index_raw : List Entry :=
    [ MkEntry 40 (CSort 1) (Just CoreTerm (CSort 0))
    , MkIndEntry 10 (MkIndDecl 10 [] [] 0
        ([MkCtor 40 property_nat, MkCtor 12 property_nat] : List Ctor))
    , MkEntry 10 (CSort 0) (Just CoreTerm property_bool)
    , MkEntry 12 (CSort 2) (Nothing CoreTerm)
    , MkBoundEntry 60 property_function scale_index_binding
    , MkRoleEntry scale_index_role
    , MkEntry 40 (CSort 2) (Nothing CoreTerm)
    , MkIndEntry 50 (MkIndDecl 50 ([MkParam 51 (CSort 0)] : List Param)
        ([CRel 0] : List CoreTerm) 1 ([MkCtor 75 (CRel 1)] : List Ctor))
    , MkEntry 99 (CSort 0) (Just CoreTerm property_nat)
    ];

def scale_index_maybe_term (left : Maybe CoreTerm) (right : Maybe CoreTerm) : Bool :=
    match left, right with
    | Nothing, Nothing => True | Nothing, Just _ => False | Just _, Nothing => False
    | Just first, Just second => eqTerm property_fuel first second
    end;

def scale_index_terms : List CoreTerm -> List CoreTerm -> Bool :=
  fix equal (left : List CoreTerm) (right : List CoreTerm) : Bool :=
    match left, right with
    | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
    | Cons first rest, Cons second tail => andb (eqTerm property_fuel first second) (equal rest tail)
    end;

def scale_index_params : List Param -> List Param -> Bool :=
  fix equal (left : List Param) (right : List Param) : Bool :=
    match left, right with
    | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
    | Cons first rest, Cons second tail => match first, second with
        | MkParam name typ, MkParam other other_type =>
            andb (eqNat name other) (andb (eqTerm property_fuel typ other_type) (equal rest tail))
        end
    end;

def scale_index_ctors : List Ctor -> List Ctor -> Bool :=
  fix equal (left : List Ctor) (right : List Ctor) : Bool :=
    match left, right with
    | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
    | Cons first rest, Cons second tail => match first, second with
        | MkCtor name typ, MkCtor other other_type =>
            andb (eqNat name other) (andb (eqTerm property_fuel typ other_type) (equal rest tail))
        end
    end;

def scale_index_maybe_ind (left : Maybe IndDecl) (right : Maybe IndDecl) : Bool :=
    match left, right with
    | Nothing, Nothing => True | Nothing, Just _ => False | Just _, Nothing => False
    | Just first, Just second => match first, second with
        | MkIndDecl name params indices sort ctors, MkIndDecl other other_params other_indices other_sort other_ctors =>
            andb (eqNat name other) (andb (eqNat sort other_sort)
              (andb (scale_index_params params other_params)
                (andb (scale_index_terms indices other_indices) (scale_index_ctors ctors other_ctors))))
        end
    end;

def scale_index_lookup_same (entries : List Entry) : Bool :=
    let environment : CheckEnvironment := check_environment_from_entries entries in
    (fix names (remaining : List Nat) : Bool :=
      match remaining with
      | Nil => True
      | Cons name rest =>
          andb (scale_index_maybe_term (lookup_type name entries) (check_environment_type name environment))
            (andb (scale_index_maybe_term (lookup_const name entries) (check_environment_const name environment))
              (andb (scale_index_maybe_ind (lookup_ind name entries) (check_environment_ind name environment))
                (andb (match entry_name_exists name entries with
                    | True => check_environment_name_exists name environment
                    | False => notb (check_environment_name_exists name environment) end) (names rest))))
      end) ([0, 10, 12, 40, 50, 60, 75, 99, 255] : List Nat);

def scale_index_boundary_keys : Bool :=
    let large : Nat := w32_of_bytes 255 255 255 255 in
    let before : CheckEnvironment := check_environment_cons (MkEntry Z property_nat (Nothing CoreTerm)) check_environment_empty in
    let after : CheckEnvironment := check_environment_cons (MkEntry large property_bool (Nothing CoreTerm)) before in
    andb (notb (check_environment_name_exists large before))
      (andb (check_environment_name_exists large after)
        (andb (scale_index_maybe_term (check_environment_type Z after) (Just CoreTerm property_nat))
          (scale_index_maybe_term (check_environment_type large after) (Just CoreTerm property_bool))));

def scale_duplicate_failure (name : Nat) (failure : CheckFailure) : Bool :=
    match failure with
    | CheckMalformedCore fault => match fault with
        | CheckDuplicateName duplicate => eqNat name duplicate
        | CheckUnboundVariable _ => False | CheckUnboundGlobal _ => False
        | CheckUnknownInductive _ => False | CheckUnknownConstructor _ _ => False
        | CheckConstructorParameters => False | CheckCaseMetadata => False
        | CheckFixMetadata => False | CheckLiteralType _ => False | CheckUnresolvedLiteral _ => False
        end
    | CheckTypeFailure _ => False | CheckReductionFailure _ => False
    | CheckResourceLimit => False | CheckUnsupported _ => False | CheckCancelled => False
    | CheckInternalFailure _ => False | CheckPrimitiveFailure _ => False
    end;

def scale_index_reserved_rejected : Bool :=
    match check_indexed_declaration CheckExactCore property_fuel check_environment_empty
      (FInd (MkIndDecl 10 [] [] 0 ([MkCtor 11 property_nat] : List Ctor))) with
    | IndexedDeclarationsErr _ _ _ => False
    | IndexedDeclarationsOk environment =>
        match check_indexed_declaration CheckExactCore property_fuel environment (FDef 11 property_nat property_zero) with
        | IndexedDeclarationsOk _ => False
        | IndexedDeclarationsErr name phase failure => match phase with
            | CheckDeclarationPlan => andb (eqNat name 11) (scale_duplicate_failure name failure)
            | CheckDeclarationType => False | CheckDeclarationBody => False | CheckInductiveDeclaration => False
            end
        end
    end;

def scale_raw_natural : Nat -> Nat -> Nat :=
  fix raw (remaining : Nat) (accumulator : Nat) : Nat :=
    match remaining with | Z => accumulator | S next => raw next (S accumulator) end;

def scale_index_raw_natural : Bool :=
    let packed : Nat := mul 20 (mul 10 100) in
    let raw : Nat := scale_raw_natural packed Z in
    let tree : EntryIndex := entry_index_insert raw
      (EntryIndexActual (MkEntry raw property_nat (Nothing CoreTerm))) EntryIndexEmpty in
    andb (eqNat (S raw) (add raw 1))
      (match entry_index_lookup packed tree, entry_index_lookup raw tree with
       | Just first, Just second => match first, second with
           | EntryIndexActual _, EntryIndexActual _ => True
           | EntryIndexReserved, EntryIndexReserved => False
           | EntryIndexActual _, EntryIndexReserved => False
           | EntryIndexReserved, EntryIndexActual _ => False end
       | Nothing, Nothing => False | Just _, Nothing => False | Nothing, Just _ => False end);

def scale_increment_boundaries : List Nat -> Bool :=
  fix boundaries (values : List Nat) : Bool :=
    match values with
    | Nil => True
    | Cons value rest =>
        let raw : Nat := scale_raw_natural value Z in
        andb (eqNat (S raw) (add raw 1)) (boundaries rest)
    end;

def scale_work_boundary (required : Nat) (work : List CheckInputWork) : Bool :=
    andb
      (match check_input_work_remaining required work with
       | Just remaining => eqNat remaining Z | Nothing => False end)
      (match check_input_work_remaining (sub required 1) work with
       | Just _ => False | Nothing => True end);

def scale_work_empty : Bool :=
    andb (match check_input_work_remaining Z [] with | Just remaining => eqNat remaining Z | Nothing => False end)
      (match check_input_work_remaining Z ([CheckInputTerm property_nat] : List CheckInputWork) with
       | Nothing => True | Just _ => False end);

def scale_work_case : CoreTerm :=
    CCase (MkCaseInfo 10 0 ([1] : List Nat)) (CPi property_nat property_nat) property_zero
      ([CLam property_nat (CRel 0)] : List CoreTerm);

def scale_work_inductive : FileItem :=
    FInd (MkIndDecl 10 ([MkParam 13 (CSort 0)] : List Param) ([CRel 0] : List CoreTerm) 0
      ([MkCtor 11 property_function] : List Ctor));

def scale_work_chain : Nat -> CoreTerm -> CoreTerm :=
  fix chain (remaining : Nat) (body : CoreTerm) : CoreTerm :=
    match remaining with
    | Z => body | S rest => chain rest (CPi property_nat body)
    end;

def scale_work_batch_boundaries : List Nat -> Bool :=
  fix boundaries (depths : List Nat) : Bool :=
    match depths with
    | Nil => True
    | Cons depth rest =>
        let required : Nat := add (mul 2 depth) 1 in
        andb (scale_work_boundary required
          ([CheckInputTerm (scale_work_chain depth property_nat)] : List CheckInputWork)) (boundaries rest)
    end;

def scale_builder_boundaries : List Nat -> Bool :=
  fix boundaries (depths : List Nat) : Bool :=
    match depths with
    | Nil => True
    | Cons depth rest =>
        let make : CoreTerm -> CoreTerm := fun (body : CoreTerm) => CPi property_nat body in
        andb (eqTerm (add 100 (mul 8 depth))
          (probe_nest make depth property_nat) (probe_nest_linear make depth property_nat)) (boundaries rest)
    end;

-- @entry main
def main : IO Unit :=
    test_run
      [ assert_true "400 open substitutions equal repeated single-binder substitution"
          (scale_substitution_samples (mul 20 20) 1)
      , assert_true "all Core forms preserve binder annotations and case/fix scope"
          (scale_substitution_all_forms scale_substitution_forms)
      , assert_true "numeric index balances ascending insertion"
          (scale_index_order (fun (number : Nat) => sub 255 number))
      , assert_true "numeric index balances descending insertion"
          (scale_index_order (fun (number : Nat) => number))
      , assert_true "numeric index balances permuted insertion"
          (scale_index_order (fun (number : Nat) => mod_nat (mul (S number) 37) 257))
      , assert_true "raw environment preserves first match and constructor reservations"
          (scale_index_lookup_same scale_index_raw)
      , assert_true "bound global still shadows an older inductive"
          (scale_index_lookup_same (Cons Entry (MkBoundEntry 10 property_bool scale_index_binding) scale_index_raw))
      , assert_true "role entries do not introduce occupied names"
          (notb (check_environment_name_exists 10
            (check_environment_from_entries ([MkRoleEntry scale_index_role] : List Entry))))
      , assert_true "persistent environment retains zero and large numeric IDs" scale_index_boundary_keys
      , assert_true "incremental checker rejects a reserved constructor name exactly" scale_index_reserved_rejected
      , assert_true "index accepts a deep raw Peano name and a packed lookup" scale_index_raw_natural
      , assert_true "input work admits an empty zero budget and rejects one missing unit" scale_work_empty
      , assert_true "input work counts Pi and lambda annotations"
          (scale_work_boundary 5 ([CheckInputTerm (CPi (CLam property_nat (CRel 0)) property_nat)] : List CheckInputWork))
      , assert_true "input work counts the fix annotation and body"
          (scale_work_boundary 7 ([CheckInputTerm (CFix 70 0 1 property_function (CLam property_nat (CRel 0)))] : List CheckInputWork))
      , assert_true "input work counts case metadata, motive, scrutinee and branches"
          (scale_work_boundary 12 ([CheckInputTerm scale_work_case] : List CheckInputWork))
      , assert_true "input work counts literal bytes including the list terminator"
          (scale_work_boundary 4 ([CheckInputTerm (CStrBytes ([0, 255] : List Nat) 80)] : List CheckInputWork))
      , assert_true "input work counts declaration parameters, indices and constructor types"
          (scale_work_boundary 13 ([CheckInputItem scale_work_inductive] : List CheckInputWork))
      , assert_true "input work preserves exact accounting across traversal batches"
          (scale_work_batch_boundaries ([499, 500, 501, 999, 1000, 1001] : List Nat))
      , assert_true "blocked builder preserves the exact nested Core shape"
          (scale_builder_boundaries ([0, 1, 999, 1000, 1001, add (mul 2 1000) 1] : List Nat))
      , assert_true "successor and numeric increment agree at representation boundaries"
          (scale_increment_boundaries ([0, 1, 99, 100, 255, 256, 1000, mul 20 (mul 10 100)] : List Nat))
      ];
