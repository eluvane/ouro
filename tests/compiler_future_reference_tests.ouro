import "../compiler/compiler.ouro",
  "../std/test.ouro";
import "compiler_wide_nat_fixtures.ouro";
import "../compiler/file_elab_core.ouro" as CoreShape;

private def future_reference_leaves (target : Nat) : List Surface :=
    [ SConst target
    , SInd target
    , SConstruct target 3 2
    , SCase (MkCaseInfo target 4 [9]) (SSort 0) (SSort 0) []
    , SPerform target []
    , SStr 41 target
    ];

private def future_reference_children (child : Surface) : List Surface :=
    let leaf : Surface := SSort 0 in
    let info : CaseInfo := MkCaseInfo 4 0 [] in
    [ SPi 9 child leaf, SPi 9 leaf child
    , SLam 9 child leaf, SLam 9 leaf child
    , SApp child leaf, SApp leaf child
    , SLet 9 child leaf leaf, SLet 9 leaf child leaf, SLet 9 leaf leaf child
    , SCase info child leaf [], SCase info leaf child []
    , SCase info leaf leaf [child, leaf], SCase info leaf leaf [leaf, child]
    , SFix 9 0 1 child leaf, SFix 9 0 1 leaf child
    , SEffectRow child
    , SPerform 4 [child, leaf], SPerform 4 [leaf, child]
    ];

private def future_reference_non_globals : List Surface :=
    [ SVar 9, SSort 9, SHole 9
    , SConstruct 4 9 9
    , SCase (MkCaseInfo 4 9 [9]) (SSort 0) (SSort 0) []
    , SFix 9 9 9 (SSort 0) (SVar 9)
    , SStr 9 4
    ];

private def future_reference_wrap : Nat -> Surface -> Surface :=
  fix wrap (depth : Nat) (inner : Surface) : Surface :=
    match depth with
    | Z => inner
    | S rest => SApp (SSort 0) (wrap rest inner)
    end;

private def future_reference_all (fuel : Nat) (future : List Nat) (expected : Bool)
    (surfaces : List Surface) : Bool :=
    all Surface (fun (surface : Surface) =>
      compiler_bool_equal (surface_has_future_global fuel surface future) expected) surfaces;

private def future_reference_local_context : Bool :=
    match compile_program_item_pure 7 (SLam 9 (SSort 0) (SVar 9)) [7, 9] [] [] with
    | Left _ => False
    | Right compiled => match compiled with
        | MkPair remaining core =>
            andb (CoreShape.eqList remaining [9])
              (CoreShape.eqList (CoreShape.encode 100 core) (CoreShape.encode 100 (CLam (CSort 0) (CRel 0))))
        end
    end;

private def future_reference_preceding_context : Bool :=
    match compile_program_with_location
      [MkPair Nat Surface 7 (SSort 0), MkPair Nat Surface 8 (SVar 7)] with
    | CompileProgramLocatedErr _ _ => False
    | CompileProgramLocatedOk cores => match cores with
        | Nil => False
        | Cons first rest => match first with
            | MkPair name core => andb (eqNat name 7)
                (andb (CoreShape.eqList (CoreShape.encode 100 core) (CoreShape.encode 100 (CSort 0)))
                  (match rest with
                   | Nil => False
                   | Cons second tail => match second with
                       | MkPair other body => andb (eqNat other 8)
                           (andb (CoreShape.eqList (CoreShape.encode 100 body) (CoreShape.encode 100 (CRel 0)))
                             (match tail with | Nil => True | Cons _ _ => False end))
                       end
                   end))
            end
        end
    end;

def future_reference_tests : List Test :=
    let leaves : List Surface := future_reference_leaves 9 in
    let children : List Surface := future_reference_children (SConst 9) in
    let wide_base : Nat := compiler_test_wide_nat_base in
    let wide : Nat := S wide_base in
    [ assert_true "future references include all six global-bearing forms"
        (future_reference_all 1 [9] True leaves)
    , assert_true "zero fuel hides every global-bearing form"
        (future_reference_all 0 [9] False leaves)
    , assert_true "empty future names preserve false"
        (future_reference_all 100 [] False (append Surface leaves children))
    , assert_true "future references visit every recursive field and list position"
        (future_reference_all 2 [9] True children)
    , assert_true "children at the exhausted boundary stay hidden"
        (future_reference_all 1 [9] False children)
    , assert_true "binder literal and metadata IDs are not global references"
        (future_reference_all 100 [9] False future_reference_non_globals)
    , assert_true "duplicate future IDs retain existential membership"
        (future_reference_all 100 [5, 9, 9, 9, 8] True (append Surface leaves children))
    , assert_true "repeated references retain membership"
        (surface_has_future_global 3 (SApp (SConst 9) (SApp (SConst 9) (SConst 9))) [9])
    , assert_true "repeated references retain a missing-name result"
        (notb (surface_has_future_global 3 (SApp (SConst 9) (SApp (SConst 9) (SConst 9))) [5, 8]))
    , assert_true "a shallow miss does not hide a later branch reference"
        (surface_has_future_global 2
          (SCase (MkCaseInfo 4 0 []) (SSort 0) (SSort 0) [SConst 5, SConst 9]) [9])
    , assert_true "the last visited layer retains its future global"
        (surface_has_future_global fuel32 (future_reference_wrap (sub fuel32 1) (SConst 9)) [9])
    , assert_true "a global beyond the old fuel limit stays hidden"
        (notb (surface_has_future_global fuel32 (future_reference_wrap fuel32 (SConst 9)) [9]))
    , assert_true "wide IDs match across packed and successor forms"
        (future_reference_all 1 [add wide_base 1] True (future_reference_leaves wide))
    , assert_true "wide IDs do not match equal low machine-word bits"
        (future_reference_all 1 [1] False (future_reference_leaves wide))
    , assert_true "wide and small references remain distinct in one index"
        (andb (surface_has_future_global 2 (SApp (SConst wide) (SConst 1)) [wide])
          (andb (surface_has_future_global 2 (SApp (SConst wide) (SConst 1)) [1])
            (notb (surface_has_future_global 2 (SApp (SConst wide) (SConst 1)) [add wide_base 2]))))
    , assert_true "local binders retain the original de Bruijn context"
        future_reference_local_context
    , assert_true "preceding declarations retain the original context order"
        future_reference_preceding_context
    ];

-- @entry main
def main : IO Unit := test_run future_reference_tests;
