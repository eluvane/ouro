-- Independent bytes and metadata for assembly caching and error order.
import "../compiler/native/codegen_assembly.ouro",
  "../std/test.ouro",
  "native_call_site_words.ouro";

def assembly_test_error_text (err : NativeCodegenError) : String :=
    match err with
    | NativeMirError _ => "mir" | NativePeError _ => "pe"
    | NativeMissingSlot id => str_concat("slot:", str_of_nat id)
    | NativeMissingLabel id => str_concat("missing:", str_of_nat id)
    | NativeCodeTooLarge => "size"
    | NativeEncodingError problem => match problem with
      | X64ByteOutOfRange byte => str_concat("byte:", str_of_nat byte)
      | X64DisplacementOutOfRange => "displacement" | X64StackPointerIndex => "index"
      | X64ShiftOutOfRange width count => str_concat
          (match width with | X64Bits32 => "shift32:" | X64Bits64 => "shift64:" end) (str_of_nat count) end end;

def assembly_test_error (a : Type) (name : String) (actual : Either NativeCodegenError a) (expected : String) : Test :=
    match actual with | Left err => assert_eq name (assembly_test_error_text err) expected
    | Right _ => test_fail name "invalid assembly accepted" end;

def assembly_test_target (target : PeTarget) : List Nat :=
    match target with | PeSymbolTarget id => [0,id] | PeImportTarget id => [1,id] end;

def assembly_test_fixup (fixup : PeFixup) : List Nat :=
    match fixup with
    | PeRel32 section field origin target => append Nat [0,pe_section_code section,field,origin] (assembly_test_target target)
    | PeRva32 section field target => append Nat [1,pe_section_code section,field] (assembly_test_target target)
    | PeVa64 section field target => append Nat [2,pe_section_code section,field] (assembly_test_target target) end;

def assembly_test_words (actual : List (List Nat)) (expected : List (List Nat)) : Bool :=
    (fix compare (left : List (List Nat)) (right : List (List Nat)) : Bool :=
      match left, right with
      | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
      | Cons a more_a, Cons b more_b => andb(pe_bytes_equal a b, compare more_a more_b) end) actual expected;

def assembly_test_encoded (name : String) (actual : Either NativeCodegenError CodegenEncoded)
    (expected_bytes : List Nat) (expected_fixups : List PeFixup) (expected_calls : List NativeCallSite) : Test :=
    match actual with | Left err => test_fail(name, assembly_test_error_text err)
    | Right encoded => match encoded with | CodegenEncodedParts bytes fixups calls => assert_true name
        (andb (pe_bytes_equal bytes expected_bytes)
          (andb (assembly_test_words (map PeFixup (List Nat) assembly_test_fixup fixups)
            (map PeFixup (List Nat) assembly_test_fixup expected_fixups))
            (assembly_test_words (map NativeCallSite (List Nat) native_call_site_words calls)
              (map NativeCallSite (List Nat) native_call_site_words expected_calls)))) end end;

def assembly_test_labels_equal (actual : List CodegenLabelAt) (expected : List CodegenLabelAt) : Bool :=
    (fix compare (left : List CodegenLabelAt) (right : List CodegenLabelAt) : Bool :=
      match left, right with
      | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
      | Cons a more_a, Cons b more_b => match a, b with
        | CodegenLabelOffset a_label a_offset, CodegenLabelOffset b_label b_offset =>
          andb(codegen_label_equal a_label b_label, andb(eq_nat a_offset b_offset, compare more_a more_b)) end end)
        actual expected;

def assembly_test_labels (name : String) (atoms : List CodegenAtom) (offset : Nat) (expected : List CodegenLabelAt) : Test :=
    match codegen_labels atoms offset with | Left err => test_fail(name, assembly_test_error_text err)
    | Right labels => assert_true(name, assembly_test_labels_equal labels expected) end;

def assembly_test_invalid_shift : CodegenAtom := CodegenInstruction (X64ShiftImm X64Bits32 X64ShiftLeft X64Rax 32);
def assembly_test_invalid_byte : CodegenAtom := CodegenInstruction (X64MovImm32(X64Rax, X64Bytes32 256 0 0 0));
def assembly_test_missing : CodegenAtom := CodegenJump (CodegenBlockLabel 99);

def assembly_test_resolved_atoms : List CodegenAtom :=
    [CodegenMark (CodegenBlockLabel 1), CodegenMark (CodegenBlockLabel 2),
      CodegenInstruction (X64MovImm32(X64R9, X64Bytes32 1 1 0 0)),
      CodegenJumpIf(X64Equal, CodegenSiteLabel 2 3 4), CodegenInstruction X64Return,
      CodegenJump (CodegenBlockLabel 1), CodegenMark (CodegenSiteLabel 2 3 4), CodegenInstruction X64Trap];

def assembly_test_duplicate_atoms : List CodegenAtom :=
    [CodegenMark (CodegenBlockLabel 7), CodegenInstruction X64Return,
      CodegenMark (CodegenBlockLabel 7), CodegenJump (CodegenBlockLabel 7)];

def assembly_test_fixup_atoms : List CodegenAtom :=
    [CodegenDirectCall 11, CodegenBoundary 2 3, CodegenImportCall 12, CodegenBoundary 2 4,
      CodegenSymbolAddress 13 False, CodegenSymbolAddress 14 True, CodegenBoundary 2 5, CodegenInstruction X64Return];

def assembly_test_positive : List Test :=
    [assembly_test_encoded "Assembly preserves ordinary bytes and both branch directions above offset 255"
        (codegen_assemble assembly_test_resolved_atoms 700 300)
        [65,185,1,1,0,0,15,132,6,0,0,0,195,233,238,255,255,255,15,11] [] [],
      assembly_test_encoded "Assembly resolves the first duplicate label"
        (codegen_assemble assembly_test_duplicate_atoms 32 300) [195,233,250,255,255,255] [] [],
      assembly_test_labels "Public labels retain duplicates in source order" assembly_test_duplicate_atoms 300
        [CodegenLabelOffset(CodegenBlockLabel 7, 300),CodegenLabelOffset(CodegenBlockLabel 7, 301)],
      assembly_test_encoded "Assembly preserves zero fixup fields and exact call boundaries"
        (codegen_assemble assembly_test_fixup_atoms 700 300)
        [232,0,0,0,0,255,21,0,0,0,0,72,141,5,0,0,0,0,72,139,5,0,0,0,0,195]
        [PeRel32(PeText, add(mul 3 256, 233), add(mul 3 256, 237), PeSymbolTarget 11),PeRel32(PeText, add(mul 3 256, 239), add(mul 3 256, 243), PeImportTarget 12),
          PeRel32(PeText, add(mul 3 256, 246), add(mul 3 256, 250), PeSymbolTarget 13),PeRel32(PeText, add(mul 3 256, 253), add(mul 4 256, 1), PeImportTarget 14)]
        [NativeCallAt 2 3 (add(mul 19 256, 237)),NativeCallAt 2 4 (add(mul 19 256, 243)),NativeCallAt 2 5 (add(mul 20 256, 1))],
      assembly_test_encoded "Public atom emission uses caller labels and a backward displacement above 255"
        (codegen_emit_atoms [CodegenLabelOffset(CodegenBlockLabel 9, 0)] 700 [CodegenJump (CodegenBlockLabel 9)] 300)
        [233,207,254,255,255] [] [],
      match codegen_encode_atom [CodegenLabelOffset(CodegenBlockLabel 9, 600)] 300 (CodegenJump (CodegenBlockLabel 9)) with
      | Left err => test_fail("Public atom encoding retains a forward displacement above 255", assembly_test_error_text err)
      | Right bytes => assert_true("Public atom encoding retains a forward displacement above 255", pe_bytes_equal bytes [233,39,1,0,0]) end,
      assembly_test_labels "Public labels do not resolve a missing jump" [assembly_test_missing] 0 [],
      assembly_test_encoded "Public atom emission retains no code-size pass"
        (codegen_emit_atoms [] 0 [CodegenInstruction X64Return] (S pe_max_rva)) [195] [] [],
      assembly_test_labels "Public labels accept an empty list above the image bound" [] (S pe_max_rva) [],
      assembly_test_labels "Public labels retain a zero-byte mark above the image bound"
        [CodegenMark (CodegenBlockLabel 7)] (S pe_max_rva) [CodegenLabelOffset(CodegenBlockLabel 7, S pe_max_rva)],
      assembly_test_encoded "Assembly accepts an empty list above the image bound"
        (codegen_assemble [] 700 (S pe_max_rva)) [] [] [],
      assembly_test_encoded "Assembly accepts a zero-byte mark above the image bound"
        (codegen_assemble [CodegenMark (CodegenBlockLabel 7)] 700 (S pe_max_rva)) [] [] []];

def assembly_test_negative : List Test :=
    [assembly_test_error CodegenEncoded "Assembly checks a later shift before an earlier missing label"
        (codegen_assemble [assembly_test_missing,assembly_test_invalid_shift] 0 0) "shift32:32",
      assembly_test_error CodegenEncoded "Assembly checks a later byte before an earlier missing label"
        (codegen_assemble [assembly_test_missing,assembly_test_invalid_byte] 0 0) "byte:256",
      assembly_test_error CodegenEncoded "Assembly rejects code size before a later invalid instruction"
        (codegen_assemble [CodegenInstruction X64Return,assembly_test_invalid_shift] 0 pe_max_rva) "size",
      assembly_test_error CodegenEncoded "Assembly validates an operand before its own size bound"
        (codegen_assemble [assembly_test_invalid_shift] 0 pe_max_rva) "shift32:32",
      assembly_test_error CodegenEncoded "Assembly applies the size pass before label resolution"
        (codegen_assemble [assembly_test_missing] 0 pe_max_rva) "size",
      assembly_test_error CodegenEncoded "Assembly reports an unresolved label after a successful size pass"
        (codegen_assemble [assembly_test_missing] 0 0) "missing:99",
      assembly_test_error CodegenEncoded "Public atom emission resolves the first missing label before a later invalid operand"
        (codegen_emit_atoms [] 0 [assembly_test_missing,assembly_test_invalid_shift] 0) "missing:99",
      assembly_test_error CodegenEncoded "Public atom emission does not introduce size-error precedence"
        (codegen_emit_atoms [] 0 [CodegenInstruction X64Return,assembly_test_invalid_shift] pe_max_rva) "shift32:32",
      assembly_test_error (List Nat) "Public atom encoding still validates arbitrary instruction bytes"
        (codegen_encode_atom [] 0 assembly_test_invalid_byte) "byte:256",
      assembly_test_error (List CodegenLabelAt) "Public labels retain interleaved size checks"
        (codegen_labels [CodegenInstruction X64Return,assembly_test_invalid_byte] pe_max_rva) "size"];

def native_codegen_assembly_tests : List Test := append Test assembly_test_positive assembly_test_negative;
