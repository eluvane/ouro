-- Explicit primitive declarations share the ordinary checked environment.
import "../compiler/file_elab.ouro";
import "../std/io.ouro";

inductive BindingLaw : Type := | BindingLawOf : String -> Bool -> BindingLaw;

def binding_u32 : FileItem := FIntrinsic 100 (CSort 0)
    ([111, 117, 114, 111, 46, 117, 51, 50] : List Nat) (Nothing CoreTerm);
def binding_runtime : FileItem := FIntrinsic 101 (CPi (CSort 0) (CSort 0))
    ([111, 117, 114, 111, 46, 114, 117, 110, 116, 105, 109, 101] : List Nat) (Nothing CoreTerm);
def binding_add_type : CoreTerm := CPi (CConst 100) (CPi (CConst 100) (CConst 100));
def binding_add : FileItem := FIntrinsic 102 binding_add_type
    ([111, 117, 114, 111, 46, 117, 51, 50, 46, 97, 100, 100, 46, 119, 114, 97, 112] : List Nat)
    (Nothing CoreTerm);
def binding_runtime_u32 : CoreTerm := CApp (CConst 101) (CConst 100);
def binding_raw_fn : FileItem := FIntrinsic 105 (CPi (CSort 0) (CSort 0))
    ([111, 117, 114, 111, 46, 114, 97, 119, 95, 102, 110] : List Nat) (Nothing CoreTerm);
def binding_fn_call : FileItem := FIntrinsic 106
    (CPi (CApp (CConst 105) binding_runtime_u32) binding_runtime_u32)
    ([111, 117, 114, 111, 46, 102, 110, 46, 99, 97, 108, 108] : List Nat)
    (Just CoreTerm binding_runtime_u32);
def binding_windows : List Nat := [119, 105, 110, 100, 111, 119, 115, 45, 120, 56, 54, 95, 54, 52];
def binding_request (target : List Nat) (abi : List Nat) (variadic : Bool) (gc : PrimitiveGc)
    : ExternRequest :=
    ExternRequestOf target abi ([107, 101, 114, 110, 101, 108, 51, 50, 46, 100, 108, 108] : List Nat)
      ([71, 101, 116, 67, 117, 114, 114, 101, 110, 116, 80, 114, 111, 99, 101, 115, 115, 73, 100] : List Nat)
      variadic gc;
def binding_pid : FileItem := FExtern 103 binding_runtime_u32
    (binding_request binding_windows ([119, 105, 110, 54, 52] : List Nat) False PrimitiveMayGc);

def binding_check (items : List FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking (mul 20 50) items;
def binding_ok (count : Nat) (items : List FileItem) : Bool :=
    match binding_check items with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries => eqNat (length Entry entries) count
    end;
def binding_rejected (name : Nat) (code : Nat) (items : List FileItem) : Bool :=
    match binding_check items with
    | DeclarationsOk _ => False
    | DeclarationsErr actual phase failure =>
        andb (eqNat actual name)
          (eqNat (declaration_failure_code CheckExactCore phase failure) code)
    end;

-- Check one item directly so traversal cannot reduce the oversized budget.
def binding_large_budget : Nat := add primitive_max_fuel 1;
def binding_item_ok (fuel : Nat) (item : FileItem) : Bool :=
    match check_declaration CheckExactCore fuel (Nil Entry) item with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries => eqNat (length Entry entries) 1
    end;
def binding_item_rejected (fuel : Nat) (code : Nat) (item : FileItem) : Bool :=
    match check_declaration CheckExactCore fuel (Nil Entry) item with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure =>
        andb (eqNat name 100)
          (andb (match phase with
                 | CheckDeclarationType => True
                 | CheckDeclarationPlan => False | CheckDeclarationBody => False
                 | CheckInductiveDeclaration => False end)
            (eqNat (declaration_failure_code CheckExactCore phase failure) code))
    end;

def binding_native_metadata : Bool :=
    match binding_check ([binding_u32, binding_add] : List FileItem) with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries =>
        match entries with
        | Nil => False
        | Cons entry _ =>
            match entry with
            | MkEntry _ _ _ => False
            | MkIndEntry _ _ => False
            | MkRoleEntry _ => False
            | MkBoundEntry name typ metadata =>
                andb (eqNat name 102)
                  (andb (check_succeeded Unit (check_convertible 100 entries typ binding_add_type))
                    (match metadata with
                     | PrimitiveExternBinding _ => False
                     | PrimitiveIntrinsicBinding id execution gc _ =>
                         andb (primitive_id_equal id
                           (PrimitiveWordOperation PrimitiveWordU32 PrimitiveAddWrap))
                           (andb (match execution with | PrimitivePureValue => True
                                  | PrimitiveTypeOnly => False | PrimitiveRuntimeAction => False end)
                             (match gc with | PrimitiveNoGc => True | PrimitiveMayGc => False end))
                     end))
            end
        end
    end;

def binding_opaque : Bool :=
    match binding_check ([binding_u32, binding_add, FAxiom 104 (CConst 100)] : List FileItem) with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries =>
        let call : CoreTerm := CApp (CApp (CConst 102) (CConst 104)) (CConst 104) in
        andb (match lookup_const 102 entries with | Nothing => True | Just _ => False end)
          (match normalize_checked 100 entries call with
           | Normalized normal => check_bool (check_from_normalize Bool (eqTerm_checked 100 call normal))
           | NormalizeExhausted => False | NormalizeMalformed _ => False end)
    end;

def binding_extern_metadata : Bool :=
    match binding_check ([binding_u32, binding_runtime, binding_pid] : List FileItem) with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries =>
        match entries with
        | Nil => False
        | Cons entry _ =>
            match entry with
            | MkEntry _ _ _ => False
            | MkIndEntry _ _ => False
            | MkRoleEntry _ => False
            | MkBoundEntry name _ metadata =>
                andb (eqNat name 103)
                  (match metadata with
                   | PrimitiveIntrinsicBinding _ _ _ _ => False
                   | PrimitiveExternBinding checked =>
                       match checked with
                       | CheckedExternOf _ _ dll symbol signature gc =>
                           andb (primitive_bytes_equal dll
                             ([107, 101, 114, 110, 101, 108, 51, 50, 46, 100, 108, 108] : List Nat))
                             (andb (primitive_bytes_equal symbol
                               ([71, 101, 116, 67, 117, 114, 114, 101, 110, 116, 80, 114, 111, 99, 101, 115, 115, 73, 100] : List Nat))
                               (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                                 (match signature with
                                  | PrimitiveAbiSignatureOf args result =>
                                      andb (eqNat (length PrimitiveAbiValue args) 0)
                                        (match result with
                                         | Nothing => False
                                         | Just value => match value with
                                           | PrimitiveAbiWord word => primitive_word_equal word PrimitiveWordU32
                                           | PrimitiveAbiPointer _ => False | PrimitiveAbiFunction _ => False end
                                         end)
                                  end)))
                       end
                   end)
            end
        end
    end;

def binding_raw_pointer : FileItem := FIntrinsic 107 (CPi (CSort 0) (CSort 0))
    (primitive_key PrimitiveRawPtrType) (Nothing CoreTerm);

def binding_raw_load_type (stored : CoreTerm) : CoreTerm :=
    CPi (CApp (CConst 107) stored) (CApp (CConst 101) stored);

def binding_raw_load (stored : CoreTerm) (specialization : Maybe CoreTerm) : FileItem :=
    FIntrinsic 108 (binding_raw_load_type stored) (primitive_key PrimitiveRawLoad) specialization;

def binding_specialization_equal (actual : Maybe CoreTerm) (expected : Maybe CoreTerm) : Bool :=
    match actual, expected with
    | Nothing, Nothing => True
    | Just left, Just right => check_bool (check_from_normalize Bool (eqTerm_checked 100 left right))
    | Just _, Nothing => False
    | Nothing, Just _ => False
    end;

def binding_specialization_metadata (name : Nat) (id : PrimitiveId) (expected : Maybe CoreTerm)
    (items : List FileItem) : Bool :=
    match binding_check items with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries =>
        match entries with
        | Nil => False
        | Cons entry _ =>
            match entry with
            | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False
            | MkBoundEntry actual _ binding =>
                andb (eqNat actual name)
                  (match binding with
                   | PrimitiveExternBinding _ => False
                   | PrimitiveIntrinsicBinding registered _ _ specialization =>
                       andb (primitive_id_equal id registered) (binding_specialization_equal specialization expected)
                   end)
            end
        end
    end;

def binding_laws : List BindingLaw :=
    [ BindingLawOf "registered type and operation retain native metadata" binding_native_metadata
    , BindingLawOf "pure native operations remain opaque during conversion" binding_opaque
    , BindingLawOf "extern preserves symbol scalar ABI and GC contract" binding_extern_metadata
    , BindingLawOf "ordinary definitions may call a checked operation"
        (binding_ok 4 ([binding_u32, binding_add, FAxiom 104 (CConst 100),
          FDef 105 (CConst 100) (CApp (CApp (CConst 102) (CConst 104)) (CConst 104))] : List FileItem))
    , BindingLawOf "unknown intrinsic is an unsupported declaration"
        (binding_rejected 100 7 ([FIntrinsic 100 (CSort 0) ([98, 97, 100] : List Nat) (Nothing CoreTerm)] : List FileItem))
    , BindingLawOf "registered type must have its exact universe signature"
        (binding_rejected 100 2 ([FIntrinsic 100 (CSort 1)
          ([111, 117, 114, 111, 46, 117, 51, 50] : List Nat) (Nothing CoreTerm)] : List FileItem))
    , BindingLawOf "a second identity binding for one primitive type is rejected"
        (binding_rejected 106 5 ([binding_u32, FIntrinsic 106 (CSort 0)
          ([111, 117, 114, 111, 46, 117, 51, 50] : List Nat) (Nothing CoreTerm)] : List FileItem))
    , BindingLawOf "a same-named axiom does not register a machine type"
        (binding_rejected 102 2 ([FAxiom 100 (CSort 0), binding_add] : List FileItem))
    , BindingLawOf "operation signature mismatch is a type error"
        (binding_rejected 102 2 ([binding_u32, FIntrinsic 102 (CPi (CConst 100) (CConst 100))
          ([111, 117, 114, 111, 46, 117, 51, 50, 46, 97, 100, 100, 46, 119, 114, 97, 112] : List Nat)
          (Nothing CoreTerm)] : List FileItem))
    , BindingLawOf "ordinary aliases are accepted by canonical conversion"
        (binding_ok 3 ([binding_u32, FDef 106 (CSort 0) (CConst 100),
          FIntrinsic 102 (CPi (CConst 106) (CPi (CConst 106) (CConst 106)))
            ([111, 117, 114, 111, 46, 117, 51, 50, 46, 97, 100, 100, 46, 119, 114, 97, 112] : List Nat)
            (Nothing CoreTerm)] : List FileItem))
    , BindingLawOf "specialization type itself is checked"
        (binding_rejected 106 6 ([binding_u32, FIntrinsic 106 (CSort 0)
          ([111, 117, 114, 111, 46, 117, 56] : List Nat) (Just CoreTerm (CRel 0))] : List FileItem))
    , BindingLawOf "valid function call specialization is accepted"
        (binding_ok 4 ([binding_u32, binding_runtime, binding_raw_fn, binding_fn_call] : List FileItem))
    , BindingLawOf "module budget above registry limit accepts a valid intrinsic"
        (binding_item_ok binding_large_budget binding_u32)
    , BindingLawOf "large module budget preserves unsupported intrinsic failure"
        (binding_item_rejected binding_large_budget 7
          (FIntrinsic 100 (CSort 0) ([98, 97, 100] : List Nat) (Nothing CoreTerm)))
    , BindingLawOf "zero declaration budget still reports exhaustion"
        (binding_item_rejected 0 4 binding_u32)
    , BindingLawOf "unsupported extern target has a distinct failure"
        (binding_rejected 103 7 ([binding_u32, binding_runtime,
          FExtern 103 binding_runtime_u32 (binding_request ([108, 105, 110, 117, 120] : List Nat)
            ([119, 105, 110, 54, 52] : List Nat) False PrimitiveMayGc)] : List FileItem))
    , BindingLawOf "unsupported extern ABI has a distinct failure"
        (binding_rejected 103 7 ([binding_u32, binding_runtime,
          FExtern 103 binding_runtime_u32 (binding_request binding_windows ([99] : List Nat)
            False PrimitiveMayGc)] : List FileItem))
    , BindingLawOf "variadic extern is rejected"
        (binding_rejected 103 7 ([binding_u32, binding_runtime,
          FExtern 103 binding_runtime_u32 (binding_request binding_windows
            ([119, 105, 110, 54, 52] : List Nat) True PrimitiveMayGc)] : List FileItem))
    , BindingLawOf "extern must return a Runtime action"
        (binding_rejected 103 2 ([binding_u32, binding_runtime,
          FExtern 103 (CConst 100) (binding_request binding_windows
            ([119, 105, 110, 54, 52] : List Nat) False PrimitiveMayGc)] : List FileItem))
    , BindingLawOf "Runtime result cannot be used as a pure machine value"
        (binding_rejected 105 1 ([binding_u32, binding_runtime, binding_pid,
          FDef 105 (CConst 100) (CConst 103)] : List FileItem))
    , BindingLawOf "failed imported-style body still prevents native module acceptance"
        (binding_rejected 105 1 ([binding_u32, binding_runtime, binding_pid,
          FDef 105 (CConst 100) (CSort 0), FAxiom 106 (CConst 100)] : List FileItem))
    , BindingLawOf "ordinary primitive records no specialization"
        (binding_specialization_metadata 102 (PrimitiveWordOperation PrimitiveWordU32 PrimitiveAddWrap)
          (Nothing CoreTerm) ([binding_u32, binding_add] : List FileItem))
    , BindingLawOf "function call retains its checked machine signature"
        (binding_specialization_metadata 106 PrimitiveFnCall (Just CoreTerm binding_runtime_u32)
          ([binding_u32, binding_runtime, binding_raw_fn, binding_fn_call] : List FileItem))
    , BindingLawOf "function call specialization is stored in canonical form"
        (binding_specialization_metadata 106 PrimitiveFnCall (Just CoreTerm binding_runtime_u32)
          ([binding_u32, binding_runtime, binding_raw_fn, FDef 104 (CSort 0) binding_runtime_u32,
            FIntrinsic 106 (CPi (CApp (CConst 105) binding_runtime_u32) binding_runtime_u32)
              (primitive_key PrimitiveFnCall) (Just CoreTerm (CConst 104))] : List FileItem))
    , BindingLawOf "scalar raw load declaration is accepted"
        (binding_ok 4 ([binding_u32, binding_runtime, binding_raw_pointer,
          binding_raw_load (CConst 100) (Just CoreTerm (CConst 100))] : List FileItem))
    , BindingLawOf "raw load stores normalized scalar identity"
        (binding_specialization_metadata 108 PrimitiveRawLoad (Just CoreTerm (CConst 100))
          ([binding_u32, binding_runtime, binding_raw_pointer, FDef 104 (CSort 0) (CConst 100),
            binding_raw_load (CConst 100) (Just CoreTerm (CConst 104))] : List FileItem))
    , BindingLawOf "generic raw load cannot claim storage for arbitrary types"
        (binding_rejected 108 2 ([binding_u32, binding_runtime, binding_raw_pointer,
          FIntrinsic 108 (CPi (CSort 0) (CPi (CApp (CConst 107) (CRel 0)) (CApp (CConst 101) (CRel 1))))
            (primitive_key PrimitiveRawLoad) (Nothing CoreTerm)] : List FileItem))
    , BindingLawOf "raw load rejects a managed String value"
        (binding_rejected 108 2 ([binding_u32, binding_runtime, binding_raw_pointer,
          FIntrinsic 109 (CSort 0) (primitive_key PrimitiveStringType) (Nothing CoreTerm),
          binding_raw_load (CConst 109) (Just CoreTerm (CConst 109))] : List FileItem))
    , BindingLawOf "an ordinary opaque type is not scalar raw storage"
        (binding_rejected 108 2 ([binding_u32, binding_runtime, binding_raw_pointer, FAxiom 109 (CSort 0),
          binding_raw_load (CConst 109) (Just CoreTerm (CConst 109))] : List FileItem))
    , BindingLawOf "raw load cannot return a pure scalar"
        (binding_rejected 108 2 ([binding_u32, binding_runtime, binding_raw_pointer,
          FIntrinsic 108 (CPi (CApp (CConst 107) (CConst 100)) (CConst 100))
            (primitive_key PrimitiveRawLoad) (Just CoreTerm (CConst 100))] : List FileItem))
    ];

-- @entry main
def main : IO Unit :=
    (fix run (laws : List BindingLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil => match failed with | True => exit 1 | False => exit 0 end
      | Cons law rest =>
          match law with
          | BindingLawOf name passed =>
              do println (prim_string_concat (match passed with | True => "ok " | False => "FAIL " end) name);
                 run rest (orb failed (notb passed))
          end
      end) binding_laws False;
