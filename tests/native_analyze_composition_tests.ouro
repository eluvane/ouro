import "analyze/precision/assertions.ouro",
  "../tools/analyze/native_composition.ouro";

def native_composition_fixture_base : String :=
    "ANALYZE_OK profile=strict files=1 imports=0 decls=1 refs=0 exports=1 constructors=0 modules=1 branches=0 suppressions=0 strict-diagnostics=0\nANALYZE_FACTS architecture=graph suppressions=parsed deadcode=typed-facts api_surface=baseline format=strict-subset trust=effects-taint-required structured=ouro-analyze-drive\n";

def native_composition_fixture_query : ProcResult :=
    MkProcResult Z "ANALYZE_FAMILIES families=dataflow\n" "";

def native_composition_fixture_drive : ProcResult :=
    MkProcResult Z "ANALYZE_DRIVE files=1 findings=0 rejected=0 families=dataflow\n" "";

def native_composition_fixture_expected : Maybe BoundedDriveExpected :=
    Just BoundedDriveExpected (MkBoundedDriveExpected (Just String "1")
      (Just String "dataflow") (Just String "std/io.ouro"));

def native_composition_fixture_accept (expected : Maybe BoundedDriveExpected)
    (base : ProcResult) (query : Maybe ProcResult) (drive : Maybe ProcResult) : Bool :=
    match native_analyze_composition_verify "strict" "1" expected base query drive with
    | Left _ => False
    | Right _ => True
    end;

def native_composition_fixture_rejected (base : ProcResult) : Bool :=
    notb(native_composition_fixture_accept (Nothing BoundedDriveExpected) base
      (Nothing ProcResult) (Nothing ProcResult));

def native_composition_fixture_style (words : List String) (expected : List String) : Bool :=
    precision_strings (native_analyze_expand_style words) expected;

def native_composition_fixture_sources : List NativeAnalyzeSourceFacts :=
    map Nat NativeAnalyzeSourceFacts (fun (n : Nat) =>
      NativeAnalyzeSourceFactsOf (str_cat3 "tools/item" (str_of_nat n) ".ouro") 1 False)
      [1, 2, 3, 4, 5, 6, 7, 8, 9];

def native_analyze_composition_laws : List (Pair String Bool) :=
  [ MkPair String Bool "native-composition/style/expanded-order"
      (native_composition_fixture_style ["--strict", "--enable-style", "--scope", "space 雪.ouro"]
        (append String ["--strict"] (append String native_analyze_style_words ["--scope", "space 雪.ouro"])))
  , MkPair String Bool "native-composition/style/repeated-words-preserved"
      (native_composition_fixture_style ["--enable-style", "--enable-style", "--enable-naming"]
        (append String native_analyze_style_words (append String native_analyze_style_words ["--enable-naming"])))
  , MkPair String Bool "native-composition/style/scope-value-is-literal"
      (native_composition_fixture_style ["--scope", "--enable-style"] ["--scope", "--enable-style"])
  , MkPair String Bool "native-composition/style/baseline-value-is-literal"
      (native_composition_fixture_style ["--api-baseline", "--enable-style"] ["--api-baseline", "--enable-style"])
  , MkPair String Bool "native-composition/style/missing-value-not-repaired"
      (native_composition_fixture_style ["--enable-style", "--scope"]
        (append String native_analyze_style_words ["--scope"]))
  , MkPair String Bool "native-composition/select/strict-is-not-enable-strict"
      (andb(notb(native_analyze_needs_drive ["--strict"]), native_analyze_needs_drive ["--enable-strict"]))
  , MkPair String Bool "native-composition/select/style-requires-drive"
      (native_analyze_needs_drive (native_analyze_expand_style ["--enable-style"]))
  , MkPair String Bool "native-composition/select/base-code-two-stops-drive"
      (notb(native_analyze_drive_after_base ["--enable-dataflow"] (MkProcResult 2 "" "invalid arguments")))
  , MkPair String Bool "native-composition/select/base-findings-still-run-drive"
      (native_analyze_drive_after_base ["--enable-dataflow"] (MkProcResult 1 "diagnostic" ""))
  , MkPair String Bool "native-composition/bounds/global-eight-65536"
      (andb(native_analyze_global_scope_valid ["--enable-all"]
          (take NativeAnalyzeSourceFacts 8 native_composition_fixture_sources),
        native_analyze_global_scope_valid ["--enable-all"]
          [NativeAnalyzeSourceFactsOf "tools/large.ouro" (mul 256 256) False]))
  , MkPair String Bool "native-composition/bounds/global-nine-refused"
      (notb(native_analyze_global_scope_valid ["--enable-all"] native_composition_fixture_sources))
  , MkPair String Bool "native-composition/bounds/global-byte-excess-refused"
      (notb(native_analyze_global_scope_valid ["--dump-facts"]
        [NativeAnalyzeSourceFactsOf "tools/large.ouro" (S (mul 256 256)) False]))
  , MkPair String Bool "native-composition/bounds/drive-40960"
      (native_analyze_drive_scope_valid ["--enable-dataflow"]
        [NativeAnalyzeSourceFactsOf "tools/large.ouro" (mul 40 (mul 32 32)) False])
  , MkPair String Bool "native-composition/bounds/drive-byte-excess-refused"
      (notb(native_analyze_drive_scope_valid ["--enable-dataflow"]
        [NativeAnalyzeSourceFactsOf "tools/large.ouro" (S (mul 40 (mul 32 32))) False]))
  , MkPair String Bool "native-composition/batch/nine-local-files"
      (native_analyze_should_batch ["--strict"] native_composition_fixture_sources)
  , MkPair String Bool "native-composition/batch/single-stdlib-needs-baseline-shard"
      (native_analyze_should_batch [] [NativeAnalyzeSourceFactsOf "std/io.ouro" 1 False])
  , MkPair String Bool "native-composition/batch/small-nonstdlib-direct"
      (notb(native_analyze_should_batch [] [NativeAnalyzeSourceFactsOf "tools/local.ouro" 1 False]))
  , MkPair String Bool "native-composition/batch/suppression-keeps-direct"
      (notb(native_analyze_should_batch ["--strict"]
        (Cons NativeAnalyzeSourceFacts (NativeAnalyzeSourceFactsOf "tools/suppressed.ouro" 1 True)
          native_composition_fixture_sources)))
  , MkPair String Bool "native-composition/batch/global-keeps-direct"
      (notb(native_analyze_should_batch ["--enable-trust"] native_composition_fixture_sources))
  , MkPair String Bool "native-composition/base/LF-clean"
      (native_composition_fixture_accept (Nothing BoundedDriveExpected)
        (MkProcResult Z native_composition_fixture_base "") (Nothing ProcResult) (Nothing ProcResult))
  , MkPair String Bool "native-composition/base/CRLF-clean"
      (native_composition_fixture_accept (Nothing BoundedDriveExpected)
        (MkProcResult Z (str_replace native_composition_fixture_base "\n" "\r\n") "")
        (Nothing ProcResult) (Nothing ProcResult))
  , MkPair String Bool "native-composition/base/quiet-zero-is-not-completion"
      (native_composition_fixture_rejected (MkProcResult Z "" ""))
  , MkPair String Bool "native-composition/base/nonzero-is-failure"
      (native_composition_fixture_rejected (MkProcResult 1 native_composition_fixture_base ""))
  , MkPair String Bool "native-composition/base/stderr-is-failure"
      (native_composition_fixture_rejected (MkProcResult Z native_composition_fixture_base "missing input"))
  , MkPair String Bool "native-composition/base/repeated-report-refused"
      (native_composition_fixture_rejected (MkProcResult Z
        (str_concat native_composition_fixture_base native_composition_fixture_base) ""))
  , MkPair String Bool "native-composition/base/profile-mismatch-refused"
      (native_composition_fixture_rejected (MkProcResult Z
        (str_replace native_composition_fixture_base "profile=strict" "profile=standard") ""))
  , MkPair String Bool "native-composition/base/files-mismatch-refused"
      (native_composition_fixture_rejected (MkProcResult Z
        (str_replace native_composition_fixture_base "files=1" "files=2") ""))
  , MkPair String Bool "native-composition/base/nonzero-strict-diagnostics-refused"
      (native_composition_fixture_rejected (MkProcResult Z
        (str_replace native_composition_fixture_base "strict-diagnostics=0" "strict-diagnostics=1") ""))
  , MkPair String Bool "native-composition/base/missing-count-refused"
      (native_composition_fixture_rejected (MkProcResult Z
        (str_replace native_composition_fixture_base " branches=0" "") ""))
  , MkPair String Bool "native-composition/base/diagnostic-with-success-banner-refused"
      (native_composition_fixture_rejected (MkProcResult Z
        (str_concat "file:1:1: warning[OURO-DF001] diagnostic\n" native_composition_fixture_base) ""))
  , MkPair String Bool "native-composition/drive/clean-query-and-report"
      (native_composition_fixture_accept native_composition_fixture_expected
        (MkProcResult Z native_composition_fixture_base "")
        (Just ProcResult native_composition_fixture_query) (Just ProcResult native_composition_fixture_drive))
  , MkPair String Bool "native-composition/drive/query-missing-refused"
      (notb(native_composition_fixture_accept native_composition_fixture_expected
        (MkProcResult Z native_composition_fixture_base "") (Nothing ProcResult)
        (Just ProcResult native_composition_fixture_drive)))
  , MkPair String Bool "native-composition/drive/report-missing-refused"
      (notb(native_composition_fixture_accept native_composition_fixture_expected
        (MkProcResult Z native_composition_fixture_base "")
        (Just ProcResult native_composition_fixture_query) (Nothing ProcResult)))
  , MkPair String Bool "native-composition/drive/family-mismatch-refused"
      (notb(native_composition_fixture_accept native_composition_fixture_expected
        (MkProcResult Z native_composition_fixture_base "")
        (Just ProcResult (MkProcResult Z "ANALYZE_FAMILIES families=contracts\n" ""))
        (Just ProcResult native_composition_fixture_drive)))
  , MkPair String Bool "native-composition/drive/unexpected-run-refused"
      (notb(native_composition_fixture_accept (Nothing BoundedDriveExpected)
        (MkProcResult Z native_composition_fixture_base "")
        (Nothing ProcResult) (Just ProcResult native_composition_fixture_drive)))
  , MkPair String Bool "native-composition/drive/findings-are-failure-not-report-success"
      (notb(native_composition_fixture_accept native_composition_fixture_expected
        (MkProcResult Z native_composition_fixture_base "") (Just ProcResult native_composition_fixture_query)
        (Just ProcResult (MkProcResult 1
          "std/io.ouro:1:1: warning[OURO-DF003] dataflow/alias: message\n  hint: fix\n  witness: name\nANALYZE_DRIVE files=1 findings=1 rejected=0 families=dataflow\n" ""))))
  , MkPair String Bool "native-composition/drive/typed-rejection-is-failure"
      (notb(native_composition_fixture_accept native_composition_fixture_expected
        (MkProcResult Z native_composition_fixture_base "") (Just ProcResult native_composition_fixture_query)
        (Just ProcResult (MkProcResult 1
          "ANALYZE_DRIVE files=1 findings=0 rejected=1 families=dataflow\n"
          "std/io.ouro: structured analyzer could not build the unit: parse\n"))))
  , MkPair String Bool "native-composition/capture/fixed-sibling-and-literal-argv"
      (match native_sibling_command_checked (Right ExecutablePathError String "C:\\bundle\\ouro-analyze.exe")
          (native_analyze_worker_name NativeAnalyzeDriveWorker) ["--scope", "space 雪\"&|.ouro", ""] with
       | Left _ => False
       | Right command => andb(str_eq (command_program command) "C:\\bundle\\ouro-analyze-drive.exe",
           precision_strings (command_args command) ["--scope", "space 雪\"&|.ouro", ""])
       end)
  ];

-- @entry main
def main : IO Unit := precision_run "native-analyze-composition" native_analyze_composition_laws;
