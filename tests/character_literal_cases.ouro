-- Independent byte vectors include encodings that source text cannot represent.

import "../std/data.ouro",
  "../std/string_prims.ouro";

def character_valid_ascii : List (Pair (List Nat) Nat) :=
  [ MkPair (List Nat) Nat ([39, 97, 39] : List Nat) 97
  , MkPair (List Nat) Nat ([39, 32, 39] : List Nat) 32
  , MkPair (List Nat) Nat ([39, 34, 39] : List Nat) 34
  , MkPair (List Nat) Nat ([39, 123, 39] : List Nat) 123
  , MkPair (List Nat) Nat ([39, 125, 39] : List Nat) 125
  , MkPair (List Nat) Nat ([39, 93, 39] : List Nat) 93
  ];

def character_valid_utf8_short : List (Pair (List Nat) Nat) :=
  [ MkPair (List Nat) Nat ([39, 194, 128, 39] : List Nat) 128
  , MkPair (List Nat) Nat ([39, 195, 169, 39] : List Nat) 233
  , MkPair (List Nat) Nat ([39, 224, 160, 128, 39] : List Nat) (mul 8 256)
  , MkPair (List Nat) Nat ([39, 226, 130, 172, 39] : List Nat) (add (mul 32 256) 172)
  , MkPair (List Nat) Nat ([39, 237, 159, 191, 39] : List Nat) (sub (mul 216 256) 1)
  ];

def character_valid_utf8_wide : List (Pair (List Nat) Nat) :=
  [ MkPair (List Nat) Nat ([39, 238, 128, 128, 39] : List Nat) (mul 224 256)
  , MkPair (List Nat) Nat ([39, 240, 144, 128, 128, 39] : List Nat) (mul 256 256)
  , MkPair (List Nat) Nat ([39, 240, 159, 152, 128, 39] : List Nat) (mul 251 (mul 2 256))
  , MkPair (List Nat) Nat ([39, 244, 143, 191, 191, 39] : List Nat) (sub (mul 17 (mul 256 256)) 1)
  ];

def character_valid_simple_escapes : List (Pair (List Nat) Nat) :=
  [ MkPair (List Nat) Nat ([39, 92, 110, 39] : List Nat) 10
  , MkPair (List Nat) Nat ([39, 92, 116, 39] : List Nat) 9
  , MkPair (List Nat) Nat ([39, 92, 114, 39] : List Nat) 13
  , MkPair (List Nat) Nat ([39, 92, 39, 39] : List Nat) 39
  , MkPair (List Nat) Nat ([39, 92, 34, 39] : List Nat) 34
  , MkPair (List Nat) Nat ([39, 92, 92, 39] : List Nat) 92
  ];

def character_valid_unicode_escapes : List (Pair (List Nat) Nat) :=
  [ MkPair (List Nat) Nat ([39, 92, 117, 123, 48, 125, 39] : List Nat) 0
  , MkPair (List Nat) Nat ([39, 92, 117, 123, 56, 48, 125, 39] : List Nat) 128
  , MkPair (List Nat) Nat ([39, 92, 117, 123, 68, 55, 70, 70, 125, 39] : List Nat) (sub (mul 216 256) 1)
  , MkPair (List Nat) Nat ([39, 92, 117, 123, 69, 48, 48, 48, 125, 39] : List Nat) (mul 224 256)
  , MkPair (List Nat) Nat ([39, 92, 117, 123, 49, 48, 70, 70, 70, 70, 125, 39] : List Nat) (sub (mul 17 (mul 256 256)) 1)
  , MkPair (List Nat) Nat ([39, 92, 117, 123, 49, 102, 54, 48, 48, 125, 39] : List Nat) (mul 251 (mul 2 256))
  , MkPair (List Nat) Nat ([39, 92, 117, 123, 48, 48, 48, 48, 54, 49, 125, 39] : List Nat) 97
  ];

def character_invalid_shape : List (Pair String (List Nat)) :=
  [ MkPair String (List Nat) "empty" ([39, 39] : List Nat)
  , MkPair String (List Nat) "multiple" ([39, 97, 98, 39] : List Nat)
  , MkPair String (List Nat) "combining" ([39, 101, 204, 129, 39] : List Nat)
  , MkPair String (List Nat) "unclosed" ([39, 97] : List Nat)
  , MkPair String (List Nat) "line-feed" ([39, 10, 39] : List Nat)
  , MkPair String (List Nat) "carriage-return" ([39, 13, 39] : List Nat)
  ];

def character_invalid_utf8_short : List (Pair String (List Nat)) :=
  [ MkPair String (List Nat) "lone-continuation" ([39, 128, 39] : List Nat)
  , MkPair String (List Nat) "overlong-two" ([39, 192, 175, 39] : List Nat)
  , MkPair String (List Nat) "bad-continuation" ([39, 194, 97, 39] : List Nat)
  , MkPair String (List Nat) "truncated-two" ([39, 195, 39] : List Nat)
  , MkPair String (List Nat) "overlong-three" ([39, 224, 128, 128, 39] : List Nat)
  , MkPair String (List Nat) "truncated-three" ([39, 226, 130, 39] : List Nat)
  ];

def character_invalid_utf8_wide : List (Pair String (List Nat)) :=
  [ MkPair String (List Nat) "surrogate" ([39, 237, 160, 128, 39] : List Nat)
  , MkPair String (List Nat) "overlong-four" ([39, 240, 128, 128, 128, 39] : List Nat)
  , MkPair String (List Nat) "truncated-four" ([39, 240, 159, 152, 39] : List Nat)
  , MkPair String (List Nat) "above-maximum" ([39, 244, 144, 128, 128, 39] : List Nat)
  , MkPair String (List Nat) "invalid-leading-byte" ([39, 245, 128, 128, 128, 39] : List Nat)
  , MkPair String (List Nat) "byte-out-of-range" ([39, 256, 39] : List Nat)
  ];

def character_invalid_escapes : List (Pair String (List Nat)) :=
  [ MkPair String (List Nat) "unknown-escape" ([39, 92, 113, 39] : List Nat)
  , MkPair String (List Nat) "truncated-escape" ([39, 92] : List Nat)
  , MkPair String (List Nat) "empty-unicode" ([39, 92, 117, 123, 125, 39] : List Nat)
  , MkPair String (List Nat) "surrogate-escape" ([39, 92, 117, 123, 68, 56, 48, 48, 125, 39] : List Nat)
  , MkPair String (List Nat) "above-maximum-escape" ([39, 92, 117, 123, 49, 49, 48, 48, 48, 48, 125, 39] : List Nat)
  , MkPair String (List Nat) "seven-hex-digits" ([39, 92, 117, 123, 48, 48, 48, 48, 48, 54, 49, 125, 39] : List Nat)
  ];

def character_invalid_escape_shape : List (Pair String (List Nat)) :=
  [ MkPair String (List Nat) "missing-brace" ([39, 92, 117, 54, 49, 39] : List Nat)
  , MkPair String (List Nat) "missing-close-brace" ([39, 92, 117, 123, 54, 49, 39] : List Nat)
  , MkPair String (List Nat) "non-hex" ([39, 92, 117, 123, 71, 125, 39] : List Nat)
  , MkPair String (List Nat) "escaped-multiple" ([39, 92, 117, 123, 54, 49, 125, 98, 39] : List Nat)
  , MkPair String (List Nat) "escaped-physical-newline" ([39, 92, 10, 39] : List Nat)
  ];

def character_valid_cases : List (Pair (List Nat) Nat) :=
  append (Pair (List Nat) Nat) character_valid_ascii
    (append (Pair (List Nat) Nat) character_valid_utf8_short
    (append (Pair (List Nat) Nat) character_valid_utf8_wide
    (append (Pair (List Nat) Nat) character_valid_simple_escapes
    (character_valid_unicode_escapes))));

def character_invalid_cases : List (Pair String (List Nat)) :=
  append (Pair String (List Nat)) character_invalid_shape
    (append (Pair String (List Nat)) character_invalid_utf8_short
    (append (Pair String (List Nat)) character_invalid_utf8_wide
    (append (Pair String (List Nat)) character_invalid_escapes
    (character_invalid_escape_shape))));
