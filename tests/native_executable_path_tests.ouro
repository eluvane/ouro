import "analyze/precision/assertions.ouro",
  "../std/executable_model.ouro";

def executable_test_length (expected : Nat) (actual : Either ExecutablePathError Nat) : Bool :=
    match actual with | Left _ => False | Right value => eq_nat expected value end;

def executable_test_error_kind (error : ExecutablePathError) : Nat :=
    match error with
    | ExecutablePathConstantsFailed => 0
    | ExecutablePathAllocationFailed => 1
    | ExecutablePathQueryFailed => 2
    | ExecutablePathTruncated => 3
    | ExecutablePathInvalidPath => 4
    | ExecutablePathConversionFailed => 5
    | ExecutablePathInvalidCount => 6
    | ExecutablePathCleanupFailed _ => 7
    end;

def executable_test_query_failed (result : Either ExecutablePathError Nat) : Bool :=
    match result with | Left error => eq_nat(executable_test_error_kind error, 2) | Right _ => False end;

def executable_test_truncated (result : Either ExecutablePathError Nat) : Bool :=
    match result with | Left error => eq_nat(executable_test_error_kind error, 3) | Right _ => False end;

def executable_test_count_failed (result : Either ExecutablePathError Nat) : Bool :=
    match result with | Left error => eq_nat(executable_test_error_kind error, 6) | Right _ => False end;

def executable_test_value (expected : String) (result : Either ExecutablePathError String) : Bool :=
    match result with | Left _ => False | Right value => prim_string_eq expected value end;

def executable_test_invalid (value : String) : Bool :=
    match executable_path_value value with
    | Left error => eq_nat(executable_test_error_kind error, 4)
    | Right _ => False end;

def executable_test_cleanup_empty (error : ExecutablePathError) : Bool :=
    match error with
    | ExecutablePathConstantsFailed => False
    | ExecutablePathAllocationFailed => False
    | ExecutablePathQueryFailed => False
    | ExecutablePathTruncated => False
    | ExecutablePathInvalidPath => False
    | ExecutablePathConversionFailed => False
    | ExecutablePathInvalidCount => False
    | ExecutablePathCleanupFailed previous => match previous with
      | Nothing => True
      | Just _ => False end
    end;

def executable_test_cleanup_conversion (error : ExecutablePathError) : Bool :=
    match error with
    | ExecutablePathConstantsFailed => False
    | ExecutablePathAllocationFailed => False
    | ExecutablePathQueryFailed => False
    | ExecutablePathTruncated => False
    | ExecutablePathInvalidPath => False
    | ExecutablePathConversionFailed => False
    | ExecutablePathInvalidCount => False
    | ExecutablePathCleanupFailed previous => match previous with
      | Nothing => False
      | Just cause => eq_nat(executable_test_error_kind cause, 5) end
    end;

def executable_test_cleanup_success : Bool :=
    match executable_path_released(Right ExecutablePathError String "C:\\bin\\coil.exe", False) with
    | Left error => executable_test_cleanup_empty error
    | Right _ => False end;

def executable_test_cleanup_error : Bool :=
    match executable_path_released(Left ExecutablePathError String ExecutablePathConversionFailed, False) with
    | Left error => executable_test_cleanup_conversion error
    | Right _ => False end;

def executable_test_keep_error : Bool :=
    match executable_path_released(Left ExecutablePathError String ExecutablePathQueryFailed, True) with
    | Left error => eq_nat(executable_test_error_kind error, 2)
    | Right _ => False end;

def executable_test_spelling : String := "\\\\?\\UNC\\server\\share with spaces\\Программа\\coil.exe";

def native_executable_path_tests : List (Pair String Bool) :=
    [ MkPair String Bool "executable/query-zero" (executable_test_query_failed (executable_path_query_length 0 8))
    , MkPair String Bool "executable/query-one" (executable_test_length(1, executable_path_query_length 1 8))
    , MkPair String Bool "executable/query-last-terminated" (executable_test_length(7, executable_path_query_length 7 8))
    , MkPair String Bool "executable/query-at-capacity" (executable_test_truncated (executable_path_query_length 8 8))
    , MkPair String Bool "executable/query-over-capacity" (executable_test_truncated (executable_path_query_length 9 8))
    , MkPair String Bool "executable/query-no-capacity" (executable_test_truncated (executable_path_query_length 1 0))
    , MkPair String Bool "executable/bytes-zero" (executable_test_count_failed (executable_path_byte_length 0 24))
    , MkPair String Bool "executable/bytes-full-capacity" (executable_test_length(24, executable_path_byte_length 24 24))
    , MkPair String Bool "executable/bytes-over-capacity" (executable_test_count_failed (executable_path_byte_length 25 24))
    , MkPair String Bool "executable/path-empty" (executable_test_invalid "")
    , MkPair String Bool "executable/path-interior-nul" (executable_test_invalid (str_of_codes ([67,58,92,65,0,66] : List Nat)))
    , MkPair String Bool "executable/preserve-loaded-spelling" (executable_test_value(executable_test_spelling, executable_path_value executable_test_spelling))
    , MkPair String Bool "executable/released-success" (executable_test_value executable_test_spelling
        (executable_path_released(Right ExecutablePathError String executable_test_spelling, True)))
    , MkPair String Bool "executable/released-error" executable_test_keep_error
    , MkPair String Bool "executable/cleanup-after-success" executable_test_cleanup_success
    , MkPair String Bool "executable/cleanup-retains-prior-error" executable_test_cleanup_error
    ];

def main : IO Unit := precision_run "native-executable-path" native_executable_path_tests;
