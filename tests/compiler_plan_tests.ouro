-- Index-family behavior uses the packed plan ABI in its own translation unit.

import "../std/test.ouro",
  "../compiler/pipeline_check.ouro",
  "../compiler/file_elab_core.ouro";

def plan_test_same_cores : List (Pair Nat CoreTerm) -> List (Pair Nat CoreTerm) -> Bool :=
  fix same (actual : List (Pair Nat CoreTerm)) (expected : List (Pair Nat CoreTerm)) : Bool :=
    match actual with
    | Nil => match expected with | Nil => True | Cons _ _ => False end
    | Cons actual_pair actual_rest => match expected with
        | Nil => False
        | Cons expected_pair expected_rest => match actual_pair with
            | MkPair actual_name actual_body => match expected_pair with
                | MkPair expected_name expected_body =>
                    andb (eqNat actual_name expected_name)
                      (andb (eqList(encode 64 actual_body, encode 64 expected_body))
                        (same actual_rest expected_rest))
                end
            end
        end
    end;

def plan_test_selected_cores : List (Pair Nat CoreTerm) :=
    [ MkPair Nat CoreTerm 9 (CApp(CConst 41, CStrLit 91 901))
    , MkPair Nat CoreTerm 3 (CLam(CSort 2, CRel 0))
    , MkPair Nat CoreTerm 9 (CApp(CConst 42, CStrLit 92 902))
    ];

def plan_test_mixed_cores : List (Pair Nat CoreTerm) :=
    Cons (Pair Nat CoreTerm) (MkPair Nat CoreTerm 70 (CSort 4))
      (append (Pair Nat CoreTerm) plan_test_selected_cores
        ([MkPair Nat CoreTerm 80 (CStrBytes([0, 255, 7] : List Nat, 903))]
          : List (Pair Nat CoreTerm)));

def plan_test_filter_cases : List Test :=
    [ assert_true "definition filter preserves core order, duplicates and complete bodies"
        (plan_test_same_cores
          (filter_definition_cores([3, 9, 3] : List Nat, plan_test_mixed_cores))
          plan_test_selected_cores)
    , assert_true "definition filter ignores absent names"
        (plan_test_same_cores
          (filter_definition_cores([500, 9, 3] : List Nat, plan_test_mixed_cores))
          plan_test_selected_cores)
    , assert_true "definition filter with no names selects no cores"
        (plan_test_same_cores(filter_definition_cores [] plan_test_mixed_cores, []))
    , assert_true "definition filter with no cores stays empty"
        (plan_test_same_cores(filter_definition_cores([3, 9] : List Nat, []), []))
    , assert_true "definition filter drops every unknown core"
        (plan_test_same_cores(filter_definition_cores([4, 5] : List Nat, plan_test_mixed_cores), []))
    , assert_true "definition filter preserves every selected core"
        (plan_test_same_cores
          (filter_definition_cores([80, 70, 9, 3] : List Nat, plan_test_mixed_cores))
          plan_test_mixed_cores)
    ];

def plan_test_indices : Bool :=
    match build_indices (CPi(CInd 10, CPi(CRel 0, CSort 2))) with
    | IndexBuildErr => False
    | IndexBuildOk indices level =>
      andb (eqNat level 2)
        (match indices with
        | Nil => False
        | Cons first rest =>
          match first with
          | CInd name =>
            andb (eqNat name 10)
              (match rest with
              | Nil => False
              | Cons second tail =>
                match second with
                | CRel index =>
                  andb (eqNat index 0)
                    (match tail with | Nil => True | Cons _ _ => False end)
                | CSort _ => False
                | CPi _ _ => False
                | CLam _ _ => False
                | CApp _ _ => False
                | CLetIn _ _ _ => False
                | CConst _ => False
                | CInd _ => False
                | CConstruct _ _ _ => False
                | CCase _ _ _ _ => False
                | CFix _ _ _ _ _ => False
                | CStrBytes _ _ => False
                | CStrLit _ _ => False
                end
              end)
          | CRel _ => False
          | CSort _ => False
          | CPi _ _ => False
          | CLam _ _ => False
          | CApp _ _ => False
          | CLetIn _ _ _ => False
          | CConst _ => False
          | CConstruct _ _ _ => False
          | CCase _ _ _ _ => False
          | CFix _ _ _ _ _ => False
          | CStrBytes _ _ => False
                | CStrLit _ _ => False
          end
        end)
    end;

def plan_test_reject_indices (family : CoreTerm) : Bool :=
    match build_indices family with
    | IndexBuildErr => True
    | IndexBuildOk _ _ => False
    end;

def plan_test_sort_family : Bool :=
    match build_indices (CSort 1) with
    | IndexBuildErr => False
    | IndexBuildOk indices level =>
      andb (eqNat level 1)
        (match indices with | Nil => True | Cons _ _ => False end)
    end;

def plan_test_families : List Test :=
    [ assert_true "index family preserves domains and universe" plan_test_indices
    , assert_true "sort-only family has no indices" plan_test_sort_family
    , assert_true "non-sort family is rejected"
        (plan_test_reject_indices (CInd 10))
    , assert_true "Pi family must end in a sort"
        (plan_test_reject_indices (CPi(CInd 10, CRel 0)))
    ];

-- @entry main
def main : IO Unit := test_run (append Test plan_test_families plan_test_filter_cases);
