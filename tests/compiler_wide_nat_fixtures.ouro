import "../std/prelude.ouro";

def compiler_test_wide_nat_base : Nat :=
    (fix grow (remaining : Nat) (value : Nat) : Nat :=
      match remaining with
      | Z => value
      | S rest => grow rest (add value value)
      end) 64 1;

def compiler_test_raw_successors : Nat -> Nat -> Nat :=
    fix build (remaining : Nat) (value : Nat) : Nat :=
      match remaining with | Z => value | S rest => build(rest, S value) end;
