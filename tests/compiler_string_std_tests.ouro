-- Original public String names keep their C-transition ASCII behavior.
import "../std/test.ouro";

def std_string_codes_exact (codes : List Nat) : Bool :=
    match codes with
    | Nil => False
    | Cons first rest => match rest with
        | Nil => False
        | Cons second tail => andb (eq_nat first 65)
            (andb(eq_nat second 66, nullb Nat tail))
        end
    end;

def StdText : Type := String;
def std_string_alias : StdText -> StdText -> StdText := prim_string_concat;

def std_string_laws : List Test :=
    [ assert_eq "intrinsic concat keeps the original public name" (prim_string_concat "ab" "cd") "abcd"
    , assert_true("intrinsic length returns checked Nat", eq_nat(prim_string_length "bytes", 5))
    , assert_true("intrinsic byte_at returns a byte", eq_nat(prim_string_byte_at "abc" 1, 98))
    , assert_eq "intrinsic slice keeps count semantics" (prim_string_slice "abcd" 1 2) "bc"
    , assert_true("intrinsic eq returns checked Bool", prim_string_eq "same" "same")
    , assert_true("intrinsic eq rejects different bytes", notb (prim_string_eq "ab" "ac"))
    , assert_eq "intrinsic of_nat returns decimal bytes" (prim_string_of_nat 120) "120"
    , assert_true "intrinsic to_char_codes returns checked List Nat"
        (std_string_codes_exact (prim_string_to_char_codes "AB"))
    , assert_eq "intrinsic of_char_codes consumes checked List Nat"
        (prim_string_of_char_codes ([65, 66] : List Nat)) "AB"
    , assert_true("intrinsic starts checks the prefix", prim_string_starts "alpha" "al")
    , assert_true("intrinsic ends checks the suffix", prim_string_ends "alpha" "ha")
    , assert_true("intrinsic contains checks inner bytes", prim_string_contains "alpha" "ph")
    , assert_true "intrinsic index returns checked Maybe Nat"
        (match prim_string_index "alpha" "ph" with
         | Nothing => False | Just value => eq_nat value 2 end)
    , assert_eq "intrinsic split preserves empty fields"
        (str_join(":", prim_string_split "a,,b," 44)) "a::b:"
    , assert_eq "intrinsic replace uses byte substrings"
        (prim_string_replace "aba" "a" "xy") "xybxy"
    , assert_true("intrinsic le compares byte order", prim_string_le "ab" "ac")
    , assert_eq "intrinsic tokens returns checked List String"
        (str_join(":", prim_string_tokens "  alpha beta  ")) "alpha:beta"
    , assert_eq "transparent String and operation aliases execute"
        (std_string_alias "typed-" "String") "typed-String"
    ];

-- @entry main
def main : IO Unit := test_run std_string_laws;
