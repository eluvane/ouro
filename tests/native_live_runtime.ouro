-- Typed MIR tests for compiler-produced root clearing. All allocation and
-- collection bodies come from the checked Ouro source program in parts.
import "native_managed_values.ouro";
import "../compiler/native/managed_source.ouro";

def live_runtime_from_parts (parts : ManagedProgramParts) : Either NativeSourceError NativeManagedRuntime :=
    match parts with | ManagedProgramOf checked _ program =>
      match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,99,111,108,108,101,99,116] with
      | Left err => Left NativeSourceError NativeManagedRuntime err | Right collector =>
      match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,97,108,108,111,99,97,116,101,95,114,97,119] with
      | Left err => Left NativeSourceError NativeManagedRuntime err | Right allocator =>
      match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,114,101,108,101,97,115,101,95,97,108,108] with
      | Left err => Left NativeSourceError NativeManagedRuntime err | Right release =>
      match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,105,110,115,112,101,99,116,95,114,111,111,116,115] with
      | Left err => Left NativeSourceError NativeManagedRuntime err | Right inspect =>
      match managed_fixture_symbol checked [119,105,110,100,111,119,115,95,101,120,105,116,95,112,114,111,99,101,115,115] with
      | Left err => Left NativeSourceError NativeManagedRuntime err | Right exit =>
        Right NativeSourceError NativeManagedRuntime (NativeManagedRuntimeOf program allocator release inspect exit
          (S (foldr Nat Nat maxNat 0 (mir_global_ids program))) collector) end end end end end end;

def live_runtime_locals : List MirLocal := [
    MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr,
    MirLocalDef 4 MirManagedPtr, MirLocalDef 5 MirManagedPtr,
    MirLocalDef 20 MirRawPtr, MirLocalDef 21 MirRawPtr, MirLocalDef 22 MirRawPtr, MirLocalDef 23 MirRawPtr,
    MirLocalDef 30 MirU32, MirLocalDef 31 MirU8, MirLocalDef 32 MirU64, MirLocalDef 33 MirU32, MirLocalDef 34 MirU8];

def live_runtime_collect (collector : Nat) : List MirInstruction :=
    append MirInstruction [MirCall MirMayGc (Just Nat 34) (MirDirect collector) [MirUse 20]]
      (managed_fixture_assert (MirUse 34) (managed_fixture_word MirU8 1));

-- Test-only raw observer. Partial collections must remove the exact busy
-- HeapWalk block while another allocation keeps the private heap alive.
-- An empty heap has been destroyed, so VirtualQuery must report MEM_FREE.
def live_runtime_heap_observer (base : Nat) : MirFunction :=
    MirFunctionDef (add base 201) [108,105,118,101,95,104,101,97,112]
      [MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirRawPtr, MirLocalDef 2 MirRawPtr]
      (append MirLocal [MirLocalDef 3 MirRawPtr, MirLocalDef 4 MirUSize,
        MirLocalDef 5 MirUSize, MirLocalDef 6 MirU32, MirLocalDef 7 MirU32,
        MirLocalDef 8 MirU32, MirLocalDef 9 MirU8, MirLocalDef 10 MirU8,
        MirLocalDef 11 MirU8, MirLocalDef 12 MirU8, MirLocalDef 13 MirRawPtr]
        managed_fixture_assert_locals) (Just MirType MirU8) 0 [
      MirBlockDef 0 [MirMove 901 (managed_fixture_word MirU8 1),
        MirLoad 4 (MirUse 0) (codegen_disp 32),
        MirBinaryOp 4 MirMul (MirUse 4) (managed_fixture_word MirUSize 16),
        MirBinaryOp 4 MirAdd (MirUse 4) (managed_fixture_word MirUSize 48),
        MirPointerAdd 3 (MirUse 0) (MirUse 4), MirLoad 3 (MirUse 3) (codegen_disp 0),
        MirCompare 10 MirEqual (MirUse 3) (managed_fixture_word MirRawPtr 0)]
        (MirBranch (MirUse 10) 1 2),
      MirBlockDef 1 (managed_fixture_join [
        managed_fixture_stat 0 0 0, managed_fixture_stat 0 16 0, managed_fixture_stat 0 24 0,
        [MirCall MirNoGc (Just Nat 5) (MirDirect (add base 200))
          [MirUse 1, MirUse 2, managed_fixture_word MirUSize 48]],
        managed_fixture_assert (MirUse 5) (managed_fixture_word MirUSize 48),
        [MirLoad 8 (MirUse 2) (codegen_disp 32)],
        managed_fixture_assert (MirUse 8) (managed_fixture_word MirU32 pe_byte2_place)])
        (MirReturn (Just MirValue (MirUse 901))),
      MirBlockDef 2 [MirCall MirNoGc (Just Nat 6) (MirDirect (add base 204)) [MirUse 3],
        MirCompare 10 MirNotEqual (MirUse 6) (managed_fixture_word MirU32 0)]
        (MirBranch (MirUse 10) 3 7),
      MirBlockDef 3 [MirStore (MirUse 2) (codegen_disp 0) (managed_fixture_word MirRawPtr 0),
        MirMove 9 (managed_fixture_word MirU8 0)] (MirJump 4),
      MirBlockDef 4 [MirCall MirNoGc (Just Nat 6) (MirDirect (add base 202)) [MirUse 3, MirUse 2],
        MirCompare 10 MirNotEqual (MirUse 6) (managed_fixture_word MirU32 0)]
        (MirBranch (MirUse 10) 5 6),
      MirBlockDef 5 [MirLoad 13 (MirUse 2) (codegen_disp 0),
        MirCompare 11 MirEqual (MirUse 13) (MirUse 1),
        MirLoad 8 (MirUse 2) (codegen_disp 12),
        MirBinaryOp 8 MirAnd (MirUse 8) (managed_fixture_word MirU32 (mul 4 pe_byte2_place)),
        MirCompare 12 MirNotEqual (MirUse 8) (managed_fixture_word MirU32 0),
        MirBinaryOp 11 MirAnd (MirUse 11) (MirUse 12),
        MirBinaryOp 9 MirOr (MirUse 9) (MirUse 11)] (MirJump 4),
      MirBlockDef 6 [MirCall MirNoGc (Just Nat 7) (MirDirect (add base 203)) [],
        MirCall MirNoGc (Just Nat 6) (MirDirect (add base 205)) [MirUse 3],
        MirCompare 10 MirEqual (MirUse 7) (managed_fixture_word MirU32 259),
        MirCompare 11 MirNotEqual (MirUse 6) (managed_fixture_word MirU32 0),
        MirBinaryOp 10 MirAnd (MirUse 10) (MirUse 11),
        MirCompare 11 MirEqual (MirUse 9) (managed_fixture_word MirU8 0),
        MirBinaryOp 10 MirAnd (MirUse 10) (MirUse 11)] (MirReturn (Just MirValue (MirUse 10))),
      MirBlockDef 7 [] (MirReturn (Just MirValue (managed_fixture_word MirU8 0)))];

def live_runtime_free (base : Nat) (address : Nat) : List MirInstruction :=
    append MirInstruction [MirCall MirNoGc (Just Nat 34) (MirDirect (add base 201))
      [MirUse 20, MirUse address, MirUse 21]]
      (managed_fixture_assert (MirUse 34) (managed_fixture_word MirU8 1));

def live_runtime_finish (runtime : NativeManagedRuntime) (functions : List MirFunction) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ _ _ _ _ base _ =>
      match managed_fixture_finish runtime (Cons MirFunction (live_runtime_heap_observer base) functions)
        (append MirData (managed_value_descriptors base) [MirDataDef (add base 105) True (pe_zeros 64)]) with
      | MirProgramDef bodies objects libraries entry =>
        MirProgramDef bodies objects (foldl MirExtern (List MirLibrary)
          (fun (current : List MirLibrary) (declaration : MirExtern) =>
            lower_add_import lower_kernel_library declaration current) libraries [
          MirExternDef MirNoGc (add base 200) [86,105,114,116,117,97,108,81,117,101,114,121]
            (MirSignatureOf [MirRawPtr,MirRawPtr,MirUSize] (Just MirType MirUSize)),
          MirExternDef MirNoGc (add base 202) [72,101,97,112,87,97,108,107]
            (MirSignatureOf [MirRawPtr,MirRawPtr] (Just MirType MirU32)),
          MirExternDef MirNoGc (add base 203) [71,101,116,76,97,115,116,69,114,114,111,114]
            (MirSignatureOf [] (Just MirType MirU32)),
          MirExternDef MirNoGc (add base 204) [72,101,97,112,76,111,99,107]
            (MirSignatureOf [MirRawPtr] (Just MirType MirU32)),
          MirExternDef MirNoGc (add base 205) [72,101,97,112,85,110,108,111,99,107]
            (MirSignatureOf [MirRawPtr] (Just MirType MirU32))]) entry end end;

def live_runtime_start (base : Nat) : List MirInstruction :=
    [MirManagedContext 20, MirAddress 21 (add base 105)];

def live_runtime_read (local : Nat) : List MirInstruction :=
    append MirInstruction [MirLoad 32 (MirUse local) (codegen_disp 32)]
      (managed_fixture_assert (MirUse 32) (managed_fixture_word MirU64 42));

def live_runtime_reclaim (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      live_runtime_finish runtime [managed_fixture_body (S base) live_runtime_locals
        (managed_fixture_join [
          live_runtime_start base,
          managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
          [MirLoad 22 (MirUse 20) (codegen_disp 0)],
          live_runtime_collect collector, managed_fixture_stat 20 16 0, live_runtime_free base 22,
          managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 99),
          managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
          managed_fixture_stat 20 16 1, live_runtime_read 1,
          live_runtime_collect collector, managed_fixture_stat 20 16 0,
          managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
          [MirMove 2 (MirUse 1), MirLoad 22 (MirUse 20) (codegen_disp 0)],
          managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 7),
          live_runtime_collect collector, managed_fixture_stat 20 16 1, live_runtime_read 2,
          live_runtime_collect collector, managed_fixture_stat 20 16 0, live_runtime_free base 22,
          managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
          [MirLoad 22 (MirUse 20) (codegen_disp 0)],
          managed_value_env 2 allocator collector (add base 102) [MirUse 1],
          managed_value_box 4 allocator collector (add base 100) (managed_fixture_word MirU64 7),
          live_runtime_collect collector, managed_fixture_stat 20 16 2, managed_fixture_stat 20 24 88,
          [MirLoad 3 (MirUse 2) (codegen_disp 40)], live_runtime_read 3,
          live_runtime_collect collector, managed_fixture_stat 20 16 0, live_runtime_free base 22])
        (managed_fixture_word MirU32 42)] end;

def live_runtime_child (runtime : NativeManagedRuntime) : MirFunction :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ exit base collector =>
      MirFunctionDef (add base 2) [108,105,118,101,95,99,104,105,108,100] [MirLocalDef 0 MirManagedPtr]
        (append MirLocal live_runtime_locals managed_fixture_assert_locals) (Just MirType MirManagedPtr) 0
        [MirBlockDef 0 (managed_fixture_join [
            [MirMove 901 (managed_fixture_word MirU8 1)], live_runtime_start base,
            managed_value_box 2 allocator collector (add base 100) (managed_fixture_word MirU64 7),
            managed_fixture_stat 20 16 2, live_runtime_read 0,
            live_runtime_collect collector, managed_fixture_stat 20 16 1]) (MirBranch (MirUse 901) 1 2),
          MirBlockDef 1 [] (MirReturn (Just MirValue (MirUse 0))),
          MirBlockDef 2 [MirCall MirNoGc (Nothing Nat) (MirDirect exit) [managed_fixture_word MirU32 77]] MirTrap] end;

def live_runtime_calls (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      live_runtime_finish runtime [managed_fixture_body (S base) live_runtime_locals
        (managed_fixture_join [
          live_runtime_start base,
          managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
          [MirLoad 22 (MirUse 20) (codegen_disp 0),
            MirCall MirMayGc (Just Nat 1) (MirDirect (add base 2)) [MirUse 1],
            MirAddress 23 (add base 2), MirCall MirMayGc (Just Nat 1)
              (MirIndirect (MirSignatureOf [MirManagedPtr] (Just MirType MirManagedPtr)) (MirUse 23)) [MirUse 1]],
          live_runtime_read 1,
          live_runtime_collect collector, managed_fixture_stat 20 16 0, live_runtime_free base 22])
        (managed_fixture_word MirU32 42), live_runtime_child runtime] end;

def live_runtime_loop (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      live_runtime_finish runtime [MirFunctionDef (S base) [108,105,118,101,95,108,111,111,112] []
        (append MirLocal live_runtime_locals managed_fixture_assert_locals) (Just MirType MirU32) 0
        [MirBlockDef 0 (managed_fixture_join [
            [MirMove 901 (managed_fixture_word MirU8 1)], live_runtime_start base,
            managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
            [MirLoad 22 (MirUse 20) (codegen_disp 0), MirMove 30 (managed_fixture_word MirU32 0)]]) (MirJump 1),
          MirBlockDef 1 (managed_fixture_join [
            managed_value_box 2 allocator collector (add base 100) (managed_fixture_word MirU64 7),
            managed_fixture_stat 20 16 2, live_runtime_read 1,
            [MirBinaryOp 30 MirAdd (MirUse 30) (managed_fixture_word MirU32 1),
              MirCompare 31 MirLess (MirUse 30) (managed_fixture_word MirU32 1000)]]) (MirBranch (MirUse 31) 1 2),
          MirBlockDef 2 (managed_fixture_join [live_runtime_collect collector,
            managed_fixture_stat 20 16 0, live_runtime_free base 22]) (MirBranch (MirUse 901) 3 4),
          MirBlockDef 3 [] (MirReturn (Just MirValue (managed_fixture_word MirU32 42))),
          MirBlockDef 4 [] (MirReturn (Just MirValue (managed_fixture_word MirU32 99)))]] end;

def live_runtime_branch (runtime : NativeManagedRuntime) (choice : Nat) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      live_runtime_finish runtime [MirFunctionDef (S base) [108,105,118,101,95,98,114,97,110,99,104] []
        (append MirLocal live_runtime_locals managed_fixture_assert_locals) (Just MirType MirU32) 0
        [MirBlockDef 0 (managed_fixture_join [
            [MirMove 901 (managed_fixture_word MirU8 1)], live_runtime_start base,
            managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
            [MirLoad 22 (MirUse 20) (codegen_disp 0)],
            managed_value_box 2 allocator collector (add base 100) (managed_fixture_word MirU64 42),
            [MirLoad 23 (MirUse 20) (codegen_disp 0), MirMove 31 (managed_fixture_word MirU8 choice)]])
            (MirBranch (MirUse 31) 1 2),
          MirBlockDef 1 (managed_fixture_join [live_runtime_collect collector,
            managed_fixture_stat 20 16 1, live_runtime_free base 23, live_runtime_read 1,
            [MirConvert 33 MirNarrow (MirUse 32)]]) (MirJump 3),
          MirBlockDef 2 (managed_fixture_join [live_runtime_collect collector,
            managed_fixture_stat 20 16 1, live_runtime_free base 22, live_runtime_read 2,
            [MirConvert 33 MirNarrow (MirUse 32)]]) (MirJump 3),
          MirBlockDef 3 (managed_fixture_join [live_runtime_collect collector,
            managed_fixture_stat 20 16 0, live_runtime_free base 22, live_runtime_free base 23]) (MirBranch (MirUse 901) 4 5),
          MirBlockDef 4 [] (MirReturn (Just MirValue (MirUse 33))),
          MirBlockDef 5 [] (MirReturn (Just MirValue (managed_fixture_word MirU32 99)))]] end;

def live_runtime_named (name : List Nat) (runtime : NativeManagedRuntime) : Maybe MirProgram :=
    match pe_bytes_equal name [114,101,99,108,97,105,109] with | True => Just MirProgram (live_runtime_reclaim runtime)
    | False => match pe_bytes_equal name [99,97,108,108,115] with | True => Just MirProgram (live_runtime_calls runtime)
    | False => match pe_bytes_equal name [108,111,111,112] with | True => Just MirProgram (live_runtime_loop runtime)
    | False => match pe_bytes_equal name [98,114,97,110,99,104,95,116,114,117,101] with
      | True => Just MirProgram (live_runtime_branch runtime 1)
    | False => match pe_bytes_equal name [98,114,97,110,99,104,95,102,97,108,115,101] with
      | True => Just MirProgram (live_runtime_branch runtime 0) | False => Nothing MirProgram end end end end end;

def live_runtime_program (name : List Nat) (parts : ManagedProgramParts) : Either NativeSourceError MirProgram :=
    match live_runtime_from_parts parts with
    | Left err => Left NativeSourceError MirProgram err
    | Right runtime => match live_runtime_named name runtime with
      | Nothing => Left NativeSourceError MirProgram (NativeSourceLowerError (LowerInvalidEntry 0))
      | Just program => Right NativeSourceError MirProgram program end end;
