-- Runtime equality complements the two wide, compiler-checked inline ErgEq laws.
import "../std/io.ouro",
  "../std/natx.ouro",
  "../std/format.ouro";

def character_runtime_four_byte_candidate : Nat := '😀';
def character_runtime_four_byte_reference : Nat := 128512;
def character_runtime_maximum_candidate : Nat := '\u{10FFFF}';
def character_runtime_maximum_reference : Nat := 1114111;

def character_runtime_check (unequal : Bool) : IO Unit :=
    let four_byte_reference : Nat := match unequal with
      | True => S character_runtime_four_byte_reference
      | False => character_runtime_four_byte_reference
      end in
    match andb(eq_nat character_runtime_four_byte_candidate four_byte_reference,
      eq_nat character_runtime_maximum_candidate character_runtime_maximum_reference) with
    | True => (do println (show_nat character_runtime_four_byte_candidate);
                  println (show_nat character_runtime_maximum_candidate);
                  exit 0)
    | False => exit 1
    end;

def character_runtime_arguments (arguments : List String) : IO Unit :=
    match arguments with
    | Nil => exit 2
    | Cons _ rest => match rest with
      | Nil => character_runtime_check False
      | Cons mode tail => match tail with
        | Nil => match prim_string_eq mode "--unequal" with
          | True => character_runtime_check True
          | False => exit 2
          end
        | Cons _ _ => exit 2
        end
      end
    end;

-- @entry main
def main : IO Unit := (do let! arguments := argv;
                         character_runtime_arguments arguments);
