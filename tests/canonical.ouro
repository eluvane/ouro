-- Focused Ouro-native smoke checks for the canonical source model.
-- Run with: sh scripts/ouro1.sh check tests/canonical.ouro
-- @entry canonical_smoke_all

import "../std/data.ouro";
import "../std/listx.ouro";
import "../compiler/canonical_model.ouro";
import "../compiler/canonical_source.ouro";
import "../compiler/canonical_hash.ouro";
import "../compiler/token.ouro";
import "../compiler/lexer.ouro";
import "../compiler/parser_min.ouro";
import "character_literal_cases.ouro";

def ct_eq_nat_list : List Nat -> List Nat -> Bool :=
  fix go (a : List Nat) (b : List Nat) : Bool :=
    match a with
    | Nil =>
        match b with
        | Nil => True
        | Cons _ _ => False
        end
    | Cons x xs =>
        match b with
        | Nil => False
        | Cons y ys =>
            match eqNat x y with
            | True => go xs ys
            | False => False
            end
        end
    end;

def ct_idents : List (Pair (List Nat) Nat) :=
  Cons (Pair (List Nat) Nat)
    (MkPair (List Nat) Nat [120] (S Z))
    (Nil (Pair (List Nat) Nat));

def ct_strings_empty : List (Pair (List Nat) Nat) :=
  Nil (Pair (List Nat) Nat);

def ct_string_table : List (Pair (List Nat) Nat) :=
  Cons (Pair (List Nat) Nat)
    (MkPair (List Nat) Nat [45, 45, 32, 120] Z)
    (Nil (Pair (List Nat) Nat));

def ct_decl_tokens : List Token :=
  [ TKeyword kwDef, TIdent (S Z), TColon, TType Z, TColonEq, TNat (S Z), TEof ];

def ct_source_with_trivia : List Nat :=
  [ 45, 45, 32, 105, 103, 110, 111, 114, 101, 10
  , 100, 101, 102, 32, 32, 32, 120, 32, 58, 32
  , 84, 121, 112, 101, 32, 58, 61, 32, 49
  ];

def ct_decl_unit : CanonicalSourceUnit :=
  canonical_from_lexed ct_source_with_trivia ct_decl_tokens;

def ct_expected_compact : List Nat :=
  [100, 101, 102, 32, 120, 58, 84, 121, 112, 101, 58, 61, 49];

def canonical_test_compact_bytes : Bool :=
  match canonical_bytes_from ct_idents ct_strings_empty ct_decl_unit with
  | CanonicalBytesErr _ _ => False
  | CanonicalBytesOk bytes => ct_eq_nat_list bytes ct_expected_compact
  end;

def ct_boundary_tokens : List Token :=
  [TIdent (S Z), TNat (S (S Z)), TEof];

def ct_boundary_unit : CanonicalSourceUnit :=
  canonical_from_lexed [120, 32, 50] ct_boundary_tokens;

def canonical_test_token_boundary : Bool :=
  match canonical_bytes_from ct_idents ct_strings_empty ct_boundary_unit with
  | CanonicalBytesErr _ _ => False
  | CanonicalBytesOk bytes => ct_eq_nat_list bytes [120, 32, 50]
  end;

def ct_string_unit : CanonicalSourceUnit :=
  canonical_from_lexed [34, 45, 45, 32, 120, 34] [TString Z, TEof];

def canonical_test_string_preservation : Bool :=
  match canonical_bytes_from ct_idents ct_string_table ct_string_unit with
  | CanonicalBytesErr _ _ => False
  | CanonicalBytesOk bytes => ct_eq_nat_list bytes [34, 45, 45, 32, 120, 34]
  end;

def ct_byte_values : List Nat := [65, 0, 255, 34, 92];

def ct_byte_unit : CanonicalSourceUnit :=
  canonical_from_lexed
    (prim_string_to_char_codes "b\"A\\x00\\xFF\\x22\\x5C\"")
    [TByteString ct_byte_values, TEof];

def canonical_test_byte_roundtrip : Bool :=
  match canonical_bytes_from ct_idents ct_strings_empty ct_byte_unit with
  | CanonicalBytesErr _ _ => False
  | CanonicalBytesOk codes =>
      andb (ct_eq_nat_list codes
          (prim_string_to_char_codes "b\"A\\x00\\xFF\\x22\\x5C\""))
        (match next_token (add(length Nat codes, 8)) codes empty_intern with
         | StepEof _ => False
         | LexStepErr _ => False
         | StepTok token tail _ => match token with
           | TByteString bytes => andb(ct_eq_nat_list bytes ct_byte_values,
               ct_eq_nat_list tail [])
           | TIdent _ => False
           | TNat _ => False
           | TKeyword _ => False
           | TType _ => False
           | TColon => False
           | TColonEq => False
           | TArrow => False
           | TFatArrow => False
           | TBar => False
           | TLparen => False
           | TRparen => False
           | TSemi => False
           | THole _ => False
           | TString _ => False
           | TComma => False
           | TBraceL => False
           | TBraceR => False
           | TExclam => False
           | TEof => False
           | TBind => False
           | TPipe => False
           | TBracketL => False
           | TBracketR => False
           | TDotDot => False
           | TDotDotEq => False
           | TCoalesce => False
           end
         end)
  end;

def canonical_test_byte_out_of_range : Bool :=
  match cs_byte_codes [256] with
  | CanonicalBytesErr code byte => andb(eqNat code cs_err_byte, eqNat byte 256)
  | CanonicalBytesOk _ => False
  end;

def ct_directive_source : List Nat :=
  [ 45, 45, 32, 64, 101, 110, 116, 114, 121, 32, 120
  , 10, 34, 45, 45, 34, 10, 45, 45, 32, 110, 111, 114, 109, 97, 108
  ];

def ct_directive_unit : CanonicalSourceUnit :=
  canonical_from_lexed ct_directive_source [TEof];

def canonical_test_directive_preserved : Bool :=
  eqNat (canonical_directive_count ct_directive_unit) (S Z);

def canonical_test_multiline_directive_masked : Bool :=
  let source : List Nat := prim_string_to_char_codes
    "def s : String := \"\"\"\n  -- @entry hidden\n  \"\"\";\n-- @entry real" in
  eqNat (canonical_directive_count (canonical_from_lexed source [TEof])) (S Z);

def canonical_test_multiline_roundtrip : Bool :=
  let source : List Nat := prim_string_to_char_codes
    "\"\"\"\n  A\n  B\n  \"\"\"" in
  let value : List Nat := [65, 10, 66] in
  match lex_all (S (length Nat source)) source with
  | LexMalformed _ => False
  | LexExhausted _ => False
  | LexOk tokens st =>
      let strings : List (Pair (List Nat) Nat) :=
        match st with | MkIntern _ _ entries _ => entries end in
      match canonical_bytes_from (unit_intern_ids st) strings
          (canonical_from_lexed source tokens) with
      | CanonicalBytesErr _ _ => False
      | CanonicalBytesOk bytes =>
          andb (ct_eq_nat_list bytes [34, 65, 92, 110, 66, 34])
            (match lex_all (S (length Nat bytes)) bytes with
             | LexMalformed _ => False
             | LexExhausted _ => False
             | LexOk roundtrip roundtrip_st => match roundtrip with
               | Cons token _ => match tokenIsString token with
                 | Nothing => False
                 | Just id => match roundtrip_st with
                   | MkIntern _ _ entries _ => match cs_lookup_id entries id with
                     | Nothing => False
                     | Just decoded => ct_eq_nat_list decoded value
                     end
                   end
                 end
               | Nil => False
               end
             end)
      end
  end;

def canonical_test_mapping_identity : Bool :=
  eqNat (canonical_original_position ct_decl_unit (S Z)) (S Z);

def canonical_test_deterministic_hash : Bool :=
  match canonical_semantic_hash_from ct_idents ct_strings_empty ct_decl_unit with
  | CanonicalHashErr _ _ => False
  | CanonicalHashOk h1 =>
      match canonical_semantic_hash_from ct_idents ct_strings_empty ct_decl_unit with
      | CanonicalHashErr _ _ => False
      | CanonicalHashOk h2 => canonical_hash_eq h1 h2
      end
  end;

def canonical_test_removed_bytes : Bool :=
  match canonical_removed_bytes_from ct_idents ct_strings_empty ct_decl_unit with
  | Nothing => False
  | Just removed => eqNat removed 16
  end;

def canonical_test_character (row : Pair (List Nat) Nat) : Bool :=
  match row with
  | MkPair source expected => match lex_all 64 source with
    | LexMalformed _ => False
    | LexExhausted _ => False
    | LexOk tokens st => match st with
      | MkIntern ids _ strings _ =>
          match canonical_bytes_from ids strings (canonical_from_lexed source tokens) with
          | CanonicalBytesErr _ _ => False
          | CanonicalBytesOk bytes =>
              ct_eq_nat_list bytes (prim_string_to_char_codes (prim_string_of_nat expected))
          end
      end
    end
  end;

def canonical_test_character_directives : Bool :=
  eqNat (canonical_directive_count
    (canonical_from_lexed
      (append Nat ([39, 34, 39, 10] : List Nat)
        (prim_string_to_char_codes "-- @entry main\n")) ([] : List Token))) 1;

def ct_intern_entries_equal : List (Pair (List Nat) Nat) -> List (Pair (List Nat) Nat) -> Bool :=
  fix compare (left : List (Pair (List Nat) Nat)) (right : List (Pair (List Nat) Nat)) : Bool :=
    match left with
    | Nil => match right with | Nil => True | Cons _ _ => False end
    | Cons pair rest => match right with
      | Nil => False
      | Cons other tail => match pair with | MkPair key id => match other with
        | MkPair other_key other_id => andb(source_bytes_equal key other_key,
            andb(eqNat id other_id, compare rest tail))
        end end
      end
    end;

def ct_intern_equal (left : InternState) (right : InternState) : Bool :=
  match left with | MkIntern ids next_id strings next_string => match right with
    | MkIntern other_ids other_id other_strings other_string =>
        andb(eqNat next_id other_id, andb(eqNat next_string other_string,
          andb(ct_intern_entries_equal ids other_ids, ct_intern_entries_equal strings other_strings)))
    end
  end;

def ct_lex_equal (left : LexResult) (right : LexResult) : Bool :=
  match left with
  | LexMalformed state => match right with
    | LexMalformed other => ct_intern_equal state other
    | LexExhausted _ => False
    | LexOk _ _ => False
    end
  | LexExhausted state => match right with
    | LexExhausted other => ct_intern_equal state other
    | LexMalformed _ => False
    | LexOk _ _ => False
    end
  | LexOk tokens state => match right with
    | LexMalformed _ => False
    | LexExhausted _ => False
    | LexOk other_tokens other =>
        andb(ct_intern_equal state other,
          match state with | MkIntern ids _ strings _ =>
            match canonical_bytes_from ids strings (canonical_from_lexed [] tokens) with
            | CanonicalBytesErr _ _ => False
            | CanonicalBytesOk bytes =>
                match canonical_bytes_from ids strings (canonical_from_lexed [] other_tokens) with
                | CanonicalBytesErr _ _ => False
                | CanonicalBytesOk other_bytes => source_bytes_equal bytes other_bytes
                end
            end
          end)
    end
  end;

def ct_intern_initial : InternState :=
  MkIntern
    ([MkPair(List Nat, Nat, prim_string_to_char_codes "alpha", 7),
      MkPair(List Nat, Nat, prim_string_to_char_codes "alpha", 99),
      MkPair(List Nat, Nat, prim_string_to_char_codes "beta", 42)] : List (Pair (List Nat) Nat)) 100
    ([MkPair(List Nat, Nat, prim_string_to_char_codes "text", 3),
      MkPair(List Nat, Nat, prim_string_to_char_codes "text", 9)] : List (Pair (List Nat) Nat)) 10;

def ct_indexed_parity (fuel : Nat) (source : String) : Bool :=
  let codes : List Nat := prim_string_to_char_codes source in
  let acc : List Token := [TString 3, TIdent 7] in
  andb (ct_lex_equal (lex_go_with next_token fuel codes ct_intern_initial acc)
      (lex_go fuel codes ct_intern_initial acc))
    (ct_lex_equal (lex_go_with next_import_token fuel codes ct_intern_initial acc)
      (lex_go_import fuel codes ct_intern_initial acc));

def canonical_test_intern_parity : Bool :=
  all Nat (fun (fuel : Nat) => all String (ct_indexed_parity fuel)
    (["", "alpha beta gamma ?alpha ?gamma ?? \"text\" \"fresh\"",
      "def gamma : Type := alpha; [1, 2] |> beta",
      "r#\"text\"# b\"A\\x00\" '\\u{1F600}'",
      "\"\"\"\n  text\n  \"\"\"", "alpha @", "\"unterminated",
      "r#\"unterminated", "1_", "?alpha @"] : List String))
    ([0, 1, 2, 3, 8, 32, 256] : List Nat);

def canonical_test_intern_incremental : Bool :=
  let first : List Nat := prim_string_to_char_codes "gamma alpha \"fresh\" \"text\"" in
  match lex_go_with next_import_token 256 first ct_intern_initial [] with
  | LexMalformed _ => False
  | LexExhausted _ => False
  | LexOk _ state => match lex_go_import 256 first ct_intern_initial [] with
    | LexMalformed _ => False
    | LexExhausted _ => False
    | LexOk _ indexed =>
        let second : List Nat := prim_string_to_char_codes "delta gamma ?alpha \"fresh\" \"later\"" in
        andb(ct_intern_equal state indexed,
          ct_lex_equal (lex_go_with next_import_token 256 second state [])
            (lex_go_import 256 second indexed []))
    end
  end;

def ct_index_lookup_equal (table : List (Pair (List Nat) Nat)) (index : SourceNameIndex)
    (key : List Nat) : Bool :=
  match source_lookup_id table key with
  | Nothing => match source_name_index_lookup key index with | Nothing => True | Just _ => False end
  | Just id => match source_name_index_lookup key index with | Nothing => False | Just other => eqNat id other end
  end;

def canonical_test_intern_lookup : Bool :=
  let table : List (Pair (List Nat) Nat) :=
    [MkPair(List Nat, Nat, [], 5), MkPair(List Nat, Nat, [120], 7),
      MkPair(List Nat, Nat, [120, 0], 9), MkPair(List Nat, Nat, [120], 99),
      MkPair(List Nat, Nat, [0, 255], 2), MkPair(List Nat, Nat, [256], 0)] in
  let index : SourceNameIndex := source_name_index_from table in
  all (List Nat) (ct_index_lookup_equal table index)
    ([[], [120], [120, 0], [0, 255], [256], [0], [120, 0, 1], [255]] : List (List Nat));

def ct_intern_scale_table (size : Nat) : List (Pair (List Nat) Nat) :=
  (fix build (left : Nat) (rows : List (Pair (List Nat) Nat)) : List (Pair (List Nat) Nat) :=
    match left with
    | Z => rows
    | S remaining => build remaining
        (Cons (Pair (List Nat) Nat) (MkPair (List Nat) Nat
          (append Nat (prim_string_to_char_codes "shared_")
            (prim_string_to_char_codes (prim_string_of_nat remaining))) remaining) rows)
    end) size [];

def canonical_test_intern_scale : Bool :=
  let table : List (Pair (List Nat) Nat) := ct_intern_scale_table 512 in
  let index : SourceNameIndex := source_name_index_from table in
  let later : List Nat := prim_string_to_char_codes "later" in
  let extended : SourceNameIndex := source_name_index_insert later 512 index in
  andb (leb_nat (source_name_index_height index) 12)
    (andb (ct_index_lookup_equal table index later)
      (andb (match source_name_index_lookup later extended with | Nothing => False | Just id => eqNat id 512 end)
        (all (Pair (List Nat) Nat) (fun (pair : Pair (List Nat) Nat) => match pair with
          | MkPair key id => andb (ct_index_lookup_equal table index key)
              (match source_name_index_lookup key extended with | Nothing => False | Just other => eqNat id other end)
          end) table)));

def canonical_test_intern_all : Bool :=
  andb canonical_test_intern_lookup (andb canonical_test_intern_parity
    (andb canonical_test_intern_incremental canonical_test_intern_scale));

def canonical_smoke_all : Bool :=
  andb canonical_test_compact_bytes
    (andb canonical_test_token_boundary
      (andb canonical_test_string_preservation
        (andb canonical_test_directive_preserved
          (andb canonical_test_multiline_directive_masked
            (andb canonical_test_multiline_roundtrip
              (andb canonical_test_byte_roundtrip
                (andb canonical_test_byte_out_of_range
              (andb canonical_test_mapping_identity
                (andb canonical_test_deterministic_hash (andb canonical_test_removed_bytes
                  (andb canonical_test_character_directives
                    (andb canonical_test_intern_all
                      (all (Pair (List Nat) Nat) canonical_test_character character_valid_cases)))))))))))));
