import "../compiler/native/mir_flow.ouro",
  "../std/test.ouro",
  "../std/collections.ouro";

private def quality_mir_wide_id : Nat := add (pow_nat 2 64) 1;

private def quality_mir_reference_predecessors (target : Nat) (facts : List MirBlockFact)
    (blocks : List MirBlock) (locals : List Nat) : Either MirError (List Nat) :=
    (fix scan (pending : List MirBlock) (common : Maybe (List Nat)) : Either MirError (List Nat) :=
      match pending with | Nil => Right MirError (List Nat)
        (match common with | Nothing => locals | Just values => values end)
      | Cons block rest => match mir_has(target, mir_successors block) with
        | False => scan rest common
        | True => match mir_fact_at(mir_block_id block, facts) with
          | Left err => Left MirError (List Nat) err
          | Right incoming => let outgoing : List Nat := mir_union(mir_generated block, incoming) in
              scan rest (Just (List Nat) (match common with | Nothing => outgoing
                | Just values => mir_intersection values outgoing end)) end end end)
      blocks (Nothing (List Nat));

private def quality_mir_flow_error_key (error : MirError) : Maybe (Pair Nat Nat) :=
    match error with
    | MirResourceExhausted => Just (Pair Nat Nat) (MkPair Nat Nat 0 0)
    | MirUnknownBlock id => Just (Pair Nat Nat) (MkPair Nat Nat 1 id)
    | MirDuplicateSymbol _ => Nothing (Pair Nat Nat) | MirUnknownSymbol _ => Nothing (Pair Nat Nat)
    | MirDuplicateLocal _ => Nothing (Pair Nat Nat) | MirUnknownLocal _ => Nothing (Pair Nat Nat)
    | MirDuplicateBlock _ => Nothing (Pair Nat Nat) | MirUninitialized _ _ => Nothing (Pair Nat Nat)
    | MirTypeMismatch _ => Nothing (Pair Nat Nat) | MirInvalidLiteral => Nothing (Pair Nat Nat)
    | MirInvalidConversion _ => Nothing (Pair Nat Nat) | MirInvalidAddress _ => Nothing (Pair Nat Nat)
    | MirInvalidCall _ => Nothing (Pair Nat Nat) | MirInvalidReturn _ => Nothing (Pair Nat Nat)
    | MirInvalidEntry _ => Nothing (Pair Nat Nat) | MirInvalidName _ => Nothing (Pair Nat Nat)
    | MirInvalidDisplacement => Nothing (Pair Nat Nat) | MirInvalidData _ => Nothing (Pair Nat Nat)
    | MirUnreachableBlock _ => Nothing (Pair Nat Nat) | MirGcCallMismatch _ _ => Nothing (Pair Nat Nat)
    | MirGcUnsafeRuntime _ => Nothing (Pair Nat Nat) end;

private def quality_mir_error_equal (actual : MirError) (expected : MirError) : Bool :=
    match quality_mir_flow_error_key actual, quality_mir_flow_error_key expected with
    | Just a, Just b => match a, b with | MkPair kind id, MkPair category key =>
        andb(eq_nat kind category, eq_nat id key) end
    | Nothing, Nothing => False | Nothing, Just _ => False | Just _, Nothing => False end;

private def quality_mir_exact_values (actual : Either MirError (List Nat))
    (expected : Either MirError (List Nat)) : Bool :=
    match actual, expected with
    | Left a, Left b => quality_mir_error_equal a b
    | Right a, Right b => list_eq Nat eq_nat a b
    | Left _, Right _ => False | Right _, Left _ => False end;

private def quality_mir_exact_fact_result (actual : Either MirError (List MirBlockFact))
    (expected : Either MirError (List MirBlockFact)) : Bool :=
    match actual, expected with
    | Left a, Left b => quality_mir_error_equal a b
    | Right a, Right b => list_eq MirBlockFact
        (fun (left : MirBlockFact) (right : MirBlockFact) => match left, right with
          | MirFact id values, MirFact key wanted => andb(eq_nat id key, list_eq Nat eq_nat values wanted) end) a b
    | Left _, Right _ => False | Right _, Left _ => False end;

private def quality_mir_predecessor_blocks : List MirBlock := [
    MirBlockDef 0 [] (MirJump 9),
    MirBlockDef 1 [MirManagedContext 1] (MirJump 9),
    MirBlockDef 2 [MirManagedContext 2, MirManagedContext 1] (MirBranch (MirUse 3) 9 9),
    MirBlockDef 3 [MirManagedContext 3] (MirJump 10)];

private def quality_mir_predecessor_parity : Bool :=
    all (List MirBlockFact) (fun (facts : List MirBlockFact) =>
      all (List MirBlock) (fun (blocks : List MirBlock) =>
        all (List Nat) (fun (locals : List Nat) =>
          quality_mir_exact_values (mir_predecessor_declared 9 facts blocks locals)
            (quality_mir_reference_predecessors 9 facts blocks locals))
          ([[], [2,1,2], [quality_mir_wide_id,1,quality_mir_wide_id]] : List (List Nat)))
        ([quality_mir_predecessor_blocks, reverse MirBlock quality_mir_predecessor_blocks,
          take MirBlock 2 quality_mir_predecessor_blocks] : List (List MirBlock)))
      ([[], [MirFact 0 [], MirFact 1 [2,2], MirFact 2 [3]],
        [MirFact 0 [1,quality_mir_wide_id,1], MirFact 0 [], MirFact 1 [2,1], MirFact 2 [1,3]]]
        : List (List MirBlockFact));

private def quality_mir_flow_blocks : List MirBlock := [
    MirBlockDef 0 [] (MirBranch (MirUse 2) 1 2),
    MirBlockDef 1 [] (MirJump 3),
    MirBlockDef 2 [MirManagedContext 1] (MirJump 3),
    MirBlockDef 3 [] (MirJump 0)];

private def quality_mir_flow_parity : Bool :=
    all (List MirBlock) (fun (blocks : List MirBlock) =>
      all Nat (fun (fuel : Nat) =>
        quality_mir_exact_fact_result
          (mir_flow_facts_with (fun (work : Unit -> Either MirError (List MirBlockFact)) => work MkUnit)
            mir_predecessor_declared fuel 0 [] [0,1,2] blocks)
          (mir_flow_facts_with (fun (work : Unit -> Either MirError (List MirBlockFact)) => work MkUnit)
            quality_mir_reference_predecessors fuel 0 [] [0,1,2] blocks))
        ([0,1,2,3,4,5] : List Nat))
      ([quality_mir_flow_blocks, reverse MirBlock quality_mir_flow_blocks] : List (List MirBlock));

private def quality_mir_scale_blocks : List MirBlock :=
    let instructions : List MirInstruction := replicate MirInstruction (MirManagedContext 7) 512 in
    Cons MirBlock (MirBlockDef 0 [] (MirJump 99))
      ((fix collect (remaining : Nat) : List MirBlock := match remaining with
        | Z => [] | S rest => Cons MirBlock (MirBlockDef remaining instructions (MirJump 99)) (collect rest) end) 64);

def quality_mir_regressions : List Test := [
    assert_true "MIR predecessor intersections preserve exact ordered facts and missing-fact errors"
      quality_mir_predecessor_parity,
    assert_true "MIR declared predecessor seed is retained when locals are empty"
      (quality_mir_exact_values
        (mir_predecessor_declared 9 [MirFact 1 [1,1]] [MirBlockDef 1 [] (MirJump 9)] [])
        (Right MirError (List Nat) [1,1])),
    assert_true "MIR no-predecessor result preserves ordered duplicate locals"
      (quality_mir_exact_values
        (mir_predecessor_declared 9 [] [MirBlockDef 3 [] (MirJump 10)] [2,1,2])
        (Right MirError (List Nat) [2,1,2])),
    assert_true "MIR predecessor lookup retains the first duplicate fact and full Nat payload order"
      (quality_mir_exact_values
        (mir_predecessor_declared 9 [MirFact 1 [quality_mir_wide_id,1,quality_mir_wide_id], MirFact 1 []]
          [MirBlockDef 1 [] (MirJump 9)] [])
        (Right MirError (List Nat) [quality_mir_wide_id,1,quality_mir_wide_id])),
    assert_true "MIR empty intersections retain the first later missing predecessor"
      (quality_mir_exact_values
        (mir_predecessor_declared 9 [MirFact 0 []] quality_mir_predecessor_blocks [1,2])
        (Left MirError (List Nat) (MirUnknownBlock 1))),
    assert_true "MIR empty intersections retain missing predecessors after becoming empty"
      (quality_mir_exact_values
        (mir_predecessor_declared 9 [MirFact 0 [7], MirFact 1 []]
          quality_mir_predecessor_blocks [7,1])
        (Left MirError (List Nat) (MirUnknownBlock 2))),
    assert_true "MIR cyclic flow preserves exact facts and fuel errors in both block orders"
      quality_mir_flow_parity,
    assert_true "MIR empty joins preserve all checks with long predecessor bodies"
      (quality_mir_exact_values
        (mir_predecessor_declared 99
          (map MirBlock MirBlockFact (fun (block : MirBlock) => MirFact (mir_block_id block) [])
            quality_mir_scale_blocks)
          quality_mir_scale_blocks [7])
        (Right MirError (List Nat) []))];

-- @entry main
def main : IO Unit := test_run quality_mir_regressions;
