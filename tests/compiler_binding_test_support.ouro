import "../compiler/driver.ouro",
  "compiler_binding_surface.ouro";

def binding_test_runtime_action (mode : PrimitiveExecution) (gc : PrimitiveGc)
    (specialization : Maybe CoreTerm) : Bool :=
    binding_surface_runtime_action mode gc specialization;

def binding_test_selected (wanted : PrimitiveId) (result : CompResult CheckedProgram) : Bool :=
    match result with
    | CErr _ => False
    | COk program =>
        (fix check (entries : List Entry) : Bool :=
          match entries with
          | Nil => False
          | Cons entry rest =>
              if let MkBoundEntry _ _ binding := entry then
                if let PrimitiveIntrinsicBinding id mode gc specialization := binding then
                  if primitive_id_equal id wanted then binding_test_runtime_action mode gc specialization
                  else check rest
                else check rest
              else check rest
          end) (checked_program_entries program)
    end;

def binding_test_rejection (result : CompResult CheckedProgram) : Bool :=
    match result with
    | COk _ => False
    | CErr error => match error with | ErrCode code _ => eqNat code 42 end
    end;
