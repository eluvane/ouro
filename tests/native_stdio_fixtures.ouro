-- Typed-MIR injection proves staging ownership and failure control flow. The
-- allocator/collector beneath managed String values is checked real Ouro.
-- The three static-buffer hooks here are test doubles, not OS/source evidence.
import "native_managed_fixtures.ouro";
import "../compiler/native/managed_stdio.ouro";
import "native_lower_fixture_common.ouro";

def native_stdio_fixture_bytes : List Nat :=
    native_fixture_chunk_bytes managed_stdio_chunk_bytes;

def native_stdio_fixture_pointer (symbol : Nat) (offset : Nat) (actual : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_address symbol state)
      (fun (address : ManagedResult) => match address with | ManagedResultOf base next =>
        lower_bind ManagedResult ManagedState
          (managed_fresh MirRawPtr (fun (local : Nat) => MirPointerAdd local base (managed_bits MirUSize offset)) next)
          (fun (pointer : ManagedResult) => match pointer with | ManagedResultOf expected after =>
            managed_require_equal actual expected after end) end);

def native_stdio_fixture_allocate (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (managed_require_equal (MirUse 0) (managed_bits MirUSize managed_stdio_buffer_bytes) state)
      (fun (sized : ManagedState) => lower_bind ManagedState ManagedResult
        (managed_require_equal (MirUse 1) (managed_bits MirUSize 8) sized)
        (fun (aligned : ManagedState) => lower_bind ManagedResult ManagedResult
          (native_managed_fixture_increment (add base 204) 0 aligned)
          (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ after =>
            match eqNat mode 4 with
            | True => Right NativeLowerError ManagedResult (ManagedResultOf (managed_bits MirRawPtr 0) after)
            | False => managed_address (add base 203) after end end)));

def native_stdio_fixture_release (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (native_stdio_fixture_pointer (add base 203) 0 (MirUse 0) state)
      (fun (checked : ManagedState) => lower_map ManagedResult ManagedResult (fun (counted : ManagedResult) =>
        match counted with | ManagedResultOf _ after => ManagedResultOf
          (managed_bits MirU8 (match orb (eqNat mode 2) (eqNat mode 3) with | True => 0 | False => 1 end)) after end)
        (native_managed_fixture_increment (add base 204) 16 checked));

def native_stdio_fixture_write_result (mode : Nat) (iteration : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match orb (eqNat mode 1) (eqNat mode 3) with
    | True => Right NativeLowerError ManagedResult (ManagedResultOf (managed_bits MirU8 0) state)
    | False => match eqNat mode 6 with
      | True => managed_compare MirLess iteration (managed_bits MirUSize 2) state
      | False => Right NativeLowerError ManagedResult (ManagedResultOf (managed_bits MirU8 1) state) end end;

def native_stdio_fixture_writer_bytes (base : Nat) (mode : Nat) (iteration : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_compare MirLess iteration (managed_bits MirUSize 3) state)
      (fun (tested : ManagedResult) => match tested with | ManagedResultOf first_two next =>
        lower_bind ManagedResult ManagedResult (managed_string_choose MirUSize first_two
          (fun (entered : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf (managed_bits MirUSize managed_stdio_chunk_bytes) entered))
          (fun (entered : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf (managed_bits MirUSize 7) entered)) next)
          (fun (sized : ManagedResult) => match sized with | ManagedResultOf count after_count =>
            lower_bind ManagedState ManagedResult (managed_require_equal (MirUse 1) count after_count)
              (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
                (managed_binary MirUSize MirSub iteration (managed_bits MirUSize 1) checked)
                (fun (indexed : ManagedResult) => match indexed with | ManagedResultOf index after_index =>
                  lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul index (managed_bits MirUSize managed_stdio_chunk_bytes) after_index)
                    (fun (offsetted : ManagedResult) => match offsetted with | ManagedResultOf offset after_offset =>
                      lower_bind ManagedResult ManagedResult (managed_address (add base 205) after_offset)
                        (fun (expected : ManagedResult) => match expected with | ManagedResultOf bytes after_bytes =>
                          lower_bind ManagedResult ManagedResult
                            (managed_bytes_equal (MirUse 0) (managed_bits MirUSize 0) bytes offset count after_bytes)
                            (fun (compared : ManagedResult) => match compared with | ManagedResultOf equal after_equal =>
                              lower_bind ManagedState ManagedResult (managed_require_equal equal (managed_bits MirU8 1) after_equal)
                                (native_stdio_fixture_write_result mode iteration) end) end) end) end)) end) end);

def native_stdio_fixture_writer (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (native_stdio_fixture_pointer (add base 203) 0 (MirUse 0) state)
      (fun (buffered : ManagedState) => lower_bind ManagedState ManagedResult
        (native_stdio_fixture_pointer (add base 203) managed_stdio_chunk_bytes (MirUse 2) buffered)
        (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult
          (native_managed_fixture_increment (add base 204) 8 checked)
          (fun (counted : ManagedResult) => match counted with | ManagedResultOf iteration after =>
            native_stdio_fixture_writer_bytes base mode iteration after end)));

def native_stdio_fixture_stat (counters : MirValue) (offset : Nat) (expected : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_load MirUSize counters offset state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf value after =>
        managed_require_equal value (managed_bits MirUSize expected) after end);

def native_stdio_fixture_checks (base : Nat) (mode : Nat) (status : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let expected : Nat := match eqNat mode 6 with | True => 1 | False => match eqNat mode 5 with
      | True => 0 | False => mode end end in
    let allocated : Nat := match eqNat mode 5 with | True => 0 | False => 1 end in
    let released : Nat := match orb (eqNat mode 4) (eqNat mode 5) with | True => 0 | False => 1 end in
    let writes : Nat := match eqNat released 0 with | True => 0 | False =>
      match orb (eqNat mode 1) (eqNat mode 3) with | True => 1 | False =>
        match eqNat mode 6 with | True => 2 | False => 3 end end end in
    lower_bind ManagedState ManagedState (managed_require_equal status (managed_bits MirU8 expected) state)
      (fun (checked : ManagedState) => lower_bind ManagedResult ManagedState (managed_address (add base 204) checked)
        (fun (address : ManagedResult) => match address with | ManagedResultOf counters next =>
          lower_bind ManagedState ManagedState (native_stdio_fixture_stat counters 0 allocated next)
            (fun (after : ManagedState) => lower_bind ManagedState ManagedState (native_stdio_fixture_stat counters 8 writes after)
              (native_stdio_fixture_stat counters 16 released)) end));

def native_stdio_fixture_run (compiler : ManagedCompiler) (base : Nat) (exit : Nat) (selected : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let fatal : Bool := leb_nat 10 selected in
    let mode : Nat := match fatal with | True => sub selected 10 | False => selected end in
    lower_bind ManagedResult ManagedResult (managed_string_literal compiler
      (match eqNat mode 5 with | True => ([] : List Nat) | False => native_stdio_fixture_bytes end) state)
      (fun (literal : ManagedResult) => match literal with | ManagedResultOf value next =>
        lower_bind ManagedResult ManagedResult
          (managed_stdio_write_status compiler (ManagedStdioRuntimeOf (add base 200) (add base 201) (add base 202)) value next)
          (fun (written : ManagedResult) => match written with | ManagedResultOf status after =>
            lower_bind ManagedState ManagedResult (native_stdio_fixture_checks base mode status after)
              (fun (checked : ManagedState) => lower_map ManagedState ManagedResult
                (fun (finished : ManagedState) => ManagedResultOf (managed_bits MirU32 42) finished)
                (match fatal with | False => Right NativeLowerError ManagedState checked
                 | True => lower_bind ManagedResult ManagedState (managed_compare MirEqual status (managed_bits MirU8 0) checked)
                    (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay after_test =>
                      managed_stdio_require exit okay after_test end) end)) end) end);

def native_stdio_fixture_function (id : Nat) (name : List Nat) (arguments : List MirLocal) (result : MirType)
    (body : ManagedState -> Either NativeLowerError ManagedResult) : Either NativeLowerError MirFunction :=
    lower_map ManagedResult MirFunction (fun (compiled : ManagedResult) => match compiled with
      | ManagedResultOf value after => match managed_flow after with | LowerStateOf _ locals _ _ =>
        MirFunctionDef id name arguments (reverse MirLocal locals) (Just MirType result) 0
          (lower_finish_blocks (MirReturn (Just MirValue value)) (managed_flow after)) end end)
      (body (ManagedStateOf 0 ([] : List MirFunction) ([] : List MirData) ([] : List Nat) ([] : List Nat)
        (lower_empty_state (length MirLocal arguments))));

def native_stdio_fixture (selected : Nat) (runtime : NativeManagedRuntime) : Either NativeLowerError MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ _ _ _ exit base _ =>
      let mode : Nat := match leb_nat 10 selected with | True => sub selected 10 | False => selected end in
      let compiler : ManagedCompiler := native_managed_fixture_compiler runtime in
      lower_bind MirFunction MirProgram (native_stdio_fixture_function (add base 200)
        ([115,116,100,105,111,95,97,108,108,111,99,97,116,101] : List Nat)
        ([MirLocalDef 0 MirUSize, MirLocalDef 1 MirUSize] : List MirLocal) MirRawPtr (native_stdio_fixture_allocate base mode))
        (fun (allocate : MirFunction) => lower_bind MirFunction MirProgram (native_stdio_fixture_function (add base 201)
          ([115,116,100,105,111,95,114,101,108,101,97,115,101] : List Nat)
          ([MirLocalDef 0 MirRawPtr] : List MirLocal) MirU8 (native_stdio_fixture_release base mode))
          (fun (release : MirFunction) => lower_bind MirFunction MirProgram (native_stdio_fixture_function (add base 202)
            ([115,116,100,105,111,95,119,114,105,116,101,114] : List Nat)
            ([MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirUSize, MirLocalDef 2 MirRawPtr] : List MirLocal) MirU8
            (native_stdio_fixture_writer base mode))
            (fun (writer : MirFunction) => lower_map ManagedResult MirProgram (fun (compiled : ManagedResult) => match compiled with
              | ManagedResultOf value after => match after with | ManagedStateOf _ functions data _ _ flow =>
                match flow with | LowerStateOf _ locals _ _ =>
                  let main : MirFunction := MirFunctionDef (S base) ([115,116,100,105,111,95,102,105,120,116,117,114,101] : List Nat)
                    ([] : List MirLocal) (reverse MirLocal locals) (Just MirType MirU32) 0
                    (lower_finish_blocks (MirReturn (Just MirValue value)) flow) in
                  managed_fixture_finish runtime
                    (append MirFunction ([main, allocate, release, writer] : List MirFunction) (reverse MirFunction functions))
                    (append MirData ([MirDataDef (managed_descriptor compiler 6) False (mir_managed_descriptor_bytes 6),
                      MirDataDef (add base 203) True (pe_zeros managed_stdio_buffer_bytes), MirDataDef (add base 204) True (pe_zeros 24),
                      MirDataDef (add base 205) False native_stdio_fixture_bytes] : List MirData) (reverse MirData data)) end end end)
              (native_stdio_fixture_run compiler base exit selected
                (ManagedStateOf (add base 300) ([] : List MirFunction) ([] : List MirData) ([] : List Nat) ([] : List Nat)
                  (lower_empty_state 0)))))) end;
