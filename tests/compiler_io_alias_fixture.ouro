import "../std/runtime.ouro";

def MetadataAction (A : Type) : Type :=
    let result : Type := IO A in result;
def MetadataAlias : Type -> Type :=
    let alias : Type -> Type := MetadataAction in alias;
def MetadataClosed : Type := MetadataAlias Unit;

def metadata_lift (A : Type) (value : A) : MetadataAlias A := io_pure A value;

def metadata_chain (A : Type) (B : Type) (action : MetadataAlias A)
    (next : A -> MetadataAlias B) : MetadataAction B :=
    io_bind A B action next;

def metadata_pure_alias : (A : Type) -> A -> MetadataAlias A := metadata_lift;
def metadata_bind_alias : (A : Type) -> (B : Type) -> MetadataAlias A ->
    (A -> MetadataAlias B) -> MetadataAlias B := metadata_chain;

def metadata_value : MetadataClosed := metadata_lift Unit MkUnit;
def metadata_nested_value : IO MetadataClosed := metadata_lift MetadataClosed metadata_value;

def metadata_callback (action : MetadataClosed) : MetadataClosed := action;
def metadata_callback_value : IO (MetadataClosed -> MetadataClosed) :=
    metadata_lift (MetadataClosed -> MetadataClosed) metadata_callback;

def metadata_bound_value : IO Unit :=
    metadata_chain MetadataClosed Unit metadata_nested_value
      (fun (_ : MetadataClosed) => metadata_value);
