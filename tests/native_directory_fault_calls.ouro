-- Exact operation counts and ownership checks are independent of exit.
import "native_directory_fault_values.ouro";

def directory_fault_stats (base : Nat) (expected : List (Pair Nat Nat)) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    (fix check (remaining : List (Pair Nat Nat)) (current : ManagedState) : Either NativeLowerError ManagedState :=
      match remaining with | Nil => Right NativeLowerError ManagedState current
      | Cons pair rest => match pair with | MkPair offset value =>
          lower_bind ManagedState ManagedState (startup_fault_stat base offset value current) (fun (after : ManagedState) => check rest after) end end) expected state;

def directory_fault_equal_counts (base : Nat) (left : Nat) (right : Nat) (increment : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (startup_fault_load base left MirUSize state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf first next =>
        lower_bind ManagedResult ManagedState (startup_fault_load base right MirUSize next)
          (fun (other : ManagedResult) => match other with | ManagedResultOf second after =>
            lower_bind ManagedResult ManagedState (managed_binary MirUSize MirAdd second (managed_bits MirUSize increment) after)
              (fun (added : ManagedResult) => match added with | ManagedResultOf expected final =>
                managed_require_equal first expected final end) end) end);

def directory_fault_at_least (base : Nat) (offset : Nat) (minimum : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (startup_fault_load base offset MirUSize state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf count next =>
        lower_bind ManagedResult ManagedState (managed_compare MirGreaterEqual count (managed_bits MirUSize minimum) next)
          (fun (tested : ManagedResult) => match tested with | ManagedResultOf enough after =>
            managed_require_equal enough (managed_bits MirU8 1) after end) end);

def directory_fault_first_calls (listable : Bool) (mode : Nat) : Nat :=
    match orb listable (andb (leb_nat 1 mode) (leb_nat mode 11)) with | True => 0 | False => 1 end;

def directory_fault_search_closes (listable : Bool) (mode : Nat) : Nat :=
    match orb (eqNat mode 12) (eqNat mode 13) with | True => 0 | False => directory_fault_first_calls listable mode end;

def directory_fault_fixed_counts (base : Nat) (listable : Bool) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let allocation_failure : Bool := andb (leb_nat 1 mode) (leb_nat mode 3) in
    let allocations : Nat := match allocation_failure with | True => mode | False => match eqNat mode 5 with | True => 2 | False => 3 end end in
    let early : Bool := orb allocation_failure (andb (leb_nat 5 mode) (leb_nat mode 7)) in
    let path_checks : Nat := match early with | True => 0 | False => 1 end in
    let opens : Nat := match orb early (eqNat mode 4) with | True => 0 | False => 1 end in
    let inspections : Nat := match eqNat mode 8 with | True => 0 | False => opens end in
    let conversions : Nat := match andb (leb_nat 1 mode) (leb_nat mode 2) with | True => 0 | False =>
      match orb (eqNat mode 3) (eqNat mode 5) with | True => 1 | False => 2 end end in
    directory_fault_stats base
      [MkPair Nat Nat 0 allocations,
       MkPair Nat Nat 8 (sub allocations (match allocation_failure with | True => 1 | False => 0 end)),
       MkPair Nat Nat 16 opens, MkPair Nat Nat 24 inspections,
       MkPair Nat Nat 40 conversions, MkPair Nat Nat 112 inspections, MkPair Nat Nat 192 path_checks,
       MkPair Nat Nat 32 (directory_fault_first_calls listable mode),
       MkPair Nat Nat 200 (directory_fault_search_closes listable mode)] state;

def directory_fault_first_conversion (base : Nat) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (startup_fault_load base 56 MirUSize state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf count next =>
        lower_bind ManagedResult ManagedState (managed_compare MirEqual count (managed_bits MirUSize 0) next)
          (fun (empty : ManagedResult) => match empty with | ManagedResultOf none after =>
            lower_bind ManagedResult ManagedState (managed_compare MirEqual count (managed_bits MirUSize 2) after)
              (fun (pair : ManagedResult) => match pair with | ManagedResultOf complete final =>
                lower_bind ManagedResult ManagedState (managed_binary MirU8 MirOr none complete final)
                  (fun (combined : ManagedResult) => match combined with | ManagedResultOf valid finished =>
                    managed_require_equal valid (managed_bits MirU8 1) finished end) end) end) end);

def directory_fault_walk_counts (base : Nat) (listable : Bool) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    match eqNat (directory_fault_search_closes listable mode) 0 with
    | True => directory_fault_stats base [MkPair Nat Nat 120 0, MkPair Nat Nat 48 0, MkPair Nat Nat 56 0] state
    | False => match andb (leb_nat 17 mode) (leb_nat mode 21) with
      | True => directory_fault_stats base [MkPair Nat Nat 120 1, MkPair Nat Nat 48 0,
          MkPair Nat Nat 56 (match eqNat mode 20 with | True => 1 | False => 0 end)] state
      | False => match eqNat mode 15 with
        | True => lower_bind ManagedState ManagedState
            (directory_fault_stats base [MkPair Nat Nat 120 1, MkPair Nat Nat 48 1] state)
            (directory_fault_first_conversion base)
        | False => match andb (leb_nat 22 mode) (leb_nat mode 25) with
          | True => lower_bind ManagedState ManagedState (directory_fault_at_least base 120 1 state)
              (fun (counted : ManagedState) => lower_bind ManagedState ManagedState
                (directory_fault_equal_counts base 120 48 1 counted)
                (startup_fault_stat base 56 (match orb (eqNat mode 22) (eqNat mode 24) with | True => 1 | False => 2 end)))
          | False => let partial : Bool := orb (eqNat mode 16) (eqNat mode 27) in
              lower_bind ManagedState ManagedState (directory_fault_at_least base 120
                (match partial with | True => 1 | False => 2 end) state)
                (fun (counted : ManagedState) => lower_bind ManagedState ManagedState
                  (directory_fault_equal_counts base 120 48 0 counted)
                  (startup_fault_stat base 56 (match partial with | True => 2 | False => 4 end))) end end end end;

def directory_fault_gc_counts (base : Nat) (listable : Bool) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let probes : Nat := match listable with | True => 2 | False => 4 end in
    let file_opens : Nat := match listable with | True => probes | False => S probes end in
    let searches : Nat := match listable with | True => 0 | False => 2 end in
    lower_bind ManagedResult ManagedState (startup_fault_load base 104 MirU8 state)
      (fun (observed : ManagedResult) => match observed with | ManagedResultOf reclaimed next =>
        lower_bind ManagedState ManagedState (managed_require_equal reclaimed (managed_bits MirU8 1) next)
          (fun (collected : ManagedState) => lower_bind ManagedState ManagedState
            (directory_fault_at_least base 0 6 collected)
            (fun (allocated : ManagedState) => lower_bind ManagedState ManagedState
              (directory_fault_equal_counts base 0 8 0 allocated)
              (directory_fault_stats base [MkPair Nat Nat 16 file_opens, MkPair Nat Nat 24 file_opens,
                MkPair Nat Nat 112 probes, MkPair Nat Nat 192 probes,
                MkPair Nat Nat 32 searches, MkPair Nat Nat 200 searches]))) end);

def directory_fault_exit_checks (base : Nat) (listable : Bool) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let success : Bool := orb (eqNat mode 0) (orb (eqNat mode 12) (orb (eqNat mode 30)
      (andb listable (andb (leb_nat 8 mode) (leb_nat mode 10))))) in
    lower_bind ManagedState ManagedState (managed_require_equal (MirUse 0)
      (managed_bits MirU32 (match success with | True => 42 | False => 73 end)) state)
      (fun (exited : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 64 0 exited)
        (fun (released : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 72 0 released)
          (fun (closed : ManagedState) => lower_bind ManagedState ManagedState (directory_fault_at_least base 96 1 closed)
            (fun (collected : ManagedState) => match eqNat mode 30 with
              | True => directory_fault_gc_counts base listable collected
              | False => lower_bind ManagedState ManagedState (directory_fault_fixed_counts base listable mode collected)
                  (directory_fault_walk_counts base listable mode) end))));

def directory_fault_arguments (index : Nat) : List MirType :=
    match eqNat index 0 with | True => [MirUSize, MirUSize] | False =>
    match eqNat index 1 with | True => [MirRawPtr] | False =>
    match eqNat index 2 with | True => [MirRawPtr, MirUSize, MirRawPtr, MirUSize, MirRawPtr] | False =>
    match eqNat index 3 with | True => [MirRawPtr, MirUSize, MirRawPtr, MirUSize, MirRawPtr] | False =>
    match eqNat index 4 with | True => [MirRawPtr, MirUSize, MirRawPtr] | False =>
    match eqNat index 5 with | True => [MirRawPtr, MirUSize, MirUSize] | False =>
    match eqNat index 6 with | True => [MirRawPtr, MirUSize, MirRawPtr] | False =>
    match eqNat index 7 with | True => [MirRawPtr, MirRawPtr] | False =>
    match eqNat index 8 with | True => [MirRawPtr] | False =>
    match eqNat index 9 with | True => [MirRawPtr, MirUSize, MirRawPtr, MirUSize, MirRawPtr] | False =>
    match eqNat index 10 with | True => [MirRawPtr, MirRawPtr, MirUSize] | False =>
    match eqNat index 11 with | True => [MirRawPtr] | False =>
    match eqNat index 12 with | True => [MirU32] | False =>
    match eqNat index 13 with | True => [MirRawPtr] | False =>
    [MirRawPtr, MirUSize, MirRawPtr] end end end end end end end end end end end end end end;

def directory_fault_wrapper (base : Nat) (listable : Bool) (mode : Nat) (index : Nat) (original : Nat)
    : Either NativeLowerError MirFunction :=
    let types : List MirType := directory_fault_arguments index in
    let entered : ManagedState := ManagedStateOf 0 ([] : List MirFunction) ([] : List MirData)
      ([] : List Nat) ([] : List Nat) (lower_empty_state (length MirType types)) in
    let arguments : List MirValue := directory_fault_values types in
    let body : Either NativeLowerError ManagedResult :=
      match eqNat index 0 with | True => startup_fault_allocate base (match andb (leb_nat 1 mode) (leb_nat mode 3) with | True => mode | False => 0 end) original entered | False =>
      match eqNat index 1 with | True => directory_fault_release base mode original entered | False =>
      match eqNat index 2 with | True => startup_fault_conversion base mode original entered | False =>
      match eqNat index 3 with | True => directory_fault_name base mode original entered | False =>
      match eqNat index 4 with | True => directory_fault_length base mode original entered | False =>
      match eqNat index 5 with | True => directory_fault_path base mode original entered | False =>
      match eqNat index 6 with | True => directory_fault_open base mode original False arguments (MirUse 2) entered | False =>
      match eqNat index 7 with | True => directory_fault_check base mode original entered | False =>
      match eqNat index 8 with | True => directory_fault_close base mode original False entered | False =>
      match eqNat index 9 with | True => directory_fault_open base mode original True arguments (MirUse 4) entered | False =>
      match eqNat index 10 with | True => directory_fault_next base mode original entered | False =>
      match eqNat index 11 with | True => directory_fault_close base mode original True entered | False =>
      match eqNat index 12 with | True => lower_bind ManagedState ManagedResult (directory_fault_exit_checks base listable mode entered)
          (fun (checked : ManagedState) => startup_fault_result MirU8 1
            (managed_emit (MirCall MirMayGc (Nothing Nat) (MirDirect original) ([MirUse 0] : List MirValue)) checked)) | False =>
      match eqNat index 13 with | True => directory_fault_collector base original entered | False =>
      directory_fault_open base mode original False arguments (MirUse 2) entered end end end end end end end end end end end end end end in
    lower_map ManagedResult MirFunction (fun (result : ManagedResult) => match result with | ManagedResultOf value after =>
      match managed_flow after with | LowerStateOf _ locals _ _ =>
        let exiting : Bool := eqNat index 12 in
        let result_type : MirType := match eqNat index 0 with | True => MirRawPtr | False =>
          match orb (eqNat index 1) (orb (eqNat index 5) (eqNat index 13)) with | True => MirU8 | False => MirU32 end end in
        MirFunctionDef (add base index) ([100,105,114,101,99,116,111,114,121,95,102,97,117,108,116] : List Nat)
          (directory_fault_locals types) (reverse MirLocal locals)
          (match exiting with | True => Nothing MirType | False => Just MirType result_type end) 0
          (lower_finish_blocks (match exiting with | True => MirTrap
            | False => MirReturn (Just MirValue value) end) (managed_flow after)) end end) body;

def directory_fault_wrappers (base : Nat) (listable : Bool) (mode : Nat) (symbols : List Nat)
    : Either NativeLowerError (List MirFunction) :=
    (fix build (remaining : List Nat) (index : Nat) : Either NativeLowerError (List MirFunction) :=
      match remaining with | Nil => Right NativeLowerError (List MirFunction) ([] : List MirFunction)
      | Cons original rest => lower_bind MirFunction (List MirFunction) (directory_fault_wrapper base listable mode index original)
          (fun (wrapper : MirFunction) => lower_map (List MirFunction) (List MirFunction) (Cons MirFunction wrapper)
            (build rest (S index))) end) symbols 0;
