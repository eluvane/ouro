import "../tools/native_release.ouro", "analyze/precision/assertions.ouro";
import "../tools/native_release_stream_model.ouro";

def native_release_test_abc : String := "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
def native_release_test_empty : String := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
def native_release_test_binary : String := str_of_codes [65, 0, 255, 13, 10, 66];
def native_release_test_binary_digest : String := "0fd7251c4cef8f3091479a66757366ae8722015005780a565eb1db530be0a7b8";

def native_release_test_file (name : String) : NativeReleaseInput :=
    NativeReleaseInputOf name "C:/inputs/source.bin" 3 native_release_test_abc;

def native_release_test_plan (budget : Nat) (names : List String) (inputs : List NativeReleaseInput)
    (expected : String) : Bool :=
    match native_release_plan_checked budget names inputs with
    | Right _ => str_null expected
    | Left error => str_eq (native_release_plan_error_code error) expected
    end;

def native_release_test_content (input : NativeReleaseInput) (content : String) (expected : String) : Bool :=
    match native_release_content_checked input content with
    | Right _ => str_null expected
    | Left error => str_eq (native_release_plan_error_code error) expected
    end;

def native_release_test_inventory (files : List NativeReleaseCaptured) (walked : FsWalkResult)
    (expected : String) : Bool :=
    match native_release_output_inventory "C:/out" files walked with
    | Right _ => str_null expected
    | Left error => str_eq (native_release_stage_error_code error) expected
    end;

def native_release_test_captured : List NativeReleaseCaptured :=
    [ NativeReleaseCapturedOf (native_release_test_file "a") "abc"
    , NativeReleaseCapturedOf (native_release_test_file "b") "abc"
    ];

def native_release_test_owned (created : Bool) : Bool :=
    match native_release_owned_result created
        (Left NativeReleaseStageError Unit (ReleaseOutputChanged "a")) with
    | Right _ => False
    | Left failure => match created, native_release_stage_failure_created failure with
      | True, True => True | False, False => True | True, False => False | False, True => False end
    end;

def native_release_model_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-release/exact-inventory-and-budget"
        (native_release_test_plan 3 ["a"] [native_release_test_file "a"] "")
    , MkPair String Bool "native-release/empty-file-zero-budget"
        (native_release_test_plan 0 ["empty"] [NativeReleaseInputOf "empty" "C:/in/empty" 0 native_release_test_empty] "")
    , MkPair String Bool "native-release/empty-inventory-refused"
        (native_release_test_plan 0 [] [] "release_empty_inventory")
    , MkPair String Bool "native-release/missing-input-refused"
        (native_release_test_plan 6 ["a", "b"] [native_release_test_file "a"] "release_inventory_mismatch")
    , MkPair String Bool "native-release/extra-input-refused"
        (native_release_test_plan 6 ["a"] [native_release_test_file "a", native_release_test_file "b"] "release_inventory_mismatch")
    , MkPair String Bool "native-release/reordered-input-refused"
        (native_release_test_plan 6 ["a", "b"] [native_release_test_file "b", native_release_test_file "a"] "release_inventory_mismatch")
    , MkPair String Bool "native-release/unsorted-inventory-refused"
        (native_release_test_plan 6 ["b", "a"] [native_release_test_file "b", native_release_test_file "a"] "release_inventory_order")
    , MkPair String Bool "native-release/duplicate-refused"
        (native_release_test_plan 6 ["a", "a"] [native_release_test_file "a", native_release_test_file "a"] "release_path_conflict")
    , MkPair String Bool "native-release/ASCII-case-alias-refused"
        (native_release_test_plan 6 ["A", "a"] [native_release_test_file "A", native_release_test_file "a"] "release_path_conflict")
    , MkPair String Bool "native-release/file-directory-prefix-refused"
        (native_release_test_plan 6 ["a", "a/child"] [native_release_test_file "a", native_release_test_file "a/child"] "release_path_conflict")
    , MkPair String Bool "native-release/prefix-boundary-accepted"
        (native_release_test_plan 6 ["a.txt", "apple"] [native_release_test_file "a.txt", native_release_test_file "apple"] "")
    , MkPair String Bool "native-release/Unicode-space-dotfile-path"
        (native_release_path_valid ".github/source 雪.ouro")
    , MkPair String Bool "native-release/empty-path-refused" (notb (native_release_path_valid ""))
    , MkPair String Bool "native-release/dot-parent-refused" (notb (native_release_path_valid "dir/../a"))
    , MkPair String Bool "native-release/dot-component-refused" (notb (native_release_path_valid "dir/./a"))
    , MkPair String Bool "native-release/absolute-path-refused" (notb (native_release_path_valid "C:/a"))
    , MkPair String Bool "native-release/UNC-path-refused" (notb (native_release_path_valid "//server/share/a"))
    , MkPair String Bool "native-release/backslash-refused" (notb (native_release_path_valid "dir\\a"))
    , MkPair String Bool "native-release/empty-component-refused" (notb (native_release_path_valid "dir//a"))
    , MkPair String Bool "native-release/trailing-slash-refused" (notb (native_release_path_valid "a/"))
    , MkPair String Bool "native-release/trailing-dot-space-refused"
        (all String (fun (name : String) => notb (native_release_path_valid name)) ["a.", "a ", "dir./a", "dir /a"])
    , MkPair String Bool "native-release/device-name-refused"
        (all String (fun (name : String) => notb (native_release_path_valid name))
          ["NUL", "aux.txt", "COM1.exe", "LPT9", "com¹.txt", "COM1 .txt", "CONOUT$", "dir/CON.log"])
    , MkPair String Bool "native-release/ADS-and-wildcards-refused"
        (all String (fun (name : String) => notb (native_release_path_valid name)) ["a:stream", "a*", "a?", "a|b"])
    , MkPair String Bool "native-release/NUL-refused"
        (notb (native_release_path_valid (str_of_codes [97, 0, 98])))
    , MkPair String Bool "native-release/invalid-UTF8-refused"
        (notb (native_release_path_valid (str_of_codes [97, 255])))
    , MkPair String Bool "native-release/overlong-UTF8-refused"
        (notb (native_release_path_valid (str_of_codes [192, 175])))
    , MkPair String Bool "native-release/relative-source-refused"
        (native_release_test_plan 3 ["a"] [NativeReleaseInputOf "a" "source.bin" 3 native_release_test_abc] "release_invalid_source")
    , MkPair String Bool "native-release/NUL-source-refused"
        (native_release_test_plan 3 ["a"] [NativeReleaseInputOf "a" (str_of_codes [67, 58, 47, 0]) 3 native_release_test_abc] "release_invalid_source")
    , MkPair String Bool "native-release/short-digest-refused"
        (native_release_test_plan 3 ["a"] [NativeReleaseInputOf "a" "C:/a" 3 "bad"] "release_invalid_digest")
    , MkPair String Bool "native-release/uppercase-digest-refused"
        (notb (native_release_digest_valid (str_upper native_release_test_abc)))
    , MkPair String Bool "native-release/budget-plus-one-refused"
        (native_release_test_plan 2 ["a"] [native_release_test_file "a"] "release_budget_exceeded")
    , MkPair String Bool "native-release/aggregate-budget-refused"
        (native_release_test_plan 5 ["a", "b"] [native_release_test_file "a", native_release_test_file "b"] "release_budget_exceeded")
    , MkPair String Bool "native-release/SHA-length-bound-refused"
        (native_release_test_plan native_release_sha256_limit ["a"] [native_release_test_file "a"] "release_unsupported_budget")
    , MkPair String Bool "native-release/SHA-length-bound-before-content"
        (native_release_test_content (NativeReleaseInputOf "a" "C:/a" native_release_sha256_limit native_release_test_empty)
          "" "release_unsupported_budget")
    , MkPair String Bool "native-release/SHA256-empty-vector"
        (native_release_test_content (NativeReleaseInputOf "empty" "C:/empty" 0 native_release_test_empty) "" "")
    , MkPair String Bool "native-release/SHA256-abc-vector"
        (native_release_test_content (native_release_test_file "a") "abc" "")
    , MkPair String Bool "native-release/SHA256-binary-vector"
        (native_release_test_content (NativeReleaseInputOf "a" "C:/a" 6 native_release_test_binary_digest)
          native_release_test_binary "")
    , MkPair String Bool "native-release/length-mismatch-refused"
        (native_release_test_content (native_release_test_file "a") "ab" "release_length_mismatch")
    , MkPair String Bool "native-release/same-size-content-change-refused"
        (native_release_test_content (native_release_test_file "a") "abd" "release_digest_mismatch")
    , MkPair String Bool "native-release/exact-output-inventory"
        (native_release_test_inventory native_release_test_captured (FsWalkComplete ["C:/out/b", "C:/out/a"]) "")
    , MkPair String Bool "native-release/output-missing-refused"
        (native_release_test_inventory native_release_test_captured (FsWalkComplete ["C:/out/a"]) "release_output_inventory_changed")
    , MkPair String Bool "native-release/output-extra-refused"
        (native_release_test_inventory native_release_test_captured (FsWalkComplete ["C:/out/a", "C:/out/b", "C:/out/c"]) "release_output_inventory_changed")
    , MkPair String Bool "native-release/output-alias-collision-refused"
        (native_release_test_inventory
          [NativeReleaseCapturedOf (native_release_test_file "Ä") "abc", NativeReleaseCapturedOf (native_release_test_file "ä") "abc"]
          (FsWalkComplete ["C:/out/Ä"]) "release_output_inventory_changed")
    , MkPair String Bool "native-release/truncated-walk-refused"
        (native_release_test_inventory native_release_test_captured (FsWalkTruncated "a") "release_output_inventory")
    , MkPair String Bool "native-release/unreadable-walk-refused"
        (native_release_test_inventory native_release_test_captured (FsWalkUnreadable "a") "release_output_inventory")
    , MkPair String Bool "native-release/unsafe-walk-refused"
        (native_release_test_inventory native_release_test_captured (FsWalkUnsafe "a") "release_output_inventory")
    , MkPair String Bool "native-release/created-root-claim-retained" (native_release_test_owned True)
    , MkPair String Bool "native-release/precreate-failure-has-no-claim" (native_release_test_owned False)
    ];

def native_release_stream_test_unit (code : String)
    (result : Either NativeReleaseStreamError Unit) : Bool :=
    match result with
    | Right _ => str_null code | Left error => str_eq code (native_release_stream_error_code error)
    end;

def native_release_stream_test_input (code : String)
    (result : Either NativeReleaseStreamError Unit) : Bool :=
    match result with
    | Right _ => False
    | Left error => if let ReleaseStreamInput detail := error then
        str_eq code (fs_bounded_read_error_code detail)
      else False
    end;

def native_release_stream_test_large (result : Either NativeReleaseStreamError Unit) : Bool :=
    match result with
    | Right _ => False
    | Left error => if let ReleaseStreamInput detail := error then
        if let FsBoundedReadTooLarge cap bytes := detail then
          andb (eq_nat cap 1) (eq_nat bytes 4294967297)
        else False
      else False
    end;

def native_release_stream_test_progress (writing : Bool) (requested : Nat) (actual : Nat) (code : String) : Bool :=
    match native_release_stream_progress writing requested actual with
    | Right count => andb (str_null code) (eq_nat count actual)
    | Left error => str_eq code (native_release_stream_error_code error)
    end;

def native_release_stream_test_written_error : Bool :=
    let error : NativeReleaseStreamError := ReleaseStreamOutput ReleaseStreamWrite 4294967295 in
    let failure : NativeReleaseStreamFailure := NativeReleaseStreamFailureOf True error in
    andb (native_release_stream_created failure)
      (if let ReleaseStreamOutput phase status :=
          (native_release_stream_error failure : NativeReleaseStreamError) then
          andb (eq_nat status 4294967295)
            (str_eq "release_stream_write" (native_release_stream_error_code (ReleaseStreamOutput phase status)))
        else False);

def native_release_stream_model_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-release/stream-empty-zero-cap"
        (native_release_stream_test_unit "" (native_release_stream_plan_checked 0 0 "C:/in" "C:/stage"))
    , MkPair String Bool "native-release/stream-exact-cap"
        (native_release_stream_test_unit "" (native_release_stream_plan_checked 3 3 "C:/in" "C:/stage"))
    , MkPair String Bool "native-release/stream-cap-before-creation"
        (native_release_stream_test_input "fs_bounded_read_too_large"
          (native_release_stream_plan_checked 2 3 "C:/in" "C:/stage"))
    , MkPair String Bool "native-release/stream-source-error-before-stage-and-cap"
        (native_release_stream_test_input "fs_bounded_read_invalid_path"
          (native_release_stream_plan_checked 0 3 "" ""))
    , MkPair String Bool "native-release/stream-stage-path-before-content-cap"
        (native_release_stream_test_unit "release_stream_stage_path"
          (native_release_stream_plan_checked 0 3 "C:/in" ""))
    , MkPair String Bool "native-release/stream-relative-source-refused"
        (native_release_stream_test_input "fs_bounded_read_invalid_path"
          (native_release_stream_plan_checked 3 3 "relative" "C:/stage"))
    , MkPair String Bool "native-release/stream-nul-stage-refused"
        (native_release_stream_test_unit "release_stream_stage_path"
          (native_release_stream_plan_checked 3 3 "C:/in" (str_concat "C:/stage" (str_of_codes [0]))))
    , MkPair String Bool "native-release/stream-full-Nat-cap"
        (native_release_stream_test_unit ""
          (native_release_stream_plan_checked (S 18446744073709551615) 3 "C:/in" "C:/stage"))
    , MkPair String Bool "native-release/stream-high-size-error-not-truncated"
        (native_release_stream_test_large (native_release_stream_plan_checked 1 4294967297 "C:/in" "C:/stage"))
    , MkPair String Bool "native-release/stream-actual-size-cap-before-declared-match"
        (native_release_stream_test_input "fs_bounded_read_too_large" (native_release_stream_source_length 2 99 3))
    , MkPair String Bool "native-release/stream-declared-size-refused-before-stage"
        (native_release_stream_test_unit "release_stream_source_length" (native_release_stream_source_length 4 4 3))
    , MkPair String Bool "native-release/stream-positive-partial-read"
        (native_release_stream_test_progress False 3 1 "")
    , MkPair String Bool "native-release/stream-positive-partial-write"
        (native_release_stream_test_progress True 3 1 "")
    , MkPair String Bool "native-release/stream-early-zero-read-refused"
        (native_release_stream_test_progress False 3 0 "release_stream_input")
    , MkPair String Bool "native-release/stream-zero-write-terminal-guard"
        (native_release_stream_test_progress True 3 0 "release_stream_guard")
    , MkPair String Bool "native-release/stream-oversized-progress-terminal-guard"
        (native_release_stream_test_progress False 3 4294967297 "release_stream_guard")
    , MkPair String Bool "native-release/stream-no-zero-request-progress"
        (native_release_stream_test_progress True 0 0 "release_stream_guard")
    , MkPair String Bool "native-release/stream-final-stage-length"
        (native_release_stream_test_unit "" (native_release_stream_stage_length 65537 65537))
    , MkPair String Bool "native-release/stream-short-stage-refused"
        (native_release_stream_test_unit "release_stream_stage_length" (native_release_stream_stage_length 65537 65536))
    , MkPair String Bool "native-release/stream-write-error-and-created-claim"
        native_release_stream_test_written_error
    , MkPair String Bool "native-release/stream-precreate-error-without-claim"
        (notb (native_release_stream_created
          (NativeReleaseStreamFailureOf False (ReleaseStreamOutput ReleaseStreamCreate 80))))
    , MkPair String Bool "native-release/stream-guard-separated-from-operational-error"
        (andb (native_release_stream_is_guard ReleaseStreamGuard)
          (notb (native_release_stream_is_guard (ReleaseStreamOutput ReleaseStreamFlush 5))))
    , MkPair String Bool "native-release/stream-closed-stage-describes-exact-bytes"
        (let stage : NativeReleaseClosedStage := NativeReleaseClosedStageOf "C:/stage" 4294967297 in
         andb (str_eq "C:/stage" (native_release_stream_closed_path stage))
           (eq_nat 4294967297 (native_release_stream_closed_bytes stage)))
    ];

-- @entry main
def main : IO Unit := precision_run "native-release-model"
    (append (Pair String Bool) native_release_model_laws native_release_stream_model_laws);
