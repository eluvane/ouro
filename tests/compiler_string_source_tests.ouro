-- Source compilation authenticates literals through checked declaration IDs.
import "../compiler/driver.ouro",
  "../std/io.ouro",
  "compiler_program_lookup.ouro";

inductive StringSourceLaw : Type :=
  | StringSourceLawOf : String -> Bool -> StringSourceLaw;

def string_source_fuel : Nat := mul 100 50;

def string_source_compile (source : String) : CompResult CheckedProgram :=
    compile_checked_source(string_source_fuel, prim_string_to_char_codes source);

def string_source_normal (source : String) (type_name : String) (bytes : List Nat) : Bool :=
    match string_source_compile source with
    | CErr _ => False
    | COk program => match compiler_test_name program type_name, compiler_test_name program "sample" with
        | Just typ, Just name => match lookup_const(name, checked_program_entries program) with
            | Nothing => False
            | Just body => match normalize_checked string_source_fuel (checked_program_entries program) body with
                | NormalizeExhausted => False | NormalizeMalformed _ => False
                | Normalized normal => match eqTerm_checked string_source_fuel normal (CStrBytes bytes typ) with
                    | Normalized same => same | NormalizeExhausted => False | NormalizeMalformed _ => False
                    end
                end
            end
        | Nothing, Nothing => False | Nothing, Just _ => False | Just _, Nothing => False
        end
    end;

def string_source_rejects (source : String) (declaration : Nat) : Bool :=
    match string_source_compile source with
    | COk _ => False
    | CErr failure => match failure with
        | ErrCode code name => andb(eqNat code 41, eqNat name declaration)
        end
    end;

def string_source_laws : List StringSourceLaw :=
    [ StringSourceLawOf "source String intrinsic preserves literal bytes"
        (string_source_normal
          "intrinsic String : Type := \"ouro.string\"; def sample : String := \"AB\";"
          "String" ([65, 66] : List Nat))
    , StringSourceLawOf "source braced Unicode escapes normalize to UTF-8 bytes"
        (string_source_normal
          "intrinsic String : Type := \"ouro.string\"; def sample : String := \"A\\u{0}\\u{e9}\\u{20AC}\\u{1F600}\";"
          "String" ([65, 0, 195, 169, 226, 130, 172, 240, 159, 152, 128] : List Nat))
    , StringSourceLawOf "source braced Unicode scalar boundaries stay valid"
        (string_source_normal
          "intrinsic String : Type := \"ouro.string\"; def sample : String := \"\\u{D7FF}\\u{E000}\\u{10FFFF}\";"
          "String" ([237, 159, 191, 238, 128, 128, 244, 143, 191, 191] : List Nat))
    , StringSourceLawOf "source raw String preserves slash and quote bytes"
        (string_source_normal
          "intrinsic String : Type := \"ouro.string\"; def sample : String := r#\"A\\\\n\"B\"#;"
          "String" ([65, 92, 110, 34, 66] : List Nat))
    , StringSourceLawOf "source raw String closes after a trailing slash"
        (string_source_normal
          "intrinsic String : Type := \"ouro.string\"; def sample : String := r#\"\\\\\"#;"
          "String" ([92] : List Nat))
    , StringSourceLawOf "source raw String preserves UTF-8 and physical newlines"
        (string_source_normal
          "intrinsic String : Type := \"ouro.string\"; def sample : String := r#\"é\n-- @export hidden\n終\"#;"
          "String" ([195, 169, 10, 45, 45, 32, 64, 101, 120, 112, 111, 114, 116, 32, 104, 105, 100, 100, 101, 110, 10, 231, 181, 130] : List Nat))
    , StringSourceLawOf "source unknown non-braced escape retains its bytes"
        (string_source_normal
          "intrinsic String : Type := \"ouro.string\"; def sample : String := \"\\user\";"
          "String" ([92, 117, 115, 101, 114] : List Nat))
    , StringSourceLawOf "source renamed intrinsic and transparent aliases normalize by identity"
        (string_source_normal
          "intrinsic Text : Type := \"ouro.string\"; def String : Type := Text; def PublicText : Type := String; intrinsic join : PublicText -> PublicText -> PublicText := \"ouro.string.concat\"; def sample : PublicText := join \"typed-\" \"String\";"
          "Text" ([116, 121, 112, 101, 100, 45, 83, 116, 114, 105, 110, 103] : List Nat))
    , StringSourceLawOf "source String alias to Empty fails at the literal declaration"
        (string_source_rejects
          "inductive Empty : Type :=; def String : Type := Empty; def forged : Empty := \"bytes\";" 3)
    , StringSourceLawOf "source String alias to UWord fails at the literal declaration"
        (string_source_rejects
          "intrinsic UWord : Type := \"ouro.u32\"; def String : Type := UWord; def forged : UWord := \"bytes\";" 3)
    , StringSourceLawOf "source opaque String fails at the literal declaration"
        (string_source_rejects "axiom String : Type; def forged : String := \"bytes\";" 2)
    , StringSourceLawOf "source alias to an opaque type fails at the literal declaration"
        (string_source_rejects
          "axiom Hidden : Type; def String : Type := Hidden; def forged : Hidden := \"bytes\";" 3)
    ];

def string_source_run : List StringSourceLaw -> Bool -> IO Unit :=
    fix run (laws : List StringSourceLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil => exit (match failed with | True => 1 | False => 0 end)
      | Cons law rest => match law with
          | StringSourceLawOf name passed =>
              do println (prim_string_concat
                   (match passed with | True => "ok " | False => "FAIL " end) name);
                 run(rest, orb(failed, notb passed))
          end
      end;

-- @entry main
def main : IO Unit := string_source_run string_source_laws False;
