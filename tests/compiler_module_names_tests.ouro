-- Focused laws for binding-aware module identity rewriting.
import "../compiler/module_names.ouro",
  "../compiler/module_registry_base.ouro",
  "../compiler/module_registry.ouro",
  "../std/test.ouro";
import "compiler_test_list_equal.ouro";

def module_name_error (A : Type) (code : Nat) (detail : Nat)
    (result : ResolveResult A) : Bool :=
    match result with
    | ROk _ => False
    | RErr actual at => andb(eqNat actual code, eqNat at detail)
    end;

def module_name_ok (A : Type) (result : ResolveResult A) : Bool :=
    match result with
    | ROk _ => True
    | RErr _ _ => False
    end;

def module_name_nat (want : Nat) (result : ResolveResult Nat) : Bool :=
    match result with
    | ROk got => eqNat got want
    | RErr _ _ => False
    end;

def module_name_var (want : Nat) (expr : Expr) : Bool :=
    if let EVar name := (expr : Expr) then eqNat name want else False;

def module_name_lambda (want_name : Nat) (want_value : Nat)
    (expr : Expr) : Bool :=
    if let ELam name _ value := (expr : Expr) then
      andb(eqNat name want_name, module_name_var want_value value)
    else False;

def module_name_fallible (want_failure : Nat) (want_success : Nat)
    (expr : Expr) : Bool :=
    if let EFallible container failure success body := (expr : Expr) then
      andb(module_name_var 30 container,
        andb(eqNat failure want_failure,
          andb(eqNat success want_success, module_name_var 30 body)))
    else False;

def module_name_def (head : Nat) (typ : Nat) (body : Nat)
    (decl : Decl) : Bool :=
    if let DDef name signature value _ _ := (decl : Decl) then
      andb(eqNat name head,
        andb(module_name_var typ signature, module_name_var body value))
    else False;

def module_name_representation (target : Nat) (label : Nat)
    (decl : Decl) : Bool :=
    if let DRepresentation name actual := (decl : Decl) then andb(eqNat name target, eqNat actual label) else False;

def module_name_inductive (head : Nat) (ctor : Nat)
    (decl : Decl) : Bool :=
    if let DInductive name _ _ ctors _ := (decl : Decl) then
      andb (eqNat name head)
        (match ctors with
         | Nil => False
         | Cons pair rest =>
             let (MkPair actual _) := pair in
             andb(eqNat actual ctor,
               match rest with | Nil => True | Cons _ _ => False end)
         end)
    else False;

def module_name_effect (head : Nat) (op : Nat)
    (decl : Decl) : Bool :=
    if let DEffect name _ operations := (decl : Decl) then
      andb (eqNat name head)
        (match operations with
         | Nil => False
         | Cons pair rest =>
             let (MkPair actual _) := pair in
             andb(eqNat actual op,
               match rest with | Nil => True | Cons _ _ => False end)
         end)
    else False;

def module_name_single (check : Decl -> Bool)
    (result : ResolveResult (List Decl)) : Bool :=
    match result with
    | RErr _ _ => False
    | ROk decls =>
        match decls with
        | Nil => False
        | Cons first rest =>
            match rest with
            | Nil => check first
            | Cons _ _ => False
            end
        end
    end;

def module_name_two_defs (result : ResolveResult (List Decl)) : Bool :=
    match result with
    | RErr _ _ => False
    | ROk decls =>
        match decls with
        | Nil => False
        | Cons first rest =>
            match rest with
            | Nil => False
            | Cons second tail =>
                andb(module_name_def 110 2 3 first,
                  andb(module_name_def 110 2 3 second,
                    match tail with | Nil => True | Cons _ _ => False end))
            end
        end
    end;

def module_name_pattern_pair (head : Nat) (bound_name : Nat)
    (result : ResolveResult (Pair Nat (List Nat))) : Bool :=
    match result with
    | RErr _ _ => False
    | ROk pair =>
        let (MkPair actual scope) := pair in andb(eqNat actual head, memNat bound_name scope)
    end;

def module_name_global_rewrite : Bool :=
    module_name_single (module_name_def 110 110 110)
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110] [MkPair Nat Nat 10 110]
        [] [] [] [DDef 10 (EVar 10) (EVar 10) 0 []]);

def module_name_marked_def_metadata : Bool :=
    module_name_single
      (fun (decl : Decl) => if let DDef name _ _ marked declared := (decl : Decl) then
          andb(eqNat name 110,
            andb(eqNat marked 1, eqNat(length DefParam declared) 2))
        else False)
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110] [] [] [] []
        [DDef 10 (EPi 41 (ESort 0) (EPi 42 (EVar 41) (EVar 41)))
          (ELam 41 (Just Expr (ESort 0))
            (ELam 42 (Just Expr (EVar 41)) (EVar 42))) 1
            [DefParamOf 41 41 (Nothing Expr),
              DefParamOf 42 42 (Nothing Expr)]]);

def module_name_duplicate_declarations : Bool :=
    module_name_two_defs
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110] [MkPair Nat Nat 2 2, MkPair Nat Nat 3 3]
        [] [] []
        [DDef 10 (EVar 2) (EVar 3) 0 [],
          DDef 10 (EVar 2) (EVar 3) 0 []]);

def module_name_constructor_head : Bool :=
    module_name_single (module_name_inductive 120 130)
      (module_rewrite_decls 80
        [MkPair Nat Nat 20 120, MkPair Nat Nat 30 130]
        [MkPair Nat Nat 20 120] [] [] [30]
        [DInductive 20 [] (ESort 1)
          [MkPair Nat Expr 30 (EVar 20)] 0]);

def module_name_effect_head : Bool :=
    module_name_single (module_name_effect 140 150)
      (module_rewrite_decls 80
        [MkPair Nat Nat 40 140, MkPair Nat Nat 50 150]
        [MkPair Nat Nat 40 140] [] [] []
        [DEffect 40 [] [MkPair Nat Expr 50 (EVar 40)]]);

def module_name_representation_target : Bool :=
    module_name_single (module_name_representation 160 70)
      (module_rewrite_decls 80 []
        [MkPair Nat Nat 60 160] [] [] []
        [DRepresentation 60 70]);

def module_name_lexical_scope : Bool :=
    andb (module_name_nat 10
      (module_ref [MkPair Nat Nat 10 110] [] [10] 10))
      (module_name_ok (List Decl)
        (module_rewrite_decls 80 [] [] [MkPair Nat Nat 10 5] [] []
          [DDef 20 (EPi 10 (ESort 0) (EVar 10))
            (ELam 10 (Just Expr (ESort 0)) (EVar 10)) 0 []]));

def module_name_fix_scope : Bool :=
    andb (module_name_ok Expr
      (module_rewrite_expr [] [MkPair Nat Nat 11 5] [] [] 80 []
        (EFix 11 (EBinder 12 (ESort 0) ENoBinder)
          (EVar 12) (EVar 11))))
      (module_name_error Expr 5 11
        (module_rewrite_expr [] [MkPair Nat Nat 11 5] [] [] 80 []
          (EFix 11 (EBinder 12 (EVar 11) ENoBinder)
            (EVar 12) (EVar 11))));

def module_name_do_scope : Bool :=
    andb (module_name_ok Expr
      (module_rewrite_expr [] [MkPair Nat Nat 7 5] [] [] 80 []
        (EDo [EDoBind 7 (ENat 1), ESpan 1 2 (EVar 7)])))
      (module_name_error Expr 5 7
        (module_rewrite_expr [] [MkPair Nat Nat 7 5] [] [] 80 []
          (EDo [EDoBind 7 (EVar 7), EVar 7])));

def module_name_constructor_namespace : Bool :=
    andb
      (module_name_pattern_pair 130 7
        (module_pattern_head [MkPair Nat Nat 30 130] [] [] [30] 30 [7]))
      (andb
        (andb
          (module_name_pattern_pair 40 40
            (module_pattern_head [] [] [] [] 40 []))
          (module_name_error (Pair Nat (List Nat)) 5 40
            (module_pattern_head [] [MkPair Nat Nat 40 5] [] [] 40 [])))
        (module_name_ok Expr
          (module_rewrite_expr [MkPair Nat Nat 30 130]
            [MkPair Nat Nat 7 5] [] [30] 80 [30]
            (EBranch [30, 7] (EVar 7) ENoBranch))));

def module_name_qualified_pattern_kind : Bool :=
    andb (module_name_pattern_pair 130 7
      (module_pattern_head [MkPair Nat Nat 99 130] [] [99] [99] 99 [7]))
      (andb (module_name_error (Pair Nat (List Nat)) 8 99
        (module_pattern_head [MkPair Nat Nat 99 130] [] [99] [] 99 []))
        (andb (module_name_error (Pair Nat (List Nat)) 5 99
          (module_pattern_head [] [MkPair Nat Nat 99 5] [99] [] 99 []))
          (andb (module_name_error Expr 8 99
            (module_rewrite_expr [MkPair Nat Nat 99 130] [] [99] [] 80 []
              (EBranch [99] (ENat 0) ENoBranch)))
            (module_name_error Expr 5 99
              (module_rewrite_expr [] [MkPair Nat Nat 99 5] [99] [] 80 []
                (EMultiMatch [ENat 0]
                  [MkPair (List (Pair Nat (List Nat))) Expr
                    [MkPair Nat (List Nat) 99 []] (ENat 0)]))))));

def module_name_marked_ctor_branch : Bool :=
    module_name_ok Expr
      (module_rewrite_expr [MkPair Nat Nat 99 130] [] [99] [99] 80 []
        (EBranch [99, 7] (EVar 7) ENoBranch));

def module_name_pattern_scope : Bool :=
    andb
      (andb
        (module_name_ok Expr
          (module_rewrite_expr [] [] [] [] 80 []
            (EBranch [40] (EVar 40) ENoBranch)))
        (module_name_error Expr 5 40
          (module_rewrite_expr [] [MkPair Nat Nat 40 5] [] [] 80 []
            (EBranch [40] (EVar 40) ENoBranch))))
      (andb
        (module_name_ok Expr
          (module_rewrite_expr [MkPair Nat Nat 30 130]
            [] [] [30] 80 []
            (EMultiMatch [ENat 0, ENat 1]
              [MkPair (List (Pair Nat (List Nat))) Expr
                [MkPair Nat (List Nat) 30 [7],
                 MkPair Nat (List Nat) 40 []]
                (EVar 40)])))
        (module_name_error Expr 5 40
          (module_rewrite_expr [MkPair Nat Nat 30 130]
            [MkPair Nat Nat 40 5] [] [30] 80 []
            (EMultiMatch [ENat 0, ENat 1]
              [MkPair (List (Pair Nat (List Nat))) Expr
                [MkPair Nat (List Nat) 30 [7],
                 MkPair Nat (List Nat) 40 []]
                (EVar 40)]))));

def module_name_wide_pattern_scope : Bool :=
    let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
    let wide : Nat := add lower 1 in
    let constructors : List Nat := [S lower] in
    let refs : List (Pair Nat Nat) := [MkPair Nat Nat wide 130] in
    let binders : List (Pair Nat Nat) :=
      [MkPair Nat Nat 7 17, MkPair Nat Nat 9 19, MkPair Nat Nat 130 131] in
    let same_ids : List Nat -> List Nat -> Bool := compiler_test_list_equal Nat eqNat in
    let same_pattern (pattern : Pair Nat (List Nat)) (other : Pair Nat (List Nat)) : Bool :=
      let (MkPair head vars) := pattern in
      let (MkPair other_head other_vars) := other in
      andb(eqNat head other_head, same_ids vars other_vars) in
    let patterns : List (Pair Nat (List Nat)) :=
      [MkPair Nat (List Nat) wide [9], MkPair Nat (List Nat) 7 [9]] in
    let branch : Bool :=
      match module_branch_pack refs [] [wide] constructors binders [23] [wide, 9, 9] with
      | RErr _ _ => False
      | ROk result =>
          let (MkPair names scope) := result in
          andb(same_ids names [130, 19, 19], same_ids scope [9, 9, 23])
      end in
    let multi : Bool :=
      match module_rewrite_patterns refs [] [wide] constructors binders [23] patterns with
      | RErr _ _ => False
      | ROk result =>
          let (MkPair names scope) := result in
          andb(compiler_test_list_equal (Pair Nat (List Nat)) same_pattern names
            [MkPair Nat (List Nat) 130 [19], MkPair Nat (List Nat) 17 [19]],
            same_ids scope [9, 7, 9, 23])
      end in
    let head_error : Bool :=
      module_name_error (Pair (List Nat) (List Nat)) 5 wide
        (module_branch_pack refs [MkPair Nat Nat (S lower) 5, MkPair Nat Nat wide 6]
          [9] constructors binders [] [wide, 9]) in
    let first_pattern_error : Bool :=
      module_name_error (Pair (List (Pair Nat (List Nat))) (List Nat)) 8 9
        (module_rewrite_patterns refs [MkPair Nat Nat 7 5] [9] constructors binders [] patterns) in
    andb(andb(branch, multi), andb(head_error, first_pattern_error));

def module_name_effect_namespace : Bool :=
    andb (module_name_error Expr 5 50
      (module_rewrite_expr [] [MkPair Nat Nat 50 5] [] [] 80 [50]
        (EEffectRow (ESort 0) [50])))
      (andb (module_name_error Expr 5 50
        (module_rewrite_expr [] [MkPair Nat Nat 50 5] [] [] 80 [50]
          (EPerform 50 [])))
        (module_name_error Expr 5 50
          (module_rewrite_expr [] [MkPair Nat Nat 50 5] [] [] 80 [50]
            (EHandle (ENat 0)
              [MkPair Nat (Pair (List Nat) Expr) 50
                (MkPair (List Nat) Expr [51] (EVar 51))]))));

def module_name_nested_positions : Bool :=
    andb (module_name_error (List Decl) 5 77
      (module_rewrite_decls 80 [] []
        [MkPair Nat Nat 77 5] [] []
        [DIntrinsic 70 (ESort 0) 1 (Just Expr (EVar 77))]))
      (andb (module_name_error (List Decl) 5 77
        (module_rewrite_decls 80 [] []
          [MkPair Nat Nat 77 5] [] []
          [DExtern 70 (EVar 77) []]))
        (module_name_error (List Decl) 5 77
          (module_rewrite_decls 80 [] []
            [MkPair Nat Nat 77 5] [] []
            [DInductive 70 [] (ESort 0)
              [MkPair Nat Expr 71 (EVar 77)] 0])));

def module_name_marker_rejection : Bool :=
    andb (module_name_error (List Decl) 8 99
      (module_rewrite_decls 80 [] [] [] [99] []
        [DDef 99 (ESort 0) (ENat 0) 0 []]))
      (andb (module_name_error (List Decl) 8 99
        (module_rewrite_decls 80 [] [] [] [99] []
          [DInductive 20 [] (ESort 0)
            [MkPair Nat Expr 99 (ESort 0)] 0]))
        (andb (module_name_error (List Decl) 8 99
          (module_rewrite_decls 80 [] [] [] [99] []
            [DDef 20 (ESort 0)
              (ELam 99 (Just Expr (ESort 0)) (EVar 99)) 0 []]))
          (module_name_error Expr 8 99
            (module_rewrite_expr [] [] [99] [30] 80 []
              (EBranch [30, 99] (EVar 99) ENoBranch)))));

def module_name_marker_nested : Bool :=
    andb (module_name_error Expr 8 99
      (module_rewrite_expr [] [] [99] [] 80 []
        (EDo [EDoBind 99 (ENat 0), EVar 99])))
      (andb (module_name_error Expr 8 99
        (module_rewrite_expr [] [] [99] [] 80 []
          (EHandle (ENat 0)
            [MkPair Nat (Pair (List Nat) Expr) 50
              (MkPair (List Nat) Expr [51, 99] (EVar 99))])))
        (module_name_error (List Decl) 8 99
          (module_rewrite_decls 80 [] [] [] [99] []
            [DEffect 20 [MkPair Nat Expr 99 (ESort 0)]
              [MkPair Nat Expr 21 (ESort 0)]])));

def module_name_marker_other_binders : Bool :=
    andb (module_name_error Expr 8 99
      (module_rewrite_expr [] [] [99] [] 80 []
        (EPi 99 (ESort 0) (EVar 99))))
      (andb (module_name_error Expr 8 99
        (module_rewrite_expr [] [] [99] [] 80 []
          (ELet 99 (Nothing Expr) (ENat 0) (EVar 99))))
        (andb (module_name_error Expr 8 99
          (module_rewrite_expr [] [] [99] [] 80 []
            (EFix 99 ENoBinder (ESort 0) (EVar 99))))
          (module_name_error Expr 8 99
            (module_rewrite_expr [] [] [99] [] 80 []
              (EBinder 99 (ESort 0) ENoBinder)))));

def module_name_marker_reference : Bool :=
    andb (module_name_nat 199
      (module_ref [MkPair Nat Nat 99 199] [] [] 99))
      (module_name_single (module_name_representation 199 70)
        (module_rewrite_decls 80 []
          [MkPair Nat Nat 99 199] [] [99] []
          [DRepresentation 99 70]));

def module_name_map_errors : Bool :=
    andb (module_name_error (List Decl) 8 10
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110, MkPair Nat Nat 10 111] [] [] [] [] []))
      (andb (module_name_error (List Decl) 8 10
        (module_rewrite_decls 80 []
          [MkPair Nat Nat 10 110, MkPair Nat Nat 10 111] [] [] [] []))
        (andb (module_name_error (List Decl) 8 10
          (module_rewrite_decls 80 [] []
            [MkPair Nat Nat 10 5, MkPair Nat Nat 10 6] [] [] []))
          (module_name_error (List Decl) 8 10
            (module_rewrite_decls 80 []
              [MkPair Nat Nat 10 110] [MkPair Nat Nat 10 5] [] [] []))));

def module_name_invalid_code_and_fuel : Bool :=
    andb (module_name_error (List Decl) 8 10
      (module_rewrite_decls 80 [] []
        [MkPair Nat Nat 10 4] [] [] []))
      (andb (module_name_error (List Decl) 7 0
        (module_rewrite_decls 0 [] [] [] [] [] []))
        (module_name_error (List Decl) 7 0
          (module_rewrite_decls 1 [] [] [] [] []
            [DDef 20 (ESort 0)
              (ELam 30 (Just Expr (ESort 0)) (EVar 30)) 0 []])));

def module_name_reference_errors : Bool :=
    andb (module_name_error (List Decl) 5 77
      (module_rewrite_decls 80 [] []
        [MkPair Nat Nat 77 5] [] []
        [DRepresentation 77 1]))
      (module_name_error (List Decl) 6 77
        (module_rewrite_decls 80 [] []
          [MkPair Nat Nat 77 6] [] []
          [DDef 20 (ESort 0) (EVar 77) 0 []]));

def module_name_representation_marker_errors : Bool :=
    andb (module_name_error (List Decl) 5 99
      (module_rewrite_decls 80 [] []
        [MkPair Nat Nat 99 5] [99] []
        [DRepresentation 99 70]))
      (module_name_error (List Decl) 6 99
        (module_rewrite_decls 80 [] []
          [MkPair Nat Nat 99 6] [99] []
          [DRepresentation 99 70]));

def module_name_binder_hygiene : Bool :=
    let refs : List (Pair Nat Nat) := [MkPair Nat Nat 99 10] in
    let binders : List (Pair Nat Nat) := [MkPair Nat Nat 10 210] in
    let global : ResolveResult Expr :=
      module_rewrite_expr_with_binders refs [] [99] [] binders 80 []
        (ELam 10 (Nothing Expr) (EVar 99)) in
    let local : ResolveResult Expr :=
      module_rewrite_expr_with_binders refs [] [99] [] binders 80 []
        (ELam 10 (Nothing Expr) (EVar 10)) in
    andb
      (match global with
       | ROk expr => module_name_lambda 210 10 expr
       | RErr _ _ => False
       end)
      (match local with
       | ROk expr => module_name_lambda 210 210 expr
       | RErr _ _ => False
       end);

def module_name_scoped_open : Bool :=
    let opened : List ModuleOpen :=
      [ MkModuleOpen 10 [MkPair Nat Nat 5 105] []
      , MkModuleOpen 11 [MkPair Nat Nat 5 205] []
      ] in
    let errors : List (Pair Nat Nat) := [MkPair Nat Nat 5 6] in
    let binders : List (Pair Nat Nat) := [MkPair Nat Nat 5 305] in
    let rewrite : Expr -> ResolveResult Expr :=
      module_rewrite_expr_with_opens [] errors opened [] [] binders 80 [] in
    andb (match rewrite (EOpen 10 (EVar 5)) with
      | ROk expr => module_name_var 105 expr
      | RErr _ _ => False end,
    andb (match rewrite (EOpen 10 (EOpen 11 (EVar 5))) with
      | ROk expr => module_name_var 205 expr
      | RErr _ _ => False end,
    andb (match rewrite (EOpen 11 (ELam 5 (Nothing Expr) (EVar 5))) with
      | ROk expr => module_name_lambda 305 305 expr
      | RErr _ _ => False end,
    andb (module_name_error Expr 6 5
      (rewrite (EApp (EOpen 10 (EVar 5)) (EVar 5))),
    andb (module_name_error Expr 8 12 (rewrite (EOpen 12 (EVar 5))),
      module_name_error Expr 6 5 (rewrite (EVar 5)))))));

def module_name_fallible_roles_in_open : Bool :=
  let opened : List ModuleOpen :=
    [MkModuleOpen 10 [MkPair Nat Nat 20 120, MkPair Nat Nat 21 121]
      [20, 21]] in
  let rewrite : Expr -> ResolveResult Expr :=
    module_rewrite_expr_with_opens [] [] opened [] [] [] 80 [] in
  andb
    (match rewrite (EOpen 10 (EFallible (EVar 30) 20 21 (EVar 30))) with
    | ROk expr => module_name_fallible 120 121 expr
    | RErr _ _ => False
    end)
    (module_name_error Expr 8 22
      (rewrite (EOpen 10 (EFallible (EVar 30) 20 22 (EVar 30)))));

def module_collision_previous (seeds : List (Pair Nat Nat))
    (units : List SrcUnit) : Maybe Nat :=
  (fix go (rows : List (Pair Nat Nat)) : Maybe Nat :=
    match rows with
    | Nil => Nothing Nat
    | Cons row rest => let (MkPair owner name) := row in
      if module_is_private owner name units then go rest
      else
        match (fix find (others : List (Pair Nat Nat)) : Bool :=
          match others with
          | Nil => False
          | Cons other tail => let (MkPair path short) := other in
            if
              andb(eqNat name short,
                andb(notb(eqNat owner path),
                  notb(module_is_private path short units))) then
              True
            else find tail
          end) rest with
        | True => Just Nat name
        | False => go rest
        end
    end) seeds;

def module_collision_equal (left : Maybe Nat) (right : Maybe Nat) : Bool :=
  match left with
  | Nothing => match right with | Nothing => True | Just _ => False end
  | Just name => match right with | Nothing => False | Just other => eqNat name other end
  end;

def module_collision_case (seeds : List (Pair Nat Nat)) (units : List SrcUnit)
    (wanted : Maybe Nat) : Bool :=
  let actual : Maybe Nat := module_public_collision seeds units in
  andb(module_collision_equal actual wanted,
    module_collision_equal actual (module_collision_previous seeds units));

def module_collision_unit (owner : Nat) (name : Nat) (hidden : Bool) : SrcUnit :=
  mk_src_unit owner [DAxiom name (ESort 0)]
    (match hidden with | True => [name] | False => [] end);

def module_conflicts_previous (seeds : List (Pair Nat Nat)) : List Nat :=
  (fix go (rows : List (Pair Nat Nat)) (found : List Nat)
      : List Nat :=
    match rows with
    | Nil => found
    | Cons row rest =>
        let (MkPair owner name) := row in
        if memNat name found then go rest found
        else
          if module_name_conflicts owner name seeds then go rest (Cons Nat name found)
          else go rest found
    end) seeds (Nil Nat);

def module_conflicts_equal : List Nat -> List Nat -> Bool :=
  compiler_test_list_equal Nat eq_nat;

def module_conflict_test_bounds (lower : Maybe Nat) (upper : Maybe Nat) (key : Nat) : Bool :=
  andb (match lower with | Nothing => True | Just bound => ltb_nat bound key end)
    (match upper with | Nothing => True | Just bound => ltb_nat key bound end);

def module_conflict_test_valid : ModuleConflictIndex -> Maybe Nat -> Maybe Nat -> Bool :=
  fix valid (tree : ModuleConflictIndex) (lower : Maybe Nat) (upper : Maybe Nat) : Bool :=
    match tree with
    | ModuleConflictIndexEmpty => True
    | ModuleConflictIndexNode height key _ left right =>
        andb (module_conflict_test_bounds lower upper key)
          (andb (eq_nat height (S (maxNat(module_conflict_index_height left, module_conflict_index_height right))))
            (andb (leb_nat(module_conflict_index_height left, S (module_conflict_index_height right)))
              (andb (leb_nat(module_conflict_index_height right, S (module_conflict_index_height left)))
                (andb(valid left lower (Just Nat key), valid right (Just Nat key) upper)))))
    end;

def module_conflict_test_complete (tree : ModuleConflictIndex) : List (Pair Nat Nat) -> Bool :=
  fix complete (rows : List (Pair Nat Nat)) : Bool :=
    match rows with
    | Nil => True
    | Cons row rest => let (MkPair _ name) := row in
      match module_conflict_index_lookup (add name Z) tree with
      | Nothing => False
      | Just state => if let ModuleConflictReported := (state : ModuleConflictValue) then False else complete rest
      end
    end;

def module_conflicts_case (seeds : List (Pair Nat Nat)) (wanted : List Nat) : Bool :=
  let tree : ModuleConflictIndex := module_conflict_index_from seeds in
  let actual : List Nat := module_conflict_names seeds in
  andb(module_conflicts_equal actual wanted,
    andb(module_conflicts_equal actual (module_conflicts_previous seeds),
      andb(module_conflict_test_valid tree (Nothing Nat) (Nothing Nat),
        module_conflict_test_complete tree seeds)));

def module_conflict_test_pairs (offset : Nat) : List Nat -> List (Pair Nat Nat) :=
  fix pairs (names : List Nat) : List (Pair Nat Nat) :=
    match names with
    | Nil => Nil (Pair Nat Nat)
    | Cons name rest => Cons (Pair Nat Nat) (MkPair Nat Nat (add name offset) name) (pairs rest)
    end;

def module_conflict_test_order (names : List Nat) (wanted : List Nat) : Bool :=
  let first : List (Pair Nat Nat) := module_conflict_test_pairs 1 names in
  let other : List (Pair Nat Nat) := module_conflict_test_pairs 2 names in
  andb(module_conflicts_case (append (Pair Nat Nat) first first) (Nil Nat),
    module_conflicts_case (append (Pair Nat Nat) first other) wanted);

def module_conflict_test_range (count : Nat) : List Nat :=
  (fix names (remaining : Nat) (key : Nat) : List Nat :=
    match remaining with
    | Z => Nil Nat
    | S next => Cons Nat key (names next (S key))
    end) count Z;

def module_conflict_test_scale (descending : Bool) (colliding : Bool) : Bool :=
  let ascending : List Nat := module_conflict_test_range 128 in
  let names : List Nat := match descending with | True => reverse Nat ascending | False => ascending end in
  let first : List (Pair Nat Nat) := module_conflict_test_pairs 1 names in
  let other : List (Pair Nat Nat) := module_conflict_test_pairs 2 names in
  let seeds : List (Pair Nat Nat) := append (Pair Nat Nat) first
    (match colliding with | True => other | False => first end) in
  let wanted : List Nat := match colliding with | True => reverse Nat names | False => Nil Nat end in
  andb(module_conflicts_case seeds wanted,
    leb_nat(module_conflict_index_height (module_conflict_index_from seeds)) 12);

def module_members_previous (st0 : InternState) (root : Nat) (reached : List Nat)
    (conflicts : List Nat) (seeds : List (Pair Nat Nat))
    (units : List SrcUnit) (isolate : Bool)
    : ResolveResult (Pair (List ModuleMember) InternState) :=
  (fix go (rows : List (Pair Nat Nat)) (st : InternState)
      : ResolveResult (Pair (List ModuleMember) InternState) :=
    match rows with
    | Nil => ROk (Pair (List ModuleMember) InternState)
        (MkPair (List ModuleMember) InternState (Nil ModuleMember) st)
    | Cons row rest =>
        let (MkPair owner name) := row in
        let collision : Bool := orb(isolate, memNat name conflicts) in
        let public : Bool := notb(module_is_private owner name units) in
        if andb collision (notb(eqNat owner root)) then
          match module_ordinal owner reached with
          | Nothing => RErr (Pair (List ModuleMember) InternState) 8 owner
          | Just ordinal =>
              let generated : List Nat :=
                module_symbol_bytes ordinal (name_of_id st name) in
              let (MkIntern ids _ _ _) := st in
              match source_lookup_id ids generated with
              | Just existing =>
                  RErr (Pair (List ModuleMember) InternState) 8 existing
              | Nothing =>
                  let (MkPair symbol next_st) := intern_ident st generated in
                  match go rest next_st with
                  | RErr code detail =>
                      RErr (Pair (List ModuleMember) InternState) code detail
                  | ROk result =>
                      let (MkPair tail final_st) := result in
                      ROk (Pair (List ModuleMember) InternState)
                        (MkPair (List ModuleMember) InternState
                          (Cons ModuleMember
                            (MkModuleMember owner name symbol public) tail)
                          final_st)
                  end
              end
          end
        else
          match go rest st with
          | RErr code detail =>
              RErr (Pair (List ModuleMember) InternState) code detail
          | ROk result =>
              let (MkPair tail final_st) := result in
              ROk (Pair (List ModuleMember) InternState)
                (MkPair (List ModuleMember) InternState
                  (Cons ModuleMember (MkModuleMember owner name name public) tail)
                  final_st)
          end
    end) seeds st0;

def module_members_bool_equal (left : Bool) (right : Bool) : Bool :=
  if left then match right with | True => True | False => False end
  else match right with | True => False | False => True end;

def module_members_table_equal
    : List (Pair (List Nat) Nat) -> List (Pair (List Nat) Nat) -> Bool :=
  compiler_test_list_equal (Pair (List Nat) Nat)
    (fun (row : Pair (List Nat) Nat) (other : Pair (List Nat) Nat) =>
      let (MkPair spelling id) := row in
      let (MkPair other_spelling other_id) := other in
      andb(source_bytes_equal spelling other_spelling, eqNat id other_id));

def module_members_intern_equal (left : InternState) (right : InternState) : Bool :=
  let (MkIntern ids next_id strings next_string) := left in
  let (MkIntern other_ids other_next other_strings other_next_string) :=
    right in
  andb(module_members_table_equal ids other_ids,
    andb(eqNat next_id other_next,
      andb(module_members_table_equal strings other_strings,
        eqNat next_string other_next_string)));

def module_members_list_equal : List ModuleMember -> List ModuleMember -> Bool :=
  compiler_test_list_equal ModuleMember
    (fun (row : ModuleMember) (other : ModuleMember) =>
      let (MkModuleMember owner name symbol public) := row in
      let (MkModuleMember other_owner other_name other_symbol other_public) := other in
      andb(eqNat owner other_owner, andb(eqNat name other_name,
        andb(eqNat symbol other_symbol, module_members_bool_equal public other_public))));

def module_members_result_equal
    (left : ResolveResult (Pair (List ModuleMember) InternState))
    (right : ResolveResult (Pair (List ModuleMember) InternState)) : Bool :=
  match left with
  | RErr code detail => match right with
    | RErr other_code other_detail => andb(eqNat code other_code, eqNat detail other_detail)
    | ROk _ => False
    end
  | ROk result => match right with
    | RErr _ _ => False
    | ROk other => let (MkPair members state) := result in
      let (MkPair other_members other_state) := other in
      andb(module_members_list_equal members other_members,
        module_members_intern_equal state other_state)
    end
  end;

def module_members_case (state : InternState) (root : Nat) (reached : List Nat)
    (conflicts : List Nat) (seeds : List (Pair Nat Nat))
    (units : List SrcUnit) (isolate : Bool)
    (wanted : ResolveResult (Pair (List ModuleMember) InternState)) : Bool :=
  let actual : ResolveResult (Pair (List ModuleMember) InternState) :=
    module_members state root reached conflicts seeds units isolate in
  andb(module_members_result_equal actual wanted,
    module_members_result_equal actual
      (module_members_previous state root reached conflicts seeds units isolate));

def module_members_test_entry (spelling : String) (id : Nat) : Pair (List Nat) Nat :=
  MkPair (List Nat) Nat (prim_string_to_char_codes spelling) id;

def module_members_test_state (ids : List (Pair (List Nat) Nat)) (next : Nat) : InternState :=
  MkIntern ids next
    [module_members_test_entry "kept" 9, module_members_test_entry "kept" 10,
      module_members_test_entry "" 0] 11;

def module_members_test_ok (members : List ModuleMember) (state : InternState)
    : ResolveResult (Pair (List ModuleMember) InternState) :=
  ROk (Pair (List ModuleMember) InternState)
    (MkPair (List ModuleMember) InternState members state);

def module_members_test_error (detail : Nat)
    : ResolveResult (Pair (List ModuleMember) InternState) :=
  RErr (Pair (List ModuleMember) InternState) 8 detail;

def module_members_rotation_case (ids : List (Pair (List Nat) Nat)) : Bool :=
  module_members_case (module_members_test_state ids 10) 0 [1] []
    [MkPair Nat Nat 1 1, MkPair Nat Nat 1 2, MkPair Nat Nat 1 3] [] True
    (module_members_test_ok
      [MkModuleMember 1 1 10 True, MkModuleMember 1 2 11 True, MkModuleMember 1 3 12 True]
      (module_members_test_state
        (append (Pair (List Nat) Nat)
          [module_members_test_entry "_ouro_m_0_c" 12,
            module_members_test_entry "_ouro_m_0_b" 11,
            module_members_test_entry "_ouro_m_0_a" 10] ids) 13));

def module_name_laws : List Test :=
    [ assert_true "module head/reference remap" module_name_global_rewrite
    , assert_true "marked definition metadata survives head remap"
        module_name_marked_def_metadata
    , assert_true "duplicate declarations remain for checker" module_name_duplicate_declarations
    , assert_true "constructor heads" module_name_constructor_head
    , assert_true "effect heads" module_name_effect_head
    , assert_true "representation target, label preserved" module_name_representation_target
    , assert_true "lexical lambda and Pi scope" module_name_lexical_scope
    , assert_true "recursive binder only in body" module_name_fix_scope
    , assert_true "do binder starts after action" module_name_do_scope
    , assert_true "constructor namespace beats local binder" module_name_constructor_namespace
    , assert_true "qualified patterns require constructor targets" module_name_qualified_pattern_kind
    , assert_true "qualified constructor branch rewrites" module_name_marked_ctor_branch
    , assert_true "variable patterns and multi-match scope" module_name_pattern_scope
    , assert_true "wide patterns preserve scope and error order" module_name_wide_pattern_scope
    , assert_true "effect labels ignore term binders" module_name_effect_namespace
    , assert_true "specialization, extern, constructor type traversal" module_name_nested_positions
    , assert_true "marker declaration and local rejection" module_name_marker_rejection
    , assert_true "marker nested binder rejection" module_name_marker_nested
    , assert_true "marker Pi, let, fix, telescope rejection" module_name_marker_other_binders
    , assert_true "marker references remain legal" module_name_marker_reference
    , assert_true "malformed maps rejected" module_name_map_errors
    , assert_true "invalid code and fuel rejected" module_name_invalid_code_and_fuel
    , assert_true "unknown and ambiguous reference codes" module_name_reference_errors
    , assert_true "representation marker preserves unknown and ambiguous errors"
        module_name_representation_marker_errors
    , assert_true "qualified globals survive lexical shadows" module_name_binder_hygiene
    , assert_true "wide binder remaps keep the first binding ahead of reference errors"
        (let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
         let name : Nat := add lower 1 in
         let equivalent : Nat := S lower in
         let refs : List (Pair Nat Nat) := [MkPair Nat Nat name 70] in
         let errors : List (Pair Nat Nat) := [MkPair Nat Nat name 6] in
         let binders : List (Pair Nat Nat) := [MkPair Nat Nat name 7, MkPair Nat Nat equivalent 8] in
         andb(module_name_nat 7
             (module_ref_with_binders refs errors binders [equivalent] name),
           andb(module_name_nat 7 (module_ref_with_binders refs errors binders [7] equivalent),
             module_name_error Nat 6 name
               (module_ref_with_binders refs errors [MkPair Nat Nat name equivalent] [7] name))))
    , assert_true "scoped opens select innermost owner without leaking" module_name_scoped_open
    , assert_true "fallible constructor roles resolve inside open" module_name_fallible_roles_in_open
    , assert_true "public collision accepts empty and distinct names"
        (andb(module_collision_case [] [] (Nothing Nat),
          module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat 2 8]
            [module_collision_unit 1 7 False, module_collision_unit 2 8 False]
            (Nothing Nat)))
    , assert_true "public collision accepts repeated rows of one owner"
        (module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat 1 7]
          [module_collision_unit 1 7 False] (Nothing Nat))
    , assert_true "public collision rejects equal names from distinct owners"
        (module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat 2 7]
          [module_collision_unit 1 7 False, module_collision_unit 2 7 False]
          (Just Nat 7))
    , assert_true "public collision skips an earlier private row"
        (module_collision_case
          [MkPair Nat Nat 1 7, MkPair Nat Nat 2 7, MkPair Nat Nat 3 7]
          [module_collision_unit 1 7 True, module_collision_unit 2 7 False,
            module_collision_unit 3 7 False] (Just Nat 7))
    , assert_true "public collision accepts a later private candidate"
        (module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat 2 7]
          [module_collision_unit 1 7 False, module_collision_unit 2 7 True]
          (Nothing Nat))
    , assert_true "public collision continues after a private candidate"
        (module_collision_case
          [MkPair Nat Nat 1 7, MkPair Nat Nat 2 7, MkPair Nat Nat 3 7]
          [module_collision_unit 1 7 False, module_collision_unit 2 7 True,
            module_collision_unit 3 7 False] (Just Nat 7))
    , assert_true "public collision retains first seed-row priority"
        (module_collision_case
          [MkPair Nat Nat 1 7, MkPair Nat Nat 2 8,
            MkPair Nat Nat 3 8, MkPair Nat Nat 4 7]
          [module_collision_unit 1 7 False, module_collision_unit 2 8 False,
            module_collision_unit 3 8 False, module_collision_unit 4 7 False]
          (Just Nat 7))
    , assert_true "public collision keeps unknown owner public"
        (module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat 99 7]
          [module_collision_unit 1 7 False] (Just Nat 7))
    , assert_true "public collision keeps first matching source privacy"
        (andb(module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat 2 7]
            [module_collision_unit 1 7 False, module_collision_unit 1 7 True,
              module_collision_unit 2 7 False] (Just Nat 7),
          module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat 2 7]
            [module_collision_unit 1 7 True, module_collision_unit 1 7 False,
              module_collision_unit 2 7 False] (Nothing Nat)))
    , assert_true "public collision preserves Peano and wide identities"
        (andb(module_collision_case [MkPair Nat Nat 1 (S (S Z)), MkPair Nat Nat 2 2]
            [module_collision_unit 1 2 False, module_collision_unit 2 2 False]
            (Just Nat 2),
          module_collision_case
            [MkPair Nat Nat 1 (add (pow_nat 2 32) 1), MkPair Nat Nat 2 (add (pow_nat 2 32) 1)]
            [module_collision_unit 1 (add (pow_nat 2 32) 1) False,
              module_collision_unit 2 (add (pow_nat 2 32) 1) False] (Just Nat (add (pow_nat 2 32) 1))))
    , assert_true "conflict index accepts empty singleton and distinct names"
        (andb (module_conflicts_case ([] : List (Pair Nat Nat)) ([] : List Nat))
          (andb (module_conflicts_case ([MkPair Nat Nat 0 0] : List (Pair Nat Nat)) ([] : List Nat))
            (module_conflicts_case
              ([MkPair Nat Nat 1 7, MkPair Nat Nat 2 8, MkPair Nat Nat 3 9] : List (Pair Nat Nat)) ([] : List Nat))))
    , assert_true "conflict index keeps same-owner and zero duplicates nonconflicting"
        (andb (module_conflicts_case
            ([MkPair Nat Nat 1 7, MkPair Nat Nat 1 7, MkPair Nat Nat 1 7] : List (Pair Nat Nat)) ([] : List Nat))
          (module_conflicts_case
            ([MkPair Nat Nat Z Z, MkPair Nat Nat 0 0] : List (Pair Nat Nat)) ([] : List Nat)))
    , assert_true "conflict index retains zero and unequal Peano owner conflicts"
        (andb (module_conflicts_case
            ([MkPair Nat Nat Z Z, MkPair Nat Nat (S Z) 0] : List (Pair Nat Nat)) ([Z] : List Nat))
          (module_conflicts_case
            ([MkPair Nat Nat (S (S Z)) 7, MkPair Nat Nat (S (S (S Z))) 7] : List (Pair Nat Nat)) ([7] : List Nat)))
    , assert_true "conflict index reverses first occurrence rather than discovery"
        (module_conflicts_case
          ([MkPair Nat Nat 1 7, MkPair Nat Nat 2 8, MkPair Nat Nat 3 8, MkPair Nat Nat 4 7] : List (Pair Nat Nat))
          ([8, 7] : List Nat))
    , assert_true "conflict index reports interleaved duplicates and three owners once"
        (andb (module_conflicts_case
            ([MkPair Nat Nat 0 7, MkPair Nat Nat 0 7, MkPair Nat Nat 1 8,
              MkPair Nat Nat 0 8, MkPair Nat Nat 2 7, MkPair Nat Nat 3 7] : List (Pair Nat Nat)) ([8, 7] : List Nat))
          (module_conflicts_case
            ([MkPair Nat Nat 1 9, MkPair Nat Nat 2 9, MkPair Nat Nat 3 9, MkPair Nat Nat 1 9] : List (Pair Nat Nat))
            ([9] : List Nat)))
    , assert_true "conflict index equates mixed Peano numeral names and owners"
        (andb (module_conflicts_case
            ([MkPair Nat Nat 1 (S (S Z)), MkPair Nat Nat 2 2] : List (Pair Nat Nat)) ([S (S Z)] : List Nat))
          (module_conflicts_case
            ([MkPair Nat Nat (S (S Z)) 7, MkPair Nat Nat 2 7] : List (Pair Nat Nat)) ([] : List Nat)))
    , assert_true "conflict index distinguishes full-width keys and preserves their order"
        (andb (module_conflicts_case
            ([MkPair Nat Nat 1 1, MkPair Nat Nat 2 (add (pow_nat 2 32) 1)] : List (Pair Nat Nat)) ([] : List Nat))
          (module_conflicts_case
            ([MkPair Nat Nat 1 0, MkPair Nat Nat 2 (pow_nat 2 32), MkPair Nat Nat 3 1, MkPair Nat Nat 4 (add (pow_nat 2 32) 1),
              MkPair Nat Nat 5 0, MkPair Nat Nat 6 (pow_nat 2 32), MkPair Nat Nat 7 1, MkPair Nat Nat 8 (add (pow_nat 2 32) 1)]
              : List (Pair Nat Nat)) ([(add (pow_nat 2 32) 1), 1, (pow_nat 2 32), 0] : List Nat)))
    , assert_true "conflict index distinguishes wide owners without inventing conflicts"
        (andb (module_conflicts_case
            ([MkPair Nat Nat 1 7, MkPair Nat Nat (add (pow_nat 2 32) 1) 7] : List (Pair Nat Nat)) ([7] : List Nat))
          (module_conflicts_case
            ([MkPair Nat Nat (add (pow_nat 2 32) 1) 7, MkPair Nat Nat (add (pow_nat 2 32) 1) 7] : List (Pair Nat Nat)) ([] : List Nat)))
    , assert_true "conflict index distinguishes keys beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_conflicts_case
            ([MkPair Nat Nat 1 wide, MkPair Nat Nat 2 7, MkPair Nat Nat 3 wide, MkPair Nat Nat 4 7]
              : List (Pair Nat Nat)) ([7, wide] : List Nat))
    , assert_true "conflict index distinguishes owners beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_conflicts_case
            ([MkPair Nat Nat 7 3, MkPair Nat Nat wide 3] : List (Pair Nat Nat)) ([3] : List Nat))
    , assert_true "conflict index left-left rotation retains payload and order"
        (module_conflict_test_order ([30, 20, 10] : List Nat) ([10, 20, 30] : List Nat))
    , assert_true "conflict index right-right rotation retains payload and order"
        (module_conflict_test_order ([10, 20, 30] : List Nat) ([30, 20, 10] : List Nat))
    , assert_true "conflict index left-right rotation retains payload and order"
        (module_conflict_test_order ([30, 10, 20] : List Nat) ([20, 10, 30] : List Nat))
    , assert_true "conflict index right-left rotation retains payload and order"
        (module_conflict_test_order ([10, 30, 20] : List Nat) ([20, 30, 10] : List Nat))
    , assert_true "conflict index balances ascending complete same-owner and conflict rows"
        (andb(module_conflict_test_scale False False, module_conflict_test_scale False True))
    , assert_true "conflict index balances descending complete same-owner and conflict rows"
        (andb(module_conflict_test_scale True False, module_conflict_test_scale True True))
    , assert_true "public collision preserves empty and mixed zero same-owner rows"
        (andb(module_collision_case [] [module_collision_unit 2 0 True] (Nothing Nat),
          module_collision_case
            [MkPair Nat Nat (S (S Z)) Z, MkPair Nat Nat 2 0, MkPair Nat Nat (S (S Z)) Z]
            [] (Nothing Nat)))
    , assert_true "public collision chooses first of three names rather than discovery"
        (andb(module_collision_case
            [MkPair Nat Nat 1 30, MkPair Nat Nat 2 20, MkPair Nat Nat 3 10,
              MkPair Nat Nat 4 10, MkPair Nat Nat 5 20, MkPair Nat Nat 6 30]
            [] (Just Nat 30),
          module_collision_case
            [MkPair Nat Nat 3 10, MkPair Nat Nat 2 20, MkPair Nat Nat 1 30,
              MkPair Nat Nat 6 30, MkPair Nat Nat 5 20, MkPair Nat Nat 4 10]
            [] (Just Nat 10)))
    , assert_true "public collision filters all-private and mixed-private first names"
        (let seeds : List (Pair Nat Nat) :=
            [MkPair Nat Nat 1 7, MkPair Nat Nat 2 8, MkPair Nat Nat 3 8, MkPair Nat Nat 4 7] in
          andb(module_collision_case seeds
              [module_collision_unit 1 7 True, module_collision_unit 2 8 True,
                module_collision_unit 3 8 True, module_collision_unit 4 7 True]
              (Nothing Nat),
            module_collision_case seeds
              [module_collision_unit 1 7 True, module_collision_unit 2 8 False,
                module_collision_unit 3 8 False, module_collision_unit 4 7 False]
              (Just Nat 8)))
    , assert_true "public collision keeps duplicate source first-owner and missing-owner priority"
        (let seeds : List (Pair Nat Nat) :=
            [MkPair Nat Nat 1 7, MkPair Nat Nat 99 7, MkPair Nat Nat 2 8, MkPair Nat Nat 3 8] in
          andb(module_collision_case seeds
              [module_collision_unit 1 7 True, module_collision_unit 1 7 False,
                module_collision_unit 2 8 False, module_collision_unit 3 8 False]
              (Just Nat 8),
            module_collision_case seeds
              [module_collision_unit 1 7 False, module_collision_unit 1 7 True,
                module_collision_unit 2 8 False, module_collision_unit 3 8 False]
              (Just Nat 7)))
    , assert_true "public collision distinguishes names and owners above 32 bits"
        (let wide : Nat := add (pow_nat 2 32) 1 in
          andb(module_collision_case [MkPair Nat Nat 1 1, MkPair Nat Nat 2 wide]
              [] (Nothing Nat),
            andb(module_collision_case [MkPair Nat Nat 1 7, MkPair Nat Nat wide 7]
                [module_collision_unit 1 7 False, module_collision_unit wide 7 False]
                (Just Nat 7),
              module_collision_case [MkPair Nat Nat wide 7, MkPair Nat Nat wide 7]
                [module_collision_unit wide 7 False] (Nothing Nat))))
    , assert_true "public collision preserves name priority and distinction above 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          andb(module_collision_case [MkPair Nat Nat 1 wide, MkPair Nat Nat 2 7]
              [] (Nothing Nat),
            module_collision_case
              [MkPair Nat Nat 1 wide, MkPair Nat Nat 2 7, MkPair Nat Nat 3 7, MkPair Nat Nat 4 wide]
              [] (Just Nat wide)))
    , assert_true "public collision preserves owner equality and first privacy above 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          andb(module_collision_case [MkPair Nat Nat 7 9, MkPair Nat Nat wide 9]
              [] (Just Nat 9),
            andb(module_collision_case [MkPair Nat Nat wide 9, MkPair Nat Nat (add wide Z) 9]
                [] (Nothing Nat),
              andb(module_collision_case [MkPair Nat Nat wide wide, MkPair Nat Nat 7 wide]
                  [module_collision_unit wide wide True, module_collision_unit wide wide False,
                    module_collision_unit 7 wide False] (Nothing Nat),
                module_collision_case [MkPair Nat Nat wide wide, MkPair Nat Nat 7 wide]
                  [module_collision_unit wide wide False, module_collision_unit wide wide True,
                    module_collision_unit 7 wide False] (Just Nat wide)))))
    , assert_true "public collision retains wide fan-in first-seed priority"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          let names : List Nat :=
            map Nat Nat (fun (key : Nat) => add wide key) (module_conflict_test_range 64) in
          let first : List (Pair Nat Nat) := module_conflict_test_pairs 1 names in
          let other : List (Pair Nat Nat) := module_conflict_test_pairs 2 (reverse Nat names) in
          andb(module_collision_case (append (Pair Nat Nat) first first) [] (Nothing Nat),
            module_collision_case (append (Pair Nat Nat) first other) [] (Just Nat wide)))
    , assert_true "members preserve empty no-remap and root-only states"
        (let ids : List (Pair (List Nat) Nat) :=
            [module_members_test_entry "alpha" 7] in
          let state : InternState := module_members_test_state ids 0 in
          andb(module_members_case state 0 [] [] [] [] True
              (module_members_test_ok [] state),
            andb(module_members_case state 0 [] [] [MkPair Nat Nat 99 7] [] False
                (module_members_test_ok [MkModuleMember 99 7 7 True] state),
              module_members_case state 0 [] [7] [MkPair Nat Nat 0 7] [] True
                (module_members_test_ok [MkModuleMember 0 7 7 True] state))))
    , assert_true "members retain missing-ordinal error priority"
        (let state : InternState := module_members_test_state
            [module_members_test_entry "_ouro_m_0_alpha" 21,
              module_members_test_entry "alpha" 7] 10 in
          andb(module_members_case state 0 [] [] [MkPair Nat Nat 1 7] [] True
              (module_members_test_error 1),
            module_members_case state 0 [1] []
              [MkPair Nat Nat 2 7, MkPair Nat Nat 1 7] [] True
              (module_members_test_error 2)))
    , assert_true "members preserve assigned IDs complete state and output order"
        (let ids : List (Pair (List Nat) Nat) :=
            [module_members_test_entry "alpha" 7] in
          module_members_case (module_members_test_state ids 10) 0 [1, 2] [7]
            [MkPair Nat Nat 1 7, MkPair Nat Nat 2 7] [] False
            (module_members_test_ok [MkModuleMember 1 7 10 True, MkModuleMember 2 7 11 True]
              (module_members_test_state
                [module_members_test_entry "_ouro_m_1_alpha" 11,
                  module_members_test_entry "_ouro_m_0_alpha" 10,
                  module_members_test_entry "alpha" 7] 12)))
    , assert_true "members reject a repeated generated spelling with its assigned ID"
        (module_members_case (module_members_test_state
            [module_members_test_entry "alpha" 7] 10) 0 [1] []
          [MkPair Nat Nat 1 7, MkPair Nat Nat 1 7] [] True
          (module_members_test_error 10))
    , assert_true "members preserve absent and first empty ID spellings"
        (andb(module_members_case (module_members_test_state [] 10) 0 [1] []
            [MkPair Nat Nat 1 7] [] True
            (module_members_test_ok [MkModuleMember 1 7 10 True]
              (module_members_test_state [module_members_test_entry "_ouro_m_0_" 10] 11)),
          module_members_case (module_members_test_state
              [module_members_test_entry "" 7, module_members_test_entry "alpha" 7] 10)
            0 [1] [] [MkPair Nat Nat 1 7] [] True
            (module_members_test_ok [MkModuleMember 1 7 10 True]
              (module_members_test_state
                [module_members_test_entry "_ouro_m_0_" 10,
                  module_members_test_entry "" 7, module_members_test_entry "alpha" 7] 11))))
    , assert_true "members retain the first initial duplicate ID"
        (module_members_case (module_members_test_state
            [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 7] 10)
          0 [1] [] [MkPair Nat Nat 1 7] [] True
          (module_members_test_ok [MkModuleMember 1 7 10 True]
            (module_members_test_state
              [module_members_test_entry "_ouro_m_0_alpha" 10,
                module_members_test_entry "alpha" 7, module_members_test_entry "beta" 7] 11)))
    , assert_true "members preserve first duplicate spelling and zero collision details"
        (andb(module_members_case (module_members_test_state
              [module_members_test_entry "_ouro_m_0_alpha" 21,
                module_members_test_entry "_ouro_m_0_alpha" 22,
                module_members_test_entry "alpha" 7] 10)
            0 [1] [] [MkPair Nat Nat 1 7] [] True (module_members_test_error 21),
          module_members_case (module_members_test_state
              [module_members_test_entry "_ouro_m_0_alpha" 0,
                module_members_test_entry "alpha" 7] 10)
            0 [1] [] [MkPair Nat Nat 1 7] [] True (module_members_test_error 0)))
    , assert_true "members prepend shadows a reused next ID before the later seed"
        (module_members_case (module_members_test_state
            [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 10] 10)
          0 [1, 2] [] [MkPair Nat Nat 1 7, MkPair Nat Nat 2 10] [] True
          (module_members_test_ok [MkModuleMember 1 7 10 True, MkModuleMember 2 10 11 True]
            (module_members_test_state
              [module_members_test_entry "_ouro_m_1__ouro_m_0_alpha" 11,
                module_members_test_entry "_ouro_m_0_alpha" 10,
                module_members_test_entry "alpha" 7, module_members_test_entry "beta" 10] 12)))
    , assert_true "members preserve zero assigned ID and prepend shadowing"
        (module_members_case (module_members_test_state
            [module_members_test_entry "zero" 0, module_members_test_entry "alpha" 7] 0)
          0 [1, 2] [] [MkPair Nat Nat 1 7, MkPair Nat Nat 2 0] [] True
          (module_members_test_ok [MkModuleMember 1 7 0 True, MkModuleMember 2 0 1 True]
            (module_members_test_state
              [module_members_test_entry "_ouro_m_1__ouro_m_0_alpha" 1,
                module_members_test_entry "_ouro_m_0_alpha" 0,
                module_members_test_entry "zero" 0, module_members_test_entry "alpha" 7] 2)))
    , assert_true "members retain root symbols and first matching owner privacy"
        (let state : InternState := module_members_test_state
            [module_members_test_entry "alpha" 7] 10 in
          let final_state : InternState := module_members_test_state
            [module_members_test_entry "_ouro_m_1_alpha" 10,
              module_members_test_entry "alpha" 7] 11 in
          let seeds : List (Pair Nat Nat) := [MkPair Nat Nat 0 7, MkPair Nat Nat 1 7] in
          andb(module_members_case state 0 [0, 1] [] seeds
              [module_collision_unit 0 7 False, module_collision_unit 1 7 True,
                module_collision_unit 1 7 False] True
              (module_members_test_ok [MkModuleMember 0 7 7 True, MkModuleMember 1 7 10 False]
                final_state),
            module_members_case state 0 [0, 1] [] seeds
              [module_collision_unit 0 7 False, module_collision_unit 1 7 False,
                module_collision_unit 1 7 True] True
              (module_members_test_ok [MkModuleMember 0 7 7 True, MkModuleMember 1 7 10 True]
                final_state)))
    , assert_true "members distinguish stored IDs beyond 32 bits"
        (let wide : Nat := add (pow_nat 2 32) 7 in
          module_members_case (module_members_test_state
              [module_members_test_entry "alpha" wide, module_members_test_entry "beta" 7] 10)
            0 [1] [] [MkPair Nat Nat 1 wide, MkPair Nat Nat 1 7] [] True
            (module_members_test_ok [MkModuleMember 1 wide 10 True, MkModuleMember 1 7 11 True]
              (module_members_test_state
                [module_members_test_entry "_ouro_m_0_beta" 11,
                  module_members_test_entry "_ouro_m_0_alpha" 10,
                  module_members_test_entry "alpha" wide, module_members_test_entry "beta" 7] 12)))
    , assert_true "members distinguish names and owners beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_members_case (module_members_test_state
              [module_members_test_entry "alpha" wide, module_members_test_entry "beta" 7] 10)
            0 [wide, 7] [] [MkPair Nat Nat wide wide, MkPair Nat Nat 7 7]
            [module_collision_unit wide wide True, module_collision_unit 7 7 False] True
            (module_members_test_ok [MkModuleMember wide wide 10 False, MkModuleMember 7 7 11 True]
              (module_members_test_state
                [module_members_test_entry "_ouro_m_1_beta" 11,
                  module_members_test_entry "_ouro_m_0_alpha" 10,
                  module_members_test_entry "alpha" wide, module_members_test_entry "beta" 7] 12)))
    , assert_true "members preserve assigned IDs and shadowing beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_members_case (module_members_test_state
              [module_members_test_entry "alpha" 7, module_members_test_entry "beta" wide] wide)
            7 [wide] [] [MkPair Nat Nat wide 7, MkPair Nat Nat wide wide] [] True
            (module_members_test_ok
              [MkModuleMember wide 7 wide True, MkModuleMember wide wide (add wide 1) True]
              (module_members_test_state
                [module_members_test_entry "_ouro_m_0__ouro_m_0_alpha" (add wide 1),
                  module_members_test_entry "_ouro_m_0_alpha" wide,
                  module_members_test_entry "alpha" 7, module_members_test_entry "beta" wide]
                (add wide 2))))
    , assert_true "members equate mixed Peano IDs while preserving raw tables"
        (module_members_case (module_members_test_state
            [module_members_test_entry "alpha" (S (S Z)), module_members_test_entry "beta" 2]
            (S (S (S Z)))) 0 [1] [] [MkPair Nat Nat 1 2] [] True
          (module_members_test_ok [MkModuleMember 1 2 (S (S (S Z))) True]
            (module_members_test_state
              [module_members_test_entry "_ouro_m_0_alpha" (S (S (S Z))),
                module_members_test_entry "alpha" (S (S Z)), module_members_test_entry "beta" 2] 4)))
    , assert_true "members keep generated collision ahead of later ordinal failure"
        (module_members_case (module_members_test_state
            [module_members_test_entry "_ouro_m_1_beta" 20,
              module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8] 10)
          0 [1, 2] [] [MkPair Nat Nat 1 7, MkPair Nat Nat 2 8, MkPair Nat Nat 99 7] [] True
          (module_members_test_error 20))
    , assert_true "members reverse index rotations preserve payload and table order"
        (andb(module_members_rotation_case
            [module_members_test_entry "a" 1, module_members_test_entry "b" 2,
              module_members_test_entry "c" 3],
          andb(module_members_rotation_case
              [module_members_test_entry "c" 3, module_members_test_entry "b" 2,
                module_members_test_entry "a" 1],
            andb(module_members_rotation_case
                [module_members_test_entry "c" 3, module_members_test_entry "a" 1,
                  module_members_test_entry "b" 2],
              module_members_rotation_case
                [module_members_test_entry "a" 1, module_members_test_entry "c" 3,
                  module_members_test_entry "b" 2]))))
    , assert_true "members preserve embedded zero and full Nat spelling elements"
        (module_members_case (module_members_test_state
            [MkPair (List Nat) Nat [0, 256] 7, MkPair (List Nat) Nat [0, 0] 8] 10)
          0 [1] [] [MkPair Nat Nat 1 7, MkPair Nat Nat 1 8] [] True
          (module_members_test_ok [MkModuleMember 1 7 10 True, MkModuleMember 1 8 11 True]
            (module_members_test_state
              [MkPair (List Nat) Nat [95, 111, 117, 114, 111, 95, 109, 95, 48, 95, 0, 0] 11,
                MkPair (List Nat) Nat [95, 111, 117, 114, 111, 95, 109, 95, 48, 95, 0, 256] 10,
                MkPair (List Nat) Nat [0, 256] 7, MkPair (List Nat) Nat [0, 0] 8] 12)))
    ];

def module_export_dedup_equal : List (Pair Nat Nat) -> List (Pair Nat Nat) -> Bool :=
  compiler_test_list_equal (Pair Nat Nat)
    (fun (row : Pair Nat Nat) (other : Pair Nat Nat) =>
      let (MkPair name symbol) := row in
      let (MkPair other_name other_symbol) := other in
      andb(eqNat name other_name, eqNat symbol other_symbol));

def module_export_dedup_wide_case (wide : Nat) (equivalent : Nat) (next : Nat) : Bool :=
  module_export_dedup_equal
    (module_unique_exports
      [MkPair Nat Nat 7 7, MkPair Nat Nat wide 7, MkPair Nat Nat 7 wide,
        MkPair Nat Nat wide next, MkPair Nat Nat next wide,
        MkPair Nat Nat equivalent 7, MkPair Nat Nat 7 equivalent,
        MkPair Nat Nat equivalent next, MkPair Nat Nat next equivalent,
        MkPair Nat Nat 7 7])
    [MkPair Nat Nat next wide, MkPair Nat Nat wide next,
      MkPair Nat Nat 7 wide, MkPair Nat Nat wide 7, MkPair Nat Nat 7 7];

def module_export_dedup_laws : List Test :=
    [ assert_true "unique exports keep empty input"
        (module_export_dedup_equal
          (module_unique_exports (Nil (Pair Nat Nat))) (Nil (Pair Nat Nat)))
    , assert_true "unique exports keep zero in either pair field"
        (module_export_dedup_equal
          (module_unique_exports
            [MkPair Nat Nat 0 0, MkPair Nat Nat 0 1, MkPair Nat Nat 1 0,
              MkPair Nat Nat 0 0, MkPair Nat Nat 0 1, MkPair Nat Nat 1 0])
          [MkPair Nat Nat 1 0, MkPair Nat Nat 0 1, MkPair Nat Nat 0 0])
    , assert_true "unique exports equate mixed Peano zero and pair fields"
        (module_export_dedup_equal
          (module_unique_exports
            [MkPair Nat Nat Z (S Z), MkPair Nat Nat 0 1,
              MkPair Nat Nat (S Z) Z, MkPair Nat Nat 1 0,
              MkPair Nat Nat Z Z, MkPair Nat Nat 0 0])
          [MkPair Nat Nat Z Z, MkPair Nat Nat (S Z) Z, MkPair Nat Nat Z (S Z)])
    , assert_true "unique exports retain ambiguity and reverse first distinct pairs"
        (module_export_dedup_equal
          (module_unique_exports
            [MkPair Nat Nat 1 10, MkPair Nat Nat 1 10,
              MkPair Nat Nat 1 11, MkPair Nat Nat 2 12, MkPair Nat Nat 1 10])
          [MkPair Nat Nat 2 12, MkPair Nat Nat 1 11, MkPair Nat Nat 1 10])
    , assert_true "unique exports distinguish full pairs beyond 32 bits"
        (let wide : Nat := add (pow_nat 2 32) 7 in
          module_export_dedup_wide_case wide wide (add wide 1))
    , assert_true "unique exports equate mixed Peano pairs beyond 32 bits"
        (let lower : Nat := add (pow_nat 2 32) 6 in
          module_export_dedup_wide_case (S lower) (add lower 1) (S (S lower)))
    , assert_true "unique exports distinguish full pairs beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_export_dedup_wide_case wide wide (add wide 1))
    , assert_true "unique exports equate mixed Peano pairs beyond 64 bits"
        (let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
          module_export_dedup_wide_case (S lower) (add lower 1) (S (S lower)))
    ];

def module_shadow_exports_laws : List Test :=
    [ assert_true "shadow exports preserve empty sides"
        (let rows : List (Pair Nat Nat) := [MkPair Nat Nat 1 2, MkPair Nat Nat 1 2] in
          andb(module_export_dedup_equal (module_shadow_exports rows []) [],
            module_export_dedup_equal (module_shadow_exports [] rows) rows))
    , assert_true "shadow exports remove owned names and preserve the other rows in order"
        (module_export_dedup_equal
          (module_shadow_exports [MkPair Nat Nat 7 0, MkPair Nat Nat 7 70, MkPair Nat Nat 1 11]
            [MkPair Nat Nat 3 70, MkPair Nat Nat 7 50, MkPair Nat Nat 2 50,
              MkPair Nat Nat 3 70, MkPair Nat Nat 1 0, MkPair Nat Nat 3 71])
          [MkPair Nat Nat 3 70, MkPair Nat Nat 2 50, MkPair Nat Nat 3 70, MkPair Nat Nat 3 71])
    , assert_true "shadow exports distinguish wide names and equate mixed Peano names"
        (let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
         let wide : Nat := add lower 1 in
         let next : Nat := add wide 1 in
         module_export_dedup_equal
           (module_shadow_exports [MkPair Nat Nat wide Z, MkPair Nat Nat Z 11]
             [MkPair Nat Nat 7 1, MkPair Nat Nat (S lower) 2, MkPair Nat Nat wide 3,
               MkPair Nat Nat 0 4, MkPair Nat Nat next 5, MkPair Nat Nat 7 1])
           [MkPair Nat Nat 7 1, MkPair Nat Nat next 5, MkPair Nat Nat 7 1])
    ];

def module_scope_maps_previous (owner : Nat) (names : List Nat)
    (members : List ModuleMember)
    (exports : List (Pair Nat Nat)) : ModuleMaps :=
  (fix go (remaining : List Nat)
      (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
      : ModuleMaps :=
    match remaining with
    | Nil => MkModuleMaps (module_heads owner names members)
        refs errors
    | Cons short rest =>
        match module_scope_decision owner short members exports with
        | ModuleFound symbol =>
            go rest (Cons (Pair Nat Nat) (MkPair Nat Nat short symbol) refs)
              errors
        | ModuleAmbiguous =>
            go rest refs
              (Cons (Pair Nat Nat) (MkPair Nat Nat short 6) errors)
        | ModuleAbsent =>
            go rest refs
              (Cons (Pair Nat Nat) (MkPair Nat Nat short 5) errors)
        end
    end) names (Nil (Pair Nat Nat)) (Nil (Pair Nat Nat));

def module_scope_maps_equal (left : ModuleMaps) (right : ModuleMaps) : Bool :=
  let (MkModuleMaps heads refs errors) := left in
  let (MkModuleMaps other_heads other_refs other_errors) := right in
  andb(module_export_dedup_equal heads other_heads,
    andb(module_export_dedup_equal refs other_refs,
      module_export_dedup_equal errors other_errors));

def module_scope_maps_case (owner : Nat) (names : List Nat)
    (members : List ModuleMember) (exports : List (Pair Nat Nat))
    (wanted : ModuleMaps) : Bool :=
  let actual : ModuleMaps := module_scope_maps owner names members exports in
  andb(module_scope_maps_equal actual wanted,
    module_scope_maps_equal actual
      (module_scope_maps_previous owner names members exports));

def module_scope_maps_wide_case (wide : Nat) (equivalent : Nat) (next : Nat) : Bool :=
  let owner : Nat := add wide 3 in
  let symbol : Nat := add wide 2 in
  andb(module_scope_maps_case owner [wide, 7, equivalent, next, Z]
      [MkModuleMember 0 wide 99 True, MkModuleMember owner wide symbol True,
        MkModuleMember owner equivalent 0 False]
      [MkPair Nat Nat 7 (add wide 4), MkPair Nat Nat next Z,
        MkPair Nat Nat next 0, MkPair Nat Nat Z 5, MkPair Nat Nat 0 6]
      (MkModuleMaps
        [MkPair Nat Nat wide symbol, MkPair Nat Nat equivalent 0]
        [MkPair Nat Nat next Z, MkPair Nat Nat equivalent symbol,
          MkPair Nat Nat 7 (add wide 4), MkPair Nat Nat wide symbol]
        [MkPair Nat Nat Z 6]),
    module_scope_maps_case 0 [7, wide, next, Z] []
      [MkPair Nat Nat wide 7, MkPair Nat Nat equivalent wide,
        MkPair Nat Nat next wide, MkPair Nat Nat next equivalent, MkPair Nat Nat 7 0]
      (MkModuleMaps []
        [MkPair Nat Nat next wide, MkPair Nat Nat 7 0]
        [MkPair Nat Nat Z 5, MkPair Nat Nat wide 6]));

def module_scope_maps_laws : List Test :=
    [ assert_true "scope maps keep empty names and all three lists empty"
        (module_scope_maps_case 0 [] [MkModuleMember 0 7 70 False]
          [MkPair Nat Nat 7 71, MkPair Nat Nat 7 72] (MkModuleMaps [] [] []))
    , assert_true "scope maps keep repeated names and reverse refs and absent errors"
        (andb(module_scope_maps_case 9 [7, 8, 7, 99, 8] []
            [MkPair Nat Nat 7 70, MkPair Nat Nat 8 80]
            (MkModuleMaps []
              [MkPair Nat Nat 8 80, MkPair Nat Nat 7 70,
                MkPair Nat Nat 8 80, MkPair Nat Nat 7 70]
              [MkPair Nat Nat 99 5]),
          module_scope_maps_case 9 [99, 98, 99, 97] [] []
            (MkModuleMaps [] []
              [MkPair Nat Nat 97 5, MkPair Nat Nat 99 5,
                MkPair Nat Nat 98 5, MkPair Nat Nat 99 5])))
    , assert_true "scope maps keep first local symbol and every original head"
        (module_scope_maps_case 1 [7, 8]
          [MkModuleMember 2 7 90 True, MkModuleMember 1 7 70 False,
            MkModuleMember 1 7 71 True, MkModuleMember 1 8 80 True]
          [MkPair Nat Nat 7 90, MkPair Nat Nat 7 91, MkPair Nat Nat 8 81]
          (MkModuleMaps
            [MkPair Nat Nat 7 70, MkPair Nat Nat 7 71, MkPair Nat Nat 8 80]
            [MkPair Nat Nat 8 80, MkPair Nat Nat 7 70] []))
    , assert_true "scope maps keep zero owner name and local and exported symbols"
        (module_scope_maps_case Z [Z, 1, 2]
          [MkModuleMember 0 0 0 False, MkModuleMember 1 1 9 True]
          [MkPair Nat Nat 0 5, MkPair Nat Nat 1 0,
            MkPair Nat Nat 2 Z, MkPair Nat Nat 2 0]
          (MkModuleMaps [MkPair Nat Nat 0 0]
            [MkPair Nat Nat 2 Z, MkPair Nat Nat 1 0, MkPair Nat Nat Z 0] []))
    , assert_true "scope maps keep equal exports found and distinct exports ambiguous"
        (andb(module_scope_maps_case 9 [1, 2, 3] []
            [MkPair Nat Nat 1 10, MkPair Nat Nat 2 20, MkPair Nat Nat 1 10,
              MkPair Nat Nat 2 21, MkPair Nat Nat 1 10, MkPair Nat Nat 3 0,
              MkPair Nat Nat 3 0, MkPair Nat Nat 2 20]
            (MkModuleMaps [] [MkPair Nat Nat 3 0, MkPair Nat Nat 1 10]
              [MkPair Nat Nat 2 6]),
          module_scope_maps_case 9 [2, 99, 2, 1, 98] []
            [MkPair Nat Nat 2 20, MkPair Nat Nat 2 21, MkPair Nat Nat 1 10]
            (MkModuleMaps [] [MkPair Nat Nat 1 10]
              [MkPair Nat Nat 98 5, MkPair Nat Nat 2 6,
                MkPair Nat Nat 99 5, MkPair Nat Nat 2 6])))
    , assert_true "scope maps keep local shadow and ignore foreign visibility flags"
        (andb(module_scope_maps_case 1 [7, 7]
            [MkModuleMember 1 7 0 False, MkModuleMember 1 7 9 True]
            [MkPair Nat Nat 7 10, MkPair Nat Nat 7 11]
            (MkModuleMaps [MkPair Nat Nat 7 0, MkPair Nat Nat 7 9]
              [MkPair Nat Nat 7 0, MkPair Nat Nat 7 0] []),
          module_scope_maps_case 1 [7, 8, 9]
            [MkModuleMember 2 7 70 True, MkModuleMember 2 8 80 False,
              MkModuleMember 1 9 90 False]
            [MkPair Nat Nat 7 71]
            (MkModuleMaps [MkPair Nat Nat 9 90]
              [MkPair Nat Nat 9 90, MkPair Nat Nat 7 71] [MkPair Nat Nat 8 5])))
    , assert_true "scope maps equate mixed Peano owners names and symbols"
        (module_scope_maps_case (S Z) [Z, 0, S (S Z), 2, 3]
          [MkModuleMember 1 Z (S Z) False,
            MkModuleMember (S Z) (S (S Z)) (S (S (S Z))) True]
          [MkPair Nat Nat 2 200, MkPair Nat Nat 3 Z,
            MkPair Nat Nat (S (S (S Z))) 0]
          (MkModuleMaps
            [MkPair Nat Nat Z (S Z), MkPair Nat Nat (S (S Z)) (S (S (S Z)))]
            [MkPair Nat Nat 3 Z, MkPair Nat Nat 2 (S (S (S Z))),
              MkPair Nat Nat (S (S Z)) (S (S (S Z))),
              MkPair Nat Nat 0 (S Z), MkPair Nat Nat Z (S Z)] []))
    , assert_true "scope maps distinguish complete names owners and symbols beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_scope_maps_wide_case wide wide (add wide 1))
    , assert_true "scope maps equate mixed Peano complete IDs beyond 64 bits"
        (let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
          module_scope_maps_wide_case (S lower) (add lower 1) (S (S lower)))
    ];

def module_bare_ctors_previous (units : List SrcUnit)
    (members : List ModuleMember) (refs : List (Pair Nat Nat))
    (errors : List (Pair Nat Nat)) (names : List Nat) : List Nat :=
  (fix go (remaining : List Nat) : List Nat :=
    match remaining with
    | Nil => Nil Nat
    | Cons name rest =>
        let tail : List Nat := go rest in
        match module_lookup name errors with
        | Just _ => tail
        | Nothing =>
            let symbol : Nat := match module_lookup name refs with
              | Just target => target | Nothing => name end in
            if module_symbol_is_ctor units members symbol then Cons Nat name tail else tail
        end
    end) names;

def module_bare_ctors_case (units : List SrcUnit)
    (members : List ModuleMember) (refs : List (Pair Nat Nat))
    (errors : List (Pair Nat Nat)) (names : List Nat) (wanted : List Nat) : Bool :=
  let actual : List Nat := module_bare_ctors units members refs errors names in
  andb(module_conflicts_equal actual wanted,
    module_conflicts_equal actual
      (module_bare_ctors_previous units members refs errors names));

def module_bare_ctors_wide_case (wide : Nat) (equivalent : Nat) (next : Nat) : Bool :=
  let owner : Nat := add wide 3 in
  let symbol : Nat := add wide 2 in
  module_bare_ctors_case
    [mk_src_unit 10 [DAxiom wide (ESort 0)] [],
      mk_src_unit owner [DInductive 100 [] (ESort 1)
        [MkPair Nat Expr wide (EVar 100)] 0] [wide]]
    [MkModuleMember 10 wide 9 False, MkModuleMember owner wide symbol False,
      MkModuleMember owner 7 7 True]
    [MkPair Nat Nat wide symbol, MkPair Nat Nat equivalent 9,
      MkPair Nat Nat 7 9, MkPair Nat Nat next symbol, MkPair Nat Nat 12 7]
    [MkPair Nat Nat next 0]
    [wide, 7, equivalent, next, 12, 9, wide] [wide, equivalent, wide];

def module_bare_ctors_laws : List Test :=
    [ assert_true "bare ctors keep empty names and reject missing unit and member contexts"
        (andb(module_bare_ctors_case [] [] [] [] [] [],
          andb(module_bare_ctors_case [] [MkModuleMember 1 7 7 False] [] [] [7, 7] [],
            module_bare_ctors_case
              [mk_src_unit 1 [DInductive 20 [] (ESort 1)
                [MkPair Nat Expr 7 (EVar 20)] 0] []] [] [] [] [7, 7] [])))
    , assert_true "bare ctors preserve whole accepted name order repeats and fallback symbols"
        (module_bare_ctors_case
          [mk_src_unit 1 [DInductive 20 [] (ESort 1)
            [MkPair Nat Expr 7 (EVar 20), MkPair Nat Expr 8 (EVar 20)] 0] [],
            mk_src_unit 2 [DInductive 21 [] (ESort 1)
              [MkPair Nat Expr 9 (EVar 21)] 0] []]
          [MkModuleMember 1 7 70 True, MkModuleMember 1 8 80 True,
            MkModuleMember 2 9 9 True]
          [MkPair Nat Nat 7 70, MkPair Nat Nat 8 80] []
          [7, 8, 7, 9, 8, 99, 7] [7, 8, 7, 9, 8, 7])
    , assert_true "bare ctors retain first duplicate refs including a zero target"
        (module_bare_ctors_case
          [mk_src_unit 0 [DInductive 19 [] (ESort 1)
            [MkPair Nat Expr 0 (EVar 19)] 0] [],
            mk_src_unit 1 [DAxiom 8 (ESort 0), DInductive 20 [] (ESort 1)
              [MkPair Nat Expr 7 (EVar 20), MkPair Nat Expr 9 (EVar 20)] 0] []]
          [MkModuleMember 1 7 70 True, MkModuleMember 1 8 80 True,
            MkModuleMember 1 9 90 True, MkModuleMember 0 0 0 False]
          [MkPair Nat Nat 10 70, MkPair Nat Nat 10 80,
            MkPair Nat Nat 11 80, MkPair Nat Nat 11 90,
            MkPair Nat Nat 12 0, MkPair Nat Nat 12 70,
            MkPair Nat Nat 13 999, MkPair Nat Nat 13 70] []
          [10, 11, 12, 13, 10, 12, 11, 13] [10, 12, 10, 12])
    , assert_true "bare ctors suppress every present error including zero before refs"
        (module_bare_ctors_case
          [mk_src_unit 0 [DInductive 19 [] (ESort 1)
            [MkPair Nat Expr 0 (EVar 19)] 0] [],
            mk_src_unit 1 [DInductive 20 [] (ESort 1)
              [MkPair Nat Expr 7 (EVar 20), MkPair Nat Expr 8 (EVar 20),
                MkPair Nat Expr 9 (EVar 20)] 0] []]
          [MkModuleMember 1 7 70 True, MkModuleMember 1 8 80 True,
            MkModuleMember 1 9 90 True, MkModuleMember 0 0 0 False]
          [MkPair Nat Nat 7 70, MkPair Nat Nat 8 80,
            MkPair Nat Nat 9 90, MkPair Nat Nat 0 0]
          [MkPair Nat Nat 7 0, MkPair Nat Nat 7 8, MkPair Nat Nat 8 5,
            MkPair Nat Nat Z 0, MkPair Nat Nat 0 6] [7, 9, 8, 0, 9, 7] [9, 9])
    , assert_true "bare ctors keep admitted private constructors and honor their name errors"
        (let units : List SrcUnit := [mk_src_unit 1 [DInductive 20 [] (ESort 1)
            [MkPair Nat Expr 7 (EVar 20), MkPair Nat Expr 8 (EVar 20)] 0] [7]] in
          let members : List ModuleMember :=
            [MkModuleMember 1 7 70 False, MkModuleMember 1 8 80 True] in
          let refs : List (Pair Nat Nat) := [MkPair Nat Nat 7 70, MkPair Nat Nat 8 80] in
          andb(module_bare_ctors_case units members refs [] [7, 8, 7] [7, 8, 7],
            module_bare_ctors_case units members refs [MkPair Nat Nat 7 0] [7, 8, 7] [8]))
    , assert_true "bare ctors keep first matching member even when later rows are constructors"
        (module_bare_ctors_case
          [mk_src_unit 1 [DAxiom 8 (ESort 0)] [],
            mk_src_unit 2 [DInductive 20 [] (ESort 1)
              [MkPair Nat Expr 7 (EVar 20)] 0] [7]]
          [MkModuleMember 1 8 70 True, MkModuleMember 2 7 70 False,
            MkModuleMember 2 7 80 False, MkModuleMember 1 8 80 True,
            MkModuleMember 99 7 90 True, MkModuleMember 2 7 90 True]
          [MkPair Nat Nat 10 70, MkPair Nat Nat 11 80, MkPair Nat Nat 12 90] []
          [10, 11, 12, 10, 11, 12] [11, 11])
    , assert_true "bare ctors retain first duplicate source unit in both constructor directions"
        (module_bare_ctors_case
          [mk_src_unit 1 [DAxiom 7 (ESort 0)] [],
            mk_src_unit 1 [DInductive 20 [] (ESort 1)
              [MkPair Nat Expr 7 (EVar 20)] 0] [],
            mk_src_unit 2 [DInductive 21 [] (ESort 1)
              [MkPair Nat Expr 8 (EVar 21)] 0] [],
            mk_src_unit 2 [DAxiom 8 (ESort 0)] []]
          [MkModuleMember 1 7 70 True, MkModuleMember 2 8 80 True]
          [MkPair Nat Nat 7 70, MkPair Nat Nat 8 80] [] [7, 8, 7, 8] [8, 8])
    , assert_true "bare ctors exclude inductive heads effect names and ordinary declarations"
        (module_bare_ctors_case
          [mk_src_unit 1
            [DInductive 7 [] (ESort 1) [MkPair Nat Expr 8 (EVar 7)] 0,
              DInductive 9 [] (ESort 1) [MkPair Nat Expr 10 (EVar 9)] 0,
              DAxiom 11 (ESort 0), DDef 12 (ESort 0) (ENat 0) 0 [],
              DEffect 13 [] [MkPair Nat Expr 14 (ESort 0)]] []]
          [MkModuleMember 1 7 7 True, MkModuleMember 1 8 8 True,
            MkModuleMember 1 9 9 True, MkModuleMember 1 10 10 True,
            MkModuleMember 1 11 11 True, MkModuleMember 1 12 12 True,
            MkModuleMember 1 13 13 True, MkModuleMember 1 14 14 True]
          [] [] [7, 8, 9, 10, 11, 12, 13, 14, 8] [8, 10, 8])
    , assert_true "bare ctors classify constructor short names within the exact member owner"
        (module_bare_ctors_case
          [mk_src_unit 1 [DInductive 20 [] (ESort 1)
            [MkPair Nat Expr 7 (EVar 20)] 0] [],
            mk_src_unit 2 [DInductive 21 [] (ESort 1)
              [MkPair Nat Expr 8 (EVar 21)] 0] []]
          [MkModuleMember 1 8 80 True, MkModuleMember 2 7 70 True]
          [MkPair Nat Nat 7 70, MkPair Nat Nat 8 80] [] [7, 8, 7] [])
    , assert_true "bare ctors preserve zero owners names symbols and name keyed errors"
        (let units : List SrcUnit := [mk_src_unit Z [DInductive 10 [] (ESort 1)
            [MkPair Nat Expr 0 (EVar 10)] 0] [Z]] in
          let members : List ModuleMember := [MkModuleMember 0 Z Z False] in
          let refs : List (Pair Nat Nat) := [MkPair Nat Nat 7 Z, MkPair Nat Nat Z 0] in
          andb(module_bare_ctors_case units members refs [] [Z, 0, 7, Z, 9] [Z, 0, 7, Z],
            module_bare_ctors_case units members refs [MkPair Nat Nat 0 Z]
              [Z, 0, 7, Z, 9] [7]))
    , assert_true "bare ctors equate mixed Peano owner short symbol ref and error keys"
        (let units : List SrcUnit :=
            [mk_src_unit (S Z) [DInductive 20 [] (ESort 1)
              [MkPair Nat Expr (S (S Z)) (EVar 20)] 0] [],
              mk_src_unit 0 [DInductive 21 [] (ESort 1)
                [MkPair Nat Expr Z (EVar 21)] 0] []] in
          let members : List ModuleMember :=
            [MkModuleMember 1 2 (S (S (S Z))) True, MkModuleMember Z 0 0 False] in
          let refs : List (Pair Nat Nat) :=
            [MkPair Nat Nat 7 3, MkPair Nat Nat (S (S (S (S (S (S (S Z))))))) 0,
              MkPair Nat Nat (S (S Z)) (S (S (S Z))), MkPair Nat Nat 0 Z] in
          andb(module_bare_ctors_case units members refs []
              [7, S (S Z), 2, 0, Z, 7] [7, S (S Z), 2, 0, Z, 7],
            module_bare_ctors_case units members refs [MkPair Nat Nat 2 0]
              [7, S (S Z), 2, 0, Z, 7] [7, 0, Z, 7]))
    , assert_true "bare ctors distinguish full names owners and symbols beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_bare_ctors_wide_case wide wide (add wide 1))
    , assert_true "bare ctors equate mixed Peano complete keys beyond 64 bits"
        (let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
          module_bare_ctors_wide_case (S lower) (add lower 1) (S (S lower)))
    , assert_true "bare ctors retain constructor resolution and complete pattern scope outputs"
        (let units : List SrcUnit := [mk_src_unit 1 [DAxiom 8 (ESort 0),
            DInductive 20 [] (ESort 1) [MkPair Nat Expr 7 (EVar 20)] 0] [7]] in
          let members : List ModuleMember :=
            [MkModuleMember 1 7 70 False, MkModuleMember 1 8 70 True,
              MkModuleMember 1 8 80 True] in
          let refs : List (Pair Nat Nat) := [MkPair Nat Nat 7 70, MkPair Nat Nat 8 80] in
          let constructors : List Nat := module_bare_ctors units members refs [] [8, 7, 7] in
          andb(module_conflicts_equal constructors [7, 7],
            andb(module_name_nat 70 (module_constructor_ref refs [] constructors [] 7),
              andb(module_name_error Nat 8 8 (module_constructor_ref refs [] constructors [] 8),
                match module_pattern_head refs [] [] constructors 7 [9] with
                | RErr _ _ => False
                | ROk pair => let (MkPair head scope) := pair in
                  andb(eq_nat head 70, module_conflicts_equal scope [9])
                end))))
    ];

def module_duplicate_key_previous : List (Pair Nat Nat) -> Maybe Nat :=
  fix go (items : List (Pair Nat Nat)) : Maybe Nat :=
    match items with
    | Nil => Nothing Nat
    | Cons pair rest =>
        let (MkPair key _) := pair in
        match module_lookup key rest with
        | Just _ => Just Nat key
        | Nothing => go rest
        end
    end;

def module_overlap_key_previous (refs : List (Pair Nat Nat))
    (errors : List (Pair Nat Nat)) : Maybe Nat :=
    (fix go (items : List (Pair Nat Nat)) : Maybe Nat :=
      match items with
      | Nil => Nothing Nat
      | Cons pair rest =>
          let (MkPair key _) := pair in
          match module_lookup key errors with
          | Just _ => Just Nat key
          | Nothing => go rest
          end
      end) refs;

def module_invalid_maps_previous (heads : List (Pair Nat Nat))
    (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat)) : Maybe Nat :=
    match module_duplicate_key_previous heads with
    | Just key => Just Nat key
    | Nothing =>
        match module_duplicate_key_previous refs with
        | Just key => Just Nat key
        | Nothing =>
            match module_duplicate_key_previous errors with
            | Just key => Just Nat key
            | Nothing =>
                match module_overlap_key_previous refs errors with
                | Just key => Just Nat key
                | Nothing => module_invalid_error_code errors
                end
            end
        end
    end;

def module_map_key_equal (left : Maybe Nat) (right : Maybe Nat) : Bool :=
  match left with
  | Nothing => match right with
    | Nothing => True
    | Just _ => False
    end
  | Just key => match right with
    | Nothing => False
    | Just other => eq_nat key other
    end
  end;

def module_duplicate_key_case (items : List (Pair Nat Nat))
    (wanted : Maybe Nat) : Bool :=
  let actual : Maybe Nat := module_duplicate_key items in
  andb(module_map_key_equal actual wanted,
    module_map_key_equal actual (module_duplicate_key_previous items));

def module_overlap_key_case (refs : List (Pair Nat Nat))
    (errors : List (Pair Nat Nat)) (wanted : Maybe Nat) : Bool :=
  let actual : Maybe Nat := module_overlap_key refs errors in
  andb(module_map_key_equal actual wanted,
    module_map_key_equal actual (module_overlap_key_previous refs errors));

def module_invalid_maps_case (heads : List (Pair Nat Nat))
    (refs : List (Pair Nat Nat)) (errors : List (Pair Nat Nat))
    (wanted : Maybe Nat) : Bool :=
  let actual : Maybe Nat := module_invalid_maps heads refs errors in
  andb(module_map_key_equal actual wanted,
    module_map_key_equal actual (module_invalid_maps_previous heads refs errors));

def module_maps_empty_boundary_case (fuel : Nat)
    (heads : List (Pair Nat Nat)) (refs : List (Pair Nat Nat))
    (errors : List (Pair Nat Nat)) (decls : List Decl)
    (wanted : ResolveResult (List Decl)) : Bool :=
  match module_rewrite_decls fuel heads refs errors [] [] decls with
  | RErr code detail => match wanted with
    | ROk _ => False
    | RErr other_code other_detail =>
        andb(eq_nat code other_code, eq_nat detail other_detail)
    end
  | ROk actual => match actual with
    | Cons _ _ => False
    | Nil => match wanted with
      | RErr _ _ => False
      | ROk out => match out with
        | Nil => True
        | Cons _ _ => False
        end
      end
    end
  end;

def module_invalid_maps_wide_case (wide : Nat) (equivalent : Nat)
    (next : Nat) : Bool :=
  andb(module_duplicate_key_case
      [MkPair Nat Nat wide 0, MkPair Nat Nat next 0, MkPair Nat Nat equivalent 9]
      (Just Nat wide),
    andb(module_duplicate_key_case
        [MkPair Nat Nat wide 0, MkPair Nat Nat next 0, MkPair Nat Nat 7 0]
        (Nothing Nat),
      andb(module_overlap_key_case
          [MkPair Nat Nat next 0, MkPair Nat Nat wide 0]
          [MkPair Nat Nat equivalent 0] (Just Nat wide),
        andb(module_overlap_key_case [MkPair Nat Nat next 0]
            [MkPair Nat Nat wide 0] (Nothing Nat),
          andb(module_invalid_maps_case
              [MkPair Nat Nat wide 0, MkPair Nat Nat equivalent 1]
              [MkPair Nat Nat next 0, MkPair Nat Nat next 1]
              [MkPair Nat Nat equivalent 0] (Just Nat wide),
            andb(module_invalid_maps_case [] [MkPair Nat Nat next 0]
                [MkPair Nat Nat equivalent 0] (Just Nat equivalent),
              andb(module_maps_empty_boundary_case 1
                  [MkPair Nat Nat wide 0, MkPair Nat Nat equivalent 1] [] [] []
                  (RErr (List Decl) 8 wide),
                module_maps_empty_boundary_case Z
                  [MkPair Nat Nat wide 0, MkPair Nat Nat equivalent 1] [] [] []
                  (RErr (List Decl) 7 Z))))))));

def module_invalid_maps_laws : List Test :=
    [ assert_true "duplicate keys retain the first occurrence rather than the first rediscovery"
        (andb(module_duplicate_key_case
            [MkPair Nat Nat 1 10, MkPair Nat Nat 2 20,
              MkPair Nat Nat 2 21, MkPair Nat Nat 1 11] (Just Nat 1),
          andb(module_duplicate_key_case
              [MkPair Nat Nat 2 20, MkPair Nat Nat 1 10,
                MkPair Nat Nat 2 21, MkPair Nat Nat 1 11] (Just Nat 2),
            module_duplicate_key_case
              [MkPair Nat Nat 3 0, MkPair Nat Nat 3 1, MkPair Nat Nat 3 2]
              (Just Nat 3))))
    , assert_true "duplicate keys retain zero payload presence and mixed Peano keys"
        (andb(module_duplicate_key_case
            [MkPair Nat Nat Z 7, MkPair Nat Nat 1 0, MkPair Nat Nat 0 0]
            (Just Nat Z),
          andb(module_duplicate_key_case
              [MkPair Nat Nat 1 9, MkPair Nat Nat 2 0, MkPair Nat Nat 2 0]
              (Just Nat 2),
            module_duplicate_key_case
              [MkPair Nat Nat 2 9, MkPair Nat Nat (S Z) 8,
                MkPair Nat Nat (S (S Z)) 7, MkPair Nat Nat 1 6]
              (Just Nat 2))))
    , assert_true "overlap keys retain refs order and repeats rather than errors order"
        (andb(module_overlap_key_case
            [MkPair Nat Nat 9 90, MkPair Nat Nat 2 20,
              MkPair Nat Nat 1 10, MkPair Nat Nat 2 21]
            [MkPair Nat Nat 1 6, MkPair Nat Nat 2 0, MkPair Nat Nat 9 5]
            (Just Nat 9),
          andb(module_overlap_key_case
              [MkPair Nat Nat 3 30, MkPair Nat Nat 2 20,
                MkPair Nat Nat 1 10, MkPair Nat Nat 2 21]
              [MkPair Nat Nat 1 5, MkPair Nat Nat 2 6] (Just Nat 2),
            module_overlap_key_case [MkPair Nat Nat 4 0, MkPair Nat Nat 4 1]
              [MkPair Nat Nat 4 0, MkPair Nat Nat 4 9] (Just Nat 4))))
    , assert_true "overlap keys treat Just zero as present and equate mixed Peano keys"
        (andb(module_overlap_key_case [MkPair Nat Nat Z 0, MkPair Nat Nat 2 7]
            [MkPair Nat Nat 0 0] (Just Nat Z),
          andb(module_overlap_key_case [MkPair Nat Nat (S Z) 2, MkPair Nat Nat Z 9]
              [MkPair Nat Nat 0 0, MkPair Nat Nat 1 0] (Just Nat (S Z)),
            module_overlap_key_case [MkPair Nat Nat 7 0]
              [MkPair Nat Nat 8 0] (Nothing Nat))))
    , assert_true "invalid maps retain heads refs errors overlap then code priority"
        (let heads : List (Pair Nat Nat) :=
            [MkPair Nat Nat 1 10, MkPair Nat Nat 1 11] in
          let refs : List (Pair Nat Nat) :=
            [MkPair Nat Nat 2 20, MkPair Nat Nat 2 21, MkPair Nat Nat 4 40] in
          let errors : List (Pair Nat Nat) :=
            [MkPair Nat Nat 3 5, MkPair Nat Nat 3 6,
              MkPair Nat Nat 4 6, MkPair Nat Nat 5 0] in
          andb(module_invalid_maps_case heads refs errors (Just Nat 1),
            andb(module_invalid_maps_case [] refs errors (Just Nat 2),
              andb(module_invalid_maps_case []
                  [MkPair Nat Nat 2 20, MkPair Nat Nat 4 40] errors (Just Nat 3),
                andb(module_invalid_maps_case []
                    [MkPair Nat Nat 2 20, MkPair Nat Nat 4 40]
                    [MkPair Nat Nat 3 5, MkPair Nat Nat 4 6, MkPair Nat Nat 5 0]
                    (Just Nat 4),
                  module_invalid_maps_case [] [MkPair Nat Nat 2 20]
                    [MkPair Nat Nat 3 5, MkPair Nat Nat 4 6, MkPair Nat Nat 5 0]
                    (Just Nat 5))))))
    , assert_true "invalid maps retain the first invalid code key including zero"
        (andb(module_invalid_maps_case [] []
            [MkPair Nat Nat 9 5, MkPair Nat Nat 8 6] (Nothing Nat),
          andb(module_invalid_maps_case [] []
              [MkPair Nat Nat 9 5, MkPair Nat Nat 8 0, MkPair Nat Nat 7 4]
              (Just Nat 8),
            andb(module_invalid_maps_case [] []
                [MkPair Nat Nat 8 6, MkPair Nat Nat 7 7, MkPair Nat Nat 6 0]
                (Just Nat 7),
              module_invalid_maps_case [] [] [MkPair Nat Nat 0 0] (Just Nat Z)))))
    , assert_true "empty duplicate and overlap gates preserve duplicate heads validation"
        (andb(module_duplicate_key_case [] (Nothing Nat),
          andb(module_duplicate_key_case [MkPair Nat Nat 0 0] (Nothing Nat),
            andb(module_duplicate_key_case
                [MkPair Nat Nat 0 0, MkPair Nat Nat 1 0] (Nothing Nat),
              andb(module_overlap_key_case [] [MkPair Nat Nat 0 0] (Nothing Nat),
                andb(module_overlap_key_case [MkPair Nat Nat 0 0] [] (Nothing Nat),
                  andb(module_invalid_maps_case [] [] [] (Nothing Nat),
                    andb(module_invalid_maps_case [MkPair Nat Nat 9 0] [] []
                        (Nothing Nat),
                      andb(module_invalid_maps_case
                          [MkPair Nat Nat Z 0, MkPair Nat Nat 0 1] [] [] (Just Nat Z),
                        andb(module_invalid_maps_case []
                            [MkPair Nat Nat 1 0, MkPair Nat Nat 2 0] [] (Nothing Nat),
                          module_invalid_maps_case [] []
                            [MkPair Nat Nat 1 5, MkPair Nat Nat 2 6]
                            (Nothing Nat)))))))))))
    , assert_true "invalid map keys and complete error details remain distinct beyond 64 bits"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          module_invalid_maps_wide_case wide wide (add wide 1))
    , assert_true "invalid map keys and error details equate mixed Peano values beyond 64 bits"
        (let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
          module_invalid_maps_wide_case (S lower) (add lower 1) (S (S lower)))
    , assert_true "public rewrite fuel zero precedes valid and malformed maps and declarations"
        (andb(module_maps_empty_boundary_case Z [] [] [] [] (RErr (List Decl) 7 Z),
          andb(module_maps_empty_boundary_case Z
              [MkPair Nat Nat 1 10, MkPair Nat Nat 1 11]
              [MkPair Nat Nat 2 0, MkPair Nat Nat 2 1]
              [MkPair Nat Nat 3 0] [] (RErr (List Decl) 7 Z),
            module_maps_empty_boundary_case Z
              [MkPair Nat Nat 0 0, MkPair Nat Nat Z 1]
              [MkPair Nat Nat 7 0] [MkPair Nat Nat 7 5]
              [DDef 99 (ESort 0) (EVar 98) 0 []] (RErr (List Decl) 7 Z))))
    , assert_true "public rewrite validates positive fuel maps before even empty declarations"
        (let heads : List (Pair Nat Nat) :=
            [MkPair Nat Nat 1 10, MkPair Nat Nat 1 11] in
          let refs : List (Pair Nat Nat) :=
            [MkPair Nat Nat 2 20, MkPair Nat Nat 2 21, MkPair Nat Nat 4 40] in
          let errors : List (Pair Nat Nat) :=
            [MkPair Nat Nat 3 5, MkPair Nat Nat 3 6,
              MkPair Nat Nat 4 6, MkPair Nat Nat 5 0] in
          andb(module_maps_empty_boundary_case 1 [] [] [] [] (ROk (List Decl) []),
            andb(module_maps_empty_boundary_case 1 [MkPair Nat Nat 1 11]
                [MkPair Nat Nat 2 0] [MkPair Nat Nat 3 5, MkPair Nat Nat 4 6] []
                (ROk (List Decl) []),
              andb(module_maps_empty_boundary_case 1 heads refs errors []
                  (RErr (List Decl) 8 1),
                andb(module_maps_empty_boundary_case 1 [] refs errors []
                    (RErr (List Decl) 8 2),
                  andb(module_maps_empty_boundary_case 1 []
                      [MkPair Nat Nat 2 20, MkPair Nat Nat 4 40] errors []
                      (RErr (List Decl) 8 3),
                    andb(module_maps_empty_boundary_case 1 []
                        [MkPair Nat Nat 2 20, MkPair Nat Nat 4 40]
                        [MkPair Nat Nat 3 5, MkPair Nat Nat 4 6, MkPair Nat Nat 5 0] []
                        (RErr (List Decl) 8 4),
                      andb(module_maps_empty_boundary_case 1 [] [MkPair Nat Nat 2 20]
                          [MkPair Nat Nat 3 5, MkPair Nat Nat 4 6, MkPair Nat Nat 5 0] []
                          (RErr (List Decl) 8 5),
                        andb(module_maps_empty_boundary_case 1
                            [MkPair Nat Nat Z 0, MkPair Nat Nat 0 1] [] [] []
                            (RErr (List Decl) 8 Z),
                          andb(module_maps_empty_boundary_case 1 [] [MkPair Nat Nat 7 0]
                              [MkPair Nat Nat 7 5] [] (RErr (List Decl) 8 7),
                            andb(module_maps_empty_boundary_case 1 [] []
                                [MkPair Nat Nat 0 0] [] (RErr (List Decl) 8 Z),
                              module_maps_empty_boundary_case 1 heads refs errors
                                [DDef 99 (ESort 0) (EVar 98) 0 []]
                                (RErr (List Decl) 8 1))))))))))))
    ];

def module_bare_demand_laws : List Test :=
    [ assert_true "bare demand preserves sparse queries among ascending and descending unused ctors"
        (let names : List Nat := module_conflict_test_range 32 in
          let fields (shorts : List Nat) : List (Pair Nat Expr) :=
            map Nat (Pair Nat Expr)
              (fun (short : Nat) => MkPair Nat Expr short (EVar 20)) shorts in
          let members : List ModuleMember :=
            [MkModuleMember 1 31 70 False, MkModuleMember 1 33 80 True] in
          let refs : List (Pair Nat Nat) := [MkPair Nat Nat 10 70, MkPair Nat Nat 11 80] in
          andb(module_bare_ctors_case
              [mk_src_unit 1 [DInductive 20 [] (ESort 1) (fields names) 0,
                DAxiom 33 (ESort 0)] [31]] members refs []
              [10, 11, 10, 11, 10] [10, 10, 10],
            module_bare_ctors_case
              [mk_src_unit 1 [DInductive 20 [] (ESort 1) (fields (reverse Nat names)) 0,
                DAxiom 33 (ESort 0)] [31]] members refs []
              [10, 11, 10, 11, 10] [10, 10, 10]))
    , assert_true "bare demand keeps exact owner pairs and first nonctor or missing member"
        (module_bare_ctors_case
          [mk_src_unit 1 [DInductive 20 [] (ESort 1)
            [MkPair Nat Expr 7 (EVar 20), MkPair Nat Expr 8 (EVar 20)] 0] [],
            mk_src_unit 2 [DAxiom 7 (ESort 0)] []]
          [MkModuleMember 2 7 70 True, MkModuleMember 1 7 70 False,
            MkModuleMember 1 7 80 False, MkModuleMember 99 7 90 True,
            MkModuleMember 1 7 90 True]
          [MkPair Nat Nat 10 70, MkPair Nat Nat 11 80, MkPair Nat Nat 12 90] []
          [10, 11, 12, 10, 11, 12] [11, 11])
    , assert_true "bare demand marks first irrelevant or empty duplicate units before later ctors"
        (let irrelevant : SrcUnit := mk_src_unit 1 [DInductive 20 [] (ESort 1)
            [MkPair Nat Expr 9 (EVar 20)] 0] [] in
          let first : SrcUnit := mk_src_unit 1 [DInductive 21 [] (ESort 1)
            [MkPair Nat Expr 7 (EVar 21)] 0] [] in
          let empty : SrcUnit := mk_src_unit 2 [] [] in
          let second : SrcUnit := mk_src_unit 2 [DInductive 22 [] (ESort 1)
            [MkPair Nat Expr 8 (EVar 22)] 0] [] in
          let members : List ModuleMember :=
            [MkModuleMember 1 7 70 False, MkModuleMember 2 8 80 False] in
          let refs : List (Pair Nat Nat) := [MkPair Nat Nat 10 70, MkPair Nat Nat 11 80] in
          andb(module_bare_ctors_case [irrelevant, first, empty, second]
              members refs [] [10, 11, 10, 11] [],
            module_bare_ctors_case [first, irrelevant, second, empty]
              members refs [] [10, 11, 10, 11] [10, 11, 10, 11]))
    , assert_true "bare demand shares zero pair across symbols without changing private errors or refs"
        (module_bare_ctors_case
          [mk_src_unit Z [DInductive 20 [] (ESort 1)
            [MkPair Nat Expr 0 (EVar 20)] 0] [Z]]
          [MkModuleMember 0 Z Z False, MkModuleMember Z 0 70 False,
            MkModuleMember 0 9 70 True]
          [MkPair Nat Nat 10 Z, MkPair Nat Nat 10 999,
            MkPair Nat Nat 11 70, MkPair Nat Nat 11 999]
          [MkPair Nat Nat 10 0] [10, 11, 11, 0, Z, 10] [11, 11, 0, Z])
    , assert_true "bare demand distinguishes full owner short pairs beyond 64 bits in output order"
        (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
          let next : Nat := add wide 1 in
          module_bare_ctors_case
            [mk_src_unit wide [DInductive 20 [] (ESort 1)
              [MkPair Nat Expr next (EVar 20)] 0, DAxiom wide (ESort 0)] [],
              mk_src_unit next [DInductive 21 [] (ESort 1)
                [MkPair Nat Expr wide (EVar 21)] 0, DAxiom next (ESort 0)] []]
            [MkModuleMember wide next (add wide 2) True,
              MkModuleMember next wide (add wide 3) False,
              MkModuleMember wide wide (add wide 4) True,
              MkModuleMember next next (add wide 5) True,
              MkModuleMember (add wide 9) wide (add wide 6) True]
            [MkPair Nat Nat 1 (add wide 2), MkPair Nat Nat 2 (add wide 3),
              MkPair Nat Nat 3 (add wide 4), MkPair Nat Nat 4 (add wide 5),
              MkPair Nat Nat 5 (add wide 6)] [] [3, 1, 4, 2, 5, 1, 2] [1, 2, 1, 2])
    , assert_true "bare demand equates mixed 65 bit pair and ref values while retaining error zero"
        (let lower : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 6 in
          let wide : Nat := S lower in
          let next : Nat := S wide in
          let symbol : Nat := S next in
          module_bare_ctors_case
            [mk_src_unit wide [DInductive 20 [] (ESort 1)
              [MkPair Nat Expr next (EVar 20)] 0] [next],
              mk_src_unit next [DAxiom wide (ESort 0)] []]
            [MkModuleMember (add lower 1) (add lower 2) (add lower 3) False,
              MkModuleMember next wide (add lower 4) True]
            [MkPair Nat Nat 1 symbol, MkPair Nat Nat (S Z) (add lower 4),
              MkPair Nat Nat wide symbol, MkPair Nat Nat 10 (add lower 4),
              MkPair Nat Nat 2 symbol]
            [MkPair Nat Nat (S (S Z)) 0] [1, S Z, 2, S (S Z), wide, 10] [1, S Z, wide])
    ];

def module_rewrite_batch_state : InternState :=
  MkIntern [] 50 [MkPair (List Nat) Nat [0, 256] 3] 4;

def module_rewrite_batch_skipped : SrcUnit :=
  mk_src_unit 9 [DImport 404, DAxiom 7 (ESort 0)] [7, 7];

def module_rewrite_batch_skipped_equal (unit : SrcUnit) : Bool :=
  let (MkSrcUnit owner body) := unit in
  let (MkPair decls private_names) := body in
  if let Cons first rest := (decls : List Decl) then
    if let DImport path := (first : Decl) then
      if let Cons second tail := (rest : List Decl) then
        if let DAxiom name typ := (second : Decl) then
          if let ESort level := (typ : Expr) then
            andb(eqNat owner 9,
              andb(eqNat path 404,
                andb(eqNat name 7,
                  andb(eqNat level 0,
                    andb(module_conflicts_equal private_names [7, 7],
                      match tail with | Nil => True | Cons _ _ => False end)))))
          else False
        else False
      else False
    else False
  else False;

def module_rewrite_batch_axiom_equal (owner : Nat) (binder : Nat)
    (private_names : List Nat) (unit : SrcUnit) : Bool :=
  let (MkSrcUnit actual_owner body) := unit in
  let (MkPair decls actual_private) := body in
  if let Cons decl tail := (decls : List Decl) then
    if let DAxiom name typ := (decl : Decl) then
      if let EPi actual_binder domain codomain := (typ : Expr) then
        if let ESort level := (domain : Expr) then
          andb(eqNat actual_owner owner,
            andb(eqNat name 8,
              andb(eqNat actual_binder binder,
                andb(eqNat level 0,
                  andb(module_name_var binder codomain,
                    andb(module_conflicts_equal actual_private private_names,
                      match tail with | Nil => True | Cons _ _ => False end))))))
        else False
      else False
    else False
  else False;

def module_rewrite_batch_units_equal (wide : Nat) (units : List SrcUnit) : Bool :=
  if let Cons first rest := (units : List SrcUnit) then
    if let Cons skipped more := (rest : List SrcUnit) then
      if let Cons last tail := (more : List SrcUnit) then
        andb(module_rewrite_batch_axiom_equal 0 50 [8, 8] first,
          andb(module_rewrite_batch_skipped_equal skipped,
            andb(module_rewrite_batch_axiom_equal wide 51 [8] last,
              match tail with | Nil => True | Cons _ _ => False end)))
      else False
    else False
  else False;

def module_rewrite_batch_slot_equal (owner : Nat) (row : SourceModuleSlot) : Bool :=
  let (SourceModuleSlotOf actual_owner relation) := row in
  let (MkPair current original) := relation in
  match original with
  | Nothing => False
  | Just prior => andb(eqNat actual_owner owner,
      andb(source_slot_equal current (MkPair Nat Nat 1 8),
        source_slot_equal prior (MkPair Nat Nat 1 8)))
  end;

def module_rewrite_batch_slots_equal (retain : Bool) (wide : Nat)
    (slots : List SourceModuleSlot) : Bool :=
  if retain then
    if let Cons first rest := (slots : List SourceModuleSlot) then
      if let Cons second tail := (rest : List SourceModuleSlot) then
        andb(module_rewrite_batch_slot_equal 0 first,
          andb(module_rewrite_batch_slot_equal wide second,
            match tail with | Nil => True | Cons _ _ => False end))
      else False
    else False
  else match slots with | Nil => True | Cons _ _ => False end;

def module_rewrite_batch_case (retain : Bool) (wide : Nat) : Bool :=
  let units : List SrcUnit :=
    [mk_src_unit 0 [DAxiom 8 (EPi 7 (ESort 0) (EVar 7))] [8, 8],
      module_rewrite_batch_skipped,
      mk_src_unit wide [DAxiom 8 (EPi 7 (ESort 0) (EVar 7))] [8]] in
  let members : List ModuleMember :=
    [MkModuleMember 0 9 7 False, MkModuleMember wide 9 7 True] in
  let expected : InternState := MkIntern
    [MkPair (List Nat) Nat [95, 111, 117, 114, 111, 95, 98, 95, 55, 95, 49] 51,
      MkPair (List Nat) Nat [95, 111, 117, 114, 111, 95, 98, 95, 55, 95, 48] 50]
    52 [MkPair (List Nat) Nat [0, 256] 3] 4 in
  match module_rewrite_units_with_metadata retain 8 units [0, wide] []
      members [9] [] [9] [] module_rewrite_batch_state False with
  | RErr _ _ => False
  | ROk packet => let (ModuleResolvedUnitsOf result slots) := packet in
    let (MkPair rewritten final_state) := result in
    andb(module_rewrite_batch_units_equal wide rewritten,
      andb(module_members_intern_equal expected final_state,
        module_rewrite_batch_slots_equal retain wide slots))
  end;

def module_rewrite_batch_empty_or_skipped (units : List SrcUnit) : Bool :=
  match module_rewrite_units_with_metadata True 0 units [] [] [] [] [] [] []
      module_rewrite_batch_state False with
  | RErr _ _ => False
  | ROk packet => let (ModuleResolvedUnitsOf result slots) := packet in
    let (MkPair rewritten final_state) := result in
    andb(module_members_intern_equal module_rewrite_batch_state final_state,
      andb(match slots with | Nil => True | Cons _ _ => False end,
        match units with
        | Nil => match rewritten with | Nil => True | Cons _ _ => False end
        | Cons _ _ => if let Cons unit tail := (rewritten : List SrcUnit) then
            andb(module_rewrite_batch_skipped_equal unit,
              match tail with | Nil => True | Cons _ _ => False end)
          else False
        end))
  end;

def module_rewrite_isolated_batch_case (retain : Bool) (reached : List Nat)
    (isolate : Bool) : Bool :=
  let units : List SrcUnit :=
    [mk_src_unit 0 [DAxiom 8 (EPi 7 (ESort 0) (EVar 7))] [8, 8],
      module_rewrite_batch_skipped,
      mk_src_unit 1 [DAxiom 8 (EPi 7 (ESort 0) (EVar 7))] [8]] in
  let members : List ModuleMember :=
    [MkModuleMember 0 9 7 False, MkModuleMember 1 9 7 True] in
  let duplicate_members : List ModuleMember :=
    [MkModuleMember 0 9 7 False, MkModuleMember 0 9 77 True,
      MkModuleMember 1 9 7 True] in
  let scopes : List ModuleExports := if isolate then
      [MkModuleExports 0 [MkPair Nat Nat 9 7],
        MkModuleExports 1 [MkPair Nat Nat 9 7]]
    else [] in
  let expected : InternState := MkIntern
    [MkPair (List Nat) Nat [95, 111, 117, 114, 111, 95, 98, 95, 55, 95, 49] 51,
      MkPair (List Nat) Nat [95, 111, 117, 114, 111, 95, 98, 95, 55, 95, 48] 50]
    52 [MkPair (List Nat) Nat [0, 256] 3] 4 in
  andb (module_name_error ModuleResolvedUnits 8 9
      (module_rewrite_units_with_metadata retain 8 units reached []
        duplicate_members [9] [] [9] scopes module_rewrite_batch_state isolate))
    (match module_rewrite_units_with_metadata retain 8 units reached []
      members [9] [] [9] scopes module_rewrite_batch_state isolate with
  | RErr _ _ => False
  | ROk packet => let (ModuleResolvedUnitsOf result slots) := packet in
    let (MkPair rewritten final_state) := result in
    andb(module_rewrite_batch_units_equal 1 rewritten,
      andb(module_members_intern_equal expected final_state,
        module_rewrite_batch_slots_equal retain 1 slots))
  end);

def module_rewrite_batch_ref_equal (owner : Nat) (head : Nat) (target : Nat)
    (private_names : List Nat) (unit : SrcUnit) : Bool :=
  let (MkSrcUnit actual_owner body) := unit in
  let (MkPair decls actual_private) := body in
  if let Cons decl tail := (decls : List Decl) then
    if let DAxiom name typ := (decl : Decl) then
      andb(eqNat actual_owner owner,
        andb(eqNat name head,
          andb(module_name_var target typ,
            andb(module_conflicts_equal actual_private private_names,
              match tail with | Nil => True | Cons _ _ => False end))))
    else False
  else False;

def module_rewrite_batch_renamed_slot_equal (owner : Nat) (current_name : Nat)
    (prior_name : Nat) (row : SourceModuleSlot) : Bool :=
  let (SourceModuleSlotOf actual_owner relation) := row in
  let (MkPair current original) := relation in
  match original with
  | Nothing => False
  | Just prior => andb(eqNat actual_owner owner,
      andb(source_slot_equal current (MkPair Nat Nat 1 current_name),
        source_slot_equal prior (MkPair Nat Nat 1 prior_name)))
  end;

def module_rewrite_batch_scoped_exports_case (duplicate_scope : Bool) : Bool :=
  let units : List SrcUnit :=
    [mk_src_unit 0 [DAxiom 7 (EVar 10)] [7, 7],
      mk_src_unit 1 [DAxiom 8 (EVar 10)] [8]] in
  let members : List ModuleMember :=
    [MkModuleMember 0 7 70 False, MkModuleMember 1 8 80 True] in
  let duplicate_members : List ModuleMember :=
    [MkModuleMember 0 7 70 False, MkModuleMember 0 7 71 True,
      MkModuleMember 1 8 80 True] in
  let scopes : List ModuleExports :=
    Cons ModuleExports (MkModuleExports 0 [MkPair Nat Nat 10 100])
      (if duplicate_scope then
          [MkModuleExports 0 [MkPair Nat Nat 10 999],
            MkModuleExports 1 [MkPair Nat Nat 10 101]]
        else [MkModuleExports 1 [MkPair Nat Nat 10 101]]) in
  andb (module_name_error ModuleResolvedUnits 8 7
      (module_rewrite_units_with_metadata True 8 units [0, 1] []
        duplicate_members [] [] [] scopes module_rewrite_batch_state True))
    (match module_rewrite_units_with_metadata True 8 units [0, 1] []
      members [] [] [] scopes module_rewrite_batch_state True with
  | RErr _ _ => False
  | ROk packet => let (ModuleResolvedUnitsOf result slots) := packet in
    let (MkPair rewritten final_state) := result in
    let units_match : Bool := if let Cons first rest := (rewritten : List SrcUnit) then
        if let Cons second tail := (rest : List SrcUnit) then
          andb(module_rewrite_batch_ref_equal 0 70 100 [7, 7] first,
            andb(module_rewrite_batch_ref_equal 1 80 101 [8] second,
              match tail with | Nil => True | Cons _ _ => False end))
        else False
      else False in
    let slots_match : Bool := if let Cons first rest := (slots : List SourceModuleSlot) then
        if let Cons second tail := (rest : List SourceModuleSlot) then
          andb(module_rewrite_batch_renamed_slot_equal 0 70 7 first,
            andb(module_rewrite_batch_renamed_slot_equal 1 80 8 second,
              match tail with | Nil => True | Cons _ _ => False end))
        else False
      else False in
    andb(units_match, andb(slots_match,
      module_members_intern_equal module_rewrite_batch_state final_state))
  end);

def module_rewrite_batch_laws : List Test :=
  [ assert_true "rewrite batch preserves empty and skipped units at zero fuel"
      (andb(module_rewrite_batch_empty_or_skipped [],
        module_rewrite_batch_empty_or_skipped [module_rewrite_batch_skipped]))
  , assert_true "rewrite batch preserves ordered full units progressive state privacy and slots"
      (let wide : Nat := add (mul (pow_nat 2 32) (pow_nat 2 32)) 7 in
        andb(module_rewrite_batch_case True wide, module_rewrite_batch_case False (S (sub wide 1))))
  , assert_true "rewrite batch maps errors precede fuel and later unit errors"
      (let units : List SrcUnit :=
          [mk_src_unit 0 [DImport 404] [], mk_src_unit 1 [DImport 505] []] in
        andb(module_name_error ModuleResolvedUnits 2 404
            (module_rewrite_units_with_metadata True 0 units [0, 1] [] [] [] [] [] []
              module_rewrite_batch_state False),
          module_name_error ModuleResolvedUnits 8 0
            (module_rewrite_units_with_metadata True 0 [mk_src_unit 0 [] []]
              [0] [] [] [] [] [] [] module_rewrite_batch_state True)))
  , assert_true "rewrite batch retains zero fuel failure before declaration checks"
      (andb(module_name_error ModuleResolvedUnits 7 0
          (module_rewrite_units_with_metadata True 0 [mk_src_unit 0 [DAxiom 9 (ESort 0)] []]
            [0] [] [] [] [] [9] [] module_rewrite_batch_state False),
        module_name_error ModuleResolvedUnits 7 0
          (module_rewrite_units_with_metadata False 0 [mk_src_unit 0 [] []]
            [0] [] [] [] [] [] [] module_rewrite_batch_state False)))
  , assert_true "rewrite batch first declaration failure precedes tail import failure"
      (module_name_error ModuleResolvedUnits 8 9
        (module_rewrite_units_with_metadata True 8
          [mk_src_unit 0 [DAxiom 9 (ESort 0)] [], mk_src_unit 1 [DImport 505] []]
          [0, 1] [] [] [] [] [9] [] module_rewrite_batch_state False))
  , assert_true "rewrite batch preserves tail errors with and without slot retention"
      (let units : List SrcUnit :=
          [mk_src_unit 0 [DAxiom 8 (ESort 0)] [8], mk_src_unit 1 [DImport 505] []] in
        andb(module_name_error ModuleResolvedUnits 2 505
            (module_rewrite_units_with_metadata True 8 units [0, 1] [] [] [] [] [] []
              module_rewrite_batch_state False),
          module_name_error ModuleResolvedUnits 2 505
            (module_rewrite_units_with_metadata False 8 units [0, 1] [] [] [] [] [] []
              module_rewrite_batch_state False)))
  , assert_true "isolated batch preserves shared scope progressive binders units privacy and slots"
      (module_rewrite_isolated_batch_case True [0, 1] True)
  , assert_true "isolated batch keeps unit order and state with reordered repeated reached owners"
      (module_rewrite_isolated_batch_case False [1, 0, 1, 0] True)
  , assert_true "isolated batch leaves unreached imports and privacy intact at zero fuel"
      (match module_rewrite_units_with_metadata True 0 [module_rewrite_batch_skipped]
          [0, 1] [] [] [] [] [] [] module_rewrite_batch_state True with
       | RErr _ _ => False
       | ROk packet => let (ModuleResolvedUnitsOf result slots) := packet in
         let (MkPair rewritten final_state) := result in
         andb(module_members_intern_equal module_rewrite_batch_state final_state,
           andb(match slots with | Nil => True | Cons _ _ => False end,
             if let Cons unit tail := (rewritten : List SrcUnit) then
               andb(module_rewrite_batch_skipped_equal unit,
                 match tail with | Nil => True | Cons _ _ => False end)
             else False))
       end)
  , assert_true "nonisolated batch ignores absent isolation scopes with the same shared members"
      (module_rewrite_isolated_batch_case True [1, 0, 1] False)
  , assert_true "isolated batch uses each owner exports and rejects duplicate local heads"
      (module_rewrite_batch_scoped_exports_case False)
  , assert_true "isolated batch keeps the first duplicate owner scope and exact renamed slots"
      (module_rewrite_batch_scoped_exports_case True)
  , assert_true "isolated batch preserves first and later import error code and detail"
      (andb(module_name_error ModuleResolvedUnits 2 404
          (module_rewrite_units_with_metadata True 8
            [mk_src_unit 0 [DImport 404] [], mk_src_unit 1 [DImport 505] []]
            [0, 1] [] [] [] [] [] [] module_rewrite_batch_state True),
        module_name_error ModuleResolvedUnits 2 505
          (module_rewrite_units_with_metadata True 8
            [mk_src_unit 0 [DAxiom 8 (ESort 0)] [], mk_src_unit 1 [DImport 505] []]
            [0, 1] [] [] [] [] [] [MkModuleExports 0 []] module_rewrite_batch_state True)))
  , assert_true "isolated batch reports a later missing scope after a valid reached unit"
      (module_name_error ModuleResolvedUnits 8 1
        (module_rewrite_units_with_metadata True 8
          [mk_src_unit 0 [DAxiom 8 (ESort 0)] [], mk_src_unit 1 [] []]
          [0, 1] [] [] [] [] [] [MkModuleExports 0 []] module_rewrite_batch_state True))
  ];

def module_name_dedup_index_laws : List Test :=
  [ assert_true "name dedup keeps empty and singleton zero"
      (andb(module_conflicts_equal (module_all_names []) [],
        andb(module_conflicts_equal
          (module_all_names [MkModuleMember 0 Z 0 False]) [Z],
          andb(module_conflicts_equal (module_unique_names [] []) [],
            module_conflicts_equal (module_unique_names [Z] []) [Z]))))
  , assert_true "all names keep first short occurrence across owners and flags"
      (module_conflicts_equal
        (module_all_names
          [MkModuleMember 1 7 70 True, MkModuleMember 2 9 90 False,
           MkModuleMember 3 7 700 False, MkModuleMember 0 0 0 True,
           MkModuleMember 4 9 900 True, MkModuleMember 5 0 50 False])
        [0, 9, 7])
  , assert_true "unique names retain reverse second traversal and output order"
      (andb(module_conflicts_equal (module_unique_names [1, 2, 3] []) [3, 2, 1],
        andb(module_conflicts_equal (module_unique_names [] [1, 2, 3]) [1, 2, 3],
          module_conflicts_equal (module_unique_names [1, 2, 3] [4, 5]) [3, 2, 1, 4, 5])))
  , assert_true "unique names retain interleaved export duplicates and overlap order"
      (module_conflicts_equal
        (module_unique_names [7, 9, 7, 0] [9, 5, 9, 2, 5]) [0, 7, 9, 2, 5])
  , assert_true "isolated maps preserve duplicate export order with cold and retained names"
      (let lower : Nat := mul (pow_nat 2 32) (pow_nat 2 32) in
       let wide : Nat := add lower 7 in
       let equivalent : Nat := S (add lower 6) in
       let members : List ModuleMember :=
         [MkModuleMember 1 Z 70 True, MkModuleMember 1 7 71 False,
          MkModuleMember 2 8 80 True, MkModuleMember 2 wide 90 True,
          MkModuleMember 3 equivalent 91 True, MkModuleMember 3 9 99 False,
          MkModuleMember 3 10 100 True] in
       let exports : List (Pair Nat Nat) :=
         [MkPair Nat Nat equivalent 90, MkPair Nat Nat 11 110,
          MkPair Nat Nat 8 80, MkPair Nat Nat wide 90,
          MkPair Nat Nat 8 81, MkPair Nat Nat 0 123] in
       let common : List Nat := module_all_names members in
       let expected : ModuleMaps := module_scope_maps_previous 1
         (module_unique_names common (module_export_names exports)) members exports in
       let check (cached : Maybe (List Nat)) : Bool :=
         match module_maps_for_cached_pure [mk_src_unit 1 [] []] [] members [] []
             [MkModuleExports 1 exports] empty_intern 1
             (MkPair Bool (Maybe (List Nat)) True cached) with
         | RErr _ _ => False
         | ROk result =>
             let (MkPair scoped retained) := result in
             let (MkPair actual _) := scoped in
             match retained with
             | Nothing => False
             | Just names => andb(module_scope_maps_equal actual expected,
                 module_conflicts_equal names common)
             end
         end in
       andb(check (Nothing (List Nat)), check (Just (List Nat) common)))
  , assert_true "name dedup equates zero and mixed Peano keys"
      (andb(module_conflicts_equal
        (module_all_names
          [MkModuleMember 0 Z 7 False, MkModuleMember 1 0 9 True,
           MkModuleMember 2 (S Z) 10 True, MkModuleMember 3 1 11 False,
           MkModuleMember 4 (S (S Z)) 12 False, MkModuleMember 5 2 13 True])
        [S (S Z), S Z, Z],
        module_conflicts_equal (module_unique_names [0, 1, 2] [Z, S Z, S (S Z)])
          [Z, S Z, S (S Z)]))
  , assert_true "name dedup distinguishes complete keys beyond 64 bits"
      (let lower : Nat := mul (pow_nat 2 32) (pow_nat 2 32) in
       let wide : Nat := add lower 7 in
       let equivalent : Nat := S (add lower 6) in
       let next : Nat := add lower 8 in
       andb(module_conflicts_equal
         (module_all_names
           [MkModuleMember 0 wide 0 True, MkModuleMember 1 next 1 False,
            MkModuleMember 2 equivalent 2 True, MkModuleMember 3 Z 3 False,
            MkModuleMember 4 0 4 True])
         [Z, next, wide],
         module_conflicts_equal (module_unique_names [next, equivalent, 0] [wide, Z, wide])
           [next, Z, wide]))
  , assert_true "name dedup retains bounded ascending and descending traversal outputs"
      (let names : List Nat := module_conflict_test_range 32 in
       let members : List ModuleMember := map Nat ModuleMember
         (fun (name : Nat) => MkModuleMember 0 name name True) names in
       andb(module_conflicts_equal
         (module_all_names (append ModuleMember members (reverse ModuleMember members)))
         (reverse Nat names),
         andb(module_conflicts_equal (module_all_names (reverse ModuleMember members)) names,
           module_conflicts_equal
             (module_unique_names names (append Nat names (reverse Nat names)))
             (reverse Nat names))))
  ];

def module_ordinal_reuse_laws : List Test :=
  [ assert_true "members retain repeated-owner spellings at a nonzero ordinal"
      (module_members_case (module_members_test_state
          [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8] 10)
        0 [0, 1] [] [MkPair Nat Nat 1 7, MkPair Nat Nat 1 8] [] True
        (module_members_test_ok [MkModuleMember 1 7 10 True, MkModuleMember 1 8 11 True]
          (module_members_test_state
            [module_members_test_entry "_ouro_m_1_beta" 11,
              module_members_test_entry "_ouro_m_1_alpha" 10,
              module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8] 12)))
  , assert_true "members retain ordinal spellings when an earlier owner returns"
      (module_members_case (module_members_test_state
          [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8,
            module_members_test_entry "gamma" 9] 10)
        0 [1, 2] []
        [MkPair Nat Nat 1 7, MkPair Nat Nat 2 8, MkPair Nat Nat 1 9] [] True
        (module_members_test_ok
          [MkModuleMember 1 7 10 True, MkModuleMember 2 8 11 True, MkModuleMember 1 9 12 True]
          (module_members_test_state
            [module_members_test_entry "_ouro_m_0_gamma" 12,
              module_members_test_entry "_ouro_m_1_beta" 11,
              module_members_test_entry "_ouro_m_0_alpha" 10,
              module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8,
              module_members_test_entry "gamma" 9] 13)))
  , assert_true "members preserve an intervening root row and the repeated owner's ordinal"
      (module_members_case (module_members_test_state
          [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8,
            module_members_test_entry "gamma" 9] 10)
        0 [0, 1] []
        [MkPair Nat Nat 1 7, MkPair Nat Nat 0 9, MkPair Nat Nat 1 8] [] True
        (module_members_test_ok
          [MkModuleMember 1 7 10 True, MkModuleMember 0 9 9 True, MkModuleMember 1 8 11 True]
          (module_members_test_state
            [module_members_test_entry "_ouro_m_1_beta" 11,
              module_members_test_entry "_ouro_m_1_alpha" 10,
              module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8,
              module_members_test_entry "gamma" 9] 12)))
  , assert_true "members keep the first unit's empty private names across owner changes"
      (let ids : List (Pair (List Nat) Nat) :=
          [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8,
           module_members_test_entry "gamma" 9] in
        module_members_case (module_members_test_state ids 10) 2 [1, 2] []
          [MkPair Nat Nat 1 7, MkPair Nat Nat (S Z) 8, MkPair Nat Nat 2 7,
           MkPair Nat Nat 1 9, MkPair Nat Nat 2 9]
          [mk_src_unit 1 [] [], mk_src_unit (S Z) [] [7, 8, 9],
           mk_src_unit 2 [] [7, 9]] True
          (module_members_test_ok
            [MkModuleMember 1 7 10 True, MkModuleMember (S Z) 8 11 True,
             MkModuleMember 2 7 7 False, MkModuleMember 1 9 12 True,
             MkModuleMember 2 9 9 False]
            (module_members_test_state
              (append (Pair (List Nat) Nat)
                [module_members_test_entry "_ouro_m_0_gamma" 12,
                 module_members_test_entry "_ouro_m_0_beta" 11,
                 module_members_test_entry "_ouro_m_0_alpha" 10] ids) 13)))
  , assert_true "members retain the first reached ordinal for equal numeral and Peano owners"
      (module_members_case (module_members_test_state
          [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8] 10)
        0 [99, S (S Z), 2, 0] []
        [MkPair Nat Nat 2 7, MkPair Nat Nat (S (S Z)) 8] [] True
        (module_members_test_ok
          [MkModuleMember 2 7 10 True, MkModuleMember (S (S Z)) 8 11 True]
          (module_members_test_state
            [module_members_test_entry "_ouro_m_1_beta" 11,
              module_members_test_entry "_ouro_m_1_alpha" 10,
              module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8] 12)))
  , assert_true "members retain a missing-owner error after a repeated-owner run"
      (module_members_case (module_members_test_state
          [module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8,
            module_members_test_entry "gamma" 9] 10)
        0 [0, 1] []
        [MkPair Nat Nat 1 7, MkPair Nat Nat 1 8, MkPair Nat Nat 99 9] [] True
        (module_members_test_error 99))
  , assert_true "members retain repeated-owner collision detail before a later missing owner"
      (module_members_case (module_members_test_state
          [module_members_test_entry "_ouro_m_1_beta" 20,
            module_members_test_entry "alpha" 7, module_members_test_entry "beta" 8] 10)
        0 [0, 1] []
        [MkPair Nat Nat 1 7, MkPair Nat Nat 1 8, MkPair Nat Nat 99 7] [] True
        (module_members_test_error 20))
  ];

def module_private_validation_laws : List Test :=
  [ assert_true "private validation accepts empty and no-private units"
      (andb(module_name_ok Unit (module_validate_private []),
        andb(module_name_ok Unit (module_validate_private [mk_src_unit 0 [] []]),
          module_name_ok Unit
            (module_validate_private [mk_src_unit 0 [DAxiom 7 (ESort 0)] []]))))
  , assert_true "private validation accepts repeated declared and generated member names"
      (module_name_ok Unit
        (module_validate_private
          [mk_src_unit 0
            [DAxiom 7 (ESort 0),
              DInductive 8 [] (ESort 0) [MkPair Nat Expr 9 (EVar 8)] 0,
              DEffect 10 [] [MkPair Nat Expr 11 (ESort 0)]] [7, 8, 9, 10, 11, 7]]))
  , assert_true "private validation keeps first invalid-name priority after a no-private unit"
      (module_name_error Unit 8 9
        (module_validate_private
          [mk_src_unit 0 [DAxiom 7 (ESort 0)] [],
            mk_src_unit 1 [DAxiom 8 (ESort 0)] [8, 9, 10],
            mk_src_unit 2 [] [11]]))
  , assert_true "private validation rejects an invalid unreachable supplied unit in both APIs"
      (let units : List SrcUnit := [mk_src_unit 0 [] [], mk_src_unit 99 [] [7]] in
        andb(module_name_error ModuleResolvedUnits 8 7
            (module_resolve_units_with_slots 80 units [] 0 empty_intern),
          module_name_error (Pair (List SrcUnit) InternState) 8 7
            (module_resolve_units 80 units [] 0 empty_intern)))
  , assert_true "private validation failure precedes duplicate-unit and missing-import failures"
      (let units : List SrcUnit :=
          [mk_src_unit 0 [DAxiom 7 (ESort 0), DImport 404] [9], mk_src_unit 0 [] []] in
        andb(module_name_error ModuleResolvedUnits 8 9
            (module_resolve_units_with_slots 80 units [] 0 empty_intern),
          module_name_error (Pair (List SrcUnit) InternState) 8 9
            (module_resolve_units 80 units [] 0 empty_intern)))
  ];

def main : IO Unit := test_run (append Test (append Test (append Test (append Test
  (append Test (append Test (append Test
  (append Test module_name_laws (append Test module_export_dedup_laws module_shadow_exports_laws))
  module_scope_maps_laws)
  module_bare_ctors_laws) module_invalid_maps_laws)
  module_bare_demand_laws) module_rewrite_batch_laws) module_name_dedup_index_laws)
  (append Test module_ordinal_reuse_laws module_private_validation_laws));
