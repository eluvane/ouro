-- Focused laws for binding-aware module identity rewriting.
import "../compiler/module_names.ouro",
  "../std/test.ouro";

def module_name_error (A : Type) (code : Nat) (detail : Nat)
    (result : ResolveResult A) : Bool :=
    match result with
    | ROk _ => False
    | RErr actual at => andb(eqNat actual code, eqNat at detail)
    end;

def module_name_ok (A : Type) (result : ResolveResult A) : Bool :=
    match result with
    | ROk _ => True
    | RErr _ _ => False
    end;

def module_name_nat (want : Nat) (result : ResolveResult Nat) : Bool :=
    match result with
    | ROk got => eqNat got want
    | RErr _ _ => False
    end;

def module_name_var (want : Nat) (expr : Expr) : Bool :=
    match expr with
    | EVar name => eqNat name want
    | EHole _ => False
    | ESort _ => False
    | ENat _ => False
    | EApp _ _ => False
    | ELam _ _ _ => False
    | EPi _ _ _ => False
    | ELet _ _ _ _ => False
    | EAscribe _ _ => False
    | EMatch _ _ => False
    | EFix _ _ _ _ => False
    | EEffectRow _ _ => False
    | EPerform _ _ => False
    | EDo _ => False
    | EHandle _ _ => False
    | EBranch _ _ _ => False
    | ENoBranch => False
    | EBinder _ _ _ => False
    | ENoBinder => False
    | EMultiMatch _ _ => False
    | EStr _ => False
    | EDoBind _ _ => False
    | EList _ => False
    | ESpan _ _ _ => False
    | EOpen _ _ => False
    | ENamedCall _ _ => False
    | EFallible _ _ _ _ => False
    end;

def module_name_def (head : Nat) (typ : Nat) (body : Nat)
    (decl : Decl) : Bool :=
    match decl with
    | DDef name signature value _ _ =>
        andb(eqNat name head,
          andb(module_name_var typ signature, module_name_var body value))
    | DAxiom _ _ => False
    | DInductive _ _ _ _ _ => False
    | DEffect _ _ _ => False
    | DImport _ => False
    | DIntrinsic _ _ _ _ => False
    | DExtern _ _ _ => False
    | DRepresentation _ _ => False
    end;

def module_name_representation (target : Nat) (label : Nat)
    (decl : Decl) : Bool :=
    match decl with
    | DDef _ _ _ _ _ => False
    | DAxiom _ _ => False
    | DInductive _ _ _ _ _ => False
    | DEffect _ _ _ => False
    | DImport _ => False
    | DIntrinsic _ _ _ _ => False
    | DExtern _ _ _ => False
    | DRepresentation name actual =>
        andb(eqNat name target, eqNat actual label)
    end;

def module_name_inductive (head : Nat) (ctor : Nat)
    (decl : Decl) : Bool :=
    match decl with
    | DDef _ _ _ _ _ => False
    | DAxiom _ _ => False
    | DInductive name _ _ ctors _ =>
        andb (eqNat name head)
          (match ctors with
           | Nil => False
           | Cons pair rest =>
               match pair with
               | MkPair actual _ =>
                   andb(eqNat actual ctor,
                     match rest with | Nil => True | Cons _ _ => False end)
               end
           end)
    | DEffect _ _ _ => False
    | DImport _ => False
    | DIntrinsic _ _ _ _ => False
    | DExtern _ _ _ => False
    | DRepresentation _ _ => False
    end;

def module_name_effect (head : Nat) (op : Nat)
    (decl : Decl) : Bool :=
    match decl with
    | DDef _ _ _ _ _ => False
    | DAxiom _ _ => False
    | DInductive _ _ _ _ _ => False
    | DEffect name _ operations =>
        andb (eqNat name head)
          (match operations with
           | Nil => False
           | Cons pair rest =>
               match pair with
               | MkPair actual _ =>
                   andb(eqNat actual op,
                     match rest with | Nil => True | Cons _ _ => False end)
               end
           end)
    | DImport _ => False
    | DIntrinsic _ _ _ _ => False
    | DExtern _ _ _ => False
    | DRepresentation _ _ => False
    end;

def module_name_single (check : Decl -> Bool)
    (result : ResolveResult (List Decl)) : Bool :=
    match result with
    | RErr _ _ => False
    | ROk decls =>
        match decls with
        | Nil => False
        | Cons first rest =>
            match rest with
            | Nil => check first
            | Cons _ _ => False
            end
        end
    end;

def module_name_two_defs (result : ResolveResult (List Decl)) : Bool :=
    match result with
    | RErr _ _ => False
    | ROk decls =>
        match decls with
        | Nil => False
        | Cons first rest =>
            match rest with
            | Nil => False
            | Cons second tail =>
                andb(module_name_def 110 2 3 first,
                  andb(module_name_def 110 2 3 second,
                    match tail with | Nil => True | Cons _ _ => False end))
            end
        end
    end;

def module_name_pattern_pair (head : Nat) (bound_name : Nat)
    (result : ResolveResult (Pair Nat (List Nat))) : Bool :=
    match result with
    | RErr _ _ => False
    | ROk pair =>
        match pair with
        | MkPair actual scope =>
            andb(eqNat actual head, memNat bound_name scope)
        end
    end;

def module_name_global_rewrite : Bool :=
    module_name_single (module_name_def 110 110 110)
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110] [MkPair Nat Nat 10 110]
        [] [] [] [DDef 10 (EVar 10) (EVar 10) 0 []]);

def module_name_marked_def_metadata : Bool :=
    module_name_single
      (fun (decl : Decl) => match decl with
       | DDef name _ _ marked declared =>
           andb(eqNat name 110,
             andb(eqNat marked 1, eqNat(length DefParam declared) 2))
       | DAxiom _ _ => False
       | DInductive _ _ _ _ _ => False
       | DEffect _ _ _ => False
       | DImport _ => False
       | DIntrinsic _ _ _ _ => False
       | DExtern _ _ _ => False
       | DRepresentation _ _ => False
       end)
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110] [] [] [] []
        [DDef 10 (EPi 41 (ESort 0) (EPi 42 (EVar 41) (EVar 41)))
          (ELam 41 (Just Expr (ESort 0))
            (ELam 42 (Just Expr (EVar 41)) (EVar 42))) 1
            [DefParamOf 41 41 (Nothing Expr),
              DefParamOf 42 42 (Nothing Expr)]]);

def module_name_duplicate_declarations : Bool :=
    module_name_two_defs
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110] [MkPair Nat Nat 2 2, MkPair Nat Nat 3 3]
        [] [] []
        [DDef 10 (EVar 2) (EVar 3) 0 [],
          DDef 10 (EVar 2) (EVar 3) 0 []]);

def module_name_constructor_head : Bool :=
    module_name_single (module_name_inductive 120 130)
      (module_rewrite_decls 80
        [MkPair Nat Nat 20 120, MkPair Nat Nat 30 130]
        [MkPair Nat Nat 20 120] [] [] [30]
        [DInductive 20 [] (ESort 1)
          [MkPair Nat Expr 30 (EVar 20)] 0]);

def module_name_effect_head : Bool :=
    module_name_single (module_name_effect 140 150)
      (module_rewrite_decls 80
        [MkPair Nat Nat 40 140, MkPair Nat Nat 50 150]
        [MkPair Nat Nat 40 140] [] [] []
        [DEffect 40 [] [MkPair Nat Expr 50 (EVar 40)]]);

def module_name_representation_target : Bool :=
    module_name_single (module_name_representation 160 70)
      (module_rewrite_decls 80 []
        [MkPair Nat Nat 60 160] [] [] []
        [DRepresentation 60 70]);

def module_name_lexical_scope : Bool :=
    andb (module_name_nat 10
      (module_ref [MkPair Nat Nat 10 110] [] [10] 10))
      (module_name_ok (List Decl)
        (module_rewrite_decls 80 [] [] [MkPair Nat Nat 10 5] [] []
          [DDef 20 (EPi 10 (ESort 0) (EVar 10))
            (ELam 10 (Just Expr (ESort 0)) (EVar 10)) 0 []]));

def module_name_fix_scope : Bool :=
    andb (module_name_ok Expr
      (module_rewrite_expr [] [MkPair Nat Nat 11 5] [] [] 80 []
        (EFix 11 (EBinder 12 (ESort 0) ENoBinder)
          (EVar 12) (EVar 11))))
      (module_name_error Expr 5 11
        (module_rewrite_expr [] [MkPair Nat Nat 11 5] [] [] 80 []
          (EFix 11 (EBinder 12 (EVar 11) ENoBinder)
            (EVar 12) (EVar 11))));

def module_name_do_scope : Bool :=
    andb (module_name_ok Expr
      (module_rewrite_expr [] [MkPair Nat Nat 7 5] [] [] 80 []
        (EDo [EDoBind 7 (ENat 1), ESpan 1 2 (EVar 7)])))
      (module_name_error Expr 5 7
        (module_rewrite_expr [] [MkPair Nat Nat 7 5] [] [] 80 []
          (EDo [EDoBind 7 (EVar 7), EVar 7])));

def module_name_constructor_namespace : Bool :=
    andb
      (module_name_pattern_pair 130 7
        (module_pattern_head [MkPair Nat Nat 30 130] [] [] [30] 30 [7]))
      (andb
        (module_name_pattern_pair 40 40
          (module_pattern_head [] [MkPair Nat Nat 40 5] [] [] 40 []))
        (module_name_ok Expr
          (module_rewrite_expr [MkPair Nat Nat 30 130]
            [MkPair Nat Nat 7 5] [] [30] 80 [30]
            (EBranch [30, 7] (EVar 7) ENoBranch))));

def module_name_qualified_pattern_kind : Bool :=
    andb (module_name_pattern_pair 130 7
      (module_pattern_head [MkPair Nat Nat 99 130] [] [99] [99] 99 [7]))
      (andb (module_name_error (Pair Nat (List Nat)) 8 99
        (module_pattern_head [MkPair Nat Nat 99 130] [] [99] [] 99 []))
        (andb (module_name_error (Pair Nat (List Nat)) 8 99
          (module_pattern_head [] [MkPair Nat Nat 99 5] [99] [] 99 []))
          (andb (module_name_error Expr 8 99
            (module_rewrite_expr [MkPair Nat Nat 99 130] [] [99] [] 80 []
              (EBranch [99] (ENat 0) ENoBranch)))
            (module_name_error Expr 8 99
              (module_rewrite_expr [] [MkPair Nat Nat 99 5] [99] [] 80 []
                (EMultiMatch [ENat 0]
                  [MkPair (List (Pair Nat (List Nat))) Expr
                    [MkPair Nat (List Nat) 99 []] (ENat 0)]))))));

def module_name_marked_ctor_branch : Bool :=
    module_name_ok Expr
      (module_rewrite_expr [MkPair Nat Nat 99 130] [] [99] [99] 80 []
        (EBranch [99, 7] (EVar 7) ENoBranch));

def module_name_pattern_scope : Bool :=
    andb (module_name_ok Expr
      (module_rewrite_expr [] [MkPair Nat Nat 40 5] [] [] 80 []
        (EBranch [40] (EVar 40) ENoBranch)))
      (module_name_ok Expr
        (module_rewrite_expr [MkPair Nat Nat 30 130]
          [MkPair Nat Nat 40 5] [] [30] 80 []
          (EMultiMatch [ENat 0, ENat 1]
            [MkPair (List (Pair Nat (List Nat))) Expr
              [MkPair Nat (List Nat) 30 [7],
               MkPair Nat (List Nat) 40 []]
              (EVar 40)])));

def module_name_effect_namespace : Bool :=
    andb (module_name_error Expr 5 50
      (module_rewrite_expr [] [MkPair Nat Nat 50 5] [] [] 80 [50]
        (EEffectRow (ESort 0) [50])))
      (andb (module_name_error Expr 5 50
        (module_rewrite_expr [] [MkPair Nat Nat 50 5] [] [] 80 [50]
          (EPerform 50 [])))
        (module_name_error Expr 5 50
          (module_rewrite_expr [] [MkPair Nat Nat 50 5] [] [] 80 [50]
            (EHandle (ENat 0)
              [MkPair Nat (Pair (List Nat) Expr) 50
                (MkPair (List Nat) Expr [51] (EVar 51))]))));

def module_name_nested_positions : Bool :=
    andb (module_name_error (List Decl) 5 77
      (module_rewrite_decls 80 [] []
        [MkPair Nat Nat 77 5] [] []
        [DIntrinsic 70 (ESort 0) 1 (Just Expr (EVar 77))]))
      (andb (module_name_error (List Decl) 5 77
        (module_rewrite_decls 80 [] []
          [MkPair Nat Nat 77 5] [] []
          [DExtern 70 (EVar 77) []]))
        (module_name_error (List Decl) 5 77
          (module_rewrite_decls 80 [] []
            [MkPair Nat Nat 77 5] [] []
            [DInductive 70 [] (ESort 0)
              [MkPair Nat Expr 71 (EVar 77)] 0])));

def module_name_marker_rejection : Bool :=
    andb (module_name_error (List Decl) 8 99
      (module_rewrite_decls 80 [] [] [] [99] []
        [DDef 99 (ESort 0) (ENat 0) 0 []]))
      (andb (module_name_error (List Decl) 8 99
        (module_rewrite_decls 80 [] [] [] [99] []
          [DInductive 20 [] (ESort 0)
            [MkPair Nat Expr 99 (ESort 0)] 0]))
        (andb (module_name_error (List Decl) 8 99
          (module_rewrite_decls 80 [] [] [] [99] []
            [DDef 20 (ESort 0)
              (ELam 99 (Just Expr (ESort 0)) (EVar 99)) 0 []]))
          (module_name_error Expr 8 99
            (module_rewrite_expr [] [] [99] [30] 80 []
              (EBranch [30, 99] (EVar 99) ENoBranch)))));

def module_name_marker_nested : Bool :=
    andb (module_name_error Expr 8 99
      (module_rewrite_expr [] [] [99] [] 80 []
        (EDo [EDoBind 99 (ENat 0), EVar 99])))
      (andb (module_name_error Expr 8 99
        (module_rewrite_expr [] [] [99] [] 80 []
          (EHandle (ENat 0)
            [MkPair Nat (Pair (List Nat) Expr) 50
              (MkPair (List Nat) Expr [51, 99] (EVar 99))])))
        (module_name_error (List Decl) 8 99
          (module_rewrite_decls 80 [] [] [] [99] []
            [DEffect 20 [MkPair Nat Expr 99 (ESort 0)]
              [MkPair Nat Expr 21 (ESort 0)]])));

def module_name_marker_other_binders : Bool :=
    andb (module_name_error Expr 8 99
      (module_rewrite_expr [] [] [99] [] 80 []
        (EPi 99 (ESort 0) (EVar 99))))
      (andb (module_name_error Expr 8 99
        (module_rewrite_expr [] [] [99] [] 80 []
          (ELet 99 (Nothing Expr) (ENat 0) (EVar 99))))
        (andb (module_name_error Expr 8 99
          (module_rewrite_expr [] [] [99] [] 80 []
            (EFix 99 ENoBinder (ESort 0) (EVar 99))))
          (module_name_error Expr 8 99
            (module_rewrite_expr [] [] [99] [] 80 []
              (EBinder 99 (ESort 0) ENoBinder)))));

def module_name_marker_reference : Bool :=
    andb (module_name_nat 199
      (module_ref [MkPair Nat Nat 99 199] [] [] 99))
      (module_name_single (module_name_representation 199 70)
        (module_rewrite_decls 80 []
          [MkPair Nat Nat 99 199] [] [99] []
          [DRepresentation 99 70]));

def module_name_map_errors : Bool :=
    andb (module_name_error (List Decl) 8 10
      (module_rewrite_decls 80
        [MkPair Nat Nat 10 110, MkPair Nat Nat 10 111] [] [] [] [] []))
      (andb (module_name_error (List Decl) 8 10
        (module_rewrite_decls 80 []
          [MkPair Nat Nat 10 110, MkPair Nat Nat 10 111] [] [] [] []))
        (andb (module_name_error (List Decl) 8 10
          (module_rewrite_decls 80 [] []
            [MkPair Nat Nat 10 5, MkPair Nat Nat 10 6] [] [] []))
          (module_name_error (List Decl) 8 10
            (module_rewrite_decls 80 []
              [MkPair Nat Nat 10 110] [MkPair Nat Nat 10 5] [] [] []))));

def module_name_invalid_code_and_fuel : Bool :=
    andb (module_name_error (List Decl) 8 10
      (module_rewrite_decls 80 [] []
        [MkPair Nat Nat 10 4] [] [] []))
      (andb (module_name_error (List Decl) 7 0
        (module_rewrite_decls 0 [] [] [] [] [] []))
        (module_name_error (List Decl) 7 0
          (module_rewrite_decls 1 [] [] [] [] []
            [DDef 20 (ESort 0)
              (ELam 30 (Just Expr (ESort 0)) (EVar 30)) 0 []])));

def module_name_reference_errors : Bool :=
    andb (module_name_error (List Decl) 5 77
      (module_rewrite_decls 80 [] []
        [MkPair Nat Nat 77 5] [] []
        [DRepresentation 77 1]))
      (module_name_error (List Decl) 6 77
        (module_rewrite_decls 80 [] []
          [MkPair Nat Nat 77 6] [] []
          [DDef 20 (ESort 0) (EVar 77) 0 []]));

def module_name_binder_hygiene : Bool :=
    let refs : List (Pair Nat Nat) := [MkPair Nat Nat 99 10] in
    let binders : List (Pair Nat Nat) := [MkPair Nat Nat 10 210] in
    let global : ResolveResult Expr :=
      module_rewrite_expr_with_binders refs [] [99] [] binders 80 []
        (ELam 10 (Nothing Expr) (EVar 99)) in
    let local : ResolveResult Expr :=
      module_rewrite_expr_with_binders refs [] [99] [] binders 80 []
        (ELam 10 (Nothing Expr) (EVar 10)) in
    andb
      (match global with
       | ROk expr => match expr with
           | ELam name _ value =>
               andb(eqNat name 210, module_name_var 10 value)
           | _ => False
           end
       | RErr _ _ => False
       end)
      (match local with
       | ROk expr => match expr with
           | ELam name _ value =>
               andb(eqNat name 210, module_name_var 210 value)
           | _ => False
           end
       | RErr _ _ => False
       end);

def module_name_scoped_open : Bool :=
    let opened : List ModuleOpen :=
      [ MkModuleOpen 10 [MkPair Nat Nat 5 105] []
      , MkModuleOpen 11 [MkPair Nat Nat 5 205] []
      ] in
    let errors : List (Pair Nat Nat) := [MkPair Nat Nat 5 6] in
    let binders : List (Pair Nat Nat) := [MkPair Nat Nat 5 305] in
    let rewrite : Expr -> ResolveResult Expr :=
      module_rewrite_expr_with_opens [] errors opened [] [] binders 80 [] in
    andb (match rewrite (EOpen 10 (EVar 5)) with
      | ROk expr => module_name_var 105 expr
      | RErr _ _ => False end,
    andb (match rewrite (EOpen 10 (EOpen 11 (EVar 5))) with
      | ROk expr => module_name_var 205 expr
      | RErr _ _ => False end,
    andb (match rewrite (EOpen 11 (ELam 5 (Nothing Expr) (EVar 5))) with
      | ROk expr => match expr with
        | ELam name _ body => andb(eqNat name 305, module_name_var 305 body)
        | _ => False end
      | RErr _ _ => False end,
    andb (module_name_error Expr 6 5
      (rewrite (EApp (EOpen 10 (EVar 5)) (EVar 5))),
    andb (module_name_error Expr 8 12 (rewrite (EOpen 12 (EVar 5))),
      module_name_error Expr 6 5 (rewrite (EVar 5)))))));

def module_name_fallible_roles_in_open : Bool :=
  let opened : List ModuleOpen :=
    [MkModuleOpen 10 [MkPair Nat Nat 20 120, MkPair Nat Nat 21 121]
      [20, 21]] in
  let rewrite : Expr -> ResolveResult Expr :=
    module_rewrite_expr_with_opens [] [] opened [] [] [] 80 [] in
  andb
    (match rewrite (EOpen 10 (EFallible (EVar 30) 20 21 (EVar 30))) with
    | ROk expr => match expr with
      | EFallible container failure success body =>
          andb(module_name_var 30 container,
            andb(eqNat failure 120,
              andb(eqNat success 121, module_name_var 30 body)))
      | _ => False
      end
    | RErr _ _ => False
    end)
    (module_name_error Expr 8 22
      (rewrite (EOpen 10 (EFallible (EVar 30) 20 22 (EVar 30)))));

def module_name_laws : List Test :=
    [ assert_true "module head/reference remap" module_name_global_rewrite
    , assert_true "marked definition metadata survives head remap"
        module_name_marked_def_metadata
    , assert_true "duplicate declarations remain for checker" module_name_duplicate_declarations
    , assert_true "constructor heads" module_name_constructor_head
    , assert_true "effect heads" module_name_effect_head
    , assert_true "representation target, label preserved" module_name_representation_target
    , assert_true "lexical lambda and Pi scope" module_name_lexical_scope
    , assert_true "recursive binder only in body" module_name_fix_scope
    , assert_true "do binder starts after action" module_name_do_scope
    , assert_true "constructor namespace beats local binder" module_name_constructor_namespace
    , assert_true "qualified patterns require constructor targets" module_name_qualified_pattern_kind
    , assert_true "qualified constructor branch rewrites" module_name_marked_ctor_branch
    , assert_true "variable patterns and multi-match scope" module_name_pattern_scope
    , assert_true "effect labels ignore term binders" module_name_effect_namespace
    , assert_true "specialization, extern, constructor type traversal" module_name_nested_positions
    , assert_true "marker declaration and local rejection" module_name_marker_rejection
    , assert_true "marker nested binder rejection" module_name_marker_nested
    , assert_true "marker Pi, let, fix, telescope rejection" module_name_marker_other_binders
    , assert_true "marker references remain legal" module_name_marker_reference
    , assert_true "malformed maps rejected" module_name_map_errors
    , assert_true "invalid code and fuel rejected" module_name_invalid_code_and_fuel
    , assert_true "unknown and ambiguous reference codes" module_name_reference_errors
    , assert_true "qualified globals survive lexical shadows" module_name_binder_hygiene
    , assert_true "scoped opens select innermost owner without leaking" module_name_scoped_open
    , assert_true "fallible constructor roles resolve inside open" module_name_fallible_roles_in_open
    ];

def main : IO Unit := test_run module_name_laws;
