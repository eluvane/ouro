-- Local type definitions guide source elaboration without duplicating values
-- in the emitted computation. Strict declaration checking accepts the result.

import "compiler_refine_result_fixtures.ouro";
import "../compiler/file_elab.ouro";
import "../compiler/file_elab_lookup.ouro";
import "compiler_core_test_decls.ouro";
import "compiler_test_phase.ouro";

inductive LetRefineLaw : Type :=
  | MkLetRefineLaw : String -> Bool -> String -> LetRefineLaw;

def let_refine_fuel : Nat := mul 50 40;
def let_refine_type_function : CoreTerm := CPi (CSort 0) (CSort 0);
def let_refine_dependent_type : CoreTerm := CPi (CSort 0) (CPi (CRel 0) (CRel 1));

def let_refine_signature : List Entry :=
    [ MkEntry 77 refine_result_function (Nothing CoreTerm)
    , MkEntry 78 (CPi refine_result_nat refine_result_function) (Nothing CoreTerm)
    , MkIndEntry 10 refine_result_decl
    ];

def let_refine_status (result : DeclarationResult) : String :=
    match result with
    | DeclarationsOk _ => "accepted"
    | DeclarationsErr name phase failure =>
        prim_string_concat "declaration=" (prim_string_concat (prim_string_of_nat name)
          (prim_string_concat " phase=" (prim_string_concat (prim_string_of_nat (compiler_test_phase_nat phase))
            (prim_string_concat " family=" (prim_string_of_nat
              (refine_result_kind CoreTerm (CheckErr CoreTerm failure)))))))
    end;

def let_refine_result (expected : CoreTerm) (term : CoreTerm) : DeclarationResult :=
    check_declaration CheckSourceCore let_refine_fuel let_refine_signature (FDef 90 expected term);

def let_refine_accept (name : String) (expected : CoreTerm) (term : CoreTerm) : LetRefineLaw :=
    let result : DeclarationResult := let_refine_result expected term in
    MkLetRefineLaw name
      (match result with | DeclarationsOk _ => True | DeclarationsErr _ _ _ => False end)
      (let_refine_status result);

def let_refine_reject (name : String) (family : Nat) (expected : CoreTerm)
    (term : CoreTerm) : LetRefineLaw :=
    let result : DeclarationResult := let_refine_result expected term in
    MkLetRefineLaw name
      (match result with
       | DeclarationsOk _ => False
       | DeclarationsErr id phase failure =>
           andb (eqNat id 90) (andb (eqNat (compiler_test_phase_nat phase) 2)
             (eqNat family (refine_result_kind CoreTerm (CheckErr CoreTerm failure))))
       end) (let_refine_status result);

def let_refine_emitted (name : String) (typ : CoreTerm) (input : CoreTerm)
    (expected : CoreTerm) : LetRefineLaw :=
    let result : DeclarationResult := let_refine_result typ input in
    MkLetRefineLaw name
      (match result with
       | DeclarationsErr _ _ _ => False
       | DeclarationsOk entries =>
           match lookup_const 90 entries with
           | Nothing => False
           | Just body => eqTerm let_refine_fuel body expected
           end
       end) (let_refine_status result);

def let_refine_equal (name : String) (expected : CoreTerm) (actual : CoreTerm) : LetRefineLaw :=
    MkLetRefineLaw name (eqTerm let_refine_fuel expected actual) "different Core term";

def let_refine_function_alias (annotation : CoreTerm) : CoreTerm :=
    CLetIn let_refine_type_function (CSort 1)
      (CLetIn (CLam annotation (CRel 0)) (CRel 0) (CRel 0));

def let_refine_alias_chain : CoreTerm :=
    CLetIn (CSort 0) (CSort 1)
      (CLetIn (CPi (CRel 0) (CRel 1)) (CSort 1)
        (CLetIn (CRel 0) (CSort 1)
          (CLetIn (CLam (CInd 0) (CRel 0)) (CRel 0) (CRel 0))));

def let_refine_alias_under_binder : CoreTerm :=
    CLam (CSort 0)
      (CLetIn (CPi (CRel 0) (CRel 1)) (CSort 0)
        (CLetIn (CLam (CInd 0) (CRel 0)) (CRel 0) (CRel 0)));

def let_refine_function_argument : CoreTerm :=
    CLetIn let_refine_type_function (CSort 1)
      (CLetIn (CLam (CRel 0) (CRel 0)) (CPi (CRel 0) (CRel 1))
        (CApp (CRel 0) (CLam (CInd 0) (CRel 0))));

def let_refine_dependent_call : CoreTerm :=
    CLetIn let_refine_dependent_type (CSort 1)
      (CLetIn (CLam (CInd 0) (CLam (CInd 0) (CRel 0))) (CRel 0)
        (CApp (CApp (CRel 0) refine_result_nat) refine_result_zero));

def let_refine_match_value : CoreTerm :=
    CLetIn refine_result_nat (CSort 0)
      (CLetIn refine_result_zero (CRel 0)
        (CCase refine_result_info (CInd 999) (CRel 0)
          ([refine_result_zero, CLam (CInd 0) (CRel 0)] : List CoreTerm)));

def let_refine_match_function : CoreTerm :=
    CLetIn refine_result_function (CSort 0)
      (CLetIn
        (CCase refine_result_info (CInd 999) refine_result_zero
          ([CLam (CInd 0) (CRel 0), CLam (CInd 0) (CLam (CInd 0) (CRel 0))] : List CoreTerm))
        (CRel 0) (CApp (CRel 0) refine_result_zero));

def let_refine_dependent_match_type : CoreTerm :=
    CPi (CSort 0) (CPi (CRel 0) (CPi refine_result_nat (CRel 2)));

def let_refine_dependent_match : CoreTerm :=
    CLam (CSort 0) (CLam (CRel 0) (CLam refine_result_nat
      (CLetIn (CRel 2) (CSort 0)
        (CLetIn (CRel 2) (CRel 0)
          (CCase refine_result_info (CInd 999) (CRel 2)
            ([CRel 0, CLam (CInd 0) (CRel 1)] : List CoreTerm))))));

-- The opaque call 77 occurs once in the value. Both uses of the shared value
-- must remain Rel 0 in the emitted body, even though inference expands it.
def let_refine_shared_call : CoreTerm :=
    CLetIn (CApp (CConst 77) refine_result_zero) refine_result_nat
      (CApp (CApp (CConst 78) (CRel 0)) (CRel 0));

def let_refine_alias_laws : List LetRefineLaw :=
    [ let_refine_accept "typed lambda uses a local function type alias"
        let_refine_type_function (let_refine_function_alias (CSort 0))
    , let_refine_accept "unannotated lambda uses a local function type alias"
        let_refine_type_function (let_refine_function_alias (CInd 0))
    , let_refine_accept "local type alias remains available to an explicit annotation"
        let_refine_type_function compiler_test_type_alias
    , let_refine_accept "local aliases expand transitively across nested lets"
        let_refine_type_function let_refine_alias_chain
    , let_refine_accept "dependent alias survives an outer assumption binder"
        let_refine_dependent_type let_refine_alias_under_binder
    , let_refine_accept "function argument inference sees local definitions"
        let_refine_type_function let_refine_function_argument
    , let_refine_accept "dependent application infers both local lambda domains"
        refine_result_nat let_refine_dependent_call
    , let_refine_accept "match scrutinee inference sees a local value and type alias"
        refine_result_nat let_refine_match_value
    , let_refine_accept "match branches receive an expanded local function type"
        refine_result_nat let_refine_match_function
    , let_refine_accept "dependent match preserves assumptions across local definitions"
        let_refine_dependent_match_type let_refine_dependent_match
    ];

def let_refine_emission_laws : List LetRefineLaw :=
    [ let_refine_emitted "typed alias keeps both let nodes and the shared reference"
        let_refine_type_function (let_refine_function_alias (CSort 0))
        (let_refine_function_alias (CSort 0))
    , let_refine_emitted "synthetic annotation is filled while let values stay shared"
        let_refine_type_function (let_refine_function_alias (CInd 0))
        (let_refine_function_alias (CSort 0))
    , let_refine_emitted "explicit local annotation keeps its de Bruijn reference"
        let_refine_type_function compiler_test_type_alias compiler_test_type_alias
    , let_refine_emitted "opaque computation stays in one let value with two Rel uses"
        refine_result_nat let_refine_shared_call let_refine_shared_call
    , let_refine_emitted "match retains the original let-bound scrutinee reference"
        refine_result_nat let_refine_match_value
        (CLetIn refine_result_nat (CSort 0)
          (CLetIn refine_result_zero (CRel 0)
            (CCase refine_result_info (CLam refine_result_nat refine_result_nat) (CRel 0)
              ([refine_result_zero, CLam refine_result_nat (CRel 0)] : List CoreTerm))))
    ];

def let_refine_bad_laws : List LetRefineLaw :=
    [ let_refine_reject "invalid local definition value remains a typing failure" 2
        (CSort 1) (CLetIn (CSort 1) (CSort 1) (CRel 0))
    , let_refine_reject "non-type local annotation remains a typing failure" 2
        refine_result_nat (CLetIn refine_result_zero refine_result_zero (CRel 0))
    , let_refine_reject "unknown local annotation remains malformed Core" 3
        (CSort 1) (CLetIn (CSort 0) (CConst 999) (CRel 0))
    , let_refine_reject "unknown local definition value remains malformed Core" 3
        (CSort 0) (CLetIn (CConst 999) (CSort 0) (CRel 0))
    , let_refine_reject "open local value cannot be hidden by an alias" 3
        (CSort 0) (CLetIn (CRel 99) (CSort 0) (CRel 0))
    , let_refine_reject "open local body cannot become an assumption" 3
        (CSort 0) (CLetIn (CSort 0) (CSort 1) (CRel 1))
    , let_refine_reject "wrong explicit lambda annotation stays rejected" 2
        let_refine_type_function (let_refine_function_alias (CSort 1))
    ];

def let_refine_empty_scope : RefineScope := refine_scope_from_context (Nil CoreTerm);

def let_refine_closed_scope : RefineScope :=
    refine_scope_define let_refine_empty_scope (CSort 1) (CSort 0);

def let_refine_open_scope : RefineScope :=
    refine_scope_assume
      (refine_scope_define (refine_scope_assume let_refine_empty_scope (CSort 0))
        (CSort 0) (CRel 0)) (CRel 0);

def let_refine_scope_laws : List LetRefineLaw :=
    [ let_refine_equal "assumption-only context preserves open references"
        (CRel 0) (refine_scope_expand (refine_scope_assume let_refine_empty_scope (CSort 0)) (CRel 0))
    , let_refine_equal "missing definition entry leaves an unbound index unchanged"
        (CRel 99) (refine_scope_expand let_refine_closed_scope (CRel 99))
    , let_refine_equal "local value lookup lifts past a newer assumption"
        (CRel 2) (refine_scope_expand let_refine_open_scope (CRel 1))
    , let_refine_equal "the newest assumption is not mistaken for a definition"
        (CRel 0) (refine_scope_expand let_refine_open_scope (CRel 0))
    , let_refine_equal "local expansion accounts for binders inside the probe"
        (CLam (CRel 2) (CRel 3))
        (refine_scope_expand let_refine_open_scope (CLam (CRel 1) (CRel 2)))
    , let_refine_equal "stored aliases are expanded before another definition is introduced"
        (CSort 0)
        (refine_scope_expand
          (refine_scope_define let_refine_closed_scope (CSort 1) (CRel 0)) (CRel 0))
    , let_refine_equal "expansion retains inner let binders"
        (CLetIn (CSort 0) (CSort 1) (CRel 0))
        (refine_scope_expand let_refine_closed_scope (CLetIn (CRel 0) (CSort 1) (CRel 0)))
    , let_refine_equal "fix annotation expands without capturing its recursive binder"
        (CFix 50 0 1 (CPi (CSort 0) (CSort 0)) (CLam (CSort 0) (CRel 1)))
        (refine_scope_expand let_refine_closed_scope
          (CFix 50 0 1 (CPi (CRel 0) (CRel 1)) (CLam (CRel 1) (CRel 1))))
    , let_refine_equal "case branches contribute only their explicit lambda binders"
        (CCase refine_result_info (CSort 0) (CSort 0)
          ([CLam (CSort 0) (CSort 0), CRel 99] : List CoreTerm))
        (refine_scope_expand let_refine_closed_scope
          (CCase refine_result_info (CRel 0) (CRel 0)
            ([CLam (CRel 0) (CRel 1), CRel 99] : List CoreTerm)))
    , MkLetRefineLaw "expanded inference preserves the resource failure family"
        (refine_result_has_kind CoreTerm 1
          (refine_scope_infer 0 let_refine_signature let_refine_closed_scope (CRel 0)))
        "expected resource failure"
    ];

def let_refine_run : List LetRefineLaw -> Bool -> IO Unit :=
    fix let_refine_run (laws : List LetRefineLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil =>
          match failed with
          | True => do println "COMPILER_REFINE_LET: FAIL"; exit 1
          | False => do println "COMPILER_REFINE_LET: PASS"; exit 0
          end
      | Cons law rest =>
          match law with
          | MkLetRefineLaw name passed actual =>
              do println (prim_string_concat
                   (match passed with | True => "PASS " | False => "FAIL " end)
                   (prim_string_concat name
                     (match passed with | True => "" | False => prim_string_concat ": " actual end)));
                 let_refine_run rest (orb failed (notb passed))
          end
      end;

def main : IO Unit :=
    let_refine_run (append LetRefineLaw let_refine_alias_laws
      (append LetRefineLaw let_refine_emission_laws
        (append LetRefineLaw let_refine_bad_laws let_refine_scope_laws))) False;
