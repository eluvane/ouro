-- Native regression laws for the shared quality input boundary.
-- @entry main

import "../tools/quality/source.ouro",
  "../tools/quality/input_error.ouro",
  "../tools/quality/text.ouro",
  "../tools/strict/scan.ouro";

def qit_keep (_path : String) : Bool := True;

def qit_files (expected : List String)
    (actual : Either QualityInputError (List String)) : Bool :=
    match actual with
    | Left _ => False
    | Right paths => list_eq String prim_string_eq expected paths
    end;

def qit_error (expected : QualityInputError)
    (actual : Either QualityInputError (List String)) : Bool :=
    match actual with
    | Left e => prim_string_eq(quality_input_message e, quality_input_message expected)
    | Right _ => False
    end;

def qit_read_error (expected : QualityInputError)
    (actual : Either QualityInputError String) : Bool :=
    match actual with
    | Left e => prim_string_eq(quality_input_message e, quality_input_message expected)
    | Right _ => False
    end;

def qit_text (expected : String) (actual : Either QualityInputError String) : Bool :=
    match actual with
    | Left _ => False
    | Right text => prim_string_eq expected text
    end;

def qit_row (label : String) (passed : Bool) : Pair String Bool :=
    MkPair String Bool label passed;

-- Exhaust every list of length at most six over three keys against the
-- independent retained insertion sort. Include duplicates and empty inputs.
def qit_order_parity : Nat -> List Nat -> Bool :=
  fix cases (fuel : Nat) (values : List Nat) : Bool :=
    let equal : Bool := list_eq Nat eq_nat
      (sort_insert Nat leb_nat values) (quality_sort Nat leb_nat values) in
    match fuel with
    | Z => equal
    | S rest => andb equal
        (andb (cases(rest, Cons Nat 0 values))
          (andb(cases(rest, Cons Nat 1 values), cases(rest, Cons Nat 2 values))))
    end;

def qit_order_stable : Bool :=
    let values : List (Pair Nat Nat) :=
      [MkPair Nat Nat 2 0, MkPair Nat Nat 1 1, MkPair Nat Nat 2 2,
       MkPair Nat Nat 1 3, MkPair Nat Nat 2 4] in
    list_eq Nat eq_nat [1, 3, 0, 2, 4]
      (map (Pair Nat Nat) Nat (snd Nat Nat)
        (quality_sort (Pair Nat Nat)
          (fun (a : Pair Nat Nat) (b : Pair Nat Nat) => leb_nat(fst Nat Nat a, fst Nat Nat b)) values));

def qit_raw_authority_mask : Bool :=
    let source : String :=
      "def text : String := r#\"first\n-- @export fake\ndef fake : Nat := 0; -- Ouro code\n-- @api fake\n\"#;\ndef after : Nat := 0;" in
    let masked : String := qt_mask_literals source in
    let lines : List String := qt_split_lines masked in
    andb(eq_nat(prim_string_length source, prim_string_length masked),
      andb(list_eq Nat eq_nat (st_top_starts lines) ([0, 5] : List Nat),
        notb(st_public_near lines 5)));

def qit_ordinary_authority_mask : Bool :=
    let lines : List String := qt_source_code_lines
      "def text : String := \"first\n-- @export fake\n-- @api fake\n\";\ndef after : Nat := 0;" in
    andb(list_eq Nat eq_nat (st_top_starts lines) ([0, 4] : List Nat),
      notb(st_public_near lines 4));

def qit_real_code_after_raw : Bool :=
    let lines : List String := qt_source_code_lines
      "def text : String := r#\"-- @export fake\ndef fake : Nat := 0;\"#;;\n-- @export real\ndef real : Nat := 0;;" in
    andb(list_eq Nat eq_nat (st_top_starts lines) ([0, 3] : List Nat),
      andb(st_public_near lines 3,
        andb
          (match qt_find_unquoted (nth String "" 1 lines) ";;" with
           | Nothing => False | Just _ => True end)
          (match qt_find_unquoted (nth String "" 3 lines) ";;" with
           | Nothing => False | Just _ => True end)));

def qit_crlf_mask_offsets : Bool :=
    let source : String :=
      "def text : String := r#\"first\r\n-- @api fake\r\n\"#;\r\n-- @api real\r\ndef real : Nat := 0;" in
    let masked : String := qt_mask_literals source in
    andb(eq_nat(prim_string_length source, prim_string_length masked),
      match prim_string_index source "-- @api real" with
      | Nothing => False
      | Just before =>
          match prim_string_index masked "-- @api real" with
          | Nothing => False
          | Just after => eq_nat before after
          end
      end);

def qit_check (row : Pair String Bool) : IO Nat :=
    match row with
    | MkPair label passed =>
        match passed with
        | True => io_pure Nat Z
        | False =>
            do eprintln (concat "QUALITY_INPUT_TESTS: FAIL " label);
               io_pure(Nat, S Z)
        end
    end;

def qit_finish (rows : List (Pair String Bool)) : IO Unit :=
    do let! failures := io_fold (Pair String Bool) Nat
         (fun (count : Nat) (row : Pair String Bool) =>
           io_bind Nat Nat (qit_check row)
             (fun (failed : Nat) => io_pure(Nat, add count failed))) Z rows;
       println (concat "QUALITY_INPUT_TESTS rows="
         (concat (prim_string_of_nat (length(Pair String Bool, rows)))
           (concat(" failures=", prim_string_of_nat failures))));
       match failures with
       | Z => exit Z
       | S _ => exit (S Z)
       end

def qit_run (requested_root : String) : IO Unit :=
    let root : String := quality_normalize_path requested_root in
    let a : String := quality_child root "a.ouro" in
    let b : String := quality_child root "b.ouro" in
    let non_source : String := quality_child root "note.txt" in
    let missing : String := quality_child root "missing.ouro" in
    let ignored_dir : String := quality_child root "_build" in
    let explicit : String := quality_child ignored_dir "explicit.ouro" in
    let empty_dir : String := quality_child root "empty" in
    do prim_fs_mkdir root;
       prim_fs_mkdir ignored_dir;
       prim_fs_mkdir empty_dir;
       prim_fs_write_file a "";
       prim_fs_write_file b "-- a source with no declarations\n";
       prim_fs_write_file non_source "not selected\n";
       prim_fs_write_file explicit "-- explicitly selected generated-path input\n";
       let! completed := quality_walk_go quality_skip_dir qit_keep Z
         (Nil String) (Nil String);
       let! exhausted := quality_walk_go quality_skip_dir qit_keep Z
         (singleton String a) (singleton String b);
       let! exact := quality_walk_go quality_skip_dir qit_keep (S Z)
         (singleton String a) (Nil String);
       let! one_short := quality_walk_go quality_skip_dir qit_keep (S Z)
         ([a, b] : List String) (Nil String);
       let! selected := quality_inventory quality_skip_dir qit_keep
         (singleton String root);
       let! repeated := quality_inventory quality_skip_dir qit_keep
         ([b, a, b, a] : List String);
       let! aliases := quality_inventory quality_skip_dir qit_keep
         ([a, quality_child root "./a.ouro", quality_child root "empty/../a.ouro"] : List String);
       let! canonical_failure := quality_unique_files ([a, missing] : List String);
       let! stable_aliases := quality_unique_files
         ([b, quality_child root "./a.ouro", a, b] : List String);
       let! explicit_input := quality_inventory quality_skip_dir qit_keep
         (singleton String explicit);
       let! no_roots := quality_inventory quality_skip_dir qit_keep (Nil String);
       let! empty_scope := quality_inventory quality_skip_dir qit_keep
         (singleton String empty_dir);
       let! filtered := quality_inventory quality_skip_dir
         (fun (_path : String) => False) (singleton String a);
       let! bad_root := quality_inventory quality_skip_dir qit_keep
         (singleton String missing);
       let! mixed_roots := quality_inventory quality_skip_dir qit_keep
         ([a, missing] : List String);
       let! ignored_suffix := quality_inventory quality_skip_dir qit_keep
         (singleton String non_source);
       let! empty_source := quality_read_file a;
       let! text_source := quality_read_file b;
       let! missing_source := quality_read_file missing;
       let! directory_source := quality_read_file root;
       qit_finish
         [ qit_row "zero budget with no pending work is complete"
             (qit_files(Nil String, completed))
         , qit_row "zero budget cannot publish an accumulated partial inventory"
             (qit_error(QualityWalkExhausted a, exhausted))
         , qit_row "exactly enough budget is accepted"
             (qit_files(singleton String a, exact))
         , qit_row "one pending file makes exhaustion an error"
             (qit_error(QualityWalkExhausted b, one_short))
         , qit_row "directory selection is sorted and excludes build directories"
             (qit_files([a, b] : List String, selected))
         , qit_row "repeated scopes are analyzed once"
             (qit_files([a, b] : List String, repeated))
         , qit_row "lexical aliases retain one deterministic source spelling"
             (qit_files(singleton(String, quality_child root "./a.ouro"), aliases))
         , qit_row "canonicalization failure cannot publish partial input"
             (qit_error(QualityInvalidInput missing, canonical_failure))
         , qit_row "explicit files survive directory-name exclusions"
             (qit_files(singleton String explicit, explicit_input))
         , qit_row "empty requested scope is not a clean report"
             (qit_error QualityNoSources no_roots)
         , qit_row "empty directory is not a clean report"
             (qit_error QualityNoSources empty_scope)
         , qit_row "entirely filtered scope is explicit failure"
             (qit_error QualityNoSources filtered)
         , qit_row "missing scope is not silently skipped"
             (qit_error(QualityInvalidInput missing, bad_root))
         , qit_row "valid files do not hide a later missing scope"
             (qit_error(QualityInvalidInput missing, mixed_roots))
         , qit_row "non-source input is not an empty successful analysis"
             (qit_error QualityNoSources ignored_suffix)
         , qit_row "valid empty source is different from failed IO"
             (qit_text "" empty_source)
         , qit_row "source content is preserved"
             (qit_text "-- a source with no declarations\n" text_source)
         , qit_row "missing imported file is rejected"
             (qit_read_error(QualityExpectedFile missing, missing_source))
         , qit_row "directory cannot masquerade as an imported file"
             (qit_read_error(QualityExpectedFile root, directory_source))
         , qit_row "stable ordering matches all 1093 small input lists"
             (qit_order_parity 6 [])
         , qit_row "equal sort keys retain their original order"
             qit_order_stable
         , qit_row "canonical groups retain first spelling and original order"
             (qit_files([b, quality_child root "./a.ouro"] : List String, stable_aliases))
         , qit_row "raw multiline markers and code are not policy or declarations"
             qit_raw_authority_mask
         , qit_row "ordinary multiline markers are not public annotations"
             qit_ordinary_authority_mask
         , qit_row "real annotation and violation after raw close stay visible"
             qit_real_code_after_raw
         , qit_row "CRLF and comment offsets survive literal masking"
             qit_crlf_mask_offsets
         ]

def main : IO Unit :=
    do let! args := prim_argv;
       qit_run (nth String "_build/tmp/quality_input_tests" (S Z) args)
