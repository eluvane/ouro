-- Development exports for checked source programs and typed stdin lifecycles.
import "native_managed_source_driver.ouro";
import "native_stdin_fixtures.ouro";

def native_stdin_fixture_runtime (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError NativeManagedRuntime :=
    managed_fixture_runtime_with_limits managed_source_driver_limits root files;
