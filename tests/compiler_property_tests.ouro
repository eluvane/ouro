-- Generated semantic laws use the canonical checker directly. The untyped
-- domain tests structural lift/substitution; typed terms test acceptance.
import "compiler_property_process.ouro";

def property_report_failure (kind : String) (seed : Nat) (index : Nat) (reason : String) : IO Unit :=
    do eprintln (str_cat4 "FAIL property " kind " seed=" (str_of_nat seed));
       eprintln (str_cat4 "sample=" (str_of_nat index) " " reason);
       exit 1

def property_report_term_failure (kind : String) (seed : Nat) (index : Nat)
    (term : CoreTerm) (reason : String) : IO Unit :=
    property_report_failure kind seed index
      (str_cat3 reason "\nterm=" (property_show term));

def property_mutation_detail (term : CoreTerm) (target : Nat) (reason : String) : String :=
    match property_mutate term 0 target with
    | PropertyMutationOf mutant _ => str_cat4 reason " target=" (str_of_nat target)
        (str_concat "\nmutant=" (property_show mutant))
    end;

def property_run_scoped (seed : Nat) (start : Nat) : Nat -> Nat -> IO Unit :=
  fix run (remaining : Nat) (index : Nat) : IO Unit :=
    match remaining with
    | Z => println (str_cat4 "ok scoped properties count=" (str_of_nat (sub index start))
        " start=" (str_of_nat start))
    | S next =>
        let sample : Nat := property_seed seed (S index) in
        let term : CoreTerm := property_scoped (property_choice (property_seed sample 47) 6) 0 sample in
        match property_scoped_laws sample term with
        | Nothing => run next (S index)
        | Just reason => property_report_term_failure "scoped" seed index term reason
        end
    end;

def property_run_shape_mutations (entries : List Entry) (seed : Nat) (index : Nat)
    (name : String) (expected : CoreTerm) (term : CoreTerm) : Nat -> Nat -> IO Unit :=
  fix run (remaining : Nat) (target : Nat) : IO Unit :=
    match remaining with
    | Z => io_unit
    | S next => match property_mutant_law entries expected term target with
        | Nothing => run next (S target)
        | Just reason => property_report_term_failure name seed index term
            (property_mutation_detail term target reason)
        end
    end;

def property_run_shapes (entries : List Entry) (seed : Nat) (complete : Nat -> IO Unit)
    : List PropertyShape -> Nat -> Nat -> IO Unit :=
  fix run (shapes : List PropertyShape) (index : Nat) (mutations : Nat) : IO Unit :=
    match shapes with
    | Nil => do println (str_cat4 "ok scope shapes count=" (str_of_nat index)
                  " every-rel mutations=" (str_of_nat mutations));
                complete mutations
    | Cons shape rest => match shape with
        | PropertyShapeOf name expected term => match property_shape_laws entries expected term with
            | Just reason => property_report_term_failure name seed index term reason
            | Nothing => let count : Nat := property_rel_count term in
                do property_run_shape_mutations entries seed index name expected term count 0;
                   run rest (S index) (add mutations count)
            end
        end
    end;

def property_run_typed (seed : Nat) (start : Nat) (entries : List Entry)
    (complete : PropertyCounts -> IO Unit) : Nat -> Nat -> Nat -> Nat -> List Nat -> IO Unit :=
  fix run (remaining : Nat) (index : Nat) (mutations : Nat) (nonfirst : Nat)
      (buckets : List Nat) : IO Unit :=
    match remaining with
    | Z => do println (str_cat4 "ok typed properties count=" (str_of_nat (sub index start))
                  " start=" (str_of_nat start));
              println (str_cat4 "ok out-of-scope mutations count=" (str_of_nat mutations)
                  " nonfirst=" (str_of_nat nonfirst));
              println (str_concat "ok typed generation buckets=" (property_nats buckets));
              complete (PropertyCountsOf mutations nonfirst buckets)
    | S next =>
        let sample : Nat := property_seed seed (add 101 index) in
        let goal : PropertyGoal := property_goal (property_seed sample 41) in
        let fuel : Nat := property_choice (property_seed sample 49) 6 in
        let term : CoreTerm := property_typed fuel ([] : List CoreTerm) goal sample in
        let next_buckets : List Nat := property_count_bucket (property_typed_bucket goal fuel sample) buckets in
        match property_environment (mod_nat index 2) with
        | DeclarationsErr _ _ _ => property_report_failure "typed" seed index "fresh environment rejected"
        | DeclarationsOk cold => match property_typed_laws entries cold goal term with
            | Just reason => property_report_term_failure "typed" seed index term reason
            | Nothing => match property_rel_count term with
                | Z => run next (S index) mutations nonfirst next_buckets
                | S rest =>
                    let target : Nat := property_choice (property_seed sample 71) (S rest) in
                    match property_mutant_law entries (property_goal_type goal) term target with
                    | Nothing => run next (S index) (S mutations)
                        (match target with | Z => nonfirst | S _ => S nonfirst end) next_buckets
                    | Just reason => property_report_term_failure "mutation" seed index term
                        (property_mutation_detail term target reason)
                    end
                end
            end
        end
    end;

def property_usage : String :=
    "usage: compiler-properties [--seed N] [--scoped N] [--typed N] [--start N] [--json PATH]";

def property_options_known (options : Args) : Bool :=
    andb (nullb String (args_positional options))
      (andb (nullb String (args_flags options))
        (all (Pair String String)
          (fun (option : Pair String String) => match option with | MkPair name _ =>
            orb (str_eq name "seed") (orb (str_eq name "scoped") (orb (str_eq name "typed")
              (orb (str_eq name "start") (str_eq name "json")))) end)
          (args_opts options)));

def property_cli_failure (error : CliError) : IO Unit :=
    do eprintln (cli_error_message error); eprintln property_usage; exit 2

def property_json (seed : Nat) (start : Nat) (scoped : Nat) (typed : Nat)
    (fixed_mutations : Nat) (counts : PropertyCounts) : String :=
    match counts with
    | PropertyCountsOf mutations nonfirst buckets =>
        str_concat "{\"kind\":\"ouro.compiler-property.v1\",\"pass\":true,"
          (str_concat (str_join "," ([str_concat "\"seed\":" (str_of_nat seed),
            str_concat "\"start\":" (str_of_nat start), str_concat "\"scoped\":" (str_of_nat scoped),
            str_concat "\"typed\":" (str_of_nat typed),
            str_concat "\"scope_shapes\":" (str_of_nat (length PropertyShape property_scope_shapes)),
            str_concat "\"shape_mutations\":" (str_of_nat fixed_mutations),
            str_concat "\"typed_mutations\":" (str_of_nat mutations),
            str_concat "\"nonfirst_mutations\":" (str_of_nat nonfirst),
            str_cat3 "\"typed_buckets\":[" (property_nats buckets) "]"] : List String)) "}\n")
    end;

def property_write_json (path : Maybe String) (content : String) : IO Unit :=
    match path with
    | Nothing => io_unit
    | Just target => do let! result := fs_write_checked target content;
        match result with
        | Right _ => io_unit
        | Left error => do eprintln (fs_error_message error); exit 1
        end
    end;

def property_run (seed : Nat) (start : Nat) (scoped : Nat) (typed : Nat)
    (json_path : Maybe String) : IO Unit :=
    match property_environment 0 with
    | DeclarationsErr _ _ _ => property_report_failure "environment" seed 0 "declaration checking failed"
    | DeclarationsOk entries => property_run_shapes entries seed
        (fun (fixed_mutations : Nat) =>
          do property_run_scoped seed start scoped start;
             property_run_typed seed start entries
               (fun (counts : PropertyCounts) =>
                 do property_write_json json_path (property_json seed start scoped typed fixed_mutations counts);
                    println (str_cat4 "ok compiler properties seed=" (str_of_nat seed)
                      " samples=" (str_of_nat (add scoped typed))))
               typed start 0 0 (replicate Nat 0 25)) property_scope_shapes 0 0
    end;

def property_dispatch (executable : String) (seed : Nat) (start : Nat) (scoped : Nat) (typed : Nat)
    (json_path : Maybe String) : IO Unit :=
    match andb (ltb_nat 0 scoped) (ltb_nat 0 typed) with
    | False => property_run seed start scoped typed json_path
    | True => do let! result := property_isolated executable seed start scoped typed;
        match result with
        | Left error => do eprintln (property_worker_error error); exit 1
        | Right counts =>
            do property_write_json json_path (property_json seed start scoped typed property_fixed_mutations counts);
               print (property_summary seed start scoped typed counts)
        end
    end

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       let options : Args := cli_from_argv ([] : List String) arguments in
       match andb (args_argv_options_complete ([] : List String) arguments) (property_options_known options) with
       | False => property_cli_failure (CliUsage property_usage)
       | True => match cli_optional_nat options "seed" (add (mul 20 100) 26) with
           | Left error => property_cli_failure error
           | Right seed => match cli_optional_nat options "scoped" 400 with
               | Left error => property_cli_failure error
               | Right scoped => match cli_optional_nat options "typed" 400 with
                   | Left error => property_cli_failure error
                   | Right typed => match cli_optional_nat options "start" 0 with
                       | Left error => property_cli_failure error
                       | Right start => property_dispatch (nth String "" 0 arguments)
                           seed start scoped typed (cli_opt options "json")
                       end
                   end
               end
           end
       end
