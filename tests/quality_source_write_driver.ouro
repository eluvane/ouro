-- Filesystem boundary driver. Independent tests own the files and observe
-- bytes and metadata after these actual Ouro operations.
import "../tools/quality/source_write.ouro";

def quality_write_driver_result (result : Either FsError Unit) : IO Unit :=
    match result with
    | Right _ => do println "0"; exit 0
    | Left error => do eprintln (fs_error_message error); println "1"; exit 1
    end

def quality_write_driver_run (mode : String) (source : String) (stage : String) (backup : String) : IO Unit :=
    match prim_string_eq mode "--replace-files" with
    | True =>
        do let! result := fs_replace_file source stage backup;
           match result with
           | FsReplaced => do println "0"; exit 0
           | FsReplaceFailed status => do println (prim_string_of_nat status); exit 1
           end
    | False =>
        match prim_string_eq mode "--publish" with
        | True =>
            do let! result := quality_write_source_checked source "original\n" "candidate\n";
               quality_write_driver_result result
        | False =>
            match prim_string_eq mode "--recover-partial" with
            | True =>
                do let! result := quality_source_recover source stage backup "original\n" "candidate\n"
                     (add(mul 11 100, 77)) "injected partial publication state";
                   quality_write_driver_result result
            | False => do eprintln "invalid source write driver mode"; exit 2
            end
        end
    end

def main : IO Unit :=
    do let! values := argv;
       match values with
       | Nil => exit 2
       | Cons _ arguments => match arguments with
         | Nil => exit 2
         | Cons mode rest => match rest with
           | Nil => exit 2
           | Cons source more => match more with
             | Nil => exit 2
             | Cons stage tail => match tail with
               | Nil => exit 2
               | Cons backup extra => match extra with
                 | Nil => quality_write_driver_run mode source stage backup
                 | Cons _ _ => exit 2 end end end end end
       end
