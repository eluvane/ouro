import "../tools/pkg/model.ouro",
  "../std/test.ouro";

def quality_semver_range_rejected (range : String) : Bool :=
    if let SvBad := (sv_range_parse range : SvRange) then True else False;

def quality_semver_operators : List String :=
    [">=", "<=", "^", "~", ">", "<", "="];

def quality_semver_supported_ranges : List String :=
    ["*", "1.2.3", "=1.2.3", ">=1.2.3", "<=1.2.3",
      ">1.2.3", "<1.2.3", "^1.2.3", "~1.2.3"];

-- @entry main
def main : IO Unit := test_run
    (append Test
      (map String Test
        (fun (operator : String) =>
          assert_true (str_concat "range requires a version after " operator)
            (andb (quality_semver_range_rejected operator)
              (quality_semver_range_rejected (str_cat3 " \t" operator " \r\n"))))
        quality_semver_operators)
      [ assert_true "package ranges reject every missing operator operand"
          (all String (fun (operator : String) =>
            andb (notb (pkg_range_ok operator))
              (notb (pkg_range_ok (str_cat3 " \t" operator " \r\n"))))
            quality_semver_operators)
      , assert_true "supported package ranges remain accepted"
          (all String pkg_range_ok quality_semver_supported_ranges)
      , assert_true "missing operand cannot match a version"
          (notb (sv_matches ">= \t" "1.2.3"))
      , assert_eq "missing operand cannot select the best version"
          (fromMaybe String "none" (sv_best_str ">=" ["0.0.0", "1.2.3"])) "none"
      , assert_true "wildcard still matches versions" (sv_matches "*" "2.3.4")
      , assert_true "empty library range retains wildcard behavior" (sv_matches " \t" "2.3.4")
      , assert_true "empty package range remains rejected" (notb (pkg_range_ok " \t"))
      , assert_eq "major-only version retains zero-filled fields"
          (maybe Semver String "invalid" sv_show (sv_parse "1")) "1.0.0"
      , assert_eq "empty version field retains zero filling"
          (maybe Semver String "invalid" sv_show (sv_parse "1..3")) "1.0.3"
      , assert_eq "empty version retains the documented field policy"
          (maybe Semver String "invalid" sv_show (sv_parse "")) "0.0.0"
      , assert_true "zero is a valid explicit range operand" (sv_matches ">=0" "0.0.0")
      , assert_true "operand whitespace retains trimming" (sv_matches " \t>= 1.2.3\r\n" "1.2.3")
      , assert_true "greater-or-equal includes its lower bound" (sv_matches ">=1.2.3" "1.2.3")
      , assert_true "greater-or-equal excludes a lower version" (notb (sv_matches ">=1.2.3" "1.2.2"))
      , assert_true "less-or-equal includes its upper bound" (sv_matches "<=1.2.3" "1.2.3")
      , assert_true "less-or-equal excludes a higher version" (notb (sv_matches "<=1.2.3" "1.2.4"))
      , assert_true "strict greater excludes equality" (notb (sv_matches ">1.2.3" "1.2.3"))
      , assert_true "strict less excludes equality" (notb (sv_matches "<1.2.3" "1.2.3"))
      , assert_true "exact range includes its version" (sv_matches "=1.2.3" "1.2.3")
      , assert_true "exact range excludes a different version" (notb (sv_matches "=1.2.3" "1.2.4"))
      , assert_true "caret retains its exclusive upper bound"
          (andb (sv_matches "^1.2.3" "1.9.9") (notb (sv_matches "^1.2.3" "2.0.0")))
      , assert_true "zero-major caret retains its exclusive upper bound"
          (andb (sv_matches "^0.2.3" "0.2.4") (notb (sv_matches "^0.2.3" "0.3.0")))
      , assert_true "tilde retains its exclusive upper bound"
          (andb (sv_matches "~1.2.3" "1.2.4") (notb (sv_matches "~1.2.3" "1.3.0")))
      , assert_true "prerelease operand remains unsupported" (quality_semver_range_rejected ">=1.2.3-alpha")
      , assert_true "build metadata operand remains unsupported" (quality_semver_range_rejected "=1.2.3+build")
      ]);
