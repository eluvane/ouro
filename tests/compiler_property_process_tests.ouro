-- Reports are only transport evidence after actual child success. Keep exact
-- coverage and counter checks independent of the report formatter.
import "compiler_property_process.ouro";
import "../std/test.ouro";

def property_wire_fixture : String :=
    "ok scope shapes count=12 every-rel mutations=28\nok scoped properties count=0 start=0\nok typed properties count=400 start=0\nok out-of-scope mutations count=109 nonfirst=40\nok typed generation buckets=15,10,7,10,13,10,16,8,6,18,11,17,18,13,16,9,25,20,14,23,20,18,25,29,29\nok compiler properties seed=2026 samples=400\n";

def property_wire_accepts (text : String) : Bool :=
    match property_report_valid (add (mul 20 100) 26) 0 0 400 text with
    | Nothing => False | Just _ => True end;

def property_wire_refuses (needle : String) (replacement : String) : Bool :=
    notb (property_wire_accepts (str_replace property_wire_fixture needle replacement));

def property_wire_laws : List Test :=
    [ assert_true "complete observed typed corpus report" (property_wire_accepts property_wire_fixture)
    , assert_true "Windows CRLF transport" (property_wire_accepts (str_replace property_wire_fixture "\n" "\r\n"))
    , assert_true "empty report" (notb (property_wire_accepts ""))
    , assert_true "wrong seed" (property_wire_refuses "seed=2026" "seed=2027")
    , assert_true "wrong start" (property_wire_refuses "start=0" "start=1")
    , assert_true "missing scoped coverage" (property_wire_refuses "count=0 start=0" "count=1 start=0")
    , assert_true "missing typed coverage" (property_wire_refuses "count=400" "count=399")
    , assert_true "fixed shape coverage" (property_wire_refuses "count=12" "count=11")
    , assert_true "fixed mutation coverage" (property_wire_refuses "mutations=28" "mutations=27")
    , assert_true "noncanonical decimal" (property_wire_refuses "count=109" "count=0109")
    , assert_true "nonfirst above total" (property_wire_refuses "nonfirst=40" "nonfirst=110")
    , assert_true "total above typed" (property_wire_refuses "count=109" "count=401")
    , assert_true "short bucket list" (property_wire_refuses "15,10,7" "25,7")
    , assert_true "extra bucket" (property_wire_refuses "15,10,7" "0,15,10,7")
    , assert_true "missing bucket sample" (property_wire_refuses "15,10,7" "14,10,7")
    , assert_true "malformed bucket" (property_wire_refuses "15,10,7" "15,x,7")
    , assert_true "wrong summary" (property_wire_refuses "samples=400" "samples=800")
    , assert_true "trailing output" (notb (property_wire_accepts (str_concat property_wire_fixture "extra\n")))
    , assert_true "truncated output" (notb (property_wire_accepts
        (str_take property_wire_fixture (sub (str_len property_wire_fixture) 1))))
    ];

def main : IO Unit := test_run property_wire_laws;
