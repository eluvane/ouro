-- Effect laws construct typed MIR directly. Runtime lifecycle evidence uses
-- separately compiled Ouro collector/allocator source in native_managed.
import "native_mir_validation_tests.ouro";

def gc_test_call (gc : MirGc) (id : Nat) : MirInstruction :=
    MirCall(gc, Nothing Nat, MirDirect id, [] : List MirValue);

def gc_test_indirect (gc : MirGc) : MirInstruction :=
    MirCall gc (Nothing Nat)
      (MirIndirect(MirSignatureOf([] : List MirType, Nothing MirType), mir_fixture_nat MirRawPtr 0))
      ([] : List MirValue);

def gc_test_body (id : Nat) (instructions : List MirInstruction) : MirFunction :=
    MirFunctionDef id ([103,99] : List Nat) ([] : List MirLocal)
      ([MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirU8, MirLocalDef 2 MirManagedPtr] : List MirLocal)
      (Nothing MirType) 0 ([MirBlockDef 0 instructions (MirReturn (Nothing MirValue))] : List MirBlock);

def gc_test_program (functions : List MirFunction) (foreign : MirGc) : MirProgram :=
    MirProgramDef functions ([MirDataDef 100 False (mir_managed_descriptor_bytes 11)] : List MirData)
      ([mir_fixture_kernel ([MirExternDef foreign 200 ([69,102,102,101,99,116] : List Nat)
        (MirSignatureOf([] : List MirType, Nothing MirType))] : List MirExtern)] : List MirLibrary) 1;

def gc_test_allocator (instructions : List MirInstruction) : MirFunction :=
    MirFunctionDef 10 ([114,97,119,95,97,108,108,111,99] : List Nat)
      ([MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirRawPtr, MirLocalDef 2 MirUSize] : List MirLocal)
      ([MirLocalDef 3 MirManagedPtr, MirLocalDef 4 MirU8] : List MirLocal)
      (Just MirType MirRawPtr) 0
      ([MirBlockDef 0 instructions (MirReturn (Just(MirValue, mir_fixture_nat MirRawPtr 0)))] : List MirBlock);

def gc_test_collector (instructions : List MirInstruction) : MirFunction :=
    MirFunctionDef 11 ([97,110,121,95,108,97,98,101,108] : List Nat)
      ([MirLocalDef 0 MirRawPtr] : List MirLocal)
      ([MirLocalDef 1 MirU8, MirLocalDef 2 MirManagedPtr] : List MirLocal)
      (Just MirType MirU8) 0
      ([MirBlockDef 0 instructions (MirReturn (Just(MirValue, mir_fixture_nat MirU8 1)))] : List MirBlock);

def gc_test_allocate : MirInstruction := MirManagedAlloc 2 10 11 100 (mir_fixture_nat MirUSize 40);

def gc_test_heap (main : List MirInstruction) (allocator : List MirInstruction)
    (collector : List MirInstruction) (extra : List MirFunction) (foreign : MirGc) : MirProgram :=
    gc_test_program (append MirFunction
      ([gc_test_body 1 main, gc_test_allocator allocator, gc_test_collector collector] : List MirFunction) extra) foreign;

def gc_test_collect_call (gc : MirGc) : MirInstruction :=
    MirCall(gc, Just Nat 1, MirDirect 11, [mir_fixture_nat MirRawPtr 0] : List MirValue);

def gc_test_chain (gc : MirGc) (ending : List MirInstruction) (foreign : MirGc) : MirProgram :=
    gc_test_program ([gc_test_body(1, [gc_test_call gc 2] : List MirInstruction),
      gc_test_body(2, [gc_test_call MirMayGc 3] : List MirInstruction), gc_test_body 3 ending] : List MirFunction) foreign;

def gc_test_cycle (ending : List MirInstruction) : MirProgram :=
    gc_test_program ([gc_test_body(1, [gc_test_call MirNoGc 2] : List MirInstruction),
      gc_test_body(2, Cons MirInstruction (gc_test_call MirMayGc 3) ending),
      gc_test_body(3, [gc_test_call MirMayGc 2] : List MirInstruction)] : List MirFunction) MirMayGc;

def gc_test_reverse (program : MirProgram) : MirProgram :=
    match program with | MirProgramDef functions objects libraries entry =>
      MirProgramDef (reverse MirFunction functions) objects libraries entry end;

def gc_test_replace_collector (function : MirFunction) : MirProgram :=
    gc_test_program ([gc_test_body(1, [gc_test_allocate] : List MirInstruction),
      gc_test_allocator ([] : List MirInstruction), function] : List MirFunction) MirNoGc;

def gc_test_inferred (name : String) (program : MirProgram) (expected : List Nat) : Test :=
    match mir_validate mir_default_limits program with
    | Left error => test_fail(name, mir_test_error_text error)
    | Right _ => match mir_gc_infer 64 program with
      | Left error => test_fail(name, mir_test_error_text error)
      | Right bodies => assert_true(name, mir_set_equal bodies expected) end end;

def gc_test_inference_error (name : String) (fuel : Nat) (program : MirProgram) : Test :=
    match mir_gc_infer fuel program with
    | Left error => assert_eq name (mir_test_error_text error) "resource"
    | Right _ => test_fail name "unfinished gc graph accepted" end;

def gc_test_effects (program : MirProgram) : List Bool :=
    concat_map MirInstruction Bool (fun (instruction : MirInstruction) => match instruction with
      | MirCall gc _ _ _ => ([mir_gc_is_no_gc gc] : List Bool)
      | MirMove _ _ => [] | MirBinaryOp _ _ _ _ => [] | MirCompare _ _ _ _ => []
      | MirConvert _ _ _ => [] | MirLoad _ _ _ => [] | MirStore _ _ _ => []
      | MirLoadAt _ _ _ => [] | MirStoreAt _ _ _ => []
      | MirAddress _ _ => [] | MirPointerAdd _ _ _ => []
      | MirManagedAlloc _ _ _ _ _ => [] | MirManagedContext _ => [] end) (mir_program_instructions program);

def gc_test_annotated (name : String) (program : MirProgram) (expected_no_gc : Bool) : Test :=
    match mir_annotate_calls mir_default_limits program with
    | Left error => test_fail(name, mir_test_error_text error)
    | Right annotated => match mir_validate mir_default_limits annotated with
      | Left error => test_fail(name, mir_test_error_text error)
      | Right _ => assert_true name (all Bool (fun (actual : Bool) =>
          match expected_no_gc with | True => actual | False => notb actual end) (gc_test_effects annotated)) end end;

-- The allocator exits with 42 if and only if the hook guard let it execute.
-- These PE fixtures distinguish 1 from 0, 2 and 255 without relying on logs.
def gc_test_hook_image (answer : Nat) : MirProgram :=
    let allocator : MirFunction := MirFunctionDef 10 ([97,108,108,111,99] : List Nat)
      ([MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirRawPtr, MirLocalDef 2 MirUSize] : List MirLocal)
      ([] : List MirLocal) (Just MirType MirRawPtr) 0
      ([MirBlockDef 0 ([mir_fixture_exit_call 42] : List MirInstruction)
        (MirReturn (Just(MirValue, mir_fixture_nat MirRawPtr 0)))] : List MirBlock) in
    let collector : MirFunction := MirFunctionDef 11 ([99,111,108,108,101,99,116] : List Nat)
      ([MirLocalDef 0 MirRawPtr] : List MirLocal) ([] : List MirLocal) (Just MirType MirU8) 0
      ([MirBlockDef 0 ([] : List MirInstruction)
        (MirReturn (Just(MirValue, mir_fixture_nat MirU8 answer)))] : List MirBlock) in
    MirProgramDef ([gc_test_body(1, [gc_test_allocate] : List MirInstruction), allocator, collector] : List MirFunction)
      ([MirDataDef 100 False (mir_managed_descriptor_bytes 11)] : List MirData)
      ([mir_fixture_kernel ([] : List MirExtern)] : List MirLibrary) 1;

def gc_test_emit (name : String) : IO Unit :=
    let value : Maybe Nat := match str_eq name "hook_true" with | True => Just Nat 1 | False =>
      match str_eq name "hook_false" with | True => Just Nat 0 | False =>
      match str_eq name "hook_two" with | True => Just Nat 2 | False =>
      match str_eq name "hook_byte_max" with | True => Just Nat 255 | False => Nothing Nat end end end end in
    match value with | Nothing => do eprintln "unknown GC fixture"; exit 2
    | Just answer => match codegen_program(mir_default_limits, gc_test_hook_image answer) with
      | Left _ => do eprintln "GC fixture rejected"; exit 2
      | Right image => match image with | NativeImageOf pe _ => match pe with | PeImageFile bytes _ =>
        println (str_join(",", map Nat String str_of_nat bytes)) end end end end;
