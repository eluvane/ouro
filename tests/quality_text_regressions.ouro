import "../std/test.ouro",
  "../std/text.ouro";

def quality_text_nat_value (actual : Maybe Nat) (expected : Nat) : Bool :=
    maybe Nat Bool False (fun (value : Nat) => eq_nat value expected) actual;

def quality_text_nat_missing (actual : Maybe Nat) : Bool :=
    match actual with
    | Nothing => True
    | Just _ => False
    end;

def quality_text_parse_value (actual : PRes Nat) (expected : Nat)
    (remaining : List Nat) : Bool :=
    match actual with
    | PNo _ => False
    | PYes value rest =>
        andb(eq_nat value expected, list_eq Nat eq_nat rest remaining)
    end;

def quality_text_parse_missing (actual : PRes Nat)
    (remaining : List Nat) : Bool :=
    match actual with
    | PNo rest => list_eq Nat eq_nat rest remaining
    | PYes _ _ => False
    end;

def quality_text_parse_list (actual : PRes (List Nat))
    (expected : List Nat) (remaining : List Nat) : Bool :=
    match actual with
    | PNo _ => False
    | PYes values rest =>
        andb(list_eq Nat eq_nat values expected,
          list_eq Nat eq_nat rest remaining)
    end;

def quality_text_nat_suffix : List Nat :=
    Cons Nat ch_comma (replicate Nat ch_a 512);

-- @entry main
def main : IO Unit :=
    test_run
      [ assert_true "pnat rejects empty input"
          (quality_text_parse_missing (pnat ([] : List Nat))
            ([] : List Nat))
      , assert_true "pnat keeps a rejected first byte"
          (quality_text_parse_missing (pnat (str_codes "/12"))
            (str_codes "/12"))
      , assert_true "pnat consumes zero"
          (quality_text_parse_value (pnat (str_codes "0")) 0
            ([] : List Nat))
      , assert_true "pnat keeps decimal order"
          (quality_text_parse_value (pnat (str_codes "1023")) 1023
            ([] : List Nat))
      , assert_true "pnat accepts leading zeros"
          (quality_text_parse_value (pnat (str_codes "00042")) 42
            ([] : List Nat))
      , assert_true "pnat stops before a delimiter"
          (quality_text_parse_value (pnat (str_codes "123;007")) 123
            (str_codes ";007"))
      , assert_true "pnat preserves an embedded zero byte"
          (quality_text_parse_value (pnat ([49, 50, 0, 51] : List Nat)) 12
            ([0, 51] : List Nat))
      , assert_true "pnat preserves a long suffix"
          (quality_text_parse_value
            (pnat (Cons Nat 55 quality_text_nat_suffix)) 7
            quality_text_nat_suffix)
      , assert_true "pnat consumes a long zero prefix"
          (quality_text_parse_value
            (pnat (append Nat (replicate Nat ch_zero 128)
              ([57] : List Nat))) 9 ([] : List Nat))
      , assert_true "parse_nat accepts decimal input"
          (quality_text_nat_value (parse_nat "908") 908)
      , assert_true "parse_nat rejects empty input"
          (quality_text_nat_missing (parse_nat ""))
      , assert_true "parse_nat rejects leading whitespace"
          (quality_text_nat_missing (parse_nat " 12"))
      , assert_true "parse_nat rejects trailing whitespace"
          (quality_text_nat_missing (parse_nat "12 "))
      , assert_true "parse_nat rejects a sign"
          (quality_text_nat_missing (parse_nat "+12"))
      , assert_true "parse_nat rejects a nondigit suffix"
          (quality_text_nat_missing (parse_nat "12a"))
      , assert_true "parse_nat rejects a hex prefix"
          (quality_text_nat_missing (parse_nat "0x12"))
      , assert_true "str_parse_nat trims outer whitespace"
          (quality_text_nat_value (str_parse_nat " \t0012\r\n") 12)
      , assert_true "str_parse_nat rejects blank input"
          (quality_text_nat_missing (str_parse_nat " \t\r\n"))
      , assert_true "str_parse_nat rejects inner whitespace"
          (quality_text_nat_missing (str_parse_nat "1 2"))
      , assert_true "ptoken retains numeric boundaries"
          (quality_text_parse_value
            (ptoken Nat pnat (str_codes " \t12\r\n!")) 12
            (str_codes "!"))
      , assert_true "psep_by preserves numeric order and suffix"
          (quality_text_parse_list
            (psep_by Nat pnat (pchar ch_comma) (str_codes "1,20,3!"))
            ([1, 20, 3] : List Nat) (str_codes "!"))
      , assert_true "psep_by retains an incomplete separator"
          (quality_text_parse_list
            (psep_by Nat pnat (pchar ch_comma) (str_codes "1,2,"))
            ([1, 2] : List Nat) (str_codes ","))
      ];
