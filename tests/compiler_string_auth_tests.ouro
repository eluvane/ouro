-- Literal bytes require a checked String type after transparent reduction.
import "compiler_string_nf_fixtures.ouro";
import "../std/test.ouro";

def string_auth_literal (name : Nat) : CoreTerm := CStrBytes ([65, 0, 255] : List Nat) name;

def string_auth_failure (name : Nat) (failure : CheckFailure) : Bool :=
    match failure with
    | CheckMalformedCore fault => match fault with
        | CheckLiteralType actual => eqNat name actual
        | CheckUnboundVariable _ => False | CheckUnboundGlobal _ => False
        | CheckUnknownInductive _ => False | CheckUnknownConstructor _ _ => False
        | CheckConstructorParameters => False | CheckCaseMetadata => False
        | CheckFixMetadata => False | CheckUnresolvedLiteral _ => False | CheckDuplicateName _ => False
        end
    | CheckTypeFailure _ => False | CheckReductionFailure _ => False
    | CheckResourceLimit => False | CheckUnsupported _ => False | CheckCancelled => False
    | CheckInternalFailure _ => False | CheckPrimitiveFailure _ => False
    end;

def string_auth_infers (entries : List Entry) (name : Nat) : Bool :=
    match infer_checked 200 entries ([] : List CoreTerm) (IGTerm (string_auth_literal name)) with
    | CheckErr _ => False
    | CheckOk typ => string_nf_test_core_equal typ (CConst name)
    end;

def string_auth_rejects (entries : List Entry) (name : Nat) : Bool :=
    andb
      (match infer_checked 200 entries ([] : List CoreTerm) (IGTerm (string_auth_literal name)) with
       | CheckOk _ => False | CheckErr failure => string_auth_failure name failure end)
      (string_nf_test_fault CoreTerm 14 (normalize_checked 200 entries (string_auth_literal name)));

def string_auth_aliases : List Entry :=
    [ MkEntry 611 (CSort 0) (Just CoreTerm (CConst 610))
    , MkEntry 610 (CSort 0) (Just CoreTerm (CConst 18))
    ];

def string_auth_scope : List Entry := append Entry string_auth_aliases string_nf_test_environment;

def string_auth_empty : IndDecl := MkIndDecl 650 ([] : List Param) ([] : List CoreTerm) 0 ([] : List Ctor);

def string_auth_empty_scope : List Entry :=
    append Entry
      ([MkEntry 610 (CSort 0) (Just CoreTerm (CInd 650)), MkIndEntry 650 string_auth_empty] : List Entry)
      string_nf_test_environment;

def string_auth_word_scope : List Entry :=
    append Entry
      ([MkEntry 610 (CSort 0) (Just CoreTerm (CConst 650)),
        MkBoundEntry 650 (CSort 0) (primitive_binding PrimitiveU32Type (Nothing CoreTerm))] : List Entry)
      string_nf_test_environment;

def string_auth_opaque_scope : List Entry :=
    append Entry
      ([MkEntry 610 (CSort 0) (Just CoreTerm (CConst 650)),
        MkEntry 650 (CSort 0) (Nothing CoreTerm)] : List Entry)
      string_nf_test_environment;

def string_auth_shadow (entry : Entry) : List Entry := Cons Entry entry string_nf_test_environment;

def string_auth_cycle : List Entry :=
    [MkEntry 610 (CSort 0) (Just CoreTerm (CConst 611)),
     MkEntry 611 (CSort 0) (Just CoreTerm (CConst 610))];

def string_auth_cycle_infer : Bool :=
    match infer_checked 40 string_auth_cycle ([] : List CoreTerm) (IGTerm (string_auth_literal 610)) with
    | CheckOk _ => False
    | CheckErr failure => match failure with
        | CheckResourceLimit => True
        | CheckMalformedCore _ => False | CheckTypeFailure _ => False | CheckReductionFailure _ => False
        | CheckUnsupported _ => False | CheckCancelled => False
        | CheckInternalFailure _ => False | CheckPrimitiveFailure _ => False
        end
    end;

def string_auth_module_rejects (mode : CheckMode) (items : List FileItem) : Bool :=
    match check_declarations mode keep_checking string_nf_test_fuel items with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure => andb (eqNat name 90)
        (andb (match phase with
               | CheckDeclarationBody => True | CheckDeclarationType => False
               | CheckDeclarationPlan => False | CheckInductiveDeclaration => False end)
          (string_auth_failure 18 failure))
    end;

def string_auth_forged_empty_items : List FileItem :=
    [FInd string_auth_empty, FDef 18 (CSort 0) (CInd 650),
     FDef 90 (CInd 650) (string_auth_literal 18)];

def string_auth_forged_word_items : List FileItem :=
    [FIntrinsic 650 (CSort 0) ([111, 117, 114, 111, 46, 117, 51, 50] : List Nat) (Nothing CoreTerm),
     FDef 18 (CSort 0) (CConst 650), FDef 90 (CConst 650) (string_auth_literal 18)];

def string_auth_opaque_items : List FileItem :=
    [FAxiom 18 (CSort 0), FDef 90 (CConst 18) (string_auth_literal 18)];

def string_auth_laws : List Test :=
    [ assert_true "a checked String binding authenticates bytes including NUL"
        (string_auth_infers string_nf_test_environment 18)
    , assert_true "a transparent String alias preserves its inferred type"
        (string_auth_infers string_auth_scope 610)
    , assert_true "a chain of String aliases preserves its inferred type"
        (string_auth_infers string_auth_scope 611)
    , assert_true "normalization canonicalizes a String alias without losing bytes"
        (string_nf_test_reduces_in string_auth_scope (string_auth_literal 611) (string_auth_literal 18))
    , assert_true "an unknown literal type has exact inference and reduction faults"
        (string_auth_rejects string_nf_test_environment 777)
    , assert_true "an alias to Empty cannot forge a literal inhabitant"
        (string_auth_rejects string_auth_empty_scope 610)
    , assert_true "an alias to UWord cannot forge a machine value"
        (string_auth_rejects string_auth_word_scope 610)
    , assert_true "an alias to an opaque type cannot forge a literal value"
        (string_auth_rejects string_auth_opaque_scope 610)
    , assert_true "an opaque type cannot authenticate bytes"
        (string_auth_rejects string_auth_opaque_scope 650)
    , assert_true "a machine type cannot authenticate bytes"
        (string_auth_rejects string_auth_word_scope 650)
    , assert_true "a newer opaque binding shadows an older String identity"
        (string_auth_rejects (string_auth_shadow (MkEntry 18 (CSort 0) (Nothing CoreTerm))) 18)
    , assert_true "a newer inductive binding shadows an older String identity"
        (string_auth_rejects (string_auth_shadow (MkIndEntry 18 string_auth_empty)) 18)
    , assert_true "a newer machine binding shadows an older String identity"
        (string_auth_rejects (string_auth_shadow
          (MkBoundEntry 18 (CSort 0) (primitive_binding PrimitiveU32Type (Nothing CoreTerm)))) 18)
    , assert_true "a newer String identity may shadow an older opaque binding"
        (string_auth_infers (append Entry string_nf_test_environment
          ([MkEntry 18 (CSort 0) (Nothing CoreTerm)] : List Entry)) 18)
    , assert_true "String output cannot recover a shadowed identity"
        (string_nf_test_malformed 12
          (string_auth_shadow (MkEntry 18 (CSort 0) (Nothing CoreTerm)))
          (string_nf_test_unary 105 (string_nf_test_nat 0)))
    , assert_true "String input rejects a forged type before primitive evaluation"
        (string_nf_test_malformed 14 string_auth_word_scope
          (string_nf_test_unary 101 (string_auth_literal 610)))
    , assert_true "conversion rejects a forged literal instead of comparing bytes"
        (string_nf_test_fault Bool 14 (conv_checked 200 string_auth_empty_scope
          (string_auth_literal 610) (string_auth_literal 18)))
    , assert_true "cyclic type aliases preserve inference exhaustion" string_auth_cycle_infer
    , assert_true "cyclic type aliases preserve normalization exhaustion"
        (match normalize_checked 40 string_auth_cycle (string_auth_literal 610) with
         | NormalizeExhausted => True | Normalized _ => False | NormalizeMalformed _ => False end)
    , assert_true "exact module checking rejects an Empty literal with exact type fault"
        (string_auth_module_rejects CheckExactCore string_auth_forged_empty_items)
    , assert_true "source module checking rejects an Empty literal with exact type fault"
        (string_auth_module_rejects CheckSourceCore string_auth_forged_empty_items)
    , assert_true "exact module checking rejects a UWord literal with exact type fault"
        (string_auth_module_rejects CheckExactCore string_auth_forged_word_items)
    , assert_true "source module checking rejects a UWord literal with exact type fault"
        (string_auth_module_rejects CheckSourceCore string_auth_forged_word_items)
    , assert_true "exact module checking rejects an opaque literal with exact type fault"
        (string_auth_module_rejects CheckExactCore string_auth_opaque_items)
    , assert_true "source module checking rejects an opaque literal with exact type fault"
        (string_auth_module_rejects CheckSourceCore string_auth_opaque_items)
    ];

-- @entry main
def main : IO Unit := test_run string_auth_laws;
