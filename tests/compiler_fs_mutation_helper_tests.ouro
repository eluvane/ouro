-- Each operation selects its checked raw helper and three scoped path helpers.
import "../compiler/native/managed_fs_mutations.ouro",
  "../compiler/driver.ouro",
  "compiler_startup_test_support.ouro";

def mutation_helper_prefix : String :=
    prim_string_concat
      "intrinsic Effect : Type -> Type := \"ouro.runtime\"; intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic Byte : Type := \"ouro.u8\"; intrinsic Word : Type := \"ouro.u32\"; intrinsic Size : Type := \"ouro.usize\"; intrinsic Text : Type := \"ouro.string\"; inductive Boolean : Type := | No : Boolean | Yes : Boolean; representation Boolean := \"ouro.bool\"; inductive Item : Type := | Only : Item; representation Item := \"ouro.unit\"; "
      "intrinsic pure : (A : Type) -> A -> Effect A := \"ouro.runtime.pure\"; axiom word : Word; axiom byte : Byte; axiom pointer : Pointer Byte; def raw_pages_allocate (bytes : Size) (alignment : Size) : Effect (Pointer Byte) := pure (Pointer Byte) pointer; def raw_pages_release (buffer : Pointer Byte) : Effect Boolean := pure Boolean Yes; def raw_windows_utf8_to_utf16 (source : Pointer Byte) (bytes : Size) (target : Pointer Byte) (units : Size) (written : Pointer Word) : Effect Word := pure Word word; ";

def mutation_helper_source (operation : PrimitiveId) (mode : Nat) : String :=
    let name : String := prim_string_of_char_codes
      (managed_fs_mutation_name (primitive_id_equal operation PrimitiveDirectoryCreate)) in
    let implementation : String := match eqNat mode 1 with | True => ""
      | False => match eqNat mode 2 with
        | True => prim_string_concat("axiom ", prim_string_concat name " : Pointer Byte -> Size -> Effect Word;")
        | False => match eqNat mode 4 with
          | True => prim_string_concat "extern " (prim_string_concat name
              " : Pointer Byte -> Size -> Effect Word := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetLastError\" \"nogc\";")
          | False => prim_string_concat "def " (prim_string_concat name
              (match eqNat mode 3 with
               | True => " (path : Pointer Word) (units : Size) : Effect Word := pure Word word;"
               | False => match eqNat mode 5 with
                 | True => " (path : Pointer Byte) (units : Word) : Effect Word := pure Word word;"
                 | False => " (path : Pointer Byte) (units : Size) : Effect Word := pure Word word;" end end)) end end end in
    prim_string_concat mutation_helper_prefix (prim_string_concat
      (prim_string_concat "intrinsic action : Text -> Effect Item := \""
        (prim_string_concat(prim_string_of_char_codes (primitive_key operation), "\"; "))) implementation);

def mutation_helper_probe (operation : PrimitiveId) (mode : Nat) : Bool :=
    match compile_checked_source(mul 100 50, prim_string_to_char_codes (mutation_helper_source operation mode)) with
    | CErr _ => False | COk program =>
      let compiler : ManagedCompiler := ManagedCompilerOf program ([] : List Nat) 0 0 0 0 0 0 ([] : List LowerContract)
        (check_environment_from_entries (checked_program_entries program)) in
      match managed_fs_mutation_roots compiler primitive_default_fuel with
      | Right roots => andb(eqNat mode 0, eqNat(length Nat roots, 4))
      | Left error => match error with
        | LowerUnknownGlobal _ => eqNat mode 1
        | LowerBodyMismatch _ => orb(eqNat mode 2, eqNat mode 4)
        | LowerMetadataMismatch _ => orb(eqNat mode 3, eqNat mode 5)
        | LowerResourceExhausted => False | LowerInvalidCall _ => False | LowerDeclarationFailure _ _ _ => False
        | LowerUnsupportedType _ => False | LowerUnsupportedTerm _ => False | LowerUnsupportedPrimitive _ => False
        | LowerUnboundLocal _ => False | LowerEffectMismatch => False | LowerInvalidEntry _ => False
        | LowerMirFailure _ => False | LowerBackendFailure _ => False end end end;

def main : IO Unit :=
    startup_test_run (concat_map PrimitiveId StartupTest (fun (operation : PrimitiveId) =>
      let key : String := prim_string_of_char_codes (primitive_key operation) in
      ([startup_test_assert(prim_string_concat key " selects four checked helpers", mutation_helper_probe operation 0),
        startup_test_assert(prim_string_concat key " rejects a missing helper", mutation_helper_probe operation 1),
        startup_test_assert(prim_string_concat key " rejects an axiom helper", mutation_helper_probe operation 2),
        startup_test_assert(prim_string_concat key " rejects the wrong path pointer", mutation_helper_probe operation 3),
        startup_test_assert(prim_string_concat key " rejects an extern helper", mutation_helper_probe operation 4),
        startup_test_assert(prim_string_concat key " rejects the wrong path size", mutation_helper_probe operation 5)] : List StartupTest))
      ([PrimitiveDirectoryCreate, PrimitivePathRemove] : List PrimitiveId));
