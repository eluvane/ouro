-- Predicate authority follows the checked identity and complete signature.
import "../compiler/file_elab.ouro";
import "../compiler/checked_program_output.ouro";
import "../std/test.ouro";
import "compiler_binding_surface.ouro";

def predicate_binding_base : List FileItem :=
    [FIntrinsic 100 (CSort 0) (primitive_key PrimitiveStringType) (Nothing CoreTerm),
     FIntrinsic 101 (CPi (CSort 0) (CSort 0)) (primitive_key PrimitiveRuntimeType) (Nothing CoreTerm),
     FInd (MkIndDecl 102 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor 103 (CInd 102), MkCtor 104 (CInd 102)] : List Ctor)),
     FRepresentation 102 (prim_string_to_char_codes "ouro.bool"),
     FDef 108 (CSort 0) (CConst 100), FDef 109 (CPi (CSort 0) (CSort 0)) (CConst 101),
     FDef 111 (CSort 0) (CInd 102),
     FInd (MkIndDecl 112 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor 113 (CInd 112), MkCtor 114 (CInd 112)] : List Ctor))];

def predicate_binding_declaration (predicate : PrimitiveId) (typ : CoreTerm) : FileItem :=
    FIntrinsic 120 typ (primitive_key predicate) (Nothing CoreTerm);

def predicate_binding_check (last : FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking (mul 20 50)
      (append FileItem predicate_binding_base ([last] : List FileItem));

def predicate_binding_metadata (predicate : PrimitiveId) (aliases : Bool) : Bool :=
    match predicate_binding_check (predicate_binding_declaration predicate (compiler_binding_mode_type aliases 0)) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      any Entry (fun (entry : Entry) => match entry with
        | MkBoundEntry name _ binding => match eqNat name 120 with | False => False | True =>
            match binding with | PrimitiveExternBinding _ => False
            | PrimitiveIntrinsicBinding actual execution gc specialization => andb (primitive_id_equal actual predicate)
                (andb (match execution with | PrimitiveRuntimeAction => True
                  | PrimitiveTypeOnly => False | PrimitivePureValue => False end)
                  (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                    (match specialization with | Nothing => True | Just _ => False end))) end end
        | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False end) entries end;

def predicate_binding_rejected (predicate : PrimitiveId) (mode : Nat) : Bool :=
    match predicate_binding_check (predicate_binding_declaration predicate (compiler_binding_mode_type False mode)) with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure => andb (eqNat name 120)
        (eqNat (declaration_failure_code CheckExactCore phase failure) 2) end;

def predicate_binding_shim (predicate : PrimitiveId) (axiom_only : Bool) : Bool :=
    match predicate_binding_check (match axiom_only with
      | True => FAxiom 120 (compiler_binding_mode_type False 0)
      | False => predicate_binding_declaration predicate (compiler_binding_mode_type True 0) end) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      let shims : List (Pair Nat (List Nat)) :=
        checked_program_c_shims (CheckedProgramOf empty_intern entries ([] : List (Pair Nat CoreTerm))) in
      match axiom_only with
      | True => notb (any (Pair Nat (List Nat)) (fun (item : Pair Nat (List Nat)) =>
          match item with | MkPair name _ => eqNat name 120 end) shims)
      | False => any (Pair Nat (List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair name key =>
          andb (eqNat name 120) (primitive_bytes_equal key (prim_string_to_char_codes
            (match primitive_id_equal predicate PrimitiveFileExists with
              | True => "prim_fs_exists" | False => "prim_fs_is_dir" end))) end) shims end end;

def predicate_binding_tests (predicate : PrimitiveId) : List Test :=
    let key : String := prim_string_of_char_codes (primitive_key predicate) in
    [assert_true (str_concat key " records canonical effect and GC metadata") (predicate_binding_metadata predicate False),
     assert_true (str_concat key " accepts normalized String, Bool and Runtime aliases") (predicate_binding_metadata predicate True),
     assert_true (str_concat key " rejects a non-String path") (predicate_binding_rejected predicate 1),
     assert_true (str_concat key " rejects a pure Bool result") (predicate_binding_rejected predicate 2),
     assert_true (str_concat key " rejects a Runtime String result") (predicate_binding_rejected predicate 3),
     assert_true (str_concat key " rejects the missing path argument") (predicate_binding_rejected predicate 4),
     assert_true (str_concat key " rejects an extra path argument") (predicate_binding_rejected predicate 5),
     assert_true (str_concat key " rejects an unrelated two-constructor Bool") (predicate_binding_rejected predicate 6),
     assert_true (str_concat key " maps a renamed checked identity to the retained C handler") (predicate_binding_shim predicate False),
     assert_true (str_concat key " gives no checked authority to a same-shaped axiom") (predicate_binding_shim predicate True)];

def main : IO Unit :=
    test_run (concat_map PrimitiveId Test predicate_binding_tests
      ([PrimitiveFileExists, PrimitiveFileIsDirectory] : List PrimitiveId));
