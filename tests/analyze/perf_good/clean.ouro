inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def add (a : Nat) (b : Nat) : Nat := a;

def append (A : Type) (xs : List A) (ys : List A) : List A := xs;

def length (A : Type) (xs : List A) : Nat := Z;

def reverse (A : Type) (xs : List A) : List A := xs;

def drop (A : Type) (n : Nat) (xs : List A) : List A := xs;

def eq_nat (a : Nat) (b : Nat) : Bool := True;

def andb (a : Bool) (b : Bool) : Bool :=
  match a with
  | True => b
  | False => False
  end;

def is_zero (n : Nat) : Bool :=
  match n with
  | Z => True
  | S _ => False
  end;

-- A definition whose whole body is a literal names it.
def hundred : Nat := 100;

-- A literal outside any fix is built once.
def offset (n : Nat) : Nat := add n 100;

-- A named literal and a small literal inside the loop.
-- @entry main
def main : Nat -> Nat :=
  fix main (n : Nat) : Nat :=
    match n with
    | Z => hundred
    | S k => add 3 (main k)
    end;

-- Cons onto the accumulator; the singleton is the copied side of the append.
def collect : List Nat -> List Nat -> List Nat :=
  fix collect (xs : List Nat) (acc : List Nat) : List Nat :=
    match xs with
    | Nil => reverse Nat acc
    | Cons x rest => collect rest (append Nat (Cons Nat x (Nil Nat)) acc)
    end;

-- The parameter that is copied lands in another slot and is reset, so each
-- round copies only the current block.
def flush : List Nat -> List Nat -> List Nat -> List Nat :=
  fix flush (xs : List Nat) (block : List Nat) (done : List Nat) : List Nat :=
    match xs with
    | Nil => append Nat block done
    | Cons x rest =>
        match is_zero x with
        | True => flush rest (Nil Nat) (append Nat block done)
        | False => flush rest (Cons Nat x block) done
        end
    end;

-- Length against a variable, and an arm that reads the count.
def sized (xs : List Nat) (n : Nat) : Bool := eq_nat (length Nat xs) n;

def pred_length (xs : List Nat) : Nat :=
  match length Nat xs with
  | Z => Z
  | S k => k
  end;

-- One conversion, bound once.
def doubled (xs : List Nat) : Nat :=
  let n : Nat := length Nat xs in
  add n n;

-- The conversion of the outer parameter sits in the arm that ends the loop.
def after_key (key : List Nat) : List Nat -> List Nat :=
  fix go (cs : List Nat) : List Nat :=
    match cs with
    | Nil => Nil Nat
    | Cons c rest =>
        match is_zero c with
        | True => drop Nat (length Nat key) cs
        | False => go rest
        end
    end;

-- Both operands are applications without control flow or recursion.
def both_zero (n : Nat) (m : Nat) : Bool := andb (is_zero n) (is_zero m);

-- A match operand is ordinary boolean composition, not a recursive call.
def gated (a : Bool) (n : Nat) : Bool :=
  andb a (match n with | Z => True | S _ => False end);

-- Cheap test first, recursive call second is the house style.
def all_zero : List Nat -> Bool :=
  fix all_zero (xs : List Nat) : Bool :=
    match xs with
    | Nil => True
    | Cons x rest => andb (is_zero x) (all_zero rest)
    end;
