inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Unit : Type :=
  | MkUnit : Unit;

axiom IO : Type -> Type;
axiom readNat : IO Nat;
axiom writeNat : Nat -> IO Unit;

-- @entry main
def main : Nat := let used : Nat := S Z in used;

-- A discard spelt with a leading underscore is not an unused parameter.
def const (keep : Nat) (_drop : Nat) : Nat := keep;

-- Naming a literal documents it; it is not an alias.
def named : Nat := let limit : Nat := 42 in S limit;

-- A do-bind names the action's result, not the action.
def echo : IO Unit :=
  do let! n := readNat;
     writeNat (S n)

inductive Empty : Type := ;

-- A type parameter read only by the declared return type is not unused.
def ex_falso (A : Type) (e : Empty) : A := match e with end;
