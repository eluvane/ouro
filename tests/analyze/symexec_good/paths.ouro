inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

-- The inner match scrutinises a different variable.
-- @entry main
def main (a : Bool) (b : Bool) : Bool :=
  match a with
  | True =>
      match b with
      | True => True
      | False => False
      end
  | False => False
  end;

-- The inner arm agrees with the path condition.
def same (b : Bool) : Bool :=
  match b with
  | True => match b with | True => False end
  | False => True
  end;

-- The pattern rebinds n, so the outer path condition no longer applies.
def rebound (n : Nat) : Nat :=
  match n with
  | Z => Z
  | S n =>
      match n with
      | Z => S Z
      | S _ => n
      end
  end;

-- The recursive call decreases a parameter.
def count : Nat -> Nat -> Nat :=
  fix count (n : Nat) (acc : Nat) : Nat :=
    match n with
    | Z => acc
    | S k => count k (S acc)
    end;

-- The pattern rebinds n, so the recursive call passes a new value even
-- though the name repeats.
def shadowed : Nat -> Nat :=
  fix shadowed (n : Nat) : Nat :=
    match n with
    | Z => Z
    | S n => shadowed n
    end;
