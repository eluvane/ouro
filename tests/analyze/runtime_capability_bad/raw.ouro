-- Newly bound primitives retain the same raw capability boundary.
def rename : String -> String -> IO Nat := prim_fs_rename;
def capture : String -> List String -> IO (Pair Nat (Pair String String)) := prim_process_capture;
def request : String -> List (Pair String String) -> String -> IO (Pair Nat (Pair String String)) := prim_http_request;
def bounded : String -> List String -> Pair String (Pair Nat (Pair Nat (Pair Nat (Pair Nat Nat))))
    -> IO (Pair Nat (Pair Nat (Pair Nat (Pair String String)))) := prim_process_capture_bounded;
