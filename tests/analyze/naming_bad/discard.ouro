inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

-- The parameter is spelt as a discard but the body reads it.
-- @entry main
def main (_n : Nat) : Nat := S _n;

-- A fix parameter spelt as a discard and read.
def count : Nat -> Nat -> Nat :=
  fix count (n : Nat) (_acc : Nat) : Nat :=
    match n with
    | Z => _acc
    | S k => count k (S _acc)
    end;
