inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

def apply4 (f : Nat -> Nat -> Nat -> Nat -> Nat) : Nat := f Z Z Z Z;

-- Four lambdas nested inside the body; the parameter telescope does not count.
-- @complexity
-- @entry main
def main (seed : Nat) : Nat :=
  apply4 (fun (a : Nat) => fun (b : Nat) => fun (c : Nat) => fun (d : Nat) => seed);
