-- Exact-list regressions for the shared code-review families. These tests
-- exercise the native cores, not a text approximation of binder scopes.

-- @entry main

import "../../../tools/analyze/naming.ouro";
import "../../../std/stringx.ouro";
import "../../../tools/analyze/simplify.ouro";
import "assertions.ouro";

def precision_style_type : Ast := ASort Z;
def precision_style_zero : Ast := ANatLit Z;
def precision_style_ids : SimpIds := MkSimpIds 1 2 3 4 5;
def precision_style_double : Ast := AApp (AVar 3) (AApp (AVar 3) (AVar 10));
def precision_style_effect : Ast := APerform 99 ([] : List Ast);

def precision_style_df_code (issue : DfIssue) : String :=
    match issue with
    | IUnusedParam id => str_concat "OURO-DF001:" (show_nat id)
    | IDeadStore id => str_concat "OURO-DF002:" (show_nat id)
    | IAlias id => str_concat "OURO-DF003:" (show_nat id)
    | IHoleFlow id => str_concat "OURO-DF004:" (show_nat id)
    end;

def precision_style_name_code (issue : NameIssue) : String :=
    match issue with
    | IUsedDiscard id => str_concat "OURO-NAME001:" (show_nat id)
    | IShortName _ => "OURO-NAME002"
    | ICapitalDef _ => "OURO-NAME003"
    end;

def precision_style_simp_code (issue : SimpIssue) : String :=
    match issue with
    | IBoolIdentity _ => "OURO-SIMP001"
    | IBoolNegation _ => "OURO-SIMP002"
    | IIdenticalArms _ => "OURO-SIMP003"
    | IEtaLambda _ => "OURO-SIMP004"
    | IDoubleNot _ => "OURO-SIMP005"
    | IConstBoolOperand _ _ => "OURO-SIMP006"
    | IRewrapIdentity _ => "OURO-SIMP007"
    end;

def precision_style_df (discards : List Nat) (a : Ast) : List String :=
    map DfIssue String precision_style_df_code (analyze_dataflow discards a);

def precision_style_names (discards : List Nat) (a : Ast) : List String :=
    map NameIssue String precision_style_name_code (nm_walk discards a);

def precision_style_simp (a : Ast) : List String :=
    map SimpIssue String precision_style_simp_code
      (analyze_simplify precision_style_ids ([1, 2, 20, 21] : List Nat) 900 a);

def precision_style_case (name : String) (actual : List String)
    (expected : List String) : Pair String Bool :=
    MkPair String Bool name (precision_strings expected actual);

def precision_style_same : Ast :=
    ABranch 20 ([] : List Nat) precision_style_zero (ABranch 21 ([] : List Nat) precision_style_zero ANoBranch);

def precision_style_identity : Ast :=
    AMatch (AVar 10) (ABranch 1 ([] : List Nat) (AVar 1) (ABranch 2 ([] : List Nat) (AVar 2) ANoBranch));

def precision_style_negation : Ast :=
    AMatch (AVar 10) (ABranch 1 ([] : List Nat) (AVar 2) (ABranch 2 ([] : List Nat) (AVar 1) ANoBranch));

def precision_style_shadowed : Ast :=
    AFix 90 (ABinder 10 precision_style_type (ABinder 10 precision_style_type ANoBinder))
      precision_style_type (AVar 10);

def precision_style_dependent : Ast :=
    AFix 90 (ABinder 10 precision_style_type (ABinder 11 (AVar 10) ANoBinder))
      precision_style_type (AVar 11);

def precision_style_binders : List (Pair String Bool) :=
    [ precision_style_case "DF001/bad/unused-named-parameter"
        (precision_style_df ([] : List Nat) (ALam 10 precision_style_type precision_style_zero))
        (["OURO-DF001:10"] : List String)
    , precision_style_case "DF001/good/explicit-discard"
        (precision_style_df ([10] : List Nat) (ALam 10 precision_style_type precision_style_zero)) ([] : List String)
    , precision_style_case "DF001/good/used-parameter"
        (precision_style_df ([] : List Nat) (ALam 10 precision_style_type (AVar 10))) ([] : List String)
    , precision_style_case "DF001/fp/later-dependent-type"
        (precision_style_df ([] : List Nat) precision_style_dependent) ([] : List String)
    , precision_style_case "DF001/fp/return-type-use"
        (precision_style_df ([] : List Nat)
          (AFix 90 (ABinder 10 precision_style_type ANoBinder) (AVar 10) precision_style_zero)) ([] : List String)
    , precision_style_case "DF001/bad/later-binder-hides-outer-body-use"
        (precision_style_df ([] : List Nat) precision_style_shadowed) (["OURO-DF001:10"] : List String)
    , precision_style_case "DF001/bad/own-annotation-is-outside-scope"
        (precision_style_df ([] : List Nat)
          (AFix 90 (ABinder 10 (AVar 10) ANoBinder) precision_style_type precision_style_zero))
        (["OURO-DF001:10"] : List String)
    , precision_style_case "DF001/fp/annotation-precedes-shadowing"
        (precision_style_df ([] : List Nat)
          (AFix 90 (ABinder 10 precision_style_type (ABinder 10 (AVar 10) ANoBinder))
            precision_style_type (AVar 10))) ([] : List String)
    , precision_style_case "DF001/bad/nested-lambda-shadows-use"
        (precision_style_df ([] : List Nat)
          (AFix 90 (ABinder 10 precision_style_type ANoBinder) precision_style_type
            (ALam 10 precision_style_type (AVar 10)))) (["OURO-DF001:10"] : List String)
    , precision_style_case "NAME001/bad/used-discard"
        (precision_style_names ([10] : List Nat) (ALam 10 precision_style_type (AVar 10)))
        (["OURO-NAME001:10"] : List String)
    , precision_style_case "NAME001/good/unused-discard"
        (precision_style_names ([10] : List Nat) (ALam 10 precision_style_type precision_style_zero)) ([] : List String)
    , precision_style_case "NAME001/fp/own-annotation-is-not-a-use"
        (precision_style_names ([10] : List Nat)
          (AFix 90 (ABinder 10 (AVar 10) ANoBinder) precision_style_type precision_style_zero)) ([] : List String)
    , precision_style_case "NAME001/fp/earlier-annotation-is-not-a-use"
        (precision_style_names ([10] : List Nat)
          (AFix 90 (ABinder 11 (AVar 10) (ABinder 10 precision_style_type ANoBinder))
            precision_style_type (AVar 11))) ([] : List String)
    , precision_style_case "NAME001/bad/dependent-type-reads-discard"
        (precision_style_names ([10] : List Nat) precision_style_dependent) (["OURO-NAME001:10"] : List String)
    , precision_style_case "NAME001/fp/one-read-binder-not-two-equal-intern-ids"
        (precision_style_names ([10] : List Nat) precision_style_shadowed) (["OURO-NAME001:10"] : List String)
    , precision_style_case "NAME001/bad/annotation-before-rebinding-reads-outer"
        (precision_style_names ([10] : List Nat)
          (AFix 90 (ABinder 10 precision_style_type (ABinder 10 (AVar 10) ANoBinder))
            precision_style_type precision_style_zero)) (["OURO-NAME001:10"] : List String)
    ];

def precision_style_scopes : List (Pair String Bool) :=
    [ precision_style_case "SIMP005/bad/double-negation"
        (precision_style_simp precision_style_double) (["OURO-SIMP005"] : List String)
    , precision_style_case "SIMP005/good/single-negation"
        (precision_style_simp (AApp (AVar 3) (AVar 10))) ([] : List String)
    , precision_style_case "SIMP005/fp/top-level-helper-parameter"
        (precision_style_simp (ALam 3 precision_style_type precision_style_double)) ([] : List String)
    , precision_style_case "SIMP005/fp/nested-helper-parameter"
        (precision_style_simp (AList ([ALam 3 precision_style_type precision_style_double] : List Ast))) ([] : List String)
    , precision_style_case "SIMP005/fp/let-hides-helper"
        (precision_style_simp (ALet 3 precision_style_type (AVar 90) precision_style_double)) ([] : List String)
    , precision_style_case "SIMP005/bad/let-initializer-precedes-binding"
        (precision_style_simp (ALet 3 precision_style_type precision_style_double (AVar 3)))
        (["OURO-SIMP005"] : List String)
    , precision_style_case "SIMP005/bad/lambda-annotation-precedes-binding"
        (precision_style_simp (AList ([ALam 3 precision_style_double (AVar 3)] : List Ast)))
        (["OURO-SIMP005"] : List String)
    , precision_style_case "SIMP005/fp/fix-parameter-hides-helper"
        (precision_style_simp
          (AFix 90 (ABinder 3 precision_style_type ANoBinder) precision_style_type
            precision_style_double)) ([] : List String)
    , precision_style_case "SIMP005/fp/recursive-name-hides-helper"
        (precision_style_simp
          (AFix 3 (ABinder 11 precision_style_type ANoBinder) precision_style_type
            precision_style_double)) ([] : List String)
    , precision_style_case "SIMP005/bad/telescope-annotations-use-positional-scope"
        (precision_style_simp
          (AList ([AFix 90 (ABinder 3 precision_style_double
              (ABinder 11 precision_style_double ANoBinder)) precision_style_type
            precision_style_double] : List Ast))) (["OURO-SIMP005"] : List String)
    , precision_style_case "SIMP005/bad/match-sibling-keeps-outer-helper"
        (precision_style_simp
          (AMatch (AVar 10) (ABranch 20 ([3] : List Nat) precision_style_double
            (ABranch 21 ([] : List Nat) precision_style_double ANoBranch)))) (["OURO-SIMP005"] : List String)
    , precision_style_case "SIMP005/bad/handler-sibling-keeps-outer-helper"
        (precision_style_simp
          (AClause 20 ([3] : List Nat) precision_style_double
            (AClause 21 ([] : List Nat) precision_style_double ANoClause))) (["OURO-SIMP005"] : List String)
    , precision_style_case "SIMP005/fp/inner-call-must-be-unary"
        (precision_style_simp
          (AApp (AVar 3) (AApp (AApp (AVar 3) (AVar 10)) (AVar 11)))) ([] : List String)
    , precision_style_case "SIMP002/bad/boolean-negation-match"
        (precision_style_simp precision_style_negation) (["OURO-SIMP002"] : List String)
    , precision_style_case "SIMP002/fp/suggested-helper-is-hidden"
        (precision_style_simp (ALam 3 precision_style_type precision_style_negation)) ([] : List String)
    , precision_style_case "SIMP001/bad/one-specific-rule-not-also-rewrap"
        (precision_style_simp precision_style_identity) (["OURO-SIMP001"] : List String)
    , precision_style_case "SIMP001/bad/hidden-notb-does-not-disable-identity"
        (precision_style_simp (ALam 3 precision_style_type precision_style_identity))
        (["OURO-SIMP001"] : List String)
    , precision_style_case "SIMP001-SIMP007/fp/constructor-name-is-a-local-value"
        (precision_style_simp (ALam 1 precision_style_type precision_style_identity)) ([] : List String)
    ];

def precision_style_evaluation : List (Pair String Bool) :=
    [ precision_style_case "SIMP003/bad/identical-arms-over-a-variable"
        (precision_style_simp (AMatch (AVar 10) precision_style_same)) (["OURO-SIMP003"] : List String)
    , precision_style_case "SIMP003/fp/do-not-drop-perform-scrutinee"
        (precision_style_simp (AMatch precision_style_effect precision_style_same)) ([] : List String)
    , precision_style_case "SIMP003/fp/do-not-assume-a-call-is-pure"
        (precision_style_simp (AMatch (AApp (AVar 90) (AVar 10)) precision_style_same)) ([] : List String)
    , precision_style_case "SIMP001/bad/identity-retains-perform-once"
        (precision_style_simp
          (AMatch precision_style_effect
            (ABranch 1 ([] : List Nat) (AVar 1) (ABranch 2 ([] : List Nat) (AVar 2) ANoBranch)))) (["OURO-SIMP001"] : List String)
    , precision_style_case "SIMP006/bad/absorbing-constant-with-an-atom"
        (precision_style_simp (AApp (AApp (AVar 4) (AVar 10)) (AVar 2))) (["OURO-SIMP006"] : List String)
    , precision_style_case "SIMP006/bad/neutral-constant-retains-perform"
        (precision_style_simp (AApp (AApp (AVar 4) (AVar 1)) precision_style_effect))
        (["OURO-SIMP006"] : List String)
    , precision_style_case "SIMP006/fp/absorbing-constant-must-not-drop-perform"
        (precision_style_simp (AApp (AApp (AVar 4) (AVar 2)) precision_style_effect)) ([] : List String)
    , precision_style_case "SIMP006/fp/absorbing-constant-must-not-drop-call"
        (precision_style_simp
          (AApp (AApp (AVar 4) (AApp (AVar 90) (AVar 10))) (AVar 2))) ([] : List String)
    , precision_style_case "SIMP006/fp/hidden-andb-is-not-the-stdlib-operation"
        (precision_style_simp
          (ALam 4 precision_style_type (AApp (AApp (AVar 4) (AVar 1)) (AVar 10)))) ([] : List String)
    , precision_style_case "SIMP006/fp/orb-true-must-not-drop-perform"
        (precision_style_simp (AApp (AApp (AVar 5) (AVar 1)) precision_style_effect)) ([] : List String)
    , precision_style_case "SIMP006/bad/orb-false-retains-perform"
        (precision_style_simp (AApp (AApp (AVar 5) (AVar 2)) precision_style_effect))
        (["OURO-SIMP006"] : List String)
    , precision_style_case "SIMP004/bad/nested-forwarding-lambda"
        (precision_style_simp
          (AList ([ALam 10 precision_style_type (AApp (AVar 90) (AVar 10))] : List Ast)))
        (["OURO-SIMP004"] : List String)
    , precision_style_case "SIMP004/fp/constructor-eta-is-an-idiom"
        (precision_style_simp
          (AList ([ALam 10 precision_style_type (AApp (AVar 20) (AVar 10))] : List Ast))) ([] : List String)
    , precision_style_case "SIMP004/fp/recursive-eta-preserves-termination-checking"
        (precision_style_simp
          (AFix 90 (ABinder 11 precision_style_type ANoBinder) precision_style_type
            (AList ([ALam 10 precision_style_type (AApp (AVar 90) (AVar 10))] : List Ast)))) ([] : List String)
    ];

def main : IO Unit :=
    precision_run "style"
      (append (Pair String Bool) precision_style_binders
        (append (Pair String Bool) precision_style_scopes precision_style_evaluation));
