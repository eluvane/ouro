-- Regression fixtures for the existing WUnused, WNonRecFix and
-- WCtorAppArity warning vocabulary. Unexpected warnings fail the exact-list
-- assertion instead of being filtered away.

-- @entry main

import "../../../compiler/lint.ouro",
  "../../../std/stringx.ouro",
  "assertions.ouro";

def precision_lint_type : Ast := ASort Z;
def precision_lint_value : Ast := ANatLit Z;
def precision_lint_sigs : List Sig := [MkSig 90 20 1 0];
def precision_lint_scope : Scope := MkScope precision_lint_sigs ([20] : List Nat) True;

def precision_lint_code (warning : Warning) : String :=
    match warning with
    | WUnused id => str_concat("WUnused:", show_nat id)
    | WNonRecFix id => str_concat("WNonRecFix:", show_nat id)
    | WCtorAppArity id => str_concat("WCtorAppArity:", show_nat id)
    | WHole _ => "unexpected:WHole"
    | WUnbound id => str_concat("WUnbound:", show_nat id)
    | WShadow id => str_concat("WShadow:", show_nat id)
    | WCtorArity _ => "unexpected:WCtorArity"
    | WRedundantBranch _ => "unexpected:WRedundantBranch"
    | WPartialMatch _ => "unexpected:WPartialMatch"
    | WUnreachableArm _ => "unexpected:WUnreachableArm"
    | WDupBinder _ => "unexpected:WDupBinder"
    | WUnknownCtor _ => "unexpected:WUnknownCtor"
    | WMixedCtors _ => "unexpected:WMixedCtors"
    | WEmptyMatch _ => "unexpected:WEmptyMatch"
    | WShadowCtor id => str_concat("WShadowCtor:", show_nat id)
    | WMatchOnHole _ => "unexpected:WMatchOnHole"
    | WMatchOnLit _ => "unexpected:WMatchOnLit"
    | WMatchOnSort _ => "unexpected:WMatchOnSort"
    | WEmptyTelescope _ => "unexpected:WEmptyTelescope"
    | WUnusedDef _ => "unexpected:WUnusedDef"
    | WUnusedCtor _ => "unexpected:WUnusedCtor"
    | WUnusedInd _ => "unexpected:WUnusedInd"
    end;

def precision_lint_case (name : String) (warnings : List Warning)
    (expected : List String) : Pair String Bool :=
    MkPair String Bool name
      (precision_strings(expected, map Warning String precision_lint_code warnings));

def precision_lint_over : Ast :=
    AApp(AApp(AVar 20, precision_lint_value), precision_lint_value);

def precision_lint_cases : List (Pair String Bool) :=
    [ precision_lint_case "unused/bad/later-binder-hides-first-use"
        (unusedBinders
          (ABinder 10 precision_lint_type (ABinder 10 precision_lint_type ANoBinder))
          precision_lint_type (AVar 10)) (["WUnused:10"] : List String)
    , precision_lint_case "unused/good/body-use"
        (unusedBinders (ABinder 10 precision_lint_type ANoBinder)
          precision_lint_type (AVar 10)) ([] : List String)
    , precision_lint_case "unused/fp/dependent-later-type-is-a-use"
        (unusedBinders
          (ABinder 10 precision_lint_type (ABinder 11 (AVar 10) ANoBinder))
          precision_lint_type (AVar 11)) ([] : List String)
    , precision_lint_case "unused/fp/annotation-precedes-shadowing"
        (unusedBinders
          (ABinder 10 precision_lint_type (ABinder 10 (AVar 10) ANoBinder))
          precision_lint_type (AVar 10)) ([] : List String)
    , precision_lint_case "unused/good/return-type-use"
        (unusedBinders (ABinder 10 precision_lint_type ANoBinder)
          (AVar 10) precision_lint_value) ([] : List String)
    , precision_lint_case "unused/bad/nested-lambda-does-not-use-outer-name"
        (unusedBinders (ABinder 10 precision_lint_type ANoBinder)
          precision_lint_type (ALam 10 precision_lint_type (AVar 10))) (["WUnused:10"] : List String)
    , precision_lint_case "unused/fp/named-function-type-may-be-nondependent"
        (lintCtx (APi 10 precision_lint_type precision_lint_type)
          precision_lint_scope ([] : List Nat) False) ([] : List String)
    , precision_lint_case "unused/fp/typed-local-helper-uses-value-parameter"
        (lintCtx (ALet 30 (APi 10 precision_lint_type precision_lint_type)
          (ALam 10 precision_lint_type (AVar 10)) (AVar 30))
          precision_lint_scope ([] : List Nat) False) ([] : List String)
    , precision_lint_case "unused/bad/typed-local-helper-ignores-value-parameter"
        (lintCtx (ALet 30 (APi 10 precision_lint_type precision_lint_type)
          (ALam 10 precision_lint_type precision_lint_value) (AVar 30))
          precision_lint_scope ([] : List Nat) False) (["WUnused:10"] : List String)
    , precision_lint_case "unused/bad/typed-local-helper-name-is-unused"
        (lintCtx (ALet 30 (APi 10 precision_lint_type precision_lint_type)
          (ALam 10 precision_lint_type (AVar 10)) precision_lint_value)
          precision_lint_scope ([] : List Nat) False) (["WUnused:30"] : List String)
    , precision_lint_case "pi/good/dependent-codomain-sees-binder"
        (lintCtx (APi 10 precision_lint_type (AVar 10))
          precision_lint_scope ([] : List Nat) False) ([] : List String)
    , precision_lint_case "pi/bad/domain-does-not-see-own-binder"
        (lintCtx (APi 10 (AVar 10) precision_lint_type)
          precision_lint_scope ([] : List Nat) False) (["WUnbound:10"] : List String)
    , precision_lint_case "pi/bad/shadow-is-still-reported"
        (lintCtx (APi 10 precision_lint_type precision_lint_type)
          precision_lint_scope ([10] : List Nat) False) (["WShadow:10"] : List String)
    , precision_lint_case "pi/bad/constructor-capture-is-still-reported"
        (lintCtx (APi 20 precision_lint_type precision_lint_type)
          precision_lint_scope ([] : List Nat) False) (["WShadowCtor:20"] : List String)
    , precision_lint_case "lambda/bad/shadow-is-still-reported"
        (lintCtx (ALam 10 precision_lint_type (AVar 10))
          precision_lint_scope ([10] : List Nat) False) (["WShadow:10"] : List String)
    , precision_lint_case "nonrec/bad/parameter-hides-recursive-name"
        (nonRecFix 10 (ABinder 10 precision_lint_type ANoBinder)
          precision_lint_type (AVar 10)) (["WNonRecFix:10"] : List String)
    , precision_lint_case "nonrec/bad/no-recursive-reference"
        (nonRecFix 10 (ABinder 11 precision_lint_type ANoBinder)
          precision_lint_type (AVar 11)) (["WNonRecFix:10"] : List String)
    , precision_lint_case "nonrec/good/actual-recursive-reference"
        (nonRecFix 10 (ABinder 11 precision_lint_type ANoBinder)
          precision_lint_type (AApp(AVar 10, AVar 11))) ([] : List String)
    , precision_lint_case "nonrec/fp/type-use-before-shadowing"
        (nonRecFix 10 (ABinder 10 (AVar 10) ANoBinder)
          precision_lint_type (AVar 10)) ([] : List String)
    , precision_lint_case "ctor-app/bad/ascribed-partial-spine"
        (checkCtorAppArity
          (AApp (AAscribe(AApp(AVar 20, precision_lint_value), precision_lint_type))
            precision_lint_value) precision_lint_sigs False) (["WCtorAppArity:20"] : List String)
    , precision_lint_case "ctor-app/good/exact-ascribed-application"
        (checkCtorAppArity
          (AApp(AAscribe(AVar 20, precision_lint_type), precision_lint_value))
          precision_lint_sigs False) ([] : List String)
    , precision_lint_case "ctor-app/fp/explicit-type-parameter-counts"
        (checkCtorAppArity
          (AAscribe precision_lint_over precision_lint_type)
          ([MkSig 90 20 1 1] : List Sig) False) ([] : List String)
    , precision_lint_case "ctor-app/bad/one-diagnostic-per-maximal-spine"
        (lintCtx
          (AApp(AAscribe precision_lint_over precision_lint_type, precision_lint_value))
          precision_lint_scope ([20] : List Nat) False) (["WCtorAppArity:20"] : List String)
    , precision_lint_case "ctor-app/bad/top-level-ascription-still-checks"
        (lintCtx (AAscribe precision_lint_over precision_lint_type)
          precision_lint_scope ([20] : List Nat) False) (["WCtorAppArity:20"] : List String)
    , precision_lint_case "ctor-app/fp/unknown-function-has-no-constructor-signature"
        (checkCtorAppArity
          (AApp(AApp(AVar 91, precision_lint_value), precision_lint_value))
          precision_lint_sigs False) ([] : List String)
    , precision_lint_case "ctor-app/good/partial-application"
        (checkCtorAppArity (AVar 20) precision_lint_sigs False) ([] : List String)
    ];

def main : IO Unit := precision_run "lint" precision_lint_cases;
