-- Regressions for compiler helpers whose recursive or library names were unbound.
-- @entry main

import "../../../compiler/extract.ouro",
  "../../../compiler/pipeline_support.ouro",
  "../../../compiler/file_elab_core.ouro",
  "../../../compiler/file_elab_lookup.ouro",
  "assertions.ouro";

def helper_units : List SrcUnit :=
    [ MkSrcUnit(1, [DDef(11, ESort 0, ESort 0)] : List Decl)
    , MkSrcUnit(2, [DImport 1, DDef(21, ESort 0, ESort 0), DAxiom(22, ESort 0)] : List Decl)
    , MkSrcUnit(2, [DDef(99, ESort 0, ESort 0)] : List Decl)
    ];

def helper_perform : Surface := SPerform(7, [SConst 8, SConst 9] : List Surface);

def helper_core (fuel : Nat) (surface : Surface) (context : List Nat)
    (expected : CoreTerm) : Bool := eqTerm 32 (elaborate fuel surface context) expected;

def helper_tests : List (Pair String Bool) :=
    [ MkPair String Bool "helpers/type-ir-sort" (is_type_ir (JErr 3))
    , MkPair String Bool "helpers/type-ir-pi" (is_type_ir (JErr 4))
    , MkPair String Bool "helpers/type-ir-inductive" (is_type_ir (JErr 5))
    , MkPair String Bool "helpers/type-ir-other-error" (notb (is_type_ir (JErr 2)))
    , MkPair String Bool "helpers/type-ir-recursive-head"
        (is_type_ir (JApp(JApp(JErr 5, JVar 0), JVar 1)))
    , MkPair String Bool "helpers/type-ir-preserves-value-head"
        (notb (is_type_ir (JApp(JApp(JGlob 7, JErr 3), JErr 4))))
    , MkPair String Bool "helpers/unit-names-empty"
        (eqList(unit_decl_names([] : List SrcUnit, 2), [] : List Nat))
    , MkPair String Bool "helpers/unit-names-later-root-and-first-match"
        (eqList(unit_decl_names helper_units 2, [21, 22] : List Nat))
    , MkPair String Bool "helpers/unit-names-missing-root"
        (eqList(unit_decl_names helper_units 3, [] : List Nat))
    , MkPair String Bool "helpers/perform-zero-fuel"
        (notb (surface_fits(0, SPerform(7, [] : List Surface))))
    , MkPair String Bool "helpers/perform-empty-fuel-one"
        (surface_fits(1, SPerform(7, [] : List Surface)))
    , MkPair String Bool "helpers/perform-children-need-fuel"
        (notb (surface_fits 1 helper_perform))
    , MkPair String Bool "helpers/perform-all-children-fit"
        (surface_fits 2 helper_perform)
    , MkPair String Bool "helpers/perform-later-child-too-deep"
        (notb (surface_fits(2, SPerform(7, [SConst 8, helper_perform] : List Surface))))
    , MkPair String Bool "helpers/case-children-fit"
        (surface_fits 2 (SCase (MkCaseInfo 1 0 ([] : List Nat)) (SSort 0)
          (SConst 8) ([SConst 9] : List Surface)))
    , MkPair String Bool "helpers/case-branch-too-deep"
        (notb (surface_fits 2 (SCase (MkCaseInfo 1 0 ([] : List Nat)) (SSort 0)
          (SConst 8) ([helper_perform] : List Surface))))
    , MkPair String Bool "helpers/perform-empty-elaboration"
        (helper_core(1, SPerform(7, [] : List Surface), [] : List Nat, CConst 7))
    , MkPair String Bool "helpers/perform-argument-order"
        (helper_core 2 helper_perform ([] : List Nat)
          (CApp(CApp(CConst 7, CConst 8), CConst 9)))
    , MkPair String Bool "helpers/perform-argument-context"
        (helper_core 2 (SPerform(7, [SVar 20, SVar 21] : List Surface))
          ([21, 20] : List Nat) (CApp(CApp(CConst 7, CRel 1), CRel 0)))
    , MkPair String Bool "helpers/perform-exhausted-child"
        (helper_core 1 (SPerform(7, [SConst 8] : List Surface)) ([] : List Nat)
          (CApp(CConst 7, elab_exhausted)))
    ];

def main : IO Unit := precision_run "frontend-helpers" helper_tests;
