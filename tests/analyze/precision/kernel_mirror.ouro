-- Constructor mismatches, metadata, fuel and reduction for the untrusted mirror.
-- Logical kernel acceptance is still checked by the independent kernel suites.
-- @entry main

import "../../../compiler/kernel_core.ouro",
  "assertions.ouro";

def mirror_case (ci : CaseInfo) (branches : List CoreTerm) : CoreTerm :=
    CCase(ci, CSort 0, CConstruct 7 0 0, branches);

def mirror_info : CaseInfo := MkCaseInfo 7 0 ([1] : List Nat);

-- Every constructor occurs, and every payload field has a distinct mutant.
def mirror_terms : List CoreTerm :=
    [ CRel 0, CRel 1, CSort 0, CSort 1
    , CPi(CRel 0, CRel 1), CPi(CRel 1, CRel 1), CPi(CRel 0, CRel 0)
    , CLam(CSort 0, CRel 0), CLam(CSort 1, CRel 0), CLam(CSort 0, CRel 1)
    , CApp(CConst 2, CRel 0), CApp(CConst 3, CRel 0), CApp(CConst 2, CRel 1)
    , CLetIn(CRel 0, CSort 0, CRel 1)
    , CLetIn(CRel 1, CSort 0, CRel 1)
    , CLetIn(CRel 0, CSort 1, CRel 1)
    , CLetIn(CRel 0, CSort 0, CRel 0)
    , CConst 0, CConst 1, CInd 0, CInd 1
    , CConstruct 0 0 0, CConstruct 1 0 0, CConstruct 0 1 0, CConstruct 0 0 1
    , CStrLit 0 7, CStrLit 1 7, CStrLit 0 8
    , mirror_case(mirror_info, [CRel 0] : List CoreTerm)
    , mirror_case(MkCaseInfo 8 0 ([1] : List Nat), [CRel 0] : List CoreTerm)
    , mirror_case(MkCaseInfo 7 1 ([1] : List Nat), [CRel 0] : List CoreTerm)
    , mirror_case(MkCaseInfo 7 0 ([0] : List Nat), [CRel 0] : List CoreTerm)
    , CCase(mirror_info, CSort 1, CConstruct 7 0 0, [CRel 0] : List CoreTerm)
    , CCase(mirror_info, CSort 0, CConstruct 7 1 0, [CRel 0] : List CoreTerm)
    , mirror_case(mirror_info, [CRel 1] : List CoreTerm)
    , mirror_case(mirror_info, [] : List CoreTerm)
    , mirror_case(mirror_info, [CRel 0, CRel 1] : List CoreTerm)
    , mirror_case(mirror_info, [CRel 1, CRel 0] : List CoreTerm)
    , CFix 7 0 1 (CSort 0) (CRel 0)
    , CFix 8 0 1 (CSort 0) (CRel 0)
    , CFix 7 1 1 (CSort 0) (CRel 0)
    , CFix 7 0 2 (CSort 0) (CRel 0)
    , CFix 7 0 1 (CSort 1) (CRel 0)
    , CFix 7 0 1 (CSort 0) (CRel 1)
    ];

def mirror_bool_eq (left : Bool) (right : Bool) : Bool :=
    match left with
    | True => match right with | True => True | False => False end
    | False => match right with | True => False | False => True end
    end;

def mirror_matrix_row (term : CoreTerm) (index : Nat)
    : List CoreTerm -> Nat -> Bool :=
  fix mirror_matrix_row (xs : List CoreTerm) (other : Nat) : Bool :=
    match xs with
    | Nil => True
    | Cons candidate rest =>
        andb (mirror_bool_eq(eqTerm 16 term candidate, eqNat index other))
          (mirror_matrix_row(rest, S other))
    end;

def mirror_matrix : List CoreTerm -> Nat -> Bool :=
  fix mirror_matrix (xs : List CoreTerm) (index : Nat) : Bool :=
    match xs with
    | Nil => True
    | Cons term rest =>
        andb (mirror_matrix_row term index mirror_terms Z)
          (mirror_matrix(rest, S index))
    end;

def mirror_encoding (fuel : Nat) (term : CoreTerm) (expected : List Nat) : Bool :=
    match encode fuel term with
    | None => False
    | Some encoded => eqList encoded expected
    end;

def mirror_no_encoding (fuel : Nat) (term : CoreTerm) : Bool :=
    match encode fuel term with | None => True | Some _ => False end;

def mirror_normal (fuel : Nat) (sig : List Entry) (term : CoreTerm)
    (expected : CoreTerm) : Bool := eqTerm 16 (normalize fuel sig term) expected;

def mirror_constant_sig : List Entry := [MkEntry(7, CSort 0, Some(CoreTerm, CRel 2))];

def mirror_beta : CoreTerm := CApp(CLam(CSort 0, CRel 0), CConst 7);

def mirror_fix (rec_arg : Nat) : CoreTerm :=
    CFix 4 rec_arg 1 (CPi(CInd 7, CInd 7)) (CLam(CInd 7, CRel 0));

def mirror_tests : List (Pair String Bool) :=
    [ MkPair String Bool "mirror/all-constructor-and-payload-pairs"
        (mirror_matrix mirror_terms Z)
    , MkPair String Bool "mirror/equality-zero-fuel" (notb (eqTerm(0, CRel 0, CRel 0)))
    , MkPair String Bool "mirror/equality-leaf-fuel" (eqTerm(1, CRel 0, CRel 0))
    , MkPair String Bool "mirror/equality-pair-needs-child-fuel"
        (notb (eqTerm(1, CPi(CRel 0, CRel 0), CPi(CRel 0, CRel 0))))
    , MkPair String Bool "mirror/equality-case-empty-branches"
        (eqTerm 2 (mirror_case(mirror_info, [] : List CoreTerm))
          (mirror_case(mirror_info, [] : List CoreTerm)))
    , MkPair String Bool "mirror/equality-branch-list-consumes-fuel"
        (notb (eqTerm 2 (mirror_case(mirror_info, [CRel 0] : List CoreTerm))
          (mirror_case(mirror_info, [CRel 0] : List CoreTerm))))
    , MkPair String Bool "mirror/equality-branch-list-sufficient-fuel"
        (eqTerm 3 (mirror_case(mirror_info, [CRel 0] : List CoreTerm))
          (mirror_case(mirror_info, [CRel 0] : List CoreTerm)))
    , MkPair String Bool "mirror/equality-later-branch-needs-fuel"
        (notb (eqTerm 3 (mirror_case(mirror_info, [CRel 0, CRel 1] : List CoreTerm))
          (mirror_case(mirror_info, [CRel 0, CRel 1] : List CoreTerm))))
    , MkPair String Bool "mirror/encode-zero-fuel" (mirror_no_encoding(0, CRel 0))
    , MkPair String Bool "mirror/encode-leaf" (mirror_encoding(1, CRel 3, [0, 3] : List Nat))
    , MkPair String Bool "mirror/encode-short-fuel"
        (mirror_no_encoding(1, CPi(CSort 0, CRel 1)))
    , MkPair String Bool "mirror/encode-pi"
        (mirror_encoding(2, CPi(CSort 0, CRel 1), [2, 1, 0, 0, 1] : List Nat))
    , MkPair String Bool "mirror/encode-lambda"
        (mirror_encoding(2, CLam(CSort 0, CRel 0), [3, 1, 0, 0, 0] : List Nat))
    , MkPair String Bool "mirror/encode-application"
        (mirror_encoding(2, CApp(CConst 2, CRel 1), [4, 6, 2, 0, 1] : List Nat))
    , MkPair String Bool "mirror/encode-case-metadata-and-order"
        (mirror_encoding 2 (mirror_case(mirror_info, [CRel 0, CRel 1] : List CoreTerm))
          ([9, 7, 0, 1, 1, 1, 0, 8, 7, 0, 0, 2, 0, 0, 0, 1] : List Nat))
    , MkPair String Bool "mirror/normalize-zero-fuel"
        (mirror_normal 0 mirror_constant_sig mirror_beta mirror_beta)
    , MkPair String Bool "mirror/normalize-beta-fuel-one"
        (mirror_normal 1 mirror_constant_sig mirror_beta (CConst 7))
    , MkPair String Bool "mirror/normalize-beta-fuel-two"
        (mirror_normal 2 mirror_constant_sig mirror_beta (CRel 2))
    , MkPair String Bool "mirror/normalize-unused-argument"
        (mirror_normal 2 mirror_constant_sig
          (CApp(CLam(CSort 0, CRel 1), CConst 7)) (CRel 0))
    , MkPair String Bool "mirror/normalize-stuck-application"
        (mirror_normal 2 mirror_constant_sig (CApp(CRel 0, CConst 7))
          (CApp(CRel 0, CRel 2)))
    , MkPair String Bool "mirror/normalize-fix-constructor"
        (mirror_normal 2 ([] : List Entry) (CApp(mirror_fix 0, CConstruct 7 0 0))
          (CConstruct 7 0 0))
    , MkPair String Bool "mirror/normalize-fix-stuck-recursive-argument"
        (mirror_normal 4 ([] : List Entry) (CApp(mirror_fix 0, CRel 0))
          (CApp(mirror_fix 0, CRel 0)))
    , MkPair String Bool "mirror/normalize-fix-missing-recursive-argument"
        (mirror_normal 4 ([] : List Entry) (CApp(mirror_fix 1, CConstruct 7 0 0))
          (CApp(mirror_fix 1, CConstruct 7 0 0)))
    , MkPair String Bool "mirror/normalize-case"
        (mirror_normal 8 ([] : List Entry)
          (CCase mirror_info (CSort 0) (CApp(CConstruct 7 0 0, CRel 3))
            ([CLam(CSort 0, CRel 0)] : List CoreTerm)) (CRel 3))
    , MkPair String Bool "mirror/normalize-case-mismatched-arity"
        (mirror_normal 8 ([] : List Entry)
          (mirror_case(mirror_info, [CRel 0] : List CoreTerm))
          (mirror_case(mirror_info, [CRel 0] : List CoreTerm)))
    ];

def main : IO Unit := precision_run "kernel-mirror" mirror_tests;
