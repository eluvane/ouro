-- Architecture reachability must preserve depth budgets and ordered witnesses.
-- @entry main

import "../../../tools/analyze/architecture.ouro";
import "../../../std/collections.ouro";
import "assertions.ouro";

def precision_arch_edge (span : Nat) (source : Nat) (target : Nat) : ArchEdge :=
    MkArchEdge span source target False False;

def precision_arch_path (expected : List Nat) (actual : Maybe (List Nat)) : Bool :=
    match actual with
    | Nothing => False
    | Just path => list_eq Nat eq_nat expected path
    end;

def precision_arch_absent (actual : Maybe (List Nat)) : Bool :=
    match actual with | Nothing => True | Just _ => False end;

def precision_arch_triangle : List ArchEdge :=
    [ precision_arch_edge 0 0 1
    , precision_arch_edge 1 1 2
    , precision_arch_edge 2 2 0
    ];

-- Each node imports its next two successors. The number of distinct paths
-- grows exponentially while the complete module/edge inventory stays small.
def precision_arch_dag (count : Nat) : List ArchEdge :=
    (fix go (left : Nat) (index : Nat) : List ArchEdge :=
      match left with
      | Z => Nil ArchEdge
      | S rest =>
          Cons ArchEdge (precision_arch_edge (mul 2 index) index (S index))
            (Cons ArchEdge (precision_arch_edge (S (mul 2 index)) index (S (S index)))
              (go rest (S index)))
      end) count Z;

def precision_arch_nodes (count : Nat) : List ArchNode :=
    (fix go (left : Nat) (index : Nat) : List ArchNode :=
      match left with
      | Z => Nil ArchNode
      | S rest => Cons ArchNode (MkArchNode index 0 False False False)
          (go rest (S index))
      end) count Z;

def precision_arch_tests : List (Pair String Bool) :=
    [ MkPair String Bool "ARCH001/good/empty-graph"
        (precision_arch_absent (arch_cycle_path 8 (Nil ArchEdge) (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/bad/self-loop"
        (precision_arch_path ([7, 7] : List Nat)
          (arch_cycle_path 1 ([precision_arch_edge 0 7 7] : List ArchEdge)
            (precision_arch_edge 0 7 7)))
    , MkPair String Bool "ARCH001/fuel/zero-cannot-close-self-loop"
        (precision_arch_absent (arch_cycle_path 0
          ([precision_arch_edge 0 7 7] : List ArchEdge) (precision_arch_edge 0 7 7)))
    , MkPair String Bool "ARCH001/bad/triangle-witness"
        (precision_arch_path ([0, 1, 2, 0] : List Nat)
          (arch_cycle_path 3 precision_arch_triangle (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/fuel/one-short"
        (precision_arch_absent
          (arch_cycle_path 2 precision_arch_triangle (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/bad/first-witness-follows-edge-order"
        (precision_arch_path ([0, 1, 2, 0] : List Nat)
          (arch_cycle_path 5 (append ArchEdge precision_arch_triangle
            ([precision_arch_edge 3 1 3, precision_arch_edge 4 3 0] : List ArchEdge))
            (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/bad/reordered-edges-reorder-first-witness"
        (precision_arch_path ([0, 1, 3, 0] : List Nat)
          (arch_cycle_path 5
            ([ precision_arch_edge 0 0 1, precision_arch_edge 3 1 3
             , precision_arch_edge 4 3 0, precision_arch_edge 1 1 2
             , precision_arch_edge 2 2 0 ] : List ArchEdge)
            (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/near-miss/import-into-a-separate-cycle"
        (precision_arch_absent (arch_cycle_path 6
          ([ precision_arch_edge 0 0 1, precision_arch_edge 1 1 2
           , precision_arch_edge 2 2 3, precision_arch_edge 3 3 2 ] : List ArchEdge)
          (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/bad/duplicate-edges-keep-distinct-spans"
        (list_eq Nat eq_nat ([10, 11, 12] : List Nat)
          (map ArchIssue Nat arch_issue_span (analyze_architecture 4 (precision_arch_nodes 2)
            ([ precision_arch_edge 10 0 1, precision_arch_edge 11 0 1
             , precision_arch_edge 12 1 0 ] : List ArchEdge))))
    , MkPair String Bool "ARCH001/near-miss/source-absent-from-nonempty-index"
        (precision_arch_absent
          (arch_cycle_path 8 precision_arch_triangle (precision_arch_edge 9 40 42)))
    , MkPair String Bool "ARCH001/good/shared-dag-does-not-enumerate-all-paths"
        (nullb ArchIssue (analyze_architecture 36 (precision_arch_nodes 34)
          (precision_arch_dag 32)))
    , MkPair String Bool "ARCH001/near-miss/shared-dag-with-disconnected-cycle"
        (precision_arch_absent (arch_cycle_path 40
          (append ArchEdge (precision_arch_dag 32)
            ([precision_arch_edge 64 40 41, precision_arch_edge 65 41 40] : List ArchEdge))
          (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/bad/shared-dag-with-return-edge"
        (precision_arch_path ([0, 1, 2, 3, 4, 5, 0] : List Nat)
          (arch_cycle_path 8
            (append ArchEdge (precision_arch_dag 5)
              ([precision_arch_edge 10 5 0] : List ArchEdge))
            (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH001/bad/late-return-after-dead-shared-dag"
        (precision_arch_path ([0, 1, 0] : List Nat)
          (arch_cycle_path 36
            (append ArchEdge (precision_arch_dag 32)
              ([precision_arch_edge 64 1 0] : List ArchEdge))
            (precision_arch_edge 0 0 1)))
    , MkPair String Bool "ARCH002-005/bad/noncycle-policy-issues-unchanged"
        (eq_nat 4 (length ArchIssue (analyze_architecture 4
          ([MkArchNode 0 0 False False True, MkArchNode 1 3 True True False] : List ArchNode)
          ([precision_arch_edge 0 0 1] : List ArchEdge))))
    ];

def main : IO Unit := precision_run "architecture" precision_arch_tests;
