-- Branch reachability keeps refinements, all scrutinees, and binder wildcards.
-- @entry main

import "../../../tools/analyze/families.ouro";
import "assertions.ouro";

def pattern_shadow (source : String) (expected : List String) : Bool :=
    precision_strings expected
      (map (Pair String Nat) String
        (fun (hit : Pair String Nat) =>
          match hit with | MkPair _ line => str_of_nat line end)
        (shadowed_in (map String (List Nat) str_codes (str_lines source))));

def pattern_tests : List (Pair String Bool) :=
    [ MkPair String Bool "DEAD001/good/multiple-entry-names"
        (precision_strings (["one", "two"] : List String)
          (tagged_names "-- @entry one two" "@entry"))
    , MkPair String Bool "DEAD001/good/entry-separators-and-repeated-tags"
        (precision_strings (["one", "two", "three", "four", "five"] : List String)
          (tagged_names "-- @entry one / two, three | four; @export api; @entry five" "@entry"))
    , MkPair String Bool "DEAD001/good/entry-stops-at-other-annotation"
        (precision_strings (["main"] : List String)
          (tagged_names "-- @entry main; @doc docs/quality.md" "@entry"))
    , MkPair String Bool "DEAD002/good/multiple-export-promises"
        (precision_strings (["first", "second"] : List String)
          (tagged_names "-- @export first second; @entry main" "@export"))
    , MkPair String Bool "DEAD005/good/third-scrutinee"
        (pattern_shadow "match a, b, c with\n| True, True, True => x\n| True, True, False => y\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/good/refined-constructors"
        (pattern_shadow "match x with\n| Wrap True => x\n| Wrap False => y\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/good/lowercase-constructor-heads"
        (pattern_shadow "match x with\n| left a => a\n| right b => b\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/bad/renamed-binders"
        (pattern_shadow "match x with\n| Cons a rest => x\n| Cons b tail => y\nend;"
          (["3"] : List String))
    , MkPair String Bool "DEAD005/bad/repeated-refinement"
        (pattern_shadow "match x with\n| Wrap True => x\n| Wrap True => y\nend;"
          (["3"] : List String))
    , MkPair String Bool "DEAD005/bad/broad-before-refined"
        (pattern_shadow "match x with\n| Wrap value => value\n| Wrap False => y\nend;"
          (["3"] : List String))
    , MkPair String Bool "DEAD005/good/refined-before-broad"
        (pattern_shadow "match x with\n| Wrap False => x\n| Wrap value => value\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/good/later-column-differs"
        (pattern_shadow "match a, b, c with\n| Cons x xs, True, True => x\n| Cons False ys, True, False => y\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/bad/parenthesized-field"
        (pattern_shadow "match x with\n| Wrap value => value\n| Wrap (Some (Some True)) => y\nend;"
          (["3"] : List String))
    , MkPair String Bool "DEAD005/good/parenthesized-refinements"
        (pattern_shadow "match x with\n| Wrap (Some True) => x\n| Wrap (Some False) => y\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/good/wildcard-keeps-columns"
        (pattern_shadow "match a, b with\n| Wrap value, True => value\n| Wrap False, False => y\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/bad/body-comma"
        (pattern_shadow "match x with\n| Yes => [Yes, No]\n| Yes => [No]\nend;"
          (["3"] : List String))
    , MkPair String Bool "DEAD005/good/separate-match-frames"
        (pattern_shadow "match x with\n| Yes => match y with\n| Yes => z\nend\n| No => w\nend;"
          ([] : List String))
    , MkPair String Bool "DEAD005/good/comment-and-string"
        (pattern_shadow "match x with\n| Yes => \"| Yes => match\"\n-- | Yes => ignored\n| No => y\nend;"
          ([] : List String))
    ];

def main : IO Unit := precision_run "deadcode-patterns" pattern_tests;
