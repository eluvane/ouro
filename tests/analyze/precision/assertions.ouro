-- Shared assertions for the native lint/analyzer/fmt/fix regressions.
-- An empty case set is a failure, not a vacuous successful suite.

import "../../../std/io.ouro";


def precision_strings : List String -> List String -> Bool :=
  fix precision_strings (left : List String) (right : List String) : Bool :=
    match left with
    | Nil => match right with | Nil => True | Cons _ _ => False end
    | Cons x xs =>
        match right with
        | Nil => False
        | Cons y ys =>
            match prim_string_eq x y with
            | True => precision_strings xs ys
            | False => False
            end
        end
    end;

def precision_report (ok : Bool) (row : Pair String Bool) : IO Bool :=
    match row with
    | MkPair name passed =>
        do match passed with
           | True => println (concat "PRECISION_OK " name)
           | False => eprintln (concat "PRECISION_FAIL " name)
           end;
           io_pure Bool (andb ok passed)
    end;

def precision_run (name : String) (rows : List (Pair String Bool)) : IO Unit :=
    match rows with
    | Nil => do eprintln (concat "PRECISION_FAIL empty suite: " name);
                exit (S Z)
    | Cons _ _ =>
        do let! ok := io_fold (Pair String Bool) Bool precision_report True rows;
           println (concat "PRECISION_SUITE " (concat name (concat " rows="
             (prim_string_of_nat (length (Pair String Bool) rows)))));
           exit (match ok with | True => Z | False => S Z end)
    end;
