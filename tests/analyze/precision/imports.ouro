-- Import facts preserve every operand, its source position, and per-edge markers.

import "../../../tools/analyze/extract.ouro",
  "assertions.ouro",
  "../../../compiler/base.ouro";

def precision_import_paths (rows : List ScannedImport) : List String :=
  map ScannedImport String
    (fun (row : ScannedImport) =>
      match row with | MkScannedImport path _ _ _ _ _ => path end)
    rows;

def precision_edge_paths (acc : FileAcc) : List String :=
  map AEdge String AEdge_target (reverse(AEdge, FileAcc_edges acc));

def precision_import_edge (edge : AEdge) (path : String) (line : Nat)
    (col : Nat) (layer : Bool) (trust : Bool) : Bool :=
  andb(str_eq(AEdge_target edge, path),
    andb(eq_nat(AEdge_line edge, line),
      andb(eq_nat(AEdge_col edge, col),
        andb(compiler_bool_equal(AEdge_allow_layer edge, layer),
          compiler_bool_equal(AEdge_allow_trust edge, trust)))));

def precision_grouped_edges : Bool :=
  match extract_file "fixtures/inner.ouro"
    "-- ouro-analyze:allow-layer-import reason=test\nimport \"first.ouro\", -- note\n  -- ouro-analyze:allow-trust-import reason=test\n  \"second.ouro\",\n  \"third.ouro\",;\n" with
  | Left _ => False
  | Right acc =>
      match reverse(AEdge, FileAcc_edges acc) with
      | Nil => False
      | Cons first rest => match rest with
        | Nil => False
        | Cons second rest2 => match rest2 with
          | Nil => False
          | Cons third rest3 =>
              andb(nullb AEdge rest3,
                andb(precision_import_edge first "fixtures/first.ouro" 2 7 True False,
                  andb(precision_import_edge second "fixtures/second.ouro" 4 2 False True,
                    precision_import_edge third "fixtures/third.ouro" 5 2 False False)))
          end
        end
      end
  end;

def precision_same_line_and_alias : Bool :=
  let source : String :=
    "import \"one.ouro\", \"two.ouro\",; import \"aliased.ouro\" as A;" in
  match scan_source_imports source with
  | Left _ => False
  | Right rows =>
      match rows with
      | Nil => False
      | Cons _ rest => match rest with
        | Nil => False
        | Cons _ rest2 => match rest2 with
          | Nil => False
          | Cons alias rest3 => match alias with
            | MkScannedImport _ maybe_name _ _ _ maybe_alias_byte =>
                match maybe_name with
                | Nothing => False
                | Just name => match maybe_alias_byte with
                  | Nothing => False
                  | Just _ =>
                      andb(nullb ScannedImport rest3,
                        andb(str_eq name "A",
                          precision_strings
                            (["one.ouro", "two.ouro", "aliased.ouro"] : List String)
                            (precision_import_paths rows)))
                  end
                end
            end
          end
        end
      end
  end;

def precision_unicode_and_escape : Bool :=
  match scan_source_imports
      "import \"café.ouro\", \"a\\\"b.ouro\", \"caf\\u{e9}.ouro\";" with
  | Left _ => False
  | Right rows =>
      precision_strings
        (["café.ouro", "a\"b.ouro", "café.ouro"] : List String)
        (precision_import_paths rows)
  end;

def precision_bad_unicode_escape : Bool :=
  match scan_source_imports "import \"\\u{110000}.ouro\";" with
  | Left _ => True
  | Right _ => False
  end;

def precision_literal_projection_comment : Bool :=
  match scan_source_imports
    "-- import \"comment.ouro\";\ndef s : String := \"import \\\"literal.ouro\\\";\";\nobject.import \"projection.ouro\";\nimport \"real.ouro\";" with
  | Left _ => False
  | Right rows =>
      precision_strings (["real.ouro"] : List String)
        (precision_import_paths rows)
  end;

def precision_later_missing_path : Bool :=
  match extract_file "fixtures/inner.ouro"
    "import \"present.ouro\", \"missing.ouro\";" with
  | Left _ => False
  | Right acc =>
      precision_strings
        (["fixtures/present.ouro", "fixtures/missing.ouro"] : List String)
        (precision_edge_paths acc)
  end;

def precision_bad_group_rejected : Bool :=
  match extract_file "fixtures/inner.ouro"
    "import \"first.ouro\", \"second.ouro\" as Bad;" with
  | Left _ => True
  | Right _ => False
  end;

def precision_import_tests : List (Pair String Bool) :=
  [ MkPair String Bool "imports/grouped/ordered-edges-and-markers" precision_grouped_edges
  , MkPair String Bool "imports/same-line/alias-separate" precision_same_line_and_alias
  , MkPair String Bool "imports/quoted/unicode-and-escape" precision_unicode_and_escape
  , MkPair String Bool "imports/quoted/bad-unicode-escape-fails" precision_bad_unicode_escape
  , MkPair String Bool "imports/lexical/no-comment-literal-or-projection" precision_literal_projection_comment
  , MkPair String Bool "imports/unresolved/later-target-retained" precision_later_missing_path
  , MkPair String Bool "imports/malformed/fails-closed" precision_bad_group_rejected
  ];

def main : IO Unit := precision_run "imports" precision_import_tests;
