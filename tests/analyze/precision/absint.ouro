-- Bad, good and false-positive cases for OURO-ABS001/002/003. These exercise
-- the native core directly, including AST scopes not expressible in one
-- small surface fixture. IDs below deliberately model interned spellings.

-- @entry main

import "../../../tools/analyze/absint.ouro",
  "../../../tools/analyze/expr_adapt.ouro",
  "../../../std/stringx.ouro",
  "assertions.ouro";

def precision_abs_ids : AbsIds := MkAbsIds([1] : List Nat, [2] : List Nat, [3] : List Nat);
def precision_abs_type : Ast := ASort Z;
def precision_abs_zero : Ast := ANatLit Z;
def precision_abs_one : Ast := ANatLit (S Z);

def precision_abs_div (denominator : Ast) : Ast :=
    AApp(AApp(AVar 3, precision_abs_one), denominator);

def precision_abs_outer (body : Ast) : Ast :=
    ALet 10 precision_abs_type precision_abs_zero body;

def precision_abs_joined (left : Ast) (right : Ast) : Ast :=
    AMatch (AVar 90)
      (ABranch(40, [] : List Nat, left, ABranch 41 ([] : List Nat) right ANoBranch));

def precision_abs_code (issue : AbsIssue) : String :=
    match issue with
    | IDivZero id => str_concat("OURO-ABS001:", show_nat id)
    | IEmptyList id => str_concat("OURO-ABS002:", show_nat id)
    | IAssertPos id => str_concat("OURO-ABS003:", show_nat id)
    end;

def precision_abs_case (name : String) (asserted : Bool) (body : Ast)
    (expected : List String) : Pair String Bool :=
    MkPair String Bool name
      (precision_strings expected
        (map AbsIssue String precision_abs_code
          (analyze_absint precision_abs_ids asserted 100 body)));

def precision_abs_cases : List (Pair String Bool) :=
    [ precision_abs_case "ABS001/bad/literal-zero" False
        (precision_abs_div precision_abs_zero) (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/good/positive-divisor" False
        (precision_abs_div precision_abs_one) ([] : List String)
    , precision_abs_case "ABS001/fp/third-argument-is-not-divisor" False
        (AApp(precision_abs_div precision_abs_one, precision_abs_zero)) ([] : List String)
    , precision_abs_case "ABS001/fp/partial-application" False
        (AApp(AVar 3, precision_abs_zero)) ([] : List String)
    , precision_abs_case "ABS001/bad/ascribed-callee" False
        (AApp (AApp(AAscribe(AVar 3, precision_abs_type), precision_abs_one))
          precision_abs_zero) (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/bad/ascribed-partial-spine" False
        (AApp (AAscribe(AApp(AVar 3, precision_abs_one), precision_abs_type))
          precision_abs_zero) (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/fp/lambda-shadows-let" False
        (precision_abs_outer
          (ALam 10 precision_abs_type (precision_abs_div (AVar 10)))) ([] : List String)
    , precision_abs_case "ABS001/fp/pi-shadows-let" False
        (precision_abs_outer
          (APi 10 precision_abs_type (precision_abs_div (AVar 10)))) ([] : List String)
    , precision_abs_case "ABS001/fp/sequential-telescope" False
        (precision_abs_outer (ABinder 10 precision_abs_type
          (ABinder 11 (precision_abs_div (AVar 10)) ANoBinder))) ([] : List String)
    , precision_abs_case "ABS001/bad/annotation-precedes-binding" False
        (precision_abs_outer
          (ABinder 10 (precision_abs_div (AVar 10)) ANoBinder)) (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/fp/fix-parameter-shadows-let" False
        (precision_abs_outer (AFix 12 (ABinder 10 precision_abs_type ANoBinder)
          precision_abs_type (precision_abs_div (AVar 10)))) ([] : List String)
    , precision_abs_case "ABS001/fp/recursive-name-is-not-primitive" False
        (AFix 3 ANoBinder precision_abs_type (precision_abs_div precision_abs_zero)) ([] : List String)
    , precision_abs_case "ABS001/fp/local-callee" False
        (ALet(3, precision_abs_type, AVar 90, precision_abs_div precision_abs_zero)) ([] : List String)
    , precision_abs_case "ABS001/fp/parameter-callee" False
        (ALam 3 precision_abs_type (precision_abs_div precision_abs_zero)) ([] : List String)
    , precision_abs_case "ABS001/fp/pattern-binder" False
        (precision_abs_outer (AMatch (AVar 90)
          (ABranch(40, [10] : List Nat, precision_abs_div (AVar 10), ANoBranch)))) ([] : List String)
    , precision_abs_case "ABS001/bad/sibling-arm-restores-outer-fact" False
        (precision_abs_outer (AMatch (AVar 90)
          (ABranch 40 ([10] : List Nat) (precision_abs_div (AVar 10))
            (ABranch(41, [] : List Nat, precision_abs_div (AVar 10), ANoBranch))))) (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/fp/effect-clause-binder" False
        (precision_abs_outer
          (AClause(50, [10] : List Nat, precision_abs_div (AVar 10), ANoClause))) ([] : List String)
    , precision_abs_case "ABS001/bad/sibling-clause-restores-outer-fact" False
        (precision_abs_outer
          (AClause 50 ([10] : List Nat) (precision_abs_div (AVar 10))
            (AClause(51, [] : List Nat, precision_abs_div (AVar 10), ANoClause)))) (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/bad/let-rhs-sees-outer-binding" False
        (precision_abs_outer (ALet 10 precision_abs_type
          (precision_abs_div (AVar 10)) precision_abs_one)) (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/good/inner-positive-let" False
        (precision_abs_outer (ALet 10 precision_abs_type precision_abs_one
          (precision_abs_div (AVar 10)))) ([] : List String)
    , precision_abs_case "ABS001/bad/agreeing-zero-branches" False
        (precision_abs_div (precision_abs_joined(precision_abs_zero, AVar 1)))
        (["OURO-ABS001:3"] : List String)
    , precision_abs_case "ABS001/good/agreeing-positive-branches" False
        (precision_abs_div (precision_abs_joined(precision_abs_one, ANatLit 2))) ([] : List String)
    , precision_abs_case "ABS001/fp/disagreeing-branches-are-unknown" False
        (precision_abs_div (precision_abs_joined precision_abs_zero precision_abs_one)) ([] : List String)
    , precision_abs_case "ABS001/fp/unknown-arm-prevents-proof" False
        (precision_abs_div (precision_abs_joined(precision_abs_zero, AVar 90))) ([] : List String)
    , precision_abs_case "ABS001/fp/empty-match-is-unknown" False
        (precision_abs_div (AMatch(AVar 90, ANoBranch))) ([] : List String)
    , precision_abs_case "ABS001/fp/branch-binder-masks-constructor-default" False
        (precision_abs_div (AMatch(AVar 90, ABranch(40, [1] : List Nat, AVar 1, ANoBranch)))) ([] : List String)
    , precision_abs_case "ABS002/bad/proven-dead-positive-arm" False
        (AMatch(precision_abs_zero, ABranch 2 ([11] : List Nat) precision_abs_one ANoBranch))
        (["OURO-ABS002:2"] : List String)
    , precision_abs_case "ABS002/good/positive-arm-is-possible" False
        (AMatch(precision_abs_one, ABranch 2 ([11] : List Nat) precision_abs_one ANoBranch)) ([] : List String)
    , precision_abs_case "ABS002/fp/shadowed-scrutinee" False
        (precision_abs_outer (ALam 10 precision_abs_type
          (AMatch(AVar 10, ABranch 2 ([11] : List Nat) precision_abs_one ANoBranch)))) ([] : List String)
    , precision_abs_case "ABS003/bad/zero-result-contract" True
        precision_abs_zero (["OURO-ABS003:100"] : List String)
    , precision_abs_case "ABS003/good/positive-result-contract" True precision_abs_one ([] : List String)
    , precision_abs_case "ABS003/fp/parameter-named-like-zero-constructor" True
        (ALam 1 precision_abs_type (AVar 1)) ([] : List String)
    , precision_abs_case "ABS003/bad/contract-through-agreeing-branches" True
        (precision_abs_joined precision_abs_zero precision_abs_zero) (["OURO-ABS003:100"] : List String)
    , precision_abs_case "ABS003/bad/spread-empty-tail-is-empty" True
        (adapt (EListSpread (Nil Expr) (EList (Nil Expr))))
        (["OURO-ABS003:100"] : List String)
    , precision_abs_case "ABS003/good/spread-nonempty-tail-is-nonempty" True
        (adapt (EListSpread (Nil Expr) (EList [ENat 1]))) ([] : List String)
    , precision_abs_case "ABS003/fp/spread-unknown-tail-remains-unknown" True
        (adapt (EListSpread (Nil Expr) (EVar 90))) ([] : List String)
    , precision_abs_case "ABS003/good/spread-prefix-proves-nonempty" True
        (adapt (EListSpread [ENat 1] (EVar 90))) ([] : List String)
    , MkPair String Bool "adapter/list-spread-keeps-distinct-tag"
        (eq_nat (ast_tag (adapt (EListSpread (Nil Expr) (EList (Nil Expr)))))
          tag_list_spread)
    ];

def main : IO Unit := precision_run "absint" precision_abs_cases;
