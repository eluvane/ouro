-- @entry main
import "../../../tools/analyze/bounded_report.ouro",
  "assertions.ouro";

def precision_report_expected : BoundedDriveExpected :=
    MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Nothing String);

def precision_report_observed (files : Nat) (found : Nat) (rejected : Nat) (families : String)
    (findings : List String) (rejections : List String) (extra_out : Bool) (extra_err : Bool)
    (code : String) : BoundedDriveObserved :=
    MkBoundedDriveObserved [MkBoundedDriveBanner (str_of_nat files) (str_of_nat found)
      (str_of_nat rejected) families]
      findings rejections extra_out extra_err code;

def precision_report_clean : BoundedDriveObserved :=
    precision_report_observed 1 0 0 "dataflow" [] [] False False "0";

def precision_report_error (expected : BoundedDriveExpected) (observed : BoundedDriveObserved)
    (message : String) : Bool :=
    match bounded_drive_verify expected observed with
    | Right _ => False
    | Left error => str_eq (bounded_drive_error_message error) message
    end;

def precision_report_accept (expected : BoundedDriveExpected) (observed : BoundedDriveObserved)
    (want_files : Nat) (want_found : Nat) (want_rejected : Nat) (want_families : String) : Bool :=
    match bounded_drive_verify expected observed with
    | Left _ => False
    | Right banner => let (MkBoundedDriveBanner files found rejected families) := banner in
        andb(str_eq files (str_of_nat want_files), andb(str_eq found (str_of_nat want_found),
          andb(str_eq rejected (str_of_nat want_rejected), str_eq families want_families)))
    end;

def precision_report_wire (extra : List (Pair String Json)) : Json :=
    JObj (append (Pair String Json)
      [ MkPair String Json "kind" (JStr "ouro.analyze-bounded-report-request.v1")
      , MkPair String Json "mode" (JStr "verify")
      , MkPair String Json "expected" (JObj
          [ MkPair String Json "files" (JStr "1")
          , MkPair String Json "families" (JStr "dataflow")
          , MkPair String Json "path" JNull ])
      , MkPair String Json "banners" (JArr
          [bounded_report_banner_json (MkBoundedDriveBanner "1" "0" "0" "dataflow")])
      , MkPair String Json "finding_paths" (JArr [])
      , MkPair String Json "rejection_paths" (JArr [])
      , MkPair String Json "stdout_unreported" (JBool False)
      , MkPair String Json "stderr_unexpected" (JBool False)
      , MkPair String Json "exit" (JStr "0")
      , MkPair String Json "family_metadata" JNull ] extra);

def precision_report_wire_bad_field (key : String) (value : Json) : Json :=
    if let JObj fields := (precision_report_wire [] : Json) then
      JObj (map (Pair String Json) (Pair String Json)
        (fun (field : Pair String Json) => let (MkPair name original) := field in
          MkPair String Json name (if str_eq name key then value else original)) fields)
    else JNull;

def precision_report_wire_rejected (value : Json) : Bool :=
    match bounded_report_decode value with | Nothing => True | Just _ => False end;

def precision_report_wire_accept : Bool :=
    match bounded_report_decode (precision_report_wire []) with
    | Nothing => False
    | Just request => let (MkPair response code) := bounded_report_result request in
        andb(eq_nat code Z, match jsonx_get_string response "error" with
          | Nothing => False | Just message => str_eq message "" end)
    end;

def precision_report_large_count : String := str_concat "1" (str_repeat "0" 1001);

def precision_report_large_banner : BoundedDriveBanner :=
    MkBoundedDriveBanner precision_report_large_count "0" "0" "dataflow";

def precision_report_count_rejected (value : Json) : Bool :=
    match bounded_report_decode_count (JObj [MkPair String Json "files" value]) "files" with
    | Nothing => True | Just _ => False
    end;

def precision_report_rows : List (Pair String Bool) :=
  [ MkPair String Bool "report/clean/summary-retained"
      (precision_report_accept precision_report_expected precision_report_clean 1 0 0 "dataflow")
  , MkPair String Bool "report/findings/unicode-and-colon-path"
      (precision_report_accept
        (MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String "C:/каталог/漢字 file.ouro"))
        (precision_report_observed 1 1 0 "dataflow" ["C:/каталог/漢字 file.ouro"] [] False False "1")
        1 1 0 "dataflow")
  , MkPair String Bool "report/rejection/nonzero-summary"
      (precision_report_accept precision_report_expected
        (precision_report_observed 1 0 1 "dataflow" [] ["std/io.ouro"] False False "1") 1 0 1 "dataflow")
  , MkPair String Bool "report/aggregate/optional-expectations"
      (precision_report_accept (MkBoundedDriveExpected (Nothing String) (Nothing String) (Nothing String))
        (precision_report_observed 3 2 1 "dataflow,effects" ["a", "b"] ["c"] False False "1")
        3 2 1 "dataflow,effects")
  , MkPair String Bool "report/malformed/missing-before-everything"
      (precision_report_error precision_report_expected (MkBoundedDriveObserved [] [] [] True True "137")
        "missing, malformed or repeated structured completion report")
  , MkPair String Bool "report/malformed/repeated"
      (precision_report_error precision_report_expected
        (MkBoundedDriveObserved [MkBoundedDriveBanner "1" "0" "0" "dataflow", MkBoundedDriveBanner "1" "0" "0" "dataflow"]
          [] [] False False "0") "missing, malformed or repeated structured completion report")
  , MkPair String Bool "report/malformed/duplicate-families"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 0 0 "dataflow,dataflow" [] [] False False "0")
        "missing, malformed or repeated structured completion report")
  , MkPair String Bool "report/malformed/empty-family"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 0 0 "" [] [] False False "0")
        "missing, malformed or repeated structured completion report")
  , MkPair String Bool "report/files/zero-before-family-and-exit"
      (precision_report_error precision_report_expected
        (precision_report_observed 0 0 0 "effects" [] [] True True "137")
        "structured report omitted or duplicated requested files")
  , MkPair String Bool "report/files/wrong-request-count"
      (precision_report_error precision_report_expected
        (precision_report_observed 2 0 0 "dataflow" [] [] False False "0")
        "structured report omitted or duplicated requested files")
  , MkPair String Bool "report/files/negative-expectation-keeps-priority"
      (precision_report_error (MkBoundedDriveExpected (Just String "-1") (Just String "effects") (Nothing String))
        precision_report_clean "structured report omitted or duplicated requested files")
  , MkPair String Bool "report/families/ordered-exact-list"
      (precision_report_error (MkBoundedDriveExpected (Just String "1") (Just String "effects,dataflow") (Nothing String))
        (precision_report_observed 1 0 0 "dataflow,effects" [] [] True True "137")
        "structured report did not run the requested families")
  , MkPair String Bool "report/counts/missing-finding-before-stderr"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 1 0 "dataflow" [] [] True True "1")
        "structured diagnostic counts disagree with the completion report")
  , MkPair String Bool "report/counts/missing-rejection"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 0 1 "dataflow" [] [] False False "1")
        "structured diagnostic counts disagree with the completion report")
  , MkPair String Bool "report/rejected/duplicate-paths"
      (precision_report_error (MkBoundedDriveExpected (Nothing String) (Nothing String) (Nothing String))
        (precision_report_observed 2 0 2 "dataflow" [] ["a", "a"] False False "1")
        "structured report has duplicate or excess rejected files")
  , MkPair String Bool "report/rejected/excess-before-unrequested-path"
      (precision_report_error (MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String "wanted"))
        (precision_report_observed 1 0 2 "dataflow" [] ["a", "b"] True True "1")
        "structured report has duplicate or excess rejected files")
  , MkPair String Bool "report/path/unrequested-before-stderr"
      (precision_report_error (MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String "wanted"))
        (precision_report_observed 1 1 0 "dataflow" ["other"] [] True True "1")
        "structured diagnostic names an unrequested file")
  , MkPair String Bool "report/stderr/before-stdout-and-exit"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 0 0 "dataflow" [] [] True True "137")
        "structured worker emitted an unexpected error")
  , MkPair String Bool "report/stdout/before-exit"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 0 0 "dataflow" [] [] True False "137")
        "structured worker emitted unreported output")
  , MkPair String Bool "report/exit/nonzero-clean"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 0 0 "dataflow" [] [] False False "1")
        "structured exit code disagrees with the completion report")
  , MkPair String Bool "report/exit/negative-completed-status"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 0 0 "dataflow" [] [] False False "-9")
        "structured exit code disagrees with the completion report")
  , MkPair String Bool "report/exit/zero-with-findings"
      (precision_report_error precision_report_expected
        (precision_report_observed 1 1 0 "dataflow" ["a"] [] False False "0")
        "structured exit code disagrees with the completion report")
  , MkPair String Bool "report/metadata/duplicate-families-rejected"
      (match bounded_drive_selected_families (Just String "dataflow,dataflow") "0" False with
       | Nothing => True | Just _ => False end)
  , MkPair String Bool "report/metadata/stderr-rejected"
      (match bounded_drive_selected_families (Just String "dataflow") "0" True with
       | Nothing => True | Just _ => False end)
  , MkPair String Bool "report/banner/zero-is-parsed-before-verification"
      (match bounded_drive_banner [MkBoundedDriveBanner "0" "0" "0" "dataflow"] with
       | Left _ => False | Right _ => True end)
  , MkPair String Bool "report/wire/valid-provider" precision_report_wire_accept
  , MkPair String Bool "report/wire/duplicate-key-rejected"
      (precision_report_wire_rejected (precision_report_wire [MkPair String Json "exit" (JStr "0")]))
  , MkPair String Bool "report/wire/unknown-key-rejected"
      (precision_report_wire_rejected (precision_report_wire [MkPair String Json "surprise" JNull]))
  , MkPair String Bool "report/wire/missing-fields-rejected"
      (precision_report_wire_rejected (JObj []))
  , MkPair String Bool "report/wire/wrong-array-type-rejected"
      (precision_report_wire_rejected (precision_report_wire_bad_field "finding_paths" (JBool False)))
  , MkPair String Bool "report/wire/wrong-bool-type-rejected"
      (precision_report_wire_rejected (precision_report_wire_bad_field "stderr_unexpected" (JStr "false")))
  , MkPair String Bool "report/wire/wrong-mode-rejected"
      (precision_report_wire_rejected (precision_report_wire_bad_field "mode" (JStr "unknown")))
  , MkPair String Bool "report/wire/wrong-exit-type-rejected"
      (precision_report_wire_rejected (precision_report_wire_bad_field "exit" (JNum "0")))
  , MkPair String Bool "report/wire/1002-digit-count-preserved-as-text"
      (match bounded_report_decode_count
        (JObj [MkPair String Json "files" (JStr precision_report_large_count)]) "files" with
       | Nothing => False | Just count => str_eq count precision_report_large_count end)
  , MkPair String Bool "report/banner/1002-digit-count-preserved"
      (match bounded_drive_banner [precision_report_large_banner] with
       | Left _ => False
       | Right banner => let (MkBoundedDriveBanner files _ _ _) := banner in
           str_eq files precision_report_large_count
       end)
  , MkPair String Bool "report/files/1002-digit-count-keeps-branch-two"
      (precision_report_error precision_report_expected
        (MkBoundedDriveObserved [precision_report_large_banner] [] [] True True "137")
        "structured report omitted or duplicated requested files")
  , MkPair String Bool "report/wire/noncanonical-decimal-text-rejected"
      (all String (fun (count : String) => precision_report_count_rejected (JStr count))
        ["01", "-1", "+1", " 1 ", "1.0", "", "١"])
  , MkPair String Bool "report/wire/numeric-count-rejected"
      (precision_report_count_rejected (JNum "1"))
  , MkPair String Bool "report/counts/decimal-order-by-length-then-digits"
      (andb(bounded_drive_count_le "9" "10",
        andb(notb (bounded_drive_count_le "10" "9"),
          andb(bounded_drive_count_le "11" "19",
            andb(notb (bounded_drive_count_le "19" "11"), bounded_drive_count_le "10" "10")))))
  ];

def main : IO Unit := precision_run "bounded-report" precision_report_rows;
