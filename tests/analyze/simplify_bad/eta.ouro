inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def pred (n : Nat) : Nat := n;

def map (A : Type) (B : Type) (f : A -> B) (xs : List A) : List B := Nil B;

-- The lambda only forwards its argument to `pred`.
-- @entry main
def main (xs : List Nat) : List Nat :=
  map Nat Nat (fun (x : Nat) => pred x) xs;
