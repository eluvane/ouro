inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Maybe (A : Type) : Type :=
  | Nothing : Maybe A
  | Just : A -> Maybe A;

-- Both arms evaluate to the same value.
-- @entry main
def main (n : Nat) : Nat :=
  match n with
  | Z => S Z
  | S _ => S Z
  end;

-- Every arm rebuilds the constructor it matched over its own binders.
def copy (m : Maybe Nat) : Maybe Nat :=
  match m with
  | Nothing => Nothing Nat
  | Just x => Just Nat x
  end;
