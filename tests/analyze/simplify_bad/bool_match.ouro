inductive Bool : Type :=
  | True : Bool
  | False : Bool;

-- The negation itself is the one place the shape belongs.
def notb (b : Bool) : Bool :=
  match b with
  | True => False
  | False => True
  end;

-- Each arm returns its own constructor.
-- @entry main
def main (b : Bool) : Bool :=
  match b with
  | True => True
  | False => False
  end;

-- Each arm returns the other constructor.
def flip (b : Bool) : Bool :=
  match b with
  | True => False
  | False => True
  end;
