inductive Bool : Type :=
  | True : Bool
  | False : Bool;

def notb (b : Bool) : Bool :=
  match b with
  | True => False
  | False => True
  end;

def andb (a : Bool) (b : Bool) : Bool :=
  match a with
  | True => b
  | False => False
  end;

-- Two negations cancel.
-- @entry main
def main (b : Bool) : Bool := notb (notb b);

-- andb with True is its other operand.
def padded (b : Bool) : Bool := andb b True;
