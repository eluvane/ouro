inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Shape : Type :=
  | Circle : Shape
  | Square : Shape;

-- Discards that are never read.
-- @entry main
def main (_unused : Nat) (n : Nat) : Nat := n;

def first : Nat -> Nat -> Nat :=
  fix first (n : Nat) (_acc : Nat) : Nat :=
    match n with
    | Z => Z
    | S k => first k k
    end;

-- The pattern discard is never read.
def head_or_zero (m : Nat) : Nat :=
  match m with
  | Z => Z
  | S _k => S Z
  end;

-- Types and type families carry a capital.
def Pair : Type := Nat;

def Vec (n : Nat) : Type := Nat;

-- `Type_field` is the projection convention, so the capital is the type's.
inductive Point : Type :=
  | MkPoint : Nat -> Nat -> Point;

def Point_x (p : Point) : Nat :=
  match p with
  | MkPoint x _ => x
  end;

-- Two characters are a name.
def id2 (n : Nat) : Nat := n;

def is_round (s : Shape) : Bool :=
  match s with
  | Circle => True
  | Square => False
  end;
