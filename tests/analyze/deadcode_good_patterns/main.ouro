-- @entry main another_entry
inductive Bool : Type := | True : Bool | False : Bool;
inductive Wrapped : Type := | Wrap : Bool -> Wrapped;

def choose (x : Wrapped) : Bool :=
    match x with
    | Wrap True => True
    | Wrap False => False
    end;

def or_three (a : Bool) (b : Bool) (c : Bool) : Bool :=
    match a, b, c with
    | True, True, True => True
    | True, True, False => True
    | True, False, True => True
    | True, False, False => True
    | False, True, True => True
    | False, True, False => True
    | False, False, True => True
    | False, False, False => False
    end;

def another_entry : Bool := False;

def main : Bool :=
    match or_three True False True with
    | True => choose (Wrap True)
    | False => choose (Wrap False)
    end;
