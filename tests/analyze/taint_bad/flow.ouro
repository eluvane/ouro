-- A marked source reaching a marked sink directly and through a let.
-- ouro-analyze:source=user_input
-- ouro-analyze:sink=eval
inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

def user_input : Nat := Z;

def eval (n : Nat) : Nat := n;

-- @entry main
def main : Nat := eval user_input;

def via_let : Nat := let raw : Nat := user_input in eval raw;
