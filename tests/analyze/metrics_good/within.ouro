inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Pair : Type :=
  | MkPair : Nat -> Nat -> Pair;

-- A claim that holds, with both operators.
-- @bound(nodes <= 64)
-- @bound(cyclo < 8)
-- @entry main
def main (n : Nat) : Bool :=
  match n with
  | Z => True
  | S _ => False
  end;

def add (a : Nat) (b : Nat) : Nat := a;

-- Minimal as claimed: the match binds, the let computes, no holes.
-- @minimal
def first (p : Pair) : Nat :=
  let two : Nat := S (S Z) in
  match p with
  | MkPair a _ => add a two
  end;

-- Wide but flat: a two-arm match is far below both complexity limits.
def flip (b : Bool) : Bool :=
  match b with
  | True => False
  | False => True
  end;

-- Several claims and a tooling tag on one comment line are separate
-- annotations; every claim holds and the body is minimal.
-- @bound(nodes <= 16) @bound(cyclo <= 4) @minimal
def negate (b : Bool) : Bool :=
  match b with
  | True => False
  | False => True
  end;
