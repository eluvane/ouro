inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

def add (a : Nat) (b : Nat) : Nat := a;

def apply3 (f : Nat -> Nat -> Nat -> Nat) : Nat := f Z Z Z;

-- Discarded parameters are not an odd identity.
def const3 (_a : Nat) (_b : Nat) (_c : Nat) : Nat := Z;

-- A definition whose whole body is a literal names it.
def answer : Nat := 42;
def page : Nat := 256;

-- Literals up to the threshold are not magic.
def small (n : Nat) : Nat := add n 10;

-- A four-parameter telescope is a signature, not lambda nesting.
def wide (a : Nat) (b : Nat) (c : Nat) (d : Nat) : Nat := add (add a b) (add c d);

-- Three nested lambdas inside the body are within the limit.
def curried (seed : Nat) : Nat :=
  apply3 (fun (a : Nat) => fun (b : Nat) => fun (c : Nat) => add seed a);

-- Both constructors covered: a total predicate.
def is_zero (n : Nat) : Bool :=
  match n with
  | Z => True
  | S _ => False
  end;

-- An application spine is an ordinary scrutinee.
-- @entry main
def main (n : Nat) : Bool :=
  match add n (S Z) with
  | Z => False
  | S _ => True
  end;
