-- Pipeline bad: non-trivial exact normalized bodies, and bodies that differ
-- only in literals.

def clone_a : Nat := add (add (add (add (add Z Z) Z) Z) Z) Z;
def clone_b : Nat := add (add (add (add (add Z Z) Z) Z) Z) Z;

def near_a (n : Nat) : Nat :=
  (fix go (k : Nat) : Nat :=
    match k with
    | Z => add (add (add (add 1 2) 3) 4) 5
    | S rest => add (add (add rest 2) 3) 4
    end) n;

def near_b (n : Nat) : Nat :=
  (fix go (k : Nat) : Nat :=
    match k with
    | Z => add (add (add (add 1 2) 3) 4) 5
    | S rest => add (add (add rest 2) 3) 7
    end) n;
