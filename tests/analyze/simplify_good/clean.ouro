inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Maybe (A : Type) : Type :=
  | Nothing : Maybe A
  | Just : A -> Maybe A;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

-- The negation is defined by the negating match.
def notb (b : Bool) : Bool :=
  match b with
  | True => False
  | False => True
  end;

def andb (a : Bool) (b : Bool) : Bool :=
  match a with
  | True => b
  | False => False
  end;

def add (a : Nat) (b : Nat) : Nat := a;

def map (A : Type) (B : Type) (f : A -> B) (xs : List A) : List B := Nil B;

-- A Bool match whose arms compute something.
-- @entry main
def main (b : Bool) (n : Nat) : Nat :=
  match b with
  | True => S n
  | False => n
  end;

-- Arms differ.
def step (n : Nat) : Nat :=
  match n with
  | Z => S Z
  | S k => k
  end;

-- The trees agree but the second arm reads its own binder, which is a
-- different variable from the parameter.
def pick (x : Nat) (m : Maybe Nat) : Nat :=
  match m with
  | Nothing => S x
  | Just x => S x
  end;

-- A single arm is not a set of identical arms.
def only (n : Nat) : Nat :=
  match n with
  | Z => Z
  end;

-- The arm changes the payload, so it is not a rewrap.
def bump (m : Maybe Nat) : Maybe Nat :=
  match m with
  | Nothing => Nothing Nat
  | Just x => Just Nat (S x)
  end;

-- The lambda reorders its argument and reads it twice.
def twice (one : Nat) (xs : List Nat) : List Nat :=
  map Nat Nat (fun (x : Nat) => add x one) (map Nat Nat (fun (x : Nat) => add x x) xs);

-- Constructor eta is the house style for map over an inductive.
def succs (xs : List Nat) : List Nat :=
  map Nat Nat (fun (x : Nat) => S x) xs;

def sum (xs : List Nat) : Nat := Z;

-- Forwarding to the enclosing fix keeps the recursive name applied.
def grow : Nat -> Nat -> Nat :=
  fix grow (n : Nat) (m : Nat) : Nat :=
    match n with
    | Z => m
    | S k => sum (map Nat Nat (fun (y : Nat) => grow k y) (Cons Nat m (Nil Nat)))
    end;

-- One negation over a compound.
def neither (a : Bool) (b : Bool) : Bool := notb (andb a b);

-- Both operands are variables.
def both (a : Bool) (b : Bool) : Bool := andb a b;
