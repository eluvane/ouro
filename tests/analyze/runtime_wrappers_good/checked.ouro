-- Checked wrappers stay available outside primitive-owning modules.
def rename : String -> String -> IO (Either FsError Unit) := fs_rename_checked;
def run : String -> List String -> IO (Either ProcessError ProcResult) := process_run_checked;
def request : String -> List (Pair String String) -> String -> IO HttpResp := http_post;
def bounded : ProcessCaptureLimits -> String -> List String -> IO (Either ProcessCaptureError ProcessCaptureResult) := process_run_captured_bounded;
def bounded_input : ProcessCaptureLimits -> String -> List String -> String -> IO (Either ProcessCaptureError ProcessCaptureResult) := process_run_captured_bounded_with_input;
def bounded_spec : ProcessCaptureLimits -> CommandSpec -> IO (Either ProcessCaptureError ProcessCaptureResult) := process_run_spec_captured_bounded;
def bounded_spec_input : ProcessCaptureLimits -> CommandSpec -> String -> IO (Either ProcessCaptureError ProcessCaptureResult) := process_run_spec_captured_bounded_with_input;
