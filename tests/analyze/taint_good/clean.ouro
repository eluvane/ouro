-- Source, sink and secret all present, none connected: the source never
-- reaches the sink and the secret is only read by a private definition.
-- ouro-analyze:source=user_input
-- ouro-analyze:sink=eval
-- ouro-analyze:secret=api_key
inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

def user_input : Nat := Z;

def api_key : Nat := S Z;

def eval (n : Nat) : Nat := n;

def echo : Nat := user_input;

def key_len : Nat := api_key;

-- @entry main
def main : Nat := eval (S Z);
