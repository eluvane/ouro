-- ouro-analyze:layer=0 trusted=true
-- ouro-analyze:source=raw_input
-- Trusted definitions whose effect and taint-source use carry a reviewed
-- allowance.
effect Log where
  | write : Nat -> Nat

def raw_input : Nat := Z;

-- @trust-reviewed audit log write is reviewed
def check_term : Nat := perform write

-- @trust-reviewed raw input is validated by the caller
def check_input : Nat := raw_input;
