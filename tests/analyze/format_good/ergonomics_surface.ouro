-- Analyzer/format good fixture: active ergonomics syntax should not trigger
-- source-format diagnostics.

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

inductive Unit : Type :=
  | MkUnit : Unit;

axiom IO : Type -> Type;
axiom io_bind : (A : Type) -> (B : Type) -> IO A -> (A -> IO B) -> IO B;
axiom readNat : IO Nat;
axiom writeNat : Nat -> IO Unit;

def xs : List Nat := [Z, S Z];
def two : Nat := Z |> S |> S;

def main : IO Unit :=
  do let! n := readNat;
     writeNat (n |> S)
