-- Contracts that read as written: text on every clause, one copy each, the
-- annotation directly above its definition, and tooling tags left alone.
-- @property contracts

effect Console where
  | write : Nat -> Nat

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

-- @requires n is nonzero
-- @ensures result is positive
-- @modifies nothing
-- @invariant n stays fixed
-- @pure
-- @entry main
def main (n : Nat) : Nat := S n;

-- @requires n is small
-- @requires acc fits
-- @doc two distinct requires clauses are not duplicates
-- @bound(nodes <= 64)
-- @export add
def add (n : Nat) (acc : Nat) : Nat := acc;

-- Not public, so the file-level contracts policy does not apply.
def echo : Nat := perform write

-- Prose that mentions a tag mid-sentence, like this note on how a @pure
-- definition is checked, is documentation and never an orphan annotation.

def documented : Nat := Z;
