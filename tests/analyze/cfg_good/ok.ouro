inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Pair : Type :=
  | MkPair : Nat -> Nat -> Pair;

inductive Eq (A : Type) (x : A) : A -> Type :=
  | refl : Eq A x x;

inductive Empty : Type := ;

inductive List : Type :=
  | Nil : List
  | Cons : Nat -> List -> List;

-- @entry main
def main (value : Bool) : Bool :=
  match value with
  | True => False
  | False => True
  end;

-- A one-arm match that binds fields is a destructuring, not a trivial match.
def first (p : Pair) : Nat := match p with | MkPair a _ => a end;

-- Recursion guarded by a match on the parameter.
def double : Nat -> Nat :=
  fix double (n : Nat) : Nat :=
    match n with
    | Z => Z
    | S k => S (S (double k))
    end;

-- Rows of a multi-scrutinee match repeat their first column's constructor
-- and still guard the recursion.
def eq_nat : Nat -> Nat -> Bool :=
  fix eq_nat (n : Nat) (m : Nat) : Bool :=
    match n, m with
    | Z, Z => True
    | Z, S _ => False
    | S _, Z => False
    | S a, S b => eq_nat a b
    end;

-- Matching on the constructor of an indexed family specialises the motive:
-- the one arm binds nothing and is the elimination, not a trivial match.
def cast (A : Type) (x : A) (y : A) (e : Eq A x y) : A :=
  match e with
  | refl => x
  end;

-- A branchless match on an uninhabited type is ex falso.
def ex_falso (A : Type) (e : Empty) : A := match e with end;

def drop_leading (xs : List) : List := xs;

-- The recursion is guarded by a match on a name computed from the parameter.
def skip_zeros : List -> List :=
  fix skip_zeros (xs : List) : List :=
    let rest : List := drop_leading xs in
    match rest with
    | Nil => Nil
    | Cons _ more => skip_zeros more
    end;
