inductive Bool : Type :=
  | True : Bool
  | False : Bool;

-- Eight nested matches: cognitive 36 for the matches plus 58 for the arms.
-- @complexity
-- @entry main
def main (b : Bool) : Bool :=
  match b with
  | False => False
  | True =>
      match b with
      | False => False
      | True =>
          match b with
          | False => False
          | True =>
              match b with
              | False => False
              | True =>
                  match b with
                  | False => False
                  | True =>
                      match b with
                      | False => False
                      | True =>
                          match b with
                          | False => False
                          | True =>
                              match b with
                              | False => False
                              | True => True
                              end
                          end
                      end
                  end
              end
          end
      end
  end;
