inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Unit : Type :=
  | MkUnit : Unit;

-- @minimal
-- @entry main
def main (n : Nat) : Nat := let copy : Nat := n in S copy;

-- @minimal
def unfinished : Nat := S _;

-- @minimal
def trivial (u : Unit) : Unit := match u with | MkUnit => u end;

-- @minimal
def constant : Nat := match S Z with | Z => Z | S k => k end;
