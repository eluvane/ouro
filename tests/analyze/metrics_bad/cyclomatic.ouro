inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

-- Fourteen two-arm matches: cyclomatic 1 + 14 + 28 = 43.
-- @complexity
-- @entry main
def main (b : Bool) : List Bool :=
  [ match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  , match b with | True => False | False => True end
  ];
