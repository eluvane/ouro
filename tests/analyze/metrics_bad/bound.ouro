inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

-- @bound(nodes <= 2)
-- @entry main
def main (n : Nat) : Nat := S (S (S n));

-- @bound(nodes = 2)
def malformed (n : Nat) : Nat := n;

-- @bound(weight <= 2)
def unknown_metric (n : Nat) : Nat := n;

-- One claim of a shared line fails and is reported alone.
-- @bound(nodes <= 64) @bound(cyclo <= 0)
def shared_line (n : Nat) : Nat := S n;
