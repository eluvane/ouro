inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

-- @property no-holes
-- @entry main
def main : Nat := Z;

-- @property exhaustive
def total (n : Nat) : Bool :=
  match n with
  | Z => True
  | S _ => False
  end;

-- @property terminates
def double : Nat -> Nat :=
  fix double (n : Nat) : Nat :=
    match n with
    | Z => Z
    | S k => S (S (double k))
    end;

-- No property directive: an unrelated hole is not this family's business.
def elsewhere : Nat := _;
