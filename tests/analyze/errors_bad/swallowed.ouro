inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Unit : Type :=
  | MkUnit : Unit;

inductive ParseError : Type :=
  | Empty : ParseError
  | Junk : Nat -> ParseError;

inductive Either (E : Type) (A : Type) : Type :=
  | Left : E -> Either E A
  | Right : A -> Either E A;

def parse (n : Nat) : Either ParseError Nat := Right ParseError Nat n;

def run (n : Nat) : IO (Either ParseError Nat) := io_pure (Either ParseError Nat) (parse n);

-- The failure arm drops the error and answers with a success.
-- @entry main
def main (n : Nat) : Either ParseError Nat :=
  match parse n with
  | Left _ => Right ParseError Nat Z
  | Right v => Right ParseError Nat (S v)
  end;

-- The checked result is bound to a discard and never inspected.
def fire (n : Nat) : IO Unit :=
  io_bind (Either ParseError Nat) Unit (run n)
    (fun (_r : Either ParseError Nat) => io_pure Unit MkUnit);
