inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Either (E : Type) (A : Type) : Type :=
  | Left : E -> Either E A
  | Right : A -> Either E A;

-- A raw String is the error channel.
-- @entry main
def main (n : Nat) : Either String Nat := Right String Nat n;

-- The same channel behind IO.
def load (n : Nat) : IO (Either String Nat) := io_pure (Either String Nat) (Right String Nat n);
