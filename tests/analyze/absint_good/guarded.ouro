inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

def div_nat (a : Nat) (b : Nat) : Nat := a;

-- The divisor is matched before the division; the arms see an unknown value.
-- @entry main
def main (n : Nat) : Nat :=
  match n with
  | Z => Z
  | S _ => div_nat (S Z) n
  end;

-- A positive divisor.
def half : Nat := div_nat (S (S Z)) (S (S Z));

-- Unknown scrutinee: both arms may fire.
def pred (n : Nat) : Nat :=
  match n with
  | Z => Z
  | S k => k
  end;

-- @ensures result is positive
def one : Nat := S Z;
