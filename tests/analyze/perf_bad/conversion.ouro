inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def length (A : Type) (xs : List A) : Nat := Z;

def add (a : Nat) (b : Nat) : Nat := a;

-- The same length of the same parameter is computed twice on one path.
-- @entry main
def main (xs : List Nat) : Nat := add (length Nat xs) (length Nat xs);

-- The length of the outer parameter is recomputed on every round.
def each_round (key : List Nat) : List Nat -> Nat :=
  fix go (cs : List Nat) : Nat :=
    match cs with
    | Nil => Z
    | Cons _ rest => add (length Nat key) (go rest)
    end;
