inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def append (A : Type) (xs : List A) (ys : List A) : List A := xs;

-- Every round copies the whole accumulator.
-- @entry main
def main : List Nat -> List Nat -> List Nat :=
  fix main (xs : List Nat) (acc : List Nat) : List Nat :=
    match xs with
    | Nil => acc
    | Cons x rest => main rest (append Nat acc (Cons Nat x (Nil Nat)))
    end;
