inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

def add (a : Nat) (b : Nat) : Nat := a;

-- The literal is rebuilt as a Peano chain on every round of the fix.
-- @entry main
def main : Nat -> Nat :=
  fix main (n : Nat) : Nat :=
    match n with
    | Z => Z
    | S k => add 256 (main k)
    end;
