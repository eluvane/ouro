inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def length (A : Type) (xs : List A) : Nat := Z;

def eq_nat (a : Nat) (b : Nat) : Bool := True;

-- The whole list is walked to learn whether it is empty.
-- @entry main
def main (xs : List Nat) : Bool := eq_nat (length Nat xs) Z;

-- No arm reads the count.
def has_any (xs : List Nat) : Bool :=
  match length Nat xs with
  | Z => False
  | S _ => True
  end;
