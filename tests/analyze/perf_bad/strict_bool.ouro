inductive Bool : Type :=
  | True : Bool
  | False : Bool;

inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive List (A : Type) : Type :=
  | Nil : List A
  | Cons : A -> List A -> List A;

def andb (a : Bool) (b : Bool) : Bool :=
  match a with
  | True => b
  | False => False
  end;

def is_zero (n : Nat) : Bool :=
  match n with
  | Z => True
  | S _ => False
  end;

-- The match runs even when `a` is already False.
-- @entry main
def main (a : Bool) (n : Nat) : Bool :=
  andb a (match n with | Z => True | S _ => False end);

-- The recursive walk runs before the cheap test.
def all_zero : List Nat -> Bool :=
  fix all_zero (xs : List Nat) : Bool :=
    match xs with
    | Nil => True
    | Cons x rest => andb (all_zero rest) (is_zero x)
    end;
