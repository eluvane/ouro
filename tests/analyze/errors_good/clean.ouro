inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;

inductive Unit : Type :=
  | MkUnit : Unit;

inductive ParseError : Type :=
  | Empty : ParseError
  | Junk : Nat -> ParseError;

inductive Either (E : Type) (A : Type) : Type :=
  | Left : E -> Either E A
  | Right : A -> Either E A;

-- A typed error channel.
def parse (n : Nat) : Either ParseError Nat := Right ParseError Nat n;

def run (n : Nat) : IO (Either ParseError Nat) := io_pure (Either ParseError Nat) (parse n);

def code (e : ParseError) : Nat :=
  match e with
  | Empty => Z
  | Junk n => n
  end;

-- The failure is propagated.
-- @entry main
def main (n : Nat) : Either ParseError Nat :=
  match parse n with
  | Left e => Left ParseError Nat e
  | Right v => Right ParseError Nat (S v)
  end;

-- The failure is inspected before a value is returned.
def recover (n : Nat) : Either ParseError Nat :=
  match parse n with
  | Left e => Right ParseError Nat (code e)
  | Right v => Right ParseError Nat v
  end;

-- The checked result is matched.
def report (n : Nat) : IO Unit :=
  io_bind (Either ParseError Nat) Unit (run n)
    (fun (r : Either ParseError Nat) =>
      match r with
      | Left _ => io_pure Unit MkUnit
      | Right _ => io_pure Unit MkUnit
      end);

-- A plain value may be dropped.
def tick (n : Nat) : IO Unit :=
  io_bind Nat Unit (io_pure Nat n) (fun (_x : Nat) => io_pure Unit MkUnit);

-- IO wrapping Either String is the host error channel, not ERR001.
def load_host (n : Nat) : IO (Either String Nat) :=
  io_pure (Either String Nat) (Right String Nat n);
