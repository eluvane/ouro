-- Typed mutation probes count only the three adapter-owned raw pages.
-- Status, conversion, release order and real GC assertions run at exit.
import "../compiler/native/managed_source.ouro",
  "../std/runtime.ouro",
  "native_startup_fault_calls.ouro",
  "native_fs_kind_fixtures.ouro",
  "native_startup_fault_values.ouro";

def mutation_fault_names (create : Bool) : List String :=
    ["raw_pages_allocate", "raw_pages_release", "raw_windows_argv_open", "raw_windows_argv_at",
      "raw_windows_argv_close", "raw_windows_wide_length", "raw_windows_utf8_to_utf16",
      "raw_windows_utf16_to_utf8", "raw_windows_environment_get", (match create with | True => "raw_windows_directory_parents" | False => "raw_windows_path_remove" end),
      "windows_exit_process", "managed_collect"];

def mutation_fault_symbols (create : Bool) (checked : CheckedProgram) : Either NativeLowerError (List Nat) :=
    (fix resolve (names : List String) : Either NativeLowerError (List Nat) :=
      match names with | Nil => Right(NativeLowerError, List Nat, [] : List Nat)
      | Cons name rest => lower_bind Nat (List Nat) (managed_source_symbol(checked, prim_string_to_char_codes name))
          (fun (id : Nat) => lower_map(List Nat, List Nat, Cons Nat id, resolve rest)) end) (mutation_fault_names create);

def mutation_fault_allocation_mode (mode : Nat) : Nat :=
    match andb(leb_nat 1 mode, leb_nat mode 3) with | True => mode | False => 0 end;

def mutation_fault_fatal (mode : Nat) : Bool :=
    orb(andb(leb_nat 1 mode, leb_nat mode 3), andb(leb_nat 6 mode, leb_nat mode 12));

def mutation_fault_allocations (mode : Nat) : Nat :=
    match andb(leb_nat 1 mode, leb_nat mode 3) with | True => mode | False =>
      match orb(eqNat mode 8, eqNat mode 10) with | True => 2 | False =>
        match orb(eqNat mode 9, eqNat mode 11) with | True => 3 | False =>
          match orb(eqNat mode 16, eqNat mode 18) with | True => 0 | False =>
            match eqNat mode 17 with | True => 9 | False => 3 end end end end end;

def mutation_fault_queries (mode : Nat) : Nat :=
    match orb (andb(leb_nat 1 mode, leb_nat mode 3))
      (orb(andb(leb_nat 8 mode, leb_nat mode 11), orb(eqNat mode 16, eqNat mode 18))) with
    | True => 0 | False => match eqNat mode 17 with | True => 3 | False => 1 end end;

-- Raw helpers have two arguments. Ordinary host errors retain Unit; 87 is fatal.
def mutation_fault_query (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (startup_fault_count base 56 state)
      (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
        match orb(eqNat mode 5, eqNat mode 7) with
        | True => startup_fault_result MirU32 5 next
        | False => match eqNat mode 12 with
          | True => startup_fault_result MirU32 87 next
          | False => startup_fault_call MirU32 original ([MirUse 0, MirUse 1] : List MirValue) next end end end);

def mutation_fault_exit_checks (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let allocations : Nat := mutation_fault_allocations mode in
    let releases : Nat := sub(allocations, match eqNat(mutation_fault_allocation_mode mode, 0) with | True => 0 | False => 1 end) in
    lower_bind ManagedState ManagedState
      (managed_require_equal(MirUse 0, managed_bits(MirU32, match mutation_fault_fatal mode with | True => 73 | False => 42 end), state))
      (fun (status : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 64 0 status)
        (fun (empty : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 72 0 empty)
          (fun (owner : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 0 allocations owner)
            (fun (allocated : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 8 releases allocated)
              (fun (released : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 40 (kind_fault_conversions mode) released)
                (fun (converted : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 56 (mutation_fault_queries mode) converted)
                  (fun (queried : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 96 MirUSize queried)
                    (fun (counted : ManagedResult) => match counted with | ManagedResultOf count next =>
                      lower_bind ManagedResult ManagedState (managed_compare MirGreater count (managed_bits MirUSize 0) next)
                        (fun (tested : ManagedResult) => match tested with | ManagedResultOf collected after =>
                          lower_bind ManagedState ManagedState (managed_require_equal collected (managed_bits MirU8 1) after)
                            (fun (gc : ManagedState) => match eqNat mode 17 with
                              | False => Right NativeLowerError ManagedState gc
                              | True => lower_bind ManagedResult ManagedState (startup_fault_load base 104 MirU8 gc)
                                  (fun (observed : ManagedResult) => match observed with | ManagedResultOf reclaimed final =>
                                    managed_require_equal reclaimed (managed_bits MirU8 1) final end) end) end) end))))))));

def mutation_fault_arguments (index : Nat) : List MirType :=
    match eqNat index 9 with | True => [MirRawPtr, MirUSize] | False =>
      match eqNat index 10 with | True => [MirU32] | False =>
        match eqNat index 11 with | True => [MirRawPtr] | False => startup_fault_arguments index end end end;

def mutation_fault_body (base : Nat) (mode : Nat) (index : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match eqNat index 0 with | True => startup_fault_allocate base (mutation_fault_allocation_mode mode) original state | False =>
      match eqNat index 1 with | True => startup_fault_release base (kind_fault_release_mode mode) original state | False =>
        match eqNat index 6 with | True => kind_fault_conversion base mode original state | False =>
          match eqNat index 9 with | True => mutation_fault_query base mode original state | False =>
            match eqNat index 11 with | True => startup_fault_collector base original state | False =>
              startup_fault_call(kind_fault_result_type index, original, startup_fault_values (mutation_fault_arguments index), state)
            end end end end end;

def mutation_fault_exit_function (base : Nat) (mode : Nat) (original : Nat) : Either NativeLowerError MirFunction :=
    lower_map ManagedState MirFunction (fun (after : ManagedState) => match managed_flow after with | LowerStateOf _ locals _ _ =>
      MirFunctionDef (add base 10) (prim_string_to_char_codes "mutation_fault") ([MirLocalDef 0 MirU32] : List MirLocal)
        (reverse MirLocal locals) (Nothing MirType) 0
        (lower_finish_blocks MirTrap (managed_flow
          (managed_emit(MirCall(MirMayGc, Nothing Nat, MirDirect original, [MirUse 0] : List MirValue), after)))) end)
      (mutation_fault_exit_checks base mode
        (ManagedStateOf(0, [] : List MirFunction, [] : List MirData, [] : List Nat, [] : List Nat, lower_empty_state 1)));

def mutation_fault_wrappers (base : Nat) (mode : Nat) (symbols : List Nat) : Either NativeLowerError (List MirFunction) :=
    (fix build (remaining : List Nat) (index : Nat) : Either NativeLowerError (List MirFunction) :=
      match remaining with | Nil => Right(NativeLowerError, List MirFunction, [] : List MirFunction)
      | Cons original rest => lower_bind MirFunction (List MirFunction) (match eqNat index 10 with
          | True => mutation_fault_exit_function base mode original
          | False => native_stdio_fixture_function (add base index) (prim_string_to_char_codes "mutation_fault")
              (startup_fault_locals (mutation_fault_arguments index)) (kind_fault_result_type index)
              (mutation_fault_body base mode index original) end)
          (fun (function : MirFunction) => lower_map (List MirFunction) (List MirFunction)
            (Cons MirFunction function) (build(rest, S index))) end) symbols 0;

def mutation_fault_valid_mode (mode : Nat) : Bool :=
    orb (leb_nat mode 3)
      (orb(andb(leb_nat 5 mode, leb_nat mode 12), andb(leb_nat 16 mode, leb_nat mode 18)));

def native_mutation_program (create : Bool) (mode : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    lower_bind Unit MirProgram (lower_require(mutation_fault_valid_mode mode, LowerInvalidEntry mode)) (fun (_ : Unit) =>
      match parts with | ManagedProgramOf checked contracts program =>
        let base : Nat := S (foldr Nat Nat maxNat 0 (mir_global_ids program)) in
        lower_bind (List Nat) MirProgram (mutation_fault_symbols create checked) (fun (symbols : List Nat) =>
          lower_map (List MirFunction) MirProgram (fun (wrappers : List MirFunction) =>
            match program with | MirProgramDef functions data libraries entry =>
              MirProgramDef (append MirFunction wrappers
                (map MirFunction MirFunction (startup_fault_function base symbols contracts) functions))
                (Cons MirData (MirDataDef(startup_fault_counter base, True, pe_zeros 192)) data) libraries entry end)
            (mutation_fault_wrappers base mode symbols)) end);

def native_mutation_fixture (encoded : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    lower_bind Unit MirProgram (lower_require(leb_nat encoded 50, LowerInvalidEntry encoded)) (fun (_ : Unit) =>
      let create : Bool := leb_nat encoded 31 in
      let mode : Nat := match create with | True => encoded | False => sub encoded 32 end in
      match parts with | ManagedProgramOf _ _ original =>
        let base : Nat := S (foldr Nat Nat maxNat 0 (mir_global_ids original)) in
        lower_map MirProgram MirProgram (fun (program : MirProgram) => match program with
          | MirProgramDef functions data libraries entry =>
            MirProgramDef (map MirFunction MirFunction (native_fault_release_collect(S base, add base 11)) functions)
              data libraries entry end) (native_mutation_program create mode parts) end);
