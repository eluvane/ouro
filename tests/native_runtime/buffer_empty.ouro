import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 0 with | Nothing => runtime_test_failure | Just zero =>
      match u8_from_nat 7 with | Nothing => runtime_test_failure | Just byte =>
        runtime_bind Bool U32 (raw_buffer_range (raw_null U8) zero zero zero) (fun (range_ok : Bool) =>
          runtime_bind Bool U32 (raw_buffer_fill (raw_null U8) zero byte) (fun (fill_ok : Bool) =>
            runtime_bind Bool U32 (raw_buffer_copy (raw_null U8) zero (raw_null U8) zero zero)
              (fun (copy_ok : Bool) => runtime_test_outcome (raw_bool_and(range_ok, raw_bool_and fill_ok copy_ok))))) end end;
