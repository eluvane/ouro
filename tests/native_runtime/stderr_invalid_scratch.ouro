import "stdio_common.ouro";

def stderr_invalid_checks (base : RawPtr U8) (one : USize) (marker : U8) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    runtime_bind (RawPtr U32) Bool (raw_cast U8 U32 base) (fun (overlap : RawPtr U32) =>
      runtime_bind Bool Bool (raw_windows_stderr base one overlap) (fun (overlap_ok : Bool) =>
        runtime_bind (RawPtr U8) Bool (raw_add U8 base one) (fun (unaligned : RawPtr U8) =>
          runtime_bind (RawPtr U32) Bool (raw_cast U8 U32 unaligned) (fun (bad_alignment : RawPtr U32) =>
            runtime_bind Bool Bool (raw_windows_stderr base one bad_alignment) (fun (alignment_ok : Bool) =>
              runtime_bind Bool Bool (raw_windows_stderr base one (raw_null U32)) (fun (null_ok : Bool) =>
                runtime_bind Bool Bool (raw_windows_stderr base (usize_sub zero one) overlap) (fun (overflow_ok : Bool) =>
                  runtime_bind Bool Bool (raw_windows_stderr (raw_null U8) zero (raw_null U32)) (fun (empty_ok : Bool) =>
                    runtime_bind U8 Bool (raw_load_u8 base) (fun (unchanged : U8) =>
                      runtime_pure Bool (raw_bool_and (raw_bool_not overlap_ok)
                        (raw_bool_and (raw_bool_not alignment_ok) (raw_bool_and (raw_bool_not null_ok)
                          (raw_bool_and (raw_bool_not overflow_ok) (raw_bool_and empty_ok
                            (u8_equal unchanged marker)))))))))))))));

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 16 with | Nothing => runtime_test_failure | Just bytes =>
        match u8_from_nat 42 with | Nothing => runtime_test_failure | Just marker =>
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
              match usize_equal address (usize_sub one one) with | True => runtime_test_failure | False =>
                runtime_bind Bool U32 (raw_buffer_fill base bytes marker) (fun (filled : Bool) =>
                  runtime_bind Bool U32 (stderr_invalid_checks base one marker)
                    (fun (correct : Bool) => runtime_test_release base (raw_bool_and filled correct))) end)) end end end;
