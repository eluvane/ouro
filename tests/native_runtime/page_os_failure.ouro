import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 64 with | Nothing => runtime_test_failure | Just bytes =>
        match u32_from_nat 63 with | Nothing => runtime_test_failure | Just shift =>
          let zero : USize := usize_sub one one in
          let impossible : USize := usize_shift_left one shift in
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (owned : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 owned) (fun (address : USize) =>
              match usize_equal address zero with | True => runtime_test_failure | False =>
                runtime_bind (RawPtr U8) U32 (raw_pages_allocate impossible one) (fun (failed : RawPtr U8) =>
                  runtime_bind USize U32 (raw_to_bits U8 failed) (fun (failed_bits : USize) =>
                    match usize_equal failed_bits zero with
                    | True => runtime_test_release owned True
                    | False => runtime_bind Bool U32 (raw_pages_release failed)
                      (fun (unexpected : Bool) => runtime_test_release owned (raw_bool_and False unexpected)) end))
              end)) end end end;
