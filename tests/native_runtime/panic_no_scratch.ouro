import "common.ouro";
import "../../runtime/platform/windows_stderr.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match u32_from_nat 0 with | Nothing => runtime_test_failure | Just zero =>
        runtime_bind Unit U32 (raw_windows_panic (raw_null U8) one (raw_null U32) zero)
          (fun (unexpected : Unit) => runtime_test_failure) end end;
