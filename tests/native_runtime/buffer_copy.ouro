import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 64 with | Nothing => runtime_test_failure | Just count =>
        match u8_from_nat 42 with | Nothing => runtime_test_failure | Just value =>
          let bytes : USize := usize_add count count in
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
              match usize_equal(address, usize_sub one one) with | True => runtime_test_failure | False =>
                runtime_bind Bool U32 (raw_buffer_fill base count value) (fun (filled : Bool) =>
                  runtime_bind (RawPtr U8) U32 (raw_add U8 base count) (fun (destination : RawPtr U8) =>
                    runtime_bind Bool U32 (raw_buffer_copy destination count base count count) (fun (copied : Bool) =>
                      runtime_bind Bool U32 (raw_buffer_read destination count (usize_sub count one) base)
                        (fun (loaded : Bool) => runtime_bind U8 U32 (raw_load_u8 base) (fun (observed : U8) =>
                          runtime_test_release base (raw_bool_and filled (raw_bool_and copied
                            (raw_bool_and(loaded, u8_equal observed value))))))))) end)) end end end;
