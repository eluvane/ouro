import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      let zero : USize := usize_sub one one in
      let two : USize := usize_add one one in
      let three : USize := usize_add two one in
      let maximum : USize := usize_sub zero one in
      runtime_bind (RawPtr U8) U32 (raw_pages_allocate zero one) (fun (empty : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (raw_pages_allocate one three) (fun (misaligned : RawPtr U8) =>
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate maximum two) (fun (overflow : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 empty) (fun (empty_bits : USize) =>
              runtime_bind USize U32 (raw_to_bits U8 misaligned) (fun (misaligned_bits : USize) =>
                runtime_bind USize U32 (raw_to_bits U8 overflow) (fun (overflow_bits : USize) =>
                  runtime_bind Bool U32 (raw_pages_release (raw_null U8)) (fun (released : Bool) =>
                    runtime_test_outcome (raw_bool_and (usize_equal empty_bits zero)
                      (raw_bool_and (usize_equal misaligned_bits zero)
                        (raw_bool_and(usize_equal overflow_bits zero, raw_bool_not released))))))))))) end;
