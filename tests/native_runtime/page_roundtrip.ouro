import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match u32_from_nat 12 with | Nothing => runtime_test_failure | Just shift =>
        match u8_from_nat 42 with | Nothing => runtime_test_failure | Just value =>
          let page : USize := usize_shift_left one shift in
          let bytes : USize := usize_add page one in
          let zero : USize := usize_sub one one in
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes page) (fun (base : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
              match usize_equal address zero with | True => runtime_test_failure | False =>
                runtime_bind U8 U32 (raw_load_u8 base) (fun (initial : U8) =>
                  runtime_bind Bool U32 (raw_buffer_write base bytes page value) (fun (stored : Bool) =>
                    runtime_bind Bool U32 (raw_buffer_read base bytes page base) (fun (loaded : Bool) =>
                      runtime_bind U8 U32 (raw_load_u8 base) (fun (observed : U8) =>
                        runtime_test_release base (raw_bool_and stored (raw_bool_and loaded
                          (raw_bool_and (usize_equal(usize_and(address, usize_sub page one), zero))
                            (raw_bool_and(u8_equal(initial, u8_sub value value), u8_equal observed value)))))))))
              end)) end end end;
