import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 64 with | Nothing => runtime_test_failure | Just bytes =>
        match u8_from_nat 9 with | Nothing => runtime_test_failure | Just marker =>
          let zero : USize := usize_sub one one in
          let two : USize := usize_add one one in
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
              match usize_equal address zero with | True => runtime_test_failure | False =>
                runtime_bind Bool U32 (raw_buffer_fill base bytes marker) (fun (filled : Bool) =>
                  runtime_bind Bool U32 (raw_buffer_write base bytes zero (u8_sub marker marker)) (fun (changed : Bool) =>
                    runtime_bind (RawPtr U8) U32 (raw_add U8 base one) (fun (inside : RawPtr U8) =>
                      runtime_bind Bool U32 (raw_buffer_copy inside (usize_sub bytes one) base bytes two) (fun (overlap : Bool) =>
                        runtime_bind Bool U32 (raw_buffer_copy base bytes base bytes bytes) (fun (identical : Bool) =>
                          runtime_bind U8 U32 (raw_load_u8 inside) (fun (unchanged : U8) =>
                            runtime_test_release base (raw_bool_and filled (raw_bool_and changed
                              (raw_bool_and(raw_bool_not overlap, raw_bool_and(identical, u8_equal unchanged marker))))))))))) end)) end end end;
