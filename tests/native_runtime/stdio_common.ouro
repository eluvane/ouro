import "common.ouro",
  "../../runtime/platform/windows_stderr.ouro";

def runtime_test_text (base : RawPtr U8) (one : USize) (first : U8) (second : U8) (newline : U8)
    : Runtime Bool :=
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    runtime_bind Bool Bool (raw_buffer_write base three (usize_sub one one) first) (fun (first_ok : Bool) =>
      runtime_bind Bool Bool (raw_buffer_write base three one second) (fun (second_ok : Bool) =>
        runtime_bind Bool Bool (raw_buffer_write base three two newline)
          (fun (line_ok : Bool) => runtime_pure(Bool, raw_bool_and(first_ok, raw_bool_and second_ok line_ok)))));

def runtime_test_scratch (base : RawPtr U8) (one : USize) : Runtime (RawPtr U32) :=
    let two : USize := usize_add one one in
    runtime_bind (RawPtr U8) (RawPtr U32) (raw_add U8 base (usize_add two two))
      (fun (address : RawPtr U8) => raw_cast U8 U32 address);

def runtime_test_print (base : RawPtr U8) (one : USize) : Runtime Bool :=
    let three : USize := usize_add(usize_add one one, one) in
    runtime_bind (RawPtr U32) Bool (runtime_test_scratch base one) (fun (written : RawPtr U32) =>
      runtime_bind Bool Bool (raw_windows_stderr base three written) (fun (printed : Bool) =>
        runtime_bind U32 Bool (raw_load_u32 written) (fun (count : U32) => runtime_pure Bool
          (raw_bool_and(printed, u32_equal(count, raw_size_to_u32 three))))));
