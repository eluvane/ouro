import "stdio_common.ouro";

extern windows_set_std_handle : U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "SetStdHandle" "nogc";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 16 with | Nothing => runtime_test_failure | Just bytes =>
        match u32_from_nat 12 with | Nothing => runtime_test_failure | Just selector =>
          match u32_from_nat 73 with | Nothing => runtime_test_failure | Just code =>
            runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
              runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
                match usize_equal(address, usize_sub one one) with | True => runtime_test_failure | False =>
                  runtime_bind U32 U32 (windows_set_std_handle(u32_sub(u32_sub selector selector, selector), raw_null U8))
                    (fun (changed : U32) => match u32_equal(changed, u32_sub selector selector) with
                      | True => runtime_test_release base False
                      | False => runtime_bind (RawPtr U32) U32 (runtime_test_scratch base one) (fun (written : RawPtr U32) =>
                        runtime_bind Unit U32 (raw_windows_panic base one written code)
                          (fun (unexpected : Unit) => runtime_test_failure)) end) end)) end end end end;
