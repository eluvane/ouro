import "../common.ouro";
def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match u32_from_nat 42 with | Nothing => runtime_test_failure | Just word =>
        runtime_bind Bool U32 (raw_buffer_write (raw_null U8) one (usize_sub one one) word)
          runtime_test_outcome end end;
