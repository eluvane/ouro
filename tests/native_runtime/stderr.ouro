import "stdio_common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 16 with | Nothing => runtime_test_failure | Just bytes =>
        match u8_from_nat 79 with | Nothing => runtime_test_failure | Just first =>
          match u8_from_nat 75 with | Nothing => runtime_test_failure | Just second =>
            match u8_from_nat 10 with | Nothing => runtime_test_failure | Just newline =>
              runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
                runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
                  match usize_equal(address, usize_sub one one) with | True => runtime_test_failure | False =>
                    runtime_bind Bool U32 (runtime_test_text base one first second newline) (fun (ready : Bool) =>
                      match ready with | False => runtime_test_release base False | True =>
                        runtime_bind Bool U32 (runtime_test_print base one)
                          (fun (printed : Bool) => runtime_test_release base printed) end) end)) end end end end end;
