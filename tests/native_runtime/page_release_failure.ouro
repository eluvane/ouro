import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match u32_from_nat 12 with | Nothing => runtime_test_failure | Just shift =>
        let zero : USize := usize_sub one one in
        let page : USize := usize_shift_left one shift in
        let bytes : USize := usize_add page page in
        runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
          runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
            match usize_equal address zero with | True => runtime_test_failure | False =>
              runtime_bind (RawPtr U8) U32 (raw_add U8 base page) (fun (interior : RawPtr U8) =>
                runtime_bind Bool U32 (raw_pages_release interior) (fun (invalid : Bool) =>
                  runtime_bind Bool U32 (raw_pages_release base) (fun (released : Bool) =>
                    runtime_bind Bool U32 (raw_pages_release base) (fun (again : Bool) =>
                      runtime_test_outcome (raw_bool_and (raw_bool_not invalid)
                        (raw_bool_and(released, raw_bool_not again))))))) end)) end end;
