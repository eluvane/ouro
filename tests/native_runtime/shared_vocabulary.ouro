-- Importing the raw vocabulary must not pull executable Nat/List helpers
-- into scalar lowering. Nat, Bool, Maybe and Unit keep their shared roles.
import "common.ouro";

def main : Runtime U32 :=
    match u32_from_nat 42 with
    | Nothing => runtime_test_failure
    | Just value => runtime_bind Unit U32 (runtime_pure Unit MkUnit)
        (fun (_ : Unit) => match u32_equal value value with
          | False => runtime_test_failure | True => runtime_pure U32 value end)
    end;
