import "common.ouro";

def buffer_bounds_checks (base : RawPtr U8) (bytes : USize) (one : USize) (marker : U8) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    runtime_bind Bool Bool (raw_buffer_write base bytes bytes (u8_sub marker marker)) (fun (outside_write : Bool) =>
      runtime_bind Bool Bool (raw_buffer_read base bytes bytes base) (fun (outside_read : Bool) =>
        runtime_bind Bool Bool (raw_buffer_read base bytes zero (raw_null U8)) (fun (null_output : Bool) =>
          runtime_bind Bool Bool (raw_buffer_write (raw_null U8) one zero marker) (fun (null_write : Bool) =>
            runtime_bind (RawPtr U8) Bool (raw_from_bits(U8, usize_sub zero one)) (fun (highest : RawPtr U8) =>
              runtime_bind Bool Bool (raw_buffer_range highest bytes one one) (fun (wrapped : Bool) =>
                runtime_bind U8 Bool (raw_load_u8 base) (fun (unchanged : U8) =>
                  runtime_pure Bool (raw_bool_and (raw_bool_not outside_write)
                    (raw_bool_and (raw_bool_not outside_read) (raw_bool_and (raw_bool_not null_output)
                      (raw_bool_and (raw_bool_not null_write) (raw_bool_and (raw_bool_not wrapped)
                        (u8_equal unchanged marker)))))))))))));

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 64 with | Nothing => runtime_test_failure | Just bytes =>
        match u8_from_nat 9 with | Nothing => runtime_test_failure | Just marker =>
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
              match usize_equal(address, usize_sub one one) with | True => runtime_test_failure | False =>
                runtime_bind Bool U32 (raw_buffer_fill base bytes marker) (fun (filled : Bool) =>
                  runtime_bind Bool U32 (buffer_bounds_checks base bytes one marker)
                    (fun (correct : Bool) => runtime_test_release(base, raw_bool_and filled correct))) end)) end end end;
