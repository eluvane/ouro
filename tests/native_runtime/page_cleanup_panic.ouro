import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 64 with | Nothing => runtime_test_failure | Just bytes =>
        match u32_from_nat 73 with | Nothing => runtime_test_failure | Just code =>
          runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes one) (fun (base : RawPtr U8) =>
            runtime_bind USize U32 (raw_to_bits U8 base) (fun (address : USize) =>
              match usize_equal(address, usize_sub one one) with | True => runtime_test_failure | False =>
                runtime_bind Bool U32 (raw_pages_release base) (fun (released : Bool) =>
                  match released with | False => runtime_test_failure | True =>
                    runtime_bind (RawPtr U8) U32 (raw_pages_reject base code)
                      (fun (unexpected : RawPtr U8) => runtime_test_failure) end) end)) end end end;
