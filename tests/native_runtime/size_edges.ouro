import "common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      let zero : USize := usize_sub one one in
      let two : USize := usize_add one one in
      let three : USize := usize_add two one in
      let four : USize := usize_add two two in
      let maximum : USize := usize_sub zero one in
      runtime_test_outcome (raw_bool_and (usize_equal (raw_size_round_up zero four) zero)
        (raw_bool_and (usize_equal (raw_size_round_up one zero) zero)
          (raw_bool_and (usize_equal (raw_size_round_up one three) zero)
            (raw_bool_and (usize_equal (raw_size_round_up maximum four) zero)
              (raw_bool_and (usize_equal (raw_size_round_up maximum one) maximum)
                (raw_bool_and (usize_equal (raw_size_round_up (usize_sub maximum three) four)
                  (usize_sub maximum three))
                  (usize_equal (raw_size_round_up (usize_add four one) four) (usize_add four four)))))))) end;
