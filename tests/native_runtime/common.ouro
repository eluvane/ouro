import "../../runtime/platform/windows_x64.ouro",
  "../../runtime/raw_buffer.ouro",
  "../native_managed/source_values.ouro";

-- Zero is a failure marker in these loader fixtures; successful normal cases
-- exit 42. Both values come from checked native operations, never host seeds.
def runtime_test_failure : Runtime U32 :=
    let result : Runtime U32 := source_zero in result;

def runtime_test_outcome (correct : Bool) : Runtime U32 :=
    match correct with | False => runtime_test_failure | True =>
      match u32_from_nat 42 with | Nothing => runtime_test_failure
      | Just answer => runtime_pure U32 answer end end;

def runtime_test_release (base : RawPtr U8) (correct : Bool) : Runtime U32 :=
    runtime_bind Bool U32 (raw_pages_release base) (fun (released : Bool) =>
      runtime_test_outcome (raw_bool_and correct released));
