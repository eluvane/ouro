-- Composition preserves independently supplied types and normal-form witnesses.
import "compiler_smith_domains.ouro";

def smith_low_family (family : Nat) : Bool :=
    notb (orb(eqNat family 8, orb(eqNat family 13, orb(eqNat family 14, eqNat family 15))));

def smith_constant_fold (typ : CoreTerm) (value : CoreTerm) : CoreTerm :=
    CFix 150 0 1 (CPi retained_nat typ)
      (CLam retained_nat
        (CCase retained_nat_info (CLam retained_nat typ) (CRel 0)
          ([value, CLam(retained_nat, CApp(CRel 2, CRel 0))] : List CoreTerm)));

def smith_extra_fold (typ : CoreTerm) : CoreTerm :=
    CFix 151 0 2 (CPi(retained_nat, CPi typ typ))
      (CLam retained_nat (CLam typ
        (CCase retained_nat_info (CLam retained_nat typ) (CRel 1)
          ([ CRel 0
           , CLam(retained_nat, smith_apply2(CRel 3, CRel 0, CRel 1))
           ] : List CoreTerm))));

def smith_form (form : Nat) (typ : CoreTerm) (term : CoreTerm) (seed : Nat) : CoreTerm :=
    let number : CoreTerm := smith_numeral (smith_choice seed 40 5) in
    match form with
    | Z => CApp(smith_identity typ, term)
    | S first => match first with
        | Z => CLetIn term typ (CRel 0)
        | S second => match second with
            | Z => smith_apply2 (CConst 300) typ term
            | S third => match third with
                | Z => smith_apply4 (CConst 301) typ retained_nat term number
                | S fourth => match fourth with
                    | Z => CCase retained_nat_info (CLam retained_nat typ) number
                        ([term, CLam retained_nat term] : List CoreTerm)
                    | S fifth => match fifth with
                        | Z => CApp(smith_constant_fold typ term, number)
                        | S sixth => match sixth with
                            | Z => smith_apply2 (smith_extra_fold typ) number term
                            | S _ => CApp(CLam(CPi typ typ, CApp(CRel 0, term)), smith_identity typ)
                            end
                        end
                    end
                end
            end
        end
    end;

def smith_wrap (seed : Nat) (witness : SmithWitness) : SmithWitness :=
    match witness with
    | SmithWitnessOf family typ term expected canonical forms =>
        let selected : Nat := smith_choice seed 41 8 in
        let form : Nat := match andb(notb (smith_low_family family), orb(eqNat selected 2, eqNat selected 3)) with
          | True => 0 | False => selected end in
        SmithWitnessOf family typ (smith_form form typ term seed) expected canonical (Cons Nat form forms)
    end;

def smith_generate (environment_seed : Nat) (depth : Nat) (family : Nat) : Nat -> Nat -> SmithWitness :=
  fix generate (fuel : Nat) (seed : Nat) : SmithWitness :=
    match fuel with
    | Z => smith_domain environment_seed depth seed family
    | S rest => smith_wrap(seed, generate(rest, property_seed seed 42))
    end;

def smith_definition_count (seed : Nat) (max_defs : Nat) : Nat := S (smith_choice seed 43 max_defs);

def smith_definition (seed : Nat) (depth : Nat) (index : Nat) : SmithWitness :=
    let state : Nat := property_seed(seed, add 44 index) in
    smith_generate seed depth (smith_choice state 45 smith_domain_count) depth state;

inductive SmithDefinition : Type :=
  | SmithDefinitionOf : Nat -> SmithWitness -> SmithDefinition;

def smith_constant_witness (definition : SmithDefinition) : SmithWitness :=
    match definition with
    | SmithDefinitionOf name witness => match witness with
        | SmithWitnessOf family typ _ normal canonical forms =>
            SmithWitnessOf family typ (CConst name) normal canonical forms
        end
    end;

def smith_compose : Nat -> Nat -> SmithWitness -> SmithWitness :=
  fix compose (depth : Nat) (seed : Nat) (witness : SmithWitness) : SmithWitness :=
    match depth with
    | Z => witness
    | S rest => smith_wrap(seed, compose rest (property_seed seed 76) witness)
    end;

def smith_next_definition (seed : Nat) (depth : Nat) (index : Nat)
    (earlier : List SmithDefinition) : Either String SmithWitness :=
    match earlier with
    | Nil => Right String SmithWitness (smith_definition seed depth index)
    | Cons _ rest =>
        let state : Nat := property_seed(seed, add 77 index) in
        match smith_choose state 78 with
        | False => Right String SmithWitness (smith_definition seed depth index)
        | True =>
            match compiler_nth SmithDefinition earlier (smith_choice state 79 (S (length SmithDefinition rest))) with
            | Nothing => Left String SmithWitness "generator selected a missing earlier definition"
            | Just selected => Right String SmithWitness (smith_compose depth state (smith_constant_witness selected))
            end
        end
    end;

def smith_definitions (seed : Nat) (depth : Nat) (max_defs : Nat) : Either String (List SmithDefinition) :=
    (fix build (remaining : Nat) (index : Nat) (earlier : List SmithDefinition) : Either String (List SmithDefinition) :=
      match remaining with
      | Z => Right(String, List SmithDefinition, reverse SmithDefinition earlier)
      | S rest => match smith_next_definition seed depth index earlier with
          | Left error => Left String (List SmithDefinition) error
          | Right witness => build(rest, S index, Cons SmithDefinition (SmithDefinitionOf(add 400 index, witness)) earlier)
          end
      end) (smith_definition_count seed max_defs) 0 (Nil SmithDefinition);

def smith_definition_item (definition : SmithDefinition) : FileItem :=
    match definition with
    | SmithDefinitionOf name witness => FDef(name, smith_witness_type witness, smith_witness_term witness)
    end;

def smith_named (name : String) (witness : SmithWitness) : Pair String SmithWitness :=
    MkPair String SmithWitness name witness;

def smith_result (family : Nat) (typ : CoreTerm) (term : CoreTerm) (normal : CoreTerm)
    (canonical : Bool) : SmithWitness :=
    SmithWitnessOf family typ term normal canonical (Nil Nat);

def smith_poly_option_type : CoreTerm :=
    CPi(CSort 0, CPi(CRel 0, CApp(CInd 44, CRel 1)));

def smith_poly_option_value : CoreTerm :=
    CLam(CSort 0, CLam(CRel 0, smith_apply2(CConstruct 44 1 1, CRel 1, CRel 0)));

def smith_poly_list_type : CoreTerm :=
    CPi(CSort 0, CPi(CRel 0, CApp(CInd 43, CRel 1)));

def smith_poly_list_value : CoreTerm :=
    CLam (CSort 0) (CLam (CRel 0)
      (smith_apply3(CConstruct 43 1 1, CRel 1, CRel 0, CApp(CConstruct 43 0 1, CRel 1))));

def smith_poly_pair_type : CoreTerm :=
    CPi(CSort 0, CPi(CRel 0, retained_pair(CRel 1, CRel 1)));

def smith_poly_pair_value : CoreTerm :=
    CLam(CSort 0, CLam(CRel 0, retained_pair_value(CRel 1, CRel 1, CRel 0, CRel 0)));

def smith_poly_cases (seed : Nat) : List (Pair String SmithWitness) :=
    let number : CoreTerm := smith_numeral (smith_choice seed 46 7) in
    [ smith_named("polymorphic-option", smith_leaf 15 smith_poly_option_type smith_poly_option_value False)
    , smith_named("polymorphic-list", smith_leaf 15 smith_poly_list_type smith_poly_list_value False)
    , smith_named("polymorphic-pair", smith_leaf 15 smith_poly_pair_type smith_poly_pair_value False)
    , smith_named "polymorphic-option-application"
        (smith_result 3 (CApp(CInd 44, retained_nat))
          (smith_apply2 smith_poly_option_value retained_nat number)
          (smith_apply2 (CConstruct 44 1 1) retained_nat number) True)
    , smith_named "polymorphic-list-application"
        (smith_result 4 (CApp(CInd 43, retained_nat))
          (smith_apply2 smith_poly_list_value retained_nat number)
          (smith_list_value(retained_nat, [number] : List CoreTerm)) True)
    , smith_named "polymorphic-pair-application"
        (smith_result 5 (retained_pair retained_nat retained_nat)
          (smith_apply2 smith_poly_pair_value retained_nat number)
          (retained_pair_value retained_nat retained_nat number number) True)
    ];
