-- Windows loader acceptance inputs. Every executable byte comes from the Ouro
-- x64 encoder and PE writer; the development host only serializes their output.

import "../compiler/native/pe.ouro";
import "../std/string.ouro";

def pe_test_zero : X64Displacement := X64Forward (X64Bytes32 0 0 0 0);

def pe_test_offset (offset : Nat) : X64Displacement := X64Forward (pe_word32 offset);

def pe_test_stack (offset : Nat) : X64Address := X64Base X64Rsp (pe_test_offset offset);

def pe_test_iat_call : X64Instruction := X64CallIndirect (X64MemoryOperand (X64Rip pe_test_zero));

def pe_test_exit_import : PeImport := PeNamedImport 1 (str_codes "ExitProcess");

def pe_test_kernel32 (imports : List PeImport) : PeLibrary := PeImportLibrary (str_codes "kernel32.dll") imports;

def pe_test_instructions (instructions : List X64Instruction) : Either PeError (List Nat) :=
    mapLeft X64EncodeError (List Nat) PeError PeInstructionError (x64_encode_block instructions);

def pe_test_exit_program (saved : List X64Register) (allocation : Nat) (status : Nat) : Either PeError PeProgram :=
    let instructions : List X64Instruction := append X64Instruction
      (map X64Register X64Instruction (fun (reg : X64Register) => X64Push reg) saved)
      ([ X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (pe_word32 allocation)
       , X64MovImm32 X64Rcx (pe_word32 status), pe_test_iat_call, X64Trap
       ] : List X64Instruction) in
    match pe_test_instructions instructions with
    | Left err => Left PeError PeProgram err
    | Right bytes =>
      let size : Nat := length Nat bytes in
      Right PeError PeProgram
        (PeProgramParts bytes ([] : List Nat) ([] : List Nat)
          ([PeNamedSymbol 1 PeText 0] : List PeSymbol)
          ([pe_test_kernel32 ([pe_test_exit_import] : List PeImport)] : List PeLibrary)
          ([PeRel32 PeText (sub size 6) (sub size 2) (PeImportTarget 1)] : List PeFixup)
          ([PeCodeFunction 1 size (str_codes "entry") (PeCallFrame saved allocation)] : List PeFunction) 1)
    end;

def pe_test_sum_entry (sixth : Nat) : List X64Instruction :=
    [ X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (pe_word32 56)
    , X64MovImm32 X64Rcx (pe_word32 1)
    , X64MovImm32 X64Rdx (pe_word32 2)
    , X64MovImm32 X64R8 (pe_word32 3)
    , X64MovImm32 X64R9 (pe_word32 4)
    , X64MovImm32 X64Rax (pe_word32 5)
    , X64Store X64Bits64 (pe_test_stack 32) X64Rax
    , X64MovImm32 X64Rax (pe_word32 sixth)
    , X64Store X64Bits64 (pe_test_stack 40) X64Rax
    , X64CallRelative pe_test_zero
    , X64ArithmeticImm32 X64Bits32 X64Compare X64Rax (pe_word32 21)
    , X64JumpIf X64NotEqual pe_test_zero
    , X64MovImm32 X64Rcx (pe_word32 42)
    , X64JumpRelative pe_test_zero
    , X64MovImm32 X64Rcx (pe_word32 99)
    , pe_test_iat_call, X64Trap
    ];

def pe_test_sum_function : List X64Instruction :=
    [ X64Mov X64Bits64 X64Rax X64Rcx
    , X64ArithmeticReg X64Bits64 X64Add X64Rax X64Rdx
    , X64ArithmeticReg X64Bits64 X64Add X64Rax X64R8
    , X64ArithmeticReg X64Bits64 X64Add X64Rax X64R9
    , X64Load X64Bits64 X64R10 (pe_test_stack 40)
    , X64ArithmeticReg X64Bits64 X64Add X64Rax X64R10
    , X64Load X64Bits64 X64R10 (pe_test_stack 48)
    , X64ArithmeticReg X64Bits64 X64Add X64Rax X64R10
    , X64Return
    ];

def pe_test_sum_program (sixth : Nat) : Either PeError PeProgram :=
    match pe_test_instructions (append X64Instruction (pe_test_sum_entry sixth) pe_test_sum_function) with
    | Left err => Left PeError PeProgram err
    | Right bytes => Right PeError PeProgram
        (PeProgramParts bytes ([] : List Nat) ([] : List Nat)
          ([PeNamedSymbol 1 PeText 0, PeNamedSymbol 2 PeText 89,
            PeNamedSymbol 3 PeText 76, PeNamedSymbol 4 PeText 81] : List PeSymbol)
          ([pe_test_kernel32 ([pe_test_exit_import] : List PeImport)] : List PeLibrary)
          ([ PeRel32 PeText 50 54 (PeSymbolTarget 2)
           , PeRel32 PeText 62 66 (PeSymbolTarget 3)
           , PeRel32 PeText 72 76 (PeSymbolTarget 4)
           , PeRel32 PeText 83 87 (PeImportTarget 1)
           ] : List PeFixup)
          ([PeCodeFunction 1 89 (str_codes "entry") (PeCallFrame ([] : List X64Register) 56),
            PeCodeFunction 2 29 (str_codes "sum_six") PeLeaf] : List PeFunction) 1)
    end;

def pe_test_stdout_message : List Nat := str_codes "native ouro\n";

def pe_test_stdout_instructions : List X64Instruction :=
    [ X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (pe_word32 56)
    , X64MovImm32 X64Rcx (X64Bytes32 245 255 255 255)
    , pe_test_iat_call
    , X64Mov X64Bits64 X64Rcx X64Rax
    , X64Lea X64Rdx (X64Rip pe_test_zero)
    , X64MovImm32 X64R8 (pe_word32 (length Nat pe_test_stdout_message))
    , X64Lea X64R9 (pe_test_stack 40)
    , X64ArithmeticReg X64Bits32 X64Xor X64Rax X64Rax
    , X64Store X64Bits64 (pe_test_stack 32) X64Rax
    , pe_test_iat_call
    , X64ArithmeticImm32 X64Bits32 X64Compare X64Rax (pe_word32 0)
    , X64JumpIf X64Equal pe_test_zero
    , X64MovImm32 X64Rcx (pe_word32 0)
    , X64JumpRelative pe_test_zero
    , X64MovImm32 X64Rcx (pe_word32 1)
    , pe_test_iat_call, X64Trap
    ];

def pe_test_stdout_program : Either PeError PeProgram :=
    match pe_test_instructions pe_test_stdout_instructions with
    | Left err => Left PeError PeProgram err
    | Right bytes => Right PeError PeProgram
        (PeProgramParts bytes pe_test_stdout_message ([] : List Nat)
          ([PeNamedSymbol 1 PeText 0, PeNamedSymbol 2 PeReadOnly 0,
            PeNamedSymbol 3 PeText 74, PeNamedSymbol 4 PeText 79] : List PeSymbol)
          ([pe_test_kernel32 ([pe_test_exit_import, PeNamedImport 2 (str_codes "GetStdHandle"),
            PeNamedImport 3 (str_codes "WriteFile")] : List PeImport)] : List PeLibrary)
          ([ PeRel32 PeText 14 18 (PeImportTarget 2)
           , PeRel32 PeText 24 28 (PeSymbolTarget 2)
           , PeRel32 PeText 48 52 (PeImportTarget 3)
           , PeRel32 PeText 60 64 (PeSymbolTarget 3)
           , PeRel32 PeText 70 74 (PeSymbolTarget 4)
           , PeRel32 PeText 81 85 (PeImportTarget 1)
           ] : List PeFixup)
          ([PeCodeFunction 1 87 (str_codes "entry") (PeCallFrame ([] : List X64Register) 56)] : List PeFunction) 1)
    end;

-- Exit 42 requires the loader to choose a nonpreferred image base and apply both
-- text/data DIR64 relocations. Independent file inspection checks the RVA32 field.
def pe_test_aslr_instructions : List X64Instruction :=
    [ X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (pe_word32 40)
    , X64ArithmeticReg X64Bits32 X64Xor X64Rcx X64Rcx
    , pe_test_iat_call
    , X64MovImm64 X64Rdx (X64Words64 (X64Bytes32 0 0 0 64) (X64Bytes32 1 0 0 0))
    , X64ArithmeticReg X64Bits64 X64Compare X64Rax X64Rdx
    , X64JumpIf X64Equal pe_test_zero
    , X64MovImm64 X64Rax (X64Words64 (pe_word32 0) (pe_word32 0))
    , X64Load X64Bits64 X64Rax (X64Base X64Rax pe_test_zero)
    , X64Load X64Bits32 X64Rcx (X64Base X64Rax pe_test_zero)
    , X64JumpRelative pe_test_zero
    , X64MovImm32 X64Rcx (pe_word32 98)
    , pe_test_iat_call, X64Trap
    ];

def pe_test_aslr_program : Either PeError PeProgram :=
    match pe_test_instructions pe_test_aslr_instructions with
    | Left err => Left PeError PeProgram err
    | Right bytes => Right PeError PeProgram
        (PeProgramParts bytes ([42, 0, 0, 0] : List Nat) (pe_zeros 12)
          ([PeNamedSymbol 1 PeText 0, PeNamedSymbol 2 PeWritable 0, PeNamedSymbol 3 PeReadOnly 0,
            PeNamedSymbol 4 PeText 54, PeNamedSymbol 5 PeText 59] : List PeSymbol)
          ([pe_test_kernel32 ([pe_test_exit_import, PeNamedImport 2 (str_codes "GetModuleHandleW")] : List PeImport)] : List PeLibrary)
          ([ PeRel32 PeText 11 15 (PeImportTarget 2)
           , PeRel32 PeText 30 34 (PeSymbolTarget 4)
           , PeVa64 PeText 36 (PeSymbolTarget 2)
           , PeRel32 PeText 50 54 (PeSymbolTarget 5)
           , PeRel32 PeText 61 65 (PeImportTarget 1)
           , PeVa64 PeWritable 0 (PeSymbolTarget 3)
           , PeRva32 PeWritable 8 (PeSymbolTarget 3)
           ] : List PeFixup)
          ([PeCodeFunction 1 67 (str_codes "entry") (PeCallFrame ([] : List X64Register) 40)] : List PeFunction) 1)
    end;

def pe_test_unwind_instructions : List X64Instruction :=
    [ X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (pe_word32 56)
    , X64Lea X64Rcx (X64Rip pe_test_zero)
    , X64Lea X64Rdx (pe_test_stack 40)
    , X64ArithmeticReg X64Bits32 X64Xor X64R8 X64R8
    , pe_test_iat_call
    , X64ArithmeticImm32 X64Bits64 X64Compare X64Rax (pe_word32 0)
    , X64JumpIf X64Equal pe_test_zero
    , X64Load X64Bits32 X64Rcx (X64Base X64Rax pe_test_zero)
    , X64ArithmeticImm32 X64Bits32 X64Compare X64Rcx (pe_word32 pe_section_alignment)
    , X64JumpIf X64NotEqual pe_test_zero
    , X64MovImm32 X64Rcx (pe_word32 42)
    , X64JumpRelative pe_test_zero
    , X64MovImm32 X64Rcx (pe_word32 99)
    , pe_test_iat_call, X64Trap
    ];

def pe_test_unwind_program : Either PeError PeProgram :=
    match pe_test_instructions pe_test_unwind_instructions with
    | Left err => Left PeError PeProgram err
    | Right bytes => Right PeError PeProgram
        (PeProgramParts bytes ([] : List Nat) ([] : List Nat)
          ([PeNamedSymbol 1 PeText 0, PeNamedSymbol 2 PeText 7,
            PeNamedSymbol 3 PeText 65, PeNamedSymbol 4 PeText 70] : List PeSymbol)
          ([pe_test_kernel32 ([pe_test_exit_import] : List PeImport),
            PeImportLibrary (str_codes "ntdll.dll") ([PeNamedImport 2 (str_codes "RtlLookupFunctionEntry")] : List PeImport)] : List PeLibrary)
          ([ PeRel32 PeText 10 14 (PeSymbolTarget 2)
           , PeRel32 PeText 24 28 (PeImportTarget 2)
           , PeRel32 PeText 37 41 (PeSymbolTarget 3)
           , PeRel32 PeText 51 55 (PeSymbolTarget 3)
           , PeRel32 PeText 61 65 (PeSymbolTarget 4)
           , PeRel32 PeText 72 76 (PeImportTarget 1)
           ] : List PeFixup)
          ([PeCodeFunction 1 78 (str_codes "entry") (PeCallFrame ([] : List X64Register) 56)] : List PeFunction) 1)
    end;

def pe_test_image (program : Either PeError PeProgram) : Either PeError PeImage :=
    match program with | Left err => Left PeError PeImage err | Right value => pe_write_image value end;

def pe_test_fixture (name : String) : Maybe (Either PeError PeProgram) :=
    match str_eq name "exit42" with
    | True => Just (Either PeError PeProgram) (pe_test_exit_program ([] : List X64Register) 40 42)
    | False =>
      match str_eq name "branch_fallthrough" with
      | True => Just (Either PeError PeProgram) (pe_test_sum_program 6)
      | False =>
        match str_eq name "branch_taken" with
        | True => Just (Either PeError PeProgram) (pe_test_sum_program 7)
        | False =>
          match str_eq name "stdout" with
          | True => Just (Either PeError PeProgram) pe_test_stdout_program
          | False =>
            match str_eq name "aslr" with
            | True => Just (Either PeError PeProgram) pe_test_aslr_program
            | False =>
              match str_eq name "unwind_lookup" with
              | True => Just (Either PeError PeProgram) pe_test_unwind_program
              | False =>
                match str_eq name "saved_frame" with
                | True => Just (Either PeError PeProgram) (pe_test_exit_program ([X64Rbx, X64R12] : List X64Register) 40 42)
                | False =>
                  match str_eq name "large_frame" with
                  | True => Just (Either PeError PeProgram) (pe_test_exit_program ([] : List X64Register) 136 42)
                  | False => Nothing (Either PeError PeProgram)
                  end
                end
              end
            end
          end
        end
      end
    end;
