-- Shared CheckPhase encoding for compiler suite status strings and codes.
import "../compiler/file_check_model.ouro",
  "../std/string_prims.ouro";

def compiler_test_phase_name (phase : CheckPhase) : String :=
    match phase with
    | CheckDeclarationPlan => "plan" | CheckDeclarationType => "type"
    | CheckDeclarationBody => "body" | CheckInductiveDeclaration => "inductive"
    end;

def compiler_test_phase_nat (phase : CheckPhase) : Nat :=
    match phase with
    | CheckDeclarationPlan => 0
    | CheckDeclarationType => 1
    | CheckDeclarationBody => 2
    | CheckInductiveDeclaration => 3
    end;
