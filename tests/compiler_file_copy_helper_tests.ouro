-- Copy alone resolves its four checked helpers and the complete two-path ABI.
import "../compiler/native/managed_fs_copy.ouro",
  "../compiler/driver.ouro",
  "compiler_startup_test_support.ouro";

def copy_helper_prefix : String :=
    prim_string_concat
      "intrinsic Effect : Type -> Type := \"ouro.runtime\"; intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic Byte : Type := \"ouro.u8\"; intrinsic Word : Type := \"ouro.u32\"; intrinsic Size : Type := \"ouro.usize\"; intrinsic Text : Type := \"ouro.string\"; inductive Boolean : Type := | No : Boolean | Yes : Boolean; representation Boolean := \"ouro.bool\"; inductive Item : Type := | Only : Item; representation Item := \"ouro.unit\"; "
      "intrinsic pure : (A : Type) -> A -> Effect A := \"ouro.runtime.pure\"; axiom word : Word; axiom byte : Byte; axiom pointer : Pointer Byte; def raw_pages_allocate (bytes : Size) (alignment : Size) : Effect (Pointer Byte) := pure (Pointer Byte) pointer; def raw_pages_release (buffer : Pointer Byte) : Effect Boolean := pure Boolean Yes; def raw_windows_utf8_to_utf16 (source : Pointer Byte) (bytes : Size) (target : Pointer Byte) (units : Size) (written : Pointer Word) : Effect Word := pure Word word; ";

def copy_helper_implementation (mode : Nat) : String :=
    match eqNat mode 1 with | True => ""
    | False => match eqNat mode 2 with
      | True => "axiom raw_windows_file_copy : Pointer Byte -> Size -> Pointer Byte -> Size -> Effect Word;"
      | False => match eqNat mode 4 with
        | True => "extern raw_windows_file_copy : Pointer Byte -> Size -> Pointer Byte -> Size -> Effect Word := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetLastError\" \"nogc\";"
        | False => prim_string_concat "def raw_windows_file_copy (source : "
          (prim_string_concat (match eqNat mode 3 with | True => "Pointer Word" | False => "Pointer Byte" end)
            (prim_string_concat ") (source_units : "
              (prim_string_concat (match eqNat mode 5 with | True => "Word" | False => "Size" end)
                (prim_string_concat ") (target : "
                  (prim_string_concat (match eqNat mode 6 with | True => "Pointer Word" | False => "Pointer Byte" end)
                    (prim_string_concat ") " (prim_string_concat
                      (match eqNat mode 9 with | True => ""
                        | False => match eqNat mode 7 with | True => "(target_units : Word) " | False => "(target_units : Size) " end end)
                      (match eqNat mode 8 with | True => ": Word := word;"
                        | False => ": Effect Word := pure Word word;" end)))))))) end end end;

def copy_helper_source (mode : Nat) : String :=
    prim_string_concat copy_helper_prefix (prim_string_concat
      "intrinsic action : Text -> Text -> Effect Item := \"ouro.fs.copy_file\"; " (copy_helper_implementation mode));

def copy_helper_probe (mode : Nat) : Bool :=
    match compile_checked_source(mul 100 50, prim_string_to_char_codes (copy_helper_source mode)) with
    | CErr _ => False | COk program =>
      let compiler : ManagedCompiler := ManagedCompilerOf program ([] : List Nat) 0 0 0 0 0 0 ([] : List LowerContract)
        (check_environment_from_entries (checked_program_entries program)) in
      match managed_copy_roots compiler primitive_default_fuel with
      | Right roots => andb(eqNat mode 0, eqNat(length Nat roots, 4))
      | Left error => match error with
        | LowerUnknownGlobal _ => eqNat mode 1
        | LowerBodyMismatch _ => orb(eqNat mode 2, eqNat mode 4)
        | LowerMetadataMismatch _ => orb(eqNat mode 3, andb(leb_nat 5 mode, leb_nat mode 9))
        | LowerResourceExhausted => False | LowerInvalidCall _ => False | LowerDeclarationFailure _ _ _ => False
        | LowerUnsupportedType _ => False | LowerUnsupportedTerm _ => False | LowerUnsupportedPrimitive _ => False
        | LowerUnboundLocal _ => False | LowerEffectMismatch => False | LowerInvalidEntry _ => False
        | LowerMirFailure _ => False | LowerBackendFailure _ => False end end end;

def main : IO Unit :=
    startup_test_run
      [startup_test_assert("copy selects four checked helpers", copy_helper_probe 0),
       startup_test_assert("copy rejects a missing helper", copy_helper_probe 1),
       startup_test_assert("copy rejects an axiom helper", copy_helper_probe 2),
       startup_test_assert("copy rejects the wrong source pointer", copy_helper_probe 3),
       startup_test_assert("copy rejects an extern helper", copy_helper_probe 4),
       startup_test_assert("copy rejects the wrong source size", copy_helper_probe 5),
       startup_test_assert("copy rejects the wrong destination pointer", copy_helper_probe 6),
       startup_test_assert("copy rejects the wrong destination size", copy_helper_probe 7),
       startup_test_assert("copy rejects a pure helper result", copy_helper_probe 8),
       startup_test_assert("copy rejects a missing destination size", copy_helper_probe 9)];
