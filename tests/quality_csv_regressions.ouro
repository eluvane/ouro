import "../std/csv.ouro",
  "../std/test.ouro";

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_eq "csv unescape keeps a lone quote"
          (csv_unescape "\"") "\""
       , assert_eq "csv unescape keeps empty input"
          (csv_unescape "") ""
       , assert_eq "csv unescape keeps an opening quote"
          (csv_unescape "\"alpha") "\"alpha"
       , assert_eq "csv unescape keeps a closing quote"
          (csv_unescape "alpha\"") "alpha\""
       , assert_eq "csv unescape keeps unquoted doubled quotes"
          (csv_unescape "a\"\"b") "a\"\"b"
       , assert_eq "csv unescape decodes an empty quote pair"
          (csv_unescape "\"\"") ""
       , assert_eq "csv unescape decodes a nonempty quote pair"
          (csv_unescape "\"alpha\"") "alpha"
       , assert_eq "csv unescape decodes escaped quotes"
          (csv_unescape "\"a\"\"b\"") "a\"b"
       , assert_eq "csv unescape decodes an escaped quote cell"
          (csv_unescape "\"\"\"\"") "\""
       , assert_eq "csv unescape preserves a quoted comma"
          (csv_unescape "\"alpha,beta\"") "alpha,beta"
       , assert_eq "csv unescape preserves quoted UTF-8"
          (csv_unescape "\"雪\"") "雪"
       , assert_eq "csv escape and unescape retain a quote"
          (csv_unescape (csv_escape "\"")) "\""
       , assert_eq "csv escape and unescape retain quotes and a comma"
          (csv_unescape (csv_escape "雪,\"alpha\"")) "雪,\"alpha\""
       ] : List Test);
