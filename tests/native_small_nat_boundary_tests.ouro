-- The full public boundary must reject forged role metadata before
-- native specialization; this law intentionally imports managed source.
import "native_small_nat_fixtures.ouro";
import "../compiler/native/managed_source.ouro";
import "../std/io.ouro";
import "native_nat_test_support.ouro";

def small_nat_test_fuel : Nat := mul 100 160;

def small_nat_metadata_rejected : Bool :=
    match compile_checked_source small_nat_test_fuel (prim_string_to_char_codes small_nat_fixture_canonical) with
    | CErr _ => False
    | COk program => match program with | CheckedProgramOf names entries bodies =>
        let forged : CheckedProgram := CheckedProgramOf names (map Entry Entry nat_forge_role entries) bodies in
        match native_managed_lower_checked small_nat_test_fuel mir_default_limits 0 forged with
        | Right _ => False
        | Left failure => match failure with
            | NativeSourceCheckError _ => False
            | NativeSourceLowerError error => match error with
                | LowerMetadataMismatch _ => True
                | LowerResourceExhausted => False | LowerDeclarationFailure _ _ _ => False
                | LowerBodyMismatch _ => False | LowerUnsupportedType _ => False
                | LowerUnsupportedTerm _ => False | LowerUnsupportedPrimitive _ => False
                | LowerUnknownGlobal _ => False | LowerUnboundLocal _ => False | LowerInvalidCall _ => False
                | LowerEffectMismatch => False | LowerInvalidEntry _ => False | LowerMirFailure _ => False
                | LowerBackendFailure _ => False end end end end end;

def main : IO Unit :=
    match small_nat_metadata_rejected with
    | True => do println "ok forged role metadata rejected at public boundary"; exit 0
    | False => do println "FAIL forged role metadata rejected at public boundary"; exit 1 end;
