-- Source elaboration fills synthetic annotations; raw Core remains strict.

import "../compiler/file_elab.ouro";
import "../std/io.ouro";

inductive RefineLaw : Type := | MkRefineLaw : String -> Bool -> RefineLaw;

def refine_test_nat : CoreTerm := CInd 10;
def refine_test_zero : CoreTerm := CConstruct 10 0 0;
def refine_test_bool : CoreTerm := CInd 20;
def refine_test_true : CoreTerm := CConstruct 20 0 0;
def refine_test_function : CoreTerm := CPi refine_test_nat refine_test_nat;
def refine_test_fuel : Nat := mul 50 40;

def refine_test_signature : List Entry :=
    match check_file refine_test_fuel
      ([ FInd (MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor 11 refine_test_nat, MkCtor 12 (CPi refine_test_nat refine_test_nat)] : List Ctor))
       , FInd (MkIndDecl 20 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor 21 refine_test_bool, MkCtor 22 refine_test_bool] : List Ctor))
       , FInd (MkIndDecl 30 ([MkParam 31 (CSort 0)] : List Param) (Nil CoreTerm) 0
          ([MkCtor 32 (CPi (CSort 0) (CPi (CRel 0) (CApp (CInd 30) (CRel 1))))] : List Ctor))
       , FInd (MkIndDecl 40 (Nil Param) ([refine_test_nat] : List CoreTerm) 0
          ([MkCtor 41 (CApp (CInd 40) refine_test_zero)] : List Ctor))
       ] : List FileItem) with
    | FRErr _ _ => Nil Entry
    | FROk sig => sig
    end;

def refine_test_accepts (expected : CoreTerm) (term : CoreTerm) : Bool :=
    match elaborate_check_item refine_test_fuel refine_test_signature (FDef 90 expected term) with
    | StepErr _ _ => False
    | StepOk _ => True
    end;

def refine_test_raw (expected : CoreTerm) (term : CoreTerm) : Bool :=
    check refine_test_fuel refine_test_signature (Nil CoreTerm) term expected;

def refine_test_nat_case (info : CaseInfo) (zero_branch : CoreTerm) (step_branch : CoreTerm) : CoreTerm :=
    CCase info (CInd 999) refine_test_zero ([zero_branch, step_branch] : List CoreTerm);

def refine_test_inferred_function : Bool :=
    let case_term : CoreTerm :=
      refine_test_nat_case (MkCaseInfo 10 0 ([0, 1] : List Nat))
        (CLam refine_test_nat (CRel 0))
        (CLam (CInd 0) (CLam refine_test_nat (CRel 0))) in
    match refine_term refine_test_fuel refine_test_signature (Nil CoreTerm) (Nothing CoreTerm) case_term with
    | Nothing => False
    | Just term => refine_test_raw refine_test_function term
    end;

def refine_test_saved_annotation : Bool :=
    match elaborate_check_item refine_test_fuel refine_test_signature
      (FDef 90 refine_test_function (CLam (CInd 0) (CRel 0))) with
    | StepErr _ _ => False
    | StepOk entries =>
        match lookup_const 90 entries with
        | Nothing => False
        | Just body => eqTerm 100 body (CLam refine_test_nat (CRel 0))
        end
    end;

def refine_test_laws : List RefineLaw :=
    [ MkRefineLaw "raw lambda rejects unknown annotation"
        (notb (refine_test_raw refine_test_function (CLam (CInd 0) (CRel 0))))
    , MkRefineLaw "source lambda gets expected domain"
        (refine_test_accepts refine_test_function (CLam (CInd 0) (CRel 0)))
    , MkRefineLaw "checked environment keeps elaborated body" refine_test_saved_annotation
    , MkRefineLaw "explicit wrong lambda annotation stays rejected"
        (notb (refine_test_accepts refine_test_function (CLam refine_test_bool (CRel 0))))
    , MkRefineLaw "raw let rejects unknown annotation"
        (notb (refine_test_raw refine_test_nat (CLetIn refine_test_zero (CInd 0) (CRel 0))))
    , MkRefineLaw "source let infers value type"
        (refine_test_accepts refine_test_nat (CLetIn refine_test_zero (CInd 0) (CRel 0)))
    , MkRefineLaw "source applied lambda infers argument domain"
        (refine_test_accepts refine_test_nat (CApp (CLam (CInd 0) (CRel 0)) refine_test_zero))
    , MkRefineLaw "source match fills motive and constructor binders"
        (refine_test_accepts refine_test_nat
          (refine_test_nat_case (MkCaseInfo 10 0 ([0, 1] : List Nat))
            refine_test_zero (CLam (CInd 0) (CRel 0))))
    , MkRefineLaw "source match still rejects wrong result"
        (notb (refine_test_accepts refine_test_nat
          (refine_test_nat_case (MkCaseInfo 10 0 ([0, 1] : List Nat))
            refine_test_true (CLam (CInd 0) (CRel 0)))))
    , MkRefineLaw "source match still rejects malformed arities"
        (notb (refine_test_accepts refine_test_nat
          (refine_test_nat_case (MkCaseInfo 10 0 ([0, 2] : List Nat))
            refine_test_zero (CLam (CInd 0) (CRel 0)))))
    , MkRefineLaw "source match uses actual parameter"
        (refine_test_accepts refine_test_nat
          (CCase (MkCaseInfo 30 1 ([1] : List Nat)) (CInd 999)
            (CApp (CApp (CConstruct 30 0 1) refine_test_nat) refine_test_zero)
            ([CLam (CInd 0) (CRel 0)] : List CoreTerm)))
    , MkRefineLaw "source indexed match abstracts actual index"
        (refine_test_accepts (CApp (CInd 40) refine_test_zero)
          (CCase (MkCaseInfo 40 0 ([0] : List Nat)) (CInd 999)
            (CConstruct 40 0 0) ([CConstruct 40 0 0] : List CoreTerm)))
    , MkRefineLaw "inferred case result preserves function telescope" refine_test_inferred_function
    , MkRefineLaw "source definition cannot reference itself"
        (notb (refine_test_accepts refine_test_nat (CConst 90)))
    , MkRefineLaw "source elaboration cannot accept unknown global"
        (notb (refine_test_accepts refine_test_nat (CConst 999)))
    ];

def main : IO Unit :=
    (fix run (laws : List RefineLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil => match failed with | True => exit 1 | False => exit 0 end
      | Cons law rest =>
          match law with
          | MkRefineLaw name passed =>
              do println (prim_string_concat
                   (match passed with | True => "ok " | False => "FAIL " end) name);
                 run rest (orb failed (notb passed))
          end
      end) refine_test_laws False;
