-- Checked String identities and independent expected Core values.
import "../compiler/file_elab.ouro";
import "../compiler/core_literals.ouro";
import "compiler_test_phase.ouro";

def string_nf_test_fuel : Nat := mul 32 128;
def string_nf_test_string_type : CoreTerm := CConst 18;
def string_nf_test_nat_type : CoreTerm := CInd 40;
def string_nf_test_bool_type : CoreTerm := CInd 41;
def string_nf_test_codes_type : CoreTerm := CApp (CInd 43) (CInd 40);
def string_nf_test_strings_type : CoreTerm := CApp (CInd 43) (CConst 18);
def string_nf_test_index_type : CoreTerm := CApp (CInd 44) (CInd 40);

def string_nf_test_binary_string_type : CoreTerm :=
    CPi string_nf_test_string_type (CPi string_nf_test_string_type string_nf_test_string_type);

def string_nf_test_predicate_type : CoreTerm :=
    CPi string_nf_test_string_type (CPi string_nf_test_string_type string_nf_test_bool_type);

def string_nf_test_binding (name : Nat) (operation : PrimitiveStringOp) (typ : CoreTerm) : Entry :=
    MkBoundEntry name typ (primitive_binding (PrimitiveStringOperation operation) (Nothing CoreTerm));

def string_nf_test_operations : List Entry :=
    [ string_nf_test_binding 100 PrimitiveStringConcat string_nf_test_binary_string_type
    , string_nf_test_binding 101 PrimitiveStringLength
        (CPi string_nf_test_string_type string_nf_test_nat_type)
    , string_nf_test_binding 102 PrimitiveStringByteAt
        (CPi string_nf_test_string_type (CPi string_nf_test_nat_type string_nf_test_nat_type))
    , string_nf_test_binding 103 PrimitiveStringSlice
        (CPi string_nf_test_string_type
          (CPi string_nf_test_nat_type (CPi string_nf_test_nat_type string_nf_test_string_type)))
    , string_nf_test_binding 104 PrimitiveStringEqual string_nf_test_predicate_type
    , string_nf_test_binding 105 PrimitiveStringOfNat
        (CPi string_nf_test_nat_type string_nf_test_string_type)
    , string_nf_test_binding 106 PrimitiveStringToCodes
        (CPi string_nf_test_string_type string_nf_test_codes_type)
    , string_nf_test_binding 107 PrimitiveStringOfCodes
        (CPi string_nf_test_codes_type string_nf_test_string_type)
    , string_nf_test_binding 108 PrimitiveStringStarts string_nf_test_predicate_type
    , string_nf_test_binding 109 PrimitiveStringEnds string_nf_test_predicate_type
    , string_nf_test_binding 110 PrimitiveStringContains string_nf_test_predicate_type
    , string_nf_test_binding 111 PrimitiveStringIndex
        (CPi string_nf_test_string_type (CPi string_nf_test_string_type string_nf_test_index_type))
    , string_nf_test_binding 112 PrimitiveStringSplit
        (CPi string_nf_test_string_type (CPi string_nf_test_nat_type string_nf_test_strings_type))
    , string_nf_test_binding 113 PrimitiveStringReplace
        (CPi string_nf_test_string_type string_nf_test_binary_string_type)
    , string_nf_test_binding 114 PrimitiveStringLessEqual string_nf_test_predicate_type
    , string_nf_test_binding 115 PrimitiveStringTokens
        (CPi string_nf_test_string_type string_nf_test_strings_type)
    ];

-- These shapes use arbitrary identities, not Nat/Bool/List/Maybe spellings.
def string_nf_test_roles : List Entry :=
    [ MkRoleEntry (PrimitiveRoleOf PrimitiveNatRole
        (PrimitiveInductiveOf 40 0 0 (CSort 0)
          ([CInd 40, CPi (CInd 40) (CInd 40)] : List CoreTerm)))
    , MkRoleEntry (PrimitiveRoleOf PrimitiveBoolRole
        (PrimitiveInductiveOf 41 0 0 (CSort 0) ([CInd 41, CInd 41] : List CoreTerm)))
    , MkRoleEntry (PrimitiveRoleOf PrimitiveListRole
        (PrimitiveInductiveOf 43 1 0 (CPi (CSort 0) (CSort 0))
          ([CPi (CSort 0) (CApp (CInd 43) (CRel 0)),
            CPi (CSort 0) (CPi (CRel 0)
              (CPi (CApp (CInd 43) (CRel 1)) (CApp (CInd 43) (CRel 2))))] : List CoreTerm)))
    , MkRoleEntry (PrimitiveRoleOf PrimitiveMaybeRole
        (PrimitiveInductiveOf 44 1 0 (CPi (CSort 0) (CSort 0))
          ([CPi (CSort 0) (CApp (CInd 44) (CRel 0)),
            CPi (CSort 0) (CPi (CRel 0) (CApp (CInd 44) (CRel 1)))] : List CoreTerm)))
    ];

def string_nf_test_support : List Entry :=
    Cons Entry (MkBoundEntry 18 (CSort 0) (primitive_binding PrimitiveStringType (Nothing CoreTerm)))
      string_nf_test_roles;

def string_nf_test_environment : List Entry :=
    append Entry string_nf_test_operations string_nf_test_support;

def string_nf_test_keep_role (role : PrimitiveRole) (entry : Entry) : Bool :=
    match entry with
    | MkEntry _ _ _ => True | MkIndEntry _ _ => True | MkBoundEntry _ _ _ => True
    | MkRoleEntry binding => match binding with
        | PrimitiveRoleOf candidate _ => match primitive_role_equal role candidate with
            | True => False | False => True end
        end
    end;

def string_nf_test_without_role (role : PrimitiveRole) : List Entry :=
    filter Entry (string_nf_test_keep_role role) string_nf_test_environment;

def string_nf_test_bytes (bytes : List Nat) : CoreTerm := CStrBytes bytes 18;

def string_nf_test_nat : Nat -> CoreTerm :=
    fix build (value : Nat) : CoreTerm :=
      match value with
      | Z => CConstruct 40 0 0
      | S previous => CApp (CConstruct 40 1 0) (build previous)
      end;

def string_nf_test_bool (value : Bool) : CoreTerm :=
    CConstruct 41 (match value with | True => 0 | False => 1 end) 0;

def string_nf_test_list (element : CoreTerm) : List CoreTerm -> CoreTerm :=
    fix build (values : List CoreTerm) : CoreTerm :=
      match values with
      | Nil => CApp (CConstruct 43 0 1) element
      | Cons value rest => CApp (CApp (CApp (CConstruct 43 1 1) element) value) (build rest)
      end;

def string_nf_test_codes (values : List Nat) : CoreTerm :=
    string_nf_test_list string_nf_test_nat_type (map Nat CoreTerm string_nf_test_nat values);

def string_nf_test_strings (values : List (List Nat)) : CoreTerm :=
    string_nf_test_list string_nf_test_string_type (map (List Nat) CoreTerm string_nf_test_bytes values);

def string_nf_test_nothing : CoreTerm := CApp (CConstruct 44 0 1) string_nf_test_nat_type;
def string_nf_test_just (value : Nat) : CoreTerm :=
    CApp (CApp (CConstruct 44 1 1) string_nf_test_nat_type) (string_nf_test_nat value);

def string_nf_test_unary (name : Nat) (first : CoreTerm) : CoreTerm := CApp (CConst name) first;
def string_nf_test_binary (name : Nat) (first : CoreTerm) (second : CoreTerm) : CoreTerm :=
    CApp (CApp (CConst name) first) second;
def string_nf_test_ternary (name : Nat) (first : CoreTerm) (second : CoreTerm) (third : CoreTerm) : CoreTerm :=
    CApp (CApp (CApp (CConst name) first) second) third;

def string_nf_test_core_equal (left : CoreTerm) (right : CoreTerm) : Bool :=
    match eqTerm_checked string_nf_test_fuel left right with
    | Normalized equal => equal | NormalizeExhausted => False | NormalizeMalformed _ => False
    end;

def string_nf_test_reduces_in (entries : List Entry) (term : CoreTerm) (expected : CoreTerm) : Bool :=
    match normalize_checked string_nf_test_fuel entries term with
    | Normalized normal => andb (string_nf_test_core_equal normal expected)
        (conv string_nf_test_fuel entries term expected)
    | NormalizeExhausted => False | NormalizeMalformed _ => False
    end;

def string_nf_test_reduces (term : CoreTerm) (expected : CoreTerm) : Bool :=
    string_nf_test_reduces_in string_nf_test_environment term expected;

def string_nf_test_stuck (entries : List Entry) (term : CoreTerm) : Bool :=
    string_nf_test_reduces_in entries term term;

-- Match exact faults; exhaustion and every older reduction fault fail these laws.
def string_nf_test_fault (A : Type) (expected : Nat) (result : NormalizeResult A) : Bool :=
    match result with
    | Normalized _ => False | NormalizeExhausted => False
    | NormalizeMalformed fault => match fault with
        | NormalizeStringBytes => eqNat expected 11
        | NormalizeStringArguments => eqNat expected 12
        | NormalizeUnresolvedLiteral => eqNat expected 13
        | NormalizeStringType => eqNat expected 14
        | NormalizeNonFunction => False | NormalizeCaseBranchCount => False
        | NormalizeCaseScrutinee => False | NormalizeCaseInductive => False
        | NormalizeCaseParameters => False | NormalizeCaseConstructor => False
        | NormalizeCaseArguments => False | NormalizeFixArgument => False
        | NormalizeFixArity => False | NormalizeUnreducedHead => False
        end
    end;

def string_nf_test_malformed (expected : Nat) (entries : List Entry) (term : CoreTerm) : Bool :=
    string_nf_test_fault CoreTerm expected (normalize_checked string_nf_test_fuel entries term);

def string_nf_test_exhausted (fuel : Nat) (term : CoreTerm) : Bool :=
    match normalize_checked fuel string_nf_test_environment term with
    | NormalizeExhausted => True | Normalized _ => False | NormalizeMalformed _ => False
    end;

def string_nf_test_table : List (Pair (List Nat) Nat) :=
    [MkPair (List Nat) Nat ([65, 0, 255] : List Nat) 7];

def string_nf_test_intern : InternState :=
    MkIntern ([] : List (Pair (List Nat) Nat)) 1 string_nf_test_table 8;

def string_nf_test_comp_error (A : Type) (code : Nat) (detail : Nat) (result : CompResult A) : Bool :=
    match result with
    | COk _ => False
    | CErr failure => match failure with
        | ErrCode actual current => andb (eqNat code actual) (eqNat detail current)
        end
    end;

def string_nf_test_resolved (result : CompResult CoreTerm) (expected : CoreTerm) : Bool :=
    match result with
    | CErr _ => False | COk value => string_nf_test_core_equal value expected
    end;

def string_nf_test_plan_preserves_nul : Bool :=
    match resolve_literal_plan string_nf_test_fuel string_nf_test_intern
      ([FDef 700 string_nf_test_string_type (CStrLit 7 18)] : List FileItem) with
    | CErr _ => False
    | COk items => match items with
        | Nil => False
        | Cons item rest => match rest with
            | Cons _ _ => False
            | Nil => match item with
                | FDef name annotation body => andb (eqNat name 700)
                    (andb (string_nf_test_core_equal annotation string_nf_test_string_type)
                      (string_nf_test_core_equal body (string_nf_test_bytes ([65, 0, 255] : List Nat))))
                | FAxiom _ _ => False | FInd _ => False | FIntrinsic _ _ _ _ => False
                | FExtern _ _ _ => False | FRepresentation _ _ => False
                end
            end
        end
    end;

-- A raw literal ID is not a value, even when its String type is known.
def string_nf_test_unresolved_failure (literal : Nat) (failure : CheckFailure) : Bool :=
    match failure with
    | CheckMalformedCore fault => match fault with
        | CheckUnresolvedLiteral actual => eqNat literal actual
        | CheckUnboundVariable _ => False | CheckUnboundGlobal _ => False
        | CheckUnknownInductive _ => False | CheckUnknownConstructor _ _ => False
        | CheckConstructorParameters => False | CheckCaseMetadata => False
        | CheckFixMetadata => False | CheckLiteralType _ => False | CheckDuplicateName _ => False
        end
    | CheckTypeFailure _ => False | CheckReductionFailure _ => False
    | CheckResourceLimit => False | CheckUnsupported _ => False | CheckCancelled => False
    | CheckInternalFailure _ => False | CheckPrimitiveFailure _ => False
    end;

def string_nf_test_unresolved_infer (literal : Nat) (term : CoreTerm) : Bool :=
    match infer_checked string_nf_test_fuel string_nf_test_environment ([] : List CoreTerm) (IGTerm term) with
    | CheckOk _ => False | CheckErr failure => string_nf_test_unresolved_failure literal failure
    end;

def string_nf_test_boundary_nat : IndDecl :=
    MkIndDecl 40 ([] : List Param) ([] : List CoreTerm) 0
      ([MkCtor 50 (CInd 40), MkCtor 51 (CPi (CInd 40) (CInd 40))] : List Ctor);

def string_nf_test_boundary_items (item : FileItem) : List FileItem :=
    [FIntrinsic 18 (CSort 0) ([111, 117, 114, 111, 46, 115, 116, 114, 105, 110, 103] : List Nat) (Nothing CoreTerm),
     FInd string_nf_test_boundary_nat, item];

def string_nf_test_raw : CoreTerm := CStrLit 7 18;
def string_nf_test_boundary_value : CoreTerm := string_nf_test_bytes ([65, 0, 255] : List Nat);
def string_nf_test_raw_item : FileItem := FDef 700 string_nf_test_string_type string_nf_test_raw;
def string_nf_test_raw_lambda : CoreTerm := CLam string_nf_test_string_type string_nf_test_raw;
def string_nf_test_raw_lambda_item : FileItem :=
    FDef 700 (CPi string_nf_test_string_type string_nf_test_string_type) string_nf_test_raw_lambda;

-- Inference must visit an argument even when beta reduction would discard it.
def string_nf_test_discarded_argument : CoreTerm :=
    CApp (CLam string_nf_test_string_type string_nf_test_boundary_value) string_nf_test_raw;
def string_nf_test_discarded_item : FileItem :=
    FDef 700 string_nf_test_string_type string_nf_test_discarded_argument;

-- This annotation is a valid type after literal resolution. A type error must
-- not masquerade as the missing-literal rejection.
def string_nf_test_raw_annotation : CoreTerm :=
    CApp (CLam string_nf_test_string_type (CSort 0)) string_nf_test_raw;
def string_nf_test_raw_annotation_item : FileItem :=
    FDef 700 string_nf_test_raw_annotation string_nf_test_string_type;

-- Zero selects the first branch; the second branch still requires checking.
def string_nf_test_unselected_branch : CoreTerm :=
    CCase (MkCaseInfo 40 0 ([0, 1] : List Nat))
      (CLam string_nf_test_nat_type string_nf_test_string_type) (string_nf_test_nat 0)
      ([string_nf_test_boundary_value, CLam string_nf_test_nat_type string_nf_test_raw] : List CoreTerm);
def string_nf_test_unselected_item : FileItem :=
    FDef 700 string_nf_test_string_type string_nf_test_unselected_branch;

def string_nf_test_unresolved_module (mode : CheckMode) (phase : CheckPhase) (item : FileItem) : Bool :=
    match check_declarations mode keep_checking string_nf_test_fuel (string_nf_test_boundary_items item) with
    | DeclarationsOk _ => False
    | DeclarationsErr name actual failure =>
        andb (eqNat name 700) (andb (eqNat (compiler_test_phase_nat phase) (compiler_test_phase_nat actual))
          (string_nf_test_unresolved_failure 7 failure))
    end;

def string_nf_test_file_error (result : FileResult) : Bool :=
    match result with
    | FROk _ => False | FRErr code name => andb (eqNat code 6) (eqNat name 700)
    end;

def string_nf_test_resolved_infers : Bool :=
    match resolve_core_literals string_nf_test_table string_nf_test_fuel string_nf_test_raw with
    | CErr _ => False
    | COk value => match infer_checked string_nf_test_fuel string_nf_test_environment
        ([] : List CoreTerm) (IGTerm value) with
        | CheckErr _ => False | CheckOk typ => andb (string_nf_test_core_equal value string_nf_test_boundary_value)
            (string_nf_test_core_equal typ string_nf_test_string_type)
        end
    end;

def string_nf_test_resolved_module (mode : CheckMode) (item : FileItem) : Bool :=
    match resolve_literal_plan string_nf_test_fuel string_nf_test_intern (string_nf_test_boundary_items item) with
    | CErr _ => False
    | COk resolved => match check_declarations mode keep_checking string_nf_test_fuel resolved with
        | DeclarationsErr _ _ _ => False | DeclarationsOk _ => True
        end
    end;

def string_nf_test_resolved_body (mode : CheckMode) : Bool :=
    match resolve_literal_plan string_nf_test_fuel string_nf_test_intern
      (string_nf_test_boundary_items string_nf_test_raw_item) with
    | CErr _ => False
    | COk resolved => match check_declarations mode keep_checking string_nf_test_fuel resolved with
        | DeclarationsErr _ _ _ => False
        | DeclarationsOk entries => match lookup_const 700 entries with
            | Nothing => False | Just body => string_nf_test_core_equal body string_nf_test_boundary_value
            end
        end
    end;
