def realpath_normalization_compiler (program : CheckedProgram) (contracts : List LowerContract)
    : Either NativeLowerError ManagedCompiler :=
    let maximum : Nat := foldr Entry Nat (fun (item : Entry) (other : Nat) => maxNat (lower_entry_max item) other)
      0 (checked_program_entries program) in
    lower_bind Nat ManagedCompiler (managed_source_symbol program (prim_string_to_char_codes "managed_allocate_raw"))
      (fun (allocator : Nat) => lower_bind Nat ManagedCompiler (managed_source_symbol program (prim_string_to_char_codes "managed_collect"))
      (fun (collector : Nat) => lower_bind Nat ManagedCompiler (managed_source_symbol program (prim_string_to_char_codes "managed_release_all"))
      (fun (release : Nat) => lower_bind Nat ManagedCompiler (managed_source_symbol program (prim_string_to_char_codes "managed_inspect_roots"))
      (fun (inspect : Nat) => lower_bind Nat ManagedCompiler (managed_source_symbol program (prim_string_to_char_codes "windows_exit_process"))
      (fun (exit : Nat) => Right NativeLowerError ManagedCompiler
        (ManagedCompilerOf program ([] : List Nat) allocator collector release inspect exit (S maximum) contracts
          (check_environment_from_entries (checked_program_entries program))))))));

def realpath_normalization_values (compiler : ManagedCompiler) (family : Nat)
    : List (List Nat) -> ManagedState -> Either NativeLowerError ManagedResult :=
    fix build (remaining : List (List Nat)) (state : ManagedState) : Either NativeLowerError ManagedResult :=
      match remaining with
      | Nil => managed_constructor compiler family (managed_bits MirUSize 0) ([] : List MirValue) state
      | Cons bytes rest => lower_bind ManagedResult ManagedResult (build rest state)
          (fun (built : ManagedResult) => match built with | ManagedResultOf tail after =>
            lower_bind (Pair Nat ManagedState) ManagedResult (managed_fresh_symbol after)
              (fun (fresh : Pair Nat ManagedState) => match fresh with | MkPair symbol next =>
                let saved : ManagedState := managed_add_data
                  (MirDataDef symbol False (append Nat bytes ([0] : List Nat))) next in
                lower_bind ManagedResult ManagedResult (managed_address symbol saved)
                  (fun (located : ManagedResult) => match located with | ManagedResultOf source ready =>
                    lower_bind ManagedResult ManagedResult
                      (managed_nat_helper (prim_string_to_char_codes "realpath_normalization_case")
                        ([MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirUSize] : List MirLocal)
                        ([source, managed_bits MirUSize (length Nat bytes)] : List MirValue) MirManagedPtr
                        (managed_realpath_normalize compiler (MirUse 0) (MirUse 1)) ready)
                      (fun (normalized : ManagedResult) => match normalized with | ManagedResultOf head final =>
                        managed_constructor compiler family (managed_bits MirUSize 1) ([head,tail] : List MirValue) final end)
                    end) end) end) end;

def realpath_normalization_replacement (compiler : ManagedCompiler) (family : Nat) (fresh : Nat)
    (function : MirFunction) : Either NativeLowerError (Pair (List MirFunction) (List MirData)) :=
    match function with | MirFunctionDef id name arguments _ result _ _ =>
      lower_bind Unit (Pair (List MirFunction) (List MirData)) (lower_require
        (andb (eqNat (length MirLocal arguments) 0)
          (match result with | Just typ => mir_type_equal typ MirManagedPtr | Nothing => False end))
        (LowerInvalidCall id)) (fun (_ : Unit) =>
          lower_map ManagedResult (Pair (List MirFunction) (List MirData)) (fun (built : ManagedResult) =>
            match built with | ManagedResultOf value state => match state with
              | ManagedStateOf _ functions data pending known _ =>
                MkPair (List MirFunction) (List MirData)
                  (Cons MirFunction (managed_finish_function id name ([] : List MirLocal) value state) functions) data end end)
            (realpath_normalization_values compiler family realpath_normalization_inputs
              (ManagedStateOf fresh ([] : List MirFunction) ([] : List MirData) ([] : List Nat) ([] : List Nat) (lower_empty_state 0)))) end;

def native_realpath_normalization_fixture (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    match parts with | ManagedProgramOf checked contracts program =>
      lower_bind ManagedCompiler MirProgram (realpath_normalization_compiler checked contracts)
        (fun (compiler : ManagedCompiler) => lower_bind Nat MirProgram
          (managed_source_symbol checked (prim_string_to_char_codes "realpath_normalization_source"))
          (fun (id : Nat) => lower_bind Nat MirProgram
            (lower_role_identity (checked_program_entries checked) PrimitiveListRole)
            (fun (family : Nat) => match program with | MirProgramDef functions data libraries entry =>
              let target : Nat := managed_global_symbol compiler id in
              let selected : List MirFunction := filter MirFunction (fun (function : MirFunction) =>
                eqNat target (mir_function_id function)) functions in
              match selected with | Nil => Left NativeLowerError MirProgram (LowerUnknownGlobal target)
              | Cons found tail => match tail with
                | Cons _ _ => Left NativeLowerError MirProgram (LowerInvalidCall target)
                | Nil => lower_map (Pair (List MirFunction) (List MirData)) MirProgram
                    (fun (replaced : Pair (List MirFunction) (List MirData)) => match replaced with | MkPair replacements objects =>
                      MirProgramDef (concat_map MirFunction MirFunction (fun (function : MirFunction) =>
                        match eqNat target (mir_function_id function) with
                        | True => replacements | False => ([function] : List MirFunction) end) functions)
                        (append MirData objects data) libraries entry end)
                    (realpath_normalization_replacement compiler family
                      (S (foldr Nat Nat maxNat 0 (mir_global_ids program))) found)
                end end end))) end;
