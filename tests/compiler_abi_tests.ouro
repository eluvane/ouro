-- Real frontend callbacks exchange the same shared nominal ABI values.

import "../compiler/lexer.ouro",
  "../compiler/parser.ouro",
  "../compiler/lower_env.ouro",
  "../compiler/compiler.ouro",
  "../compiler/import_resolve.ouro",
  "../compiler/preprocess_import.ouro",
  "../compiler/preprocess_record.ouro",
  "../compiler/pipeline.ouro",
  "../std/io.ouro";

inductive AbiLaw : Type :=
  | MkAbiLaw : String -> Bool -> AbiLaw;

def abi_fuel : Nat := mul 40 50;

def abi_parse_file (fuel : Nat) (tokens : List Token) (position : Nat)
    : ParseResult (List Decl) :=
    parse_file parse fuel tokens position;

def abi_codes_equal (codes : List Nat) (expected : String) : Bool :=
    prim_string_eq(prim_string_of_char_codes codes, expected);

def abi_decl_name (decls : List Decl) (state : InternState) : Bool :=
    match decls with
    | Nil => False
    | Cons decl rest =>
        match rest with
        | Cons _ _ => False
        | Nil =>
            match decl with
            | DDef name _ _ => abi_codes_equal(name_of_id state name, "value")
            | DAxiom _ _ => False
            | DInductive _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def abi_lex_parse_resolve : Bool :=
    match parse_unit lex_go intern_string abi_parse_file abi_fuel empty_intern
      (prim_string_to_char_codes "a.ouro")
      (prim_string_to_char_codes "def value : Type 1 := Type;") with
    | UErr _ _ _ => False
    | UOk unit state =>
        match unit with
        | MkSrcUnit path decls =>
            andb (abi_codes_equal(str_of_id state path, "a.ouro"))
              (andb (abi_decl_name decls state)
                (match resolve_imports([unit] : List SrcUnit, path) with
                | RErr _ _ => False
                | ROk ordered => abi_decl_name ordered state
                end))
        end
    end;

def abi_unit_error (fuel : Nat) (source : String) (expected : Nat) : Bool :=
    match parse_unit lex_go intern_string abi_parse_file fuel empty_intern
      (prim_string_to_char_codes "bad.ouro")
      (prim_string_to_char_codes source) with
    | UOk _ _ => False
    | UErr code _ _ => eqNat code expected
    end;

def abi_resolver_error : Bool :=
    match resolve_imports
      ([MkSrcUnit(0, [DImport 1] : List Decl)] : List SrcUnit) 0 with
    | ROk _ => False
    | RErr code missing => andb(eqNat code 2, eqNat missing 1)
    end;

def abi_compiler_result : Bool :=
    match compile_program
      ([MkPair Nat Surface 7 (SSort 0)] : List (Pair Nat Surface)) with
    | CErr _ => False
    | COk cores =>
        match cores with
        | Nil => False
        | Cons pair rest =>
            match pair with
            | MkPair name term =>
                andb (eqNat name 7)
                  (andb (eqNat(extract_tag term, 1))
                    (match rest with | Nil => True | Cons _ _ => False end))
            end
        end
    end;

def abi_compiler_error : Bool :=
    match compile_program
      ([MkPair Nat Surface 7 (SHole 1)] : List (Pair Nat Surface)) with
    | COk _ => False
    | CErr error =>
        match error with
        | ErrCode code detail => andb(eqNat code 2, eqNat detail 0)
        end
    end;

def abi_first_nat (values : List Nat) (expected : Nat) : Bool :=
    match values with
    | Nil => False
    | Cons value _ => eqNat value expected
    end;

def abi_first_surface_name (values : List (Pair Nat Surface))
    (expected : Nat) : Bool :=
    match values with
    | Nil => False
    | Cons pair _ =>
        match pair with | MkPair name _ => eqNat name expected end
    end;

def abi_constructor_fields (values : List CtorInfo) : Bool :=
    match values with
    | Nil => False
    | Cons ctor _ =>
        andb (eqNat(ctor_nameId ctor, 3))
          (andb (eqNat(ctor_indId ctor, 2))
            (andb (eqNat(ctor_idx ctor, 1))
              (andb(eqNat(ctor_nparams ctor, 4), eqNat(ctor_arity ctor, 5)))))
    end;

def abi_lower_environment : Bool :=
    let env : LowerEnv := MkLowerEnv ([1] : List Nat) ([2] : List Nat)
      ([MkCtorInfo 3 2 1 4 5] : List CtorInfo)
      ([6, 7, 8, 9, 10, 11, 12, 13] : List Nat)
      ([MkPair Nat Surface 14 (SSort 0)] : List (Pair Nat Surface))
      ([MkPair Nat Surface 15 (SSort 1)] : List (Pair Nat Surface)) in
    andb (abi_first_nat(env_constIds env, 1))
      (andb (abi_first_nat(env_indIds env, 2))
        (andb (abi_constructor_fields (env_ctors env))
          (andb (eqNat(env_stringTyId env, 6))
            (andb (eqNat(env_unitId env, 7))
              (andb (eqNat(env_ioId env, 8))
                (andb (eqNat(env_ioBindId env, 9))
                  (andb (eqNat(env_pureId env, 10))
                    (andb (eqNat(env_listId env, 11))
                      (andb (eqNat(env_nilId env, 12))
                        (andb (eqNat(env_consId env, 13))
                          (andb (abi_first_surface_name(env_ioPayloads env, 14))
                            (abi_first_surface_name(env_declTypes env, 15)))))))))))));

def abi_import_state : Bool :=
    let aliases : List (List Nat) := [prim_string_to_char_codes "A"] in
    match preprocess_imports_reg(MkImpReg aliases, Nil Nat) with
    | MkPair registry result =>
        match registry with
        | MkImpReg names =>
            match names with
            | Nil => False
            | Cons name _ =>
                andb (abi_codes_equal name "A")
                  (match result with
                  | ImpErr _ _ => False
                  | ImpOk source =>
                      match source with | Nil => True | Cons _ _ => False end
                  end)
            end
        end
    end;

def abi_record_field (fields : List RecField) : Bool :=
    match fields with
    | Nil => False
    | Cons field _ =>
        match field with
        | MkRecField name typ =>
            andb(abi_codes_equal name "field", abi_codes_equal typ "Type")
        end
    end;

def abi_record_info (records : List RecInfo) : Bool :=
    match records with
    | Nil => False
    | Cons info _ =>
        match info with
        | MkRecInfo tag name ctor fields =>
            andb (eqNat tag 7)
              (andb (abi_codes_equal name "R")
                (andb(abi_codes_equal ctor "MkR", abi_record_field fields)))
        end
    end;

def abi_record_binding (bindings : List RecBind) : Bool :=
    match bindings with
    | Nil => False
    | Cons binding _ =>
        match binding with
        | MkRecBind name tag => andb(abi_codes_equal name "r", eqNat tag 7)
        end
    end;

def abi_record_state : Bool :=
    let fields : List RecField :=
      [MkRecField(prim_string_to_char_codes "field", prim_string_to_char_codes "Type")] in
    let records : List RecInfo :=
      [MkRecInfo(7, prim_string_to_char_codes "R", prim_string_to_char_codes "MkR", fields)] in
    let bindings : List RecBind := [MkRecBind(prim_string_to_char_codes "r", 7)] in
    let registry : RecReg := MkRecReg 8 records (Nil (List Nat)) bindings in
    match preprocess_src preprocess_imports_reg preprocess_records_reg registry (Nil Nat) with
    | SrcPrepErr _ _ => False
    | SrcPrepOk next source =>
        match next with
        | MkRecReg _ kept _ globals =>
            andb (abi_record_info kept)
              (andb (abi_record_binding globals)
                (match source with | Nil => True | Cons _ _ => False end))
        end
    end;

def abi_preprocess_source : Bool :=
    let source : List Nat := prim_string_to_char_codes "axiom A : Type;" in
    match preprocess_src preprocess_imports_reg preprocess_records_reg empty_rec_reg source with
    | SrcPrepErr _ _ => False
    | SrcPrepOk _ output => abi_codes_equal output "axiom A : Type;"
    end;

def abi_preprocess_error : Bool :=
    match preprocess_src preprocess_imports_reg preprocess_records_reg empty_rec_reg
      (prim_string_to_char_codes "import \"a.ouro\" as ;") with
    | SrcPrepOk _ _ => False
    | SrcPrepErr code _ => eqNat code 81
    end;

def abi_laws : List AbiLaw :=
    [ MkAbiLaw "lexer/parser/resolver share declarations and intern state" abi_lex_parse_resolve
    , MkAbiLaw("lexer malformed result crosses parser callback", abi_unit_error abi_fuel "@" 11)
    , MkAbiLaw("lexer exhaustion crosses parser callback", abi_unit_error 0 "def" 12)
    , MkAbiLaw("parser error crosses unit callback", abi_unit_error abi_fuel "def" 10)
    , MkAbiLaw "resolver error retains code and missing path" abi_resolver_error
    , MkAbiLaw "compiler result retains named core" abi_compiler_result
    , MkAbiLaw "compiler error retains code and detail" abi_compiler_error
    , MkAbiLaw "lower environment preserves constructor and hint fields" abi_lower_environment
    , MkAbiLaw "import preprocessing retains registry values" abi_import_state
    , MkAbiLaw "record callback retains nested record model values" abi_record_state
    , MkAbiLaw "preprocessors share successful source value" abi_preprocess_source
    , MkAbiLaw "preprocessor error crosses pipeline callback" abi_preprocess_error
    ];

def abi_run : List AbiLaw -> Bool -> IO Unit :=
    fix abi_run (laws : List AbiLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil =>
          match failed with
          | True => do println "COMPILER_ABI: FAIL"; exit 1
          | False => println "COMPILER_ABI: PASS"
          end
      | Cons law rest =>
          match law with
          | MkAbiLaw name passed =>
              do println (prim_string_concat
                   (match passed with | True => "PASS " | False => "FAIL " end) name);
                 abi_run(rest, orb(failed, notb passed))
          end
      end;

-- @entry main
def main : IO Unit := abi_run abi_laws False;
