-- Real managed owners are kept through collection by indexed reads and stores.
-- The complete allocator and collector are lowered from checked Ouro source.
import "native_live_runtime.ouro";

def indexed_runtime_locals : List MirLocal :=
    append MirLocal live_runtime_locals [MirLocalDef 6 MirUSize];

def indexed_runtime_widths (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      let word : MirValue := MirBits MirU32 (X64Words64 (X64Bytes32 239 205 171 137) codegen_zero) in
      let wide : MirValue := MirBits MirU64 (X64Words64 (X64Bytes32 239 205 171 137) (X64Bytes32 103 69 35 1)) in
      live_runtime_finish runtime [managed_fixture_body (S base) indexed_runtime_locals
        (managed_fixture_join [
          live_runtime_start base,
          [MirMove 6 (managed_fixture_word MirUSize 32)],
          managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 0),
          [MirStoreAt (MirUse 1) (MirUse 6) (managed_fixture_word MirU8 211),
            MirLoad 22 (MirUse 20) (codegen_disp 0)],
          managed_value_box 2 allocator collector (add base 100) (managed_fixture_word MirU64 0),
          [MirStoreAt (MirUse 2) (MirUse 6) word],
          managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 0),
          [MirStoreAt (MirUse 3) (MirUse 6) wide],
          managed_value_box 4 allocator collector (add base 100) (managed_fixture_word MirU64 7),
          managed_fixture_stat 20 16 4, managed_fixture_stat 20 24 160,
          [MirLoadAt 31 (MirUse 1) (MirUse 6)],
          managed_fixture_assert (MirUse 31) (managed_fixture_word MirU8 211),
          [MirLoadAt 30 (MirUse 2) (MirUse 6)],
          managed_fixture_assert (MirUse 30) word,
          [MirLoadAt 32 (MirUse 3) (MirUse 6)],
          managed_fixture_assert (MirUse 32) wide,
          live_runtime_collect collector, managed_fixture_stat 20 16 0,
          managed_fixture_stat 20 24 0, live_runtime_free base 22])
        (managed_fixture_word MirU32 42)] end;

def indexed_runtime_alias (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      live_runtime_finish runtime [managed_fixture_body (S base) indexed_runtime_locals
        (managed_fixture_join [
          live_runtime_start base,
          managed_value_env 1 allocator collector (add base 102) [managed_fixture_word MirManagedPtr 0],
          managed_value_box 2 allocator collector (add base 100) (managed_fixture_word MirU64 42),
          [MirLoad 22 (MirUse 20) (codegen_disp 0), MirMove 6 (managed_fixture_word MirUSize 40)],
          managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 7),
          managed_fixture_stat 20 16 3,
          [MirStoreAt (MirUse 1) (MirUse 6) (MirUse 2)],
          managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 7),
          managed_fixture_stat 20 16 3, managed_fixture_stat 20 24 128,
          [MirLoadAt 1 (MirUse 1) (MirUse 6)],
          managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 7),
          managed_fixture_stat 20 16 2, managed_fixture_stat 20 24 80,
          [MirMove 6 (managed_fixture_word MirUSize 32), MirLoadAt 32 (MirUse 1) (MirUse 6)],
          managed_fixture_assert (MirUse 32) (managed_fixture_word MirU64 42),
          live_runtime_collect collector, managed_fixture_stat 20 16 0,
          managed_fixture_stat 20 24 0, live_runtime_free base 22])
        (managed_fixture_word MirU32 42)] end;

def indexed_runtime_named (name : List Nat) (runtime : NativeManagedRuntime) : Maybe MirProgram :=
    match pe_bytes_equal name [105,110,100,101,120,101,100,95,119,105,100,116,104,115] with
    | True => Just MirProgram (indexed_runtime_widths runtime)
    | False => match pe_bytes_equal name [105,110,100,101,120,101,100,95,97,108,105,97,115] with
      | True => Just MirProgram (indexed_runtime_alias runtime) | False => Nothing MirProgram end end;

def indexed_runtime_program (name : List Nat) (parts : ManagedProgramParts) : Either NativeSourceError MirProgram :=
    match live_runtime_from_parts parts with
    | Left err => Left NativeSourceError MirProgram err
    | Right runtime => match indexed_runtime_named name runtime with
      | Nothing => Left NativeSourceError MirProgram (NativeSourceLowerError (LowerInvalidEntry 0))
      | Just program => Right NativeSourceError MirProgram program end end;
