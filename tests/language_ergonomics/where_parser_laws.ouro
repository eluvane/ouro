-- Exact let/lambda/application shapes for ordinary, packed, and spanned parsing.
import "../../compiler/parser.ouro",
  "parser_test_budget.ouro",
  "../../compiler/source_spans.ouro",
  "../../std/listx.ouro",
  "../../std/collections.ouro",
  "../../std/io.ouro";

-- Other constructors cannot match the expected shapes in these laws.
def where_shape_codes : Expr -> List Nat -> List Nat :=
  fix codes (expr : Expr) (tail : List Nat) : List Nat :=
    match expr with
    | EVar name => Cons Nat 1 (Cons Nat name tail)
    | ESort level => Cons Nat 2 (Cons Nat level tail)
    | ENat number => Cons Nat 3 (Cons Nat number tail)
    | EApp head argument => Cons Nat 4 (codes head (codes argument tail))
    | ELam name annotation body =>
        Cons Nat 5 (Cons Nat name
          (match annotation with
           | Nothing => Cons Nat 0 (codes body tail)
           | Just ty => Cons Nat 1 (codes ty (codes body tail))
           end))
    | EPi name domain body => Cons Nat 6 (Cons Nat name (codes domain (codes body tail)))
    | ELet name annotation value body =>
        Cons Nat 7 (Cons Nat name
          (match annotation with
           | Nothing => Cons Nat 0 (codes value (codes body tail))
           | Just ty => Cons Nat 1 (codes ty (codes value (codes body tail)))
           end))
    | EAscribe value ty => Cons Nat 8 (codes value (codes ty tail))
    | ESpan _ _ body => codes body tail
    | EOpen alias body => Cons Nat 9 (Cons Nat alias (codes body tail))
    | EHole _ => list1_nat 0
    | EMatch _ _ => list1_nat 0
    | EFix _ _ _ _ => list1_nat 0
    | EEffectRow _ _ => list1_nat 0
    | EPerform _ _ => list1_nat 0
    | EDo _ => list1_nat 0
    | EHandle _ _ => list1_nat 0
    | EBranch _ _ _ => list1_nat 0
    | ENoBranch => list1_nat 0
    | EBinder _ _ _ => list1_nat 0
    | ENoBinder => list1_nat 0
    | EMultiMatch _ _ => list1_nat 0
    | EStr _ => list1_nat 0
    | EDoBind _ _ => list1_nat 0
    | EList _ => list1_nat 0
    | EFallible _ _ _ _ => list1_nat 0
    | EListSpread _ _ => list1_nat 0
    | ENamedCall _ _ => list1_nat 0
    | ERange _ _ _ => list1_nat 0
    | EIf condition yes no => Cons Nat 10 (codes condition (codes yes (codes no tail)))
    | EIfLet pattern subject yes no =>
        Cons Nat 11 (Cons Nat (length Nat pattern)
          (append Nat pattern (codes subject (codes yes (codes no tail)))))
    | ECoalesce operand fallback => Cons Nat 12 (codes operand (codes fallback tail))
    end;

-- Keep fuel opaque to native emission, as in the other parser laws.
def where_parser_fuel : Nat := parser_test_fuel;

def where_parses_shape
    (frontend : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (tokens : List Token) (expected : Expr) (expected_past : Nat) : Bool :=
    match frontend where_parser_fuel MExpr tokens 0 (VExpr (ESort 0)) with
    | PErr _ => False
    | POk value rest past =>
        match asExpr value with
        | Nothing => False
        | Just expr => andb (is_eof (peek rest))
            (andb (eqNat past expected_past)
              (list_eq Nat eq_nat (where_shape_codes expr (Nil Nat))
                (where_shape_codes expected (Nil Nat))))
        end
    end;

def where_rejected_at
    (frontend : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value)
    (tokens : List Token) (expected : Nat) : Bool :=
    match frontend where_parser_fuel MExpr tokens 0 (VExpr (ESort 0)) with
    | PErr position => eqNat position expected
    | POk _ _ _ => False
    end;

def where_positive_laws
    (frontend : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value) : Bool :=
    all Bool (fun (law : Bool) => law)
      ([where_parses_shape frontend
        [TIdent 12, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TColon, TIdent 20, TColonEq,
         TIdent 21, TSemi, TKeyword kwLet, TIdent 12, TColon, TIdent 20, TColonEq, TIdent 11, TSemi,
         TKeyword kwEnd, TEof]
        (ELet 11 (Just Expr (EVar 20)) (EVar 21) (ELet 12 (Just Expr (EVar 20)) (EVar 11) (EVar 12))) 17,
      where_parses_shape frontend
        [TIdent 11, TIdent 21, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TLparen, TIdent 30,
         TColon, TIdent 20, TRparen, TColon, TIdent 20, TColonEq, TIdent 30, TSemi, TKeyword kwEnd,
         TEof]
        (ELet 11 (Just Expr (EPi 30 (EVar 20) (EVar 20))) (ELam 30 (Just Expr (EVar 20)) (EVar 30)) (EApp (EVar 11) (EVar 21))) 16,
      where_parses_shape frontend
        [TIdent 21, TPipe, TIdent 11, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TLparen, TIdent 30,
         TColon, TIdent 20, TRparen, TColon, TIdent 20, TColonEq, TIdent 30, TSemi, TKeyword kwEnd,
         TEof]
        (ELet 11 (Just Expr (EPi 30 (EVar 20) (EVar 20))) (ELam 30 (Just Expr (EVar 20)) (EVar 30)) (EApp (EVar 11) (EVar 21))) 17,
      where_parses_shape frontend
        [TKeyword kwFun, TLparen, TIdent 31, TColon, TIdent 20, TRparen, TFatArrow, TIdent 11,
         TIdent 31, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TLparen, TIdent 30, TColon,
         TIdent 20, TRparen, TColon, TIdent 20, TColonEq, TIdent 30, TSemi, TKeyword kwEnd, TEof]
        (ELam 31 (Just Expr (EVar 20)) (ELet 11 (Just Expr (EPi 30 (EVar 20) (EVar 20))) (ELam 30 (Just Expr (EVar 20)) (EVar 30)) (EApp (EVar 11) (EVar 31)))) 23,
      where_parses_shape frontend
        [TLparen, TKeyword kwFun, TLparen, TIdent 31, TColon, TIdent 20, TRparen, TFatArrow,
         TIdent 11, TIdent 31, TRparen, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TLparen,
         TIdent 30, TColon, TIdent 20, TRparen, TColon, TIdent 20, TColonEq, TIdent 30, TSemi,
         TKeyword kwEnd, TEof]
        (ELet 11 (Just Expr (EPi 30 (EVar 20) (EVar 20))) (ELam 30 (Just Expr (EVar 20)) (EVar 30)) (ELam 31 (Just Expr (EVar 20)) (EApp (EVar 11) (EVar 31)))) 25,
      where_parses_shape frontend
        [TIdent 11, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TColon, TIdent 20, TColonEq,
         TIdent 12, TKeyword kwWhere, TKeyword kwLet, TIdent 12, TColon, TIdent 20, TColonEq,
         TIdent 21, TSemi, TKeyword kwEnd, TSemi, TKeyword kwEnd, TEof]
        (ELet 11 (Just Expr (EVar 20)) (ELet 12 (Just Expr (EVar 20)) (EVar 21) (EVar 12)) (EVar 11)) 19,
      where_parses_shape frontend
        [TKeyword kwLet, TIdent 12, TColon, TIdent 20, TColonEq, TIdent 21, TKeyword kwIn, TIdent 11,
         TKeyword kwWhere, TKeyword kwLet, TIdent 11, TColon, TIdent 20, TColonEq, TIdent 12, TSemi,
         TKeyword kwEnd, TEof]
        (ELet 12 (Just Expr (EVar 20)) (EVar 21) (ELet 11 (Just Expr (EVar 20)) (EVar 12) (EVar 11))) 17,
      where_parses_shape frontend
        [TIdent 11, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TColon, TIdent 20, TColonEq,
         TKeyword kwLet, TIdent 12, TColon, TIdent 20, TColonEq, TIdent 21, TKeyword kwIn, TIdent 12,
         TSemi, TKeyword kwEnd, TEof]
        (ELet 11 (Just Expr (EVar 20)) (ELet 12 (Just Expr (EVar 20)) (EVar 21) (EVar 12)) (EVar 11)) 17,
      where_parses_shape frontend
        [TIdent 21, TCoalesce, TIdent 22, TKeyword kwWhere, TKeyword kwLet, TIdent 22,
         TColon, TIdent 20, TColonEq, TIdent 23, TSemi, TKeyword kwEnd, TEof]
        (ELet 22 (Just Expr (EVar 20)) (EVar 23) (ECoalesce (EVar 21) (EVar 22))) 12] : List Bool);

def where_negative_laws
    (frontend : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value) : Bool :=
    all Bool (fun (law : Bool) => law)
      ([where_rejected_at frontend
        [TIdent 11, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TColon, TIdent 20, TColonEq,
         TIdent 21, TKeyword kwEnd, TEof] 8,
        where_rejected_at frontend
        [TIdent 11, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TColon, TIdent 20, TColonEq,
         TIdent 21, TSemi, TEof] 9,
        where_rejected_at frontend
        [TIdent 11, TKeyword kwWhere, TKeyword kwLet, TExclam, TIdent 11, TColonEq, TIdent 21, TSemi,
         TKeyword kwEnd, TEof] 3,
        where_rejected_at frontend
        [TIdent 11, TKeyword kwWhere, TKeyword kwLet, TIdent 11, TIdent 30, TColonEq, TIdent 21,
         TSemi, TKeyword kwEnd, TEof] 4] : List Bool);

-- A where owned by another grammar is not consumed as a helper block.
def where_boundary_laws
    (frontend : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value) : Bool :=
    let untouched : Bool :=
      match frontend where_parser_fuel MExpr
          [TIdent 11, TKeyword kwWhere, TBar, TEof] 0 (VExpr (ESort 0)) with
      | PErr _ => False
      | POk value rest past =>
          match asExpr value with
          | Nothing => False
          | Just expr => andb (eqNat past 1)
              (andb (eqNat (token_nat_payload (peek rest)) kwWhere)
                (list_eq Nat eq_nat (where_shape_codes expr (Nil Nat)) [1, 11]))
          end
      end in
    let exhausted : Bool :=
      match frontend 0 MExpr [TIdent 11, TEof] 0 (VExpr (ESort 0)) with
      | PErr position => eqNat position 0
      | POk _ _ _ => False
      end in
    andb untouched exhausted;

def where_parser_laws
    (frontend : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value) : Bool :=
    andb (where_positive_laws frontend)
      (andb (where_negative_laws frontend) (where_boundary_laws frontend));

-- @entry main
def main : IO Unit :=
    let direct : Bool := where_parser_laws parse in
    let packed : Bool := where_parser_laws (close_parse parse_a parse_b) in
    let spanned : Bool := where_parser_laws parse_spanned in
    match andb direct (andb packed spanned) with
    | True => println "ERGO_WHERE_PARSER_OK"
    | False => do eprintln "ERGO_WHERE_PARSER_FAIL"; exit 1
    end;
