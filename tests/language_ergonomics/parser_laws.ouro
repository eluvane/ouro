                                | EMatch _ _ => False
                                | EFix _ _ _ _ => False
                                | EEffectRow _ _ => False
                                | EPerform _ _ => False
                                | EDo _ => False
                                | EHandle _ _ => False
                                | EBranch _ _ _ => False
                                | ENoBranch => False
                                | EBinder _ _ _ => False
                                | ENoBinder => False
                                | EMultiMatch _ _ => False
                                | EStr _ => False
                                | EDoBind _ _ => False
                                | EList _ => False
                                | ESpan _ _ _ => False
                                | EFallible _ _ _ _ => False
                                | EOpen _ _ => False
                                | EListSpread _ _ => False
                                | ENamedCall _ _ => False
                                | ERange _ _ _ => False
                                | EIf _ _ _ => False
                                | EIfLet _ _ _ _ => False
                                | ECoalesce _ _ => False
                                end
                            | EVar _ => False
                            | EHole _ => False
                            | ESort _ => False
                            | ENat _ => False
                            | EApp _ _ => False
                            | ELam _ _ _ => False
                            | EPi _ _ _ => False
                            | ELet _ _ _ _ => False
                            | EAscribe _ _ => False
