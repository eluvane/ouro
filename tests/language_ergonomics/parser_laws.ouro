-- Exercise declaration parsing directly, without the dependency scanner.
-- Both ordinary dispatch and the packed/bootstrap closure run these laws.
import "../../compiler/parser.ouro";
import "../../std/io.ouro";

def erg_import_id (decl : Decl) : Nat :=
    match decl with
    | DImport path => path
    | DDef _ _ _ _ _ => Z
    | DAxiom _ _ => Z
    | DInductive _ _ _ _ _ => Z
    | DEffect _ _ _ => Z
    | DIntrinsic _ _ _ _ => Z
    | DExtern _ _ _ => Z
    | DRepresentation _ _ => Z
    end;

def erg_same_ids : List Nat -> List Nat -> Bool :=
  fix same (left : List Nat) (right : List Nat) : Bool :=
    match left with
    | Nil => match right with | Nil => True | Cons _ _ => False end
    | Cons x xs =>
        match right with
        | Nil => False
        | Cons y ys => andb(eqNat x y, same xs ys)
        end
    end;

-- Keep parser fuel opaque to native C emission so it cannot unroll the parser.
def erg_parser_fuel : Nat :=
    (fix go (n : Nat) : Nat := match n with | Z => add 1500 1500 | S k => go k end) 0;

def erg_parse_imports
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : List Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => False
    | POk decls rest _ =>
        andb (is_eof (peek rest))
          (erg_same_ids(map Decl Nat erg_import_id decls, expected))
    end;

def erg_parse_error
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr position => eqNat position expected
    | POk _ _ _ => False
    end;

def erg_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TSemi, TKeyword kwImport, TString 12, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 11, TEof] [11, 11])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TSemi, TEof] [11])
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TComma, TString 12, TSemi, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TSemi, TEof] 1)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TString 12, TSemi, TEof] 2)
      (erg_parse_error frontend
        [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TEof] 5)))))))));

def erg_var_name (expr : Expr) : Maybe Nat :=
    match expr with
    | EVar name => Just Nat name
    | EHole _ => Nothing Nat
    | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat
    | EApp _ _ => Nothing Nat
    | ELam _ _ _ => Nothing Nat
    | EPi _ _ _ => Nothing Nat
    | ELet _ _ _ _ => Nothing Nat
    | EAscribe _ _ => Nothing Nat
    | EMatch _ _ => Nothing Nat
    | EFix _ _ _ _ => Nothing Nat
    | EEffectRow _ _ => Nothing Nat
    | EPerform _ _ => Nothing Nat
    | EDo _ => Nothing Nat
    | EHandle _ _ => Nothing Nat
    | EBranch _ _ _ => Nothing Nat
    | ENoBranch => Nothing Nat
    | EBinder _ _ _ => Nothing Nat
    | ENoBinder => Nothing Nat
    | EMultiMatch _ _ => Nothing Nat
    | EStr _ => Nothing Nat
    | EDoBind _ _ => Nothing Nat
    | EList _ => Nothing Nat
    | ESpan _ _ _ => Nothing Nat
    | EFallible _ _ _ _ => Nothing Nat
    | EOpen _ _ => Nothing Nat
    | EListSpread _ _ => Nothing Nat
    | ENamedCall _ _ => Nothing Nat
    | ERange _ _ _ => Nothing Nat
    end;

def erg_block_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | ELet binder annotation rhs result =>
                    match annotation with
                    | Nothing => False
                    | Just ann =>
                        match erg_var_name ann with
                        | Nothing => False
                        | Just ty =>
                            match erg_var_name rhs with
                            | Nothing => False
                            | Just value =>
                                match erg_var_name result with
                                | Nothing => False
                                | Just used =>
                                    andb (eqNat name 10)
                                      (andb (eqNat binder 12)
                                        (andb (eqNat ty 11)
                                          (andb (eqNat value 13) (eqNat used 12))))
                                end
                            end
                        end
                    end
                | EVar _ => False
                | EHole _ => False
                | ESort _ => False
                | ENat _ => False
                | EApp _ _ => False
                | ELam _ _ _ => False
                | EPi _ _ _ => False
                | EAscribe _ _ => False
                | EMatch _ _ => False
                | EFix _ _ _ _ => False
                | EEffectRow _ _ => False
                | EPerform _ _ => False
                | EDo _ => False
                | EHandle _ _ => False
                | EBranch _ _ _ => False
                | ENoBranch => False
                | EBinder _ _ _ => False
                | ENoBinder => False
                | EMultiMatch _ _ => False
                | EStr _ => False
                | EDoBind _ _ => False
                | EList _ => False
                | ESpan _ _ _ => False
                | EFallible _ _ _ _ => False
                | EOpen _ _ => False
                | EListSpread _ _ => False
                | ENamedCall _ _ => False
                | ERange _ _ _ => False
                end
            | DAxiom _ _ => False
            | DInductive _ _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def erg_parse_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TKeyword kwLet, TIdent 12, TColon,
       TIdent 11, TColonEq, TIdent 13, TSemi, TIdent 12, TBraceR,
       TSemi, TEof] Z with
    | PErr _ => False
    | POk decls rest _ => andb (is_eof (peek rest)) (erg_block_shape decls)
    end;

def erg_reject_empty_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TBraceR, TSemi, TEof] Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_parse_rejected
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_destructure_shape (decls : List Decl)
    (fields : List Nat) : Bool :=
    match decls with
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | EMatch subject branches =>
                    match subject with
                    | EVar source =>
                        match branches with
                        | EBranch packed used remaining =>
                            match remaining with
                            | ENoBranch =>
                                match used with
                                | EVar binder =>
                                    andb(eqNat name 10,
                                      andb(eqNat source 14,
                                        andb(eqNat binder 12,
                                          erg_same_ids packed (Cons Nat 11 fields))))
                                | EHole _ => False
                                | ESort _ => False
                                | ENat _ => False
                                | EApp _ _ => False
                                | ELam _ _ _ => False
                                | EPi _ _ _ => False
                                | ELet _ _ _ _ => False
                                | EAscribe _ _ => False
                                | EMatch _ _ => False
                                | EFix _ _ _ _ => False
                                | EEffectRow _ _ => False
                                | EPerform _ _ => False
                                | EDo _ => False
                                | EHandle _ _ => False
                                | EBranch _ _ _ => False
                                | ENoBranch => False
                                | EBinder _ _ _ => False
                                | ENoBinder => False
                                | EMultiMatch _ _ => False
                                | EStr _ => False
                                | EDoBind _ _ => False
                                | EList _ => False
                                | ESpan _ _ _ => False
                                | EFallible _ _ _ _ => False
                                | EOpen _ _ => False
                                | EListSpread _ _ => False
                                | ENamedCall _ _ => False
                                | ERange _ _ _ => False
                                end
                            | EVar _ => False
                            | EHole _ => False
                            | ESort _ => False
                            | ENat _ => False
                            | EApp _ _ => False
                            | ELam _ _ _ => False
                            | EPi _ _ _ => False
                            | ELet _ _ _ _ => False
                            | EAscribe _ _ => False
                            | EMatch _ _ => False
                            | EFix _ _ _ _ => False
                            | EEffectRow _ _ => False
                            | EPerform _ _ => False
                            | EDo _ => False
                            | EHandle _ _ => False
                            | EBranch _ _ _ => False
                            | EBinder _ _ _ => False
                            | ENoBinder => False
                            | EMultiMatch _ _ => False
                            | EStr _ => False
                            | EDoBind _ _ => False
                            | EList _ => False
                            | ESpan _ _ _ => False
                            | EFallible _ _ _ _ => False
                            | EOpen _ _ => False
                            | EListSpread _ _ => False
                            | ENamedCall _ _ => False
                            | ERange _ _ _ => False
                            end
                        | EVar _ => False
                        | EHole _ => False
                        | ESort _ => False
                        | ENat _ => False
                        | EApp _ _ => False
                        | ELam _ _ _ => False
                        | EPi _ _ _ => False
                        | ELet _ _ _ _ => False
                        | EAscribe _ _ => False
                        | EMatch _ _ => False
                        | EFix _ _ _ _ => False
                        | EEffectRow _ _ => False
                        | EPerform _ _ => False
                        | EDo _ => False
                        | EHandle _ _ => False
                        | ENoBranch => False
                        | EBinder _ _ _ => False
                        | ENoBinder => False
                        | EMultiMatch _ _ => False
                        | EStr _ => False
                        | EDoBind _ _ => False
                        | EList _ => False
                        | ESpan _ _ _ => False
                        | EFallible _ _ _ _ => False
                        | EOpen _ _ => False
                        | EListSpread _ _ => False
                        | ENamedCall _ _ => False
                        | ERange _ _ _ => False
                        end
                    | EHole _ => False
                    | ESort _ => False
                    | ENat _ => False
                    | EApp _ _ => False
                    | ELam _ _ _ => False
                    | EPi _ _ _ => False
                    | ELet _ _ _ _ => False
                    | EAscribe _ _ => False
                    | EMatch _ _ => False
                    | EFix _ _ _ _ => False
                    | EEffectRow _ _ => False
                    | EPerform _ _ => False
                    | EDo _ => False
                    | EHandle _ _ => False
                    | EBranch _ _ _ => False
                    | ENoBranch => False
                    | EBinder _ _ _ => False
                    | ENoBinder => False
                    | EMultiMatch _ _ => False
                    | EStr _ => False
                    | EDoBind _ _ => False
                    | EList _ => False
                    | ESpan _ _ _ => False
                    | EFallible _ _ _ _ => False
                    | EOpen _ _ => False
                    | EListSpread _ _ => False
                    | ENamedCall _ _ => False
                    | ERange _ _ _ => False
                    end
                | EVar _ => False
                | EHole _ => False
                | ESort _ => False
                | ENat _ => False
                | EApp _ _ => False
                | ELam _ _ _ => False
                | EPi _ _ _ => False
                | ELet _ _ _ _ => False
                | EAscribe _ _ => False
                | EFix _ _ _ _ => False
                | EEffectRow _ _ => False
                | EPerform _ _ => False
                | EDo _ => False
                | EHandle _ _ => False
                | EBranch _ _ _ => False
                | ENoBranch => False
                | EBinder _ _ _ => False
                | ENoBinder => False
                | EMultiMatch _ _ => False
                | EStr _ => False
                | EDoBind _ _ => False
                | EList _ => False
                | ESpan _ _ _ => False
                | EFallible _ _ _ _ => False
                | EOpen _ _ => False
                | EListSpread _ _ => False
                | ENamedCall _ _ => False
                | ERange _ _ _ => False
                end
            | DAxiom _ _ => False
            | DInductive _ _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    | Nil => False
    end;

def erg_parse_destructure
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (fields : List Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => False
    | POk decls rest _ =>
        andb(is_eof(peek rest), erg_destructure_shape decls fields)
    end;

def erg_destructure_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let ordinary : Bool := erg_parse_destructure frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwLet, TLparen, TIdent 11, TIdent 12, TIdent 13,
       TRparen, TColonEq, TIdent 14, TKeyword kwIn, TIdent 12,
       TSemi, TEof] [12, 13] in
    let block : Bool := erg_parse_destructure frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwLet, TBraceL, TKeyword kwLet, TLparen,
       TIdent 11, TIdent 12, THole (Nothing Nat), TRparen,
       TColonEq, TIdent 14, TSemi, TIdent 12, TBraceR,
       TSemi, TEof] [12, Z] in
    let missing_close : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwLet, TLparen, TIdent 11, TIdent 12,
       TColonEq, TIdent 14, TKeyword kwIn, TIdent 12, TSemi, TEof] in
    let repeated : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwLet, TLparen, TIdent 11, TIdent 12, TIdent 12,
       TRparen, TColonEq, TIdent 14, TKeyword kwIn, TIdent 12,
       TSemi, TEof] in
    let nested : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwLet, TLparen, TIdent 11, TLparen, TIdent 12,
       TRparen, TRparen, TColonEq, TIdent 14, TKeyword kwIn,
       TIdent 12, TSemi, TEof] in
    andb ordinary (andb block (andb missing_close (andb repeated nested)));

def erg_parse_one_declaration
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => False
    | POk decls rest _ =>
        andb(is_eof (peek rest), eqNat(length Decl decls, 1))
    end;

def erg_parse_rejected
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_do_pure_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let pure_first : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TKeyword kwLet, TIdent 12, TColonEq,
       TIdent 13, TSemi, TIdent 12, TSemi, TEof] in
    let no_final_semi : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TKeyword kwLet, TIdent 12, TColonEq,
       TIdent 13, TSemi, TIdent 12, TEof] in
    let actions : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TIdent 13, TSemi, TIdent 14, TSemi, TEof] in
    let after_action : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TIdent 13, TSemi, TKeyword kwLet,
       TIdent 12, TColonEq, TIdent 13, TSemi, TIdent 12, TSemi, TEof] in
    let effect_bind : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TKeyword kwLet, TExclam, TIdent 12,
       TColonEq, TIdent 13, TSemi, TIdent 12, TSemi, TEof] in
    let nested : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TKeyword kwLet, TIdent 12, TColonEq,
       TLparen, TKeyword kwDo, TIdent 13, TRparen, TSemi,
       TKeyword kwLet, TExclam, TIdent 14, TColonEq, TIdent 12,
       TSemi, TIdent 14, TSemi, TEof] in
    let followed_by_def : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TKeyword kwDo, TKeyword kwLet, TIdent 12, TColonEq,
         TIdent 13, TSemi, TIdent 12, TSemi,
         TKeyword kwDef, TIdent 14, TColon, TIdent 11,
         TColonEq, TIdent 13, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb (is_eof (peek rest)) (eqNat (length Decl decls) 2)
      end in
    let no_tail : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TKeyword kwLet, TIdent 12, TColonEq,
       TIdent 13, TSemi, TEof] in
    let trailing_let : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TIdent 13, TSemi, TKeyword kwLet,
       TIdent 12, TColonEq, TIdent 13, TSemi, TEof] in
    let no_separator : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwDo, TKeyword kwLet, TIdent 12, TColonEq,
       TIdent 13, TIdent 12, TSemi, TEof] in
    let accepted : Bool := andb pure_first
      (andb no_final_semi (andb actions
        (andb after_action (andb effect_bind
          (andb nested followed_by_def))))) in
    let rejected : Bool := andb no_tail
      (andb trailing_let no_separator) in
    andb accepted rejected;

def erg_if_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool := match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwIf, TIdent 11, TKeyword kwThen, TIdent 12,
       TKeyword kwElse, TIdent 13, TSemi, TEof] Z with
      | PErr _ => False
      | POk declarations rest _ =>
          andb (is_eof (peek rest))
            (match declarations with
             | Nil => False
             | Cons declaration tail =>
                 andb (nullb Decl tail)
                   (match declaration with
                    | DDef _ _ body _ _ => match body with
                      | EIf condition yes no =>
                          match condition with
                          | EVar test => match yes with
                            | EVar first => match no with
                              | EVar second =>
                                  andb (eqNat test 11)
                                    (andb (eqNat first 12) (eqNat second 13))
                              | EHole _ => False
                              | ESort _ => False
                              | ENat _ => False
                              | EApp _ _ => False
                              | ELam _ _ _ => False
                              | EPi _ _ _ => False
                              | ELet _ _ _ _ => False
                              | EAscribe _ _ => False
                              | EMatch _ _ => False
                              | EFix _ _ _ _ => False
                              | EEffectRow _ _ => False
                              | EPerform _ _ => False
                              | EDo _ => False
                              | EHandle _ _ => False
                              | EBranch _ _ _ => False
                              | ENoBranch => False
                              | EBinder _ _ _ => False
                              | ENoBinder => False
                              | EMultiMatch _ _ => False
                              | EStr _ => False
                              | EDoBind _ _ => False
                              | EList _ => False
                              | ESpan _ _ _ => False
                              | EFallible _ _ _ _ => False
                              | EOpen _ _ => False
                              | EListSpread _ _ => False
                              | ENamedCall _ _ => False
                              | ERange _ _ _ => False
                              | EIf _ _ _ => False
                              end
                            | EHole _ => False
                            | ESort _ => False
                            | ENat _ => False
                            | EApp _ _ => False
                            | ELam _ _ _ => False
                            | EPi _ _ _ => False
                            | ELet _ _ _ _ => False
                            | EAscribe _ _ => False
                            | EMatch _ _ => False
                            | EFix _ _ _ _ => False
                            | EEffectRow _ _ => False
                            | EPerform _ _ => False
                            | EDo _ => False
                            | EHandle _ _ => False
                            | EBranch _ _ _ => False
                            | ENoBranch => False
                            | EBinder _ _ _ => False
                            | ENoBinder => False
                            | EMultiMatch _ _ => False
                            | EStr _ => False
                            | EDoBind _ _ => False
                            | EList _ => False
                            | ESpan _ _ _ => False
                            | EFallible _ _ _ _ => False
                            | EOpen _ _ => False
                            | EListSpread _ _ => False
                            | ENamedCall _ _ => False
                            | ERange _ _ _ => False
                            | EIf _ _ _ => False
                            end
                          | EHole _ => False
                          | ESort _ => False
                          | ENat _ => False
                          | EApp _ _ => False
                          | ELam _ _ _ => False
                          | EPi _ _ _ => False
                          | ELet _ _ _ _ => False
                          | EAscribe _ _ => False
                          | EMatch _ _ => False
                          | EFix _ _ _ _ => False
                          | EEffectRow _ _ => False
                          | EPerform _ _ => False
                          | EDo _ => False
                          | EHandle _ _ => False
                          | EBranch _ _ _ => False
                          | ENoBranch => False
                          | EBinder _ _ _ => False
                          | ENoBinder => False
                          | EMultiMatch _ _ => False
                          | EStr _ => False
                          | EDoBind _ _ => False
                          | EList _ => False
                          | ESpan _ _ _ => False
                          | EFallible _ _ _ _ => False
                          | EOpen _ _ => False
                          | EListSpread _ _ => False
                          | ENamedCall _ _ => False
                          | ERange _ _ _ => False
                          | EIf _ _ _ => False
                          end
                      | EVar _ => False
                      | EHole _ => False
                      | ESort _ => False
                      | ENat _ => False
                      | EApp _ _ => False
                      | ELam _ _ _ => False
                      | EPi _ _ _ => False
                      | ELet _ _ _ _ => False
                      | EAscribe _ _ => False
                      | EMatch _ _ => False
                      | EFix _ _ _ _ => False
                      | EEffectRow _ _ => False
                      | EPerform _ _ => False
                      | EDo _ => False
                      | EHandle _ _ => False
                      | EBranch _ _ _ => False
                      | ENoBranch => False
                      | EBinder _ _ _ => False
                      | ENoBinder => False
                      | EMultiMatch _ _ => False
                      | EStr _ => False
                      | EDoBind _ _ => False
                      | EList _ => False
                      | ESpan _ _ _ => False
                      | EFallible _ _ _ _ => False
                      | EOpen _ _ => False
                      | EListSpread _ _ => False
                      | ENamedCall _ _ => False
                      | ERange _ _ _ => False
                      end
                    | DAxiom _ _ => False
                    | DInductive _ _ _ _ _ => False
                    | DEffect _ _ _ => False
                    | DImport _ => False
                    | DIntrinsic _ _ _ _ => False
                    | DExtern _ _ _ => False
                    | DRepresentation _ _ => False
                    end)
             end)
      end in
    andb accepted (erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwIf, TIdent 11, TKeyword kwThen, TIdent 12,
       TSemi, TEof]);

def erg_iflet_var_is (expected : Nat) (expr : Expr) : Bool :=
    match expr with
    | EVar name => eqNat name expected
    | EHole _ => False
    | ESort _ => False
    | ENat _ => False
    | EApp _ _ => False
    | ELam _ _ _ => False
    | EPi _ _ _ => False
    | ELet _ _ _ _ => False
    | EAscribe _ _ => False
    | EMatch _ _ => False
    | EFix _ _ _ _ => False
    | EEffectRow _ _ => False
    | EPerform _ _ => False
    | EDo _ => False
    | EHandle _ _ => False
    | EBranch _ _ _ => False
    | ENoBranch => False
    | EBinder _ _ _ => False
    | ENoBinder => False
    | EMultiMatch _ _ => False
    | EStr _ => False
    | EDoBind _ _ => False
    | EList _ => False
    | ESpan _ _ _ => False
    | EFallible _ _ _ _ => False
    | EOpen _ _ => False
    | EListSpread _ _ => False
    | ENamedCall _ _ => False
    | ERange _ _ _ => False
    | EIf _ _ _ => False
    | EIfLet _ _ _ _ => False
    end;

def erg_iflet_declaration_shape (declaration : Decl) (legacy : Bool) : Bool :=
    match declaration with
    | DDef _ _ body _ _ => match body with
      | EIfLet pattern subject yes no =>
          match pattern with
          | Nil => False
          | Cons ctor binders => match binders with
            | Nil => False
            | Cons binder remaining =>
                andb (notb legacy)
                  (andb (nullb Nat remaining)
                    (andb (eqNat ctor 14)
                      (andb (eqNat binder 15)
                        (andb (erg_iflet_var_is 11 subject)
                          (andb (erg_iflet_var_is 15 yes)
                            (erg_iflet_var_is 13 no))))))
            end
          end
      | EIf _ _ _ => legacy
      | EVar _ => False
      | EHole _ => False
      | ESort _ => False
      | ENat _ => False
      | EApp _ _ => False
      | ELam _ _ _ => False
      | EPi _ _ _ => False
      | ELet _ _ _ _ => False
      | EAscribe _ _ => False
      | EMatch _ _ => False
      | EFix _ _ _ _ => False
      | EEffectRow _ _ => False
      | EPerform _ _ => False
      | EDo _ => False
      | EHandle _ _ => False
      | EBranch _ _ _ => False
      | ENoBranch => False
      | EBinder _ _ _ => False
      | ENoBinder => False
      | EMultiMatch _ _ => False
      | EStr _ => False
      | EDoBind _ _ => False
      | EList _ => False
      | ESpan _ _ _ => False
      | EFallible _ _ _ _ => False
      | EOpen _ _ => False
      | EListSpread _ _ => False
      | ENamedCall _ _ => False
      | ERange _ _ _ => False
      end
    | DAxiom _ _ => False
    | DInductive _ _ _ _ _ => False
    | DEffect _ _ _ => False
    | DImport _ => False
    | DIntrinsic _ _ _ _ => False
    | DExtern _ _ _ => False
    | DRepresentation _ _ => False
    end;

def erg_iflet_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool := match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwIf, TKeyword kwLet, TIdent 14, TIdent 15,
       TColonEq, TIdent 11, TKeyword kwThen, TIdent 15,
       TKeyword kwElse, TIdent 13, TSemi, TEof] Z with
      | PErr _ => False
      | POk declarations rest _ =>
          andb (is_eof (peek rest))
            (match declarations with
             | Nil => False
             | Cons declaration tail =>
                 andb (nullb Decl tail)
                   (erg_iflet_declaration_shape declaration False)
             end)
      end in
    let legacy_condition : Bool := match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwIf, TKeyword kwLet, TIdent 14, TColonEq,
       TIdent 11, TKeyword kwIn, TIdent 14, TKeyword kwThen,
       TIdent 12, TKeyword kwElse, TIdent 13, TSemi, TEof] Z with
      | PErr _ => False
      | POk declarations rest _ =>
          andb (is_eof (peek rest))
            (match declarations with
             | Cons declaration tail =>
                 andb (nullb Decl tail)
                   (erg_iflet_declaration_shape declaration True)
             | Nil => False
             end)
      end in
    andb accepted (andb legacy_condition
      (andb (erg_parse_rejected frontend
        [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
         TKeyword kwIf, TKeyword kwLet, TIdent 14, TIdent 15,
         TColonEq, TIdent 11, TKeyword kwThen, TIdent 15,
         TSemi, TEof])
        (erg_parse_rejected frontend
          [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
           TKeyword kwIf, TKeyword kwLet, TIdent 14, TIdent 15,
           TIdent 11, TKeyword kwThen, TIdent 15,
           TKeyword kwElse, TIdent 13, TSemi, TEof])));

def erg_list_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let single : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TIdent 30, TComma, TBracketR, TSemi, TEof] in
    let multiple : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TIdent 30, TComma, TIdent 31, TComma, TBracketR, TSemi, TEof] in
    let leading : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TComma, TIdent 30, TBracketR, TSemi, TEof] in
    let doubled : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TIdent 30, TComma, TComma, TIdent 31, TBracketR, TSemi, TEof] in
    andb single (andb multiple (andb leading doubled));

def erg_fallible_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | EFallible container failure success block =>
                    match erg_var_name container with
                    | Nothing => False
                    | Just container_id =>
                        match block with
                        | ELet binder annotation value used_expr =>
                            match annotation with
                            | Nothing => False
                            | Just ann_expr =>
                                match erg_var_name used_expr with
                                | Nothing => False
                                | Just used =>
                                    match fallible_postfix value with
                                    | Nothing => False
                                    | Just operand =>
                                        match erg_var_name ann_expr with
                                        | Nothing => False
                                        | Just annotation_id =>
                                            match erg_var_name operand with
                                            | Nothing => False
                                            | Just source =>
                                                andb (eqNat name 10)
                                                  (andb (eqNat container_id 11)
                                                    (andb (eqNat failure 12)
                                                      (andb (eqNat success 13)
                                                        (andb (eqNat binder 14)
                                                          (andb (eqNat annotation_id 15)
                                                            (andb (eqNat source 16) (eqNat used 14)))))))
                                            end
                                        end
                                    end
                                end
                            end
                        | EVar _ => False
                        | EHole _ => False
                        | ESort _ => False
                        | ENat _ => False
                        | EApp _ _ => False
                        | ELam _ _ _ => False
                        | EPi _ _ _ => False
                        | EAscribe _ _ => False
                        | EMatch _ _ => False
                        | EFix _ _ _ _ => False
                        | EEffectRow _ _ => False
                        | EPerform _ _ => False
                        | EDo _ => False
                        | EHandle _ _ => False
                        | EBranch _ _ _ => False
                        | ENoBranch => False
                        | EBinder _ _ _ => False
                        | ENoBinder => False
                        | EMultiMatch _ _ => False
                        | EStr _ => False
                        | EDoBind _ _ => False
                        | EList _ => False
                        | ESpan _ _ _ => False
                        | EFallible _ _ _ _ => False
                        | EOpen _ _ => False
                        | EListSpread _ _ => False
                        | ENamedCall _ _ => False
                        | ERange _ _ _ => False
                        end
                    end
                | EVar _ => False
                | EHole _ => False
                | ESort _ => False
                | ENat _ => False
                | EApp _ _ => False
                | ELam _ _ _ => False
                | EPi _ _ _ => False
                | ELet _ _ _ _ => False
                | EAscribe _ _ => False
                | EMatch _ _ => False
                | EFix _ _ _ _ => False
                | EEffectRow _ _ => False
                | EPerform _ _ => False
                | EDo _ => False
                | EHandle _ _ => False
                | EBranch _ _ _ => False
                | ENoBranch => False
                | EBinder _ _ _ => False
                | ENoBinder => False
                | EMultiMatch _ _ => False
                | EStr _ => False
                | EDoBind _ _ => False
                | EList _ => False
                | ESpan _ _ _ => False
                | EOpen _ _ => False
                | EListSpread _ _ => False
                | ENamedCall _ _ => False
                | ERange _ _ _ => False
                end
            | DAxiom _ _ => False
            | DInductive _ _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def erg_fallible_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TKeyword kwLet, THole (Just Nat Z), TLparen, TIdent 12, TComma,
         TIdent 13, TRparen, TColon, TIdent 11, TKeyword kwDo,
         TKeyword kwLet, TIdent 14, TColon, TIdent 15, TColonEq,
         TIdent 16, THole (Just Nat Z), TSemi, TIdent 14,
         TKeyword kwEnd, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb (is_eof (peek rest)) (erg_fallible_shape decls)
      end in
    let rejected : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TKeyword kwLet, THole (Just Nat Z), TLparen, TIdent 12, TComma,
         TIdent 13, TRparen, TColon, TIdent 11, TKeyword kwDo,
         TKeyword kwEnd, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted rejected;

def erg_implicit_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration rest =>
        match rest with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DInductive name params _ _ marked =>
                match params with
                | Nil => False
                | Cons first tail =>
                    match first, tail with
                    | MkPair binder ty, Nil =>
                        match ty with
                        | ESort level =>
                            andb(eqNat name 10,
                              andb(eqNat binder 11,
                                andb(eqNat level Z, eqNat marked 1)))
                        | EVar _ => False
                        | EHole _ => False
                        | ENat _ => False
                        | EApp _ _ => False
                        | ELam _ _ _ => False
                        | EPi _ _ _ => False
                        | ELet _ _ _ _ => False
                        | EAscribe _ _ => False
                        | EMatch _ _ => False
                        | EFix _ _ _ _ => False
                        | EEffectRow _ _ => False
                        | EPerform _ _ => False
                        | EDo _ => False
                        | EHandle _ _ => False
                        | EBranch _ _ _ => False
                        | ENoBranch => False
                        | EBinder _ _ _ => False
                        | ENoBinder => False
                        | EMultiMatch _ _ => False
                        | EStr _ => False
                        | EDoBind _ _ => False
                        | EList _ => False
                        | ESpan _ _ _ => False
                        | EFallible _ _ _ _ => False
                        | EOpen _ _ => False
                        | EListSpread _ _ => False
                        | ENamedCall _ _ => False
                        | ERange _ _ _ => False
                        end
                    | MkPair _ _, Cons _ _ => False
                    end
                end
            | DDef _ _ _ _ _ => False
            | DAxiom _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def erg_implicit_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb(is_eof(peek rest), erg_implicit_shape decls)
      end in
    let bad_level : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TBraceL, TIdent 11, TColon,
         TType 1, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    let nonleading : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TLparen, TIdent 13,
         TColon, TType Z, TRparen, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted (andb bad_level nonleading);

def erg_marked_def_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name signature _ marked declared =>
                andb(eqNat name 10,
                  andb(eqNat marked 1,
                    andb(eqNat(length DefParam declared) 2,
                      (match signature with
                       | EPi type_name _ rest =>
                           andb(eqNat type_name 11,
                             (match rest with
                              | EPi value_name _ _ => eqNat value_name 12
                              | EVar _ => False
                              | EHole _ => False
                              | ESort _ => False
                              | ENat _ => False
                              | EApp _ _ => False
                              | ELam _ _ _ => False
                              | ELet _ _ _ _ => False
                              | EAscribe _ _ => False
                              | EMatch _ _ => False
                              | EIf _ _ _ => False
                              | EIfLet _ _ _ _ => False
                              | EFix _ _ _ _ => False
                              | EEffectRow _ _ => False
                              | EPerform _ _ => False
                              | EDo _ => False
                              | EHandle _ _ => False
                              | EBranch _ _ _ => False
                              | ENoBranch => False
                              | EBinder _ _ _ => False
                              | ENoBinder => False
                              | EMultiMatch _ _ => False
                              | EStr _ => False
                              | EDoBind _ _ => False
                              | EList _ => False
                              | EListSpread _ _ => False
                              | ERange _ _ _ => False
                              | ESpan _ _ _ => False
                              | EFallible _ _ _ _ => False
                              | EOpen _ _ => False
                              | ENamedCall _ _ => False
                              end))
                       | EVar _ => False
                       | EHole _ => False
                       | ESort _ => False
                       | ENat _ => False
                       | EApp _ _ => False
                       | ELam _ _ _ => False
                       | ELet _ _ _ _ => False
                       | EAscribe _ _ => False
                       | EMatch _ _ => False
                       | EIf _ _ _ => False
                       | EIfLet _ _ _ _ => False
                       | EFix _ _ _ _ => False
                       | EEffectRow _ _ => False
                       | EPerform _ _ => False
                       | EDo _ => False
                       | EHandle _ _ => False
                       | EBranch _ _ _ => False
                       | ENoBranch => False
                       | EBinder _ _ _ => False
                       | ENoBinder => False
                       | EMultiMatch _ _ => False
                       | EStr _ => False
                       | EDoBind _ _ => False
                       | EList _ => False
                       | EListSpread _ _ => False
                              | ERange _ _ _ => False
                       | ESpan _ _ _ => False
                       | EFallible _ _ _ _ => False
                       | EOpen _ _ => False
                       | ENamedCall _ _ => False
                       end))))
            | DAxiom _ _ => False
            | DInductive _ _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def erg_marked_def_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TLparen, TIdent 12, TColon, TIdent 11,
         TRparen, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb(is_eof(peek rest), erg_marked_def_shape decls)
      end in
    let bad_level : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TBraceL, TIdent 11, TColon,
         TType 1, TBraceR, TLparen, TIdent 12, TColon, TIdent 11,
         TRparen, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    let nonleading : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TLparen, TIdent 12, TColon,
         TType Z, TRparen, TBraceL, TIdent 11, TColon, TType Z,
         TBraceR, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted (andb bad_level nonleading);

-- @entry main
def main : IO Unit :=
    let destructure : Bool := andb (erg_destructure_laws (parse_file parse))
      (erg_destructure_laws (closed_parse_file parse_a parse_b)) in
    let direct : Bool := andb (erg_parser_laws (parse_file parse))
      (andb (erg_list_parser_laws (parse_file parse))
        (andb (erg_parse_block (parse_file parse))
          (erg_reject_empty_block (parse_file parse)))) in
    let closed : Bool := andb (erg_parser_laws (closed_parse_file parse_a parse_b))
      (andb (erg_list_parser_laws (closed_parse_file parse_a parse_b))
        (andb (erg_parse_block (closed_parse_file parse_a parse_b))
          (erg_reject_empty_block (closed_parse_file parse_a parse_b)))) in
    let do_pure : Bool := andb (erg_do_pure_laws (parse_file parse))
      (erg_do_pure_laws (closed_parse_file parse_a parse_b)) in
    let prior : Bool := andb do_pure (andb destructure (andb (andb direct closed)
        (andb (erg_fallible_laws (parse_file parse))
          (andb (erg_fallible_laws (closed_parse_file parse_a parse_b))
            (andb (erg_implicit_laws (parse_file parse))
              (andb (erg_implicit_laws (closed_parse_file parse_a parse_b))
                (andb (erg_marked_def_laws (parse_file parse))
                  (erg_marked_def_laws (closed_parse_file parse_a parse_b))))))))) in
    match andb prior
        (andb (erg_if_parser_laws (parse_file parse))
          (andb (erg_if_parser_laws (closed_parse_file parse_a parse_b))
            (andb (erg_iflet_parser_laws (parse_file parse))
              (erg_iflet_parser_laws (closed_parse_file parse_a parse_b))))) with
    | True => println "ERGO_PARSER_OK"
    | False => do eprintln "ERGO_PARSER_FAIL"; exit 1
    end;
