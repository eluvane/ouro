                    | ERange _ _ _ => False
                    | EIf _ _ _ => False
                    | EIfLet _ _ _ _ => False
                    | ECoalesce _ _ => False
                    end
                  | EVar _ => False
                  | EHole _ => False
                  | ESort _ => False
                  | ENat _ => False
