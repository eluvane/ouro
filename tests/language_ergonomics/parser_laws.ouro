-- Exercise declaration parsing directly, without the dependency scanner.
-- Both ordinary dispatch and the packed/bootstrap closure run these laws.
import "../../compiler/parser.ouro";
import "parser_test_budget.ouro";
import "../../std/io.ouro";
import "../../std/listx.ouro";
import "../compiler_test_list_equal.ouro";

def erg_import_id (decl : Decl) : Nat :=
    match decl with
    | DImport path => path
    | DDef _ _ _ _ _ => Z
    | DAxiom _ _ => Z
    | DInductive _ _ _ _ _ => Z
    | DEffect _ _ _ => Z
    | DIntrinsic _ _ _ _ => Z
    | DExtern _ _ _ => Z
    | DRepresentation _ _ => Z
    end;

def erg_same_ids : List Nat -> List Nat -> Bool :=
  compiler_test_list_equal Nat eqNat;

-- Keep parser fuel opaque to native C emission so it cannot unroll the parser.
def erg_parser_fuel : Nat := parser_test_fuel;

def erg_parse_imports
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : List Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => False
    | POk decls rest _ =>
        andb (is_eof (peek rest))
          (erg_same_ids(map Decl Nat erg_import_id decls, expected))
    end;

def erg_parse_error
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr position => eqNat position expected
    | POk _ _ _ => False
    end;

def erg_atom_start_laws : Bool :=
    let starts : List Token :=
      [TIdent Z, TNat 42, TType Z, TLparen, TBracketL, THole (Nothing Nat),
       THole (Just Nat Z), TString Z, TByteString [], TByteString [256],
       TKeyword kwIf, TKeyword kwFun, TKeyword kwLet, TKeyword kwMatch, TKeyword kwFix] in
    let stops : List Token :=
      [TColon, TColonEq, TArrow, TFatArrow, TBar, TRparen, TSemi, TComma,
       TBraceL, TBraceR, TExclam, TEof, TBind, TPipe, TBracketR, TDotDot, TDotDotEq, TCoalesce] in
    let keywords : List Nat :=
      [kwDef, kwAxiom, kwInductive, kwWith, kwEnd, kwIn, kwImport, kwEffect, kwWhere,
       kwRecord, kwIntrinsic, kwExtern, kwRepresentation, kwOpen, kwThen, kwElse, kwPrivate, 25, 99] in
    let neither (token : Token) : Bool := notb (orb (is_atom_start token) (is_comma_list_start token)) in
    andb (all Token (fun (token : Token) => andb (is_atom_start token) (is_comma_list_start token)) starts)
      (andb (all Token neither stops)
        (andb (all Nat (fun (key : Nat) => neither (TKeyword key)) keywords)
          (all Nat (fun (key : Nat) =>
            andb (notb (is_atom_start (TKeyword key))) (is_comma_list_start (TKeyword key)))
            [kwDo, kwPerform, kwHandle])));

def erg_atom_callback_laws : Bool :=
    let forwards (token : Token) (fuel : Nat) (expected : Nat) : Bool :=
      let observe (received : Nat) (_ : Mode) (rest : List Token) (pos : Nat) (extra : Value)
          : ParseResult Value :=
        match andb (eqNat received fuel) (andb (eqNat pos 9)
          (andb (eqNat (length Token rest) 1) (is_semi (peek rest)))) with
        | True => POk Value extra rest pos | False => PErr Value pos
        end in
      match parse_a_atom observe fuel [token, TSemi] 8 (VNat 31) with
      | PErr _ => False
      | POk value _ _ => maybe Nat Bool False (eqNat expected) (asNat value)
      end in
    andb (forwards TLparen Z 31)
      (andb (forwards TBracketL 7 31) (forwards (TKeyword 99) 17 99));

def erg_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let tail_errors : Bool := all Nat (fun (key : Nat) => erg_parse_error frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq, TIdent 11,
       TKeyword key, TSemi, TEof] 6) [kwDo, kwPerform, kwHandle, kwOpen, 25] in
    let atom_errors : Bool := andb (erg_parse_error frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq, TKeyword 99, TSemi, TEof] 6)
      (all Token (fun (separator : Token) => erg_parse_error frontend
        [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq, TNat 4, separator, TSemi, TEof] 7)
        [TDotDot, TDotDotEq]) in
    andb (andb tail_errors atom_errors) (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TSemi, TKeyword kwImport, TString 12, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 11, TEof] [11, 11])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TSemi, TEof] [11])
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TComma, TString 12, TSemi, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TSemi, TEof] 1)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TString 12, TSemi, TEof] 2)
      (erg_parse_error frontend
        [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TEof] 5))))))))));

def erg_var_name (expr : Expr) : Maybe Nat :=
    match expr with
    | EVar name => Just Nat name
    | EHole _ => Nothing Nat
    | ESort _ => Nothing Nat
    | ENat _ => Nothing Nat
    | EApp _ _ => Nothing Nat
    | ELam _ _ _ => Nothing Nat
    | EPi _ _ _ => Nothing Nat
    | ELet _ _ _ _ => Nothing Nat
    | EAscribe _ _ => Nothing Nat
    | EMatch _ _ => Nothing Nat
    | EFix _ _ _ _ => Nothing Nat
    | EEffectRow _ _ => Nothing Nat
    | EPerform _ _ => Nothing Nat
    | EDo _ => Nothing Nat
    | EHandle _ _ => Nothing Nat
    | EBranch _ _ _ => Nothing Nat
    | ENoBranch => Nothing Nat
    | EBinder _ _ _ => Nothing Nat
    | ENoBinder => Nothing Nat
    | EMultiMatch _ _ => Nothing Nat
    | EStr _ => Nothing Nat
    | EDoBind _ _ => Nothing Nat
    | EList _ => Nothing Nat
    | ESpan _ _ _ => Nothing Nat
    | EFallible _ _ _ _ => Nothing Nat
    | EOpen _ _ => Nothing Nat
    | EListSpread _ _ => Nothing Nat
    | ENamedCall _ _ => Nothing Nat
    | ERange _ _ _ => Nothing Nat
    | EIf _ _ _ => Nothing Nat
    | EIfLet _ _ _ _ => Nothing Nat
    | ECoalesce _ _ => Nothing Nat
    end;

def erg_block_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | ELet binder annotation rhs result =>
                    match annotation with
                    | Nothing => False
                    | Just ann =>
                        match erg_var_name ann with
                        | Nothing => False
                        | Just ty =>
                            match erg_var_name rhs with
                            | Nothing => False
                            | Just value =>
                                match erg_var_name result with
                                | Nothing => False
                                | Just used =>
                                    andb (eqNat name 10)
                                      (andb (eqNat binder 12)
                                        (andb (eqNat ty 11)
                                          (andb (eqNat value 13) (eqNat used 12))))
                                end
                            end
                        end
                    end
                | EVar _ => False
                | EHole _ => False
                | ESort _ => False
                | ENat _ => False
                | EApp _ _ => False
                | ELam _ _ _ => False
                | EPi _ _ _ => False
                | EAscribe _ _ => False
                | EMatch _ _ => False
                | EFix _ _ _ _ => False
                | EEffectRow _ _ => False
                | EPerform _ _ => False
                | EDo _ => False
                | EHandle _ _ => False
                | EBranch _ _ _ => False
                | ENoBranch => False
                | EBinder _ _ _ => False
                | ENoBinder => False
                | EMultiMatch _ _ => False
                | EStr _ => False
                | EDoBind _ _ => False
                | EList _ => False
                | ESpan _ _ _ => False
                | EFallible _ _ _ _ => False
                | EOpen _ _ => False
                | EListSpread _ _ => False
                | ENamedCall _ _ => False
                | ERange _ _ _ => False
                | EIf _ _ _ => False
                | EIfLet _ _ _ _ => False
                | ECoalesce _ _ => False
                end
            | DAxiom _ _ => False
            | DInductive _ _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def erg_parse_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TKeyword kwLet, TIdent 12, TColon,
       TIdent 11, TColonEq, TIdent 13, TSemi, TIdent 12, TBraceR,
       TSemi, TEof] Z with
    | PErr _ => False
    | POk decls rest _ => andb (is_eof (peek rest)) (erg_block_shape decls)
    end;

def erg_reject_empty_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TBraceR, TSemi, TEof] Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_parse_rejected
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_destructure_shape (decls : List Decl)
    (fields : List Nat) : Bool :=
    match decls with
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | EMatch subject branches =>
                    match subject with
                    | EVar source =>
                        match branches with
                        | EBranch packed used remaining =>
                            match remaining with
                            | ENoBranch =>
                                match used with
                                | EVar binder =>
                                    andb(eqNat name 10,
                                      andb(eqNat source 14,
                                        andb(eqNat binder 12,
                                          erg_same_ids packed (Cons Nat 11 fields))))
                                | EHole _ => False
                                | ESort _ => False
                                | ENat _ => False
                                | EApp _ _ => False
                                | ELam _ _ _ => False
                                | EPi _ _ _ => False
                                | ELet _ _ _ _ => False
