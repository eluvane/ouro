                        | EOpen _ _ => False
                        | EListSpread _ _ => False
                        | ENamedCall _ _ => False
                        | ERange _ _ _ => False
                        | EIf _ _ _ => False
                        | EIfLet _ _ _ _ => False
                        | ECoalesce _ _ => False
                        end
                      | EHole _ => False
