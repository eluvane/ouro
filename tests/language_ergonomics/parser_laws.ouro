-- Exercise declaration parsing directly, without the dependency scanner.
-- Both ordinary dispatch and the packed/bootstrap closure run these laws.
import "../../compiler/parser.ouro";
import "../../std/io.ouro";

def erg_import_id (decl : Decl) : Nat :=
    match decl with
    | DImport path => path
    | DDef _ _ _ _ _ => Z
    | DAxiom _ _ => Z
    | DInductive _ _ _ _ _ => Z
    | DEffect _ _ _ => Z
    | DIntrinsic _ _ _ _ => Z
    | DExtern _ _ _ => Z
    | DRepresentation _ _ => Z
    end;

def erg_same_ids : List Nat -> List Nat -> Bool :=
  fix same (left : List Nat) (right : List Nat) : Bool :=
    match left with
    | Nil => match right with | Nil => True | Cons _ _ => False end
    | Cons x xs =>
        match right with
        | Nil => False
        | Cons y ys => andb(eqNat x y, same xs ys)
        end
    end;

-- Keep parser fuel opaque to native C emission so it cannot unroll the parser.
def erg_parser_fuel : Nat :=
    (fix go (n : Nat) : Nat := match n with | Z => add 1500 1500 | S k => go k end) 0;

def erg_parse_imports
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : List Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => False
    | POk decls rest _ =>
        andb (is_eof (peek rest))
          (erg_same_ids(map Decl Nat erg_import_id decls, expected))
    end;

def erg_parse_error
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr position => eqNat position expected
    | POk _ _ _ => False
    end;

def erg_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TSemi, TKeyword kwImport, TString 12, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 11, TEof] [11, 11])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TSemi, TEof] [11])
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TComma, TString 12, TSemi, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TSemi, TEof] 1)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TString 12, TSemi, TEof] 2)
      (erg_parse_error frontend
        [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TEof] 5)))))))));

def erg_block_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | ELet binder annotation rhs result =>
                    match annotation with
                    | Nothing => False
                    | Just ann =>
                        match ann, rhs, result with
                        | EVar ty, EVar value, EVar used =>
                            andb (eqNat name 10)
                              (andb (eqNat binder 12)
                                (andb (eqNat ty 11)
                                  (andb (eqNat value 13) (eqNat used 12))))
                        | _, _, _ => False
                        end
                    end
                | _ => False
                end
            | _ => False
            end
        end
    end;

def erg_parse_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TKeyword kwLet, TIdent 12, TColon,
       TIdent 11, TColonEq, TIdent 13, TSemi, TIdent 12, TBraceR,
       TSemi, TEof] Z with
    | PErr _ => False
    | POk decls rest _ => andb (is_eof (peek rest)) (erg_block_shape decls)
    end;

def erg_reject_empty_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TBraceR, TSemi, TEof] Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_fallible_shape (decls : List Decl) : Bool :=
    match decls with
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | EFallible container failure success block =>
                    match container, block with
                    | EVar container_id, ELet binder annotation value used_expr =>
                        match annotation, used_expr, fallible_postfix value with
                        | Just ann_expr, EVar used, Just operand =>
                            match ann_expr, operand with
                            | EVar annotation_id, EVar source =>
                                andb (eqNat name 10)
                                  (andb (eqNat container_id 11)
                                    (andb (eqNat failure 12)
                                      (andb (eqNat success 13)
                                        (andb (eqNat binder 14)
                                          (andb (eqNat annotation_id 15)
                                            (andb (eqNat source 16) (eqNat used 14)))))))
                            | _, _ => False
                            end
                        | _, _, _ => False
                        end
                    | _, _ => False
                    end
                | _ => False
                end
            | _ => False
            end
        end
    | _ => False
    end;

def erg_fallible_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TKeyword kwLet, THole (Just Nat Z), TLparen, TIdent 12, TComma,
         TIdent 13, TRparen, TColon, TIdent 11, TKeyword kwDo,
         TKeyword kwLet, TIdent 14, TColon, TIdent 15, TColonEq,
         TIdent 16, THole (Just Nat Z), TSemi, TIdent 14,
         TKeyword kwEnd, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb (is_eof (peek rest)) (erg_fallible_shape decls)
      end in
    let rejected : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TKeyword kwLet, THole (Just Nat Z), TLparen, TIdent 12, TComma,
         TIdent 13, TRparen, TColon, TIdent 11, TKeyword kwDo,
         TKeyword kwEnd, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted rejected;

def erg_implicit_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration rest =>
        match rest with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DInductive name params _ _ marked =>
                match params with
                | Nil => False
                | Cons first tail =>
                    match first, tail with
                    | MkPair binder ty, Nil =>
                        match ty with
                        | ESort level =>
                            andb(eqNat name 10,
                              andb(eqNat binder 11,
                                andb(eqNat level Z, eqNat marked 1)))
                        | _ => False
                        end
                    | _, _ => False
                    end
                end
            | _ => False
            end
        end
    end;

def erg_implicit_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb(is_eof(peek rest), erg_implicit_shape decls)
      end in
    let bad_level : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TBraceL, TIdent 11, TColon,
         TType 1, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    let nonleading : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TLparen, TIdent 13,
         TColon, TType Z, TRparen, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted (andb bad_level nonleading);

def erg_marked_def_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name signature _ marked declared =>
                andb(eqNat name 10,
                  andb(eqNat marked 1,
                    andb(eqNat declared 2,
                      (match signature with
                       | EPi type_name _ rest =>
                           andb(eqNat type_name 11,
                             (match rest with
                              | EPi value_name _ _ => eqNat value_name 12
                              | EVar _ => False
                              | EHole _ => False
                              | ESort _ => False
                              | ENat _ => False
                              | EApp _ _ => False
                              | ELam _ _ _ => False
                              | ELet _ _ _ _ => False
                              | EAscribe _ _ => False
                              | EMatch _ _ => False
                              | EFix _ _ _ _ => False
                              | EEffectRow _ _ => False
                              | EPerform _ _ => False
                              | EDo _ => False
                              | EHandle _ _ => False
                              | EBranch _ _ _ => False
                              | ENoBranch => False
                              | EBinder _ _ _ => False
                              | ENoBinder => False
                              | EMultiMatch _ _ => False
                              | EStr _ => False
                              | EDoBind _ _ => False
                              | EList _ => False
                              | ESpan _ _ _ => False
                              | EFallible _ _ _ _ => False
                              end))
                       | EVar _ => False
                       | EHole _ => False
                       | ESort _ => False
                       | ENat _ => False
                       | EApp _ _ => False
                       | ELam _ _ _ => False
                       | ELet _ _ _ _ => False
                       | EAscribe _ _ => False
                       | EMatch _ _ => False
                       | EFix _ _ _ _ => False
                       | EEffectRow _ _ => False
                       | EPerform _ _ => False
                       | EDo _ => False
                       | EHandle _ _ => False
                       | EBranch _ _ _ => False
                       | ENoBranch => False
                       | EBinder _ _ _ => False
                       | ENoBinder => False
                       | EMultiMatch _ _ => False
                       | EStr _ => False
                       | EDoBind _ _ => False
                       | EList _ => False
                       | ESpan _ _ _ => False
                       | EFallible _ _ _ _ => False
                       end))))
            | DAxiom _ _ => False
            | DInductive _ _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def erg_marked_def_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TLparen, TIdent 12, TColon, TIdent 11,
         TRparen, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb(is_eof(peek rest), erg_marked_def_shape decls)
      end in
    let bad_level : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TBraceL, TIdent 11, TColon,
         TType 1, TBraceR, TLparen, TIdent 12, TColon, TIdent 11,
         TRparen, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    let nonleading : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TLparen, TIdent 12, TColon,
         TType Z, TRparen, TBraceL, TIdent 11, TColon, TType Z,
         TBraceR, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted (andb bad_level nonleading);

-- @entry main
def main : IO Unit :=
    let existing : Bool := andb
        (andb (erg_parser_laws (parse_file parse))
          (erg_parser_laws (closed_parse_file parse_a parse_b)))
        (andb
          (andb (erg_parse_block (parse_file parse))
            (erg_parse_block (closed_parse_file parse_a parse_b)))
          (andb (erg_reject_empty_block (parse_file parse))
            (erg_reject_empty_block (closed_parse_file parse_a parse_b)))) in
    match andb existing
        (andb (erg_fallible_laws (parse_file parse))
          (andb (erg_fallible_laws (closed_parse_file parse_a parse_b))
            (andb (erg_implicit_laws (parse_file parse))
              (andb (erg_implicit_laws (closed_parse_file parse_a parse_b))
                (andb (erg_marked_def_laws (parse_file parse))
                  (erg_marked_def_laws (closed_parse_file parse_a parse_b))))))) with
    | True => println "ERGO_PARSER_OK"
    | False => do eprintln "ERGO_PARSER_FAIL"; exit 1
    end;
