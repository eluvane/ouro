  | EIf _ _ _ => Nothing (Pair Expr Expr)
  | EIfLet _ _ _ _ => Nothing (Pair Expr Expr)
  end;

def erg_coalesce_shape (decls : List Decl) : Bool :=
  match erg_single_def_body decls with
  | Nothing => False
  | Just body => match erg_coalesce_parts body with
    | Nothing => False
    | Just outer => match outer with
      | MkPair lhs rhs => match erg_coalesce_var_id lhs with
        | Nothing => False
        | Just first => match erg_coalesce_parts rhs with
          | Nothing => False
          | Just inner => match inner with
            | MkPair second third =>
                match erg_coalesce_var_id second with
                | Nothing => False
                | Just second_id => match erg_coalesce_var_id third with
                  | Nothing => False
                  | Just third_id => andb(eqNat first 11,
                    andb(eqNat second_id 12, eqNat third_id 13))
                  end
                end
            end
          end
        end
      end
    end
  end;

def erg_coalesce_pipe_shape (decls : List Decl) : Bool :=
  match erg_single_def_body decls with
  | Nothing => False
  | Just body => match erg_coalesce_parts body with
    | Nothing => False
    | Just outer => match outer with
      | MkPair lhs rhs => match erg_coalesce_var_id lhs with
        | Nothing => False
        | Just first => match erg_coalesce_app_parts rhs with
          | Nothing => False
          | Just inner => match inner with
            | MkPair function argument =>
                match erg_coalesce_var_id function with
                | Nothing => False
                | Just second_id => match erg_coalesce_var_id argument with
                  | Nothing => False
                  | Just third_id => andb(eqNat first 11,
                    andb(eqNat second_id 13, eqNat third_id 12))
                  end
                end
            end
          end
        end
      end
    end
  end;

def erg_coalesce_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let nested : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
         TIdent 11, TCoalesce, TIdent 12, TCoalesce, TIdent 13,
         TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ => andb(is_eof(peek rest), erg_coalesce_shape decls)
      end in
    let pipe : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
         TIdent 11, TCoalesce, TIdent 12, TPipe, TIdent 13,
         TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ => andb(is_eof(peek rest), erg_coalesce_pipe_shape decls)
      end in
    let missing_rhs : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TIdent 11, TCoalesce, TSemi, TEof] in
    andb nested (andb pipe missing_rhs);

def erg_match_bang_shape (term : Expr) : Bool :=
    if let EDo items := term then
      match items with
      | Nil => False
      | Cons binding rest => match rest with
        | Nil => False
        | Cons dispatch tail =>
            andb (nullb Expr tail)
              (if let EDoBind name action := binding then
                 if let EMatch subject _ := dispatch then
                   andb (maybe Nat Bool False (eqNat 11) (erg_var_name action))
                     (maybe Nat Bool False (eqNat name) (erg_var_name subject))
                 else False
               else False)
        end
      end
    else False;

def erg_match_bang_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let expanded : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
         TKeyword kwMatch, TExclam, TIdent 11, TKeyword kwWith,
         TBar, TIdent 12, TFatArrow, TIdent 13, TKeyword kwEnd, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb (is_eof (peek rest))
            (maybe Expr Bool False erg_match_bang_shape (erg_single_def_body decls))
      end in
    let missing_with : Bool := erg_parse_error frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TKeyword kwMatch, TExclam, TIdent 11, TBar, TIdent 12, TFatArrow,
       TIdent 13, TKeyword kwEnd, TSemi, TEof] 8 in
    andb expanded missing_with;

def erg_call_argument_laws
    (frontend : Nat -> Mode -> List Token -> Nat -> Value -> ParseResult Value) : Bool :=
    let call (tokens : List Token) : ParseResult Value :=
      parse_a_call_arguments frontend erg_parser_fuel (EVar 10) tokens Z (VNat Z) in
    let consumed (rest : List Token) (position : Nat) (expected : Nat) : Bool :=
      andb (eqNat position expected) (andb (is_semi (peek rest)) (eqNat (length Token rest) 1)) in
    let numeral (expected : Nat) (term : Expr) : Bool :=
      if let ENat value := term then eqNat value expected else False in
    let positional : Bool := match call [TNat 21, TComma, TNat 22, TRparen, TSemi] with
      | PErr _ => False
      | POk value rest position =>
          andb (consumed rest position 4)
            (if let VExpr term := value then
               if let EApp prefix second := term then
                 if let EApp head first := prefix then
                   andb (maybe Nat Bool False (eqNat 10) (erg_var_name head))
                     (andb (numeral 21 first) (numeral 22 second))
                 else False
               else False
             else False)
      end in
    let row_values (row : Pair Nat Expr) : List Nat :=
      let (MkPair label argument) := row in
      if let ENat value := argument then [label, value] else [] in
    let named_trailing : Bool := match call
      [TNat 21, TComma, TIdent 11, TColonEq, TNat 22,
       TComma, TIdent 12, TColonEq, TNat 23, TComma, TRparen, TSemi] with
      | PErr _ => False
      | POk value rest position =>
          andb (consumed rest position 11)
            (if let VExpr term := value then
               if let ENamedCall head rows := term then
                 andb (maybe Nat Bool False (eqNat 10) (erg_var_name head))
                   (compiler_test_list_equal (List Nat) erg_same_ids
                     (map (Pair Nat Expr) (List Nat) row_values rows)
                     ([[Z, 21], [11, 22], [12, 23]] : List (List Nat)))
               else False
             else False)
      end in
    let misordered : Bool := match call
      [TIdent 11, TColonEq, TNat 22, TComma, TNat 23, TRparen, TSemi] with
      | PErr position => eqNat position 4
      | POk _ _ _ => False
      end in
    andb positional (andb named_trailing misordered);

-- @entry main
def main : IO Unit :=
    let destructure : Bool := andb (erg_destructure_laws (parse_file parse))
      (erg_destructure_laws (closed_parse_file parse_a parse_b)) in
    let direct : Bool := andb (erg_parser_laws (parse_file parse))
      (andb (erg_list_parser_laws (parse_file parse))
        (andb (erg_parse_block (parse_file parse))
          (erg_reject_empty_block (parse_file parse)))) in
    let closed : Bool := andb (erg_parser_laws (closed_parse_file parse_a parse_b))
      (andb (erg_list_parser_laws (closed_parse_file parse_a parse_b))
        (andb (erg_parse_block (closed_parse_file parse_a parse_b))
          (erg_reject_empty_block (closed_parse_file parse_a parse_b)))) in
    let trailing : Bool := andb
      (erg_trailing_lambda_laws (parse_file parse))
      (erg_trailing_lambda_laws (closed_parse_file parse_a parse_b)) in
    let call_arguments : Bool := andb (erg_call_argument_laws parse)
      (erg_call_argument_laws (close_parse parse_a parse_b)) in
    let coalesce : Bool := andb (erg_coalesce_laws (parse_file parse))
      (erg_coalesce_laws (closed_parse_file parse_a parse_b)) in
    let match_bang : Bool := andb (erg_match_bang_laws (parse_file parse))
      (erg_match_bang_laws (closed_parse_file parse_a parse_b)) in
    let do_pure : Bool := andb (erg_do_pure_laws (parse_file parse))
      (erg_do_pure_laws (closed_parse_file parse_a parse_b)) in
    let do_items : Bool := andb (erg_do_items_laws parse)
      (andb (erg_do_items_laws (close_parse parse_a parse_b)) erg_do_items_fuel_law) in
    let prior : Bool := andb (andb (andb do_pure do_items) erg_atom_callback_laws) (andb destructure (andb (andb direct closed)
        (andb (erg_fallible_laws (parse_file parse))
          (andb (erg_fallible_laws (closed_parse_file parse_a parse_b))
            (andb (erg_implicit_laws (parse_file parse))
              (andb (erg_implicit_laws (closed_parse_file parse_a parse_b))
                (andb (erg_marked_def_laws (parse_file parse))
                  (erg_marked_def_laws (closed_parse_file parse_a parse_b))))))))) in
    match andb (andb match_bang
          (andb erg_atom_start_laws (andb (andb trailing call_arguments) (andb coalesce prior))))
        (andb (erg_if_parser_laws (parse_file parse))
          (andb (erg_if_parser_laws (closed_parse_file parse_a parse_b))
            (andb (erg_iflet_parser_laws (parse_file parse))
              (erg_iflet_parser_laws (closed_parse_file parse_a parse_b))))) with
    | True => println "ERGO_PARSER_OK"
    | False => do eprintln "ERGO_PARSER_FAIL"; exit 1
    end;
