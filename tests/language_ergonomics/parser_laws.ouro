-- Exercise declaration parsing directly, without the dependency scanner.
-- Both ordinary dispatch and the packed/bootstrap closure run these laws.
import "../../compiler/parser.ouro";
import "../../std/io.ouro";

def erg_import_id (decl : Decl) : Nat :=
    match decl with
    | DImport path => path
    | DDef _ _ _ _ _ => Z
    | DAxiom _ _ => Z
    | DInductive _ _ _ _ _ => Z
    | DEffect _ _ _ => Z
    | DIntrinsic _ _ _ _ => Z
    | DExtern _ _ _ => Z
    | DRepresentation _ _ => Z
    end;

def erg_same_ids : List Nat -> List Nat -> Bool :=
  fix same (left : List Nat) (right : List Nat) : Bool :=
    match left with
    | Nil => match right with | Nil => True | Cons _ _ => False end
    | Cons x xs =>
        match right with
        | Nil => False
        | Cons y ys => andb(eqNat x y, same xs ys)
        end
    end;

-- Keep parser fuel opaque to native C emission so it cannot unroll the parser.
def erg_parser_fuel : Nat :=
    (fix go (n : Nat) : Nat := match n with | Z => add 1500 1500 | S k => go k end) 0;

def erg_parse_imports
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : List Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => False
    | POk decls rest _ =>
        andb (is_eof (peek rest))
          (erg_same_ids(map Decl Nat erg_import_id decls, expected))
    end;

def erg_parse_error
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) (expected : Nat) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr position => eqNat position expected
    | POk _ _ _ => False
    end;

def erg_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TSemi, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TSemi, TKeyword kwImport, TString 12, TEof] [11, 12])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TString 11, TEof] [11, 11])
    (andb (erg_parse_imports frontend
      [TKeyword kwImport, TString 11, TComma, TSemi, TEof] [11])
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TComma, TComma, TString 12, TSemi, TEof] 3)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TSemi, TEof] 1)
    (andb (erg_parse_error frontend
      [TKeyword kwImport, TString 11, TString 12, TSemi, TEof] 2)
      (erg_parse_error frontend
        [TKeyword kwImport, TString 11, TComma, TString 12, TComma, TEof] 5)))))))));

def erg_block_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | ELet binder annotation rhs result =>
                    match annotation with
                    | Nothing => False
                    | Just ann =>
                        match ann, rhs, result with
                        | EVar ty, EVar value, EVar used =>
                            andb (eqNat name 10)
                              (andb (eqNat binder 12)
                                (andb (eqNat ty 11)
                                  (andb (eqNat value 13) (eqNat used 12))))
                        | _, _, _ => False
                        end
                    end
                | _ => False
                end
            | _ => False
            end
        end
    end;

def erg_parse_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TKeyword kwLet, TIdent 12, TColon,
       TIdent 11, TColonEq, TIdent 13, TSemi, TIdent 12, TBraceR,
       TSemi, TEof] Z with
    | PErr _ => False
    | POk decls rest _ => andb (is_eof (peek rest)) (erg_block_shape decls)
    end;

def erg_reject_empty_block
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    match frontend erg_parser_fuel
      [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
       TKeyword kwLet, TBraceL, TBraceR, TSemi, TEof] Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_parse_one_declaration
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => False
    | POk decls rest _ =>
        andb(is_eof (peek rest), eqNat(length Decl decls, 1))
    end;

def erg_parse_rejected
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl))
    (tokens : List Token) : Bool :=
    match frontend erg_parser_fuel tokens Z with
    | PErr _ => True
    | POk _ _ _ => False
    end;

def erg_list_parser_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let single : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TIdent 30, TComma, TBracketR, TSemi, TEof] in
    let multiple : Bool := erg_parse_one_declaration frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TIdent 30, TComma, TIdent 31, TComma, TBracketR, TSemi, TEof] in
    let leading : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TComma, TIdent 30, TBracketR, TSemi, TEof] in
    let doubled : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TBracketL, TIdent 30, TComma, TComma, TIdent 31, TBracketR, TSemi, TEof] in
    andb single (andb multiple (andb leading doubled));

def erg_fallible_shape (decls : List Decl) : Bool :=
    match decls with
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name _ body _ _ =>
                match body with
                | EFallible container failure success block =>
                    match container, block with
                    | EVar container_id, ELet binder annotation value used_expr =>
                        match annotation, used_expr, fallible_postfix value with
                        | Just ann_expr, EVar used, Just operand =>
                            match ann_expr, operand with
                            | EVar annotation_id, EVar source =>
                                andb (eqNat name 10)
                                  (andb (eqNat container_id 11)
                                    (andb (eqNat failure 12)
                                      (andb (eqNat success 13)
                                        (andb (eqNat binder 14)
                                          (andb (eqNat annotation_id 15)
                                            (andb (eqNat source 16) (eqNat used 14)))))))
                            | _, _ => False
                            end
                        | _, _, _ => False
                        end
                    | _, _ => False
                    end
                | _ => False
                end
            | _ => False
            end
        end
    | _ => False
    end;

def erg_fallible_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TKeyword kwLet, THole (Just Nat Z), TLparen, TIdent 12, TComma,
         TIdent 13, TRparen, TColon, TIdent 11, TKeyword kwDo,
         TKeyword kwLet, TIdent 14, TColon, TIdent 15, TColonEq,
         TIdent 16, THole (Just Nat Z), TSemi, TIdent 14,
         TKeyword kwEnd, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb (is_eof (peek rest)) (erg_fallible_shape decls)
      end in
    let rejected : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TKeyword kwLet, THole (Just Nat Z), TLparen, TIdent 12, TComma,
         TIdent 13, TRparen, TColon, TIdent 11, TKeyword kwDo,
         TKeyword kwEnd, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted rejected;

def erg_implicit_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration rest =>
        match rest with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DInductive name params _ _ marked =>
                match params with
                | Nil => False
                | Cons first tail =>
                    match first, tail with
                    | MkPair binder ty, Nil =>
                        match ty with
                        | ESort level =>
                            andb(eqNat name 10,
                              andb(eqNat binder 11,
                                andb(eqNat level Z, eqNat marked 1)))
                        | _ => False
                        end
                    | _, _ => False
                    end
                end
            | _ => False
            end
        end
    end;

def erg_implicit_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb(is_eof(peek rest), erg_implicit_shape decls)
      end in
    let bad_level : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TBraceL, TIdent 11, TColon,
         TType 1, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    let nonleading : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwInductive, TIdent 10, TLparen, TIdent 13,
         TColon, TType Z, TRparen, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TColon, TType Z, TColonEq, TBar,
         TIdent 12, TColon, TIdent 10, TIdent 11, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted (andb bad_level nonleading);

def erg_marked_def_shape (decls : List Decl) : Bool :=
    match decls with
    | Nil => False
    | Cons declaration tail =>
        match tail with
        | Cons _ _ => False
        | Nil =>
            match declaration with
            | DDef name signature _ marked declared =>
                andb(eqNat name 10,
                  andb(eqNat marked 1,
                    andb(eqNat(length DefParam declared) 2,
                      (match signature with
                       | EPi type_name _ rest =>
                           andb(eqNat type_name 11,
                             (match rest with
                              | EPi value_name _ _ => eqNat value_name 12
                              | EVar _ => False
                              | EHole _ => False
                              | ESort _ => False
                              | ENat _ => False
                              | EApp _ _ => False
                              | ELam _ _ _ => False
                              | ELet _ _ _ _ => False
                              | EAscribe _ _ => False
                              | EMatch _ _ => False
                              | ECoalesce _ _ => False
                              | EFix _ _ _ _ => False
                              | EEffectRow _ _ => False
                              | EPerform _ _ => False
                              | EDo _ => False
                              | EHandle _ _ => False
                              | EBranch _ _ _ => False
                              | ENoBranch => False
                              | EBinder _ _ _ => False
                              | ENoBinder => False
                              | EMultiMatch _ _ => False
                              | EStr _ => False
                              | EDoBind _ _ => False
                              | EList _ => False
                              | EListSpread _ _ => False
                              | ERange _ _ _ => False
                              | ESpan _ _ _ => False
                              | EFallible _ _ _ _ => False
                              | EOpen _ _ => False
                              | ENamedCall _ _ => False
                              end))
                       | EVar _ => False
                       | EHole _ => False
                       | ESort _ => False
                       | ENat _ => False
                       | EApp _ _ => False
                       | ELam _ _ _ => False
                       | ELet _ _ _ _ => False
                       | EAscribe _ _ => False
                       | EMatch _ _ => False
                       | ECoalesce _ _ => False
                       | EFix _ _ _ _ => False
                       | EEffectRow _ _ => False
                       | EPerform _ _ => False
                       | EDo _ => False
                       | EHandle _ _ => False
                       | EBranch _ _ _ => False
                       | ENoBranch => False
                       | EBinder _ _ _ => False
                       | ENoBinder => False
                       | EMultiMatch _ _ => False
                       | EStr _ => False
                       | EDoBind _ _ => False
                       | EList _ => False
                       | EListSpread _ _ => False
                              | ERange _ _ _ => False
                       | ESpan _ _ _ => False
                       | EFallible _ _ _ _ => False
                       | EOpen _ _ => False
                       | ENamedCall _ _ => False
                       end))))
            | DAxiom _ _ => False
            | DInductive _ _ _ _ _ => False
            | DEffect _ _ _ => False
            | DImport _ => False
            | DIntrinsic _ _ _ _ => False
            | DExtern _ _ _ => False
            | DRepresentation _ _ => False
            end
        end
    end;

def erg_marked_def_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TBraceL, TIdent 11, TColon,
         TType Z, TBraceR, TLparen, TIdent 12, TColon, TIdent 11,
         TRparen, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          andb(is_eof(peek rest), erg_marked_def_shape decls)
      end in
    let bad_level : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TBraceL, TIdent 11, TColon,
         TType 1, TBraceR, TLparen, TIdent 12, TColon, TIdent 11,
         TRparen, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    let nonleading : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TLparen, TIdent 12, TColon,
         TType Z, TRparen, TBraceL, TIdent 11, TColon, TType Z,
         TBraceR, TColon, TIdent 11, TColonEq, TIdent 12, TSemi, TEof] Z with
      | PErr _ => True
      | POk _ _ _ => False
      end in
    andb accepted (andb bad_level nonleading);

def erg_trailing_lambda_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let accepted : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TIdent 12, TLparen, TIdent 13, TRparen, TBraceL, TIdent 14,
         TArrow, TIdent 14, TBraceR, TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ =>
          match decls with
          | Cons declaration tail => match tail with
            | Cons _ _ => False
            | Nil => match declaration with
              | DDef _ _ body _ _ => match body with
                | EApp called callback => match called with
                  | EApp callee argument => match callee with
                    | EVar callee_name => match argument with
                      | EVar argument_name => match callback with
                        | ELam binder annotation lambda_body =>
                            match annotation with
                            | Just ignored => False
                            | Nothing => match lambda_body with
                              | EVar used =>
                                  andb(is_eof(peek rest),
                                    andb(eqNat callee_name 12,
                                      andb(eqNat argument_name 13,
                                        andb(eqNat binder 14, eqNat used 14))))
                              | _ => False
                              end
                            end
                        | _ => False
                        end
                      | _ => False
                      end
                    | _ => False
                    end
                  | _ => False
                  end
                | _ => False
                end
              | _ => False
              end
            end
          | Nil => False
          end
      end in
    andb accepted
      (andb (erg_parse_rejected frontend
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TIdent 12, TLparen, TRparen, TBraceL, TIdent 14, TArrow,
         TIdent 14, TBraceR, TSemi, TEof])
      (andb (erg_parse_rejected frontend
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TIdent 12, TBraceL, TIdent 14, TArrow, TIdent 14, TBraceR,
         TSemi, TEof])
      (andb (erg_parse_rejected frontend
        [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
         TIdent 12, TLparen, TIdent 13, TRparen, TBraceL,
         TIdent 14, TIdent 14, TBraceR, TSemi, TEof])
        (erg_parse_rejected frontend
          [TKeyword kwDef, TIdent 10, TColon, TIdent 11, TColonEq,
           TIdent 12, TLparen, TIdent 13, TRparen, TBraceL,
           TIdent 14, TIdent 15, TArrow, TIdent 14, TBraceR,
           TSemi, TEof]))));
def erg_coalesce_decl_body (decls : List Decl) : Maybe Expr :=
  match decls with
  | Nil => Nothing Expr
  | Cons declaration remaining =>
      match remaining with
      | Nil => match declaration with
        | DDef _ _ body _ _ => Just Expr body
        | DAxiom _ _ => Nothing Expr
        | DInductive _ _ _ _ _ => Nothing Expr
        | DEffect _ _ _ => Nothing Expr
        | DImport _ => Nothing Expr
        | DIntrinsic _ _ _ _ => Nothing Expr
        | DExtern _ _ _ => Nothing Expr
        | DRepresentation _ _ => Nothing Expr
        end
      | Cons _ _ => Nothing Expr
      end
  end;

def erg_coalesce_var_id (term : Expr) : Maybe Nat :=
  match term with
  | EVar name => Just Nat name
  | EHole _ => Nothing Nat
  | ESort _ => Nothing Nat
  | ENat _ => Nothing Nat
  | EApp _ _ => Nothing Nat
  | ELam _ _ _ => Nothing Nat
  | EPi _ _ _ => Nothing Nat
  | ELet _ _ _ _ => Nothing Nat
  | EAscribe _ _ => Nothing Nat
  | EMatch _ _ => Nothing Nat
  | EFix _ _ _ _ => Nothing Nat
  | EEffectRow _ _ => Nothing Nat
  | EPerform _ _ => Nothing Nat
  | EDo _ => Nothing Nat
  | EHandle _ _ => Nothing Nat
  | EBranch _ _ _ => Nothing Nat
  | ENoBranch => Nothing Nat
  | EBinder _ _ _ => Nothing Nat
  | ENoBinder => Nothing Nat
  | EMultiMatch _ _ => Nothing Nat
  | EStr _ => Nothing Nat
  | EDoBind _ _ => Nothing Nat
  | EList _ => Nothing Nat
  | ESpan _ _ _ => Nothing Nat
  | EFallible _ _ _ _ => Nothing Nat
  | EOpen _ _ => Nothing Nat
  | EListSpread _ _ => Nothing Nat
  | ENamedCall _ _ => Nothing Nat
  | ERange _ _ _ => Nothing Nat
  | ECoalesce _ _ => Nothing Nat
  end;

def erg_coalesce_parts (term : Expr) : Maybe (Pair Expr Expr) :=
  match term with
  | ECoalesce left right => Just (Pair Expr Expr) (MkPair Expr Expr left right)
  | EVar _ => Nothing (Pair Expr Expr)
  | EHole _ => Nothing (Pair Expr Expr)
  | ESort _ => Nothing (Pair Expr Expr)
  | ENat _ => Nothing (Pair Expr Expr)
  | EApp _ _ => Nothing (Pair Expr Expr)
  | ELam _ _ _ => Nothing (Pair Expr Expr)
  | EPi _ _ _ => Nothing (Pair Expr Expr)
  | ELet _ _ _ _ => Nothing (Pair Expr Expr)
  | EAscribe _ _ => Nothing (Pair Expr Expr)
  | EMatch _ _ => Nothing (Pair Expr Expr)
  | EFix _ _ _ _ => Nothing (Pair Expr Expr)
  | EEffectRow _ _ => Nothing (Pair Expr Expr)
  | EPerform _ _ => Nothing (Pair Expr Expr)
  | EDo _ => Nothing (Pair Expr Expr)
  | EHandle _ _ => Nothing (Pair Expr Expr)
  | EBranch _ _ _ => Nothing (Pair Expr Expr)
  | ENoBranch => Nothing (Pair Expr Expr)
  | EBinder _ _ _ => Nothing (Pair Expr Expr)
  | ENoBinder => Nothing (Pair Expr Expr)
  | EMultiMatch _ _ => Nothing (Pair Expr Expr)
  | EStr _ => Nothing (Pair Expr Expr)
  | EDoBind _ _ => Nothing (Pair Expr Expr)
  | EList _ => Nothing (Pair Expr Expr)
  | ESpan _ _ _ => Nothing (Pair Expr Expr)
  | EFallible _ _ _ _ => Nothing (Pair Expr Expr)
  | EOpen _ _ => Nothing (Pair Expr Expr)
  | EListSpread _ _ => Nothing (Pair Expr Expr)
  | ENamedCall _ _ => Nothing (Pair Expr Expr)
  | ERange _ _ _ => Nothing (Pair Expr Expr)
  end;

def erg_coalesce_app_parts (term : Expr) : Maybe (Pair Expr Expr) :=
  match term with
  | EApp left right => Just (Pair Expr Expr) (MkPair Expr Expr left right)
  | EVar _ => Nothing (Pair Expr Expr)
  | EHole _ => Nothing (Pair Expr Expr)
  | ESort _ => Nothing (Pair Expr Expr)
  | ENat _ => Nothing (Pair Expr Expr)
  | ELam _ _ _ => Nothing (Pair Expr Expr)
  | EPi _ _ _ => Nothing (Pair Expr Expr)
  | ELet _ _ _ _ => Nothing (Pair Expr Expr)
  | EAscribe _ _ => Nothing (Pair Expr Expr)
  | EMatch _ _ => Nothing (Pair Expr Expr)
  | EFix _ _ _ _ => Nothing (Pair Expr Expr)
  | EEffectRow _ _ => Nothing (Pair Expr Expr)
  | EPerform _ _ => Nothing (Pair Expr Expr)
  | EDo _ => Nothing (Pair Expr Expr)
  | EHandle _ _ => Nothing (Pair Expr Expr)
  | EBranch _ _ _ => Nothing (Pair Expr Expr)
  | ENoBranch => Nothing (Pair Expr Expr)
  | EBinder _ _ _ => Nothing (Pair Expr Expr)
  | ENoBinder => Nothing (Pair Expr Expr)
  | EMultiMatch _ _ => Nothing (Pair Expr Expr)
  | EStr _ => Nothing (Pair Expr Expr)
  | EDoBind _ _ => Nothing (Pair Expr Expr)
  | EList _ => Nothing (Pair Expr Expr)
  | ESpan _ _ _ => Nothing (Pair Expr Expr)
  | EFallible _ _ _ _ => Nothing (Pair Expr Expr)
  | EOpen _ _ => Nothing (Pair Expr Expr)
  | EListSpread _ _ => Nothing (Pair Expr Expr)
  | ENamedCall _ _ => Nothing (Pair Expr Expr)
  | ERange _ _ _ => Nothing (Pair Expr Expr)
  | ECoalesce _ _ => Nothing (Pair Expr Expr)
  end;

def erg_coalesce_shape (decls : List Decl) : Bool :=
  match erg_coalesce_decl_body decls with
  | Nothing => False
  | Just body => match erg_coalesce_parts body with
    | Nothing => False
    | Just outer => match outer with
      | MkPair lhs rhs => match erg_coalesce_var_id lhs with
        | Nothing => False
        | Just first => match erg_coalesce_parts rhs with
          | Nothing => False
          | Just inner => match inner with
            | MkPair second third =>
                match erg_coalesce_var_id second with
                | Nothing => False
                | Just second_id => match erg_coalesce_var_id third with
                  | Nothing => False
                  | Just third_id => andb(eqNat first 11,
                    andb(eqNat second_id 12, eqNat third_id 13))
                  end
                end
            end
          end
        end
      end
    end
  end;

def erg_coalesce_pipe_shape (decls : List Decl) : Bool :=
  match erg_coalesce_decl_body decls with
  | Nothing => False
  | Just body => match erg_coalesce_parts body with
    | Nothing => False
    | Just outer => match outer with
      | MkPair lhs rhs => match erg_coalesce_var_id lhs with
        | Nothing => False
        | Just first => match erg_coalesce_app_parts rhs with
          | Nothing => False
          | Just inner => match inner with
            | MkPair function argument =>
                match erg_coalesce_var_id function with
                | Nothing => False
                | Just second_id => match erg_coalesce_var_id argument with
                  | Nothing => False
                  | Just third_id => andb(eqNat first 11,
                    andb(eqNat second_id 13, eqNat third_id 12))
                  end
                end
            end
          end
        end
      end
    end
  end;

def erg_coalesce_laws
    (frontend : Nat -> List Token -> Nat -> ParseResult (List Decl)) : Bool :=
    let nested : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
         TIdent 11, TCoalesce, TIdent 12, TCoalesce, TIdent 13,
         TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ => andb(is_eof(peek rest), erg_coalesce_shape decls)
      end in
    let pipe : Bool :=
      match frontend erg_parser_fuel
        [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
         TIdent 11, TCoalesce, TIdent 12, TPipe, TIdent 13,
         TSemi, TEof] Z with
      | PErr _ => False
      | POk decls rest _ => andb(is_eof(peek rest), erg_coalesce_pipe_shape decls)
      end in
    let missing_rhs : Bool := erg_parse_rejected frontend
      [TKeyword kwDef, TIdent 10, TColon, TIdent 20, TColonEq,
       TIdent 11, TCoalesce, TSemi, TEof] in
    andb nested (andb pipe missing_rhs);

-- @entry main
def main : IO Unit :=
    let direct : Bool := andb (erg_parser_laws (parse_file parse))
      (andb (erg_list_parser_laws (parse_file parse))
        (andb (erg_parse_block (parse_file parse))
          (erg_reject_empty_block (parse_file parse)))) in
    let closed : Bool := andb (erg_parser_laws (closed_parse_file parse_a parse_b))
      (andb (erg_list_parser_laws (closed_parse_file parse_a parse_b))
        (andb (erg_parse_block (closed_parse_file parse_a parse_b))
          (erg_reject_empty_block (closed_parse_file parse_a parse_b)))) in
    let trailing : Bool := andb
      (erg_trailing_lambda_laws (parse_file parse))
      (erg_trailing_lambda_laws (closed_parse_file parse_a parse_b)) in
    let coalesce : Bool := andb (erg_coalesce_laws (parse_file parse))
      (erg_coalesce_laws (closed_parse_file parse_a parse_b)) in
    match andb (andb direct closed)
        (andb (erg_fallible_laws (parse_file parse))
          (andb (erg_fallible_laws (closed_parse_file parse_a parse_b))
            (andb (erg_implicit_laws (parse_file parse))
              (andb (erg_implicit_laws (closed_parse_file parse_a parse_b))
                (andb (erg_marked_def_laws (parse_file parse))
                  (andb (erg_marked_def_laws (closed_parse_file parse_a parse_b))
                    (andb trailing coalesce)))))) with
    | True => println "ERGO_PARSER_OK"
    | False => do eprintln "ERGO_PARSER_FAIL"; exit 1
    end;
