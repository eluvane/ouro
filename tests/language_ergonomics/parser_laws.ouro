                  end
                | EVar _ => False
                | EHole _ => False
                | ESort _ => False
                | ENat _ => False
                | ELam _ _ _ => False
                | EPi _ _ _ => False
                | ELet _ _ _ _ => False
                | EAscribe _ _ => False
