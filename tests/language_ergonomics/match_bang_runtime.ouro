import "../../std/io.ouro";

def match_bang_action (choice : Bool) : IO Bool :=
    do println "action";
       io_pure Bool choice;

def match_bang_report (choice : Bool) : IO Unit :=
    match! match_bang_action choice with
    | True => println "true branch"
    | False => println "false branch"
    end;

-- @entry main
def main : IO Unit := do match_bang_report True; match_bang_report False;
