-- Small nominal types keep the syntax laws independent of arithmetic rules.
inductive ErgNat : Type :=
  | ErgZero : ErgNat
  | ErgSucc : ErgNat -> ErgNat;

inductive ErgBool : Type :=
  | ErgFalse : ErgBool
  | ErgTrue : ErgBool;

inductive ErgEq (A : Type) (x : A) : A -> Type :=
  | ErgRefl : ErgEq A x x;

inductive ErgMaybe (A : Type) : Type :=
  | ErgNothing : ErgMaybe A
  | ErgJust : A -> ErgMaybe A;

inductive ErgResult (E : Type) (A : Type) : Type :=
  | ErgLeft : E -> ErgResult E A
  | ErgRight : A -> ErgResult E A;

def erg_first (x : ErgNat) (y : ErgNat) : ErgNat := x;
def erg_apply (f : ErgNat -> ErgNat) (x : ErgNat) : ErgNat := f x;
def erg_id (A : Type) (x : A) : A := x;
