-- Semantic acceptance laws for the packaged Ouro declaration checker.
-- Core data is constructed directly so frontend rejection cannot hide checker gaps.
-- Verdicts preserve the retained kernel corpus, including its negative cases.

import "../compiler/file_elab.ouro";
import "../compiler/file_elab_lookup.ouro";
import "../std/io.ouro";
import "compiler_core_test_decls.ouro";

-- One IO pass reports every law and preserves a nonzero failure exit.
inductive CheckerTest : Type :=
  | CheckerLaw : String -> Bool -> String -> CheckerTest;

def checker_test_assert (name : String) (passed : Bool) : CheckerTest :=
    CheckerLaw name passed "expected true";

def checker_tests_run (tests : List CheckerTest) : IO Unit :=
    (fix report (remaining : List CheckerTest) (failed : Bool) : IO Unit :=
      match remaining with
      | Nil =>
          match failed with
          | True => exit 1
          | False => exit 0
          end
      | Cons law rest =>
          match law with
          | CheckerLaw name passed observed =>
              do println
                   (prim_string_concat
                     (match passed with | True => "ok " | False => "FAIL " end)
                     (prim_string_concat name
                       (match passed with
                        | True => ""
                        | False => prim_string_concat " " observed
                        end)));
                 report rest (orb failed (notb passed))
          end
      end) tests False;

def checker_test_fuel : Nat := mul 50 40;

def checker_test_verdict (result : FileResult) : String :=
    match result with
    | FROk _ => "accept"
    | FRErr code name =>
        prim_string_concat "reject code="
          (prim_string_concat (prim_string_of_nat code)
            (prim_string_concat " name=" (prim_string_of_nat name)))
    end;

def checker_test_accepts (result : FileResult) : Bool :=
    match result with
    | FROk _ => True
    | FRErr _ _ => False
    end;

def checker_test_accept (name : String) (items : List FileItem) : CheckerTest :=
    let result : FileResult := check_file checker_test_fuel items in
    CheckerLaw name (checker_test_accepts result) (checker_test_verdict result);

def checker_test_reject (name : String) (items : List FileItem) : CheckerTest :=
    let result : FileResult := check_file checker_test_fuel items in
    CheckerLaw name (notb (checker_test_accepts result)) (checker_test_verdict result);

def checker_test_infers (sig : List Entry) (term : CoreTerm) : Bool :=
    match infer_checked checker_test_fuel sig (Nil CoreTerm) (IGTerm term) with
    | CheckErr _ => False
    | CheckOk _ => True
    end;

-- A failed reduction is not evidence of inequality; conversion and cumulativity
-- laws must inspect their typed results.
def checker_test_conversion (expected : Bool) (fuel : Nat) (sig : List Entry)
    (left : CoreTerm) (right : CoreTerm) : Bool :=
    match conv_checked fuel sig left right with
    | Normalized actual => match expected with | True => actual | False => notb actual end
    | NormalizeMalformed _ => False
    | NormalizeExhausted => False
    end;

def checker_test_cumulative (expected : Bool) (fuel : Nat) (sig : List Entry)
    (left : CoreTerm) (right : CoreTerm) : Bool :=
    match cumul_checked fuel sig left right with
    | CheckOk actual => match expected with | True => actual | False => notb actual end
    | CheckErr _ => False
    end;

-- Applying a sort or Pi is malformed, not a successfully normalized
-- inequality. Require its precise typed fault rather than any failure.
def checker_test_conversion_nonfunction (fuel : Nat) (sig : List Entry)
    (left : CoreTerm) (right : CoreTerm) : Bool :=
    match conv_checked fuel sig left right with
    | NormalizeMalformed fault => match fault with
      | NormalizeNonFunction => True
      | NormalizeCaseBranchCount => False
      | NormalizeCaseScrutinee => False
      | NormalizeCaseInductive => False
      | NormalizeCaseParameters => False
      | NormalizeCaseConstructor => False
      | NormalizeCaseArguments => False
      | NormalizeFixArgument => False
      | NormalizeFixArity => False
      | NormalizeUnreducedHead => False
      | NormalizeStringBytes => False
      | NormalizeStringArguments => False
      | NormalizeUnresolvedLiteral => False
      | NormalizeStringType => False
      end
    | Normalized _ => False
    | NormalizeExhausted => False
    end;

def checker_test_base : List FileItem :=
    [FInd checker_test_nat_decl, FInd checker_test_bool_decl];

def checker_test_signature : List Entry :=
    match check_file checker_test_fuel checker_test_base with
    | FROk sig => sig
    | FRErr _ _ => Nil Entry
    end;

def checker_test_with (item : FileItem) : List FileItem :=
    append FileItem checker_test_base ([item] : List FileItem);

def checker_test_nat_case (motive : CoreTerm) (annotation : CoreTerm)
    : CoreTerm :=
    CCase (MkCaseInfo 10 0 ([0, 1] : List Nat)) motive
      (CApp (CConstruct 10 1 0) checker_test_zero)
      ([checker_test_zero, CLam annotation checker_test_zero] : List CoreTerm);

def checker_test_nondecreasing : CoreTerm :=
    CFix 51 0 1 (CPi checker_test_nat checker_test_nat)
      (CLam checker_test_nat (CApp (CRel 1) (CRel 0)));

-- constructor_universe_above_inductive.json and its positive ceiling pair.
def checker_test_universe_decl (sort : Nat) : IndDecl :=
    MkIndDecl 60 (Nil Param) (Nil CoreTerm) sort
      ([MkCtor 61 (CPi (CSort 0) (CInd 60))] : List Ctor);

-- nested_negative_inductive_argument.json: Negative's parameter is contravariant.
def checker_test_positive_function : IndDecl :=
    MkIndDecl 75 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 76 (CPi (CPi checker_test_nat (CInd 75)) (CInd 75))] : List Ctor);

def checker_test_negative_function : IndDecl :=
    MkIndDecl 75 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 76 (CPi (CPi (CInd 75) checker_test_nat) (CInd 75))] : List Ctor);

def checker_test_parameter_self_reference : IndDecl :=
    MkIndDecl 77 ([MkParam 78 (CInd 77)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 79 (CPi (CInd 77) (CApp (CInd 77) (CRel 0)))] : List Ctor);

def checker_test_duplicate_constructors : IndDecl :=
    MkIndDecl 80 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 81 (CInd 80), MkCtor 81 (CInd 80)] : List Ctor);

def checker_test_sequence : IndDecl :=
    MkIndDecl 82 ([MkParam 83 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([ MkCtor 84 (CPi (CSort 0) (CApp (CInd 82) (CRel 0)))
       , MkCtor 85
          (CPi (CSort 0)
            (CPi (CRel 0)
              (CPi (CApp (CInd 82) (CRel 1))
                (CApp (CInd 82) (CRel 2)))))
       ] : List Ctor);

-- Motives bind indices and the scrutinee; parameters come from the scrutinee.
-- This is the retained core contract exercised by smith_kernel_laws.ml.
def checker_test_box_base : List FileItem :=
    [ FAxiom 40 (CSort 0)
    , FAxiom 41 (CSort 0)
    , FAxiom 42 (CConst 40)
    , FInd checker_test_box
    ];

def checker_test_box_case (motive_parameter : Nat) : CoreTerm :=
    CCase (MkCaseInfo 30 1 ([1] : List Nat))
      (CLam (CApp (CInd 30) (CConst motive_parameter)) (CSort 0))
      (CApp (CApp (CConstruct 30 0 1) (CConst 40)) (CConst 42))
      ([CLam (CConst 40) (CConst 40)] : List CoreTerm);

def checker_test_box_items (motive_parameter : Nat) : List FileItem :=
    append FileItem checker_test_box_base
      ([FDef 43 (CSort 0) (checker_test_box_case motive_parameter)] : List FileItem);

def checker_test_box_infers : Bool :=
    match check_file checker_test_fuel checker_test_box_base with
    | FROk sig => checker_test_infers sig (checker_test_box_case 40)
    | FRErr _ _ => False
    end;

def checker_test_box_parameter_error : Bool :=
    match check_declarations CheckExactCore keep_checking checker_test_fuel
      (checker_test_box_items 41) with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure =>
        andb (eqNat name 43)
          (andb
            (match phase with
             | CheckDeclarationBody => True
             | CheckDeclarationPlan => False
             | CheckDeclarationType => False
             | CheckInductiveDeclaration => False
             end)
            (match failure with
             | CheckTypeFailure fault =>
                 match fault with
                 | CheckTypeMismatch => True
                 | CheckExpectedSort => False
                 | CheckExpectedFunction => False
                 | CheckCaseMotive => False
                 | CheckNonPositive => False
                 | CheckNonTerminating => False
                 | CheckUniverseBound => False
                 end
             | CheckMalformedCore _ => False
             | CheckReductionFailure _ => False
             | CheckResourceLimit => False
             | CheckUnsupported _ => False
             | CheckCancelled => False
             | CheckInternalFailure _ => False
             | CheckPrimitiveFailure _ => False
             end))
    end;

-- Indexed motives must use their bound index in the scrutinee domain.
def checker_test_indexed_decl : IndDecl :=
    MkIndDecl 95 (Nil Param) ([checker_test_nat] : List CoreTerm) 0
      ([MkCtor 96 (CApp (CInd 95) checker_test_zero)] : List Ctor);

def checker_test_indexed_base : List FileItem :=
    checker_test_with (FInd checker_test_indexed_decl);

def checker_test_indexed_case (scrutinee_index : CoreTerm) : CoreTerm :=
    CCase (MkCaseInfo 95 0 ([0] : List Nat))
      (CLam checker_test_nat
        (CLam (CApp (CInd 95) scrutinee_index) (CApp (CInd 95) (CRel 1))))
      (CConstruct 95 0 0) ([CConstruct 95 0 0] : List CoreTerm);

def checker_test_indexed_items (scrutinee_index : CoreTerm) : List FileItem :=
    append FileItem checker_test_indexed_base
      ([FDef 97 (CApp (CInd 95) checker_test_zero)
        (checker_test_indexed_case scrutinee_index)] : List FileItem);

def checker_test_indexed_infers : Bool :=
    match check_file checker_test_fuel checker_test_indexed_base with
    | FROk sig => checker_test_infers sig (checker_test_indexed_case (CRel 0))
    | FRErr _ _ => False
    end;

def checker_test_bad_branch_type : CoreTerm :=
    CCase (MkCaseInfo 10 0 ([0, 1] : List Nat))
      checker_test_nat_motive checker_test_zero
      ([checker_test_true, CLam checker_test_nat checker_test_zero] : List CoreTerm);

def checker_test_fuel_error : Bool :=
    match check_file 0 checker_test_base with
    | FROk _ => False
    | FRErr code _ => eqNat code 4
    end;

-- A positive occurrence search must not succeed by exhausting its own fuel.
def checker_test_positivity_fuel : Bool :=
    notb (arg_positive 1 75 (CPi (CInd 75) checker_test_nat));

def checker_test_deep_lift : Bool :=
    eqTerm (mul 20 25)
      (lift 1 (checker_test_lambdas 205 (CRel 205)))
      (checker_test_lambdas 205 (CRel 206));

def checker_test_deep_substitution : Bool :=
    eqTerm (mul 20 25)
      (subst checker_test_zero (checker_test_lambdas 205 (CRel 205)))
      (checker_test_lambdas 205 checker_test_zero);

-- Branch arity does not add implicit binders around explicit branch lambdas.
def checker_test_case_lift : Bool :=
    eqTerm 100
      (lift 1
        (CCase (MkCaseInfo 10 0 ([0, 1] : List Nat))
          checker_test_nat_motive (CRel 0)
          ([CRel 0, CLam checker_test_nat (CRel 1)] : List CoreTerm)))
      (CCase (MkCaseInfo 10 0 ([0, 1] : List Nat))
        checker_test_nat_motive (CRel 1)
        ([CRel 1, CLam checker_test_nat (CRel 2)] : List CoreTerm));

-- The annotation contains the escaping fix reference (smith_kernel_laws.ml).
def checker_test_recursion_annotation : Bool :=
    notb
      (check_termination 0 1 200
        (CLam (CSort 0)
          (CCase (MkCaseInfo 10 0 ([1] : List Nat)) (CSort 0) (CRel 0)
            ([CLam (CRel 1) (CRel 0)] : List CoreTerm))));

def checker_test_pi_cumulative : Bool :=
    checker_test_cumulative True 100 checker_test_signature
      (CPi checker_test_nat (CSort 0)) (CPi checker_test_nat (CSort 1));

def checker_test_pi_domain_invariant : Bool :=
    checker_test_cumulative False 100 checker_test_signature
      (CPi (CSort 0) (CSort 0)) (CPi (CSort 1) (CSort 0));

def checker_test_fix_alpha : Bool :=
    checker_test_conversion True 200 checker_test_signature (checker_test_copy 50) (checker_test_copy 51);

def checker_test_fix_pair_type : CoreTerm :=
    CPi checker_test_nat (CPi checker_test_nat checker_test_nat);

def checker_test_fix_pair (name : Nat) (rec_arg : Nat) (arity : Nat) : CoreTerm :=
    CFix name rec_arg arity checker_test_fix_pair_type
      (CLam checker_test_nat (CLam checker_test_nat (CRel 0)));

-- Both inputs have valid recursion metadata. A malformed term or exhausted
-- conversion must not count as evidence that two neutral fixpoints differ.
def checker_test_fix_comparison (expected : Bool) (left : CoreTerm)
    (right : CoreTerm) : Bool :=
    checker_test_conversion expected 200 checker_test_signature left right;

def checker_test_eta : Bool :=
    let sig : List Entry :=
      Cons Entry
        (MkEntry 90 (CPi checker_test_nat checker_test_nat) (Nothing CoreTerm))
        checker_test_signature in
    checker_test_conversion True 100 sig (CConst 90)
      (CLam checker_test_nat (CApp (CConst 90) (CRel 0)));

def checker_test_eta_argument : Bool :=
    match check_file checker_test_fuel
      (append FileItem checker_test_base
        ([ FAxiom 90 (CPi checker_test_nat checker_test_nat)
         , FAxiom 91 (CPi (CPi checker_test_nat checker_test_nat) (CSort 0))
         ] : List FileItem)) with
    | FRErr _ _ => False
    | FROk sig =>
        checker_test_conversion True 100 sig
          (CApp (CConst 91) (CConst 90))
          (CApp (CConst 91)
            (CLam checker_test_nat (CApp (CConst 90) (CRel 0))))
    end;

def checker_test_preserve_lift_branches : Bool :=
    eqTerm 100
      (lift 1
        (CCase (MkCaseInfo 10 0 ([0] : List Nat))
          checker_test_nat_motive (CRel 0)
          ([CRel 0, CLam checker_test_nat (CRel 1)] : List CoreTerm)))
      (CCase (MkCaseInfo 10 0 ([0] : List Nat))
        checker_test_nat_motive (CRel 1)
        ([CRel 1, CLam checker_test_nat (CRel 2)] : List CoreTerm));

def checker_test_preserve_subst_branches : Bool :=
    eqTerm 100
      (subst checker_test_zero
        (CCase (MkCaseInfo 10 0 ([0] : List Nat))
          checker_test_nat_motive (CRel 0)
          ([CRel 0, CLam checker_test_nat (CRel 1)] : List CoreTerm)))
      (CCase (MkCaseInfo 10 0 ([0] : List Nat))
        checker_test_nat_motive checker_test_zero
        ([checker_test_zero, CLam checker_test_nat checker_test_zero] : List CoreTerm));

def checker_test_fix_lift : Bool :=
    eqTerm 100
      (lift 1 (CFix 50 0 1 (CRel 0) (CLam checker_test_nat (CRel 2))))
      (CFix 50 0 1 (CRel 1) (CLam checker_test_nat (CRel 3)));

def checker_test_fix_substitution : Bool :=
    eqTerm 100
      (subst checker_test_zero
        (CFix 50 0 1 (CRel 0) (CLam checker_test_nat (CRel 2))))
      (CFix 50 0 1 checker_test_zero (CLam checker_test_nat checker_test_zero));

def checker_test_sort_alias : Bool :=
    match check_file checker_test_fuel
      ([FDef 91 (CSort 1) (CSort 0), FAxiom 92 (CConst 91)] : List FileItem) with
    | FROk sig => checker_test_infers sig (CLam (CConst 92) (CRel 0))
    | FRErr _ _ => False
    end;

def checker_module_tests : List CheckerTest :=
      ([ checker_test_accept "accept ordinary inductives" checker_test_base
       , checker_test_accept "accept explicit assumption"
          (checker_test_with (FAxiom 50 checker_test_nat))
       , checker_test_reject "reject wrong declaration body"
          (checker_test_with (FDef 50 checker_test_nat checker_test_true))
       , checker_test_reject "reject unknown declaration body"
          (checker_test_with (FDef 50 checker_test_nat (CConst 99)))
       , checker_test_reject "reject unchecked self reference"
          (checker_test_with (FDef 50 checker_test_nat (CConst 50)))
       , checker_test_accept "accept decreasing structural fix"
          (checker_test_with (FDef 50 (CPi checker_test_nat checker_test_nat)
            (checker_test_copy 50)))
       , checker_test_reject "reject nondecreasing structural fix"
          (checker_test_with (FDef 51 (CPi checker_test_nat checker_test_nat)
            checker_test_nondecreasing))
       , checker_test_accept "accept parameterized recursive sequence"
          ([FInd checker_test_sequence] : List FileItem)
       , checker_test_reject "reject nested negative parameter"
          ([FInd checker_test_negative_wrapper, FInd checker_test_nested_negative]
            : List FileItem)
       , checker_test_accept "accept positive function constructor"
          (checker_test_with (FInd checker_test_positive_function))
       , checker_test_reject "reject negative function constructor"
          (checker_test_with (FInd checker_test_negative_function))
       , checker_test_reject "reject constructor above universe ceiling"
          ([FInd (checker_test_universe_decl 0)] : List FileItem)
       , checker_test_accept "accept constructor within universe ceiling"
          ([FInd (checker_test_universe_decl 1)] : List FileItem)
       , checker_test_reject "reject inductive parameter self reference"
          ([FInd checker_test_parameter_self_reference] : List FileItem)
       , checker_test_reject "reject duplicate global"
          (append FileItem checker_test_base
            ([FAxiom 50 checker_test_nat, FAxiom 50 checker_test_nat] : List FileItem))
       , checker_test_reject "reject duplicate constructor names"
          ([FInd checker_test_duplicate_constructors] : List FileItem)
       , checker_test_reject "reject global replacing constructor"
          (checker_test_with (FAxiom 11 (CSort 0)))
       , checker_test_accept "accept checked case motive and branches"
          (checker_test_with (FDef 50 checker_test_nat
            (checker_test_nat_case checker_test_nat_motive checker_test_nat)))
       , checker_test_reject "reject unknown case motive"
          (checker_test_with (FDef 50 checker_test_nat
            (checker_test_nat_case (CConst 99) checker_test_nat)))
       , checker_test_accept "accept motive using scrutinee parameter"
          (checker_test_box_items 40)
       , checker_test_assert "reject motive changing scrutinee parameter with exact body type error"
          checker_test_box_parameter_error
       , checker_test_assert "infer parameterized dependent case" checker_test_box_infers
       , checker_test_accept "accept motive with dependent index result"
          (checker_test_indexed_items (CRel 0))
       , checker_test_reject "reject motive changing bound index"
          (checker_test_indexed_items checker_test_zero)
       , checker_test_assert "infer motive with dependent index result"
          checker_test_indexed_infers
       , checker_test_reject "reject unknown branch annotation"
          (checker_test_with (FDef 50 checker_test_nat
            (checker_test_nat_case checker_test_nat_motive (CConst 99))))
       , checker_test_reject "reject mismatched branch annotation"
          (checker_test_with (FDef 50 checker_test_nat
            (checker_test_nat_case checker_test_nat_motive checker_test_bool)))
       , checker_test_reject "reject mismatched branch result"
          (checker_test_with (FDef 50 checker_test_nat checker_test_bad_branch_type))
       , checker_test_reject "reject excess case metadata"
          (checker_test_with (FDef 50 checker_test_nat checker_test_extra_case_metadata))
       , checker_test_reject "reject missing case metadata"
          (checker_test_with (FDef 50 checker_test_nat checker_test_missing_case_metadata))
       , checker_test_assert "inference rejects excess case metadata"
          (notb (checker_test_infers checker_test_signature checker_test_extra_case_metadata))
       , checker_test_assert "universe Pi codomain is cumulative" checker_test_pi_cumulative
       , checker_test_assert "universe Pi domain stays invariant" checker_test_pi_domain_invariant
       , checker_test_assert "sort inference unfolds aliases" checker_test_sort_alias
       , checker_test_assert "declaration fuel has resource diagnostic" checker_test_fuel_error
       , checker_test_assert "positivity exhaustion rejects" checker_test_positivity_fuel
       , checker_test_assert "termination checks branch annotations" checker_test_recursion_annotation
       ] : List CheckerTest);

def checker_core_tests : List CheckerTest :=
    [ checker_test_assert "fix names do not affect conversion" checker_test_fix_alpha
    , checker_test_accept "accept fix with first recursive argument"
        (checker_test_with (FDef 50 checker_test_fix_pair_type (checker_test_fix_pair 50 0 2)))
    , checker_test_accept "accept fix with second recursive argument"
        (checker_test_with (FDef 50 checker_test_fix_pair_type (checker_test_fix_pair 50 1 2)))
    , checker_test_accept "accept fix returning another function"
        (checker_test_with (FDef 50 checker_test_fix_pair_type (checker_test_fix_pair 50 0 1)))
    , checker_test_assert "fix recursive argument affects conversion"
        (checker_test_fix_comparison False (checker_test_fix_pair 50 0 2) (checker_test_fix_pair 50 1 2))
    , checker_test_assert "fix arity affects conversion"
        (checker_test_fix_comparison False (checker_test_fix_pair 50 0 1) (checker_test_fix_pair 50 0 2))
    , checker_test_assert "equal fix metadata preserves alpha conversion"
        (checker_test_fix_comparison True (checker_test_fix_pair 50 0 2) (checker_test_fix_pair 51 0 2))
    , checker_test_assert "function eta conversion" checker_test_eta
    , checker_test_assert "eta inside a dependent type argument" checker_test_eta_argument
    , checker_test_assert "eta lifts an open neutral under its binder"
        (checker_test_conversion True 100 checker_test_signature (CRel 0)
          (CLam checker_test_nat (CApp (CRel 1) (CRel 0))))
    , checker_test_assert "eta is symmetric for open neutral"
        (checker_test_conversion True 100 checker_test_signature
          (CLam checker_test_nat (CApp (CRel 1) (CRel 0))) (CRel 0))
    , checker_test_assert "eta rejects a captured function variable"
        (checker_test_conversion False 100 checker_test_signature (CRel 0)
          (CLam checker_test_nat (CApp (CRel 0) (CRel 0))))
    , checker_test_assert "eta rejects sorts as functions"
        (checker_test_conversion_nonfunction 100 checker_test_signature (CSort 0)
          (CLam checker_test_nat (CApp (CSort 0) (CRel 0))))
    , checker_test_assert "eta rejects Pi types as functions"
        (checker_test_conversion_nonfunction 100 checker_test_signature (CPi checker_test_nat checker_test_nat)
          (CLam checker_test_nat
            (CApp (CPi checker_test_nat checker_test_nat) (CRel 0))))
    , checker_test_assert "conversion exhaustion rejects"
        (match conv_checked 0 checker_test_signature (CRel 0) (CRel 0) with
         | NormalizeExhausted => True
         | Normalized _ => False
         | NormalizeMalformed _ => False
         end)
    , checker_test_assert "structural equality exhaustion rejects"
        (notb (eqTerm 0 (CRel 0) (CRel 0)))
    , checker_test_assert "lift crosses 200 binders" checker_test_deep_lift
    , checker_test_assert "substitution crosses 200 binders" checker_test_deep_substitution
    , checker_test_assert "substitution lifts an open replacement"
        (eqTerm 100 (subst (CRel 3) (CLam checker_test_nat (CRel 1)))
          (CLam checker_test_nat (CRel 4)))
    , checker_test_assert "case branches bind through explicit lambdas" checker_test_case_lift
    , checker_test_assert "lift preserves all branches despite malformed metadata"
        checker_test_preserve_lift_branches
    , checker_test_assert "substitution preserves all branches despite malformed metadata"
        checker_test_preserve_subst_branches
    , checker_test_assert "lift distinguishes fix type and body scopes" checker_test_fix_lift
    , checker_test_assert "substitution distinguishes fix type and body scopes"
        checker_test_fix_substitution
    ];

def checker_test_select (args : List String) : IO Unit :=
    match args with
    | Nil => checker_tests_run (append CheckerTest checker_module_tests checker_core_tests)
    | Cons selector rest =>
        match rest with
        | Cons _ _ => do println "usage: compiler_check_tests [--core]"; exit 2
        | Nil =>
            match prim_string_eq selector "--core" with
            | True => checker_tests_run checker_core_tests
            | False => do println "usage: compiler_check_tests [--core]"; exit 2
            end
        end
    end;

-- @entry main
def main : IO Unit :=
    (do let! args := argv;
       match args with
       | Nil => checker_test_select (Nil String)
       | Cons _ remaining => checker_test_select remaining
       end);
