import "../../../std/collections.ouro",
  "../../../std/natx.ouro";

inductive MemoryTarget : Type :=
  | MemoryWindowsX64 : MemoryTarget
  | MemoryLinuxX64 : MemoryTarget;

inductive MemoryValidity : Type :=
  | MemoryOctets : MemoryValidity
  | MemoryBooleanByte : MemoryValidity;

inductive MemoryLayout : Type :=
  | MkMemoryLayout : Nat -> Nat -> MemoryValidity -> MemoryLayout;

private def memory_layout_width (entry : MemoryLayout) : Nat :=
    match entry with | MkMemoryLayout width _ _ => width end;

private def memory_layout_alignment (entry : MemoryLayout) : Nat :=
    match entry with | MkMemoryLayout _ alignment _ => alignment end;

private def memory_layout_validity (entry : MemoryLayout) : MemoryValidity :=
    match entry with | MkMemoryLayout _ _ validity => validity end;

inductive MemoryBinding : Type :=
  | MkMemoryBinding : MemoryTarget -> Nat -> MemoryLayout -> MemoryBinding;

private def memory_binding_target (entry : MemoryBinding) : MemoryTarget :=
    match entry with | MkMemoryBinding target _ _ => target end;

private def memory_binding_domain (entry : MemoryBinding) : Nat :=
    match entry with | MkMemoryBinding _ domain _ => domain end;

private def memory_binding_layout (entry : MemoryBinding) : MemoryLayout :=
    match entry with | MkMemoryBinding _ _ layout => layout end;

inductive MemoryPointer : Type :=
  | MkMemoryPointer : Nat -> Nat -> Nat -> MemoryPointer;

def memory_pointer_identity (entry : MemoryPointer) : Nat :=
    match entry with | MkMemoryPointer identity _ _ => identity end;

def memory_pointer_offset (entry : MemoryPointer) : Nat :=
    match entry with | MkMemoryPointer _ offset _ => offset end;

def memory_pointer_bits (entry : MemoryPointer) : Nat :=
    match entry with | MkMemoryPointer _ _ bits => bits end;

inductive MemoryRange : Type :=
  | MkMemoryRange : Nat -> Nat -> MemoryRange;

def memory_range_start (entry : MemoryRange) : Nat :=
    match entry with | MkMemoryRange start _ => start end;

def memory_range_size (entry : MemoryRange) : Nat :=
    match entry with | MkMemoryRange _ size => size end;

inductive MemoryPermissionKind : Type :=
  | MemoryOwner : MemoryPermissionKind
  | MemoryShared : MemoryPermissionKind
  | MemoryExclusive : MemoryPermissionKind;

inductive MemoryPermission : Type :=
  | MkMemoryPermission : Nat -> Nat -> MemoryRange -> MemoryPermissionKind -> Maybe Nat -> MemoryPermission;

def memory_permission_token (entry : MemoryPermission) : Nat :=
    match entry with | MkMemoryPermission token _ _ _ _ => token end;

def memory_permission_identity (entry : MemoryPermission) : Nat :=
    match entry with | MkMemoryPermission _ identity _ _ _ => identity end;

def memory_permission_range (entry : MemoryPermission) : MemoryRange :=
    match entry with | MkMemoryPermission _ _ range _ _ => range end;

def memory_permission_kind (entry : MemoryPermission) : MemoryPermissionKind :=
    match entry with | MkMemoryPermission _ _ _ kind _ => kind end;

def memory_permission_parent (entry : MemoryPermission) : Maybe Nat :=
    match entry with | MkMemoryPermission _ _ _ _ parent => parent end;

-- Equal model histories issue equal credentials. The ledger checks the issued
-- grant as well as its number when evaluating a different branch.
private inductive MemoryCredentialData : Type :=
  | MemoryCredentialOf : MemoryPermission -> Nat -> MemoryBinding -> MemoryCredentialData;

def MemoryCredential : Type := MemoryCredentialData;

def memory_credential_id (credential : MemoryCredential) : Nat :=
    match credential with | MemoryCredentialOf permission _ _ => memory_permission_token permission end;

inductive MemoryAccess : Type :=
  | MkMemoryAccess : MemoryPointer -> MemoryCredential -> MemoryBinding -> MemoryAccess;

def memory_access_pointer (entry : MemoryAccess) : MemoryPointer :=
    match entry with | MkMemoryAccess pointer _ _ => pointer end;

def memory_access_credential (entry : MemoryAccess) : MemoryCredential :=
    match entry with | MkMemoryAccess _ credential _ => credential end;

def memory_access_binding (entry : MemoryAccess) : MemoryBinding :=
    match entry with | MkMemoryAccess _ _ binding => binding end;

inductive MemoryAllocation : Type :=
  | MkMemoryAllocation : Nat -> Nat -> MemoryBinding -> List (Maybe Nat) -> MemoryAllocation;

def memory_allocation_identity (entry : MemoryAllocation) : Nat :=
    match entry with | MkMemoryAllocation identity _ _ _ => identity end;

def memory_allocation_address (entry : MemoryAllocation) : Nat :=
    match entry with | MkMemoryAllocation _ address _ _ => address end;

private def memory_allocation_binding (entry : MemoryAllocation) : MemoryBinding :=
    match entry with | MkMemoryAllocation _ _ binding _ => binding end;

def memory_allocation_cells (entry : MemoryAllocation) : List (Maybe Nat) :=
    match entry with | MkMemoryAllocation _ _ _ cells => cells end;

private record MemoryStateData : Type where
  target : MemoryTarget;
  heap : List MemoryAllocation;
  ledger : List MemoryPermission;
  next_identity : Nat;
  next_token : Nat;
end;

def MemoryState : Type := MemoryStateData;

def memory_heap (state : MemoryState) : List MemoryAllocation := MemoryStateData_heap state;
def memory_ledger (state : MemoryState) : List MemoryPermission := MemoryStateData_ledger state;

inductive MemoryError : Type :=
  | MemoryInvalidLayout : MemoryError
  | MemoryMetadataMismatch : MemoryError
  | MemoryNullAddress : MemoryError
  | MemoryAddressOverflow : MemoryError
  | MemoryAddressInUse : MemoryError
  | MemoryAddressMismatch : MemoryError
  | MemoryStaleIdentity : MemoryError
  | MemoryPermissionMissing : MemoryError
  | MemoryPermissionDenied : MemoryError
  | MemoryBorrowConflict : MemoryError
  | MemoryActiveBorrow : MemoryError
  | MemoryOutOfBounds : MemoryError
  | MemoryMisaligned : MemoryError
  | MemoryUninitialized : MemoryError
  | MemoryWrongValueSize : MemoryError
  | MemoryInvalidValue : MemoryError
  | MemoryCapacity : MemoryError
  | MemoryFuelExhausted : MemoryError;

inductive MemoryCommand : Type :=
  | MemoryAllocate : MemoryBinding -> Nat -> Nat -> MemoryCommand
  | MemoryBorrowRead : MemoryAccess -> MemoryRange -> MemoryCommand
  | MemoryBorrowWrite : MemoryAccess -> MemoryRange -> MemoryCommand
  | MemorySplit : MemoryAccess -> Nat -> MemoryCommand
  | MemoryEndBorrow : MemoryAccess -> MemoryCommand
  | MemoryRead : MemoryAccess -> MemoryCommand
  | MemoryWrite : MemoryAccess -> List Nat -> MemoryCommand
  | MemoryMove : MemoryAccess -> MemoryCommand
  | MemoryFree : MemoryAccess -> MemoryCommand;

inductive MemoryEvent : Type :=
  | MemoryAllocated : MemoryAccess -> MemoryEvent
  | MemoryBorrowed : MemoryPermissionKind -> MemoryAccess -> MemoryEvent
  | MemorySplitDone : MemoryAccess -> MemoryAccess -> MemoryEvent
  | MemoryBorrowEnded : Nat -> MemoryEvent
  | MemoryReadDone : MemoryPointer -> List Nat -> MemoryEvent
  | MemoryWritten : MemoryPointer -> List Nat -> MemoryEvent
  | MemoryMoved : MemoryAccess -> MemoryEvent
  | MemoryFreed : Nat -> MemoryEvent;

inductive MemoryTransition : Type :=
  | MkMemoryTransition : MemoryState -> MemoryEvent -> MemoryTransition;

def memory_transition_state (entry : MemoryTransition) : MemoryState :=
    match entry with | MkMemoryTransition state _ => state end;

def memory_transition_event (entry : MemoryTransition) : MemoryEvent :=
    match entry with | MkMemoryTransition _ event => event end;

inductive MemoryRun : Type :=
  | MkMemoryRun : MemoryState -> List MemoryEvent -> Either MemoryError Unit -> MemoryRun;

def memory_run_state (entry : MemoryRun) : MemoryState :=
    match entry with | MkMemoryRun state _ _ => state end;

def memory_run_trace (entry : MemoryRun) : List MemoryEvent :=
    match entry with | MkMemoryRun _ trace _ => trace end;

def memory_run_result (entry : MemoryRun) : Either MemoryError Unit :=
    match entry with | MkMemoryRun _ _ result => result end;

def memory_empty (target : MemoryTarget) : MemoryState :=
    MkMemoryStateData target [] [] 1 1;

private def memory_max_bytes : Nat := 8;
private def memory_max_allocations : Nat := 4;
private def memory_max_permissions : Nat := 16;
-- Every allocation reserves a representable one-past address.
private def memory_max_address : Nat := sub (pow_nat 2 64) 1;

private def memory_target_eq (left : MemoryTarget) (right : MemoryTarget) : Bool :=
    match left with
    | MemoryWindowsX64 => match right with | MemoryWindowsX64 => True | MemoryLinuxX64 => False end
    | MemoryLinuxX64 => match right with | MemoryWindowsX64 => False | MemoryLinuxX64 => True end
    end;

private def memory_boolean_layout (layout : MemoryLayout) : Bool :=
    match (memory_layout_validity layout) with | MemoryOctets => False | MemoryBooleanByte => True end;

private def memory_layout_valid (layout : MemoryLayout) : Bool :=
    if andb (ltb_nat 0 (memory_layout_width layout)) (leb_nat (memory_layout_width layout) memory_max_bytes) then
      if any Nat (eq_nat (memory_layout_alignment layout)) [1, 2, 4, 8] then
        andb (eq_nat (mod_nat (memory_layout_width layout) (memory_layout_alignment layout)) 0)
          (if memory_boolean_layout layout then eq_nat (memory_layout_width layout) 1 else True)
      else False
    else False;

private def memory_binding_eq (left : MemoryBinding) (right : MemoryBinding) : Bool :=
    let left_layout : MemoryLayout := (memory_binding_layout left) in
    let right_layout : MemoryLayout := (memory_binding_layout right) in
    andb (memory_target_eq (memory_binding_target left) (memory_binding_target right))
      (andb (eq_nat (memory_binding_domain left) (memory_binding_domain right))
        (andb (eq_nat (memory_layout_width left_layout) (memory_layout_width right_layout))
          (andb (eq_nat (memory_layout_alignment left_layout) (memory_layout_alignment right_layout))
            (if memory_boolean_layout left_layout then memory_boolean_layout right_layout
             else notb (memory_boolean_layout right_layout)))));

private def memory_aligned (address : Nat) (alignment : Nat) : Bool :=
    if eq_nat alignment 1 then True else eq_nat (mod_nat address alignment) 0;

private def memory_range_fits (capacity : Nat) (offset : Nat) (width : Nat) : Bool :=
    if leb_nat offset capacity then andb (ltb_nat 0 width) (leb_nat width (sub capacity offset))
    else False;

private def memory_overlap (left : Nat) (left_size : Nat) (right : Nat) (right_size : Nat) : Bool :=
    andb (ltb_nat left (add right_size right)) (ltb_nat right (add left_size left));

private def memory_allocation_size (allocation : MemoryAllocation) : Nat :=
    length (Maybe Nat) (memory_allocation_cells allocation);

private def memory_pointer_at (allocation : MemoryAllocation) (offset : Nat) : MemoryPointer :=
    MkMemoryPointer (memory_allocation_identity allocation) offset (add offset (memory_allocation_address allocation));

private def memory_access_for (allocation : MemoryAllocation) (permission : MemoryPermission) : MemoryAccess :=
    let range : MemoryRange := (memory_permission_range permission) in
    MkMemoryAccess (memory_pointer_at allocation (memory_range_start range))
      (MemoryCredentialOf permission (memory_allocation_address allocation) (memory_allocation_binding allocation)) (memory_allocation_binding allocation);

private def memory_direct_child (token : Nat) (permission : MemoryPermission) : Bool :=
    match (memory_permission_parent permission) with | Nothing => False | Just parent => eq_nat parent token end;

private def memory_has_borrow (state : MemoryStateData) (permission : MemoryPermission) : Bool :=
    any MemoryPermission (memory_direct_child (memory_permission_token permission)) (MemoryStateData_ledger state);

private def memory_owning (kind : MemoryPermissionKind) : Bool :=
    match kind with | MemoryOwner => True | MemoryShared => False | MemoryExclusive => False end;

private def memory_shared (kind : MemoryPermissionKind) : Bool :=
    match kind with | MemoryOwner => False | MemoryShared => True | MemoryExclusive => False end;

private def memory_permission_eq (issued : MemoryPermission) (current : MemoryPermission) : Bool :=
    let issued_range : MemoryRange := (memory_permission_range issued) in
    let current_range : MemoryRange := (memory_permission_range current) in
    andb (eq_nat (memory_permission_identity issued) (memory_permission_identity current))
      (andb (eq_nat (memory_range_start issued_range) (memory_range_start current_range))
        (andb (eq_nat (memory_range_size issued_range) (memory_range_size current_range))
          (andb (if memory_owning (memory_permission_kind issued) then memory_owning (memory_permission_kind current)
                 else if memory_shared (memory_permission_kind issued) then memory_shared (memory_permission_kind current)
                 else notb (orb (memory_owning (memory_permission_kind current)) (memory_shared (memory_permission_kind current))))
            (match (memory_permission_parent issued) with
             | Nothing => match (memory_permission_parent current) with | Nothing => True | Just _ => False end
             | Just token => memory_direct_child token current
             end))));

private def memory_lookup (state : MemoryStateData) (access : MemoryAccess)
    : Either MemoryError (Pair MemoryAllocation MemoryPermission) :=
    let pointer : MemoryPointer := (memory_access_pointer access) in
    let failure : MemoryError -> Either MemoryError (Pair MemoryAllocation MemoryPermission) :=
      Left MemoryError (Pair MemoryAllocation MemoryPermission) in
    match (memory_access_credential access) with
    | MemoryCredentialOf issued address binding =>
        match find MemoryAllocation (fun (entry : MemoryAllocation) => eq_nat (memory_pointer_identity pointer) (memory_allocation_identity entry)) (MemoryStateData_heap state) with
        | Nothing => failure MemoryStaleIdentity
        | Just allocation =>
            let original : MemoryBinding := memory_allocation_binding allocation in
            if notb (andb (memory_binding_eq (memory_access_binding access) original) (memory_binding_eq binding original)) then
              failure MemoryMetadataMismatch
            else if notb (leb_nat (memory_pointer_offset pointer) (memory_allocation_size allocation)) then failure MemoryOutOfBounds
            else if notb (eq_nat (memory_pointer_bits pointer) (add (memory_pointer_offset pointer) (memory_allocation_address allocation))) then failure MemoryAddressMismatch
            else if notb (eq_nat address (memory_allocation_address allocation)) then failure MemoryPermissionMissing
            else match find MemoryPermission (fun (entry : MemoryPermission) =>
                andb (eq_nat (memory_permission_token issued) (memory_permission_token entry))
                  (andb (eq_nat (memory_pointer_identity pointer) (memory_permission_identity entry)) (memory_permission_eq issued entry))) (MemoryStateData_ledger state) with
              | Nothing => failure MemoryPermissionMissing
              | Just permission => Right MemoryError (Pair MemoryAllocation MemoryPermission)
                  (MkPair MemoryAllocation MemoryPermission allocation permission)
              end
        end
    end;

def memory_access_at (state : MemoryState) (access : MemoryAccess) (offset : Nat) : Either MemoryError MemoryAccess :=
    match memory_lookup state access with
    | Left error => Left MemoryError MemoryAccess error
    | Right pair => match pair with
      | MkPair allocation _ =>
          if leb_nat offset (memory_allocation_size allocation) then
            Right MemoryError MemoryAccess (MkMemoryAccess (memory_pointer_at allocation offset) (memory_access_credential access) (memory_access_binding access))
          else Left MemoryError MemoryAccess MemoryOutOfBounds
      end
    end;

private def memory_accept (state : MemoryState) (event : MemoryEvent) : Either MemoryError MemoryTransition :=
    Right MemoryError MemoryTransition (MkMemoryTransition state event);

private def memory_refuse : MemoryError -> Either MemoryError MemoryTransition :=
    Left MemoryError MemoryTransition;

private def memory_remove_permission (token : Nat) (state : MemoryStateData) : List MemoryPermission :=
    filter MemoryPermission (fun (entry : MemoryPermission) => neb_nat token (memory_permission_token entry)) (MemoryStateData_ledger state);

private def memory_allocate (state : MemoryStateData) (binding : MemoryBinding) (address : Nat) (size : Nat)
    : Either MemoryError MemoryTransition :=
    let layout : MemoryLayout := (memory_binding_layout binding) in
    if notb (memory_target_eq (MemoryStateData_target state) (memory_binding_target binding)) then memory_refuse MemoryMetadataMismatch
    else if notb (memory_layout_valid layout) then memory_refuse MemoryInvalidLayout
    else if notb (memory_range_fits memory_max_bytes 0 size) then memory_refuse MemoryOutOfBounds
    else if neb_nat (mod_nat size (memory_layout_width layout)) 0 then memory_refuse MemoryInvalidLayout
    else if eq_nat address 0 then memory_refuse MemoryNullAddress
    else if notb (leb_nat (add size address) memory_max_address) then memory_refuse MemoryAddressOverflow
    else if notb (memory_aligned address (memory_layout_alignment layout)) then memory_refuse MemoryMisaligned
    else if any MemoryAllocation (fun (entry : MemoryAllocation) =>
      memory_overlap address size (memory_allocation_address entry) (memory_allocation_size entry)) (MemoryStateData_heap state) then memory_refuse MemoryAddressInUse
    else if notb (andb (ltb_nat (length MemoryAllocation (MemoryStateData_heap state)) memory_max_allocations)
        (ltb_nat (length MemoryPermission (MemoryStateData_ledger state)) memory_max_permissions)) then memory_refuse MemoryCapacity
    else
      let allocation : MemoryAllocation :=
        MkMemoryAllocation (MemoryStateData_next_identity state) address binding (replicate (Maybe Nat) (Nothing Nat) size) in
      let permission : MemoryPermission := MkMemoryPermission (MemoryStateData_next_token state) (MemoryStateData_next_identity state)
        (MkMemoryRange 0 size) MemoryOwner (Nothing Nat) in
      memory_accept (MkMemoryStateData (MemoryStateData_target state) (Cons MemoryAllocation allocation (MemoryStateData_heap state))
        (Cons MemoryPermission permission (MemoryStateData_ledger state)) (S (MemoryStateData_next_identity state)) (S (MemoryStateData_next_token state)))
        (MemoryAllocated (memory_access_for allocation permission));

-- Direct children reserve their full ranges until they close, including while
-- their own split children are live.
private def memory_borrow_conflicts (parent : Nat) (range : MemoryRange) (kind : MemoryPermissionKind)
    (entry : MemoryPermission) : Bool :=
    let current : MemoryRange := (memory_permission_range entry) in
    andb (memory_direct_child parent entry)
      (andb (notb (andb (memory_shared kind) (memory_shared (memory_permission_kind entry))))
        (memory_overlap (memory_range_start range) (memory_range_size range) (memory_range_start current) (memory_range_size current)));

private def memory_borrow (state : MemoryStateData) (allocation : MemoryAllocation) (owner : MemoryPermission)
    (range : MemoryRange) (kind : MemoryPermissionKind) : Either MemoryError MemoryTransition :=
    if notb (memory_owning (memory_permission_kind owner)) then memory_refuse MemoryPermissionDenied
    else if notb (memory_range_fits (memory_allocation_size allocation) (memory_range_start range) (memory_range_size range)) then memory_refuse MemoryOutOfBounds
    else if any MemoryPermission (memory_borrow_conflicts (memory_permission_token owner) range kind) (MemoryStateData_ledger state) then memory_refuse MemoryBorrowConflict
    else if notb (ltb_nat (length MemoryPermission (MemoryStateData_ledger state)) memory_max_permissions) then memory_refuse MemoryCapacity
    else
      let permission : MemoryPermission := MkMemoryPermission (MemoryStateData_next_token state) (memory_allocation_identity allocation) range kind (Just Nat (memory_permission_token owner)) in
      memory_accept (MkMemoryStateData (MemoryStateData_target state) (MemoryStateData_heap state) (Cons MemoryPermission permission (MemoryStateData_ledger state))
        (MemoryStateData_next_identity state) (S (MemoryStateData_next_token state))) (MemoryBorrowed kind (memory_access_for allocation permission));

private def memory_split (state : MemoryStateData) (allocation : MemoryAllocation) (permission : MemoryPermission) (cut : Nat)
    : Either MemoryError MemoryTransition :=
    if orb (memory_owning (memory_permission_kind permission)) (memory_shared (memory_permission_kind permission)) then memory_refuse MemoryPermissionDenied
    else if memory_has_borrow state permission then memory_refuse MemoryActiveBorrow
    else
      let range : MemoryRange := (memory_permission_range permission) in
      if notb (andb (ltb_nat 0 cut) (ltb_nat cut (memory_range_size range))) then memory_refuse MemoryOutOfBounds
      else if notb (leb_nat (add 2 (length MemoryPermission (MemoryStateData_ledger state))) memory_max_permissions) then memory_refuse MemoryCapacity
      else
        let parent : Maybe Nat := Just Nat (memory_permission_token permission) in
        let left : MemoryPermission := MkMemoryPermission (MemoryStateData_next_token state) (memory_allocation_identity allocation)
          (MkMemoryRange (memory_range_start range) cut) MemoryExclusive parent in
        let right : MemoryPermission := MkMemoryPermission (S (MemoryStateData_next_token state)) (memory_allocation_identity allocation)
          (MkMemoryRange (add cut (memory_range_start range)) (sub (memory_range_size range) cut)) MemoryExclusive parent in
        memory_accept (MkMemoryStateData (MemoryStateData_target state) (MemoryStateData_heap state)
          (Cons MemoryPermission left (Cons MemoryPermission right (MemoryStateData_ledger state))) (MemoryStateData_next_identity state) (S (S (MemoryStateData_next_token state))))
          (MemorySplitDone (memory_access_for allocation left) (memory_access_for allocation right));

private def memory_end_borrow (state : MemoryStateData) (permission : MemoryPermission) : Either MemoryError MemoryTransition :=
    if memory_owning (memory_permission_kind permission) then memory_refuse MemoryPermissionDenied
    else if memory_has_borrow state permission then memory_refuse MemoryActiveBorrow
    else memory_accept (MkMemoryStateData (MemoryStateData_target state) (MemoryStateData_heap state) (memory_remove_permission (memory_permission_token permission) state)
        (MemoryStateData_next_identity state) (MemoryStateData_next_token state)) (MemoryBorrowEnded (memory_permission_token permission));

private def memory_validate_scalar (state : MemoryStateData) (allocation : MemoryAllocation) (permission : MemoryPermission)
    (pointer : MemoryPointer) (writing : Bool) : Either MemoryError Unit :=
    let binding : MemoryBinding := (memory_allocation_binding allocation) in
    let layout : MemoryLayout := (memory_binding_layout binding) in
    let range : MemoryRange := (memory_permission_range permission) in
    if notb (memory_range_fits (memory_allocation_size allocation) (memory_pointer_offset pointer) (memory_layout_width layout)) then
      Left MemoryError Unit MemoryOutOfBounds
    else if memory_has_borrow state permission then Left MemoryError Unit MemoryActiveBorrow
    else if andb writing (memory_shared (memory_permission_kind permission)) then Left MemoryError Unit MemoryPermissionDenied
    else if notb (leb_nat (memory_range_start range) (memory_pointer_offset pointer)) then Left MemoryError Unit MemoryPermissionDenied
    else if notb (memory_range_fits (memory_range_size range) (sub (memory_pointer_offset pointer) (memory_range_start range)) (memory_layout_width layout)) then
      Left MemoryError Unit MemoryPermissionDenied
    else if notb (memory_aligned (memory_pointer_bits pointer) (memory_layout_alignment layout)) then Left MemoryError Unit MemoryMisaligned
    else Right MemoryError Unit MkUnit;

private def memory_scalar_bytes_valid (layout : MemoryLayout) (bytes : List Nat) : Bool :=
    let upper : Nat := if memory_boolean_layout layout then 2 else 256 in
    all Nat (fun (byte : Nat) => ltb_nat byte upper) bytes;

private def memory_read (state : MemoryStateData) (allocation : MemoryAllocation) (permission : MemoryPermission)
    (pointer : MemoryPointer) : Either MemoryError MemoryTransition :=
    match memory_validate_scalar state allocation permission pointer False with
    | Left error => memory_refuse error
    | Right _ =>
        let binding : MemoryBinding := (memory_allocation_binding allocation) in
        let layout : MemoryLayout := (memory_binding_layout binding) in
        let cells : List (Maybe Nat) := take (Maybe Nat) (memory_layout_width layout) (drop (Maybe Nat) (memory_pointer_offset pointer) (memory_allocation_cells allocation)) in
        let bytes : List Nat := filter_map (Maybe Nat) Nat (fun (cell : Maybe Nat) => cell) cells in
        if neb_nat (length Nat bytes) (memory_layout_width layout) then memory_refuse MemoryUninitialized
        else if notb (memory_scalar_bytes_valid layout bytes) then memory_refuse MemoryInvalidValue
        else memory_accept state (MemoryReadDone pointer bytes)
    end;

private def memory_write (state : MemoryStateData) (allocation : MemoryAllocation) (permission : MemoryPermission)
    (pointer : MemoryPointer) (bytes : List Nat) : Either MemoryError MemoryTransition :=
    match memory_validate_scalar state allocation permission pointer True with
    | Left error => memory_refuse error
    | Right _ =>
        let binding : MemoryBinding := (memory_allocation_binding allocation) in
        let layout : MemoryLayout := (memory_binding_layout binding) in
        if neb_nat (length Nat (take Nat (S (memory_layout_width layout)) bytes)) (memory_layout_width layout) then memory_refuse MemoryWrongValueSize
        else if notb (memory_scalar_bytes_valid layout bytes) then memory_refuse MemoryInvalidValue
        else
          let cells : List (Maybe Nat) := append (Maybe Nat) (take (Maybe Nat) (memory_pointer_offset pointer) (memory_allocation_cells allocation))
            (append (Maybe Nat) (map Nat (Maybe Nat) (Just Nat) bytes)
              (drop (Maybe Nat) (add (memory_layout_width layout) (memory_pointer_offset pointer)) (memory_allocation_cells allocation))) in
          let replacement : MemoryAllocation := MkMemoryAllocation (memory_allocation_identity allocation) (memory_allocation_address allocation) (memory_allocation_binding allocation) cells in
          let heap : List MemoryAllocation := map MemoryAllocation MemoryAllocation
            (fun (entry : MemoryAllocation) => if eq_nat (memory_allocation_identity entry) (memory_allocation_identity allocation) then replacement else entry) (MemoryStateData_heap state) in
          memory_accept (MkMemoryStateData (MemoryStateData_target state) heap (MemoryStateData_ledger state) (MemoryStateData_next_identity state) (MemoryStateData_next_token state))
            (MemoryWritten pointer bytes)
    end;

private def memory_move (state : MemoryStateData) (allocation : MemoryAllocation) (permission : MemoryPermission)
    : Either MemoryError MemoryTransition :=
    if notb (memory_owning (memory_permission_kind permission)) then memory_refuse MemoryPermissionDenied
    else if memory_has_borrow state permission then memory_refuse MemoryActiveBorrow
    else
      let moved : MemoryPermission := MkMemoryPermission (MemoryStateData_next_token state) (memory_permission_identity permission) (memory_permission_range permission) (memory_permission_kind permission) (memory_permission_parent permission) in
      memory_accept (MkMemoryStateData (MemoryStateData_target state) (MemoryStateData_heap state)
        (Cons MemoryPermission moved (memory_remove_permission (memory_permission_token permission) state)) (MemoryStateData_next_identity state) (S (MemoryStateData_next_token state)))
        (MemoryMoved (memory_access_for allocation moved));

private def memory_free (state : MemoryStateData) (allocation : MemoryAllocation) (permission : MemoryPermission)
    : Either MemoryError MemoryTransition :=
    if notb (memory_owning (memory_permission_kind permission)) then memory_refuse MemoryPermissionDenied
    else if memory_has_borrow state permission then memory_refuse MemoryActiveBorrow
    else
      let heap : List MemoryAllocation := filter MemoryAllocation
        (fun (entry : MemoryAllocation) => neb_nat (memory_allocation_identity entry) (memory_allocation_identity allocation)) (MemoryStateData_heap state) in
      memory_accept (MkMemoryStateData (MemoryStateData_target state) heap (memory_remove_permission (memory_permission_token permission) state)
        (MemoryStateData_next_identity state) (MemoryStateData_next_token state)) (MemoryFreed (memory_allocation_identity allocation));

private def memory_with_access (state : MemoryState) (access : MemoryAccess)
    (operation : MemoryAllocation -> MemoryPermission -> Either MemoryError MemoryTransition)
    : Either MemoryError MemoryTransition :=
    match memory_lookup state access with
    | Left error => memory_refuse error
    | Right pair => match pair with | MkPair allocation permission => operation allocation permission end
    end;

def memory_step (state : MemoryState) (command : MemoryCommand) : Either MemoryError MemoryTransition :=
    match command with
    | MemoryAllocate binding address size => memory_allocate state binding address size
    | MemoryBorrowRead access range => memory_with_access state access
        (fun (allocation : MemoryAllocation) (permission : MemoryPermission) =>
          memory_borrow state allocation permission range MemoryShared)
    | MemoryBorrowWrite access range => memory_with_access state access
        (fun (allocation : MemoryAllocation) (permission : MemoryPermission) =>
          memory_borrow state allocation permission range MemoryExclusive)
    | MemorySplit access cut => memory_with_access state access
        (fun (allocation : MemoryAllocation) (permission : MemoryPermission) => memory_split state allocation permission cut)
    | MemoryEndBorrow access => memory_with_access state access
        (fun (_ : MemoryAllocation) (permission : MemoryPermission) => memory_end_borrow state permission)
    | MemoryRead access => memory_with_access state access
        (fun (allocation : MemoryAllocation) (permission : MemoryPermission) =>
          memory_read state allocation permission (memory_access_pointer access))
    | MemoryWrite access bytes => memory_with_access state access
        (fun (allocation : MemoryAllocation) (permission : MemoryPermission) =>
          memory_write state allocation permission (memory_access_pointer access) bytes)
    | MemoryMove access => memory_with_access state access (memory_move state)
    | MemoryFree access => memory_with_access state access (memory_free state)
    end;

def memory_run (fuel : Nat) (initial : MemoryState) (commands : List MemoryCommand) : MemoryRun :=
    (fix run (remaining : Nat) (state : MemoryState) (pending : List MemoryCommand)
        (reverse_trace : List MemoryEvent) : MemoryRun :=
      match pending with
      | Nil => MkMemoryRun state (reverse_lin MemoryEvent reverse_trace) (Right MemoryError Unit MkUnit)
      | Cons command rest => match remaining with
        | Z => MkMemoryRun state (reverse_lin MemoryEvent reverse_trace) (Left MemoryError Unit MemoryFuelExhausted)
        | S next => match memory_step state command with
          | Left error => MkMemoryRun state (reverse_lin MemoryEvent reverse_trace) (Left MemoryError Unit error)
          | Right transition => run next (memory_transition_state transition) rest
              (Cons MemoryEvent (memory_transition_event transition) reverse_trace)
          end
        end
      end) fuel initial commands [];
