-- Shared export cone for host parity probes and direct-PE reclamation fixtures.
-- Load the common units in the build driver's order for the host probes.
import "../compiler/native/diagnostics.ouro",
  "../compiler/native/managed_stdio_compile.ouro",
  "../tools/native_build_core.ouro",
  "native_live_runtime.ouro",
  "native_file_fixtures.ouro";

def frontend_host_file_status_parts (fuel : Nat) (limits : MirLimits) (root : List Nat)
    (files : List (Pair (List Nat) (List Nat))) : Either NativeSourceError ManagedProgramParts :=
    match native_managed_lower_units fuel limits [109,97,105,110] root files with
    | Left error => Left NativeSourceError ManagedProgramParts error
    | Right lowered => match lowered with | NativeLoweredOf checked contracts program =>
        Right NativeSourceError ManagedProgramParts (ManagedProgramOf checked contracts program) end end;

-- @entry main
def main : IO Unit := io_pure Unit MkUnit;
