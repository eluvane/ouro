-- The transitional C host retains its allocation arena for the whole process.
-- Keep both complete property domains, but release each worker's arena at exit.
import "compiler_property_typed.ouro";
import "../tools/test/process.ouro";

inductive PropertyCounts : Type :=
  | PropertyCountsOf : Nat -> Nat -> List Nat -> PropertyCounts;

inductive PropertyWorkerError : Type :=
  | PropertyWorkerCapture : NativeTestProcessError -> PropertyWorkerError
  | PropertyWorkerExit : Nat -> String -> PropertyWorkerError
  | PropertyWorkerProtocol : PropertyWorkerError;

def property_worker_error (error : PropertyWorkerError) : String :=
    match error with
    | PropertyWorkerCapture cause => test_process_error_message cause
    | PropertyWorkerExit code detail => str_cat4 "property worker exit=" (str_of_nat code) ": " detail
    | PropertyWorkerProtocol => "incomplete or invalid property worker report"
    end;

def property_fixed_mutations : Nat :=
    sum_nats (map PropertyShape Nat (fun (shape : PropertyShape) => match shape with
      | PropertyShapeOf _ _ term => property_rel_count term end) property_scope_shapes);

def property_summary (seed : Nat) (start : Nat) (scoped : Nat) (typed : Nat)
    (counts : PropertyCounts) : String :=
    match counts with | PropertyCountsOf mutations nonfirst buckets =>
      str_concat (str_join "\n" ([
        str_cat4 "ok scope shapes count=" (str_of_nat (length PropertyShape property_scope_shapes))
          " every-rel mutations=" (str_of_nat property_fixed_mutations),
        str_cat4 "ok scoped properties count=" (str_of_nat scoped) " start=" (str_of_nat start),
        str_cat4 "ok typed properties count=" (str_of_nat typed) " start=" (str_of_nat start),
        str_cat4 "ok out-of-scope mutations count=" (str_of_nat mutations) " nonfirst=" (str_of_nat nonfirst),
        str_concat "ok typed generation buckets=" (property_nats buckets),
        str_cat4 "ok compiler properties seed=" (str_of_nat seed) " samples=" (str_of_nat (add scoped typed))
      ] : List String)) "\n"
    end;

def property_report_nat (text : String) : Maybe Nat :=
    match str_parse_nat text with
    | Nothing => Nothing Nat
    | Just value => match str_eq text (str_of_nat value) with
      | True => Just Nat value | False => Nothing Nat end
    end;

def property_report_buckets : List String -> Maybe (List Nat) :=
  fix parse (remaining : List String) : Maybe (List Nat) :=
    match remaining with
    | Nil => Just (List Nat) []
    | Cons text rest => match property_report_nat text with
      | Nothing => Nothing (List Nat)
      | Just value => match parse rest with
        | Nothing => Nothing (List Nat)
        | Just values => Just (List Nat) (Cons Nat value values) end end
    end;

def property_report_counts (output : String) : Maybe PropertyCounts :=
    let lines : List String := str_lines output in
    let mutations : String := str_drop (nth String "" 3 lines) (str_len "ok out-of-scope mutations count=") in
    let buckets : String := str_drop (nth String "" 4 lines) (str_len "ok typed generation buckets=") in
    match str_split_first mutations " nonfirst=" with
    | Nothing => Nothing PropertyCounts
    | Just fields => match fields with | MkPair first second =>
      match property_report_nat first with | Nothing => Nothing PropertyCounts
      | Just total => match property_report_nat second with | Nothing => Nothing PropertyCounts
        | Just nonfirst => match property_report_buckets (str_split buckets 44) with
          | Nothing => Nothing PropertyCounts
          | Just values => Just PropertyCounts (PropertyCountsOf total nonfirst values) end end end end
    end;

def property_report_valid (seed : Nat) (start : Nat) (scoped : Nat) (typed : Nat)
    (output : String) : Maybe PropertyCounts :=
    let normalized : String := str_replace output "\r\n" "\n" in
    match property_report_counts normalized with
    | Nothing => Nothing PropertyCounts
    | Just counts => match counts with | PropertyCountsOf mutations nonfirst buckets =>
      match andb (eq_nat (length Nat buckets) 25)
        (andb (eq_nat (sum_nats buckets) typed)
          (andb (leb_nat nonfirst mutations) (andb (leb_nat mutations typed)
            (str_eq normalized (property_summary seed start scoped typed counts))))) with
      | False => Nothing PropertyCounts | True => Just PropertyCounts counts end end
    end;

-- Native children use one CPU, 120 seconds and 2560 MiB. Hosted compiler
-- suites select the existing host process boundary and its outer budget.
-- The sequential parent keeps no generated Core corpus.
def property_worker_limits : ProcessCaptureLimits :=
    ProcessCaptureLimitsOf (mul 120 (mul 10 100)) (mul 10 256) 1 (mul 32 256) (mul 32 256);

def property_worker (executable : String) (seed : Nat) (start : Nat) (scoped : Nat) (typed : Nat)
    : IO (Either PropertyWorkerError PropertyCounts) :=
    do let! captured := test_run_process property_worker_limits executable
         (["--seed", str_of_nat seed, "--start", str_of_nat start,
           "--scoped", str_of_nat scoped, "--typed", str_of_nat typed] : List String) "";
       io_pure (Either PropertyWorkerError PropertyCounts) (match captured with
       | Left error => Left PropertyWorkerError PropertyCounts (PropertyWorkerCapture error)
       | Right process =>
         match andb (eq_nat (proc_code process) 0) (str_null (proc_stderr process)) with
         | False => Left PropertyWorkerError PropertyCounts
             (PropertyWorkerExit (proc_code process) (proc_stderr process))
         | True => match property_report_valid seed start scoped typed (proc_stdout process) with
           | Nothing => Left PropertyWorkerError PropertyCounts PropertyWorkerProtocol
           | Just counts => Right PropertyWorkerError PropertyCounts counts end end
       end)

def property_isolated (executable : String) (seed : Nat) (start : Nat) (scoped : Nat) (typed : Nat)
    : IO (Either PropertyWorkerError PropertyCounts) :=
    do let! first := property_worker executable seed start scoped 0;
       match first with
       | Left error => io_pure (Either PropertyWorkerError PropertyCounts)
           (Left PropertyWorkerError PropertyCounts error)
       | Right _ => property_worker executable seed start 0 typed
       end
