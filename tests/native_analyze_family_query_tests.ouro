-- @entry main
import "../tools/analyze/native_family_query.ouro",
  "analyze/precision/assertions.ouro", "native_analyze_wire_fixtures.ouro";

-- Synthetic wire cases do not establish native worker acceptance.

def native_analyze_family_query_wire (names : String) (ending : String) : String :=
    str_concat "ANALYZE_FAMILIES families=" (str_concat names ending);

def native_analyze_family_query_result (names : String) : ProcResult :=
    MkProcResult Z (native_analyze_family_query_wire names "\n") "";

def native_analyze_family_query_error_name (error : NativeFamilyQueryError) : String :=
    match error with
    | NativeFamilyQueryRaw raw => match raw with
      | BoundedNativeReportByteLimit => "byte-limit"
      | BoundedNativeReportEncoding stream => match stream with
        | CaptureStdout => "stdout-encoding" | CaptureStderr => "stderr-encoding" end
      | BoundedNativeReportNewline stream => match stream with
        | CaptureStdout => "stdout-newline" | CaptureStderr => "stderr-newline" end
      | BoundedNativeReportStatus _ => "DWORD"
      | BoundedNativeReportPolicy policy => bounded_drive_error_message policy
      end
    | NativeFamilyQueryMissing => "missing"
    | NativeFamilyQueryMalformed => "malformed"
    | NativeFamilyQueryNames => "families"
    | NativeFamilyQueryStderr => "stderr"
    | NativeFamilyQueryExit _ => "exit"
    | NativeFamilyQueryInconsistent => "inconsistent"
    end;

def native_analyze_family_query_accept (result : ProcResult) (expected : String) : Bool :=
    match native_family_query_observe result with
    | Left _ => False
    | Right names => str_eq names expected
    end;

def native_analyze_family_query_error (result : ProcResult) (expected : String) : Bool :=
    match native_family_query_observe result with
    | Right _ => False
    | Left error => str_eq (native_analyze_family_query_error_name error) expected
    end;

def native_analyze_family_query_consistent_accept (earlier : ProcResult) (later : ProcResult)
    (expected : String) : Bool :=
    match native_family_query_consistent earlier later with
    | Left _ => False
    | Right names => str_eq names expected
    end;

def native_analyze_family_query_consistent_error (earlier : ProcResult) (later : ProcResult)
    (expected : String) : Bool :=
    match native_family_query_consistent earlier later with
    | Right _ => False
    | Left error => str_eq (native_analyze_family_query_error_name error) expected
    end;

def native_analyze_family_query_all : String :=
    "effects,capability,extract,match,cfg,dataflow,semantic,property,absint,symexec,taint,contracts,metrics,duplication,trust,simplify,perf,naming,errors";

def native_analyze_family_query_invalid_names : List String :=
    [ "", "Dataflow", "dataflow1", "data-flow", "data flow", "dataflow "
    , ",dataflow", "dataflow,", "dataflow,,perf", "dataflow,dataflow", "dataflow,perf,dataflow"
    , str_of_codes [100, 195, 169] ];

def native_analyze_family_query_invalid_utf8 : List String :=
    native_analyze_invalid_wire_strings;

def native_analyze_family_query_rows : List (Pair String Bool) :=
  [ MkPair String Bool "family-query/accept/LF"
      (native_analyze_family_query_accept (native_analyze_family_query_result "dataflow") "dataflow")
  , MkPair String Bool "family-query/accept/CRLF"
      (native_analyze_family_query_accept
        (MkProcResult Z (native_analyze_family_query_wire "dataflow,perf" "\r\n") "")
        "dataflow,perf")
  , MkPair String Bool "family-query/accept/style-order"
      (native_analyze_family_query_accept
        (native_analyze_family_query_result "dataflow,metrics,simplify,perf,naming")
        "dataflow,metrics,simplify,perf,naming")
  , MkPair String Bool "family-query/accept/all-owner-order"
      (native_analyze_family_query_accept
        (native_analyze_family_query_result native_analyze_family_query_all)
        native_analyze_family_query_all)
  , MkPair String Bool "family-query/accept/emitted-order-retained"
      (native_analyze_family_query_accept
        (native_analyze_family_query_result "trust,effects") "trust,effects")
  , MkPair String Bool "family-query/accept/owner-can-evolve-names"
      (native_analyze_family_query_accept
        (native_analyze_family_query_result "next_family,_") "next_family,_")
  , MkPair String Bool "family-query/accept/no-hardcoded-19-cap"
      (native_analyze_family_query_accept
        (native_analyze_family_query_result "a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t")
        "a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t")
  , MkPair String Bool "family-query/output/missing"
      (native_analyze_family_query_error (MkProcResult Z "" "") "missing")
  , MkPair String Bool "family-query/output/empty-line"
      (native_analyze_family_query_error (MkProcResult Z "\n" "") "malformed")
  , MkPair String Bool "family-query/output/invalid-names"
      (all String (fun (names : String) => native_analyze_family_query_error
        (native_analyze_family_query_result names) "families")
        native_analyze_family_query_invalid_names)
  , MkPair String Bool "family-query/output/wrong-marker"
      (native_analyze_family_query_error
        (MkProcResult Z "ANALYZE_DRIVE families=dataflow\n" "") "malformed")
  , MkPair String Bool "family-query/output/wrong-field"
      (native_analyze_family_query_error
        (MkProcResult Z "ANALYZE_FAMILIES family=dataflow\n" "") "malformed")
  , MkPair String Bool "family-query/output/partial-marker"
      (native_analyze_family_query_error
        (MkProcResult Z "ANALYZE_FAMILIES fam\n" "") "malformed")
  , MkPair String Bool "family-query/output/leading-bytes"
      (native_analyze_family_query_error
        (MkProcResult Z " ANALYZE_FAMILIES families=dataflow\n" "") "malformed")
  , MkPair String Bool "family-query/output/BOM"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat (str_of_codes [239, 187, 191])
          (native_analyze_family_query_wire "dataflow" "\n")) "") "malformed")
  , MkPair String Bool "family-query/output/repeated-identical"
      (let row : String := native_analyze_family_query_wire "dataflow" "\n" in
        native_analyze_family_query_error (MkProcResult Z (str_concat row row) "") "malformed")
  , MkPair String Bool "family-query/output/repeated-different"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat (native_analyze_family_query_wire "dataflow" "\n")
          (native_analyze_family_query_wire "perf" "\n")) "") "malformed")
  , MkPair String Bool "family-query/output/leading-empty-row"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat "\n" (native_analyze_family_query_wire "dataflow" "\n")) "")
        "malformed")
  , MkPair String Bool "family-query/output/trailing-empty-row"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat (native_analyze_family_query_wire "dataflow" "\n") "\n") "")
        "malformed")
  , MkPair String Bool "family-query/output/extra-row"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat (native_analyze_family_query_wire "dataflow" "\n") "noise\n") "")
        "malformed")
  , MkPair String Bool "family-query/output/no-final-newline"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "") "") "stdout-newline")
  , MkPair String Bool "family-query/output/bare-CR"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\r") "") "stdout-newline")
  , MkPair String Bool "family-query/output/truncated-extra-row"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat (native_analyze_family_query_wire "dataflow" "\n") "partial") "")
        "stdout-newline")
  , MkPair String Bool "family-query/encoding/stdout"
      (all String (fun (bytes : String) => native_analyze_family_query_error
        (MkProcResult Z (str_concat bytes "\n") "") "stdout-encoding")
        native_analyze_family_query_invalid_utf8)
  , MkPair String Bool "family-query/encoding/extra-row-is-still-checked"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat (native_analyze_family_query_wire "dataflow" "\n")
          (str_concat (str_of_codes [128]) "\n")) "") "stdout-encoding")
  , MkPair String Bool "family-query/stderr/complete-error"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\n") "error\n") "stderr")
  , MkPair String Bool "family-query/stderr/blank-is-nonempty"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\n") "\n") "stderr")
  , MkPair String Bool "family-query/stderr/valid-unicode"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\n")
          (str_concat (str_of_codes [230, 188, 162, 240, 159, 152, 128]) "\r\n")) "stderr")
  , MkPair String Bool "family-query/stderr/rejection-is-not-query-success"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\n")
          "std/io.ouro: structured analyzer could not build the unit: parse-fail\n") "stderr")
  , MkPair String Bool "family-query/stderr/unterminated"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\n") "error") "stderr-newline")
  , MkPair String Bool "family-query/encoding/stderr"
      (all String (fun (bytes : String) => native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\n")
          (str_concat bytes "\n")) "stderr-encoding") native_analyze_family_query_invalid_utf8)
  , MkPair String Bool "family-query/exit/nonzero"
      (all Nat (fun (code : Nat) => native_analyze_family_query_error
        (MkProcResult code (native_analyze_family_query_wire "dataflow" "\n") "") "exit")
        [1, 2, 137])
  , MkPair String Bool "family-query/exit/full-DWORD-payload"
      (let status : Nat := sub process_capture_u32_bound 1 in
        match native_family_query_observe
          (MkProcResult status (native_analyze_family_query_wire "dataflow" "\n") "") with
        | Right _ => False
        | Left error => if let NativeFamilyQueryExit code := (error : NativeFamilyQueryError) then
            eq_nat code status
          else False
        end)
  , MkPair String Bool "family-query/status/overflow-payload"
      (let status : Nat := S process_capture_u32_bound in
        match native_family_query_observe
          (MkProcResult status (native_analyze_family_query_wire "dataflow" "\n") "") with
        | Right _ => False
        | Left error => if let NativeFamilyQueryRaw raw := (error : NativeFamilyQueryError) then
            if let BoundedNativeReportStatus code := (raw : BoundedNativeReportError) then
              eq_nat code status
            else False
          else False
        end)
  , MkPair String Bool "family-query/priority/status-before-encoding"
      (native_analyze_family_query_error
        (MkProcResult process_capture_u32_bound (str_concat (str_of_codes [0]) "\n") "") "DWORD")
  , MkPair String Bool "family-query/priority/stdout-before-stderr-encoding"
      (native_analyze_family_query_error
        (MkProcResult Z (str_concat (str_of_codes [128]) "\n")
          (str_concat (str_of_codes [0]) "\n")) "stdout-encoding")
  , MkPair String Bool "family-query/priority/stdout-newline-before-stderr"
      (native_analyze_family_query_error
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "")
          (str_concat (str_of_codes [128]) "\n")) "stdout-newline")
  , MkPair String Bool "family-query/priority/stderr-encoding-before-marker"
      (native_analyze_family_query_error
        (MkProcResult Z "wrong\n" (str_concat (str_of_codes [128]) "\n")) "stderr-encoding")
  , MkPair String Bool "family-query/priority/families-before-stderr-and-exit"
      (native_analyze_family_query_error
        (MkProcResult 1 (native_analyze_family_query_wire "dataflow,dataflow" "\n") "error\n")
        "families")
  , MkPair String Bool "family-query/priority/stderr-before-exit"
      (native_analyze_family_query_error
        (MkProcResult 2 (native_analyze_family_query_wire "dataflow" "\n") "ANALYZE_FAIL: refusal\n")
        "stderr")
  , MkPair String Bool "family-query/consistent/equal-independent-results"
      (native_analyze_family_query_consistent_accept
        (native_analyze_family_query_result "dataflow,perf")
        (MkProcResult Z (native_analyze_family_query_wire "dataflow,perf" "\r\n") "")
        "dataflow,perf")
  , MkPair String Bool "family-query/consistent/order-change"
      (native_analyze_family_query_consistent_error
        (native_analyze_family_query_result "dataflow,perf")
        (native_analyze_family_query_result "perf,dataflow") "inconsistent")
  , MkPair String Bool "family-query/consistent/selection-change"
      (native_analyze_family_query_consistent_error
        (native_analyze_family_query_result "dataflow")
        (native_analyze_family_query_result "dataflow,perf") "inconsistent")
  , MkPair String Bool "family-query/consistent/second-must-be-valid"
      (native_analyze_family_query_consistent_error
        (native_analyze_family_query_result "dataflow")
        (native_analyze_family_query_result "dataflow,dataflow") "families")
  , MkPair String Bool "family-query/consistent/equal-bytes-nonzero-is-refused"
      (let bad : ProcResult :=
        MkProcResult 2 (native_analyze_family_query_wire "dataflow" "\n") "" in
        native_analyze_family_query_consistent_error bad bad "exit")
  , MkPair String Bool "family-query/consistent/first-refusal-keeps-priority"
      (native_analyze_family_query_consistent_error
        (MkProcResult Z (str_concat (str_of_codes [128]) "\n") "")
        (MkProcResult process_capture_u32_bound "" "") "stdout-encoding")
  , MkPair String Bool "family-query/consistent/second-missing"
      (native_analyze_family_query_consistent_error
        (native_analyze_family_query_result "dataflow") (MkProcResult Z "" "") "missing")
  , MkPair String Bool "family-query/consistent/second-stderr"
      (native_analyze_family_query_consistent_error
        (native_analyze_family_query_result "dataflow")
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "\n") "error\n") "stderr")
  , MkPair String Bool "family-query/consistent/second-truncated"
      (native_analyze_family_query_consistent_error
        (native_analyze_family_query_result "dataflow")
        (MkProcResult Z (native_analyze_family_query_wire "dataflow" "") "") "stdout-newline")
  ];

def main : IO Unit := precision_run "native-analyze-family-query" native_analyze_family_query_rows;
