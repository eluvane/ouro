-- Instrumentation changes generated managed calls after complete checking
-- and replay. Canonical MIR validation and PE phases still follow the transform.
import "native_realpath_fault_calls.ouro",
  "native_realpath_normalization.ouro";

def realpath_fault_arguments (index : Nat) : List MirType :=
    match eqNat index 0 with | True => [MirUSize, MirUSize] | False =>
      match realpath_fault_mode(index, [1,6,8] : List Nat) with | True => [MirRawPtr] | False =>
        match eqNat index 4 with | True => [MirRawPtr, MirUSize, MirRawPtr] | False =>
          match eqNat index 5 with | True => [MirRawPtr, MirRawPtr, MirUSize, MirRawPtr] | False =>
            match eqNat index 7 with | True => [MirU32]
            | False => [MirRawPtr, MirUSize, MirRawPtr, MirUSize, MirRawPtr] end end end end end;

def realpath_fault_result_type (index : Nat) : MirType :=
    match eqNat index 0 with | True => MirRawPtr | False =>
      match realpath_fault_mode(index, [1,8] : List Nat) with | True => MirU8 | False => MirU32 end end;

def realpath_fault_body (base : Nat) (mode : Nat) (index : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match eqNat index 0 with | True => realpath_fault_allocate base mode original state | False =>
      match eqNat index 1 with | True => realpath_fault_release base mode original state | False =>
        match eqNat index 2 with | True => realpath_fault_conversion base mode False original state | False =>
          match eqNat index 3 with | True => realpath_fault_conversion base mode True original state | False =>
            match eqNat index 4 with | True => realpath_fault_open base mode original state | False =>
              match eqNat index 5 with | True => realpath_fault_read base mode original state | False =>
                match eqNat index 6 with | True => realpath_fault_close base mode original state | False =>
                  startup_fault_collector base original state end end end end end end end;

def realpath_fault_exit_function (base : Nat) (mode : Nat) (original : Nat) : Either NativeLowerError MirFunction :=
    lower_map ManagedState MirFunction (fun (after : ManagedState) => match managed_flow after with | LowerStateOf _ locals _ _ =>
      MirFunctionDef (add base 7) (prim_string_to_char_codes "realpath_fault_exit") ([MirLocalDef 0 MirU32] : List MirLocal)
        (reverse MirLocal locals) (Nothing MirType) 0
        (lower_finish_blocks MirTrap (managed_flow
          (managed_emit(MirCall(MirMayGc, Nothing Nat, MirDirect original, [MirUse 0] : List MirValue), after)))) end)
      (realpath_fault_exit_checks base mode
        (ManagedStateOf(0, [] : List MirFunction, [] : List MirData, [] : List Nat, [] : List Nat, lower_empty_state 1)));

def realpath_fault_wrappers (base : Nat) (mode : Nat) (symbols : List Nat) : Either NativeLowerError (List MirFunction) :=
    (fix build (remaining : List Nat) (index : Nat) : Either NativeLowerError (List MirFunction) :=
      match remaining with | Nil => Right(NativeLowerError, List MirFunction, [] : List MirFunction)
      | Cons original rest => lower_bind MirFunction (List MirFunction) (match eqNat index 7 with
          | True => realpath_fault_exit_function base mode original
          | False => native_stdio_fixture_function (add base index) (prim_string_to_char_codes "realpath_fault_hook")
              (startup_fault_locals (realpath_fault_arguments index)) (realpath_fault_result_type index)
              (realpath_fault_body base mode index original) end)
          (fun (function : MirFunction) => lower_map (List MirFunction) (List MirFunction)
            (Cons MirFunction function) (build(rest, S index))) end) symbols 0;

def realpath_fault_instruction (base : Nat) (symbols : List Nat) (managed : Bool)
    (instruction : MirInstruction) : MirInstruction :=
    match instruction with
    | MirCall gc result target arguments => match target with
      | MirIndirect _ _ => instruction | MirDirect id => match startup_fault_target symbols id with
        | Nothing => instruction | Just index => match orb(managed, realpath_fault_mode(index, [7,8] : List Nat)) with
          | False => instruction | True => MirCall gc result (MirDirect (add base index)) arguments end end end
    | MirManagedAlloc local allocator _ descriptor bytes => MirManagedAlloc local allocator (add base 8) descriptor bytes
    | MirMove _ _ => instruction | MirBinaryOp _ _ _ _ => instruction | MirCompare _ _ _ _ => instruction
    | MirConvert _ _ _ => instruction | MirLoad _ _ _ => instruction | MirStore _ _ _ => instruction
    | MirLoadAt _ _ _ => instruction | MirStoreAt _ _ _ => instruction | MirAddress _ _ => instruction
    | MirPointerAdd _ _ _ => instruction | MirManagedContext _ => instruction end;

def realpath_fault_function (base : Nat) (symbols : List Nat) (contracts : List LowerContract)
    (function : MirFunction) : MirFunction :=
    match function with | MirFunctionDef id name arguments locals result entry blocks =>
      let managed : Bool := match lower_find_contract id contracts with | Nothing => True | Just _ => False end in
      MirFunctionDef id name arguments locals result entry
        (map MirBlock MirBlock (fun (block : MirBlock) => match block with | MirBlockDef label instructions terminator =>
          MirBlockDef label (map MirInstruction MirInstruction (realpath_fault_instruction base symbols managed) instructions) terminator end) blocks) end;

def native_realpath_fault_fixture (mode : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    match parts with | ManagedProgramOf checked contracts program =>
      let base : Nat := S (foldr Nat Nat maxNat 0 (mir_global_ids program)) in
      lower_bind (List Nat) MirProgram (realpath_fault_symbols checked) (fun (symbols : List Nat) =>
        lower_map (List MirFunction) MirProgram (fun (wrappers : List MirFunction) =>
          match program with | MirProgramDef functions data libraries entry =>
            MirProgramDef (append MirFunction wrappers
              (map MirFunction MirFunction (realpath_fault_function base symbols contracts) functions))
              (Cons MirData (MirDataDef(startup_fault_counter base, True, pe_zeros 192)) data) libraries entry end)
          (realpath_fault_wrappers base mode symbols)) end;

def native_realpath_fixture (mode : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    match eqNat mode 100 with | True => native_realpath_normalization_fixture parts
    | False => native_realpath_fault_fixture mode parts end;
