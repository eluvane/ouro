-- PRECISION coverage for native build argument defaults and rejections.

import "analyze/precision/assertions.ouro",
  "../tools/native_build_args.ouro";

def native_build_args_ok_target (request : NativeBuildRequest)
    (expected : String) : Bool :=
    str_eq(native_build_request_target request, expected);

def native_build_args_ok_out (request : NativeBuildRequest)
    (expected : String) : Bool :=
    str_eq(native_build_request_out request, expected);

def native_build_args_accepted (request : NativeBuildRequest) : Bool :=
    andb (str_eq (native_build_request_backend request)
      native_build_backend_native)
      (andb (str_eq (native_build_request_target request)
        native_build_default_target)
        (andb (str_eq(native_build_request_source request, "foo.ouro"))
          (andb (str_eq (native_build_request_entry request)
            native_build_default_entry)
            (eq_nat (native_build_request_fuel request)
              native_build_default_fuel))));

def native_build_args_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-build-args/build-fuel-preserved"
        (eq_nat(native_build_default_fuel, mul 200 1000))
    , MkPair String Bool "native-build-args/check-fuel-preserved"
        (eq_nat(native_build_check_default_fuel, mul 16 1000))
    , MkPair String Bool "native-build-args/default-target"
        (match native_build_parse "native" "" "src/main.ouro" "" "" with
         | Left _ => False
         | Right request =>
             native_build_args_ok_target request native_build_default_target
         end)
    , MkPair String Bool "native-build-args/default-out-src-main"
        (match native_build_parse "native" "" "src/main.ouro" "" "" with
         | Left _ => False
         | Right request =>
             native_build_args_ok_out request "_build/native/main.exe"
         end)
    , MkPair String Bool "native-build-args/default-out-foo"
        (match native_build_parse "native" "" "foo.ouro" "" "" with
         | Left _ => False
         | Right request =>
             native_build_args_ok_out request "_build/native/foo.exe"
         end)
    , MkPair String Bool "native-build-args/reject-legacy-c"
        (match native_build_parse native_build_backend_legacy_c
           native_build_default_target "foo.ouro" "" "" with
         | Left err =>
             str_eq err
               (native_build_err_backend native_build_backend_legacy_c)
         | Right _ => False
         end)
    , MkPair String Bool "native-build-args/reject-unknown-backend"
        (match native_build_parse "llvm" native_build_default_target
           "foo.ouro" "" "" with
         | Left err => str_eq(err, native_build_err_backend "llvm")
         | Right _ => False
         end)
    , MkPair String Bool "native-build-args/reject-linux-target"
        (match native_build_parse "native" "linux" "foo.ouro" "" "" with
         | Left err => str_eq(err, native_build_err_target "linux")
         | Right _ => False
         end)
    , MkPair String Bool "native-build-args/reject-other-target"
        (match native_build_parse "native" "x86_64-linux" "foo.ouro" "" "" with
         | Left err => str_eq(err, native_build_err_target "x86_64-linux")
         | Right _ => False
         end)
    , MkPair String Bool "native-build-args/accept-native-windows"
        (match native_build_parse "native" native_build_default_target
           "foo.ouro" "" "" with
         | Left _ => False
         | Right request => native_build_args_accepted request
         end)
    ];

-- @entry main
def main : IO Unit := precision_run "native-build-args" native_build_args_laws;
