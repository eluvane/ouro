-- Run with the isolated managed_heap_release source mutant. A valid owned
-- scalar carrying payload 73 makes that one release boundary return False.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset four, five)))) (fun (descriptor : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (later : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (injected : RawPtr U8) =>
  runtime_bind Unit U32 (managed_write_word injected four (usize_add(managed_word_offset (managed_word_offset one), usize_add(managed_word_offset one, one)))) (fun (fault_enabled : Unit) =>
  runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (live : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (dead : (RawPtr U8)) =>
  runtime_bind Unit U32 (gc_test_root context zero live anchor) (fun (rooted : Unit) =>
  runtime_bind Unit U32 (gc_test_counts context four (managed_word_offset (usize_add(managed_word_offset two, four))) anchor) (fun (initial_count : Unit) =>
  runtime_bind Bool U32 (managed_collect context) (fun (collected : Bool) =>
  runtime_bind Unit U32 (managed_require(raw_bool_not collected, anchor)) (fun (failed : Unit) =>
  runtime_bind Unit U32 (gc_test_counts context three (managed_word_offset (usize_add(managed_word_offset one, seven))) anchor) (fun (remaining_count : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context dead False anchor) (fun (first_freed : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context live True anchor) (fun (root_preserved : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context later True anchor) (fun (later_preserved : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context injected True anchor) (fun (injected_preserved : Unit) =>
  runtime_bind USize U32 (managed_read_word context zero) (fun (head_actual : USize) =>
  runtime_bind USize U32 (raw_to_bits U8 live) (fun (head_expected : USize) =>
  runtime_bind Unit U32 (managed_require(usize_equal head_actual head_expected, anchor)) (fun (head_same : Unit) =>
  runtime_bind USize U32 (managed_read_word live two) (fun (failed_link_actual : USize) =>
  runtime_bind USize U32 (raw_to_bits U8 injected) (fun (failed_link_expected : USize) =>
  runtime_bind Unit U32 (managed_require(usize_equal failed_link_actual failed_link_expected, anchor)) (fun (failed_link_same : Unit) =>
  runtime_bind USize U32 (managed_read_word injected two) (fun (tail_link_actual : USize) =>
  runtime_bind USize U32 (raw_to_bits U8 later) (fun (tail_link_expected : USize) =>
  runtime_bind Unit U32 (managed_require(usize_equal tail_link_actual tail_link_expected, anchor)) (fun (tail_link_same : Unit) =>
  runtime_bind USize U32 (managed_read_word live three) (fun (live_mark : USize) =>
  runtime_bind Unit U32 (managed_require(usize_equal live_mark zero, anchor)) (fun (live_clear : Unit) =>
  runtime_bind USize U32 (managed_read_word injected three) (fun (injected_mark : USize) =>
  runtime_bind Unit U32 (managed_require(usize_equal injected_mark zero, anchor)) (fun (injected_clear : Unit) =>
  runtime_bind USize U32 (managed_read_word later three) (fun (later_mark : USize) =>
  runtime_bind Unit U32 (managed_require(usize_equal later_mark zero, anchor)) (fun (later_clear : Unit) =>
  runtime_bind Bool U32 (managed_collect context) (fun (retried : Bool) =>
  runtime_bind Unit U32 (managed_require(raw_bool_not retried, anchor)) (fun (failed_again : Unit) =>
  runtime_bind Unit U32 (gc_test_counts context three (managed_word_offset (usize_add(managed_word_offset one, seven))) anchor) (fun (retry_count : Unit) =>
  runtime_bind Unit U32 (managed_write_word injected four zero) (fun (fault_disabled : Unit) =>
  runtime_bind Unit U32 (gc_test_collect context anchor) (fun (recovered : Unit) =>
  runtime_bind Unit U32 (gc_test_counts context one (managed_word_offset five) anchor) (fun (recovered_count : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context injected False anchor) (fun (failed_object_recovered : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context later False anchor) (fun (later_freed : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context live True anchor) (fun (live_retained : Unit) =>
  runtime_bind Unit U32 (gc_test_root context zero (raw_null U8) anchor) (fun (unrooted : Unit) =>
  runtime_bind Unit U32 (gc_test_collect context anchor) (fun (finished : Unit) =>
  runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (empty : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context live False anchor) (fun (last_freed : Unit) =>
  gc_test_finish context anchor)))))))))))))))))))))))))))))))))))))))))))));
