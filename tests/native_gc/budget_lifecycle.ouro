-- Explicit collection uses post-sweep live pressure; failed allocations never consume credit.
import "budget_common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    let eight : USize := managed_word_offset one in
    let page : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight four)) in
    let minimum : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight (usize_add eight four))) in
    let bytes : USize := managed_word_offset five in
    let maximum : USize := usize_sub zero one in
    runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (initial_budget : Unit) =>
    runtime_bind Unit U32 (gc_test_collect context anchor) (fun (first_collection : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (first_credit : Unit) =>
    runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add (managed_word_offset four) five))) (fun (descriptor : (RawPtr U8)) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (usize_add minimum bytes)) (fun (live : (RawPtr U8)) =>
    runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (large_charge : Unit) =>
    runtime_bind Unit U32 (gc_test_root context zero live anchor) (fun (rooted : Unit) =>
    runtime_bind Unit U32 (gc_test_collect context anchor) (fun (live_collection : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context (usize_add (usize_add minimum page) bytes) anchor) (fun (live_credit : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (dead : (RawPtr U8)) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (small_charge : Unit) =>
    runtime_bind Unit U32 (gc_test_collect context anchor) (fun (positive_credit_force : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context one (usize_add minimum bytes) anchor) (fun (post_sweep_count : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context (usize_add (usize_add minimum page) bytes) anchor) (fun (post_sweep_credit : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (live_frame_release : Bool) =>
    runtime_bind Unit U32 (managed_require (raw_bool_not live_frame_release) anchor) (fun (live_frame_rejected : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context (usize_add (usize_add minimum page) bytes) anchor) (fun (live_frame_credit : Unit) =>
    runtime_bind Unit U32 (gc_test_root context zero (raw_null U8) anchor) (fun (unrooted : Unit) =>
    runtime_bind Unit U32 (gc_test_collect context anchor) (fun (empty_collection : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (empty_count : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (empty_credit : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_try_allocate_raw context context bytes) (fun (invalid : (RawPtr U8)) =>
    runtime_bind Bool U32 (managed_pointer_is_null invalid) (fun (invalid_null : Bool) =>
    runtime_bind Unit U32 (managed_require invalid_null anchor) (fun (invalid_rejected : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (invalid_uncharged : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_try_allocate_raw context descriptor (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset eight) one)))) (fun (huge : (RawPtr U8)) =>
    runtime_bind Bool U32 (managed_pointer_is_null huge) (fun (huge_null : Bool) =>
    runtime_bind Unit U32 (managed_require huge_null anchor) (fun (huge_rejected : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (huge_uncharged : Unit) =>
    runtime_bind Unit U32 (managed_write_word context two maximum) (fun (overflow_count : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_try_allocate_raw context descriptor bytes) (fun (overflow : (RawPtr U8)) =>
    runtime_bind Bool U32 (managed_pointer_is_null overflow) (fun (overflow_null : Bool) =>
    runtime_bind Unit U32 (managed_require overflow_null anchor) (fun (overflow_rejected : Unit) =>
    runtime_bind Unit U32 (managed_write_word context two zero) (fun (restored_count : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (overflow_uncharged : Unit) =>
    runtime_bind Unit U32 (managed_write_pointer context one (raw_null U8)) (fun (removed_frame : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (released : Bool) =>
    runtime_bind Unit U32 (managed_require released anchor) (fun (release_success : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (release_reset : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (reuse : (RawPtr U8)) =>
    runtime_bind Unit U32 (gc_test_counts context one bytes anchor) (fun (reuse_count : Unit) =>
    runtime_bind Unit U32 (gc_test_collect context anchor) (fun (reuse_collect : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (reuse_empty : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (reuse_credit : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (final_release : Bool) =>
    runtime_bind Unit U32 (managed_require final_release anchor) (fun (final_release_success : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (final_reset : Unit) =>
      gc_test_finish context anchor)))))))))))))))))))))))))))))))))))))))))))))))));
