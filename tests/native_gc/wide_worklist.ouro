import "common.ouro";

-- A wide graph fills the pending worklist with 512 distinct leaves. The raw
-- address array is observation-only storage; it does not keep a leaf alive.
def gc_test_star_child (context : RawPtr U8) (parent : RawPtr U8) (descriptor : RawPtr U8)
    (addresses : RawPtr U8) (index : USize) (anchor : USize) : Runtime USize :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) USize (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (child : (RawPtr U8)) =>
  runtime_bind Unit USize (managed_write_pointer parent (usize_add five index) child) (fun (linked : Unit) =>
  runtime_bind Unit USize (managed_write_pointer addresses index child) (fun (observed : Unit) =>
  runtime_pure USize (usize_add index one))));

def gc_test_star_freed (context : RawPtr U8) (addresses : RawPtr U8)
    (index : USize) (anchor : USize) : Runtime USize :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) USize (managed_read_pointer addresses index) (fun (child : (RawPtr U8)) =>
  runtime_bind Unit USize (gc_test_allocation context child False anchor) (fun (freed : Unit) =>
  runtime_pure USize (usize_add index one)));
def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add (managed_word_offset five) seven))) (fun (descriptor : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add (managed_word_offset four) five))) (fun (scalar : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_pages_allocate (managed_word_offset (managed_word_offset (managed_word_offset (managed_word_offset one)))) (managed_word_offset one)) (fun (addresses : (RawPtr U8)) =>
  runtime_bind Bool U32 (managed_pointer_is_null addresses) (fun (missing : Bool) =>
  runtime_bind Unit U32 (managed_require (raw_bool_not missing) anchor) (fun (reserved : Unit) =>
  runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset (usize_add (managed_word_offset (managed_word_offset (managed_word_offset one))) five))) (fun (parent : (RawPtr U8)) =>
  runtime_bind Unit U32 (managed_write_word parent four (managed_word_offset (managed_word_offset (managed_word_offset one)))) (fun (field_count : Unit) =>
  runtime_bind Unit U32 (gc_test_root context zero parent anchor) (fun (rooted : Unit) =>
  match u8_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (managed_panic anchor)
        (fun (unexpected : Unit) => runtime_pure U32 (raw_size_to_u32 zero))
    | Just running => runtime_bind USize U32 (runtime_loop USize zero
    (fun (index : USize) => runtime_pure U8 (match usize_less index (managed_word_offset (managed_word_offset (managed_word_offset one))) with
      | True => running | False => u8_sub running running end))
    (fun (index : USize) => gc_test_star_child context parent scalar addresses index anchor)) (fun (created : USize) =>
  runtime_bind Unit U32 (managed_require (usize_equal created (managed_word_offset (managed_word_offset (managed_word_offset one)))) anchor) (fun (all_created : Unit) =>
  runtime_bind Unit U32 (gc_test_collect context anchor) (fun (traced : Unit) =>
  runtime_bind Unit U32 (gc_test_counts context (usize_add (managed_word_offset (managed_word_offset (managed_word_offset one))) one) (managed_word_offset (usize_add (managed_word_offset (managed_word_offset (managed_word_offset six))) five)) anchor) (fun (live : Unit) =>
  runtime_bind Unit U32 (gc_test_root context zero (raw_null U8) anchor) (fun (unrooted : Unit) =>
  runtime_bind Unit U32 (gc_test_collect context anchor) (fun (collected : Unit) =>
  runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (empty : Unit) =>
  runtime_bind Unit U32 (gc_test_allocation context parent False anchor) (fun (parent_freed : Unit) =>
  runtime_bind USize U32 (runtime_loop USize zero
    (fun (index : USize) => runtime_pure U8 (match usize_less index (managed_word_offset (managed_word_offset (managed_word_offset one))) with
      | True => running | False => u8_sub running running end))
    (fun (index : USize) => gc_test_star_freed context addresses index anchor)) (fun (observed : USize) =>
  runtime_bind Unit U32 (managed_require (usize_equal observed (managed_word_offset (managed_word_offset (managed_word_offset one)))) anchor) (fun (all_observed : Unit) =>
  runtime_bind Bool U32 (raw_pages_release addresses) (fun (released : Bool) =>
  runtime_bind Unit U32 (managed_require released anchor) (fun (cleaned : Unit) =>
  gc_test_finish context anchor)))))))))))) end))))))))));
