-- Strict standalone lookup accepts exact older bases and rejects null, interior, and foreign addresses.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let six : USize := usize_add four two in
        let seven : USize := usize_add four three in
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add (managed_word_offset four) five))) (fun (descriptor : (RawPtr U8)) =>
        runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (live : (RawPtr U8)) =>
        runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (prefix : (RawPtr U8)) =>
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (managed_word_offset (usize_add (managed_word_offset one) four)))) (fun (scratch : (RawPtr U8)) =>
        runtime_bind USize U32 (raw_to_bits U8 live) (fun (live_bits : USize) =>
        runtime_bind Unit U32 (gc_test_root context zero live anchor) (fun (rooted : Unit) =>
        runtime_bind Bool U32 (managed_object_known context live_bits scratch) (fun (known : Bool) =>
        runtime_bind Unit U32 (managed_require known anchor) (fun (found : Unit) =>
        runtime_bind Bool U32 (managed_object_known context zero scratch) (fun (null_known : Bool) =>
        runtime_bind Unit U32 (managed_require (raw_bool_not null_known) anchor) (fun (null_rejected : Unit) =>
        runtime_bind Bool U32 (managed_object_known context (usize_add live_bits (managed_word_offset one)) scratch) (fun (interior_known : Bool) =>
        runtime_bind Unit U32 (managed_require (raw_bool_not interior_known) anchor) (fun (interior_rejected : Unit) =>
        runtime_bind Bool U32 (managed_object_known context anchor scratch) (fun (foreign_known : Bool) =>
        runtime_bind Unit U32 (managed_require (raw_bool_not foreign_known) anchor) (fun (foreign_rejected : Unit) =>
        runtime_bind Unit U32 (managed_inspect_roots context scratch) (fun (inspected : Unit) =>
        runtime_bind USize U32 (managed_read_word scratch zero) (fun (frames : USize) =>
        runtime_bind USize U32 (managed_read_word scratch one) (fun (slots : USize) =>
        runtime_bind USize U32 (managed_read_word scratch two) (fun (values : USize) =>
        runtime_bind Unit U32 (managed_require (raw_bool_and (usize_equal frames one) (raw_bool_and (usize_equal slots two) (usize_equal values one))) anchor) (fun (counts : Unit) =>
        runtime_bind Unit U32 (gc_test_root context zero (raw_null U8) anchor) (fun (unrooted : Unit) =>
        runtime_bind Unit U32 (gc_test_collect context anchor) (fun (collected : Unit) =>
        runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (empty : Unit) =>
          gc_test_finish context anchor))))))))))))))))))))))));
