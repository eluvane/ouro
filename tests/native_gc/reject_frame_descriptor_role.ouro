import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let four : USize := usize_add two two in
    runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (managed_word_offset four))) (fun (object_kind : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (managed_word_offset (usize_add (managed_word_offset one) one)))) (fun (frame : (RawPtr U8)) =>
  runtime_bind Unit U32 (managed_write_pointer frame one object_kind) (fun (corrupted : Unit) =>
  runtime_bind Unit U32 (gc_test_collect context anchor) (fun (unexpected : Unit) =>
  gc_test_finish context anchor))))));
