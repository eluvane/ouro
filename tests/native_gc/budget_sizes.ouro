-- Word offsets, pressure overflow and saturating charges cannot grant wrapped credit.
import "budget_common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    let eight : USize := managed_word_offset one in
    let page : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight four)) in
    let minimum : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight (usize_add eight four))) in
    let bytes : USize := managed_word_offset five in
    let maximum : USize := usize_sub zero one in
    runtime_bind Unit U32 (managed_require (usize_equal (managed_heap_handle_word zero) six) anchor) (fun (owner_empty : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_heap_handle_word five) (usize_add eight eight)) anchor) (fun (owner_five : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_heap_handle_word maximum) zero) anchor) (fun (owner_count_overflow : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_heap_handle_word (usize_sub (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset eight) four))) four)) (usize_sub (managed_shift_right maximum (raw_size_to_u32 three)) one)) anchor) (fun (owner_last_complete : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_heap_handle_word (usize_sub (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset eight) four))) three)) zero) anchor) (fun (owner_end_overflow : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget_word (zero)) (five)) anchor) (fun (word_empty : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget_word (five)) (usize_sub (usize_add eight eight) one)) anchor) (fun (word_five : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget_word (maximum)) (zero)) anchor) (fun (word_count_overflow : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget_word (managed_shift_right maximum (raw_size_to_u32 one))) (zero)) anchor) (fun (word_prefix_overflow : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget_word (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset eight) four)))) (zero)) anchor) (fun (word_byte_overflow : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget (zero) (zero)) (minimum)) anchor) (fun (pressure_empty : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget (managed_word_offset (managed_word_offset four)) (zero)) (minimum)) anchor) (fun (pressure_exact_floor : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget (managed_word_offset (managed_word_offset four)) (one)) (usize_add minimum one)) anchor) (fun (pressure_above_floor : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset seven) four))) (zero)) (zero)) anchor) (fun (pressure_count_overflow : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_budget (one) (maximum)) (zero)) anchor) (fun (pressure_bytes_overflow : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (zero) (bytes)) (zero)) anchor) (fun (remaining_zero : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (usize_sub page one) (bytes)) (zero)) anchor) (fun (remaining_below_page : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (page) (bytes)) (zero)) anchor) (fun (remaining_page : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (usize_sub (usize_add page bytes) one) (bytes)) (zero)) anchor) (fun (remaining_below_request : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (usize_add page bytes) (bytes)) (zero)) anchor) (fun (remaining_exact_request : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (usize_add (usize_add page bytes) one) (bytes)) (one)) anchor) (fun (remaining_after_request : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (maximum) (maximum)) (zero)) anchor) (fun (remaining_huge_request : Unit) =>
    runtime_bind Unit U32 (managed_require (usize_equal (managed_collection_remaining (maximum) (bytes)) (usize_sub (usize_sub maximum page) bytes)) anchor) (fun (remaining_maximum : Unit) =>
    runtime_bind Unit U32 (gc_budget_set context minimum anchor) (fun (seeded : Unit) =>
    runtime_bind Unit U32 (managed_write_word context four maximum) (fun (invalid_descriptors : Unit) =>
    runtime_bind Bool U32 (managed_write_collection_budget context one) (fun (word_result : Bool) =>
    runtime_bind Unit U32 (managed_require (raw_bool_not word_result) anchor) (fun (word_rejected : Unit) =>
    runtime_bind Unit U32 (managed_write_word context four five) (fun (restored_descriptors : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (word_preserved : Unit) =>
    runtime_bind Unit U32 (managed_write_word context two (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset seven) four)))) (fun (invalid_pressure : Unit) =>
    runtime_bind Bool U32 (managed_reset_collection_budget context) (fun (pressure_result : Bool) =>
    runtime_bind Unit U32 (managed_require (raw_bool_not pressure_result) anchor) (fun (pressure_rejected : Unit) =>
    runtime_bind Unit U32 (managed_write_word context two zero) (fun (restored_count : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (pressure_preserved : Unit) =>
      gc_test_finish context anchor))))))))))))))))))))))))))))))))))));
