-- Collector component fixtures use a caller-owned raw context and shadow
-- frame. The production codegen's stack integration has separate tests.
import "heap_observe.ouro",
  "../../runtime/native_types.ouro";

def gc_test_write_u32 (base : RawPtr U8) (offset : USize) (value : U32) : Runtime Unit :=
    let result : Runtime Unit := raw_store_word_at base offset value in result;

def gc_test_descriptor (base : RawPtr U8) (kind : USize) (prefix : USize)
    (start : USize) (mode : USize) (argument : USize) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind Unit Unit (gc_test_write_u32 base zero (raw_size_to_u32 one)) (fun (version : Unit) =>
  runtime_bind Unit Unit (gc_test_write_u32 base four (raw_size_to_u32 kind)) (fun (typed : Unit) =>
  runtime_bind Unit Unit (managed_write_word base one prefix) (fun (sized : Unit) =>
  runtime_bind Unit Unit (managed_write_word base two start) (fun (started : Unit) =>
  runtime_bind Unit Unit (managed_write_word base three mode) (fun (traced : Unit) =>
  runtime_bind Unit Unit (managed_write_word base four argument) (fun (counted : Unit) =>
  runtime_pure Unit MkUnit))))));

-- Layout in this 1024-byte raw fixture reservation:
-- context 0, descriptors 256/296/336/376, frame descriptor 416,
-- frame base 512, root slots 544/552, frame 576, query output 640.
def gc_test_initialize (context : RawPtr U8) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (managed_word_offset four))) (fun (constructor : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset four, five)))) (fun (scalar : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset five, two)))) (fun (closure : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset five, seven)))) (fun (environment : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset six, four)))) (fun (frame_descriptor : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (managed_word_offset (managed_word_offset one)))) (fun (frame_base : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (managed_word_offset (usize_add(managed_word_offset one, one))))) (fun (frame : (RawPtr U8)) =>
  runtime_bind Unit Unit (gc_test_descriptor constructor one (managed_word_offset seven) (managed_word_offset seven) two (managed_word_offset six) anchor) (fun (constructor_layout : Unit) =>
  runtime_bind Unit Unit (gc_test_descriptor scalar (usize_add(managed_word_offset one, six)) (managed_word_offset five) zero zero zero anchor) (fun (scalar_layout : Unit) =>
  runtime_bind Unit Unit (gc_test_descriptor closure three (managed_word_offset six) (managed_word_offset five) one one anchor) (fun (closure_layout : Unit) =>
  runtime_bind Unit Unit (gc_test_descriptor environment two (managed_word_offset five) (managed_word_offset five) two (managed_word_offset four) anchor) (fun (environment_layout : Unit) =>
  runtime_bind Unit Unit (managed_write_word context four five) (fun (descriptor_count : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer context five constructor) (fun (constructor_registered : Unit) =>
  runtime_bind Unit Unit (managed_write_word context six one) (fun (constructor_role : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer context seven scalar) (fun (scalar_registered : Unit) =>
  runtime_bind Unit Unit (managed_write_word context (managed_word_offset one) one) (fun (scalar_role : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer context (usize_add(managed_word_offset one, one)) closure) (fun (closure_registered : Unit) =>
  runtime_bind Unit Unit (managed_write_word context (usize_add(managed_word_offset one, two)) one) (fun (closure_role : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer context (usize_add(managed_word_offset one, three)) environment) (fun (environment_registered : Unit) =>
  runtime_bind Unit Unit (managed_write_word context (usize_add(managed_word_offset one, four)) one) (fun (environment_role : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer context (usize_add(managed_word_offset one, five)) frame_descriptor) (fun (frame_descriptor_registered : Unit) =>
  runtime_bind Unit Unit (managed_write_word context (usize_add(managed_word_offset one, six)) two) (fun (frame_descriptor_role : Unit) =>
  runtime_bind Unit Unit (managed_write_word frame_descriptor zero two) (fun (root_count : Unit) =>
  runtime_bind Unit Unit (managed_write_word frame_descriptor one (managed_word_offset four)) (fun (first_offset : Unit) =>
  runtime_bind Unit Unit (managed_write_word frame_descriptor two (managed_word_offset five)) (fun (second_offset : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer frame one frame_descriptor) (fun (frame_kind : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer frame two frame_base) (fun (frame_storage : Unit) =>
  runtime_bind Unit Unit (managed_write_pointer context one frame) (fun (published_frame : Unit) =>
  runtime_pure Unit MkUnit))))))))))))))))))))))))))));

def gc_test_context : Runtime (RawPtr U8) :=
    runtime_bind USize (RawPtr U8) (raw_to_bits(U8, raw_null U8)) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) (RawPtr U8) (raw_pages_allocate(managed_word_offset (managed_word_offset (managed_word_offset two)), managed_word_offset one)) (fun (context : (RawPtr U8)) =>
  runtime_bind Bool (RawPtr U8) (managed_pointer_is_null context) (fun (missing : Bool) =>
  runtime_bind Unit (RawPtr U8) (managed_require(raw_bool_not missing, anchor)) (fun (allocated : Unit) =>
  runtime_bind Unit (RawPtr U8) (gc_test_initialize context anchor) (fun (initialized : Unit) =>
  runtime_pure(RawPtr U8, context))))));

def gc_test_root (context : RawPtr U8) (slot : USize) (value : RawPtr U8) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind Unit Unit (managed_write_pointer context (usize_add(usize_add(managed_word_offset (managed_word_offset one), four), slot)) value) (fun (stored : Unit) =>
  runtime_pure Unit MkUnit);

def gc_test_counts (context : RawPtr U8) (count : USize) (bytes : USize) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind USize Unit (managed_read_word context two) (fun (actual_count : USize) =>
  runtime_bind USize Unit (managed_read_word context three) (fun (actual_bytes : USize) =>
  runtime_bind Unit Unit (managed_require(raw_bool_and(usize_equal count actual_count, usize_equal bytes actual_bytes), anchor)) (fun (counted : Unit) =>
  runtime_pure Unit MkUnit)));

def gc_test_collect (context : RawPtr U8) (anchor : USize) : Runtime Unit :=
    runtime_bind(Bool, Unit, managed_collect context, fun (collected : Bool) => managed_require collected anchor);

-- The raw query buffer lies outside the private heap and is not a GC root.
def gc_test_allocation (context : RawPtr U8) (base : RawPtr U8) (expected : Bool)
    (anchor : USize) : Runtime Unit :=
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    runtime_bind (RawPtr U8) Unit (raw_add U8 context
      (managed_word_offset (managed_word_offset (usize_add(managed_word_offset one, two)))))
      (fun (buffer : RawPtr U8) => gc_heap_expect_allocation context base buffer expected anchor);

def gc_test_state (context : RawPtr U8) (base : RawPtr U8) (state : U32) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) Unit (raw_add U8 context (managed_word_offset (managed_word_offset (usize_add(managed_word_offset one, two))))) (fun (output : (RawPtr U8)) =>
  runtime_bind USize Unit (gc_test_virtual_query base output (managed_word_offset six)) (fun (written : USize) =>
  runtime_bind Unit Unit (managed_require(usize_equal(written, managed_word_offset six), anchor)) (fun (queried : Unit) =>
  runtime_bind U32 Unit (managed_read_u32(output, managed_word_offset four)) (fun (actual : U32) =>
  runtime_bind Unit Unit (managed_require(u32_equal actual state, anchor)) (fun (observed : Unit) =>
  runtime_pure Unit MkUnit)))));

def gc_test_finish (context : RawPtr U8) (anchor : USize) : Runtime U32 :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind Bool U32 (managed_heap_destroy_empty context) (fun (retired : Bool) =>
  runtime_bind Unit U32 (managed_require retired anchor) (fun (heap_closed : Unit) =>
    runtime_bind Bool U32 (raw_pages_release context) (fun (released : Bool) =>
  runtime_bind Unit U32 (managed_require released anchor) (fun (closed : Unit) =>
  match u32_from_nat 42 with | Nothing => runtime_pure(U32, raw_size_to_u32 zero)
      | Just answer => runtime_pure U32 answer end))));
