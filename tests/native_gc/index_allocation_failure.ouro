-- A representable reservation beyond Windows user address space returns False before heap changes.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let six : USize := usize_add four two in
        let seven : USize := usize_add four three in
        runtime_bind Unit U32 (managed_write_word context two (usize_shift_left one (raw_size_to_u32 (usize_add (managed_word_offset six) seven)))) (fun (huge_count : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (usize_shift_left one (raw_size_to_u32 (usize_add (managed_word_offset six) seven)))) (fun (capacity : USize) =>
        runtime_bind Unit U32 (managed_require (raw_bool_not (usize_equal (managed_gc_index_bytes (usize_shift_left one (raw_size_to_u32 (usize_add (managed_word_offset six) seven))) capacity) zero)) anchor) (fun (representable : Unit) =>
        runtime_bind Bool U32 (managed_collect context) (fun (collected : Bool) =>
        runtime_bind Unit U32 (managed_require (raw_bool_not collected) anchor) (fun (refused : Unit) =>
        runtime_bind Unit U32 (gc_test_counts context (usize_shift_left one (raw_size_to_u32 (usize_add (managed_word_offset six) seven))) zero anchor) (fun (unchanged : Unit) =>
        runtime_bind USize U32 (managed_read_word context zero) (fun (heap_head : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal heap_head zero) anchor) (fun (head_unchanged : Unit) =>
        runtime_bind Unit U32 (managed_write_word context two zero) (fun (restore_count : Unit) =>
        runtime_bind Unit U32 (gc_test_collect context anchor) (fun (retry : Unit) =>
          gc_test_finish context anchor))))))))))));
