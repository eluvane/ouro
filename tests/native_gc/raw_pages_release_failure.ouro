-- The unchanged page adapter rejects a reservation's interior address and preserves its owner.
import "budget_common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let eight : USize := managed_word_offset one in
    let bytes : USize := managed_word_offset five in
    let owner : USize := managed_heap_handle_word five in
    let minimum : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight (usize_add eight four))) in
    let enormous : USize := usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset eight) one)) in
    let page : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight four)) in
    runtime_bind (RawPtr U8) U32 (raw_pages_allocate (usize_add page page) eight) (fun (reservation : (RawPtr U8)) =>
    runtime_bind Bool U32 (managed_pointer_is_null reservation) (fun (missing : Bool) =>
    runtime_bind Unit U32 (managed_require (raw_bool_not missing) anchor) (fun (allocated : Unit) =>
    runtime_bind (RawPtr U8) U32 (raw_add U8 reservation page) (fun (interior : (RawPtr U8)) =>
    runtime_bind Bool U32 (raw_pages_release interior) (fun (refused : Bool) =>
    runtime_bind Unit U32 (managed_require (raw_bool_not refused) anchor) (fun (interior_rejected : Unit) =>
    runtime_bind Unit U32 (gc_test_state context reservation (raw_size_to_u32 page) anchor) (fun (still_committed : Unit) =>
    runtime_bind Bool U32 (raw_pages_release reservation) (fun (released : Bool) =>
    runtime_bind Unit U32 (managed_require (released) anchor) (fun (owner_released : Unit) =>
    runtime_bind Unit U32 (gc_test_state context reservation (raw_size_to_u32 (usize_shift_left one (raw_size_to_u32 (usize_add eight eight)))) anchor) (fun (pages_free : Unit) =>
      gc_test_finish context anchor))))))))))));
