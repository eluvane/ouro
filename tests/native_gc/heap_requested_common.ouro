import "budget_common.ouro",
  "../../runtime/managed_heap_observer.ouro";

def heap_requested_expect (context : RawPtr U8) (expected : USize) : Runtime Unit :=
    runtime_bind USize Unit (raw_managed_allocated_requested_bytes context) (fun (first : USize) =>
      runtime_bind USize Unit (raw_managed_allocated_requested_bytes context) (fun (second : USize) =>
        managed_require(raw_bool_and(usize_equal first expected, usize_equal second expected), expected)));

def heap_requested_reject (mode : USize) : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let count : USize := match raw_bool_and (usize_less zero mode) (usize_less mode four) with
          | True => one | False => zero end in
        let bytes : USize := match usize_equal mode zero with | True => one | False =>
          match usize_equal mode two with | True => usize_sub (managed_word_offset four) one
          | False => match usize_equal mode three with | True => managed_word_offset five | False => zero end end end in
        let head : USize := match raw_bool_and (usize_less one mode) (usize_less mode four) with
          | True => anchor | False => zero end in
        runtime_bind Unit U32 (managed_write_word context zero head) (fun (_head : Unit) =>
          runtime_bind Unit U32 (managed_write_word context two count) (fun (_count : Unit) =>
            runtime_bind Unit U32 (managed_write_word context three bytes) (fun (_bytes : Unit) =>
              runtime_bind (RawPtr U8) U32 (match usize_equal mode four with
                | True => runtime_pure(RawPtr U8, raw_null U8)
                | False => match usize_equal mode five with
                  | True => raw_add U8 context one | False => runtime_pure(RawPtr U8, context) end end)
                (fun (invalid : RawPtr U8) => runtime_bind USize U32
                  (raw_managed_allocated_requested_bytes invalid)
                  (fun (_unexpected : USize) => runtime_bind Bool U32 (raw_pages_release context)
                    (fun (released : Bool) => runtime_pure U32 (match released with
                      | False => raw_size_to_u32 zero
                      | True => match u32_from_nat 42 with
                        | Nothing => raw_size_to_u32 zero | Just accepted => accepted end end)))))))));
