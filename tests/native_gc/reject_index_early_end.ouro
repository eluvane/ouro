-- An owner list that ends before the checked count cannot publish an index.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let six : USize := usize_add four two in
        let seven : USize := usize_add four three in
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add (managed_word_offset four) five))) (fun (descriptor : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (live : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (prefix : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (managed_word_offset (usize_add (managed_word_offset one) four)))) (fun (scratch : RawPtr U8) =>
        runtime_bind USize U32 (raw_to_bits U8 live) (fun (live_bits : USize) =>
        runtime_bind Unit U32 (gc_test_root context zero live anchor) (fun (rooted : Unit) =>
        runtime_bind Unit U32 (managed_write_word scratch five two) (fun (work_capacity : Unit) =>
        runtime_bind Unit U32 (managed_gc_heap context scratch False) (fun (heap_valid : Unit) =>
        runtime_bind Unit U32 (managed_write_pointer prefix two (raw_null U8)) (fun (broken_link : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_build context scratch four) (fun (unexpected : Unit) =>
          gc_test_finish context anchor))))))))))));
