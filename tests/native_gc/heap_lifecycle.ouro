-- Lazy creation, real partial block release, empty destruction and allocation-failure ownership.
import "budget_common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let eight : USize := managed_word_offset one in
    let bytes : USize := managed_word_offset five in
    let owner : USize := managed_heap_handle_word five in
    let minimum : USize := usize_shift_left(one, raw_size_to_u32 (usize_add(eight, usize_add eight four))) in
    let enormous : USize := usize_shift_left(one, raw_size_to_u32 (usize_sub(managed_word_offset eight, one))) in
    let page : USize := usize_shift_left(one, raw_size_to_u32 (usize_add eight four)) in
    runtime_bind USize U32 (managed_read_word context owner) (fun (initial_owner : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal initial_owner zero, anchor)) (fun (starts_uncreated : Unit) =>
    runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset four, five)))) (fun (descriptor : (RawPtr U8)) =>
    runtime_bind Unit U32 (gc_budget_set context minimum anchor) (fun (seeded : Unit) =>
    runtime_bind Bool U32 (managed_descriptor_valid context descriptor enormous) (fun (huge_valid : Bool) =>
    runtime_bind Unit U32 (managed_require(huge_valid, anchor)) (fun (valid_request : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_try_allocate_raw context descriptor enormous) (fun (failed : (RawPtr U8)) =>
    runtime_bind Bool U32 (managed_pointer_is_null failed) (fun (failed_null : Bool) =>
    runtime_bind Unit U32 (managed_require(failed_null, anchor)) (fun (allocation_failed : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (failed_owner : USize) =>
    runtime_bind Unit U32 (managed_require(raw_bool_not (usize_equal failed_owner zero), anchor)) (fun (failure_keeps_owner : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (no_objects : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (no_charge : Unit) =>
    runtime_bind Bool U32 (managed_heap_destroy_empty context) (fun (retired_failure : Bool) =>
    runtime_bind Unit U32 (managed_require(retired_failure, anchor)) (fun (empty_cleanup : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (retired_owner : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal retired_owner zero, anchor)) (fun (owner_cleared : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (live : (RawPtr U8)) =>
    runtime_bind USize U32 (managed_read_word live four) (fun (zero_payload : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal zero_payload zero, anchor)) (fun (zeroed_storage : Unit) =>
    runtime_bind Unit U32 (managed_write_word live four (usize_add(managed_word_offset five, two))) (fun (marked : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (dead : (RawPtr U8)) =>
    runtime_bind Unit U32 (gc_test_root context zero live anchor) (fun (rooted : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context live True anchor) (fun (live_before : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context dead True anchor) (fun (dead_before : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (active_owner : USize) =>
    runtime_bind Unit U32 (managed_require(raw_bool_not (usize_equal active_owner zero), anchor)) (fun (created : Unit) =>
    runtime_bind Bool U32 (managed_heap_destroy_empty context) (fun (premature : Bool) =>
    runtime_bind Unit U32 (managed_require(raw_bool_not premature, anchor)) (fun (live_destroy_rejected : Unit) =>
    runtime_bind Unit U32 (gc_test_collect context anchor) (fun (partial : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context one bytes anchor) (fun (one_object : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context dead False anchor) (fun (block_freed : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context live True anchor) (fun (root_survives : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (same_owner : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal same_owner active_owner, anchor)) (fun (heap_survives : Unit) =>
    runtime_bind USize U32 (managed_read_word live four) (fun (payload : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal(payload, usize_add(managed_word_offset five, two)), anchor)) (fun (payload_survives : Unit) =>
    runtime_bind Unit U32 (gc_test_root context zero (raw_null U8) anchor) (fun (unrooted : Unit) =>
    runtime_bind Unit U32 (gc_test_collect context anchor) (fun (collected : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (all_empty : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context live False anchor) (fun (pages_freed : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (empty_owner : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal empty_owner zero, anchor)) (fun (destroyed : Unit) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (fresh : (RawPtr U8)) =>
    runtime_bind Unit U32 (gc_test_allocation context fresh True anchor) (fun (recreated : Unit) =>
    runtime_bind Unit U32 (managed_write_pointer context one (raw_null U8)) (fun (no_frame : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (released : Bool) =>
    runtime_bind Unit U32 (managed_require(released, anchor)) (fun (shutdown : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context fresh False anchor) (fun (shutdown_pages : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (shutdown_credit : Unit) =>
      gc_test_finish context anchor))))))))))))))))))))))))))))))))))))))))))))))))))));
