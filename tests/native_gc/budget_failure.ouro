-- The isolated managed_heap_release source mutant refuses payload 73 on a
-- valid owned scalar. Failed collection/release cannot change its budget.
import "budget_common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    let eight : USize := managed_word_offset one in
    let page : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight four)) in
    let minimum : USize := usize_shift_left one (raw_size_to_u32 (usize_add eight (usize_add eight four))) in
    let bytes : USize := managed_word_offset five in
    let maximum : USize := usize_sub zero one in
    runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add (managed_word_offset four) five))) (fun (descriptor : (RawPtr U8)) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (fault : RawPtr U8) =>
    runtime_bind Unit U32 (managed_write_word fault four (usize_add (managed_word_offset eight) (usize_add eight one))) (fun (fault_enabled : Unit) =>
    runtime_bind Unit U32 (gc_budget_set context minimum anchor) (fun (seeded : Unit) =>
    runtime_bind Bool U32 (managed_collect context) (fun (collected : Bool) =>
    runtime_bind Unit U32 (managed_require (raw_bool_not collected) anchor) (fun (collection_failed : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (collection_no_credit : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context one bytes anchor) (fun (count_unchanged : Unit) =>
    runtime_bind Unit U32 (managed_write_pointer context one (raw_null U8)) (fun (removed_frame : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (released : Bool) =>
    runtime_bind Unit U32 (managed_require (raw_bool_not released) anchor) (fun (release_failed : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context minimum anchor) (fun (release_no_reset : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context one bytes anchor) (fun (release_count : Unit) =>
    runtime_bind Unit U32 (managed_write_word fault four zero) (fun (fault_disabled : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (recovered : Bool) =>
    runtime_bind Unit U32 (managed_require recovered anchor) (fun (recovery_checked : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (recovery_reset : Unit) =>
      gc_test_finish context anchor)))))))))))))))))));
