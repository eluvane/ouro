import "common.ouro";

def gc_test_iteration (context : RawPtr U8) (index : USize) (anchor : USize) : Runtime USize :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) USize (raw_add U8 context (managed_word_offset (managed_word_offset four))) (fun (descriptor : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) USize (managed_allocate_raw context descriptor (managed_word_offset (usize_add(managed_word_offset one, one)))) (fun (object : (RawPtr U8)) =>
  runtime_bind Unit USize (managed_write_word object six two) (fun (field_count : Unit) =>
  runtime_bind Unit USize (managed_write_pointer object seven object) (fun (cycle : Unit) =>
  runtime_bind Unit USize (gc_test_root context zero object anchor) (fun (rooted : Unit) =>
  runtime_bind Unit USize (gc_test_collect context anchor) (fun (retained : Unit) =>
  runtime_bind Unit USize (gc_test_counts context one (managed_word_offset (usize_add(managed_word_offset one, one))) anchor) (fun (live_count : Unit) =>
  runtime_bind Unit USize (gc_test_allocation context object True anchor) (fun (live_state : Unit) =>
  runtime_bind Unit USize (gc_test_root context zero (raw_null U8) anchor) (fun (unrooted : Unit) =>
  runtime_bind Unit USize (gc_test_collect context anchor) (fun (collected : Unit) =>
  runtime_bind Unit USize (gc_test_counts context zero zero anchor) (fun (empty : Unit) =>
  runtime_bind Unit USize (gc_test_allocation context object False anchor) (fun (freed : Unit) =>
  runtime_pure(USize, usize_add index one)))))))))))));
def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    match u8_from_nat 1 with
    | Nothing => runtime_bind Unit U32 (managed_panic anchor)
        (fun (unexpected : Unit) => runtime_pure(U32, raw_size_to_u32 zero))
    | Just running =>
      runtime_bind USize U32 (runtime_loop USize zero
        (fun (index : USize) => runtime_pure U8 (match usize_less(index, managed_word_offset (usize_add(managed_word_offset (usize_add(managed_word_offset one, seven)), five))) with
          | True => running | False => u8_sub running running end))
        (fun (index : USize) => gc_test_iteration context index anchor))
        (fun (finished : USize) => runtime_bind Unit U32
          (managed_require(usize_equal(finished, managed_word_offset (usize_add(managed_word_offset (usize_add(managed_word_offset one, seven)), five))), anchor))
          (fun (repeated : Unit) => gc_test_finish context anchor)) end));
