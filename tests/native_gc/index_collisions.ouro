-- Exact full-width keys survive collisions and wraparound; null and absent keys stay absent.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let six : USize := usize_add four two in
        let seven : USize := usize_add four three in
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (managed_word_offset (usize_add(managed_word_offset one, four))))) (fun (scratch : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (raw_add U8 scratch (managed_word_offset (managed_word_offset one))) (fun (table : RawPtr U8) =>
        runtime_bind Unit U32 (managed_gc_index_clear(table, managed_word_offset one)) (fun (clear : Unit) =>
        runtime_bind USize U32 (managed_gc_index_slot(table, managed_word_offset one, one, scratch)) (fun (slot_first : USize) =>
        runtime_bind Unit U32 (managed_require(usize_equal slot_first one, anchor)) (fun (slot_first_checked : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_insert(table, managed_word_offset one, one, scratch)) (fun (insert_first : Unit) =>
        runtime_bind USize U32 (managed_gc_index_slot(table, managed_word_offset one, usize_add(managed_word_offset one, one), scratch)) (fun (slot_second : USize) =>
        runtime_bind Unit U32 (managed_require(usize_equal slot_second two, anchor)) (fun (slot_second_checked : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_insert(table, managed_word_offset one, usize_add(managed_word_offset one, one), scratch)) (fun (insert_second : Unit) =>
        runtime_bind USize U32 (managed_gc_index_slot(table, managed_word_offset one, usize_add(managed_word_offset two, one), scratch)) (fun (slot_third : USize) =>
        runtime_bind Unit U32 (managed_require(usize_equal slot_third three, anchor)) (fun (slot_third_checked : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_insert(table, managed_word_offset one, usize_add(managed_word_offset two, one), scratch)) (fun (insert_third : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_insert(table, managed_word_offset one, usize_add(one, usize_shift_left(one, raw_size_to_u32 (managed_word_offset four))), scratch)) (fun (insert_high : Unit) =>
        runtime_bind Bool U32 (managed_gc_index_contains(table, managed_word_offset one, one, scratch)) (fun (found_first : Bool) =>
        runtime_bind Unit U32 (managed_require(found_first, anchor)) (fun (first_present : Unit) =>
        runtime_bind Bool U32 (managed_gc_index_contains(table, managed_word_offset one, usize_add(managed_word_offset one, one), scratch)) (fun (found_second : Bool) =>
        runtime_bind Unit U32 (managed_require(found_second, anchor)) (fun (second_present : Unit) =>
        runtime_bind Bool U32 (managed_gc_index_contains(table, managed_word_offset one, usize_add(managed_word_offset two, one), scratch)) (fun (found_third : Bool) =>
        runtime_bind Unit U32 (managed_require(found_third, anchor)) (fun (third_present : Unit) =>
        runtime_bind Bool U32 (managed_gc_index_contains(table, managed_word_offset one, usize_add(one, usize_shift_left(one, raw_size_to_u32 (managed_word_offset four))), scratch)) (fun (found_high : Bool) =>
        runtime_bind Unit U32 (managed_require(found_high, anchor)) (fun (high_present : Unit) =>
        runtime_bind Bool U32 (managed_gc_index_contains(table, managed_word_offset one, zero, scratch)) (fun (found_null : Bool) =>
        runtime_bind Unit U32 (managed_require((raw_bool_not found_null), anchor)) (fun (null_absent : Unit) =>
        runtime_bind Bool U32 (managed_gc_index_contains(table, managed_word_offset one, usize_add(managed_word_offset three, one), scratch)) (fun (found_missing : Bool) =>
        runtime_bind Unit U32 (managed_require((raw_bool_not found_missing), anchor)) (fun (missing_absent : Unit) =>
        runtime_bind Bool U32 (managed_gc_index_contains(table, managed_word_offset one, usize_add(one, usize_shift_left(one, raw_size_to_u32 (managed_word_offset six))), scratch)) (fun (found_high_missing : Bool) =>
        runtime_bind Unit U32 (managed_require((raw_bool_not found_high_missing), anchor)) (fun (high_missing_absent : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_clear(table, managed_word_offset one)) (fun (clear_wrap : Unit) =>
        runtime_bind USize U32 (managed_gc_index_slot(table, managed_word_offset one, seven, scratch)) (fun (slot_wrap_first : USize) =>
        runtime_bind Unit U32 (managed_require(usize_equal slot_wrap_first seven, anchor)) (fun (slot_wrap_first_checked : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_insert(table, managed_word_offset one, seven, scratch)) (fun (insert_wrap_first : Unit) =>
        runtime_bind USize U32 (managed_gc_index_slot(table, managed_word_offset one, usize_add(managed_word_offset one, seven), scratch)) (fun (slot_wrap_second : USize) =>
        runtime_bind Unit U32 (managed_require(usize_equal slot_wrap_second zero, anchor)) (fun (slot_wrap_second_checked : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_insert(table, managed_word_offset one, usize_add(managed_word_offset one, seven), scratch)) (fun (insert_wrap_second : Unit) =>
        runtime_bind USize U32 (managed_gc_index_slot(table, managed_word_offset one, usize_add(managed_word_offset two, seven), scratch)) (fun (slot_wrap_third : USize) =>
        runtime_bind Unit U32 (managed_require(usize_equal slot_wrap_third one, anchor)) (fun (slot_wrap_third_checked : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_insert(table, managed_word_offset one, usize_add(managed_word_offset two, seven), scratch)) (fun (insert_wrap_third : Unit) =>
          gc_test_finish context anchor)))))))))))))))))))))))))))))))))))))));
