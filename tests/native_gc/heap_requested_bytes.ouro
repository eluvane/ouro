-- The OS oracle checks real allocations/frees independently of the new reader.
import "heap_requested_common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let bytes : USize := managed_word_offset five in
        let pair_bytes : USize := usize_add bytes bytes in
        let budget : USize := usize_shift_left(one, raw_size_to_u32 (usize_add(managed_word_offset one, four))) in
        runtime_bind Unit U32 (gc_budget_set context budget anchor) (fun (_budget : Unit) =>
          runtime_bind Unit U32 (heap_requested_expect context zero) (fun (_initial : Unit) =>
            runtime_bind Unit U32 (gc_budget_expect context budget anchor) (fun (_untouched : Unit) =>
              runtime_bind (RawPtr U8) U32
                (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset four, five))))
                (fun (descriptor : RawPtr U8) =>
                  runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (live : RawPtr U8) =>
                    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (dead : RawPtr U8) =>
                      runtime_bind Unit U32 (gc_test_root context zero live anchor) (fun (_rooted : Unit) =>
                        runtime_bind Unit U32 (gc_test_allocation context live True anchor) (fun (_live : Unit) =>
                          runtime_bind Unit U32 (gc_test_allocation context dead True anchor) (fun (_dead : Unit) =>
                            runtime_bind Unit U32 (heap_requested_expect context pair_bytes) (fun (_two : Unit) =>
                              runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (_charged : Unit) =>
                                runtime_bind (RawPtr U8) U32 (managed_release_step context dead) (fun (_remaining : RawPtr U8) =>
                                  runtime_bind Unit U32 (gc_test_allocation context dead False anchor) (fun (_freed : Unit) =>
                                    runtime_bind Unit U32 (gc_test_allocation context live True anchor) (fun (_retained : Unit) =>
                                      runtime_bind Unit U32 (heap_requested_expect context bytes) (fun (_one : Unit) =>
                                        runtime_bind Unit U32 (gc_test_collect context anchor) (fun (_collected : Unit) =>
                                          runtime_bind Unit U32 (heap_requested_expect context bytes) (fun (_root_kept : Unit) =>
                                            runtime_bind Unit U32 (gc_test_root context zero (raw_null U8) anchor) (fun (_unrooted : Unit) =>
                                              runtime_bind Unit U32 (gc_test_collect context anchor) (fun (_empty : Unit) =>
                                                runtime_bind Unit U32 (gc_test_allocation context live False anchor) (fun (_released : Unit) =>
                                                  runtime_bind Unit U32 (heap_requested_expect context zero)
                                                    (fun (_final : Unit) => gc_test_finish context anchor)))))))))))))))))))))));
