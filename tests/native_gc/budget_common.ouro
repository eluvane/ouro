-- Test-only observations of the trailing allocation budget.
import "common.ouro";

def gc_budget_expect (context : RawPtr U8) (expected : USize) (anchor : USize) : Runtime Unit :=
    let one : USize := managed_one anchor in
    let five : USize := usize_sub(managed_word_offset one, usize_add(one, usize_add one one)) in
    runtime_bind USize Unit (managed_read_word(context, managed_collection_budget_word five))
      (fun (actual : USize) => managed_require(usize_equal actual expected, anchor));

def gc_budget_set (context : RawPtr U8) (value : USize) (anchor : USize) : Runtime Unit :=
    runtime_bind Bool Unit (managed_write_collection_budget context value)
      (fun (written : Bool) => managed_require written anchor);
