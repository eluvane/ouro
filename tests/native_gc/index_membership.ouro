-- Only actual validated bases are members; marking preserves the separate fixed worklist capacity.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let six : USize := usize_add four two in
        let seven : USize := usize_add four three in
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset four, five)))) (fun (descriptor : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (live : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset five)) (fun (prefix : RawPtr U8) =>
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (managed_word_offset (usize_add(managed_word_offset one, four))))) (fun (scratch : RawPtr U8) =>
        runtime_bind USize U32 (raw_to_bits U8 live) (fun (live_bits : USize) =>
        runtime_bind Unit U32 (gc_test_root context zero live anchor) (fun (rooted : Unit) =>
        runtime_bind Unit U32 (managed_write_word scratch five two) (fun (work_capacity : Unit) =>
        runtime_bind Unit U32 (managed_gc_heap context scratch False) (fun (heap_valid : Unit) =>
        runtime_bind Unit U32 (managed_gc_index_build context scratch four) (fun (index_ready : Unit) =>
        runtime_bind Bool U32 (managed_object_in_mark_heap context (live_bits) scratch) (fun (known_exact : Bool) =>
        runtime_bind Unit U32 (managed_require(known_exact, anchor)) (fun (exact_checked : Unit) =>
        runtime_bind Bool U32 (managed_object_in_mark_heap context (zero) scratch) (fun (known_null : Bool) =>
        runtime_bind Unit U32 (managed_require((raw_bool_not known_null), anchor)) (fun (null_checked : Unit) =>
        runtime_bind Bool U32 (managed_object_in_mark_heap context (usize_add(live_bits, managed_word_offset one)) scratch) (fun (known_interior : Bool) =>
        runtime_bind Unit U32 (managed_require((raw_bool_not known_interior), anchor)) (fun (interior_checked : Unit) =>
        runtime_bind Bool U32 (managed_object_in_mark_heap context (anchor) scratch) (fun (known_foreign : Bool) =>
        runtime_bind Unit U32 (managed_require((raw_bool_not known_foreign), anchor)) (fun (foreign_checked : Unit) =>
        runtime_bind Bool U32 (managed_object_in_mark_heap context (one) scratch) (fun (known_fabricated : Bool) =>
        runtime_bind Unit U32 (managed_require((raw_bool_not known_fabricated), anchor)) (fun (fabricated_checked : Unit) =>
        runtime_bind Unit U32 (managed_mark_roots_after_heap context scratch) (fun (roots_marked : Unit) =>
        runtime_bind Unit U32 (managed_mark_pending_with_heap context scratch True) (fun (edges_marked : Unit) =>
        runtime_bind USize U32 (managed_read_word scratch five) (fun (work_capacity_after : USize) =>
        runtime_bind USize U32 (managed_read_word scratch six) (fun (index_capacity_after : USize) =>
        runtime_bind USize U32 (managed_read_word live three) (fun (marked : USize) =>
        runtime_bind Unit U32 (managed_require(raw_bool_and(usize_equal work_capacity_after two, usize_equal index_capacity_after four), anchor)) (fun (capacities_unchanged : Unit) =>
        runtime_bind Unit U32 (managed_require(usize_equal marked one, anchor)) (fun (exact_object_marked : Unit) =>
        runtime_bind Unit U32 (managed_gc_heap context scratch True) (fun (marks_clear : Unit) =>
        runtime_bind Unit U32 (gc_test_root context zero (raw_null U8) anchor) (fun (unrooted : Unit) =>
        runtime_bind Unit U32 (gc_test_collect context anchor) (fun (collected : Unit) =>
        runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (empty : Unit) =>
          gc_test_finish context anchor))))))))))))))))))))))))))))))));
