-- Capacity, load, addition and byte-overflow boundaries return exact sizes or zero.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let six : USize := usize_add four two in
        let seven : USize := usize_add four three in
        runtime_bind USize U32 (managed_gc_index_capacity (zero)) (fun (capacity_zero : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_zero (two)) anchor) (fun (capacity_zero_checked : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (one)) (fun (capacity_one : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_one (two)) anchor) (fun (capacity_one_checked : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (two)) (fun (capacity_two : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_two (four)) anchor) (fun (capacity_two_checked : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (three)) (fun (capacity_three : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_three (managed_word_offset one)) anchor) (fun (capacity_three_checked : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (four)) (fun (capacity_four : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_four (managed_word_offset one)) anchor) (fun (capacity_four_checked : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (five)) (fun (capacity_five : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_five (managed_word_offset two)) anchor) (fun (capacity_five_checked : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (usize_sub zero one)) (fun (capacity_maximum : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_maximum (zero)) anchor) (fun (capacity_maximum_checked : Unit) =>
        runtime_bind USize U32 (managed_gc_index_capacity (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset (managed_word_offset one)) one)))) (fun (capacity_high : USize) =>
        runtime_bind Unit U32 (managed_require (usize_equal capacity_high (zero)) anchor) (fun (capacity_high_checked : Unit) =>
        runtime_bind Unit U32 (managed_require (usize_equal (managed_gc_index_bytes (zero) (two)) (managed_word_offset (usize_add (managed_word_offset one) two))) anchor) (fun (bytes_zero : Unit) =>
        runtime_bind Unit U32 (managed_require (usize_equal (managed_gc_index_bytes (one) (two)) (managed_word_offset (usize_add (managed_word_offset one) three))) anchor) (fun (bytes_one : Unit) =>
        runtime_bind Unit U32 (managed_require (usize_equal (managed_gc_index_bytes (one) (zero)) (zero)) anchor) (fun (bytes_zero_capacity : Unit) =>
        runtime_bind Unit U32 (managed_require (usize_equal (managed_gc_index_bytes (one) (three)) (zero)) anchor) (fun (bytes_shape : Unit) =>
        runtime_bind Unit U32 (managed_require (usize_equal (managed_gc_index_bytes (two) (two)) (zero)) anchor) (fun (bytes_load : Unit) =>
        runtime_bind Unit U32 (managed_require (usize_equal (managed_gc_index_bytes (usize_sub zero one) (two)) (zero)) anchor) (fun (bytes_addition : Unit) =>
        runtime_bind Unit U32 (managed_require (usize_equal (managed_gc_index_bytes (zero) (usize_shift_left one (raw_size_to_u32 (usize_sub (managed_word_offset (managed_word_offset one)) three)))) (zero)) anchor) (fun (bytes_bytes : Unit) =>
          gc_test_finish context anchor)))))))))))))))))))))))));
