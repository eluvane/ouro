-- An isolated destroy source mutant refuses budget 73; failed cleanup retains the empty heap owner.
import "budget_common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := managed_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let eight : USize := managed_word_offset one in
    let bytes : USize := managed_word_offset five in
    let owner : USize := managed_heap_handle_word five in
    let minimum : USize := usize_shift_left(one, raw_size_to_u32 (usize_add(eight, usize_add eight four))) in
    let enormous : USize := usize_shift_left(one, raw_size_to_u32 (usize_sub(managed_word_offset eight, one))) in
    let page : USize := usize_shift_left(one, raw_size_to_u32 (usize_add eight four)) in
    runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (usize_add(managed_word_offset four, five)))) (fun (descriptor : (RawPtr U8)) =>
    runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor bytes) (fun (object : (RawPtr U8)) =>
    runtime_bind Unit U32 (gc_test_allocation context object True anchor) (fun (busy_before : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (first_owner : USize) =>
    runtime_bind Unit U32 (managed_require(raw_bool_not (usize_equal first_owner zero), anchor)) (fun (created : Unit) =>
    runtime_bind Unit U32 (gc_budget_set context (usize_add(managed_word_offset eight, usize_add eight one)) anchor) (fun (enabled : Unit) =>
    runtime_bind Bool U32 (managed_collect context) (fun (collected : Bool) =>
    runtime_bind Unit U32 (managed_require(raw_bool_not collected, anchor)) (fun (destroy_refused : Unit) =>
    runtime_bind Unit U32 (gc_test_counts context zero zero anchor) (fun (no_objects : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context object False anchor) (fun (real_block_release : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context (usize_add(managed_word_offset eight, usize_add eight one)) anchor) (fun (no_new_credit : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (after_collect : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal after_collect first_owner, anchor)) (fun (collection_keeps_owner : Unit) =>
    runtime_bind Unit U32 (managed_write_pointer context one (raw_null U8)) (fun (no_frame : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (released : Bool) =>
    runtime_bind Unit U32 (managed_require(raw_bool_not released, anchor)) (fun (shutdown_refused : Unit) =>
    runtime_bind USize U32 (managed_read_word context owner) (fun (after_release : USize) =>
    runtime_bind Unit U32 (managed_require(usize_equal after_release first_owner, anchor)) (fun (shutdown_keeps_owner : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context (usize_add(managed_word_offset eight, usize_add eight one)) anchor) (fun (no_reset : Unit) =>
    runtime_bind Unit U32 (gc_budget_set context one anchor) (fun (disabled : Unit) =>
    runtime_bind Bool U32 (managed_release_all context) (fun (recovered : Bool) =>
    runtime_bind Unit U32 (managed_require(recovered, anchor)) (fun (retry_releases_owner : Unit) =>
    runtime_bind Unit U32 (gc_test_allocation context object False anchor) (fun (real_page_release : Unit) =>
    runtime_bind Unit U32 (gc_budget_expect context zero anchor) (fun (retry_resets_credit : Unit) =>
      gc_test_finish context anchor))))))))))))))))))))))))));
