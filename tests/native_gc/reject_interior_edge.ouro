-- Marking rejects an interior traced edge after initial heap validation and a valid exact root.
import "common.ouro";

def main : Runtime U32 :=
    runtime_bind (RawPtr U8) U32 gc_test_context (fun (context : RawPtr U8) =>
      runtime_bind USize U32 (raw_to_bits U8 context) (fun (anchor : USize) =>
        let zero : USize := usize_sub anchor anchor in
        let one : USize := managed_one anchor in
        let two : USize := usize_add one one in
        let three : USize := usize_add two one in
        let four : USize := usize_add two two in
        let five : USize := usize_add four one in
        let six : USize := usize_add four two in
        let seven : USize := usize_add four three in
        runtime_bind (RawPtr U8) U32 (raw_add U8 context (managed_word_offset (managed_word_offset four))) (fun (descriptor : (RawPtr U8)) =>
        runtime_bind (RawPtr U8) U32 (managed_allocate_raw context descriptor (managed_word_offset (usize_add (managed_word_offset one) one))) (fun (object : (RawPtr U8)) =>
        runtime_bind Unit U32 (managed_write_word object six one) (fun (field_count : Unit) =>
        runtime_bind (RawPtr U8) U32 (raw_add U8 object (managed_word_offset seven)) (fun (interior : (RawPtr U8)) =>
        runtime_bind Unit U32 (managed_write_pointer object seven interior) (fun (edge : Unit) =>
        runtime_bind Unit U32 (gc_test_root context zero object anchor) (fun (rooted : Unit) =>
        runtime_bind Unit U32 (gc_test_collect context anchor) (fun (unexpected : Unit) =>
          gc_test_finish context anchor)))))))));
