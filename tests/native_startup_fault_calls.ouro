-- Query/fill faults must terminate after one fill. All raw scopes are checked
-- at ExitProcess, including failures while unwinding another failed helper.
import "native_startup_fault_values.ouro";

def startup_fault_environment_result (base : Nat) (mode : Nat) (original : Nat)
    (first : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let arguments : List MirValue := [MirUse 0, MirUse 1, MirUse 2, MirUse 3, MirUse 4] in
    managed_string_choose MirU32 first
      (fun (query : ManagedState) => match eqNat mode 9 with | True => startup_fault_result MirU32 5 query
        | False => startup_fault_call MirU32 original arguments query end)
      (fun (fill : ManagedState) => match orb(eqNat mode 6, eqNat mode 12) with
        | True => startup_fault_result MirU32 122 fill | False => match eqNat mode 7 with
          | True => startup_fault_result MirU32 203 fill | False =>
            lower_map ManagedResult ManagedResult (fun (returned : ManagedResult) => match returned with
              | ManagedResultOf status after => ManagedResultOf status
                  (match eqNat mode 8 with | False => after | True =>
                    managed_emit(MirStore(MirUse 4, codegen_disp 0, managed_bits MirU32 0), after) end) end)
              (startup_fault_call MirU32 original arguments fill) end end) state;

def startup_fault_environment (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (startup_fault_count base 56 state)
      (fun (counted : ManagedResult) => match counted with | ManagedResultOf attempt next =>
        lower_bind ManagedState ManagedResult (match leb_nat 30 mode with
          | True => Right NativeLowerError ManagedState next | False =>
            lower_bind ManagedResult ManagedState (managed_compare MirLessEqual attempt (managed_bits MirUSize 2) next)
              (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf okay after =>
                managed_require_equal okay (managed_bits MirU8 1) after end) end)
          (fun (bounded : ManagedState) => lower_bind ManagedResult ManagedResult
            (managed_compare(MirEqual, MirUse 3, managed_bits MirUSize 0, bounded))
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf first after =>
              startup_fault_environment_result base mode original first after end)) end);

def startup_fault_passthrough (base : Nat) (mode : Nat) (index : Nat) (original : Nat)
    (arguments : List MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let offset : Nat := match eqNat index 3 with | True => 32 | False =>
      match eqNat index 6 with | True => 40 | False => 48 end end in
    lower_bind ManagedResult ManagedResult (startup_fault_count base offset state)
      (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ after =>
        let fail : Bool := orb (andb(eqNat index 3, orb(eqNat mode 22, eqNat mode 27)))
          (orb (andb(eqNat index 5, eqNat mode 28))
            (orb (andb(eqNat index 6, eqNat mode 13))
              (andb(eqNat index 7, orb(eqNat mode 10, eqNat mode 23))))) in
        match fail with | True => startup_fault_result MirU32 5 after
        | False => startup_fault_call MirU32 original arguments after end end);

-- Exact expected call counts distinguish cleanup from merely reaching exit.
-- Allocation failures count the failed attempt, which never enters the stack.
def startup_fault_expected_allocations (mode : Nat) : Nat :=
    match andb(leb_nat 1 mode, leb_nat mode 5) with | True => mode | False =>
      match orb(eqNat mode 6, orb(eqNat mode 7, orb(eqNat mode 8, orb(eqNat mode 10, eqNat mode 12)))) with
      | True => 4 | False => match eqNat mode 9 with | True => 3 | False =>
        match eqNat mode 13 with | True => 2 | False => match startup_fault_argv mode with
          | False => 5 | True => match orb(eqNat mode 24, orb(eqNat mode 25, eqNat mode 26)) with
            | True => 2 | False => 1 end end end end end end;

def startup_fault_expected_releases (mode : Nat) : Nat :=
    sub (startup_fault_expected_allocations mode)
      (match eqNat(startup_fault_fail_allocation mode, 0) with | True => 0 | False => 1 end);

def startup_fault_fixed_counts (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let arguments : Bool := startup_fault_argv mode in
    let opened : Nat := match arguments with | False => 0 | True => match eqNat mode 20 with | True => 0 | False => 1 end end in
    let closed : Nat := match arguments with | False => 0 | True =>
      match orb(eqNat mode 20, eqNat mode 21) with | True => 0 | False => 1 end end in
    let queries : Nat := match arguments with | True => 0 | False =>
      match orb(andb(leb_nat 1 mode, leb_nat mode 3), eqNat mode 13) with | True => 0 | False =>
        match orb(eqNat mode 4, eqNat mode 9) with | True => 1 | False => 2 end end end in
    lower_bind ManagedState ManagedState (startup_fault_stat base 0 (startup_fault_expected_allocations mode) state)
      (fun (allocated : ManagedState) => lower_bind ManagedState ManagedState
        (startup_fault_stat base 8 (startup_fault_expected_releases mode) allocated)
        (fun (released : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 16 opened released)
          (fun (checked : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 24 closed checked)
            (startup_fault_stat base 56 queries))));

def startup_fault_exit_checks (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedState ManagedState (managed_require_equal (MirUse 0)
      (managed_bits(MirU32, match startup_fault_fatal mode with | True => 73 | False => 42 end)) state)
      (fun (exited : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 64 0 exited)
        (fun (released : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 72 0 released)
          (fun (closed : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 96 MirUSize closed)
            (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf count next =>
              lower_bind ManagedResult ManagedState (managed_compare MirGreater count (managed_bits MirUSize 0) next)
                (fun (tested : ManagedResult) => match tested with | ManagedResultOf collected after =>
                  lower_bind ManagedState ManagedState (managed_require_equal collected (managed_bits MirU8 1) after)
                    (fun (checked : ManagedState) => match leb_nat 30 mode with
                      | False => startup_fault_fixed_counts base mode checked
                      | True => lower_bind ManagedResult ManagedState (startup_fault_load base 104 MirU8 checked)
                          (fun (observed : ManagedResult) => match observed with | ManagedResultOf reclaimed final =>
                            lower_bind ManagedState ManagedState (managed_require_equal reclaimed (managed_bits MirU8 1) final)
                              (fun (gc : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 0 MirUSize gc)
                                (fun (allocations : ManagedResult) => match allocations with | ManagedResultOf total ready =>
                                  lower_bind ManagedResult ManagedState (startup_fault_load base 8 MirUSize ready)
                                    (fun (frees : ManagedResult) => match frees with | ManagedResultOf actual finished =>
                                      managed_require_equal actual total finished end) end)) end) end) end) end))));

def startup_fault_arguments (index : Nat) : List MirType :=
    match eqNat index 0 with | True => [MirUSize, MirUSize] | False =>
      match orb(eqNat index 1, orb(eqNat index 4, eqNat index 10)) with | True => [MirRawPtr] | False =>
        match eqNat index 2 with | True => [MirRawPtr, MirRawPtr] | False =>
          match eqNat index 3 with | True => [MirRawPtr, MirU32, MirUSize, MirRawPtr] | False =>
            match eqNat index 5 with | True => [MirRawPtr, MirUSize, MirRawPtr] | False =>
              match eqNat index 9 with | True => [MirU32] | False =>
                [MirRawPtr, MirUSize, MirRawPtr, MirUSize, MirRawPtr] end end end end end end;

def startup_fault_result_type (index : Nat) : MirType :=
    match eqNat index 0 with | True => MirRawPtr | False =>
      match orb(eqNat index 1, eqNat index 10) with | True => MirU8 | False => MirU32 end end;

def startup_fault_body (base : Nat) (mode : Nat) (index : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match eqNat index 0 with | True => startup_fault_allocate base mode original state | False =>
      match eqNat index 1 with | True => startup_fault_release base mode original state | False =>
        match eqNat index 2 with | True => startup_fault_open base mode original state | False =>
          match eqNat index 4 with | True => startup_fault_close base mode original state | False =>
            match eqNat index 8 with | True => startup_fault_environment base mode original state | False =>
              match eqNat index 10 with | True => startup_fault_collector base original state | False =>
                startup_fault_passthrough base mode index original (startup_fault_values (startup_fault_arguments index)) state
              end end end end end end;

def startup_fault_exit_function (base : Nat) (mode : Nat) (original : Nat) : Either NativeLowerError MirFunction :=
    lower_map ManagedState MirFunction (fun (after : ManagedState) => match managed_flow after with | LowerStateOf _ locals _ _ =>
      MirFunctionDef (add base 9) (prim_string_to_char_codes "startup_fault_exit") ([MirLocalDef 0 MirU32] : List MirLocal)
        (reverse MirLocal locals) (Nothing MirType) 0
        (lower_finish_blocks MirTrap (managed_flow
          (managed_emit(MirCall(MirMayGc, Nothing Nat, MirDirect original, [MirUse 0] : List MirValue), after)))) end)
      (startup_fault_exit_checks base mode
        (ManagedStateOf(0, [] : List MirFunction, [] : List MirData, [] : List Nat, [] : List Nat, lower_empty_state 1)));

def startup_fault_wrappers (base : Nat) (mode : Nat) (symbols : List Nat) : Either NativeLowerError (List MirFunction) :=
    (fix build (remaining : List Nat) (index : Nat) : Either NativeLowerError (List MirFunction) :=
      match remaining with | Nil => Right(NativeLowerError, List MirFunction, [] : List MirFunction)
      | Cons original rest => lower_bind MirFunction (List MirFunction) (match eqNat index 9 with
          | True => startup_fault_exit_function base mode original
          | False => native_stdio_fixture_function (add base index) (prim_string_to_char_codes "startup_fault_hook")
              (startup_fault_locals (startup_fault_arguments index)) (startup_fault_result_type index)
              (startup_fault_body base mode index original) end)
          (fun (function : MirFunction) => lower_map (List MirFunction) (List MirFunction)
            (Cons MirFunction function) (build(rest, S index))) end) symbols 0;
