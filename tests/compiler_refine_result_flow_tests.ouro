-- Refiner failures preserve resource, typing and malformed-Core distinctions.

import "compiler_refine_result_fixtures.ouro";

def refine_result_flow_laws : List RefineResultLaw :=
    [ MkRefineResultLaw "unannotated lambda needs an expected function type"
        (refine_result_has_kind CoreTerm 2
          (refine_lambda refine_result_copy 100 refine_result_no_environment refine_result_no_scope
            (Nothing CoreTerm) (CInd 0) (CRel 0)))
    , MkRefineResultLaw "explicit lambda can refine without an expectation"
        (refine_result_matches (CLam(CSort 0, CRel 0))
          (refine_lambda refine_result_copy 100 refine_result_no_environment refine_result_no_scope
            (Nothing CoreTerm) (CSort 0) (CRel 0)))
    , MkRefineResultLaw "lambda annotation callback exhaustion survives"
        (refine_result_has_kind CoreTerm 1
          (refine_lambda refine_result_resource 100 refine_result_no_environment refine_result_no_scope
            (Just CoreTerm refine_result_function) (CSort 0) (CRel 0)))
    , MkRefineResultLaw "application preserves inference exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_apply refine_result_copy 0 refine_result_no_environment refine_result_no_scope (CSort 0) (CSort 0)))
    , MkRefineResultLaw "application of an unknown global is malformed Core"
        (refine_result_has_kind CoreTerm 3
          (refine_apply refine_result_copy 100 refine_result_no_environment refine_result_no_scope (CConst 999) (CSort 0)))
    , MkRefineResultLaw "application of a sort is a typing failure"
        (refine_result_has_kind CoreTerm 2
          (refine_apply refine_result_copy 100 refine_result_no_environment refine_result_no_scope (CSort 0) (CSort 0)))
    , MkRefineResultLaw "application preserves malformed function-type reduction"
        (refine_result_has_kind CoreTerm 4
          (refine_apply refine_result_copy 100 refine_result_bad_environment refine_result_no_scope (CConst 90) (CSort 0)))
    , MkRefineResultLaw "applied synthetic lambda preserves argument inference exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_application refine_result_copy 0 refine_result_no_environment refine_result_no_scope
            (CLam(CInd 0, CRel 0)) (CSort 0)))
    , MkRefineResultLaw "applied synthetic lambda preserves malformed argument"
        (refine_result_has_kind CoreTerm 3
          (refine_application refine_result_copy 100 refine_result_no_environment refine_result_no_scope
            (CLam(CInd 0, CRel 0)) (CConst 999)))
    , MkRefineResultLaw "synthetic let preserves value inference exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_let refine_result_copy 0 refine_result_no_environment refine_result_no_scope (Nothing CoreTerm)
            (CSort 0) (CInd 0) (CRel 0)))
    , MkRefineResultLaw "synthetic let preserves malformed value"
        (refine_result_has_kind CoreTerm 3
          (refine_let refine_result_copy 100 refine_result_no_environment refine_result_no_scope (Nothing CoreTerm)
            (CConst 999) (CInd 0) (CRel 0)))
    , MkRefineResultLaw "telescope tail preserves Pi-view exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_telescope_tail 0 refine_result_no_environment 1 refine_result_function))
    , MkRefineResultLaw "telescope tail rejects a nonproduct as a typing failure"
        (refine_result_has_kind CoreTerm 2
          (refine_telescope_tail 100 refine_result_no_environment 1 (CSort 0)))
    , MkRefineResultLaw "constructor branch preserves telescope exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_branch refine_result_copy 0 refine_result_no_environment 1 refine_result_no_scope
            (Nothing CoreTerm) refine_result_function (CLam(CInd 0, CRel 0))))
    , MkRefineResultLaw "constructor branch cannot discard exhausted expected Pi"
        (refine_result_has_kind CoreTerm 1
          (refine_branch refine_result_copy 1 refine_result_alias_environment 1 refine_result_no_scope
            (Just(CoreTerm, CConst 100)) refine_result_function (CLam(CInd 0, CRel 0))))
    , MkRefineResultLaw "constructor branch preserves malformed expected Pi"
        (refine_result_has_kind CoreTerm 4
          (refine_branch refine_result_copy 100 refine_result_no_environment 1 refine_result_no_scope
            (Just CoreTerm refine_result_bad_type) refine_result_function (CLam(CInd 0, CRel 0))))
    ];

-- @entry main
def main : IO Unit := refine_result_run refine_result_flow_laws;
