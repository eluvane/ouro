-- These hash laws require the direct PE runtime.

import "../std/crypto.ouro",
  "../std/num.ouro",
  "../std/test.ouro",
  "crypto_stream_checks.ouro";

private def crypto_binary : String := str_of_codes (nat_range_count 1 129);

private def crypto_binary_digest : String :=
    "b5baf29ea8ef57ade36b68a46f56642328e9712477b58c4b5ba42521081680d8";

private def crypto_compressed_hex (block : List Nat) : String :=
    str_of_codes (hex_encode (sha_to_bytes (sha_compress crypto_check_initial_hash block)));

private def crypto_invalid_hashes : List ShaSt :=
    [ MkSha crypto_check_word_limit 0 0 0 0 0 0 0
    , MkSha 0 crypto_check_word_limit 0 0 0 0 0 0
    , MkSha 0 0 crypto_check_word_limit 0 0 0 0 0
    , MkSha 0 0 0 crypto_check_word_limit 0 0 0 0
    , MkSha 0 0 0 0 crypto_check_word_limit 0 0 0
    , MkSha 0 0 0 0 0 crypto_check_word_limit 0 0
    , MkSha 0 0 0 0 0 0 crypto_check_word_limit 0
    , MkSha 0 0 0 0 0 0 0 crypto_check_word_limit
    ];

private def crypto_tail_max_state : Sha256Stream :=
    Sha256StreamOf (sub sha256_stream_byte_limit 1) crypto_check_initial_hash
      (str_of_codes (replicate Nat 97 63));

def crypto_hash_laws : List Test :=
    [ assert_eq "SHA-256 empty vector" (sha256 "")
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    , assert_eq "SHA-256 abc vector" (sha256 "abc")
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    , assert_eq "SHA-256 two-block padding vector"
        (sha256 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
    , assert_eq "stream empty updates" (crypto_check_stream_digest ["", "", ""])
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    , assert_eq "stream abc chunks" (crypto_check_stream_digest ["a", "", "bc"])
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    , assert_eq "stream padding at 55 bytes"
        (crypto_check_stream_digest [str_slice crypto_binary 0 1, str_slice crypto_binary 1 54])
        "e87b25305254cd03a1ab3d2ce92986a903c4fbc0c76db2e52a26f88b0a97ce10"
    , assert_eq "stream padding at 56 bytes"
        (crypto_check_stream_digest [str_slice crypto_binary 0 55, "", str_slice crypto_binary 55 1])
        "f0ece3bff9d99a790383a7141cff604926d83a7d1d8336f29afa4523079378a5"
    , assert_eq "stream residual 63 bytes"
        (crypto_check_stream_digest ["", str_slice crypto_binary 0 63])
        "7018ebfc63acba9d5c72a3d468176cf6944d46c60d15bfbc925a5cecb2e36cf8"
    , assert_eq "stream exact block"
        (crypto_check_stream_digest [str_slice crypto_binary 0 63, str_slice crypto_binary 63 1])
        "20a7ec84684f7fe124cb3727d049734ab0b7da2f52fcafbcef989ecfd91e870b"
    , assert_eq "stream block plus byte"
        (crypto_check_stream_digest [str_slice crypto_binary 0 63, "", str_slice crypto_binary 63 2])
        "47e9b736f9001fab14640d9c915574c20669621520371f05a4b50906020dc49f"
    , assert_eq "stream two binary blocks"
        (crypto_check_stream_digest [str_slice crypto_binary 0 64, str_slice crypto_binary 64 64, ""])
        "bafa52e3c9b5c87242b6bb2ecb23976625fe469ac15670d22fb09b5be1111115"
    , assert_true "stream every residual length before binary continuation"
        (all Nat (fun (split : Nat) =>
          str_eq (crypto_check_stream_digest
            [str_slice crypto_binary 0 split, "", str_slice crypto_binary split (sub 129 split)])
            crypto_binary_digest) (nat_range_count 0 64))
    , assert_eq "stream high bytes across chunks"
        (crypto_check_stream_digest (map Nat String
          (fun (byte : Nat) => str_of_codes [byte]) [65, 255, 13, 10, 128]))
        "f4294bdc316f152cd64185dc3bbd1a175caf49e4a05a9d97de40095dc2ecaf74"
    , assert_true "stream retains only the exact residual byte"
        (crypto_check_state_shape (crypto_check_update_chunks
          [str_slice crypto_binary 0 63, str_slice crypto_binary 63 2] sha256_stream_init)
          65 (str_slice crypto_binary 64 1))
    , assert_true "stream finalization is reusable" (crypto_check_reusable_final crypto_binary crypto_binary_digest)
    , assert_eq "HMAC empty key and message" (hmac_sha256 "" "")
        "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad"
    , assert_eq "HMAC RFC 4231 short key"
        (hmac_sha256 (str_of_codes (replicate Nat 11 20)) "Hi There")
        "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
    , assert_eq "HMAC exact-block binary key"
        (hmac_sha256 (str_slice crypto_binary 0 64) crypto_binary)
        "861e1f65244c5be4c3736961fd28121bc6ba14ae1d8b420f80fab75700ab5cca"
    , assert_eq "HMAC RFC 4231 long key"
        (hmac_sha256 (str_of_codes (replicate Nat 170 131))
          "Test Using Larger Than Block-Size Key - Hash Key First")
        "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
    , assert_eq "HMAC NUL and high bytes in byte lists"
        (str_of_codes (hex_encode (hmac_sha256_bytes [0, 255, 128] [65, 0, 255, 13, 10, 128])))
        "738e52c3b724033d551c3e06bcb8d0073676ee51ac75ace589cbe56690f85ed2"
    , assert_eq "compression fills missing schedule words with zero"
        (crypto_compressed_hex []) (crypto_compressed_hex (replicate Nat 0 64))
    , assert_eq "compression retains 64 rounds with an oversized schedule"
        (crypto_compressed_hex (replicate Nat 0 80))
        (crypto_compressed_hex (replicate Nat 0 64))
    , assert_true "stream rejects an oversized tail"
        (crypto_check_invalid_state (Sha256StreamOf 0 crypto_check_initial_hash
          (str_slice crypto_binary 0 64)))
    , assert_true "stream rejects count and tail mismatch"
        (crypto_check_invalid_state (Sha256StreamOf 3 crypto_check_initial_hash "ab"))
    , assert_true "stream rejects every out-of-range Word32 lane"
        (all ShaSt (fun (hash : ShaSt) =>
          crypto_check_invalid_state (Sha256StreamOf 0 hash "")) crypto_invalid_hashes)
    , assert_true "stream accepts every maximum Word32 lane"
        (let lane : Nat := sub crypto_check_word_limit 1 in
          crypto_check_state_shape (sha256_stream_update
            (Sha256StreamOf 0 (MkSha lane lane lane lane lane lane lane lane) "") "") 0 "")
    , assert_true "stream accepts empty update at the last byte count"
        (crypto_check_state_shape (sha256_stream_update crypto_tail_max_state "")
          (sub sha256_stream_byte_limit 1) (str_of_codes (replicate Nat 97 63)))
    , assert_true "stream rejects an update reaching the byte limit"
        (crypto_check_limit_error Sha256Stream sha256_stream_byte_limit
          (sha256_stream_update crypto_tail_max_state "b"))
    , assert_true "stream rejects finalization at the byte limit"
        (crypto_check_limit_error String sha256_stream_byte_limit
          (sha256_stream_final (Sha256StreamOf sha256_stream_byte_limit crypto_check_initial_hash "")))
    , assert_true "stream byte limit takes precedence over invalid shape"
        (let state : Sha256Stream := Sha256StreamOf sha256_stream_byte_limit
            (MkSha crypto_check_word_limit 0 0 0 0 0 0 0) (str_slice crypto_binary 0 64) in
          andb (crypto_check_limit_error Sha256Stream sha256_stream_byte_limit
            (sha256_stream_update state ""))
            (crypto_check_limit_error String sha256_stream_byte_limit (sha256_stream_final state)))
    ];
