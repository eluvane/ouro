-- Linux loader input: actual shared x64 encoder MOVs and ELF writer bytes.
import "../compiler/native/elf.ouro";

def elf_test_load_segment (bytes : List Nat) (header : Nat) (flags : Nat)
    (offset : Nat) (size : Nat) : Bool :=
    pe_bytes_equal (take Nat 56 (drop Nat header bytes))
      (pe_join [pe_le32 1, pe_le32 flags, pe_le64_rva offset,
        pe_le64_rva (add elf_image_base offset), pe_le64_rva 0,
        pe_le64_rva size, pe_le64_rva size, pe_le64_rva 4096]);

-- Linux x86-64 syscall ABI: RAX=60 (exit), RDI=42. 0F05 is fixture-only;
-- this does not add a SysV function ABI, syscall lowering or Linux runtime.
def elf_test_exit_code : Either ElfError (List Nat) :=
    match x64_encode_block
      [X64MovImm32(X64Rax, X64Bytes32 60 0 0 0),
       X64MovImm32(X64Rdi, X64Bytes32 42 0 0 0)] with
    | Left error => Left ElfError (List Nat) (ElfBytesRejected (PeInstructionError error))
    | Right bytes => Right ElfError (List Nat) (append Nat bytes [15, 5])
    end;

def elf_test_exit_image : Either ElfError (List Nat) :=
    match elf_test_exit_code with
    | Left error => Left ElfError (List Nat) error
    | Right bytes => elf_write_image bytes 0
    end;

def elf_test_read_word (bytes : List Nat) (offset : Nat) (width : Nat) : Nat :=
    foldr Nat Nat (fun (byte : Nat) (rest : Nat) => add byte (mul 256 rest)) 0
      (take Nat width (drop Nat offset bytes));
