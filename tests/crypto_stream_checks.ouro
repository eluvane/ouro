import "../std/crypto.ouro";

def crypto_check_update_chunks : List String -> Sha256Stream -> Either Sha256StreamError Sha256Stream :=
    fix update_chunks (chunks : List String) (state : Sha256Stream)
        : Either Sha256StreamError Sha256Stream :=
      match chunks with
      | Nil => Right Sha256StreamError Sha256Stream state
      | Cons chunk rest =>
        match sha256_stream_update state chunk with
        | Left cause => Left Sha256StreamError Sha256Stream cause
        | Right next => update_chunks rest next
        end
      end;

def crypto_check_stream_digest (chunks : List String) : String :=
    match crypto_check_update_chunks chunks sha256_stream_init with
    | Left cause => sha256_stream_error_code cause
    | Right state =>
      match sha256_stream_final state with
      | Left cause => sha256_stream_error_code cause
      | Right digest => digest
      end
    end;

def crypto_check_initial_hash : ShaSt := sha_from_list sha256_iv;

def crypto_check_invalid_error (A : Type) (result : Either Sha256StreamError A) : Bool :=
    match result with
    | Left cause =>
      match cause with
      | Sha256StreamInvalidState => True
      | Sha256StreamByteLimitExceeded _ => False
      end
    | Right _ => False
    end;

def crypto_check_limit_error (A : Type) (count : Nat)
    (result : Either Sha256StreamError A) : Bool :=
    match result with
    | Left cause =>
      match cause with
      | Sha256StreamInvalidState => False
      | Sha256StreamByteLimitExceeded attempted => eq_nat attempted count
      end
    | Right _ => False
    end;

def crypto_check_invalid_state (state : Sha256Stream) : Bool :=
    andb (crypto_check_invalid_error Sha256Stream (sha256_stream_update state ""))
      (crypto_check_invalid_error String (sha256_stream_final state));

def crypto_check_word_limit : Nat := mul n65536 n65536;

def crypto_check_state_shape (result : Either Sha256StreamError Sha256Stream)
    (count : Nat) (tail : String) : Bool :=
    match result with
    | Left _ => False
    | Right state =>
      match state with
      | Sha256StreamOf actual _ buffered =>
        andb (eq_nat actual count) (str_eq buffered tail)
      end
    end;

def crypto_check_reusable_final (input : String) (expected : String) : Bool :=
    match sha256_stream_update sha256_stream_init input with
    | Left _ => False
    | Right state =>
      match sha256_stream_final state with
      | Left _ => False
      | Right first =>
        match sha256_stream_final state with
        | Left _ => False
        | Right second =>
          andb (str_eq first expected) (str_eq first second)
        end
      end
    end;
