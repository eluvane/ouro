-- @entry main
-- Proof authorization is independent from proposal scheduling. Fake edits with
-- a legitimate rule ID must fail, even when their byte ranges are well formed.
import "quality_test_support.ouro",
  "../tools/fix/pipeline.ouro",
  "../std/io.ouro";

def ft_edit (start : Nat) (stop : Nat) (replacement : String) (rule : String) : FxEdit :=
    MkFxEdit start stop replacement rule 1 "untrusted proposal";
def ft_reject (src : String) (edits : List FxEdit) : Bool :=
    match fx_certify_transaction src edits with | Left _ => True | Right _ => False end;
def ft_round (src : String) (expected : String) : Bool :=
    match fx_checked_round [] src with
    | Left _ => False
    | Right pair => match pair with | MkPair output edits => andb (str_eq output expected)
        (notb (nullb FxEdit edits)) end end;

def ft_unchanged (src : String) : Bool :=
    match fx_checked_round [] src with
    | Left _ => False
    | Right pair => match pair with | MkPair output edits =>
        andb(str_eq output src, nullb FxEdit edits) end
    end;

def ft_stale : Bool :=
    match fx_certify_transaction ";;" [ft_edit 1 2 "" "double-semi"] with
    | Left _ => False
    | Right proof => andb (fx_transaction_matches ";;" proof)
        (notb (fx_transaction_matches "; ;" proof)) end;
def ft_review (rule : String) : Bool :=
    match fx_applicability (ft_edit 0 0 "" rule) with
    | QualitySuggestedEdit => True | QualityMechanicalEdit => False | QualityNoEdit => False end;
def ft_laws : List (Pair String Bool) :=
    [ MkPair String Bool "rule-ID-is-not-proof" (ft_reject "abcd" [ft_edit 1 2 "" "double-semi"])
    , MkPair String Bool "wrong-replacement-breaks-proof" (ft_reject ";;" [ft_edit 1 2 "x" "double-semi"])
    , MkPair String Bool "wrong-rule-breaks-proof" (ft_reject ";;" [ft_edit 1 2 "" "do-bind"])
    , MkPair String Bool "wrong-span-breaks-proof" (ft_reject ";;" [ft_edit 0 1 "" "double-semi"])
    , MkPair String Bool "comment-in-span-forbids-fix" (ft_reject "; -- why\n;" [ft_edit 1 10 "" "double-semi"])
    , MkPair String Bool "quoted-separator-is-data" (ft_reject "\";;\"" [ft_edit 2 3 "" "double-semi"])
    , MkPair String Bool "overlapping-proof-list-fails" (ft_reject ";;;"
        [ft_edit 1 3 "" "double-semi", ft_edit 2 3 "" "double-semi"])
    , MkPair String Bool "duplicate-unnormalized-proofs-fail" (ft_reject ";;"
        [ft_edit 1 2 "" "double-semi", ft_edit 1 2 "" "double-semi"])
    , MkPair String Bool "out-of-order-proof-list-fails" (ft_reject ";;;"
        [ft_edit 2 3 "" "double-semi", ft_edit 1 2 "" "double-semi"])
    , MkPair String Bool "stale-snapshot-invalidates-proof" ft_stale
    , MkPair String Bool "syntax-separator-proof-applies" (ft_round "def n : Nat := 1;;" "def n : Nat := 1;")
    , MkPair String Bool "legacy-bind-proof-applies" (ft_round "do x <- action; x" "do let! x := action; x")
    , MkPair String Bool "duplicate-import-proof-applies" (ft_round
        "import \"x.ouro\";\nimport \"x.ouro\";\ndef n : Nat := 1;"
        "import \"x.ouro\";\ndef n : Nat := 1;")
    , MkPair String Bool "duplicate-first-member-preserves-group" (ft_unchanged
        "import \"x.ouro\";\nimport \"x.ouro\", \"y.ouro\";")
    , MkPair String Bool "alias-and-multiline-group-remain-separate" (ft_unchanged
        "import \"x.ouro\" as Old;\nimport -- dependencies\n \"x.ouro\", \"y.ouro\",;")
    , MkPair String Bool "binder-identity-needs-review" (ft_review "identity-let")
    , MkPair String Bool "dead-let-needs-review" (ft_review "dead-let")
    , MkPair String Bool "empty-transaction-preserves-source"
        (match fx_certify_transaction "source" [] with | Left _ => False
         | Right proof => str_eq(fx_transaction_output proof, "source") end)
    ];
def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True ft_laws;
       exit (match ok with | True => 0 | False => 1 end)
