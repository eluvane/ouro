import "../compiler/checked_program_output.ouro";
import "../compiler/file_elab.ouro";
import "../std/string.ouro";

def output_io_fuel : Nat := mul 20 50;

def output_io_names (offset : Nat) : InternState :=
    let names : List String := ["Carrier", "Byte", "Word", "Pointer", "One", "Only",
      "IO", "Action", "Deferred", "yield_value", "chain_action", "io_pure", "io_bind",
      "prim_string_concat", "lift", "chain", "Closed", "opaque", "pure_alias", "bind_alias",
      "unit_action", "nested_action", "callback_action", "bound_action"] in
    MkIntern
      ((fix assign (rest : List String) (index : Nat) : List (Pair (List Nat) Nat) :=
        match rest with | Nil => [] | Cons name tail => Cons (Pair (List Nat) Nat)
          (MkPair (List Nat) Nat (prim_string_to_char_codes name) index) (assign tail (S index)) end)
        names (S offset)) (add offset 25) ([] : List (Pair (List Nat) Nat)) 0;

def output_io_apply (family : Nat) (payload : CoreTerm) : CoreTerm :=
    CApp (CConst family) payload;

def output_io_pure_type (family : Nat) : CoreTerm :=
    CPi (CSort 0) (CPi (CRel 0) (output_io_apply family (CRel 1)));

def output_io_bind_type (family : Nat) : CoreTerm :=
    CPi (CSort 0) (CPi (CSort 0) (CPi (output_io_apply family (CRel 1))
      (CPi (CPi (CRel 2) (output_io_apply family (CRel 2))) (output_io_apply family (CRel 2)))));

def output_io_pure_body (pure_name : Nat) : CoreTerm :=
    CLam (CSort 0) (CLam (CRel 0) (CApp (CApp (CConst pure_name) (CRel 1)) (CRel 0)));

def output_io_bind_body (family : Nat) (bind_name : Nat) : CoreTerm :=
    CLam (CSort 0) (CLam (CSort 0) (CLam (output_io_apply family (CRel 1))
      (CLam (CPi (CRel 2) (output_io_apply family (CRel 2)))
        (CApp (CApp (CApp (CApp (CConst bind_name) (CRel 3)) (CRel 2)) (CRel 1)) (CRel 0)))));

def output_io_items (offset : Nat) : List FileItem :=
    let name : Nat -> Nat := fun (index : Nat) => add offset index in
    let action_type : CoreTerm -> CoreTerm := output_io_apply (name 1) in
    let public : CoreTerm -> CoreTerm := output_io_apply (name 7) in
    let unit : CoreTerm := CInd (name 5) in
    let closed : CoreTerm := CConst (name 17) in
    [FIntrinsic (name 1) (CPi (CSort 0) (CSort 0)) (primitive_key PrimitiveRuntimeType) (Nothing CoreTerm),
     FIntrinsic (name 2) (CSort 0) (primitive_key PrimitiveU8Type) (Nothing CoreTerm),
     FIntrinsic (name 3) (CSort 0) (primitive_key PrimitiveU32Type) (Nothing CoreTerm),
     FIntrinsic (name 4) (CPi (CSort 0) (CSort 0)) (primitive_key PrimitiveRawPtrType) (Nothing CoreTerm),
     FInd (MkIndDecl (name 5) ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor (name 6) unit] : List Ctor)),
     FRepresentation (name 5) (prim_string_to_char_codes "ouro.unit"),
     FDef (name 7) (CPi (CSort 0) (CSort 0)) (CLam (CSort 0) (action_type (CRel 0))),
     FDef (name 8) (CPi (CSort 0) (CSort 0)) (CConst (name 7)),
     FDef (name 9) (CPi (CSort 0) (CSort 0))
       (CLam (CSort 0) (output_io_apply (name 8) (CRel 0))),
     FIntrinsic (name 10) (output_io_pure_type (name 1)) (primitive_key PrimitiveRuntimePure) (Nothing CoreTerm),
     FIntrinsic (name 11) (output_io_bind_type (name 1)) (primitive_key PrimitiveRuntimeBind) (Nothing CoreTerm),
     -- These legacy-looking names must not change their checked identities.
     FIntrinsic (name 12)
       (CPi (CSort 0) (CPi (CRel 0) (CPi (CPi (CRel 1) (action_type (CConst (name 2))))
         (CPi (CPi (CRel 2) (action_type (CRel 3))) (action_type (CRel 3))))))
       (primitive_key PrimitiveRuntimeLoop) (Nothing CoreTerm),
     FIntrinsic (name 13) (CPi (CSort 0) (output_io_apply (name 4) (CRel 0)))
       (primitive_key PrimitiveRawNull) (Nothing CoreTerm),
     FExtern (name 14) (action_type (CConst (name 3)))
       (ExternRequestOf (prim_string_to_char_codes "windows-x86_64") (prim_string_to_char_codes "win64")
         (prim_string_to_char_codes "kernel32.dll") (prim_string_to_char_codes "GetCurrentProcessId") False PrimitiveMayGc),
     FDef (name 15) (output_io_pure_type (name 9)) (output_io_pure_body (name 10)),
     FDef (name 16) (output_io_bind_type (name 9)) (output_io_bind_body (name 9) (name 11)),
     FDef (name 17) (CSort 0) (output_io_apply (name 8) unit),
     FAxiom (name 18) (CPi closed closed),
     FDef (name 19) (output_io_pure_type (name 7)) (CConst (name 15)),
     FDef (name 20) (output_io_bind_type (name 7)) (CConst (name 16)),
     FDef (name 21) (public unit) (CApp (CApp (CConst (name 15)) unit) (CConstruct (name 5) 0 0)),
     FDef (name 22) (public closed) (CApp (CApp (CConst (name 15)) closed) (CConst (name 21))),
     FDef (name 23) (public (CPi closed closed))
       (CApp (CApp (CConst (name 15)) (CPi closed closed)) (CConst (name 18))),
     FDef (name 24) (public unit)
       (CApp (CApp (CApp (CApp (CConst (name 16)) closed) unit) (CConst (name 22)))
         (CLam closed (CConst (name 21))))];

def output_io_fixture (offset : Nat) : CompResult CheckedProgram :=
    let items : List FileItem := output_io_items offset in
    match check_declarations CheckExactCore keep_checking output_io_fuel items with
    | DeclarationsErr _ _ _ => CErr CheckedProgram (ErrCode 49 1)
    | DeclarationsOk entries =>
        let cores : List (Pair Nat CoreTerm) :=
          (fix collect (rest : List FileItem) : List (Pair Nat CoreTerm) :=
            match rest with | Nil => [] | Cons item tail => match item with
              | FDef name _ body => Cons (Pair Nat CoreTerm) (MkPair Nat CoreTerm name body) (collect tail)
              | FAxiom _ _ => collect tail | FIntrinsic _ _ _ _ => collect tail
              | FExtern _ _ _ => collect tail | FInd _ => collect tail
              | FRepresentation _ _ => collect tail
              end end) items in
        COk CheckedProgram (CheckedProgramOf (output_io_names offset) entries cores)
    end;
