-- Renaming the source function preserves the checked C bridge identity.
import "../std/test.ouro";

def KindText : Type := String;
def KindAction (A : Type) : Type := IO A;
intrinsic renamed_kind : KindText -> KindAction Nat := "ouro.fs.kind";

def main : IO Unit :=
    let query : String -> IO Nat := renamed_kind in
    let saved : IO Nat := query "std/runtime.ouro" in
    do let! empty := query "";
       let! file := saved;
       let! again := saved;
       let! directory := query "tests";
       let! absent := query "__ouro_kind_missing_probe_257__";
       test_run
         [assert_true "renamed C file kind returns missing for the empty path" (eq_nat empty 0),
          assert_true "renamed C file kind reads a regular file on each invocation" (andb (eq_nat file 1) (eq_nat again 1)),
          assert_true "renamed C file kind identifies a directory" (eq_nat directory 2),
          assert_true "renamed C file kind preserves the missing path result" (eq_nat absent 0)]
