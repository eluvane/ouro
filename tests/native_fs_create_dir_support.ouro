-- Independent constructor predicates shared by pure laws and native probes.
import "../std/fs_create_model.ouro";
import "../compiler/base.ouro";

def fs_create_test_error_kind (error : FsCreateDirError) : Nat :=
    match error with
    | FsCreateDirConstantsFailed => 0
    | FsCreateDirInvalidPath => 1
    | FsCreateDirPathTooLong => 2
    | FsCreateDirAllocationFailed => 3
    | FsCreateDirConversionFailed => 4
    | FsCreateDirInvalidCount => 5
    | FsCreateDirCreateFailed => 6
    | FsCreateDirCleanupFailed _ _ => 7
    end;

def fs_create_test_length (expected : Nat) (result : Either FsCreateDirError Nat) : Bool :=
    match result with | Left _ => False | Right count => eq_nat expected count end;

def fs_create_test_length_error (kind : Nat) (result : Either FsCreateDirError Nat) : Bool :=
    match result with
    | Right _ => False
    | Left error => eq_nat kind (fs_create_test_error_kind error)
    end;

def fs_create_test_error (kind : Nat) (result : Either FsCreateDirError Unit) : Bool :=
    match result with
    | Right _ => False
    | Left error => eq_nat kind (fs_create_test_error_kind error)
    end;

def fs_create_test_success (result : Either FsCreateDirError Unit) : Bool :=
    match result with | Right _ => True | Left _ => False end;

def fs_create_test_prior (expected : Maybe Nat) (actual : Maybe FsCreateDirError) : Bool :=
    match expected with
    | Nothing => match actual with | Nothing => True | Just _ => False end
    | Just kind => match actual with
      | Nothing => False
      | Just error => eq_nat kind (fs_create_test_error_kind error)
      end
    end;

def fs_create_test_cleanup (created : Bool) (prior : Maybe Nat)
    (result : Either FsCreateDirError Unit) : Bool :=
    match result with
    | Right _ => False
    | Left error => match error with
      | FsCreateDirConstantsFailed => False
      | FsCreateDirInvalidPath => False
      | FsCreateDirPathTooLong => False
      | FsCreateDirAllocationFailed => False
      | FsCreateDirConversionFailed => False
      | FsCreateDirInvalidCount => False
      | FsCreateDirCreateFailed => False
      | FsCreateDirCleanupFailed actual previous =>
          andb (compiler_bool_equal created actual) (fs_create_test_prior prior previous)
      end
    end;
