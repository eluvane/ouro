-- HTTP authority is attached to the checked status/body/error contract.
import "../compiler/driver.ouro";
import "compiler_startup_test_support.ouro";

def http_binding_prefix : String :=
    prim_string_concat
      "intrinsic Action : Type -> Type := \"ouro.runtime\"; intrinsic Text : Type := \"ouro.string\"; inductive Count : Type := | Zero : Count | Next : Count -> Count; representation Count := \"ouro.nat\"; "
      "inductive Chain (A : Type) : Type := | End : Chain A | Link : A -> Chain A -> Chain A; representation Chain := \"ouro.list\"; inductive Couple (A : Type) (B : Type) : Type := | Both : A -> B -> Couple A B; representation Couple := \"ouro.pair\"; def Deferred (A : Type) : Type := Action A; def Name : Type := Text; def Reply : Type := Couple Count (Couple Text Text); ";

def http_binding_compile (source : String) : CompResult CheckedProgram :=
    compile_checked_source (mul 100 50)
      (prim_string_to_char_codes (prim_string_concat http_binding_prefix source));

def http_binding_selected (source : String) : Bool :=
    match http_binding_compile source with
    | CErr _ => False
    | COk program =>
        (fix find (entries : List Entry) : Bool :=
          match entries with | Nil => False | Cons entry rest =>
            match entry with
            | MkBoundEntry _ _ binding =>
                match binding with
                | PrimitiveExternBinding _ => find rest
                | PrimitiveIntrinsicBinding id mode gc specialization =>
                    match primitive_id_equal id PrimitiveHttpPost with
                    | False => find rest
                    | True =>
                        andb (match mode with | PrimitiveRuntimeAction => True
                          | PrimitivePureValue => False | PrimitiveTypeOnly => False end)
                          (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                            (match specialization with | Nothing => True | Just _ => False end))
                    end
                end
            | MkEntry _ _ _ => find rest
            | MkIndEntry _ _ => find rest
            | MkRoleEntry _ => find rest
            end
          end) (checked_program_entries program)
    end;

def http_binding_rejected (source : String) : Bool :=
    match http_binding_compile source with
    | COk _ => False
    | CErr error => match error with | ErrCode code _ => eqNat code 42 end
    end;

def main : IO Unit :=
    startup_test_run
      [startup_test_assert "HTTP status/body/error binding is an allocating action"
         (http_binding_selected "intrinsic send : Text -> Chain (Couple Text Text) -> Text -> Action (Couple Count (Couple Text Text)) := \"ouro.http.post\";"),
       startup_test_assert "HTTP binding accepts transparent aliases"
         (http_binding_selected "intrinsic renamed : Name -> Chain (Couple Name Name) -> Name -> Deferred Reply := \"ouro.http.post\";"),
       startup_test_assert "HTTP rejects the retired String-only response"
         (http_binding_rejected "intrinsic send : Text -> Chain (Couple Text Text) -> Text -> Action Text := \"ouro.http.post\";"),
       startup_test_assert "HTTP rejects headers without name/value pairs"
         (http_binding_rejected "intrinsic send : Text -> Chain Text -> Text -> Action Reply := \"ouro.http.post\";"),
       startup_test_assert "HTTP rejects a pure transport result"
         (http_binding_rejected "intrinsic send : Text -> Chain (Couple Text Text) -> Text -> Reply := \"ouro.http.post\";"),
       startup_test_assert "HTTP rejects a response without the failure reason"
         (http_binding_rejected "intrinsic send : Text -> Chain (Couple Text Text) -> Text -> Action (Couple Count Text) := \"ouro.http.post\";")];
