-- Transformation occurs after complete checking/replay and before canonical
-- MIR annotation and validation. Original raw bodies keep their own calls;
-- exit/collector dispatch alone is shared with the probes.
import "../compiler/native/managed_source.ouro";
import "../std/runtime.ouro";
import "native_copy_fault_calls.ouro";

def copy_fault_instruction (base : Nat) (symbols : List Nat) (managed : Bool)
    (instruction : MirInstruction) : MirInstruction :=
    match instruction with
    | MirCall gc result target arguments => match target with
      | MirIndirect _ _ => instruction | MirDirect id => match startup_fault_target symbols id with
        | Nothing => instruction | Just index => match orb managed (orb (eqNat index 4) (eqNat index 5)) with
          | False => instruction | True => MirCall gc result (MirDirect (add base index)) arguments end end end
    | MirManagedAlloc local allocator _ descriptor bytes => MirManagedAlloc local allocator (add base 5) descriptor bytes
    | MirMove _ _ => instruction | MirBinaryOp _ _ _ _ => instruction | MirCompare _ _ _ _ => instruction
    | MirConvert _ _ _ => instruction | MirLoad _ _ _ => instruction | MirStore _ _ _ => instruction
    | MirLoadAt _ _ _ => instruction | MirStoreAt _ _ _ => instruction | MirAddress _ _ => instruction
    | MirPointerAdd _ _ _ => instruction | MirManagedContext _ => instruction end;

def copy_fault_function (base : Nat) (symbols : List Nat) (contracts : List LowerContract)
    (function : MirFunction) : MirFunction :=
    match function with | MirFunctionDef id name arguments locals result entry blocks =>
      let managed : Bool := match lower_find_contract id contracts with | Nothing => True | Just _ => False end in
      MirFunctionDef id name arguments locals result entry
        (map MirBlock MirBlock (fun (block : MirBlock) => match block with | MirBlockDef label instructions terminator =>
          MirBlockDef label (map MirInstruction MirInstruction (copy_fault_instruction base symbols managed) instructions) terminator end) blocks) end;

def native_copy_fixture (mode : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    match leb_nat mode 23 with
    | False => Left NativeLowerError MirProgram (LowerInvalidCall mode)
    | True => match parts with | ManagedProgramOf checked contracts program =>
        let base : Nat := S (foldr Nat Nat maxNat 0 (mir_global_ids program)) in
        lower_bind (List Nat) MirProgram (copy_fault_symbols checked) (fun (symbols : List Nat) =>
          lower_map (List MirFunction) MirProgram (fun (wrappers : List MirFunction) =>
            match program with | MirProgramDef functions data libraries entry =>
              MirProgramDef (append MirFunction wrappers
                (map MirFunction MirFunction (copy_fault_function base symbols contracts) functions))
                (Cons MirData (MirDataDef (startup_fault_counter base) True (pe_zeros 192))
                  (Cons MirData (MirDataDef (add base 33) False (copy_fault_order_bytes mode)) data)) libraries entry end)
            (copy_fault_wrappers base mode symbols)) end end;
