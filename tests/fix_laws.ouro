import "../std/io.ouro",
  "../std/string.ouro";
import "fix_precision.ouro" as Precision;
import "fix_proofs.ouro" as Proofs;

private def fix_laws_usage : IO Unit :=
    do eprintln "usage: fix-laws --group precision|proofs";
       exit 2;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       if andb(eq_nat(length String arguments, 3), str_eq(nth String "" 1 arguments, "--group")) then
         let group : String := nth String "" 2 arguments in
         if str_eq group "precision" then Precision.main
         else if str_eq group "proofs" then Proofs.main
         else fix_laws_usage
       else fix_laws_usage;
