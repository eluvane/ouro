-- Source spelling, transparent aliases and identifier offsets must preserve
-- checked startup identities and the established development C shim keys.
import "../compiler/driver.ouro",
  "../compiler/checked_program_output.ouro",
  "../std/listx.ouro",
  "compiler_startup_test_support.ouro",
  "compiler_program_lookup.ouro";

def startup_metadata_prefix : String :=
    prim_string_concat
      "intrinsic Action : Type -> Type := \"ouro.runtime\"; intrinsic Text : Type := \"ouro.string\"; inductive Chain (A : Type) : Type := | End : Chain A | Link : A -> Chain A -> Chain A; representation Chain := \"ouro.list\"; "
      "inductive Optional (A : Type) : Type := | Absent : Optional A | Present : A -> Optional A; representation Optional := \"ouro.maybe\"; def Deferred (A : Type) : Type := Action A; def Name : Type := Text; ";

def startup_metadata_compile (source : String) : CompResult CheckedProgram :=
    compile_checked_source(mul 100 50, prim_string_to_char_codes (prim_string_concat startup_metadata_prefix source));

def startup_metadata_selected (source : String) (name : String) (primitive : PrimitiveId) (c_key : String) : Bool :=
    match startup_metadata_compile source with | CErr _ => False | COk program =>
      match compiler_test_name program name with | Nothing => False | Just id =>
        andb(compiler_test_runtime_binding program id primitive, compiler_test_c_shim program id c_key) end end;

def startup_metadata_rejected (source : String) : Bool :=
    match startup_metadata_compile source with | COk _ => False | CErr error =>
      match error with | ErrCode code _ => eqNat code 42 end end;

def startup_metadata_axiom : Bool :=
    match startup_metadata_compile "axiom prim_argv : Deferred (Chain Text); axiom prim_env_get : Text -> Deferred (Optional Text);" with
    | CErr _ => False | COk program =>
      match compiler_test_name program "prim_argv", compiler_test_name program "prim_env_get" with
      | Just argv, Just environment => andb (notb (compiler_test_runtime_binding program argv PrimitiveArgv))
          (andb (notb (compiler_test_runtime_binding program environment PrimitiveEnvGet))
            (andb (notb (compiler_test_c_shim program argv "prim_argv"))
              (notb (compiler_test_c_shim program environment "prim_env_get"))))
      | Nothing, Nothing => False | Nothing, Just _ => False | Just _, Nothing => False end end;

def main : IO Unit :=
    startup_test_run
      [startup_test_assert "renamed argv keeps checked action and existing C implementation"
        (startup_metadata_selected "intrinsic read_arguments : Action (Chain Text) := \"ouro.runtime.argv\";"
          "read_arguments" PrimitiveArgv "prim_argv"),
       startup_test_assert "renamed env keeps checked action and existing C implementation"
        (startup_metadata_selected "intrinsic lookup_variable : Text -> Action (Optional Text) := \"ouro.runtime.env_get\";"
          "lookup_variable" PrimitiveEnvGet "prim_env_get"),
       startup_test_assert "argv accepts transparent Runtime and String aliases"
        (startup_metadata_selected "intrinsic selected : Deferred (Chain Name) := \"ouro.runtime.argv\";"
          "selected" PrimitiveArgv "prim_argv"),
       startup_test_assert "environment accepts transparent Runtime and String aliases"
        (startup_metadata_selected "intrinsic selected : Name -> Deferred (Optional Name) := \"ouro.runtime.env_get\";"
          "selected" PrimitiveEnvGet "prim_env_get"),
       startup_test_assert "misleading env spelling cannot change the argv key"
        (startup_metadata_selected "intrinsic prim_env_get : Deferred (Chain Name) := \"ouro.runtime.argv\";"
          "prim_env_get" PrimitiveArgv "prim_argv"),
       startup_test_assert "misleading argv spelling cannot change the environment key"
        (startup_metadata_selected "intrinsic prim_argv : Name -> Deferred (Optional Name) := \"ouro.runtime.env_get\";"
          "prim_argv" PrimitiveEnvGet "prim_env_get"),
       startup_test_assert "earlier declarations do not change startup metadata"
        (startup_metadata_selected "axiom earlier : Text; def Alias : Type := Text; intrinsic chosen : Alias -> Deferred (Optional Alias) := \"ouro.runtime.env_get\";"
          "chosen" PrimitiveEnvGet "prim_env_get"),
       startup_test_assert "same-named axioms never gain startup bindings or C shims" startup_metadata_axiom,
       startup_test_assert "argv rejects a Maybe result"
        (startup_metadata_rejected "intrinsic wrong : Action (Optional Text) := \"ouro.runtime.argv\";"),
       startup_test_assert "argv rejects an extra input"
        (startup_metadata_rejected "intrinsic wrong : Text -> Action (Chain Text) := \"ouro.runtime.argv\";"),
       startup_test_assert "argv rejects a pure result"
        (startup_metadata_rejected "intrinsic wrong : Chain Text := \"ouro.runtime.argv\";"),
       startup_test_assert "argv rejects a container with the wrong payload"
        (startup_metadata_rejected "intrinsic wrong : Action (Chain (Optional Text)) := \"ouro.runtime.argv\";"),
       startup_test_assert "environment rejects a List result"
        (startup_metadata_rejected "intrinsic wrong : Text -> Action (Chain Text) := \"ouro.runtime.env_get\";"),
       startup_test_assert "environment requires its String input"
        (startup_metadata_rejected "intrinsic wrong : Action (Optional Text) := \"ouro.runtime.env_get\";"),
       startup_test_assert "environment rejects a different input identity"
        (startup_metadata_rejected "axiom Other : Type; intrinsic wrong : Other -> Action (Optional Text) := \"ouro.runtime.env_get\";"),
       startup_test_assert "environment rejects a pure result"
        (startup_metadata_rejected "intrinsic wrong : Text -> Optional Text := \"ouro.runtime.env_get\";")];
