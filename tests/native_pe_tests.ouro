-- PE header/table vectors, fail-closed image validation, and loader fixtures.
-- With --image NAME this program prints the writer's actual decimal bytes.
-- A development harness may serialize those bytes while binary Ouro IO lands.

import "native_pe_fixtures.ouro",
  "../std/test.ouro";

def pe_test_error_code (err : PeError) : Nat :=
    match err with
    | PeInvalidByte _ => 1 | PeImageTooLarge => 2 | PeEmptyText => 3
    | PeDuplicateSymbol _ => 4 | PeMissingSymbol _ => 5 | PeInvalidSymbol _ => 6
    | PeInvalidName => 7 | PeDuplicateLibrary => 8 | PeDuplicateImport _ => 9
    | PeMissingImport _ => 10 | PeEmptyLibrary => 11 | PeInvalidFixup _ => 12
    | PeUnorderedFixup _ => 13 | PeNonzeroFixup _ => 14 | PeRelativeOverflow _ => 15
    | PeMissingEntry _ => 16 | PeInvalidFunction _ => 17 | PeUnorderedFunction _ => 18
    | PeUnsupportedFrame _ => 19 | PeStackProbeRequired _ => 20 | PePrologMismatch _ => 21
    | PeInstructionError _ => 22
    end;

def pe_test_error_detail (err : PeError) : Nat :=
    match err with
    | PeInvalidByte detail => detail | PeDuplicateSymbol detail => detail
    | PeMissingSymbol detail => detail | PeInvalidSymbol detail => detail
    | PeDuplicateImport detail => detail | PeMissingImport detail => detail
    | PeInvalidFixup detail => detail | PeUnorderedFixup detail => detail
    | PeNonzeroFixup detail => detail | PeRelativeOverflow detail => detail
    | PeMissingEntry detail => detail | PeInvalidFunction detail => detail
    | PeUnorderedFunction detail => detail | PeUnsupportedFrame detail => detail
    | PeStackProbeRequired detail => detail | PePrologMismatch detail => detail
    | PeImageTooLarge => 0 | PeEmptyText => 0 | PeInvalidName => 0
    | PeDuplicateLibrary => 0 | PeEmptyLibrary => 0 | PeInstructionError _ => 0
    end;

def pe_test_error_text (err : PeError) : String :=
    str_cat3(str_of_nat (pe_test_error_code err), ":", str_of_nat (pe_test_error_detail err));

def pe_test_error (A : Type) (name : String) (expected : PeError) (result : Either PeError A) : Test :=
    match result with
    | Left err => assert_eq(name, pe_test_error_text err, pe_test_error_text expected)
    | Right _ => test_fail name "invalid input accepted"
    end;

def pe_test_byte_text (bytes : List Nat) : String := str_join(",", map Nat String str_of_nat bytes);

def pe_test_bytes (name : String) (got : List Nat) (expected : List Nat) : Test :=
    assert_eq(name, pe_test_byte_text got, pe_test_byte_text expected);

def pe_test_slice (name : String) (bytes : List Nat) (offset : Nat) (expected : List Nat) : Test :=
    pe_test_bytes name (take(Nat, length Nat expected, drop Nat offset bytes)) expected;

def pe_test_header_checks (bytes : List Nat) : List Test :=
    [ assert_true("PE file size includes all section padding", eq_nat(length Nat bytes, mul 20 256))
    , pe_test_slice "MZ signature" bytes 0 ([77, 90] : List Nat)
    , pe_test_slice "PE header offset" bytes 60 ([128, 0, 0, 0] : List Nat)
    , pe_test_slice "PE signature and AMD64 machine" bytes 128 ([80, 69, 0, 0, 100, 134, 8, 0] : List Nat)
    , pe_test_slice "deterministic COFF timestamp" bytes 136 ([0, 0, 0, 0] : List Nat)
    , pe_test_slice "PE32+ optional header magic" bytes 152 ([11, 2] : List Nat)
    , pe_test_slice "entry RVA" bytes 168 ([0, 16, 0, 0] : List Nat)
    , pe_test_slice "64-bit preferred image base" bytes 176 ([0, 0, 0, 64, 1, 0, 0, 0] : List Nat)
    , pe_test_slice "section and file alignment" bytes 184 ([0, 16, 0, 0, 0, 2, 0, 0] : List Nat)
    , pe_test_slice "image and header sizes" bytes 208 ([0, 144, 0, 0, 0, 4, 0, 0] : List Nat)
    , pe_test_slice "console NX ASLR high entropy flags" bytes 220 ([3, 0, 96, 129] : List Nat)
    , pe_test_slice "2 GiB stack reserve" bytes 224 ([0, 0, 0, 128, 0, 0, 0, 0] : List Nat)
    , pe_test_slice("import descriptor directory", bytes, add 256 16, [0, 64, 0, 0, 40, 0, 0, 0] : List Nat)
    , pe_test_slice("exception directory", bytes, add 256 32, [0, 80, 0, 0, 12, 0, 0, 0] : List Nat)
    , pe_test_slice("no unnecessary base relocations", bytes, add 256 48, pe_zeros 8)
    , pe_test_slice("IAT directory", bytes, add 256 104, [56, 64, 0, 0, 16, 0, 0, 0] : List Nat)
    , pe_test_slice("text RX permissions", bytes, add 256 172, [32, 0, 0, 96] : List Nat)
    , pe_test_slice("rdata read-only permissions", bytes, add 256 212, [64, 0, 0, 64] : List Nat)
    , pe_test_slice("data RW permissions", bytes, add 256 252, [64, 0, 0, 192] : List Nat)
    , pe_test_slice("resolved RIP call to IAT", bytes, add pe_header_size 12, [255, 21, 38, 48, 0, 0] : List Nat)
    , pe_test_slice("runtime function entry", bytes, mul 12 256, [0, 16, 0, 0, 20, 16, 0, 0, 0, 96, 0, 0] : List Nat)
    , pe_test_slice("40-byte frame unwind info", bytes, mul 14 256, [1, 7, 1, 0, 7, 66, 0, 0] : List Nat)
    , pe_test_slice "embedded function map signature version count" bytes (mul 16 256)
        ([79, 85, 82, 79, 77, 65, 80, 0, 1, 0, 0, 0, 1, 0, 0, 0] : List Nat)
    ];

def pe_test_unwind_vector (name : String) (frame : PeFrame) (prolog : List Nat) (unwind : List Nat) : Test :=
    match pe_encode_frame 1 frame with
    | Left err => test_fail(name, pe_test_error_text err)
    | Right info =>
      match info with
      | PeUnwindInfoData got_prolog got_unwind => assert_true name
          (andb(pe_bytes_equal got_prolog prolog, pe_bytes_equal got_unwind unwind))
      end
    end;

def pe_test_large_bytes : List Nat :=
    concat_map(Nat, Nat, fun (_ : Nat) => pe_zeros (mul 4 256), pe_zeros 64);

def pe_test_cursor_checks : List Test :=
    let symbols : List PeSymbol := [PeNamedSymbol 1 PeText 0] in
    let sections : List PePlacedSection :=
      [PeSectionAt PeText pe_section_alignment 0 32 (pe_zeros 32),
       PeSectionAt PeReadOnly (mul 2 pe_section_alignment) 0 16 (pe_zeros 16),
       PeSectionAt PeWritable (mul 3 pe_section_alignment) 0 16 (pe_zeros 16)] in
    let fixups : List PeFixup := [PeRva32 PeText 4 (PeSymbolTarget 1), PeRva32 PeText 8 (PeSymbolTarget 1),
      PeVa64 PeText 24 (PeSymbolTarget 1), PeRva32 PeReadOnly 0 (PeSymbolTarget 1), PeVa64 PeWritable 8 (PeSymbolTarget 1)] in
    match pe_plan_fixups sections symbols ([] : List (Pair Nat Nat)) fixups with
    | Left error => [test_fail("PE forward fixup cursor", pe_test_error_text error)]
    | Right patches =>
      [pe_test_bytes "PE fixup cursor preserves adjacent slots gaps and mixed widths"
        (pe_apply_section_patches PeText (pe_zeros 32) patches)
        (pe_join ([pe_zeros 4, pe_le32 pe_section_alignment, pe_le32 pe_section_alignment, pe_zeros 12,
          pe_va64 pe_section_alignment] : List (List Nat))),
       pe_test_bytes "PE fixup cursor resets at read-only section start"
        (pe_apply_section_patches PeReadOnly (pe_zeros 16) patches)
        (append(Nat, pe_le32 pe_section_alignment, pe_zeros 12)),
       pe_test_bytes "PE fixup cursor skips the first writable prefix"
        (pe_apply_section_patches PeWritable (pe_zeros 16) patches)
        (append(Nat, pe_zeros 8, pe_va64 pe_section_alignment)),
       pe_test_error (List PePatch) "PE forward fixup checks bytes after a gap" (PeNonzeroFixup 20)
        (pe_plan_fixups
          ([PeSectionAt PeText pe_section_alignment 0 32 (append(Nat, pe_zeros 20, Cons Nat 1 (pe_zeros 11)))] : List PePlacedSection)
          symbols ([] : List (Pair Nat Nat)) ([PeRva32 PeText 4 (PeSymbolTarget 1), PeRva32 PeText 20 (PeSymbolTarget 1)] : List PeFixup))]
    end;


def pe_test_function_record (info : PeFunctionInfo) : String :=
    match info with | PeFunctionInfoData name start finish label metadata =>
      pe_test_byte_text (pe_join ([([name, start, finish, length Nat label] : List Nat), label,
        ([length Nat metadata] : List Nat), metadata] : List (List Nat))) end;

def pe_test_function_records (name : String) (result : Either PeError (List PeFunctionInfo))
    (expected : List PeFunctionInfo) : Test :=
    match result with | Left error => test_fail(name, pe_test_error_text error)
    | Right actual => assert_eq name
        (str_join(";", map PeFunctionInfo String pe_test_function_record actual))
        (str_join(";", map PeFunctionInfo String pe_test_function_record expected)) end;

def pe_test_function_cursor_checks : List Test :=
    let frame40 : PeFrame := PeCallFrame([] : List X64Register, 40) in
    let frame56 : PeFrame := PeCallFrame([] : List X64Register, 56) in
    let first : PeFunction := PeCodeFunction 1 8 ([97] : List Nat) frame40 in
    let second : PeFunction := PeCodeFunction 2 8 ([98] : List Nat) frame56 in
    let third : PeFunction := PeCodeFunction 3 1 ([99] : List Nat) PeLeaf in
    let text : List Nat := [170, 171, 172, 72, 129, 236, 40, 0, 0, 0, 195,
      72, 129, 236, 56, 0, 0, 0, 195, 173, 174, 175, 176, 195, 177, 178] in
    let sections : List PePlacedSection :=
      [PeSectionAt PeText pe_section_alignment 0 32 text,
       PeSectionAt PeReadOnly (mul 2 pe_section_alignment) 0 1 ([0] : List Nat)] in
    let symbols : List PeSymbol := [PeNamedSymbol 1 PeText 3, PeNamedSymbol 2 PeText 11,
      PeNamedSymbol 3 PeText 23, PeNamedSymbol 4 PeText 8, PeNamedSymbol 5 PeReadOnly 0,
      PeNamedSymbol 6 PeText 26, PeNamedSymbol 7 PeText 30, PeNamedSymbol 8 PeText 0] in
    let collect : List PeFunction -> Either PeError (List PeFunctionInfo) := pe_collect_functions sections symbols in
    let expected : List PeFunctionInfo :=
      [PeFunctionInfoData(1, add pe_section_alignment 3, add pe_section_alignment 11, [97] : List Nat, [1, 7, 1, 0, 7, 66, 0, 0] : List Nat),
       PeFunctionInfoData(2, add pe_section_alignment 11, add pe_section_alignment 19, [98] : List Nat, [1, 7, 1, 0, 7, 98, 0, 0] : List Nat),
       PeFunctionInfoData(3, add pe_section_alignment 23, add pe_section_alignment 24, [99] : List Nat, [1, 0, 0, 0] : List Nat)] in
    [pe_test_function_records "PE function cursor retains every record across prefix adjacency gap and suffix"
       (collect ([first, second, third] : List PeFunction)) expected,
     pe_test_function_records "PE empty function list needs no text section"
       (pe_collect_functions([] : List PePlacedSection, symbols, [] : List PeFunction)) ([] : List PeFunctionInfo),
     pe_test_function_records "PE direct function validator retains its original-offset contract"
       (mapRight PeError PeFunctionInfo (List PeFunctionInfo)
         (fun (info : PeFunctionInfo) => [info]) (pe_function_info sections symbols third))
       (drop PeFunctionInfo 2 expected),
     pe_test_error (List PeFunctionInfo) "PE cursor missing symbol precedes later checks" (PeMissingSymbol 99)
       (collect ([first, PeCodeFunction 99 0 ([256] : List Nat) frame40] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor wrong section precedes bounds and label" (PeInvalidFunction 5)
       (collect ([first, PeCodeFunction 5 0 ([256] : List Nat) frame40] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor absent text retains function diagnostic" (PeInvalidFunction 1)
       (pe_collect_functions([] : List PePlacedSection, symbols, [first] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor rejects zero size before label and frame" (PeInvalidFunction 2)
       (collect ([first, PeCodeFunction 2 0 ([256] : List Nat) frame40] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor checks body bounds against original section" (PeInvalidFunction 2)
       (collect ([first, PeCodeFunction 2 16 ([256] : List Nat) frame40] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor rejects start at section end" (PeInvalidFunction 6)
       (collect ([first, PeCodeFunction 6 1 ([] : List Nat) PeLeaf] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor rejects start beyond section end" (PeInvalidFunction 7)
       (collect ([first, PeCodeFunction 7 1 ([] : List Nat) PeLeaf] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor label error precedes frame prolog and ordering" (PeInvalidByte 256)
       (collect ([first, PeCodeFunction(1, 8, [256, 257] : List Nat, PeCallFrame([] : List X64Register, 24))] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor frame error precedes prolog and ordering" (PeUnsupportedFrame 1)
       (collect ([first, PeCodeFunction(1, 8, [] : List Nat, PeCallFrame([] : List X64Register, 24))] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor probe error precedes prolog and ordering" (PeStackProbeRequired 1)
       (collect ([first, PeCodeFunction(1, 8, [] : List Nat, PeCallFrame([] : List X64Register, pe_section_alignment))] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor prolog mismatch precedes equal-start ordering" (PePrologMismatch 1)
       (collect ([first, PeCodeFunction 1 8 ([] : List Nat) frame56] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor equal valid starts retain ordering error" (PeUnorderedFunction 1)
       (collect ([first, first] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor validates adjacent prolog from its own start" (PePrologMismatch 2)
       (collect ([first, PeCodeFunction 2 8 ([] : List Nat) frame40] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor overlap after previous start retains ordering error" (PeUnorderedFunction 4)
       (collect ([first, PeCodeFunction 4 1 ([] : List Nat) PeLeaf] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor overlapping prolog error precedes ordering" (PePrologMismatch 4)
       (collect ([first, PeCodeFunction 4 8 ([] : List Nat) frame40] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE backwards valid prolog uses original bytes before ordering" (PeUnorderedFunction 1)
       (collect ([second, first] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE backwards prolog mismatch uses original bytes before ordering" (PePrologMismatch 1)
       (collect ([second, PeCodeFunction 1 8 ([] : List Nat) frame56] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE backwards leaf still reaches ordering check" (PeUnorderedFunction 8)
       (collect ([second, PeCodeFunction 8 1 ([] : List Nat) PeLeaf] : List PeFunction)),
     pe_test_error (List PeFunctionInfo) "PE cursor requires a body after the prolog" (PePrologMismatch 1)
       (collect ([PeCodeFunction 1 7 ([] : List Nat) frame40] : List PeFunction)),
     pe_test_function_records "PE cursor accepts a leaf ending exactly at section end"
       (collect ([first, second, PeCodeFunction 3 3 ([99] : List Nat) PeLeaf] : List PeFunction))
       (append PeFunctionInfo (take PeFunctionInfo 2 expected)
         ([PeFunctionInfoData(3, add pe_section_alignment 23, add pe_section_alignment 26, [99] : List Nat, [1, 0, 0, 0] : List Nat)] : List PeFunctionInfo))];

-- Large gaps require a linear traversal of the original text. Every record is
-- compared, so omitting a function or changing its range cannot satisfy this.
def pe_test_function_cursor_scale : Test :=
    let stride : Nat := mul 8 256 in
    let ids : List Nat := (fix collect (remaining : Nat) (id : Nat) : List Nat :=
      match remaining with | Z => [] | S rest => Cons Nat id (collect(rest, S id)) end) 128 1 in
    let frame : PeFrame := PeCallFrame([] : List X64Register, 40) in
    let body : List Nat := append(Nat, [72, 129, 236, 40, 0, 0, 0, 195] : List Nat, pe_zeros (sub stride 8)) in
    let sections : List PePlacedSection := [PeSectionAt PeText pe_section_alignment 0 (mul stride 128)
      (concat_map Nat Nat (fun (_ : Nat) => body) ids)] in
    let symbols : List PeSymbol := map Nat PeSymbol
      (fun (id : Nat) => PeNamedSymbol id PeText (mul(sub id 1, stride))) ids in
    let functions : List PeFunction := map Nat PeFunction
      (fun (id : Nat) => PeCodeFunction id 8 ([id] : List Nat) frame) ids in
    let expected : List PeFunctionInfo := map Nat PeFunctionInfo
      (fun (id : Nat) => let start : Nat := add(pe_section_alignment, mul(sub id 1, stride)) in
        PeFunctionInfoData(id, start, add start 8, [id] : List Nat, [1, 7, 1, 0, 7, 66, 0, 0] : List Nat)) ids in
    pe_test_function_records "PE function cursor checks all 128 functions across 256 KiB text"
      (pe_collect_functions sections symbols functions) expected;

def pe_test_byte_check_result (name : String) (result : Either PeError (List Nat))
    (expected : List Nat) : Test :=
    match result with | Left error => test_fail(name, pe_test_error_text error)
    | Right bytes => pe_test_bytes name bytes expected end;

def pe_test_reject_byte_work (_ : Unit -> Either PeError (List Nat)) : Either PeError (List Nat) :=
    Left(PeError, List Nat, PeInvalidByte 511);

def pe_test_byte_step_checks : List Test :=
    let chunk : Nat := mul 4 256 in
    let suffix : List Nat := [255, 0, 128, 1] in
    let bytes : List Nat := append Nat (pe_zeros chunk) suffix in
    [ pe_test_byte_check_result "PE byte step accepts empty input"
        (pe_check_byte_step 3 [] MkUnit) []
    , pe_test_byte_check_result "PE byte step exhausts an exact chunk"
        (pe_check_byte_step 3 [0, 128, 255] MkUnit) []
    , pe_test_byte_check_result "PE byte step exhausts a partial chunk"
        (pe_check_byte_step 3 [0, 255] MkUnit) []
    , pe_test_byte_check_result "PE byte step returns the complete unvisited suffix"
        (pe_check_byte_step chunk bytes MkUnit) suffix
    , pe_test_error (List Nat) "PE byte step retains the first chunk error" (PeInvalidByte 257)
        (pe_check_byte_step 3 [0, 257, 256] MkUnit)
    , pe_test_byte_check_result "PE byte step leaves the next chunk for its own validation"
        (pe_check_byte_step 3 [0, 128, 255, 256, 257] MkUnit) [256, 257]
    , pe_test_byte_check_result "PE byte runner returns the complete original input"
        (pe_check_bytes_with pe_run_byte_check bytes) bytes
    , pe_test_error (List Nat) "PE byte runner propagates its typed error" (PeInvalidByte 511)
        (pe_check_bytes_with pe_test_reject_byte_work [0])
    , pe_test_byte_check_result "PE empty input does not invoke the byte runner"
        (pe_check_bytes_with pe_test_reject_byte_work []) []
    ];

def pe_test_table_checks : List Test :=
    [ match pe_check_bytes pe_test_large_bytes with
      | Left error => test_fail("PE validates a full section with bounded byte recursion", pe_test_error_text error)
      | Right bytes => assert_true "PE validates a full section with bounded byte recursion"
          (andb (eq_nat(length Nat bytes, pe_byte2_place))
            (pe_bytes_equal(take Nat 4 bytes, pe_zeros 4))) end
    , pe_test_error (List Nat) "PE rejects the first invalid byte across a chunk boundary" (PeInvalidByte 300)
        (pe_check_bytes (append(Nat, pe_zeros (mul 4 256), [300, 301] : List Nat)))
    , pe_test_error (List Nat) "PE checks the final partial byte chunk" (PeInvalidByte 511)
        (pe_check_bytes (append(Nat, pe_zeros (add(mul 8 256, 7)), [511] : List Nat)))
    , pe_test_bytes("largest PE RVA serialization", pe_le32 pe_max_rva, [255, 255, 255, 127] : List Nat)
    , pe_test_bytes("RVA to preferred VA", pe_va64 pe_section_alignment, [0, 16, 0, 64, 1, 0, 0, 0] : List Nat)
    , assert_true("file alignment boundary", eq_nat(pe_align pe_file_alignment pe_file_alignment, pe_file_alignment))
    , assert_true("file alignment rounds up", eq_nat(pe_align(pe_file_alignment, S pe_file_alignment), pe_header_size))
    , pe_test_error Nat "section RVA overflow" PeImageTooLarge (pe_advance pe_section_alignment pe_max_rva 1)
    , pe_test_unwind_vector("leaf unwind", PeLeaf, [] : List Nat, [1, 0, 0, 0] : List Nat)
    , pe_test_unwind_vector "saved registers unwind descending offsets"
        (PeCallFrame([X64Rbx, X64R12] : List X64Register, 40))
        ([83, 65, 84, 72, 129, 236, 40, 0, 0, 0] : List Nat)
        ([1, 10, 3, 0, 10, 66, 3, 192, 1, 48, 0, 0] : List Nat)
    , pe_test_unwind_vector "large allocation uses UWOP_ALLOC_LARGE"
        (PeCallFrame([] : List X64Register, 136))
        ([72, 129, 236, 136, 0, 0, 0] : List Nat) ([1, 7, 2, 0, 7, 1, 17, 0] : List Nat)
    , pe_test_unwind_vector "largest allocation before probing"
        (PeCallFrame([] : List X64Register, sub pe_section_alignment 8))
        ([72, 129, 236, 248, 15, 0, 0] : List Nat) ([1, 7, 2, 0, 7, 1, 255, 1] : List Nat)
    , pe_test_error PeUnwindInfo "frame requires probes" (PeStackProbeRequired 1)
        (pe_encode_frame(1, PeCallFrame([] : List X64Register, pe_section_alignment)))
    , pe_test_error PeUnwindInfo "unaligned frame rejected" (PeUnsupportedFrame 1)
        (pe_encode_frame(1, PeCallFrame([] : List X64Register, 32)))
    , pe_test_error PeUnwindInfo "insufficient shadow space rejected" (PeUnsupportedFrame 1)
        (pe_encode_frame(1, PeCallFrame([] : List X64Register, 24)))
    , pe_test_error PeUnwindInfo "volatile register unwind rejected" (PeUnsupportedFrame 1)
        (pe_encode_frame(1, PeCallFrame([X64Rax] : List X64Register, 32)))
    , pe_test_error PeUnwindInfo "duplicate register unwind rejected" (PeUnsupportedFrame 1)
        (pe_encode_frame(1, PeCallFrame([X64Rbx, X64Rbx] : List X64Register, 40)))
    , pe_test_bytes "relocation block groups page entries and pads odd count"
        (pe_encode_relocations ([add pe_section_alignment 8, add pe_section_alignment 24, add(mul 2 pe_section_alignment, 16)] : List Nat))
        ([0, 16, 0, 0, 12, 0, 0, 0, 8, 160, 24, 160,
          0, 32, 0, 0, 12, 0, 0, 0, 16, 160, 0, 0] : List Nat)
    , pe_test_bytes("empty relocation table", pe_encode_relocations ([] : List Nat), [] : List Nat)
    ];

def pe_test_import_checks : List Test :=
    let exit_imports : List PeImport := [pe_test_exit_import] in
    let other_import : PeImport := PeNamedImport(2, str_codes "Other") in
    [ pe_test_error PeImportTable "empty DLL name" PeInvalidName
        (pe_build_imports(pe_section_alignment, [PeImportLibrary([] : List Nat, exit_imports)] : List PeLibrary))
    , pe_test_error PeImportTable "NUL in imported symbol" PeInvalidName
        (pe_build_imports(pe_section_alignment, [pe_test_kernel32 ([PeNamedImport(1, [65, 0] : List Nat)] : List PeImport)] : List PeLibrary))
    , pe_test_error PeImportTable "non-ASCII imported symbol" PeInvalidName
        (pe_build_imports(pe_section_alignment, [pe_test_kernel32 ([PeNamedImport(1, [128] : List Nat)] : List PeImport)] : List PeLibrary))
    , pe_test_error PeImportTable "library needs an import" PeEmptyLibrary
        (pe_build_imports(pe_section_alignment, [pe_test_kernel32 ([] : List PeImport)] : List PeLibrary))
    , pe_test_error PeImportTable "DLL duplicates are case insensitive" PeDuplicateLibrary
        (pe_build_imports pe_section_alignment ([pe_test_kernel32 exit_imports,
          PeImportLibrary(str_codes "KERNEL32.DLL", [other_import] : List PeImport)] : List PeLibrary))
    , pe_test_error PeImportTable "duplicate imported name" (PeDuplicateImport 1)
        (pe_build_imports pe_section_alignment ([pe_test_kernel32 ([pe_test_exit_import,
          PeNamedImport(2, str_codes "ExitProcess")] : List PeImport)] : List PeLibrary))
    , pe_test_error PeImportTable "duplicate import ID across DLLs" (PeDuplicateImport 1)
        (pe_build_imports pe_section_alignment ([pe_test_kernel32 exit_imports,
          PeImportLibrary(str_codes "ntdll.dll", [PeNamedImport(1, str_codes "Other")] : List PeImport)] : List PeLibrary))
    , pe_test_error PeImportTable "import RVA arithmetic overflow" PeImageTooLarge
        (pe_build_imports(pe_max_rva, [pe_test_kernel32 exit_imports] : List PeLibrary))
    ];

inductive PeTestRejection : Type :=
  | PeRejectedProgram : String -> PeError -> PeProgram -> PeTestRejection;

def pe_test_program_rejections (program : PeProgram) : List PeTestRejection :=
    match program with
    | PeProgramParts text ro data symbols libraries fixups functions entry =>
      [ PeRejectedProgram "empty text" PeEmptyText
          (PeProgramParts ([] : List Nat) ro data symbols libraries fixups functions entry)
      , PeRejectedProgram "text byte overflow" (PeInvalidByte 256)
          (PeProgramParts (Cons Nat 256 text) ro data symbols libraries fixups functions entry)
      , PeRejectedProgram "read-only byte overflow" (PeInvalidByte 256)
          (PeProgramParts text ([256] : List Nat) data symbols libraries fixups functions entry)
      , PeRejectedProgram "writable byte overflow" (PeInvalidByte 256)
          (PeProgramParts text ro ([256] : List Nat) symbols libraries fixups functions entry)
      , PeRejectedProgram "duplicate symbol ID" (PeDuplicateSymbol 1)
          (PeProgramParts text ro data (Cons PeSymbol (PeNamedSymbol 1 PeText 0) symbols) libraries fixups functions entry)
      , PeRejectedProgram "symbol one past section end" (PeInvalidSymbol 2)
          (PeProgramParts text ro data (Cons PeSymbol (PeNamedSymbol 2 PeText (length Nat text)) symbols) libraries fixups functions entry)
      , PeRejectedProgram "symbol in writer-owned metadata" (PeInvalidSymbol 2)
          (PeProgramParts text ro data (Cons PeSymbol (PeNamedSymbol 2 PeImports 0) symbols) libraries fixups functions entry)
      , PeRejectedProgram "unknown entry symbol" (PeMissingEntry 99)
          (PeProgramParts text ro data symbols libraries fixups functions 99)
      , PeRejectedProgram "unmapped entry function" (PeMissingEntry 1)
          (PeProgramParts text ro data symbols libraries fixups ([] : List PeFunction) entry)
      , PeRejectedProgram "unknown image fixup symbol" (PeMissingSymbol 99)
          (PeProgramParts text ro data symbols libraries ([PeRel32 PeText 14 18 (PeSymbolTarget 99)] : List PeFixup) functions entry)
      , PeRejectedProgram "unknown IAT fixup" (PeMissingImport 99)
          (PeProgramParts text ro data symbols libraries ([PeRel32 PeText 14 18 (PeImportTarget 99)] : List PeFixup) functions entry)
      , PeRejectedProgram "fixup extends beyond section" (PeInvalidFixup 18)
          (PeProgramParts text ro data symbols libraries ([PeRva32 PeText 18 (PeSymbolTarget 1)] : List PeFixup) functions entry)
      , PeRejectedProgram "fixup origin before field end" (PeInvalidFixup 14)
          (PeProgramParts text ro data symbols libraries ([PeRel32 PeText 14 17 (PeImportTarget 1)] : List PeFixup) functions entry)
      , PeRejectedProgram "fixup origin beyond code" (PeInvalidFixup 14)
          (PeProgramParts text ro data symbols libraries ([PeRel32 PeText 14 21 (PeImportTarget 1)] : List PeFixup) functions entry)
      , PeRejectedProgram "fixup overwrites nonzero data" (PeNonzeroFixup 8)
          (PeProgramParts text ro data symbols libraries ([PeRva32 PeText 8 (PeSymbolTarget 1)] : List PeFixup) functions entry)
      , PeRejectedProgram "overlapping fixups" (PeUnorderedFixup 14)
          (PeProgramParts text ro data symbols libraries (append PeFixup fixups ([PeRva32 PeText 14 (PeSymbolTarget 1)] : List PeFixup)) functions entry)
      , PeRejectedProgram "backwards fixup retains nonzero slot diagnostic before ordering" (PeNonzeroFixup 8)
          (PeProgramParts text ro data symbols libraries (append PeFixup fixups ([PeRva32 PeText 8 (PeSymbolTarget 99)] : List PeFixup)) functions entry)
      , PeRejectedProgram "backwards fixup retains missing target diagnostic before ordering" (PeMissingSymbol 99)
          (PeProgramParts text ro data symbols libraries (append PeFixup fixups ([PeRva32 PeText 14 (PeSymbolTarget 99)] : List PeFixup)) functions entry)
      , PeRejectedProgram "backwards fixup retains origin diagnostic before target and ordering" (PeInvalidFixup 14)
          (PeProgramParts text ro data symbols libraries (append PeFixup fixups ([PeRel32 PeText 14 17 (PeSymbolTarget 99)] : List PeFixup)) functions entry)
      , PeRejectedProgram "fixups in reversed section order" (PeUnorderedFixup 14)
          (PeProgramParts text ro (pe_zeros 8) symbols libraries (Cons PeFixup (PeVa64 PeWritable 0 (PeSymbolTarget 1)) fixups) functions entry)
      , PeRejectedProgram "patches cannot rewrite import metadata" (PeInvalidFixup 0)
          (PeProgramParts text ro data symbols libraries ([PeRva32 PeImports 0 (PeSymbolTarget 1)] : List PeFixup) functions entry)
      , PeRejectedProgram "unwind differs from actual prolog" (PePrologMismatch 1)
          (PeProgramParts text ro data symbols libraries fixups
            ([PeCodeFunction(1, 20, str_codes "entry", PeCallFrame([] : List X64Register, 56))] : List PeFunction) entry)
      , PeRejectedProgram "function body cannot be empty" (PeInvalidFunction 1)
          (PeProgramParts text ro data symbols libraries fixups
            ([PeCodeFunction 1 0 (str_codes "entry") PeLeaf] : List PeFunction) entry)
      , PeRejectedProgram "function extends beyond code" (PeInvalidFunction 1)
          (PeProgramParts text ro data symbols libraries fixups
            ([PeCodeFunction 1 21 (str_codes "entry") PeLeaf] : List PeFunction) entry)
      , PeRejectedProgram "overlapping function ranges" (PeUnorderedFunction 1)
          (PeProgramParts text ro data symbols libraries fixups (append PeFunction functions functions) entry)
      , PeRejectedProgram "function-map byte overflow" (PeInvalidByte 256)
          (PeProgramParts text ro data symbols libraries fixups
            ([PeCodeFunction(1, 20, [256] : List Nat, PeCallFrame([] : List X64Register, 40))] : List PeFunction) entry)
      ]
    end;

def pe_test_rejection (test : PeTestRejection) : Test :=
    match test with | PeRejectedProgram name expected program => pe_test_error PeImage name expected (pe_write_image program) end;

def pe_test_address_map (addresses : List PeFunctionAddress) : Bool :=
    match addresses with
    | Nil => False
    | Cons address rest =>
      match address with
      | PeFunctionAt name start end_rva label =>
        andb (eq_nat name 1) (andb (eq_nat start pe_section_alignment)
          (andb (eq_nat(end_rva, add pe_section_alignment 20))
            (andb(pe_bytes_equal(label, str_codes "entry"), eq_nat(length PeFunctionAddress rest, 0)))))
      end
    end;

-- The previous complete input-layout composition is an independent oracle
-- for the split entry points, including the original validation order.
def pe_test_reference_input_layout (text : List Nat) (read_only : List Nat) (writable : List Nat) : Either PeError PeLayout :=
    match text with
    | Nil => Left PeError PeLayout PeEmptyText
    | Cons _ _ =>
      match pe_check_bytes text with
      | Left err => Left PeError PeLayout err
      | Right _ =>
        match pe_check_bytes read_only with
        | Left err => Left PeError PeLayout err
        | Right _ =>
          match pe_check_bytes writable with
          | Left err => Left PeError PeLayout err
          | Right _ =>
            match pe_place_section pe_layout_empty PeText text with
            | Left err => Left PeError PeLayout err
            | Right text_layout =>
              match pe_place_section text_layout PeReadOnly read_only with
              | Left err => Left PeError PeLayout err
              | Right data_layout => pe_place_section data_layout PeWritable writable
              end
            end
          end
        end
      end
    end;

def pe_test_placed_equal (left : PePlacedSection) (right : PePlacedSection) : Bool :=
    match left, right with
    | PeSectionAt kind rva raw size bytes, PeSectionAt other more_rva more_raw more_size more_bytes =>
      andb (pe_section_equal kind other) (andb (eq_nat rva more_rva) (andb (eq_nat raw more_raw)
        (andb(eq_nat size more_size, pe_bytes_equal bytes more_bytes)))) end;

def pe_test_input_layout_equal (text : List Nat) (ro : List Nat) (rw : List Nat) : Bool :=
    match pe_input_layout text ro rw, pe_test_reference_input_layout text ro rw with
    | Right left, Right right => match left, right with
      | PeLayoutAt rva raw sections, PeLayoutAt more_rva more_raw more_sections =>
        andb (eq_nat rva more_rva) (andb (eq_nat raw more_raw)
          (andb (eq_nat(length PePlacedSection sections, length PePlacedSection more_sections))
            (foldr (Pair PePlacedSection PePlacedSection) Bool
              (fun (pair : Pair PePlacedSection PePlacedSection) (rest : Bool) => match pair with
                | MkPair a b => andb(pe_test_placed_equal a b, rest) end) True
              (zip PePlacedSection PePlacedSection sections more_sections)))) end
    | Left _, Right _ => False | Right _, Left _ => False | Left _, Left _ => False end;

def pe_test_input_phase_checks : List Test :=
    [ assert_true "split input retains empty data section layout"
        (pe_test_input_layout_equal([195], [] : List Nat, [] : List Nat))
    , assert_true "split input retains every section byte and address"
        (pe_test_input_layout_equal [72,131,236,40,195] [0,255,13] [1,0,2])
    , assert_true "split input retains layout across validation chunk boundary"
        (pe_test_input_layout_equal(append Nat (pe_zeros (S (mul 4 256))) [195], [255], pe_zeros 257))
    , pe_test_error Unit "empty text precedes invalid data in input validation" PeEmptyText
        (pe_validate_input ([] : List Nat) [257] [258])
    , pe_test_error Unit "invalid text precedes both invalid data inputs" (PeInvalidByte 256)
        (pe_validate_input [256] [257] [258])
    , pe_test_error Unit "invalid read-only input precedes invalid writable input" (PeInvalidByte 257)
        (pe_validate_input [195] [257] [258])
    , pe_test_error Unit "invalid writable input retains its byte" (PeInvalidByte 258)
        (pe_validate_input [195] [0] [258])
    , pe_test_error Unit "input validation retains first invalid byte after a full chunk" (PeInvalidByte 256)
        (pe_validate_input(append Nat (pe_zeros (mul 4 256)) [256,257], [] : List Nat, [] : List Nat))
    ];

-- The raw planner accepts explicit section lists. Cache lookup must retain
-- the first duplicate and measure actual bytes, including empty sections.
def pe_test_size_patch_text (patch : PePatch) : String :=
    match patch with | PePatchAt kind offset bytes absolute => str_join "|"
      ([str_of_nat (pe_section_code kind), str_of_nat offset,
        match absolute with | False => "0" | True => "1" end, pe_test_byte_text bytes] : List String) end;

def pe_test_size_patches (name : String) (result : Either PeError (List PePatch))
    (expected : List PePatch) : Test :=
    match result with
    | Left error => test_fail(name, pe_test_error_text error)
    | Right actual => assert_eq name
        (str_join(";", map PePatch String pe_test_size_patch_text actual))
        (str_join(";", map PePatch String pe_test_size_patch_text expected)) end;

def pe_test_size_cache_checks : List Test :=
    let text : PePlacedSection := PeSectionAt PeText pe_section_alignment pe_header_size pe_file_alignment (pe_zeros 8) in
    let empty : PePlacedSection := PeSectionAt PeText 0 0 pe_file_alignment ([] : List Nat) in
    let short : PePlacedSection := PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 3) in
    let read : PePlacedSection := PeSectionAt PeReadOnly (mul 2 pe_section_alignment) 0 pe_file_alignment (pe_zeros 4) in
    let empty_read : PePlacedSection := PeSectionAt PeReadOnly 0 0 pe_file_alignment ([] : List Nat) in
    let sections : List PePlacedSection := [text, read] in
    let symbols : List PeSymbol := [PeNamedSymbol 1 PeText 0, PeNamedSymbol 2 PeReadOnly 0, PeNamedSymbol 3 PeText 8] in
    let imports : List (Pair Nat Nat) := [] in
    let first : PeFixup := PeRva32 PeText 0 (PeSymbolTarget 1) in
    let later : PeFixup := PeRva32 PeText 4 (PeSymbolTarget 1) in
    let origin_zero : List PePlacedSection := [PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 8)] in
    let import_zero : List (Pair Nat Nat) := [MkPair Nat Nat 7 0] in
    [ pe_test_size_patches "PE size cache accepts empty plan without sections"
        (pe_plan_fixups([] : List PePlacedSection, symbols, imports, [] : List PeFixup)) ([] : List PePatch)
    , pe_test_error (List PePatch) "PE size cache retains first empty duplicate source" (PeInvalidFixup 0)
        (pe_plan_fixups [empty, text] symbols imports [first])
    , pe_test_error (List PePatch) "PE size cache ignores padded size of first short source" (PeInvalidFixup 0)
        (pe_plan_fixups [short, text] symbols imports [first])
    , pe_test_size_patches "PE size cache retains first valid duplicate source"
        (pe_plan_fixups [text, empty] symbols imports [first]) [PePatchAt PeText 0 (pe_le32 pe_section_alignment) False]
    , pe_test_error (List PePatch) "PE size cache retains first empty duplicate target" (PeInvalidSymbol 2)
        (pe_plan_fixups [text, empty_read, read] symbols imports [PeRva32 PeText 0 (PeSymbolTarget 2)])
    , pe_test_size_patches "PE size cache retains first valid duplicate target RVA"
        (pe_plan_fixups [text, read, empty_read] symbols imports [PeRva32 PeText 0 (PeSymbolTarget 2)])
        [PePatchAt PeText 0 (pe_le32 (mul 2 pe_section_alignment)) False]
    , pe_test_error Nat "PE symbol lookup still excludes padded bytes" (PeInvalidSymbol 3)
        (pe_symbol_rva sections symbols 3)
    , assert_true "PE raw bounds retain zero width at actual section end"
        (match pe_patch_bounds sections PeText 8 0 with | Left _ => False | Right section => pe_test_placed_equal section text end)
    , assert_true "PE raw bounds retain zero width in an empty section"
        (match pe_patch_bounds [empty, text] PeText 0 0 with | Left _ => False | Right section => pe_test_placed_equal section empty end)
    , pe_test_error PePlacedSection "PE raw bounds reject zero width after actual section end" (PeInvalidFixup 9)
        (pe_patch_bounds sections PeText 9 0)
    , pe_test_error (List PePatch) "PE size cache rejects a field crossing actual byte end" (PeInvalidFixup 6)
        (pe_plan_fixups sections symbols imports [PeRva32 PeText 6 (PeSymbolTarget 99)])
    , pe_test_error (List PePatch) "PE size cache keeps nonzero slot before origin target and order" (PeNonzeroFixup 0)
        (pe_plan_fixups [PeSectionAt PeText pe_section_alignment 0 pe_file_alignment (Cons Nat 1 (pe_zeros 7))]
          symbols imports [later, PeRel32 PeText 0 3 (PeSymbolTarget 99)])
    , pe_test_error (List PePatch) "PE size cache keeps relative origin before target and order" (PeInvalidFixup 0)
        (pe_plan_fixups sections symbols imports [later, PeRel32 PeText 0 3 (PeSymbolTarget 99)])
    , pe_test_error (List PePatch) "PE size cache keeps missing target before order" (PeMissingSymbol 99)
        (pe_plan_fixups sections symbols imports [later, PeRva32 PeText 0 (PeSymbolTarget 99)])
    , pe_test_size_patches "PE size cache encodes the positive signed Rel32 maximum"
        (pe_plan_fixups origin_zero symbols [MkPair Nat Nat 7 (add pe_max_rva 4)] [PeRel32 PeText 0 4 (PeImportTarget 7)])
        [PePatchAt PeText 0 [255,255,255,127] False]
    , pe_test_error (List PePatch) "PE size cache rejects positive signed Rel32 overflow" (PeRelativeOverflow 0)
        (pe_plan_fixups origin_zero symbols [MkPair Nat Nat 7 (add pe_max_rva 5)] [PeRel32 PeText 0 4 (PeImportTarget 7)])
    , pe_test_size_patches "PE size cache encodes the negative signed Rel32 maximum"
        (pe_plan_fixups [PeSectionAt PeText (sub pe_max_rva 3) 0 pe_file_alignment (pe_zeros 8)]
          symbols import_zero [PeRel32 PeText 0 4 (PeImportTarget 7)]) [PePatchAt PeText 0 [0,0,0,128] False]
    , pe_test_error (List PePatch) "PE size cache rejects negative signed Rel32 overflow" (PeRelativeOverflow 0)
        (pe_plan_fixups [PeSectionAt PeText (sub pe_max_rva 2) 0 pe_file_alignment (pe_zeros 8)]
          symbols import_zero [PeRel32 PeText 0 4 (PeImportTarget 7)])
    ];

-- The single-fixup owner retains its linear symbol lookup. Comparing it
-- with a singleton bulk plan covers the indexed path without a second resolver.
def pe_test_symbol_single_parity (name : String) (sections : List PePlacedSection)
    (symbols : List PeSymbol) (imports : List (Pair Nat Nat)) (fixup : PeFixup) : Test :=
    match pe_plan_fixup sections symbols imports fixup with
    | Left error => pe_test_error (List PePatch) name error
        (pe_plan_fixups sections symbols imports [fixup])
    | Right patch => pe_test_size_patches name
        (pe_plan_fixups sections symbols imports [fixup]) [patch]
    end;

def pe_test_symbol_index_checks : List Test :=
    let text : PePlacedSection := PeSectionAt PeText pe_section_alignment 0 64 (pe_zeros 64) in
    let read : PePlacedSection := PeSectionAt PeReadOnly (mul 2 pe_section_alignment) 0 32 (pe_zeros 32) in
    let write : PePlacedSection := PeSectionAt PeWritable (mul 3 pe_section_alignment) 0 32 (pe_zeros 32) in
    let sections : List PePlacedSection := [text, read, write] in
    let symbols : List PeSymbol :=
      [PeNamedSymbol 90 PeText 0, PeNamedSymbol 30 PeReadOnly 7, PeNamedSymbol 70 PeWritable 8,
       PeNamedSymbol 20 PeText 12, PeNamedSymbol 40 PeReadOnly 9, PeNamedSymbol 10 PeText 16,
       PeNamedSymbol 80 PeText 20, PeNamedSymbol 60 PeText 24, PeNamedSymbol 50 PeText 28] in
    let imports : List (Pair Nat Nat) := [MkPair Nat Nat 7 123, MkPair Nat Nat 7 456] in
    let valid_first : List PeSymbol := append PeSymbol symbols [PeNamedSymbol 30 PeImports 0] in
    let invalid_first : List PeSymbol := Cons PeSymbol (PeNamedSymbol 30 PeImports 0) symbols in
    let known : PeFixup := PeRva32 PeText 0 (PeSymbolTarget 30) in
    let later : PeFixup := PeRva32 PeText 8 (PeSymbolTarget 90) in
    [ pe_test_size_patches "PE symbol index preserves full mixed target patch payloads"
        (pe_plan_fixups sections valid_first imports
          [known, PeRel32 PeText 4 8 (PeSymbolTarget 70), PeVa64 PeText 8 (PeSymbolTarget 30)])
        [PePatchAt PeText 0 (pe_le32 (add(mul 2 pe_section_alignment, 7))) False,
         PePatchAt PeText 4 (pe_le32 (mul 2 pe_section_alignment)) False,
         PePatchAt PeText 8 (pe_va64 (add(mul 2 pe_section_alignment, 7))) True]
    , pe_test_symbol_single_parity "PE symbol index retains first valid duplicate"
        sections valid_first imports known
    , pe_test_symbol_single_parity "PE symbol index retains first invalid duplicate"
        sections invalid_first imports known
    , pe_test_symbol_single_parity "PE symbol index retains missing symbol detail"
        sections symbols imports (PeRva32 PeText 0 (PeSymbolTarget 99))
    , pe_test_symbol_single_parity "PE symbol index rejects missing target section"
        [text] symbols imports known
    , pe_test_symbol_single_parity "PE symbol index rejects target at actual byte end"
        sections [PeNamedSymbol 30 PeText 64] imports known
    , pe_test_symbol_single_parity "PE symbol index rejects oversized target offset"
        sections [PeNamedSymbol 30 PeText (S pe_max_rva)] imports known
    , pe_test_symbol_single_parity "PE symbol index leaves first duplicate import lookup unchanged"
        sections invalid_first imports (PeRva32 PeText 0 (PeImportTarget 7))
    , pe_test_symbol_single_parity "PE symbol index leaves missing import detail unchanged"
        sections symbols imports (PeVa64 PeText 0 (PeImportTarget 99))
    , pe_test_symbol_single_parity "PE symbol index keeps relative origin before missing target"
        sections symbols imports (PeRel32 PeText 0 3 (PeSymbolTarget 99))
    , pe_test_symbol_single_parity "PE symbol index keeps slot bounds before missing target"
        sections symbols imports (PeVa64 PeText 60 (PeSymbolTarget 99))
    , pe_test_symbol_single_parity "PE symbol index keeps nonzero slot before invalid symbol"
        [PeSectionAt PeText pe_section_alignment 0 64 (Cons Nat 1 (pe_zeros 63))]
        invalid_first imports known
    , pe_test_error (List PePatch) "PE symbol index keeps missing target before ordering"
        (PeMissingSymbol 99) (pe_plan_fixups sections symbols imports
          [later, PeRva32 PeText 0 (PeSymbolTarget 99)])
    , pe_test_error (List PePatch) "PE symbol index keeps invalid first duplicate before ordering"
        (PeInvalidSymbol 30) (pe_plan_fixups sections invalid_first imports [later, known])
    , pe_test_error (List PePatch) "PE symbol index keeps nonzero slot before origin target and ordering"
        (PeNonzeroFixup 0) (pe_plan_fixups
          [PeSectionAt PeText pe_section_alignment 0 64 (Cons Nat 1 (pe_zeros 63))]
          symbols imports [later, PeRel32 PeText 0 3 (PeSymbolTarget 99)])
    , pe_test_error (List PePatch) "PE symbol index still rejects backwards valid patches"
        (PeUnorderedFixup 0) (pe_plan_fixups sections symbols imports [later, known])
    , pe_test_size_patches "PE symbol index does not validate an unused malformed symbol"
        (pe_plan_fixups sections (Cons PeSymbol (PeNamedSymbol 99 PeImports 0) symbols)
          imports [known]) [PePatchAt PeText 0 (pe_le32 (add(mul 2 pe_section_alignment, 7))) False]
    , pe_test_error Unit "whole symbol validation still rejects duplicates"
        (PeDuplicateSymbol 30) (pe_validate_symbols sections valid_first)
    , pe_test_error Unit "whole symbol validation still rejects unused malformed symbols"
        (PeInvalidSymbol 99) (pe_validate_symbols sections
          (Cons PeSymbol (PeNamedSymbol 99 PeImports 0) symbols))
    , pe_test_size_patches "empty fixup plan retains no symbol-validation side effect"
        (pe_plan_fixups [] invalid_first [] []) []
    ];

def pe_test_run : IO Unit :=
    match pe_test_exit_program ([] : List X64Register) 40 42 with
    | Left err => test_run ([test_fail("reference fixture encoding", pe_test_error_text err)] : List Test)
    | Right program =>
      match pe_write_image program with
      | Left err => test_run ([test_fail("reference image creation", pe_test_error_text err)] : List Test)
      | Right image =>
        match image with
        | PeImageFile bytes addresses =>
          test_run (append Test (append(Test, append(Test, append Test pe_test_byte_step_checks pe_test_symbol_index_checks, append Test pe_test_size_cache_checks pe_test_input_phase_checks), pe_test_header_checks bytes))
            (append Test pe_test_cursor_checks (append Test pe_test_function_cursor_checks (Cons Test pe_test_function_cursor_scale (append Test pe_test_table_checks (append Test pe_test_import_checks
              (Cons Test (assert_true("returned function-address map", pe_test_address_map addresses))
                (map PeTestRejection Test pe_test_rejection (pe_test_program_rejections program)))))))))
        end
      end
    end;

def pe_test_emit (name : String) : IO Unit :=
    match pe_test_fixture name with
    | Nothing => do eprintln "unknown PE fixture"; exit 2
    | Just program =>
      match pe_test_image program with
      | Left err => do eprintln (str_concat("PE_ERROR ", pe_test_error_text err)); exit 1
      | Right image => match image with | PeImageFile bytes _ => println (pe_test_byte_text bytes) end
      end
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match eq_nat(length String arguments, 1) with
       | True => pe_test_run
       | False =>
         match andb(eq_nat(length String arguments, 3), str_eq(nth String "" 1 arguments, "--image")) with
         | True => pe_test_emit (nth String "" 2 arguments)
         | False => do eprintln "usage: native_pe_tests [--image NAME]"; exit 2
         end
       end
