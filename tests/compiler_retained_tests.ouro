-- Retained kernel acceptance, conversion and termination laws.
-- A negative law requires its exact typed failure, phase and declaration ID.
-- Resource exhaustion, unsupported input and cancellation never count as it.

import "compiler_retained_fixtures.ouro",
  "../compiler/file_elab.ouro",
  "../std/io.ouro",
  "compiler_core_test_decls.ouro",
  "compiler_test_phase.ouro";

inductive RetainedLaw : Type :=
  | MkRetainedLaw : String -> Bool -> String -> RetainedLaw;

def retained_fuel : Nat := mul 50 40;

def retained_nat_label (prefix : String) (value : Nat) : String :=
    prim_string_concat(prefix, prim_string_of_nat value);

def retained_normal_fault (fault : NormalizeFault) : String :=
    match fault with
    | NormalizeNonFunction => "non-function"
    | NormalizeCaseBranchCount => "case-branch-count"
    | NormalizeCaseScrutinee => "case-scrutinee"
    | NormalizeCaseInductive => "case-inductive"
    | NormalizeCaseParameters => "case-parameters"
    | NormalizeCaseConstructor => "case-constructor"
    | NormalizeCaseArguments => "case-arguments"
    | NormalizeFixArgument => "fix-argument"
    | NormalizeFixArity => "fix-arity"
    | NormalizeUnreducedHead => "unreduced-head"
    | NormalizeStringBytes => "string-bytes"
    | NormalizeStringArguments => "string-arguments"
    | NormalizeUnresolvedLiteral => "unresolved-literal"
    | NormalizeStringType => "string-type"
    end;

def retained_failure (failure : CheckFailure) : String :=
    match failure with
    | CheckTypeFailure fault =>
        match fault with
        | CheckTypeMismatch => "type-mismatch"
        | CheckExpectedSort => "expected-sort"
        | CheckExpectedFunction => "expected-function"
        | CheckCaseMotive => "case-motive"
        | CheckNonPositive => "non-positive"
        | CheckNonTerminating => "non-terminating"
        | CheckUniverseBound => "universe-bound"
        end
    | CheckMalformedCore fault =>
        match fault with
        | CheckUnboundVariable index => retained_nat_label "unbound-variable=" index
        | CheckUnboundGlobal name => retained_nat_label "unbound-global=" name
        | CheckUnknownInductive name => retained_nat_label "unknown-inductive=" name
        | CheckUnknownConstructor name index =>
            prim_string_concat (retained_nat_label "unknown-constructor=" name)
              (retained_nat_label "/" index)
        | CheckConstructorParameters => "constructor-parameters"
        | CheckCaseMetadata => "case-metadata"
        | CheckFixMetadata => "fix-metadata"
        | CheckLiteralType name => retained_nat_label "literal-type=" name
        | CheckUnresolvedLiteral literal => retained_nat_label "unresolved-literal=" literal
        | CheckDuplicateName name => retained_nat_label "duplicate-name=" name
        end
    | CheckReductionFailure fault =>
        prim_string_concat("reduction/", retained_normal_fault fault)
    | CheckResourceLimit => "resource-limit"
    | CheckUnsupported detail => retained_nat_label "unsupported=" detail
    | CheckCancelled => "cancelled"
    | CheckInternalFailure detail => retained_nat_label "internal=" detail
    | CheckPrimitiveFailure _ => "primitive-declaration"
    end;

def retained_error_label (name : Nat) (phase : CheckPhase) (failure : CheckFailure)
    : String :=
    prim_string_concat (retained_nat_label "decl=" name)
      (prim_string_concat (prim_string_concat("/", compiler_test_phase_name phase))
        (prim_string_concat("/", retained_failure failure)));

def retained_declaration_status (result : DeclarationResult) : String :=
    match result with
    | DeclarationsOk _ => "accepted"
    | DeclarationsErr name phase failure => retained_error_label name phase failure
    end;

def retained_exact (items : List FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking retained_fuel items;

def retained_accept (name : String) (items : List FileItem) : RetainedLaw :=
    let result : DeclarationResult := retained_exact items in
    MkRetainedLaw name
      (match result with | DeclarationsOk _ => True | DeclarationsErr _ _ _ => False end)
      (retained_declaration_status result);

def retained_reject (name : String) (declaration : Nat) (phase : CheckPhase)
    (failure : CheckFailure) (items : List FileItem) : RetainedLaw :=
    let result : DeclarationResult := retained_exact items in
    let expected : String := retained_error_label declaration phase failure in
    let actual : String := retained_declaration_status result in
    MkRetainedLaw name (prim_string_eq expected actual)
      (prim_string_concat(actual, prim_string_concat "; expected " expected));

def retained_check_ok (A : Type) (name : String) (result : CheckResult A) : RetainedLaw :=
    MkRetainedLaw name
      (match result with | CheckOk _ => True | CheckErr _ => False end)
      (match result with | CheckOk _ => "checked" | CheckErr failure => retained_failure failure end);

def retained_check_error (A : Type) (name : String) (failure : CheckFailure)
    (result : CheckResult A) : RetainedLaw :=
    let expected : String := retained_failure failure in
    let actual : String :=
      match result with | CheckOk _ => "checked" | CheckErr error => retained_failure error end in
    MkRetainedLaw name (prim_string_eq expected actual)
      (prim_string_concat(actual, prim_string_concat "; expected " expected));

def retained_normal_status (A : Type) (result : NormalizeResult A) : String :=
    match result with
    | Normalized _ => "normalized"
    | NormalizeExhausted => "exhausted"
    | NormalizeMalformed fault => prim_string_concat("malformed/", retained_normal_fault fault)
    end;

def retained_normal (name : String) (expected : CoreTerm)
    (result : NormalizeResult CoreTerm) : RetainedLaw :=
    MkRetainedLaw name
      (match result with
       | Normalized actual => eqTerm retained_fuel expected actual
       | NormalizeExhausted => False
       | NormalizeMalformed _ => False
       end) (retained_normal_status CoreTerm result);

def retained_convert (name : String) (expected : Bool)
    (result : NormalizeResult Bool) : RetainedLaw :=
    MkRetainedLaw name
      (match result with
       | Normalized actual => match expected with | True => actual | False => notb actual end
       | NormalizeExhausted => False
       | NormalizeMalformed _ => False
       end)
      (match result with
       | Normalized actual => match actual with | True => "convertible" | False => "not-convertible" end
       | NormalizeExhausted => "exhausted"
       | NormalizeMalformed fault => retained_normal_fault fault
       end);

def retained_normal_in (name : String) (items : List FileItem)
    (term : CoreTerm) (expected : CoreTerm) : RetainedLaw :=
    match retained_exact items with
    | DeclarationsOk sig => retained_normal name expected (normalize_checked retained_fuel sig term)
    | DeclarationsErr id phase failure => MkRetainedLaw name False (retained_error_label id phase failure)
    end;

def retained_convert_in (name : String) (items : List FileItem)
    (left : CoreTerm) (right : CoreTerm) : RetainedLaw :=
    match retained_exact items with
    | DeclarationsOk sig => retained_convert name True (conv_checked retained_fuel sig left right)
    | DeclarationsErr id phase failure => MkRetainedLaw name False (retained_error_label id phase failure)
    end;

def retained_dependent_check : RetainedLaw :=
    match retained_exact retained_dependent_items with
    | DeclarationsOk sig =>
        retained_check_ok Unit "case_branch_lambda_lift_under_binder/check"
          (check_term_checked retained_fuel sig (Nil CoreTerm)
            retained_dependent_body retained_dependent_type)
    | DeclarationsErr id phase failure =>
        MkRetainedLaw "case_branch_lambda_lift_under_binder/check" False
          (retained_error_label id phase failure)
    end;

-- These 21 declaration laws retain every representable JSON case. The two
-- primitive-evaluation cases need a literal pool and a declared builtin table;
-- bad_binder, unmarked_axiom and wrong_schema_kind test the old JSON transport.
def retained_corpus_laws : List RetainedLaw :=
    [ retained_accept("nat_id", retained_nat_items retained_identity)
    , retained_accept("bool_case", retained_nat_bool_items retained_bool_case)
    , retained_accept "case_branch_lambda_lift_under_binder" retained_dependent_items
    , retained_dependent_check
    , retained_accept "nested_case_same_constructor_fields" retained_nested_pair_items
    , retained_normal_in "nested_case_same_constructor_fields/normalize"
        retained_nested_pair_items (CConst 90) retained_two
    , retained_accept "fix_binder_name_not_in_conversion" retained_copy_items
    , retained_convert_in "fix_binder_name_not_in_conversion/constant-aliases"
        retained_copy_items (CConst 90) (CConst 91)
    , retained_convert_in "fix_binder_name_not_in_conversion/raw-fix"
        retained_copy_items (retained_copy 50) (retained_copy 52)
    , retained_normal_in "copy preserves two successors"
        retained_copy_items (CApp(CConst 90, retained_two)) retained_two
    , retained_accept "parameterized_box" [FInd retained_box_decl]
    , retained_accept "parameterized_recursive_sequence" [FInd retained_sequence_decl]
    , retained_accept "string_literal_intrinsic"
        [FIntrinsic(80, CSort 0, [111, 117, 114, 111, 46, 115, 116, 114, 105, 110, 103] : List Nat, Nothing CoreTerm),
         FDef(90, CConst 80, CStrBytes([104, 101, 108, 108, 111] : List Nat, 80))]
    , retained_reject "string_literal_axiom" 90 CheckDeclarationBody
        (CheckMalformedCore (CheckLiteralType 80))
        [FAxiom(80, CSort 0), FDef(90, CConst 80, CStrBytes([104, 101, 108, 108, 111] : List Nat, 80))]
    , retained_reject "wrong_body_type" 90 CheckDeclarationBody
        (CheckTypeFailure CheckTypeMismatch)
        [FInd retained_nat_zero_decl,
         FInd (MkIndDecl(20, Nil Param, Nil CoreTerm, 0, [MkCtor 21 retained_bool] : List Ctor)),
         FDef 90 retained_nat retained_true]
    , retained_reject "constructor_index_out_of_range" 90 CheckDeclarationBody
        (CheckMalformedCore (CheckUnknownConstructor 10 5))
        [FInd retained_nat_zero_decl, FDef 90 retained_nat (CConstruct 10 5 0)]
    , retained_reject "fix_recarg_out_of_range" 90 CheckDeclarationBody
        (CheckMalformedCore CheckFixMetadata)
        [FInd retained_nat_zero_decl, FDef 90 retained_nat_fn
          (CFix 50 1 1 retained_nat_fn (CLam(retained_nat, CRel 0)))]
    , retained_reject "forward_reference_constant" 90 CheckDeclarationType
        (CheckMalformedCore (CheckUnboundGlobal 91))
        [FAxiom(80, CSort 0), FAxiom(90, CConst 91), FAxiom(91, CSort 0)]
    , retained_reject "substitution_name_capture_open_let" 90 CheckDeclarationBody
        (CheckMalformedCore (CheckUnboundVariable 1))
        (retained_nat_items (FDef 90 retained_nat
          (CLetIn retained_zero retained_nat (CRel 1))))
    , retained_reject "malformed_case_branch_count" 90 CheckDeclarationBody
        (CheckMalformedCore CheckCaseMetadata)
        [FInd retained_nat_zero_decl, FDef 90 retained_nat retained_bad_case_shape]
    , retained_reject "invalid_eliminator_coverage" 90 CheckDeclarationBody
        (CheckMalformedCore CheckCaseMetadata)
        [FInd retained_nat_zero_decl, FInd checker_test_bool_decl,
         FDef 90 (CPi retained_bool retained_nat) retained_bad_coverage]
    , retained_reject "malformed_environment_duplicate_global" 80 CheckDeclarationPlan
        (CheckMalformedCore (CheckDuplicateName 80))
        [FAxiom(80, CSort 0), FAxiom(80, CSort 0)]
    , retained_reject "constructor_universe_above_inductive" 60 CheckInductiveDeclaration
        (CheckTypeFailure CheckUniverseBound) [FInd (retained_universe_decl 0 0)]
    , retained_reject "nonpositive_constructor" 60 CheckInductiveDeclaration
        (CheckTypeFailure CheckNonPositive) [FInd retained_negative_decl]
    , retained_reject "nested_negative_inductive_argument" 73 CheckInductiveDeclaration
        (CheckTypeFailure CheckNonPositive)
        [FInd checker_test_negative_wrapper, FInd checker_test_nested_negative]
    , retained_reject "inductive_parameter_self_reference" 60 CheckInductiveDeclaration
        (CheckMalformedCore (CheckUnknownInductive 60)) [FInd retained_parameter_self]
    , retained_reject "invalid_constructor_return" 60 CheckInductiveDeclaration
        (CheckTypeFailure CheckNonPositive) [FInd retained_bad_return]
    ];

def retained_stuck_case (parameters : Nat) (arity : Nat) : CoreTerm :=
    CCase (MkCaseInfo 60 parameters ([arity] : List Nat))
      (CSort 0) (CRel 0) ([CRel 1] : List CoreTerm);

def retained_type_identity : CoreTerm := CPi(CSort 0, CSort 0);

def retained_ml_laws : List RetainedLaw :=
    [ retained_check_error Unit "ML eta-short case branch rejects recursive escape"
        (CheckTypeFailure CheckNonTerminating)
        (check_termination_checked 0 1 retained_fuel
          (CLam (CSort 0) (CCase (MkCaseInfo 60 0 ([1] : List Nat))
            (CSort 0) (CRel 0) ([CRel 1] : List CoreTerm))))
    , retained_check_error Unit "ML case branch annotation cannot capture recursion"
        (CheckTypeFailure CheckNonTerminating)
        (check_termination_checked 0 1 retained_fuel
          (CLam (CSort 0) (CCase (MkCaseInfo 60 0 ([1] : List Nat))
            (CSort 0) (CRel 0) ([CLam(CRel 1, CRel 0)] : List CoreTerm))))
    , retained_convert "ML stuck fix spines distinguish arguments" False
        (conv_checked retained_fuel (Nil Entry)
          (CApp(retained_copy 50, CRel 0)) (CApp(retained_copy 50, CRel 1)))
    , retained_convert "ML stuck case distinguishes parameter metadata" False
        (conv_checked(retained_fuel, Nil Entry, retained_stuck_case 0 0, retained_stuck_case 1 0))
    , retained_convert "ML stuck case distinguishes constructor arity" False
        (conv_checked(retained_fuel, Nil Entry, retained_stuck_case 0 0, retained_stuck_case 0 1))
    , retained_convert "ML captured fix type participates in conversion" False
        (conv_checked retained_fuel (Nil Entry)
          (retained_let_fix (CPi(CSort 0, CSort 0)))
          (retained_let_fix (CPi(CSort 1, CSort 1))))
    , retained_normal "ML let-bound fix reifies its type environment"
        (CFix 50 0 1 retained_type_identity (CLam(CSort 0, CRel 0)))
        (normalize_checked(retained_fuel, Nil Entry, retained_let_fix retained_type_identity))
    , retained_convert "ML non-function eta stays false" False
        (conv_checked(retained_fuel, Nil Entry, CLam(CSort 0, CRel 0), CSort 0))
    , retained_reject "ML universe ceiling level 1" 60 CheckInductiveDeclaration
        (CheckTypeFailure CheckUniverseBound) [FInd (retained_universe_decl 1 1)]
    , retained_reject "ML universe ceiling level 2" 60 CheckInductiveDeclaration
        (CheckTypeFailure CheckUniverseBound) [FInd (retained_universe_decl 2 2)]
    , retained_accept "ML universe ceiling admits level 1" [FInd (retained_universe_decl 1 0)]
    , retained_accept "ML universe ceiling admits level 2" [FInd (retained_universe_decl 2 1)]
    , retained_accept "ML universe ceiling admits level 3" [FInd (retained_universe_decl 3 2)]
    , retained_accept "local type alias enters a checked lambda annotation"
        [FDef 90 retained_type_identity compiler_test_type_alias]
    , retained_check_ok Unit "local type alias direct checking"
        (check_term_checked retained_fuel (Nil Entry) (Nil CoreTerm)
          compiler_test_type_alias retained_type_identity)
    , retained_check_ok CoreTerm "local type alias inference"
        (infer_checked(retained_fuel, Nil Entry, Nil CoreTerm, IGTerm compiler_test_type_alias))
    ];

def retained_nested_accept (name : String) (term : CoreTerm) : RetainedLaw :=
    retained_accept(name, retained_nat_items (FDef 90 retained_nat_fn term));

def retained_nested_reject (name : String) (term : CoreTerm) : RetainedLaw :=
    retained_reject name 90 CheckDeclarationBody (CheckTypeFailure CheckNonTerminating)
      (retained_nat_items (FDef 90 retained_nat_fn term));

def retained_nested_normal (name : String) (term : CoreTerm) : RetainedLaw :=
    retained_normal_in name (retained_nat_items (FDef 90 retained_nat_fn term))
      (CApp(CConst 90, retained_two)) retained_two;

def retained_nested_laws : List RetainedLaw :=
    [ retained_nested_accept "nested strict descent" retained_nested_strict
    , retained_nested_accept "nested nonzero recursive argument" retained_nested_nonzero
    , retained_nested_accept "nested eta-short identity body" retained_nested_eta_short
    , retained_nested_normal "nested strict computes identity" retained_nested_strict
    , retained_nested_normal "nested nonzero argument computes identity" retained_nested_nonzero
    , retained_nested_normal "nested eta-short computes identity" retained_nested_eta_short
    , retained_nested_reject "nested unchanged initial argument" retained_nested_unchanged
    , retained_nested_reject "nested growing inner recursion" retained_nested_growing
    , retained_nested_reject "nested growing other parameter" retained_nested_other_parameter
    , retained_nested_reject "nested captured unchanged argument" retained_nested_captured
    , retained_nested_reject "nested partial function escape" retained_nested_partial
    , retained_nested_reject "nested function argument escape" retained_nested_argument
    ];

def retained_run : List RetainedLaw -> Bool -> IO Unit :=
    fix retained_run (laws : List RetainedLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil =>
          match failed with
          | True => do println "COMPILER_RETAINED: FAIL"; exit 1
          | False => do println "COMPILER_RETAINED: PASS"; exit 0
          end
      | Cons law rest =>
          match law with
          | MkRetainedLaw name passed actual =>
              do println
                   (prim_string_concat
                     (match passed with | True => "PASS " | False => "FAIL " end)
                     (prim_string_concat name
                       (match passed with | True => "" | False => prim_string_concat ": " actual end)));
                 retained_run(rest, orb(failed, notb passed))
          end
      end;

def main : IO Unit :=
    retained_run (append RetainedLaw retained_corpus_laws
      (append RetainedLaw retained_ml_laws retained_nested_laws)) False;
