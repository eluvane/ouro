-- These ABI fixtures deliberately start at typed MIR. The allocator and root
-- inspection bodies are compiled from real imported Ouro source by the driver.
import "../compiler/native/lower_source.ouro";

inductive NativeManagedRuntime : Type :=
  | NativeManagedRuntimeOf : MirProgram -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> NativeManagedRuntime;

def native_fixture_chunk_bytes (chunk : Nat) : List Nat :=
    append Nat (replicate Nat 65 chunk) (append Nat (replicate Nat 66 chunk) (replicate Nat 67 7));

def native_managed_fixture_compiler (runtime : NativeManagedRuntime) : ManagedCompiler :=
    match runtime with | NativeManagedRuntimeOf _ allocator release inspect exit base collector =>
      ManagedCompilerOf (CheckedProgramOf empty_intern ([] : List Entry) ([] : List (Pair Nat CoreTerm)))
        ([] : List Nat) allocator collector release inspect exit (add base 100) ([] : List LowerContract)
        check_environment_empty end;

def managed_fixture_word (ty : MirType) (value : Nat) : MirValue :=
    MirBits ty (X64Words64 (pe_word32 value) codegen_zero);

def managed_fixture_symbol (checked : CheckedProgram) (name : List Nat) : Either NativeSourceError Nat :=
    match checked_program_intern checked with | MkIntern names _ _ _ =>
      match source_lookup_id names name with
      | Nothing => Left NativeSourceError Nat (NativeSourceLowerError (LowerUnknownGlobal 0))
      | Just id => Right NativeSourceError Nat id end end;

def managed_fixture_runtime_with_limits (limits : MirLimits) (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError NativeManagedRuntime :=
    match native_lower_units (mul 100 160) limits [109, 97, 105, 110] root files with
    | Left err => Left NativeSourceError NativeManagedRuntime err
    | Right lowered => match lowered with | NativeLoweredOf checked _ program =>
      match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,99,111,108,108,101,99,116] with
      | Left err => Left NativeSourceError NativeManagedRuntime err | Right collector =>
      match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,97,108,108,111,99,97,116,101,95,114,97,119] with
      | Left err => Left NativeSourceError NativeManagedRuntime err | Right allocator =>
        match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,114,101,108,101,97,115,101,95,97,108,108] with
        | Left err => Left NativeSourceError NativeManagedRuntime err | Right release =>
          match managed_fixture_symbol checked [109,97,110,97,103,101,100,95,105,110,115,112,101,99,116,95,114,111,111,116,115] with
          | Left err => Left NativeSourceError NativeManagedRuntime err | Right inspect =>
            match managed_fixture_symbol checked [119,105,110,100,111,119,115,95,101,120,105,116,95,112,114,111,99,101,115,115] with
            | Left err => Left NativeSourceError NativeManagedRuntime err | Right exit =>
              Right NativeSourceError NativeManagedRuntime (NativeManagedRuntimeOf program allocator release inspect exit
                (S (foldr Nat Nat maxNat 0 (mir_global_ids program))) collector) end end end end end end end;

-- Retain the original default-bound entry point for existing small fixtures.
def managed_fixture_runtime (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError NativeManagedRuntime :=
    managed_fixture_runtime_with_limits mir_default_limits root files;

def managed_fixture_assert (value : MirValue) (expected : MirValue) : List MirInstruction :=
    [MirCompare 900 MirEqual value expected, MirBinaryOp 901 MirAnd (MirUse 901) (MirUse 900)];

def managed_fixture_stat (base : Nat) (offset : Nat) (expected : Nat) : List MirInstruction :=
    Cons MirInstruction (MirLoad 902 (MirUse base) (codegen_disp offset))
      (managed_fixture_assert (MirUse 902) (managed_fixture_word MirUSize expected));

def managed_fixture_join (parts : List (List MirInstruction)) : List MirInstruction :=
    concat_map (List MirInstruction) MirInstruction (fun (part : List MirInstruction) => part) parts;

def managed_fixture_assert_locals : List MirLocal :=
    [MirLocalDef 900 MirU8, MirLocalDef 901 MirU8, MirLocalDef 902 MirUSize];

def managed_fixture_body (id : Nat) (locals : List MirLocal) (instructions : List MirInstruction)
    (result : MirValue) : MirFunction :=
    MirFunctionDef id [109,97,110,97,103,101,100,95,109,97,105,110] []
      (append MirLocal locals managed_fixture_assert_locals) (Just MirType MirU32) 0
      ([MirBlockDef 0 (Cons MirInstruction (MirMove 901 (managed_fixture_word MirU8 1)) instructions)
          (MirBranch (MirUse 901) 1 2),
        MirBlockDef 1 [] (MirReturn (Just MirValue result)),
        MirBlockDef 2 [] (MirReturn (Just MirValue (managed_fixture_word MirU32 99)))] : List MirBlock);

-- This entry has no managed locals. The last managed frame has returned before
-- cleanup, and every cleanup result/counter is checked before ExitProcess.
def managed_fixture_entry (id : Nat) (main : Nat) (release : Nat) (exit : Nat) : MirFunction :=
    MirFunctionDef id [109,97,110,97,103,101,100,95,101,110,116,114,121] []
      (append MirLocal ([MirLocalDef 0 MirU32, MirLocalDef 1 MirRawPtr, MirLocalDef 2 MirU8] : List MirLocal)
        managed_fixture_assert_locals) (Nothing MirType) 0
      ([MirBlockDef 0 (managed_fixture_join ([
          ([MirMove 901 (managed_fixture_word MirU8 1), MirCall MirMayGc (Just Nat 0) (MirDirect main) [], MirManagedContext 1] : List MirInstruction),
          managed_fixture_stat 1 8 0,
          ([MirCall MirMayGc (Just Nat 2) (MirDirect release) [MirUse 1]] : List MirInstruction),
          managed_fixture_assert (MirUse 2) (managed_fixture_word MirU8 1),
          managed_fixture_stat 1 0 0, managed_fixture_stat 1 16 0, managed_fixture_stat 1 24 0]
            : List (List MirInstruction))) (MirBranch (MirUse 901) 1 2),
        MirBlockDef 1 [MirCall MirMayGc (Nothing Nat) (MirDirect exit) [MirUse 0]] MirTrap,
        MirBlockDef 2 [MirCall MirMayGc (Nothing Nat) (MirDirect exit) [managed_fixture_word MirU32 98]] MirTrap] : List MirBlock);

def managed_fixture_finish (runtime : NativeManagedRuntime) (functions : List MirFunction) (data : List MirData) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf program _ release _ exit base collector =>
      match program with | MirProgramDef originals objects libraries _ =>
        MirProgramDef
          (Cons MirFunction (managed_fixture_entry base (S base) release exit) (append MirFunction functions originals))
          (append MirData data objects) libraries base end end;

def managed_fixture_header (runtime : NativeManagedRuntime) (initial_null : Bool) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ inspect _ base collector =>
      let descriptor : Nat := add base 100 in
      let scratch : Nat := add base 101 in
      managed_fixture_finish runtime
        ([managed_fixture_body (S base)
          ([MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirRawPtr, MirLocalDef 3 MirRawPtr,
            MirLocalDef 4 MirU64, MirLocalDef 5 MirU32] : List MirLocal)
          (managed_fixture_join ([
            ([MirManagedContext 2, MirAddress 3 scratch] : List MirInstruction),
            match initial_null with | False => [] | True => managed_fixture_join ([
              ([MirCall MirMayGc (Nothing Nat) (MirDirect inspect) [MirUse 2, MirUse 3]] : List MirInstruction),
              managed_fixture_stat 3 0 1, managed_fixture_stat 3 8 1, managed_fixture_stat 3 16 0]
                : List (List MirInstruction)) end,
            ([MirManagedAlloc 1 allocator collector descriptor (managed_fixture_word MirUSize 40),
              MirStore (MirUse 1) (codegen_disp 32) (managed_fixture_word MirU64 42),
              MirCall MirMayGc (Nothing Nat) (MirDirect inspect) [MirUse 2, MirUse 3]] : List MirInstruction),
            managed_fixture_stat 3 0 1, managed_fixture_stat 3 8 1, managed_fixture_stat 3 16 1,
            managed_fixture_stat 2 16 1, managed_fixture_stat 2 24 40,
            ([MirLoad 4 (MirUse 1) (codegen_disp 32), MirConvert 5 MirNarrow (MirUse 4)] : List MirInstruction)]
              : List (List MirInstruction))) (MirUse 5)] : List MirFunction)
        ([MirDataDef descriptor False (mir_managed_descriptor_bytes 11), MirDataDef scratch True (pe_zeros 32)] : List MirData) end;

def managed_fixture_named (name : List Nat) (runtime : NativeManagedRuntime) : Maybe MirProgram :=
    match pe_bytes_equal name [104,101,97,100,101,114] with
    | True => Just MirProgram (managed_fixture_header runtime False)
    | False => match pe_bytes_equal name [110,117,108,108,95,114,111,111,116,115] with
      | True => Just MirProgram (managed_fixture_header runtime True)
      | False => Nothing MirProgram end end;
