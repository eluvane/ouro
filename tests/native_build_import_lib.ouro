-- Imported scalar helper for native-build closure smoke.
intrinsic W : Type := "ouro.u32";
intrinsic Runtime : Type -> Type := "ouro.runtime";
intrinsic pure : (A : Type) -> A -> Runtime A := "ouro.runtime.pure";
extern pid : Runtime W := "windows-x86_64" "win64" "kernel32.dll" "GetCurrentProcessId" "maygc";
inductive Nat : Type :=
  | Z : Nat
  | S : Nat -> Nat;
representation Nat := "ouro.nat";
inductive Choice (A : Type) : Type :=
  | None : Choice A
  | Some : A -> Choice A;
representation Choice := "ouro.maybe";
intrinsic from_word : Nat -> Choice W := "ouro.u32.from_nat.checked";

def answer : Runtime W :=
    match from_word 42 with
    | None => pid
    | Some value => pure W value
    end;
