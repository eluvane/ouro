-- @entry main
import "../std/test.ouro";

intrinsic nat_mul_to_u64 : Nat -> Maybe U64 := "ouro.u64.from_nat.checked";

-- An accumulating reference is used only on the bounded small-input grid.
def nat_mul_reference (n : Nat) (m : Nat) : Nat :=
    (fix sum (fuel : Nat) (acc : Nat) : Nat :=
      match fuel with | Z => acc | S next => sum next (add acc m) end) n 0;

def nat_mul_columns (n : Nat) : Nat -> Bool :=
  fix columns (remaining : Nat) : Bool :=
    match remaining with
    | Z => True
    | S m => andb (eq_nat (mul n m) (nat_mul_reference n m)) (columns m)
    end;

def nat_mul_grid : Nat -> Bool :=
  fix rows (remaining : Nat) : Bool :=
    match remaining with
    | Z => True
    | S n => andb (nat_mul_columns n 32) (rows n)
    end;

def nat_mul_power_two : Nat -> Nat :=
  fix power (exponent : Nat) : Nat :=
    match exponent with
    | Z => 1
    | S next => let previous : Nat := power next in add previous previous
    end;

def nat_mul_u64_missing (value : Nat) : Bool :=
    match nat_mul_to_u64 value with | Nothing => True | Just _ => False end;

def nat_mul_partial : Bool :=
    let bound : Nat := nat_mul_power_two 16 in
    let product : Nat -> Nat := mul bound in
    andb (eq_nat (product bound) (nat_mul_power_two 32))
      (eq_nat (product 3) (add (nat_mul_power_two 17) bound));

def nat_mul_dormant : Bool :=
    let huge : Nat := add (nat_mul_power_two 65) 7 in
    let product : Nat -> Nat := mul huge in
    let pending : Runtime Nat := runtime_bind Unit Nat (runtime_pure Unit MkUnit)
      (fun (_ : Unit) => runtime_pure Nat (mul huge huge)) in
    andb (eq_nat (length (Nat -> Nat) [product]) 1)
      (eq_nat (length (Runtime Nat) [pending]) 1);

def nat_mul_mutant_add (n : Nat) (m : Nat) : Nat := Z;

def nat_mul_mutant : Nat -> Nat -> Nat :=
  fix product (n : Nat) (m : Nat) : Nat :=
    match n with | Z => Z | S previous => nat_mul_mutant_add m (product previous m) end;

def nat_mul_constant (n : Nat) (m : Nat) : Nat := 17;

def nat_mul_laws : List Test :=
    let power32 : Nat := nat_mul_power_two 32 in
    let power64 : Nat := nat_mul_power_two 64 in
    let power65 : Nat := add power64 power64 in
    let maximum32 : Nat := sub power32 1 in
    [ assert_true "mul small grid agrees with bounded accumulation" (nat_mul_grid 32)
    , assert_true "mul zero left" (eq_nat (mul 0 9) 0)
    , assert_true "mul zero right" (eq_nat (mul 9 0) 0)
    , assert_true "mul manual small result" (eq_nat (mul 7 6) 42)
    , assert_true "mul U32 inputs retain the high product limb"
        (eq_nat (mul (nat_mul_power_two 16) (nat_mul_power_two 16)) power32)
    , assert_true "mul maximum U32 inputs retain the full U64 product"
        (eq_nat (mul maximum32 maximum32) (sub power64 (sub (nat_mul_power_two 33) 1)))
    , assert_true "mul wide operand uses the original body"
        (eq_nat (mul 2 power32) (nat_mul_power_two 33))
    , assert_true "mul U64 result overflow remains an exact Nat"
        (eq_nat (mul 2 (nat_mul_power_two 63)) power64)
    , assert_true "mul result above U64 rejects checked conversion"
        (nat_mul_u64_missing (mul 2 (nat_mul_power_two 63)))
    , assert_true "mul BigNat right operand retains all limbs"
        (eq_nat (mul 3 (add power65 7)) (add (add (add power65 power65) power65) 21))
    , assert_true "mul zero times BigNat remains zero"
        (eq_nat (mul 0 (add power65 7)) 0)
    , assert_true "mul one times BigNat remains exact"
        (eq_nat (mul 1 (add power65 7)) (add power65 7))
    , assert_true "mul captured partial closure can be reused" nat_mul_partial
    , assert_true "mul partial and Runtime computations remain dormant" nat_mul_dormant
    , assert_true "mul changed addition retains mutant semantics" (eq_nat (nat_mul_mutant 2 3) 0)
    , assert_true "mul noncanonical constant body retains its result" (eq_nat (nat_mul_constant 2 3) 17)
    ];

def main : IO Unit := test_run nat_mul_laws;
