-- @entry main
import "../std/natx.ouro",
  "../std/test.ouro";

-- The retained algorithm is an oracle only for the bounded small-input grid.
def nat_divmod_reference (n : Nat) (m : Nat) : Pair Nat Nat :=
    match m with
    | Z => MkPair Nat Nat Z n
    | S _ =>
      (fix subtract (fuel : Nat) (quotient : Nat) (remainder : Nat) : Pair Nat Nat :=
        match fuel with
        | Z => MkPair Nat Nat quotient remainder
        | S next =>
          if ltb_nat remainder m then MkPair Nat Nat quotient remainder
          else subtract next (S quotient) (sub remainder m)
        end) (S n) Z n
    end;

def nat_divmod_expected (n : Nat) (m : Nat) (q : Nat) (r : Nat) : Bool :=
    let (MkPair quotient remainder) := divmod_nat n m in
    andb (andb (eq_nat quotient q) (eq_nat remainder r))
      (andb (eq_nat (div_nat n m) q) (eq_nat (mod_nat n m) r));

def nat_divmod_law (n : Nat) (m : Nat) : Bool :=
    match m with
    | Z => nat_divmod_expected n m Z n
    | S _ => let (MkPair q r) := divmod_nat n m in andb (eq_nat (add (mul m q) r) n) (ltb_nat r m)
    end;

def nat_divmod_small_row (n : Nat) : Nat -> Bool :=
  fix check (m : Nat) : Bool :=
    let same : Bool := let (MkPair q r) := nat_divmod_reference n m in nat_divmod_expected n m q r in
    andb (andb same (nat_divmod_law n m))
      (match m with | Z => True | S next => check next end);

def nat_divmod_small_grid : Nat -> Bool :=
  fix check (n : Nat) : Bool :=
    andb (nat_divmod_small_row n 16)
      (match n with | Z => True | S next => check next end);

def nat_divmod_power_two : Nat -> Nat :=
  fix power (exponent : Nat) : Nat :=
    match exponent with
    | Z => S Z
    | S next => let half : Nat := power next in add half half
    end;

def nat_divmod_large (q : Nat) : Bool :=
    let dividend : Nat := add (mul 7 q) 5 in
    andb (nat_divmod_expected dividend 7 q 5) (nat_divmod_law dividend 7);

def nat_divmod_boundaries (q : Nat) : Bool :=
    let exact : Nat := add q q in
    andb (nat_divmod_expected exact 2 q Z)
      (andb (nat_divmod_expected (sub exact 1) 2 (sub q 1) 1)
        (andb (nat_divmod_expected (S exact) 2 q 1)
          (nat_divmod_expected q 1 q Z)));

def nat_divmod_wide : Bool :=
    let q : Nat := add (nat_divmod_power_two 65) 7 in
    let dividend : Nat := add (mul 3 q) 2 in
    andb (andb (nat_divmod_expected dividend 3 q 2) (nat_divmod_law dividend 3))
      (andb (nat_divmod_expected q (S q) Z q)
        (nat_divmod_expected (S q) q (S Z) (S Z)));

def main : IO Unit := test_run
    [ assert_true "Nat divmod bounded reference and laws" (nat_divmod_small_grid 63)
    , assert_true "Nat divmod large quotient and remainder" (nat_divmod_large (nat_divmod_power_two 20))
    , assert_true "Nat divmod scaled quotient boundaries" (nat_divmod_boundaries (nat_divmod_power_two 20))
    , assert_true "Nat divmod quotient above 64 bits" nat_divmod_wide
    ];
