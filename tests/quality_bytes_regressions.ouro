import "../std/bytes.ouro",
  "../std/test.ouro";

def quality_bytes_long_tail : List Nat :=
    replicate Nat 255 512;

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_true "byte equality accepts empty lists"
          (bytes_eq ([] : List Nat) ([] : List Nat))
      , assert_true "byte equality accepts identical binary values"
          (bytes_eq [0, 1, 127, 128, 255] [0, 1, 127, 128, 255])
      , assert_true "byte equality preserves exact Nat values"
          (bytes_eq [256, 511] [256, 511])
      , assert_true "byte equality rejects modulo-equivalent Nat values"
          (notb (bytes_eq [0, 255] [256, 511]))
      , assert_true "byte equality rejects empty left input"
          (notb (bytes_eq ([] : List Nat) [0]))
      , assert_true "byte equality rejects empty right input"
          (notb (bytes_eq [0] ([] : List Nat)))
      , assert_true "byte equality rejects extra left bytes"
          (notb (bytes_eq [0, 255] [0]))
      , assert_true "byte equality rejects extra right bytes"
          (notb (bytes_eq [0] [0, 255]))
      , assert_true "byte equality rejects reordered bytes"
          (notb (bytes_eq [0, 255] [255, 0]))
      , assert_true "byte equality rejects a late difference"
          (notb (bytes_eq [0, 127, 255] [0, 127, 254]))
      , assert_true "byte equality accepts a long equal tail"
          (bytes_eq (Cons Nat 0 quality_bytes_long_tail)
            (Cons Nat 0 quality_bytes_long_tail))
      , assert_true "byte equality rejects an early difference with a long tail"
          (notb (bytes_eq (Cons Nat 0 quality_bytes_long_tail)
            (Cons Nat 1 quality_bytes_long_tail)))
      ] : List Test);
