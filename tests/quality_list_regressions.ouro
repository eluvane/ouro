import "../std/listx.ouro",
  "../std/test.ouro";

-- A full scan adds 256 sums of 128 values. The input keeps this probe bounded.
private def quality_list_bounded_predicate (value : Nat) : Bool :=
    match value with
    | Z => True
    | S _ => eq_nat (sum_nats (replicate Nat value 128)) 129
    end;

private def quality_list_bounded_tail : List Nat :=
    Cons Nat Z (replicate Nat 1 256);

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_true "any empty is false"
          (notb (any Nat (eq_nat 2) ([] : List Nat)))
       , assert_true "all empty is true"
          (all Nat (eq_nat 2) ([] : List Nat))
       , assert_true "any accepts the first match"
          (any Nat (eq_nat 2) ([2, 3, 4] : List Nat))
       , assert_true "any reaches a later match"
          (any Nat (eq_nat 2) ([3, 4, 2] : List Nat))
       , assert_true "any rejects a list without matches"
          (notb (any Nat (eq_nat 2) ([3, 4, 5] : List Nat)))
       , assert_true "all accepts every matching element"
          (all Nat (eq_nat 2) ([2, 2, 2] : List Nat))
       , assert_true "all rejects the first mismatch"
          (notb (all Nat (eq_nat 2) ([3, 2, 2] : List Nat)))
       , assert_true "all rejects a later mismatch"
          (notb (all Nat (eq_nat 2) ([2, 2, 3] : List Nat)))
       , assert_true "any keeps the element type generic"
          (any String (str_eq "match") (["other", "match"] : List String))
       , assert_true "all keeps the element type generic"
          (all String (str_eq "match") (["match", "match"] : List String))
       , assert_true "any resolves before bounded predicate work in the tail"
          (any Nat quality_list_bounded_predicate quality_list_bounded_tail)
       , assert_true "all resolves before bounded predicate work in the tail"
          (notb (all Nat
            (fun (value : Nat) => notb (quality_list_bounded_predicate value))
            quality_list_bounded_tail))
       ] : List Test);
