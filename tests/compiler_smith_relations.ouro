import "compiler_smith_operations.ouro";

inductive SmithRelation : Type :=
  | SmithConversion : String -> CoreTerm -> CoreTerm -> Bool -> SmithRelation
  | SmithCumulativity : String -> CoreTerm -> CoreTerm -> Bool -> SmithRelation;

def smith_bool_same (left : Bool) (right : Bool) : Bool :=
    match left, right with
    | True, True => True | False, False => True
    | True, False => False | False, True => False
    end;

def smith_relation_result (expected : Bool) (actual : Bool) : Maybe String :=
    match smith_bool_same expected actual with
    | True => Nothing String
    | False => Just(String, match actual with | True => "unexpected true" | False => "unexpected false" end)
    end;

def smith_relation_name (relation : SmithRelation) : String :=
    match relation with
    | SmithConversion name _ _ _ => name | SmithCumulativity name _ _ _ => name
    end;

def smith_relation_check (entries : List Entry) (relation : SmithRelation) : Maybe String :=
    match relation with
    | SmithConversion _ left right expected => match conv_checked smith_fuel entries left right with
        | Normalized actual => smith_relation_result expected actual
        | NormalizeExhausted => Just String "conversion exhausted"
        | NormalizeMalformed _ => Just String "conversion malformed"
        end
    | SmithCumulativity _ left right expected =>
        smith_from_check Bool "cumulative" (cumul_checked smith_fuel entries left right)
          (smith_relation_result expected)
    end;

def smith_relations (seed : Nat) : List SmithRelation :=
    let number : CoreTerm := smith_numeral (smith_choice seed 80 7) in
    let copy : CoreTerm := retained_copy 150 in
    let left : CoreTerm := CStrBytes([108, 101, 102, 116] : List Nat, 18) in
    let right : CoreTerm := CStrBytes([114, 105, 103, 104, 116] : List Nat, 18) in
    [ SmithConversion "alpha-fix-display-name" copy (retained_copy 151) True
    , SmithConversion "eta-fix" copy (CLam(retained_nat, CApp(copy, CRel 0))) True
    , SmithConversion "eta-polymorphic" smith_poly_body
        (CLam(CSort 0, CApp(smith_poly_body, CRel 0))) True
    , SmithConversion "let-inline" (CLetIn number retained_nat (CApp(retained_succ, CRel 0)))
        (CApp retained_succ number) True
    , SmithConversion "let-type-binder" (CLetIn(retained_nat, CSort 0, CLam(CRel 0, CRel 0)))
        (CLam(retained_nat, CRel 0)) True
    , SmithConversion "distinct-constructors" retained_zero (CApp retained_succ retained_zero) False
    , SmithConversion "concat-distinct-order" (smith_apply2 (CConst 220) left right)
        (smith_apply2 (CConst 220) right left) False
    , SmithCumulativity("sort-cumulative", CSort 0, CSort 1, True)
    , SmithCumulativity("sort-cumulative-reverse", CSort 1, CSort 0, False)
    , SmithCumulativity("pi-codomain-cumulative", CPi(retained_nat, CSort 0), CPi(retained_nat, CSort 1), True)
    , SmithCumulativity("pi-codomain-reverse", CPi(retained_nat, CSort 1), CPi(retained_nat, CSort 0), False)
    , SmithCumulativity("pi-domain-invariant", CPi(retained_nat, CSort 0), CPi(retained_bool, CSort 1), False)
    ];

def smith_nested_cases (seed : Nat) : List (Pair String SmithWitness) :=
    let number : CoreTerm := smith_numeral (smith_choice seed 81 7) in
    [ smith_named("nested-fix-strict", smith_result 17 retained_nat (CApp retained_nested_strict number) number True)
    , smith_named("nested-fix-nonzero-rec-arg", smith_result 17 retained_nat (CApp retained_nested_nonzero number) number True)
    , smith_named("nested-fix-eta-short", smith_result 17 retained_nat (CApp retained_nested_eta_short number) number True)
    ];

def smith_operation_cases (seed : Nat) : List (Pair String SmithWitness) :=
    append (Pair String SmithWitness) (smith_elimination_cases seed)
      (append (Pair String SmithWitness) (smith_string_cases seed)
        (append(Pair String SmithWitness, smith_poly_cases seed, smith_nested_cases seed)));
