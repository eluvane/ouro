-- The strict option precheck and forgiving parser share the same CLI grammar.

import "../std/test.ouro",
  "../std/args.ouro";

def args_test_missing : Args := args_of_argv ["tool", "input.ouro", "--registry"];

def args_test_combined : Args :=
    args_of_argv_bools ["list"]
      ["tool", "--registry", "local", "--jobs=2", "--list", "input.ouro"];

def args_test_complete : List Test :=
    [ assert_true("empty argv is complete", args_argv_options_complete [] [])
    , assert_true "program name is not an option"
        (args_argv_options_complete [] ["--registry"])
    , assert_true "separate long option value is complete"
        (args_argv_options_complete [] ["tool", "--registry", "local"])
    , assert_true "inline values include an empty value"
        (args_argv_options_complete [] ["tool", "--jobs=2", "--name="])
    , assert_true "boolean switch does not consume a positional word"
        (args_argv_options_complete ["list"] ["tool", "--list", "input.ouro"])
    , assert_true "missing nonboolean value is rejected"
        (notb (args_argv_options_complete [] ["tool", "--registry"]))
    , assert_true "following long option is not a value"
        (notb (args_argv_options_complete ["list"]
          ["tool", "--registry", "--list"]))
    , assert_true "following short flag is not a value"
        (notb (args_argv_options_complete [] ["tool", "--registry", "-v"]))
    , assert_true "negative spelling requires an inline value"
        (notb (args_argv_options_complete [] ["tool", "--jobs", "-2"]))
    , assert_true "end marker stops option checking"
        (args_argv_options_complete [] ["tool", "--", "--registry"])
    , assert_true "short flag and positional input are complete"
        (args_argv_options_complete [] ["tool", "-v", "input.ouro"])
    , assert_true "later incomplete option is rejected"
        (notb (args_argv_options_complete []
          ["tool", "--jobs", "2", "--registry"]))
    , assert_true "forgiving parser leaves missing value absent"
        (andb (notb (args_flag args_test_missing "registry"))
          (match args_opt args_test_missing "registry" with
           | Nothing => True
           | Just _ => False
           end))
    , assert_eq "forgiving parser preserves the input path"
        (args_at args_test_missing 0) "input.ouro"
    , assert_eq "end marker preserves option-looking positional words"
        (str_join(",", args_positional (args_of_argv ["tool", "--", "--registry", "-v"])))
        "--registry,-v"
    , assert_true "mixed options retain values, flag and positional input"
        (andb (str_eq(args_opt_or args_test_combined "registry" "", "local"))
          (andb (str_eq(args_opt_or args_test_combined "jobs" "", "2"))
            (andb (args_flag args_test_combined "list")
              (str_eq(args_at args_test_combined 0, "input.ouro")))))
    ];

-- @entry main
def main : IO Unit := test_run args_test_complete;
