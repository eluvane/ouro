-- Registered by native_mir_tests. Typed null bases below are never executed;
-- indexed_fixture_raw and the separate collector fixtures use owned storage.
import "native_live_fixtures.ouro";

def indexed_test_scalar (base : MirType) (scalar : MirType) : Test :=
    mir_test_accept (str_cat4 "Indexed memory preserves scalar " (str_of_nat (mir_type_code scalar))
      " through pointer kind " (str_of_nat (mir_type_code base)))
      (mir_fixture_program (mir_fixture_function [MirLocalDef 1 base, MirLocalDef 2 MirUSize, MirLocalDef 3 scalar]
        [MirBlockDef 0 [MirMove 1 (mir_fixture_nat base 0), MirMove 2 (mir_fixture_nat MirUSize 32),
          MirMove 3 (mir_fixture_nat scalar 0), MirStoreAt (MirUse 1) (MirUse 2) (MirUse 3),
          MirLoadAt 3 (MirUse 1) (MirUse 2)] (MirReturn mir_fixture_no_value)]));

def indexed_test_offset (typ : MirType) : List Test :=
    [mir_test_bad (str_concat "Indexed load rejects offset type " (str_of_nat (mir_type_code typ)))
        (MirTypeMismatch 10) (mir_test_one (MirLoadAt 10 (mir_fixture_nat MirRawPtr 0) (mir_fixture_nat typ 0))),
      mir_test_bad (str_concat "Indexed store rejects offset type " (str_of_nat (mir_type_code typ)))
        (MirTypeMismatch 0) (mir_test_one (MirStoreAt (mir_fixture_nat MirManagedPtr 0)
          (mir_fixture_nat typ 0) (mir_fixture_nat MirU32 0)))];

def indexed_test_count (name : String) (instruction : MirInstruction) (fuel : Nat) (expected : String) : Test :=
    let actual : String := match mir_count_instructions [instruction] fuel with
      | Left err => mir_test_error_text err | Right remaining => str_concat "remaining:" (str_of_nat remaining) end in
    assert_eq name actual expected;

def indexed_test_load : MirInstruction := MirLoadAt 10 (mir_fixture_nat MirRawPtr 0) (mir_fixture_nat MirUSize 0);
def indexed_test_store : MirInstruction := MirStoreAt (mir_fixture_nat MirRawPtr 0)
    (mir_fixture_nat MirUSize 0) (mir_fixture_nat MirU32 0);

def indexed_test_validation : List Test :=
    append Test (concat_map MirType Test (fun (base : MirType) => map MirType Test (indexed_test_scalar base)
      [MirU8, MirU32, MirU64, MirI32, MirUSize, MirRawPtr, MirManagedPtr]) [MirRawPtr, MirManagedPtr])
      (append Test (concat_map MirType Test indexed_test_offset [MirU8, MirU32, MirU64, MirI32, MirRawPtr, MirManagedPtr])
        [mir_test_bad "Indexed load rejects an integer base" (MirTypeMismatch 0)
            (mir_test_one (MirLoadAt 10 (mir_fixture_nat MirUSize 0) (mir_fixture_nat MirUSize 0))),
          mir_test_bad "Indexed store rejects an integer base" (MirTypeMismatch 0)
            (mir_test_one (MirStoreAt (mir_fixture_nat MirU64 0) (mir_fixture_nat MirUSize 0) (mir_fixture_nat MirU32 0))),
          mir_test_bad "Indexed load requires an existing destination" (MirUnknownLocal 99)
            (mir_test_one (MirLoadAt 99 (mir_fixture_nat MirRawPtr 0) (mir_fixture_nat MirUSize 0))),
          mir_test_bad "Indexed load requires an existing base" (MirUnknownLocal 99)
            (mir_test_one (MirLoadAt 10 (MirUse 99) (mir_fixture_nat MirUSize 0))),
          mir_test_bad "Indexed load requires an existing offset" (MirUnknownLocal 99)
            (mir_test_one (MirLoadAt 10 (mir_fixture_nat MirRawPtr 0) (MirUse 99))),
          mir_test_bad "Indexed store requires an existing base" (MirUnknownLocal 99)
            (mir_test_one (MirStoreAt (MirUse 99) (mir_fixture_nat MirUSize 0) (mir_fixture_nat MirU32 0))),
          mir_test_bad "Indexed store requires an existing offset" (MirUnknownLocal 99)
            (mir_test_one (MirStoreAt (mir_fixture_nat MirRawPtr 0) (MirUse 99) (mir_fixture_nat MirU32 0))),
          mir_test_bad "Indexed store requires an existing value" (MirUnknownLocal 99)
            (mir_test_one (MirStoreAt (mir_fixture_nat MirRawPtr 0) (mir_fixture_nat MirUSize 0) (MirUse 99))),
          mir_test_bad "Indexed load reads its base before assignment" (MirUninitialized 0 13)
            (mir_test_one (MirLoadAt 10 (MirUse 13) (mir_fixture_nat MirUSize 0))),
          mir_test_bad "Indexed load reads its offset before assignment" (MirUninitialized 0 16)
            (mir_test_one (MirLoadAt 10 (mir_fixture_nat MirRawPtr 0) (MirUse 16))),
          mir_test_bad "Indexed load cannot initialize its own base" (MirUninitialized 0 13)
            (mir_test_one (MirLoadAt 13 (MirUse 13) (mir_fixture_nat MirUSize 0))),
          mir_test_bad "Indexed load cannot initialize its own offset" (MirUninitialized 0 16)
            (mir_test_one (MirLoadAt 16 (mir_fixture_nat MirRawPtr 0) (MirUse 16))),
          mir_test_bad "Indexed store reads its base before assignment" (MirUninitialized 0 14)
            (mir_test_one (MirStoreAt (MirUse 14) (mir_fixture_nat MirUSize 0) (mir_fixture_nat MirU32 0))),
          mir_test_bad "Indexed store reads its offset before assignment" (MirUninitialized 0 16)
            (mir_test_one (MirStoreAt (mir_fixture_nat MirRawPtr 0) (MirUse 16) (mir_fixture_nat MirU32 0))),
          mir_test_bad "Indexed store reads its value before assignment" (MirUninitialized 0 10)
            (mir_test_one (MirStoreAt (mir_fixture_nat MirRawPtr 0) (mir_fixture_nat MirUSize 0) (MirUse 10))),
          mir_test_accept "Indexed load may replace its initialized raw base" (mir_test_ops
            [MirMove 13 (mir_fixture_nat MirRawPtr 0), MirLoadAt 13 (MirUse 13) (mir_fixture_nat MirUSize 0)]),
          mir_test_accept "Indexed load may replace its initialized managed base" (mir_test_ops
            [MirMove 14 (mir_fixture_nat MirManagedPtr 0), MirLoadAt 14 (MirUse 14) (mir_fixture_nat MirUSize 0)]),
          mir_test_accept "Indexed load may replace its initialized offset" (mir_test_ops
            [MirMove 16 (mir_fixture_nat MirUSize 0), MirLoadAt 16 (mir_fixture_nat MirRawPtr 0) (MirUse 16)]),
          mir_test_accept "Indexed offset retains all 64 unsigned bits" (mir_test_one
            (MirLoadAt 10 (mir_fixture_nat MirManagedPtr 0)
              (mir_fixture_bits MirUSize (X64Bytes32 255 255 255 255) (X64Bytes32 255 255 255 255)))),
          indexed_test_count "Indexed load charges both operands" indexed_test_load 2 "resource",
          indexed_test_count "Indexed load exact node budget" indexed_test_load 3 "remaining:0",
          indexed_test_count "Indexed store charges all three operands" indexed_test_store 3 "resource",
          indexed_test_count "Indexed store exact node budget" indexed_test_store 4 "remaining:0",
          gc_test_inferred "Indexed memory does not introduce a collection effect"
            (mir_test_ops [indexed_test_load, indexed_test_store]) [1],
          gc_test_annotated "Indexed memory survives call annotation"
            (mir_test_ops [indexed_test_load, indexed_test_store, mir_fixture_exit_call 0]) True]);

def indexed_test_liveness : List Test :=
    [live_test_instruction "Indexed load keeps its managed owner live" (MirLoadAt 0 (MirUse 1) (MirUse 6)) [0,3] [1,3],
      live_test_instruction "Indexed load alias reads the previous managed owner" (MirLoadAt 1 (MirUse 1) (MirUse 6)) [1,3] [1,3],
      live_test_instruction "Indexed raw base and USize offset are not roots" (MirLoadAt 10 (MirUse 7) (MirUse 6)) [3] [3],
      live_test_instruction "Indexed store keeps both managed values live" (MirStoreAt (MirUse 1) (MirUse 6) (MirUse 2)) [3] [1,2,3],
      live_test_sequence "Indexed load retains its owner through another allocation"
        [MirManagedAlloc 1 10 11 100 (mir_fixture_nat MirUSize 40), MirMove 6 (mir_fixture_nat MirUSize 32),
          MirManagedAlloc 2 10 11 100 (mir_fixture_nat MirUSize 40), MirLoadAt 10 (MirUse 1) (MirUse 6)]
        [] [[],[1],[1],[1]],
      live_test_sequence "Indexed store retains its owner and stored child through allocation"
        [MirManagedAlloc 1 10 11 100 (mir_fixture_nat MirUSize 48),
          MirManagedAlloc 2 10 11 100 (mir_fixture_nat MirUSize 40),
          MirManagedAlloc 3 10 11 100 (mir_fixture_nat MirUSize 40), MirStoreAt (MirUse 1) (MirUse 6) (MirUse 2)]
        [] [[],[1],[1,2],[1,2]],
      assert_true "Indexed memory has no internal safepoint"
        (andb (notb (mir_live_safepoint indexed_test_load)) (notb (mir_live_safepoint indexed_test_store)))];

def indexed_test_encoding (name : String) (atoms : Either NativeCodegenError (List CodegenAtom)) (expected : List Nat) : Test :=
    match atoms with | Left _ => test_fail name "instruction selection failed"
    | Right instructions => match codegen_assemble instructions 0 0 with
      | Left _ => test_fail name "instruction encoding failed"
      | Right encoded => match encoded with | CodegenEncodedParts bytes fixups calls =>
        assert_true name (andb (pe_bytes_equal bytes expected)
          (andb (eq_nat (length PeFixup fixups) 0) (eq_nat (length NativeCallSite calls) 0))) end end end;

def indexed_test_slots (scalar : MirType) : List CodegenSlot :=
    [CodegenSlotAt 0 MirRawPtr 32, CodegenSlotAt 1 MirUSize 40, CodegenSlotAt 2 scalar 48];

def indexed_test_load_bytes (scalar : MirType) (middle : List Nat) : Test :=
    indexed_test_encoding (str_concat "Indexed load exact x64 bytes for scalar " (str_of_nat (mir_type_code scalar)))
      (codegen_load_indexed_memory (indexed_test_slots scalar) 2 (MirUse 0) (MirUse 1))
      (pe_join [[72,139,68,36,32,76,139,84,36,40], middle, [72,137,68,36,48]]);

def indexed_test_store_bytes (scalar : MirType) (last : List Nat) : Test :=
    indexed_test_encoding (str_concat "Indexed store exact x64 bytes for scalar " (str_of_nat (mir_type_code scalar)))
      (codegen_store_indexed_memory (indexed_test_slots scalar) (MirUse 0) (MirUse 1) (MirUse 2))
      (append Nat [76,139,84,36,32,76,139,92,36,40,72,139,68,36,48] last);

def indexed_test_encodings : List Test :=
    [indexed_test_load_bytes MirU8 [66,15,182,4,16,129,224,255,0,0,0],
      indexed_test_load_bytes MirU32 [66,139,4,16,137,192],
      indexed_test_load_bytes MirI32 [66,139,4,16,137,192],
      indexed_test_load_bytes MirU64 [74,139,4,16],
      indexed_test_load_bytes MirUSize [74,139,4,16],
      indexed_test_load_bytes MirRawPtr [74,139,4,16],
      indexed_test_load_bytes MirManagedPtr [74,139,4,16],
      indexed_test_store_bytes MirU8 [67,136,4,26],
      indexed_test_store_bytes MirU32 [67,137,4,26],
      indexed_test_store_bytes MirI32 [67,137,4,26],
      indexed_test_store_bytes MirU64 [75,137,4,26],
      indexed_test_store_bytes MirUSize [75,137,4,26],
      indexed_test_store_bytes MirRawPtr [75,137,4,26],
      indexed_test_store_bytes MirManagedPtr [75,137,4,26],
      indexed_test_encoding "Indexed load alias base writes after both reads"
        (codegen_load_indexed_memory (indexed_test_slots MirU64) 0 (MirUse 0) (MirUse 1))
        [72,139,68,36,32,76,139,84,36,40,74,139,4,16,72,137,68,36,32],
      indexed_test_encoding "Indexed load alias offset writes after both reads"
        (codegen_load_indexed_memory (indexed_test_slots MirU64) 1 (MirUse 0) (MirUse 1))
        [72,139,68,36,32,76,139,84,36,40,74,139,4,16,72,137,68,36,40],
      indexed_test_encoding "Indexed store value may alias its base"
        (codegen_store_indexed_memory (indexed_test_slots MirU64) (MirUse 0) (MirUse 1) (MirUse 0))
        [76,139,84,36,32,76,139,92,36,40,72,139,68,36,32,75,137,4,26],
      indexed_test_encoding "Indexed store value may alias its offset"
        (codegen_store_indexed_memory (indexed_test_slots MirU64) (MirUse 0) (MirUse 1) (MirUse 1))
        [76,139,84,36,32,76,139,92,36,40,72,139,68,36,40,75,137,4,26]];

def indexed_fixture_raw : MirProgram :=
    let word : MirValue := mir_fixture_u32 (X64Bytes32 239 205 171 137) in
    let wide : MirValue := mir_fixture_bits MirU64 (X64Bytes32 239 205 171 137) (X64Bytes32 103 69 35 1) in
    MirProgramDef [mir_fixture_assert_function
      [MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirRawPtr, MirLocalDef 2 MirUSize,
        MirLocalDef 3 MirU8, MirLocalDef 4 MirU32, MirLocalDef 5 MirU64, MirLocalDef 6 MirI32]
      (managed_fixture_join [
        [MirAddress 0 200, MirMove 2 (mir_fixture_nat MirUSize 1),
          MirStoreAt (MirUse 0) (MirUse 2) (mir_fixture_nat MirU8 211)],
        mir_fixture_assert_ops (MirLoadAt 3 (MirUse 0) (MirUse 2)) 3 (mir_fixture_nat MirU8 211),
        mir_fixture_assert_ops (MirLoadAt 3 (MirUse 0) (mir_fixture_nat MirUSize 0)) 3 (mir_fixture_nat MirU8 170),
        mir_fixture_assert_ops (MirLoadAt 3 (MirUse 0) (mir_fixture_nat MirUSize 2)) 3 (mir_fixture_nat MirU8 170),
        [MirMove 2 (mir_fixture_nat MirUSize 4), MirStoreAt (MirUse 0) (MirUse 2) word],
        mir_fixture_assert_ops (MirLoadAt 4 (MirUse 0) (MirUse 2)) 4 word,
        mir_fixture_assert_ops (MirLoadAt 3 (MirUse 0) (mir_fixture_nat MirUSize 3)) 3 (mir_fixture_nat MirU8 170),
        mir_fixture_assert_ops (MirLoadAt 3 (MirUse 0) (mir_fixture_nat MirUSize 8)) 3 (mir_fixture_nat MirU8 170),
        [MirMove 2 (mir_fixture_nat MirUSize 16), MirStoreAt (MirUse 0) (MirUse 2) wide],
        mir_fixture_assert_ops (MirLoadAt 5 (MirUse 0) (MirUse 2)) 5 wide,
        mir_fixture_assert_ops (MirLoadAt 3 (MirUse 0) (mir_fixture_nat MirUSize 15)) 3 (mir_fixture_nat MirU8 170),
        mir_fixture_assert_ops (MirLoadAt 3 (MirUse 0) (mir_fixture_nat MirUSize 24)) 3 (mir_fixture_nat MirU8 170),
        [MirMove 2 (mir_fixture_nat MirUSize 32), MirStoreAt (MirUse 0) (MirUse 2) (mir_fixture_i32 (X64Bytes32 248 255 255 255))],
        mir_fixture_assert_ops (MirLoadAt 6 (MirUse 0) (MirUse 2)) 6 (mir_fixture_i32 (X64Bytes32 248 255 255 255)),
        mir_fixture_assert_ops (MirConvert 5 MirSignExtend (MirUse 6)) 5
          (mir_fixture_bits MirU64 (X64Bytes32 248 255 255 255) (X64Bytes32 255 255 255 255)),
        [MirStoreAt (MirUse 0) (mir_fixture_nat MirUSize 40) (mir_fixture_nat MirUSize 48), MirMove 2 (mir_fixture_nat MirUSize 40)],
        mir_fixture_assert_ops (MirLoadAt 2 (MirUse 0) (MirUse 2)) 2 (mir_fixture_nat MirUSize 48),
        [MirStoreAt (MirUse 0) (MirUse 2) (MirUse 2)],
        mir_fixture_assert_ops (MirLoadAt 2 (MirUse 0) (MirUse 2)) 2 (mir_fixture_nat MirUSize 48),
        [MirAddress 1 201, MirStoreAt (MirUse 1) (mir_fixture_nat MirUSize 0) (MirUse 0),
          MirLoadAt 1 (MirUse 1) (mir_fixture_nat MirUSize 0)],
        mir_fixture_expect (MirUse 1) (MirUse 0),
        [MirStoreAt (MirUse 1) (mir_fixture_nat MirUSize 56) (MirUse 1)],
        mir_fixture_assert_ops (MirLoadAt 1 (MirUse 1) (mir_fixture_nat MirUSize 56)) 1 (MirUse 0),
        [MirPointerAdd 1 (MirUse 0) (mir_fixture_nat MirUSize 8),
          MirMove 2 (mir_fixture_bits MirUSize (X64Bytes32 252 255 255 255) (X64Bytes32 255 255 255 255))],
        mir_fixture_assert_ops (MirLoadAt 4 (MirUse 1) (MirUse 2)) 4 word])]
      [MirDataDef 200 True (replicate Nat 170 64), MirDataDef 201 True (pe_zeros 8)]
      [mir_fixture_kernel []] 1;

def indexed_memory_tests : List Test :=
    append Test indexed_test_validation (append Test indexed_test_liveness indexed_test_encodings);
