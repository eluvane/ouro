-- Each invocation constructs and exercises one real checked API operation.
-- The host runs the full 15-operation inventory in isolated bounded processes.
import "compiler_scale_fixtures.ouro";

def depth_check_case (fuel : Nat) (entries : List Entry) (term : CoreTerm) (expected : CoreTerm) : ProbeCase :=
    MkProbeCase ([CheckInputTerms [], CheckInputTerm term, CheckInputTerm expected] : List CheckInputWork)
      (fun (_run : Unit) => probe_check_outcome Unit (check_term_checked fuel entries [] term expected));

def depth_infer_case (fuel : Nat) (entries : List Entry) (term : CoreTerm) (expected : CoreTerm) : ProbeCase :=
    MkProbeCase ([CheckInputTerms [], CheckInputTerm term] : List CheckInputWork)
      (fun (_run : Unit) => probe_inferred fuel expected (infer_checked fuel entries [] (IGTerm term)));

def depth_normal_case
    (reduce : Nat -> List Entry -> CoreTerm -> NormalizeResult CoreTerm)
    (fuel : Nat) (entries : List Entry) (term : CoreTerm) (expected : CoreTerm) : ProbeCase :=
    MkProbeCase ([CheckInputTerm term] : List CheckInputWork)
      (fun (_run : Unit) => probe_same fuel expected (reduce fuel entries term));

def depth_declaration_case (fuel : Nat) (entries : List Entry) (item : FileItem) : ProbeCase :=
    MkProbeCase ([CheckInputItem item] : List CheckInputWork)
      (fun (_run : Unit) => probe_declaration_outcome (check_declaration CheckExactCore fuel entries item));

def depth_case (name : String) (depth : Nat) (fuel : Nat) (entries : List Entry) : Maybe ProbeCase :=
    match str_eq name "check-lam" with
    | True => Just ProbeCase (depth_check_case fuel entries (probe_lam depth) (probe_pi depth))
    | False => match str_eq name "infer-pi-sort" with
      | True => Just ProbeCase (depth_infer_case fuel entries (probe_pi depth) (CSort 0))
      | False => match str_eq name "infer-domain-sort" with
        | True => Just ProbeCase (depth_infer_case fuel entries (probe_domain depth) (CSort 0))
        | False => match str_eq name "check-let" with
          | True => Just ProbeCase (depth_check_case fuel entries (probe_let depth) retained_nat)
          | False => match str_eq name "infer-app" with
            | True => Just ProbeCase (depth_infer_case fuel entries (probe_app depth) retained_nat)
            | False => match str_eq name "normalize-let" with
              | True => Just ProbeCase (depth_normal_case normalize_checked fuel entries (probe_let depth) retained_zero)
              | False => match str_eq name "normalize-app" with
                | True => let term : CoreTerm := probe_app depth in
                    Just ProbeCase (depth_normal_case normalize_checked fuel entries term term)
                | False => match str_eq name "whnf-lam" with
                  | True => let term : CoreTerm := probe_lam depth in
                      Just ProbeCase (depth_normal_case whnf_checked fuel entries term term)
                  | False => match str_eq name "normalize-lam" with
                    | True => let term : CoreTerm := probe_lam depth in
                        Just ProbeCase (depth_normal_case normalize_checked fuel entries term term)
                    | False => match str_eq name "convert-lam" with
                      | True => let term : CoreTerm := probe_lam depth in
                          Just ProbeCase (MkProbeCase ([CheckInputTerm term, CheckInputTerm term] : List CheckInputWork)
                            (fun (_run : Unit) => probe_normal_bool (conv_checked fuel entries term term)))
                      | False => match str_eq name "recheck-lam" with
                        | True => Just ProbeCase (depth_declaration_case fuel entries (FDef 71 (probe_pi depth) (probe_lam depth)))
                        | False => match str_eq name "recheck-let" with
                          | True => Just ProbeCase (depth_declaration_case fuel entries (FDef 72 retained_nat (probe_let depth)))
                          | False => match str_eq name "recheck-app" with
                            | True => Just ProbeCase (depth_declaration_case fuel entries (FDef 73 retained_nat (probe_app depth)))
                            | False => match str_eq name "recheck-axiom-pi" with
                              | True => Just ProbeCase (depth_declaration_case fuel entries (FAxiom 74 (probe_pi depth)))
                              | False => match str_eq name "recheck-axiom-domain" with
                                | True => Just ProbeCase (depth_declaration_case fuel entries (FAxiom 75 (probe_domain depth)))
                                | False => Nothing ProbeCase
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end;

def depth_run (name : String) (depth : Nat) (fuel : Nat) : IO Unit :=
    match check_declaration CheckExactCore fuel [] (FInd retained_nat_decl) with
    | DeclarationsErr _ _ _ => do eprintln "KERNEL_DEPTH_ENV_FAIL"; exit 1
    | DeclarationsOk entries => match probe_add_function fuel entries with
        | DeclarationsErr _ _ _ => do eprintln "KERNEL_DEPTH_ENV_FAIL"; exit 1
        | DeclarationsOk environment => match depth_case name depth fuel environment with
            | Nothing => do eprintln "KERNEL_DEPTH_UNKNOWN_OPERATION"; exit 2
            | Just case => probe_execute "DEPTH" name depth case
            end
        end
    end;

-- @entry main
def main : IO Unit :=
    (do let! arguments := argv;
       let options : Args := cli_from_argv [] arguments in
       match cli_required options "operation" with
       | Left error => do eprintln (cli_error_message error); exit 2
       | Right name => match cli_required_nat options "depth" with
         | Left error => do eprintln (cli_error_message error); exit 2
         | Right depth => match cli_optional_nat options "fuel" (add 100 (mul 8 depth)) with
           | Left error => do eprintln (cli_error_message error); exit 2
           | Right fuel => depth_run name depth fuel
           end
         end
       end);
