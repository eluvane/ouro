-- Ordinary source exercises the constructor pass through the public frontend.

import "../std/test.ouro";

inductive CallbackBox : Type :=
  | CallbackValue : Nat -> CallbackBox;

def callback_values : List CallbackBox :=
    map Nat CallbackBox CallbackValue ([1, 2] : List Nat);

def callback_total : Nat :=
    foldr CallbackBox Nat
      (fun (box : CallbackBox) (total : Nat) =>
        match box with | CallbackValue value => add value total end)
      0 callback_values;

-- @entry main
def main : IO Unit :=
    test_run ([assert_eq "constructor callback" (str_of_nat callback_total) "3"] : List Test);
