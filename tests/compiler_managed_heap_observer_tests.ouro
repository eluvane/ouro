-- Heap observation is authorized by a closed key and the complete checked type.
import "compiler_binding_surface.ouro",
  "../std/test.ouro";

def heap_observer_binding_base (registered : Bool) : List FileItem :=
    append FileItem compiler_binding_nat_base
      (append FileItem
        ([FInd(MkIndDecl 170 ([MkParam(169, CSort 0)] : List Param) (Nil CoreTerm) 0
          ([MkCtor(171, CPi(CSort 0, CApp(CInd 170, CRel 0))),
            MkCtor(172, CPi(CSort 0, CPi(CRel 0, CApp(CInd 170, CRel 1))))] : List Ctor))] : List FileItem)
        (append FileItem (match registered with
          | True => ([FRepresentation(170, prim_string_to_char_codes "ouro.maybe")] : List FileItem)
          | False => ([] : List FileItem) end)
          ([FDef(173, CPi(CSort 0, CSort 0), CInd 170)] : List FileItem)));

def heap_observer_binding_type (aliases : Bool) : CoreTerm :=
    CApp (match aliases with | True => CConst 109 | False => CConst 101 end)
      (CApp (match aliases with | True => CConst 173 | False => CInd 170 end)
        (match aliases with | True => CConst 111 | False => CInd 102 end));

def heap_observer_binding_declaration (typ : CoreTerm) (specialization : Maybe CoreTerm) : FileItem :=
    FIntrinsic(180, typ, primitive_key PrimitiveManagedAllocatedRequestedBytes, specialization);

def heap_observer_binding_metadata (aliases : Bool) : Bool :=
    match compiler_binding_check_last (heap_observer_binding_base True)
      (heap_observer_binding_declaration (heap_observer_binding_type aliases) (Nothing CoreTerm)) with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries => any Entry (fun (entry : Entry) => match entry with
        | MkBoundEntry name _ binding => andb (eqNat name 180)
            (match binding with | PrimitiveExternBinding _ => False
            | PrimitiveIntrinsicBinding id execution gc specialization =>
                andb (primitive_id_equal id PrimitiveManagedAllocatedRequestedBytes)
                  (andb (match execution with | PrimitiveRuntimeAction => True
                    | PrimitiveTypeOnly => False | PrimitivePureValue => False end)
                    (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                      (match specialization with | Nothing => True | Just _ => False end))) end)
        | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False end) entries end;

def heap_observer_binding_rejected (registered : Bool) (typ : CoreTerm)
    (specialization : Maybe CoreTerm) : Bool :=
    match compiler_binding_check_last (heap_observer_binding_base registered)
      (heap_observer_binding_declaration typ specialization) with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure => andb (eqNat name 180)
        (eqNat(declaration_failure_code CheckExactCore phase failure, 2)) end;

def heap_observer_binding_c_shim (axiom_only : Bool) : Bool :=
    match compiler_binding_check_last (heap_observer_binding_base True)
      (match axiom_only with
      | True => FAxiom(180, heap_observer_binding_type False)
      | False => heap_observer_binding_declaration (heap_observer_binding_type True) (Nothing CoreTerm) end) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      let shims : List (Pair Nat (List Nat)) := checked_program_c_shims
        (CheckedProgramOf empty_intern entries ([] : List (Pair Nat CoreTerm))) in
      let selected : Bool := any (Pair Nat (List Nat)) (fun (shim : Pair Nat (List Nat)) =>
        match shim with | MkPair name key => andb (eqNat name 180)
          (primitive_bytes_equal(key, primitive_key PrimitiveManagedAllocatedRequestedBytes)) end) shims in
      match axiom_only with | True => notb selected | False => selected end end;

def main : IO Unit := test_run
    [assert_true("heap observation records Runtime action and allocating boxing", heap_observer_binding_metadata False),
     assert_true("heap observation accepts transparent Runtime Maybe Nat aliases", heap_observer_binding_metadata True),
     assert_true "heap observation rejects pure Maybe Nat"
       (heap_observer_binding_rejected True (CApp(CInd 170, CInd 102)) (Nothing CoreTerm)),
     assert_true "heap observation rejects collapsed Runtime Nat"
       (heap_observer_binding_rejected True (CApp(CConst 101, CInd 102)) (Nothing CoreTerm)),
     assert_true "heap observation rejects a String payload"
       (heap_observer_binding_rejected True (CApp(CConst 101, CApp(CInd 170, CConst 100))) (Nothing CoreTerm)),
     assert_true "heap observation rejects an extra source argument"
       (heap_observer_binding_rejected True (CPi(CInd 102, heap_observer_binding_type False)) (Nothing CoreTerm)),
     assert_true "heap observation requires registered Maybe constructors"
       (heap_observer_binding_rejected False (heap_observer_binding_type False) (Nothing CoreTerm)),
     assert_true "heap observation rejects specialization"
       (heap_observer_binding_rejected True (heap_observer_binding_type False) (Just(CoreTerm, CInd 102))),
     assert_true("heap observation emits its checked C adapter key", heap_observer_binding_c_shim False),
     assert_true("same-name axioms never authorize the observer", heap_observer_binding_c_shim True)];
