-- Differential probes apply a supplied original-signature function to
-- typed data. Every result retains the complete input and raw Either value.
import "../compiler/native/pe.ouro",
  "../std/listx.ouro";

inductive PeSizeNameCase : Type :=
  | PeSizeName : Nat -> List PePlacedSection -> List PeSymbol -> Nat -> PeSizeNameCase;
inductive PeSizeTargetCase : Type :=
  | PeSizeTarget : Nat -> List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeTarget -> PeSizeTargetCase;
inductive PeSizeSlotCase : Type :=
  | PeSizeSlot : Nat -> List PePlacedSection -> PeSection -> Nat -> Nat -> PeSizeSlotCase;
inductive PeSizeRelativeCase : Type :=
  | PeSizeRelative : Nat -> List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat)
      -> PeSection -> Nat -> Nat -> PeTarget -> PePlacedSection -> PeSizeRelativeCase;
inductive PeSizeAddressCase : Type :=
  | PeSizeAddress : Nat -> List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat)
      -> PeSection -> Nat -> PeTarget -> Bool -> PeSizeAddressCase;
inductive PeSizeSingleCase : Type :=
  | PeSizeSingle : Nat -> List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat)
      -> PeFixup -> PePlacedSection -> PeSizeSingleCase;
inductive PeSizeManyCase : Type :=
  | PeSizeMany : Nat -> List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat)
      -> List PeFixup -> PeSizeManyCase;

def pe_size_text : PePlacedSection := PeSectionAt PeText pe_section_alignment pe_header_size pe_file_alignment (pe_zeros 32);
def pe_size_read : PePlacedSection := PeSectionAt(PeReadOnly, mul 2 pe_section_alignment, mul 6 256, pe_file_alignment, pe_zeros 16);
def pe_size_write : PePlacedSection := PeSectionAt(PeWritable, mul 3 pe_section_alignment, mul 8 256, pe_file_alignment, pe_zeros 16);
def pe_size_sections : List PePlacedSection := [pe_size_text, pe_size_read, pe_size_write];
def pe_size_symbols : List PeSymbol := [PeNamedSymbol 1 PeText 0, PeNamedSymbol 2 PeReadOnly 15, PeNamedSymbol 3 PeWritable 8];
def pe_size_imports : List (Pair Nat Nat) := [MkPair Nat Nat 7 (mul 4 pe_section_alignment), MkPair Nat Nat 8 0];
def pe_size_empty : PePlacedSection := PeSectionAt PeText 256 pe_file_alignment pe_section_alignment ([] : List Nat);
def pe_size_short : PePlacedSection := PeSectionAt PeText pe_file_alignment pe_header_size pe_section_alignment (pe_zeros 3);
def pe_size_nonzero : PePlacedSection := PeSectionAt PeText pe_section_alignment pe_header_size pe_file_alignment
  (append(Nat, pe_zeros 4, Cons Nat 1 (pe_zeros 27)));
def pe_size_late_nonzero : PePlacedSection := PeSectionAt PeText pe_section_alignment pe_header_size pe_file_alignment
  (append(Nat, pe_zeros 20, Cons Nat 1 (pe_zeros 11)));
def pe_size_empty_sections : List PePlacedSection := [];
def pe_size_empty_symbols : List PeSymbol := [];
def pe_size_empty_imports : List (Pair Nat Nat) := [];

def pe_size_name_cases : List PeSizeNameCase :=
  [PeSizeName 1 pe_size_sections pe_size_symbols 1,
    PeSizeName 2 pe_size_sections pe_size_symbols 2,
    PeSizeName 3 pe_size_empty_sections pe_size_empty_symbols 99,
    PeSizeName 4 pe_size_sections pe_size_symbols 99,
    PeSizeName 5 pe_size_empty_sections pe_size_symbols 1,
    PeSizeName 6 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols 1,
    PeSizeName 7 ([pe_size_text, pe_size_empty] : List PePlacedSection) pe_size_symbols 1,
    PeSizeName 8 pe_size_sections ([PeNamedSymbol 1 PeImports 0, PeNamedSymbol 1 PeText 0] : List PeSymbol) 1,
    PeSizeName 9 pe_size_sections ([PeNamedSymbol 1 PeText 7, PeNamedSymbol 1 PeText 0] : List PeSymbol) 1,
    PeSizeName 10 pe_size_sections ([PeNamedSymbol 4 PeText 32] : List PeSymbol) 4,
    PeSizeName 11 pe_size_sections ([PeNamedSymbol 4 PeText 33] : List PeSymbol) 4,
    PeSizeName 12 pe_size_sections ([PeNamedSymbol 4 PeRelocations 0] : List PeSymbol) 4,
    PeSizeName 13 pe_size_empty_sections ([PeNamedSymbol 4 PeText (add pe_max_rva 1)] : List PeSymbol) 4,
    PeSizeName 14 ([pe_size_short, pe_size_text] : List PePlacedSection) pe_size_symbols 1];

def pe_size_target_cases : List PeSizeTargetCase :=
  [PeSizeTarget 1 pe_size_sections pe_size_symbols pe_size_imports (PeSymbolTarget 1),
    PeSizeTarget 2 pe_size_sections pe_size_symbols pe_size_imports (PeSymbolTarget 99),
    PeSizeTarget 3 pe_size_empty_sections pe_size_symbols pe_size_imports (PeSymbolTarget 1),
    PeSizeTarget 4 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports (PeSymbolTarget 1),
    PeSizeTarget 5 ([pe_size_text, pe_size_empty] : List PePlacedSection) pe_size_symbols pe_size_imports (PeSymbolTarget 1),
    PeSizeTarget 6 pe_size_empty_sections pe_size_empty_symbols pe_size_imports (PeImportTarget 7),
    PeSizeTarget 7 pe_size_sections pe_size_symbols pe_size_imports (PeImportTarget 99),
    PeSizeTarget 8 pe_size_sections pe_size_symbols pe_size_empty_imports (PeImportTarget 7),
    PeSizeTarget 9 pe_size_empty_sections pe_size_empty_symbols ([MkPair Nat Nat 7 123, MkPair Nat Nat 7 456] : List (Pair Nat Nat)) (PeImportTarget 7),
    PeSizeTarget 10 pe_size_empty_sections pe_size_empty_symbols pe_size_imports (PeImportTarget 8)];

def pe_size_slot_cases : List PeSizeSlotCase :=
  [PeSizeSlot 1 pe_size_sections PeText 0 0,
    PeSizeSlot 2 pe_size_sections PeText 32 0,
    PeSizeSlot 3 pe_size_sections PeText 33 0,
    PeSizeSlot 4 pe_size_sections PeText 28 4,
    PeSizeSlot 5 pe_size_sections PeText 24 8,
    PeSizeSlot 6 pe_size_sections PeText 29 4,
    PeSizeSlot 7 pe_size_sections PeText 25 8,
    PeSizeSlot 8 pe_size_sections PeText 0 33,
    PeSizeSlot 9 pe_size_sections PeText 32 4,
    PeSizeSlot 10 pe_size_sections PeText (add pe_max_rva 1) 4,
    PeSizeSlot 11 pe_size_sections PeText 0 (add pe_max_rva 1),
    PeSizeSlot 12 pe_size_empty_sections PeText 0 4,
    PeSizeSlot 13 ([PeSectionAt PeImports pe_section_alignment 0 32 (pe_zeros 32)] : List PePlacedSection) PeImports 0 4,
    PeSizeSlot 14 ([pe_size_empty, pe_size_text] : List PePlacedSection) PeText 0 4,
    PeSizeSlot 15 ([pe_size_empty, pe_size_text] : List PePlacedSection) PeText 0 0,
    PeSizeSlot 16 ([pe_size_short, pe_size_text] : List PePlacedSection) PeText 0 4,
    PeSizeSlot 17 ([pe_size_text, pe_size_empty] : List PePlacedSection) PeText 4 4,
    PeSizeSlot 18 ([pe_size_nonzero] : List PePlacedSection) PeText 4 4,
    PeSizeSlot 19 ([pe_size_nonzero] : List PePlacedSection) PeText 1 4,
    PeSizeSlot 20 ([pe_size_nonzero] : List PePlacedSection) PeText 8 4,
    PeSizeSlot 21 ([pe_size_nonzero] : List PePlacedSection) PeText 4 0,
    PeSizeSlot 22 ([pe_size_nonzero] : List PePlacedSection) PeText 31 8];

def pe_size_relative_cases : List PeSizeRelativeCase :=
  [PeSizeRelative 1 pe_size_sections pe_size_symbols pe_size_imports PeText 4 8 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 2 pe_size_sections pe_size_symbols pe_size_imports PeText 4 8 (PeImportTarget 7) pe_size_text,
    PeSizeRelative 3 pe_size_sections pe_size_symbols ([MkPair Nat Nat 7 (add pe_section_alignment 8)] : List (Pair Nat Nat)) PeText 4 8 (PeImportTarget 7) pe_size_text,
    PeSizeRelative 4 pe_size_sections pe_size_symbols pe_size_imports PeText 4 12 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 5 pe_size_sections pe_size_symbols pe_size_imports PeText 4 7 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 6 pe_size_sections pe_size_symbols pe_size_imports PeText 4 32 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 7 pe_size_sections pe_size_symbols pe_size_imports PeText 4 33 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 8 ([pe_size_nonzero] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 4 7 (PeSymbolTarget 99) pe_size_nonzero,
    PeSizeRelative 9 ([pe_size_nonzero] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 31 0 (PeSymbolTarget 99) pe_size_nonzero,
    PeSizeRelative 10 pe_size_sections pe_size_symbols pe_size_imports PeText 4 7 (PeSymbolTarget 99) pe_size_text,
    PeSizeRelative 11 pe_size_sections pe_size_symbols pe_size_imports PeText 4 8 (PeSymbolTarget 99) pe_size_text,
    PeSizeRelative 12 pe_size_sections pe_size_symbols pe_size_imports PeText 4 8 (PeImportTarget 99) pe_size_text,
    PeSizeRelative 13 pe_size_empty_sections pe_size_symbols pe_size_imports PeText 4 8 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 14 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 0 4 (PeSymbolTarget 1) pe_size_empty,
    PeSizeRelative 15 ([pe_size_text, pe_size_empty] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 4 8 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 16 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 4 8 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 17 pe_size_sections pe_size_symbols pe_size_imports PeImports 4 8 (PeSymbolTarget 1) pe_size_text,
    PeSizeRelative 18 pe_size_sections pe_size_symbols pe_size_imports PeText 0 0 (PeSymbolTarget 1) pe_size_empty,
    PeSizeRelative 19 pe_size_sections pe_size_symbols pe_size_imports PeText 4 8 (PeSymbolTarget 1) pe_size_read,
    PeSizeRelative 20 ([(PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 16))] : List PePlacedSection) pe_size_symbols ([MkPair Nat Nat 7 (add pe_max_rva 4)] : List (Pair Nat Nat)) PeText 0 4 (PeImportTarget 7) (PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 16)),
    PeSizeRelative 21 ([(PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 16))] : List PePlacedSection) pe_size_symbols ([MkPair Nat Nat 7 (add pe_max_rva 5)] : List (Pair Nat Nat)) PeText 0 4 (PeImportTarget 7) (PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 16)),
    PeSizeRelative 22 ([(PeSectionAt PeText (sub pe_max_rva 3) 0 pe_file_alignment (pe_zeros 16))] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 0 4 (PeImportTarget 8) (PeSectionAt PeText (sub pe_max_rva 3) 0 pe_file_alignment (pe_zeros 16)),
    PeSizeRelative 23 ([(PeSectionAt PeText (sub pe_max_rva 2) 0 pe_file_alignment (pe_zeros 16))] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 0 4 (PeImportTarget 8) (PeSectionAt PeText (sub pe_max_rva 2) 0 pe_file_alignment (pe_zeros 16))];

def pe_size_address_cases : List PeSizeAddressCase :=
  [PeSizeAddress 1 pe_size_sections pe_size_symbols pe_size_imports PeText 4 (PeSymbolTarget 1) False,
    PeSizeAddress 2 pe_size_sections pe_size_symbols pe_size_imports PeText 4 (PeSymbolTarget 1) True,
    PeSizeAddress 3 pe_size_sections pe_size_symbols pe_size_imports PeText 4 (PeImportTarget 7) False,
    PeSizeAddress 4 pe_size_sections pe_size_symbols pe_size_imports PeText 4 (PeImportTarget 7) True,
    PeSizeAddress 5 pe_size_empty_sections pe_size_symbols pe_size_imports PeText 4 (PeSymbolTarget 1) False,
    PeSizeAddress 6 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 0 (PeSymbolTarget 1) False,
    PeSizeAddress 7 ([pe_size_text, pe_size_empty] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 4 (PeSymbolTarget 1) False,
    PeSizeAddress 8 pe_size_sections pe_size_symbols pe_size_imports PeRelocations 4 (PeSymbolTarget 1) False,
    PeSizeAddress 9 pe_size_sections pe_size_symbols pe_size_imports PeText 28 (PeSymbolTarget 1) False,
    PeSizeAddress 10 pe_size_sections pe_size_symbols pe_size_imports PeText 24 (PeSymbolTarget 1) True,
    PeSizeAddress 11 pe_size_sections pe_size_symbols pe_size_imports PeText 29 (PeSymbolTarget 1) False,
    PeSizeAddress 12 pe_size_sections pe_size_symbols pe_size_imports PeText 25 (PeSymbolTarget 1) True,
    PeSizeAddress 13 ([pe_size_nonzero] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 4 (PeSymbolTarget 99) False,
    PeSizeAddress 14 pe_size_sections pe_size_symbols pe_size_imports PeText 4 (PeSymbolTarget 99) False,
    PeSizeAddress 15 pe_size_sections pe_size_symbols pe_size_imports PeText 4 (PeImportTarget 99) False,
    PeSizeAddress 16 pe_size_empty_sections pe_size_empty_symbols pe_size_imports PeText 100 (PeImportTarget 7) False,
    PeSizeAddress 17 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports PeText 0 (PeSymbolTarget 1) False,
    PeSizeAddress 18 pe_size_sections ([PeNamedSymbol 1 PeText 32] : List PeSymbol) pe_size_imports PeText 4 (PeSymbolTarget 1) False,
    PeSizeAddress 19 pe_size_sections ([PeNamedSymbol 1 PeImports 0, PeNamedSymbol 1 PeText 0] : List PeSymbol) pe_size_imports PeText 4 (PeSymbolTarget 1) False,
    PeSizeAddress 20 pe_size_sections pe_size_symbols ([MkPair Nat Nat 7 (add pe_max_rva 1)] : List (Pair Nat Nat)) PeText 4 (PeImportTarget 7) True];

def pe_size_single_cases : List PeSizeSingleCase :=
  [PeSizeSingle 1 pe_size_sections pe_size_symbols pe_size_imports (PeRel32 PeText 4 8 (PeSymbolTarget 1)) pe_size_text,
    PeSizeSingle 2 pe_size_sections pe_size_symbols pe_size_imports (PeRva32 PeText 4 (PeSymbolTarget 1)) pe_size_text,
    PeSizeSingle 3 pe_size_sections pe_size_symbols pe_size_imports (PeVa64 PeText 24 (PeImportTarget 7)) pe_size_text,
    PeSizeSingle 4 pe_size_empty_sections pe_size_symbols pe_size_imports (PeRva32 PeText 4 (PeImportTarget 7)) pe_size_text,
    PeSizeSingle 5 pe_size_sections pe_size_symbols pe_size_imports (PeRel32 PeText 4 7 (PeSymbolTarget 99)) pe_size_text,
    PeSizeSingle 6 ([pe_size_nonzero] : List PePlacedSection) pe_size_symbols pe_size_imports (PeRel32 PeText 4 7 (PeSymbolTarget 99)) pe_size_nonzero,
    PeSizeSingle 7 pe_size_sections pe_size_symbols pe_size_imports (PeRel32 PeText 0 4 (PeImportTarget 7)) pe_size_empty,
    PeSizeSingle 8 pe_size_sections pe_size_symbols pe_size_imports (PeVa64 PeImports 4 (PeImportTarget 7)) pe_size_text,
    PeSizeSingle 9 pe_size_sections pe_size_symbols pe_size_imports (PeVa64 PeText 28 (PeSymbolTarget 99)) pe_size_text,
    PeSizeSingle 10 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports (PeRel32 PeText 0 4 (PeSymbolTarget 1)) pe_size_empty,
    PeSizeSingle 11 pe_size_sections pe_size_symbols pe_size_imports (PeRva32 PeText 4 (PeImportTarget 99)) pe_size_text,
    PeSizeSingle 12 pe_size_sections pe_size_symbols pe_size_imports (PeRel32 PeText 0 4 (PeImportTarget 7)) pe_size_read];

def pe_size_many_cases : List PeSizeManyCase :=
  [PeSizeMany 1 pe_size_empty_sections pe_size_empty_symbols pe_size_empty_imports ([] : List PeFixup),
    PeSizeMany 2 ([PeSectionAt PeText 0 0 1 ([256] : List Nat), pe_size_empty] : List PePlacedSection) pe_size_symbols pe_size_imports ([] : List PeFixup),
    PeSizeMany 3 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1), PeRva32 PeText 8 (PeSymbolTarget 1), PeVa64 PeText 24 (PeSymbolTarget 1), PeRel32 PeReadOnly 0 4 (PeSymbolTarget 1), PeVa64 PeWritable 8 (PeImportTarget 7)] : List PeFixup),
    PeSizeMany 4 pe_size_sections pe_size_symbols pe_size_imports ([PeRel32 PeText 0 4 (PeSymbolTarget 2)] : List PeFixup),
    PeSizeMany 5 pe_size_sections pe_size_symbols pe_size_imports ([PeRel32 PeReadOnly 4 8 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 6 pe_size_empty_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 7 ([pe_size_empty, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRva32 PeText 0 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 8 ([pe_size_short, pe_size_text] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRva32 PeText 0 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 9 ([pe_size_text, pe_size_empty] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 10 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeImports 0 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 11 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 32 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 12 pe_size_sections pe_size_symbols pe_size_imports ([PeVa64 PeText 28 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 13 ([pe_size_nonzero] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRel32 PeText 4 7 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 14 pe_size_sections pe_size_symbols pe_size_imports ([PeRel32 PeText 4 7 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 15 pe_size_sections pe_size_symbols pe_size_imports ([PeRel32 PeText 4 8 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 16 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeImportTarget 99)] : List PeFixup),
    PeSizeMany 17 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1), PeRva32 PeText 6 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 18 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1), PeRva32 PeText 4 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 19 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 8 (PeSymbolTarget 1), PeRva32 PeText 4 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 20 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 8 (PeSymbolTarget 1), PeRva32 PeText 4 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 21 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1), PeRva32 PeText 6 (PeImportTarget 99)] : List PeFixup),
    PeSizeMany 22 ([pe_size_nonzero] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRva32 PeText 8 (PeSymbolTarget 1), PeRva32 PeText 4 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 23 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 8 (PeSymbolTarget 1), PeRel32 PeText 0 3 (PeSymbolTarget 99)] : List PeFixup),
    PeSizeMany 24 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeReadOnly 0 (PeSymbolTarget 1), PeRva32 PeText 4 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 25 ([pe_size_late_nonzero] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1), PeRva32 PeText 20 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 26 pe_size_sections ([PeNamedSymbol 1 PeImports 0, PeNamedSymbol 1 PeText 0] : List PeSymbol) pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany 27 pe_size_sections pe_size_symbols pe_size_imports ([PeRva32 PeText 4 (PeSymbolTarget 99), PeVa64 PeText 31 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany(28, [pe_size_text, PeSectionAt PeReadOnly (mul 2 pe_section_alignment) 0 pe_section_alignment ([] : List Nat)] : List PePlacedSection, [PeNamedSymbol 1 PeReadOnly 0] : List PeSymbol, pe_size_imports, [PeRva32 PeText 4 (PeSymbolTarget 1)] : List PeFixup),
    PeSizeMany(29, [(PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 16))] : List PePlacedSection, pe_size_symbols, [MkPair Nat Nat 7 (add pe_max_rva 4)] : List (Pair Nat Nat), [PeRel32 PeText 0 4 (PeImportTarget 7)] : List PeFixup),
    PeSizeMany(30, [(PeSectionAt PeText 0 0 pe_file_alignment (pe_zeros 16))] : List PePlacedSection, pe_size_symbols, [MkPair Nat Nat 7 (add pe_max_rva 5)] : List (Pair Nat Nat), [PeRel32 PeText 0 4 (PeImportTarget 7)] : List PeFixup),
    PeSizeMany 31 ([PeSectionAt PeText (sub pe_max_rva 3) 0 pe_file_alignment (pe_zeros 16)] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRel32 PeText 0 4 (PeImportTarget 8)] : List PeFixup),
    PeSizeMany 32 ([PeSectionAt PeText (sub pe_max_rva 2) 0 pe_file_alignment (pe_zeros 16)] : List PePlacedSection) pe_size_symbols pe_size_imports ([PeRel32 PeText 0 4 (PeImportTarget 8)] : List PeFixup)];

def pe_size_probe_symbol (call : List PePlacedSection -> List PeSymbol -> Nat -> Either PeError Nat) : List (Pair PeSizeNameCase (Either PeError Nat)) :=
    map PeSizeNameCase (Pair(PeSizeNameCase, Either PeError Nat))
      (fun (input : PeSizeNameCase) => MkPair PeSizeNameCase (Either PeError Nat) input
        (match input with | PeSizeName _ sections symbols name => call sections symbols name end)) pe_size_name_cases;

def pe_size_probe_target (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeTarget -> Either PeError Nat) : List (Pair PeSizeTargetCase (Either PeError Nat)) :=
    map PeSizeTargetCase (Pair(PeSizeTargetCase, Either PeError Nat))
      (fun (input : PeSizeTargetCase) => MkPair PeSizeTargetCase (Either PeError Nat) input
        (match input with | PeSizeTarget _ sections symbols imports target => call sections symbols imports target end)) pe_size_target_cases;

def pe_size_probe_bounds (call : List PePlacedSection -> PeSection -> Nat -> Nat -> Either PeError PePlacedSection) : List (Pair PeSizeSlotCase (Either PeError PePlacedSection)) :=
    map PeSizeSlotCase (Pair(PeSizeSlotCase, Either PeError PePlacedSection))
      (fun (input : PeSizeSlotCase) => MkPair PeSizeSlotCase (Either PeError PePlacedSection) input
        (match input with | PeSizeSlot _ sections kind offset width => call sections kind offset width end)) pe_size_slot_cases;

def pe_size_probe_slot (call : List PePlacedSection -> PeSection -> Nat -> Nat -> Either PeError PePlacedSection) : List (Pair PeSizeSlotCase (Either PeError PePlacedSection)) :=
    let result : List (Pair PeSizeSlotCase (Either PeError PePlacedSection)) := pe_size_probe_bounds call in result;

def pe_size_probe_relative (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeSection -> Nat -> Nat -> PeTarget -> Either PeError PePatch) : List (Pair PeSizeRelativeCase (Either PeError PePatch)) :=
    map PeSizeRelativeCase (Pair(PeSizeRelativeCase, Either PeError PePatch))
      (fun (input : PeSizeRelativeCase) => MkPair PeSizeRelativeCase (Either PeError PePatch) input
        (match input with | PeSizeRelative _ sections symbols imports kind offset next target _ => call sections symbols imports kind offset next target end)) pe_size_relative_cases;

def pe_size_probe_relative_in (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeSection -> Nat -> Nat -> PeTarget -> PePlacedSection -> Either PeError PePatch) : List (Pair PeSizeRelativeCase (Either PeError PePatch)) :=
    map PeSizeRelativeCase (Pair(PeSizeRelativeCase, Either PeError PePatch))
      (fun (input : PeSizeRelativeCase) => MkPair PeSizeRelativeCase (Either PeError PePatch) input
        (match input with | PeSizeRelative _ sections symbols imports kind offset next target section => call sections symbols imports kind offset next target section end)) pe_size_relative_cases;

def pe_size_probe_address (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeSection -> Nat -> PeTarget -> Bool -> Either PeError PePatch) : List (Pair PeSizeAddressCase (Either PeError PePatch)) :=
    map PeSizeAddressCase (Pair(PeSizeAddressCase, Either PeError PePatch))
      (fun (input : PeSizeAddressCase) => MkPair PeSizeAddressCase (Either PeError PePatch) input
        (match input with | PeSizeAddress _ sections symbols imports kind offset target absolute => call sections symbols imports kind offset target absolute end)) pe_size_address_cases;

def pe_size_probe_address_in (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeSection -> Nat -> PeTarget -> Bool -> Either PeError PePatch) : List (Pair PeSizeAddressCase (Either PeError PePatch)) :=
    let result : List (Pair PeSizeAddressCase (Either PeError PePatch)) := pe_size_probe_address call in result;

def pe_size_probe_single (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeFixup -> Either PeError PePatch) : List (Pair PeSizeSingleCase (Either PeError PePatch)) :=
    map PeSizeSingleCase (Pair(PeSizeSingleCase, Either PeError PePatch))
      (fun (input : PeSizeSingleCase) => MkPair PeSizeSingleCase (Either PeError PePatch) input
        (match input with | PeSizeSingle _ sections symbols imports fixup _ => call sections symbols imports fixup end)) pe_size_single_cases;

def pe_size_probe_resolve (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> PeFixup -> PePlacedSection -> Either PeError PePatch) : List (Pair PeSizeSingleCase (Either PeError PePatch)) :=
    map PeSizeSingleCase (Pair(PeSizeSingleCase, Either PeError PePatch))
      (fun (input : PeSizeSingleCase) => MkPair PeSizeSingleCase (Either PeError PePatch) input
        (match input with | PeSizeSingle _ sections symbols imports fixup section => call sections symbols imports fixup section end)) pe_size_single_cases;

def pe_size_probe_many (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> List PeFixup -> Either PeError (List PePatch)) : List (Pair PeSizeManyCase (Either PeError (List PePatch))) :=
    map PeSizeManyCase (Pair(PeSizeManyCase, Either(PeError, List PePatch)))
      (fun (input : PeSizeManyCase) => MkPair PeSizeManyCase (Either(PeError, List PePatch)) input
        (match input with | PeSizeMany _ sections symbols imports fixups => call sections symbols imports fixups end)) pe_size_many_cases;

-- Input construction is pure Ouro and is included in both timing intervals.
def pe_size_benchmark_bytes (byte_count : Nat) : List Nat :=
    concat_map(Nat, Nat, fun (_ : Nat) => pe_zeros 256, pe_zeros (div_nat byte_count 256));

def pe_size_benchmark_fixups (fixup_count : Nat) : List PeFixup :=
    let ids : List Nat := (fix collect (remaining : Nat) (id : Nat) : List Nat :=
      match remaining with | Z => [] | S rest => Cons Nat id (collect(rest, S id)) end) fixup_count 0 in
    map Nat PeFixup (fun (id : Nat) => let offset : Nat := mul id 16 in
      PeRel32(PeText, offset, add offset 4, PeSymbolTarget 1)) ids;

def pe_size_probe_benchmark
    (call : List PePlacedSection -> List PeSymbol -> List (Pair Nat Nat) -> List PeFixup -> Either PeError (List PePatch))
    (byte_count : Nat) (fixup_count : Nat) : Pair PeSizeManyCase (Either PeError (List PePatch)) :=
    let sections : List PePlacedSection := [PeSectionAt PeText pe_section_alignment pe_header_size byte_count (pe_size_benchmark_bytes byte_count)] in
    let symbols : List PeSymbol := [PeNamedSymbol 1 PeText 0] in
    let imports : List (Pair Nat Nat) := [] in
    let fixups : List PeFixup := pe_size_benchmark_fixups fixup_count in
    MkPair PeSizeManyCase (Either(PeError, List PePatch))
      (PeSizeMany 1 sections symbols imports fixups) (call sections symbols imports fixups);
