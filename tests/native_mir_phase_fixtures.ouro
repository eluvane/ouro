-- The retained pre-callback body is an independent composition oracle.
-- Production checking always supplies the canonical function checker.
import "native_mir_validation_tests.ouro";

def mir_phase_reference_check (limits : MirLimits) (program : MirProgram) : Either MirError Unit :=
    match mir_check_bounds limits program with | Left err => Left MirError Unit err | Right _ =>
      match program with | MirProgramDef functions objects libraries _ => match limits with | MirLimitsWith _ _ flow =>
        match mir_checks ([mir_unique (fun (id : Nat) => MirDuplicateSymbol id) (mir_global_ids program),
          mir_each Nat (fun (id : Nat) => mir_require (ltb_nat id pe_max_rva) MirResourceExhausted) (mir_global_ids program),
          mir_each MirData mir_check_data objects, mir_check_libraries libraries,
          mir_check_entry program, mir_each MirFunction (mir_check_function program flow) functions]
          : List (Either MirError Unit)) with
        | Left err => Left MirError Unit err
        | Right _ => Right MirError Unit MkUnit end end end end;

def mir_phase_result_text (result : Either MirError Unit) : String :=
    match result with | Left error => mir_test_error_text error | Right _ => "accepted" end;

def mir_phase_forward (program : MirProgram) (flow : Nat) (function : MirFunction) : Either MirError Unit :=
    mir_check_function program flow function;

def mir_phase_same (name : String) (limits : MirLimits) (program : MirProgram) : Test :=
    let expected : String := mir_phase_result_text (mir_phase_reference_check limits program) in
    assert_true name (andb (str_eq expected (mir_phase_result_text (mir_check_program limits program)))
      (str_eq expected (mir_phase_result_text (mir_check_program_with mir_phase_forward limits program))));

def mir_phase_expect (name : String) (expected : MirError) (result : Either MirError Unit) : Test :=
    match result with | Right _ => test_fail name "invalid MIR accepted"
    | Left error => assert_eq name (mir_test_error_text error) (mir_test_error_text expected) end;

def mir_phase_good_function (id : Nat) : MirFunction :=
    MirFunctionDef id ([102] : List Nat) ([] : List MirLocal) ([] : List MirLocal)
      mir_fixture_void 0 ([MirBlockDef 0 ([] : List MirInstruction) MirTrap] : List MirBlock);

def mir_phase_bad_function (id : Nat) (missing : Nat) : MirFunction :=
    MirFunctionDef id ([102] : List Nat) ([] : List MirLocal) ([] : List MirLocal)
      mir_fixture_void 0 ([MirBlockDef 0 ([] : List MirInstruction) (MirJump missing)] : List MirBlock);

def mir_phase_functions (functions : List MirFunction) (entry : Nat) : MirProgram :=
    MirProgramDef functions ([] : List MirData) ([] : List MirLibrary) entry;

def mir_phase_two_bad : MirProgram := mir_phase_functions
    ([mir_phase_bad_function 1 71, mir_phase_bad_function 2 72] : List MirFunction) 1;

def mir_phase_callback_error (program : MirProgram) (flow : Nat) (function : MirFunction) : Either MirError Unit :=
    match program with | MirProgramDef _ _ _ entry =>
      Left MirError Unit (MirInvalidCall (add (mir_function_id function) (add flow entry))) end;

def mir_phase_callback_accept (_ : MirProgram) (_ : Nat) (_ : MirFunction) : Either MirError Unit :=
    Right MirError Unit MkUnit;

def mir_phase_priority (name : String) (expected : MirError) (program : MirProgram) : Test :=
    mir_phase_expect name expected (mir_check_program_with mir_phase_callback_error mir_default_limits program);

def mir_phase_public_boundary : Test :=
    let probe : Either MirError Unit := mir_check_program_with mir_phase_callback_accept mir_default_limits mir_phase_two_bad in
    match probe with | Left _ => test_fail "A callback Unit result cannot change public MIR acceptance" "diagnostic callback failed"
    | Right _ => mir_test_bad "A callback Unit result cannot change public MIR acceptance" (MirUnknownBlock 71) mir_phase_two_bad end;
