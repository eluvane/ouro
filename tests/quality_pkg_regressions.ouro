import "../tools/pkg/model.ouro",
  "../std/test.ouro";

def quality_pkg_lock_rejects (text : String) : Bool :=
    match lock_parse text with
    | Nothing => True
    | Just _ => False
    end;

def quality_pkg_lock_rendered (text : String) : String :=
    match lock_parse text with
    | Nothing => "invalid lock"
    | Just locked => lock_render locked
    end;

def quality_pkg_lock_fields : List (Pair String Json) :=
    [ MkPair String Json "name" (JStr "hello")
    , MkPair String Json "version" (JStr "0.1.0")
    , MkPair String Json "source" (JStr "registry/hello")
    , MkPair String Json "digest" (JStr "files=0,bytes=0,mix=1")
    ];

def quality_pkg_lock_with_field (key : String) (value : Json) : String :=
    gate_json_print (JObj
      [MkPair String Json "packages" (JArr
        [JObj (map (Pair String Json) (Pair String Json)
          (fun (field : Pair String Json) =>
            let (MkPair name body) := field in
            MkPair String Json name
              (if str_eq name key then value else body))
          quality_pkg_lock_fields)])]);

def quality_pkg_lock_wrong_types_rejected (key : String) : Bool :=
    all Json
      (fun (value : Json) =>
        quality_pkg_lock_rejects (quality_pkg_lock_with_field key value))
      [JNull, JBool True, JNum "1", JArr (Nil Json), JObj (Nil (Pair String Json))];

-- @entry main
def main : IO Unit := test_run
    [ assert_eq "empty package lock remains valid"
        (quality_pkg_lock_rendered "{\"packages\":[]}") "{\"packages\":[]}\n"
    , assert_eq "generated package lock roundtrip preserves identities and order"
        (quality_pkg_lock_rendered (lock_render
          [MkLocked "greet" "0.1.0" "registry/greet" "greet digest",
           MkLocked "hello" "0.0.0" "registry/hello" "hello digest"]))
        "{\"packages\":[{\"name\":\"greet\",\"version\":\"0.1.0\",\"source\":\"registry/greet\",\"digest\":\"greet digest\"},{\"name\":\"hello\",\"version\":\"0.0.0\",\"source\":\"registry/hello\",\"digest\":\"hello digest\"}]}\n"
    , assert_eq "package lock accepts explicit empty strings in opaque fields"
        (quality_pkg_lock_rendered "{\"packages\":[{\"name\":\"hello\",\"version\":\"0.0.0\",\"source\":\"\",\"digest\":\"\"}]}")
        "{\"packages\":[{\"name\":\"hello\",\"version\":\"0.0.0\",\"source\":\"\",\"digest\":\"\"}]}\n"
    , assert_eq "package lock ignores extra fields without changing retained values"
        (quality_pkg_lock_rendered "{\"extra\":true,\"packages\":[{\"name\":\"hello\",\"version\":\"0.1.0\",\"source\":\"registry/hello\",\"digest\":\"files=0,bytes=0,mix=1\",\"extra\":[]}]}")
        "{\"packages\":[{\"name\":\"hello\",\"version\":\"0.1.0\",\"source\":\"registry/hello\",\"digest\":\"files=0,bytes=0,mix=1\"}]}\n"
    , assert_true "missing lock name is invalid"
        (quality_pkg_lock_rejects "{\"packages\":[{\"version\":\"0.1.0\",\"source\":\"registry/hello\",\"digest\":\"files=0,bytes=0,mix=1\"}]}")
    , assert_true "missing lock version is not replaced by zero"
        (quality_pkg_lock_rejects "{\"packages\":[{\"name\":\"hello\",\"source\":\"registry/hello\",\"digest\":\"files=0,bytes=0,mix=1\"}]}")
    , assert_true "missing lock source is invalid"
        (quality_pkg_lock_rejects "{\"packages\":[{\"name\":\"hello\",\"version\":\"0.1.0\",\"digest\":\"files=0,bytes=0,mix=1\"}]}")
    , assert_true "missing lock digest is invalid"
        (quality_pkg_lock_rejects "{\"packages\":[{\"name\":\"hello\",\"version\":\"0.1.0\",\"source\":\"registry/hello\"}]}")
    , assert_true "lock name rejects every non-string JSON kind"
        (quality_pkg_lock_wrong_types_rejected "name")
    , assert_true "lock version rejects every non-string JSON kind"
        (quality_pkg_lock_wrong_types_rejected "version")
    , assert_true "lock source rejects every non-string JSON kind"
        (quality_pkg_lock_wrong_types_rejected "source")
    , assert_true "lock digest rejects every non-string JSON kind"
        (quality_pkg_lock_wrong_types_rejected "digest")
    , assert_true "valid first lock does not hide a malformed later lock"
        (quality_pkg_lock_rejects "{\"packages\":[{\"name\":\"hello\",\"version\":\"0.1.0\",\"source\":\"registry/hello\",\"digest\":\"files=0,bytes=0,mix=1\"},{\"name\":\"greet\"}]}")
    , assert_true "non-object lock entry is invalid"
        (quality_pkg_lock_rejects "{\"packages\":[null]}")
    , assert_true "package lock retains path traversal rejection"
        (quality_pkg_lock_rejects "{\"packages\":[{\"name\":\"../hello\",\"version\":\"0.1.0\",\"source\":\"registry/hello\",\"digest\":\"files=0,bytes=0,mix=1\"}]}")
    ];
