import "../compiler/preprocess_record.ouro";

def destructure_test_registry : RecReg :=
  MkRecReg(0,
    [MkRecInfo (Nil Nat) (str_codes "Point") (str_codes "MkPoint")
      [MkRecField (str_codes "x") (str_codes "Nat"),
       MkRecField (str_codes "flag") (str_codes "Bool")]
      empty_rec_owner_scope], [], []);

def destructure_test_preprocess (source : String) : PrepResult :=
  match preprocess_records_reg (Nil Nat)
      (MkImpReg (MkPair (List (List Nat)) (List (Pair (List Nat) (List Nat)))
        (Nil (List Nat)) (Nil (Pair (List Nat) (List Nat))))
        (Nil ImpRule)) destructure_test_registry (str_codes source) with
  | MkPair _ tagged => match tagged with
    | MkPair _ result => result
    end
  end;

def destructure_test_count (needle : List Nat) : List Nat -> Nat :=
  fix go (xs : List Nat) : Nat :=
    match xs with
    | Nil => Z
    | Cons _ rest =>
        match source_starts needle xs with
        | True => S (go rest)
        | False => go rest
        end
    end;

def destructure_test_before (first : List Nat) (second : List Nat)
    : List Nat -> Bool :=
  fix go (xs : List Nat) : Bool :=
    match xs with
    | Nil => False
    | Cons _ rest =>
        match source_starts first xs with
        | True => True
        | False =>
            match source_starts second xs with
            | True => False
            | False => go rest
            end
        end
    end;

def destructure_test_lowering : Bool :=
  match destructure_test_preprocess
      "def result : Nat := let { flag, x } : Point := perform choosePoint(point) in x;" with
  | PrepErr _ _ => False
  | PrepOk source =>
      andb(eqNat(destructure_test_count
          (str_codes "perform choosePoint(point)") source, S Z),
        andb(destructure_test_before (str_codes "perform choosePoint(point)")
            (str_codes "Point_flag __ouro_update") source,
          andb(destructure_test_before (str_codes "Point_flag __ouro_update")
              (str_codes "Point_x __ouro_update") source,
            destructure_test_before (str_codes "Point_x __ouro_update")
              (str_codes "let flag :=") source)))
  end;

def destructure_test_rename_lowering : Bool :=
  match destructure_test_preprocess
      "def result : Nat := let { flag as enabled, x as value } : Point := perform choosePoint(point) in value;" with
  | PrepErr _ _ => False
  | PrepOk source =>
      andb(eqNat(destructure_test_count
          (str_codes "perform choosePoint(point)") source, S Z),
        andb(destructure_test_before (str_codes "Point_flag __ouro_update")
            (str_codes "Point_x __ouro_update") source,
          andb(destructure_test_before (str_codes "Point_x __ouro_update")
              (str_codes "let enabled :=") source,
            destructure_test_before (str_codes "let enabled :=")
              (str_codes "let value :=") source)))
  end;

def destructure_test_fresh : Bool :=
  match destructure_test_preprocess
      "def result : Nat := let __ouro_update : Nat := Z in let { x } : Point := point in __ouro_update;" with
  | PrepErr _ _ => False
  | PrepOk source =>
      andb(eqNat(destructure_test_count
          (str_codes "let __ouro_update_ : Point") source, S Z),
        eqNat(destructure_test_count (str_codes "let __ouro_update : Nat") source, S Z))
  end;

def destructure_test_block_ascription : Bool :=
  let source : String := "def value : Nat := let { Z } : Nat;" in
  match destructure_test_preprocess source with
  | PrepErr _ _ => False
  | PrepOk output => source_bytes_equal output (str_codes source)
  end;

def destructure_test_trivia : Bool :=
  match destructure_test_preprocess
      "def value : Nat := -- before\n let { x } : Point := point in x;" with
  | PrepErr _ _ => False
  | PrepOk output => eqNat(destructure_test_count
      (str_codes "-- before\n") output, S Z)
  end;

def destructure_test_error (source : String) (wanted : Nat) : Bool :=
  match destructure_test_preprocess source with
  | PrepErr code _ => eqNat code wanted
  | PrepOk _ => False
  end;
