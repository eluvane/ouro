-- Core closure conversion and its unchanged strict-checking boundary.
-- --emit prints C produced by constructor_close -> extract -> print_c. A host
-- test executes that output, including a map callback and reusable captures.

import "../compiler/constructor_closures.ouro",
  "../compiler/file_elab.ouro",
  "../compiler/backend.ouro",
  "../std/io.ouro";

def closure_test_fuel : Nat := mul 50 40;
def closure_test_nat : CoreTerm := CInd 10;
def closure_test_box : CoreTerm := CInd 40;

def closure_test_number : Nat -> CoreTerm :=
  fix closure_test_number (number : Nat) : CoreTerm :=
    match number with
    | Z => CConstruct 10 0 0
    | S rest => CApp(CConstruct 10 1 0, closure_test_number rest)
    end;

def closure_test_sig : List Entry :=
    [ MkIndEntry 10
        (MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor 11 closure_test_nat, MkCtor(12, CPi closure_test_nat closure_test_nat)] : List Ctor))
    , MkIndEntry 30
        (MkIndDecl 30 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(31, CPi(closure_test_nat, CPi(closure_test_nat, CInd 30)))] : List Ctor))
    , MkIndEntry 40
        (MkIndDecl 40 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(41, CPi closure_test_nat closure_test_box)] : List Ctor))
    , MkIndEntry 50
        (MkIndDecl 50 ([MkParam(51, CSort 0)] : List Param) (Nil CoreTerm) 0
          ([MkCtor(52, CPi(CSort 0, CPi(CRel 0, CApp(CInd 50, CRel 1))))] : List Ctor))
    , MkIndEntry 60
        (MkIndDecl 60 ([MkParam 61 closure_test_nat] : List Param) (Nil CoreTerm) 0
          ([MkCtor(62, CPi(closure_test_nat, CPi(closure_test_nat, CApp(CInd 60, CRel 1))))] : List Ctor))
    , MkIndEntry 70
        (MkIndDecl 70 (Nil Param) (Nil CoreTerm) 1
          ([MkCtor(71, CPi(CSort 0, CPi(CRel 0, CInd 70)))] : List Ctor))
    , MkIndEntry 80
        (MkIndDecl 80 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(81, CPi(CPi closure_test_nat closure_test_box, CInd 80))] : List Ctor))
    , MkIndEntry 90
        (MkIndDecl 90 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(91, CInd 90), MkCtor(92, CPi(closure_test_nat, CPi(CInd 90, CInd 90)))] : List Ctor))
    , MkIndEntry 95
        (MkIndDecl 95 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(96, CInd 95), MkCtor(97, CPi(closure_test_box, CPi(CInd 95, CInd 95)))] : List Ctor))
    , MkIndEntry 105
        (MkIndDecl 105 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(106, CPi(closure_test_nat, CPi(closure_test_nat, CPi(closure_test_nat, CInd 105))))] : List Ctor))
    , MkEntry 777 closure_test_nat (Nothing CoreTerm)
    ];

def closure_test_map_type : CoreTerm :=
    CPi(CPi closure_test_nat closure_test_box, CPi(CInd 90, CInd 95));

def closure_test_map : CoreTerm :=
    CFix 200 1 2 closure_test_map_type
      (CLam (CPi closure_test_nat closure_test_box)
        (CLam (CInd 90)
          (CCase (MkCaseInfo 90 0 ([0, 2] : List Nat))
            (CLam(CInd 90, CInd 95)) (CRel 0)
            ([ CConstruct 95 0 0
             , CLam closure_test_nat (CLam (CInd 90)
                (CApp (CApp(CConstruct 95 1 0, CApp(CRel 3, CRel 1)))
                  (CApp(CApp(CRel 4, CRel 3), CRel 0))))
             ] : List CoreTerm))));

def closure_test_list : List Nat -> CoreTerm :=
  fix closure_test_list (numbers : List Nat) : CoreTerm :=
    match numbers with
    | Nil => CConstruct 90 0 0
    | Cons number rest => CApp(CApp(CConstruct 90 1 0, closure_test_number number), closure_test_list rest)
    end;

def closure_test_map_value : CoreTerm :=
    CApp(CApp(closure_test_map, CConstruct 40 0 0), closure_test_list ([1, 2, 3] : List Nat));

inductive ConstructorCase : Type :=
  | ConstructorCaseInput : String -> CoreTerm -> CoreTerm -> ConstructorCase;

-- The runtime harness checks these exports in this stable order, IDs 100..113.
def closure_test_cases : List ConstructorCase :=
    [ ConstructorCaseInput("unary constructor callback", CPi closure_test_nat closure_test_box, CConstruct 40 0 0)
    , ConstructorCaseInput "nullary constructor stays a value" closure_test_nat (CConstruct 10 0 0)
    , ConstructorCaseInput "fully applied binary constructor" (CInd 30)
        (CApp(CApp(CConstruct 30 0 0, closure_test_number 1), closure_test_number 2))
    , ConstructorCaseInput "partial binary constructor captures first field" (CPi(closure_test_nat, CInd 30))
        (CApp(CConstruct 30 0 0, closure_test_number 7))
    , ConstructorCaseInput "bare polymorphic constructor erases type binder"
        (CPi(CSort 0, CPi(CRel 0, CApp(CInd 50, CRel 1)))) (CConstruct 50 0 1)
    , ConstructorCaseInput "polymorphic parameter instantiates field annotation"
        (CPi(closure_test_nat, CApp(CInd 50, closure_test_nat))) (CApp(CConstruct 50 0 1, closure_test_nat))
    , ConstructorCaseInput "erased Nat parameter does not become a payload field"
        (CPi(closure_test_nat, CApp(CInd 60, closure_test_number 3)))
        (CApp(CConstruct 60 0 1, closure_test_number 3))
    , ConstructorCaseInput "sort field outside inductive parameters is erased"
        (CPi(closure_test_nat, CInd 70)) (CApp(CConstruct 70 0 0, closure_test_nat))
    , ConstructorCaseInput "captured computation is evaluated once" (CPi(closure_test_nat, CInd 30))
        (CApp(CConstruct 30 0 0, CConst 777))
    , ConstructorCaseInput "outer de Bruijn variable is captured without shadowing"
        (CPi(closure_test_nat, CPi(closure_test_nat, CInd 30)))
        (CLam(closure_test_nat, CApp(CConstruct 30 0 0, CRel 0)))
    , ConstructorCaseInput "constructor stored in function-valued field" (CInd 80)
        (CApp(CConstruct 80 0 0, CConstruct 40 0 0))
    , ConstructorCaseInput "CFix map consumes constructor callback" (CInd 95) closure_test_map_value
    , ConstructorCaseInput "bare Nat-parameter constructor retains its callable telescope"
        (CPi(closure_test_nat, CPi(closure_test_nat, CApp(CInd 60, CRel 1)))) (CConstruct 60 0 1)
    , ConstructorCaseInput "multiple supplied fields preserve distinct outer binders"
        (CPi(closure_test_nat, CPi(closure_test_nat, CPi(closure_test_nat, CInd 105))))
        (CLam closure_test_nat (CLam closure_test_nat
          (CApp(CApp(CConstruct 105 0 0, CRel 1), CRel 0))))
    ];

inductive ClosureLaw : Type :=
  | ClosureLawResult : String -> Bool -> ClosureLaw;

def closure_test_equal (left : CoreTerm) (right : CoreTerm) : Bool :=
    eqTerm closure_test_fuel left right;

def closure_test_shape (name : String) (input : CoreTerm) (expected : CoreTerm) : ClosureLaw :=
    ClosureLawResult name
      (match constructor_close closure_test_fuel closure_test_sig input with
       | Left _ => False
       | Right output => closure_test_equal output expected
       end);

def closure_test_checked (test : ConstructorCase) : ClosureLaw :=
    match test with
    | ConstructorCaseInput name typ input =>
        ClosureLawResult name
          (match constructor_close closure_test_fuel closure_test_sig input with
           | Left _ => False
           | Right output =>
               match check_term_checked closure_test_fuel closure_test_sig (Nil CoreTerm) output typ with
               | CheckOk _ => True
               | CheckErr _ => False
               end
           end)
    end;

def closure_test_idempotent (test : ConstructorCase) : Bool :=
    match test with
    | ConstructorCaseInput _ _ input =>
        match constructor_close closure_test_fuel closure_test_sig input with
        | Left _ => False
        | Right output =>
            match constructor_close closure_test_fuel closure_test_sig output with
            | Left _ => False
            | Right repeated => closure_test_equal output repeated
            end
        end
    end;

def closure_test_error_code (error : ConstructorClosureError) : Nat :=
    match error with
    | ConstructorClosureMissing _ _ => 1
    | ConstructorClosureOverapplied _ _ => 2
    | ConstructorClosureMalformed _ _ => 3
    | ConstructorClosureExhausted => 4
    end;

def closure_test_error_ids (error : ConstructorClosureError) : Pair Nat Nat :=
    match error with
    | ConstructorClosureMissing ind index => MkPair Nat Nat ind index
    | ConstructorClosureOverapplied ind index => MkPair Nat Nat ind index
    | ConstructorClosureMalformed ind index => MkPair Nat Nat ind index
    | ConstructorClosureExhausted => MkPair Nat Nat 0 0
    end;

def closure_test_error (name : String) (expected : ConstructorClosureError)
    (result : Either ConstructorClosureError CoreTerm) : ClosureLaw :=
    ClosureLawResult name
      (match result with
       | Right _ => False
       | Left actual =>
           match closure_test_error_ids expected, closure_test_error_ids actual with
           | MkPair expected_ind expected_index, MkPair actual_ind actual_index =>
               andb (eqNat(closure_test_error_code actual, closure_test_error_code expected))
                 (andb(eqNat actual_ind expected_ind, eqNat actual_index expected_index))
           end
       end);

def closure_test_bad_sig (typ : CoreTerm) : List Entry :=
    Cons Entry (MkIndEntry 110 (MkIndDecl 110 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 111 typ] : List Ctor))) closure_test_sig;

-- A source declaration visits every constructor of the literal. Its lookup
-- environment must survive the complete traversal, including closure conversion.
def closure_test_wide_environment : CheckEnvironment :=
    (fix extend (remaining : Nat) (environment : CheckEnvironment) : CheckEnvironment :=
      match remaining with
      | Z => environment
      | S rest => extend rest
          (check_environment_cons(MkEntry(add(mul 10 100, rest), closure_test_nat, Nothing CoreTerm), environment))
      end) (mul 20 20) (check_environment_from_entries closure_test_sig);

def closure_test_wide_literal : CoreTerm := closure_test_number (mul 3 100);

def closure_test_wide_name : Nat := mul 30 100;

def closure_test_wide_source : Bool :=
    match check_indexed_declaration CheckSourceCore closure_test_fuel closure_test_wide_environment
        (FDef closure_test_wide_name closure_test_nat closure_test_wide_literal) with
    | IndexedDeclarationsErr _ _ _ => False
    | IndexedDeclarationsOk checked =>
        match check_environment_const closure_test_wide_name checked with
        | Nothing => False
        | Just term => closure_test_equal closure_test_wide_literal term
        end
    end;

def closure_test_wide_raw : Bool :=
    match constructor_close closure_test_fuel
        (check_environment_entries closure_test_wide_environment) closure_test_wide_literal with
    | Left _ => False
    | Right term => closure_test_equal closure_test_wide_literal term
    end;

def closure_test_laws : List ClosureLaw :=
    [
      ClosureLawResult "source literal keeps one wide lookup environment" closure_test_wide_source
    , ClosureLawResult "raw constructor closure builds one wide lookup environment" closure_test_wide_raw
    , closure_test_shape "bare constructor becomes typed lambda" (CConstruct 40 0 0)
        (CLam(closure_test_nat, CApp(CConstruct 40 0 0, CRel 0)))
    , closure_test_shape("nullary remains identical", CConstruct 10 0 0, CConstruct 10 0 0)
    , closure_test_shape "saturated constructor remains identical"
        (CApp(CConstruct 40 0 0, closure_test_number 2))
        (CApp(CConstruct 40 0 0, closure_test_number 2))
    , closure_test_shape "provided field sits outside closure"
        (CApp(CConstruct 30 0 0, closure_test_number 7))
        (CLetIn (closure_test_number 7) closure_test_nat
          (CLam(closure_test_nat, CApp(CApp(CConstruct 30 0 0, CRel 1), CRel 0))))
    , closure_test_shape "open argument survives both new binders"
        (CApp(CConstruct 30 0 0, CRel 0))
        (CLetIn (CRel 0) closure_test_nat
          (CLam(closure_test_nat, CApp(CApp(CConstruct 30 0 0, CRel 1), CRel 0))))
    , closure_test_shape "type parameter annotates introduced lambda"
        (CApp(CConstruct 50 0 1, closure_test_nat))
        (CLam(closure_test_nat, CApp(CApp(CConstruct 50 0 1, closure_test_nat), CRel 0)))
    , closure_test_shape "Nat index parameter remains erased"
        (CApp(CConstruct 60 0 1, closure_test_number 3))
        (CLam(closure_test_nat, CApp(CApp(CConstruct 60 0 1, closure_test_number 3), CRel 0)))
    , closure_test_shape "type annotations remain exact"
        (CLam(CApp(CInd 120, CConstruct 40 0 0), CRel 0))
        (CLam(CApp(CInd 120, CConstruct 40 0 0), CRel 0))
    , ClosureLawResult "conversion preserves each checked input type"
        (foldr ConstructorCase Bool (fun (test : ConstructorCase) (rest : Bool) =>
          match test with
          | ConstructorCaseInput _ typ input =>
              andb (match check_term_checked closure_test_fuel closure_test_sig (Nil CoreTerm) input typ with
                    | CheckOk _ => True
                    | CheckErr _ => False
                    end) rest
          end) True closure_test_cases)
    , ClosureLawResult "conversion is idempotent"
        (foldr ConstructorCase Bool (fun (test : ConstructorCase) (rest : Bool) => andb(closure_test_idempotent test, rest))
          True closure_test_cases)
    , closure_test_error "unknown inductive fails" (ConstructorClosureMissing 999 0)
        (constructor_close closure_test_fuel closure_test_sig (CConstruct 999 0 0))
    , closure_test_error "unknown constructor index fails" (ConstructorClosureMissing 40 2)
        (constructor_close closure_test_fuel closure_test_sig (CConstruct 40 2 0))
    , closure_test_error "constructor parameter count mismatch fails" (ConstructorClosureMalformed 50 0)
        (constructor_close closure_test_fuel closure_test_sig (CConstruct 50 0 0))
    , closure_test_error "overapplied nullary fails" (ConstructorClosureOverapplied 10 0)
        (constructor_close closure_test_fuel closure_test_sig (CApp(CConstruct 10 0 0, closure_test_number 1)))
    , closure_test_error "overapplied unary fails" (ConstructorClosureOverapplied 40 0)
        (constructor_close closure_test_fuel closure_test_sig
          (CApp(CApp(CConstruct 40 0 0, closure_test_number 1), closure_test_number 2)))
    , closure_test_error "wrong constructor result family fails" (ConstructorClosureMalformed 110 0)
        (constructor_close(closure_test_fuel, closure_test_bad_sig (CInd 40), CConstruct 110 0 0))
    , closure_test_error "malformed type application propagates" (ConstructorClosureMalformed 110 0)
        (constructor_close(closure_test_fuel, closure_test_bad_sig (CApp(CSort 0, CSort 0)), CConstruct 110 0 0))
    , closure_test_error "zero fuel cannot return unchanged input" ConstructorClosureExhausted
        (constructor_close 0 closure_test_sig (CConstruct 10 0 0))
    , closure_test_error "constructor telescope exhaustion propagates" ConstructorClosureExhausted
        (constructor_close 2 closure_test_sig (CConstruct 30 0 0))
    , closure_test_error "nested callback failure propagates" (ConstructorClosureMissing 40 2)
        (constructor_close closure_test_fuel closure_test_sig (CApp(CConstruct 80 0 0, CConstruct 40 2 0)))
    , closure_test_error "branch failure propagates" (ConstructorClosureMissing 40 2)
        (constructor_close closure_test_fuel closure_test_sig
          (CCase (MkCaseInfo 10 0 ([0, 1] : List Nat)) (CLam closure_test_nat closure_test_box)
            (closure_test_number 0) ([CConstruct 40 2 0, CLam(closure_test_nat, CRel 0)] : List CoreTerm)))
    , ClosureLawResult "closure conversion does not accept wrong field type"
        (match constructor_close closure_test_fuel closure_test_sig
            (CApp(CConstruct 30 0 0, CApp(CConstruct 40 0 0, closure_test_number 1))) with
         | Left _ => True
         | Right output =>
             match check_term_checked closure_test_fuel closure_test_sig (Nil CoreTerm) output (CPi(closure_test_nat, CInd 30)) with
             | CheckOk _ => False
             | CheckErr failure =>
                 match failure with
                 | CheckTypeFailure fault =>
                     match fault with
                     | CheckTypeMismatch => True
                     | CheckExpectedSort => False
                     | CheckExpectedFunction => False
                     | CheckCaseMotive => False
                     | CheckNonPositive => False
                     | CheckNonTerminating => False
                     | CheckUniverseBound => False
                     end
                 | CheckMalformedCore _ => False
                 | CheckReductionFailure _ => False
                 | CheckResourceLimit => False
                 | CheckUnsupported _ => False
                 | CheckCancelled => False
                 | CheckInternalFailure _ => False
                 | CheckPrimitiveFailure _ => False
                 end
             end
         end)
    ];

def closure_test_run : List ClosureLaw -> Bool -> IO Unit :=
  fix closure_test_run (laws : List ClosureLaw) (failed : Bool) : IO Unit :=
    match laws with
    | Nil => exit (match failed with | True => 1 | False => 0 end)
    | Cons law rest =>
        match law with
        | ClosureLawResult name passed =>
            do println (prim_string_concat(match passed with | True => "ok " | False => "FAIL " end, name));
               closure_test_run(rest, orb(failed, notb passed))
        end
    end;

def closure_test_pieces : List ConstructorCase -> Nat
    -> Either ConstructorClosureError (List (Pair Nat CoreTerm)) :=
  fix closure_test_pieces (tests : List ConstructorCase) (name : Nat)
      : Either ConstructorClosureError (List (Pair Nat CoreTerm)) :=
    match tests with
    | Nil => Right(ConstructorClosureError, List (Pair Nat CoreTerm), Nil (Pair Nat CoreTerm))
    | Cons test rest =>
        match test with
        | ConstructorCaseInput _ _ input =>
            match constructor_close closure_test_fuel closure_test_sig input with
            | Left err => Left ConstructorClosureError (List (Pair Nat CoreTerm)) err
            | Right output =>
                mapRight ConstructorClosureError (List (Pair Nat CoreTerm)) (List (Pair Nat CoreTerm))
                  (fun (tail : List (Pair Nat CoreTerm)) => Cons(Pair Nat CoreTerm, MkPair Nat CoreTerm name output, tail))
                  (closure_test_pieces(rest, S name))
            end
        end
    end;

def closure_test_emit : IO Unit :=
    match closure_test_pieces closure_test_cases 100 with
    | Left error => do eprintln (prim_string_concat("constructor conversion failed: ", prim_string_of_nat (closure_test_error_code error))); exit 1
    | Right pieces => print (prim_string_of_char_codes (pieces_to_c pieces))
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match eqNat(length String arguments, 1) with
       | True => closure_test_run
           (append ClosureLaw (map ConstructorCase ClosureLaw closure_test_checked closure_test_cases) closure_test_laws) False
       | False =>
           match compiler_nth String arguments 1 with
           | Nothing => do eprintln "usage: constructor_closure_tests [--emit]"; exit 2
           | Just flag =>
               match andb(eqNat(length String arguments, 2), prim_string_eq flag "--emit") with
               | True => closure_test_emit
               | False => do eprintln "usage: constructor_closure_tests [--emit]"; exit 2
               end
           end
       end
