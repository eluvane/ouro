-- Closed primitive identity, signature, ABI, role and layout regressions.
-- Expected Core signatures and key spellings are independent fixture data.
import "../compiler/primitive_registry.ouro";
import "../std/test.ouro";

def pr_nf (fuel : Nat) (term : CoreTerm) : Either PrimitiveError CoreTerm :=
    match fuel with | Z => Left PrimitiveError CoreTerm PrimitiveResourceExhausted
    | S _ => Right PrimitiveError CoreTerm term end;

def pr_alias_nf : Nat -> CoreTerm -> Either PrimitiveError CoreTerm :=
  fix pr_alias_nf (fuel : Nat) (term : CoreTerm) : Either PrimitiveError CoreTerm :=
    match fuel with | Z => Left PrimitiveError CoreTerm PrimitiveResourceExhausted
    | S next => match term with
      | CConst name => Right PrimitiveError CoreTerm
          (match eqNat name 90 with | True => CSort 0 | False =>
           match eqNat name 91 with | True => CConst 11 | False =>
           match eqNat name 92 with | True => CConst 15 | False =>
           match eqNat name 93 with | True => CConst 16 | False =>
           match eqNat name 94 with | True => CInd 42 | False =>
           match eqNat name 95 with | True => CInd 50 | False => term end end end end end end)
      | CPi a b => primitive_bind CoreTerm CoreTerm (pr_alias_nf next a)
          (fun (x : CoreTerm) => primitive_map CoreTerm CoreTerm (fun (y : CoreTerm) => CPi x y) (pr_alias_nf next b))
      | CApp a b => primitive_bind CoreTerm CoreTerm (pr_alias_nf next a)
          (fun (x : CoreTerm) => primitive_map CoreTerm CoreTerm (fun (y : CoreTerm) => CApp x y) (pr_alias_nf next b))
      | CRel _ => Right PrimitiveError CoreTerm term | CSort _ => Right PrimitiveError CoreTerm term
      | CInd _ => Right PrimitiveError CoreTerm term | CConstruct _ _ _ => Right PrimitiveError CoreTerm term
      | CLam _ _ => Right PrimitiveError CoreTerm term | CLetIn _ _ _ => Right PrimitiveError CoreTerm term
      | CCase _ _ _ _ => Right PrimitiveError CoreTerm term | CFix _ _ _ _ _ => Right PrimitiveError CoreTerm term
      | CStrBytes _ _ => Right PrimitiveError CoreTerm term
      | CStrLit _ _ => Right PrimitiveError CoreTerm term end end;

def pr_nf_error (_fuel : Nat) (_term : CoreTerm) : Either PrimitiveError CoreTerm :=
    Left PrimitiveError CoreTerm PrimitiveResourceExhausted;

def pr_bindings : List PrimitiveResolved :=
    [PrimitiveResolvedAs 10 PrimitiveU8Type (CSort 0), PrimitiveResolvedAs 11 PrimitiveU32Type (CSort 0),
     PrimitiveResolvedAs 12 PrimitiveU64Type (CSort 0), PrimitiveResolvedAs 13 PrimitiveI32Type (CSort 0),
     PrimitiveResolvedAs 14 PrimitiveUSizeType (CSort 0),
     PrimitiveResolvedAs 15 PrimitiveRawPtrType (CPi (CSort 0) (CSort 0)),
     PrimitiveResolvedAs 16 PrimitiveRuntimeType (CPi (CSort 0) (CSort 0)),
     PrimitiveResolvedAs 17 PrimitiveRawFnType (CPi (CSort 0) (CSort 0)),
     PrimitiveResolvedAs 18 PrimitiveStringType (CSort 0)];

def pr_roles : List PrimitiveRoleBinding :=
    [PrimitiveRoleOf PrimitiveNatRole (PrimitiveInductiveOf 40 0 0 (CSort 0)
        ([CInd 40, CPi (CInd 40) (CInd 40)] : List CoreTerm)),
     PrimitiveRoleOf PrimitiveBoolRole (PrimitiveInductiveOf 41 0 0 (CSort 0)
        ([CInd 41, CInd 41] : List CoreTerm)),
     PrimitiveRoleOf PrimitiveUnitRole (PrimitiveInductiveOf 42 0 0 (CSort 0)
        ([CInd 42] : List CoreTerm)),
     PrimitiveRoleOf PrimitiveListRole (PrimitiveInductiveOf 43 1 0 (CPi (CSort 0) (CSort 0))
        ([CPi (CSort 0) (CApp (CInd 43) (CRel 0)),
          CPi (CSort 0) (CPi (CRel 0) (CPi (CApp (CInd 43) (CRel 1)) (CApp (CInd 43) (CRel 2))))] : List CoreTerm)),
     PrimitiveRoleOf PrimitiveMaybeRole (PrimitiveInductiveOf 44 1 0 (CPi (CSort 0) (CSort 0))
        ([CPi (CSort 0) (CApp (CInd 44) (CRel 0)),
          CPi (CSort 0) (CPi (CRel 0) (CApp (CInd 44) (CRel 1)))] : List CoreTerm)),
     PrimitiveRoleOf PrimitivePairRole (PrimitiveInductiveOf 45 2 0 (CPi (CSort 0) (CPi (CSort 0) (CSort 0)))
        ([CPi (CSort 0) (CPi (CSort 0) (CPi (CRel 1) (CPi (CRel 1)
          (CApp (CApp (CInd 45) (CRel 3)) (CRel 2)))))] : List CoreTerm))];

def pr_error_text (err : PrimitiveError) : String :=
    match err with
    | PrimitiveResourceExhausted => "fuel" | PrimitiveUnknownKey => "key"
    | PrimitiveMissingType id => str_concat "missing:" (str_of_codes (primitive_key id))
    | PrimitiveDuplicateType id => str_concat "duplicate:" (str_of_codes (primitive_key id))
    | PrimitiveDuplicateName name => str_concat "name:" (str_of_nat name)
    | PrimitiveInvalidTypeBinding name => str_concat "binding:" (str_of_nat name)
    | PrimitiveMissingRole role => str_concat "missing-role:" (str_of_nat (primitive_role_code role))
    | PrimitiveDuplicateRole role => str_concat "duplicate-role:" (str_of_nat (primitive_role_code role))
    | PrimitiveInvalidRole role => str_concat "role:" (str_of_nat (primitive_role_code role))
    | PrimitiveUnsupportedTarget => "target" | PrimitiveUnsupportedAbi => "abi"
    | PrimitiveInvalidExternName => "extern-name" | PrimitiveVariadicExtern => "variadic"
    | PrimitiveDependentAbi => "dependent" | PrimitiveUnsupportedAbiType => "value-type"
    | PrimitiveRuntimeResultRequired => "runtime-result" | PrimitiveInvalidFunctionPointer => "fn-pointer"
    | PrimitiveSpecializationRequired => "specialization" | PrimitiveUnexpectedSpecialization => "unexpected-spec"
    | PrimitiveInvalidConversion => "conversion"
    | PrimitiveInvalidLayout fault => match fault with
      | PrimitiveLayoutSize => "layout-size" | PrimitiveLayoutAlignment => "layout-align"
      | PrimitiveLayoutFieldRange id => str_concat "field-range:" (str_of_nat id)
      | PrimitiveLayoutFieldAlignment id => str_concat "field-align:" (str_of_nat id)
      | PrimitiveLayoutFieldOverlap id => str_concat "field-overlap:" (str_of_nat id)
      | PrimitiveLayoutDuplicateField id => str_concat "field-duplicate:" (str_of_nat id) end end;

def pr_error (A : Type) (name : String) (expected : PrimitiveError) (got : Either PrimitiveError A) : Test :=
    match got with | Left err => assert_eq name (pr_error_text err) (pr_error_text expected)
    | Right _ => test_fail name "invalid input accepted" end;

def pr_ok (A : Type) (name : String) (got : Either PrimitiveError A) : Test :=
    match got with | Left err => test_fail name (pr_error_text err) | Right _ => test_ok name end;

def pr_core_text : Nat -> CoreTerm -> String :=
  fix pr_core_text (fuel : Nat) (term : CoreTerm) : String :=
    match fuel with | Z => "depth" | S next => match term with
    | CRel id => str_concat "r" (str_of_nat id) | CSort id => str_concat "s" (str_of_nat id)
    | CConst id => str_concat "c" (str_of_nat id) | CInd id => str_concat "i" (str_of_nat id)
    | CPi a b => str_cat4 "Pi(" (pr_core_text next a) "," (str_concat (pr_core_text next b) ")")
    | CApp a b => str_cat4 "App(" (pr_core_text next a) "," (str_concat (pr_core_text next b) ")")
    | CLam _ _ => "lambda" | CLetIn _ _ _ => "let" | CConstruct _ _ _ => "constructor"
    | CCase _ _ _ _ => "case" | CFix _ _ _ _ _ => "fix" | CStrBytes _ _ => "string-bytes" | CStrLit _ _ => "string" end end;

def pr_signature_result (name : String) (expected : CoreTerm) (got : Either PrimitiveError CoreTerm) : Test :=
    match got with | Left err => test_fail name (pr_error_text err)
    | Right term => assert_eq name (pr_core_text 64 term) (pr_core_text 64 expected) end;

def pr_expected (id : PrimitiveId) : Either PrimitiveError CoreTerm :=
    primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles id (Nothing CoreTerm);

def pr_signature (name : String) (id : PrimitiveId) (expected : CoreTerm) : Test :=
    pr_signature_result name expected (pr_expected id);

def pr_word_specs : List (Pair PrimitiveWord String) :=
    [MkPair PrimitiveWord String PrimitiveWordU8 "u8", MkPair PrimitiveWord String PrimitiveWordU32 "u32",
     MkPair PrimitiveWord String PrimitiveWordU64 "u64", MkPair PrimitiveWord String PrimitiveWordI32 "i32",
     MkPair PrimitiveWord String PrimitiveWordUSize "usize"];

def pr_op_specs : List (Pair PrimitiveWordOp String) :=
    [MkPair PrimitiveWordOp String PrimitiveAddWrap "add.wrap", MkPair PrimitiveWordOp String PrimitiveSubWrap "sub.wrap",
     MkPair PrimitiveWordOp String PrimitiveMulWrap "mul.wrap", MkPair PrimitiveWordOp String PrimitiveBitAnd "and",
     MkPair PrimitiveWordOp String PrimitiveBitOr "or", MkPair PrimitiveWordOp String PrimitiveBitXor "xor",
     MkPair PrimitiveWordOp String PrimitiveShiftLeft "shl", MkPair PrimitiveWordOp String PrimitiveShiftRight "shr",
     MkPair PrimitiveWordOp String PrimitiveWordEqual "eq", MkPair PrimitiveWordOp String PrimitiveWordLess "lt",
     MkPair PrimitiveWordOp String PrimitiveAddChecked "add.checked", MkPair PrimitiveWordOp String PrimitiveSubChecked "sub.checked",
     MkPair PrimitiveWordOp String PrimitiveMulChecked "mul.checked", MkPair PrimitiveWordOp String PrimitiveDivChecked "div.checked",
     MkPair PrimitiveWordOp String PrimitiveRemChecked "rem.checked"];

def pr_conv_specs : List (Pair PrimitiveConversion String) :=
    [MkPair PrimitiveConversion String PrimitiveNarrowWrap "narrow.wrap",
     MkPair PrimitiveConversion String PrimitiveZeroExtend "zext", MkPair PrimitiveConversion String PrimitiveSignExtend "sext",
     MkPair PrimitiveConversion String PrimitiveReinterpret "reinterpret", MkPair PrimitiveConversion String PrimitiveConvertChecked "checked"];

def pr_string_specs : List (Pair PrimitiveStringOp String) :=
    [MkPair PrimitiveStringOp String PrimitiveStringConcat "concat", MkPair PrimitiveStringOp String PrimitiveStringLength "length",
     MkPair PrimitiveStringOp String PrimitiveStringByteAt "byte_at", MkPair PrimitiveStringOp String PrimitiveStringSlice "slice",
     MkPair PrimitiveStringOp String PrimitiveStringEqual "eq", MkPair PrimitiveStringOp String PrimitiveStringOfNat "of_nat",
     MkPair PrimitiveStringOp String PrimitiveStringToCodes "to_char_codes", MkPair PrimitiveStringOp String PrimitiveStringOfCodes "of_char_codes",
     MkPair PrimitiveStringOp String PrimitiveStringStarts "starts", MkPair PrimitiveStringOp String PrimitiveStringEnds "ends",
     MkPair PrimitiveStringOp String PrimitiveStringContains "contains", MkPair PrimitiveStringOp String PrimitiveStringIndex "index",
     MkPair PrimitiveStringOp String PrimitiveStringSplit "split", MkPair PrimitiveStringOp String PrimitiveStringReplace "replace",
     MkPair PrimitiveStringOp String PrimitiveStringLessEqual "le", MkPair PrimitiveStringOp String PrimitiveStringTokens "tokens"];

