    [MkPair PrimitiveId String PrimitiveU8Type "ouro.u8", MkPair PrimitiveId String PrimitiveU32Type "ouro.u32",
     MkPair PrimitiveId String PrimitiveU64Type "ouro.u64", MkPair PrimitiveId String PrimitiveI32Type "ouro.i32",
     MkPair PrimitiveId String PrimitiveUSizeType "ouro.usize", MkPair PrimitiveId String PrimitiveRawPtrType "ouro.raw_ptr",
     MkPair PrimitiveId String PrimitiveRuntimeType "ouro.runtime", MkPair PrimitiveId String PrimitiveRawFnType "ouro.raw_fn",
     MkPair PrimitiveId String PrimitiveStringType "ouro.string", MkPair PrimitiveId String PrimitiveRuntimePure "ouro.runtime.pure",
     MkPair PrimitiveId String PrimitiveRuntimeBind "ouro.runtime.bind", MkPair PrimitiveId String PrimitiveRuntimeLoop "ouro.runtime.loop",
     MkPair PrimitiveId String PrimitiveRawNull "ouro.raw.null", MkPair PrimitiveId String PrimitiveRawLoad "ouro.raw.load",
     MkPair PrimitiveId String PrimitiveRawStore "ouro.raw.store", MkPair PrimitiveId String PrimitiveRawAddWrap "ouro.raw.add.wrap",
     MkPair PrimitiveId String PrimitiveRawCast "ouro.raw.cast", MkPair PrimitiveId String PrimitiveRawToBits "ouro.raw.to_bits",
     MkPair PrimitiveId String PrimitiveRawFromBits "ouro.raw.from_bits", MkPair PrimitiveId String PrimitiveFnCall "ouro.fn.call",
     MkPair PrimitiveId String PrimitiveStdoutWrite "ouro.runtime.stdout.write",
     MkPair PrimitiveId String PrimitiveStderrWrite "ouro.runtime.stderr.write",
     MkPair PrimitiveId String PrimitiveStdoutFlush "ouro.runtime.stdout.flush",
     MkPair PrimitiveId String PrimitiveProcessExit "ouro.runtime.exit",
     MkPair PrimitiveId String PrimitiveArgv "ouro.runtime.argv",
     MkPair PrimitiveId String PrimitiveEnvGet "ouro.runtime.env_get",
     MkPair PrimitiveId String PrimitiveTimeNow "ouro.time.now",
     MkPair PrimitiveId String PrimitiveStdinReadLine "ouro.runtime.stdin.read_line",
     MkPair PrimitiveId String PrimitiveStdinReadBytes "ouro.runtime.stdin.read_bytes",
     MkPair PrimitiveId String PrimitiveFileRead "ouro.fs.read_file",
     MkPair PrimitiveId String PrimitiveFileWrite "ouro.fs.write_file",
     MkPair PrimitiveId String PrimitiveFileKind "ouro.fs.kind",
     MkPair PrimitiveId String PrimitiveFileExists "ouro.fs.exists",
     MkPair PrimitiveId String PrimitiveFileIsDirectory "ouro.fs.is_dir",
     MkPair PrimitiveId String PrimitiveFileRealpath "ouro.fs.realpath",
     MkPair PrimitiveId String PrimitiveFileTemp "ouro.fs.temp_file",
     MkPair PrimitiveId String PrimitiveFileTempIn "ouro.fs.temp_file_in",
     MkPair PrimitiveId String PrimitiveProcessInherit "ouro.process.inherit",
     MkPair PrimitiveId String PrimitiveProcessCapture "ouro.process.capture",
     MkPair PrimitiveId String PrimitiveHttpPost "ouro.http.post",
     MkPair PrimitiveId String PrimitiveDirectoryList "ouro.fs.list_dir",
     MkPair PrimitiveId String PrimitiveDirectoryListable "ouro.fs.listable",
     MkPair PrimitiveId String PrimitiveDirectoryCreate "ouro.fs.mkdir",
     MkPair PrimitiveId String PrimitivePathRemove "ouro.fs.remove",
     MkPair PrimitiveId String PrimitiveFileCopy "ouro.fs.copy_file",
     MkPair PrimitiveId String PrimitiveFileRename "ouro.fs.rename"];

def pr_all_specs : List (Pair PrimitiveId String) :=
    append (Pair PrimitiveId String) pr_fixed_specs
      (append (Pair PrimitiveId String)
        (concat_map (Pair PrimitiveWord String) (Pair PrimitiveId String)
          (fun (word_spec : Pair PrimitiveWord String) => match word_spec with | MkPair word word_name =>
            let prefix : String := str_cat3 "ouro." word_name "." in
            append (Pair PrimitiveId String)
              (map (Pair PrimitiveWordOp String) (Pair PrimitiveId String)
                (fun (op_spec : Pair PrimitiveWordOp String) => match op_spec with | MkPair op name =>
                  MkPair PrimitiveId String (PrimitiveWordOperation word op) (str_concat prefix name) end) pr_op_specs)
              ([MkPair PrimitiveId String (PrimitiveWordFromNat word) (str_concat prefix "from_nat.checked"),
                MkPair PrimitiveId String (PrimitiveWordToNat word) (str_concat prefix "to_nat.bits")] : List (Pair PrimitiveId String)) end) pr_word_specs)
        (append (Pair PrimitiveId String)
          (concat_map (Pair PrimitiveWord String) (Pair PrimitiveId String)
            (fun (source_spec : Pair PrimitiveWord String) => match source_spec with | MkPair source source_name =>
              concat_map (Pair PrimitiveWord String) (Pair PrimitiveId String)
                (fun (dest_spec : Pair PrimitiveWord String) => match dest_spec with | MkPair dest dest_name =>
                  map (Pair PrimitiveConversion String) (Pair PrimitiveId String)
                    (fun (mode_spec : Pair PrimitiveConversion String) => match mode_spec with | MkPair mode mode_name =>
                      MkPair PrimitiveId String (PrimitiveWordConversion source dest mode)
                        (str_cat4 "ouro.convert." source_name "." (str_cat3 dest_name "." mode_name)) end) pr_conv_specs end) pr_word_specs end) pr_word_specs)
          (map (Pair PrimitiveStringOp String) (Pair PrimitiveId String)
            (fun (spec : Pair PrimitiveStringOp String) => match spec with | MkPair op name =>
              MkPair PrimitiveId String (PrimitiveStringOperation op) (str_concat "ouro.string." name) end) pr_string_specs)));

def pr_key_test (spec : Pair PrimitiveId String) : Test :=
    match spec with | MkPair id name => match primitive_decode primitive_default_fuel (str_codes name) with
      | Left err => test_fail name (pr_error_text err)
      | Right decoded => assert_true name (andb (primitive_id_equal id decoded)
          (str_eq (str_of_codes (primitive_key id)) name)) end end;

def pr_unique_ids : List PrimitiveId -> Bool :=
  fix pr_unique_ids (ids : List PrimitiveId) : Bool :=
    match ids with | Nil => True | Cons id tail =>
      andb (notb (any PrimitiveId (fun (other : PrimitiveId) => primitive_id_equal id other) tail)) (pr_unique_ids tail) end;

def pr_unique_keys : List (Pair PrimitiveId (List Nat)) -> Bool :=
  fix pr_unique_keys (entries : List (Pair PrimitiveId (List Nat))) : Bool :=
    match entries with | Nil => True | Cons entry tail => match entry with | MkPair _ key =>
      andb (notb (any (Pair PrimitiveId (List Nat))
        (fun (other : Pair PrimitiveId (List Nat)) => match other with | MkPair _ bytes => primitive_bytes_equal key bytes end) tail))
        (pr_unique_keys tail) end end;

def pr_word_type (word : PrimitiveWord) : CoreTerm :=
    match word with | PrimitiveWordU8 => CConst 10 | PrimitiveWordU32 => CConst 11
    | PrimitiveWordU64 => CConst 12 | PrimitiveWordI32 => CConst 13 | PrimitiveWordUSize => CConst 14 end;

def pr_word_signature (word : PrimitiveWord) (op : PrimitiveWordOp) : CoreTerm :=
    let typ : CoreTerm := pr_word_type word in
    match op with
    | PrimitiveShiftLeft => CPi typ (CPi (CConst 11) typ) | PrimitiveShiftRight => CPi typ (CPi (CConst 11) typ)
    | PrimitiveWordEqual => CPi typ (CPi typ (CInd 41)) | PrimitiveWordLess => CPi typ (CPi typ (CInd 41))
    | PrimitiveAddWrap => CPi typ (CPi typ typ) | PrimitiveSubWrap => CPi typ (CPi typ typ)
    | PrimitiveMulWrap => CPi typ (CPi typ typ) | PrimitiveBitAnd => CPi typ (CPi typ typ)
    | PrimitiveBitOr => CPi typ (CPi typ typ) | PrimitiveBitXor => CPi typ (CPi typ typ)
    | PrimitiveAddChecked => CPi typ (CPi typ (CApp (CInd 44) typ))
    | PrimitiveSubChecked => CPi typ (CPi typ (CApp (CInd 44) typ))
    | PrimitiveMulChecked => CPi typ (CPi typ (CApp (CInd 44) typ))
    | PrimitiveDivChecked => CPi typ (CPi typ (CApp (CInd 44) typ))
    | PrimitiveRemChecked => CPi typ (CPi typ (CApp (CInd 44) typ)) end;

-- Explicit 5x5 matrices: U8,U32,U64,I32,USize; index = source*5+dest.
def pr_conversion_allowed (source : PrimitiveWord) (dest : PrimitiveWord) (mode : PrimitiveConversion) : Bool :=
    let cell : Nat := add (mul 5 (primitive_word_code source)) (primitive_word_code dest) in
    match mode with
    | PrimitiveNarrowWrap => memNat cell ([5, 10, 11, 13, 15, 20, 21, 23] : List Nat)
    | PrimitiveZeroExtend => memNat cell ([1, 2, 3, 4, 7, 9] : List Nat)
    | PrimitiveSignExtend => memNat cell ([17, 19] : List Nat)
    | PrimitiveReinterpret => memNat cell ([0, 6, 8, 12, 14, 16, 18, 22, 24] : List Nat)
    | PrimitiveConvertChecked => notb (memNat cell ([0, 6, 12, 18, 24] : List Nat)) end;
