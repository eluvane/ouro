-- Real collection precedes every release, including failure cleanup. A failed
-- release result is injected only after the original raw page was freed.
import "native_copy_fault_values.ouro";

def copy_fault_release (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 0 state)
      (fun (closed : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_load base 8 MirUSize closed)
        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf releases next =>
          lower_bind ManagedResult ManagedResult (startup_fault_load base 112 MirUSize next)
            (fun (counted : ManagedResult) => match counted with | ManagedResultOf collections after =>
              lower_bind ManagedState ManagedResult (managed_require_equal releases collections after)
                (fun (ordered : ManagedState) => lower_bind ManagedResult ManagedResult (managed_fresh MirRawPtr MirManagedContext ordered)
                  (fun (context : ManagedResult) => match context with | ManagedResultOf heap entered =>
                    lower_bind ManagedResult ManagedResult (startup_fault_call MirU8 (add base 5) ([heap] : List MirValue) entered)
                      (fun (collected : ManagedResult) => match collected with | ManagedResultOf okay final =>
                        lower_bind ManagedState ManagedResult (managed_require_equal okay (managed_bits MirU8 1) final)
                          (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 112 checked)
                            (fun (forced : ManagedResult) => match forced with | ManagedResultOf _ ready =>
                              lower_bind ManagedState ManagedResult (startup_fault_pop base (MirUse 0) ready)
                                (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult
                                  (startup_fault_call MirU8 original ([MirUse 0] : List MirValue) owned)
                                  (fun (released : ManagedResult) => match released with | ManagedResultOf freed freed_state =>
                                    lower_bind ManagedState ManagedResult (managed_require_equal freed (managed_bits MirU8 1) freed_state)
                                      (fun (success : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 8 success)
                                        (fun (counted : ManagedResult) => match counted with | ManagedResultOf attempt finished =>
                                          match orb (eqNat mode 17) (eqNat mode 18) with
                                          | False => startup_fault_result MirU8 1 finished
                                          | True => managed_compare MirNotEqual attempt (managed_bits MirUSize 1) finished end end)) end)) end)) end) end)) end) end));

def copy_fault_copy_arguments (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedState ManagedState (startup_fault_stat base 64 6 state)
      (fun (owned : ManagedState) => lower_bind ManagedState ManagedState (copy_fault_conversion_count base (managed_bits MirUSize 4) owned)
        (fun (ordered : ManagedState) => lower_bind ManagedState ManagedState (copy_fault_pointer base 2 (MirUse 0) ordered)
          (fun (source : ManagedState) => lower_bind ManagedState ManagedState (managed_require_equal (MirUse 1) (managed_bits MirUSize 12) source)
            (fun (sized : ManagedState) => lower_bind ManagedState ManagedState (copy_fault_pointer base 5 (MirUse 2) sized)
              (fun (target : ManagedState) => managed_require_equal (MirUse 3) (managed_bits MirUSize (copy_fault_target_bytes mode)) target)))));

def copy_fault_copy (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (copy_fault_copy_arguments base mode state)
      (fun (ordered : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 16 ordered)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
          match orb (eqNat mode 15) (eqNat mode 18) with | True => startup_fault_result MirU32 5 next
          | False => match eqNat mode 16 with | True => startup_fault_result MirU32 87 next
            | False => lower_bind ManagedResult ManagedResult (startup_fault_count base 24 next)
                (fun (real : ManagedResult) => match real with | ManagedResultOf _ entered =>
                  lower_bind ManagedResult ManagedResult
                    (startup_fault_call MirU32 original ([MirUse 0, MirUse 1, MirUse 2, MirUse 3] : List MirValue) entered)
                    (fun (copied : ManagedResult) => match copied with | ManagedResultOf status after =>
                      lower_bind ManagedResult ManagedResult (managed_compare MirEqual status (managed_bits MirU32 0) after)
                        (fun (tested : ManagedResult) => match tested with | ManagedResultOf okay final =>
                          lower_map ManagedState ManagedResult (fun (checked : ManagedState) => ManagedResultOf status checked)
                            (managed_require_equal okay (managed_bits MirU8 (match eqNat mode 23 with | True => 0 | False => 1 end)) final) end) end) end) end end end));

def copy_fault_allocations (mode : Nat) : Nat :=
    match andb (leb_nat 1 mode) (leb_nat mode 6) with | True => mode | False =>
    match orb (eqNat mode 7) (eqNat mode 10) with | True => 2 | False =>
    match orb (eqNat mode 8) (orb (eqNat mode 9) (eqNat mode 20)) with | True => 3 | False =>
    match orb (eqNat mode 11) (eqNat mode 14) with | True => 5 | False =>
    match orb (eqNat mode 19) (eqNat mode 21) with | True => 0 | False =>
    match eqNat mode 22 with | True => 18 | False => 6 end end end end end end;

def copy_fault_conversion_calls (mode : Nat) : Nat :=
    match orb (eqNat mode 1) (orb (eqNat mode 2) (orb (eqNat mode 19) (eqNat mode 21))) with | True => 0 | False =>
    match orb (eqNat mode 3) (orb (eqNat mode 7) (eqNat mode 10)) with | True => 1 | False =>
    match orb (eqNat mode 4) (orb (eqNat mode 5) (orb (eqNat mode 8) (orb (eqNat mode 9) (eqNat mode 20)))) with | True => 2 | False =>
    match orb (eqNat mode 6) (orb (eqNat mode 11) (eqNat mode 14)) with | True => 3 | False =>
    match eqNat mode 22 with | True => 12 | False => 4 end end end end end;

def copy_fault_copy_calls (mode : Nat) : Nat :=
    match eqNat mode 22 with | True => 3 | False =>
      match orb (eqNat mode 0) (orb (andb (leb_nat 15 mode) (leb_nat mode 18)) (eqNat mode 23)) with
      | True => 1 | False => 0 end end;

def copy_fault_exit_checks (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let success : Bool := orb (eqNat mode 0) (orb (eqNat mode 21) (eqNat mode 22)) in
    let allocations : Nat := copy_fault_allocations mode in
    let releases : Nat := sub allocations (match andb (leb_nat 1 mode) (leb_nat mode 6) with | True => 1 | False => 0 end) in
    let copies : Nat := copy_fault_copy_calls mode in
    let real : Nat := match orb (eqNat mode 15) (orb (eqNat mode 16) (eqNat mode 18)) with | True => 0 | False => copies end in
    let expected : List (Pair Nat Nat) :=
      [MkPair Nat Nat 0 allocations, MkPair Nat Nat 8 releases, MkPair Nat Nat 16 copies,
       MkPair Nat Nat 24 real, MkPair Nat Nat 40 (copy_fault_conversion_calls mode),
       MkPair Nat Nat 64 0, MkPair Nat Nat 72 0, MkPair Nat Nat 112 releases, MkPair Nat Nat 120 releases] in
    lower_bind ManagedState ManagedState (managed_require_equal (MirUse 0)
      (managed_bits MirU32 (match success with | True => 42 | False => 73 end)) state)
      (fun (exited : ManagedState) => lower_bind ManagedState ManagedState
        ((fix check (remaining : List (Pair Nat Nat)) (current : ManagedState) : Either NativeLowerError ManagedState :=
          match remaining with | Nil => Right NativeLowerError ManagedState current
          | Cons pair rest => match pair with | MkPair offset value =>
              lower_bind ManagedState ManagedState (startup_fault_stat base offset value current)
                (fun (next : ManagedState) => check rest next) end end) expected exited)
        (fun (counted : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 96 MirUSize counted)
          (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf collections next =>
            lower_bind ManagedResult ManagedState (managed_compare MirGreaterEqual collections (managed_bits MirUSize releases) next)
              (fun (tested : ManagedResult) => match tested with | ManagedResultOf enough after =>
                lower_bind ManagedState ManagedState (managed_require_equal enough (managed_bits MirU8 1) after)
                  (fun (collected : ManagedState) => match eqNat mode 22 with
                    | False => Right NativeLowerError ManagedState collected
                    | True => lower_bind ManagedResult ManagedState (startup_fault_load base 104 MirU8 collected)
                        (fun (observed : ManagedResult) => match observed with | ManagedResultOf reclaimed final =>
                          managed_require_equal reclaimed (managed_bits MirU8 1) final end) end) end) end)));

def copy_fault_arguments (index : Nat) : List MirType :=
    match eqNat index 0 with | True => [MirUSize, MirUSize] | False =>
    match orb (eqNat index 1) (eqNat index 5) with | True => [MirRawPtr] | False =>
    match eqNat index 2 with | True => [MirRawPtr, MirUSize, MirRawPtr, MirUSize, MirRawPtr] | False =>
    match eqNat index 3 with | True => [MirRawPtr, MirUSize, MirRawPtr, MirUSize] | False => [MirU32] end end end end;

def copy_fault_wrapper (base : Nat) (mode : Nat) (index : Nat) (original : Nat)
    : Either NativeLowerError MirFunction :=
    let types : List MirType := copy_fault_arguments index in
    let entered : ManagedState := ManagedStateOf 0 ([] : List MirFunction) ([] : List MirData)
      ([] : List Nat) ([] : List Nat) (lower_empty_state (length MirType types)) in
    let body : Either NativeLowerError ManagedResult :=
      match eqNat index 0 with | True => copy_fault_allocate base mode original entered | False =>
      match eqNat index 1 with | True => copy_fault_release base mode original entered | False =>
      match eqNat index 2 with | True => copy_fault_conversion base mode original entered | False =>
      match eqNat index 3 with | True => copy_fault_copy base mode original entered | False =>
      match eqNat index 5 with | True => startup_fault_collector base original entered | False =>
      lower_bind ManagedState ManagedResult (copy_fault_exit_checks base mode entered)
        (fun (checked : ManagedState) => startup_fault_result MirU8 1
          (managed_emit (MirCall MirMayGc (Nothing Nat) (MirDirect original) ([MirUse 0] : List MirValue)) checked)) end end end end end in
    lower_map ManagedResult MirFunction (fun (result : ManagedResult) => match result with | ManagedResultOf value after =>
      match managed_flow after with | LowerStateOf _ locals _ _ =>
        let exiting : Bool := eqNat index 4 in
        let result_type : MirType := match eqNat index 0 with | True => MirRawPtr | False =>
          match orb (eqNat index 1) (eqNat index 5) with | True => MirU8 | False => MirU32 end end in
        MirFunctionDef (add base index) ([99,111,112,121,95,102,97,117,108,116] : List Nat)
          (startup_fault_locals types) (reverse MirLocal locals)
          (match exiting with | True => Nothing MirType | False => Just MirType result_type end) 0
          (lower_finish_blocks (match exiting with | True => MirTrap | False => MirReturn (Just MirValue value) end)
            (managed_flow after)) end end) body;

def copy_fault_wrappers (base : Nat) (mode : Nat) (symbols : List Nat) : Either NativeLowerError (List MirFunction) :=
    (fix build (remaining : List Nat) (index : Nat) : Either NativeLowerError (List MirFunction) :=
      match remaining with | Nil => Right NativeLowerError (List MirFunction) ([] : List MirFunction)
      | Cons original rest => lower_bind MirFunction (List MirFunction) (copy_fault_wrapper base mode index original)
          (fun (wrapper : MirFunction) => lower_map (List MirFunction) (List MirFunction) (Cons MirFunction wrapper)
            (build rest (S index))) end) symbols 0;
