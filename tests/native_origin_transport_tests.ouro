-- @entry main
import "../compiler/native/source_debug.ouro", "compiler_program_lookup.ouro",
  "compiler_startup_test_support.ouro", "compiler_test_phase.ouro";

def native_origin_transport_source : String :=
    "inductive Token : Type := | Here : Token; def make (saved : Token) : Token -> Token := fun (other : Token) => saved; def identity (value : Token) : Token := value;";

def native_origin_transport_state (capture : NativeOriginCapture) : ManagedState :=
    ManagedStateOf 2000 ([] : List MirFunction) ([] : List MirData) ([] : List Nat) ([] : List Nat)
      (lower_empty_state 0) capture;

def native_origin_transport_count (source : Nat) (rows : List NativeFunctionOrigin) : Nat :=
    length NativeFunctionOrigin (filter NativeFunctionOrigin (fun (row : NativeFunctionOrigin) => match row with
      | NativeFunctionOriginOf _ owner => match owner with
        | NativeFunctionUnknown => False
        | NativeFunctionSource id generated => andb (eqNat source id) generated
        end end) rows);

def native_origin_transport_getter (compiler : ManagedCompiler) (source : Nat) (rows : List NativeFunctionOrigin) : Bool :=
    match native_debug_origin (managed_global_symbol compiler source) rows with
    | Left _ => False
    | Right owner => match owner with
      | NativeFunctionUnknown => False
      | NativeFunctionSource id generated => andb (eqNat source id) generated
      end
    end;

def native_origin_transport_probe (enabled : Bool) : Bool :=
    match compile_checked_source 5000 (prim_string_to_char_codes native_origin_transport_source) with
    | CErr _ => False
    | COk checked => match compiler_test_name checked "make", compiler_test_name checked "identity" with
      | Just maker, Just identity =>
        match checked_program_type_globals_indexed source_normalize_indexed 5000 checked with
        | CErr _ => False
        | COk types =>
          let compiler : ManagedCompiler := ManagedCompilerOf checked types 900 901 902 903 904 1000
            ([] : List LowerContract) (check_environment_from_entries (checked_program_entries checked)) in
          match managed_global_function compiler 5000 maker (native_origin_transport_state
              (match enabled with | False => NativeOriginsDisabled
               | True => NativeOriginsEnabled (Nothing Nat) ([] : List NativeFunctionOrigin) end)) with
          | Left _ => False
          | Right before => match managed_global_function compiler 5000 identity before with
            | Left _ => False
            | Right after => match after with | ManagedStateOf _ functions _ _ _ _ capture =>
              let rows : List NativeFunctionOrigin := native_origins_rows capture in
              andb (eqNat (length MirFunction functions) 5)
                (match enabled with
                 | False => andb (nullb NativeFunctionOrigin rows)
                     (match capture with | NativeOriginsDisabled => True | NativeOriginsEnabled _ _ => False end)
                 | True => andb (eqNat (length NativeFunctionOrigin rows) 5)
                     (andb (eqNat (native_origin_transport_count maker rows) 3)
                       (andb (eqNat (native_origin_transport_count identity rows) 2)
                         (andb (native_origin_transport_getter compiler maker rows)
                           (andb (native_origin_transport_getter compiler identity rows)
                             (match native_origins_parent capture with | Nothing => True | Just _ => False end)))))
                 end)
              end
            end
          end
        end
      | Nothing, Nothing => False
      | Nothing, Just _ => False
      | Just _, Nothing => False
      end
    end;

def native_origin_transport_unknown : Bool :=
    let state : ManagedState := native_origin_transport_state
      (NativeOriginsEnabled (Nothing Nat) ([] : List NativeFunctionOrigin)) in
    let function : MirFunction := MirFunctionDef 77 [102] ([] : List MirLocal) ([] : List MirLocal)
      (Nothing MirType) 0 [MirBlockDef 0 ([] : List MirInstruction) MirTrap] in
    match native_debug_origin 77 (native_origins_rows (managed_origins (managed_add_function function state))) with
    | Left _ => False
    | Right owner => match owner with | NativeFunctionUnknown => True | NativeFunctionSource _ _ => False end
    end;

def native_origin_transport_recheck : Bool :=
    let forged : CheckedProgram := CheckedProgramOf empty_intern
      [MkEntry 1 (CSort 0) (Just CoreTerm (CSort 0))] ([] : List (Pair Nat CoreTerm)) in
    match native_managed_lower_checked 500 mir_default_limits 1 forged,
        native_debug_managed_checked 500 mir_default_limits 1 forged with
    | Left ordinary, Left observed => match ordinary with
      | NativeSourceCheckError _ => False
      | NativeSourceLowerError first_error => match observed with
        | NativeSourceCheckError _ => False
        | NativeSourceLowerError second_error =>
          if let LowerDeclarationFailure first first_phase _ := (first_error : NativeLowerError) then
            if let LowerDeclarationFailure second second_phase _ := (second_error : NativeLowerError) then
              andb (eqNat first second) (eqNat (compiler_test_phase_nat first_phase) (compiler_test_phase_nat second_phase))
            else False
          else False
        end
      end
    | Left _, Right _ => False
    | Right _, Left _ => False
    | Right _, Right _ => False
    end;

def native_origin_transport_restored_parent : Bool :=
    match compile_checked_source 5000 (prim_string_to_char_codes native_origin_transport_source) with
    | CErr _ => False
    | COk checked => match compiler_test_name checked "identity" with
      | Nothing => False
      | Just source => match checked_program_type_globals_indexed source_normalize_indexed 5000 checked with
        | CErr _ => False
        | COk types =>
          let compiler : ManagedCompiler := ManagedCompilerOf checked types 900 901 902 903 904 1000
            ([] : List LowerContract) (check_environment_from_entries (checked_program_entries checked)) in
          match managed_global_function compiler 5000 source (native_origin_transport_state
              (NativeOriginsEnabled (Just Nat 777) ([] : List NativeFunctionOrigin))) with
          | Left _ => False
          | Right after => let capture : NativeOriginCapture := managed_origins after in
              andb (match native_origins_parent capture with | Just id => eqNat id 777 | Nothing => False end)
                (andb (eqNat (native_origin_transport_count source (native_origins_rows capture)) 2)
                  (eqNat (native_origin_transport_count 777 (native_origins_rows capture)) 0))
          end
        end
      end
    end;

def native_origin_transport_state_fields : Bool :=
    let initial : ManagedState := native_origin_transport_state
      (NativeOriginsEnabled (Just Nat 777) [NativeFunctionOriginOf 70 NativeFunctionUnknown]) in
    let flowed : ManagedState := managed_with_flow initial (lower_empty_state 9) in
    match managed_fresh_symbol flowed with
    | Left _ => False
    | Right fresh => match fresh with | MkPair _ reserved =>
      let queued : ManagedState := managed_request_global 42 reserved in
      let stored : ManagedState := managed_add_data (MirDataDef 71 False []) queued in
      let capture : NativeOriginCapture := managed_origins stored in
      andb (match native_origins_parent capture with | Just id => eqNat id 777 | Nothing => False end)
        (andb (eqNat (length NativeFunctionOrigin (native_origins_rows capture)) 1)
          (match native_debug_origin 70 (native_origins_rows capture) with
            | Right owner => match owner with | NativeFunctionUnknown => True | NativeFunctionSource _ _ => False end | Left _ => False end))
      end
    end;

def native_origin_transport_fresh_state (symbol : Nat) : ManagedState :=
    ManagedStateOf symbol
      [MirFunctionDef 77 [102] ([] : List MirLocal) ([] : List MirLocal) (Nothing MirType) 3
        [MirBlockDef 3 ([] : List MirInstruction) MirTrap]]
      [MirDataDef 71 True [7, 8]] [8, 5, 8] [5, 8] (lower_empty_state 9)
      (NativeOriginsEnabled (Just Nat 777) [NativeFunctionOriginOf 70 NativeFunctionUnknown]);

def native_origin_transport_fresh_payload (expected : Nat) (state : ManagedState) : Bool :=
    match state with | ManagedStateOf symbol functions data pending known flow capture =>
      let function_ok : Bool := match functions with
        | Nil => False
        | Cons function rest => andb(nullb MirFunction rest, match function with
          | MirFunctionDef id name args locals result entry blocks =>
              andb(eqNat id 77, andb(pe_bytes_equal name [102],
                andb(nullb MirLocal args, andb(nullb MirLocal locals,
                  andb(match result with | Nothing => True | Just _ => False end,
                    andb(eqNat entry 3, match blocks with
                      | Nil => False
                      | Cons block more => andb(nullb MirBlock more, match block with
                        | MirBlockDef label instructions finish => andb(eqNat label 3,
                            andb(nullb MirInstruction instructions, match finish with
                              | MirTrap => True | MirJump _ => False | MirBranch _ _ _ => False | MirReturn _ => False end))
                        end)
                      end))))))
          end)
        end in
      let data_ok : Bool := match data with
        | Nil => False
        | Cons object rest => andb(nullb MirData rest, match object with
          | MirDataDef id writable bytes => andb(eqNat id 71, andb(writable, pe_bytes_equal bytes [7, 8])) end)
        end in
      let flow_ok : Bool := match flow with | LowerStateOf local locals instructions control =>
        andb(eqNat local 9, andb(nullb MirLocal locals, andb(nullb MirInstruction instructions,
          match control with | LowerFlowOf current label blocks =>
            andb(eqNat current 0, andb(eqNat label 1, nullb MirBlock blocks)) end))) end in
      let capture_ok : Bool := match capture with
        | NativeOriginsDisabled => False
        | NativeOriginsEnabled parent rows => andb(match parent with
            | Nothing => False | Just id => eqNat id 777 end, match rows with
            | Nil => False
            | Cons row rest => andb(nullb NativeFunctionOrigin rest, match row with
              | NativeFunctionOriginOf id owner => andb(eqNat id 70, match owner with
                | NativeFunctionUnknown => True | NativeFunctionSource _ _ => False end) end)
            end)
        end in
      andb(eqNat symbol expected, andb(function_ok, andb(data_ok,
        andb(pe_bytes_equal pending [8, 5, 8], andb(pe_bytes_equal known [5, 8], andb(flow_ok, capture_ok))))))
    end;

def native_origin_transport_fresh_result (key : Nat) : Bool :=
    match managed_fresh_symbol (native_origin_transport_fresh_state key) with
    | Left _ => False
    | Right fresh => match fresh with | MkPair previous state =>
        andb(eqNat previous key, native_origin_transport_fresh_payload (add key 1) state) end
    end;

def native_origin_transport_fresh_sequence : Bool :=
    match managed_fresh_symbol (native_origin_transport_fresh_state 2000) with
    | Left _ => False
    | Right first => match first with | MkPair a after_first =>
      match managed_fresh_symbol after_first with
      | Left _ => False
      | Right second => match second with | MkPair b after_second =>
        match managed_fresh_symbol after_second with
        | Left _ => False
        | Right third => match third with | MkPair c after_third =>
            andb(eqNat a 2000, andb(eqNat b 2001,
              andb(eqNat c 2002, native_origin_transport_fresh_payload 2003 after_third))) end
        end end
      end end
    end;

def native_origin_transport_fresh_exhausted (state : ManagedState) : Bool :=
    match managed_fresh_symbol state with
    | Right _ => False
    | Left err => if let LowerResourceExhausted := (err : NativeLowerError) then True else False
    end;

def native_origin_transport_fresh_boundary : Bool :=
    let last : Nat := sub pe_max_rva 1 in
    match managed_fresh_symbol (native_origin_transport_fresh_state last) with
    | Left _ => False
    | Right fresh => match fresh with | MkPair previous next =>
        andb(eqNat previous last, andb(native_origin_transport_fresh_payload pe_max_rva next,
          native_origin_transport_fresh_exhausted next)) end
    end;

def native_origin_transport_tests : List StartupTest :=
    [startup_test_assert "managed getters and nested closures retain distinct source parents" (native_origin_transport_probe True),
     startup_test_assert "disabled origins retain the same generated function count" (native_origin_transport_probe False),
     startup_test_assert "functions outside a source parent remain unknown" native_origin_transport_unknown,
     startup_test_assert "origin lowering rechecks forged checked inputs" native_origin_transport_recheck,
     startup_test_assert "global lowering restores the enclosing source parent" native_origin_transport_restored_parent,
     startup_test_assert "flow symbol queue and data operations retain origin capture" native_origin_transport_state_fields,
     startup_test_assert "fresh symbol retains its old ID and all seven state fields"
       (native_origin_transport_fresh_result (S (S 2000))),
     startup_test_assert "fresh symbol preserves zero and its next state"
       (native_origin_transport_fresh_result Z),
     startup_test_assert "fresh symbols remain sequential across repeated reservations"
       native_origin_transport_fresh_sequence,
     startup_test_assert "last available RVA succeeds before the exact resource refusal"
       native_origin_transport_fresh_boundary,
     startup_test_assert "fresh symbol rejects the RVA limit and larger complete Nat IDs"
       (andb(native_origin_transport_fresh_exhausted (native_origin_transport_fresh_state pe_max_rva),
         andb(native_origin_transport_fresh_exhausted (native_origin_transport_fresh_state (S pe_max_rva)),
           native_origin_transport_fresh_exhausted (native_origin_transport_fresh_state
             (add (mul (pow_nat 2 32) (pow_nat 2 32)) 17)))))];

def main : IO Unit := startup_test_run native_origin_transport_tests;
