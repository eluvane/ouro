import "native_mir_fixtures.ouro",
  "../std/test.ouro";

def mir_test_error_text (err : MirError) : String :=
    match err with
    | MirResourceExhausted => "resource"
    | MirDuplicateSymbol id => str_concat("duplicate-symbol:", str_of_nat id)
    | MirUnknownSymbol id => str_concat("unknown-symbol:", str_of_nat id)
    | MirDuplicateLocal id => str_concat("duplicate-local:", str_of_nat id)
    | MirUnknownLocal id => str_concat("unknown-local:", str_of_nat id)
    | MirDuplicateBlock id => str_concat("duplicate-block:", str_of_nat id)
    | MirUnknownBlock id => str_concat("unknown-block:", str_of_nat id)
    | MirUninitialized block id => str_cat3(str_concat("uninitialized:", str_of_nat block), ":", str_of_nat id)
    | MirTypeMismatch id => str_concat("type:", str_of_nat id)
    | MirInvalidLiteral => "literal"
    | MirInvalidConversion id => str_concat("conversion:", str_of_nat id)
    | MirInvalidAddress id => str_concat("address:", str_of_nat id)
    | MirInvalidCall id => str_concat("call:", str_of_nat id)
    | MirInvalidReturn id => str_concat("return:", str_of_nat id)
    | MirInvalidEntry id => str_concat("entry:", str_of_nat id)
    | MirInvalidName id => str_concat("name:", str_of_nat id)
    | MirInvalidDisplacement => "displacement"
    | MirInvalidData id => str_concat("data:", str_of_nat id)
    | MirUnreachableBlock id => str_concat("unreachable:", str_of_nat id)
    | MirGcCallMismatch caller target => str_cat3(str_concat("gc-call:", str_of_nat caller), ":", str_of_nat target)
    | MirGcUnsafeRuntime id => str_concat("gc-runtime:", str_of_nat id) end;

def mir_test_reject (name : String) (expected : MirError) (limits : MirLimits) (program : MirProgram) : Test :=
    match mir_validate limits program with
    | Right _ => test_fail name "invalid MIR accepted"
    | Left err => assert_eq(name, mir_test_error_text err, mir_test_error_text expected) end;
def mir_test_bad (name : String) (expected : MirError) (program : MirProgram) : Test :=
    mir_test_reject name expected mir_default_limits program;
def mir_test_accept (name : String) (program : MirProgram) : Test :=
    match mir_validate mir_default_limits program with
    | Right _ => assert_true name True | Left err => test_fail(name, mir_test_error_text err) end;

def mir_test_locals : List MirLocal := [MirLocalDef 10 MirU32, MirLocalDef 11 MirU32, MirLocalDef 12 MirU8,
    MirLocalDef 13 MirRawPtr, MirLocalDef 14 MirManagedPtr, MirLocalDef 15 MirU64, MirLocalDef 16 MirUSize];
def mir_test_blocks (blocks : List MirBlock) : MirProgram := mir_fixture_program (mir_fixture_function mir_test_locals blocks);
def mir_test_ops (instructions : List MirInstruction) : MirProgram := mir_test_blocks
    ([MirBlockDef 0 instructions (MirReturn mir_fixture_no_value)] : List MirBlock);
def mir_test_one (instruction : MirInstruction) : MirProgram := mir_test_ops ([instruction] : List MirInstruction);

def mir_test_diamond (initialize_both : Bool) : MirProgram := mir_test_blocks
    ([MirBlockDef(0, [MirMove(12, mir_fixture_nat MirU8 0)] : List MirInstruction, MirBranch (MirUse 12) 1 2),
      MirBlockDef(1, [MirMove(10, mir_fixture_nat MirU32 1)] : List MirInstruction, MirJump 3),
      MirBlockDef 2 (match initialize_both with | True => ([MirMove(10, mir_fixture_nat MirU32 2)] : List MirInstruction)
        | False => ([] : List MirInstruction) end) (MirJump 3),
      MirBlockDef(3, [MirMove(11, MirUse 10)] : List MirInstruction, MirReturn mir_fixture_no_value)] : List MirBlock);

def mir_test_reverse_blocks (program : MirProgram) : MirProgram :=
    match program with | MirProgramDef functions objects libraries entry =>
      MirProgramDef (map MirFunction MirFunction (fun (function : MirFunction) => match function with
        | MirFunctionDef id name args locals result first blocks =>
          MirFunctionDef id name args locals result first (reverse MirBlock blocks) end) functions)
        objects libraries entry end;

-- Keep many initialized locals live across branch merges. This reproduces
-- the membership-allocation pressure of ordinary managed primitive checks.
def mir_test_wide_locals : List MirLocal :=
    Cons MirLocal (MirLocalDef 10 MirU32)
      ((fix go (count : Nat) : List MirLocal := match count with | Z => [] | S rest =>
        Cons(MirLocal, MirLocalDef(add 100 count, MirU32), go rest) end) 244);

def mir_test_wide_blocks (initialize_both : Bool) : List MirBlock :=
    (fix go (count : Nat) (id : Nat) : List MirBlock := match count with
      | Z => [MirBlockDef(id, [MirMove(101, MirUse 10)] : List MirInstruction, MirReturn mir_fixture_no_value)]
      | S rest =>
        let destination : Nat := match rest with | Z => 10 | S _ => 101 end in
        let assign : List MirInstruction := [MirMove(destination, mir_fixture_nat MirU32 42)] in
        let other : List MirInstruction := match andb(eq_nat destination 10, notb initialize_both) with
          | True => [] | False => assign end in
        append MirBlock ([MirBlockDef id ([] : List MirInstruction)
            (MirBranch(mir_fixture_nat MirU8 1, add id 1, add id 2)),
          MirBlockDef(add id 1, assign, MirJump (add id 3)),
          MirBlockDef(add id 2, other, MirJump (add id 3))] : List MirBlock)
          (go(rest, add id 3)) end) 40 1;

def mir_test_wide_flow (initialize_both : Bool) : MirProgram :=
    let initial : List MirInstruction := map MirLocal MirInstruction
      (fun (local : MirLocal) => MirMove(mir_local_id local, mir_fixture_nat MirU32 0))
      (filter MirLocal (fun (local : MirLocal) => notb (eq_nat(mir_local_id local, 10))) mir_test_wide_locals) in
    mir_fixture_program (mir_fixture_function mir_test_wide_locals
      (Cons(MirBlock, MirBlockDef 0 initial (MirJump 1), mir_test_wide_blocks initialize_both)));

def mir_test_exact_values (name : String) (expected : List Nat) (actual : Either MirError (List Nat)) : Test :=
    match actual with | Left err => test_fail(name, mir_test_error_text err)
    | Right values => assert_true(name, pe_bytes_equal values expected) end;

def mir_test_manual_predecessors : List MirBlock :=
    [MirBlockDef(0, [MirMove(900, mir_fixture_nat MirU32 0)] : List MirInstruction, MirJump 1)];

def mir_test_manual_facts (arguments : List Nat) : Either MirError (List Nat) :=
    match mir_flow_facts 10 0 arguments ([301, 300] : List Nat)
      (append MirBlock mir_test_manual_predecessors
        ([MirBlockDef 1 ([] : List MirInstruction) MirTrap] : List MirBlock)) with
    | Left err => Left MirError (List Nat) err | Right facts => mir_fact_at 1 facts end;

def mir_validation_tests : List Test :=
    [assert_true "MIR set equality accepts identical natural IDs above one byte"
        (mir_set_equal([256, pe_byte2_place] : List Nat, [256, pe_byte2_place] : List Nat)),
      assert_true "MIR set equality accepts permuted natural IDs"
        (mir_set_equal([256, 7, pe_byte2_place] : List Nat, [pe_byte2_place, 256, 7] : List Nat)),
      assert_true "MIR set equality preserves duplicate-insensitive membership"
        (mir_set_equal([256, 256, pe_byte2_place] : List Nat, [pe_byte2_place, 256] : List Nat)),
      assert_true("MIR set equality accepts two empty sets", mir_set_equal([] : List Nat, [] : List Nat)),
      assert_true "MIR set equality distinguishes full natural IDs"
        (notb (mir_set_equal([256, pe_byte2_place] : List Nat, [256, S pe_byte2_place] : List Nat))),
      assert_true "MIR set equality rejects a proper prefix"
        (notb (mir_set_equal([256, pe_byte2_place] : List Nat, [256] : List Nat))),
      assert_true "MIR set equality rejects empty versus repeated elements"
        (notb (mir_set_equal([] : List Nat, [256, 256] : List Nat))),
      mir_test_exact_values "MIR public predecessor helper intersects an arbitrary ordered subset" ([301, 300] : List Nat)
        (mir_predecessor_values 1 ([MirFact(0, [300, 301] : List Nat)] : List MirBlockFact)
          mir_test_manual_predecessors ([301, 300, 2] : List Nat)),
      mir_test_exact_values "MIR public predecessor helper preserves an empty intersection" ([] : List Nat)
        (mir_predecessor_values 1 ([MirFact(0, [300, 301] : List Nat)] : List MirBlockFact)
          mir_test_manual_predecessors ([] : List Nat)),
      mir_test_exact_values "MIR public predecessor helper preserves its no-predecessor input" ([301, 300, 301] : List Nat)
        (mir_predecessor_values(2, [] : List MirBlockFact, mir_test_manual_predecessors, [301, 300, 301] : List Nat)),
      mir_test_exact_values "MIR public flow facts retain intersection with permuted locals" ([300] : List Nat)
        (mir_test_manual_facts ([300] : List Nat)),
      mir_test_exact_values "MIR public flow facts exclude undeclared incoming and generated IDs" ([] : List Nat)
        (mir_test_manual_facts ([900] : List Nat)),
      mir_test_bad "MIR checked flow rejects an undeclared destination before specialization" (MirUnknownLocal 900)
        (mir_fixture_program (mir_fixture_function ([MirLocalDef 300 MirU32] : List MirLocal)
          (append MirBlock mir_test_manual_predecessors ([MirBlockDef 1 ([] : List MirInstruction) MirTrap] : List MirBlock)))) ,
      mir_test_accept "MIR branches and loop reach a definite-assignment fixed point" mir_fixture_control,
      mir_test_accept("MIR cyclic facts converge with reversed block order", mir_test_reverse_blocks mir_fixture_control),
      mir_test_accept("MIR all-predecessor assignment survives reversed block order", mir_test_reverse_blocks (mir_test_diamond True)),
      mir_test_bad "MIR reversed order cannot hide an uninitialized predecessor" (MirUninitialized 3 10)
        (mir_test_reverse_blocks (mir_test_diamond False)),
      mir_test_accept "MIR full-width arithmetic and explicit conversions" mir_fixture_arithmetic,
      mir_test_accept "MIR unsafe memory retains pointer types" mir_fixture_memory,
      mir_test_accept "MIR direct and indirect calls agree with signatures" mir_fixture_calls,
      mir_test_accept "MIR large frame remains within explicit resource budget" mir_fixture_large,
      mir_test_accept("MIR initializes a value on both predecessors", mir_test_diamond True),
      mir_test_bad("MIR branch merge requires initialization on every predecessor", MirUninitialized 3 10, mir_test_diamond False),
      mir_test_bad("MIR read before same-block assignment", MirUninitialized 0 11, mir_test_one (MirMove(10, MirUse 11))),
      mir_test_bad "MIR assignment cannot initialize its own input" (MirUninitialized 0 10)
        (mir_test_one (MirBinaryOp(10, MirAdd, MirUse 10, mir_fixture_nat MirU32 1))),
      mir_test_bad "MIR call cannot initialize its argument retroactively" (MirUninitialized 0 10)
        (mir_test_one (MirCall(MirMayGc, mir_fixture_no_dest, MirDirect 1000, [MirUse 10] : List MirValue))),
      mir_test_bad "MIR does not assume a loop executes" (MirUninitialized 3 10) (mir_test_blocks
        ([MirBlockDef(0, [MirMove(12, mir_fixture_nat MirU8 1)] : List MirInstruction, MirJump 1),
          MirBlockDef(1, [] : List MirInstruction, MirBranch (MirUse 12) 2 3),
          MirBlockDef(2, [MirMove(10, mir_fixture_nat MirU32 1)] : List MirInstruction, MirJump 1),
          MirBlockDef(3, [MirMove(11, MirUse 10)] : List MirInstruction, MirReturn mir_fixture_no_value)] : List MirBlock)),
      mir_test_bad("MIR unknown destination", MirUnknownLocal 99, mir_test_one (MirMove(99, mir_fixture_nat MirU32 0))),
      mir_test_bad("MIR unknown operand", MirUnknownLocal 99, mir_test_one (MirMove(10, MirUse 99))),
      mir_test_bad "MIR unknown jump target" (MirUnknownBlock 99) (mir_test_blocks
        ([MirBlockDef(0, [] : List MirInstruction, MirJump 99)] : List MirBlock)),
      mir_test_bad "MIR duplicate block ID" (MirDuplicateBlock 0) (mir_test_blocks
        ([MirBlockDef 0 ([] : List MirInstruction) MirTrap, MirBlockDef 0 ([] : List MirInstruction) MirTrap] : List MirBlock)),
      mir_test_bad "MIR unreachable block is explicit" (MirUnreachableBlock 9) (mir_test_blocks
        ([MirBlockDef 0 ([] : List MirInstruction) MirTrap, MirBlockDef 9 ([] : List MirInstruction) MirTrap] : List MirBlock)),
      mir_test_bad "MIR checks types in unreachable blocks" (MirUnknownLocal 99) (mir_test_blocks
        ([MirBlockDef 0 ([] : List MirInstruction) MirTrap,
          MirBlockDef 9 ([MirMove(99, mir_fixture_nat MirU32 1)] : List MirInstruction) MirTrap] : List MirBlock)),
      mir_test_bad "MIR duplicate local ID" (MirDuplicateLocal 10) (mir_fixture_program (mir_fixture_function
        ([MirLocalDef 10 MirU32, MirLocalDef 10 MirU64] : List MirLocal)
        ([MirBlockDef 0 ([] : List MirInstruction) MirTrap] : List MirBlock))),
      mir_test_bad "MIR duplicate global ID across data and functions" (MirDuplicateSymbol 1) (MirProgramDef
        ([mir_fixture_function([] : List MirLocal, [MirBlockDef 0 ([] : List MirInstruction) MirTrap] : List MirBlock)] : List MirFunction)
        ([MirDataDef 1 False ([1] : List Nat)] : List MirData) ([] : List MirLibrary) 1),
      mir_test_bad "MIR globals include the extern namespace" (MirDuplicateSymbol 1) (MirProgramDef
        ([mir_fixture_function([] : List MirLocal, [MirBlockDef 0 ([] : List MirInstruction) MirTrap] : List MirBlock)] : List MirFunction)
        ([] : List MirData) ([mir_fixture_kernel ([MirExternDef MirNoGc 1 ([65] : List Nat)
          (MirSignatureOf([] : List MirType, mir_fixture_void))] : List MirExtern)] : List MirLibrary) 1),
      mir_test_bad("MIR scalar widths do not coerce", MirTypeMismatch 10, mir_test_one (MirMove(10, mir_fixture_nat MirU64 0))),
      mir_test_bad "MIR shift count must be U32" (MirTypeMismatch 10)
        (mir_test_one (MirBinaryOp(10, MirShl, mir_fixture_nat MirU32 1, mir_fixture_nat MirU64 1))),
      mir_test_bad "MIR pointer arithmetic requires the explicit pointer operation" (MirTypeMismatch 13)
        (mir_test_one (MirBinaryOp(13, MirAdd, mir_fixture_nat MirRawPtr 0, mir_fixture_nat MirRawPtr 0))),
      mir_test_bad "MIR pointer ordering is not an integer comparison" (MirTypeMismatch 12)
        (mir_test_one (MirCompare(12, MirLess, mir_fixture_nat MirRawPtr 0, mir_fixture_nat MirRawPtr 0))),
      mir_test_bad("MIR pointer kinds stay distinct", MirTypeMismatch 13, mir_test_one (MirMove(13, mir_fixture_nat MirManagedPtr 0))),
      mir_test_bad "MIR managed roots cannot become interior raw pointers" (MirTypeMismatch 13)
        (mir_test_one (MirPointerAdd(13, mir_fixture_nat MirManagedPtr 0, mir_fixture_nat MirUSize 8))),
      mir_test_bad "MIR integer pointer literal cannot smuggle an address" MirInvalidLiteral (mir_test_one (MirMove(13, mir_fixture_nat MirRawPtr 1))),
      mir_test_bad "MIR U8 literal is range checked" MirInvalidLiteral (mir_test_one (MirMove(12, mir_fixture_nat MirU8 256))),
      mir_test_bad "MIR U32 literal cannot carry upper bits" MirInvalidLiteral
        (mir_test_one (MirMove(10, mir_fixture_bits MirU32 codegen_zero (pe_word32 1)))),
      mir_test_bad "MIR literal limbs are bytes" MirInvalidLiteral
        (mir_test_one (MirMove(15, mir_fixture_bits MirU64 (X64Bytes32 256 0 0 0) codegen_zero))),
      mir_test_bad "MIR narrowing must reduce width" (MirInvalidConversion 10)
        (mir_test_one (MirConvert 10 MirNarrow (mir_fixture_nat MirU8 1))),
      mir_test_bad "MIR signed source requires sign extension" (MirInvalidConversion 15)
        (mir_test_one (MirConvert 15 MirZeroExtend (mir_fixture_nat MirI32 1))),
      mir_test_bad "MIR sign extension requires I32" (MirInvalidConversion 15)
        (mir_test_one (MirConvert 15 MirSignExtend (mir_fixture_nat MirU32 1))),
      mir_test_bad "MIR reinterpret cannot change width" (MirInvalidConversion 15)
        (mir_test_one (MirConvert 15 MirReinterpret (mir_fixture_nat MirU32 1))),
      mir_test_bad "MIR reinterpret cannot change pointer kind" (MirInvalidConversion 14)
        (mir_test_one (MirConvert 14 MirReinterpret (mir_fixture_nat MirRawPtr 0))),
      mir_test_accept("MIR explicit raw pointer to USize bits", mir_test_one (MirConvert 16 MirRawToBits (mir_fixture_nat MirRawPtr 0))),
      mir_test_accept "MIR explicit USize bits to raw pointer" (mir_test_one (MirConvert 13 MirRawFromBits
        (mir_fixture_bits(MirUSize, X64Bytes32 255 255 255 255, X64Bytes32 255 255 255 255)))),
      mir_test_bad "MIR raw-to-bits cannot expose a managed root" (MirInvalidConversion 16)
        (mir_test_one (MirConvert 16 MirRawToBits (mir_fixture_nat MirManagedPtr 0))),
      mir_test_bad "MIR raw-from-bits cannot fabricate a managed root" (MirInvalidConversion 14)
        (mir_test_one (MirConvert 14 MirRawFromBits (mir_fixture_nat MirUSize 0))),
      mir_test_bad "MIR raw-to-bits requires USize instead of U64" (MirInvalidConversion 15)
        (mir_test_one (MirConvert 15 MirRawToBits (mir_fixture_nat MirRawPtr 0))),
      mir_test_bad "MIR raw-from-bits requires USize instead of U64" (MirInvalidConversion 13)
        (mir_test_one (MirConvert 13 MirRawFromBits (mir_fixture_nat MirU64 0))),
      mir_test_bad "MIR raw-to-bits cannot truncate an address" (MirInvalidConversion 10)
        (mir_test_one (MirConvert 10 MirRawToBits (mir_fixture_nat MirRawPtr 0))),
      mir_test_bad "MIR integer reinterpret does not imply raw-to-bits" (MirInvalidConversion 16)
        (mir_test_one (MirConvert 16 MirReinterpret (mir_fixture_nat MirRawPtr 0))),
      mir_test_bad "MIR integer reinterpret does not imply raw-from-bits" (MirInvalidConversion 13)
        (mir_test_one (MirConvert 13 MirReinterpret (mir_fixture_nat MirUSize 0))),
      mir_test_bad("MIR address target exists", MirUnknownSymbol 777, mir_test_one (MirAddress 13 777)),
      mir_test_bad("MIR address destination is a raw pointer", MirInvalidAddress 10, mir_test_one (MirAddress 10 1)),
      mir_test_bad "MIR load base is a pointer" (MirTypeMismatch 0)
        (mir_test_one (MirLoad(10, mir_fixture_nat MirU32 0, codegen_disp 0))),
      mir_test_bad "MIR displacement must fit signed 32 bits" MirInvalidDisplacement
        (mir_test_one (MirLoad(10, mir_fixture_nat MirRawPtr 0, X64Forward (X64Bytes32 0 0 0 128)))),
      mir_test_bad "MIR direct-call target must be a callable symbol" (MirInvalidCall 777)
        (mir_test_one (MirCall(MirMayGc, mir_fixture_no_dest, MirDirect 777, [] : List MirValue))),
      mir_test_bad "MIR calls require the exact argument count" (MirInvalidCall 1)
        (mir_test_one (MirCall(MirMayGc, mir_fixture_no_dest, MirDirect 1000, [] : List MirValue))),
      mir_test_bad "MIR calls require the exact argument type" (MirTypeMismatch 1)
        (mir_test_one (MirCall(MirMayGc, mir_fixture_no_dest, MirDirect 1000, [mir_fixture_nat MirU64 42] : List MirValue))),
      mir_test_bad "MIR void call cannot initialize a destination" (MirInvalidCall 1)
        (mir_test_one (MirCall(MirMayGc, Just Nat 10, MirDirect 1000, [mir_fixture_nat MirU32 42] : List MirValue))),
      mir_test_bad "MIR indirect call address is raw" (MirTypeMismatch 0)
        (mir_test_one (MirCall MirMayGc mir_fixture_no_dest (MirIndirect (MirSignatureOf([] : List MirType, mir_fixture_void))
          (mir_fixture_nat MirManagedPtr 0)) ([] : List MirValue))),
      mir_test_bad "MIR branch condition is U8" (MirTypeMismatch 1) (mir_test_blocks
        ([MirBlockDef(0, [] : List MirInstruction, MirBranch (mir_fixture_nat MirU32 1) 0 0)] : List MirBlock)),
      mir_test_bad "MIR return agrees with signature" (MirInvalidReturn 1) (mir_test_blocks
        ([MirBlockDef(0, [] : List MirInstruction, MirReturn (Just(MirValue, mir_fixture_nat MirU32 0)))] : List MirBlock)),
      mir_test_bad "MIR entry must name a function" (MirInvalidEntry 2) (MirProgramDef ([] : List MirFunction)
        ([] : List MirData) ([] : List MirLibrary) 2),
      mir_test_bad "MIR data must contain valid bytes" (MirInvalidData 200) (MirProgramDef
        ([mir_fixture_function([] : List MirLocal, [MirBlockDef 0 ([] : List MirInstruction) MirTrap] : List MirBlock)] : List MirFunction)
        ([MirDataDef 200 True ([256] : List Nat)] : List MirData) ([] : List MirLibrary) 1),
      mir_test_reject "MIR node budget exhaustion is not acceptance" MirResourceExhausted (MirLimitsWith 0 100 100) mir_fixture_control,
      mir_test_reject "MIR flow fuel exhaustion is not a fixed point" MirResourceExhausted (MirLimitsWith 1000 1000 0) mir_fixture_control,
      mir_test_reject "MIR data budget exhaustion is explicit" MirResourceExhausted (MirLimitsWith 1000 1 1000) mir_fixture_memory];
