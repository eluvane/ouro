import "../compiler/driver.ouro",
  "../compiler/native/managed_model.ouro",
  "../compiler/native/lower_types.ouro",
  "../compiler/native/lower_model.ouro",
  "../compiler/file_elab_lookup.ouro",
  "../compiler/file_check_environment.ouro",
  "../compiler/checked_program.ouro",
  "../compiler/primitive_contracts.ouro",
  "../compiler/primitive_model.ouro",
  "../std/string_prims.ouro";

def managed_helper_test_compiler (program : CheckedProgram) (contracts : List LowerContract)
    : ManagedCompiler :=
    ManagedCompilerOf program ([] : List Nat) 0 0 0 0 0 0 contracts
      (check_environment_from_entries (checked_program_entries program));

def managed_helper_test_contracts (primitive : PrimitiveId) (mode : Nat)
    (contract : LowerContract) : List LowerContract :=
    match contract with | LowerContractOf id annotation arguments result binding =>
      match eqNat mode 2 with | True => ([] : List LowerContract) | False =>
        ([LowerContractOf (match eqNat mode 3 with | True => S id | False => id end)
          (match eqNat mode 4 with | True => CSort 0 | False => annotation end) arguments result
          (match eqNat mode 5 with
            | True => Just(PrimitiveBinding, PrimitiveIntrinsicBinding primitive PrimitiveRuntimeAction PrimitiveMayGc (Nothing CoreTerm))
            | False => binding end)] : List LowerContract) end end;

def managed_helper_test_resolve (mode : Nat) (name : List Nat)
    (expected_type : ManagedCompiler -> Either NativeLowerError CoreTerm)
    (contracts : LowerContract -> List LowerContract) (program : CheckedProgram)
    : Either NativeLowerError Nat :=
    let compiler : ManagedCompiler := managed_helper_test_compiler program [] in
    let entries : List Entry := checked_program_entries program in
    lower_bind Nat Nat (managed_source_symbol program name) (fun (id : Nat) =>
      match lookup_type id entries with
      | Nothing => Left NativeLowerError Nat (LowerUnknownGlobal id)
      | Just annotation => lower_bind LowerContract Nat
          (lower_make_contract primitive_default_fuel entries id annotation (Nothing PrimitiveBinding))
          (fun (contract : LowerContract) => lower_bind CoreTerm Nat
            (expected_type compiler) (fun (expected : CoreTerm) =>
              lower_bind LowerContract Nat
                (managed_runtime_contract (managed_helper_test_compiler program (contracts contract))
                  (match eqNat mode 8 with | True => 0 | False => primitive_default_fuel end) name expected)
                (fun (selected : LowerContract) => lower_map Unit Nat (fun (_ : Unit) => id)
                  (lower_require(eqNat(lower_contract_id selected, id), LowerInvalidCall id))))) end);

def managed_helper_test_status (result : Either NativeLowerError Nat) : String :=
    match result with
      | Right _ => "linked" | Left error => match error with
        | LowerResourceExhausted => "resource" | LowerMetadataMismatch _ => "metadata"
        | LowerBodyMismatch _ => "body" | LowerInvalidCall _ => "call"
        | LowerDeclarationFailure _ _ _ => "declaration" | LowerUnsupportedType _ => "type"
        | LowerUnsupportedTerm _ => "term" | LowerUnsupportedPrimitive _ => "primitive"
        | LowerUnknownGlobal _ => "global" | LowerUnboundLocal _ => "local" | LowerEffectMismatch => "effect"
        | LowerInvalidEntry _ => "entry" | LowerMirFailure _ => "mir" | LowerBackendFailure _ => "backend" end end;

def managed_helper_test_probe (source : String)
    (resolve : CheckedProgram -> Either NativeLowerError Nat) : String :=
    match compile_checked_source(mul 100 50, prim_string_to_char_codes source) with
    | CErr _ => "source-rejected"
    | COk program => managed_helper_test_status (resolve program)
    end;
