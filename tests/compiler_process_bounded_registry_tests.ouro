import "compiler_primitive_registry_fixtures.ouro";

def bounded_registry_pair (tail : CoreTerm) : CoreTerm := CApp (CApp (CInd 45) (CInd 40)) tail;
def bounded_registry_signature : CoreTerm :=
    CPi (CConst 18) (CPi (CApp (CInd 43) (CConst 18))
      (CPi (CApp (CApp (CInd 45) (CConst 18)) (bounded_registry_pair (bounded_registry_pair (bounded_registry_pair (bounded_registry_pair (CInd 40))))))
        (CApp (CConst 16) (bounded_registry_pair (bounded_registry_pair
          (bounded_registry_pair (CApp (CApp (CInd 45) (CConst 18)) (CConst 18))))))));

def main : IO Unit := test_run
    [ pr_signature "bounded capture exact pair contract" PrimitiveProcessBounded bounded_registry_signature
    , assert_eq "separate primitive key" (str_of_codes (primitive_key PrimitiveProcessBounded)) "ouro.process.capture_bounded"
    , pr_error CoreTerm "bounded capture requires Pair role" (PrimitiveMissingRole PrimitivePairRole)
        (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
          (filter PrimitiveRoleBinding (fun (binding : PrimitiveRoleBinding) => match binding with | PrimitiveRoleOf role _ => notb (primitive_role_equal role PrimitivePairRole) end) pr_roles)
          PrimitiveProcessBounded (Nothing CoreTerm))
    , pr_error CoreTerm "bounded capture rejects specialization" PrimitiveUnexpectedSpecialization
        (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles PrimitiveProcessBounded (Just CoreTerm (CConst 18)))
    ];
