-- Checked reduction, conversion and spine laws, independent of declaration inference.

import "../compiler/file_elab_core.ouro";
import "../compiler/file_elab_lookup.ouro";
import "../std/io.ouro";
import "compiler_core_test_decls.ouro";

inductive ReduceTest : Type :=
  | ReduceLaw : String -> Bool -> String -> ReduceTest;

def reduce_test_assert (name : String) (passed : Bool) : ReduceTest :=
    ReduceLaw name passed "expected true";

def reduce_tests_run (tests : List ReduceTest) : IO Unit :=
    (fix report (remaining : List ReduceTest) (failed : Bool) : IO Unit :=
      match remaining with
      | Nil =>
          match failed with
          | True => exit 1
          | False => exit 0
          end
      | Cons law rest =>
          match law with
          | ReduceLaw name passed observed =>
              do println
                   (prim_string_concat
                     (match passed with | True => "ok " | False => "FAIL " end)
                     (prim_string_concat name
                       (match passed with
                        | True => ""
                        | False => prim_string_concat " " observed
                        end)));
                 report rest (orb failed (notb passed))
          end
      end) tests False;

def reduce_test_fuel : Nat := mul 50 40;

def reduce_test_nat : CoreTerm := CInd 10;
def reduce_test_zero : CoreTerm := CConstruct 10 0 0;
def reduce_test_bool : CoreTerm := CInd 20;
def reduce_test_true : CoreTerm := CConstruct 20 0 0;

def reduce_test_nat_motive : CoreTerm :=
    CLam reduce_test_nat reduce_test_nat;

def reduce_test_signature : List Entry :=
    [ MkIndEntry 20 checker_test_bool_decl
    , MkIndEntry 10 checker_test_nat_decl
    ];

def reduce_normal_fault_id (fault : NormalizeFault) : Nat :=
    match fault with
    | NormalizeNonFunction => 1
    | NormalizeCaseBranchCount => 2
    | NormalizeCaseScrutinee => 3
    | NormalizeCaseInductive => 4
    | NormalizeCaseParameters => 5
    | NormalizeCaseConstructor => 6
    | NormalizeCaseArguments => 7
    | NormalizeFixArgument => 8
    | NormalizeFixArity => 9
    | NormalizeUnreducedHead => 10
    | NormalizeStringBytes => 11
    | NormalizeStringArguments => 12
    | NormalizeUnresolvedLiteral => 13
    | NormalizeStringType => 14
    end;

def reduce_normal_status (A : Type) (result : NormalizeResult A) : String :=
    match result with
    | Normalized _ => "normalized"
    | NormalizeExhausted => "exhausted"
    | NormalizeMalformed fault =>
        prim_string_concat "malformed=" (prim_string_of_nat (reduce_normal_fault_id fault))
    end;

def reduce_normal_expect (name : String) (result : NormalizeResult CoreTerm)
    (expected : CoreTerm) : ReduceTest :=
    ReduceLaw name
      (match result with
       | Normalized value => eqTerm reduce_test_fuel value expected
       | NormalizeExhausted => False
       | NormalizeMalformed _ => False
       end) (reduce_normal_status CoreTerm result);

def reduce_normal_exhaust (A : Type) (name : String) (result : NormalizeResult A)
    : ReduceTest :=
    ReduceLaw name
      (match result with
       | NormalizeExhausted => True
       | Normalized _ => False
       | NormalizeMalformed _ => False
       end) (reduce_normal_status A result);

def reduce_normal_fault (A : Type) (name : String) (expected : NormalizeFault)
    (result : NormalizeResult A) : ReduceTest :=
    ReduceLaw name
      (match result with
       | NormalizeMalformed actual =>
           eqNat (reduce_normal_fault_id actual) (reduce_normal_fault_id expected)
       | Normalized _ => False
       | NormalizeExhausted => False
       end) (reduce_normal_status A result);

def reduce_normal_boolean (name : String) (result : NormalizeResult Bool)
    (expected : Bool) : ReduceTest :=
    ReduceLaw name
      (match result with
       | Normalized actual => match expected with | True => actual | False => notb actual end
       | NormalizeExhausted => False
       | NormalizeMalformed _ => False
       end) (reduce_normal_status Bool result);

def reduce_normal_aliases (result_type : CoreTerm) (value : CoreTerm)
    : Nat -> Nat -> List Entry :=
    fix reduce_normal_aliases (remaining : Nat) (name : Nat) : List Entry :=
      match remaining with
      | Z => [MkEntry name result_type (Just CoreTerm value)]
      | S rest =>
          Cons Entry (MkEntry name result_type (Just CoreTerm (CConst (S name))))
            (reduce_normal_aliases rest (S name))
      end;

def reduce_normal_constructors : Nat -> Nat -> List Ctor :=
    fix reduce_normal_constructors (remaining : Nat) (name : Nat) : List Ctor :=
      match remaining with
      | Z => Nil Ctor
      | S rest => Cons Ctor (MkCtor name (CInd 83))
          (reduce_normal_constructors rest (S name))
      end;

def reduce_normal_wide_ctors : List Ctor :=
    reduce_normal_constructors 205 (mul 20 50);

def reduce_normal_signature : List Entry :=
    append Entry
      ([ MkIndEntry 30 checker_test_box
       , MkIndEntry 83 (MkIndDecl 83 (Nil Param) (Nil CoreTerm) 0 reduce_normal_wide_ctors)
       , MkEntry 98 reduce_test_nat (Just CoreTerm (CConst 99))
       , MkEntry 99 reduce_test_nat (Just CoreTerm (CConst 98))
       ] : List Entry)
      (append Entry (reduce_normal_aliases (CSort 0) reduce_test_nat 205 400)
        (append Entry (reduce_normal_aliases reduce_test_nat reduce_test_zero 205 100)
          reduce_test_signature));

def reduce_normal_reduce (fuel : Nat) (term : CoreTerm) : NormalizeResult CoreTerm :=
    normalize_checked fuel reduce_normal_signature term;

def reduce_normal_beta (annotation : CoreTerm) : Nat -> CoreTerm -> CoreTerm :=
    fix reduce_normal_beta (remaining : Nat) (tail : CoreTerm) : CoreTerm :=
      match remaining with
      | Z => tail
      | S rest => CApp (CLam annotation (CRel 0)) (reduce_normal_beta rest tail)
      end;

def reduce_normal_lets : Nat -> CoreTerm -> CoreTerm :=
    fix reduce_normal_lets (remaining : Nat) (tail : CoreTerm) : CoreTerm :=
      match remaining with
      | Z => tail
      | S rest =>
          CLetIn reduce_test_zero reduce_test_nat (reduce_normal_lets rest tail)
      end;

def reduce_normal_apps : Nat -> CoreTerm -> CoreTerm :=
    fix reduce_normal_apps (remaining : Nat) (head : CoreTerm) : CoreTerm :=
      match remaining with
      | Z => head
      | S rest => reduce_normal_apps rest (CApp head (CRel rest))
      end;

def reduce_normal_spine_round_trip : Bool :=
    let term : CoreTerm := reduce_normal_apps 205 (CConst 90) in
    match app_spine_checked reduce_test_fuel term with
    | NormalizeExhausted => False
    | NormalizeMalformed _ => False
    | Normalized spine =>
        match spine with
        | MkSpine head arguments =>
            andb (eqNat 205 (length CoreTerm arguments))
              (eqTerm reduce_test_fuel (mk_app head arguments) term)
        end
    end;

def reduce_normal_case (scrutinee : CoreTerm) (zero_branch : CoreTerm)
    (successor_branch : CoreTerm) : CoreTerm :=
    CCase (MkCaseInfo 10 0 ([0, 1] : List Nat)) reduce_test_nat_motive scrutinee
      ([zero_branch, successor_branch] : List CoreTerm);

def reduce_normal_open_case : CoreTerm :=
    reduce_normal_case (CRel 0) reduce_test_zero (CLam reduce_test_nat (CRel 0));

def reduce_normal_wide_case : CoreTerm :=
    CCase (MkCaseInfo 83 0
      (map Ctor Nat (fun (_ctor : Ctor) => Z) reduce_normal_wide_ctors))
      (CLam (CInd 83) reduce_test_nat) (CRel 0)
      (map Ctor CoreTerm (fun (_ctor : Ctor) => reduce_test_zero) reduce_normal_wide_ctors);

def reduce_normal_parameter_case : CoreTerm :=
    CCase (MkCaseInfo 30 1 ([1] : List Nat))
      (CLam (CApp (CInd 30) reduce_test_nat) reduce_test_nat)
      (CApp (CApp (CConstruct 30 0 1) reduce_test_nat) reduce_test_zero)
      ([CLam reduce_test_nat (CRel 0)] : List CoreTerm);

def reduce_normal_second_fix : CoreTerm :=
    CFix 50 1 2 (CPi reduce_test_nat (CPi reduce_test_nat reduce_test_nat))
      (CLam reduce_test_nat (CLam reduce_test_nat (CRel 0)));

def reduce_normal_tests : List ReduceTest :=
    [ reduce_normal_exhaust CoreTerm "normalize zero fuel has no term"
        (reduce_normal_reduce 0 reduce_test_zero)
    , reduce_normal_exhaust CoreTerm "WHNF zero fuel has no term"
        (whnf_checked 0 reduce_normal_signature reduce_test_zero)
    , reduce_normal_exhaust Spine "spine zero fuel has no partial result"
        (app_spine_checked 0 (CRel 0))
    , reduce_normal_expect "one fuel normalizes an open leaf"
        (reduce_normal_reduce 1 (CRel 4)) (CRel 4)
    , reduce_normal_expect "normalize crosses 200 delta aliases"
        (reduce_normal_reduce reduce_test_fuel (CConst 100)) reduce_test_zero
    , reduce_normal_exhaust CoreTerm "delta exhaustion propagates"
        (reduce_normal_reduce 20 (CConst 100))
    , reduce_normal_exhaust CoreTerm "cyclic aliases report exhaustion"
        (reduce_normal_reduce 20 (CConst 98))
    , reduce_normal_expect "WHNF leaves lambda annotation and body untouched"
        (whnf_checked 1 reduce_normal_signature (CLam (CConst 400) (CConst 100)))
        (CLam (CConst 400) (CConst 100))
    , reduce_normal_exhaust CoreTerm "full lambda annotation exhaustion propagates"
        (reduce_normal_reduce 20 (CLam (CConst 400) reduce_test_zero))
    , reduce_normal_exhaust CoreTerm "full lambda body exhaustion propagates"
        (reduce_normal_reduce 20 (CLam reduce_test_nat (CConst 100)))
    , reduce_normal_exhaust CoreTerm "Pi domain exhaustion propagates"
        (reduce_normal_reduce 20 (CPi (CConst 400) reduce_test_nat))
    , reduce_normal_exhaust CoreTerm "Pi codomain exhaustion propagates"
        (reduce_normal_reduce 20 (CPi reduce_test_nat (CConst 400)))
    , reduce_normal_expect "WHNF leaves a neutral argument untouched"
        (whnf_checked 2 reduce_normal_signature (CApp (CRel 0) (CConst 100)))
        (CApp (CRel 0) (CConst 100))
    , reduce_normal_exhaust CoreTerm "full application argument exhaustion propagates"
        (reduce_normal_reduce 20 (CApp (CRel 0) (CConst 100)))
    , reduce_normal_expect "normalize crosses 200 beta reductions"
        (reduce_normal_reduce reduce_test_fuel
          (reduce_normal_beta reduce_test_nat 205 reduce_test_zero)) reduce_test_zero
    , reduce_normal_exhaust CoreTerm "beta exhaustion propagates"
        (reduce_normal_reduce 20 (reduce_normal_beta reduce_test_nat 205 reduce_test_zero))
    , reduce_normal_expect "normalize crosses 200 let reductions"
        (reduce_normal_reduce reduce_test_fuel (reduce_normal_lets 205 reduce_test_zero))
        reduce_test_zero
    , reduce_normal_exhaust CoreTerm "let exhaustion propagates"
        (reduce_normal_reduce 20 (reduce_normal_lets 205 reduce_test_zero))
    , reduce_normal_expect "beta preserves an open argument under a binder"
        (reduce_normal_reduce 100
          (CApp (CLam reduce_test_nat (CLam reduce_test_nat (CRel 1))) (CRel 0)))
        (CLam reduce_test_nat (CRel 1))
    , reduce_normal_expect "beta need not normalize a discarded argument"
        (reduce_normal_reduce 3 (CApp (CLam reduce_test_nat reduce_test_zero) (CConst 100)))
        reduce_test_zero
    , reduce_normal_exhaust CoreTerm "demanded let value exhaustion propagates"
        (reduce_normal_reduce 20 (CLetIn (CConst 100) reduce_test_nat (CRel 0)))
    , reduce_normal_expect "let need not normalize a discarded value"
        (reduce_normal_reduce 3 (CLetIn (CConst 100) reduce_test_nat reduce_test_zero))
        reduce_test_zero
    , reduce_test_assert "checked spine preserves 205 ordered arguments" reduce_normal_spine_round_trip
    , reduce_normal_exhaust Spine "checked spine rejects depth exhaustion"
        (app_spine_checked 20 (reduce_normal_apps 205 (CConst 90)))
    , reduce_normal_expect "normalize preserves a deep neutral application"
        (reduce_normal_reduce reduce_test_fuel (reduce_normal_apps 205 (CConst 90)))
        (reduce_normal_apps 205 (CConst 90))
    , reduce_normal_exhaust CoreTerm "deep application head exhaustion propagates"
        (reduce_normal_reduce 20 (reduce_normal_apps 205 (CConst 90)))
    , reduce_normal_expect "open scrutinee leaves a valid stuck case"
        (reduce_normal_reduce reduce_test_fuel reduce_normal_open_case) reduce_normal_open_case
    , reduce_normal_expect "stuck case normalizes its final branch"
        (reduce_normal_reduce reduce_test_fuel
          (reduce_normal_case (CRel 0) reduce_test_zero (CLam reduce_test_nat (CConst 100))))
        (reduce_normal_case (CRel 0) reduce_test_zero (CLam reduce_test_nat reduce_test_zero))
    , reduce_normal_exhaust CoreTerm "final stuck branch exhaustion propagates"
        (reduce_normal_reduce 20
          (reduce_normal_case (CRel 0) reduce_test_zero (CLam reduce_test_nat (CConst 100))))
    , reduce_normal_expect "normalize retains every branch of a 205-constructor case"
        (reduce_normal_reduce reduce_test_fuel reduce_normal_wide_case) reduce_normal_wide_case
    , reduce_normal_exhaust CoreTerm "wide case exhaustion never truncates branches"
        (reduce_normal_reduce 20 reduce_normal_wide_case)
    , reduce_normal_expect "iota applies a constructor field"
        (reduce_normal_reduce reduce_test_fuel
          (reduce_normal_case (CApp (CConstruct 10 1 0) reduce_test_zero)
            reduce_test_zero (CLam reduce_test_nat (CRel 0)))) reduce_test_zero
    , reduce_normal_expect "iota drops uniform constructor parameters"
        (reduce_normal_reduce reduce_test_fuel reduce_normal_parameter_case) reduce_test_zero
    , reduce_normal_exhaust CoreTerm "iota scrutinee exhaustion propagates"
        (reduce_normal_reduce 20
          (reduce_normal_case (CConst 100) reduce_test_zero (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_exhaust CoreTerm "iota selected branch exhaustion propagates"
        (reduce_normal_reduce 20
          (reduce_normal_case reduce_test_zero (CConst 100) (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_expect "iota need not normalize an unselected branch"
        (reduce_normal_reduce 10
          (reduce_normal_case reduce_test_zero reduce_test_zero (CLam reduce_test_nat (CConst 100))))
        reduce_test_zero
    , reduce_normal_expect "fix unfolds on a structural constructor"
        (reduce_normal_reduce reduce_test_fuel
          (CApp (checker_test_copy 50)
            (CApp (CConstruct 10 1 0) (CApp (CConstruct 10 1 0) reduce_test_zero))))
        reduce_test_zero
    , reduce_normal_exhaust CoreTerm "fix unfolding exhaustion propagates"
        (reduce_normal_reduce 3
          (CApp (checker_test_copy 50) (CApp (CConstruct 10 1 0) reduce_test_zero)))
    , reduce_normal_exhaust CoreTerm "fix structural argument exhaustion propagates"
        (reduce_normal_reduce 20 (CApp (checker_test_copy 50) (CConst 100)))
    , reduce_normal_expect "fix remains stuck on an open structural argument"
        (reduce_normal_reduce reduce_test_fuel (CApp (checker_test_copy 50) (CRel 0)))
        (CApp (checker_test_copy 50) (CRel 0))
    , reduce_normal_expect "fix waits for a nonzero structural argument position"
        (reduce_normal_reduce reduce_test_fuel (CApp reduce_normal_second_fix reduce_test_zero))
        (CApp reduce_normal_second_fix reduce_test_zero)
    , reduce_normal_expect "fix unfolds when its second structural argument arrives"
        (reduce_normal_reduce reduce_test_fuel
          (CApp (CApp reduce_normal_second_fix reduce_test_zero) reduce_test_zero)) reduce_test_zero
    , reduce_normal_fault CoreTerm "nonfunction application has a precise fault" NormalizeNonFunction
        (reduce_normal_reduce 100 (CApp (CSort 0) reduce_test_zero))
    , reduce_normal_fault CoreTerm "excess case arities have a precise fault" NormalizeCaseBranchCount
        (reduce_normal_reduce 100 checker_test_extra_case_metadata)
    , reduce_normal_fault CoreTerm "missing case arities have a precise fault" NormalizeCaseBranchCount
        (reduce_normal_reduce 100 checker_test_missing_case_metadata)
    , reduce_normal_fault CoreTerm "nonconstructor nonneutral scrutinee has a precise fault"
        NormalizeCaseScrutinee
        (reduce_normal_reduce 100
          (reduce_normal_case (CSort 0) reduce_test_zero (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_fault CoreTerm "wrong scrutinee inductive has a precise fault" NormalizeCaseInductive
        (reduce_normal_reduce 100
          (reduce_normal_case reduce_test_true reduce_test_zero (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_fault CoreTerm "wrong constructor parameter count has a precise fault"
        NormalizeCaseParameters
        (reduce_normal_reduce 100
          (CCase (MkCaseInfo 10 1 ([0, 1] : List Nat)) reduce_test_nat_motive reduce_test_zero
            ([reduce_test_zero, CLam reduce_test_nat (CRel 0)] : List CoreTerm)))
    , reduce_normal_fault CoreTerm "out of range constructor has a precise fault" NormalizeCaseConstructor
        (reduce_normal_reduce 100
          (reduce_normal_case (CConstruct 10 9 0) reduce_test_zero (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_fault CoreTerm "missing constructor fields have a precise fault" NormalizeCaseArguments
        (reduce_normal_reduce 100
          (reduce_normal_case (CConstruct 10 1 0) reduce_test_zero (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_fault CoreTerm "excess constructor fields have a precise fault" NormalizeCaseArguments
        (reduce_normal_reduce 100
          (reduce_normal_case (CApp reduce_test_zero reduce_test_zero)
            reduce_test_zero (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_fault CoreTerm "invalid fix structural index has a precise fault" NormalizeFixArgument
        (reduce_normal_reduce 100
          (CFix 50 1 1 (CPi reduce_test_nat reduce_test_nat) (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_fault CoreTerm "fix arity above its type has a precise fault" NormalizeFixArity
        (reduce_normal_reduce 100
          (CFix 50 0 2 (CPi reduce_test_nat reduce_test_nat) (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_fault CoreTerm "nested Pi keeps the original reduction fault" NormalizeNonFunction
        (reduce_normal_reduce 100 (CPi (CApp (CSort 0) reduce_test_zero) reduce_test_nat))
    , reduce_normal_fault CoreTerm "nested branch keeps the original reduction fault" NormalizeCaseBranchCount
        (reduce_normal_reduce 100
          (reduce_normal_case (CRel 0) checker_test_extra_case_metadata (CLam reduce_test_nat (CRel 0))))
    , reduce_normal_exhaust Bool "checked conversion distinguishes zero fuel"
        (conv_checked 0 reduce_normal_signature reduce_test_zero reduce_test_zero)
    , reduce_normal_exhaust Bool "checked equality distinguishes zero fuel"
        (eqTerm_checked 0 reduce_test_zero reduce_test_zero)
    , reduce_normal_exhaust Bool "checked equality propagates deep exhaustion"
        (eqTerm_checked 20 (checker_test_lambdas 205 (CRel 0)) (checker_test_lambdas 205 (CRel 0)))
    , reduce_normal_boolean "checked equality reports an actual mismatch"
        (eqTerm_checked 1 (CSort 0) (CSort 1)) False
    , reduce_normal_exhaust Bool "checked conversion propagates alias exhaustion"
        (conv_checked 20 reduce_normal_signature (CConst 100) reduce_test_zero)
    , reduce_normal_boolean "checked conversion completes deep aliases"
        (conv_checked reduce_test_fuel reduce_normal_signature (CConst 100) reduce_test_zero) True
    , reduce_normal_fault Bool "checked conversion preserves malformed cause" NormalizeNonFunction
        (conv_checked 100 reduce_normal_signature (CApp (CSort 0) reduce_test_zero) reduce_test_zero)
    , reduce_normal_exhaust Bool "eta expansion propagates its reduction exhaustion"
        (conversion_normal_checked reduce_normal_signature 2
          (CLam reduce_test_nat (CApp (CRel 1) (CRel 0))) (CRel 0))
    , reduce_normal_boolean "checked eta preserves an open neutral"
        (conv_checked 100 reduce_normal_signature (CRel 0)
          (CLam reduce_test_nat (CApp (CRel 1) (CRel 0)))) True
    , reduce_normal_boolean "checked fix equality ignores diagnostic names"
        (eqTerm_checked 200 (checker_test_copy 50) (checker_test_copy 51)) True
    , reduce_normal_exhaust Bool "checked equality propagates branch-list exhaustion"
        (eqTerm_checked 20 reduce_normal_wide_case reduce_normal_wide_case)
    ];

def main : IO Unit := reduce_tests_run reduce_normal_tests;
