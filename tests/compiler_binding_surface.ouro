-- Shared checked FileItem surfaces for primitive-binding suite files.
import "../compiler/file_elab.ouro",
  "../compiler/checked_program_output.ouro";

def compiler_binding_nat_unit_base : List FileItem :=
    [FIntrinsic(100, CSort 0, primitive_key PrimitiveStringType, Nothing CoreTerm),
     FIntrinsic(101, CPi(CSort 0, CSort 0), primitive_key PrimitiveRuntimeType, Nothing CoreTerm),
     FInd (MkIndDecl 102 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor(103, CInd 102), MkCtor(104, CPi(CInd 102, CInd 102))] : List Ctor)),
     FRepresentation(102, prim_string_to_char_codes "ouro.nat"),
     FInd (MkIndDecl(105, [] : List Param, [] : List CoreTerm, 0, [MkCtor(106, CInd 105)] : List Ctor)),
     FRepresentation(105, prim_string_to_char_codes "ouro.unit"),
     FDef(108, CSort 0, CConst 100), FDef(109, CPi(CSort 0, CSort 0), CConst 101),
     FDef(110, CSort 0, CInd 105), FDef(111, CSort 0, CInd 102)];

def compiler_binding_nat_base : List FileItem :=
    [FIntrinsic(100, CSort 0, primitive_key PrimitiveStringType, Nothing CoreTerm),
     FIntrinsic(101, CPi(CSort 0, CSort 0), primitive_key PrimitiveRuntimeType, Nothing CoreTerm),
     FInd (MkIndDecl 102 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor(103, CInd 102), MkCtor(104, CPi(CInd 102, CInd 102))] : List Ctor)),
     FRepresentation(102, prim_string_to_char_codes "ouro.nat"),
     FDef(108, CSort 0, CConst 100), FDef(109, CPi(CSort 0, CSort 0), CConst 101),
     FDef(111, CSort 0, CInd 102)];

def compiler_binding_unit_extra_base : List FileItem :=
    [FIntrinsic(100, CSort 0, primitive_key PrimitiveStringType, Nothing CoreTerm),
     FIntrinsic(101, CPi(CSort 0, CSort 0), primitive_key PrimitiveRuntimeType, Nothing CoreTerm),
     FInd (MkIndDecl 102 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor(103, CInd 102)] : List Ctor)),
     FRepresentation(102, prim_string_to_char_codes "ouro.unit"),
     FDef(108, CSort 0, CConst 100), FDef(109, CPi(CSort 0, CSort 0), CConst 101),
     FDef(111, CSort 0, CInd 102),
     FInd (MkIndDecl 112 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor(113, CInd 112)] : List Ctor))];

def compiler_binding_check (items : List FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking (mul 20 50) items;

def compiler_binding_check_last (base : List FileItem) (last : FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking (mul 20 50)
      (append FileItem base ([last] : List FileItem));

def compiler_binding_mode_type (aliases : Bool) (mode : Nat) : CoreTerm :=
    let text : CoreTerm := match aliases with | True => CConst 108 | False => CConst 100 end in
    let unit_value : CoreTerm := match aliases with | True => CConst 111 | False => CInd 102 end in
    let runtime : CoreTerm := match aliases with | True => CConst 109 | False => CConst 101 end in
    let result : CoreTerm := match eqNat mode 2 with | True => unit_value
      | False => CApp(runtime, match eqNat mode 3 with | True => text | False => match eqNat mode 6 with | True => CInd 112 | False => unit_value end end) end in
    match eqNat mode 4 with | True => result | False =>
      CPi (match eqNat mode 1 with | True => unit_value | False => text end)
        (match eqNat mode 5 with | True => CPi text result | False => result end) end;
