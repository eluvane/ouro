-- Native file write/read: persist bytes, read them back, then exit 0.
import "../std/io.ouro";

def files_path : String :=
    "_build/native/native_build_files.txt";

def files_payload : String :=
    "native-files-ok";

def files_label (text : String) : String :=
    match prim_string_eq text files_payload with
    | True => "files-ok"
    | False => "files-mismatch"
    end;

-- @entry main
def main : IO Unit :=
  do prim_fs_mkdir "_build/native";
     prim_fs_write_file files_path files_payload;
     let! back := prim_fs_read_file files_path;
     println (files_label back);
     exit 0
