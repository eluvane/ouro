import "../std/json.ouro",
  "../std/test.ouro";

def quality_json_prints (source : String) (expected : String) : Bool :=
    match parse_json source with
    | Nothing => False
    | Just value => str_eq (json_print value) expected
    end;

def quality_json_rejected (source : String) : Bool :=
    match parse_json source with
    | Nothing => True
    | Just _ => False
    end;

def quality_json_number_at (source : String) (start : Nat) (expected : String) (next : Nat) : Bool :=
    match parse_num source start with
    | PErr _ => False
    | POk value actual =>
      if let JNum text := (value : Json) then andb (str_eq text expected) (eq_nat actual next) else False
    end;

def quality_json_number_error_at (source : String) (start : Nat) (offset : Nat) : Bool :=
    match parse_num source start with
    | PErr actual => eq_nat actual offset
    | POk _ _ => False
    end;

def quality_json_long_digits : String :=
    (fix double (count : Nat) (text : String) : String :=
      match count with
      | Z => text
      | S rest => double rest (str_concat text text)
      end) 10 "7";

private def quality_json_wide_array : Bool :=
    let items : List Json := append Json (replicate Json (JNum "1.20") 129)
      (Cons Json (JStr "a\nb") (replicate Json (JArr [JBool False]) 127)) in
    let expected : List String := append String (replicate String "1.20" 129)
      (Cons String "\"a\\nb\"" (replicate String "[false]" 127)) in
    str_eq (json_print (JArr items)) (str_cat3 "[" (str_join "," expected) "]");

private def quality_json_wide_object : Bool :=
    let fields : List (Pair String Json) :=
      append (Pair String Json)
        (replicate (Pair String Json) (MkPair String Json "dup" (JNum "-0")) 128)
        (Cons (Pair String Json) (MkPair String Json "q\"" (JArr []))
          (replicate (Pair String Json) (MkPair String Json "dup" (JStr "\t")) 129)) in
    let expected : List String := append String (replicate String "\"dup\":-0" 128)
      (Cons String "\"q\\\"\":[]" (replicate String "\"dup\":\"\\t\"" 129)) in
    str_eq (json_print (JObj fields)) (str_cat3 "{" (str_join "," expected) "}");

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_true("empty digit run stops at EOF", eq_nat (json_consume_digits "" 0) 0)
      , assert_true("digit run at EOF preserves offset", eq_nat (json_consume_digits "12" 2) 2)
      , assert_true("digit run past EOF preserves offset", eq_nat (json_consume_digits "12" 7) 7)
      , assert_true("digit run stops before non-digit", eq_nat (json_consume_digits "123x" 0) 3)
      , assert_true("digit run with nonzero offset", eq_nat (json_consume_digits "xx123]" 2) 5)
      , assert_true("empty digit run preserves non-digit", eq_nat (json_consume_digits "x123" 0) 0)
      , assert_true("number at nonzero offset preserves rest", quality_json_number_at "xx-12.5]" 2 "-12.5" 7)
      , assert_true("number at EOF preserves all bytes", quality_json_number_at "-12.5" 0 "-12.5" 5)
      , assert_true("long integer retains every digit",
          quality_json_number_at quality_json_long_digits 0 quality_json_long_digits 1024)
      , assert_true("long digit run ends at its delimiter from a nonzero offset",
          eq_nat (json_consume_digits (str_cat3 "prefix:" quality_json_long_digits ",8") 7) 1031)
      , assert_true("long negative integer preserves rest",
          quality_json_number_at (str_cat3 "xx-" quality_json_long_digits "]") 2
            (str_concat "-" quality_json_long_digits) 1027)
      , assert_true("long fraction retains every digit",
          quality_json_number_at (str_cat3 "-0." quality_json_long_digits "]") 0
            (str_concat "-0." quality_json_long_digits) 1027)
      , assert_true("long integer parses through public API", quality_json_prints quality_json_long_digits quality_json_long_digits)
      , assert_true("long integer and fraction parse in nested value",
          let number : String := str_cat3 quality_json_long_digits "." quality_json_long_digits in
          quality_json_prints (str_cat3 "{\"n\":[ " number " ]}") (str_cat3 "{\"n\":[" number "]}"))
      , assert_true("missing fraction after long integer reports EOF",
          quality_json_number_error_at (str_concat quality_json_long_digits ".") 0 1025)
      , assert_true("missing fraction after long integer reports non-digit",
          quality_json_number_error_at (str_concat quality_json_long_digits ".x") 0 1025)
      , assert_true("leading zero is still rejected", quality_json_number_error_at "01" 0 1)
      , assert_true("missing signed integer is still rejected", quality_json_number_error_at "-" 0 1)
      , assert_true("long number with trailing content is rejected", quality_json_rejected (str_concat quality_json_long_digits "x"))
      , assert_true("long number with missing fraction is rejected", quality_json_rejected (str_concat quality_json_long_digits "."))
      , assert_eq "opaque number strings keep their array positions"
          (json_print (JArr [JNum "", JNum "1", JNum ""])) "[,1,]"
      , assert_true "wide array keeps every item in order" quality_json_wide_array
      , assert_true "wide object keeps escaped keys and ordered duplicates" quality_json_wide_object
      ] : List Test);
