-- Source conversion and typed failure fixtures share one export set.
import "native_managed_source_driver.ouro",
  "native_stdio_fixtures.ouro";

-- Shared standard data identities allow the ordinary raw runtime pipeline.
-- Use the existing test limit for the complete collector dependency closure.
def native_stdio_fixture_runtime (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError NativeManagedRuntime :=
    managed_fixture_runtime_with_limits managed_source_driver_limits root files;
