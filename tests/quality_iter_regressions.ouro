import "../std/collections.ouro",
  "../std/range.ouro",
  "../std/test.ouro";

private def quality_range_values (range : NatRange) (max_pulls : Nat)
    (expected : List Nat) : Bool :=
    match iter_from_nat_range range with
    | Left _ => False
    | Right source =>
        match collect_list NatRangeCursor NatRangeError Nat max_pulls source with
        | Left _ => False
        | Right values => list_eq Nat eq_nat values expected
        end
    end;

private def quality_range_resumed_values (range : NatRange) (position : Nat)
    (max_pulls : Nat) (expected : List Nat) : Bool :=
    let source : Iterator NatRangeCursor NatRangeError Nat :=
      MkIterator NatRangeCursor NatRangeError Nat
        (MkNatRangeCursor range (Just Nat position)) nat_range_pull in
    match collect_list NatRangeCursor NatRangeError Nat max_pulls source with
    | Left _ => False
    | Right values => list_eq Nat eq_nat values expected
    end;

private def quality_range_take_values (range : NatRange) (count : Nat)
    (max_pulls : Nat) (expected : List Nat) : Bool :=
    match iter_from_nat_range range with
    | Left _ => False
    | Right source =>
        match collect_list (Pair Nat NatRangeCursor) NatRangeError Nat max_pulls
            (iter_take NatRangeCursor NatRangeError Nat count source) with
        | Left _ => False
        | Right values => list_eq Nat eq_nat values expected
        end
    end;

private def quality_range_limit (range : NatRange) (max_pulls : Nat) : Bool :=
    match iter_from_nat_range range with
    | Left _ => False
    | Right source =>
        match collect_list NatRangeCursor NatRangeError Nat max_pulls source with
        | Left problem =>
            match problem with
            | IterPullLimit => True
            | IterSourceFailure _ => False
            end
        | Right _ => False
        end
    end;

private def quality_range_power_of_two (exponent : Nat) : Nat :=
    (fix double (remaining : Nat) (value : Nat) : Nat :=
      match remaining with
      | Z => value
      | S rest => double rest (add value value)
      end) exponent 1;

private def quality_range_large_boundary : Bool :=
    let boundary : Nat := quality_range_power_of_two 64 in
    let first_item : Nat := sub boundary 1 in
    let last_item : Nat := add boundary 3 in
    quality_range_values (MkNatRange first_item last_item 2 RangeInclusive) 4
      ([first_item, add boundary 1, last_item] : List Nat);

private def quality_range_zero_rejected : Bool :=
    match iter_from_nat_range (MkNatRange 3 11 Z RangeInclusive) with
    | Left problem => match problem with | RangeZeroStep => True end
    | Right _ => False
    end;

private def quality_range_zero_cursor : Bool :=
    if let IterFail problem := (nat_range_pull
        (MkNatRangeCursor (MkNatRange 3 11 Z RangeInclusive) (Nothing Nat)) : IterStep NatRangeCursor NatRangeError Nat) then
      match problem with | RangeZeroStep => True end
    else False;

private def quality_range_zero_next : Bool :=
    match nat_range_next (MkNatRange 3 11 Z RangeExclusive) 12 with
    | Nothing => False
    | Just next => eq_nat next 12
    end;

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_true "short prefix of a range with a large endpoint"
          (quality_range_take_values
            (nat_range_exclusive Z (quality_range_power_of_two 128))
            4 5 ([0, 1, 2, 3] : List Nat))
       , assert_true "ascending inclusive range stops before an unaligned endpoint"
          (quality_range_values (MkNatRange 3 12 4 RangeInclusive) 4
            ([3, 7, 11] : List Nat))
       , assert_true "ascending inclusive range includes an exact endpoint"
          (quality_range_values (MkNatRange 3 11 4 RangeInclusive) 4
            ([3, 7, 11] : List Nat))
       , assert_true "ascending exclusive range omits an exact endpoint"
          (quality_range_values (MkNatRange 3 11 4 RangeExclusive) 3
            ([3, 7] : List Nat))
       , assert_true "ascending oversized step stops after the first item"
          (quality_range_values
            (MkNatRange 3 4 (quality_range_power_of_two 128) RangeInclusive)
            2 ([3] : List Nat))
       , assert_true "ascending step retains the carry beyond a machine word"
          quality_range_large_boundary
       , assert_true "resumed cursor preserves its unaligned position"
          (quality_range_resumed_values (MkNatRange 3 12 4 RangeInclusive)
            4 4 ([4, 8, 12] : List Nat))
       , assert_true "resumed cursor below start is done"
          (quality_range_resumed_values (MkNatRange 3 12 4 RangeInclusive)
            2 1 ([] : List Nat))
       , assert_true "resumed cursor beyond stop is done"
          (quality_range_resumed_values (MkNatRange 3 12 4 RangeInclusive)
            13 1 ([] : List Nat))
       , assert_true "equal exclusive endpoints give no items"
          (quality_range_values (nat_range_exclusive 3 3) 1 ([] : List Nat))
       , assert_true "equal inclusive endpoints give one item"
          (quality_range_values (nat_range_inclusive 3 3) 2 ([3] : List Nat))
       , assert_true "descending nonlanding step never fabricates zero"
          (quality_range_values (MkNatRange 10 0 3 RangeInclusive) 5
            ([10, 7, 4, 1] : List Nat))
       , assert_true "final end observation still needs its own pull"
          (quality_range_limit (MkNatRange 3 11 4 RangeInclusive) 3)
       , assert_true "zero-step range is rejected" quality_range_zero_rejected
       , assert_true "zero-step cursor fails before testing its position"
          quality_range_zero_cursor
       , assert_true "next helper preserves direct zero-step behavior"
          quality_range_zero_next
       ] : List Test);
