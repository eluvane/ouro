import "../std/fs_bounded.ouro", "../std/parse.ouro";

def fs_bounded_probe_usage : IO Unit :=
    do eprintln "usage: native-fs-bounded-probe PATH BYTE_CAP"; exit 2;

def main : IO Unit :=
    do let! args := argv;
       match args with
       | Nil => fs_bounded_probe_usage
       | Cons _ rest => match rest with
         | Nil => fs_bounded_probe_usage
         | Cons path tail => match tail with
           | Nil => fs_bounded_probe_usage
           | Cons raw_cap extra => match extra with
             | Cons _ _ => fs_bounded_probe_usage
             | Nil => match parse_nat raw_cap with
               | Nothing => fs_bounded_probe_usage
               | Just cap => do let! result := fs_read_bounded_checked cap path;
                                match result with
                                | Left error => do eprintln (fs_bounded_read_error_message error); exit 1
                                | Right content => print content
                                end
               end
             end
           end
         end
       end;
