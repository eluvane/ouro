-- File-kind authority follows the checked identity and complete signature.
import "../compiler/file_elab.ouro";
import "../compiler/checked_program_output.ouro";
import "../std/test.ouro";
import "compiler_binding_surface.ouro";

def kind_binding_type (aliases : Bool) (mode : Nat) : CoreTerm :=
    let text : CoreTerm := match aliases with | True => CConst 108 | False => CConst 100 end in
    let count : CoreTerm := match aliases with | True => CConst 111 | False => CInd 102 end in
    let runtime : CoreTerm := match aliases with | True => CConst 109 | False => CConst 101 end in
    let result : CoreTerm := match eqNat mode 2 with | True => count
      | False => CApp runtime (match eqNat mode 3 with | True => text | False => count end) end in
    match eqNat mode 4 with | True => result | False =>
      CPi (match eqNat mode 1 with | True => count | False => text end)
        (match eqNat mode 5 with | True => CPi text result | False => result end) end;

def kind_binding_declaration (typ : CoreTerm) : FileItem :=
    FIntrinsic 120 typ (primitive_key PrimitiveFileKind) (Nothing CoreTerm);

def kind_binding_check (last : FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking (mul 20 50)
      (append FileItem compiler_binding_nat_base ([last] : List FileItem));

def kind_binding_metadata (aliases : Bool) : Bool :=
    match kind_binding_check (kind_binding_declaration (kind_binding_type aliases 0)) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      any Entry (fun (entry : Entry) => match entry with
        | MkBoundEntry name _ binding => match eqNat name 120 with | False => False | True =>
            match binding with | PrimitiveExternBinding _ => False
            | PrimitiveIntrinsicBinding actual execution gc specialization => andb (primitive_id_equal actual PrimitiveFileKind)
                (andb (match execution with | PrimitiveRuntimeAction => True
                  | PrimitiveTypeOnly => False | PrimitivePureValue => False end)
                  (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                    (match specialization with | Nothing => True | Just _ => False end))) end end
        | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False end) entries end;

def kind_binding_rejected (mode : Nat) : Bool :=
    match kind_binding_check (kind_binding_declaration (kind_binding_type False mode)) with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure => andb (eqNat name 120)
        (eqNat (declaration_failure_code CheckExactCore phase failure) 2) end;

def kind_binding_shim (axiom_only : Bool) : Bool :=
    match kind_binding_check (match axiom_only with
      | True => FAxiom 120 (kind_binding_type False 0)
      | False => kind_binding_declaration (kind_binding_type True 0) end) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      let shims : List (Pair Nat (List Nat)) :=
        checked_program_c_shims (CheckedProgramOf empty_intern entries ([] : List (Pair Nat CoreTerm))) in
      match axiom_only with
      | True => notb (any (Pair Nat (List Nat)) (fun (item : Pair Nat (List Nat)) =>
          match item with | MkPair name _ => eqNat name 120 end) shims)
      | False => any (Pair Nat (List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair name key =>
          andb (eqNat name 120) (primitive_bytes_equal key (prim_string_to_char_codes "prim_fs_kind")) end) shims end end;

def main : IO Unit :=
    test_run
      [assert_true "file kind records canonical effect and GC metadata" (kind_binding_metadata False),
       assert_true "file kind accepts normalized String, Nat and Runtime aliases" (kind_binding_metadata True),
       assert_true "file kind rejects a non-String path" (kind_binding_rejected 1),
       assert_true "file kind rejects a pure Nat result" (kind_binding_rejected 2),
       assert_true "file kind rejects a Runtime String result" (kind_binding_rejected 3),
       assert_true "file kind rejects the missing path argument" (kind_binding_rejected 4),
       assert_true "file kind rejects an extra path argument" (kind_binding_rejected 5),
       assert_true "file kind maps a renamed checked identity to the retained C handler" (kind_binding_shim False),
       assert_true "file kind gives no checked authority to a same-shaped axiom" (kind_binding_shim True)];
