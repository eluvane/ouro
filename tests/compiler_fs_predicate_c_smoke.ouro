-- Renamed checked identities retain both transitional C bridge handlers.
import "../std/test.ouro";

def PredicateText : Type := String;
def PredicateAction (A : Type) : Type := IO A;
intrinsic renamed_exists : PredicateText -> PredicateAction Bool := "ouro.fs.exists";
intrinsic renamed_directory : PredicateText -> PredicateAction Bool := "ouro.fs.is_dir";

def predicate_c_tests (query : String -> IO Bool) (directory : Bool) : IO (List Test) :=
    let saved : IO Bool := query "std/runtime.ouro" in
    let key : String := match directory with | True => "directory" | False => "exists" end in
    (do let! empty := query "";
       let! file := saved;
       let! again := saved;
       let! folder := query "tests";
       let! absent := query "__ouro_predicate_missing_probe_260__";
       io_pure (List Test)
         [assert_true (str_concat key " C query preserves the empty path result") (notb empty),
          assert_true (str_concat key " C query reads a regular file on each invocation")
            (match directory with | True => andb (notb file) (notb again) | False => andb file again end),
          assert_true (str_concat key " C query identifies a directory") folder,
          assert_true (str_concat key " C query preserves the missing path result") (notb absent)]);

def main : IO Unit :=
    do let! existence := predicate_c_tests renamed_exists False;
       let! directory := predicate_c_tests renamed_directory True;
       test_run (append Test existence directory)
