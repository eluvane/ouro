-- Public source compilation uses the canonical declaration checker for roots
-- and imported bodies, and returns the bodies that checker actually produced.

import "../compiler/driver.ouro",
  "../std/io.ouro",
  "compiler_program_lookup.ouro";

inductive DriverLaw : Type :=
  | MkDriverLaw : String -> Bool -> String -> DriverLaw;

def driver_test_fuel : Nat := mul 100 50;

def driver_test_nat : String :=
    "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; ";

def driver_test_source (body : String) : List Nat :=
    prim_string_to_char_codes (prim_string_concat driver_test_nat body);

def driver_test_compile (body : String) : CompResult (List (Pair Nat CoreTerm)) :=
    compile_to_cores(driver_test_fuel, driver_test_source body);

def driver_test_status (A : Type) (result : CompResult A) : String :=
    match result with
    | COk _ => "COk"
    | CErr error =>
        match error with
        | ErrCode code detail =>
            prim_string_concat "CErr "
              (prim_string_concat (prim_string_of_nat code)
                (prim_string_concat("/", prim_string_of_nat detail)))
        end
    end;

def driver_test_accept (A : Type) (name : String) (result : CompResult A)
    : DriverLaw :=
    MkDriverLaw name
      (match result with | COk _ => True | CErr _ => False end)
      (driver_test_status A result);

def driver_test_error (A : Type) (name : String) (expected : Nat)
    (result : CompResult A) : DriverLaw :=
    MkDriverLaw name
      (match result with
       | COk _ => False
       | CErr error =>
           match error with | ErrCode code _ => eqNat code expected end
       end)
      (driver_test_status A result);

def driver_test_good (name : String) (body : String) : DriverLaw :=
    driver_test_accept(List (Pair Nat CoreTerm), name, driver_test_compile body);

def driver_test_bad (name : String) (code : Nat) (body : String) : DriverLaw :=
    driver_test_error(List (Pair Nat CoreTerm), name, code, driver_test_compile body);

def driver_test_residual_open (name : String) (body : Expr) : DriverLaw :=
    let result : CompResult CheckedProgram :=
      compile_checked_from_decls desugar_file rewrite_declarations lower_expr_env2
        compile_program driver_elaborate_surfaces elaborate check_module
        ([] : List Nat) driver_test_fuel empty_intern
        ([DDef 77 (ESort 0) body 0 []] : List Decl) in
    MkDriverLaw name
      (match result with
       | COk _ => False
       | CErr error => match error with
         | ErrCode code detail => andb(eqNat code 98, eqNat detail 88)
         end
       end)
      (driver_test_status CheckedProgram result);

def driver_test_units (root : String) (dependency : String)
    : CompResult (List (Pair Nat CoreTerm)) :=
    compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([compiler_test_unit "main.ouro" root, compiler_test_unit "dep.ouro" dependency]
        : List (Pair(List Nat, List Nat)));

def driver_test_import_root : String :=
    "import \"dep.ouro\"; def value : Nat := Z;";

def driver_test_bad_dependency : String :=
    prim_string_concat driver_test_nat "def hidden : Nat := Type;";

def driver_test_valid_list : String :=
    "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A; def values : List Nat := [Z,]; ";

def driver_test_valid_string_list : String :=
    "intrinsic String : Type := \"ouro.string\"; inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A; def values : List String := [\"a,,b\",]; ";

def driver_test_record : String :=
    "record Point : Type where x : Nat; y : Nat; end; def x : Nat := Z; def y : Nat := S Z; ";

def driver_test_nested_record : String :=
    "record Address : Type where city : Nat; zip : Nat; end; record User : Type where address : Address; age : Nat; end; record Other : Type where city : Nat; end; def home : Address := { city := Z, zip := S Z }; def user : User := { address := home, age := Z }; ";

def driver_test_exact_error (name : String) (code : Nat) (detail : Nat) (result : CompResult Nat)
    : DriverLaw :=
    MkDriverLaw name (match result with
      | COk _ => False
      | CErr error => match error with | ErrCode actual position =>
          andb(eqNat actual code, eqNat position detail) end
      end) (driver_test_status Nat result);

def driver_test_spread_env : LowerEnv :=
    MkLowerEnv (Nil Nat) [10]
      [MkCtorInfo 11 10 0 1 0 0, MkCtorInfo 12 10 1 1 2 0]
      [0, 0, 0, 0, 0, 10, 11, 12]
      (Nil (Pair Nat Surface)) (Nil (Pair Nat Surface))
      (Nil MarkedDefInfo);

def driver_test_spread_expected : Maybe Surface :=
    Just Surface (SApp (SInd 10) (SInd 20));

def driver_test_spread_outer (term : Surface)
    : Maybe (Pair Nat Surface) :=
    match term with
    | SLet binder value _ _ =>
        Just (Pair Nat Surface) (MkPair Nat Surface binder value)
    | SVar _ => Nothing (Pair Nat Surface)
    | SSort _ => Nothing (Pair Nat Surface)
    | SPi _ _ _ => Nothing (Pair Nat Surface)
    | SLam _ _ _ => Nothing (Pair Nat Surface)
    | SApp _ _ => Nothing (Pair Nat Surface)
    | SConst _ => Nothing (Pair Nat Surface)
    | SInd _ => Nothing (Pair Nat Surface)
    | SConstruct _ _ _ => Nothing (Pair Nat Surface)
    | SCase _ _ _ _ => Nothing (Pair Nat Surface)
    | SFix _ _ _ _ _ => Nothing (Pair Nat Surface)
    | SHole _ => Nothing (Pair Nat Surface)
    | SEffectRow _ => Nothing (Pair Nat Surface)
    | SPerform _ _ => Nothing (Pair Nat Surface)
    | SStr _ _ => Nothing (Pair Nat Surface)
    end;

def driver_test_spread_fresh : Bool :=
    match driver_test_spread_outer
        (lower_expr_env2 driver_test_spread_env driver_test_spread_expected
          (EListSpread [EVar 9001] (EVar 9003))) with
    | Nothing => False
    | Just outer =>
        match outer with
        | MkPair binder _ =>
            match compareNat 9003 binder with
            | LT => True
            | EQ => False
            | GT => False
            end
        end
    end;

def driver_test_spread_invalid_value (body : Expr) : Bool :=
    match driver_test_spread_outer
        (lower_expr_env2 driver_test_spread_env driver_test_spread_expected body) with
    | Nothing => False
    | Just outer =>
        match outer with
        | MkPair _ value =>
            surface_hint_has_placeholder (Nil (Pair Nat Surface)) 100 value
        end
    end;

def driver_test_spread_invalid_head : Bool :=
    driver_test_spread_invalid_value
      (EListSpread [ENoBranch] (EVar 9003));

def driver_test_spread_invalid_tail : Bool :=
    driver_test_spread_invalid_value
      (EListSpread (Nil Expr) ENoBranch);

def driver_test_spread_invalid_role : Bool :=
    match lower_expr_env2 empty_env driver_test_spread_expected
        (EListSpread [ENat 1] (EList (Nil Expr))) with
    | SConst name => eqNat name Z
    | SVar _ => False
    | SSort _ => False
    | SPi _ _ _ => False
    | SLam _ _ _ => False
    | SApp _ _ => False
    | SLet _ _ _ _ => False
    | SInd _ => False
    | SConstruct _ _ _ => False
    | SCase _ _ _ _ => False
    | SFix _ _ _ _ _ => False
    | SHole _ => False
    | SEffectRow _ => False
    | SPerform _ _ => False
    | SStr _ _ => False
    end;

-- Parse only the ordinary prelude; the checked definition body is a direct
-- AST input so malformed nodes cannot be dismissed as parser rejections.
def driver_test_spread_direct_ast (kind : Nat) (expect_good : Bool) : Bool :=
    let source : List Nat := driver_test_source
      "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A;" in
    match lex_all driver_test_fuel source with
    | LexMalformed _ => False
    | LexExhausted _ => False
    | LexOk tokens state =>
        match parse_file parse driver_test_fuel tokens Z with
        | PErr _ => False
        | POk decls rest _ =>
            match is_eof (peek rest) with
            | False => False
            | True =>
                match intern_ident state (prim_string_to_char_codes "List") with
                | MkPair listName state1 =>
                    match intern_ident state1 (prim_string_to_char_codes "Nat") with
                    | MkPair natName state2 =>
                        match intern_ident state2 (prim_string_to_char_codes "Z") with
                        | MkPair zeroName state3 =>
                            match intern_ident state3 (prim_string_to_char_codes "directSpread") with
                            | MkPair defName finalState =>
                                let body : Expr :=
                                  match kind with
                                  | Z => EListSpread [EVar zeroName] (EList [EVar zeroName])
                                  | S other =>
                                      match other with
                                      | Z => EListSpread [ENoBranch] (EList [EVar zeroName])
                                      | S _ => EListSpread [EVar zeroName] ENoBranch
                                      end
                                  end in
                                let result : CompResult CheckedProgram :=
                                  compile_checked_from_decls desugar_file rewrite_declarations lower_expr_env2
                                    compile_program driver_elaborate_surfaces elaborate check_module
                                    ([] : List Nat) driver_test_fuel finalState
                                    (append Decl decls
                                      [DDef defName (EApp (EVar listName) (EVar natName))
                                        body 0 0]) in
                                match result with
                                | COk _ => expect_good
                                | CErr _ => notb expect_good
                                end
                            end
                        end
                    end
                end
            end
        end
    end;

def driver_test_diagnostic_laws : List DriverLaw :=
    append DriverLaw
      (map Nat DriverLaw (fun (code : Nat) =>
        driver_test_exact_error (prim_string_concat("specific error is preserved: ", prim_string_of_nat code)) code 77
          (remap_comp_src_for Nat False (prim_string_to_char_codes "?unrelated [] |> let!")
            (CErr(Nat, ErrCode code 77)))) ([3, 11, 12, 41, 42, 43, 44, 45, 46, 47, 48, 49, 61, 62, 63, 64, 65, 92] : List Nat))
      [ MkDriverLaw "spread fresh binders exceed forged source IDs" driver_test_spread_fresh ""
      , MkDriverLaw "malformed direct AST head remains unresolved" driver_test_spread_invalid_head ""
      , MkDriverLaw "malformed direct AST tail remains unresolved" driver_test_spread_invalid_tail ""
      , MkDriverLaw "unresolved nominal List role rejects before lowering" driver_test_spread_invalid_role ""
      , MkDriverLaw "direct AST valid spread reaches checker" (driver_test_spread_direct_ast 0 True) ""
      , MkDriverLaw "direct AST malformed head fails checker" (driver_test_spread_direct_ast 1 False) ""
      , MkDriverLaw "direct AST malformed tail fails checker" (driver_test_spread_direct_ast 2 False) ""
      , driver_test_good "trailing list comma compiles" driver_test_valid_list
      , driver_test_good "list spread constructs checked prefix and final tail"
          (prim_string_concat driver_test_valid_list
            "def rest : List Nat := [S Z]; def joined : List Nat := [Z, ..rest];")
      , driver_test_good "tail-only spread infers a local List type"
          (prim_string_concat driver_test_valid_list
            "def rest : List Nat := [Z]; def joined : List Nat := let copy := [..rest] in copy;")
      , driver_test_good "list spread accepts a trailing comma and comments"
          (prim_string_concat driver_test_valid_list
            "def rest : List Nat := [Z]; def joined : List Nat := [S Z, -- prefix\n ..rest,];")
      , driver_test_bad "spread tail of wrong element type reaches checker" 41
          (prim_string_concat driver_test_valid_list
            "def bad : List Nat := [Z, ..[Type]];")
      , driver_test_bad "spread tail that is not a list reaches checker" 41
          (prim_string_concat driver_test_valid_list
            "def bad : List Nat := [Z, ..Z];")
      , driver_test_bad "untyped spread without List tail rejects" 41
          (prim_string_concat driver_test_valid_list
            "def bad : Nat := let values := [..Z] in Z;")
      , driver_test_bad "standalone spread stays a parse error" 65
          (prim_string_concat driver_test_valid_list
            "def bad : List Nat := ..values;")
      , driver_test_bad "nonfinal spread stays a parse error" 65
          (prim_string_concat driver_test_valid_list
            "def bad : List Nat := [..values, Z];")
      , driver_test_bad "multiple spreads stay a parse error" 65
          (prim_string_concat driver_test_valid_list
            "def bad : List Nat := [..values, ..values];")
      , driver_test_bad "valid trailing list cannot replace body type failure" 41
          (prim_string_concat driver_test_valid_list "def bad : Nat := Type;")
      , driver_test_bad "valid trailing list cannot replace duplicate declaration failure" 45
          (prim_string_concat driver_test_valid_list "axiom twice : Nat; axiom twice : Nat;")
      , driver_test_good "quoted commas inside a trailing list compile" driver_test_valid_string_list
      , driver_test_bad "quoted commas do not mask a later parse failure" 10
          (prim_string_concat driver_test_valid_string_list "def bad : Nat := ;")
      , driver_test_bad "comment commas do not mask a later parse failure" 10
          (prim_string_concat driver_test_valid_list "def more : List Nat := [Z, -- ,, ]\n]; def bad : Nat := ;")
      , driver_test_bad "double list comma keeps list syntax diagnostic" 65
          (prim_string_concat driver_test_valid_list "def bad : List Nat := [Z,,];")
      , driver_test_bad "double list comma across comment keeps list syntax diagnostic" 65
          (prim_string_concat driver_test_valid_list "def bad : List Nat := [Z, -- separator\n,];")
      , driver_test_good "record literal accepts a grouped result annotation"
          (prim_string_concat driver_test_record "def point : (Point) := { x, y }; ")
      , driver_test_good "record literal accepts a doubly grouped result annotation"
          (prim_string_concat driver_test_record "def point : ((Point)) := { x, y }; ")
      , driver_test_good "record literal accepts a commented grouped result annotation"
          (prim_string_concat driver_test_record
            "def point : ( -- before\n Point -- inside\n ) := { x, y }; ")
      , driver_test_bad "compound grouped annotation is not a nominal record" 73
          (prim_string_concat driver_test_record "def bad : (Point) Nat := { x, y }; ")
      , driver_test_good "record punning preserves declaration field order"
          (prim_string_concat driver_test_record "def point : Point := { y, x }; ")
      , driver_test_good "record punning mixes explicit fields and comments"
          (prim_string_concat driver_test_record "def point : Point := { y -- kept\n, x := Z, }; ")
      , driver_test_good "record field comment before comma keeps constructor punctuation"
          (prim_string_concat driver_test_record "def point : Point := { x := Z -- kept\n, y := S Z }; ")
      , driver_test_good "record field comment before closing brace keeps constructor punctuation"
          (prim_string_concat driver_test_record "def point : Point := { x := Z, y := S Z -- kept\n}; ")
      , driver_test_good "record field expression preserves a quoted comma"
          "intrinsic String : Type := \"ouro.string\"; record Item : Type where text : String; end; def item : Item := { text := \"a,b\" }; "
      , driver_test_bad "punned record missing field keeps exact diagnostic" 74
          (prim_string_concat driver_test_record "def bad : Point := { x }; ")
      , driver_test_bad "punned record unknown field keeps exact diagnostic" 75
          (prim_string_concat driver_test_record "def bad : Point := { x, other := Z }; ")
      , driver_test_bad "punned record duplicate field keeps exact diagnostic" 72
          (prim_string_concat driver_test_record "def bad : Point := { x, x, y }; ")
      , driver_test_bad "punned record requires nominal context" 73
          (prim_string_concat driver_test_record "def bad : Nat := { x, y }; ")
      , driver_test_bad "malformed record field precedes unknown-field diagnostic" 71
          (prim_string_concat driver_test_record "def bad : Point := { unknown blah := Z, x, y }; ")
      , driver_test_bad "empty record assignment is malformed" 71
          (prim_string_concat driver_test_record "def bad : Point := { x :=, y }; ")
      , driver_test_bad "comment-only record assignment is malformed" 71
          (prim_string_concat driver_test_record "def bad : Point := { x := -- only comment\n, y := Z }; ")
      , driver_test_bad "double record comma is malformed" 71
          (prim_string_concat driver_test_record "def bad : Point := { x,, y }; ")
      , driver_test_good "archived annotated record update is now accepted"
          "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; record Point : Type where x : Nat; y : Nat; end; def bad (p : Point) : Point := { p with x := Z };"
      , driver_test_good "record update keeps unchanged fields"
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def next : Point := { point with y := Z, x := S Z }; ")
      , driver_test_good "record update keeps comments in record type metadata"
          "record Point : Type -- sort\n where x : Nat -- field\n; end; def x : Nat := Z; def point : Point := {x}; def next : Point := {point with x := S Z}; "
      , driver_test_good "record update checks a function-valued field"
          "record FnBox : Type where run : Nat -> Nat; end; def ident (n : Nat) : Nat := n; def box : FnBox := {run := ident}; def next : FnBox := {box with run := ident}; "
      , driver_test_good "record update accepts a computed base"
          (prim_string_concat driver_test_record "def make_point (n : Nat) : Point := { x := n, y := Z }; def next : Point := { make_point Z with x := S Z }; ")
      , driver_test_good "record update keeps comments before with and source-order RHS"
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def next : Point := { point -- base\n with x := Z -- first\n, y := S Z }; ")
      , driver_test_good "record update keeps a final RHS comment newline"
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def next : Point := { point with x := Z -- last\n}; ")
      , driver_test_good "record update generated binders avoid user names"
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def __ouro_update : Nat := Z; def __ouro_update_ : Nat := S Z; def next : Point := { point with x := __ouro_update_, y := __ouro_update }; ")
      , driver_test_good "record nested update preserves both sibling fields"
          (prim_string_concat driver_test_nested_record
            "def next : User := { user with address.city := S Z, address.zip := Z }; ")
      , driver_test_good "record update rewrites literal base and record-valued RHS"
          (prim_string_concat driver_test_nested_record
            "def next : User := { { address := home, age := Z } with address := { city := Z, zip := Z } }; ")
      , driver_test_good "nested record update rewrites an update-valued RHS"
          (prim_string_concat driver_test_nested_record
            "def next : User := { user with address := { home with city := S Z } }; ")
      , driver_test_good "nested update keeps base and final RHS comment boundaries"
          (prim_string_concat driver_test_nested_record
            "def next : User := { user -- base\n with address.city := Z -- first\n, address.zip := S Z -- final\n}; ")
      , driver_test_good "nested update names avoid user compiler-like names"
          (prim_string_concat driver_test_nested_record
            "def __ouro_update : Nat := Z; def __ouro_update_ : Nat := S Z; def next : User := { user with address.city := __ouro_update_, address.zip := __ouro_update }; ")
      , driver_test_good "record literal recursively checks a record-valued field"
          (prim_string_concat driver_test_nested_record
            "def next : User := { address := { city := S Z, zip := Z }, age := Z }; ")
      , driver_test_good "record typed local supplies RHS context and projected scope"
          (prim_string_concat driver_test_nested_record
            "def next : Address := let current : User := { user with address.city := Z } in current.address; ")
      , driver_test_good "ordinary typed local precedes a record-typed binding"
          (prim_string_concat driver_test_nested_record
            "def city : Nat := let count : Nat := Z in let item : Address := { city := count, zip := Z } in item.city; ")
      , driver_test_good "untyped local precedes a record-typed binding"
          (prim_string_concat driver_test_nested_record
            "def city : Nat := let count := Z in let item : Address := { city := count, zip := Z } in item.city; ")
      , driver_test_good "parenthesized record-typed local retains its own scope"
          (prim_string_concat driver_test_nested_record
            "def city : Nat := (let item : Address := { city := Z, zip := Z } in item.city); ")
      , driver_test_good "record typed local respects a nested let in its RHS"
          (prim_string_concat driver_test_nested_record
            "def city : Nat := let item : Address := let inner : Address := home in inner in item.city; ")
      , driver_test_good "record typed local shadows a nominal name"
          (prim_string_concat driver_test_nested_record
            "def city : Nat := let item : Address := home in let item : Other := { city := S Z } in item.city; ")
      , driver_test_good "ascribed record literal works in an argument"
          (prim_string_concat driver_test_nested_record
            "def identity (a : Address) : Address := a; def next : Address := identity ({ city := Z, zip := Z } : Address); ")
      , driver_test_good "nested field metadata accepts a trailing type comment"
          "record Address : Type where city : Nat; zip : Nat; end; record User : Type where address : Address -- nominal\n; age : Nat; end; def home : Address := { city := Z, zip := Z }; def user : User := { address := home, age := Z }; def next : User := { user with address.city := S Z }; "
      , driver_test_bad "nested update rejects an unknown leaf" 75
          (prim_string_concat driver_test_nested_record
            "def bad : User := { user with address.missing := Z }; ")
      , driver_test_bad "nested update rejects a non-record intermediate" 75
          (prim_string_concat driver_test_nested_record
            "def bad : User := { user with age.city := Z }; ")
      , driver_test_bad "nested update rejects parent then child overlap" 72
          (prim_string_concat driver_test_nested_record
            "def bad : User := { user with address := home, address.city := Z }; ")
      , driver_test_bad "nested update rejects child then parent overlap" 72
          (prim_string_concat driver_test_nested_record
            "def bad : User := { user with address.city := Z, address := home }; ")
      , driver_test_bad "nested update rejects a duplicate leaf path" 72
          (prim_string_concat driver_test_nested_record
            "def bad : User := { user with address.city := Z, address.city := S Z }; ")
      , driver_test_bad "nested record literal checks a field value" 41
          (prim_string_concat driver_test_nested_record
            "def bad : User := { address := { city := Type, zip := Z }, age := Z }; ")
      , driver_test_bad "nested update checks its leaf type" 41
          (prim_string_concat driver_test_nested_record
            "def bad : User := { user with address.city := Type }; ")
      , driver_test_bad "non-record local shadows a global nominal hint" 77
          (prim_string_concat driver_test_nested_record
            "def item : Address := home; def bad : Nat := let item : Nat := Z in item.city; ")
      , driver_test_bad "record expected type does not leak to an unrelated argument" 73
          (prim_string_concat driver_test_nested_record
            "def keep (n : Nat) : User := user; def bad : User := keep { address := home, age := Z }; ")
      , driver_test_bad "nested update rejects an empty leaf assignment" 71
          (prim_string_concat driver_test_nested_record
            "def bad : User := { user with address.city :=, address.zip := Z }; ")
      , driver_test_bad "record update requires a nominal expected type" 73
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def bad : Nat := { point with x := Z }; ")
      , driver_test_bad "record update rejects an unknown field" 75
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def bad : Point := { point with other := Z }; ")
      , driver_test_bad "record update rejects a duplicate field" 72
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def bad : Point := { point with x := Z, x := S Z }; ")
      , driver_test_bad "record update rejects an empty assignment" 71
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def bad : Point := { point with x := }; ")
      , driver_test_bad "record update rejects an empty change list" 71
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def bad : Point := { point with }; ")
      , driver_test_bad "record update checks its base type" 41
          (prim_string_concat driver_test_record "def bad : Point := { Z with x := S Z }; ")
      , driver_test_bad "record update checks a changed field type" 41
          (prim_string_concat driver_test_record "def point : Point := { x, y }; def bad : Point := { point with x := Type }; ")
      , driver_test_bad "unresolved punned name reaches compiler checking" 2
          "record Point : Type where x : Nat; end; def bad : Point := { x };"
      , driver_test_error (List (Pair Nat CoreTerm)) "imported punned record error is checked" 74
          (driver_test_units "import \"dep.ouro\"; def value : Nat := Z;"
            "record Point : Type where x : Nat; y : Nat; end; def x : Nat := Z; def bad : Point := { x }; ")
      , driver_test_error (List (Pair Nat CoreTerm)) "parse failure stays in its failing imported unit" 10
          (driver_test_units "import \"dep.ouro\"; def value : Nat := ?later;" "def")
      , driver_test_error Nat "generic lowering keeps list-context diagnostic" 64
          (remap_comp_src_for(Nat, False, prim_string_to_char_codes "[]", CErr(Nat, ErrCode 2 1)))
      , driver_test_error Nat "generic parse keeps dangling-pipe diagnostic" 63
          (remap_comp_src_for(Nat, True, prim_string_to_char_codes "value |>", CErr(Nat, ErrCode 10 1)))
      , driver_test_exact_error "file remapping preserves the exact typed failure" 44 77
          (remap_comp_files_for Nat False
            [compiler_test_unit "unrelated.ouro" "?other", compiler_test_unit "main.ouro" "[]"]
            (CErr(Nat, ErrCode 44 77)))
      , driver_test_exact_error "parse hint cannot replace a specific error" 45 77
          (remap_comp_src_for(Nat, True, prim_string_to_char_codes "?other", CErr(Nat, ErrCode 45 77)))
      , MkDriverLaw "successful payload is preserved"
          (match remap_comp_src_for(Nat, False, prim_string_to_char_codes "?other", COk Nat 7) with
           | COk value => eqNat value 7 | CErr _ => False end) "COk 7"
      ];

def driver_test_summary : DriverLaw :=
    let result : CompResult CompilationSummary :=
      compile_source(driver_test_fuel, driver_test_source "def value : Nat := Z;") in
    MkDriverLaw "compile_source summarizes one checked definition"
      (match result with
       | CErr _ => False
       | COk summary =>
           match summary with
           | MkCompilationSummary stages names =>
               andb(eqNat(pipeline_ok stages, 0), eqNat(length NamedInfo names, 1))
           end
       end)
      (driver_test_status CompilationSummary result);

def driver_test_checked_body : DriverLaw :=
    let result : CompResult (List (Pair Nat CoreTerm)) :=
      driver_test_compile "def successor : Nat -> Nat := S;" in
    MkDriverLaw "public result contains the checker constructor closure"
      (match result with
       | CErr _ => False
       | COk cores =>
           match cores with
           | Nil => False
           | Cons pair rest =>
               match pair with
               | MkPair _ body =>
                   andb (eqNat(extract_tag body, 3))
                     (match rest with | Nil => True | Cons _ _ => False end)
               end
           end
       end)
      (driver_test_status(List (Pair Nat CoreTerm), result));

def driver_test_module_pair (root : String) (left : String) (right : String)
    : CompResult (List (Pair Nat CoreTerm)) :=
    compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           root
       , compiler_test_unit "a.ouro" left
       , compiler_test_unit "b.ouro" right
       ] : List (Pair(List Nat, List Nat)));

def driver_test_core_for (program : CheckedProgram) (spelling : String)
    : Maybe CoreTerm :=
  match compiler_test_name program spelling with
  | Nothing => Nothing CoreTerm
  | Just name =>
      (fix find (cores : List (Pair Nat CoreTerm)) : Maybe CoreTerm :=
        match cores with
        | Nil => Nothing CoreTerm
        | Cons entry rest => match entry with
          | MkPair id body =>
              match eqNat id name with
              | True => Just CoreTerm body
              | False => find rest
              end
          end
        end) (checked_program_cores program)
  end;

def driver_test_qualified_record_projection : DriverLaw :=
  let result : CompResult CheckedProgram :=
    compile_checked_units driver_test_fuel
      (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           "import \"a.ouro\" as A; import \"b.ouro\" as B; def Point_x (p : A.Point) : A.Nat := A.S A.Z; def MkPoint (x : A.Nat) : A.Point := A.MkPoint (A.S x); def point : B.OtherPoint := B.MkOtherPoint B.Marker; def projected : A.Nat := A.point.x; def explicit : A.Nat := A.Point_x A.point; def local : A.Point := A.MkPoint A.Z; def localProjected : A.Nat := local.x; def localExplicit : A.Nat := A.Point_x local; def made : A.Point := {x := A.Z}; def madeBare : Point := {x := A.Z}; def madeExplicit : A.Point := A.MkPoint A.Z;"
       , compiler_test_unit "a.ouro"
           "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; record Point : Type where x : Nat; end; def point : Point := MkPoint Z;"
       , compiler_test_unit "b.ouro"
           "inductive Other : Type := | Marker : Other; record OtherPoint : Type where y : Other; end;"
       ] : List (Pair(List Nat, List Nat))) in
  MkDriverLaw "qualified record projection keeps its imported base and owner"
    (match result with
     | CErr _ => False
     | COk program =>
         match driver_test_core_for program "projected" with
         | Nothing => False
         | Just projected => match driver_test_core_for program "explicit" with
           | Nothing => False
           | Just explicit =>
               match driver_test_core_for program "localProjected" with
               | Nothing => False
               | Just localProjected =>
                   match driver_test_core_for program "localExplicit" with
                   | Nothing => False
                   | Just localExplicit =>
                       match driver_test_core_for program "made" with
                       | Nothing => False
                       | Just made =>
                           match driver_test_core_for program "madeBare" with
                           | Nothing => False
                           | Just madeBare =>
                               match driver_test_core_for program "madeExplicit" with
                               | Nothing => False
                               | Just madeExplicit =>
                                   andb(eqTerm 500 projected explicit,
                                     andb(eqTerm 500 localProjected localExplicit,
                                       andb(eqTerm 500 made madeExplicit,
                                         eqTerm 500 madeBare madeExplicit)))
                               end
                           end
                       end
                   end
               end
           end
         end
     end)
    (driver_test_status CheckedProgram result);

def driver_test_local_record_equivalence : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_source
    driver_test_fuel (driver_test_source
      "record Point : Type where x : Nat; end; def point : Point := MkPoint Z; def explicit : Nat := Point_x point; def projected : Nat := point.x;") in
  MkDriverLaw "internal self-owner alias preserves the canonical accessor"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "explicit" with
       | Nothing => False
       | Just explicit => match driver_test_core_for program "projected" with
         | Nothing => False
         | Just projected => eqTerm 500 explicit projected
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_unaliased_record_shadow : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_units
    driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           "import \"dep.ouro\"; def Point_x (p : Point) : Nat := S Z; def point : Point := MkPoint Z; def explicit : Nat := Point_x point; def projected : Nat := point.x;"
       , compiler_test_unit "dep.ouro"
           "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; record Point : Type where x : Nat; end;"
       ] : List (Pair(List Nat, List Nat))) in
  MkDriverLaw "internal imported-owner alias bypasses a local forged accessor"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "explicit" with
       | Nothing => False
       | Just explicit => match driver_test_core_for program "projected" with
         | Nothing => False
         | Just projected => notb (eqTerm 500 explicit projected)
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_typed_record_shadow : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_source
    driver_test_fuel (driver_test_source
      "record Point : Type where x : Nat; end; def canonical_accessor (unused : Point -> Nat) (p : Point) : Nat := Point_x p; def shadow_accessor (Point_x : Point -> Nat) (p : Point) : Nat := p.x; def canonical_ctor (unused : Nat -> Point) : Point := MkPoint Z; def shadow_ctor (MkPoint : Nat -> Point) : Point := {x := Z};") in
  MkDriverLaw "typed local shadows cannot capture generated record references"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "canonical_accessor" with
       | Nothing => False
       | Just accessor => match driver_test_core_for program "shadow_accessor" with
         | Nothing => False
         | Just shadow_accessor =>
             match driver_test_core_for program "canonical_ctor" with
             | Nothing => False
             | Just ctor => match driver_test_core_for program "shadow_ctor" with
               | Nothing => False
               | Just shadow_ctor =>
                   andb(eqTerm 500 accessor shadow_accessor,
                     eqTerm 500 ctor shadow_ctor)
               end
             end
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_qualified_global_shadow : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_units
    driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           "import \"a.ouro\" as A; def canonical (unused : Nat) : Nat := A.target; def shadow (target : Nat) : Nat := A.target; def local (target : Nat) : Nat := target;"
       , compiler_test_unit "a.ouro"
           "inductive Nat : Type := | Z : Nat; def target : Nat := Z;"
       ] : List (Pair(List Nat, List Nat))) in
  MkDriverLaw "qualified global references survive same-name local binders"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "canonical" with
       | Nothing => False
       | Just canonical => match driver_test_core_for program "shadow" with
         | Nothing => False
         | Just shadow => match driver_test_core_for program "local" with
           | Nothing => False
           | Just local =>
               andb(eqTerm 500 canonical shadow,
                 notb (eqTerm 500 shadow local))
           end
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_alias_collision : CompResult (List (Pair Nat CoreTerm)) :=
    driver_test_module_pair
      "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.Shared; def right : Type := B.Shared;"
      "axiom Shared : Type;" "axiom Shared : Type;";

def driver_test_selected_identity : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_units driver_test_fuel
    (prim_string_to_char_codes "main.ouro")
    ([ compiler_test_unit "main.ouro"
         "import \"a.ouro\" as A exposing (Visible as Pick,); def selected : Type := Pick; def qualified : Type := A.Visible; def opened : Type := open A in Pick;"
     , compiler_test_unit "a.ouro" "axiom Visible : Type; axiom Hidden : Type;"
     ] : List (Pair(List Nat, List Nat))) in
  MkDriverLaw "selected, qualified and opened names retain one owner identity"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "selected" with
       | Nothing => False
       | Just selected => match driver_test_core_for program "qualified" with
         | Nothing => False
         | Just qualified => match driver_test_core_for program "opened" with
           | Nothing => False
           | Just opened => andb(eqTerm 500 selected qualified,
               eqTerm 500 opened qualified)
           end
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_selected_record_shadow : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_units driver_test_fuel
    (prim_string_to_char_codes "main.ouro")
    ([ compiler_test_unit "main.ouro"
         "import \"a.ouro\" as A exposing (Nat, Z, S, Point, MkPoint, Point_x); def MkPoint (n : A.Nat) : A.Point := A.MkPoint (A.S n); def made : A.Point := {x := A.Z}; def canonical : A.Point := A.MkPoint A.Z; def projected (p : A.Point) : A.Nat := p.x; def explicit (p : A.Point) : A.Nat := A.Point_x p;"
     , compiler_test_unit "a.ouro"
         "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; record Point : Type where x : Nat; end;"
     ] : List (Pair(List Nat, List Nat))) in
  MkDriverLaw "selected record grants keep the direct owner under a local constructor shadow"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "made" with
       | Nothing => False
       | Just made => match driver_test_core_for program "canonical" with
         | Nothing => False
         | Just canonical => match driver_test_core_for program "projected" with
           | Nothing => False
           | Just projected => match driver_test_core_for program "explicit" with
             | Nothing => False
             | Just explicit => andb(eqTerm 500 made canonical,
                 eqTerm 500 projected explicit)
             end
           end
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_export_dedup : DriverLaw :=
  let exports : List (Pair Nat Nat) := module_unique_exports
    ([MkPair Nat Nat 1 10, MkPair Nat Nat 1 10,
      MkPair Nat Nat 1 11, MkPair Nat Nat 2 12,
      MkPair Nat Nat 1 10] : List (Pair Nat Nat)) in
  MkDriverLaw "shared paths deduplicate bindings without hiding ambiguity"
    (andb(eqNat(length (Pair Nat Nat) exports, 3),
      match module_scope_decision 99 1 (Nil ModuleMember) exports with
      | ModuleAmbiguous => True
      | ModuleAbsent => False
      | ModuleFound _ => False
      end)) "module-exports";

def driver_test_scoped_open : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_units driver_test_fuel
    (prim_string_to_char_codes "main.ouro")
    ([ compiler_test_unit "main.ouro"
         "import \"a.ouro\" as A; import \"b.ouro\" as B; def openA : Type := open A in Shared; def openB : Type := open B in Shared; def nested : Type := open A in open B in Shared; def explicitA : Type := A.Shared; def explicitB : Type := B.Shared; def withLocal (Shared : Type) : Type := open A in Shared; def plainLocal (Shared : Type) : Type := Shared;"
     , compiler_test_unit "a.ouro" "axiom Shared : Type;"
     , compiler_test_unit "b.ouro" "axiom Shared : Type;"
     ] : List (Pair(List Nat, List Nat))) in
  MkDriverLaw "scoped opens select direct identities and the inner open wins"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "openA" with
       | Nothing => False
       | Just openA => match driver_test_core_for program "openB" with
         | Nothing => False
         | Just openB => match driver_test_core_for program "nested" with
           | Nothing => False
           | Just nested => match driver_test_core_for program "explicitA" with
             | Nothing => False
             | Just explicitA => match driver_test_core_for program "explicitB" with
               | Nothing => False
               | Just explicitB => match driver_test_core_for program "withLocal" with
                 | Nothing => False
                 | Just withLocal => match driver_test_core_for program "plainLocal" with
                   | Nothing => False
                   | Just plainLocal =>
                       andb(eqTerm 500 openA explicitA,
                         andb(eqTerm 500 openB explicitB,
                           andb(eqTerm 500 nested explicitB,
                             andb(eqTerm 500 withLocal plainLocal,
                               notb (eqTerm 500 openA openB)))))
                   end
                 end
               end
             end
           end
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_source_guard_open : DriverLaw :=
  match intern_string empty_intern
      (prim_string_to_char_codes "A@Shared") with
  | MkPair marker st1 => match intern_string st1
      (prim_string_to_char_codes "A") with
    | MkPair alias st2 =>
        let bindings : ImpReg := MkImpReg
          [prim_string_to_char_codes "A"]
          (Nil (Pair (List Nat) (List Nat))) (Nil ImpRule) in
        let preserved : Bool :=
          match module_source_guard 80 bindings st2
              [DDef 20 (ESort 0) (EOpen alias (EVar marker)) 0 []] with
          | RErr _ _ => False
          | ROk ds => match ds with
            | Nil => False
            | Cons declaration rest => match rest with
              | Cons _ _ => False
              | Nil => match declaration with
                | DDef _ _ body _ _ => match body with
                  | EOpen selected opened => match opened with
                    | EVar member =>
                        andb(eqNat selected alias, eqNat member marker)
                    | _ => False end
                  | _ => False end
                | _ => False end
              end
            end
          end in
        let rejected : Bool :=
          match module_source_guard 80 bindings st2
              [DDef marker (ESort 0) (ENat 0) 0 []] with
          | RErr code detail => andb(eqNat code 8, eqNat detail marker)
          | ROk _ => False
          end in
        MkDriverLaw "source guard validates markers without erasing an open"
          (andb preserved rejected) "guard"
    end
  end;

def driver_test_open_offsets : DriverLaw :=
  let suffix : List Nat := prim_string_to_char_codes
    "open A in Shared;" in
  let original : List Nat := prim_string_to_char_codes
    "import \"a.ouro\" as A; def chosen : Type := open A in Shared;" in
  MkDriverLaw "open preprocessing preserves text and byte positions"
    (match preprocess_imports_reg empty_imp_reg original with
    | MkPair _ prepared => match prepared with
      | ImpErr _ _ => False
      | ImpOk expanded =>
          andb(eqNat (length Nat original) (length Nat expanded),
            source_bytes_equal suffix
              (drop Nat (sub (length Nat expanded) (length Nat suffix))
                expanded))
      end
    end) "source";

def driver_test_open_current_owner : DriverLaw :=
  let result : CompResult CheckedProgram := compile_checked_units driver_test_fuel
    (prim_string_to_char_codes "main.ouro")
    ([ compiler_test_unit "main.ouro"
         "import \"a.ouro\" as A; axiom Shared : Type; def opened : Type := open A in Shared; def local : Type := Shared; def qualified : Type := A.Shared;"
     , compiler_test_unit "a.ouro" "axiom Shared : Type;"
     ] : List (Pair(List Nat, List Nat))) in
  MkDriverLaw "current file declaration precedes an opened import"
    (match result with
     | CErr _ => False
     | COk program => match driver_test_core_for program "opened" with
       | Nothing => False
       | Just opened => match driver_test_core_for program "local" with
         | Nothing => False
         | Just local => match driver_test_core_for program "qualified" with
           | Nothing => False
           | Just qualified => andb(eqTerm 500 opened local,
               notb (eqTerm 500 opened qualified))
           end
         end
       end
     end) (driver_test_status CheckedProgram result);

def driver_test_alias_scope : CompResult (List (Pair Nat CoreTerm)) :=
    compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.fromA; def right : Type := B.fromB;"
       , compiler_test_unit "a.ouro"
           "import \"c.ouro\" as X; def fromA : Type := X.Shared;"
       , compiler_test_unit "b.ouro"
           "import \"d.ouro\" as X; def fromB : Type := X.Shared;"
       , compiler_test_unit "c.ouro" "axiom Shared : Type;"
       , compiler_test_unit "d.ouro" "axiom Shared : Type;"
       ] : List (Pair(List Nat, List Nat)));

def driver_test_open_file_scope : CompResult (List (Pair Nat CoreTerm)) :=
    compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.fromA; def right : Type := B.fromB;"
       , compiler_test_unit "a.ouro"
           "import \"c.ouro\" as X; def fromA : Type := open X in Shared;"
       , compiler_test_unit "b.ouro"
           "import \"d.ouro\" as X; def fromB : Type := open X in Shared;"
       , compiler_test_unit "c.ouro" "axiom Shared : Type;"
       , compiler_test_unit "d.ouro" "axiom Shared : Type;"
       ] : List (Pair(List Nat, List Nat)));

def driver_test_path (prefix : String) (leaf : String) : String :=
    prim_string_concat(prefix, prim_string_concat("/", leaf));

def driver_test_relocated (prefix : String) : CompResult CheckedProgram :=
    compile_checked_units driver_test_fuel
      (prim_string_to_char_codes (driver_test_path prefix "main.ouro"))
      ([ compiler_test_unit (driver_test_path prefix "main.ouro")
           "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.Shared; def right : Type := B.Shared;"
       , compiler_test_unit (driver_test_path prefix "a.ouro") "axiom Shared : Type;"
       , compiler_test_unit (driver_test_path prefix "b.ouro") "axiom Shared : Type;"
       ] : List (Pair(List Nat, List Nat)));

def driver_test_same_name (first : CheckedProgram) (second : CheckedProgram)
    (name : String) : Bool :=
    match compiler_test_name first name with
    | Nothing => False
    | Just left =>
        match compiler_test_name second name with
        | Nothing => False
        | Just right => eqNat left right
        end
    end;

def driver_test_relocation_law : DriverLaw :=
    match driver_test_relocated "first-root" with
    | CErr error => MkDriverLaw "module identities survive graph relocation" False
        (match error with | ErrCode code _ => prim_string_of_nat code end)
    | COk first =>
        match driver_test_relocated "other/deeper/root" with
        | CErr error => MkDriverLaw "module identities survive graph relocation" False
            (match error with | ErrCode code _ => prim_string_of_nat code end)
        | COk second =>
            MkDriverLaw "module identities survive graph relocation"
              (andb(driver_test_same_name first second "_ouro_m_0_Shared",
                driver_test_same_name first second "_ouro_m_1_Shared"))
              "same internal identifier IDs"
        end
    end;

def driver_test_surface_laws : List DriverLaw :=
    [ driver_test_good "accept a checked constructor value" "def value : Nat := Z;"
    , driver_test_good "accept an explicit assumption" "axiom value : Nat;"
    , driver_test_good "accept universe annotation" "def universe : Type1 := Type;"
    , driver_test_good "accept dependent identity"
        "def identity (A : Type) (x : A) : A := x;"
    , driver_test_summary
    , driver_test_checked_body
    , driver_test_bad "reject wrong definition body" 41 "def bad : Nat := Type;"
    , driver_test_bad "reject a declaration whose annotation is a value" 42
        "def bad : Z := Z;"
    , driver_test_bad "reject unresolved global before elaboration" 2 "def bad : Nat := ghost;"
    , driver_test_bad "reject unchecked self reference" 41 "def bad : Nat := bad;"
    , driver_test_bad "reject an anonymous hole instead of returning fallback Core" 2
        "def bad : Nat := _;"
    , driver_test_bad "reject a named hole with its specific diagnostic" 61
        "def bad : Nat := ?missing;"
    , driver_test_bad "reject duplicate assumptions" 45
        "axiom duplicate : Nat; axiom duplicate : Nat;"
    , driver_test_bad "source-only aliases cannot declare a qualified global" 98
        "import \"missing.ouro\" as A; def A.Shared : Type := Type;"
    , driver_test_bad "source-only aliases cannot bind a qualified local" 98
        "import \"missing.ouro\" as A; def use (A.Shared : Type) : Type := Type;"
    , driver_test_error (List (Pair Nat CoreTerm)) "reject malformed source" 10
        (compile_to_cores(driver_test_fuel, prim_string_to_char_codes "def"))
    , driver_test_error (List (Pair Nat CoreTerm)) "reject malformed lexical input" 11
        (compile_to_cores(driver_test_fuel, prim_string_to_char_codes "@"))
    , driver_test_bad "reject malformed Unicode scalar as a lexical failure" 11
        "def bad : Nat := \"\\u{D800}\";"
    , driver_test_error (List (Pair Nat CoreTerm)) "keep lexer exhaustion distinct" 12
        (compile_to_cores(0, driver_test_source "def value : Nat := Z;"))
    , driver_test_error CompilationSummary "compile_source keeps a parse failure" 10
        (compile_source(driver_test_fuel, prim_string_to_char_codes "def"))
    , driver_test_error CompilationSummary "compile_source keeps a type failure" 41
        (compile_source(driver_test_fuel, driver_test_source "def bad : Nat := Type;"))
    ];

def driver_test_import_laws : List DriverLaw :=
    [ driver_test_error CheckedProgram "source-only checking rejects an unresolved import" 92
        (compile_checked_source driver_test_fuel
          (driver_test_source "import \"definitely-missing.ouro\"; def value : Nat := Z;"))
    , driver_test_bad "core emission rejects a trailing unresolved import" 92
        "def value : Nat := Z; import \"definitely-missing.ouro\";"
    , driver_test_error CompilationSummary "source summary cannot hide an unresolved import" 92
        (compile_source driver_test_fuel
          (driver_test_source "import \"definitely-missing.ouro\"; def value : Nat := Z;"))
    , driver_test_bad "effect roots cannot hide a source-only unresolved import" 92
        "import \"definitely-missing.ouro\"; effect Console where | write : Nat -> Nat def value : Nat := Z;"
    , driver_test_good "import text in comments is not a dependency"
        "-- import \"definitely-missing.ouro\";\ndef value : Nat := Z;"
    , driver_test_good "import text in string literals is not a dependency"
        "intrinsic String : Type := \"ouro.string\"; def value : String := \"import \\\"definitely-missing.ouro\\\";\";"
    , driver_test_error CheckedProgram "declaration entry rejects unresolved imports before lowering" 92
        (compile_checked_from_decls desugar_file rewrite_declarations lower_expr_env2
          compile_program driver_elaborate_surfaces elaborate check_module
          ([] : List Nat) driver_test_fuel empty_intern ([DImport 77] : List Decl))
    , driver_test_residual_open "declaration entry rejects an open around match branches"
        (EMatch (ENat 0)
          (EOpen 88 (EBranch [1] (ENat 0) ENoBranch)))
    , driver_test_residual_open "declaration entry rejects an open around fix binders"
        (EFix 12 (EOpen 88 (EBinder 13 (ESort 0) ENoBinder))
          (ESort 0) (EVar 13))
    , driver_test_residual_open "declaration entry rejects an open inside do"
        (EDo [ESpan 0 2 (EOpen 88 (EDoBind 13 (ENat 0))), ENat 0])
    , driver_test_residual_open "declaration entry rejects an open in fallible container"
        (EFallible (EOpen 88 (EVar 30)) 20 21 (EVar 30))
    , driver_test_residual_open "declaration entry rejects an open in fallible body"
        (EFallible (EVar 30) 20 21 (EOpen 88 (EVar 30)))
    , driver_test_error CheckedProgram
        "declaration entry rejects an open in intrinsic implementation" 98
        (compile_checked_from_decls desugar_file rewrite_declarations lower_expr_env2
          compile_program driver_elaborate_surfaces elaborate check_module
          ([] : List Nat) driver_test_fuel empty_intern
          ([DIntrinsic 77 (ESort 0) 1 (Just Expr (EOpen 88 (ENat 0)))]
            : List Decl))
    , driver_test_accept (List (Pair Nat CoreTerm)) "accept a checked dependency"
