-- Public source compilation uses the canonical declaration checker for roots
-- and imported bodies, and returns the bodies that checker actually produced.

import "../compiler/driver.ouro",
  "../std/io.ouro",
  "compiler_program_lookup.ouro";

inductive DriverLaw : Type :=
  | MkDriverLaw : String -> Bool -> String -> DriverLaw;

def driver_test_fuel : Nat := mul 100 50;

def driver_test_nat : String :=
    "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; ";

def driver_test_source (body : String) : List Nat :=
    prim_string_to_char_codes (prim_string_concat driver_test_nat body);

def driver_test_compile (body : String) : CompResult (List (Pair Nat CoreTerm)) :=
    compile_to_cores(driver_test_fuel, driver_test_source body);

def driver_test_status (A : Type) (result : CompResult A) : String :=
    match result with
    | COk _ => "COk"
    | CErr error =>
        match error with
        | ErrCode code detail =>
            prim_string_concat "CErr "
              (prim_string_concat (prim_string_of_nat code)
                (prim_string_concat("/", prim_string_of_nat detail)))
        end
    end;

def driver_test_accept (A : Type) (name : String) (result : CompResult A)
    : DriverLaw :=
    MkDriverLaw name
      (match result with | COk _ => True | CErr _ => False end)
      (driver_test_status A result);

def driver_test_error (A : Type) (name : String) (expected : Nat)
    (result : CompResult A) : DriverLaw :=
    MkDriverLaw name
      (match result with
       | COk _ => False
       | CErr error =>
           match error with | ErrCode code _ => eqNat code expected end
       end)
      (driver_test_status A result);

def driver_test_good (name : String) (body : String) : DriverLaw :=
    driver_test_accept(List (Pair Nat CoreTerm), name, driver_test_compile body);

def driver_test_bad (name : String) (code : Nat) (body : String) : DriverLaw :=
    driver_test_error(List (Pair Nat CoreTerm), name, code, driver_test_compile body);

def driver_test_units (root : String) (dependency : String)
    : CompResult (List (Pair Nat CoreTerm)) :=
    compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([compiler_test_unit "main.ouro" root, compiler_test_unit "dep.ouro" dependency]
        : List (Pair(List Nat, List Nat)));

def driver_test_import_root : String :=
    "import \"dep.ouro\"; def value : Nat := Z;";

def driver_test_bad_dependency : String :=
    prim_string_concat driver_test_nat "def hidden : Nat := Type;";

def driver_test_valid_list : String :=
    "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A; def values : List Nat := [Z]; ";

def driver_test_exact_error (name : String) (code : Nat) (detail : Nat) (result : CompResult Nat)
    : DriverLaw :=
    MkDriverLaw name (match result with
      | COk _ => False
      | CErr error => match error with | ErrCode actual position =>
          andb(eqNat actual code, eqNat position detail) end
      end) (driver_test_status Nat result);

def driver_test_diagnostic_laws : List DriverLaw :=
    append DriverLaw
      (map Nat DriverLaw (fun (code : Nat) =>
        driver_test_exact_error (prim_string_concat("specific error is preserved: ", prim_string_of_nat code)) code 77
          (remap_comp_src_for Nat False (prim_string_to_char_codes "?unrelated [] |> let!")
            (CErr(Nat, ErrCode code 77)))) ([3, 11, 12, 41, 42, 43, 44, 45, 46, 47, 48, 49, 61, 62, 63, 64, 65, 92] : List Nat))
      [ driver_test_bad "valid list cannot replace body type failure" 41
          (prim_string_concat driver_test_valid_list "def bad : Nat := Type;")
      , driver_test_bad "valid list cannot replace duplicate declaration failure" 45
          (prim_string_concat driver_test_valid_list "axiom twice : Nat; axiom twice : Nat;")
      , driver_test_error (List (Pair Nat CoreTerm)) "parse failure stays in its failing imported unit" 10
          (driver_test_units "import \"dep.ouro\"; def value : Nat := ?later;" "def")
      , driver_test_error Nat "generic lowering keeps list-context diagnostic" 64
          (remap_comp_src_for(Nat, False, prim_string_to_char_codes "[]", CErr(Nat, ErrCode 2 1)))
      , driver_test_error Nat "generic parse keeps dangling-pipe diagnostic" 63
          (remap_comp_src_for(Nat, True, prim_string_to_char_codes "value |>", CErr(Nat, ErrCode 10 1)))
      , driver_test_exact_error "file remapping preserves the exact typed failure" 44 77
          (remap_comp_files_for Nat False
            [compiler_test_unit "unrelated.ouro" "?other", compiler_test_unit "main.ouro" "[]"]
            (CErr(Nat, ErrCode 44 77)))
      , driver_test_exact_error "parse hint cannot replace a specific error" 45 77
          (remap_comp_src_for(Nat, True, prim_string_to_char_codes "?other", CErr(Nat, ErrCode 45 77)))
      , MkDriverLaw "successful payload is preserved"
          (match remap_comp_src_for(Nat, False, prim_string_to_char_codes "?other", COk Nat 7) with
           | COk value => eqNat value 7 | CErr _ => False end) "COk 7"
      ];

def driver_test_summary : DriverLaw :=
    let result : CompResult CompilationSummary :=
      compile_source(driver_test_fuel, driver_test_source "def value : Nat := Z;") in
    MkDriverLaw "compile_source summarizes one checked definition"
      (match result with
       | CErr _ => False
       | COk summary =>
           match summary with
           | MkCompilationSummary stages names =>
               andb(eqNat(pipeline_ok stages, 0), eqNat(length NamedInfo names, 1))
           end
       end)
      (driver_test_status CompilationSummary result);

def driver_test_checked_body : DriverLaw :=
    let result : CompResult (List (Pair Nat CoreTerm)) :=
      driver_test_compile "def successor : Nat -> Nat := S;" in
    MkDriverLaw "public result contains the checker constructor closure"
      (match result with
       | CErr _ => False
       | COk cores =>
           match cores with
           | Nil => False
           | Cons pair rest =>
               match pair with
               | MkPair _ body =>
                   andb (eqNat(extract_tag body, 3))
                     (match rest with | Nil => True | Cons _ _ => False end)
               end
           end
       end)
      (driver_test_status(List (Pair Nat CoreTerm), result));

def driver_test_module_pair (root : String) (left : String) (right : String)
    : CompResult (List (Pair Nat CoreTerm)) :=
    compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           root
       , compiler_test_unit "a.ouro" left
       , compiler_test_unit "b.ouro" right
       ] : List (Pair(List Nat, List Nat)));

def driver_test_alias_collision : CompResult (List (Pair Nat CoreTerm)) :=
    driver_test_module_pair
      "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.Shared; def right : Type := B.Shared;"
      "axiom Shared : Type;" "axiom Shared : Type;";

def driver_test_alias_scope : CompResult (List (Pair Nat CoreTerm)) :=
    compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
      ([ compiler_test_unit "main.ouro"
           "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.fromA; def right : Type := B.fromB;"
       , compiler_test_unit "a.ouro"
           "import \"c.ouro\" as X; def fromA : Type := X.Shared;"
       , compiler_test_unit "b.ouro"
           "import \"d.ouro\" as X; def fromB : Type := X.Shared;"
       , compiler_test_unit "c.ouro" "axiom Shared : Type;"
       , compiler_test_unit "d.ouro" "axiom Shared : Type;"
       ] : List (Pair(List Nat, List Nat)));

def driver_test_path (prefix : String) (leaf : String) : String :=
    prim_string_concat(prefix, prim_string_concat("/", leaf));

def driver_test_relocated (prefix : String) : CompResult CheckedProgram :=
    compile_checked_units driver_test_fuel
      (prim_string_to_char_codes (driver_test_path prefix "main.ouro"))
      ([ compiler_test_unit (driver_test_path prefix "main.ouro")
           "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.Shared; def right : Type := B.Shared;"
       , compiler_test_unit (driver_test_path prefix "a.ouro") "axiom Shared : Type;"
       , compiler_test_unit (driver_test_path prefix "b.ouro") "axiom Shared : Type;"
       ] : List (Pair(List Nat, List Nat)));

def driver_test_same_name (first : CheckedProgram) (second : CheckedProgram)
    (name : String) : Bool :=
    match compiler_test_name first name with
    | Nothing => False
    | Just left =>
        match compiler_test_name second name with
        | Nothing => False
        | Just right => eqNat left right
        end
    end;

def driver_test_relocation_law : DriverLaw :=
    match driver_test_relocated "first-root" with
    | CErr error => MkDriverLaw "module identities survive graph relocation" False
        (match error with | ErrCode code _ => prim_string_of_nat code end)
    | COk first =>
        match driver_test_relocated "other/deeper/root" with
        | CErr error => MkDriverLaw "module identities survive graph relocation" False
            (match error with | ErrCode code _ => prim_string_of_nat code end)
        | COk second =>
            MkDriverLaw "module identities survive graph relocation"
              (andb(driver_test_same_name first second "_ouro_m_0_Shared",
                driver_test_same_name first second "_ouro_m_1_Shared"))
              "same internal identifier IDs"
        end
    end;

def driver_test_surface_laws : List DriverLaw :=
    [ driver_test_good "accept a checked constructor value" "def value : Nat := Z;"
    , driver_test_good "accept an explicit assumption" "axiom value : Nat;"
    , driver_test_good "accept universe annotation" "def universe : Type1 := Type;"
    , driver_test_good "accept dependent identity"
        "def identity (A : Type) (x : A) : A := x;"
    , driver_test_summary
    , driver_test_checked_body
    , driver_test_bad "reject wrong definition body" 41 "def bad : Nat := Type;"
    , driver_test_bad "reject a declaration whose annotation is a value" 42
        "def bad : Z := Z;"
    , driver_test_bad "reject unresolved global before elaboration" 2 "def bad : Nat := ghost;"
    , driver_test_bad "reject unchecked self reference" 41 "def bad : Nat := bad;"
    , driver_test_bad "reject an anonymous hole instead of returning fallback Core" 2
        "def bad : Nat := _;"
    , driver_test_bad "reject a named hole with its specific diagnostic" 61
        "def bad : Nat := ?missing;"
    , driver_test_bad "reject duplicate assumptions" 45
        "axiom duplicate : Nat; axiom duplicate : Nat;"
    , driver_test_bad "source-only aliases cannot declare a qualified global" 98
        "import \"missing.ouro\" as A; def A.Shared : Type := Type;"
    , driver_test_bad "source-only aliases cannot bind a qualified local" 98
        "import \"missing.ouro\" as A; def use (A.Shared : Type) : Type := Type;"
    , driver_test_error (List (Pair Nat CoreTerm)) "reject malformed source" 10
        (compile_to_cores(driver_test_fuel, prim_string_to_char_codes "def"))
    , driver_test_error (List (Pair Nat CoreTerm)) "reject malformed lexical input" 11
        (compile_to_cores(driver_test_fuel, prim_string_to_char_codes "@"))
    , driver_test_error (List (Pair Nat CoreTerm)) "keep lexer exhaustion distinct" 12
        (compile_to_cores(0, driver_test_source "def value : Nat := Z;"))
    , driver_test_error CompilationSummary "compile_source keeps a parse failure" 10
        (compile_source(driver_test_fuel, prim_string_to_char_codes "def"))
    , driver_test_error CompilationSummary "compile_source keeps a type failure" 41
        (compile_source(driver_test_fuel, driver_test_source "def bad : Nat := Type;"))
    ];

def driver_test_import_laws : List DriverLaw :=
    [ driver_test_error CheckedProgram "source-only checking rejects an unresolved import" 92
        (compile_checked_source driver_test_fuel
          (driver_test_source "import \"definitely-missing.ouro\"; def value : Nat := Z;"))
    , driver_test_bad "core emission rejects a trailing unresolved import" 92
        "def value : Nat := Z; import \"definitely-missing.ouro\";"
    , driver_test_error CompilationSummary "source summary cannot hide an unresolved import" 92
        (compile_source driver_test_fuel
          (driver_test_source "import \"definitely-missing.ouro\"; def value : Nat := Z;"))
    , driver_test_bad "effect roots cannot hide a source-only unresolved import" 92
        "import \"definitely-missing.ouro\"; effect Console where | write : Nat -> Nat def value : Nat := Z;"
    , driver_test_good "import text in comments is not a dependency"
        "-- import \"definitely-missing.ouro\";\ndef value : Nat := Z;"
    , driver_test_good "import text in string literals is not a dependency"
        "intrinsic String : Type := \"ouro.string\"; def value : String := \"import \\\"definitely-missing.ouro\\\";\";"
    , driver_test_error CheckedProgram "declaration entry rejects unresolved imports before lowering" 92
        (compile_checked_from_decls desugar_file rewrite_declarations lower_expr_env2
          compile_program driver_elaborate_surfaces elaborate check_module
          ([] : List Nat) driver_test_fuel empty_intern ([DImport 77] : List Decl))
    , driver_test_accept (List (Pair Nat CoreTerm)) "accept a checked dependency"
        (driver_test_units driver_test_import_root driver_test_nat)
    , driver_test_accept (List (Pair Nat CoreTerm)) "conversion uses a checked imported body"
        (driver_test_units "import \"dep.ouro\"; def value : Alias := Z;"
          (prim_string_concat driver_test_nat "def Alias : Type := Nat;"))
    , driver_test_accept (List (Pair Nat CoreTerm)) "import alias uses shared nominal declarations"
        (driver_test_units "import \"dep.ouro\" as D; def value : D.Nat := D.Z;"
          driver_test_nat)
    , driver_test_error (List (Pair Nat CoreTerm)) "reject an unused imported invalid body" 41
        (driver_test_units driver_test_import_root driver_test_bad_dependency)
    , driver_test_error (List (Pair Nat CoreTerm)) "preserve imported parse failure" 10
        (driver_test_units driver_test_import_root "def")
    , driver_test_error (List (Pair Nat CoreTerm)) "preserve imported lexical failure" 11
        (driver_test_units driver_test_import_root "@")
    , driver_test_error (List (Pair Nat CoreTerm)) "reject a missing imported unit" 92
        (compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
          ([compiler_test_unit "main.ouro" driver_test_import_root]
            : List (Pair(List Nat, List Nat))))
    , driver_test_error (List (Pair Nat CoreTerm)) "reject an import cycle" 91
        (driver_test_units "import \"dep.ouro\";" "import \"main.ouro\";")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "aliases select distinct direct declarations with the same short name"
        driver_test_alias_collision
    , driver_test_error (List (Pair Nat CoreTerm))
        "plain colliding imports still reject duplicate declarations" 45
        (driver_test_module_pair
          "import \"a.ouro\"; import \"b.ouro\";"
          "axiom Shared : Type;" "axiom Shared : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "unreached alias file does not change plain import collision behavior" 45
        (compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
          ([ compiler_test_unit "main.ouro"
               "import \"a.ouro\"; import \"b.ouro\";"
           , compiler_test_unit "a.ouro" "axiom Shared : Type;"
           , compiler_test_unit "b.ouro" "axiom Shared : Type;"
           , compiler_test_unit "unrelated.ouro"
               "import \"unused.ouro\" as U; axiom Other : Type;"
           , compiler_test_unit "unused.ouro" "axiom Unused : Type;"
           ] : List (Pair(List Nat, List Nat))))
    , driver_test_error (List (Pair Nat CoreTerm))
        "module identity preserves cross-module type mismatch" 41
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def wrong : A.Value := B.BV;"
          "inductive Value : Type := | AV : Value;"
          "inductive Value : Type := | BV : Value;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "qualified Nat types with the same short name stay distinct"
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def custom : A.Nat := A.Zero; def standard : B.Nat := B.Z;"
          "inductive Nat : Type := | Zero : Nat;" driver_test_nat)
    , driver_test_error (List (Pair Nat CoreTerm))
        "a custom Nat value cannot inhabit another module's Nat" 41
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def wrong : A.Nat := B.Z;"
          "inductive Nat : Type := | Zero : Nat;" driver_test_nat)
    , driver_test_accept (List (Pair Nat CoreTerm))
        "string literals use the checked intrinsic across a name collision"
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def text : A.String := \"ok\";"
          "intrinsic String : Type := \"ouro.string\";"
          "axiom String : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "string literals cannot inhabit an unrelated colliding String" 41
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def wrong : B.String := \"ok\";"
          "intrinsic String : Type := \"ouro.string\";"
          "axiom String : Type;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "renamed String intrinsic still types a colliding transparent alias"
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def text : A.String := \"ok\";"
          "intrinsic Text : Type := \"ouro.string\"; def String : Type := Text;"
          "axiom String : Type;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "list literals select represented List and its own constructors"
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; inductive Item : Type := | One : Item; def items : A.List Item := [One];"
          "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A; representation List := \"ouro.list\";"
          "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "list literal cannot inhabit an unrelated colliding List" 41
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; inductive Item : Type := | One : Item; def wrong : B.List Item := [One];"
          "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A; representation List := \"ouro.list\";"
          "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "duplicate List roles reject instead of selecting the first" 45
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; inductive Item : Type := | One : Item; def items : A.List Item := A.Nil Item;"
          "inductive List (A : Type) : Type := | Nil : List A | Cons : A -> List A -> List A; representation List := \"ouro.list\";"
          "inductive List (A : Type) : Type := | Empty : List A | Push : A -> List A -> List A; representation List := \"ouro.list\";")
    , driver_test_good "unambiguous legacy do wrappers still lower"
        "axiom IO : Type -> Type; axiom io_bind : (A : Type) -> (B : Type) -> IO A -> (A -> IO B) -> IO B; axiom initial : IO Nat; def action : IO Nat := do let! x := initial; initial"
    , driver_test_good "do can use registered Runtime and bind without legacy wrapper names"
        "intrinsic Runtime : Type -> Type := \"ouro.runtime\"; intrinsic runtime_bind : (A : Type) -> (B : Type) -> Runtime A -> (A -> Runtime B) -> Runtime B := \"ouro.runtime.bind\"; axiom initial : Runtime Nat; def action : Runtime Nat := do let! x := initial; initial"
    , driver_test_error (List (Pair Nat CoreTerm))
        "root IO wrapper cannot shadow an imported IO during do lowering" 96
        (driver_test_module_pair
          "import \"a.ouro\" as A; def IO (T : Type) : Type := T; def bad : IO Type := do let! x := A.action; A.action"
          "axiom IO : Type -> Type; axiom action : IO Type;"
          "axiom Other : Type;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "lexical binder wins over ambiguous imported name"
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def choose (Shared : Type) : Type := Shared;"
          "axiom Shared : Type;" "axiom Shared : Type;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "constructors keep their declaring module identity"
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def first : A.Left := A.Mk; def second : B.Right := B.Mk;"
          "inductive Left : Type := | Mk : Left;"
          "inductive Right : Type := | Mk : Right;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "qualified constructor pattern resolves through its direct owner"
        (driver_test_module_pair
          "import \"a.ouro\" as A; def choose (value : A.Choice) : A.Choice := match value with | A.Chosen => A.Chosen end;"
          "inductive Choice : Type := | Chosen : Choice;"
          "axiom Other : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "qualified non-constructor cannot become a pattern binder" 98
        (driver_test_module_pair
          "import \"a.ouro\" as A; def choose (value : Type) : Type := match value with | A.other => Type end;"
          "axiom other : Type;" "axiom Other : Type;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "generated record constructor and accessor belong to their file"
        (driver_test_module_pair
          "import \"a.ouro\" as A; def point : A.Point := A.MkPoint A.Z; def value : A.Nat := A.Point_x point;"
          "inductive Nat : Type := | Z : Nat; record Point : Type where x : Nat; end;"
          "axiom Other : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "unqualified colliding imports are ambiguous" 96
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def value : Type := Shared;"
          "axiom Shared : Type;" "axiom Shared : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "qualified lookup cannot borrow a transitive declaration" 95
        (driver_test_module_pair
          "import \"a.ouro\" as A; def value : Type := A.Hidden;"
          "import \"b.ouro\";" "axiom Hidden : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "qualified lookup rejects a missing direct name" 95
        (driver_test_module_pair
          "import \"a.ouro\" as A; def value : Type := A.Missing;"
          "axiom Present : Type;" "axiom Other : Type;")
    , driver_test_accept (List (Pair Nat CoreTerm))
        "the same alias spelling is local to each source file"
        driver_test_alias_scope
    , driver_test_relocation_law
    , driver_test_accept (List (Pair Nat CoreTerm))
        "equivalent import spellings select one canonical module"
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"./a.ouro\" as Again; def left : Type := A.Shared; def right : Type := Again.Shared;"
          "axiom Shared : Type;" "axiom Other : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "two supplied bodies cannot claim one normalized module path" 98
        (compile_units driver_test_fuel (prim_string_to_char_codes "main.ouro")
          ([ compiler_test_unit "main.ouro"
               "import \"a.ouro\" as A; def value : Type := A.Shared;"
           , compiler_test_unit "a.ouro" "axiom Shared : Type;"
           , compiler_test_unit "./a.ouro" "axiom Other : Type;"
           ] : List (Pair(List Nat, List Nat))))
    , driver_test_accept (List (Pair Nat CoreTerm))
        "an alias qualifier wins over a same-spelled local binder"
        (driver_test_module_pair
          "import \"a.ouro\" as A; def use (A : Type) : Type := A.Shared;"
          "axiom Shared : Type;" "axiom Other : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "a qualified spelling cannot declare a new global" 98
        (driver_test_module_pair
          "import \"a.ouro\" as A; def A.Shared : Type := Type;"
          "axiom Shared : Type;" "axiom Other : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "a qualified spelling cannot bind a local" 98
        (driver_test_module_pair
          "import \"a.ouro\" as A; def use (A.Shared : Type) : Type := Type;"
          "axiom Shared : Type;" "axiom Other : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "source identifiers cannot forge generated module identities" 98
        (driver_test_module_pair
          "import \"a.ouro\" as A; import \"b.ouro\" as B; def _ouro_m_0_Shared : Type := Type; def left : Type := A.Shared; def right : Type := B.Shared;"
          "axiom Shared : Type;" "axiom Shared : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "an unbound dotted prefix remains an invalid record projection" 77
        (driver_test_module_pair
          "import \"a.ouro\" as A; def value : Type := Unknown.Shared;"
          "axiom Shared : Type;" "axiom Other : Type;")
    , driver_test_error (List (Pair Nat CoreTerm))
        "raw qualified marker syntax is rejected" 11
        (driver_test_module_pair
          "import \"a.ouro\" as A; def value : Type := A@Shared;"
          "axiom Shared : Type;" "axiom Other : Type;")
    , driver_test_good "raw marker text in comments remains inert"
        "-- A@Shared\ndef value : Nat := Z;"
    , driver_test_accept (List (Pair Nat CoreTerm))
        "raw marker text in strings remains literal"
        (driver_test_compile
          "intrinsic String : Type := \"ouro.string\"; def value : String := \"A@Shared\";")
    , driver_test_error (List (Pair Nat CoreTerm))
        "an unused imported invalid body remains checked with aliases" 41
        (driver_test_module_pair
          "import \"a.ouro\" as A; def value : Nat := Z;"
          driver_test_bad_dependency "axiom Other : Type;")
    ];

def driver_test_effect_laws : List DriverLaw :=
    [ driver_test_good "effect roots still check ordinary valid definitions"
        "effect Console where | write : Nat -> Nat def value : Nat := Z;"
    , driver_test_bad "effect roots reject an invalid definition" 41
        "effect Console where | write : Nat -> Nat def bad : Nat := Type;"
    , driver_test_good "source pipeline applies the shared handler rewrite"
        "effect Console where | write : Nat -> Nat def handled : Nat := handle perform write(Z) with | write (n) k => k n | pure x => x end;"
    , driver_test_error (List (Pair Nat CoreTerm)) "effect roots reject an invalid imported body" 41
        (driver_test_units
          "import \"dep.ouro\"; effect Console where | write : Nat -> Nat def value : Nat := Z;"
          driver_test_bad_dependency)
    ];

def driver_run : List DriverLaw -> Bool -> IO Bool :=
    fix driver_run (laws : List DriverLaw) (failed : Bool) : IO Bool :=
      match laws with
      | Nil => io_pure Bool failed
      | Cons law rest =>
          match law with
          | MkDriverLaw name passed observed =>
              do println (prim_string_concat
                   (match passed with | True => "PASS " | False => "FAIL " end)
                   (prim_string_concat(name, prim_string_concat ": " observed)));
                 driver_run(rest, orb(failed, notb passed))
          end
      end;

-- @entry main
def main : IO Unit :=
    (do let! surface_failed := driver_run driver_test_surface_laws False;
        let! imports_failed := driver_run driver_test_import_laws surface_failed;
        let! effects_failed := driver_run driver_test_effect_laws imports_failed;
        let! diagnostics_failed := driver_run driver_test_diagnostic_laws effects_failed;
        match diagnostics_failed with
        | True => do println "COMPILER_DRIVER: FAIL"; exit 1
        | False => println "COMPILER_DRIVER: PASS"
        end);
