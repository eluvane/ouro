-- Checked source constants, Bool CFG, and local Maybe elimination.
import "native_lower_loop_fixtures.ouro";

def lower_constant_roles : String :=
    "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; representation Nat := \"ouro.nat\"; inductive Truth : Type := | Yes : Truth | No : Truth; representation Truth := \"ouro.bool\"; inductive Choice (A : Type) : Type := | None : Choice A | Some : A -> Choice A; representation Choice := \"ouro.maybe\"; ";

def lower_constant_intrinsics : String :=
    "intrinsic from_word : Nat -> Choice W := \"ouro.u32.from_nat.checked\"; intrinsic from_byte : Nat -> Choice Byte := \"ouro.u8.from_nat.checked\"; intrinsic from_wide : Nat -> Choice Wide := \"ouro.u64.from_nat.checked\"; intrinsic from_signed : Nat -> Choice Signed := \"ouro.i32.from_nat.checked\"; intrinsic from_size : Nat -> Choice Size := \"ouro.usize.from_nat.checked\"; intrinsic same : W -> W -> Truth := \"ouro.u32.eq\"; intrinsic less : W -> W -> Truth := \"ouro.u32.lt\"; intrinsic size_same : Size -> Size -> Truth := \"ouro.usize.eq\"; intrinsic signed_less : Signed -> Signed -> Truth := \"ouro.i32.lt\"; ";

def lower_constant_base : String := lower_fixture_join
    ([lower_fixture_base, lower_fixture_word_types, lower_constant_roles, lower_constant_intrinsics] : List String);

def lower_constant_zero : String := prim_string_concat lower_constant_base
    "def main : Runtime W := match from_word 0 with | None => pid | Some value => pure W value end;";
def lower_constant_word : String := prim_string_concat lower_constant_base
    "def main : Runtime W := match from_word 42 with | None => pid | Some value => pure W value end;";
def lower_constant_byte_max : String := prim_string_concat lower_constant_base
    "def main : Runtime W := match from_byte 255 with | None => pid | Some value => pure W (unbyte value) end;";
def lower_constant_byte_overflow : String := prim_string_concat lower_constant_base
    "def main : Runtime W := match from_byte 256 with | None => (match from_word 42 with | None => pid | Some value => pure W value end) | Some wrapped => pure W (unbyte wrapped) end;";
def lower_constant_wide : String := prim_string_concat lower_constant_base
    "def main : Runtime W := match from_wide 256 with | None => pid | Some value => pure W (narrow value) end;";
def lower_constant_size : String := prim_string_concat lower_constant_base
    "def main : Runtime W := match from_size 64 with | None => pid | Some value => pure W (narrow (as_wide value)) end;";
def lower_constant_signed : String := prim_string_concat lower_constant_base
    "def main : Runtime W := match from_signed 42 with | None => pid | Some value => pure W (as_unsigned value) end;";
def lower_constant_local : String := prim_string_concat lower_constant_base
    "def Alias : Type := W; def main : Runtime Alias := let count : Nat := 40 in let count : Nat := S (S count) in let selected : Choice Alias := from_word count in match selected with | None => pid | Some value => pure Alias value end;";
def lower_constant_maybe_ctor : String := prim_string_concat lower_constant_base
    "def main : Runtime W := bind W W pid (fun (x : W) => let empty : Choice W := None W in match empty with | None => (let present : Choice W := Some W x in match present with | None => pure W (sub x x) | Some saved => pure W saved end) | Some wrong => pure W (sub wrong wrong) end);";

def lower_constant_bool : String := prim_string_concat lower_constant_base
    "def choose (truth : Truth) (first : W) (second : W) : W := match truth with | Yes => first | No => second end; def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in pure W (add (choose Yes x zero) (choose No x zero)));";
def lower_constant_bool_compare : String := prim_string_concat lower_constant_base
    "def check (x : W) (zero : W) : Truth := match same x x with | Yes => less zero x | No => No end; def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in match check x zero with | Yes => (match same x zero with | Yes => pure W zero | No => pure W x end) | No => pure W zero end);";
def lower_constant_bool_signed : String := prim_string_concat lower_constant_base
    "def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in let negative : Signed := as_signed (sub zero x) in match signed_less negative (as_signed zero) with | Yes => pure W x | No => pure W zero end);";
def lower_constant_bool_ordinal : String := prim_string_concat lower_fixture_base
    "inductive Truth : Type := | False : Truth | True : Truth; representation Truth := \"ouro.bool\"; intrinsic equal : W -> W -> Truth := \"ouro.u32.eq\"; def main : Runtime W := bind W W pid (fun (x : W) => match equal x x with | False => pure W x | True => pure W (sub x x) end);";

def lower_constant_bool_effect : String := lower_fixture_join
    ([lower_constant_base, lower_fixture_error_state,
      "def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in bind Empty W (set_error zero) (fun (reset : Empty) => let delayed : Runtime Empty := match less zero x with | Yes => set_error x | No => set_error zero end in bind Empty W delayed (fun (first : Empty) => bind W W get_error (fun (saved : W) => bind Empty W (match same zero x with | Yes => set_error zero | No => set_error x end) (fun (second : Empty) => bind W W get_error (fun (current : W) => pure W (sub (add saved current) x))))))); "] : List String);

def lower_constant_bool_unit : String := lower_fixture_join
    ([lower_constant_base, lower_fixture_error_state,
      "def empty (truth : Truth) : Empty := match truth with | Yes => EmptyValue | No => EmptyValue end; def main : Runtime W := bind W W pid (fun (x : W) => bind Empty W (pure Empty (empty Yes)) (fun (ignored : Empty) => pure W x));"] : List String);

def lower_constant_memory : String := lower_fixture_join
    ([lower_constant_base,
      "inductive Empty : Type := | EmptyValue : Empty; representation Empty := \"ouro.unit\"; ",
      "intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic null : (A : Type) -> Pointer A := \"ouro.raw.null\"; ",
      "intrinsic raw_add : (A : Type) -> Pointer A -> Size -> Runtime (Pointer A) := \"ouro.raw.add.wrap\"; ",
      "intrinsic raw_cast : (A : Type) -> (B : Type) -> Pointer A -> Runtime (Pointer B) := \"ouro.raw.cast\"; ",
      "intrinsic pointer_bits : (A : Type) -> Pointer A -> Runtime Size := \"ouro.raw.to_bits\"; ",
      "intrinsic read_word : Pointer W -> Runtime W := \"ouro.raw.load\" W; intrinsic write_word : Pointer W -> W -> Runtime Empty := \"ouro.raw.store\" W; ",
      "extern heap : Runtime (Pointer Empty) := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetProcessHeap\" \"maygc\"; ",
      "extern allocate : Pointer Empty -> W -> Size -> Runtime (Pointer Byte) := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"HeapAlloc\" \"maygc\"; ",
      "extern release : Pointer Empty -> W -> Pointer Byte -> Runtime W := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"HeapFree\" \"maygc\"; "] : List String);

-- Allocation size, zero and byte offset are checked Nat conversions. This
-- fixture has no GetCurrentProcess declaration or pseudo-handle dependency.
def lower_constant_allocation : String := lower_fixture_join
    ([lower_constant_memory,
      "def main : Runtime W := match from_word 0 with | None => pid | Some zero => (match from_word 42 with | None => pid | Some value => ",
      "(match from_size 0 with | None => pid | Some zero_size => (match from_size 64 with | None => pid | Some count => ",
      "(match from_size 4 with | None => pid | Some offset => bind (Pointer Empty) W heap (fun (owner : Pointer Empty) => ",
      "bind (Pointer Byte) W (allocate owner zero count) (fun (allocated : Pointer Byte) => bind Size W (pointer_bits Byte allocated) (fun (bits : Size) => ",
      "match size_same bits zero_size with | Yes => pure W zero | No => bind (Pointer W) W (raw_cast Byte W allocated) (fun (base : Pointer W) => ",
      "bind (Pointer W) W (raw_add W base offset) (fun (target : Pointer W) => bind Empty W (write_word target value) (fun (stored : Empty) => ",
      "bind W W (read_word target) (fun (observed : W) => bind W W (release owner zero allocated) (fun (status : W) => ",
      "match same status zero with | Yes => pure W zero | No => pure W observed end))))) end))) end) end) end) end) end;"] : List String);

def lower_constant_null_branch : String := lower_fixture_join
    ([lower_constant_memory,
      "def main : Runtime W := match from_word 42 with | None => pid | Some value => (match from_size 0 with | None => pid | Some zero => bind Size W (pointer_bits W (null W)) (fun (bits : Size) => match size_same bits zero with | Yes => pure W value | No => read_word (null W) end) end) end;"] : List String);

def lower_constant_bool_loop : String := lower_fixture_join
    ([lower_constant_base, lower_fixture_error_state,
      "intrinsic loop : (A : Type) -> A -> (A -> Runtime Byte) -> (A -> Runtime A) -> Runtime A := \"ouro.runtime.loop\"; intrinsic byte_sub : Byte -> Byte -> Byte := \"ouro.u8.sub.wrap\"; intrinsic byte_equal : Byte -> Byte -> Truth := \"ouro.u8.eq\"; ",
      "def main : Runtime W := bind W W pid (fun (x : W) => match from_byte 1 with | None => pid | Some one => (match from_byte 3 with | None => pid | Some three => ",
      "bind Empty W (set_error (sub x x)) (fun (reset : Empty) => bind Byte W (loop Byte three (fun (state : Byte) => pure Byte state) ",
      "(fun (state : Byte) => match byte_equal state one with | Yes => bind W Byte (increment x) (fun (changed : W) => pure Byte (byte_sub state one)) ",
      "| No => bind W Byte (increment (add x x)) (fun (changed : W) => pure Byte (byte_sub state one)) end)) (fun (finished : Byte) => get_error)) end) end);"] : List String);

-- Modes 10..14 are exact 0,42,255,256,64; mode 15 is 5*PID modulo 2^32.
def lower_constant_fixtures : List NativeLowerFixture :=
    [NativeLowerFixtureOf "constant_zero" lower_constant_zero 10,
     NativeLowerFixtureOf "constant_word" lower_constant_word 11,
     NativeLowerFixtureOf "constant_u8_max" lower_constant_byte_max 12,
     NativeLowerFixtureOf "constant_u8_overflow" lower_constant_byte_overflow 11,
     NativeLowerFixtureOf "constant_u64" lower_constant_wide 13,
     NativeLowerFixtureOf "constant_usize" lower_constant_size 14,
     NativeLowerFixtureOf "constant_i32" lower_constant_signed 11,
     NativeLowerFixtureOf "constant_local" lower_constant_local 11,
     NativeLowerFixtureOf "constant_maybe" lower_constant_maybe_ctor 0,
     NativeLowerFixtureOf "bool_constructors" lower_constant_bool 0,
     NativeLowerFixtureOf "bool_comparison" lower_constant_bool_compare 0,
     NativeLowerFixtureOf "bool_signed" lower_constant_bool_signed 0,
     NativeLowerFixtureOf "bool_ordinal" lower_constant_bool_ordinal 0,
     NativeLowerFixtureOf "bool_effects" lower_constant_bool_effect 0,
     NativeLowerFixtureOf "bool_unit" lower_constant_bool_unit 0,
     NativeLowerFixtureOf "constant_allocation" lower_constant_allocation 11,
     NativeLowerFixtureOf "constant_null_branch" lower_constant_null_branch 11,
     NativeLowerFixtureOf "bool_loop" lower_constant_bool_loop 15];
