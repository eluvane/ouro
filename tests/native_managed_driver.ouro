-- Development driver: file IO supplies bytes; checked Ouro emits all runtime,
-- MIR, machine instructions and PE data. The fixture level is explicit in CLI.
import "native_managed_reject.ouro";
import "native_managed_driver_common.ouro";

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 2 | Cons _ rest =>
         match rest with | Nil => exit 2 | Cons mode more =>
           match more with | Nil => exit 2 | Cons name paths =>
             match paths with | Nil => exit 2 | Cons root inputs =>
               match orb (prim_string_eq mode "--image") (prim_string_eq mode "--metadata") with
               | False => do eprintln "usage: native_managed_driver --image|--metadata MIR_FIXTURE ROOT SOURCES..."; exit 2
               | True => do let! files := managed_driver_files (Cons String root inputs);
                            match managed_fixture_runtime (prim_string_to_char_codes root) files with
                            | Left error => do eprintln (managed_driver_source_error error); exit 2
                            | Right runtime => match managed_case_named (prim_string_to_char_codes name) runtime with
                              | Nothing => do eprintln "unknown managed MIR fixture"; exit 2
                              | Just program => match codegen_program mir_default_limits program with
                                | Left error => do eprintln (managed_driver_error error); exit 2
                                | Right image => managed_driver_write_image (prim_string_eq mode "--metadata") image
                                end end end
               end end end end end
