-- Shared Core constructors and inductive descriptors used by checker, reduce,
-- retained and refine suite files. One owner keeps the bytes identical.
import "../compiler/file_check_model.ouro";

def checker_test_nat : CoreTerm := CInd 10;
def checker_test_zero : CoreTerm := CConstruct 10 0 0;
def checker_test_bool : CoreTerm := CInd 20;
def checker_test_true : CoreTerm := CConstruct 20 0 0;

def checker_test_nat_decl : IndDecl :=
    MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0
      ([ MkCtor 11 checker_test_nat
       , MkCtor(12, CPi checker_test_nat checker_test_nat)
       ] : List Ctor);

def checker_test_bool_decl : IndDecl :=
    MkIndDecl 20 (Nil Param) (Nil CoreTerm) 0
      ([ MkCtor 21 checker_test_bool
       , MkCtor 22 checker_test_bool
       ] : List Ctor);

def checker_test_nat_motive : CoreTerm :=
    CLam checker_test_nat checker_test_nat;

def checker_test_copy (name : Nat) : CoreTerm :=
    CFix name 0 1 (CPi checker_test_nat checker_test_nat)
      (CLam checker_test_nat
        (CCase (MkCaseInfo 10 0 ([0, 1] : List Nat))
          checker_test_nat_motive (CRel 0)
          ([ checker_test_zero
           , CLam(checker_test_nat, CApp(CRel 2, CRel 0))
           ] : List CoreTerm)));

def checker_test_negative_wrapper : IndDecl :=
    MkIndDecl 70 ([MkParam(71, CSort 1)] : List Param) (Nil CoreTerm) 1
      ([MkCtor 72
        (CPi (CSort 1)
          (CPi(CPi(CRel 0, CSort 0), CApp(CInd 70, CRel 1))))]
        : List Ctor);

def checker_test_nested_negative : IndDecl :=
    MkIndDecl 73 (Nil Param) (Nil CoreTerm) 1
      ([MkCtor(74, CPi(CApp(CInd 70, CInd 73), CInd 73))] : List Ctor);

def checker_test_box : IndDecl :=
    MkIndDecl 30 ([MkParam(31, CSort 0)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 32
        (CPi(CSort 0, CPi(CRel 0, CApp(CInd 30, CRel 1))))]
        : List Ctor);

def checker_test_extra_case_metadata : CoreTerm :=
    CCase (MkCaseInfo 10 0 ([0, 1, 0] : List Nat))
      checker_test_nat_motive checker_test_zero
      ([checker_test_zero, CLam checker_test_nat checker_test_zero] : List CoreTerm);

def checker_test_missing_case_metadata : CoreTerm :=
    CCase (MkCaseInfo 10 0 ([0] : List Nat))
      checker_test_nat_motive checker_test_zero
      ([checker_test_zero, CLam checker_test_nat checker_test_zero] : List CoreTerm);

def checker_test_lambdas : Nat -> CoreTerm -> CoreTerm :=
    fix checker_test_lambdas (count : Nat) (tail : CoreTerm) : CoreTerm :=
      match count with
      | Z => tail
      | S rest => CLam(checker_test_nat, checker_test_lambdas rest tail)
      end;

def compiler_test_type_alias : CoreTerm :=
    CLetIn(CSort 0, CSort 1, CLam(CRel 0, CRel 0));
