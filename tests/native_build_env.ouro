-- Native env lookup: missing name is Nothing; then exit 0.
import "../std/io.ouro";

def env_label (value : Maybe String) : String :=
    match value with
    | Nothing => "env-missing"
    | Just text => prim_string_concat "env-set=" text
    end;

-- @entry main
def main : IO Unit :=
  do let! value := env_get "__OURO_NATIVE_ENV_ABSENT__";
     println (env_label value);
     exit 0
