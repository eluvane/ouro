-- Each retained negative must fail in its owning phase with its exact typed fault.
import "compiler_smith_generate.ouro",
  "compiler_property_typed.ouro";

inductive SmithNegative : Type :=
  | SmithNegativeOf : String -> List FileItem -> Nat -> CheckPhase -> CheckFailure -> SmithNegative;

def smith_negative_one (name : String) (item : FileItem) (phase : CheckPhase)
    (failure : CheckFailure) : SmithNegative :=
    SmithNegativeOf name ([item] : List FileItem) (file_item_name item) phase failure;

def smith_negative_body (name : String) (typ : CoreTerm) (body : CoreTerm)
    (failure : CheckFailure) : SmithNegative :=
    smith_negative_one name (FDef 900 typ body) CheckDeclarationBody failure;

def smith_item_text (item : FileItem) : String :=
    match item with
    | FDef name typ body => str_cat4(str_of_nat name, ":", property_show typ, str_concat("=", property_show body))
    | FAxiom name typ => str_cat3(str_of_nat name, ":", property_show typ)
    | FInd decl => match decl with
        | MkIndDecl name _ _ level ctors => str_cat4 (str_of_nat name) ":ind:" (str_of_nat level)
            (str_concat ":" (str_join ";" (map Ctor String
              (fun (ctor : Ctor) => match ctor with
                | MkCtor ctor_name typ => str_cat3(str_of_nat ctor_name, ":", property_show typ) end) ctors)))
        end
    | FIntrinsic name _ _ _ => str_concat("intrinsic:", str_of_nat name)
    | FExtern name _ _ => str_concat("extern:", str_of_nat name)
    | FRepresentation name _ => str_concat("representation:", str_of_nat name)
    end;

def smith_negative_check (entries : List Entry) (negative : SmithNegative) : Maybe String :=
    match negative with
    | SmithNegativeOf name items wanted phase failure =>
        match check_declarations_go check_declaration CheckExactCore keep_checking
          smith_fuel 0 (Nil Nat) entries items with
        | DeclarationsOk _ => Just String (str_cat4 name " accepted input="
            (str_join("|", map FileItem String smith_item_text items)) "")
        | DeclarationsErr actual actual_phase actual_failure =>
            let expected : String := str_cat4 (str_of_nat wanted) ":" (compiler_test_phase_name phase)
              (str_concat(":", smith_fault failure)) in
            let observed : String := str_cat4 (str_of_nat actual) ":" (compiler_test_phase_name actual_phase)
              (str_concat(":", smith_fault actual_failure)) in
            match str_eq expected observed with
            | True => Nothing String
            | False => Just String (str_cat4 name " expected=" expected
                (str_cat4 " actual=" observed " input=" (str_join("|", map FileItem String smith_item_text items))))
            end
        end
    end;

def smith_negative_wrapper : IndDecl :=
    MkIndDecl 120 ([MkParam(122, CSort 1)] : List Param) (Nil CoreTerm) 1
      ([MkCtor 121 (CPi (CSort 1)
        (CPi(CPi(CRel 0, CSort 0), CApp(CInd 120, CRel 1))))] : List Ctor);

def smith_bad_nested_inductive : IndDecl :=
    MkIndDecl 900 (Nil Param) (Nil CoreTerm) 1
      ([MkCtor(901, CPi(CApp(CInd 120, CInd 900), CInd 900))] : List Ctor);

def smith_negative_nested (name : String) (body : CoreTerm) : SmithNegative :=
    smith_negative_body name retained_nat_fn body (CheckTypeFailure CheckNonTerminating);

def smith_negative_cases (seed : Nat) : List SmithNegative :=
    let number : CoreTerm := smith_numeral (smith_choice seed 70 7) in
    let level : Nat := smith_choice seed 71 2 in
    let bad_fix : CoreTerm := CFix 150 0 1 retained_nat_fn
      (CLam retained_nat (CCase retained_nat_info retained_nat_motive (CRel 0)
        ([retained_zero, CLam(retained_nat, CApp(CRel 2, CRel 1))] : List CoreTerm))) in
    [ smith_negative_body "type-mismatch-def" retained_nat (CConstruct 20 0 0)
        (CheckTypeFailure CheckTypeMismatch)
    , smith_negative_body "type-mismatch-argument" retained_nat (CApp(retained_succ, CConstruct 20 1 0))
        (CheckTypeFailure CheckTypeMismatch)
    , smith_negative_body "type-mismatch-parameter" (CApp(CInd 44, retained_bool))
        (smith_apply2 (CConstruct 44 1 1) retained_nat number) (CheckTypeFailure CheckTypeMismatch)
    , smith_negative_body "lambda-annotation-mismatch" retained_nat_fn (CLam(retained_bool, CRel 0))
        (CheckTypeFailure CheckTypeMismatch)
    , smith_negative_body("sort-level-too-big", CSort level, CSort level, CheckTypeFailure CheckTypeMismatch)
    , smith_negative_body("not-pi", CSort 0, CApp(number, CSort 0), CheckTypeFailure CheckExpectedFunction)
    , smith_negative_one "sort-expected" (FAxiom(900, CPi(number, CSort 0))) CheckDeclarationType
        (CheckTypeFailure CheckExpectedSort)
    , smith_negative_body "not-inductive" (CSort 1)
        (CCase retained_nat_info (CLam(retained_nat, CSort 0)) (CSort 0)
          ([retained_nat, CLam retained_nat retained_nat] : List CoreTerm)) (CheckTypeFailure CheckCaseMotive)
    , smith_negative_body "coverage" retained_nat
        (CCase(MkCaseInfo 10 0 ([0] : List Nat), retained_nat_motive, number, [retained_zero] : List CoreTerm))
        (CheckMalformedCore CheckCaseMetadata)
    , smith_negative_body "case-arity" retained_nat
        (CCase (MkCaseInfo 10 0 ([0, 2] : List Nat)) retained_nat_motive number
          ([retained_zero, CLam retained_nat retained_zero] : List CoreTerm)) (CheckMalformedCore CheckCaseMetadata)
    , smith_negative_body "case-wrong-inductive" retained_nat
        (CCase (MkCaseInfo 20 0 ([0, 0] : List Nat)) retained_nat_motive number
          ([retained_zero, retained_zero] : List CoreTerm)) (CheckMalformedCore CheckCaseMetadata)
    , smith_negative_body "case-branch-count" retained_nat
        (CCase retained_nat_info retained_nat_motive number ([retained_zero] : List CoreTerm))
        (CheckMalformedCore CheckCaseMetadata)
    , smith_negative_body("ctor-nparams", retained_nat, CConstruct 10 0 1, CheckMalformedCore CheckConstructorParameters)
    , smith_negative_body("ctor-index", retained_nat, CConstruct 10 2 0, CheckMalformedCore (CheckUnknownConstructor 10 2))
    , smith_negative_one "unbound-global-constant" (FAxiom(900, CPi(CConst 998, CSort 0))) CheckDeclarationType
        (CheckMalformedCore (CheckUnboundGlobal 998))
    , smith_negative_one "unbound-global-inductive" (FAxiom(900, CInd 997)) CheckDeclarationType
        (CheckMalformedCore (CheckUnknownInductive 997))
    , SmithNegativeOf "forward-reference"
        ([ FInd (MkIndDecl 900 (Nil Param) (Nil CoreTerm) 0
             ([MkCtor(901, CPi(CInd 997, CInd 900))] : List Ctor))
         , FInd (MkIndDecl(997, Nil Param, Nil CoreTerm, 0, [MkCtor(996, CInd 997)] : List Ctor))
         ] : List FileItem) 900 CheckInductiveDeclaration (CheckMalformedCore (CheckUnknownInductive 997))
    , smith_negative_one "duplicate-global-axiom" (FAxiom(200, CSort 0)) CheckDeclarationPlan
        (CheckMalformedCore (CheckDuplicateName 200))
    , smith_negative_one "duplicate-global-inductive"
        (FInd (MkIndDecl(20, Nil Param, Nil CoreTerm, 0, [MkCtor(901, CInd 20)] : List Ctor)))
        CheckDeclarationPlan (CheckMalformedCore (CheckDuplicateName 20))
    , smith_negative_one "positivity-negative"
        (FInd (MkIndDecl 900 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(901, CPi(CPi(CInd 900, CInd 900), CInd 900))] : List Ctor)))
        CheckInductiveDeclaration (CheckTypeFailure CheckNonPositive)
    , SmithNegativeOf "positivity-nested-contravariant"
        ([FInd smith_negative_wrapper, FInd smith_bad_nested_inductive] : List FileItem)
        900 CheckInductiveDeclaration (CheckTypeFailure CheckNonPositive)
    , smith_negative_one "universe"
        (FInd (MkIndDecl 900 (Nil Param) (Nil CoreTerm) 0
          ([MkCtor(901, CPi(CSort 0, CInd 900))] : List Ctor)))
        CheckInductiveDeclaration (CheckTypeFailure CheckUniverseBound)
    , smith_negative_nested "termination" bad_fix
    , smith_negative_nested "termination-nested-unchanged-initial" retained_nested_unchanged
    , smith_negative_nested "termination-nested-growing-inner" retained_nested_growing
    , smith_negative_nested "termination-nested-growing-other-parameter" retained_nested_other_parameter
    , smith_negative_nested "termination-nested-captured-unchanged" retained_nested_captured
    , smith_negative_nested "termination-nested-partial-escape" retained_nested_partial
    , smith_negative_nested "termination-nested-argument-escape" retained_nested_argument
    , smith_negative_body "fix-arity" retained_nat_fn (CFix 150 0 3 retained_nat_fn (smith_identity retained_nat))
        (CheckMalformedCore CheckFixMetadata)
    , smith_negative_body "fix-rec-arg-range" retained_nat_fn
        (CFix 150 (S (smith_choice seed 72 2)) 1 retained_nat_fn (smith_identity retained_nat))
        (CheckMalformedCore CheckFixMetadata)
    ];

-- The mutator can target a non-first Rel and records its exact unbound index.
def smith_rel_negative (seed : Nat) (depth : Nat) : Either String SmithNegative :=
    let candidate : SmithWitness := smith_definition seed depth 0 in
    let witness : SmithWitness := match property_rel_count (smith_witness_term candidate) with
      | Z => smith_leaf(12, CPi(retained_nat, CPi retained_nat retained_nat), smith_extra_fold retained_nat, False)
      | S _ => candidate end in
    let term : CoreTerm := smith_witness_term witness in
    let target : Nat := smith_choice seed 73 (property_rel_count term) in
    match property_mutate term (smith_choice seed 74 3) target with
    | PropertyMutationOf mutant selected => match selected with
        | Nothing => Left String SmithNegative "generator rel selection failed"
        | Just index => Right String SmithNegative
            (smith_negative_body (str_concat("rel-out-of-scope target=", str_of_nat target))
              (smith_witness_type witness) mutant (CheckMalformedCore (CheckUnboundVariable index)))
        end
    end;

def smith_covariant_decl (container : Nat) : IndDecl :=
    MkIndDecl 900 (Nil Param) (Nil CoreTerm) 0
      ([ MkCtor(901, CInd 900)
       , MkCtor(902, CPi(CApp(CInd container, CInd 900), CInd 900))
       ] : List Ctor);

def smith_positive_declarations (entries : List Entry) (items : List FileItem) : Maybe String :=
    match check_declarations_go check_declaration CheckExactCore keep_checking
      smith_fuel 0 (Nil Nat) entries items with
    | DeclarationsOk _ => Nothing String
    | DeclarationsErr name phase failure => Just String
        (str_cat4("declaration=", str_of_nat name, " ", str_cat3(compiler_test_phase_name phase, ":", smith_fault failure)))
    end;
