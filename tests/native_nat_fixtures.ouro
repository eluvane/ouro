-- Deliberately forged typed-MIR Nat payloads test the runtime representation
-- guards. These fixtures make no claim of source-level acceptance.
import "native_managed_fixtures.ouro",
  "../compiler/native/managed_nat_arithmetic.ouro";

def native_nat_fixture_size_max : MirValue :=
    MirBits(MirUSize, X64Words64(X64Bytes32 255 255 255 255, X64Bytes32 255 255 255 255));

def native_nat_fixture_checks (fits : MirValue) (bits : MirValue) (wanted_fit : Nat) (wanted_bits : MirValue)
    (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedState ManagedState (managed_require_equal fits (managed_bits MirU8 wanted_fit) state)
      (managed_require_equal bits wanted_bits);

def native_nat_fixture_large (compiler : ManagedCompiler) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedNatWordResult ManagedResult (managed_nat_checked_word compiler PrimitiveWordU64 value state)
      (fun (converted : ManagedNatWordResult) => match converted with | ManagedNatWordOf fits bits next =>
        lower_bind ManagedState ManagedResult (native_nat_fixture_checks fits bits 0 (managed_bits MirU64 0) next)
          (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_nat_predecessor compiler value checked)
            (fun (prior : ManagedResult) => match prior with | ManagedResultOf predecessor after =>
              lower_bind ManagedNatWordResult ManagedResult (managed_nat_checked_word compiler PrimitiveWordU64 predecessor after)
                (fun (again : ManagedNatWordResult) => match again with | ManagedNatWordOf prior_fits prior_bits ready =>
                  lower_map ManagedState ManagedResult (fun (finish : ManagedState) =>
                    ManagedResultOf(managed_bits MirU32 42, finish))
                    (native_nat_fixture_checks prior_fits prior_bits 1 (managed_nat_word_max PrimitiveWordU64) ready) end) end)) end);

def native_nat_fixture_payload (compiler : ManagedCompiler) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let bytes : Nat := match eqNat mode 0 with | True => 40 | False => match eqNat mode 1 with
      | True => 56 | False => 48 end end in
    let kind : Nat := match eqNat mode 4 with | True => 9 | False => 8 end in
    let count : Nat := match eqNat mode 0 with | True => 0 | False => match orb(eqNat mode 1, eqNat mode 2) with
      | True => 3 | False => 1 end end in
    lower_map ManagedResult ManagedResult (fun (allocated : ManagedResult) => match allocated with
      | ManagedResultOf value next => let counted : ManagedState := managed_emit
          (MirStore(value, codegen_disp 32, managed_bits MirUSize count)) next in
        let filled : ManagedState := match eqNat mode 0 with | True => counted | False => managed_emit_all
          ([MirStore(value, codegen_disp 40, managed_bits MirU32 0),
            MirStore(value, codegen_disp 44, managed_bits MirU32 0)] : List MirInstruction) counted end in
        let complete : ManagedState := match eqNat mode 1 with | True => managed_emit
          (MirStore(value, codegen_disp 48, managed_bits MirU32 1)) filled | False => filled end in
        ManagedResultOf value (match eqNat mode 7 with | True => managed_emit
          (MirStore value (codegen_disp 32) native_nat_fixture_size_max) complete | False =>
          match eqNat mode 8 with | True => managed_emit
            (MirStore(value, codegen_disp 8, managed_bits MirUSize 32)) complete | False => complete end end) end)
      (managed_allocate_value compiler kind bytes state);

def native_nat_fixture_run (compiler : ManagedCompiler) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match eqNat mode 5 with
    | True => lower_map ManagedResult ManagedResult (fun (allocated : ManagedResult) => match allocated with
        | ManagedResultOf _ next => ManagedResultOf(managed_bits MirU32 42, next) end)
        (managed_nat_allocate compiler native_nat_fixture_size_max state)
    | False => lower_bind ManagedResult ManagedResult (native_nat_fixture_payload compiler
        (match eqNat mode 6 with | True => 0 | False => mode end) state)
        (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf value next =>
          match eqNat mode 1 with
          | True => native_nat_fixture_large compiler value next
          | False => match eqNat mode 6 with
            | True => lower_map ManagedResult ManagedResult (fun (prior : ManagedResult) => match prior with
                | ManagedResultOf _ after => ManagedResultOf(managed_bits MirU32 42, after) end)
                (managed_nat_predecessor compiler value next)
            | False => lower_bind ManagedNatWordResult ManagedResult (managed_nat_checked_word compiler PrimitiveWordU64 value next)
                (fun (converted : ManagedNatWordResult) => match converted with | ManagedNatWordOf fits bits after =>
                  lower_map ManagedState ManagedResult (fun (finish : ManagedState) => ManagedResultOf(managed_bits MirU32 42, finish))
                    (native_nat_fixture_checks fits bits 1 (managed_bits MirU64 0) after) end) end end end) end;

def native_nat_fixture (mode : Nat) (runtime : NativeManagedRuntime) : Either NativeLowerError MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ _ _ _ _ base _ =>
      let compiler : ManagedCompiler := native_managed_fixture_compiler runtime in
      lower_map ManagedResult MirProgram (fun (compiled : ManagedResult) => match compiled with
        | ManagedResultOf value after => match after with | ManagedStateOf _ functions _ _ _ flow =>
          match flow with | LowerStateOf _ locals _ _ =>
            let main : MirFunction := MirFunctionDef (S base) ([110,97,116,95,102,105,120,116,117,114,101] : List Nat)
              ([] : List MirLocal) (reverse MirLocal locals) (Just MirType MirU32) 0
              (lower_finish_blocks(MirReturn (Just MirValue value), flow)) in
            managed_fixture_finish runtime (Cons MirFunction main (reverse MirFunction functions))
              ([MirDataDef(managed_descriptor compiler 8, False, mir_managed_descriptor_bytes 8),
                MirDataDef(managed_descriptor compiler 9, False, mir_managed_descriptor_bytes 9)] : List MirData) end end end)
        (native_nat_fixture_run compiler mode
          (ManagedStateOf(add base 200, [] : List MirFunction, [] : List MirData, [] : List Nat, [] : List Nat, lower_empty_state 0))) end;
