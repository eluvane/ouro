-- Native argv smoke: print argv[0] stem presence, then exit 0.
import "../std/io.ouro";

def argv_head (args : List String) : String :=
    match args with
    | Nil => "argv-empty"
    | Cons first _ => first
    end;

-- @entry main
def main : IO Unit :=
  do let! args := argv;
     println (argv_head args);
     exit 0
