-- Source spelling, transparent aliases and identifier offsets must preserve
-- checked directory identities and the established development C shim keys.
import "../compiler/driver.ouro";
import "../compiler/checked_program_output.ouro";
import "../std/listx.ouro";
import "compiler_startup_test_support.ouro";
import "compiler_program_lookup.ouro";

def directory_binding_prefix : String :=
    prim_string_concat
      "intrinsic Action : Type -> Type := \"ouro.runtime\"; intrinsic Text : Type := \"ouro.string\"; inductive Chain (A : Type) : Type := | End : Chain A | Link : A -> Chain A -> Chain A; representation Chain := \"ouro.list\"; "
      "inductive Flag : Type := | Yes : Flag | No : Flag; representation Flag := \"ouro.bool\"; def Deferred (A : Type) : Type := Action A; def Name : Type := Text; ";

def directory_binding_compile (source : String) : CompResult CheckedProgram :=
    compile_checked_source (mul 100 50) (prim_string_to_char_codes (prim_string_concat directory_binding_prefix source));

def directory_binding_selected (source : String) (name : String) (primitive : PrimitiveId) (c_key : String) : Bool :=
    match directory_binding_compile source with | CErr _ => False | COk program =>
      match compiler_test_name program name with | Nothing => False | Just id =>
        andb (compiler_test_runtime_binding program id primitive) (compiler_test_c_shim program id c_key) end end;

def directory_binding_rejected (source : String) : Bool :=
    match directory_binding_compile source with | COk _ => False | CErr error =>
      match error with | ErrCode code _ => eqNat code 42 end end;

def directory_binding_axiom : Bool :=
    match directory_binding_compile "axiom prim_fs_list_dir : Name -> Deferred (Chain Name); axiom prim_fs_listable : Name -> Deferred Flag;" with
    | CErr _ => False | COk program =>
      match compiler_test_name program "prim_fs_list_dir", compiler_test_name program "prim_fs_listable" with
      | Just listing, Just listable => andb (notb (compiler_test_runtime_binding program listing PrimitiveDirectoryList))
          (andb (notb (compiler_test_runtime_binding program listable PrimitiveDirectoryListable))
            (andb (notb (compiler_test_c_shim program listing "prim_fs_list_dir"))
              (notb (compiler_test_c_shim program listable "prim_fs_listable"))))
      | Nothing, Nothing => False | Nothing, Just _ => False | Just _, Nothing => False end end;

def main : IO Unit :=
    startup_test_run
      [startup_test_assert "list_dir renamed identity"
        (directory_binding_selected "intrinsic selected : Text -> Deferred (Chain Text) := \"ouro.fs.list_dir\";"
          "selected" PrimitiveDirectoryList "prim_fs_list_dir"),
       startup_test_assert "list_dir normalized aliases"
        (directory_binding_selected "intrinsic selected : Name -> Deferred (Chain Name) := \"ouro.fs.list_dir\";"
          "selected" PrimitiveDirectoryList "prim_fs_list_dir"),
       startup_test_assert "list_dir misleading source spelling"
        (directory_binding_selected "intrinsic prim_fs_read_file : Name -> Deferred (Chain Name) := \"ouro.fs.list_dir\";"
          "prim_fs_read_file" PrimitiveDirectoryList "prim_fs_list_dir"),
       startup_test_assert "list_dir earlier declarations"
        (directory_binding_selected "axiom earlier : Text; intrinsic selected : Name -> Deferred (Chain Name) := \"ouro.fs.list_dir\";"
          "selected" PrimitiveDirectoryList "prim_fs_list_dir"),
       startup_test_assert "list_dir rejects wrong container"
        (directory_binding_rejected "intrinsic wrong : Text -> Action Flag := \"ouro.fs.list_dir\";"),
       startup_test_assert "list_dir rejects missing input"
        (directory_binding_rejected "intrinsic wrong : Action (Chain Text) := \"ouro.fs.list_dir\";"),
       startup_test_assert "list_dir rejects pure result"
        (directory_binding_rejected "intrinsic wrong : Text -> (Chain Text) := \"ouro.fs.list_dir\";"),
       startup_test_assert "list_dir rejects wrong input identity"
        (directory_binding_rejected "intrinsic wrong : Flag -> Action (Chain Text) := \"ouro.fs.list_dir\";"),
       startup_test_assert "listable renamed identity"
        (directory_binding_selected "intrinsic selected : Text -> Deferred (Flag) := \"ouro.fs.listable\";"
          "selected" PrimitiveDirectoryListable "prim_fs_listable"),
       startup_test_assert "listable normalized aliases"
        (directory_binding_selected "intrinsic selected : Name -> Deferred (Flag) := \"ouro.fs.listable\";"
          "selected" PrimitiveDirectoryListable "prim_fs_listable"),
       startup_test_assert "listable misleading source spelling"
        (directory_binding_selected "intrinsic prim_fs_read_file : Name -> Deferred (Flag) := \"ouro.fs.listable\";"
          "prim_fs_read_file" PrimitiveDirectoryListable "prim_fs_listable"),
       startup_test_assert "listable earlier declarations"
        (directory_binding_selected "axiom earlier : Text; intrinsic selected : Name -> Deferred (Flag) := \"ouro.fs.listable\";"
          "selected" PrimitiveDirectoryListable "prim_fs_listable"),
       startup_test_assert "listable rejects wrong container"
        (directory_binding_rejected "intrinsic wrong : Text -> Action (Chain Text) := \"ouro.fs.listable\";"),
       startup_test_assert "listable rejects missing input"
        (directory_binding_rejected "intrinsic wrong : Action (Flag) := \"ouro.fs.listable\";"),
       startup_test_assert "listable rejects pure result"
        (directory_binding_rejected "intrinsic wrong : Text -> (Flag) := \"ouro.fs.listable\";"),
       startup_test_assert "listable rejects wrong input identity"
        (directory_binding_rejected "intrinsic wrong : Flag -> Action (Flag) := \"ouro.fs.listable\";"),
       startup_test_assert "same-named axioms gain no directory authority" directory_binding_axiom];
