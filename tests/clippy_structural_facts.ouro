-- Black-box source fixtures run through the real compiler lexer/parser and
-- the native fact/rule owners. This unit stays on the structural cone.

import "../tools/clippy/structural_rules.ouro";
import "../std/io.ouro";
import "../tools/quality/source.ouro";

def cs_test_codes : List String -> List String -> Bool :=
  fix go (xs : List String) (ys : List String) : Bool :=
    match xs, ys with
    | Nil, Nil => True
    | Nil, Cons _ _ => False
    | Cons _ _, Nil => False
    | Cons x more, Cons y rest => andb (prim_string_eq x y) (go more rest)
    end;

def cs_test_fail (label : String) (message : String) : List String :=
    [prim_string_concat label (prim_string_concat ": " message)];

def cs_child (root : String) (name : String) : String :=
    prim_string_concat root (prim_string_concat "/" name);

def cs_join : List String -> String :=
  fix go (xs : List String) : String :=
    match xs with
    | Nil => ""
    | Cons x rest => match rest with
      | Nil => x
      | Cons _ _ => prim_string_concat x (prim_string_concat ", " (go rest))
      end
    end;

def cs_expect (field : String) : List String :=
    match prim_string_length field with
    | Z => Nil String
    | S _ => filter String (fun (item : String) =>
        ltb_nat 0 (prim_string_length item)) (prim_string_split field 44)
    end;

def cs_found (proofs : List CgSProof) : List String :=
    map CgSProof String (fun (proof : CgSProof) => match proof with
      | MkCgSProof code _ _ _ => code
      end) proofs;

def cs_test_source (label : String) (mode : String) (source : String)
    (wanted : List String) : List String :=
    match cg_s_frontend source with
    | Left error => match prim_string_eq mode "frontend-error" with
      | True => []
      | False => cs_test_fail label
          (prim_string_concat "unexpected frontend failure: "
            (quality_input_message error))
      end
    | Right unit => match prim_string_eq mode "facts" with
      | False => cs_test_fail label
          "frontend unexpectedly accepted the error fixture or invalid fixture kind"
      | True => match cg_s_proofs unit with
        | Left error => cs_test_fail label
            (prim_string_concat "proof construction failed: "
              (quality_input_message error))
        | Right proofs =>
            let found : List String := cs_found proofs in
            match cs_test_codes (quality_sort String prim_string_le wanted)
                (quality_sort String prim_string_le found) with
            | True => []
            | False => cs_test_fail label
                (prim_string_concat "expected ["
                  (prim_string_concat (cs_join wanted)
                    (prim_string_concat "] but found ["
                      (prim_string_concat (cs_join found) "]"))))
            end
        end
      end
    end;

def cs_nonempty (s : String) : Bool :=
    ltb_nat 0 (prim_string_length (prim_string_replace s "\r" ""));

def cs_line (s : String) : String :=
    prim_string_replace s "\r" "";

-- These use compiler AST constructors directly to exercise states that the
-- parser cannot normally manufacture, not a second parser or a Python oracle.
def cs_test_budget : Bool :=
    match cg_s_build 0 [DDef 1 (EVar 2) (ENat 0)] with
    | Left _ => True
    | Right _ => False
    end;

def cs_test_scopes : Bool :=
    let catalog : CgSCatalog := MkCgSCatalog [] [] in
    match cg_s_bind 7 (Nothing Nat) [] (MkCgSState 1 0 []) with
    | MkPair outer first => match cg_s_bind 7 (Nothing Nat) outer first with
      | MkPair inner _ => notb (cg_s_maybe_equal
          (cg_s_atom catalog outer (EVar 7)) (cg_s_atom catalog inner (EVar 7)))
      end
    end;

def cs_test_bad_spine : Bool :=
    let catalog : CgSCatalog := MkCgSCatalog [MkPair Nat (List Nat) 1 [2, 3]]
      [MkPair Nat Nat 2 1, MkPair Nat Nat 3 1] in
    let env : List CgSBinding := [MkCgSBinding 4 1 (Just Nat 1)] in
    match cg_s_visit catalog 5 32 env (EMatch (EVar 4) (ENat 0)) (MkCgSState 2 0 []) with
    | Left _ => True
    | Right _ => False
    end;

def cs_test_effect_atom : Bool :=
    match cg_s_atom (MkCgSCatalog [] []) [] (EPerform 1 [ENat 2]) with
    | Nothing => True
    | Just _ => False
    end;

def cs_test_invariants : List String :=
    concat_map (Pair String Bool) String
      (fun (test : Pair String Bool) => match test with
        | MkPair label passed => match passed with
          | True => []
          | False => cs_test_fail label "native invariant failed"
          end
        end)
      [MkPair String Bool "fact-budget" cs_test_budget,
       MkPair String Bool "distinct-binder-identity" cs_test_scopes,
       MkPair String Bool "invalid-branch-spine" cs_test_bad_spine,
       MkPair String Bool "effect-is-not-an-atom" cs_test_effect_atom];

def cs_test_print : List String -> IO Unit :=
  fix go (errors : List String) : IO Unit :=
    match errors with
    | Nil => io_pure Unit MkUnit
    | Cons error rest =>
        do eprintln (prim_string_concat "CLIPPY_STRUCTURAL_FACTS_FAIL " error);
           go rest
    end;

def cs_test_row (root : String) (raw : String) : IO (List String) :=
    let fields : List String := prim_string_split (cs_line raw) 9 in
    match fields with
    | Nil => io_pure (List String)
        (["inventory row is not name<TAB>kind<TAB>expect"] : List String)
    | Cons name rest1 => match rest1 with
      | Nil => io_pure (List String)
          (["inventory row is not name<TAB>kind<TAB>expect"] : List String)
      | Cons kind rest2 => match rest2 with
        | Nil => io_pure (List String)
            (["inventory row is not name<TAB>kind<TAB>expect"] : List String)
        | Cons expect _extra =>
            match prim_string_length name with
            | Z => io_pure (List String) (["fixture has no name"] : List String)
            | S _ =>
                do let! loaded := quality_read_file
                     (cs_child root (prim_string_concat name ".ouro"));
                   match loaded with
                   | Left error => io_pure (List String)
                       (cs_test_fail name (quality_input_message error))
                   | Right source => io_pure (List String)
                       (cs_test_source name kind source (cs_expect expect))
                   end
            end
        end
      end
    end;

def cs_test_rows (root : String) : List String -> List String
    -> IO (List String) :=
  fix go (xs : List String) (acc : List String) : IO (List String) :=
    match xs with
    | Nil => io_pure (List String) acc
    | Cons raw rest => match cs_nonempty raw with
      | False => go rest acc
      | True =>
          do let! more := cs_test_row root raw;
             go rest (append String acc more)
      end
    end;

def cs_test_run (root : String) : IO Unit :=
    do let! loaded := quality_read_file (cs_child root "inventory.txt");
       match loaded with
       | Left error =>
           do eprintln (quality_input_message error);
              exit 1
       | Right text =>
           do let! fixture_errors := cs_test_rows root
                (prim_string_split text 10) (Nil String);
              let errors : List String :=
                append String cs_test_invariants fixture_errors in
              match errors with
              | Cons _ _ => do cs_test_print errors; exit 1
              | Nil =>
                  do println (prim_string_concat
                       "CLIPPY_STRUCTURAL_FACTS: OK cases="
                       (prim_string_of_nat (length String
                         (filter String cs_nonempty (prim_string_split text 10)))));
                     exit 0
              end
       end

def main : IO Unit :=
    do let! argv := prim_argv;
       match tail String argv with
       | Cons root _ => cs_test_run root
       | Nil =>
           do eprintln "CLIPPY_STRUCTURAL_FACTS: FAIL missing fixture directory";
              exit 1
       end
