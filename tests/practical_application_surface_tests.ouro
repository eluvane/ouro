-- Acceptance tests for real app-surface helpers used by tools/app_surface.

import "../std/test.ouro",
  "../tools/app_surface_lib.ouro";

def app_test_json_valid : String :=
    app_report_text (app_json_validate_report "{\"name\":\"ouro\",\"ok\":true}");

def app_test_json_invalid : String :=
    app_report_text (app_json_validate_report "{\"name\":}");

def app_test_json_minify : Bool :=
    match app_json_minify "{ \"a\" : [1,true] }" with
    | Left _ => False
    | Right text => str_eq text "{\"a\":[1,true]}"
    end;

def app_test_json_minify_invalid : Bool :=
    match app_json_minify "{\"a\":}" with
    | Left e => str_eq(app_surface_error_message e, "invalid json")
    | Right _ => False
    end;

def app_test_csv_rows : List (List String) :=
    csv_parse "name,count\nalpha,2\nbeta,3\n";

def app_test_csv_report : String :=
    app_report_text (app_csv_report_json "fixture.csv" app_test_csv_rows);

def app_test_csv_select : Bool :=
    match app_csv_select_column app_test_csv_rows "count" with
    | Left _ => False
    | Right text => str_eq text "2\n3"
    end;

def app_test_csv_missing : Bool :=
    match app_csv_select_column app_test_csv_rows "missing" with
    | Left e => str_eq(app_surface_error_message e, "missing column: missing")
    | Right _ => False
    end;

def app_test_tsv_project : Bool :=
    match app_tsv_from_csv_columns(app_test_csv_rows, ["name", "count"] : List String) with
    | Left _ => False
    | Right text => str_eq text "name\tcount\nalpha\t2\nbeta\t3"
    end;

def app_test_tsv_missing : Bool :=
    match app_tsv_from_csv_columns(app_test_csv_rows, ["name", "missing"] : List String) with
    | Left e => str_eq(app_surface_error_message e, "missing column: missing")
    | Right _ => False
    end;

def app_test_config_report : String :=
    app_report_text (app_config_report_json (config_parse "name=ouro\nenabled=true\n"));

def app_test_safe_path : Bool :=
    match app_path_within_workspace "_build/app_surface" "reports/out.json" with
    | Left _ => False
    | Right path => str_eq path "_build/app_surface/reports/out.json"
    end;

def app_test_reject_escape : Bool :=
    match app_path_within_workspace "_build/app_surface" "../secret" with
    | Left _ => True
    | Right _ => False
    end;

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_eq "json valid report" app_test_json_valid
          "{\"kind\":\"ouro.app_surface.json.validate\",\"pass\":true,\"message\":\"valid_json\"}"
       , assert_eq "json invalid report" app_test_json_invalid
          "{\"kind\":\"ouro.app_surface.json.validate\",\"pass\":false,\"message\":\"invalid_json\"}"
       , assert_true "json minify" app_test_json_minify
       , assert_true "json minify invalid" app_test_json_minify_invalid
       , assert_eq "csv report" app_test_csv_report
          "{\"kind\":\"ouro.app_surface.csv.report\",\"label\":\"fixture.csv\",\"rows\":3,\"data_rows\":2,\"columns\":2}"
       , assert_true "csv select" app_test_csv_select
       , assert_true "csv missing" app_test_csv_missing
       , assert_true "csv to tsv" app_test_tsv_project
       , assert_true "csv to tsv missing" app_test_tsv_missing
       , assert_eq "config report" app_test_config_report
          "{\"kind\":\"ouro.app_surface.config.report\",\"keys\":2}"
       , assert_true "safe workspace path" app_test_safe_path
       , assert_true "reject escape path" app_test_reject_escape
       ] : List Test);
