import "../tools/fmt.ouro" as Formatter;
import "../std/processx.ouro",
  "analyze/precision/assertions.ouro";

def native_fmt_selftest_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-fmt-selftest/worker-order"
        (precision_strings Formatter.fmt_selftest_worker_names
          ["clean", "messy", "syntax_keep", "multiline_calls", "write"])
    , MkPair String Bool "native-fmt-selftest/six-result-rows"
        (precision_strings (append String Formatter.fmt_selftest_worker_names ["tree"])
          ["clean", "messy", "syntax_keep", "multiline_calls", "write", "tree"])
    , MkPair String Bool "native-fmt-selftest/worker-argv-literal-bytes"
        (precision_strings
          (Formatter.fmt_selftest_worker_arguments "out 雪 & dir" "fixtures \\\" name" False "syntax_keep")
          ["--selftest-worker=syntax_keep", "--out=out 雪 & dir", "--fixtures=fixtures \\\" name"])
    , MkPair String Bool "native-fmt-selftest/probe-flag-order"
        (precision_strings (Formatter.fmt_selftest_worker_arguments "out" "fixtures" True "messy")
          ["--selftest-worker=messy", "--out=out", "--fixtures=fixtures", "--selftest-probe-failure"])
    , MkPair String Bool "native-fmt-selftest/probe-reaches-every-worker"
        (all String (fun (name : String) =>
          elem String str_eq "--selftest-probe-failure"
            (Formatter.fmt_selftest_worker_arguments "out" "fixtures" True name))
          Formatter.fmt_selftest_worker_names)
    , MkPair String Bool "native-fmt-selftest/pass-result"
        (Formatter.fmt_selftest_worker_result_valid "clean" 0 "clean\ttrue\t\n")
    , MkPair String Bool "native-fmt-selftest/expected-failure-result"
        (Formatter.fmt_selftest_worker_result_valid "messy" 1 "messy\tfalse\toutput\n")
    , MkPair String Bool "native-fmt-selftest/tree-failure-result"
        (Formatter.fmt_selftest_worker_result_valid "tree" 1 "tree\tfalse\tunformatted\n")
    , MkPair String Bool "native-fmt-selftest/pass-exit-mismatch"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 1 "clean\ttrue\t\n"))
    , MkPair String Bool "native-fmt-selftest/failure-exit-mismatch"
        (notb (Formatter.fmt_selftest_worker_result_valid "messy" 0 "messy\tfalse\toutput\n"))
    , MkPair String Bool "native-fmt-selftest/setup-usage-crash-codes-rejected"
        (all Nat (fun (code : Nat) =>
          notb (Formatter.fmt_selftest_worker_result_valid "clean" code "clean\ttrue\t\n"))
          [2, 127, 139, 259])
    , MkPair String Bool "native-fmt-selftest/wrong-row-name-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 0 "messy\ttrue\t\n"))
    , MkPair String Bool "native-fmt-selftest/empty-result-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 0 ""))
    , MkPair String Bool "native-fmt-selftest/missing-newline-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 0 "clean\ttrue\t"))
    , MkPair String Bool "native-fmt-selftest/unknown-boolean-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 1 "clean\tunknown\t\n"))
    , MkPair String Bool "native-fmt-selftest/extra-column-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 0 "clean\ttrue\t\textra\n"))
    , MkPair String Bool "native-fmt-selftest/extra-empty-column-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 0 "clean\ttrue\t\t\n"))
    , MkPair String Bool "native-fmt-selftest/extra-newline-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 0 "clean\ttrue\t\n\n"))
    , MkPair String Bool "native-fmt-selftest/leading-padding-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "clean" 0 " clean\ttrue\t\n"))
    , MkPair String Bool "native-fmt-selftest/multiline-issue-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "messy" 1 "messy\tfalse\toutput\ninjected\n"))
    , MkPair String Bool "native-fmt-selftest/raw-cr-issue-rejected"
        (notb (Formatter.fmt_selftest_worker_result_valid "messy" 1 "messy\tfalse\toutput\rinjected\n"))
    , MkPair String Bool "native-fmt-selftest/tree-literal-lines"
        (precision_strings
          (Formatter.fmt_selftest_tree_lines "std/ leading space.ouro\ntools/雪 & \\ path.ouro\nsamples/trailing space .ouro\n")
          ["std/ leading space.ouro", "tools/雪 & \\ path.ouro", "samples/trailing space .ouro"])
    , MkPair String Bool "native-fmt-selftest/tree-unterminated-last-line-skipped"
        (precision_strings (Formatter.fmt_selftest_tree_lines "std/first.ouro\ntools/last.ouro")
          ["std/first.ouro"])
    , MkPair String Bool "native-fmt-selftest/tree-empty-listing"
        (precision_strings (Formatter.fmt_selftest_tree_lines "") [])
    , MkPair String Bool "native-fmt-selftest/tree-blank-line-is-not-filtered"
        (precision_strings (Formatter.fmt_selftest_tree_lines "\n") [""])
    , MkPair String Bool "native-fmt-selftest/tree-middle-blank-line-is-retained"
        (precision_strings (Formatter.fmt_selftest_tree_lines "std/a.ouro\n\ntools/b.ouro\n")
          ["std/a.ouro", "", "tools/b.ouro"])
    , MkPair String Bool "native-fmt-selftest/tree-cr-is-literal"
        (precision_strings (Formatter.fmt_selftest_tree_lines "std/a.ouro\r\n") ["std/a.ouro\r"])
    , MkPair String Bool "native-fmt-selftest/tree-success"
        (Formatter.fmt_selftest_tree_pass True (MkProcResult 0 "" ""))
    , MkPair String Bool "native-fmt-selftest/tree-failure"
        (notb (Formatter.fmt_selftest_tree_pass True (MkProcResult 1 "" "needs formatting\n")))
    , MkPair String Bool "native-fmt-selftest/tree-failure-cannot-be-erased"
        (notb (Formatter.fmt_selftest_tree_pass False (MkProcResult 0 "" "")))
    , MkPair String Bool "native-fmt-selftest/tree-crash-is-failure"
        (notb (Formatter.fmt_selftest_tree_pass True (MkProcResult 139 "" "crash\n")))
    , MkPair String Bool "native-fmt-selftest/report-row-byte-format"
        (str_eq (Formatter.fmt_selftest_result_row
          (Formatter.MkFmtSelftestResult "clean" True "")) "clean\ttrue\t")
    ];

-- @entry main
def main : IO Unit := precision_run "native-fmt-selftest" native_fmt_selftest_laws;
