import "native_gc_fixtures.ouro";

def gc_tests : List Test := [
    let program : MirProgram := gc_test_heap [gc_test_allocate] [] [] [] MirNoGc in
      assert_true "Context footer preserves the four-entry descriptor table and budget offset"
        (andb (eq_nat(codegen_runtime_budget_offset program, 104))
          (eq_nat(codegen_runtime_heap_offset program, 112))),
    let program : MirProgram := gc_test_heap [gc_test_allocate] [] [] [] MirNoGc in
      match codegen_runtime_data program with
      | Nil => test_fail "Context reserves two zero footer words" "runtime context missing"
      | Cons object _ => match object with | MirDataDef _ writable bytes =>
          assert_true "Context reserves two zero footer words"
            (andb(writable, pe_bytes_equal(bytes, pe_zeros 120))) end end,
    gc_test_inferred "NoGc leaf body" (gc_test_program [gc_test_body 1 []] MirMayGc) [1],
    gc_test_inferred "NoGc includes raw memory and context without managed allocation"
      (gc_test_program [gc_test_body 1 [MirManagedContext 0, MirLoad(1, MirUse 0, codegen_disp 0),
        MirStore(MirUse 0, codegen_disp 0, MirUse 1)]] MirMayGc) [1],
    gc_test_inferred "NoGc direct chain is transitive" (gc_test_chain MirNoGc [] MirMayGc) [1,2,3],
    gc_test_inferred "NoGc recursive body is a closed graph"
      (gc_test_program [gc_test_body 1 [gc_test_call MirNoGc 1]] MirMayGc) [1],
    gc_test_inferred "NoGc mutual recursion reaches a fixed point" (gc_test_cycle []) [1,2,3],
    gc_test_inferred "NoGc mutual recursion is independent of function order" (gc_test_reverse (gc_test_cycle [])) [1,2,3],
    mir_test_bad "NoGc direct call cannot conceal allocation" (MirGcCallMismatch 1 2)
      (gc_test_heap [gc_test_call MirNoGc 2] [] [] [gc_test_body 2 [gc_test_allocate]] MirNoGc),
    mir_test_bad "NoGc caller cannot conceal transitive allocation" (MirGcCallMismatch 1 2)
      (gc_test_heap [gc_test_call MirNoGc 2] [] []
        [gc_test_body 2 [gc_test_call MirMayGc 3], gc_test_body 3 [gc_test_allocate]] MirNoGc),
    mir_test_bad "NoGc SCC cannot conceal an allocating exit" (MirGcCallMismatch 1 2)
      (gc_test_heap [gc_test_call MirNoGc 2] [] []
        [gc_test_body 2 [gc_test_call MirMayGc 3], gc_test_body 3 [gc_test_call MirMayGc 2, gc_test_allocate]] MirNoGc),
    mir_test_accept "MayGc direct call permits an allocating body"
      (gc_test_heap [gc_test_call MirMayGc 2] [] [] [gc_test_body 2 [gc_test_allocate]] MirNoGc),
    mir_test_bad "NoGc direct import preserves foreign MayGc" (MirGcCallMismatch 1 200)
      (gc_test_program [gc_test_body 1 [gc_test_call MirNoGc 200]] MirMayGc),
    mir_test_bad "NoGc chain preserves foreign MayGc" (MirGcCallMismatch 1 2)
      (gc_test_chain MirNoGc [gc_test_call MirMayGc 200] MirMayGc),
    mir_test_bad "NoGc recursive SCC preserves foreign MayGc" (MirGcCallMismatch 1 2)
      (gc_test_cycle [gc_test_call MirMayGc 200]),
    gc_test_inferred "Foreign NoGc remains an explicit raw ABI contract"
      (gc_test_chain MirNoGc [gc_test_call MirNoGc 200] MirNoGc) [1,2,3],
    mir_test_bad "Unknown indirect call cannot claim NoGc" (MirGcCallMismatch 1 0)
      (gc_test_program [gc_test_body 1 [gc_test_indirect MirNoGc]] MirNoGc),
    mir_test_accept "Unknown indirect call must remain MayGc"
      (gc_test_program [gc_test_body 1 [gc_test_indirect MirMayGc]] MirNoGc),
    mir_test_bad "NoGc chain preserves unknown indirect MayGc" (MirGcCallMismatch 1 2)
      (gc_test_chain MirNoGc [gc_test_indirect MirMayGc] MirNoGc),
    gc_test_inferred "Allocator and collector bodies are NoGc while managed allocation is MayGc"
      (gc_test_heap [gc_test_allocate] [] [] [] MirMayGc) [10,11],
    mir_test_bad "Allocator cannot call unknown indirect code" (MirGcUnsafeRuntime 10)
      (gc_test_heap [gc_test_allocate] [gc_test_indirect MirMayGc] [] [] MirNoGc),
    mir_test_bad "Allocator cannot transitively allocate managed storage" (MirGcUnsafeRuntime 10)
      (gc_test_heap [gc_test_allocate] [gc_test_call MirMayGc 2] [] [gc_test_body 2 [gc_test_allocate]] MirNoGc),
    mir_test_bad "Allocator cannot call a MayGc import" (MirGcUnsafeRuntime 10)
      (gc_test_heap [gc_test_allocate] [gc_test_call MirMayGc 200] [] [] MirMayGc),
    mir_test_bad "Collector cannot call a MayGc import" (MirGcUnsafeRuntime 11)
      (gc_test_heap [gc_test_allocate] [] [gc_test_call MirMayGc 200] [] MirMayGc),
    mir_test_bad "Collector cannot call unknown indirect code" (MirGcUnsafeRuntime 11)
      (gc_test_heap [gc_test_allocate] [] [gc_test_indirect MirMayGc] [] MirNoGc),
    mir_test_bad "Collector cannot allocate managed storage" (MirGcUnsafeRuntime 11)
      (gc_test_heap [gc_test_allocate] [] [gc_test_allocate] [] MirNoGc),
    mir_test_bad "Collector cannot reenter its own hook" (MirGcUnsafeRuntime 11)
      (gc_test_heap [gc_test_allocate] [] [gc_test_collect_call MirMayGc] [] MirNoGc),
    mir_test_bad "Collector helper cannot reenter the hook" (MirGcUnsafeRuntime 11)
      (gc_test_heap [gc_test_allocate] [] [gc_test_call MirMayGc 2]
        [gc_test_body 2 [gc_test_collect_call MirMayGc]] MirNoGc),
    mir_test_bad "Allocator cannot enter the collector" (MirGcUnsafeRuntime 10)
      (gc_test_heap [gc_test_allocate]
        [MirCall(MirMayGc, Just Nat 4, MirDirect 11, [MirUse 0])] [] [] MirNoGc),
    mir_test_bad "A direct collector call cannot claim its body effect" (MirGcCallMismatch 1 11)
      (gc_test_heap [gc_test_allocate, gc_test_collect_call MirNoGc] [] [] [] MirNoGc),
    mir_test_accept "A direct collector call explicitly carries MayGc"
      (gc_test_heap [gc_test_allocate, gc_test_collect_call MirMayGc] [] [] [] MirNoGc),
    mir_test_accept "Collector raw helpers may call a declared NoGc import"
      (gc_test_heap [gc_test_allocate] [] [gc_test_call MirNoGc 2]
        [gc_test_body 2 [gc_test_call MirNoGc 200]] MirNoGc),
    mir_test_bad "Collector ABI requires an internal function" (MirInvalidCall 200)
      (gc_test_heap [MirManagedAlloc 2 10 200 100 (mir_fixture_nat MirUSize 40)] [] [] [] MirNoGc),
    mir_test_bad "Collector ABI rejects an unknown target" (MirInvalidCall 12)
      (gc_test_heap [MirManagedAlloc 2 10 12 100 (mir_fixture_nat MirUSize 40)] [] [] [] MirNoGc),
    mir_test_bad "Collector ABI requires a U8 result" (MirInvalidCall 11)
      (gc_test_replace_collector (MirFunctionDef 11 [99] [MirLocalDef 0 MirRawPtr] [] (Just MirType MirU32) 0
        [MirBlockDef 0 [] (MirReturn (Just(MirValue, mir_fixture_nat MirU32 1)))])),
    mir_test_bad "Collector ABI cannot consume a managed argument" (MirInvalidCall 11)
      (gc_test_replace_collector (MirFunctionDef 11 [99] [MirLocalDef 0 MirManagedPtr] [] (Just MirType MirU8) 0
        [MirBlockDef 0 [] (MirReturn (Just(MirValue, mir_fixture_nat MirU8 1)))])),
    mir_test_bad "Collector ABI rejects an extra parameter" (MirInvalidCall 11)
      (gc_test_replace_collector (MirFunctionDef 11 [99] [MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirRawPtr] []
        (Just MirType MirU8) 0 [MirBlockDef 0 [] (MirReturn (Just(MirValue, mir_fixture_nat MirU8 1)))])),
    gc_test_annotated "Lowered calls receive transitive NoGc labels" (gc_test_chain MirMayGc [] MirMayGc) True,
    gc_test_annotated "Lowered calls retain transitive foreign MayGc labels"
      (gc_test_chain MirMayGc [gc_test_call MirMayGc 200] MirMayGc) False,
    gc_test_annotated "Lowered indirect calls remain MayGc"
      (gc_test_program [gc_test_body 1 [gc_test_indirect MirMayGc]] MirNoGc) False,
    gc_test_inference_error "Zero effect budget is not NoGc evidence" 0 (gc_test_chain MirMayGc [] MirNoGc),
    gc_test_inference_error "Partial effect convergence is a resource failure" 2
      (gc_test_chain MirMayGc [gc_test_call MirMayGc 200] MirMayGc),
    mir_test_reject "MIR effect validation preserves the node ceiling" MirResourceExhausted
      (MirLimitsWith 0 1024 64) (gc_test_heap [gc_test_allocate] [] [] [] MirNoGc),
    match codegen_program(mir_default_limits, gc_test_program [gc_test_body 1 [gc_test_call MirNoGc 200]] MirMayGc) with
    | Right _ => test_fail "Codegen rechecks false NoGc claims" "invalid MIR emitted"
    | Left error => match error with
      | NativeMirError problem => assert_eq "Codegen rechecks false NoGc claims" (mir_test_error_text problem) "gc-call:1:200"
      | NativeEncodingError _ => test_fail "Codegen rechecks false NoGc claims" "wrong error"
      | NativePeError _ => test_fail "Codegen rechecks false NoGc claims" "wrong error"
      | NativeMissingSlot _ => test_fail "Codegen rechecks false NoGc claims" "wrong error"
      | NativeMissingLabel _ => test_fail "Codegen rechecks false NoGc claims" "wrong error"
      | NativeCodeTooLarge => test_fail "Codegen rechecks false NoGc claims" "wrong error" end end];

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match eq_nat(length String arguments, 1) with
       | True => test_run gc_tests
       | False => match andb(eq_nat(length String arguments, 3), str_eq(nth String "" 1 arguments, "--image")) with
         | True => gc_test_emit (nth String "" 2 arguments)
         | False => do eprintln "usage: native_gc_tests [--image NAME]"; exit 2 end end
