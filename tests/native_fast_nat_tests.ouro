-- Real source checking supplies the Core and resolved identities under test.
-- Forged records below are rejection probes for the public checked boundary.
import "native_fast_nat_fixtures.ouro";
import "../compiler/native/managed_source.ouro";
import "../std/io.ouro";
import "compiler_program_lookup.ouro";
import "native_nat_test_support.ouro";

def fast_nat_test_fuel : Nat := mul 100 160;

def assert_true (name : String) (passed : Bool) : Pair String Bool := MkPair String Bool name passed;

def fast_nat_operation_code (result : Either NativeLowerError (Maybe ManagedNatOperation)) : Nat :=
    match result with
    | Left _ => 5
    | Right operation => match operation with
        | Nothing => 0
        | Just selected => match selected with
            | ManagedNatEqual _ => 1 | ManagedNatAdd => 2
            | ManagedNatSubtract => 3 | ManagedNatCompare _ => 4 end end end;

def fast_nat_source_case (source : String) (expectations : List (Pair String Nat)) : Bool :=
    match compile_checked_source fast_nat_test_fuel (prim_string_to_char_codes source) with
    | CErr _ => False
    | COk program => all (Pair String Nat) (fun (expectation : Pair String Nat) => match expectation with
        | MkPair name expected => nat_test_with_body fast_nat_test_fuel program name (fun (id : Nat) (annotation : CoreTerm) (body : CoreTerm) =>
            eqNat expected (fast_nat_operation_code
              (managed_nat_recognize (checked_program_entries program) fast_nat_test_fuel id annotation body))) end) expectations end;

def fast_nat_standard_expectations : List (Pair String Nat) :=
    [MkPair String Nat "eqNat" 1, MkPair String Nat "add" 2,
     MkPair String Nat "sub" 3, MkPair String Nat "compareNat" 4];

def fast_nat_renamed_expectations : List (Pair String Nat) :=
    [MkPair String Nat "unrelated_one" 1, MkPair String Nat "unrelated_two" 2,
     MkPair String Nat "unrelated_three" 3, MkPair String Nat "unrelated_four" 4];

def fast_nat_renumbered : Bool :=
    match compile_checked_source fast_nat_test_fuel (prim_string_to_char_codes fast_nat_fixture_canonical),
      compile_checked_source fast_nat_test_fuel (prim_string_to_char_codes fast_nat_fixture_renamed) with
    | COk first, COk second => match compiler_test_name first "Nat", compiler_test_name second "Count" with
        | Just original, Just renamed => notb (eqNat original renamed)
        | Nothing, Just _ => False | Just _, Nothing => False | Nothing, Nothing => False end
    | CErr _, COk _ => False | COk _, CErr _ => False | CErr _, CErr _ => False end;

-- Mutants are deliberately untrusted inputs to the recognizer. The source
-- program supplying each original body was checked immediately above it.
def fast_nat_change_fix (mode : Nat) (body : CoreTerm) : CoreTerm :=
    match body with
    | CFix name argument arity typ inner =>
        match eqNat mode 0 with
        | True => CFix name (S argument) arity typ inner
        | False => match eqNat mode 1 with
            | True => CFix name argument (S arity) typ inner
            | False => CFix (S name) argument arity typ inner end end
    | CRel _ => body | CConst _ => body | CInd _ => body | CConstruct _ _ _ => body
    | CSort _ => body | CPi _ _ => body | CLam _ _ => body | CApp _ _ => body
    | CLetIn _ _ _ => body | CCase _ _ _ _ => body | CStrLit _ _ => body | CStrBytes _ _ => body end;

def fast_nat_fix_case (name : String) (mode : Nat) (expected : Nat) : Bool :=
    match compile_checked_source fast_nat_test_fuel (prim_string_to_char_codes fast_nat_fixture_canonical) with
    | CErr _ => False
    | COk program => nat_test_with_body fast_nat_test_fuel program name (fun (id : Nat) (annotation : CoreTerm) (body : CoreTerm) =>
        eqNat expected (fast_nat_operation_code (managed_nat_recognize (checked_program_entries program)
          fast_nat_test_fuel id annotation (fast_nat_change_fix mode body)))) end;

def fast_nat_metadata_rejected : Bool :=
    match compile_checked_source fast_nat_test_fuel (prim_string_to_char_codes fast_nat_fixture_canonical) with
    | CErr _ => False
    | COk program => match program with | CheckedProgramOf names entries bodies =>
        let forged : CheckedProgram := CheckedProgramOf names (map Entry Entry nat_forge_role entries) bodies in
        match native_managed_lower_checked fast_nat_test_fuel mir_default_limits 0 forged with
        | Right _ => False
        | Left failure => match failure with
            | NativeSourceCheckError _ => False
            | NativeSourceLowerError error => match error with
                | LowerMetadataMismatch _ => True
                | LowerResourceExhausted => False | LowerDeclarationFailure _ _ _ => False
                | LowerBodyMismatch _ => False | LowerUnsupportedType _ => False
                | LowerUnsupportedTerm _ => False | LowerUnsupportedPrimitive _ => False
                | LowerUnknownGlobal _ => False | LowerUnboundLocal _ => False | LowerInvalidCall _ => False
                | LowerEffectMismatch => False | LowerInvalidEntry _ => False | LowerMirFailure _ => False
                | LowerBackendFailure _ => False end end end end end;

def fast_nat_fuel_rejected : Bool :=
    match compile_checked_source fast_nat_test_fuel (prim_string_to_char_codes fast_nat_fixture_canonical) with
    | CErr _ => False
    | COk program => nat_test_with_body fast_nat_test_fuel program "add" (fun (id : Nat) (annotation : CoreTerm) (body : CoreTerm) =>
        match managed_nat_recognize (checked_program_entries program) 0 id annotation body with
        | Right _ => False | Left error => match error with
            | LowerResourceExhausted => True | LowerDeclarationFailure _ _ _ => False
            | LowerMetadataMismatch _ => False | LowerBodyMismatch _ => False | LowerUnsupportedType _ => False
            | LowerUnsupportedTerm _ => False | LowerUnsupportedPrimitive _ => False | LowerUnknownGlobal _ => False
            | LowerUnboundLocal _ => False | LowerInvalidCall _ => False | LowerEffectMismatch => False
            | LowerInvalidEntry _ => False | LowerMirFailure _ => False | LowerBackendFailure _ => False end end) end;

def main : IO Unit := nat_test_run
    [assert_true "four checked standard bodies select native Nat operations"
       (fast_nat_source_case fast_nat_fixture_canonical fast_nat_standard_expectations),
     assert_true "renamed globals constructors binders and families select the same operations"
       (fast_nat_source_case fast_nat_fixture_renamed fast_nat_renamed_expectations),
     assert_true "renamed source actually changes resolved Nat identity" fast_nat_renumbered,
     assert_true "constant same-name equality keeps generic lowering"
       (fast_nat_source_case fast_nat_fixture_constant_eq [MkPair String Nat "eqNat" 0]),
     assert_true "inverted same-name equality keeps generic lowering"
       (fast_nat_source_case fast_nat_fixture_inverted_eq [MkPair String Nat "eqNat" 0]),
     assert_true "changed addition body keeps generic lowering"
       (fast_nat_source_case fast_nat_fixture_changed_add [MkPair String Nat "add" 0]),
     assert_true "changed subtraction body keeps generic lowering"
       (fast_nat_source_case fast_nat_fixture_changed_sub [MkPair String Nat "sub" 0]),
     assert_true "permuted comparison branch results keep generic lowering"
       (fast_nat_source_case fast_nat_fixture_changed_compare [MkPair String Nat "compareNat" 0]),
     assert_true "missing Nat role disables all four operations"
       (fast_nat_source_case fast_nat_fixture_missing_nat [MkPair String Nat "eqNat" 0,
          MkPair String Nat "add" 0, MkPair String Nat "sub" 0, MkPair String Nat "compareNat" 0]),
     assert_true "missing Bool role disables equality"
       (fast_nat_source_case fast_nat_fixture_missing_bool [MkPair String Nat "eqNat" 0]),
     assert_true "different Nat-shaped family does not acquire the registered role"
       (fast_nat_source_case fast_nat_fixture_foreign [MkPair String Nat "eqNat" 0]),
     assert_true "non-nullary comparison result family keeps generic lowering"
       (fast_nat_source_case fast_nat_fixture_non_enum [MkPair String Nat "compareNat" 0]),
     assert_true "changed recursive argument is not recognized" (fast_nat_fix_case "eqNat" 0 0),
     assert_true "changed fixpoint arity is not recognized" (fast_nat_fix_case "add" 1 0),
     assert_true "fixpoint display name has no recognition authority" (fast_nat_fix_case "sub" 2 3),
     assert_true "forged representation metadata fails before native specialization" fast_nat_metadata_rejected,
     assert_true "exact comparison fuel failure propagates" fast_nat_fuel_rejected];
