import "../../runtime/platform/windows_directory.ouro",
  "host_test_common.ouro";

-- Bound the fixture traversal and emit each successful Win32 record verbatim.
def directory_test_entry (stream : RawPtr U8) (search : RawPtr U8) (data : RawPtr U8)
    (written : RawPtr U32) (total : RawPtr USize) (anchor : USize) : Runtime USize :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := host_test_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind USize USize (raw_load_usize total) (fun (seen : USize) =>
  runtime_bind Unit USize (host_test_require(usize_less(seen, host_test_times_eight two), raw_size_to_u32 (host_test_times_eight (usize_add(host_test_times_eight one, two))))) (fun (bounded : Unit) =>
  runtime_bind U32 USize (raw_windows_file_write stream data (host_test_times_eight (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), two))) written) (fun (write : U32) =>
  runtime_bind Unit USize (host_test_require(u32_equal(write, raw_size_to_u32 zero), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), four)))) (fun (write_ok : Unit) =>
  runtime_bind U32 USize (raw_load_u32 written) (fun (actual : U32) =>
  runtime_bind Unit USize (host_test_require(u32_equal(actual, raw_size_to_u32 (host_test_times_eight (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), two)))), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, two)), one)))) (fun (complete : Unit) =>
  runtime_bind Unit USize (raw_store_usize(total, usize_add seen one)) (fun (incremented : Unit) =>
  runtime_bind U32 USize (raw_windows_directory_next search data (host_test_times_eight (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), two)))) (fun (next : U32) =>
  runtime_pure(USize, raw_u32_to_size next)))))))));

-- Every validation failure must preserve all 592 output bytes.
def directory_test_unchanged (data : RawPtr U8) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := host_test_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    match u8_from_nat 1 with | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, two)), three))) | Just running => runtime_bind USize Unit (runtime_loop USize zero (fun (index : USize) => runtime_pure(U8, match usize_less(index, host_test_times_eight (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), two))) with | True => running | False => u8_sub running running end)) (fun (index : USize) => runtime_bind Unit USize (host_test_byte(data, index, raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight two, four)), five)), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, two)), two)))) (fun (same : Unit) =>
  runtime_pure(USize, usize_add index one)))) (fun (checked : USize) => runtime_pure Unit MkUnit) end;
