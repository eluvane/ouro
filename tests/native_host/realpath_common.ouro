-- Raw probes use separate aligned cells. Status failures must leave both
-- sentinels intact, including ordinary OS absence and a preowned owner cell.
import "file_common.ouro";
import "../../runtime/platform/windows_realpath.ouro";

extern realpath_test_set_last_error : U32 -> Runtime Unit :=
    "windows-x86_64" "win64" "kernel32.dll" "SetLastError" "nogc";

def realpath_test_cells (status : U32) (expected : U32) (owner : RawPtr USize)
    (owner_bits : USize) (count : RawPtr U32) (count_bits : U32) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := host_test_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind Unit Unit (host_test_require (u32_equal status expected) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) two))) (fun (status_ok : Unit) =>
      runtime_bind USize Unit (raw_load_usize owner) (fun (actual_owner : USize) =>
        runtime_bind Unit Unit (host_test_require (usize_equal actual_owner owner_bits) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) three))) (fun (owner_ok : Unit) =>
          runtime_bind U32 Unit (raw_load_u32 count) (fun (actual_count : U32) =>
            host_test_require (u32_equal actual_count count_bits) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) four))))));
