import "text_common.ouro";

def main : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits(U8, raw_null U8)) (fun (anchor : USize) =>
    let zero : USize := usize_sub anchor anchor in
    let one : USize := host_test_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) U32 (raw_pages_allocate(host_test_times_eight (host_test_times_eight (host_test_times_eight one)), host_test_times_eight one)) (fun (storage : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_to_bits U8 storage) (fun (address : USize) =>
  runtime_bind Unit U32 (host_test_require(raw_bool_not (usize_equal address zero), raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), six)))) (fun (allocated : Unit) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage zero) (fun (source : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight two))) (fun (target : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight four))) (fun (back : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight six))) (fun (count_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 count_bytes) (fun (count : (RawPtr U32)) =>
  runtime_bind Unit U32 (raw_store_u32(count, raw_size_to_u32 (usize_add(host_test_times_eight two, one)))) (fun (empty8_sentinel : Unit) =>
  runtime_bind U32 U32 (raw_windows_utf8_to_utf16 (raw_null U8) zero (raw_null U8) zero count) (fun (empty8_status : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(empty8_status, raw_size_to_u32 zero), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), four)))) (fun (empty8_status_ok : Unit) =>
  runtime_bind U32 U32 (raw_load_u32 count) (fun (empty8_count : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(empty8_count, raw_size_to_u32 zero), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), five)))) (fun (empty8_count_ok : Unit) =>
  runtime_bind Unit U32 (raw_store_u32(count, raw_size_to_u32 (usize_add(host_test_times_eight two, one)))) (fun (empty16_sentinel : Unit) =>
  runtime_bind U32 U32 (raw_windows_utf16_to_utf8 (raw_null U8) zero (raw_null U8) zero count) (fun (empty16_status : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(empty16_status, raw_size_to_u32 zero), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), four)))) (fun (empty16_status_ok : Unit) =>
  runtime_bind U32 U32 (raw_load_u32 count) (fun (empty16_count : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(empty16_count, raw_size_to_u32 zero), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), five)))) (fun (empty16_count_ok : Unit) =>
  host_test_finish storage anchor)))))))))))))))))));
