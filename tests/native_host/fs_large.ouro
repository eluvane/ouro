def host_file_test_all (buffer : RawPtr U8) (bytes : USize) (expected : U32) (one : USize) (code : U32) : Runtime Unit :=
    let zero : USize := usize_sub one one in
    match u8_from_nat 1 with | Nothing => windows_exit_process code | Just running =>
      runtime_bind USize Unit (runtime_loop USize zero
        (fun (index : USize) => runtime_pure U8 (match usize_less index bytes with
          | True => running | False => u8_sub running running end))
        (fun (index : USize) => runtime_bind Unit USize (host_test_byte buffer index expected code)
          (fun (checked : Unit) => runtime_pure(USize, usize_add index one))))
        (fun (finished : USize) => host_test_require(usize_equal finished bytes, code)) end;

