    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) U32 (raw_pages_allocate (host_test_times_eight (host_test_times_eight (host_test_times_eight (host_test_times_eight two)))) (host_test_times_eight one)) (fun (storage : (RawPtr U8)) =>
  runtime_bind USize U32 (raw_to_bits U8 storage) (fun (address : USize) =>
