  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight two))) (fun (source : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight (host_test_times_eight two)))) (fun (target : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight (host_test_times_eight (host_test_times_eight one))))) (fun (back : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) five)) five)) three))) (fun (owner_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) five)) five)) four))) (fun (result_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) five)) five)) five))) (fun (count_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) five)) six)))) (fun (clock_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) five)) six)) five))) (fun (env_owner_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize owner_bytes) (fun (owner : (RawPtr USize)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize result_bytes) (fun (result : (RawPtr USize)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize env_owner_bytes) (fun (env_owner : (RawPtr USize)) =>
  runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 count_bytes) (fun (count : (RawPtr U32)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize clock_bytes) (fun (clock_word : (RawPtr USize)) =>
  runtime_bind U32 U32 (raw_windows_counter_frequency clock_word) (fun (frequency : U32) =>
  runtime_bind Unit U32 (host_test_require (u32_equal frequency (raw_size_to_u32 zero)) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) four))) (fun (frequency_ok : Unit) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 clock_bytes (host_test_times_eight one)) (fun (first_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize first_bytes) (fun (first_word : (RawPtr USize)) =>
  runtime_bind U32 U32 (raw_windows_counter first_word) (fun (first : U32) =>
  runtime_bind Unit U32 (host_test_require (u32_equal first (raw_size_to_u32 zero)) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) four))) (fun (first_ok : Unit) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 clock_bytes (host_test_times_eight two)) (fun (second_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize second_bytes) (fun (second_word : (RawPtr USize)) =>
  runtime_bind U32 U32 (raw_windows_counter second_word) (fun (second : U32) =>
  runtime_bind Unit U32 (host_test_require (u32_equal second (raw_size_to_u32 zero)) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) four))) (fun (second_ok : Unit) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 clock_bytes (host_test_times_eight three)) (fun (wall_bytes : (RawPtr U8)) =>
  runtime_bind (RawPtr USize) U32 (raw_cast U8 USize wall_bytes) (fun (wall_word : (RawPtr USize)) =>
  runtime_bind U32 U32 (raw_windows_wall_time wall_word) (fun (wall : U32) =>
  runtime_bind Unit U32 (host_test_require (u32_equal wall (raw_size_to_u32 zero)) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) four))) (fun (wall_ok : Unit) =>
  runtime_bind Unit U32 (startup_test_output clock_bytes (host_test_times_eight four) count anchor) (fun (output : Unit) =>
  host_test_finish storage anchor))))))))))))))))))))))))))))))));
