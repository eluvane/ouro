  runtime_bind U32 U32 (raw_load_u32 count) (fun (bytes : U32) =>
  runtime_bind Unit U32 (startup_test_output back (raw_u32_to_size bytes) count anchor) (fun (output : Unit) =>
  host_test_finish storage anchor)))))))))))))))))))))))))))))))));
