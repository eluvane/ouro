  runtime_bind U32 U32 (raw_load_u32 count) (fun (units : U32) =>
  runtime_bind Unit U32 (host_test_require (usize_equal (usize_add (raw_u32_to_size units) one) (raw_u32_to_size needed)) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) five))) (fun (length_excludes_zero : Unit) =>
