  runtime_bind U32 U32 (raw_windows_current_directory target one count) (fun (short : U32) =>
  runtime_bind Unit U32 (host_test_require (u32_equal short (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) seven)) two))) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) four))) (fun (short_ok : Unit) =>
  runtime_bind U32 U32 (raw_load_u32 count) (fun (again : U32) =>
