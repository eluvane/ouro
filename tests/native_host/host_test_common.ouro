import "../../runtime/managed_memory.ouro";

def host_test_one (anchor : USize) : USize :=
    let one : USize := managed_one anchor in one;

def host_test_times_eight (value : USize) : USize :=
    let scaled : USize := managed_word_offset value in scaled;

def host_test_require (condition : Bool) (code : U32) : Runtime Unit :=
    match condition with | True => runtime_pure Unit MkUnit | False => windows_exit_process code end;

def host_test_byte (base : RawPtr U8) (offset : USize) (expected : U32) (code : U32) : Runtime Unit :=
    runtime_bind (RawPtr U8) Unit (raw_add U8 base offset) (fun (cell : RawPtr U8) =>
      runtime_bind U8 Unit (raw_load_u8 cell) (fun (actual : U8) =>
        host_test_require (u32_equal (u8_to_u32 actual) expected) code));

def host_test_write (base : RawPtr U8) (offset : USize) (value : U8) : Runtime Unit :=
    runtime_bind (RawPtr U8) Unit (raw_add U8 base offset)
      (fun (cell : RawPtr U8) => raw_store_u8 cell value);

def host_test_finish (storage : RawPtr U8) (anchor : USize) : Runtime U32 :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := host_test_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind Bool U32 (raw_pages_release storage) (fun (released : Bool) =>
  runtime_bind Unit U32 (host_test_require released (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) one)) one))) (fun (closed : Unit) =>
  runtime_pure U32 (raw_size_to_u32 (usize_add (host_test_times_eight five) two))));
