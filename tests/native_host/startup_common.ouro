import "../../runtime/platform/windows_text.ouro";
import "../../runtime/platform/windows_startup.ouro";
import "../../runtime/platform/windows_clock.ouro";
import "../../runtime/platform/windows_io.ouro";
import "host_test_common.ouro";

-- Fixture output uses the inherited stdout handle; verification supplies a
-- private pipe and a controlled child environment.
def startup_test_output (buffer : RawPtr U8) (bytes : USize) (count : RawPtr U32) (anchor : USize) : Runtime Unit :=
    let zero : USize := usize_sub anchor anchor in
    let one : USize := host_test_one anchor in
    let two : USize := usize_add one one in
    let three : USize := usize_add two one in
    let four : USize := usize_add two two in
    let five : USize := usize_add four one in
    let six : USize := usize_add four two in
    let seven : USize := usize_add four three in
    runtime_bind (RawPtr U8) Unit (windows_get_std_handle (u32_sub (raw_size_to_u32 zero) (raw_size_to_u32 (usize_add (host_test_times_eight one) three)))) (fun (stream : (RawPtr U8)) =>
  runtime_bind U32 Unit (windows_write_file stream buffer (raw_size_to_u32 bytes) count (raw_null U8)) (fun (status : U32) =>
  runtime_bind Unit Unit (host_test_require (raw_bool_not (u32_equal status (raw_size_to_u32 zero))) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) two)) four))) (fun (written : Unit) =>
  runtime_bind U32 Unit (raw_load_u32 count) (fun (actual : U32) =>
  runtime_bind Unit Unit (host_test_require (u32_equal actual (raw_size_to_u32 bytes)) (raw_size_to_u32 (usize_add (host_test_times_eight (usize_add (host_test_times_eight one) two)) five))) (fun (exact : Unit) =>
  runtime_pure Unit MkUnit)))));
