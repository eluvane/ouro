  runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 count_bytes) (fun (count : (RawPtr U32)) =>
  runtime_bind Unit U32 (match u8_from_nat 0 with | Just byte => host_test_write source zero byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad0_0 : Unit) =>
  runtime_bind Unit U32 (match u8_from_nat 216 with | Just byte => host_test_write source one byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad0_1 : Unit) =>
  runtime_bind Unit U32 (raw_store_u32(count, raw_size_to_u32 (usize_add(host_test_times_eight two, one)))) (fun (reject0_sentinel : Unit) =>
  runtime_bind U32 U32 (raw_windows_utf16_to_utf8 source one target (host_test_times_eight four) count) (fun (reject0_status : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(reject0_status, raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight (usize_add(host_test_times_eight two, one)), three)), one))), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), four)))) (fun (reject0_status_ok : Unit) =>
  runtime_bind U32 U32 (raw_load_u32 count) (fun (reject0_count : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(reject0_count, raw_size_to_u32 (usize_add(host_test_times_eight two, one))), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), five)))) (fun (reject0_count_ok : Unit) =>
  runtime_bind Unit U32 (match u8_from_nat 0 with | Just byte => host_test_write source zero byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad1_0 : Unit) =>
  runtime_bind Unit U32 (match u8_from_nat 220 with | Just byte => host_test_write source one byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad1_1 : Unit) =>
  runtime_bind Unit U32 (raw_store_u32(count, raw_size_to_u32 (usize_add(host_test_times_eight two, one)))) (fun (reject1_sentinel : Unit) =>
  runtime_bind U32 U32 (raw_windows_utf16_to_utf8 source one target (host_test_times_eight four) count) (fun (reject1_status : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(reject1_status, raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight (usize_add(host_test_times_eight two, one)), three)), one))), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), four)))) (fun (reject1_status_ok : Unit) =>
  runtime_bind U32 U32 (raw_load_u32 count) (fun (reject1_count : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(reject1_count, raw_size_to_u32 (usize_add(host_test_times_eight two, one))), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), five)))) (fun (reject1_count_ok : Unit) =>
  runtime_bind Unit U32 (match u8_from_nat 0 with | Just byte => host_test_write source zero byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad2_0 : Unit) =>
  runtime_bind Unit U32 (match u8_from_nat 216 with | Just byte => host_test_write source one byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad2_1 : Unit) =>
  runtime_bind Unit U32 (match u8_from_nat 65 with | Just byte => host_test_write source two byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad2_2 : Unit) =>
  runtime_bind Unit U32 (match u8_from_nat 0 with | Just byte => host_test_write source three byte | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(host_test_times_eight (host_test_times_eight one), seven))) end) (fun (bad2_3 : Unit) =>
  runtime_bind Unit U32 (raw_store_u32(count, raw_size_to_u32 (usize_add(host_test_times_eight two, one)))) (fun (reject2_sentinel : Unit) =>
  runtime_bind U32 U32 (raw_windows_utf16_to_utf8 source two target (host_test_times_eight four) count) (fun (reject2_status : U32) =>
  runtime_bind Unit U32 (host_test_require(u32_equal(reject2_status, raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight (usize_add(host_test_times_eight two, one)), three)), one))), raw_size_to_u32 (usize_add(host_test_times_eight (usize_add(host_test_times_eight one, one)), four)))) (fun (reject2_status_ok : Unit) =>
