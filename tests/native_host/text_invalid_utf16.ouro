  runtime_bind (RawPtr U8) U32 (raw_add U8 storage zero) (fun (source : (RawPtr U8)) =>
  runtime_bind (RawPtr U8) U32 (raw_add U8 storage (host_test_times_eight (host_test_times_eight two))) (fun (target : (RawPtr U8)) =>
