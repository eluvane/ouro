-- Registry and suppression invariants for the core/json Clippy cone.

import "../tools/clippy/scan.ouro",
  "../std/io.ouro";

def cg_inv_fail (label : String) (message : String) : List String :=
    [prim_string_concat(label, prim_string_concat ": " message)];

def cg_inv_rule (strict : String) (release : String) : QrClippy :=
    MkQrClippy "OURO-CLIPPY-TEST-001" "test" "test title" "test message" "Manual test suggestion"
      [MkPair String String "baseline" "warn", MkPair String String "project" "warn",
       MkPair String String "strict" strict, MkPair String String "release" release];

def cg_inv_small_registry : Bool :=
    match cg_validate_rules [MkPair String QrClippy "OURO-CLIPPY-TEST-001" (cg_inv_rule "deny" "deny")] with
    | Nil => True
    | Cons _ _ => False
    end;

def cg_inv_release_order : Bool :=
    match cg_validate_one_rule "OURO-CLIPPY-TEST-001" (cg_inv_rule "deny" "warn") [] with
    | Nil => False
    | Cons _ _ => True
    end;

def cg_inv_fatal : Bool :=
    let failed : QrFinding := cg_s_incomplete [] "project" "probe.ouro" "test frontend failure" in
    match cg_apply_sup [failed] [MkPair Nat (List String) 1 ["OURO-CLIPPY-FRONTEND-001"]] with
    | Nil => False
    | Cons finding rest => match rest with
      | Cons _ _ => False
      | Nil => match qr_find_mark finding with
        | Just _ => False
        | Nothing => andb(prim_string_eq(qr_find_level finding, "fatal"), qr_clip_blocks finding)
        end
      end
    end;

def cg_inv_parse_ok : Bool :=
    match cg_s_parse_reply
        (prim_string_concat "ouro.clippy-semantic.v3\nok\n0\n\n1\n"
          "OURO-CLIPPY-REDUNDANT-001\nretain\n1\n-\n-\nunannotated local\n") with
    | Left _ => False
    | Right framed => match framed with
      | MkPair source proofs => match proofs with
      | Nil => False
      | Cons proof rest => match rest with
        | Cons _ _ => False
        | Nil => match proof with
          | MkCgSProof code owner node range evidence =>
              andb (prim_string_eq source "") (andb (prim_string_eq code "OURO-CLIPPY-REDUNDANT-001")
                (andb (prim_string_eq owner "retain")
                  (andb (eq_nat node 1) (andb (match range with
                    | Nothing => True | Just _ => False end)
                    (prim_string_eq evidence "unannotated local")))))
          end
        end
      end
      end
    end;

def cg_inv_parse_error : Bool :=
    match cg_s_parse_reply "ouro.clippy-semantic.v3\nerror\ncompiler parser failed\n" with
    | Left error => prim_string_eq (quality_input_message error)
        "missing or unsafe quality input: semantic worker rejected input: compiler parser failed"
    | Right _ => False
    end;

def cg_inv_rejected (text : String) : Bool :=
    match cg_s_parse_reply text with | Left _ => True | Right _ => False end;

def cg_inv_protocol_negative : Bool :=
    all String cg_inv_rejected
      [ "ouro.clippy-structural.v1\nok\n0\n"
      , "ouro.clippy-semantic.v2\nok\n0\n\n0\n"
      , "ouro.clippy-semantic.v3\nok\n00\n\n0\n"
      , "ouro.clippy-semantic.v3\nok\n2\nx\n0\n"
      , "ouro.clippy-semantic.v3\nok\n0\n\n01\n"
      , "ouro.clippy-semantic.v3\nok\n0\n\n500001\n"
      , "ouro.clippy-semantic.v3\nok\n0\n\n1\nCODE\nowner\n01\n-\n-\nevidence\n"
      , "ouro.clippy-semantic.v3\nok\n0\n\n1\nCODE\nowner\n1\n-\n0\nevidence\n"
      , "ouro.clippy-semantic.v3\nok\n0\n\n1\nCODE\nowner\n1\n2\n1\nevidence\n"
      , "ouro.clippy-semantic.v3\nok\n0\n\n1\nCODE\nowner\n1\n-\n-\n   \n"
      , "ouro.clippy-semantic.v3\nok\n0\n\n0\nextra\n" ];

def cg_inv_raw_directive_boundary : Bool :=
    let source : String :=
      "def text : String := r#\"first\n-- ouro-clippy:disable-all\n\"#;\n-- ouro-clippy:disable=OURO-CLIPPY-REDUNDANT-001 reason=real" in
    let raw_lines : List String := qt_split_lines source in
    let code_lines : List String := qt_source_code_lines source in
    andb(prim_string_eq
      (cg_directive (nth String "" 1 raw_lines) (nth String "" 1 code_lines)) "",
      prim_string_eq
        (cg_directive (nth String "" 3 raw_lines) (nth String "" 3 code_lines))
        "ouro-clippy:disable=OURO-CLIPPY-REDUNDANT-001 reason=real");

def cg_inv_print : List String -> IO Unit :=
  fix go (errors : List String) : IO Unit :=
    match errors with
    | Nil => io_pure Unit MkUnit
    | Cons error rest =>
        do eprintln (prim_string_concat "CLIPPY_GRADE_INVARIANTS_FAIL " error);
           go rest
    end;

def main : IO Unit :=
    let errors : List String :=
      concat_map (Pair String Bool) String
        (fun (test : Pair String Bool) => match test with
          | MkPair label passed => match passed with
            | True => []
            | False => cg_inv_fail label "native invariant failed"
            end
          end)
        [MkPair String Bool "small-valid-registry" cg_inv_small_registry,
         MkPair String Bool "release-not-weaker" cg_inv_release_order,
         MkPair String Bool "fatal-not-suppressible" cg_inv_fatal,
         MkPair String Bool "structural-protocol-ok" cg_inv_parse_ok,
         MkPair String Bool "semantic-protocol-error" cg_inv_parse_error,
         MkPair String Bool "semantic-protocol-negative-mutations" cg_inv_protocol_negative,
         MkPair String Bool "raw-multiline-suppression-is-not-a-directive" cg_inv_raw_directive_boundary] in
    match errors with
    | Cons _ _ => do cg_inv_print errors; exit 1
    | Nil => do println "CLIPPY_GRADE_INVARIANTS: OK"; exit 0
    end
