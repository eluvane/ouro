-- Native file copy: write, copy, read the copy, then exit 0.
import "../std/io.ouro";

def copy_src : String :=
    "_build/native/native_build_copy_src.txt";

def copy_dst : String :=
    "_build/native/native_build_copy_dst.txt";

def copy_payload : String :=
    "native-copy-ok";

def copy_label (text : String) : String :=
    match prim_string_eq text copy_payload with
    | True => "copy-ok"
    | False => "copy-mismatch"
    end;

-- @entry main
def main : IO Unit :=
  do prim_fs_mkdir "_build/native";
     prim_fs_write_file copy_src copy_payload;
     prim_fs_copy_file copy_src copy_dst;
     let! back := prim_fs_read_file copy_dst;
     println (copy_label back);
     exit 0
