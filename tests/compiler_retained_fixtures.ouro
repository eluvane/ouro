-- Direct Core transcriptions of retained semantic fixtures. Global names are
-- alpha-renamed to the IDs below; explicit lambda branches keep their binders.
-- The original JSON transport-only cases remain under quality/smith/corpus/kernel.

import "../compiler/file_check_model.ouro";
import "compiler_core_test_decls.ouro";

def retained_nat : CoreTerm := CInd 10;
def retained_zero : CoreTerm := CConstruct 10 0 0;
def retained_succ : CoreTerm := CConstruct 10 1 0;
def retained_bool : CoreTerm := CInd 20;
def retained_true : CoreTerm := CConstruct 20 0 0;
def retained_nat_fn : CoreTerm := CPi retained_nat retained_nat;
def retained_nat_motive : CoreTerm := CLam retained_nat retained_nat;
def retained_nat_info : CaseInfo := MkCaseInfo 10 0 ([0, 1] : List Nat);

def retained_nat_zero_decl : IndDecl :=
    MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0 ([MkCtor 11 retained_nat] : List Ctor);

def retained_nat_decl : IndDecl :=
    MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 11 retained_nat, MkCtor 12 retained_nat_fn] : List Ctor);

def retained_nat_items (item : FileItem) : List FileItem :=
    [FInd retained_nat_decl, item];

def retained_nat_bool_items (item : FileItem) : List FileItem :=
    [FInd retained_nat_decl, FInd checker_test_bool_decl, item];

def retained_identity : FileItem :=
    FDef 90 retained_nat_fn (CLam retained_nat (CRel 0));

def retained_bool_case : FileItem :=
    FDef 90 (CPi retained_bool retained_nat)
      (CLam retained_bool
        (CCase (MkCaseInfo 20 0 ([0, 0] : List Nat))
          (CLam retained_bool retained_nat) (CRel 0)
          ([retained_zero, retained_zero] : List CoreTerm)));

-- case_branch_lambda_lift_under_binder.json. The same outer n occurs below
-- an explicit branch lambda and must shift once when the x binder is crossed.
def retained_dependent_case (outside : Nat) : CoreTerm :=
    CCase retained_nat_info (CLam retained_nat (CSort 0)) (CRel outside)
      ([ retained_nat
       , CLam retained_nat
           (CCase retained_nat_info (CLam retained_nat (CSort 0)) (CRel (S outside))
             ([retained_nat, CLam retained_nat retained_bool] : List CoreTerm))
       ] : List CoreTerm);

def retained_dependent_type : CoreTerm :=
    CPi retained_nat (CPi (retained_dependent_case 0) (retained_dependent_case 1));

def retained_dependent_body : CoreTerm :=
    CLam retained_nat (CLam (retained_dependent_case 0) (CRel 0));

def retained_dependent_items : List FileItem :=
    retained_nat_bool_items (FDef 90 retained_dependent_type retained_dependent_body);

-- nested_case_same_constructor_fields.json.
def retained_pair (first : CoreTerm) (second : CoreTerm) : CoreTerm :=
    CApp (CApp (CInd 30) first) second;

def retained_pair_value (first : CoreTerm) (second : CoreTerm)
    (left : CoreTerm) (right : CoreTerm) : CoreTerm :=
    CApp (CApp (CApp (CApp (CConstruct 30 0 2) first) second) left) right;

def retained_pair_decl : IndDecl :=
    MkIndDecl 30 ([MkParam 31 (CSort 0), MkParam 32 (CSort 0)] : List Param)
      (Nil CoreTerm) 0
      ([MkCtor 33 (CPi (CSort 0) (CPi (CSort 0)
        (CPi (CRel 1) (CPi (CRel 1) (retained_pair (CRel 3) (CRel 2))))))] : List Ctor);

def retained_nested_pair_body : CoreTerm :=
    CCase (MkCaseInfo 30 2 ([2] : List Nat))
      (CLam (retained_pair retained_nat retained_bool) retained_nat)
      (retained_pair_value retained_nat retained_bool
        (CApp retained_succ retained_zero) retained_true)
      ([CLam retained_nat (CLam retained_bool
        (CCase (MkCaseInfo 30 2 ([2] : List Nat))
          (CLam (retained_pair retained_bool retained_nat) retained_nat)
          (retained_pair_value retained_bool retained_nat (CRel 0) (CRel 1))
          ([CLam retained_bool (CLam retained_nat
            (CApp retained_succ (CRel 0)))] : List CoreTerm)))] : List CoreTerm);

def retained_nested_pair_items : List FileItem :=
    [FInd retained_nat_decl, FInd checker_test_bool_decl, FInd retained_pair_decl,
     FDef 90 retained_nat retained_nested_pair_body];

-- fix_binder_name_not_in_conversion.json. Copy preserves every successor.
def retained_copy (name : Nat) : CoreTerm :=
    CFix name 0 1 retained_nat_fn
      (CLam retained_nat
        (CCase retained_nat_info retained_nat_motive (CRel 0)
          ([ retained_zero
           , CLam retained_nat (CApp retained_succ (CApp (CRel 2) (CRel 0)))
           ] : List CoreTerm)));

def retained_copy_items : List FileItem :=
    [FInd retained_nat_decl, FDef 90 retained_nat_fn (retained_copy 50),
     FDef 91 retained_nat_fn (retained_copy 51)];

def retained_two : CoreTerm := CApp retained_succ (CApp retained_succ retained_zero);

def retained_box_decl : IndDecl :=
    MkIndDecl 40 ([MkParam 41 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 42 (CPi (CSort 0)
        (CPi (CRel 0) (CApp (CInd 40) (CRel 1))))] : List Ctor);

def retained_sequence_decl : IndDecl :=
    MkIndDecl 43 ([MkParam 44 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 45 (CPi (CSort 0)
        (CPi (CRel 0) (CPi (CApp (CInd 43) (CRel 1))
          (CApp (CInd 43) (CRel 2)))))] : List Ctor);

def retained_universe_decl (level : Nat) (argument : Nat) : IndDecl :=
    MkIndDecl 60 (Nil Param) (Nil CoreTerm) level
      ([MkCtor 61 (CPi (CSort argument) (CInd 60))] : List Ctor);

def retained_negative_decl : IndDecl :=
    MkIndDecl 60 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 61 (CPi (CPi (CInd 60) (CInd 60)) (CInd 60))] : List Ctor);

def retained_parameter_self : IndDecl :=
    MkIndDecl 60 ([MkParam 62 (CInd 60)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 61 (CPi (CInd 60) (CInd 60))] : List Ctor);

def retained_bad_return : IndDecl :=
    MkIndDecl 60 (Nil Param) (Nil CoreTerm) 0 ([MkCtor 61 (CSort 0)] : List Ctor);

def retained_bad_case_shape : CoreTerm :=
    CCase retained_nat_info retained_nat_motive retained_zero
      ([retained_zero] : List CoreTerm);

def retained_bad_coverage : CoreTerm :=
    CLam retained_bool
      (CCase (MkCaseInfo 20 0 ([0] : List Nat))
        (CLam retained_bool retained_nat) (CRel 0) ([retained_zero] : List CoreTerm));

-- smith_kernel_laws.ml: structural environments must enter fix annotations.
def retained_let_fix (annotation : CoreTerm) : CoreTerm :=
    CLetIn annotation (CSort 1)
      (CFix 50 0 1 (CRel 0) (CLam (CSort 0) (CRel 0)));

-- scripts/ourosmith/core/nested.py. An applied term is inserted in the
-- successor branch scope [predecessor, outer argument, outer function].
def retained_nested_outer (applied : CoreTerm) : CoreTerm :=
    CFix 50 0 1 retained_nat_fn
      (CLam retained_nat
        (CCase retained_nat_info retained_nat_motive (CRel 0)
          ([retained_zero, CLam retained_nat (CApp retained_succ applied)] : List CoreTerm)));

def retained_nested_walk (outer_argument : CoreTerm) : CoreTerm :=
    CFix 51 0 1 retained_nat_fn
      (CLam retained_nat
        (CCase retained_nat_info retained_nat_motive (CRel 0)
          ([ CApp (CRel 4) outer_argument
           , CLam retained_nat (CApp retained_succ (CApp (CRel 2) (CRel 0)))
           ] : List CoreTerm)));

def retained_nested_strict : CoreTerm :=
    retained_nested_outer (CApp (retained_nested_walk (CRel 0)) (CRel 0));

def retained_nested_nonzero : CoreTerm :=
    retained_nested_outer
      (CApp (CApp
        (CFix 51 1 2 (CPi retained_nat retained_nat_fn)
          (CLam retained_nat (CLam retained_nat
            (CCase retained_nat_info retained_nat_motive (CRel 0)
              ([ CApp (CRel 5) (CRel 0)
               , CLam retained_nat
                   (CApp retained_succ (CApp (CApp (CRel 3) (CRel 2)) (CRel 0)))
               ] : List CoreTerm))))) (CRel 0)) (CRel 0));

def retained_nested_eta_short : CoreTerm :=
    retained_nested_outer
      (CApp (CFix 51 0 1 retained_nat_fn
        (CLetIn (CLam retained_nat (CRel 0)) retained_nat_fn (CRel 0))) (CRel 0));

def retained_nested_unchanged : CoreTerm :=
    retained_nested_outer
      (CApp (CFix 51 0 1 retained_nat_fn
        (CLam retained_nat (CApp (CRel 4) (CRel 0)))) (CRel 1));

def retained_nested_growing : CoreTerm :=
    retained_nested_outer
      (CApp (CFix 51 0 1 retained_nat_fn
        (CLam retained_nat (CApp (CRel 1) (CRel 0)))) (CRel 0));

def retained_nested_other_parameter : CoreTerm :=
    retained_nested_outer
      (CApp (CApp
        (CFix 51 0 2 (CPi retained_nat retained_nat_fn)
          (CLam retained_nat (CLam retained_nat
            (CCase retained_nat_info retained_nat_motive (CRel 1)
              ([ CApp (CRel 5) (CRel 0)
               , CLam retained_nat
                   (CApp retained_succ (CApp (CApp (CRel 3) (CRel 0))
                     (CApp retained_succ (CApp retained_succ (CRel 5)))))
               ] : List CoreTerm))))) (CRel 0)) (CRel 0));

def retained_nested_captured : CoreTerm :=
    retained_nested_outer (CApp (retained_nested_walk (CRel 3)) (CRel 0));

def retained_nested_partial : CoreTerm :=
    retained_nested_outer
      (CLetIn (retained_nested_walk (CRel 0)) retained_nat_fn (CApp (CRel 0) (CRel 1)));

def retained_nested_argument : CoreTerm :=
    retained_nested_outer
      (CApp (CApp
        (CFix 51 0 2 (CPi retained_nat (CPi retained_nat_fn retained_nat))
          (CLam retained_nat (CLam retained_nat_fn
            (CCase retained_nat_info retained_nat_motive (CRel 1)
              ([ CApp (CRel 5) (CRel 1)
               , CLam retained_nat
                   (CApp retained_succ (CApp (CApp (CRel 3) (CRel 0)) (CRel 1)))
               ] : List CoreTerm))))) (CRel 0)) (CRel 2));
