-- Fixed x64 oracles are fixture-only and do not enter the checked MIR API.
import "../compiler/native/codegen_linux.ouro",
  "../std/string.ouro";

def sysv_fixture_word (ty : MirType) (value : Nat) : MirValue :=
    MirBits ty (X64Words64 (pe_word32 value) (pe_word32 0));

def sysv_fixture_args (count : Nat) (ty : MirType) : List MirLocal :=
    (fix build (remaining : Nat) (next : Nat) : List MirLocal :=
      match remaining with | Z => [] | S rest =>
        Cons MirLocal (MirLocalDef next ty) (build rest (S next)) end) count 0;

def sysv_fixture_values : List MirValue :=
    map Nat MirValue (sysv_fixture_word MirU64) [11,22,33,44,55,66,77,88];

def sysv_fixture_signature : MirSignature :=
    MirSignatureOf (replicate MirType MirU64 8) (Just MirType MirU32);

def sysv_fixture_body (id : Nat) (args : List MirLocal) (locals : List MirLocal)
    (result : Maybe MirType) (instructions : List MirInstruction) (term : MirTerminator) : MirFunction :=
    MirFunctionDef id [102,110] args locals result 0 [MirBlockDef 0 instructions term];

def sysv_fixture_entry : MirFunction :=
    sysv_fixture_body 1 [] [] (Just MirType MirU32) [] (MirReturn (Just MirValue (sysv_fixture_word MirU32 42)));

def sysv_fixture_leaf : MirFunction :=
    sysv_fixture_body 3 (sysv_fixture_args 6 MirU64) [] (Just MirType MirU64) []
      (MirReturn (Just MirValue (sysv_fixture_word MirU64 99)));

def sysv_fixture_weighted : MirFunction :=
    sysv_fixture_body 2 (sysv_fixture_args 8 MirU64)
      [MirLocalDef 10 MirU64,MirLocalDef 11 MirU64,MirLocalDef 12 MirU64] (Just MirType MirU64)
      (append MirInstruction
        [MirCall(MirNoGc, Just Nat 12, MirDirect 3, replicate MirValue (sysv_fixture_word MirU64 0) 6),
         MirMove(10, MirUse 0)]
        (concat_map Nat MirInstruction (fun (index : Nat) =>
          [MirBinaryOp(11, MirMul, MirUse index, sysv_fixture_word MirU64 (S index)),
           MirBinaryOp(10, MirAdd, MirUse 10, MirUse 11)]) [1,2,3,4,5,6,7]))
      (MirReturn (Just MirValue (MirUse 10)));

def sysv_fixture_narrow : MirFunction :=
    sysv_fixture_body 2 [MirLocalDef 0 MirU8,MirLocalDef 1 MirU32,MirLocalDef 2 MirI32]
      [MirLocalDef 3 MirU64,MirLocalDef 4 MirU64,MirLocalDef 5 MirU64,MirLocalDef 6 MirU64]
      (Just MirType MirU64)
      [MirConvert 3 MirZeroExtend (MirUse 0), MirConvert 4 MirZeroExtend (MirUse 1),
       MirConvert 5 MirSignExtend (MirUse 2), MirBinaryOp(6, MirAdd, MirUse 3, MirUse 4),
       MirBinaryOp(6, MirAdd, MirUse 6, MirUse 5)]
      (MirReturn (Just MirValue (MirUse 6)));

def sysv_fixture_caller (indirect : Bool) : MirFunction :=
    MirFunctionDef 1 [102,110] []
      [MirLocalDef 0 MirRawPtr,MirLocalDef 1 MirU32,MirLocalDef 2 MirU64,MirLocalDef 3 MirU8]
      (Just MirType MirU32) 0
      [MirBlockDef 0
        [MirAddress 0 2, MirCall(MirMayGc, Just Nat 1,
          match indirect with | True => MirIndirect sysv_fixture_signature (MirUse 0) | False => MirDirect 2 end,
          sysv_fixture_values),MirConvert 2 MirZeroExtend (MirUse 1),
         MirCompare(3, MirEqual, MirUse 2, sysv_fixture_word MirU64 42)] (MirBranch (MirUse 3) 1 2),
       MirBlockDef 1 [] (MirReturn (Just MirValue (sysv_fixture_word MirU32 42))),
       MirBlockDef 2 [] (MirReturn (Just MirValue (sysv_fixture_word MirU32 99)))];

def sysv_fixture_callee_contract : MirFunction :=
    sysv_fixture_body 2 (sysv_fixture_args 8 MirU64) [] (Just MirType MirU32) []
      (MirReturn (Just MirValue (sysv_fixture_word MirU32 42)));

def sysv_fixture_program (functions : List MirFunction) : MirProgram :=
    MirProgramDef functions [] [] 1;

def sysv_fixture_mir_entry : MirFunction :=
    MirFunctionDef 1 [109,97,105,110] []
      [MirLocalDef 0 MirRawPtr,MirLocalDef 1 MirU64,MirLocalDef 2 MirU64,
       MirLocalDef 3 MirU8,MirLocalDef 4 MirU64] (Just MirType MirU32) 0
      [MirBlockDef 0
        [MirMove(4, sysv_fixture_word MirU64 123),MirAddress 0 2,
         MirCall(MirNoGc, Just Nat 1, MirDirect 2, sysv_fixture_values),
         MirCompare(3, MirEqual, MirUse 1, sysv_fixture_word MirU64 2244)] (MirBranch (MirUse 3) 1 3),
       MirBlockDef 1
        [MirCall(MirMayGc, Just Nat 2,
           MirIndirect (MirSignatureOf (replicate MirType MirU64 8) (Just MirType MirU64)) (MirUse 0),
           sysv_fixture_values),
         MirCompare(3, MirEqual, MirUse 2, sysv_fixture_word MirU64 2244)] (MirBranch (MirUse 3) 2 3),
       MirBlockDef 2 [MirCompare(3, MirEqual, MirUse 4, sysv_fixture_word MirU64 123)] (MirBranch (MirUse 3) 4 3),
       MirBlockDef 3 [] (MirReturn (Just MirValue (sysv_fixture_word MirU32 99))),
       MirBlockDef 4 [] (MirReturn (Just MirValue (sysv_fixture_word MirU32 42)))];

def sysv_fixture_mir_program : MirProgram :=
    sysv_fixture_program [sysv_fixture_mir_entry,sysv_fixture_weighted,sysv_fixture_leaf];

def sysv_fixture_assemble (atoms : List CodegenAtom) (base : Nat) : Either LinuxCodegenError CodegenEncoded :=
    linux_from_native CodegenEncoded (codegen_assemble atoms base 0);

def sysv_fixture_pack
    : List (Pair Nat (Nat -> Either LinuxCodegenError CodegenEncoded)) -> Nat -> Either LinuxCodegenError LinuxText :=
  fix pack (parts : List (Pair Nat (Nat -> Either LinuxCodegenError CodegenEncoded))) (base : Nat)
    : Either LinuxCodegenError LinuxText :=
    match parts with
    | Nil => Right LinuxCodegenError LinuxText (LinuxTextParts [] [] [])
    | Cons part rest => match part with | MkPair id encode =>
      match encode base with | Left error => Left LinuxCodegenError LinuxText error
      | Right encoded => match encoded with | CodegenEncodedParts bytes fixups _ =>
        let? (Left, Right) : Either LinuxCodegenError LinuxText do
          let following : LinuxText := pack rest (add base (length Nat bytes))?;
          match following with | LinuxTextParts more symbols more_fixups =>
            LinuxTextParts (append Nat bytes more) (Cons PeSymbol (PeNamedSymbol id PeText base) symbols)
              (append PeFixup fixups more_fixups) end
        end end end end end;

-- MIR/signatures are checked first; only this fixture substitutes fixed raw
-- oracle bodies. linux_codegen_program has no substitution callback.
def sysv_fixture_oracle_image (program : MirProgram)
    (parts : List (Pair Nat (Nat -> Either LinuxCodegenError CodegenEncoded))) : Either LinuxCodegenError (List Nat) :=
    let? (Left, Right) : Either LinuxCodegenError (List Nat) do
      let _checked : MirCheckedProgram := mapLeft MirError MirCheckedProgram LinuxCodegenError
        LinuxMirRejected (mir_validate mir_default_limits program)?;
      let _slice : Unit := linux_check_slice program?;
      let start : CodegenEncoded := linux_start 1?;
      let base : Nat := match start with | CodegenEncodedParts bytes _ _ => length Nat bytes end;
      let text : LinuxText := sysv_fixture_pack parts base?;
      linux_finish_image start text?
    end;

def sysv_fixture_expect_reg (reg : X64Register) (expected : Nat) : List CodegenAtom :=
    [CodegenInstruction (X64ArithmeticImm32 X64Bits64 X64Compare reg (pe_word32 expected)),
     CodegenJumpIf X64NotEqual (CodegenBlockLabel 99)];

def sysv_fixture_fixed_callee : List CodegenAtom :=
    codegen_join
      [codegen_raw [X64Mov X64Bits64 X64Rax X64Rsp,
        X64ArithmeticImm32 X64Bits32 X64And X64Rax (pe_word32 15)],
       sysv_fixture_expect_reg X64Rax 8,
       sysv_fixture_expect_reg X64Rdi 11,sysv_fixture_expect_reg X64Rsi 22,
       sysv_fixture_expect_reg X64Rdx 33,sysv_fixture_expect_reg X64Rcx 44,
       sysv_fixture_expect_reg X64R8 55,sysv_fixture_expect_reg X64R9 66,
       codegen_raw [X64Load X64Bits64 X64Rax (X64Base X64Rsp (codegen_disp 8))],
       sysv_fixture_expect_reg X64Rax 77,
       codegen_raw [X64Load X64Bits64 X64Rax (X64Base X64Rsp (codegen_disp 16))],
       sysv_fixture_expect_reg X64Rax 88,
       codegen_raw [X64MovImm32(X64Rdi, pe_word32 0),X64MovImm32(X64Rsi, pe_word32 0),
         X64MovImm32(X64Rdx, pe_word32 0),X64MovImm32(X64Rcx, pe_word32 0),
         X64MovImm32(X64R8, pe_word32 0),X64MovImm32(X64R9, pe_word32 0),
         X64MovImm32(X64R10, pe_word32 0),X64MovImm32(X64R11, pe_word32 0),
          X64MovImm64(X64Rax, X64Words64 (pe_word32 42) (X64Bytes32 1 2 3 4)),X64Return],
       [CodegenMark (CodegenBlockLabel 99)],
       codegen_raw [X64MovImm32(X64Rax, pe_word32 99),X64Return]];

def sysv_fixture_caller_image (indirect : Bool) : Either LinuxCodegenError (List Nat) :=
    let caller : MirFunction := sysv_fixture_caller indirect in
    let program : MirProgram := sysv_fixture_program [caller,sysv_fixture_callee_contract] in
    sysv_fixture_oracle_image program
      [MkPair Nat (Nat -> Either LinuxCodegenError CodegenEncoded) 1 (linux_encode_function program caller),
       MkPair Nat (Nat -> Either LinuxCodegenError CodegenEncoded) 2 (sysv_fixture_assemble sysv_fixture_fixed_callee)];

def sysv_fixture_stack_args : List X64Instruction :=
    [X64MovImm32(X64Rax, pe_word32 77),X64Store X64Bits64 (X64Base X64Rsp (codegen_disp 0)) X64Rax,
     X64MovImm32(X64Rax, pe_word32 88),X64Store X64Bits64 (X64Base X64Rsp (codegen_disp 8)) X64Rax,
     X64MovImm32(X64Rdi, pe_word32 11),X64MovImm32(X64Rsi, pe_word32 22),
     X64MovImm32(X64Rdx, pe_word32 33),X64MovImm32(X64Rcx, pe_word32 44),
     X64MovImm32(X64R8, pe_word32 55),X64MovImm32(X64R9, pe_word32 66)];

def sysv_fixture_dirty_args : List X64Instruction :=
    [X64MovImm64(X64Rdi, X64Words64 (X64Bytes32 42 171 205 239) (X64Bytes32 239 190 173 222)),
     X64MovImm64(X64Rsi, X64Words64 (pe_word32 7) (X64Bytes32 1 2 3 4)),
     X64MovImm64(X64Rdx, X64Words64 (X64Bytes32 255 255 255 255) (X64Bytes32 1 2 3 4))];

def sysv_fixture_fixed_caller (arguments : List X64Instruction) (expected : Nat) : List CodegenAtom :=
    codegen_join
      [codegen_raw [X64Push X64Rbx,X64Push X64Rbp,X64Push X64R12,
         X64Push X64R13,X64Push X64R14,X64Push X64R15,
         X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (pe_word32 40),
         X64Store X64Bits64 (X64Base X64Rsp (codegen_disp 24)) X64Rsp,
         X64MovImm32(X64Rax, pe_word32 12345),
         X64Store X64Bits64 (X64Base X64Rsp (codegen_disp 16)) X64Rax,
         X64MovImm32(X64Rbx, pe_word32 11),X64MovImm32(X64Rbp, pe_word32 22),
         X64MovImm32(X64R12, pe_word32 33),X64MovImm32(X64R13, pe_word32 44),
         X64MovImm32(X64R14, pe_word32 55),X64MovImm32(X64R15, pe_word32 66)],
       codegen_raw arguments,[CodegenDirectCall 2],sysv_fixture_expect_reg X64Rax expected,
       sysv_fixture_expect_reg X64Rbx 11,sysv_fixture_expect_reg X64Rbp 22,
       sysv_fixture_expect_reg X64R12 33,sysv_fixture_expect_reg X64R13 44,
       sysv_fixture_expect_reg X64R14 55,sysv_fixture_expect_reg X64R15 66,
       codegen_raw [X64Load X64Bits64 X64R10 (X64Base X64Rsp (codegen_disp 24)),
         X64ArithmeticReg X64Bits64 X64Compare X64Rsp X64R10],
       [CodegenJumpIf X64NotEqual (CodegenBlockLabel 99)],
       codegen_raw [X64Load X64Bits64 X64Rax (X64Base X64Rsp (codegen_disp 16))],
       sysv_fixture_expect_reg X64Rax 12345,
       codegen_raw [X64ArithmeticImm32 X64Bits64 X64Add X64Rsp (pe_word32 40),
         X64Pop X64R15,X64Pop X64R14,X64Pop X64R13,
         X64Pop X64R12,X64Pop X64Rbp,X64Pop X64Rbx,
         X64MovImm32(X64Rax, pe_word32 42),X64Return],
       [CodegenMark (CodegenBlockLabel 99)],
       codegen_raw [X64ArithmeticImm32 X64Bits64 X64Add X64Rsp (pe_word32 40),
         X64Pop X64R15,X64Pop X64R14,X64Pop X64R13,
         X64Pop X64R12,X64Pop X64Rbp,X64Pop X64Rbx,
         X64MovImm32(X64Rax, pe_word32 99),X64Return]];

def sysv_fixture_callee_image (narrow : Bool) : Either LinuxCodegenError (List Nat) :=
    let callee : MirFunction := match narrow with | True => sysv_fixture_narrow | False => sysv_fixture_weighted end in
    let functions : List MirFunction := match narrow with
      | True => [sysv_fixture_entry,callee] | False => [sysv_fixture_entry,callee,sysv_fixture_leaf] end in
    let program : MirProgram := sysv_fixture_program functions in
    let caller : List CodegenAtom := sysv_fixture_fixed_caller
      (match narrow with | True => sysv_fixture_dirty_args | False => sysv_fixture_stack_args end)
      (match narrow with | True => 48 | False => 2244 end) in
    let parts : List (Pair Nat (Nat -> Either LinuxCodegenError CodegenEncoded)) :=
      [MkPair Nat (Nat -> Either LinuxCodegenError CodegenEncoded) 1 (sysv_fixture_assemble caller),
       MkPair Nat (Nat -> Either LinuxCodegenError CodegenEncoded) 2 (linux_encode_function program callee)] in
    sysv_fixture_oracle_image program (match narrow with | True => parts
      | False => append (Pair Nat (Nat -> Either LinuxCodegenError CodegenEncoded)) parts
          [MkPair Nat (Nat -> Either LinuxCodegenError CodegenEncoded) 3 (linux_encode_function program sysv_fixture_leaf)] end);

def sysv_fixture_named (name : String) : Maybe (Either LinuxCodegenError (List Nat)) :=
    match str_eq name "mir-calls" with
    | True => Just (Either LinuxCodegenError (List Nat)) (linux_codegen_program mir_default_limits sysv_fixture_mir_program)
    | False => match str_eq name "caller8" with
      | True => Just (Either LinuxCodegenError (List Nat)) (sysv_fixture_caller_image False)
      | False => match str_eq name "indirect8" with
        | True => Just (Either LinuxCodegenError (List Nat)) (sysv_fixture_caller_image True)
        | False => match str_eq name "callee8" with
          | True => Just (Either LinuxCodegenError (List Nat)) (sysv_fixture_callee_image False)
          | False => match str_eq name "narrow3" with
            | True => Just (Either LinuxCodegenError (List Nat)) (sysv_fixture_callee_image True)
            | False => Nothing (Either LinuxCodegenError (List Nat)) end end end end end;
