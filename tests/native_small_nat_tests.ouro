-- Recognition laws use compiler-checked source and closed, rechecked Core.
import "native_small_nat_fixtures.ouro",
  "../compiler/native/managed_nat_small_shapes.ouro",
  "../compiler/driver.ouro",
  "../std/io.ouro",
  "compiler_program_lookup.ouro",
  "native_nat_test_support.ouro";

-- Runtime helper ids are unused by the recognizer. The checked environment
-- is the source program's environment, exactly as in managed source lowering.
def small_nat_test_compiler (program : CheckedProgram) : ManagedCompiler :=
    ManagedCompilerOf program ([] : List Nat) 0 0 0 0 0 0 ([] : List LowerContract)
      (check_environment_from_entries (checked_program_entries program));

def small_nat_test_fuel : Nat := mul 100 160;

def assert_true (name : String) (passed : Bool) : Pair String Bool := MkPair String Bool name passed;

def small_nat_operation_code (result : Either NativeLowerError (Maybe ManagedNatSmallOperation)) : Nat :=
    match result with
    | Left _ => 5
    | Right operation => match operation with
        | Nothing => 0
        | Just selected => match selected with
            | ManagedNatSmallMultiply => 1 | ManagedNatSmallDivide => 2 | ManagedNatSmallRemainder => 3 end end end;

def small_nat_source_case (source : String) (expectations : List (Pair String Nat)) : Bool :=
    match compile_checked_source(small_nat_test_fuel, prim_string_to_char_codes source) with
    | CErr _ => False
    | COk program => all (Pair String Nat) (fun (expectation : Pair String Nat) => match expectation with
        | MkPair name expected => nat_test_with_body small_nat_test_fuel program name (fun (id : Nat) (annotation : CoreTerm) (body : CoreTerm) =>
            eqNat expected (small_nat_operation_code
              (managed_small_nat_recognize (small_nat_test_compiler program) small_nat_test_fuel id annotation body))) end) expectations end;

-- Change only fixpoint metadata, including the local div/mod loops.
def small_nat_change_fix : Nat -> Nat -> CoreTerm -> CoreTerm :=
  fix change (fuel : Nat) (mode : Nat) (body : CoreTerm) : CoreTerm :=
    match fuel with | Z => body | S next => match body with
    | CFix name argument arity typ inner =>
        match eqNat mode 0 with
        | True => CFix name (S argument) arity typ inner
        | False => match eqNat mode 1 with
            | True => CFix name argument (S arity) typ inner
            | False => CFix (S name) argument arity typ inner end end
    | CLam domain inner => CLam(domain, change next mode inner)
    | CApp head argument => CApp(change next mode head, change next mode argument)
    | CCase info motive condition branches => CCase info motive condition
        (map CoreTerm CoreTerm (fun (branch : CoreTerm) => change next mode branch) branches)
    | CLetIn value typ inner => CLetIn(change next mode value, typ, change next mode inner)
    | CRel _ => body | CConst _ => body | CInd _ => body | CConstruct _ _ _ => body
    | CSort _ => body | CPi _ _ => body | CStrLit _ _ => body | CStrBytes _ _ => body end end;

def small_nat_fix_case (name : String) (mode : Nat) (expected : Nat) : Bool :=
    match compile_checked_source(small_nat_test_fuel, prim_string_to_char_codes small_nat_fixture_canonical) with
    | CErr _ => False
    | COk program => nat_test_with_body small_nat_test_fuel program name (fun (id : Nat) (annotation : CoreTerm) (body : CoreTerm) =>
        eqNat expected (small_nat_operation_code (managed_small_nat_recognize (small_nat_test_compiler program)
          small_nat_test_fuel id annotation (small_nat_change_fix 200 mode body)))) end;

def small_nat_annotation_rejected : Bool :=
    match compile_checked_source(small_nat_test_fuel, prim_string_to_char_codes small_nat_fixture_canonical) with
    | CErr _ => False
    | COk program => nat_test_with_body small_nat_test_fuel program "mul" (fun (id : Nat) (_ : CoreTerm) (body : CoreTerm) =>
        eqNat 0 (small_nat_operation_code (managed_small_nat_recognize (small_nat_test_compiler program)
          small_nat_test_fuel id (CSort 0) body))) end;

def small_nat_fuel_rejected : Bool :=
    match compile_checked_source(small_nat_test_fuel, prim_string_to_char_codes small_nat_fixture_canonical) with
    | CErr _ => False
    | COk program => nat_test_with_body small_nat_test_fuel program "mul" (fun (id : Nat) (annotation : CoreTerm) (body : CoreTerm) =>
        match managed_small_nat_recognize (small_nat_test_compiler program) 0 id annotation body with
        | Right _ => False | Left error => match error with
            | LowerResourceExhausted => True | LowerDeclarationFailure _ _ _ => False
            | LowerMetadataMismatch _ => False | LowerBodyMismatch _ => False | LowerUnsupportedType _ => False
            | LowerUnsupportedTerm _ => False | LowerUnsupportedPrimitive _ => False | LowerUnknownGlobal _ => False
            | LowerUnboundLocal _ => False | LowerInvalidCall _ => False | LowerEffectMismatch => False
            | LowerInvalidEntry _ => False | LowerMirFailure _ => False | LowerBackendFailure _ => False end end) end;

def main : IO Unit := nat_test_run
    [assert_true "small Nat checked source canonical"
       (small_nat_source_case small_nat_fixture_canonical [MkPair String Nat "mul" 1, MkPair String Nat "div_nat" 2, MkPair String Nat "mod_nat" 3]),
     assert_true "small Nat checked source renamed"
       (small_nat_source_case small_nat_fixture_renamed [MkPair String Nat "product" 1, MkPair String Nat "quotient" 2, MkPair String Nat "residue" 3]),
     assert_true "small Nat checked source changed_mul"
       (small_nat_source_case small_nat_fixture_changed_mul [MkPair String Nat "mul" 0]),
     assert_true "small Nat checked source changed_add"
       (small_nat_source_case small_nat_fixture_changed_add [MkPair String Nat "mul" 0]),
     assert_true "small Nat checked source changed_sub"
       (small_nat_source_case small_nat_fixture_changed_sub [MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source changed_ltb"
       (small_nat_source_case small_nat_fixture_changed_ltb [MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source changed_compare"
       (small_nat_source_case small_nat_fixture_changed_compare [MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source changed_div_zero"
       (small_nat_source_case small_nat_fixture_changed_div_zero [MkPair String Nat "div_nat" 0]),
     assert_true "small Nat checked source changed_mod_zero"
       (small_nat_source_case small_nat_fixture_changed_mod_zero [MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source changed_div_fuel"
       (small_nat_source_case small_nat_fixture_changed_div_fuel [MkPair String Nat "div_nat" 0]),
     assert_true "small Nat checked source changed_mod_fuel"
       (small_nat_source_case small_nat_fixture_changed_mod_fuel [MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source axiom_add"
       (small_nat_source_case small_nat_fixture_axiom_add [MkPair String Nat "mul" 0]),
     assert_true "small Nat checked source axiom_sub"
       (small_nat_source_case small_nat_fixture_axiom_sub [MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source axiom_ltb"
       (small_nat_source_case small_nat_fixture_axiom_ltb [MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source axiom_compare"
       (small_nat_source_case small_nat_fixture_axiom_compare [MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source missing_nat_role"
       (small_nat_source_case small_nat_fixture_missing_nat_role [MkPair String Nat "mul" 0, MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source missing_bool_role"
       (small_nat_source_case small_nat_fixture_missing_bool_role [MkPair String Nat "mul" 1, MkPair String Nat "div_nat" 0, MkPair String Nat "mod_nat" 0]),
     assert_true "small Nat checked source unrecognized_dependency_alias"
       (small_nat_source_case small_nat_fixture_unrecognized_dependency_alias [MkPair String Nat "mul" 0]),
     assert_true "small Nat checked source unrelated_mutant"
       (small_nat_source_case small_nat_fixture_unrelated_mutant [MkPair String Nat "mul" 1, MkPair String Nat "div_nat" 2, MkPair String Nat "mod_nat" 3]),
     assert_true "mul recursive argument mismatch"
       (small_nat_fix_case "mul" 0 0),
     assert_true "mul arity mismatch"
       (small_nat_fix_case "mul" 1 0),
     assert_true "mul display name ignored"
       (small_nat_fix_case "mul" 2 1),
     assert_true "div_nat recursive argument mismatch"
       (small_nat_fix_case "div_nat" 0 0),
     assert_true "div_nat arity mismatch"
       (small_nat_fix_case "div_nat" 1 0),
     assert_true "div_nat display name ignored"
       (small_nat_fix_case "div_nat" 2 2),
     assert_true "mod_nat recursive argument mismatch"
       (small_nat_fix_case "mod_nat" 0 0),
     assert_true "mod_nat arity mismatch"
       (small_nat_fix_case "mod_nat" 1 0),
     assert_true "mod_nat display name ignored"
       (small_nat_fix_case "mod_nat" 2 3),
     assert_true "root annotation mismatch" small_nat_annotation_rejected,
     assert_true "exact comparison exhaustion propagates" small_nat_fuel_rejected];
