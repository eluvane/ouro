-- Boundary inputs and expected decimals come from the independent civil-date reference.
-- See the pinned native-time-tests/reference.json receipt and preparation command.
import "../compiler/native/managed_time.ouro";

inductive NativeTimeCase : Type :=
  | NativeTimeCaseOf : MirValue -> List Nat -> NativeTimeCase;

def native_time_cases : List NativeTimeCase :=
    [
      -- before_1ms_1tick
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 239 88 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "-2"),
      -- before_1ms
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 240 88 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "-1"),
      -- before_1ms_minus_tick
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 241 88 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "-1"),
      -- before_1tick
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 255 127 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "-1"),
      -- epoch
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 0 128 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "0"),
      -- after_1tick
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 1 128 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "0"),
      -- after_1ms_minus_tick
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 15 167 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "0"),
      -- after_1ms
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 16 167 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "1"),
      -- after_1ms_1tick
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 17 167 62 213) (X64Bytes32 222 177 157 1)))
        (prim_string_to_char_codes "1"),
      -- epoch_1601
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 0 0 0 0) (X64Bytes32 0 0 0 0)))
        (prim_string_to_char_codes "-11644473600000"),
      -- epoch_1601_1tick
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 1 0 0 0) (X64Bytes32 0 0 0 0)))
        (prim_string_to_char_codes "-11644473600000"),
      -- high_signed_boundary_before
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 255 255 255 255) (X64Bytes32 255 255 255 127)))
        (prim_string_to_char_codes "910692730085477"),
      -- high_signed_boundary
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 0 0 0 0) (X64Bytes32 0 0 0 128)))
        (prim_string_to_char_codes "910692730085477"),
      -- maximum_u64
      NativeTimeCaseOf (MirBits MirUSize (X64Words64 (X64Bytes32 255 255 255 255) (X64Bytes32 255 255 255 255)))
        (prim_string_to_char_codes "1833029933770955")
    ];

def native_time_case (selected : Nat) : Either NativeLowerError NativeTimeCase :=
    match drop NativeTimeCase selected native_time_cases with
    | Nil => Left NativeLowerError NativeTimeCase (LowerInvalidCall selected)
    | Cons value _ => Right NativeLowerError NativeTimeCase value end;
