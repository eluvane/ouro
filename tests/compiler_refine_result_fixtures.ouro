-- Shared inputs and failure-family assertions for typed refiner regressions.

import "../compiler/file_refine.ouro";
import "../std/io.ouro";
import "compiler_core_test_decls.ouro";

inductive RefineResultLaw : Type :=
  | MkRefineResultLaw : String -> Bool -> RefineResultLaw;

def refine_result_kind (A : Type) (result : CheckResult A) : Nat :=
    match result with
    | CheckOk _ => 0
    | CheckErr failure =>
        match failure with
        | CheckResourceLimit => 1
        | CheckTypeFailure _ => 2
        | CheckMalformedCore _ => 3
        | CheckReductionFailure _ => 4
        | CheckUnsupported _ => 5
        | CheckCancelled => 6
        | CheckInternalFailure _ => 7
        | CheckPrimitiveFailure _ => 8
        end
    end;

def refine_result_has_kind (A : Type) (kind : Nat) (result : CheckResult A) : Bool :=
    eqNat kind (refine_result_kind A result);

def refine_result_matches (expected : CoreTerm) (result : CheckResult CoreTerm) : Bool :=
    match result with
    | CheckOk term => eqTerm 100 expected term
    | CheckErr _ => False
    end;

def refine_result_index (expected : Nat) (result : CheckResult (Maybe Nat)) : Bool :=
    match result with
    | CheckErr _ => False
    | CheckOk found =>
        match found with
        | Nothing => False
        | Just index => eqNat expected index
        end
    end;

def refine_result_copy (ctx : RefineScope) (expected : Maybe CoreTerm) (term : CoreTerm)
    : CheckResult CoreTerm := CheckOk CoreTerm term;

def refine_result_resource (ctx : RefineScope) (expected : Maybe CoreTerm) (term : CoreTerm)
    : CheckResult CoreTerm := CheckErr CoreTerm CheckResourceLimit;

def refine_result_later_resource (ctx : RefineScope) (expected : Maybe CoreTerm)
    (term : CoreTerm) : CheckResult CoreTerm :=
    match eqTerm 100 term (CConst 901) with
    | True => CheckErr CoreTerm CheckResourceLimit
    | False => CheckOk CoreTerm term
    end;

def refine_result_nat : CoreTerm := CInd 10;
def refine_result_zero : CoreTerm := CConstruct 10 0 0;
def refine_result_function : CoreTerm := CPi refine_result_nat refine_result_nat;
def refine_result_bad_type : CoreTerm := CApp (CSort 0) (CSort 0);
def refine_result_deep : CoreTerm := CPi (CSort 0) (CPi (CSort 0) (CSort 0));
def refine_result_no_sig : List Entry := Nil Entry;
def refine_result_no_ctx : List CoreTerm := Nil CoreTerm;

def refine_result_no_scope : RefineScope := refine_scope_from_context refine_result_no_ctx;

def refine_result_ctors : List Ctor :=
    [ MkCtor 11 refine_result_nat
    , MkCtor 12 refine_result_function
    ];

def refine_result_decl : IndDecl :=
    MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0 refine_result_ctors;

def refine_result_sig : List Entry := [MkIndEntry 10 refine_result_decl];

def refine_result_alias_sig : List Entry :=
    [MkEntry 100 (CSort 1) (Just CoreTerm refine_result_function)];

def refine_result_bad_sig : List Entry :=
    [ MkEntry 90 refine_result_bad_type (Nothing CoreTerm)
    , MkIndEntry 10 refine_result_decl
    ];

-- Internal refinement helpers share a derived lookup environment. Raw
-- wrapper tests retain the ordered List Entry inputs.
def refine_result_no_environment : CheckEnvironment := check_environment_from_entries refine_result_no_sig;
def refine_result_environment : CheckEnvironment := check_environment_from_entries refine_result_sig;
def refine_result_alias_environment : CheckEnvironment := check_environment_from_entries refine_result_alias_sig;
def refine_result_bad_environment : CheckEnvironment := check_environment_from_entries refine_result_bad_sig;

def refine_result_info : CaseInfo := MkCaseInfo 10 0 ([0, 1] : List Nat);
def refine_result_bodies : List CoreTerm :=
    [refine_result_zero, CLam (CInd 0) (CRel 0)];
def refine_result_case : CoreTerm :=
    CCase refine_result_info (CInd 999) refine_result_zero refine_result_bodies;

-- Candidate refinement still relies on the strict checker for acceptance.
def refine_result_check (expected : CoreTerm) (term : CoreTerm) : CheckResult Unit :=
    check_bind CoreTerm Unit
      (refine_term_checked 200 refine_result_sig refine_result_no_ctx (Just CoreTerm expected) term)
      (fun (refined : CoreTerm) =>
        check_term_checked 200 refine_result_sig refine_result_no_ctx refined expected);

def refine_result_run (input : List RefineResultLaw) : IO Unit :=
    (fix run (laws : List RefineResultLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil => match failed with | True => exit 1 | False => exit 0 end
      | Cons law rest =>
          match law with
          | MkRefineResultLaw name passed =>
              do println (prim_string_concat
                   (match passed with | True => "ok " | False => "FAIL " end) name);
                 run rest (orb failed (notb passed))
          end
      end) input False;
