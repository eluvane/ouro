-- Opaque native declarations still participate in lint scope checks. Keep
-- this cone separate from desugar_match, which has a different binderIds API.

import "../tools/lint_host.ouro",
  "analyze/precision/assertions.ouro";

def native_lint_unbound : List Warning -> List Nat -> Bool :=
  fix native_lint_unbound (warnings : List Warning) (expected : List Nat) : Bool :=
    match warnings with
    | Nil => nullb Nat expected
    | Cons warning rest =>
        match expected with
        | Nil => False
        | Cons name tail =>
            if let WUnbound found := warning then
              andb(eqNat found name, native_lint_unbound rest tail)
            else False
        end
    end;

def native_lint_has_hole : List Warning -> Bool :=
  fix has_hole (warnings : List Warning) : Bool :=
    match warnings with
    | Nil => False
    | Cons warning rest =>
        if let WHole _ := warning then True else has_hole rest
    end;

def native_fallible_question : Expr := EHole (Just Nat Z);

def native_fallible_body : Expr :=
  ESpan(1, 20,
    ELet(7, Nothing Expr,
      ESpan(2, 6, EApp(EVar 4, native_fallible_question)),
      ELet(8, Nothing Expr,
        EApp(EVar 7, native_fallible_question),
        ESpan(13, 20, EApp(EVar 8, native_fallible_question)))));

def native_lint_scope : Scope := MkScope [] [] True;

def native_fallible_lint (body : Expr) : List Warning :=
  lint_one native_lint_scope [1, 2, 3, 4]
    (EFallible (EVar 1) 2 3 body);

def native_import_paths_eq (source : String) (want : List String) : Bool :=
    match harvest_imports source with
    | Left _ => False
    | Right paths => precision_strings paths want
    end;

def native_import_rejected (source : String) : Bool :=
    match scan_source_imports source with
    | Left error => match error with
      | ImportScanFailure _ => True
      end
    | Right _ => False
    end;

def native_import_offsets : Bool :=
    let source : String :=
      "-- leading\nimport\n  \"a.ouro\", -- gap\n  \"β.ouro\",;\n" in
    match scan_source_imports source with
    | Left _ => False
    | Right rows => match rows with
      | Cons first rest => match first with
        | MkScannedImport path alias declaration quote _ _ =>
            match rest with
            | Cons second tail => match second with
              | MkScannedImport path2 alias2 declaration2 quote2 _ _ =>
                  andb(precision_strings [path, path2] ["a.ouro", "β.ouro"],
                    andb(eq_nat declaration 11,
                      andb(eq_nat declaration2 declaration,
                        andb(match alias with
                          | Nothing => True | Just _ => False end,
                          andb(match alias2 with
                            | Nothing => True | Just _ => False end,
                            andb(match import_scan_place source quote with
                              | MkPair line column =>
                                  andb(eq_nat line 3, eq_nat column 3)
                              end,
                              andb(match import_scan_place source quote2 with
                                | MkPair line column =>
                                    andb(eq_nat line 4, eq_nat column 3)
                                end, nullb ScannedImport tail)))))))
              end
            | Nil => False
            end
        end
      | Nil => False
      end
    end;

def native_import_alias : Bool :=
    match scan_source_imports "import \"a.ouro\" as A; import \"b.ouro\";" with
    | Left _ => False
    | Right rows => match rows with
      | Cons first rest => match first with
        | MkScannedImport path alias _ _ _ alias_at =>
            andb(prim_string_eq path "a.ouro",
              andb(match alias with
                | Just name => prim_string_eq name "A"
                | Nothing => False end,
                andb(match alias_at with
                  | Just at => eq_nat at 19
                  | Nothing => False end,
                  match rest with
                  | Cons second tail => match second with
                    | MkScannedImport path2 alias2 _ _ _ _ =>
                        andb(prim_string_eq path2 "b.ouro",
                          andb(match alias2 with
                            | Nothing => True | Just _ => False end,
                            nullb ScannedImport tail))
                    end
                  | Nil => False
                  end)))
        end
      | Nil => False
      end
    end;

def native_lint_qualified_collision : Bool :=
    let source : String :=
      "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.Shared; def right : Type := B.Shared;" in
    match prep_codes (ncodes source) with
    | LintPrepErr _ => False
    | LintPrepOk codes =>
        let lines : List String := lint_lines "main.ouro" source
          ["A@Shared", "B@Shared"] [] codes in
        let short_only : List String := lint_lines "main.ouro" source
          ["Shared"] [] codes in
        andb(all String (fun (line : String) =>
            notb (orb (prim_string_contains line "lex-malformed")
              (orb (prim_string_contains line "parse-fail")
                (prim_string_contains line "OURO-LINT002")))) lines,
          any String (fun (line : String) =>
            prim_string_contains line "OURO-LINT002") short_only)
    end;

def native_lint_scoped_open : Bool :=
    let source : String :=
      "import \"a.ouro\" as A; def selected : Type := open A in Shared; def bad : Type := Missing;" in
    match prep_codes (ncodes source) with
    | LintPrepErr _ => False
    | LintPrepOk codes =>
        let lines : List String := lint_lines "main.ouro" source
          ["Shared"] [] codes in
        andb (all String (fun (line : String) =>
            notb (orb (prim_string_contains line "parse-fail")
              (prim_string_contains line "lex-malformed"))) lines,
          andb (notb (any String (fun (line : String) =>
              andb (prim_string_contains line "OURO-LINT002")
                (prim_string_contains line "Shared")) lines),
            any String (fun (line : String) =>
              andb (prim_string_contains line "OURO-LINT002")
                (prim_string_contains line "Missing")) lines))
    end;

def native_lint_record_owner_marker : Bool :=
    let source : String :=
      "inductive Nat : Type := | Z : Nat; record Point : Type where x : Nat; end; def point : Point := MkPoint Z; def explicit : Nat := Point_x point; def get : Nat := point.x;" in
    let bad_source : String :=
      "inductive Nat : Type := | Z : Nat; record Point : Type where x : Nat; end; def point : Point := MkPoint Z; def get : Nat := point.x; def bad : Nat := Missing;" in
    match prep_codes (ncodes source) with
    | LintPrepErr _ => False
    | LintPrepOk codes =>
        let clean : List String :=
          lint_lines "main.ouro" source [] [] codes in
        match prep_codes (ncodes bad_source) with
        | LintPrepErr _ => False
        | LintPrepOk bad_codes =>
            let warned : List String :=
              lint_lines "main.ouro" bad_source [] [] bad_codes in
            andb
              (all String (fun (line : String) =>
                notb (orb (prim_string_contains line "OURO-LINT002")
                  (orb (prim_string_contains line "lex-malformed")
                    (prim_string_contains line "parse-fail")))) clean)
              (any String (fun (line : String) =>
                andb (prim_string_contains line "OURO-LINT002")
                  (prim_string_contains line "Missing")) warned)
        end
    end;

def native_lint_alias_ctor_identity : Bool :=
    let source : String :=
      "import \"a.ouro\" as A; import \"b.ouro\" as B; def left : Type := A.Ctor; def right : Type := B.Ctor;" in
    match scan_source_imports source with
    | Left _ => False
    | Right rows =>
        let aliases : List (Pair String String) :=
          lint_alias_targets "main.ouro" rows in
        let a_names : List String := lint_qualified_for_path
          (resolve_import "main.ouro" "a.ouro") aliases
          (harvest_names "def Ctor : Type := Nat;") in
        let b_ctors : List String := lint_qualified_for_path
          (resolve_import "main.ouro" "b.ouro") aliases
          (harvest_ctor_names "inductive B : Type := | Ctor : B;") in
        match prep_codes (ncodes source) with
        | LintPrepErr _ => False
        | LintPrepOk codes =>
            if let LexOk _ st :=
              (lex_all_import (lint_fuel (prim_string_length source)) codes : LexResult) then
              let identifiers : List (Pair (List Nat) Nat) :=
                unit_intern_ids st in
              let found : List String := map (Pair (List Nat) Nat) String
                (fun (p : Pair (List Nat) Nat) =>
                  match p with | MkPair cs _ => nstr cs end) identifiers in
              let ctor_ids : List Nat := imported_ctor_ids st b_ctors in
              andb(precision_strings a_names ["A@Ctor"],
                andb(precision_strings b_ctors ["B@Ctor"],
                  andb(mem_str "A@Ctor" found,
                    andb(mem_str "B@Ctor" found,
                      all (Pair (List Nat) Nat)
                        (fun (p : Pair (List Nat) Nat) =>
                          match p with
                          | MkPair cs id =>
                              match prim_string_eq (nstr cs) "A@Ctor" with
                              | True => andb(notb (elem Nat eqNat id ctor_ids),
                                  notb (keep_warn st [] a_names [] (WUnbound id)))
                              | False => match prim_string_eq (nstr cs) "B@Ctor" with
                                | True => elem Nat eqNat id ctor_ids
                                | False => True
                                end
                              end
                          end) identifiers))))
            else False
        end
    end;

def native_lint_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-lint/module-rewrite-retains-underscore-and-indent"
        (prim_string_eq (nstr (rewrite_mod_def (ncodes "Sample")
          (ncodes "  def name : Nat := Z;"))) "  def Sample_name : Nat := Z;")
    , MkPair String Bool "native-lint/hole-name-is-underscore"
        (prim_string_eq(nstr (name_codes_of empty_intern Z), "_"))
    , MkPair String Bool "native-lint/underscore-prefix-is-discard"
        (starts_uscore (ncodes "_unused"))
    , MkPair String Bool "native-lint/ordinary-prefix-is-not-discard"
        (notb (starts_uscore (ncodes "value")))
    , MkPair String Bool "native-lint/intrinsic-references-are-not-dropped"
        (native_lint_unbound (lint_decl empty_intern native_lint_scope []
          (DIntrinsic(10, EVar 1, 20, Just(Expr, EVar 2)))) [1, 2])
    , MkPair String Bool "native-lint/extern-reference-is-not-dropped"
        (native_lint_unbound (lint_decl empty_intern native_lint_scope []
          (DExtern 10 (EVar 1) [20, 21, 22, 23, 24])) [1])
    , MkPair String Bool "native-lint/known-signature-and-specialization-stay-clean"
        (nullb Warning (lint_decl empty_intern native_lint_scope [1, 2]
          (DIntrinsic(10, EVar 1, 20, Just(Expr, EVar 2)))))
    , MkPair String Bool "native-lint/type-use-filters-unused-binder-and-preserves-warning-order"
        (native_lint_unbound (lint_decl empty_intern native_lint_scope []
          (DDef 10 (EPi 7 (ESort 0) (EApp (EVar 20) (EVar 7)))
            (ELam 7 (Just Expr (ESort 0)) (EVar 30)) 0 [])) [20, 30])
    , MkPair String Bool "native-lint/unbound-text-keeps-qualified-name-and-byte-column"
        (let source : String := "A.SharedLong\n-- 雪 A.Shared\n" in
          let names : InternState := MkIntern [MkPair (List Nat) Nat (ncodes "A@Shared") 1] 2 [] 0 in
          let warning : Warning := WUnbound 1 in
          andb (prim_string_eq (show_warn "main.ouro" source names warning)
            "main.ouro:2:8: warning[OURO-LINT002] lint/unbound: unbound name: A.Shared")
            (prim_string_eq
              (quality_advice_evidence (quality_diagnostic_advice (warn_diagnostic "main.ouro" source names warning)))
              "A.Shared"))
    , MkPair String Bool "native-lint/opaque-globals-enter-the-following-scope"
        (source_bytes_equal (concat_map Decl Nat decl_bind_ids
          [DIntrinsic(10, ESort 0, 20, Nothing Expr), DExtern 11 (EVar 10) []]) [10, 11])
    , MkPair String Bool "lint-do/bind-scopes-over-following-statements"
        (nullb Warning (lint_one native_lint_scope [1]
          (EDo [EDoBind(7, EVar 1), EVar 7])))
    , MkPair String Bool "lint-do/bind-does-not-scope-over-its-initializer"
        (native_lint_unbound (lint_one native_lint_scope []
          (EDo [EDoBind(7, EVar 7), EVar 7])) [7])
    , MkPair String Bool "lint-do/final-ordinary-expression-retains-references"
        (native_lint_unbound(lint_one native_lint_scope [] (EDo [EVar 1]), [1]))
    , MkPair String Bool "lint-do/empty-block-stays-empty"
        (nullb(Warning, lint_one native_lint_scope [] (EDo [])))
    , MkPair String Bool "lint-named/labels-are-not-references-values-are"
        (native_lint_unbound (lint_one native_lint_scope []
          (ENamedCall (EVar 1) [MkPair Nat Expr 3 (EVar 2)])) [1, 2])
    , MkPair String Bool "lint-named/public-type-label-is-not-a-constructor-binder"
        (nullb Warning (lint_decl empty_intern (MkScope [] [20] True) []
          (DDef 30 (EPi 10 (ESort 0) (ESort 0))
            (ELam 10 (Just Expr (ESort 0)) (EVar 10)) Z
            [DefParamOf 20 10 (Nothing Expr)])))
    , MkPair String Bool "lint-range/value-is-reference-free"
        (nullb Warning (lint_one native_lint_scope [] (ERange 1 3 True)))
    , MkPair String Bool "lint-range/match-is-not-nat-literal"
        (nullb Warning (checkSillyScrut (adapt (ERange 1 3 False))))
    , MkPair String Bool "lint-range/application-keeps-head-reference"
        (native_lint_unbound (lint_one native_lint_scope []
          (EApp(EVar 5, ERange 1 3 True))) [5])
    , MkPair String Bool "lint-fallible/spanned-nested-lets-and-final-postfix"
        (notb (native_lint_has_hole (native_fallible_lint native_fallible_body)))
    , MkPair String Bool "lint-fallible/operand-reference-survives-postfix"
        (occurs 4 (adapt (EFallible (EVar 1) 2 3 native_fallible_body)))
    , MkPair String Bool "lint-fallible/anonymous-operand-hole-remains-visible"
        (native_lint_has_hole (native_fallible_lint
          (EApp(EHole (Nothing Nat), native_fallible_question))))
    , MkPair String Bool "lint-fallible/lambda-boundary-retains-question-hole"
        (native_lint_has_hole (native_fallible_lint
          (ELam(9, Nothing Expr, EApp(EVar 9, native_fallible_question)))))
    , MkPair String Bool "lint-fallible/nonmarker-hole-remains-visible"
        (native_lint_has_hole (native_fallible_lint
          (EApp(EVar 4, EHole (Nothing Nat)))))
    , MkPair String Bool "lint-fallible/exhausted-normalization-retains-question-hole"
        (native_lint_has_hole (lintCtx
          (lint_fallible_body_ast Z native_fallible_body (adapt native_fallible_body))
          native_lint_scope [4] False))
    , MkPair String Bool "native-lint/harvests-importable-global-names"
        (precision_strings (harvest_names
          "intrinsic U32 : Type := \"ouro.u32\";\nextern call : U32 := \"a\" \"b\" \"c\" \"d\" \"e\";\n")
          ["call", "U32"])
    , MkPair String Bool "native-lint/harvest-keeps-keyword-boundaries"
        (precision_strings (harvest_names
          "intrinsically value\nexternal value\n-- extern comment\n\"intrinsic quoted\"\n") [])
    , MkPair String Bool "native-lint/harvest-skips-only-leading-whitespace"
        (precision_strings (harvest_names
          "\t \r\n \tdef\tfirst : Nat := 0;\r\n\t\raxiom \tsecond : Type;\n  de f split : Nat := 0;\n")
          ["second", "first"])
    , MkPair String Bool "native-lint/module-expansion-preserves-comment-and-line-bytes"
        (prim_string_eq (nstr (expand_modules (ncodes
          "module Names where -- header\r\n\tdef first : Nat := 0; -- body\r\n  axiom next : Nat;\r\nend; -- close\r\nmodulex\r\n")))
          "\tdef Names_first : Nat := 0; -- body\r\n  axiom Names_next : Nat;\r\nmodulex\r\n")
    , MkPair String Bool "native-lint/qualifying-keeps-alias-order-and-duplicate-names"
        (precision_strings
          (lint_qualified_for_path "./a.ouro"
            [MkPair String String "First" "./a.ouro", MkPair String String "Other" "./b.ouro",
             MkPair String String "Last" "./a.ouro"]
            ["Ctor", "value", "Ctor"])
          ["First@Ctor", "First@value", "First@Ctor", "Last@Ctor", "Last@value", "Last@Ctor"])
    , MkPair String Bool "native-lint/private-local-names-stay-known"
        (precision_strings (harvest_names
          "private def helper : Type := Type;\ndef api : Type := helper;\n")
          ["api", "helper"])
    , MkPair String Bool "native-lint/local-symbols-keep-fields-operations-and-constructors-in-order"
        (let source : String := qt_cat4
          "private record Point : Type where\n  x : Nat;\n  y : Nat;\nend;\n"
          "record Delta : Type where\n  x : Nat;\n  shift : Nat;\nend;\n"
          "effect Log where\n  | write : Nat -> Nat\nprivate inductive Move : Type :=\n  | Stay : Move\n  | Step : Move;\n"
          "inductive Flag : Type := | Off : Flag | On : Flag;" in
         let agrees (combined : List String) (separate : List String) (expected : List String) : Bool :=
           andb (precision_strings combined expected) (precision_strings separate expected) in
         match harvest_local_symbols source with
         | MkLintLocalSymbols names fields ctors =>
             andb (agrees names (harvest_names source)
                 ["On", "Off", "Flag", "Step", "Stay", "Move", "write", "Delta", "Point"])
               (andb (agrees fields (harvest_record_fields source) ["shift", "x", "y", "x"])
                 (agrees ctors (harvest_ctor_names source) ["On", "Off", "Step", "Stay"]))
         end)
    , MkPair String Bool "native-lint/private-names-do-not-enter-import-inventory"
        (precision_strings (harvest_public_names
          "private def hidden : Type := Type;\nprivate\n-- kept\naxiom secret : Type;\ndef api : Type := hidden;\n")
          ["api"])
    , MkPair String Bool "native-lint/private-constructors-do-not-enter-import-inventory"
        (precision_strings (harvest_public_ctor_names
          "private inductive Hidden : Type :=\n | Make : Hidden;\ninductive Public : Type := | Build : Public;\n")
          ["Build"])
    , MkPair String Bool "native-lint/public-symbols-keep-visibility-and-order"
        (match harvest_public_symbols
          "private\r\n-- modifier\r\ninductive Hidden : Type := | Secret : Hidden;\r\ninductive Visible : Type :=\r\n | First : Visible\r\n | Second : Visible;\r\naxiom api : Visible;\r\n" with
        | MkPair names ctors =>
            andb (precision_strings names ["api", "Second", "First", "Visible"])
              (precision_strings ctors ["Second", "First"])
        end)
    , MkPair String Bool "representation-lint/target-reference-is-not-dropped"
        (native_lint_unbound (lint_decl empty_intern native_lint_scope []
          (DRepresentation 1 20)) [1])
    , MkPair String Bool "representation-lint/known-target-stays-clean"
        (nullb Warning (lint_decl empty_intern native_lint_scope [1]
          (DRepresentation 1 20)))
    , MkPair String Bool "representation-lint/annotation-does-not-bind-a-global"
        (nullb(Nat, decl_bind_ids (DRepresentation 1 20)))
    , MkPair String Bool "representation-lint/harvest-does-not-invent-a-global"
        (precision_strings (harvest_names
          "representation Missing := \"ouro.nat\";\naxiom Present : Type;\n") ["Present"])
    , MkPair String Bool "native-import/group-multiline-comment-and-trailing-comma"
        (native_import_paths_eq
          "import\n  \"a.ouro\", -- split\n  \"β.ouro\",;\n"
          ["β.ouro", "a.ouro"])
    , MkPair String Bool "native-import/escaped-paths-decode-before-resolution"
        (native_import_paths_eq
          "import \"x\\\\y.ouro\", \"a\\\"b.ouro\";"
          ["a\"b.ouro", "x\\y.ouro"])
    , MkPair String Bool "native-import/braced-unicode-paths-decode-before-resolution"
        (native_import_paths_eq "import \"caf\\u{e9}.ouro\";"
          ["café.ouro"])
    , MkPair String Bool "native-import/malformed-unicode-path-is-rejected"
        (native_import_rejected "import \"\\u{D800}.ouro\";")
    , MkPair String Bool "native-import/ignores-comments-strings-and-projections"
        (native_import_paths_eq
          "-- import \"comment.ouro\";\ndef text : String := \"import \\\"quoted.ouro\\\";\";\ndef fake : Nat := N.import;\nimport \"real.ouro\";"
          ["real.ouro"])
    , MkPair String Bool "native-import/comment-punctuation-does-not-project"
        (native_import_paths_eq
          "-- sentence.\nimport \"a.ouro\", \"b.ouro\";"
          ["b.ouro", "a.ouro"])
    , MkPair String Bool "native-import/projection-survives-comment-trivia"
        (native_import_paths_eq
          "N. -- comment\n import \"projected.ouro\";\nimport \"real.ouro\";"
          ["real.ouro"])
    , MkPair String Bool "native-import/aliases-stay-single-path"
        native_import_alias
    , MkPair String Bool "native-lint/qualified-colliding-references-remain-parseable"
        native_lint_qualified_collision
    , MkPair String Bool "native-lint/scoped-open-retains-unknown-precision"
        native_lint_scoped_open
    , MkPair String Bool "native-lint/record-owner-marker-keeps-unknown-precision"
        native_lint_record_owner_marker
    , MkPair String Bool "native-lint/direct-alias-constructor-identity"
        native_lint_alias_ctor_identity
    , MkPair String Bool "native-import/operand-byte-locations"
        native_import_offsets
    , MkPair String Bool "native-import/rejects-missing-path"
        (native_import_rejected "import;\n")
    , MkPair String Bool "native-import/rejects-missing-group-member"
        (native_import_rejected "import \"a.ouro\", -- trailing\n")
    , MkPair String Bool "native-import/rejects-mixed-alias-group"
        (native_import_rejected "import \"a.ouro\" as A, \"b.ouro\";")
    ];

-- @entry main
def main : IO Unit := precision_run "compiler-native-lint" native_lint_laws;
