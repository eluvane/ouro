-- Opaque native declarations still participate in lint scope checks. Keep
-- this cone separate from desugar_match, which has a different binderIds API.

import "../tools/lint_host.ouro",
  "analyze/precision/assertions.ouro";

def native_lint_unbound : List Warning -> List Nat -> Bool :=
  fix native_lint_unbound (warnings : List Warning) (expected : List Nat) : Bool :=
    match warnings with
    | Nil => nullb Nat expected
    | Cons warning rest =>
        match expected with
        | Nil => False
        | Cons name tail =>
            match warning with
            | WUnbound found => andb(eqNat found name, native_lint_unbound rest tail)
            | WHole _ => False
            | WUnused _ => False
            | WShadow _ => False
            | WCtorArity _ => False
            | WRedundantBranch _ => False
            | WPartialMatch _ => False
            | WUnreachableArm _ => False
            | WDupBinder _ => False
            | WNonRecFix _ => False
            | WUnknownCtor _ => False
            | WMixedCtors _ => False
            | WEmptyMatch _ => False
            | WShadowCtor _ => False
            | WCtorAppArity _ => False
            | WMatchOnHole _ => False
            | WMatchOnLit _ => False
            | WMatchOnSort _ => False
            | WEmptyTelescope _ => False
            | WUnusedDef _ => False
            | WUnusedCtor _ => False
            | WUnusedInd _ => False
            end
        end
    end;

def native_lint_scope : Scope := MkScope [] [] True;

def native_import_paths_eq (source : String) (want : List String) : Bool :=
    match harvest_imports source with
    | Left _ => False
    | Right paths => precision_strings paths want
    end;

def native_import_rejected (source : String) : Bool :=
    match scan_source_imports source with
    | Left error => match error with
      | ImportScanFailure _ => True
      end
    | Right _ => False
    end;

def native_import_offsets : Bool :=
    let source : String :=
      "-- leading\nimport\n  \"a.ouro\", -- gap\n  \"β.ouro\",;\n" in
    match scan_source_imports source with
    | Left _ => False
    | Right rows => match rows with
      | Cons first rest => match first with
        | MkScannedImport path alias declaration quote _ _ =>
            match rest with
            | Cons second tail => match second with
              | MkScannedImport path2 alias2 declaration2 quote2 _ _ =>
                  andb(precision_strings [path, path2] ["a.ouro", "β.ouro"],
                    andb(eq_nat declaration 11,
                      andb(eq_nat declaration2 declaration,
                        andb(match alias with
                          | Nothing => True | Just _ => False end,
                          andb(match alias2 with
                            | Nothing => True | Just _ => False end,
                            andb(match import_scan_place source quote with
                              | MkPair line column =>
                                  andb(eq_nat line 3, eq_nat column 3)
                              end,
                              andb(match import_scan_place source quote2 with
                                | MkPair line column =>
                                    andb(eq_nat line 4, eq_nat column 3)
                                end, nullb ScannedImport tail)))))))
              end
            | Nil => False
            end
        end
      | Nil => False
      end
    end;

def native_import_alias : Bool :=
    match scan_source_imports "import \"a.ouro\" as A; import \"b.ouro\";" with
    | Left _ => False
    | Right rows => match rows with
      | Cons first rest => match first with
        | MkScannedImport path alias _ _ _ alias_at =>
            andb(prim_string_eq path "a.ouro",
              andb(match alias with
                | Just name => prim_string_eq name "A"
                | Nothing => False end,
                andb(match alias_at with
                  | Just at => eq_nat at 19
                  | Nothing => False end,
                  match rest with
                  | Cons second tail => match second with
                    | MkScannedImport path2 alias2 _ _ _ _ =>
                        andb(prim_string_eq path2 "b.ouro",
                          andb(match alias2 with
                            | Nothing => True | Just _ => False end,
                            nullb ScannedImport tail))
                    end
                  | Nil => False
                  end)))
        end
      | Nil => False
      end
    end;

def native_lint_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-lint/module-rewrite-retains-underscore-and-indent"
        (prim_string_eq (nstr (rewrite_mod_def (ncodes "Sample")
          (ncodes "  def name : Nat := Z;"))) "  def Sample_name : Nat := Z;")
    , MkPair String Bool "native-lint/hole-name-is-underscore"
        (prim_string_eq(nstr (name_codes_of empty_intern Z), "_"))
    , MkPair String Bool "native-lint/underscore-prefix-is-discard"
        (starts_uscore (ncodes "_unused"))
    , MkPair String Bool "native-lint/ordinary-prefix-is-not-discard"
        (notb (starts_uscore (ncodes "value")))
    , MkPair String Bool "native-lint/intrinsic-references-are-not-dropped"
        (native_lint_unbound (lint_decl empty_intern native_lint_scope []
          (DIntrinsic(10, EVar 1, 20, Just(Expr, EVar 2)))) [1, 2])
    , MkPair String Bool "native-lint/extern-reference-is-not-dropped"
        (native_lint_unbound (lint_decl empty_intern native_lint_scope []
          (DExtern 10 (EVar 1) [20, 21, 22, 23, 24])) [1])
    , MkPair String Bool "native-lint/known-signature-and-specialization-stay-clean"
        (nullb Warning (lint_decl empty_intern native_lint_scope [1, 2]
          (DIntrinsic(10, EVar 1, 20, Just(Expr, EVar 2)))))
    , MkPair String Bool "native-lint/opaque-globals-enter-the-following-scope"
        (source_bytes_equal (concat_map Decl Nat decl_bind_ids
          [DIntrinsic(10, ESort 0, 20, Nothing Expr), DExtern 11 (EVar 10) []]) [10, 11])
    , MkPair String Bool "lint-do/bind-scopes-over-following-statements"
        (nullb Warning (lint_one native_lint_scope [1]
          (EDo [EDoBind(7, EVar 1), EVar 7])))
    , MkPair String Bool "lint-do/bind-does-not-scope-over-its-initializer"
        (native_lint_unbound (lint_one native_lint_scope []
          (EDo [EDoBind(7, EVar 7), EVar 7])) [7])
    , MkPair String Bool "lint-do/final-ordinary-expression-retains-references"
        (native_lint_unbound(lint_one native_lint_scope [] (EDo [EVar 1]), [1]))
    , MkPair String Bool "lint-do/empty-block-stays-empty"
        (nullb(Warning, lint_one native_lint_scope [] (EDo [])))
    , MkPair String Bool "native-lint/harvests-importable-global-names"
        (precision_strings (harvest_names
          "intrinsic U32 : Type := \"ouro.u32\";\nextern call : U32 := \"a\" \"b\" \"c\" \"d\" \"e\";\n")
          ["call", "U32"])
    , MkPair String Bool "native-lint/harvest-keeps-keyword-boundaries"
        (precision_strings (harvest_names
          "intrinsically value\nexternal value\n-- extern comment\n\"intrinsic quoted\"\n") [])
    , MkPair String Bool "representation-lint/target-reference-is-not-dropped"
        (native_lint_unbound (lint_decl empty_intern native_lint_scope []
          (DRepresentation 1 20)) [1])
    , MkPair String Bool "representation-lint/known-target-stays-clean"
        (nullb Warning (lint_decl empty_intern native_lint_scope [1]
          (DRepresentation 1 20)))
    , MkPair String Bool "representation-lint/annotation-does-not-bind-a-global"
        (nullb(Nat, decl_bind_ids (DRepresentation 1 20)))
    , MkPair String Bool "representation-lint/harvest-does-not-invent-a-global"
        (precision_strings (harvest_names
          "representation Missing := \"ouro.nat\";\naxiom Present : Type;\n") ["Present"])
    , MkPair String Bool "native-import/group-multiline-comment-and-trailing-comma"
        (native_import_paths_eq
          "import\n  \"a.ouro\", -- split\n  \"β.ouro\",;\n"
          ["β.ouro", "a.ouro"])
    , MkPair String Bool "native-import/escaped-paths-decode-before-resolution"
        (native_import_paths_eq
          "import \"x\\\\y.ouro\", \"a\\\"b.ouro\";"
          ["a\"b.ouro", "x\\y.ouro"])
    , MkPair String Bool "native-import/braced-unicode-paths-decode-before-resolution"
        (native_import_paths_eq "import \"caf\\u{e9}.ouro\";"
          ["café.ouro"])
    , MkPair String Bool "native-import/malformed-unicode-path-is-rejected"
        (native_import_rejected "import \"\\u{D800}.ouro\";")
    , MkPair String Bool "native-import/ignores-comments-strings-and-projections"
        (native_import_paths_eq
          "-- import \"comment.ouro\";\ndef text : String := \"import \\\"quoted.ouro\\\";\";\ndef fake : Nat := N.import;\nimport \"real.ouro\";"
          ["real.ouro"])
    , MkPair String Bool "native-import/comment-punctuation-does-not-project"
        (native_import_paths_eq
          "-- sentence.\nimport \"a.ouro\", \"b.ouro\";"
          ["b.ouro", "a.ouro"])
    , MkPair String Bool "native-import/projection-survives-comment-trivia"
        (native_import_paths_eq
          "N. -- comment\n import \"projected.ouro\";\nimport \"real.ouro\";"
          ["real.ouro"])
    , MkPair String Bool "native-import/aliases-stay-single-path"
        native_import_alias
    , MkPair String Bool "native-import/operand-byte-locations"
        native_import_offsets
    , MkPair String Bool "native-import/rejects-missing-path"
        (native_import_rejected "import;\n")
    , MkPair String Bool "native-import/rejects-missing-group-member"
        (native_import_rejected "import \"a.ouro\", -- trailing\n")
    , MkPair String Bool "native-import/rejects-mixed-alias-group"
        (native_import_rejected "import \"a.ouro\" as A, \"b.ouro\";")
    ];

-- @entry main
def main : IO Unit := precision_run "compiler-native-lint" native_lint_laws;
