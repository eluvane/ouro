import "../std/crypto.ouro",
  "../std/num.ouro",
  "../std/test.ouro",
  "crypto_stream_checks.ouro";

import "native_crypto_hash_laws.ouro" as hash_laws;

private def native_crypto_binary : String := str_of_codes (nat_range_count 0 129);

private def native_crypto_binary_digest : String :=
    "5099c6a56203f9687f7d33f4bfdf576d31dc91f6b695ecea38b2770c87631135";

private def native_crypto_tests : List Test :=
    [ assert_eq "stream padding at 55 bytes"
        (crypto_check_stream_digest [str_slice native_crypto_binary 0 1, str_slice native_crypto_binary 1 54])
        "463eb28e72f82e0a96c0a4cc53690c571281131f672aa229e0d45ae59b598b59"
    , assert_eq "stream padding at 56 bytes"
        (crypto_check_stream_digest [str_slice native_crypto_binary 0 55, "", str_slice native_crypto_binary 55 1])
        "da2ae4d6b36748f2a318f23e7ab1dfdf45acdc9d049bd80e59de82a60895f562"
    , assert_eq "stream residual 63 bytes"
        (crypto_check_stream_digest ["", str_slice native_crypto_binary 0 63])
        "29af2686fd53374a36b0846694cc342177e428d1647515f078784d69cdb9e488"
    , assert_eq "stream exact block"
        (crypto_check_stream_digest [str_slice native_crypto_binary 0 63, str_slice native_crypto_binary 63 1])
        "fdeab9acf3710362bd2658cdc9a29e8f9c757fcf9811603a8c447cd1d9151108"
    , assert_eq "stream block plus byte"
        (crypto_check_stream_digest [str_slice native_crypto_binary 0 63, "", str_slice native_crypto_binary 63 2])
        "4bfd2c8b6f1eec7a2afeb48b934ee4b2694182027e6d0fc075074f2fabb31781"
    , assert_eq "stream two binary blocks"
        (crypto_check_stream_digest [str_slice native_crypto_binary 0 64, str_slice native_crypto_binary 64 64, ""])
        "471fb943aa23c511f6f72f8d1652d9c880cfa392ad80503120547703e56a2be5"
    , assert_true "stream every residual length before binary continuation"
        (all Nat (fun (split : Nat) =>
          str_eq (crypto_check_stream_digest
            [str_slice native_crypto_binary 0 split, "", str_slice native_crypto_binary split (sub 129 split)])
            native_crypto_binary_digest) (nat_range_count 0 64))
    , assert_eq "stream NUL and high bytes across chunks"
        (crypto_check_stream_digest (map Nat String
          (fun (byte : Nat) => str_of_codes [byte]) [65, 0, 255, 13, 10, 128]))
        "08dfa4ee58c7045488f1342b045037c01dbc4f5bd18a09bb0a60ab4d1bed0ecd"
    , assert_true "stream retains only the exact residual byte"
        (crypto_check_state_shape (crypto_check_update_chunks
          [str_slice native_crypto_binary 0 63, str_slice native_crypto_binary 63 2] sha256_stream_init)
          65 (str_slice native_crypto_binary 64 1))
    , assert_true "stream finalization is reusable" (crypto_check_reusable_final native_crypto_binary native_crypto_binary_digest)
    , assert_eq "HMAC exact-block binary key"
        (hmac_sha256 (str_slice native_crypto_binary 0 64) native_crypto_binary)
        "335e54597fb47ebfcffcaaa3a1711076bc8952532d562bf31c9bd3101de46dfa"
    , assert_eq "HMAC NUL and high bytes"
        (hmac_sha256 (str_of_codes [0, 255, 128]) (str_of_codes [65, 0, 255, 13, 10, 128]))
        "738e52c3b724033d551c3e06bcb8d0073676ee51ac75ace589cbe56690f85ed2"
    , assert_true "stream rejects an oversized tail"
        (crypto_check_invalid_state (Sha256StreamOf 0 crypto_check_initial_hash
          (str_slice native_crypto_binary 0 64)))
    , assert_true "stream byte limit takes precedence over invalid shape"
        (let state : Sha256Stream := Sha256StreamOf sha256_stream_byte_limit
            (MkSha crypto_check_word_limit 0 0 0 0 0 0 0) (str_slice native_crypto_binary 0 64) in
          andb (crypto_check_limit_error Sha256Stream sha256_stream_byte_limit
            (sha256_stream_update state ""))
            (crypto_check_limit_error String sha256_stream_byte_limit (sha256_stream_final state)))
    ];

-- @entry main
def main : IO Unit := test_run (append Test hash_laws.crypto_hash_laws native_crypto_tests);
