import "native_mir_phase_fixtures.ouro";

def native_mir_phase_tests : List Test :=
    [mir_phase_same "MIR callback composition preserves control validation" mir_default_limits mir_fixture_control,
      mir_phase_same "MIR callback composition preserves arithmetic validation" mir_default_limits mir_fixture_arithmetic,
      mir_phase_same "MIR callback composition preserves memory validation" mir_default_limits mir_fixture_memory,
      mir_phase_same "MIR callback receives the complete program for call signatures" mir_default_limits mir_fixture_calls,
      mir_phase_same "MIR callback composition preserves large local namespaces" mir_default_limits mir_fixture_large,
      mir_phase_same "MIR callback composition preserves imported IO signatures" mir_default_limits mir_fixture_stdout,
      mir_phase_same "MIR callback composition preserves missing-predecessor rejection" mir_default_limits (mir_test_diamond False),
      mir_phase_same "MIR callback composition preserves reversed block order" mir_default_limits
        (mir_test_reverse_blocks (mir_test_diamond False)),
      mir_phase_same "MIR callback composition preserves the first function error" mir_default_limits mir_phase_two_bad,
      mir_phase_same "MIR callback composition checks later functions" mir_default_limits
        (mir_phase_functions([mir_phase_good_function 1, mir_phase_bad_function 2 72] : List MirFunction, 1)),
      mir_phase_same "MIR callback composition rejects invalid local operands" mir_default_limits
        (mir_test_one (MirMove(10, MirUse 99))),
      mir_phase_same "MIR callback composition preserves zero flow fuel" (MirLimitsWith 1000 1000 0) mir_fixture_control,
      mir_phase_same "MIR callback composition preserves data byte exhaustion" (MirLimitsWith 1000 1 1000) mir_fixture_memory,
      mir_phase_expect "MIR bounds precede the function callback" MirResourceExhausted
        (mir_check_program_with mir_phase_callback_error (MirLimitsWith 0 1000 1000) mir_phase_two_bad),
      mir_phase_same "compiler-scale MIR limits stay under the hard ceiling"
        native_compiler_limits mir_fixture_control,
      mir_phase_expect "MIR node hard ceiling precedes the function callback" MirResourceExhausted
        (mir_check_program_with mir_phase_callback_error (MirLimitsWith (S mir_limit_node_ceiling) 1000 1000) mir_phase_two_bad),
      mir_phase_expect "MIR byte hard ceiling precedes the function callback" MirResourceExhausted
        (mir_check_program_with mir_phase_callback_error (MirLimitsWith 1000 (S mir_limit_byte_ceiling) 1000) mir_phase_two_bad),
      mir_phase_expect "MIR flow hard ceiling precedes the function callback" MirResourceExhausted
        (mir_check_program_with mir_phase_callback_error (MirLimitsWith 1000 1000 (S mir_limit_flow_ceiling)) mir_phase_two_bad),
      mir_phase_priority "MIR duplicate symbols retain priority over all later errors" (MirDuplicateSymbol 1)
        (MirProgramDef ([mir_phase_bad_function 1 71] : List MirFunction)
          ([MirDataDef 1 False ([] : List Nat)] : List MirData)
          ([MirLibraryDef([] : List Nat, [] : List MirExtern)] : List MirLibrary) 999),
      mir_phase_priority "MIR symbol range retains priority over data and function errors" MirResourceExhausted
        (MirProgramDef ([mir_phase_bad_function pe_max_rva 71] : List MirFunction)
          ([MirDataDef 91 False ([] : List Nat)] : List MirData) ([] : List MirLibrary) pe_max_rva),
      mir_phase_priority "MIR data errors retain priority over library and function errors" (MirInvalidData 91)
        (MirProgramDef ([mir_phase_bad_function 1 71] : List MirFunction)
          ([MirDataDef 91 False ([] : List Nat)] : List MirData)
          ([MirLibraryDef([] : List Nat, [] : List MirExtern)] : List MirLibrary) 999),
      mir_phase_priority "MIR library errors retain priority over entry and function errors" (MirInvalidName 0)
        (MirProgramDef ([mir_phase_bad_function 1 71] : List MirFunction) ([] : List MirData)
          ([MirLibraryDef([] : List Nat, [] : List MirExtern)] : List MirLibrary) 999),
      mir_phase_priority "MIR entry errors retain priority over the function callback" (MirInvalidEntry 999)
        (mir_phase_functions([mir_phase_bad_function 1 71] : List MirFunction, 999)),
      mir_phase_expect "MIR callback receives program, flow and first function in order" (MirInvalidCall 16)
        (mir_check_program_with mir_phase_callback_error (MirLimitsWith 1000 1000 7)
          (mir_phase_functions([mir_phase_good_function 4, mir_phase_good_function 5] : List MirFunction, 5))),
      mir_phase_expect "MIR canonical callback retains first-function failure" (MirUnknownBlock 71)
        (mir_check_program_with mir_check_function mir_default_limits mir_phase_two_bad),
      mir_phase_expect "MIR canonical callback still checks a later function" (MirUnknownBlock 72)
        (mir_check_program_with mir_check_function mir_default_limits
          (mir_phase_functions([mir_phase_good_function 1, mir_phase_bad_function 2 72] : List MirFunction, 1))),
      mir_phase_public_boundary];

-- @entry main
def main : IO Unit := test_run native_mir_phase_tests
