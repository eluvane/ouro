-- Native architectural limits; no machine-dependent timing assertions.
-- @entry main
import "../quality_test_support.ouro",
  "../../tools/clippy/semantic_contracts.ouro",
  "../../std/io.ouro";

def cr_local (name : Nat) : ScDecl :=
    ScDeclOf name 1 0 0 (EPi(10, ESort 0, ESort 0))
      (Just(Expr, ELam(10, Nothing Expr, EVar 10))) (Nothing Nat);
def cr_decls : Nat -> Nat -> List ScDecl :=
  fix go (remaining : Nat) (name : Nat) : List ScDecl :=
    match remaining with | Z => [] | S less => Cons(ScDecl, cr_local name, go(less, add name 1)) end;
def cr_many (count : Nat) (budget : Nat) : Bool :=
    let decls : List ScDecl := cr_decls count 100 in
    match sc_index_sorted decls with
    | Left _ => False
    | Right index =>
        let unit : ClippySemanticUnit := CmUnit empty_intern 1 "" [MkSrcUnit 1 []] decls index [] 1 [] in
        match cm_build_apis unit index with
        | Left _ => False
        | Right apis =>
            let state : CsAnalysis := cs_analyze unit apis budget 16 in
            andb (eq_nat(cs_computed state, minNat count budget))
              (andb (eq_nat(cs_expansions state, 0))
                (eq_nat(cs_unavailable state, sub count budget)))
        end
    end;

-- Fuel is not a compile-time 4096 literal: native C emit would unroll the
-- import-resolution fix into one expression and exceed Clang bracket-depth.
def cr_import_fuel : Nat :=
    (fix go (n : Nat) : Nat := match n with | Z => add 2048 2048 | S k => go k end) 0;
def cr_graph_ok (units : List SrcUnit) (expected : Nat) : Bool :=
    match resolve_imports_fuel cr_import_fuel units 1 with
    | RErr _ _ => False
    | ROk original => match resolve_imports_fuel cr_import_fuel (cm_graph_units units) 1 with
      | RErr _ _ => False
      | ROk projected => andb(eq_nat(length Decl original, expected), nullb Decl projected) end
    end;
def cr_graph_error (units : List SrcUnit) (code : Nat) : Bool :=
    match resolve_imports_fuel cr_import_fuel units 1 with
    | ROk _ => False
    | RErr original detail => match resolve_imports_fuel cr_import_fuel (cm_graph_units units) 1 with
      | ROk _ => False
      | RErr projected projected_detail => andb (eq_nat original code)
          (andb(eq_nat projected code, eq_nat detail projected_detail)) end
    end;
def cr_skip_stub_unit : ClippySemanticUnit :=
    let intern : InternState := MkIntern (Nil (Pair(List Nat, Nat))) 0
      [MkPair(List Nat, Nat, prim_string_to_char_codes "std/process.ouro", 1)] 2 in
    CmUnit intern 1 "" [MkSrcUnit(1, Nil Decl)] (Nil ScDecl) ScEmpty (Nil Decl) 1 [];
def cr_process_stub_binding : Bool :=
    match cm_validate_contract_bindings cr_skip_stub_unit
        [CmContractOf "std/process.ouro" "process_run_checked" 24 False 0 False] with
      | Left _ => False
      | Right _ => True
      end;
def cr_binding_unit (decl_owner : Nat) : ClippySemanticUnit :=
    let intern : InternState := MkIntern [MkPair(List Nat, Nat, prim_string_to_char_codes "parse", 7)] 8
      [MkPair(List Nat, Nat, prim_string_to_char_codes "api.ouro", 1),
       MkPair(List Nat, Nat, prim_string_to_char_codes "other.ouro", 2)] 3 in
    let decl : ScDecl := ScDeclOf 7 decl_owner 0 0 (ESort 0) (Nothing Expr) (Nothing Nat) in
    CmUnit intern 1 "" [MkSrcUnit 1 []] [decl] (ScNode decl ScEmpty ScEmpty) [] 1 [];
def cr_binding (unit : ClippySemanticUnit) (name : String) (expected : Bool) : Bool :=
    let valid : Bool := match cm_validate_contract_bindings unit
        [CmContractOf "api.ouro" name 15 True 1 False] with
      | Left _ => False | Right _ => True end in
    match expected with | True => valid | False => notb valid end;
def cr_import_priority : Bool :=
    let root : ScDecl := cr_local 100 in
    let imported : ScDecl := ScDeclOf 101 2 0 0 (EPi(10, ESort 0, ESort 0))
      (Nothing Expr) (Nothing Nat) in
    let index : ScIndex := ScNode root ScEmpty (ScNode imported ScEmpty ScEmpty) in
    let unit : ClippySemanticUnit := CmUnit empty_intern 1 "" [] [imported, root] index [] 2
      [CsOriginOf 2 101 (CsArgumentOrigin 0)] in
    match cm_build_apis unit index with
    | Left _ => False
    | Right apis =>
        let state : CsAnalysis := cs_analyze unit apis 1 8 in
        andb (eq_nat(cs_computed state, 1))
          (andb (match cm_api_lookup(100, cs_cache state) with
             | Nothing => False | Just api => cs_complete (cm_api_summary api) end)
            (match cm_api_lookup(101, cs_cache state) with
             | Nothing => False | Just api => notb (cs_complete (cm_api_summary api)) end))
    end;

def cr_laws : List (Pair String Bool) :=
    [ MkPair String Bool "root-summaries-precede-imported-origins-with-one-shared-budget" cr_import_priority
    , MkPair String Bool "256-definitions-one-summary-each" (cr_many 256 256)
    , MkPair String Bool "many-definitions-obey-shared-budget" (cr_many 256 32)
    , MkPair String Bool "zero-budget-builds-no-summaries" (cr_many 256 0)
    , MkPair String Bool "empty-unit-builds-no-summaries" (cr_many 0 16)
    , MkPair String Bool "graph-projection-retains-closure" (cr_graph_ok
        [MkSrcUnit 1 [DImport 2, DDef(3, ESort 0, ESort 0, 0, 0)],
         MkSrcUnit 2 [DDef(4, ESort 0, ESort 0, 0, 0)]] 2)
    , MkPair String Bool "large-declaration-list-not-flattened" (cr_graph_ok
        [MkSrcUnit(1, Cons(Decl, DImport 2, replicate Decl (DDef(3, ESort 0, ESort 0, 0, 0)) 256)),
         MkSrcUnit(2, replicate Decl (DDef(4, ESort 0, ESort 0, 0, 0)) 256)] 512)
    , MkPair String Bool "graph-cycle-error-preserved" (cr_graph_error
        [MkSrcUnit 1 [DImport 2], MkSrcUnit 2 [DImport 1]] errCycle)
    , MkPair String Bool "graph-missing-unit-error-preserved" (cr_graph_error [MkSrcUnit 1 [DImport 2]] errMissing)
    , MkPair String Bool "registered-declaration-owner-resolves" (cr_binding (cr_binding_unit 1) "parse" True)
    , MkPair String Bool "stale-registered-name-fails-closed" (cr_binding (cr_binding_unit 1) "missing" False)
    , MkPair String Bool "wrong-declaration-owner-fails-closed" (cr_binding (cr_binding_unit 2) "parse" False)
    , MkPair String Bool "skipped-process-stub-is-not-stale" cr_process_stub_binding
    ];
def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True cr_laws;
       exit (match ok with | True => 0 | False => 1 end)
