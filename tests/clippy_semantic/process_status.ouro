-- Checked process transport must preserve reports from expected nonzero exits.
-- @entry main
import "../../std/processx.ouro",
  "../../std/process.ouro",
  "../quality_test_support.ouro";

def status_accepts (result : Either ProcessError ProcResult) (code : Nat) : Bool :=
    match result with
    | Left _ => False
    | Right process => andb (eq_nat(proc_code process, code))
        (andb (str_eq(proc_stdout process, "payload\n"))
          (str_eq(proc_stderr process, "detail\n")))
    end;

def status_rejects (result : Either ProcessError ProcResult) (code : Nat) : Bool :=
    match result with
    | Left error => andb (eq_nat(process_error_status error, code))
        (str_eq(process_error_stderr error, "detail\n"))
    | Right _ => False
    end;

def status_laws (executable : String) : IO Unit :=
    do let! zero := process_run_expected_codes(command_spec executable ["0"], [0, 1]);
       let! one := process_run_expected_codes(command_spec executable ["1"], [0, 1]);
       let! rejected := process_run_expected_codes(command_spec executable ["7"], [0, 1]);
       let! empty := process_run_expected_codes(command_spec executable ["0"], []);
       let! single := process_run_expected(command_spec executable ["7"], 7);
       let! ok := io_fold (Pair String Bool) Bool quality_test_print True
         [ MkPair String Bool "zero-status-preserves-both-streams" (status_accepts zero 0)
         , MkPair String Bool "nonzero-status-preserves-both-streams" (status_accepts one 1)
         , MkPair String Bool "unexpected-status-is-typed-error" (status_rejects rejected 7)
         , MkPair String Bool "empty-status-set-rejects-zero" (status_rejects empty 0)
         , MkPair String Bool "single-status-api-preserved" (status_accepts single 7)
         ];
       exit (match ok with | True => 0 | False => 1 end)

def main : IO Unit :=
    do let! values := argv;
       match values with
       | Nil => exit 2
       | Cons executable arguments => match arguments with
         | Nil => status_laws executable
         | Cons mode _ =>
             do println "payload";
                eprintln "detail";
                exit (match str_eq mode "0" with
                  | True => 0
                  | False => match str_eq mode "1" with | True => 1 | False => 7 end
                  end)
         end
       end
