-- @entry main
import "../quality_test_support.ouro";
import "../../tools/clippy/semantic_proof.ouro";
import "../../std/io.ouro";

def pr_owner : ScDecl := ScDeclOf 1 2 0 0 (ESort 0) (Nothing Expr) (Nothing Nat);
def pr_base : List CmEvidence :=
    [cm_known_fact CmCheckedProducer True, cm_known_fact CmNoObservation True];
def pr_make (facts : List CmEvidence) : CmSemanticProof :=
    cm_proof_for CmIgnoredResultProof pr_owner 3 4 5 facts "checked producer has no observation";
def pr_mutation (fact : CmRequirement) : Bool :=
    let requirements : List CmRequirement := cm_requirements CmRepeatedWorkProof in
    let evidence : List CmEvidence := map CmRequirement CmEvidence
      (fun (item : CmRequirement) => CmEvidenceOf item
        (match eq_nat (cm_requirement_id item) (cm_requirement_id fact) with
         | True => Nothing Bool | False => Just Bool True end)) requirements in
    notb (cm_proof_valid (CmSemanticProofOf CmRepeatedWorkProof 2 1 3 4 5
      (Nothing (Pair Nat Nat)) evidence "mutation"));
def pr_laws : List (Pair String Bool) :=
    [ MkPair String Bool "complete-proof-publishes" (cm_proof_valid (pr_make pr_base))
    , MkPair String Bool "missing-required-fact-blocks" (notb (cm_proof_valid (pr_make [])))
    , MkPair String Bool "unknown-fact-blocks" (notb (cm_proof_valid (pr_make
        [cm_known_fact CmCheckedProducer True, CmEvidenceOf CmNoObservation (Nothing Bool)])))
    , MkPair String Bool "disproved-fact-blocks" (notb (cm_proof_valid (pr_make
        [cm_known_fact CmCheckedProducer True, cm_known_fact CmNoObservation False])))
    , MkPair String Bool "duplicate-evidence-blocks" (notb (cm_proof_valid (pr_make
        (append CmEvidence pr_base [cm_known_fact CmNoObservation True]))))
    , MkPair String Bool "contradictory-evidence-blocks" (notb (cm_proof_valid (pr_make
        (append CmEvidence pr_base [cm_known_fact CmNoObservation False]))))
    , MkPair String Bool "owner-identity-bound" (cm_proof_owned pr_owner (pr_make pr_base))
    , MkPair String Bool "different-owner-invalidates" (notb (cm_proof_owned
        (ScDeclOf 9 2 0 0 (ESort 0) (Nothing Expr) (Nothing Nat)) (pr_make pr_base)))
    , MkPair String Bool "every-performance-premise-required"
        (all CmRequirement pr_mutation (cm_requirements CmRepeatedWorkProof))
    ];
def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True pr_laws;
       exit (match ok with | True => 0 | False => 1 end)
