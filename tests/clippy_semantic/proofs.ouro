-- @entry main
import "../quality_test_support.ouro",
  "../../tools/clippy/semantic_proof.ouro",
  "expansion_laws.ouro",
  "result_laws.ouro",
  "collection_laws.ouro",
  "quality_laws.ouro",
  "../../std/io.ouro";

def pr_owner : ScDecl := ScDeclOf 1 2 0 0 (ESort 0) (Nothing Expr) (Nothing Nat);
def pr_base : List CmEvidence :=
    [cm_known_fact CmCheckedProducer True, cm_known_fact CmNoObservation True];
def pr_make (facts : List CmEvidence) : CmSemanticProof :=
    cm_proof_for CmIgnoredResultProof pr_owner 3 4 5 facts "checked producer has no observation";
def pr_mutation (fact : CmRequirement) : Bool :=
    let requirements : List CmRequirement := cm_requirements CmRepeatedWorkProof in
    let evidence : List CmEvidence := map CmRequirement CmEvidence
      (fun (item : CmRequirement) => CmEvidenceOf item
        (match eq_nat(cm_requirement_id item, cm_requirement_id fact) with
         | True => Nothing Bool | False => Just Bool True end)) requirements in
    notb (cm_proof_valid (CmSemanticProofOf CmRepeatedWorkProof 2 1 3 4 5
      (Nothing (Pair Nat Nat)) evidence "mutation"));
def pr_rule_kinds : List CmProofKind :=
    append CmProofKind (append CmProofKind cr_rule_kinds qx_kinds) (append CmProofKind
    [CmNeutralNatProof, CmErasingNatProof, CmZeroDivisorProof, CmConstantNatOrderProof, CmInvertedBoundsProof, CmEmptyConcatProof, CmIdentityBoolProof, CmAbsorbingBoolProof, CmZeroListCountProof, CmDoubleNotProof, CmIdempotentNormalizeProof, CmDoubleReverseProof,
     CmDegenerateClampProof, CmExtremumOperandProof, CmTrivialPowerProof,
     CmUnchangedReplaceProof, CmEmptySearchProof, CmTextByteBoundsProof,
     CmEmptySliceProof, CmTextSliceBoundsProof, CmReflexiveSearchProof,
     CmKnownResultTestProof, CmKnownResultDefaultProof, CmExtremumAbsorptionProof,
     CmKnownMaybeDefaultProof, CmLengthReverseProof, CmLengthAppendProof,
     CmDominatedTakeProof, CmDropAfterTakeProof, CmContainedClampProof,
     CmClampedRangeProof, CmBooleanComplementProof]
    (map CmCollectionLaw CmProofKind CmCollectionProof cc_laws));

def pr_rule_evidence (kind : CmProofKind) : List CmEvidence :=
    map CmRequirement CmEvidence (fun (fact : CmRequirement) => cm_known_fact fact True)
      (cm_requirements kind);

def pr_rule_valid (kind : CmProofKind) (evidence : List CmEvidence) : Bool :=
    cm_proof_valid (CmSemanticProofOf kind 2 1 3 4 5
      (Nothing (Pair Nat Nat)) evidence "operation law mutation");

def pr_rule_mutations (kind : CmProofKind) : Bool :=
    let complete : List CmEvidence := pr_rule_evidence kind in
    andb (pr_rule_valid kind complete)
      (all CmRequirement (fun (required : CmRequirement) =>
        let id : Nat := cm_requirement_id required in
        let rest : List CmEvidence := filter CmEvidence
            (fun (fact : CmEvidence) => notb (eq_nat(cm_evidence_id fact, id))) complete in
        andb (notb (pr_rule_valid kind rest))
          (andb (notb (pr_rule_valid(kind, Cons CmEvidence (CmEvidenceOf(required, Nothing Bool)) rest)))
            (andb (notb (pr_rule_valid(kind, Cons CmEvidence (cm_known_fact required False) rest)))
              (notb (pr_rule_valid(kind, Cons CmEvidence (cm_known_fact required True) complete))))))
        (cm_requirements kind));

def pr_rule_shard (shard : Nat) : List CmProofKind -> Nat -> List CmProofKind :=
  fix select (kinds : List CmProofKind) (position : Nat) : List CmProofKind :=
    match kinds with
    | Nil => []
    | Cons kind rest => match eq_nat(mod_nat position 4, shard) with
      | True => Cons CmProofKind kind (select(rest, add position 1))
      | False => select(rest, add position 1)
      end
    end;

def pr_operation_laws (shard : Nat) : List (Pair String Bool) :=
    map CmProofKind (Pair String Bool) (fun (kind : CmProofKind) =>
      MkPair String Bool (prim_string_concat(cm_proof_rule kind, ": all required premises fail closed"))
        (pr_rule_mutations kind)) (pr_rule_shard shard pr_rule_kinds 0);

def pr_base_laws : List (Pair String Bool) :=
    [ MkPair String Bool "complete-proof-publishes" (cm_proof_valid (pr_make pr_base))
    , MkPair String Bool "missing-required-fact-blocks" (notb (cm_proof_valid (pr_make [])))
    , MkPair String Bool "unknown-fact-blocks" (notb (cm_proof_valid (pr_make
        [cm_known_fact CmCheckedProducer True, CmEvidenceOf(CmNoObservation, Nothing Bool)])))
    , MkPair String Bool "disproved-fact-blocks" (notb (cm_proof_valid (pr_make
        [cm_known_fact CmCheckedProducer True, cm_known_fact CmNoObservation False])))
    , MkPair String Bool "duplicate-evidence-blocks" (notb (cm_proof_valid (pr_make
        (append CmEvidence pr_base [cm_known_fact CmNoObservation True]))))
    , MkPair String Bool "contradictory-evidence-blocks" (notb (cm_proof_valid (pr_make
        (append CmEvidence pr_base [cm_known_fact CmNoObservation False]))))
    , MkPair String Bool "owner-identity-bound" (cm_proof_owned(pr_owner, pr_make pr_base))
    , MkPair String Bool "different-owner-invalidates" (notb (cm_proof_owned
        (ScDeclOf 9 2 0 0 (ESort 0) (Nothing Expr) (Nothing Nat)) (pr_make pr_base)))
    , MkPair String Bool "every-performance-premise-required"
        (all CmRequirement pr_mutation (cm_requirements CmRepeatedWorkProof))
    , MkPair String Bool "expansion-requirement-identities-are-distinct"
        (cm_evidence_unique (map CmRequirement CmEvidence
          (fun (required : CmRequirement) => cm_known_fact required True)
          [CmComplementaryOperands, CmCallbackSkipped, CmIdentityCallback,
           CmMatchDominates, CmResultRoundTrip, CmTotalCallbacks,
           CmCollectionEquivalence, CmCollectionLawEstablished, CmProducerUnbound,
           CmDynamicInput]) [])
    ];

-- Select before evaluating the eager law lists. Separate processes retain the
-- complete inventory while bounding allocations in the transitional C runtime.
def pr_groups : List String :=
    ["base", "quality", "expansion", "result", "collection",
     "premises-0", "premises-1", "premises-2", "premises-3"];

def pr_group_laws (group : String) : Maybe (List (Pair String Bool)) :=
    match prim_string_eq group "base" with
    | True => Just(List (Pair String Bool), pr_base_laws)
    | False => match prim_string_eq group "quality" with
      | True => Just(List (Pair String Bool), qx_laws)
      | False => match prim_string_eq group "expansion" with
        | True => Just(List (Pair String Bool), cx_laws)
        | False => match prim_string_eq group "result" with
          | True => Just(List (Pair String Bool), cr_laws)
          | False => match prim_string_eq group "collection" with
            | True => Just(List (Pair String Bool), ct_laws)
            | False => match prim_string_eq group "premises-0" with
              | True => Just(List (Pair String Bool), pr_operation_laws 0)
              | False => match prim_string_eq group "premises-1" with
                | True => Just(List (Pair String Bool), pr_operation_laws 1)
                | False => match prim_string_eq group "premises-2" with
                  | True => Just(List (Pair String Bool), pr_operation_laws 2)
                  | False => match prim_string_eq group "premises-3" with
                    | True => Just(List (Pair String Bool), pr_operation_laws 3)
                    | False => Nothing (List (Pair String Bool))
                    end
                  end
                end
              end
            end
          end
        end
      end
    end;

def pr_usage : IO Unit :=
    (do eprintln "usage: clippy proofs --list-groups | --group NAME";
        exit 2);

def pr_run_group (group : String) : IO Unit :=
    match pr_group_laws group with
    | Nothing => pr_usage
    | Just laws => do let! ok := io_fold (Pair String Bool) Bool quality_test_print True laws;
                     exit (match ok with | True => 0 | False => 1 end)
    end;

def main : IO Unit :=
    do let! arguments := argv;
       let options : List String := tail String arguments in
       match andb (eq_nat(length String options, 1))
           (prim_string_eq(head String "" options, "--list-groups")) with
       | True => println (str_join "\n" pr_groups)
       | False => match andb (eq_nat(length String options, 2))
           (prim_string_eq(head String "" options, "--group")) with
         | True => pr_run_group (nth String "" 1 options)
         | False => pr_usage
         end
       end
