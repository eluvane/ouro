-- Production consumer laws and counterexamples; no source-text rule oracle.
import "../../tools/clippy/semantic_rules.ouro";

def qx_decl : ScDecl := ScDeclOf 1 2 0 0 (ESort 0) (Nothing Expr) (Nothing Nat);
def qx_type : CmValue := CmValueOf 2 100 0 False False True;
def qx_x : CmValue := cm_local_value 101 0;
def qx_xs : CmValue := cm_local_value 102 0;
def qx_ys : CmValue := cm_local_value 103 0;
def qx_count : CmValue := cm_local_value 104 0;
def qx_limit : CmValue := cm_local_value 105 0;
def qx_default : CmValue := cm_local_value 106 0;
def qx_result : CmValue := CmValueOf 6 30 0 False False False;
def qx_nat (n : Nat) : CmValue := CmValueOf 3 n 0 False False True;
def qx_call (node : Nat) (role : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall node (add 200 role) 1 0 role True
      (match elem Nat eq_nat role [55,56,60,62] with | True => 0 | False => 1 end) args False;

inductive QxCase : Type :=
  | QxCaseOf : CmQualityKind -> ClippyCallFact -> ClippyCallFact -> QxCase;
def qx_cases : List QxCase :=
    [
      QxCaseOf CmNullReverse
        (qx_call 20 55 [qx_type, qx_result])
        (qx_call 30 43 [qx_type, qx_xs]),
      QxCaseOf CmEndpointReverse
        (qx_call 20 56 [qx_type, qx_default, qx_result])
        (qx_call 30 43 [qx_type, qx_xs]),
      QxCaseOf CmNullAppend
        (qx_call 20 55 [qx_type, qx_result])
        (qx_call 30 21 [qx_type, qx_xs, qx_ys]),
      QxCaseOf CmLengthReplicate
        (qx_call 20 18 [qx_type, qx_result])
        (qx_call 30 58 [qx_type, qx_x, qx_count]),
      QxCaseOf CmNullReplicate
        (qx_call 20 55 [qx_type, qx_result])
        (qx_call 30 58 [qx_type, qx_x, qx_count]),
      QxCaseOf CmEndpointReplicate
        (qx_call 20 57 [qx_type, qx_default, qx_result])
        (qx_call 30 58 [qx_type, qx_x, qx_count]),
      QxCaseOf CmReverseReplicate
        (qx_call 20 43 [qx_type, qx_result])
        (qx_call 30 58 [qx_type, qx_x, qx_count]),
      QxCaseOf CmBoundedReplicate
        (qx_call 20 40 [qx_type, qx_count, qx_result])
        (qx_call 30 58 [qx_type, qx_x, qx_limit]),
      QxCaseOf CmNthReplicate
        (qx_call 20 61 [qx_type, qx_default, qx_count, qx_result])
        (qx_call 30 58 [qx_type, qx_x, qx_limit]),
      QxCaseOf CmLengthIntersperse
        (qx_call 20 18 [qx_type, qx_result])
        (qx_call 30 59 [qx_type, qx_x, qx_xs]),
      QxCaseOf CmNullIntersperse
        (qx_call 20 55 [qx_type, qx_result])
        (qx_call 30 59 [qx_type, qx_x, qx_xs]),
      QxCaseOf CmEndpointIntersperse
        (qx_call 20 57 [qx_type, qx_default, qx_result])
        (qx_call 30 59 [qx_type, qx_x, qx_xs]),
      QxCaseOf CmNullTake
        (qx_call 20 55 [qx_type, qx_result])
        (qx_call 30 40 [qx_type, qx_nat 3, qx_xs]),
      QxCaseOf CmHeadTake
        (qx_call 20 56 [qx_type, qx_default, qx_result])
        (qx_call 30 40 [qx_type, qx_nat 3, qx_xs]),
      QxCaseOf CmTightenTake
        (qx_call 20 40 [qx_type, qx_nat 2, qx_result])
        (qx_call 30 40 [qx_type, qx_nat 5, qx_xs]),
      QxCaseOf CmNestedDrop
        (qx_call 20 41 [qx_type, qx_nat 2, qx_result])
        (qx_call 30 41 [qx_type, qx_nat 3, qx_xs]),
      QxCaseOf CmSingletonSize
        (qx_call 20 18 [qx_type, qx_result])
        (qx_call 30 60 [qx_type, qx_x]),
      QxCaseOf CmSingletonEndpoint
        (qx_call 20 56 [qx_type, qx_default, qx_result])
        (qx_call 30 60 [qx_type, qx_x]),
      QxCaseOf CmSingletonTail
        (qx_call 20 62 [qx_type, qx_result])
        (qx_call 30 60 [qx_type, qx_x]),
      QxCaseOf CmSingletonReverse
        (qx_call 20 43 [qx_type, qx_result])
        (qx_call 30 60 [qx_type, qx_x])
    ];

def qx_kinds : List CmProofKind :=
    map QxCase CmProofKind (fun (item : QxCase) => match item with
      | QxCaseOf kind _ _ => CmQualityProof kind end) qx_cases;

def qx_proofs (outer : ClippyCallFact) (inner : ClippyCallFact) (bound : List Nat) : List CgSProof :=
    cm_nested_laws_with_bindings qx_decl "collection law" [inner, outer] bound;
def qx_exact (kind : CmQualityKind) (outer : ClippyCallFact) (inner : ClippyCallFact) : Bool :=
    match qx_proofs outer inner [] with
    | Nil => False
    | Cons proof rest => match proof with | MkCgSProof rule _ _ _ _ =>
        andb(nullb CgSProof rest, prim_string_eq(rule, cm_quality_rule kind)) end
    end;
def qx_clean (outer : ClippyCallFact) (inner : ClippyCallFact) : Bool :=
    nullb(CgSProof, qx_proofs outer inner []);
def qx_with_role (role : Nat) (call : ClippyCallFact) : ClippyCallFact :=
    match call with | CmCall node callee branch epoch _ pure cost args recursive =>
      CmCall node callee branch epoch role pure cost args recursive end;
def qx_with_purity (pure : Bool) (call : ClippyCallFact) : ClippyCallFact :=
    match call with | CmCall node callee branch epoch role _ cost args recursive =>
      CmCall node callee branch epoch role pure cost args recursive end;
def qx_with_region (branch : Nat) (epoch : Nat) (call : ClippyCallFact) : ClippyCallFact :=
    match call with | CmCall node callee _ _ role pure cost args recursive =>
      CmCall node callee branch epoch role pure cost args recursive end;
def qx_with_args (args : List CmValue) (call : ClippyCallFact) : ClippyCallFact :=
    match call with | CmCall node callee branch epoch role pure cost _ recursive =>
      CmCall node callee branch epoch role pure cost args recursive end;
def qx_without_cost (call : ClippyCallFact) : ClippyCallFact :=
    match call with | CmCall node callee branch epoch role pure _ args recursive =>
      CmCall node callee branch epoch role pure 0 args recursive end;
def qx_replace_first (value : CmValue) (call : ClippyCallFact) : ClippyCallFact :=
    qx_with_args(Cons CmValue value (drop CmValue 1 (cm_call_args call)), call);
def qx_replace_result (value : CmValue) (call : ClippyCallFact) : ClippyCallFact :=
    qx_with_args (map CmValue CmValue (fun (arg : CmValue) =>
      match cm_law_same arg qx_result with | True => value | False => arg end) (cm_call_args call)) call;
def qx_constant (call : ClippyCallFact) : ClippyCallFact :=
    qx_with_args (map CmValue CmValue (fun (arg : CmValue) =>
      CmValueOf (cm_value_kind arg) (cm_value_id arg) (cm_value_result arg)
        (cm_value_io arg) (cm_value_taint arg) True)
      (cm_call_args call)) call;

def qx_case_laws (item : QxCase) : List (Pair String Bool) :=
    match item with | QxCaseOf kind outer inner =>
      [ MkPair String Bool "exact-rule" (qx_exact kind outer inner)
      , MkPair String Bool "unknown-consumer" (qx_clean(qx_with_role 0 outer, inner))
      , MkPair String Bool "unknown-producer" (qx_clean(outer, qx_with_role 0 inner))
      , MkPair String Bool "effectful-consumer" (qx_clean(qx_with_purity False outer, inner))
      , MkPair String Bool "effectful-producer" (qx_clean(outer, qx_with_purity False inner))
      , MkPair String Bool "different-branch" (qx_clean(qx_with_region 2 0 outer, inner))
      , MkPair String Bool "different-effect-epoch" (qx_clean(qx_with_region 1 1 outer, inner))
      , MkPair String Bool "missing-consumer-argument"
          (qx_clean(qx_with_args(drop CmValue 1 (cm_call_args outer), outer), inner))
      , MkPair String Bool "missing-producer-argument"
          (qx_clean(outer, qx_with_args(drop CmValue 1 (cm_call_args inner), inner)))
      , MkPair String Bool "unknown-type" (qx_clean(qx_replace_first(cm_unknown 100, outer), inner))
      , MkPair String Bool "different-type-identity"
          (qx_clean(qx_replace_first(CmValueOf 2 999 0 False False True, outer), inner))
      , MkPair String Bool "io-type-value" (qx_clean(qx_replace_first(cm_as_io qx_type, outer), inner))
      , MkPair String Bool "lost-lineage" (qx_clean(qx_replace_result(cm_local_value 30 0, outer), inner))
      , MkPair String Bool "different-producer-node"
          (qx_clean(qx_replace_result(CmValueOf 6 999 0 False False False, outer), inner))
      , MkPair String Bool "io-lineage" (qx_clean(qx_replace_result(cm_as_io qx_result, outer), inner))
      , MkPair String Bool "constructor-is-not-collection-lineage"
          (qx_clean(qx_replace_result(CmValueOf 7 30 0 False False False, outer), inner))
      , MkPair String Bool "missing-producer-cost"
          (match cm_quality_cost_required kind with
           | True => qx_clean(outer, qx_without_cost inner)
           | False => qx_exact kind outer (qx_without_cost inner) end)
      , MkPair String Bool "type-only-dynamic"
          (qx_clean
            (qx_replace_first(CmValueOf 1 100 0 False False False, outer))
            (qx_replace_first(CmValueOf 1 100 0 False False False, qx_constant inner)))
      , MkPair String Bool "bound-producer" (nullb(CgSProof, qx_proofs outer inner [30]))
      , MkPair String Bool "constant-data" (qx_clean(outer, qx_constant inner))
      , MkPair String Bool "missing-cost"
          (match cm_quality_cost_required kind with
           | True => qx_clean(qx_without_cost outer, qx_without_cost inner)
           | False => qx_exact(kind, qx_without_cost outer, qx_without_cost inner) end)
      ]
    end;

def qx_fact_laws : List (Pair String Bool) :=
    concat_map QxCase (Pair String Bool) (fun (item : QxCase) => match item with
      | QxCaseOf kind _ _ => map (Pair String Bool) (Pair String Bool)
          (fun (law : Pair String Bool) => match law with | MkPair name passed =>
            MkPair String Bool (prim_string_concat (cm_quality_rule kind)
              (prim_string_concat ": " name)) passed end) (qx_case_laws item)
      end) qx_cases;

-- Evaluate the actual stdlib on empty, singleton and longer lists; the native
-- consumer tests above are not a substitute for the collection identities.
def qx_bool_eq (a : Bool) (b : Bool) : Bool :=
    match a with | True => b | False => notb b end;
def qx_list_eq : List Nat -> List Nat -> Bool :=
  fix go (xs : List Nat) (ys : List Nat) : Bool :=
    match xs with
    | Nil => nullb Nat ys
    | Cons x rest => match ys with
      | Nil => False | Cons y tail => andb(eq_nat x y, go rest tail) end
    end;
def qx_samples : List (List Nat) := [Nil Nat, [0], [4,2], [3,3,1]];
def qx_counts : List Nat := [0,1,2,4];

def qx_value_law (kind : CmQualityKind) (xs : List Nat) (ys : List Nat)
    (n : Nat) (k : Nat) : Bool :=
    match kind with
    | CmNullReverse => qx_bool_eq(nullb(Nat, reverse_lin Nat xs), nullb Nat xs)
    | CmEndpointReverse => andb
        (eq_nat(head Nat 9 (reverse_lin Nat xs), last Nat 9 xs))
        (eq_nat(last Nat 9 (reverse Nat xs), head Nat 9 xs))
    | CmNullAppend => qx_bool_eq (nullb(Nat, append Nat xs ys))
        (andb(nullb Nat xs, nullb Nat ys))
    | CmLengthReplicate => eq_nat(length(Nat, replicate Nat 3 n), n)
    | CmNullReplicate => qx_bool_eq(nullb(Nat, replicate Nat 3 n), eq_nat n 0)
    | CmEndpointReplicate => andb
        (eq_nat(head Nat 9 (replicate Nat 3 n), match n with | Z => 9 | S _ => 3 end))
        (eq_nat(last Nat 9 (replicate Nat 3 n), match n with | Z => 9 | S _ => 3 end))
    | CmReverseReplicate => qx_list_eq(reverse_lin(Nat, replicate Nat 3 n), replicate Nat 3 n)
    | CmBoundedReplicate => andb
        (qx_list_eq(take Nat k (replicate Nat 3 n), replicate Nat 3 (minNat n k)))
        (qx_list_eq(drop Nat k (replicate Nat 3 n), replicate Nat 3 (sub n k)))
    | CmNthReplicate => eq_nat (nth Nat 9 k (replicate Nat 3 n))
        (match ltb_nat k n with | True => 3 | False => 9 end)
    | CmLengthIntersperse => eq_nat (length(Nat, intersperse Nat 8 xs))
        (sub(mul(2, length Nat xs), 1))
    | CmNullIntersperse => qx_bool_eq(nullb(Nat, intersperse Nat 8 xs), nullb Nat xs)
    | CmEndpointIntersperse => andb
        (eq_nat(head Nat 9 (intersperse Nat 8 xs), head Nat 9 xs))
        (eq_nat(last Nat 9 (intersperse Nat 8 xs), last Nat 9 xs))
    | CmNullTake => match n with
      | Z => True | S _ => qx_bool_eq(nullb(Nat, take Nat n xs), nullb Nat xs) end
    | CmHeadTake => match n with
      | Z => True | S _ => eq_nat(head Nat 9 (take Nat n xs), head Nat 9 xs) end
    | CmTightenTake => match andb(ltb_nat 0 k, ltb_nat k n) with
      | False => True | True => qx_list_eq(take Nat k (take Nat n xs), take Nat k xs) end
    | CmNestedDrop => qx_list_eq(drop Nat k (drop Nat n xs), drop Nat (add n k) xs)
    | CmSingletonSize => andb (eq_nat(length(Nat, singleton Nat n), 1))
        (notb (nullb(Nat, singleton Nat n)))
    | CmSingletonEndpoint => andb (eq_nat(head Nat 9 (singleton Nat n), n))
        (andb(eq_nat(last Nat 9 (singleton Nat n), n), eq_nat(nth Nat 9 0 (singleton Nat n), n)))
    | CmSingletonTail => nullb(Nat, tail(Nat, singleton Nat n))
    | CmSingletonReverse => qx_list_eq(reverse_lin(Nat, singleton Nat n), singleton Nat n)
    end;

def qx_value_laws : List (Pair String Bool) :=
    map QxCase (Pair String Bool) (fun (item : QxCase) => match item with
      | QxCaseOf kind _ _ => MkPair String Bool
          (prim_string_concat(cm_quality_rule kind, ": native stdlib value law"))
          (all (List Nat) (fun (xs : List Nat) =>
            all (List Nat) (fun (ys : List Nat) =>
              all Nat (fun (n : Nat) =>
                all Nat (fun (k : Nat) => qx_value_law kind xs ys n k) qx_counts)
                qx_counts) qx_samples) qx_samples)
      end) qx_cases;

def qx_guard_laws : List (Pair String Bool) :=
    [ MkPair String Bool "unknown-take-count-is-not-positive"
        (qx_clean(qx_call 20 55 [qx_type,qx_result], qx_call 30 40 [qx_type,qx_count,qx_xs]))
    , MkPair String Bool "zero-take-does-not-preserve-head"
        (qx_clean(qx_call 20 56 [qx_type,qx_default,qx_result], qx_call 30 40 [qx_type,qx_nat 0,qx_xs]))
    , MkPair String Bool "unknown-drop-offset-is-not-a-literal-law"
        (qx_clean(qx_call 20 41 [qx_type,qx_nat 2,qx_result], qx_call 30 41 [qx_type,qx_count,qx_xs]))
    , MkPair String Bool "singleton-index-one-is-not-its-payload"
        (qx_clean(qx_call 20 61 [qx_type,qx_default,qx_nat 1,qx_result], qx_call 30 60 [qx_type,qx_x]))
    , MkPair String Bool "zero-replication-does-not-allocate-a-list"
        (qx_clean(qx_call 20 18 [qx_type,qx_result], qx_call 30 58 [qx_type,qx_x,qx_nat 0]))
    , MkPair String Bool "dynamic-separator-does-not-prove-traversal"
        (qx_clean (qx_call 20 18 [qx_type,qx_result])
          (qx_call 30 59 [qx_type,qx_x,CmValueOf 5 90 0 False False True]))
    , MkPair String Bool "dynamic-right-append-does-not-prove-copying"
        (qx_clean (qx_call 20 55 [qx_type,qx_result])
          (qx_call 30 21 [qx_type,CmValueOf 5 90 0 False False True,qx_ys]))
    , MkPair String Bool "new-contract-role-ceiling-rejects-unknown"
        (match cm_validate_contracts [CmContractOf "std/listx.ouro" "law" 63 True 0 False] with
         | Left _ => True | Right _ => False end)
    ];

def qx_laws : List (Pair String Bool) :=
    append (Pair String Bool) qx_fact_laws
      (append (Pair String Bool) qx_value_laws qx_guard_laws);
