        (cp_nested_clean(CmCall 20 500 1 0 43 True 0 [cp_operation_global 200, cp_nested_result] False, cp_nested_inner 43 500 [cp_operation_global 200, cp_operation_local 40]))
    ];

def cp_operation_laws : List (Pair String Bool) :=
    append (Pair String Bool) cp_arithmetic_text_laws
      (append (Pair String Bool) cp_boolean_collection_laws
        (append (Pair String Bool) cp_nested_boolean_laws
          (append (Pair String Bool) cp_nested_normalization_laws cp_nested_reversal_laws)));

def cp_bounded_cwd_decl (identity : Maybe Nat) : ScDecl :=
    ScDeclOf 300 2 4 0
      (EPi(20, ESort 0, EPi(21, ESort 0, EPi(22, ESort 0, EPi(23, ESort 0, ESort 0)))))
      (Nothing Expr) identity;

def cp_bounded_cwd_unit (owner : String) (provider : String) (name : String)
    (decl : ScDecl) : ClippySemanticUnit :=
    let intern : InternState := MkIntern
      [MkPair (List Nat) Nat (prim_string_to_char_codes name) 300] 301
      [MkPair (List Nat) Nat (prim_string_to_char_codes owner) 1,
       MkPair (List Nat) Nat (prim_string_to_char_codes provider) 2,
       MkPair (List Nat) Nat (prim_string_to_char_codes "ouro.process.capture_bounded_at") 3] 4 in
    CmUnit intern 1 "" [] [cp_decl, decl]
      (ScNode cp_decl ScEmpty (ScNode decl ScEmpty ScEmpty)) [] 1 [] cm_empty_resolved_imports;

def cp_bounded_cwd_contract (provider : String) (name : String) (identity : Maybe Nat) : CmContract :=
    let decl : ScDecl := cp_bounded_cwd_decl identity in
    cm_contract_for (cp_bounded_cwd_unit "tools/analyze/main.ouro" provider name decl) decl;

def cp_bounded_cwd_boundary (owner : String) (provider : String) (name : String)
    (identity : Maybe Nat) : CmState :=
    let decl : ScDecl := cp_bounded_cwd_decl identity in
    let unit : ClippySemanticUnit := cp_bounded_cwd_unit owner provider name decl in
    let role : Nat := cm_contract_role (cm_contract_for unit decl) in
    cm_boundary_call unit cp_ctx
      (cp_operation_call role [cp_text_literal 7, cp_operation_local 40,
        cp_text_literal 8, cp_operation_local 41]) cp_state;

private def cp_boundary_role (owner : String) (ctx : CmContext) (role : Nat)
    (args : List CmValue) (state : CmState) : CmState :=
    let unit : ClippySemanticUnit := cp_bounded_cwd_unit owner "std/runtime.ouro"
      "renamed_capture" (cp_bounded_cwd_decl (Just Nat 3)) in
    cm_boundary_call unit ctx (cp_operation_call role args) state;

private def cp_policy_failure : CmContext :=
    CmContextOf cp_decl [] 1 True (Nothing Nat) True False 0;

private def cp_lexical_reference : Bool :=
    let started : CmState := cm_execute 40 cp_checked_value cp_state in
    let (MkPair scope bound) := cm_bind 100 (cm_unknown 39) cp_ctx started in
    let (MkPair shadowed linked) := cm_bind 100 cp_checked_value scope bound in
    match cm_variable pp_unit CmApiEmpty shadowed 100 linked with
    | Left _ => False
    | Right step => let (MkPair value after) := step in
      let events : List CmEvent := cm_events after in
      let created : List Nat := cm_flow_ids [1] events in
      let used : CmState := cm_observe 3 42 value after in
      andb (eq_nat (length CmEvent events) (add (length CmEvent (cm_events linked)) 2))
        (andb (eq_nat_list (cm_tokens False events) [91,101,91,90])
          (andb (eq_nat_list (cm_tokens True events) [100,101,100,100])
            (andb (cp_one_unobserved created (cm_flow_ids [3,4,6,9] events) 1)
              (cp_one_unobserved created (cm_flow_ids [3,4,6,9] (cm_events used)) 0))))
    end;

private def cp_boundary_laws : List (Pair String Bool) :=
    [ MkPair String Bool "raw-read-outside-owner-has-proof"
        (cp_operation_exact(cp_boundary_role "tools/read.ouro" cp_ctx 1 [] cp_state,
          "OURO-CLIPPY-CHECKED-001"))
    , MkPair String Bool "raw-write-outside-owner-has-proof"
        (cp_operation_exact(cp_boundary_role "tools/write.ouro" cp_ctx 2 [] cp_state,
          "OURO-CLIPPY-CHECKED-002"))
    , MkPair String Bool "raw-filesystem-owner-is-clean"
        (andb (cp_no_finding (cp_boundary_role "std/fs.ouro" cp_ctx 1 [] cp_state))
          (cp_no_finding (cp_boundary_role "std/fs.ouro" cp_ctx 2 [] cp_state)))
    , MkPair String Bool "known-other-role-does-not-count-as-exit"
        (cp_no_finding (cp_boundary_role "tools/exit.ouro" cp_failed_ctx 7 [cp_nat_literal 0] cp_state))
    , MkPair String Bool "zero-exit-on-checked-failure-has-proof-even-in-runtime-owner"
        (cp_operation_exact(cp_boundary_role "std/runtime.ouro" cp_failed_ctx 4 [cp_nat_literal 0] cp_state,
          "OURO-CLIPPY-ERROR-001"))
    , MkPair String Bool "zero-exit-outside-checked-failure-is-clean"
        (cp_no_finding (cp_boundary_role "tools/exit.ouro" cp_ctx 4 [cp_nat_literal 0] cp_state))
    , MkPair String Bool "nonzero-exit-on-checked-failure-is-clean"
        (cp_no_finding (cp_boundary_role "tools/exit.ouro" cp_failed_ctx 4 [cp_nat_literal 1] cp_state))
    , MkPair String Bool "checked-failure-exit-respects-recovery-and-policy"
        (andb (cp_no_finding (cp_boundary_role "tools/exit.ouro" cp_failed_ctx 4 [cp_nat_literal 0]
          (cm_barrier cp_state)))
          (cp_no_finding (cp_boundary_role "tools/exit.ouro" cp_policy_failure 4 [cp_nat_literal 0] cp_state)))
    ];

def cp_laws : List (Pair String Bool) :=
    append (Pair String Bool) (append (Pair String Bool) cp_operation_laws cp_boundary_laws)
      [ MkPair String Bool "local-reference-emits-only-tokens-and-preserves-observation"
          cp_lexical_reference
      , MkPair String Bool "bounded-cwd-intrinsic-keeps-process-role"
          (eq_nat(cm_contract_role (cp_bounded_cwd_contract
            "std/runtime.ouro" "renamed_capture" (Just Nat 3)), 3))
      , MkPair String Bool "bounded-cwd-outside-owner-has-raw-process-proof"
          (cp_operation_exact(cp_bounded_cwd_boundary "tools/analyze/main.ouro"
            "std/runtime.ouro" "renamed_capture" (Just Nat 3), "OURO-CLIPPY-CHECKED-003"))
      , MkPair String Bool "bounded-cwd-process-owner-is-clean"
          (cp_no_finding (cp_bounded_cwd_boundary "std/process.ouro"
            "std/runtime.ouro" "renamed_capture" (Just Nat 3)))
      , MkPair String Bool "bounded-cwd-runtime-owner-is-clean"
          (cp_no_finding (cp_bounded_cwd_boundary "std/runtime.ouro"
            "std/runtime.ouro" "renamed_capture" (Just Nat 3)))
      , MkPair String Bool "bounded-cwd-owner-lookalike-keeps-raw-process-proof"
          (cp_operation_exact(cp_bounded_cwd_boundary "std/nested/process.ouro"
            "std/runtime.ouro" "renamed_capture" (Just Nat 3), "OURO-CLIPPY-CHECKED-003"))
      , MkPair String Bool "bounded-cwd-provider-lookalike-has-no-intrinsic-contract"
          (eq_nat(cm_contract_role (cp_bounded_cwd_contract
            "std/nested/runtime.ouro" "prim_process_capture_bounded_at" (Just Nat 3)), 0))
      , MkPair String Bool "bounded-cwd-same-spelling-is-not-intrinsic-proof"
          (eq_nat(cm_contract_role (cp_bounded_cwd_contract
            "std/runtime.ouro" "prim_process_capture_bounded_at" (Nothing Nat)), 0))
      , MkPair String Bool "named-known-callee-keeps-required-effectful-result"
          (cp_named_transfer cp_ctx cp_state (ENat 1) False)
      , MkPair String Bool "named-known-callee-keeps-actual-argument-taint"
          cp_named_tainted
      , MkPair String Bool "generic-Either-is-not-must-use"
        (notb (cm_checked (CmValueOf 1 40 1 False False False)))
    , MkPair String Bool "known-Right-is-not-must-use"
        (notb (cm_checked (CmValueOf 8 40 1 False False False)))
    , MkPair String Bool "registered-checked-result-is-obligatory" (cm_checked cp_checked_value)
    , MkPair String Bool "IO-construction-is-not-execution" (notb (cm_checked cp_io_value))
    , MkPair String Bool "execution-activates-obligation" (cm_checked (cm_unwrap_io 90 cp_io_value))
    , MkPair String Bool "alias-preserves-producer" (eq_nat(cm_value_id (cm_unwrap_io 90 cp_io_value), 40))
    , MkPair String Bool "unused-alias-does-not-hide-observed-original" (cp_one_unobserved [40,40] [40] 0)
    , MkPair String Bool "alias-chain-without-observation-reports-once" (cp_one_unobserved [40,40,40] [] 1)
    , MkPair String Bool "different-value-observation-does-not-hide-error" (cp_one_unobserved [40] [41] 1)
    , MkPair String Bool "observation-order-merge" (cp_one_unobserved [40,50] [1,40,49,50,90] 0)
    , MkPair String Bool "generic-Left-does-not-establish-error" (notb (cm_error_arm (cm_context_pattern cp_ctx 10)))
    , MkPair String Bool "checked-Left-establishes-error" (cm_error_arm cp_failed_ctx)
    , MkPair String Bool "checked-retry-success-clears-error"
        (notb (cm_error_arm (cm_context_pattern(cm_context_subject cp_failed_ctx cp_checked_value, 11))))
    , MkPair String Bool "unrelated-Right-does-not-clear-error"
        (cm_error_arm (cm_context_pattern cp_failed_ctx 11))
    , MkPair String Bool "lambda-does-not-inherit-error-path" (notb (cm_error_arm (cm_context_region cp_failed_ctx 4)))
    , MkPair String Bool "literal-error-code-not-assumed-success"
        (cp_no_finding (cm_arm_outcome cp_failed_ctx 3 (CmValueOf 3 1 0 False False True) cp_state))
    , MkPair String Bool "rendered-string-not-assumed-success"
        (cp_no_finding (cm_arm_outcome cp_failed_ctx 3 (CmValueOf 4 1 0 False False True) cp_state))
    , MkPair String Bool "effect-or-recovery-boundary-invalidates-failure-proof"
        (cp_no_finding (cm_arm_outcome(cp_failed_ctx, 3, CmValueOf 8 4 1 False False False, cm_barrier cp_state)))
    , MkPair String Bool "registered-error-to-Right-is-visible"
        (notb (cp_no_finding (cm_arm_outcome cp_failed_ctx 3 (CmValueOf 8 4 1 False False False) cp_state)))
    , MkPair String Bool "same-traversal-same-arguments"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 1 0 (cp_args 5)] 1)
    , MkPair String Bool "different-callback-is-not-repeated-work"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 1 0 (cp_args 6)] 0)
    , MkPair String Bool "different-callee-is-not-repeated-work"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 2 1 0 (cp_args 5)] 0)
    , MkPair String Bool "effect-barrier-breaks-proof"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 1 1 (cp_args 5)] 0)
    , MkPair String Bool "branch-separation-breaks-proof"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 2 0 (cp_args 5)] 0)
    , MkPair String Bool "different-collection-breaks-proof"
        (cp_repeated_count [cp_call 1 1 0 [CmValueOf 1 3 0 False False False],
                           cp_call 1 1 0 [CmValueOf 1 4 0 False False False]] 0)
    , MkPair String Bool "unknown-purity-is-not-a-proof"
        (notb (cm_traversal_eligible (CmCall 1 1 1 0 20 False 1 (cp_args 5) False)))
    , MkPair String Bool "small-constant-input-excluded"
        (notb (cm_traversal_eligible (cp_call 1 1 0 [CmValueOf 5 4 0 False False True])))
    , MkPair String Bool "costless-operation-excluded"
        (notb (cm_traversal_eligible (CmCall 1 1 1 0 20 True 0 (cp_args 5) False)))
    , MkPair String Bool "registry-duplicate-fails"
        (cp_registry_bad [CmContractOf "std/fs.ouro" "read" 23 False 0 False,
                          CmContractOf "std/fs.ouro" "read" 23 False 0 False])
    , MkPair String Bool "registry-unknown-role-fails"
        (cp_registry_bad [CmContractOf "std/fs.ouro" "read" 999 False 0 False])
    , MkPair String Bool "registry-noncanonical-module-fails"
        (cp_registry_bad [CmContractOf "std/../std/fs.ouro" "read" 23 False 0 False])
    , MkPair String Bool "Either-and-Option-roles-not-must-use"
        (andb (notb (cm_contract_observe (CmContractOf "std/types.ouro" "Either" 12 True 0 False)))
          (notb (cm_contract_observe (CmContractOf "std/types.ouro" "Maybe" 13 True 0 False))))
    ];

def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True cp_laws;
       println (prim_string_concat("CLIPPY_SEMANTIC_PRECISION: ", match ok with | True => "OK" | False => "FAIL" end));
       exit (match ok with | True => 0 | False => 1 end)
