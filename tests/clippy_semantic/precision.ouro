def cp_nested_boolean_laws : List (Pair String Bool) :=
    [ MkPair String Bool "nested-positive-37"
        (cp_nested_exact [cp_nested_inner 37 500 [cp_operation_local 40], cp_nested_outer 37 500 [cp_nested_result]] "OURO-CLIPPY-REDUNDANT-012")
    , MkPair String Bool "nested-preorder-join-37"
        (cp_nested_exact [cp_nested_outer 37 500 [cp_nested_result], cp_nested_inner 37 500 [cp_operation_local 40]] "OURO-CLIPPY-REDUNDANT-012")
    , MkPair String Bool "nested-different-callee-37"
        (cp_nested_clean(cp_nested_outer 37 501 [cp_nested_result], cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-different-operation-37"
        (cp_nested_clean(cp_nested_outer 37 500 [cp_nested_result], cp_nested_inner 0 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-unknown-37"
        (cp_nested_clean(cp_nested_outer 37 500 [CmValueOf 0 30 0 False False False], cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-local-not-producer-37"
        (cp_nested_clean(cp_nested_outer 37 500 [CmValueOf 1 30 0 False False False], cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-checked-not-producer-37"
        (cp_nested_clean(cp_nested_outer 37 500 [CmValueOf 14 30 0 False False False], cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-branch-barrier-37"
        (cp_nested_clean(CmCall 20 500 2 0 37 True 1 [cp_nested_result] False, cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-epoch-barrier-37"
        (cp_nested_clean(CmCall 20 500 1 1 37 True 1 [cp_nested_result] False, cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-purity-barrier-37"
        (cp_nested_clean(CmCall 20 500 1 0 37 False 1 [cp_nested_result] False, cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-partial-call-37"
        (cp_nested_clean(cp_nested_outer 37 500 [], cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-missing-producer-37"
        (nullb(CgSProof, cm_nested_laws cp_decl "law" [cp_nested_outer 37 500 [cp_nested_result]]))
    , MkPair String Bool "nested-wrong-lineage-37"
        (cp_nested_clean(cp_nested_outer 37 500 [CmValueOf 6 31 0 False False False], cp_nested_inner 37 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-IO-not-executed-value-37"
        (cp_nested_clean(cp_nested_outer 37 500 [cm_as_io cp_nested_result], cp_nested_inner 37 500 [cp_operation_local 40]))
    ];

