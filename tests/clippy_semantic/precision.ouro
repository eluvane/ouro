        (cp_operation_clean 21 [cp_text_literal 99, cp_operation_local 40])
    , MkPair String Bool "list-node-is-not-empty-string"
        (cp_operation_clean 21 [CmValueOf 5 7 0 False False True, cp_operation_local 40])
    ];

