        (cp_operation_reports 32 [cp_nat_literal 0, cp_operation_local 40] "OURO-CLIPPY-LOGIC-008")
    , MkPair String Bool "order-reflexive-less-equal"
        (cp_operation_reports 32 [cp_operation_local 40, cp_operation_local 40] "OURO-CLIPPY-LOGIC-008")
    , MkPair String Bool "existing-irreflexive-rule-owns-zero-self"
        (cp_operation_clean 26 [cp_nat_literal 0, cp_nat_literal 0])
    , MkPair String Bool "inverted-bounds-33"
        (cp_operation_reports 33 [cp_nat_literal 9, cp_nat_literal 2, cp_operation_local 40] "OURO-CLIPPY-LOGIC-009")
    , MkPair String Bool "inverted-bounds-34"
        (cp_operation_reports 34 [cp_nat_literal 9, cp_nat_literal 2, cp_operation_local 40] "OURO-CLIPPY-LOGIC-009")
    , MkPair String Bool "ordered-bounds-33"
        (cp_operation_clean 33 [cp_nat_literal 2, cp_nat_literal 9, cp_operation_local 40])
    , MkPair String Bool "unknown-bounds-33"
        (cp_operation_clean 33 [cp_operation_local 40, cp_operation_local 41, cp_operation_local 42])
    , MkPair String Bool "ordered-bounds-34"
