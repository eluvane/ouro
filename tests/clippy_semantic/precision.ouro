        (cp_nested_clean(cp_nested_outer 42 500 [cp_nested_result], CmCall 30 500 1 0 42 True 0 [cp_operation_local 40] False))
    , MkPair String Bool "nested-cheap-outer-42"
        (cp_nested_clean(CmCall 20 500 1 0 42 True 0 [cp_nested_result] False, cp_nested_inner 42 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-small-constant-input-43"
        (cp_nested_clean(cp_nested_outer 43 500 [cp_operation_global 200, cp_nested_result], cp_nested_inner 43 500 [cp_operation_global 200, CmValueOf 4 7 0 False False True]))
    , MkPair String Bool "nested-cheap-inner-43"
        (cp_nested_clean(cp_nested_outer 43 500 [cp_operation_global 200, cp_nested_result], CmCall 30 500 1 0 43 True 0 [cp_operation_global 200, cp_operation_local 40] False))
    , MkPair String Bool "nested-cheap-outer-43"
        (cp_nested_clean(CmCall 20 500 1 0 43 True 0 [cp_operation_global 200, cp_nested_result] False, cp_nested_inner 43 500 [cp_operation_global 200, cp_operation_local 40]))
    ];

def cp_operation_laws : List (Pair String Bool) :=
    append (Pair String Bool) cp_arithmetic_text_laws
      (append (Pair String Bool) cp_boolean_collection_laws
        (append (Pair String Bool) cp_nested_boolean_laws
          (append (Pair String Bool) cp_nested_normalization_laws cp_nested_reversal_laws)));

def cp_laws : List (Pair String Bool) :=
    append (Pair String Bool) cp_operation_laws [ MkPair String Bool "generic-Either-is-not-must-use"
        (notb (cm_checked (CmValueOf 1 40 1 False False False)))
    , MkPair String Bool "known-Right-is-not-must-use"
        (notb (cm_checked (CmValueOf 8 40 1 False False False)))
    , MkPair String Bool "registered-checked-result-is-obligatory" (cm_checked cp_checked_value)
    , MkPair String Bool "IO-construction-is-not-execution" (notb (cm_checked cp_io_value))
    , MkPair String Bool "execution-activates-obligation" (cm_checked (cm_unwrap_io 90 cp_io_value))
    , MkPair String Bool "alias-preserves-producer" (eq_nat(cm_value_id (cm_unwrap_io 90 cp_io_value), 40))
    , MkPair String Bool "unused-alias-does-not-hide-observed-original" (cp_one_unobserved [40,40] [40] 0)
    , MkPair String Bool "alias-chain-without-observation-reports-once" (cp_one_unobserved [40,40,40] [] 1)
    , MkPair String Bool "different-value-observation-does-not-hide-error" (cp_one_unobserved [40] [41] 1)
    , MkPair String Bool "observation-order-merge" (cp_one_unobserved [40,50] [1,40,49,50,90] 0)
    , MkPair String Bool "generic-Left-does-not-establish-error" (notb (cm_error_arm (cm_context_pattern cp_ctx 10)))
    , MkPair String Bool "checked-Left-establishes-error" (cm_error_arm cp_failed_ctx)
    , MkPair String Bool "checked-retry-success-clears-error"
        (notb (cm_error_arm (cm_context_pattern(cm_context_subject cp_failed_ctx cp_checked_value, 11))))
    , MkPair String Bool "unrelated-Right-does-not-clear-error"
        (cm_error_arm (cm_context_pattern cp_failed_ctx 11))
    , MkPair String Bool "lambda-does-not-inherit-error-path" (notb (cm_error_arm (cm_context_region cp_failed_ctx 4)))
    , MkPair String Bool "literal-error-code-not-assumed-success"
        (cp_no_finding (cm_arm_outcome cp_failed_ctx 3 (CmValueOf 3 1 0 False False True) cp_state))
    , MkPair String Bool "rendered-string-not-assumed-success"
        (cp_no_finding (cm_arm_outcome cp_failed_ctx 3 (CmValueOf 4 1 0 False False True) cp_state))
    , MkPair String Bool "effect-or-recovery-boundary-invalidates-failure-proof"
        (cp_no_finding (cm_arm_outcome(cp_failed_ctx, 3, CmValueOf 8 4 1 False False False, cm_barrier cp_state)))
    , MkPair String Bool "registered-error-to-Right-is-visible"
        (notb (cp_no_finding (cm_arm_outcome cp_failed_ctx 3 (CmValueOf 8 4 1 False False False) cp_state)))
    , MkPair String Bool "same-traversal-same-arguments"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 1 0 (cp_args 5)] 1)
    , MkPair String Bool "different-callback-is-not-repeated-work"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 1 0 (cp_args 6)] 0)
    , MkPair String Bool "different-callee-is-not-repeated-work"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 2 1 0 (cp_args 5)] 0)
    , MkPair String Bool "effect-barrier-breaks-proof"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 1 1 (cp_args 5)] 0)
    , MkPair String Bool "branch-separation-breaks-proof"
        (cp_repeated_count [cp_call 1 1 0 (cp_args 5), cp_call 1 2 0 (cp_args 5)] 0)
    , MkPair String Bool "different-collection-breaks-proof"
        (cp_repeated_count [cp_call 1 1 0 [CmValueOf 1 3 0 False False False],
                           cp_call 1 1 0 [CmValueOf 1 4 0 False False False]] 0)
    , MkPair String Bool "unknown-purity-is-not-a-proof"
        (notb (cm_traversal_eligible (CmCall 1 1 1 0 20 False 1 (cp_args 5) False)))
    , MkPair String Bool "small-constant-input-excluded"
        (notb (cm_traversal_eligible (cp_call 1 1 0 [CmValueOf 5 4 0 False False True])))
    , MkPair String Bool "costless-operation-excluded"
        (notb (cm_traversal_eligible (CmCall 1 1 1 0 20 True 0 (cp_args 5) False)))
    , MkPair String Bool "registry-duplicate-fails"
        (cp_registry_bad [CmContractOf "std/fs.ouro" "read" 23 False 0 False,
                          CmContractOf "std/fs.ouro" "read" 23 False 0 False])
    , MkPair String Bool "registry-unknown-role-fails"
        (cp_registry_bad [CmContractOf "std/fs.ouro" "read" 999 False 0 False])
    , MkPair String Bool "registry-noncanonical-module-fails"
        (cp_registry_bad [CmContractOf "std/../std/fs.ouro" "read" 23 False 0 False])
    , MkPair String Bool "Either-and-Option-roles-not-must-use"
        (andb (notb (cm_contract_observe (CmContractOf "std/types.ouro" "Either" 12 True 0 False)))
          (notb (cm_contract_observe (CmContractOf "std/types.ouro" "Maybe" 13 True 0 False))))
    ];

def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True cp_laws;
       println (prim_string_concat("CLIPPY_SEMANTIC_PRECISION: ", match ok with | True => "OK" | False => "FAIL" end));
       exit (match ok with | True => 0 | False => 1 end)
