private def cp_nested_unary_laws (role : Nat) (suffix : String) (rule : String)
    : List (Pair String Bool) :=
    [ MkPair String Bool (prim_string_concat "nested-positive-" suffix)
        (cp_nested_exact [cp_nested_inner role 500 [cp_operation_local 40], cp_nested_outer role 500 [cp_nested_result]] rule)
    , MkPair String Bool (prim_string_concat "nested-preorder-join-" suffix)
        (cp_nested_exact [cp_nested_outer role 500 [cp_nested_result], cp_nested_inner role 500 [cp_operation_local 40]] rule)
    , MkPair String Bool (prim_string_concat "nested-different-callee-" suffix)
        (cp_nested_clean(cp_nested_outer role 501 [cp_nested_result], cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-different-operation-" suffix)
        (cp_nested_clean(cp_nested_outer role 500 [cp_nested_result], cp_nested_inner 0 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-unknown-" suffix)
        (cp_nested_clean(cp_nested_outer role 500 [CmValueOf 0 30 0 False False False], cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-local-not-producer-" suffix)
        (cp_nested_clean(cp_nested_outer role 500 [CmValueOf 1 30 0 False False False], cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-checked-not-producer-" suffix)
        (cp_nested_clean(cp_nested_outer role 500 [CmValueOf 14 30 0 False False False], cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-branch-barrier-" suffix)
        (cp_nested_clean(CmCall 20 500 2 0 role True 1 [cp_nested_result] False, cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-epoch-barrier-" suffix)
        (cp_nested_clean(CmCall 20 500 1 1 role True 1 [cp_nested_result] False, cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-purity-barrier-" suffix)
        (cp_nested_clean(CmCall 20 500 1 0 role False 1 [cp_nested_result] False, cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-partial-call-" suffix)
        (cp_nested_clean(cp_nested_outer role 500 [], cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-missing-producer-" suffix)
        (nullb(CgSProof, cm_nested_laws cp_decl "law" [cp_nested_outer role 500 [cp_nested_result]]))
    , MkPair String Bool (prim_string_concat "nested-wrong-lineage-" suffix)
        (cp_nested_clean(cp_nested_outer role 500 [CmValueOf 6 31 0 False False False], cp_nested_inner role 500 [cp_operation_local 40]))
    , MkPair String Bool (prim_string_concat "nested-IO-not-executed-value-" suffix)
        (cp_nested_clean(cp_nested_outer role 500 [cm_as_io cp_nested_result], cp_nested_inner role 500 [cp_operation_local 40]))
    ];

def cp_nested_boolean_laws : List (Pair String Bool) :=
    cp_nested_unary_laws 37 "37" "OURO-CLIPPY-REDUNDANT-012";

def cp_nested_normalization_laws : List (Pair String Bool) :=
    cp_nested_unary_laws 42 "42" "OURO-CLIPPY-PERF-003";

