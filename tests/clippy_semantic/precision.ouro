-- Native laws for proof mutations; all predicates are the production consumers.
-- @entry main
import "../quality_test_support.ouro",
  "../../tools/clippy/semantic_rules.ouro",
  "../../std/io.ouro";

def cp_checked_value : CmValue := CmValueOf 14 40 1 False False False;
def cp_io_value : CmValue := cm_as_io cp_checked_value;
def cp_decl : ScDecl := ScDeclOf 1 1 0 0 (ESort 0) (Nothing Expr) (Nothing Nat);
def cp_ctx : CmContext := CmContextOf cp_decl [] 1 False (Nothing Nat) False False 0;
def cp_state : CmState := CmStateOf 90 0 (Nil CmEvent) (Nothing (Pair Nat Nat))
    (Nil (Pair(Nat, Pair Nat Nat)));
def cp_checked_ctx : CmContext := cm_context_subject cp_ctx cp_checked_value;
def cp_failed_ctx : CmContext := cm_context_pattern cp_checked_ctx 10;

def cp_call (callee : Nat) (branch : Nat) (epoch : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 2 callee branch epoch 20 True 1 args False;

def cp_args (callback : Nat) : List CmValue :=
    [CmValueOf 2 7 0 False False True, CmValueOf 2 callback 0 False False True,
     CmValueOf 1 50 0 False False False];

def cp_one_unobserved (created : List Nat) (observed : List Nat) (count : Nat) : Bool :=
    eq_nat(length(CgSProof, cm_unobserved cp_decl "law" created observed (Nothing Nat)), count);

def cp_registry_bad (rows : List CmContract) : Bool :=
    match cm_validate_contracts rows with | Left _ => True | Right _ => False end;

def cp_repeated_count (calls : List ClippyCallFact) (count : Nat) : Bool :=
    eq_nat (length CgSProof (cm_repeated cp_decl "law" CmRepeatedTraversalProof "test evidence"
      cm_work_key (filter ClippyCallFact cm_traversal_eligible calls))) count;

def cp_no_finding (state : CmState) : Bool := nullb(CgSProof, cm_findings cp_decl "law" (cm_events state));

def cp_operation_call (role : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 20 300 1 0 role True 0 args False;
def cp_nat_literal (value : Nat) : CmValue := CmValueOf 3 value 0 False False True;
def cp_text_literal (value : Nat) : CmValue := CmValueOf 4 value 0 False False True;
def cp_operation_local (id : Nat) : CmValue := CmValueOf 1 id 0 False False False;
def cp_operation_global (id : Nat) : CmValue := CmValueOf 2 id 0 False False True;
def cp_operation_constructor (id : Nat) (role : Nat) : CmApi :=
    let decl : ScDecl := ScDeclOf id 2 3 0 (ESort 0) (Nothing Expr) (Nothing Nat) in
    let contract : CmContract := CmContractOf "std/types.ouro" "constructor-law" role True 0 False in
    CmApiOf decl contract 0 0 (cm_seed_summary decl contract);
def cp_operation_apis : CmApiIndex :=
    CmApiNode (cp_operation_constructor 100 38) CmApiEmpty
      (CmApiNode (cp_operation_constructor 101 39) CmApiEmpty CmApiEmpty);
def cp_operation_intern : InternState :=
    MkIntern [] 0 [MkPair (List Nat) Nat [] 7, MkPair (List Nat) Nat [120] 8] 9;
def cp_operation_state (call : ClippyCallFact) : CmState :=
    cm_collection_operand_laws cp_operation_intern cp_ctx call
      (cm_bool_operand_laws cp_operation_apis cp_ctx call
        (cm_nat_bound_laws cp_ctx call (cm_nat_operand_laws cp_ctx call cp_state)));
def cp_operation_exact (state : CmState) (expected : String) : Bool :=
    match cm_findings cp_decl "operation law" (cm_events state) with
    | Nil => False
    | Cons proof rest => match proof with | MkCgSProof rule _ _ _ _ =>
        andb(nullb CgSProof rest, prim_string_eq rule expected) end
    end;
def cp_operation_reports (role : Nat) (args : List CmValue) (expected : String) : Bool :=
    cp_operation_exact(cp_operation_state (cp_operation_call role args), expected);
def cp_operation_clean (role : Nat) (args : List CmValue) : Bool :=
    cp_no_finding (cp_operation_state (cp_operation_call role args));
def cp_nested_inner (role : Nat) (callee : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 30 callee 1 0 role True 1 args False;
def cp_nested_outer (role : Nat) (callee : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 20 callee 1 0 role True 1 args False;
def cp_nested_result : CmValue := CmValueOf 6 30 0 False False False;
def cp_nested_exact (calls : List ClippyCallFact) (expected : String) : Bool :=
    match cm_nested_laws cp_decl "operation law" calls with
    | Nil => False
    | Cons proof rest => match proof with | MkCgSProof rule _ _ _ _ =>
        andb(nullb CgSProof rest, prim_string_eq rule expected) end
    end;
def cp_nested_clean (outer : ClippyCallFact) (inner : ClippyCallFact) : Bool :=
    nullb(CgSProof, cm_nested_pair cp_decl "operation law" outer inner);

