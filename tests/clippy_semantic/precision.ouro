    , MkPair String Bool "nested-wrong-lineage-43"
        (cp_nested_clean(cp_nested_outer 43 500 [cp_operation_global 200, CmValueOf 6 31 0 False False False], cp_nested_inner 43 500 [cp_operation_global 200, cp_operation_local 40]))
    , MkPair String Bool "nested-IO-not-executed-value-43"
        (cp_nested_clean(cp_nested_outer 43 500 [cp_operation_global 200, cm_as_io cp_nested_result], cp_nested_inner 43 500 [cp_operation_global 200, cp_operation_local 40]))
    , MkPair String Bool "reversal-element-type-identity"
        (cp_nested_clean(cp_nested_outer 43 500 [cp_operation_global 201, cp_nested_result], cp_nested_inner 43 500 [cp_operation_global 200, cp_operation_local 40]))
    , MkPair String Bool "replacement-not-idempotence"
        (cp_nested_clean(cp_nested_outer 16 500 [cp_nested_result], cp_nested_inner 16 500 [cp_operation_local 40]))
    , MkPair String Bool "join-reuses-producer-for-two-consumers"
        (eq_nat(length(CgSProof, cm_nested_laws cp_decl "law" [cp_nested_inner 37 500 [cp_operation_local 40], cp_nested_outer 37 500 [cp_nested_result], CmCall 21 500 1 0 37 True 1 [cp_nested_result] False]), 2))
    , MkPair String Bool "nested-small-constant-input-42"
        (cp_nested_clean(cp_nested_outer 42 500 [cp_nested_result], cp_nested_inner 42 500 [CmValueOf 4 7 0 False False True]))
    , MkPair String Bool "nested-cheap-inner-42"
        (cp_nested_clean(cp_nested_outer 42 500 [cp_nested_result], CmCall 30 500 1 0 42 True 0 [cp_operation_local 40] False))
    , MkPair String Bool "nested-cheap-outer-42"
        (cp_nested_clean(CmCall 20 500 1 0 42 True 0 [cp_nested_result] False, cp_nested_inner 42 500 [cp_operation_local 40]))
    , MkPair String Bool "nested-small-constant-input-43"
        (cp_nested_clean(cp_nested_outer 43 500 [cp_operation_global 200, cp_nested_result], cp_nested_inner 43 500 [cp_operation_global 200, CmValueOf 4 7 0 False False True]))
    , MkPair String Bool "nested-cheap-inner-43"
        (cp_nested_clean(cp_nested_outer 43 500 [cp_operation_global 200, cp_nested_result], CmCall 30 500 1 0 43 True 0 [cp_operation_global 200, cp_operation_local 40] False))
