import "../../../std/text.ouro";

inductive LocalBox : Type := | LocalBoxValue : Maybe Nat -> LocalBox;
def LocalConstructor : Type := Maybe Nat -> LocalBox;

def constructor_value (parsed : Maybe Nat) : LocalConstructor := LocalBoxValue;

def discard_through_partial_constructor (text : String) : LocalConstructor :=
    constructor_value (str_parse_nat text);
