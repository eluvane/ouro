import "../../../std/fs.ouro";

def pure_does_not_recover (path : String) : IO (Either FsError String) :=
    do let! result := fs_read_checked path;
       match result with
       | Left error =>
           do let! fallback := io_pure String "";
              io_pure (Either FsError String) (Right FsError String fallback)
       | Right text => io_pure (Either FsError String) (Right FsError String text)
       end
