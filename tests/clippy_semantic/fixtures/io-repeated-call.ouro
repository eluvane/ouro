import "../../../std/io.ouro";
import "../../../std/text.ouro";

def sample_number (fallback : Nat) : IO Nat :=
    do let! stamp := now;
       io_pure Nat (fromMaybe Nat fallback (str_parse_nat stamp))

def call_difference (fallback : Nat) : IO Nat :=
    let action := sample_number fallback in
    let alias := action in
    do let! first := action;
       let! second := alias;
       io_pure Nat (sub second first)
