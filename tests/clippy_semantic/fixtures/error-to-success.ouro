-- Semantic precision fixture: error-to-success
import "../../../std/fs.ouro";
def hidden_failure (path : String) : IO (Either FsError String) := do let! result := fs_read_checked path; match result with | Left error => io_pure (Either FsError String) (Right FsError String "") | Right text => io_pure (Either FsError String) (Right FsError String text) end
