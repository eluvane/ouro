-- Contract precision fixture: contract-ignored-argument-does-not-observe
import "../../../std/fs.ouro";
def ignore_result (E : Type) (A : Type) (value : Either E A) : Nat := 0;
def discard_through_helper (path : String) : IO Unit :=
    do let! value := fs_read_checked path;
       let unused := ignore_result FsError String value in
       io_pure Unit MkUnit
