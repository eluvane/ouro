import "../../../std/result.ouro";
import "../../../std/fs.ouro";
import "../../../std/io.ouro";

def result_good_number (_value : Nat) : Nat := 17;

-- Corresponding operations with unknown constructors cannot acquire a fixed
-- branch from the API spelling, function name or the surrounding return type.
def result_good_success_map (value : Either Nat Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_map Nat Nat Nat f value;

def result_good_error_map (value : Either Nat Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_map_err Nat Nat Nat f value;

def result_good_bind (value : Either Nat Nat) (next : Nat -> Either Nat Nat) : Either Nat Nat :=
    result_bind Nat Nat Nat value next;

def result_good_recovery (value : Either Nat Nat) (recover : Nat -> Either Nat Nat) : Either Nat Nat :=
    result_or_else Nat Nat value recover;

def result_good_fold (value : Either Nat Nat) : Nat :=
    result_fold Nat Nat Nat result_good_number result_good_number value;

def result_good_maybe_map (value : Maybe Nat) : Maybe Nat :=
    mapMaybe Nat Nat result_good_number value;

def result_good_maybe_fold (value : Maybe Nat) : Nat :=
    maybe Nat Nat 0 result_good_number value;

def result_good_to_maybe (value : Either Nat Nat) : Maybe Nat :=
    result_to_maybe Nat Nat value;

def result_good_from_maybe (value : Maybe Nat) (error : Nat) : Either Nat Nat :=
    result_from_maybe Nat Nat error value;

def result_good_default (value : Either Nat Nat) (fallback : Nat) : Nat :=
    result_or Nat Nat fallback value;

def result_good_maybe_default (value : Maybe Nat) (fallback : Nat) : Nat :=
    fromMaybe Nat fallback value;

def result_good_map2 (left : Either Nat Nat) (right : Either Nat Nat)
    (f : Nat -> Nat -> Nat) : Either Nat Nat :=
    result_map2 Nat Nat Nat Nat f left right;

def result_good_unit_failure (value : Either Nat Nat) : Either Nat Unit :=
    result_to_unit Nat Nat value;

def result_good_unit_once (value : Either Nat Unit) : Either Nat Unit :=
    result_to_unit Nat Unit value;

-- The opposite round trip may replace an existing error with the new error.
-- It is intentionally NOT licensed by the Maybe -> Result -> Maybe law.
def result_good_opposite_round_trip (error : Nat) (value : Either Nat Nat) : Either Nat Nat :=
    result_from_maybe Nat Nat error (result_to_maybe Nat Nat value);

-- These callbacks change payloads/errors. A pure summary alone is not identity.
def result_good_changed_success (value : Either Nat Nat) : Either Nat Nat :=
    result_map Nat Nat Nat result_good_number value;

def result_good_changed_error (value : Either Nat Nat) : Either Nat Nat :=
    result_map_err Nat Nat Nat result_good_number value;

def result_good_changed_maybe (value : Maybe Nat) (f : Nat -> Nat) : Maybe Nat :=
    mapMaybe Nat Nat f value;

-- A generic Either is not a registered checked producer, even in a known arm.
def result_good_generic_path (value : Either Nat Nat) : Bool :=
    match value with
    | Left _ => False
    | Right _ => result_is_ok Nat Nat value
    end;

-- Intentional fallback on the checked failure arm remains explicit policy.
def result_good_failure_policy (path : String) : IO String :=
    (do let! result := fs_read_checked path;
       match result with
       | Left _ => io_pure String (result_or FsError String "recovered" result)
       | Right text => io_pure String text
       end);
