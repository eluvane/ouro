import "../../../std/result.ouro";
import "../../../std/fs.ouro";
import "../../../std/io.ouro";

-- Non-identity pure callback: constructor laws must not accidentally be
-- satisfied only by the separate identity-callback diagnostics.
def result_fixture_number (_value : Nat) : Nat := 7;
def result_fixture_identity (value : Nat) : Nat := value;

-- REDUNDANT-101..115: each site has its own proof kind and one producer edge.
def result_bad_success_map (error : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_map Nat Nat Nat f (Left Nat Nat error);

def result_bad_error_map (value : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_map_err Nat Nat Nat f (Right Nat Nat value);

def result_bad_bind (error : Nat) (next : Nat -> Either Nat Nat) : Either Nat Nat :=
    result_bind Nat Nat Nat (Left Nat Nat error) next;

def result_bad_recovery (value : Nat) (recover : Nat -> Either Nat Nat) : Either Nat Nat :=
    result_or_else Nat Nat (Right Nat Nat value) recover;

def result_bad_fold (error : Nat) : Nat :=
    result_fold Nat Nat Nat result_fixture_number result_fixture_number (Left Nat Nat error);

def result_bad_maybe_map : Maybe Nat :=
    mapMaybe Nat Nat result_fixture_number (Nothing Nat);

def result_bad_maybe_fold (value : Nat) : Nat :=
    maybe Nat Nat 0 result_fixture_number (Just Nat value);

def result_bad_to_maybe (error : Nat) : Maybe Nat :=
    result_to_maybe Nat Nat (Left Nat Nat error);

def result_bad_from_maybe (value : Nat) : Either Nat Nat :=
    result_from_maybe Nat Nat 0 (Just Nat value);

def result_bad_default (error : Nat) (fallback : Nat) : Nat :=
    result_or Nat Nat fallback (Left Nat Nat error);

def result_bad_maybe_default (fallback : Nat) : Nat :=
    fromMaybe Nat fallback (Nothing Nat);

def result_bad_map2 (error : Nat) (other : Either Nat Nat)
    (f : Nat -> Nat -> Nat) : Either Nat Nat :=
    result_map2 Nat Nat Nat Nat f (Left Nat Nat error) other;

def result_bad_unit_failure (error : Nat) : Either Nat Unit :=
    result_to_unit Nat Nat (Left Nat Nat error);

def result_bad_unit_twice (value : Either Nat Unit) : Either Nat Unit :=
    result_to_unit Nat Unit (result_to_unit Nat Unit value);

def result_bad_round_trip (error : Nat) (value : Maybe Nat) : Maybe Nat :=
    result_to_maybe Nat Nat (result_from_maybe Nat Nat error value);

-- REDUNDANT-116..118: complete unary callback summaries, unchanged types.
def result_bad_identity_map (value : Either Nat Nat) : Either Nat Nat :=
    result_map Nat Nat Nat result_fixture_identity value;

def result_bad_identity_error (value : Either Nat Nat) : Either Nat Nat :=
    result_map_err Nat Nat Nat result_fixture_identity value;

def result_bad_identity_maybe (value : Maybe Nat) : Maybe Nat :=
    mapMaybe Nat Nat result_fixture_identity value;

-- REDUNDANT-119..120: the result is executed, checked, selected and unchanged.
def result_bad_path_test (path : String) : IO Bool :=
    (do let! result := fs_read_checked path;
       match result with
       | Left _ => io_pure Bool False
       | Right _ => io_pure Bool (result_is_ok FsError String result)
       end);

def result_bad_path_default (path : String) : IO String :=
    (do let! result := fs_read_checked path;
       match result with
       | Left _ => io_pure String "failure"
       | Right _ => io_pure String (result_or FsError String "fallback" result)
       end);
