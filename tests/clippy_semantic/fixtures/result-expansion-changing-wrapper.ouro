import "../../../std/result.ouro";

-- The wrapper replaces Left with Right. Its body is not transparent delegation
-- and it must not inherit the producer's failure constructor or a map role.
def result_changes_semantics (value : Either Nat Nat) : Either Nat Nat :=
    Right Nat Nat (result_or Nat Nat 0 value);

def result_changed_wrapper_input (error : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_map Nat Nat Nat f (result_changes_semantics (Left Nat Nat error));

-- This wrapper reverses its type-argument order while forwarding the values.
-- Its role must remain unknown rather than interpreting positions by spelling.
def result_reordered_wrapper (B : Type) (A : Type) (E : Type)
    (f : A -> B) (value : Either E A) : Either E B := result_map E A B f value;

def result_reordered_input (error : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_reordered_wrapper Nat Nat Nat f (Left Nat Nat error);
