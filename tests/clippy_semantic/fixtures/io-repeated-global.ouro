import "../../../std/io.ouro";
import "../../../std/text.ouro";

def sample_clock : IO Nat :=
    do let! stamp := now;
       io_pure Nat (fromMaybe Nat 0 (str_parse_nat stamp))

def clock_difference : IO Nat :=
    do let! start := sample_clock;
       let! finish := sample_clock;
       io_pure Nat (sub finish start)
