import "../../../std/result.ouro";
import "../../../std/fs.ouro";
import "../../../std/io.ouro";

-- Only full-arity, order-preserving delegation inherits this operation role.
def result_forward_map (E : Type) (A : Type) (B : Type) (f : A -> B)
    (value : Either E A) : Either E B := result_map E A B f value;

def result_forward_map_twice (E : Type) (A : Type) (B : Type) (f : A -> B)
    (value : Either E A) : Either E B := result_forward_map E A B f value;

def result_wrapped_failure (error : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_forward_map_twice Nat Nat Nat f (Left Nat Nat error);

-- Checked producer identity comes from the registered API summary, not names.
def result_read_one (path : String) : IO (Either FsError String) := fs_read_checked path;
def result_read_two (path : String) : IO (Either FsError String) := result_read_one path;

def result_wrapped_path (path : String) : IO Bool :=
    (do let! result := result_read_two path;
       let alias : Either FsError String := result in
       match alias with
       | Left _ => io_pure Bool False
       | Right _ => io_pure Bool (result_is_ok FsError String result)
       end);
