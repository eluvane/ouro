import "../../../std/result.ouro";
import "../../../std/fs.ouro";
import "../../../std/io.ouro";

-- A local function with the complete call shape is still not the std API.
def result_local_callee
    (result_map : Type -> Type -> Type -> (Nat -> Nat) -> Either Nat Nat -> Either Nat Nat)
    (error : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_map Nat Nat Nat f (Left Nat Nat error);

-- A partial application does not have the saturated API proof.
def result_partial_map (error : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    let mapper : Either Nat Nat -> Either Nat Nat := result_map Nat Nat Nat f in
    mapper (Left Nat Nat error);

-- Do not transfer the selected producer to a same-spelled replacement binder.
def result_shadowed_value (path : String) (other : Either FsError String) : IO Bool :=
    (do let! result := fs_read_checked path;
       match result with
       | Left _ => io_pure Bool False
       | Right _ =>
           let result : Either FsError String := other in
           io_pure Bool (result_is_ok FsError String result)
       end);

-- A different checked producer is not constrained by the first one's arm.
def result_different_producer (first_path : String) (second_path : String) : IO Bool :=
    (do let! original := fs_read_checked first_path;
       let! other := fs_read_checked second_path;
       match original with
       | Left _ => io_pure Bool False
       | Right _ => io_pure Bool (result_is_ok FsError String other)
       end);

-- Effects invalidate the conservative path witness, even with the same value.
def result_after_effect (path : String) : IO Bool :=
    (do let! result := fs_read_checked path;
       match result with
       | Left _ => io_pure Bool False
       | Right _ =>
           do let! _ := println "effect boundary";
              io_pure Bool (result_is_ok FsError String result)
       end);

-- Capturing the value does not capture an immediately executing branch proof.
def result_deferred_test (path : String) : IO (Unit -> Bool) :=
    (do let! result := fs_read_checked path;
       match result with
       | Left _ => io_pure (Unit -> Bool) (fun (_marker : Unit) => False)
       | Right _ => io_pure (Unit -> Bool)
           (fun (_marker : Unit) => result_is_ok FsError String result)
       end);

-- Constructing an IO action is not executing its checked result.
def result_pending_action (path : String) : IO Unit :=
    let action : IO (Either FsError String) := fs_read_checked path in
    io_pure Unit MkUnit;

-- The success/failure choice of an unrelated Bool must not select this Result.
def result_ambiguous_branch (flag : Bool) (result : Either Nat Nat) : Bool :=
    match flag with
    | True => result_is_ok Nat Nat result
    | False => False
    end;
