import "../../../std/result.ouro";
import "../../../std/fs.ouro";

def result_keep_text (value : String) : String := value;

def result_identity_discard (path : String) : IO Unit :=
    (do let! result := fs_read_checked path;
       let alias : Either FsError String :=
           result_map FsError String String result_keep_text result in
       io_pure Unit MkUnit);
