-- Stop at the requested prefix; a full-list length can be much more work.
import "../../../std/listx.ouro";
def collection_prefix_length : Nat -> List Bool -> Nat :=
  fix go (count : Nat) (xs : List Bool) : Nat :=
    match count with
    | Z => Z
    | S remaining => match xs with
      | Nil => Z | Cons _ rest => S (go remaining rest) end
    end;
def collection_example (xs : List Bool) : Nat := collection_prefix_length 2 xs;
