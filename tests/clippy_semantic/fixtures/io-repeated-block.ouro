import "../../../std/io.ouro";
import "../../../std/text.ouro";

def block_difference : IO Nat :=
    let action : IO Nat :=
        (do let! stamp := now;
            io_pure Nat (fromMaybe Nat 0 (str_parse_nat stamp))) in
    do let! first := action;
       let! second := action;
       io_pure Nat (sub second first)
