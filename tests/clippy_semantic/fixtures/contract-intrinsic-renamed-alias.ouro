import "../../../std/string_prims.ouro";
def normalized (renamed : String) (old : String) (new : String) : String := let alias := renamed in prim_string_replace alias old new;
def twice (input : String) : String := prim_string_concat (normalized input "a" "b") (normalized input "a" "b");
