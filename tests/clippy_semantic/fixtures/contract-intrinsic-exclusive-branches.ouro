-- Full worker contract mutation fixture; real intrinsic identity.
import "../../../std/string_prims.ouro";
def normalized (text : String) (old : String) (new : String) : String := prim_string_replace text old new;
def either_side (flag : Bool) (input : String) : String := match flag with | True => normalized input "a" "b" | False => normalized input "a" "b" end;
