-- Contract precision fixture: contract-identity-result-propagated
import "../../../std/fs.ouro";
def result_identity (E : Type) (A : Type) (value : Either E A) : Either E A := value;
def propagate_alias (path : String) : IO (Either FsError String) :=
    do let! value := fs_read_checked path;
       io_pure (Either FsError String) (result_identity FsError String value)
