import "../../../std/fs.ouro";

def observe_both_reads (path : String) : IO Unit :=
    let action := fs_read_checked path in
    do let! first := action;
       match first with
       | Left error => io_pure Unit MkUnit
       | Right text =>
           do let! second := action;
              match second with
              | Left retry_error => io_pure Unit MkUnit
              | Right retry_text => io_pure Unit MkUnit
              end
       end
