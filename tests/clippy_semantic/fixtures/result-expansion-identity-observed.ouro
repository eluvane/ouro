import "../../../std/result.ouro";
import "../../../std/fs.ouro";

def result_observed_keep_text (value : String) : String := value;

def result_identity_observed (path : String) : IO Unit :=
    (do let! result := fs_read_checked path;
       let observation : Bool := result_is_ok FsError String result in
       let alias : Either FsError String :=
           result_map FsError String String result_observed_keep_text result in
       io_pure Unit MkUnit);

def result_identity_propagated (path : String) : IO (Either FsError String) :=
    (do let! result := fs_read_checked path;
       io_pure (Either FsError String)
           (result_map FsError String String result_observed_keep_text result));
