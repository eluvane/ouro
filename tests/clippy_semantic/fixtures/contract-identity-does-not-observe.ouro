-- Contract precision fixture: contract-identity-does-not-observe
import "../../../std/fs.ouro";
def result_identity (E : Type) (A : Type) (value : Either E A) : Either E A := value;
def discard_alias (path : String) : IO Unit :=
    do let! value := fs_read_checked path;
       let alias := result_identity FsError String value in
       io_pure Unit MkUnit
