import "../../../std/data.ouro";

-- Same spelling and arity, different compiler-owned declaration identity.
-- This function deliberately does not implement the standard success map.
def result_map (E : Type) (A : Type) (B : Type) (_f : A -> B)
    (value : Either E A) : Either E A := value;

def result_same_spelling (error : Nat) (f : Nat -> Nat) : Either Nat Nat :=
    result_map Nat Nat Nat f (Left Nat Nat error);
