import "../../../std/fs.ouro";

def retry_with_action (path : String) (recover : IO String) : IO (Either FsError String) :=
    do let! result := fs_read_checked path;
       match result with
       | Left error =>
           do let! recovered := recover;
              io_pure (Either FsError String) (Right FsError String recovered)
       | Right text => io_pure (Either FsError String) (Right FsError String text)
       end

def retry_with_input (path : String) : IO (Either FsError String) :=
    do let! result := fs_read_checked path;
       match result with
       | Left error =>
           do let! recovered := readLine;
              io_pure (Either FsError String) (Right FsError String recovered)
       | Right text => io_pure (Either FsError String) (Right FsError String text)
       end
