-- Invoked by proofs.ouro through the existing native law runner.
-- Production detector/join mutation tests and independent std value laws.
import "expansion_laws.ouro",
  "../../std/string.ouro";

def ct_api (id : Nat) (module_path : String) (name : String) (role : Nat)
    (pure : Bool) (cost : Nat) (arity : Nat) : CmApi :=
    let decl : ScDecl := ScDeclOf id 1 0 0 (ESort 0) (Nothing Expr) (Nothing Nat) in
    let contract : CmContract := CmContractOf module_path name role pure cost False in
    CmApiOf decl contract arity 0 (cm_seed_summary decl contract);

def ct_apis : CmApiIndex :=
    foldr CmApi CmApiIndex (fun (api : CmApi) (tail : CmApiIndex) =>
      CmApiNode api CmApiEmpty tail) CmApiEmpty
      [ct_api 1 "std/prelude.ouro" "map" 20 False 1 4,
       ct_api 2 "std/data.ouro" "filter" 20 False 1 3,
       ct_api 3 "std/prelude.ouro" "length" 18 True 1 2,
       ct_api 4 "std/data.ouro" "take" 40 True 1 3,
       ct_api 5 "std/data.ouro" "drop" 41 True 1 3,
       ct_api 6 "std/listx.ouro" "reverse_lin" 43 True 1 2,
       ct_api 7 "std/prelude.ouro" "append" 21 True 1 3,
       ct_api 8 "std/string.ouro" "str_trim" 42 True 1 1,
       ct_api 9 "std/string.ouro" "str_ltrim" 42 True 1 1,
       ct_api 10 "std/string.ouro" "str_rtrim" 42 True 1 1,
       ct_api 11 "std/string.ouro" "str_lower" 42 True 1 1,
       ct_api 12 "std/string.ouro" "str_upper" 42 True 1 1,
       ct_api 14 "std/prelude.ouro" "notb" 37 True 0 1,
       ct_api 15 "std/string.ouro" "str_len" 18 True 0 1,
       ct_api 16 "user.ouro" "str_trim" 42 True 1 1,
       ct_api 17 "user.ouro" "delegate" 20 False 1 4,
       ct_api 18 "user.ouro" "notb" 37 True 0 1];

def ct_call (node : Nat) (callee : Nat) (args : List CmValue) : ClippyCallFact :=
    match cm_api_lookup callee ct_apis with
    | Nothing => CmCall node callee 1 0 0 False 0 args False
    | Just api => CmCall node callee 1 0 (cm_contract_role (cm_api_contract api))
        True (cm_contract_cost (cm_api_contract api)) args False
    end;
def ct_inner (callee : Nat) (args : List CmValue) : ClippyCallFact := ct_call 30 callee args;
def ct_outer (callee : Nat) (args : List CmValue) : ClippyCallFact := ct_call 20 callee args;
def ct_callback : CmValue := cx_type 14;

def ct_selected (proofs : List CgSProof) : List CgSProof :=
    filter CgSProof (fun (proof : CgSProof) => match proof with
      | MkCgSProof code _ _ _ _ =>
          any CmCollectionLaw (fun (law : CmCollectionLaw) =>
            prim_string_eq(code, cc_rule law)) cc_laws end) proofs;
def ct_join (inner : ClippyCallFact) (outer : ClippyCallFact) (bound : List Nat) : List CgSProof :=
    ct_selected (cm_collection_laws_with_bindings ct_apis cx_decl "collection-law"
      [outer,inner] bound);

def ct_replace : Nat -> CmValue -> List CmValue -> List CmValue :=
  fix go (position : Nat) (value : CmValue) (args : List CmValue) : List CmValue :=
    match args with
    | Nil => []
    | Cons first rest => match position with
      | Z => Cons CmValue value rest
      | S previous => Cons CmValue first (go previous value rest) end
    end;
def ct_arg (call : ClippyCallFact) (position : Nat) (value : CmValue) : ClippyCallFact :=
    cx_args(call, ct_replace position value (cm_call_args call));
def ct_callee (call : ClippyCallFact) (callee : Nat) : ClippyCallFact :=
    CmCall (cm_call_node call) callee (cm_call_branch call) (cm_call_epoch call)
      (cm_call_role call) (cm_call_pure call) (cm_call_cost call) (cm_call_args call) False;
def ct_constants (call : ClippyCallFact) : ClippyCallFact :=
    cx_args call (map CmValue CmValue (fun (value : CmValue) =>
      match eq_nat(cm_value_kind value, 1) with
      | True => CmValueOf 5 (cm_value_id value) 0 False False True
      | False => value end) (cm_call_args call));

inductive CtCase : Type :=
  | CtCaseOf : CmCollectionLaw -> ClippyCallFact -> ClippyCallFact -> CtCase;
def ct_cases : List CtCase :=
    [CtCaseOf CcLengthMap
       (ct_inner 1 [cx_element,cx_element,ct_callback,cx_input])
       (ct_outer 3 [cx_element,cx_result]),
     CtCaseOf CcLengthFilter
       (ct_inner 2 [cx_element,ct_callback,cx_input])
       (ct_outer 3 [cx_element,cx_result]),
     CtCaseOf CcMapMap
       (ct_inner 1 [cx_element,cx_element,ct_callback,cx_input])
       (ct_outer 1 [cx_element,cx_element,ct_callback,cx_result]),
     CtCaseOf CcLengthTake
       (ct_inner 4 [cx_element,cx_nat 4,cx_input])
       (ct_outer 3 [cx_element,cx_result]),
     CtCaseOf CcMapFilter
       (ct_inner 2 [cx_element,ct_callback,cx_input])
       (ct_outer 1 [cx_element,cx_element,ct_callback,cx_result]),
     CtCaseOf CcFilterMap
       (ct_inner 1 [cx_element,cx_element,ct_callback,cx_input])
       (ct_outer 2 [cx_element,ct_callback,cx_result]),
     CtCaseOf CcTakeMap
       (ct_inner 1 [cx_element,cx_element,ct_callback,cx_input])
       (ct_outer 4 [cx_element,cx_nat 2,cx_result]),
     CtCaseOf CcDropMap
       (ct_inner 1 [cx_element,cx_element,ct_callback,cx_input])
       (ct_outer 5 [cx_element,cx_nat 2,cx_result]),
     CtCaseOf CcNarrowTake
       (ct_inner 4 [cx_element,cx_nat 4,cx_input])
       (ct_outer 4 [cx_element,cx_nat 2,cx_result]),
     CtCaseOf CcDropTakeWindow
       (ct_inner 4 [cx_element,cx_nat 3,cx_input])
       (ct_outer 5 [cx_element,cx_nat 1,cx_result]),
     CtCaseOf CcReverseAppend
       (ct_inner 7 [cx_element,cx_input,cx_other])
       (ct_outer 6 [cx_element,cx_result]),
     CtCaseOf CcLeftAppend
       (ct_inner 7 [cx_element,cx_input,cx_other])
       (ct_outer 7 [cx_element,cx_result,cx_local 102]),
     CtCaseOf CcMapReverse
       (ct_inner 6 [cx_element,cx_input])
       (ct_outer 1 [cx_element,cx_element,ct_callback,cx_result]),
     CtCaseOf CcFilterReverse
       (ct_inner 6 [cx_element,cx_input])
       (ct_outer 2 [cx_element,ct_callback,cx_result]),
     CtCaseOf CcReverseMap
       (ct_inner 1 [cx_element,cx_element,ct_callback,cx_input])
       (ct_outer 6 [cx_element,cx_result]),
     CtCaseOf CcReverseFilter
       (ct_inner 2 [cx_element,ct_callback,cx_input])
       (ct_outer 6 [cx_element,cx_result]),
     CtCaseOf CcFilterFilter
       (ct_inner 2 [cx_element,ct_callback,cx_input])
       (ct_outer 2 [cx_element,ct_callback,cx_result]),
     CtCaseOf(CcTrimSide, ct_inner 9 [cx_input], ct_outer 8 [cx_result]),
     CtCaseOf(CcSideTrim, ct_inner 8 [cx_input], ct_outer 9 [cx_result]),
     CtCaseOf(CcCaseAbsorption, ct_inner 12 [cx_input], ct_outer 11 [cx_result])];

def ct_mutations (call : ClippyCallFact) : List ClippyCallFact :=
    [cx_role call 0, cx_impure call, cx_cost call 0,
     cx_unknown_args call, cx_io_args call,
     cx_args call [], cx_args(call, append CmValue (cm_call_args call) [cx_input]),
     cx_rebuild call (cm_call_role call) 2 0 True (cm_call_args call),
     cx_rebuild call (cm_call_role call) 1 1 True (cm_call_args call),
     ct_callee call 999];

def ct_case_law (item : CtCase) : Pair String Bool :=
    match item with | CtCaseOf law inner outer =>
      let kind : CmProofKind := CmCollectionProof law in
      let bound : List CgSProof := ct_join inner outer [30] in
      let sharing : Bool := match cc_allocation law False with
        | True => cx_one kind bound | False => nullb CgSProof bound end in
      let types : Bool := match leb_nat(8, cc_call_tag ct_apis outer) with
        | True => True
        | False => nullb(CgSProof, ct_join inner (ct_arg outer 0 cx_error) []) end in
      MkPair String Bool (prim_string_concat(cc_rule law, ": production join and negative space"))
        (all Bool (fun (value : Bool) => value)
          [cx_one(kind, ct_join inner outer []), sharing, types,
           cx_one kind (ct_selected (cm_collection_laws_with_bindings ct_apis cx_decl
             "ordered" [inner,outer] [])),
           all ClippyCallFact (fun (bad : ClippyCallFact) =>
             nullb(CgSProof, ct_join bad outer [])) (ct_mutations inner),
           all ClippyCallFact (fun (bad : ClippyCallFact) =>
             nullb(CgSProof, ct_join inner bad [])) (ct_mutations outer),
           nullb(CgSProof, ct_join (ct_constants inner) outer []),
           nullb CgSProof (ct_selected (cm_collection_laws_with_bindings ct_apis cx_decl
             "missing" [outer] [])),
           nullb CgSProof (ct_selected (cm_collection_laws_with_bindings CmApiEmpty cx_decl
             "unknown-contracts" [inner,outer] []))])
    end;

def ct_extra : List (Pair String Bool) :=
    [MkPair String Bool "direct narrow take publishes one diagnostic across both families"
       (cx_one (CmCollectionProof CcNarrowTake)
         (cm_collection_laws_with_bindings ct_apis cx_decl "overlap"
           [ct_outer 4 [cx_element,cx_nat 2,cx_result],
            ct_inner 4 [cx_element,cx_nat 5,cx_input]] [])),
     MkPair String Bool "role-based narrow take survives unavailable direct contract proof"
       (cx_one (CmQualityProof CmTightenTake)
         (cm_collection_laws_with_bindings CmApiEmpty cx_decl "role-only"
           [ct_outer 4 [cx_element,cx_nat 2,cx_result],
            ct_inner 4 [cx_element,cx_nat 5,cx_input]] [])),
     MkPair String Bool "narrow take precedence is local to its producer pair"
       (let proofs : List CgSProof := cm_collection_laws_with_bindings ct_apis cx_decl "distinct-pairs"
          [ct_outer 4 [cx_element,cx_nat 2,cx_result],
           ct_inner 4 [cx_element,cx_nat 5,cx_input],
           ct_call 21 4 [cx_element,cx_nat 2,cx_edge 31],
           ct_callee(ct_call 31 4 [cx_element,cx_nat 5,cx_other], 999)] [] in
        andb (cx_one(CmCollectionProof CcNarrowTake, take CgSProof 1 proofs))
          (cx_one(CmQualityProof CmTightenTake, drop CgSProof 1 proofs))),
     MkPair String Bool "collection same spelling does not establish a contract"
       (nullb(CgSProof, ct_join(ct_inner 9 [cx_input], ct_outer 16 [cx_result], []))),
     MkPair String Bool "collection inferred work role is not a canonical map identity"
       (nullb CgSProof (ct_join
         (ct_inner 17 [cx_element,cx_element,ct_callback,cx_input])
         (ct_outer 3 [cx_element,cx_result]) [])),
     MkPair String Bool "collection totality is not inferred from callback purity or spelling"
       (andb (notb (cc_total_callback(ct_apis, cx_type 18)))
         (notb (cc_total_callback(ct_apis, cx_local 14)))),
     MkPair String Bool "collection unknown callback blocks map elimination"
       (nullb CgSProof (ct_join
         (ct_inner 1 [cx_element,cx_element,cx_type 18,cx_input])
         (ct_outer 3 [cx_element,cx_result]) [])),
     MkPair String Bool "collection changing predicate identity blocks repeated filter"
       (nullb CgSProof (ct_join (ct_inner 2 [cx_element,ct_callback,cx_input])
         (ct_outer 2 [cx_element,cx_type 18,cx_result]) [])),
     MkPair String Bool "collection lineage cannot be borrowed from a different producer"
       (nullb(CgSProof, ct_join(ct_inner 9 [cx_input], ct_outer 8 [cx_edge 31], []))),
     MkPair String Bool "collection right-associated append remains clean"
       (nullb CgSProof (ct_join (ct_inner 7 [cx_element,cx_input,cx_other])
         (ct_outer 7 [cx_element,cx_other,cx_result]) [])),
     MkPair String Bool "collection heterogeneous map checks the intermediate type only"
       (cx_one (CmCollectionProof CcMapMap) (ct_join
         (ct_inner 1 [cx_type 80,cx_type 81,cx_type 11,cx_input])
         (ct_outer 1 [cx_type 81,cx_type 82,cx_type 15,cx_result]) [])),
     MkPair String Bool "collection unknown counts never become literal bounds"
       (all Nat (fun (api : Nat) => nullb CgSProof (ct_join
         (ct_inner 1 [cx_element,cx_element,ct_callback,cx_input])
         (ct_outer api [cx_element,cx_input,cx_result]) [])) [4,5]),
     MkPair String Bool "collection zero equal and exhausting bounds are not narrower windows"
       (all Nat (fun (count : Nat) => all Nat (fun (api : Nat) =>
         nullb CgSProof (ct_join (ct_inner 4 [cx_element,cx_nat 3,cx_input])
           (ct_outer api [cx_element,cx_nat count,cx_result]) [])) [4,5]) [0,3,4]),
     MkPair String Bool "collection full trim absorbs either side"
       (cx_one (CmCollectionProof CcTrimSide)
         (ct_join(ct_inner 10 [cx_input], ct_outer 8 [cx_result], []))),
     MkPair String Bool "collection either side is redundant after full trim"
       (cx_one (CmCollectionProof CcSideTrim)
         (ct_join(ct_inner 8 [cx_input], ct_outer 10 [cx_result], [30]))),
     MkPair String Bool "collection uppercase also absorbs lowercase"
       (cx_one (CmCollectionProof CcCaseAbsorption)
         (ct_join(ct_inner 11 [cx_input], ct_outer 12 [cx_result], [])))];

-- Independent executable std laws include empty lists, short lists, bounds
-- exceeding length, asymmetric append inputs and all four Boolean callbacks.
-- ouro-structural: {"rule":"STRUCT_DUPLICATE_IMPLEMENTATION","category":"independent-oracle","related":["compiler/base.ouro#compiler_bool_equal","tests/clippy_semantic/quality_laws.ouro#qx_bool_eq"],"reason":"Keep Boolean equality assertions in the independent stdlib law suites separate from compiler equality and from each other's result computation."}
def ct_bool_eq (a : Bool) (b : Bool) : Bool :=
    match a with | True => b | False => notb b end;
def ct_list_eq : List Bool -> List Bool -> Bool :=
  fix go (xs : List Bool) (ys : List Bool) : Bool :=
    match xs with
    | Nil => nullb Bool ys
    | Cons x rest => match ys with
      | Nil => False
      | Cons y tail => andb(ct_bool_eq x y, go rest tail) end
    end;
def ct_lists : Nat -> List (List Bool) :=
  fix go (depth : Nat) : List (List Bool) :=
    match depth with
    | Z => [[]]
    | S smaller => Cons (List Bool) []
        (concat_map (List Bool) (List Bool) (fun (xs : List Bool) =>
          [Cons Bool False xs, Cons Bool True xs]) (go smaller))
    end;
def ct_callbacks : List (Bool -> Bool) :=
    [notb, fun (b : Bool) => b, fun (_ : Bool) => True, fun (_ : Bool) => False];
def ct_bounded : Nat -> List Bool -> Nat :=
  fix go (count : Nat) (xs : List Bool) : Nat :=
    match count with
    | Z => Z
    | S remaining => match xs with | Nil => Z | Cons _ rest => S (go remaining rest) end
    end;
def ct_map_select (f : Bool -> Bool) (p : Bool -> Bool) (xs : List Bool) : List Bool :=
    foldr Bool (List Bool) (fun (x : Bool) (acc : List Bool) =>
      match p x with | True => Cons Bool (f x) acc | False => acc end) [] xs;
def ct_select_map (f : Bool -> Bool) (p : Bool -> Bool) (xs : List Bool) : List Bool :=
    foldr Bool (List Bool) (fun (x : Bool) (acc : List Bool) =>
      let mapped : Bool := f x in
      match p mapped with | True => Cons Bool mapped acc | False => acc end) [] xs;
def ct_reverse_map (f : Bool -> Bool) (xs : List Bool) : List Bool :=
    foldl Bool (List Bool) (fun (acc : List Bool) (x : Bool) => Cons Bool (f x) acc) [] xs;
def ct_reverse_select (p : Bool -> Bool) (xs : List Bool) : List Bool :=
    foldl Bool (List Bool) (fun (acc : List Bool) (x : Bool) =>
      match p x with | True => Cons Bool x acc | False => acc end) [] xs;

def ct_value_law (law : CmCollectionLaw) (xs : List Bool)
    (f : Bool -> Bool) (p : Bool -> Bool) : Bool :=
    match law with
    | CcLengthMap => eq_nat(length(Bool, map Bool Bool f xs), length Bool xs)
    | CcLengthFilter => eq_nat(length(Bool, filter Bool p xs), count_if Bool p xs)
    | CcMapMap => ct_list_eq (map Bool Bool f (map Bool Bool p xs))
        (map Bool Bool (fun (x : Bool) => f (p x)) xs)
    | CcLengthTake => all Nat (fun (n : Nat) =>
        eq_nat(length(Bool, take Bool n xs), ct_bounded n xs)) [1,2,4,7]
    | CcMapFilter => ct_list_eq(map Bool Bool f (filter Bool p xs), ct_map_select f p xs)
    | CcFilterMap => ct_list_eq(filter Bool p (map Bool Bool f xs), ct_select_map f p xs)
    | CcTakeMap => all Nat (fun (n : Nat) => ct_list_eq
        (take Bool n (map Bool Bool f xs)) (map Bool Bool f (take Bool n xs))) [1,2,4,7]
    | CcDropMap => all Nat (fun (n : Nat) => ct_list_eq
        (drop Bool n (map Bool Bool f xs)) (map Bool Bool f (drop Bool n xs))) [1,2,4,7]
    | CcNarrowTake => ct_list_eq(take Bool 2 (take Bool 4 xs), take Bool 2 xs)
    | CcDropTakeWindow => ct_list_eq(drop Bool 1 (take Bool 3 xs), take Bool 2 (drop Bool 1 xs))
    | CcReverseAppend => ct_list_eq (reverse_lin(Bool, append Bool xs [False,True,True]))
        (rev_append Bool [False,True,True] (reverse_lin Bool xs))
    | CcLeftAppend => ct_list_eq (append Bool (append Bool xs [False,True,True]) [True,False])
        (append Bool xs (append Bool [False,True,True] [True,False]))
    | CcMapReverse => ct_list_eq(map Bool Bool f (reverse_lin Bool xs), ct_reverse_map f xs)
    | CcFilterReverse => ct_list_eq(filter Bool p (reverse_lin Bool xs), ct_reverse_select p xs)
    | CcReverseMap => ct_list_eq(reverse_lin(Bool, map Bool Bool f xs), ct_reverse_map f xs)
    | CcReverseFilter => ct_list_eq(reverse_lin(Bool, filter Bool p xs), ct_reverse_select p xs)
    | CcFilterFilter => ct_list_eq(filter Bool p (filter Bool p xs), filter Bool p xs)
    | CcTrimSide => True
    | CcSideTrim => True
    | CcCaseAbsorption => True
    end;

def ct_texts : List String :=
    ["", " \t\r\n", "aB", " AbéZ \t", "ßΣ",
     prim_string_of_char_codes [65,0,97], prim_string_of_char_codes [255,65,9,128]];
def ct_text_law (law : CmCollectionLaw) (text : String) : Bool :=
    match law with
    | CcTrimSide => andb (str_eq(str_trim (str_ltrim text), str_trim text))
        (str_eq(str_trim (str_rtrim text), str_trim text))
    | CcSideTrim => andb (str_eq(str_ltrim (str_trim text), str_trim text))
        (str_eq(str_rtrim (str_trim text), str_trim text))
    | CcCaseAbsorption => andb (str_eq(str_lower (str_upper text), str_lower text))
        (str_eq(str_upper (str_lower text), str_upper text))
    | CcLengthMap => True | CcLengthFilter => True | CcMapMap => True
    | CcLengthTake => True | CcMapFilter => True | CcFilterMap => True
    | CcTakeMap => True | CcDropMap => True | CcNarrowTake => True
    | CcDropTakeWindow => True | CcReverseAppend => True | CcLeftAppend => True
    | CcMapReverse => True | CcFilterReverse => True | CcReverseMap => True
    | CcReverseFilter => True | CcFilterFilter => True
    end;

def ct_values : List (Pair String Bool) :=
    map CmCollectionLaw (Pair String Bool) (fun (law : CmCollectionLaw) =>
      MkPair String Bool (prim_string_concat(cc_rule law, ": native std value law"))
        (andb (all (List Bool) (fun (xs : List Bool) =>
          all (Bool -> Bool) (fun (f : Bool -> Bool) =>
            all (Bool -> Bool) (fun (p : Bool -> Bool) =>
              ct_value_law law xs f p) ct_callbacks) ct_callbacks) (ct_lists 4))
          (all String (ct_text_law law) ct_texts))) cc_laws;

def ct_laws : List (Pair String Bool) :=
    append (Pair String Bool) (map CtCase (Pair String Bool) ct_case_law ct_cases)
      (append (Pair String Bool) ct_extra ct_values);
