-- Executed by proofs.ouro through the existing native semantic-law runner.
-- These tests call production predicates and the sorted producer join; the
-- manifest independently exercises frontend resolution and wrapper summaries.
import "../../tools/clippy/semantic_rules.ouro";

def cx_decl : ScDecl := ScDeclOf 1 1 0 0 (ESort 0) (Nothing Expr) (Nothing Nat);
def cx_ctx : CmContext := CmContextOf cx_decl [] 1 False (Nothing Nat) False False 0;
def cx_nat (n : Nat) : CmValue := CmValueOf 3 n 0 False False True;
def cx_local (id : Nat) : CmValue := CmValueOf 1 id 0 False False False;
def cx_type (id : Nat) : CmValue := CmValueOf 2 id 0 False False True;
def cx_text (id : Nat) : CmValue := CmValueOf 4 id 0 False False True;
def cx_edge (id : Nat) : CmValue := CmValueOf 6 id 0 False False False;
def cx_result : CmValue := cx_edge 30;
def cx_input : CmValue := cx_local 100;
def cx_other : CmValue := cx_local 101;
def cx_element : CmValue := cx_type 10;
def cx_error : CmValue := cx_type 11;
def cx_intern : InternState := MkIntern [] 0
    [MkPair (List Nat) Nat [] 7, MkPair (List Nat) Nat [97,98] 8,
     MkPair(List Nat, Nat, prim_string_to_char_codes "é", 9)] 10;

def cx_inner (role : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 30 300 1 0 role True 1 args False;
def cx_outer (role : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 20 301 1 0 role True 1 args False;

def cx_rebuild (call : ClippyCallFact) (role : Nat) (branch : Nat) (epoch : Nat)
    (pure : Bool) (args : List CmValue) : ClippyCallFact :=
    CmCall (cm_call_node call) (cm_call_callee call) branch epoch role pure
      (cm_call_cost call) args False;
def cx_args (call : ClippyCallFact) (args : List CmValue) : ClippyCallFact :=
    cx_rebuild call (cm_call_role call) (cm_call_branch call) (cm_call_epoch call)
      (cm_call_pure call) args;
def cx_role (call : ClippyCallFact) (role : Nat) : ClippyCallFact :=
    cx_rebuild call role (cm_call_branch call) (cm_call_epoch call)
      (cm_call_pure call) (cm_call_args call);
def cx_impure (call : ClippyCallFact) : ClippyCallFact :=
    cx_rebuild call (cm_call_role call) (cm_call_branch call) (cm_call_epoch call)
      False (cm_call_args call);
def cx_cost (call : ClippyCallFact) (cost : Nat) : ClippyCallFact :=
    CmCall (cm_call_node call) (cm_call_callee call) (cm_call_branch call)
      (cm_call_epoch call) (cm_call_role call) (cm_call_pure call) cost (cm_call_args call) False;
def cx_unknown_args (call : ClippyCallFact) : ClippyCallFact :=
    cx_args call (map CmValue CmValue (fun (value : CmValue) => cm_unknown (cm_value_id value))
      (cm_call_args call));
def cx_io_args (call : ClippyCallFact) : ClippyCallFact :=
    cx_args(call, map CmValue CmValue cm_as_io (cm_call_args call));

def cx_one (kind : CmProofKind) (proofs : List CgSProof) : Bool :=
    match proofs with
    | Nil => False
    | Cons proof rest => match proof with | MkCgSProof id _ _ _ _ =>
        andb(nullb CgSProof rest, prim_string_eq(id, cm_proof_rule kind)) end
    end;

def cx_scalar (call : ClippyCallFact) : List CgSProof :=
    cm_findings cx_decl "scalar-law"
      (cm_events (cm_text_operand_laws cx_intern cx_ctx call
        (cm_extremum_operand_laws cx_ctx call cm_state0)));

inductive CxScalar : Type :=
  | CxScalarOf : CmProofKind -> ClippyCallFact -> CxScalar;
def cx_scalars : List CxScalar :=
    [CxScalarOf(CmDegenerateClampProof, cx_outer 33 [cx_input,cx_input,cx_other]),
     CxScalarOf(CmExtremumOperandProof, cx_outer 44 [cx_input,cx_input]),
     CxScalarOf(CmTrivialPowerProof, cx_outer 46 [cx_input,cx_nat 1]),
     CxScalarOf(CmUnchangedReplaceProof, cx_outer 47 [cx_input,cx_other,cx_other]),
     CxScalarOf(CmEmptySearchProof, cx_outer 48 [cx_input,cx_text 7]),
     CxScalarOf(CmTextByteBoundsProof, cx_outer 49 [cx_text 8,cx_nat 2]),
     CxScalarOf(CmEmptySliceProof, cx_outer 50 [cx_input,cx_other,cx_nat 0]),
     CxScalarOf(CmTextSliceBoundsProof, cx_outer 50 [cx_text 8,cx_nat 2,cx_nat 1]),
     CxScalarOf(CmReflexiveSearchProof, cx_outer 48 [cx_input,cx_input])];

def cx_scalar_law (item : CxScalar) : Pair String Bool :=
    match item with | CxScalarOf kind call =>
      MkPair String Bool (prim_string_concat(cm_proof_rule kind, ": predicate and unavailable facts"))
        (andb (cx_one(kind, cx_scalar call))
          (all ClippyCallFact (fun (mutated : ClippyCallFact) => nullb(CgSProof, cx_scalar mutated))
            [cx_role call 0, cx_impure call, cx_unknown_args call, cx_io_args call,
             cx_args call [], cx_args(call, append CmValue (cm_call_args call) [cx_input])]))
    end;

inductive CxComposition : Type :=
  | CxCompositionOf : CmProofKind -> ClippyCallFact -> ClippyCallFact -> CxComposition;
def cx_compositions : List CxComposition :=
    [CxCompositionOf CmKnownResultTestProof
       (cx_inner 11 [cx_error,cx_element,cx_input])
       (cx_outer 51 [cx_error,cx_element,cx_result]),
     CxCompositionOf CmKnownResultDefaultProof
       (cx_inner 11 [cx_error,cx_element,cx_input])
       (cx_outer 52 [cx_error,cx_element,cx_other,cx_result]),
     CxCompositionOf CmExtremumAbsorptionProof
       (cx_inner 45 [cx_input,cx_other]) (cx_outer 44 [cx_input,cx_result]),
     CxCompositionOf CmKnownMaybeDefaultProof
       (cx_inner 54 [cx_element,cx_input])
       (cx_outer 53 [cx_element,cx_other,cx_result]),
     CxCompositionOf CmLengthReverseProof
       (cx_inner 43 [cx_element,cx_input]) (cx_outer 18 [cx_element,cx_result]),
     CxCompositionOf CmLengthAppendProof
       (cx_inner 21 [cx_element,cx_input,cx_other]) (cx_outer 18 [cx_element,cx_result]),
     CxCompositionOf CmDominatedTakeProof
       (cx_inner 40 [cx_element,cx_nat 2,cx_input])
       (cx_outer 40 [cx_element,cx_nat 5,cx_result]),
     CxCompositionOf CmDropAfterTakeProof
       (cx_inner 40 [cx_element,cx_nat 2,cx_input])
       (cx_outer 41 [cx_element,cx_nat 5,cx_result]),
     CxCompositionOf CmContainedClampProof
       (cx_inner 33 [cx_nat 2,cx_nat 8,cx_input])
       (cx_outer 33 [cx_nat 0,cx_nat 10,cx_result]),
     CxCompositionOf CmClampedRangeProof
       (cx_inner 33 [cx_nat 2,cx_nat 8,cx_input])
       (cx_outer 34 [cx_nat 0,cx_nat 10,cx_result]),
     CxCompositionOf CmBooleanComplementProof
       (cx_inner 37 [cx_input]) (cx_outer 35 [cx_input,cx_result])];

-- Requests are deliberately before their producer and have a smaller ordinal.
-- Neither list order nor ordinal magnitude is an execution-order proof.
def cx_join (inner : ClippyCallFact) (outer : ClippyCallFact) (bound : List Nat) : List CgSProof :=
    cm_nested_laws_with_bindings cx_decl "composition-law" [outer,inner] bound;

def cx_composition_law (item : CxComposition) : Pair String Bool :=
    match item with | CxCompositionOf kind inner outer =>
      let bad_producers : List ClippyCallFact :=
          [cx_role inner 0, cx_impure inner, cx_unknown_args inner, cx_io_args inner,
           cx_args inner [], cx_args(inner, append CmValue (cm_call_args inner) [cx_input]),
           cx_rebuild inner (cm_call_role inner) 2 0 True (cm_call_args inner),
           cx_rebuild inner (cm_call_role inner) 1 1 True (cm_call_args inner),
           CmCall 31 300 1 0 (cm_call_role inner) True 1 (cm_call_args inner) False] in
      let bad_consumers : List ClippyCallFact :=
          [cx_role outer 0, cx_impure outer, cx_unknown_args outer, cx_io_args outer,
           cx_args outer [], cx_args(outer, append CmValue (cm_call_args outer) [cx_input])] in
      MkPair String Bool (prim_string_concat(cm_proof_rule kind, ": producer join and missing premises"))
        (andb (cx_one(kind, cx_join inner outer []))
          (andb (all ClippyCallFact (fun (mutated : ClippyCallFact) =>
              nullb(CgSProof, cx_join mutated outer [])) bad_producers)
            (andb (all ClippyCallFact (fun (mutated : ClippyCallFact) =>
                nullb(CgSProof, cx_join inner mutated [])) bad_consumers)
              (nullb(CgSProof, cm_nested_laws cx_decl "missing-producer" [outer])))))
    end;

def cx_length_negative (role : Nat) (args : List CmValue) : Bool :=
    let inner : ClippyCallFact := cx_inner role args in
    let outer : ClippyCallFact := cx_outer 18 [cx_element,cx_result] in
    andb (nullb(CgSProof, cx_join inner outer [30]))
      (andb (nullb(CgSProof, cx_join (cx_cost inner 0) outer []))
        (nullb(CgSProof, cx_join inner (cx_outer 18 [cx_error,cx_result]) [])));

def cx_extra_laws : List (Pair String Bool) :=
    [MkPair String Bool "scalar equal spelling is not equal binder identity"
       (nullb(CgSProof, cx_scalar (cx_outer 44 [cx_input,cx_other]))),
     MkPair String Bool "power base zero does not determine unknown exponent"
       (nullb(CgSProof, cx_scalar (cx_outer 46 [cx_nat 0,cx_input]))),
     MkPair String Bool "power zero to zero follows Nat API"
       (cx_one(CmTrivialPowerProof, cx_scalar (cx_outer 46 [cx_nat 0,cx_nat 0]))),
     MkPair String Bool "missing literal intern entry is not empty or bounded"
       (andb (nullb(CgSProof, cx_scalar (cx_outer 48 [cx_input,cx_text 99])))
         (nullb(CgSProof, cx_scalar (cx_outer 49 [cx_text 99,cx_nat 100])))),
     MkPair String Bool "valid byte lookup remains clean"
       (nullb(CgSProof, cx_scalar (cx_outer 49 [cx_text 8,cx_nat 1]))),
     MkPair String Bool "UTF-8 byte offset is not a character index"
       (andb (nullb(CgSProof, cx_scalar (cx_outer 49 [cx_text 9,cx_nat 1])))
         (cx_one(CmTextByteBoundsProof, cx_scalar (cx_outer 49 [cx_text 9,cx_nat 2])))),
     MkPair String Bool "unknown slice count and offset stay unproved"
       (andb (nullb(CgSProof, cx_scalar (cx_outer 50 [cx_text 8,cx_nat 2,cx_input])))
         (nullb(CgSProof, cx_scalar (cx_outer 50 [cx_text 8,cx_input,cx_nat 1])))),
     MkPair String Bool "zero slice takes precedence over out-of-bounds slice"
       (cx_one(CmEmptySliceProof, cx_scalar (cx_outer 50 [cx_text 8,cx_nat 2,cx_nat 0]))),
     MkPair String Bool "empty search takes precedence over reflexive search"
       (cx_one(CmEmptySearchProof, cx_scalar (cx_outer 48 [cx_text 7,cx_text 7]))),
     MkPair String Bool "selected Result fallback uses its failure law"
       (cx_one CmResultDefaultFailureProof (cx_join (cx_inner 10 [cx_error,cx_element,cx_input])
         (cx_outer 52 [cx_error,cx_element,cx_other,cx_result]) [])),
     MkPair String Bool "Result constructor test requires both type identities"
       (nullb CgSProof (cx_join (cx_inner 11 [cx_error,cx_element,cx_input])
         (cx_outer 51 [cx_element,cx_error,cx_result]) [])),
     MkPair String Bool "checked unknown result is not a fixed constructor"
       (nullb CgSProof (cx_join (cx_inner 24 [cx_error,cx_element,cx_input])
         (cx_outer 51 [cx_error,cx_element,CmValueOf 14 30 1 False False False]) [])),
     MkPair String Bool "direct Right lineage and transparent constructor delegate are supported"
       (cx_one CmKnownResultTestProof (cx_join (cx_inner 11 [cx_error,cx_element,cx_input])
         (cx_outer 51 [cx_error,cx_element,CmValueOf 8 30 1 False False False]) [])),
     MkPair String Bool "Maybe default requires same payload type"
       (nullb CgSProof (cx_join (cx_inner 54 [cx_element,cx_input])
         (cx_outer 53 [cx_error,cx_other,cx_result]) [])),
     MkPair String Bool "bound reversal cost and type are not guessed"
       (cx_length_negative 43 [cx_element,cx_input]),
     MkPair String Bool "bound append cost and type are not guessed"
       (cx_length_negative 21 [cx_element,cx_input,cx_other]),
     MkPair String Bool "append with constant left input is not an allocation claim"
       (nullb CgSProof (cx_join
         (cx_inner 21 [cx_element,CmValueOf 5 1 0 False False True,cx_other])
         (cx_outer 18 [cx_element,cx_result]) [])),
     MkPair String Bool "binding facts retain producer identity through aliases"
       (match cm_bound_producers
          [CmBindEvent (CmBinding 90 91 cx_result),
           CmBindEvent (CmBinding 92 93 cx_input)] with
        | Nil => False
        | Cons id rest => andb(eq_nat id 30, nullb Nat rest)
        end),
     MkPair String Bool "constructor default still supports a bound producer"
       (cx_one CmKnownMaybeDefaultProof (cx_join (cx_inner 54 [cx_element,cx_input])
         (cx_outer 53 [cx_element,cx_other,cx_result]) [30])),
     MkPair String Bool "strictly smaller take uses its collection law"
       (cx_one (CmQualityProof CmTightenTake) (cx_join (cx_inner 40 [cx_element,cx_nat 5,cx_input])
         (cx_outer 40 [cx_element,cx_nat 2,cx_result]) [])),
     MkPair String Bool "smaller drop need not exhaust take"
       (nullb CgSProof (cx_join (cx_inner 40 [cx_element,cx_nat 5,cx_input])
         (cx_outer 41 [cx_element,cx_nat 2,cx_result]) [])),
     MkPair String Bool "unknown counts do not establish dominance"
       (nullb CgSProof (cx_join (cx_inner 40 [cx_element,cx_input,cx_other])
         (cx_outer 41 [cx_element,cx_nat 5,cx_result]) [])),
     MkPair String Bool "list count composition requires matching element types"
       (nullb CgSProof (cx_join (cx_inner 40 [cx_element,cx_nat 2,cx_input])
         (cx_outer 41 [cx_error,cx_nat 5,cx_result]) [])),
     MkPair String Bool "partially overlapping clamp cannot be removed"
       (nullb CgSProof (cx_join (cx_inner 33 [cx_nat 2,cx_nat 8,cx_input])
         (cx_outer 33 [cx_nat 4,cx_nat 10,cx_result]) [])),
     MkPair String Bool "partially overlapping range is not constant"
       (nullb CgSProof (cx_join (cx_inner 33 [cx_nat 2,cx_nat 8,cx_input])
         (cx_outer 34 [cx_nat 4,cx_nat 10,cx_result]) [])),
     MkPair String Bool "disjoint ordered clamp interval fixes range to false"
       (cx_one CmClampedRangeProof (cx_join (cx_inner 33 [cx_nat 2,cx_nat 8,cx_input])
         (cx_outer 34 [cx_nat 10,cx_nat 12,cx_result]) [])),
     MkPair String Bool "unknown interval bounds do not establish containment"
       (nullb CgSProof (cx_join (cx_inner 33 [cx_nat 2,cx_nat 8,cx_input])
         (cx_outer 34 [cx_input,cx_nat 10,cx_result]) [])),
     MkPair String Bool "inverted producer interval blocks containment proof"
       (nullb CgSProof (cx_join (cx_inner 33 [cx_nat 8,cx_nat 2,cx_input])
         (cx_outer 34 [cx_nat 0,cx_nat 10,cx_result]) [])),
     MkPair String Bool "different Boolean identities are not complements"
       (nullb CgSProof (cx_join (cx_inner 37 [cx_other])
         (cx_outer 35 [cx_input,cx_result]) [])),
     MkPair String Bool "negation in first operand is supported"
       (cx_one CmBooleanComplementProof (cx_join (cx_inner 37 [cx_input])
         (cx_outer 36 [cx_result,cx_input]) []))];

def cx_laws : List (Pair String Bool) :=
    append (Pair String Bool) (map CxScalar (Pair String Bool) cx_scalar_law cx_scalars)
      (append (Pair String Bool)
        (map CxComposition (Pair String Bool) cx_composition_law cx_compositions) cx_extra_laws);
