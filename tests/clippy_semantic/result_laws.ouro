-- Native consumers, not a parallel model of the analyzer. These laws are
-- imported by proofs.ouro and run by the existing --laws-only/full suite.
import "../../tools/clippy/semantic_rules.ouro";

def cr_rule_kinds : List CmProofKind :=
    [CmResultMapFailureProof, CmResultMapErrorSuccessProof, CmResultBindFailureProof,
     CmResultRecoverySuccessProof, CmResultFoldKnownProof, CmMaybeMapNothingProof,
     CmMaybeFoldKnownProof, CmResultToMaybeKnownProof, CmResultFromMaybeKnownProof,
     CmResultDefaultFailureProof, CmMaybeDefaultNothingProof, CmResultMap2FailureProof,
     CmResultUnitFailureProof, CmResultUnitIdempotentProof, CmMaybeResultRoundTripProof,
     CmResultMapIdentityProof, CmResultMapErrorIdentityProof, CmMaybeMapIdentityProof,
     CmResultPathTestProof, CmResultPathDefaultProof];

def cr_owner : ScDecl := ScDeclOf 1 2 0 0 (ESort 0) (Nothing Expr) (Nothing Nat);
def cr_type : CmValue := CmValueOf 2 100 0 False False True;
def cr_other_type : CmValue := CmValueOf 2 102 0 False False True;
def cr_callback : CmValue := CmValueOf 2 101 0 False False True;
def cr_local : CmValue := CmValueOf 1 8 0 False False False;
def cr_edge : CmValue := CmValueOf 6 30 1 False False False;
def cr_number : CmValue := CmValueOf 3 7 0 False False True;
def cr_inner (role : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 30 300 1 0 role True 0 args False;
def cr_outer (role : Nat) (args : List CmValue) : ClippyCallFact :=
    CmCall 20 301 1 0 role True 0 args False;
def cr_one (kind : CmProofKind) (proofs : List CgSProof) : Bool :=
    match proofs with
    | Nil => False
    | Cons proof rest => match proof with | MkCgSProof code _ _ _ _ =>
        andb(nullb CgSProof rest, prim_string_eq(code, cm_proof_rule kind)) end
    end;
def cr_join (outer : ClippyCallFact) (inner : ClippyCallFact) : List CgSProof :=
    cm_nested_laws cr_owner "result-law" [outer,inner];

inductive CrComposition : Type :=
  | CrCompositionOf : CmProofKind -> ClippyCallFact -> ClippyCallFact -> CrComposition;

def cr_compositions : List CrComposition :=
    [CrCompositionOf CmResultMapFailureProof
       (cr_outer 201 [cr_type,cr_type,cr_type,cr_callback,cr_edge])
       (cr_inner 10 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmResultMapErrorSuccessProof
       (cr_outer 202 [cr_type,cr_type,cr_type,cr_callback,cr_edge])
       (cr_inner 11 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmResultBindFailureProof
       (cr_outer 204 [cr_type,cr_type,cr_type,cr_edge,cr_callback])
       (cr_inner 10 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmResultRecoverySuccessProof
       (cr_outer 206 [cr_type,cr_type,cr_edge,cr_callback])
       (cr_inner 11 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmResultFoldKnownProof
       (cr_outer 207 [cr_type,cr_type,cr_type,cr_callback,cr_callback,cr_edge])
       (cr_inner 10 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmMaybeMapNothingProof
       (cr_outer 212 [cr_type,cr_type,cr_callback,cr_edge])
       (cr_inner 200 [cr_type]),
     CrCompositionOf CmMaybeFoldKnownProof
       (cr_outer 213 [cr_type,cr_type,cr_number,cr_callback,cr_edge])
       (cr_inner 54 [cr_type,cr_local]),
     CrCompositionOf CmResultToMaybeKnownProof
       (cr_outer 208 [cr_type,cr_type,cr_edge])
       (cr_inner 10 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmResultFromMaybeKnownProof
       (cr_outer 209 [cr_type,cr_type,cr_number,cr_edge])
       (cr_inner 54 [cr_type,cr_local]),
     CrCompositionOf CmResultDefaultFailureProof
       (cr_outer 52 [cr_type,cr_type,cr_number,cr_edge])
       (cr_inner 10 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmMaybeDefaultNothingProof
       (cr_outer 53 [cr_type,cr_number,cr_edge])
       (cr_inner 200 [cr_type]),
     CrCompositionOf CmResultMap2FailureProof
       (cr_outer 210 [cr_type,cr_type,cr_type,cr_type,cr_callback,cr_edge,cr_local])
       (cr_inner 10 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmResultUnitFailureProof
       (cr_outer 211 [cr_type,cr_type,cr_edge])
       (cr_inner 10 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmResultUnitIdempotentProof
       (cr_outer 211 [cr_type,cr_type,cr_edge])
       (cr_inner 211 [cr_type,cr_type,cr_local]),
     CrCompositionOf CmMaybeResultRoundTripProof
       (cr_outer 208 [cr_type,cr_type,cr_edge])
       (cr_inner 209 [cr_type,cr_type,cr_number,cr_local])];

-- A Maybe producer constrains only payload A, not the new error type E in
-- result_from_maybe E A. Mutate a type that the particular edge really proves.
def cr_mutate_edge_type (role : Nat) (replacement : CmValue) (args : List CmValue) : List CmValue :=
    match args with
    | Nil => []
    | Cons first rest => match eq_nat role 209 with
      | False => Cons CmValue replacement rest
      | True => match rest with
        | Nil => args
        | Cons _ tail => Cons CmValue first (Cons CmValue replacement tail)
        end
      end
    end;

-- Mutate already-built facts independently. Node ordinals intentionally run
-- backwards (consumer 20, producer 30): ordering is not a dominance proof.
def cr_composition_mutations (example : CrComposition) : Bool :=
    match example with | CrCompositionOf kind outer inner =>
      match inner with | CmCall node callee branch epoch role pure cost args recursive =>
        let bad_inner : List ClippyCallFact :=
            [CmCall node callee branch epoch 0 pure cost args recursive,
             CmCall node callee branch epoch role False cost args recursive,
             CmCall node callee 2 epoch role pure cost args recursive,
             CmCall node callee branch 1 role pure cost args recursive,
             CmCall 31 callee branch epoch role pure cost args recursive,
             CmCall node callee branch epoch role pure cost [] recursive,
             CmCall node callee branch epoch role pure cost (append CmValue args [cr_local]) recursive] in
        match outer with | CmCall on oc ob oe orole opure ocost oargs orecur =>
          let changed_type : List CmValue := cr_mutate_edge_type orole cr_other_type oargs in
          let unknown_type : List CmValue := cr_mutate_edge_type orole (cm_unknown 0) oargs in
          let io_type : List CmValue := cr_mutate_edge_type orole (cm_as_io cr_type) oargs in
          let bad_outer : List ClippyCallFact :=
              [CmCall on oc ob oe 0 opure ocost oargs orecur,
               CmCall on oc ob oe orole False ocost oargs orecur,
               CmCall on oc ob oe orole opure ocost changed_type orecur,
               CmCall on oc ob oe orole opure ocost unknown_type orecur,
               CmCall on oc ob oe orole opure ocost io_type orecur,
               CmCall on oc ob oe orole opure ocost [] orecur,
               CmCall on oc ob oe orole opure ocost (append CmValue oargs [cr_local]) orecur] in
          all Bool (fun (yes : Bool) => yes)
            [cr_one(kind, cr_join outer inner),
             cr_one(kind, cm_nested_laws cr_owner "result-law" [inner,outer]),
             nullb(CgSProof, cm_nested_laws cr_owner "result-law" [outer]),
             all ClippyCallFact (fun (changed : ClippyCallFact) => nullb(CgSProof, cr_join outer changed)) bad_inner,
             all ClippyCallFact (fun (changed : ClippyCallFact) => nullb(CgSProof, cr_join changed inner)) bad_outer]
        end
      end
    end;

def cr_identity_decl : ScDecl := ScDeclOf 101 1 0 0 (ESort 0) (Nothing Expr) (Nothing Nat);
def cr_identity_apis (status : CsStatus) (callback_effect : CsEffect) (result : CsResult)
    (module_id : Nat) (arity : Nat) : CmApiIndex :=
    CmApiNode (CmApiOf cr_identity_decl
      (CmContractOf "tests/clippy_semantic/result_identity.ouro" "identity" 0 False 0 False)
      arity 0 (CsContract module_id 101 status callback_effect result (CsArgumentOrigin 0)
        [CsReturnedArgument] (Just Nat 0) (Just Bool False) 0)) CmApiEmpty CmApiEmpty;
def cr_apis : CmApiIndex := cr_identity_apis CsComplete CsPure (CsArgumentResult 0) 1 1;
def cr_checked : CmValue := CmValueOf 14 90 1 False False False;
def cr_identity_args (role : Nat) : List CmValue :=
    match eq_nat role 212 with
    | True => [cr_type,cr_type,cr_callback,cr_local]
    | False => [cr_type,cr_type,cr_type,cr_callback,cr_checked]
    end;
def cr_identity_transfer_ok (role : Nat) : Bool :=
    match cm_result_identity_transfer cr_apis role (cr_identity_args role) with
    | Nothing => False
    | Just value => cm_law_same(value, match eq_nat role 212 with | True => cr_local | False => cr_checked end)
    end;
def cr_identity_emits (role : Nat) (kind : CmProofKind) : Bool :=
    let ctx : CmContext := CmContextOf cr_owner [] 1 False (Nothing Nat) False False 0 in
    let state : CmState := cm_result_identity_law cr_apis ctx
        (cr_outer(role, cr_identity_args role)) cm_state0 in
    cr_one(kind, cm_findings cr_owner "identity-law" (cm_events state));
def cr_identity_negative : Bool :=
    all CmApiIndex (fun (apis : CmApiIndex) =>
      notb (cm_result_identity_callback apis cr_callback))
      [CmApiEmpty,
       cr_identity_apis CsPending CsPure (CsArgumentResult 0) 1 1,
       cr_identity_apis CsCycle CsPure (CsArgumentResult 0) 1 1,
       cr_identity_apis CsBudget CsPure (CsArgumentResult 0) 1 1,
       cr_identity_apis CsDepth CsPure (CsArgumentResult 0) 1 1,
       cr_identity_apis CsComplete CsUnknownEffect (CsArgumentResult 0) 1 1,
       cr_identity_apis CsComplete CsMutation (CsArgumentResult 0) 1 1,
       cr_identity_apis CsComplete CsPure CsUnknownResult 1 1,
       cr_identity_apis CsComplete CsPure (CsArgumentResult 1) 1 1,
       cr_identity_apis CsComplete CsPure (CsArgumentResult 0) 2 1,
       cr_identity_apis CsComplete CsPure (CsArgumentResult 0) 1 2];

def cr_path_events : List CmEvent :=
    [CmFlowEvent (CmFlow 70 20 90), CmFlowEvent (CmFlow 71 21 70),
     CmFlowEvent (CmFlow 71 22 11), CmFlowEvent (CmFlow 71 23 9)];
def cr_path_call (role : Nat) (branch : Nat) (epoch : Nat) (value : CmValue) : ClippyCallFact :=
    CmCall 80 81 branch epoch role True 0
      (match eq_nat role 51 with
       | True => [cr_type,cr_type,value]
       | False => [cr_type,cr_type,cr_number,value] end) False;
def cr_path_render (events : List CmEvent) (call : ClippyCallFact) : List CgSProof :=
    cm_result_path_proofs (cm_render_proof cr_owner "path-law") cr_owner events [call];
def cr_path_mutations : Bool :=
    let call : ClippyCallFact := cr_path_call 51 71 9 cr_checked in
    let without (kind : Nat) : List CmEvent :=
        filter CmEvent (fun (event : CmEvent) => match event with
          | CmFlowEvent flow => match flow with | CmFlow _ selected _ => notb (eq_nat kind selected) end
          | CmCallEvent _ => True | CmBindEvent _ => True | CmUseEvent _ => True
          | CmTraversalEvent _ => True | CmRecursionEvent _ => True
          | CmWrapperEvent _ => True | CmFinding _ => True | CmToken _ _ => True end) cr_path_events in
    all Bool (fun (yes : Bool) => yes)
      [cr_one(CmResultPathTestProof, cr_path_render cr_path_events call),
       cr_one(CmResultPathTestProof, cr_path_render(reverse_lin CmEvent cr_path_events, call)),
       cr_one(CmResultPathDefaultProof, cr_path_render(cr_path_events, cr_path_call 52 71 9 cr_checked)),
       all Nat (fun (kind : Nat) => nullb(CgSProof, cr_path_render(without kind, call))) [20,21,22,23],
       all CmEvent (fun (event : CmEvent) => nullb CgSProof
         (cr_path_render(Cons CmEvent event cr_path_events, call))) cr_path_events,
       nullb(CgSProof, cr_path_render(cr_path_events, cr_path_call 51 72 9 cr_checked)),
       nullb(CgSProof, cr_path_render(cr_path_events, cr_path_call 51 71 10 cr_checked)),
       nullb(CgSProof, cr_path_render(cr_path_events, cr_path_call 51 71 9 (cm_as_io cr_checked))),
       nullb(CgSProof, cr_path_render(cr_path_events, cr_path_call 51 71 9 (CmValueOf 6 90 1 False False False))),
       nullb(CgSProof, cr_path_render(cr_path_events, cr_path_call 51 71 9 (CmValueOf 14 91 1 False False False))),
       nullb CgSProof (cr_path_render (Cons(CmEvent, CmFlowEvent (CmFlow 71 22 10), without 22))
         (cr_path_call 52 71 9 cr_checked)),
       cr_one CmResultPathTestProof (cr_path_render
         (Cons(CmEvent, CmFlowEvent (CmFlow 71 22 10), without 22)) call)];

def cr_skipped_callback_laws : Bool :=
    let left : CmValue := CmValueOf 7 30 1 False False False in
    let right : CmValue := CmValueOf 8 30 1 False False False in
    let callback : CmValue := CmValueOf 12 9 0 False False False in
    all Bool (fun (yes : Bool) => yes)
      [cm_result_call_pure CmApiEmpty 201 [cr_type,cr_type,cr_type,callback,left],
       notb (cm_result_call_pure CmApiEmpty 201 [cr_type,cr_type,cr_type,callback,right]),
       cm_result_call_pure CmApiEmpty 204 [cr_type,cr_type,cr_type,left,callback],
       notb (cm_result_call_pure CmApiEmpty 204 [cr_type,cr_type,cr_type,right,callback]),
       cm_result_call_pure CmApiEmpty 206 [cr_type,cr_type,right,callback],
       notb (cm_result_call_pure CmApiEmpty 206 [cr_type,cr_type,left,callback]),
       notb (cm_result_call_pure CmApiEmpty 201 [cr_type,cr_type,cr_type,callback,cm_as_io left]),
       notb (cm_result_call_pure CmApiEmpty 201 [cr_type,cr_type,cr_type,callback,cr_local]),
       notb (cm_result_call_pure CmApiEmpty 201 [cr_type,cr_type,cr_type,callback]),
       notb (cm_result_identity_callback cr_apis callback),
       notb (cm_result_identity_callback(cr_apis, cm_as_io cr_callback))];

def cr_laws : List (Pair String Bool) :=
    append (Pair String Bool)
      (map CrComposition (Pair String Bool) (fun (example : CrComposition) => match example with
        | CrCompositionOf kind _ _ => MkPair String Bool
            (prim_string_concat(cm_proof_rule kind, ": producer/type/arity/region mutations"))
            (cr_composition_mutations example) end) cr_compositions)
      [MkPair String Bool "Result map identity emits" (cr_identity_emits 201 CmResultMapIdentityProof),
       MkPair String Bool "Result error identity emits" (cr_identity_emits 202 CmResultMapErrorIdentityProof),
       MkPair String Bool "Maybe map identity emits" (cr_identity_emits 212 CmMaybeMapIdentityProof),
       MkPair String Bool "identity transfers preserve original value lineage"
         (all Nat cr_identity_transfer_ok [201,202,203,212]),
       MkPair String Bool "unknown/stale/cyclic/effectful callback summaries cannot prove identity" cr_identity_negative,
       MkPair String Bool "checked path joins reject absent/duplicate/sibling/effect/IO/generic facts" cr_path_mutations,
       MkPair String Bool "skipped callbacks are not assumed pure or executed" cr_skipped_callback_laws];
