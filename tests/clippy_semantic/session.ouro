-- Native scheduling laws. These do not assert semantic parity or RSS.
-- @entry main
import "../../tools/clippy/session.ouro";
import "../../std/fs.ouro";

def cs_ids : List (Pair Nat String) -> List Nat :=
  fix go (rows : List (Pair Nat String)) : List Nat :=
    match rows with
    | Nil => Nil Nat
    | Cons row rest => match row with
      | MkPair id _ => Cons Nat id (go rest)
      end
    end;

def cs_flatten : List (List (Pair Nat String)) -> List (Pair Nat String) :=
  fix go (groups : List (List (Pair Nat String))) : List (Pair Nat String) :=
    match groups with
    | Nil => Nil (Pair Nat String)
    | Cons group rest => append (Pair Nat String) group (go rest)
    end;

def cs_nat_eq : List Nat -> List Nat -> Bool :=
  fix go (left : List Nat) (right : List Nat) : Bool :=
    match left with
    | Nil => nullb Nat right
    | Cons x xs => match right with
      | Nil => False
      | Cons y ys => andb (eq_nat x y) (go xs ys)
      end
    end;

def cs_repeat : Nat -> List String :=
  fix go (n : Nat) : List String :=
    match n with
    | Z => Nil String
    | S less => Cons String "same.ouro" (go less)
    end;

def cs_epoch_law (count : Nat) : Bool :=
    let requests : List (Pair Nat String) := cg_s_number_requests (cs_repeat count) 0 in
    let groups : List (List (Pair Nat String)) := cg_s_epoch_groups requests
      cg_s_epoch_budget (Nil (Pair Nat String)) in
    andb (cs_nat_eq (cs_ids (cs_flatten groups)) (cs_ids requests))
      (all (List (Pair Nat String)) (fun (group : List (Pair Nat String)) =>
        andb (notb (nullb (Pair Nat String) group))
          (cg_s_epoch_fits cg_s_batch_limit group)) groups);

def cs_laws : List (Pair String Bool) :=
    [ MkPair String Bool "empty-inventory-has-no-epochs" (cs_epoch_law 0)
    , MkPair String Bool "one-root" (cs_epoch_law 1)
    , MkPair String Bool "two-roots" (cs_epoch_law 2)
    , MkPair String Bool "odd-tail" (cs_epoch_law 3)
    , MkPair String Bool "ten-roots" (cs_epoch_law 10)
    , MkPair String Bool "fifty-roots" (cs_epoch_law 50)
    , MkPair String Bool "hundred-roots" (cs_epoch_law 100)
    , MkPair String Bool "retained-bound-not-raised" (eq_nat cg_s_batch_limit 2)
    , MkPair String Bool "oversized-epoch-rejected"
        (notb (cg_s_epoch_fits cg_s_batch_limit (cg_s_number_requests (cs_repeat 3) 0)))
    ];

def cs_empty_harvest : CmHarvest :=
    MkHarvest empty_intern (Nil ScDecl) (Nil Nat) (Nil Decl);

def cs_cache_count (cache : CmParseCache) : Nat :=
    match cache with | MkCmParseCache rows => length CmCachedFile rows end;

def cs_cache_hit (cache : CmParseCache) (path : String) (source : String) : Bool :=
    match cm_cache_lookup cache path source with
    | CmCacheHit _ => True
    | CmCacheMiss => False
    | CmCacheStale => False
    end;

def cs_edit_cache : Nat -> CmParseCache -> CmParseCache :=
  fix go (count : Nat) (cache : CmParseCache) : CmParseCache :=
    match count with
    | Z => cache
    | S remaining => go remaining
        (cm_cache_put cache "edited.ouro" (prim_string_of_nat count) cs_empty_harvest)
    end;

def cs_fill_cache : Nat -> CmParseCache -> CmParseCache :=
  fix go (count : Nat) (cache : CmParseCache) : CmParseCache :=
    match count with
    | Z => cache
    | S remaining => go remaining
        (cm_cache_put cache (prim_string_of_nat count) "x" cs_empty_harvest)
    end;

def cs_edit_law : Bool :=
    let cache : CmParseCache := cs_edit_cache 200 cm_cache0 in
    andb (eq_nat (cs_cache_count cache) 1)
      (andb (eq_nat (cm_cache_bytes cache) 1)
        (andb (cs_cache_hit cache "edited.ouro" "1")
          (notb (cs_cache_hit cache "edited.ouro" "200"))));

def cs_capacity_law : Bool :=
    let cache : CmParseCache := cs_fill_cache 200 cm_cache0 in
    let changed : CmParseCache := cm_cache_put cache "1" "y" cs_empty_harvest in
    andb (eq_nat (cs_cache_count cache) cg_session_cache_rows)
      (andb (eq_nat (cs_cache_count changed) cg_session_cache_rows)
        (andb (cs_cache_hit changed "1" "y")
          (andb (notb (cs_cache_hit changed "1" "x"))
            (notb (cs_cache_hit cache "200" "x")))));

def cs_collision_law : Bool :=
    let cache : CmParseCache := MkCmParseCache
      [MkCmCachedFile (cm_cache_identity "dep.ouro") 1
        (cm_content_hash "x") "y" cs_empty_harvest] in
    match cm_cache_lookup cache "dep.ouro" "x" with
    | CmCacheStale => True
    | CmCacheMiss => False
    | CmCacheHit _ => False
    end;

def cs_mode_law : Bool :=
    let cache : CmParseCache := MkCmParseCache
      [MkCmCachedFile "different-frontend:dep.ouro" 1
        (cm_content_hash "x") "x" cs_empty_harvest] in
    match cm_cache_lookup cache "dep.ouro" "x" with
    | CmCacheMiss => True
    | CmCacheStale => False
    | CmCacheHit _ => False
    end;

def cs_signature_law : Bool :=
    match cm_load_file (MkPair String String "dep.ouro" "def before : Nat := 0;") empty_intern with
    | Left _ => False
    | Right first => match first with
      | MkHarvest intern _ _ _ =>
          let cache : CmParseCache := cm_cache_put cm_cache0 "dep.ouro"
            "def before : Nat := 0;" first in
          match cm_load_file_cached (MkPair String String "dep.ouro"
              "def after : Nat := 1;") intern cache with
          | Left _ => False
          | Right replaced => match replaced with
            | MkPair harvest next => match harvest with
              | MkHarvest updated symbols _ _ => andb (eq_nat (cs_cache_count next) 1)
                  (andb (andb (eq_nat (length ScDecl symbols) 1)
                    (cs_cache_hit next "dep.ouro" "def after : Nat := 1;"))
                    (all ScDecl (fun (decl : ScDecl) => andb
                      (prim_string_eq (cm_name updated (sc_decl_name decl)) "after")
                      (match sc_decl_body decl with | Nothing => True | Just _ => False end)) symbols))
              end
            end
          end
      end
    end;

def cs_reuse_law : Nat -> InternState -> CmParseCache -> Bool :=
  fix go (count : Nat) (intern : InternState) (cache : CmParseCache) : Bool :=
    match count with
    | Z => eq_nat (cs_cache_count cache) 1
    | S remaining => match cm_load_file_cached
        (MkPair String String "dep.ouro" "def shared : Nat := 0;") intern cache with
      | Left _ => False
      | Right loaded => match loaded with
        | MkPair harvest next => match harvest with
          | MkHarvest updated symbols _ _ => andb
              (andb (eq_nat (length ScDecl symbols) 1)
                (all ScDecl (fun (decl : ScDecl) =>
                prim_string_eq (cm_name updated (sc_decl_name decl)) "shared") symbols))
              (match cm_load_file (MkPair String String "root.ouro"
                  "def local : Nat := 1;") updated with
               | Left _ => False
               | Right root => match root with
                 | MkHarvest next_intern _ _ _ => go remaining next_intern next
                 end
               end)
          end
        end
      end
    end;

def cs_more_laws : List (Pair String Bool) :=
    [ MkPair String Bool "cache-repeated-edits-replace-one-row" cs_edit_law
    , MkPair String Bool "cache-full-capacity-replaces-and-evicts" cs_capacity_law
    , MkPair String Bool "equal-hash-and-length-still-verify-exact-bytes" cs_collision_law
    , MkPair String Bool "frontend-mode-is-part-of-identity" cs_mode_law
    , MkPair String Bool "stale-signature-replaced-without-bodies" cs_signature_law
    , MkPair String Bool "dependency-identifiers-survive-ten-parse-scopes"
        (cs_reuse_law 10 empty_intern cm_cache0)
    , MkPair String Bool "process-is-not-two-root-epoch"
        (notb (cg_session_recycle 2 0 False 0))
    , MkPair String Bool "hundred-small-roots-need-no-recycle"
        (notb (cg_session_recycle 100 0 False 0))
    , MkPair String Bool "process-root-count-is-bounded"
        (cg_session_recycle cg_session_max_roots 0 False 0)
    , MkPair String Bool "retained-dependency-bytes-recycle"
        (cg_session_recycle 2 cg_session_cache_bytes False 0)
    , MkPair String Bool "large-root-recycles"
        (cg_session_recycle 2 0 True 0)
    , MkPair String Bool "runtime-heap-watermark-recycles"
        (cg_session_recycle 2 0 False cg_session_heap_bytes)
    ];

def cs_all_laws : List (Pair String Bool) :=
    append (Pair String Bool) cs_laws cs_more_laws;

def cs_write (path : String) (source : String) : IO Unit :=
    do let! wrote := fs_write_checked path source;
       match wrote with
       | Left error =>
           do let! _e := eprintln (fs_error_message error);
              exit 1
       | Right _ => io_pure Unit MkUnit
       end

def cs_cached_symbol (state : CgSessionState) (source : String) : Maybe Nat :=
    match state with
    | MkCgSessionState _ cache _ _ _ => match cm_cache_lookup cache "dep.ouro" source with
      | CmCacheHit harvest => match harvest with
        | MkHarvest _ symbols _ _ => match symbols with
          | Nil => Nothing Nat
          | Cons decl rest => match rest with
            | Nil => Just Nat (sc_decl_name decl)
            | Cons _ _ => Nothing Nat
            end
          end
        end
      | CmCacheMiss => Nothing Nat
      | CmCacheStale => Nothing Nat
      end
    end;

def cs_epoch_cache_ok (state : CgSessionState) (source : String) (name : String)
    (expected : Nat) (passed : Bool) : Bool :=
    match state with
    | MkCgSessionState intern cache count actual _ =>
        andb (eq_nat count expected)
          (andb (match passed with | True => actual | False => notb actual end)
            (andb (eq_nat (cs_cache_count cache) 1)
              (match cs_cached_symbol state source with
               | Nothing => False
               | Just id => prim_string_eq (cm_name intern id) name
               end)))
    end;

-- Writes are sequenced between real, hooked native epochs. The same cache
-- and intern IDs must survive resets, including an intervening parse error.
def cs_epoch_lifetime_test (root : String) : IO Bool :=
    let before : String := "def before (A : Type) (x : A) : A := x;\n" in
    let after : String := "def after_ (A : Type) (x : A) : A := x;\n" in
    do let! _d := cs_write (quality_child root "dep.ouro") before;
       let! _a := cs_write (quality_child root "a.ouro")
         "import \"dep.ouro\";\ndef a (A : Type) (x : A) : A := x;\n";
       let! _b := cs_write (quality_child root "b.ouro")
         "import \"dep.ouro\";\ndef b (A : Type) (x : A) : A := x;\n";
       let! _e := cs_write (quality_child root "bad.ouro") "def broken : Nat := ;\n";
       let! first := cg_s_epoch_request (MkPair String (List (Pair Nat String)) root
         (cg_s_number_requests ["a.ouro", "b.ouro"] 0)) cg_s_state0;
       let! _m := cs_write (quality_child root "dep.ouro") after;
       let! second := cg_s_epoch_request (MkPair String (List (Pair Nat String)) root
         (cg_s_number_requests ["a.ouro", "b.ouro"] 2)) first;
       let! third := cg_s_epoch_request (MkPair String (List (Pair Nat String)) root
         (cg_s_number_requests ["bad.ouro", "a.ouro"] 4)) second;
       io_pure Bool (andb (eq_nat (prim_string_length before) (prim_string_length after))
         (andb (cs_epoch_cache_ok first before "before" 2 True)
           (andb (cs_epoch_cache_ok second after "after_" 4 True)
             (andb (cs_epoch_cache_ok third after "after_" 6 False)
               (match cs_cached_symbol second after with
                | Nothing => False
                | Just id => match cs_cached_symbol third after with
                  | Nothing => False
                  | Just next => eq_nat id next
                  end
                end)))))

def cs_run_laws (root : String) : IO Unit :=
    do let! lifetime := cs_epoch_lifetime_test root;
       let laws : List (Pair String Bool) := append (Pair String Bool) cs_all_laws
         [MkPair String Bool "cache-survives-epochs-edits-and-error-root" lifetime] in
       do let! _p := io_foreach (Pair String Bool) (fun (law : Pair String Bool) =>
            match law with
            | MkPair name passed => println (prim_string_concat
                (match passed with | True => "PASS " | False => "FAIL " end) name)
            end) laws;
          exit (match all (Pair String Bool) (fun (law : Pair String Bool) =>
            snd String Bool law) laws with | True => 0 | False => 1 end)

def main : IO Unit :=
    do let! argv := prim_argv;
       match tail String argv with
       | Cons root rest => match rest with
         | Nil => cs_run_laws root
         | Cons _ _ =>
             do let! _e := eprintln "session laws require one writable fixture directory";
                exit 1
         end
       | Nil =>
           do let! _e := eprintln "session laws require one writable fixture directory";
              exit 1
       end
