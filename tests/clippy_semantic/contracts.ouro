-- @entry main
import "../quality_test_support.ouro";
import "../../tools/clippy/semantic_contracts.ouro";
import "../../std/io.ouro";

def ct_decl (name : Nat) (body : Expr) : ScDecl :=
    ScDeclOf name 1 0 0 (EPi 20 (ESort 0) (ESort 0)) (Just Expr body) (Nothing Nat);
def ct_api (name : Nat) (body : Expr) : CmApi :=
    let decl : ScDecl := ct_decl name body in
    CmApiOf decl (CmContractOf "test.ouro" "local" 0 False 0 False) 1 1 (cs_unknown decl CsPending);
def ct_wrap (target : Nat) : Expr := ELam 20 (Nothing Expr) (EApp (EVar target) (EVar 20));
def ct_leaf : CmApi :=
    let decl : ScDecl := ct_decl 3 (EVar 20) in
    let registered : CmContract := CmContractOf "test.ouro" "checked" 23 False 0 False in
    CmApiOf decl registered 1 1 (cm_seed_summary decl registered);
def ct_index : CmApiIndex :=
    CmApiNode (ct_api 2 (ct_wrap 3)) (CmApiNode (ct_api 1 (ct_wrap 2)) CmApiEmpty CmApiEmpty)
      (CmApiNode ct_leaf CmApiEmpty CmApiEmpty);
def ct_run (depth : Nat) (budget : Nat) : CsAnalysis :=
    cs_infer depth 1 (CsAnalysisOf ct_index budget 0 0 0 0);
def ct_get (name : Nat) (state : CsAnalysis) : CsFunctionContract :=
    match cm_api_lookup name (cs_cache state) with
    | Nothing => cs_unknown (ct_decl name (EVar 0)) CsUnsupported
    | Just api => cm_api_summary api end;
def ct_identity : CsFunctionContract :=
    cs_direct_contract (ct_api 1 (EVar 20)) (CsArgumentOrigin 0);
def ct_ignored : CsFunctionContract :=
    cs_direct_contract (ct_api 1 (ENat 0)) (CsLiteralOrigin 1 0);
def ct_origin_arg (term : Expr) (position : Nat) : Bool :=
    match cs_local_origin 64 1 0 [] term with
    | CsArgumentOrigin arg => eq_nat arg position
    | CsUnknownOrigin => False | CsLiteralOrigin _ _ => False | CsDelegateOrigin _ _ => False end;
def ct_unknown (term : Expr) : Bool :=
    match cs_local_origin 64 1 0 [] term with
    | CsUnknownOrigin => True | CsArgumentOrigin _ => False
    | CsLiteralOrigin _ _ => False | CsDelegateOrigin _ _ => False end;
def ct_cycle : CsAnalysis :=
    cs_infer 8 1 (CsAnalysisOf
      (CmApiNode (ct_api 1 (ct_wrap 2)) CmApiEmpty
        (CmApiNode (ct_api 2 (ct_wrap 1)) CmApiEmpty CmApiEmpty)) 10 0 0 0 0);
def ct_many_hits : CsAnalysis :=
    foldl Nat CsAnalysis (fun (state : CsAnalysis) (_ : Nat) => cs_infer 8 1 state)
      (ct_run 8 10) (replicate Nat 0 100);
def ct_laws : List (Pair String Bool) :=
    [ MkPair String Bool "two-wrappers-retain-required-Result" (cs_required (ct_get 1 (ct_run 8 10)))
    , MkPair String Bool "two-wrappers-computed-once" (eq_nat (cs_computed (ct_run 8 10)) 2)
    , MkPair String Bool "expansion-count-bounded" (eq_nat (cs_expansions (ct_run 8 10)) 2)
    , MkPair String Bool "depth-exhaustion-blocks-proof" (notb (cs_required (ct_get 1 (ct_run 1 10))))
    , MkPair String Bool "budget-exhaustion-blocks-proof" (notb (cs_required (ct_get 1 (ct_run 8 1))))
    , MkPair String Bool "zero-budget-does-not-expand" (eq_nat (cs_expansions (ct_run 8 0)) 0)
    , MkPair String Bool "cycle-blocks-proof" (notb (cs_complete (ct_get 1 ct_cycle)))
    , MkPair String Bool "cycle-expands-only-two-edges" (eq_nat (cs_expansions ct_cycle) 2)
    , MkPair String Bool "identity-return-not-observation" (notb (cs_argument_escapes ct_identity 0))
    , MkPair String Bool "ignored-argument-not-observation" (notb (cs_argument_escapes ct_ignored 0))
    , MkPair String Bool "unknown-argument-is-possible-escape" (cs_argument_escapes
        (cs_unknown (ct_decl 1 (EVar 0)) CsUnsupported) 0)
    , MkPair String Bool "alias-retains-parameter-identity" (ct_origin_arg
        (ELam 20 (Nothing Expr) (ELet 21 (Nothing Expr) (EVar 20) (EVar 21))) 0)
    , MkPair String Bool "binder-rename-retains-origin" (ct_origin_arg
        (ELam 50 (Nothing Expr) (EVar 50)) 0)
    , MkPair String Bool "different-callee-is-resolved-by-ID"
        (match cs_local_origin 64 1 0 [] (ct_wrap 9) with
         | CsDelegateOrigin name _ => eq_nat name 9 | CsUnknownOrigin => False
         | CsArgumentOrigin _ => False | CsLiteralOrigin _ _ => False end)
    , MkPair String Bool "local-function-shadow-not-global-delegation" (ct_unknown
        (ELam 20 (Nothing Expr) (EApp (EVar 20) (EVar 20))))
    , MkPair String Bool "effect-before-delegation-blocks" (ct_unknown
        (ELam 20 (Nothing Expr) (EDo [EApp (EVar 8) (EVar 20), EApp (EVar 3) (EVar 20)])))
    , MkPair String Bool "branch-dependent-origin-unknown" (ct_unknown
        (ELam 20 (Nothing Expr) (EMatch (EVar 20) ENoBranch)))
    , MkPair String Bool "typed-adapter-is-not-pass-through" (ct_unknown
        (ELam 20 (Nothing Expr) (EAscribe (EVar 20) (ESort 0))))
    , MkPair String Bool "argument-order-exact" (cs_ordered_arguments [0,1,2] 0)
    , MkPair String Bool "reordered-arguments-break-proof" (notb (cs_ordered_arguments [1,0] 0))
    , MkPair String Bool "duplicated-argument-breaks-proof" (notb (cs_ordered_arguments [0,0] 0))
    , MkPair String Bool "100-demands-use-cache" (eq_nat (cs_computed ct_many_hits) 2)
    , MkPair String Bool "100-demands-add-cache-hits" (eq_nat (cs_hits ct_many_hits) 101)
    , MkPair String Bool "effect-summary-not-invented-pure" (notb (cs_pure (ct_get 1 (ct_run 8 10))))
    , MkPair String Bool "registry-pure-filesystem-contradiction"
        (notb (cm_contract_consistent (CmContractOf "std/fs.ouro" "fs_read" 1 True 0 False)))
    , MkPair String Bool "registry-checked-fallback-contradiction"
        (notb (cm_contract_consistent (CmContractOf "std/fs.ouro" "fs_read_checked" 23 False 0 True)))
    , MkPair String Bool "registry-missing-owner-rejected"
        (notb (cm_contract_consistent (CmContractOf "" "fs_read" 1 False 0 False)))
    ];
def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True ct_laws;
       exit (match ok with | True => 0 | False => 1 end)
