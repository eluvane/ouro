import "../../tools/clippy/semantic_definition.ouro";

def pp_decl : ScDecl :=
    ScDeclOf 300 1 0 0 (EPi(20, ESort 0, ESort 0)) (Nothing Expr) (Nothing Nat);

def pp_ctx : CmContext := CmContextOf pp_decl [] 1 False (Nothing Nat) False False 0;

def pp_state : CmState := CmStateOf 90 0 [] (Nothing (Pair Nat Nat)) [];

def pp_value : CmValue := CmValueOf 15 40 2 False False False;

def pp_api (role : Nat) (pure : Bool) (result : Nat) : CmApi :=
    let contract : CmContract := CmContractOf "std/text.ouro" "str_parse_nat" role pure 1 False in
    CmApiOf pp_decl contract 1 result (cm_seed_summary pp_decl contract);

def pp_unit : ClippySemanticUnit :=
    CmUnit empty_intern 1 "" [] [pp_decl]
      (ScNode pp_decl ScEmpty ScEmpty) [] 1 [] cm_empty_resolved_imports;

def pp_parse_api : CmApi := pp_api 15 True 2;

def pp_argument : CmValue := CmValueOf 4 7 0 False False True;

def pp_call_created (args : List CmValue) (count : Nat) : Bool :=
    match cm_apply_call pp_unit (CmApiNode pp_parse_api CmApiEmpty CmApiEmpty)
        pp_ctx 40 (CmValueOf 2 300 0 False False True) args pp_state with
    | Left _ => False
    | Right step => match step with | MkPair value after =>
        andb(eq_nat(length Nat (cm_flow_ids [10] (cm_events after)), count),
          match eq_nat count 0 with
          | True => notb (cm_pure_parse value)
          | False => andb(cm_pure_parse value, notb (cm_checked value)) end)
        end
    end;

def pp_exact_count (created : List Nat) (observed : List Nat) (count : Nat) : Bool :=
    let proofs : List CgSProof := cm_unobserved_pure_parse pp_decl "pure-parser law"
        created observed (Nothing Nat) in
    andb (eq_nat(length CgSProof proofs, count))
      (all CgSProof (fun (proof : CgSProof) => match proof with
        | MkCgSProof rule _ _ _ _ => prim_string_eq rule "OURO-CLIPPY-ERROR-004" end) proofs);

def pp_observed (kind : Nat) : Bool :=
    let after : CmState := cm_observe kind 42 pp_value (cm_observe 10 40 pp_value pp_state) in
    pp_exact_count (cm_flow_ids [10] (cm_events after)) (cm_flow_ids [3,4,6,9] (cm_events after)) 0;

def pp_alias_observed : Bool :=
    match cm_bind 100 pp_value pp_ctx (cm_observe 10 40 pp_value pp_state) with
    | MkPair scope bound => match cm_bind 101 pp_value scope bound with
      | MkPair aliases linked => match cm_variable pp_unit CmApiEmpty aliases 101 linked with
        | Left _ => False
        | Right step => match step with | MkPair value after =>
            let used : CmState := cm_observe 3 42 value after in
            andb(eq_nat(cm_value_id value, 40),
              pp_exact_count (cm_flow_ids [10] (cm_events used)) (cm_flow_ids [3,4,6,9] (cm_events used)) 0)
            end
        end
      end
    end;

def pp_laws : List (Pair String Bool) :=
    [ MkPair String Bool "pure-parse-full-call-creates-separate-obligation" (pp_call_created [pp_argument] 1)
    , MkPair String Bool "pure-parse-partial-call-is-clean" (pp_call_created [] 0)
    , MkPair String Bool "pure-parse-overapplied-call-is-clean" (pp_call_created [pp_argument,pp_argument] 0)
    , MkPair String Bool "pure-parse-generic-producer-is-clean" (notb (cm_pure_parse_call (pp_api 0 True 2) [pp_argument]))
    , MkPair String Bool "pure-parse-effectful-producer-is-clean" (notb (cm_pure_parse_call (pp_api 15 False 2) [pp_argument]))
    , MkPair String Bool "pure-parse-IO-result-is-clean" (notb (cm_pure_parse_call (pp_api 15 True 12) [pp_argument]))
    , MkPair String Bool "pure-parse-ordinary-result-is-clean" (notb (cm_pure_parse_call (pp_api 15 True 0) [pp_argument]))
    , MkPair String Bool "pure-parse-alias-discard-reports-once" (pp_exact_count [40,40,40] [] 1)
    , MkPair String Bool "pure-parse-unrelated-observation-does-not-hide-result" (pp_exact_count [40] [41] 1)
    , MkPair String Bool "pure-parse-match-observes" (pp_observed 3)
    , MkPair String Bool "pure-parse-return-or-escape-observes" (pp_observed 4)
    , MkPair String Bool "pure-parse-explicit-default-observes" (pp_observed 9)
    , MkPair String Bool "pure-parse-alias-observes-original" pp_alias_observed
    , MkPair String Bool "pure-parse-does-not-create-checked-failure-context"
        (notb (cm_error_arm (cm_context_pattern (cm_context_subject pp_ctx pp_value) 10)))
    , MkPair String Bool "generic-Maybe-does-not-create-pure-parse-flow"
        (nullb Nat (cm_flow_ids [10] (cm_events (cm_observe 10 40 (CmValueOf 1 40 2 False False False) pp_state))))
    ];
