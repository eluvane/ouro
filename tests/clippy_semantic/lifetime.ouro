-- Parser lifetime seam laws: the complete result, intern identities and typed
-- failures survive later calls. No allocation count or wall-clock assertions.
-- @entry main
import "../../tools/clippy/semantic_unit.ouro",
  "../../tools/clippy/structural_frontend.ouro",
  "../../std/io.ouro";

def cl_name (decls : List Decl) (intern : InternState) (expected : String) : Bool :=
    match decls with
    | Nil => False
    | Cons decl rest => andb (nullb Decl rest) (match decl with
      | DDef name _ _ _ _ => prim_string_eq(cm_name intern name, expected)
      | DImport _ => False
      | DAxiom _ _ => False
      | DInductive _ _ _ _ _ => False
      | DEffect _ _ _ => False
      | DIntrinsic _ _ _ _ => False
      | DExtern _ _ _ => False
      | DRepresentation _ _ => False end)
    end;

def cl_survivors : Bool :=
    match cm_parse "def retained (x : Nat) : Nat := x;" empty_intern with
    | Left _ => False
    | Right first => match first with | MkPair decls intern =>
      match cm_parse "def next (y : Nat) : Nat := y;" intern with
      | Left _ => False
      | Right second => match second with | MkPair next updated =>
        andb (cl_name decls intern "retained")
          (andb(cl_name next updated "next", cl_name decls updated "retained")) end
      end end
    end;

def cl_repeated : Nat -> InternState -> Bool :=
  fix go (count : Nat) (intern : InternState) : Bool :=
    match count with
    | Z => True
    | S less => match cm_parse "def same (value : Nat) : Nat := value;" intern with
      | Left _ => False
      | Right parsed => match parsed with | MkPair decls updated =>
        andb(cl_name decls updated "same", go less updated) end
      end
    end;

def cl_rejected (source : String) : Bool :=
    match cm_parse source empty_intern with | Left _ => True | Right _ => False end;

def cl_qualified_import_parses : Bool :=
    match cm_parse
        "import \"a.ouro\" as A; def value : Type := A.Shared;"
        empty_intern with
    | Left _ => False
    | Right _ => True
    end;

def cl_scoped_open_parses : Bool :=
    match cm_parse
        "import \"a.ouro\" as A; def value : Type := open A in Shared;"
        empty_intern with
    | Left _ => False
    | Right _ => True
    end;

def cl_record_alias_parses : Bool :=
    match cm_parse
        "record Point : Type where x : Nat; end; def point : Point := MkPoint Z; def get : Nat := point.x;"
        empty_intern with
    | Left _ => False
    | Right _ => True
    end;

def cl_cache_row_count (cache : CmParseCache) : Nat :=
    match cache with | MkCmParseCache rows => length CmCachedFile rows end;

def cl_cache_hit_reuses_row : Bool :=
    let src : String := "def n : Nat := Z;" in
    let req : Pair String String := MkPair String String "std/cache_reuse.ouro" src in
    match cm_load_file_cached req empty_intern cm_cache0 with
    | Left _ => False
    | Right first => match first with
      | MkPair _ cache =>
          match cm_load_file_cached req empty_intern cache with
          | Left _ => False
          | Right second => match second with
            | MkPair _ reused =>
                andb (eq_nat(cl_cache_row_count cache, S Z))
                  (eq_nat(cl_cache_row_count reused, S Z))
            end
          end
      end
    end;

def cl_cache_stale_replaces_row : Bool :=
    let src : String := "def n : Nat := Z;" in
    let other : String := "def n : Nat := S Z;" in
    let path : String := "std/cache_stale.ouro" in
    match cm_load_file_cached (MkPair String String path src) empty_intern cm_cache0 with
    | Left _ => False
    | Right first => match first with
      | MkPair _ cache =>
          match cm_cache_lookup cache path other with
          | CmCacheStale =>
              match cm_load_file_cached (MkPair String String path other)
                  empty_intern cache with
              | Left _ => False
              | Right second => match second with
                | MkPair _ next => andb (eq_nat(cl_cache_row_count next, S Z))
                    (andb (match cm_cache_lookup next path other with
                      | CmCacheHit _ => True
                      | CmCacheMiss => False
                      | CmCacheStale => False end)
                      (match cm_cache_lookup next path src with
                      | CmCacheStale => True
                      | CmCacheHit _ => False
                      | CmCacheMiss => False end))
                end
              end
          | CmCacheHit _ => False
          | CmCacheMiss => False
          end
      end
    end;

def cl_cache_reset_is_miss : Bool :=
    let src : String := "def n : Nat := Z;" in
    let path : String := "std/cache_reset.ouro" in
    match cm_load_file_cached (MkPair String String path src) empty_intern cm_cache0 with
    | Left _ => False
    | Right first => match first with
      | MkPair _ cache =>
          match cm_cache_lookup (cm_cache_reset cache) path src with
          | CmCacheMiss => True
          | CmCacheHit _ => False
          | CmCacheStale => False
          end
      end
    end;

def cl_private_source : String :=
    "private inductive Hidden : Type := | HiddenValue : Hidden; inductive Visible : Type := | VisibleValue : Visible;";

def cl_private_snapshot (file : CmHarvest) (intern : InternState) (private_expected : Bool) : Bool :=
    match file with | MkHarvest _ symbols _ parsed _ =>
      andb (all ScDecl (fun (decl : ScDecl) => match sc_decl_body decl with
        | Nothing => True | Just _ => False end) symbols)
        (match private_expected with
         | True => list_eq String prim_string_eq
             (map Nat String (fun (name : Nat) => cm_name intern name) (cm_parsed_private parsed))
             (["Hidden", "HiddenValue"] : List String)
         | False => nullb Nat (cm_parsed_private parsed) end)
    end;

def cl_private_cache : Bool :=
    let path : String := "private_owner.ouro" in
    let source : String := cl_private_source in
    let public_source : String := prim_string_replace source "private " "        " in
    match cm_load_file_cached (MkPair String String path source) empty_intern cm_cache0 with
    | Left _ => False
    | Right first => match first with | MkPair cold cache => match cold with
      | MkHarvest intern _ _ _ _ =>
        andb (cl_private_snapshot cold intern True)
          (andb (match cm_cache_lookup cache path source with
            | CmCacheHit stored => cl_private_snapshot stored intern True
            | CmCacheMiss => False | CmCacheStale => False end)
            (match cm_load_file_cached (MkPair String String path source) intern cache with
             | Left _ => False
             | Right second => match second with | MkPair warm reused =>
               andb (cl_private_snapshot warm intern True)
                 (andb (match cm_cache_lookup reused path public_source with
                   | CmCacheStale => True | CmCacheHit _ => False | CmCacheMiss => False end)
                   (match cm_load_file_cached (MkPair String String path public_source) intern reused with
                    | Left _ => False
                    | Right third => match third with | MkPair edited next =>
                      andb (cl_private_snapshot edited intern False)
                        (andb (match cm_cache_lookup next path public_source with
                          | CmCacheHit stored => cl_private_snapshot stored intern False
                          | CmCacheMiss => False | CmCacheStale => False end)
                          (eq_nat (prim_string_length source) (prim_string_length public_source)))
                      end
                    end))
               end
             end))
      end end
    end;

def cl_laws : List (Pair String Bool) :=
    [ MkPair String Bool "earlier-ast-and-intern-survive-later-parse" cl_survivors
    , MkPair String Bool "32-nested-calls-preserve-identities" (cl_repeated 32 empty_intern)
    , MkPair String Bool "parse-error-remains-error" (cl_rejected "def broken : Nat := ;")
    , MkPair String Bool "unterminated-string-remains-error" (cl_rejected "def broken : String := \"")
    , MkPair String Bool "malformed-import-remains-error" (cl_rejected "import ;")
    , MkPair String Bool "qualified-import-preprocessed-source-parses" cl_qualified_import_parses
    , MkPair String Bool "scoped-open-preprocessed-source-parses" cl_scoped_open_parses
    , MkPair String Bool "record-owner-marker-preprocessed-source-parses" cl_record_alias_parses
    , MkPair String Bool "raw-module-marker-remains-error"
        (cl_rejected "def invalid : Type := A@Shared;")
    , MkPair String Bool "success-after-error-remains-success"
        (andb(cl_rejected "def broken : Nat := ;", cl_survivors))
    , MkPair String Bool "content-addressed-cache-hit-reuses-row" cl_cache_hit_reuses_row
    , MkPair String Bool "content-addressed-cache-stale-replaces-row" cl_cache_stale_replaces_row
    , MkPair String Bool "content-addressed-cache-reset-is-miss" cl_cache_reset_is_miss
    , MkPair String Bool "private-names-survive-cold-hit-and-equal-length-edit" cl_private_cache
    ];
def main : IO Unit :=
    do io_foreach (Pair String Bool) (fun (law : Pair String Bool) => match law with
         | MkPair name passed => println (prim_string_concat
             (match passed with | True => "PASS " | False => "FAIL " end) name) end) cl_laws;
       exit (match all(Pair String Bool, fun (law : Pair String Bool) => snd String Bool law, cl_laws) with
         | True => 0 | False => 1 end)
