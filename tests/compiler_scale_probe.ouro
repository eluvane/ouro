-- The six retained 20k shapes exercise canonical checked APIs directly.
import "compiler_scale_fixtures.ouro";

def scale_constants (fuel : Nat) : List FileItem -> CheckEnvironment -> IndexedDeclarationResult :=
  fix check_items (items : List FileItem) (environment : CheckEnvironment) : IndexedDeclarationResult :=
    match items with
    | Nil => IndexedDeclarationsOk environment
    | Cons item rest => match check_indexed_declaration CheckExactCore fuel environment item with
        | IndexedDeclarationsErr name phase failure => IndexedDeclarationsErr name phase failure
        | IndexedDeclarationsOk next => check_items rest next
        end
    end;

def scale_constant_case (depth : Nat) (fuel : Nat) (entries : List Entry) : ProbeCase :=
    let items : List FileItem := probe_constant_items depth in
    let last : CoreTerm := CConst (add 99 depth) in
    MkProbeCase (append CheckInputWork
      (map FileItem CheckInputWork (fun (item : FileItem) => CheckInputItem item) items)
      ([CheckInputTerm last, CheckInputTerm retained_zero] : List CheckInputWork))
      (fun (_run : Unit) => match scale_constants fuel items (check_environment_from_entries entries) with
        | IndexedDeclarationsErr _ _ failure => probe_check_outcome(Unit, CheckErr Unit failure)
        | IndexedDeclarationsOk environment => probe_normal_bool (conv_checked_indexed fuel environment last retained_zero)
        end);

def scale_spine_case (depth : Nat) (fuel : Nat) (entries : List Entry) : ProbeCase :=
    let item : FileItem := FAxiom(70, probe_pi depth) in
    let term : CoreTerm := probe_spine depth in
    MkProbeCase ([CheckInputItem item, CheckInputTerms [], CheckInputTerm term] : List CheckInputWork)
      (fun (_run : Unit) => match check_declaration CheckExactCore fuel entries item with
        | DeclarationsErr _ _ failure => probe_check_outcome(Unit, CheckErr Unit failure)
        | DeclarationsOk environment => probe_inferred fuel retained_nat (infer_checked fuel environment [] (IGTerm term))
        end);

def scale_case (name : String) (depth : Nat) (fuel : Nat) (entries : List Entry) : Maybe ProbeCase :=
    match str_eq name "let-chain" with
    | True => let term : CoreTerm := probe_let depth in
        Just ProbeCase (MkProbeCase ([CheckInputTerms [], CheckInputTerm term, CheckInputTerm retained_nat] : List CheckInputWork)
          (fun (_run : Unit) => probe_check_outcome(Unit, check_term_checked fuel entries [] term retained_nat)))
    | False => match str_eq name "lam-chain" with
      | True => let term : CoreTerm := probe_lam depth in
          let expected : CoreTerm := probe_pi depth in
          Just ProbeCase (MkProbeCase ([CheckInputTerms [], CheckInputTerm term, CheckInputTerm expected] : List CheckInputWork)
            (fun (_run : Unit) => probe_check_outcome(Unit, check_term_checked fuel entries [] term expected)))
      | False => match str_eq name "app-spine" with
        | True => Just(ProbeCase, scale_spine_case depth fuel entries)
        | False => match str_eq name "nested-app" with
          | True => let term : CoreTerm := probe_app depth in
              Just ProbeCase (MkProbeCase
                ([CheckInputTerms [], CheckInputTerm term, CheckInputTerm retained_nat, CheckInputTerm term] : List CheckInputWork)
                (fun (_run : Unit) => probe_then
                  (probe_check_outcome(Unit, check_term_checked fuel entries [] term retained_nat))
                  (fun (_checked : Unit) => probe_same fuel term (normalize_checked fuel entries term))))
          | False => match str_eq name "domain-deep-pi" with
            | True => let term : CoreTerm := probe_domain depth in
                Just ProbeCase (MkProbeCase ([CheckInputTerms [], CheckInputTerm term] : List CheckInputWork)
                  (fun (_run : Unit) => probe_inferred(fuel, CSort 0, infer_checked fuel entries [] (IGTerm term))))
            | False => match str_eq name "const-chain" with
              | True => Just(ProbeCase, scale_constant_case depth fuel entries)
              | False => Nothing ProbeCase
              end
            end
          end
        end
      end
    end;

def scale_environment (name : String) (fuel : Nat) (entries : List Entry) : DeclarationResult :=
    match str_eq name "nested-app" with
    | True => probe_add_function fuel entries | False => DeclarationsOk entries end;

def scale_run (name : String) (depth : Nat) (fuel : Nat) : IO Unit :=
    match check_declaration CheckExactCore fuel [] (FInd retained_nat_decl) with
    | DeclarationsErr _ _ _ => do eprintln "KERNEL_SCALE_ENV_FAIL"; exit 1
    | DeclarationsOk entries => match scale_environment name fuel entries with
        | DeclarationsErr _ _ _ => do eprintln "KERNEL_SCALE_ENV_FAIL"; exit 1
        | DeclarationsOk environment => match scale_case name depth fuel environment with
            | Nothing => do eprintln "KERNEL_SCALE_UNKNOWN_OPERATION"; exit 2
            | Just case => probe_execute "SCALE" name depth case
            end
        end
    end;

def scale_inventory_predecessor (body : CoreTerm) : Maybe String :=
    match body with
    | CConst name => Just(String, str_of_nat name)
    | CConstruct _ _ _ => match eqTerm 8 body retained_zero with
        | True => Just String "zero" | False => Nothing String end
    | CRel _ => Nothing String | CSort _ => Nothing String | CPi _ _ => Nothing String
    | CLam _ _ => Nothing String | CApp _ _ => Nothing String | CLetIn _ _ _ => Nothing String
    | CInd _ => Nothing String | CCase _ _ _ _ => Nothing String | CFix _ _ _ _ _ => Nothing String
    | CStrLit _ _ => Nothing String | CStrBytes _ _ => Nothing String
    end;

def scale_inventory_item (item : FileItem) : Maybe String :=
    match item with
    | FDef name typ body => match eqTerm 8 typ retained_nat with
        | False => Nothing String
        | True => match scale_inventory_predecessor body with
            | Nothing => Nothing String
            | Just previous => Just(String, str_cat4 "KERNEL_SCALE_ITEM name=" (str_of_nat name) " predecessor=" previous)
            end
        end
    | FAxiom _ _ => Nothing String | FInd _ => Nothing String | FIntrinsic _ _ _ _ => Nothing String
    | FExtern _ _ _ => Nothing String | FRepresentation _ _ => Nothing String
    end;

def scale_inventory_items : List FileItem -> IO Unit :=
  fix emit (items : List FileItem) : IO Unit :=
    match items with
    | Nil => println "KERNEL_SCALE_INVENTORY_COMPLETE"
    | Cons item rest => match scale_inventory_item item with
        | Nothing => do eprintln "KERNEL_SCALE_INVENTORY_BAD_ITEM"; exit 1
        | Just line => do println line; emit rest
        end
    end;

-- Inventory is separate from the timed check. It prints every actual ID and
-- predecessor edge from the same item constructor consumed by scale_constants.
def scale_inventory (depth : Nat) : IO Unit :=
    (do println (str_concat("KERNEL_SCALE_INVENTORY_START count=", str_of_nat depth));
        scale_inventory_items (probe_constant_items depth));

-- @entry main
def main : IO Unit :=
    (do let! arguments := argv;
       let options : Args := cli_from_argv [] arguments in
       match cli_required options "operation" with
       | Left error => do eprintln (cli_error_message error); exit 2
       | Right name => match cli_required_nat options "depth" with
         | Left error => do eprintln (cli_error_message error); exit 2
         | Right depth => match str_eq name "inventory" with
           | True => scale_inventory depth
           | False => match cli_optional_nat options "fuel" (add(100, mul 8 depth)) with
             | Left error => do eprintln (cli_error_message error); exit 2
             | Right fuel => scale_run name depth fuel
             end
           end
         end
       end);
