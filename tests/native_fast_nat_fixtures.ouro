-- Original helper bodies are retained verbatim from checked std/compiler source.
-- Each variant is independently checked by the Ouro compiler in the laws.
import "../std/io.ouro";

def fast_nat_fixture_canonical : String :=
    "inductive Nat : Type :=\n  | Z : Nat\n  | S : Nat -> Nat;\n\nrepresentation Nat := \"ouro.nat\";\n\ninductive Bool : Type :=\n  | True : Bool\n  | False : Bool;\n\nrepresentation Bool := \"ouro.bool\";\n\ninductive Ordering : Type :=\n  | LT : Ordering\n  | EQ : Ordering\n  | GT : Ordering;\n\ndef eqNat : Nat -> Nat -> Bool :=\n  fix eqNat (n : Nat) (m : Nat) : Bool :=\n    match n with\n    | Z => match m with | Z => True | S _ => False end\n    | S n' => match m with | Z => False | S m' => eqNat n' m' end\n    end;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (add n' m) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n";

def fast_nat_fixture_renamed : String :=
    "inductive Padding : Type := | PadA : Padding | PadB : Padding;\ninductive Count : Type :=\n  | ZeroC : Count\n  | NextC : Count -> Count;\n\nrepresentation Count := \"ouro.nat\";\n\ninductive Truth : Type :=\n  | YesT : Truth\n  | NoT : Truth;\n\nrepresentation Truth := \"ouro.bool\";\n\ninductive Relation : Type :=\n  | BeforeR : Relation\n  | SameR : Relation\n  | AfterR : Relation;\n\ndef unrelated_one : Count -> Count -> Truth :=\n  fix unrelated_one (left : Count) (right : Count) : Truth :=\n    match left with\n    | ZeroC => match right with | ZeroC => YesT | NextC _ => NoT end\n    | NextC left' => match right with | ZeroC => NoT | NextC right' => unrelated_one left' right' end\n    end;\n\ndef unrelated_two : Count -> Count -> Count :=\n  fix unrelated_two (left : Count) (right : Count) : Count :=\n    match left with | ZeroC => right | NextC left' => NextC (unrelated_two left' right) end;\n\ndef unrelated_three : Count -> Count -> Count :=\n  fix unrelated_three (left : Count) (right : Count) : Count :=\n    match left with\n    | ZeroC => ZeroC\n    | NextC left' =>\n      match right with\n      | ZeroC => left\n      | NextC right' => unrelated_three left' right'\n      end\n    end;\n\ndef unrelated_four : Count -> Count -> Relation :=\n  fix unrelated_four (left : Count) (right : Count) : Relation :=\n    match left, right with\n    | ZeroC, ZeroC => SameR\n    | ZeroC, NextC _ => BeforeR\n    | NextC _, ZeroC => AfterR\n    | NextC left', NextC right' => unrelated_four left' right'\n    end;\n";

def fast_nat_fixture_constant_eq : String :=
    "inductive Nat : Type :=\n  | Z : Nat\n  | S : Nat -> Nat;\n\nrepresentation Nat := \"ouro.nat\";\n\ninductive Bool : Type :=\n  | True : Bool\n  | False : Bool;\n\nrepresentation Bool := \"ouro.bool\";\n\ninductive Ordering : Type :=\n  | LT : Ordering\n  | EQ : Ordering\n  | GT : Ordering;\n\ndef eqNat : Nat -> Nat -> Bool := fun (n : Nat) => fun (m : Nat) => True;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (add n' m) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n";

def fast_nat_fixture_inverted_eq : String :=
    "inductive Nat : Type :=\n  | Z : Nat\n  | S : Nat -> Nat;\n\nrepresentation Nat := \"ouro.nat\";\n\ninductive Bool : Type :=\n  | True : Bool\n  | False : Bool;\n\nrepresentation Bool := \"ouro.bool\";\n\ninductive Ordering : Type :=\n  | LT : Ordering\n  | EQ : Ordering\n  | GT : Ordering;\n\ndef eqNat : Nat -> Nat -> Bool :=\n  fix eqNat (n : Nat) (m : Nat) : Bool :=\n    match n with\n    | Z => match m with | Z => False | S _ => True end\n    | S n' => match m with | Z => True | S m' => eqNat n' m' end\n    end;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (add n' m) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n";

def fast_nat_fixture_changed_add : String :=
    "inductive Nat : Type :=\n  | Z : Nat\n  | S : Nat -> Nat;\n\nrepresentation Nat := \"ouro.nat\";\n\ninductive Bool : Type :=\n  | True : Bool\n  | False : Bool;\n\nrepresentation Bool := \"ouro.bool\";\n\ninductive Ordering : Type :=\n  | LT : Ordering\n  | EQ : Ordering\n  | GT : Ordering;\n\ndef eqNat : Nat -> Nat -> Bool :=\n  fix eqNat (n : Nat) (m : Nat) : Bool :=\n    match n with\n    | Z => match m with | Z => True | S _ => False end\n    | S n' => match m with | Z => False | S m' => eqNat n' m' end\n    end;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (S (add n' m)) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n";

