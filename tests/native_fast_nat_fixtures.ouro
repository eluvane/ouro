def fast_nat_fixture_foreign : String :=
    "inductive Nat : Type :=\n  | Z : Nat\n  | S : Nat -> Nat;\n\nrepresentation Nat := \"ouro.nat\";\n\ninductive Bool : Type :=\n  | True : Bool\n  | False : Bool;\n\nrepresentation Bool := \"ouro.bool\";\n\ninductive Ordering : Type :=\n  | LT : Ordering\n  | EQ : Ordering\n  | GT : Ordering;\n\ninductive Foreign : Type := | FZ : Foreign | FS : Foreign -> Foreign;\n\ndef eqNat : Foreign -> Foreign -> Bool :=\n  fix eqNat (n : Foreign) (m : Foreign) : Bool :=\n    match n with\n    | FZ => match m with | FZ => True | FS _ => False end\n    | FS n' => match m with | FZ => False | FS m' => eqNat n' m' end\n    end;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (add n' m) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n";

def fast_nat_fixture_non_enum : String :=
    "inductive Nat : Type :=\n  | Z : Nat\n  | S : Nat -> Nat;\n\nrepresentation Nat := \"ouro.nat\";\n\ninductive Bool : Type :=\n  | True : Bool\n  | False : Bool;\n\nrepresentation Bool := \"ouro.bool\";\n\ninductive Ordering : Type :=\n  | LT : Nat -> Ordering\n  | EQ : Ordering\n  | GT : Ordering;\n\ndef eqNat : Nat -> Nat -> Bool :=\n  fix eqNat (n : Nat) (m : Nat) : Bool :=\n    match n with\n    | Z => match m with | Z => True | S _ => False end\n    | S n' => match m with | Z => False | S m' => eqNat n' m' end\n    end;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (add n' m) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT Z\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n";
