-- These inputs are language source, not hand-constructed MIR. Every PE fixture
-- traverses compile_checked_source and the native checked-Core boundary.
import "../compiler/native/lower_source.ouro";
import "../std/io.ouro";

def lower_fixture_types : String :=
    "intrinsic W : Type := \"ouro.u32\"; intrinsic Runtime : Type -> Type := \"ouro.runtime\"; ";
def lower_fixture_pid_decl : String :=
    "extern pid : Runtime W := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetCurrentProcessId\" \"maygc\"; ";
def lower_fixture_actions : String :=
    "intrinsic pure : (A : Type) -> A -> Runtime A := \"ouro.runtime.pure\"; intrinsic bind : (A : Type) -> (B : Type) -> Runtime A -> (A -> Runtime B) -> Runtime B := \"ouro.runtime.bind\"; ";
def lower_fixture_arithmetic : String :=
    "intrinsic add : W -> W -> W := \"ouro.u32.add.wrap\"; intrinsic sub : W -> W -> W := \"ouro.u32.sub.wrap\"; intrinsic mulw : W -> W -> W := \"ouro.u32.mul.wrap\"; ";

def lower_fixture_join : List String -> String :=
  fix join (parts : List String) : String := match parts with
    | Nil => "" | Cons part rest => prim_string_concat part (join rest) end;

def lower_fixture_base : String := lower_fixture_join
    ([lower_fixture_types, lower_fixture_pid_decl, lower_fixture_actions, lower_fixture_arithmetic] : List String);

def lower_fixture_pid : String := lower_fixture_join
    ([lower_fixture_types, lower_fixture_pid_decl, "def main : Runtime W := pid;"] : List String);

def lower_fixture_calls5 : String := prim_string_concat lower_fixture_base
    "def five (a : W) (b : W) (c : W) (d : W) (e : W) : W := sub (add (add a b) (add c d)) e; def main : Runtime W := bind W W pid (fun (x : W) => let two : W := add x x in let three : W := add two x in let four : W := add three x in let nine : W := add four (add four x) in pure W (five x two three four nine));";

def lower_fixture_calls6 : String := prim_string_concat lower_fixture_base
    "def six (a : W) (b : W) (c : W) (d : W) (e : W) (f : W) : W := sub (add (add (add a b) (add c d)) e) f; def main : Runtime W := bind W W pid (fun (x : W) => let two : W := add x x in let three : W := add two x in let four : W := add three x in let five : W := add four x in let fourteen : W := add (add five five) four in pure W (six x two three four five fourteen));";

def lower_fixture_error_state : String :=
    "inductive Empty : Type := | EmptyValue : Empty; representation Empty := \"ouro.unit\"; extern set_error : W -> Runtime Empty := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"SetLastError\" \"nogc\"; extern get_error : Runtime W := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetLastError\" \"nogc\"; def increment (amount : W) : Runtime W := bind W W get_error (fun (before : W) => let after : W := add before amount in bind Empty W (set_error after) (fun (ignored : Empty) => pure W after)); ";

def lower_fixture_once : String := lower_fixture_join
    ([lower_fixture_base, lower_fixture_error_state,
      "def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in bind Empty W (set_error zero) (fun (ignored : Empty) => bind W W (increment x) (fun (first : W) => bind W W (increment x) (fun (second : W) => bind W W get_error (fun (current : W) => pure W (sub current x))))));"] : List String);

def lower_fixture_deferred : String := lower_fixture_join
    ([lower_fixture_base, lower_fixture_error_state,
      "def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in bind Empty W (set_error zero) (fun (ignored : Empty) => let delayed : Runtime W := increment x in bind W W get_error (fun (before : W) => bind Empty W (set_error zero) (fun (reset : Empty) => bind W W delayed (fun (observed : W) => bind W W get_error (fun (current : W) => pure W (sub (sub (add observed current) x) before)))))));"] : List String);

def lower_fixture_capture : String := lower_fixture_join
    ([lower_fixture_base, lower_fixture_error_state,
      "def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in bind Empty W (set_error zero) (fun (ignored : Empty) => let delayed : Runtime W := increment x in let x : W := add x x in bind W W delayed (fun (first : W) => bind W W delayed (fun (second : W) => pure W (sub second first)))));"] : List String);

def lower_fixture_word_types : String :=
    "intrinsic Wide : Type := \"ouro.u64\"; intrinsic Byte : Type := \"ouro.u8\"; intrinsic Signed : Type := \"ouro.i32\"; intrinsic Size : Type := \"ouro.usize\"; intrinsic widen : W -> Wide := \"ouro.convert.u32.u64.zext\"; intrinsic narrow : Wide -> W := \"ouro.convert.u64.u32.narrow.wrap\"; intrinsic as_size : Wide -> Size := \"ouro.convert.u64.usize.reinterpret\"; intrinsic as_wide : Size -> Wide := \"ouro.convert.usize.u64.reinterpret\"; intrinsic as_signed : W -> Signed := \"ouro.convert.u32.i32.reinterpret\"; intrinsic as_unsigned : Signed -> W := \"ouro.convert.i32.u32.reinterpret\"; intrinsic byte : W -> Byte := \"ouro.convert.u32.u8.narrow.wrap\"; intrinsic unbyte : Byte -> W := \"ouro.convert.u8.u32.zext\"; intrinsic wide_add : Wide -> Wide -> Wide := \"ouro.u64.add.wrap\"; intrinsic wide_sub : Wide -> Wide -> Wide := \"ouro.u64.sub.wrap\"; intrinsic signed_mul : Signed -> Signed -> Signed := \"ouro.i32.mul.wrap\"; ";

def lower_fixture_words : String := lower_fixture_join
    ([lower_fixture_base, lower_fixture_word_types,
      "def wrap (x : Wide) : Wide := let zero : Wide := wide_sub x x in wide_add (wide_sub zero x) (wide_add x x); def main : Runtime W := bind W W pid (fun (x : W) => pure W (as_unsigned (as_signed (narrow (as_wide (as_size (wrap (widen x))))))));"] : List String);

def lower_fixture_u8 : String := lower_fixture_join
    ([lower_fixture_base, lower_fixture_word_types,
      "def identity (x : Byte) : Byte := x; def main : Runtime W := bind W W pid (fun (x : W) => pure W (unbyte (identity (byte x))));"] : List String);

def lower_fixture_i32 : String := lower_fixture_join
    ([lower_fixture_base, lower_fixture_word_types,
      "def cube (x : Signed) : Signed := signed_mul (signed_mul x x) x; def main : Runtime W := bind W W pid (fun (x : W) => pure W (as_unsigned (cube (as_signed x)))) ;"] : List String);

def lower_fixture_pointer : String := prim_string_concat lower_fixture_base
    "intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic null : (A : Type) -> Pointer A := \"ouro.raw.null\"; extern self : Runtime (Pointer W) := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetCurrentProcess\" \"maygc\"; extern process_id : Pointer W -> Runtime W := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetProcessId\" \"maygc\"; def keep_pointer (p : Pointer W) (unused : Pointer W) : Pointer W := let saved : Pointer W := p in saved; def main : Runtime W := bind (Pointer W) W self (fun (p : Pointer W) => process_id (keep_pointer p (null W)));";

def lower_fixture_alias : String := prim_string_concat lower_fixture_base
    "def Alias : Type := W; def identity (x : Alias) : Alias := x; def main : Runtime Alias := bind W Alias pid (fun (x : W) => pure Alias (identity x));";

def lower_fixture_lambda : String := prim_string_concat lower_fixture_base
    "def main : Runtime W := bind W W pid (fun (x : W) => pure W ((fun (y : W) (z : W) => sub (add x y) z) x x));";

inductive NativeLowerFixture : Type :=
  | NativeLowerFixtureOf : String -> String -> Nat -> NativeLowerFixture;

-- Expected mode: 0=process ID, 1=low byte, 2=wrapping cube of process ID.
def lower_fixtures : List NativeLowerFixture :=
    [NativeLowerFixtureOf "pid" lower_fixture_pid 0,
     NativeLowerFixtureOf "calls5" lower_fixture_calls5 0,
     NativeLowerFixtureOf "calls6" lower_fixture_calls6 0,
     NativeLowerFixtureOf "once" lower_fixture_once 0,
     NativeLowerFixtureOf "deferred" lower_fixture_deferred 0,
     NativeLowerFixtureOf "capture" lower_fixture_capture 0,
     NativeLowerFixtureOf "words" lower_fixture_words 0,
     NativeLowerFixtureOf "u8" lower_fixture_u8 1,
     NativeLowerFixtureOf "i32" lower_fixture_i32 2,
     NativeLowerFixtureOf "pointer" lower_fixture_pointer 0,
     NativeLowerFixtureOf "alias" lower_fixture_alias 0,
     NativeLowerFixtureOf "lambda" lower_fixture_lambda 0];

def lower_fixture_fuel : Nat := mul 100 60;
def lower_fixture_main : List Nat := [109, 97, 105, 110];

def lower_fixture_compile (source : String) : Either NativeSourceError NativeImage :=
    native_compile_source lower_fixture_fuel mir_default_limits lower_fixture_main (prim_string_to_char_codes source);
