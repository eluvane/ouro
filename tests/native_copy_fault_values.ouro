-- Pure typed MIR probes. Raw helper bodies remain checked and retained.
-- Raw allocation slots are source count/bytes/wide, then target count/bytes/wide.
import "native_startup_fault_calls.ouro",
  "../compiler/native/managed_fs_copy.ouro";

def copy_fault_symbol_names : List String :=
    ["raw_pages_allocate", "raw_pages_release", "raw_windows_utf8_to_utf16",
      "raw_windows_file_copy", "windows_exit_process", "managed_collect"];

def copy_fault_symbols (checked : CheckedProgram) : Either NativeLowerError (List Nat) :=
    (fix resolve (names : List String) : Either NativeLowerError (List Nat) :=
      match names with | Nil => Right(NativeLowerError, List Nat, [] : List Nat)
      | Cons name rest => lower_bind Nat (List Nat) (managed_source_symbol(checked, prim_string_to_char_codes name))
          (fun (id : Nat) => lower_map(List Nat, List Nat, Cons Nat id, resolve rest)) end) copy_fault_symbol_names;

def copy_fault_target_bytes (mode : Nat) : Nat := match eqNat mode 23 with | True => 12 | False => 17 end;

-- Each row holds the exact requested byte count and the conversion calls
-- already completed in this invocation when that allocation is attempted.
def copy_fault_order_bytes (mode : Nat) : List Nat :=
    let target : Nat := copy_fault_target_bytes mode in
    (fix encode (rows : List (Pair Nat Nat)) : List Nat :=
      match rows with | Nil => ([] : List Nat) | Cons pair rest => match pair with | MkPair bytes phase =>
        append(Nat, append(Nat, Cons Nat bytes (pe_zeros 7), Cons Nat phase (pe_zeros 7)), encode rest) end end)
      [MkPair Nat Nat 8 0, MkPair Nat Nat 12 0, MkPair Nat Nat 26 1,
       MkPair Nat Nat 8 2, MkPair Nat Nat target 2, MkPair Nat Nat (mul(S target, 2)) 3];

def copy_fault_order_at (base : Nat) (depth : MirValue) (offset : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul depth (managed_bits MirUSize 16) state)
      (fun (scaled : ManagedResult) => match scaled with | ManagedResultOf relative next =>
        lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd relative (managed_bits MirUSize offset) next)
          (fun (added : ManagedResult) => match added with | ManagedResultOf at after =>
            lower_bind ManagedResult ManagedResult (managed_address(add base 33, after))
              (fun (located : ManagedResult) => match located with | ManagedResultOf table final =>
                managed_fresh MirUSize (fun (local : Nat) => MirLoadAt local table at) final end) end) end);

def copy_fault_conversion_count (base : Nat) (phase : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (startup_fault_load base 16 MirUSize state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf copies next =>
        lower_bind ManagedResult ManagedState (managed_binary MirUSize MirMul copies (managed_bits MirUSize 4) next)
          (fun (multiplied : ManagedResult) => match multiplied with | ManagedResultOf previous after =>
            lower_bind ManagedResult ManagedState (managed_binary MirUSize MirAdd previous phase after)
              (fun (added : ManagedResult) => match added with | ManagedResultOf expected final =>
                lower_bind ManagedResult ManagedState (startup_fault_load base 40 MirUSize final)
                  (fun (counted : ManagedResult) => match counted with | ManagedResultOf actual ready =>
                    managed_require_equal actual expected ready end) end) end) end);

def copy_fault_allocation_order (base : Nat) (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedState ManagedState (managed_require_equal(MirUse 1, managed_bits MirUSize 8, state))
      (fun (aligned : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 64 MirUSize aligned)
        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf depth next =>
          lower_bind ManagedResult ManagedState (managed_compare MirLess depth (managed_bits MirUSize 6) next)
            (fun (bounded : ManagedResult) => match bounded with | ManagedResultOf fits after =>
              lower_bind ManagedState ManagedState (managed_require_equal fits (managed_bits MirU8 1) after)
                (fun (valid : ManagedState) => lower_bind ManagedResult ManagedState (copy_fault_order_at base depth 0 valid)
                  (fun (sized : ManagedResult) => match sized with | ManagedResultOf bytes entered =>
                    lower_bind ManagedState ManagedState (managed_require_equal (MirUse 0) bytes entered)
                      (fun (exact : ManagedState) => lower_bind ManagedResult ManagedState (copy_fault_order_at base depth 8 exact)
                        (fun (ordered : ManagedResult) => match ordered with | ManagedResultOf phase final =>
                          copy_fault_conversion_count base phase final end)) end)) end) end));

def copy_fault_allocate (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (copy_fault_allocation_order base state)
      (fun (ordered : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 0 ordered)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf attempt next =>
          let failed_at : Nat := match andb(leb_nat 1 mode, leb_nat mode 6) with | True => mode | False => 0 end in
          lower_bind ManagedResult ManagedResult (managed_compare MirEqual attempt (managed_bits MirUSize failed_at) next)
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf failed after =>
              managed_string_choose MirRawPtr failed (startup_fault_result MirRawPtr 0)
                (fun (entered : ManagedState) => lower_bind ManagedResult ManagedResult
                  (startup_fault_call MirRawPtr original ([MirUse 0, MirUse 1] : List MirValue) entered)
                  (fun (allocated : ManagedResult) => match allocated with | ManagedResultOf pointer final =>
                    lower_bind ManagedResult ManagedResult (managed_compare MirNotEqual pointer (managed_bits MirRawPtr 0) final)
                      (fun (tested : ManagedResult) => match tested with | ManagedResultOf valid ready =>
                        lower_bind ManagedState ManagedResult (managed_require_equal valid (managed_bits MirU8 1) ready)
                          (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 120 owned)
                            (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ stored =>
                              startup_fault_push base pointer stored end)) end) end)) after end) end));

def copy_fault_pointer (base : Nat) (slot : Nat) (actual : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (startup_fault_load base (add(128, mul slot 8)) MirRawPtr state)
      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf expected next =>
        managed_require_equal actual expected next end);

def copy_fault_conversion_arguments (base : Nat) (mode : Nat) (source : Bool) (query : Bool) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let slot : Nat := match source with | True => 0 | False => 3 end in
    let bytes : Nat := match source with | True => 12 | False => copy_fault_target_bytes mode end in
    let phase : Nat := add(match source with | True => 0 | False => 2 end, match query with | True => 1 | False => 2 end) in
    lower_bind ManagedState ManagedState (startup_fault_stat base 64 (add(slot, match query with | True => 2 | False => 3 end)) state)
      (fun (depth : ManagedState) => lower_bind ManagedState ManagedState (copy_fault_conversion_count base (managed_bits MirUSize phase) depth)
        (fun (ordered : ManagedState) => lower_bind ManagedState ManagedState (copy_fault_pointer(base, S slot, MirUse 0, ordered))
          (fun (buffer : ManagedState) => lower_bind ManagedState ManagedState (managed_require_equal(MirUse 1, managed_bits MirUSize bytes, buffer))
            (fun (sized : ManagedState) => lower_bind ManagedState ManagedState (copy_fault_pointer base slot (MirUse 4) sized)
              (fun (counted : ManagedState) => lower_bind ManagedState ManagedState
                (match query with
                 | True => managed_require_equal(MirUse 2, managed_bits MirRawPtr 0, counted)
                 | False => copy_fault_pointer(base, add slot 2, MirUse 2, counted) end)
                (fun (target : ManagedState) => managed_require_equal (MirUse 3)
                  (managed_bits(MirUSize, match query with | True => 0 | False => bytes end)) target))))));

def copy_fault_conversion_result (base : Nat) (mode : Nat) (source : Bool) (query : Bool)
    (original : Nat) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    let first_mode : Nat := match source with | True => 7 | False => 11 end in
    let fail : Nat := add(first_mode, match query with | True => 0 | False => 1 end) in
    lower_bind ManagedState ManagedResult (copy_fault_conversion_arguments base mode source query state)
      (fun (ordered : ManagedState) => match eqNat mode fail with | True => startup_fault_result MirU32 5 ordered
        | False => lower_bind ManagedResult ManagedResult
            (startup_fault_call MirU32 original ([MirUse 0, MirUse 1, MirUse 2, MirUse 3, MirUse 4] : List MirValue) ordered)
            (fun (converted : ManagedResult) => match converted with | ManagedResultOf status next =>
              lower_map ManagedState ManagedResult (fun (checked : ManagedState) =>
                let inject : Bool := eqNat(mode, add(first_mode, match query with | True => 3 | False => 2 end)) in
                ManagedResultOf status (match inject with | False => checked | True =>
                  managed_emit (MirStore (MirUse 4) (codegen_disp 0)
                    (match query with
                     | True => MirBits(MirU32, X64Words64(X64Bytes32 255 255 255 127, codegen_zero))
                     | False => managed_bits MirU32 0 end)) checked end))
                (managed_require_equal status (managed_bits MirU32 0) next) end) end);

def copy_fault_conversion (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (startup_fault_count base 40 state)
      (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
        lower_bind ManagedResult ManagedResult (startup_fault_load base 64 MirUSize next)
          (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf depth after =>
            lower_bind ManagedResult ManagedResult (managed_compare MirLessEqual depth (managed_bits MirUSize 3) after)
              (fun (selected : ManagedResult) => match selected with | ManagedResultOf source entered =>
                lower_bind ManagedResult ManagedResult (managed_compare(MirEqual, MirUse 2, managed_bits MirRawPtr 0, entered))
                  (fun (queried : ManagedResult) => match queried with | ManagedResultOf query final =>
                    managed_string_choose MirU32 source
                      (managed_string_choose MirU32 query (copy_fault_conversion_result base mode True True original)
                        (copy_fault_conversion_result base mode True False original))
                      (managed_string_choose MirU32 query (copy_fault_conversion_result base mode False True original)
                        (copy_fault_conversion_result base mode False False original)) final end) end) end) end);
