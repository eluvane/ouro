-- Shared typed-MIR fixture helpers for stdin, stdio and time suites.
import "native_managed_fixtures.ouro";
import "../compiler/native/managed_strings.ouro";

def native_managed_fixture_store (symbol : Nat) (offset : Nat) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_map ManagedResult ManagedState (fun (address : ManagedResult) => match address with
      | ManagedResultOf base next => managed_emit (MirStore base (codegen_disp offset) value) next end)
      (managed_address symbol state);

def native_managed_fixture_increment (symbol : Nat) (offset : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_address symbol state)
      (fun (address : ManagedResult) => match address with | ManagedResultOf base next =>
        lower_bind ManagedResult ManagedResult (managed_load MirUSize base offset next)
          (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf count after =>
            lower_map ManagedResult ManagedResult (fun (added : ManagedResult) => match added with
              | ManagedResultOf total ready => ManagedResultOf total
                  (managed_emit (MirStore base (codegen_disp offset) total) ready) end)
              (managed_binary MirUSize MirAdd count (managed_bits MirUSize 1) after) end) end);

def native_managed_fixture_text (compiler : ManagedCompiler) (value : MirValue) (expected : List Nat)
    (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (managed_string_literal compiler expected state)
      (fun (literal : ManagedResult) => match literal with | ManagedResultOf wanted next =>
        lower_bind ManagedResult ManagedState (managed_string_size compiler value next)
          (fun (sized : ManagedResult) => match sized with | ManagedResultOf size after =>
            lower_bind ManagedState ManagedState (managed_require_equal size (managed_bits MirUSize (length Nat expected)) after)
              (fun (bounded : ManagedState) => lower_bind ManagedResult ManagedState
                (managed_bytes_equal value (managed_bits MirUSize 40) wanted (managed_bits MirUSize 40) size bounded)
                (fun (compared : ManagedResult) => match compared with | ManagedResultOf equal ready =>
                  managed_require_equal equal (managed_bits MirU8 1) ready end)) end) end);

def native_managed_fixture_function (id : Nat) (name : List Nat) (arguments : List MirLocal) (result : Maybe MirType)
    (body : ManagedState -> Either NativeLowerError ManagedResult) : Either NativeLowerError MirFunction :=
    lower_map ManagedResult MirFunction (fun (compiled : ManagedResult) => match compiled with
      | ManagedResultOf value after => match managed_flow after with | LowerStateOf _ locals _ _ =>
        MirFunctionDef id name arguments (reverse MirLocal locals) result 0
          (lower_finish_blocks (match result with | Nothing => MirTrap
            | Just _ => MirReturn (Just MirValue value) end) (managed_flow after)) end end)
      (body (ManagedStateOf 0 ([] : List MirFunction) ([] : List MirData) ([] : List Nat) ([] : List Nat)
        (lower_empty_state (length MirLocal arguments))));
