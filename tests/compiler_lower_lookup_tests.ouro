import "../compiler/lower_env.ouro",
  "../std/test.ouro";
import "compiler_wide_nat_fixtures.ouro";

def lower_lookup_is_sort (level : Nat) (result : Maybe Surface) : Bool :=
    match result with
    | Nothing => False
    | Just surface => if let SSort actual := surface then eqNat actual level else False
    end;

def lower_lookup_is_missing (result : Maybe Surface) : Bool :=
    match result with | Nothing => True | Just _ => False end;

def lower_lookup_wide_base : Nat := compiler_test_wide_nat_base;

def lower_lookup_tests : List Test :=
    let first : Surface := SSort 1 in
    let second : Surface := SSort 2 in
    let same_name : List (Pair Nat Surface) := [MkPair Nat Surface 7 first, MkPair Nat Surface 7 second] in
    let changed : List (Pair Nat Surface) := [MkPair Nat Surface 7 second] in
    let find : List (Pair Nat Surface) -> Maybe Surface := lookup_local 7 in
    let wide_base : Nat := lower_lookup_wide_base in
    let wide : Nat := S wide_base in
    let packed_wide : Nat := add wide_base 1 in
    let wider : Nat := add wide_base 2 in
    let hints : List (Pair Nat Surface) := [MkPair Nat Surface 7 second] in
    let env : LowerEnv := MkLowerEnv [] [] [] empty_special_ids hints hints [] in
    [ assert_true "lower lookup empty list" (lower_lookup_is_missing (find []))
    , assert_true "lower lookup missing name" (lower_lookup_is_missing (lookup_local 8 same_name))
    , assert_true "lower lookup first duplicate shadows later payload"
        (lower_lookup_is_sort 1 (find same_name))
    , assert_true "lower lookup partial uses each changed list"
        (andb (lower_lookup_is_sort 2 (find changed)) (lower_lookup_is_sort 1 (find same_name)))
    , assert_true "lower lookup global hint keeps first duplicate"
        (lower_lookup_is_sort 1 (lookup_decl_type
          (MkLowerEnv [] [] [] empty_special_ids [] same_name []) 7))
    , assert_true "lower lookup lexical hint precedes global type"
        (lower_lookup_is_sort 1 (surface_type_hint env same_name 1 (SVar 7)))
    , assert_true "lower lookup global hint fallback remains available"
        (lower_lookup_is_sort 2 (surface_type_hint env [] 1 (SVar 7)))
    , assert_true "lower lookup exhausted hint fuel remains missing"
        (lower_lookup_is_missing (surface_type_hint env same_name 0 (SVar 7)))
    , assert_true "lower lookup wide packed query matches successor key"
        (lower_lookup_is_sort 1 (lookup_local packed_wide [MkPair Nat Surface wide first]))
    , assert_true "lower lookup wide successor query matches packed key"
        (lower_lookup_is_sort 2 (lookup_local wide [MkPair Nat Surface packed_wide second]))
    , assert_true "lower lookup wide names retain low-word distinction"
        (lower_lookup_is_missing (lookup_local 1 [MkPair Nat Surface wide first]))
    , assert_true "lower lookup mixed wide prefix retains complete fallback"
        (lower_lookup_is_sort 2 (lookup_local 7 [MkPair Nat Surface wide first, MkPair Nat Surface 7 second]))
    , assert_true "lower lookup distinct wide names stay missing"
        (lower_lookup_is_missing (lookup_local wider [MkPair Nat Surface wide first]))
    , assert_true "lower lookup mixed packed and successor duplicates keep first hit"
        (lower_lookup_is_sort 1 (lookup_local wide
          [MkPair Nat Surface packed_wide first, MkPair Nat Surface wide second]))
    ];

-- @entry main
def main : IO Unit := test_run lower_lookup_tests;
