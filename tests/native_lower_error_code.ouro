-- Shared NativeLowerError numeric codes for lower and runtime-driver suites.
import "../compiler/native/diagnostics.ouro";

def native_lower_error_code (error : NativeLowerError) : Nat :=
    match error with
    | LowerResourceExhausted => 0 | LowerDeclarationFailure _ _ _ => 1
    | LowerMetadataMismatch _ => 2 | LowerBodyMismatch _ => 3
    | LowerUnsupportedType _ => 4 | LowerUnsupportedTerm _ => 5
    | LowerUnsupportedPrimitive _ => 6 | LowerUnknownGlobal _ => 7
    | LowerUnboundLocal _ => 8 | LowerInvalidCall _ => 9 | LowerEffectMismatch => 10
    | LowerInvalidEntry _ => 11 | LowerMirFailure _ => 12 | LowerBackendFailure _ => 13 end;
