-- Reporting only; each law suite retains its independent assertions.
import "../std/io.ouro";

def quality_test_print (ok : Bool) (row : Pair String Bool) : IO Bool :=
    match row with | MkPair name passed =>
      do println (prim_string_concat(match passed with | True => "PASS " | False => "FAIL " end, name));
         io_pure(Bool, andb ok passed) end;
