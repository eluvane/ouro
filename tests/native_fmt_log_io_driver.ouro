import "../tools/fmt.ouro" as Formatter;
import "../std/io.ouro",
  "../std/args.ouro",
  "../std/string.ouro";

def native_fmt_log_driver_run (mode : String) (path : String) : IO Unit :=
    if prim_string_eq mode "--init-empty" then Formatter.fmt_selftest_write path ""
    else
      if prim_string_eq mode "--write-raw" then
        Formatter.fmt_selftest_write path
          (str_of_codes [65, 0, 255, 128, 13, 10, 90])
      else
        if prim_string_eq mode "--append-quiet" then Formatter.fmt_selftest_append path ""
        else
          if prim_string_eq mode "--append-raw" then
            Formatter.fmt_selftest_append path
              (str_of_codes [79, 0, 255, 13, 10, 69, 13])
          else exit 2;

-- @entry main
def main : IO Unit :=
    do let! values := argv;
       match values with
       | Nil => exit 2
       | Cons _ arguments => match arguments with
         | Nil => exit 2
         | Cons mode rest => match rest with
           | Nil => exit 2
           | Cons path extra => match extra with
             | Nil => native_fmt_log_driver_run mode path
             | Cons _ _ => exit 2 end end end
       end;
