-- Representation contracts apply to checked inductives and preserve Core identity.
import "../compiler/file_elab.ouro",
  "../compiler/file_elab_lookup.ouro",
  "../std/io.ouro",
  "compiler_test_phase.ouro";

inductive RepresentationLaw : Type :=
  | RepresentationLawOf : String -> Bool -> String -> RepresentationLaw;

def representation_fuel : Nat := mul 20 50;

def representation_key (role : PrimitiveRole) : List Nat :=
    match role with
    | PrimitiveNatRole => ([111, 117, 114, 111, 46, 110, 97, 116] : List Nat)
    | PrimitiveBoolRole => ([111, 117, 114, 111, 46, 98, 111, 111, 108] : List Nat)
    | PrimitiveUnitRole => ([111, 117, 114, 111, 46, 117, 110, 105, 116] : List Nat)
    | PrimitiveListRole => ([111, 117, 114, 111, 46, 108, 105, 115, 116] : List Nat)
    | PrimitiveMaybeRole => ([111, 117, 114, 111, 46, 109, 97, 121, 98, 101] : List Nat)
    | PrimitivePairRole => ([111, 117, 114, 111, 46, 112, 97, 105, 114] : List Nat)
    end;

-- Constructor IDs deliberately differ from their runtime ordinals.
def representation_nat : IndDecl :=
    MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor(42, CInd 10), MkCtor(7, CPi(CInd 10, CInd 10))] : List Ctor);

def representation_bool : IndDecl :=
    MkIndDecl 20 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor(21, CInd 20), MkCtor(22, CInd 20)] : List Ctor);

def representation_unit : IndDecl :=
    MkIndDecl(30, Nil Param, Nil CoreTerm, 0, [MkCtor(31, CInd 30)] : List Ctor);

def representation_list_empty : CoreTerm := CPi(CSort 0, CApp(CInd 40, CRel 0));
def representation_list_cons : CoreTerm :=
    CPi (CSort 0) (CPi (CRel 0)
      (CPi(CApp(CInd 40, CRel 1), CApp(CInd 40, CRel 2))));

def representation_list : IndDecl :=
    MkIndDecl 40 ([MkParam(1, CSort 0)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 41 representation_list_empty, MkCtor 43 representation_list_cons] : List Ctor);

def representation_maybe : IndDecl :=
    MkIndDecl 50 ([MkParam(2, CSort 0)] : List Param) (Nil CoreTerm) 0
      ([ MkCtor(51, CPi(CSort 0, CApp(CInd 50, CRel 0)))
       , MkCtor(52, CPi(CSort 0, CPi(CRel 0, CApp(CInd 50, CRel 1))))
       ] : List Ctor);

def representation_pair (second_field : CoreTerm) : IndDecl :=
    MkIndDecl 60 ([MkParam(3, CSort 0), MkParam(4, CSort 0)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 61
        (CPi (CSort 0) (CPi (CSort 0) (CPi (CRel 1) (CPi second_field
          (CApp(CApp(CInd 60, CRel 3), CRel 2))))))] : List Ctor);

def representation_second_nat (constructors : List Ctor) : IndDecl :=
    MkIndDecl 70 (Nil Param) (Nil CoreTerm) 0 constructors;

def representation_indexed_nat : IndDecl :=
    let indexed : CoreTerm := CApp(CInd 70, CConstruct 10 0 0) in
    MkIndDecl 70 (Nil Param) ([CInd 10] : List CoreTerm) 0
      ([MkCtor 71 indexed, MkCtor(72, CPi indexed indexed)] : List Ctor);

def representation_check (items : List FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking representation_fuel items;

def representation_status (result : DeclarationResult) : String :=
    match result with
    | DeclarationsOk _ => "accepted"
    | DeclarationsErr name phase failure =>
        prim_string_concat "declaration=" (prim_string_concat (prim_string_of_nat name)
          (prim_string_concat " phase=" (prim_string_concat (prim_string_of_nat (compiler_test_phase_nat phase))
            (prim_string_concat " code=" (prim_string_of_nat
              (declaration_failure_code CheckExactCore phase failure))))))
    end;

def representation_accept (name : String) (count : Nat) (items : List FileItem) : RepresentationLaw :=
    let result : DeclarationResult := representation_check items in
    RepresentationLawOf name
      (match result with | DeclarationsErr _ _ _ => False
       | DeclarationsOk entries => eqNat(length Entry entries, count) end)
      (representation_status result);

-- These are exact-Core codes; the frontend adds the diagnostic family offset.
-- Checking the phase prevents an invalid inductive fixture from satisfying a
-- rejection that must occur at the later representation declaration.
def representation_reject (name : String) (target : Nat) (code : Nat)
    (items : List FileItem) : RepresentationLaw :=
    let result : DeclarationResult := representation_check items in
    RepresentationLawOf name
      (match result with
       | DeclarationsOk _ => False
       | DeclarationsErr actual phase failure =>
           andb (eqNat actual target) (andb (eqNat(compiler_test_phase_nat phase, 1))
             (eqNat(code, declaration_failure_code CheckExactCore phase failure)))
       end) (representation_status result);

def representation_register (name : String) (role : PrimitiveRole) (decl : IndDecl) : RepresentationLaw :=
    match decl with
    | MkIndDecl target _ _ _ _ =>
        let result : DeclarationResult := representation_check
          ([FInd decl, FRepresentation(target, representation_key role)] : List FileItem) in
        RepresentationLawOf name
          (match result with
           | DeclarationsErr _ _ _ => False
           | DeclarationsOk entries =>
               andb (eqNat(length Entry entries, 2))
                 (match primitive_roles_environment entries with
                  | Nil => False
                  | Cons binding rest =>
                      andb (eqNat(length PrimitiveRoleBinding rest, 0))
                        (andb (eqNat(primitive_role_id binding, target))
                          (primitive_role_equal(primitive_role_kind binding, role)))
                  end)
           end) (representation_status result)
    end;

def representation_metadata : RepresentationLaw :=
    let result : DeclarationResult := representation_check
      ([FInd representation_list, FRepresentation(40, representation_key PrimitiveListRole)] : List FileItem) in
    RepresentationLawOf "metadata retains every List parameter and constructor type"
      (match result with
       | DeclarationsErr _ _ _ => False
       | DeclarationsOk entries =>
           match primitive_roles_environment entries with
           | Nil => False
           | Cons binding _ =>
               match binding with
               | PrimitiveRoleOf role shape =>
                   match shape with
                   | PrimitiveInductiveOf id parameters indices family constructors =>
                       andb (primitive_role_equal role PrimitiveListRole)
                         (andb (eqNat id 40) (andb (eqNat parameters 1) (andb (eqNat indices 0)
                           (andb (eqTerm representation_fuel family (CPi(CSort 0, CSort 0)))
                             (check_bool (check_from_normalize Bool
                               (eq_term_list eqTerm_checked representation_fuel constructors
                                 ([representation_list_empty, representation_list_cons] : List CoreTerm))))))))
                   end
               end
           end
       end) (representation_status result);

def representation_identity : RepresentationLaw :=
    let result : DeclarationResult := representation_check
      ([FInd representation_nat, FRepresentation(10, representation_key PrimitiveNatRole),
        FDef(73, CSort 0, CInd 10)] : List FileItem) in
    RepresentationLawOf "representation preserves Core identity and transparent type aliases"
      (match result with
       | DeclarationsErr _ _ _ => False
       | DeclarationsOk entries =>
           andb (match lookup_const 10 entries with | Nothing => True | Just _ => False end)
             (andb (check_succeeded Unit
               (check_convertible(representation_fuel, entries, CConst 73, CInd 10)))
               (check_succeeded Unit (check_term_checked representation_fuel entries
                 (Nil CoreTerm) (CConstruct 10 0 0) (CInd 10))))
       end) (representation_status result);

def representation_word : FileItem := FIntrinsic 80 (CSort 0)
    ([111, 117, 114, 111, 46, 117, 51, 50] : List Nat) (Nothing CoreTerm);

def representation_from_nat : FileItem :=
    FIntrinsic 81 (CPi(CInd 10, CApp(CInd 50, CConst 80)))
      ([111, 117, 114, 111, 46, 117, 51, 50, 46, 102, 114, 111, 109, 95,
        110, 97, 116, 46, 99, 104, 101, 99, 107, 101, 100] : List Nat) (Nothing CoreTerm);

def representation_equal : FileItem :=
    FIntrinsic 82 (CPi(CConst 80, CPi(CConst 80, CInd 20)))
      ([111, 117, 114, 111, 46, 117, 51, 50, 46, 101, 113] : List Nat) (Nothing CoreTerm);

def representation_valid_laws : List RepresentationLaw :=
    [ representation_register "Nat accepts arbitrary declaration and constructor IDs" PrimitiveNatRole representation_nat
    , representation_register "Bool representation accepts two nullary constructors" PrimitiveBoolRole representation_bool
    , representation_register "Unit representation accepts its one nullary constructor" PrimitiveUnitRole representation_unit
    , representation_register "List representation checks its parameter and recursive field" PrimitiveListRole representation_list
    , representation_register "Maybe representation checks its parameter and payload" PrimitiveMaybeRole representation_maybe
    , representation_register "Pair representation checks both parameter identities" PrimitivePairRole (representation_pair (CRel 1))
    , representation_metadata
    , representation_identity
    ];

def representation_identity_laws : List RepresentationLaw :=
    [ representation_reject "unknown representation key is unsupported" 10 7
        ([FInd representation_nat, FRepresentation(10, [111, 117, 114, 111, 46, 110, 97, 116, 105, 118, 101] : List Nat)] : List FileItem)
    , representation_reject "representation cannot bind an unknown inductive ID" 99 6
        ([FRepresentation(99, representation_key PrimitiveNatRole)] : List FileItem)
    , representation_reject "an axiom cannot acquire an inductive representation" 73 6
        ([FAxiom(73, CSort 0), FRepresentation(73, representation_key PrimitiveNatRole)] : List FileItem)
    , representation_reject "a transparent alias cannot replace the inductive identity" 73 6
        ([FInd representation_nat, FDef(73, CSort 0, CInd 10),
          FRepresentation(73, representation_key PrimitiveNatRole)] : List FileItem)
    , representation_reject "one representation kind cannot bind two inductive IDs" 70 5
        ([FInd representation_nat,
          FInd (representation_second_nat ([MkCtor(71, CInd 70), MkCtor(72, CPi(CInd 70, CInd 70))] : List Ctor)),
          FRepresentation(10, representation_key PrimitiveNatRole),
          FRepresentation(70, representation_key PrimitiveNatRole)] : List FileItem)
    , representation_reject "one inductive ID cannot bind two representation kinds" 10 5
        ([FInd representation_nat, FRepresentation(10, representation_key PrimitiveNatRole),
          FRepresentation(10, representation_key PrimitiveBoolRole)] : List FileItem)
    ];

def representation_shape_laws : List RepresentationLaw :=
    [ representation_reject "Nat representation rejects a wrong constructor count" 70 2
        ([FInd (representation_second_nat ([MkCtor(71, CInd 70)] : List Ctor)),
          FRepresentation(70, representation_key PrimitiveNatRole)] : List FileItem)
    , representation_reject "Nat representation rejects reversed constructor ordinals" 70 2
        ([FInd (representation_second_nat ([MkCtor(71, CPi(CInd 70, CInd 70)), MkCtor(72, CInd 70)] : List Ctor)),
          FRepresentation(70, representation_key PrimitiveNatRole)] : List FileItem)
    , representation_reject "Nat successor domain must be the same inductive identity" 70 2
        ([FInd representation_nat,
          FInd (representation_second_nat ([MkCtor(71, CInd 70), MkCtor(72, CPi(CInd 10, CInd 70))] : List Ctor)),
          FRepresentation(70, representation_key PrimitiveNatRole)] : List FileItem)
    , representation_reject "List representation rejects an absent recursive tail field" 50 2
        ([FInd representation_maybe, FRepresentation(50, representation_key PrimitiveListRole)] : List FileItem)
    , representation_reject "Pair second field must use the second type parameter" 60 2
        ([FInd (representation_pair (CRel 2)), FRepresentation(60, representation_key PrimitivePairRole)] : List FileItem)
    , representation_reject "indexed inductive cannot acquire the ordinary Nat representation" 70 2
        ([FInd representation_nat, FInd representation_indexed_nat,
          FRepresentation(70, representation_key PrimitiveNatRole)] : List FileItem)
    ];

def representation_operation_laws : List RepresentationLaw :=
    [ representation_reject "Nat-shaped data alone does not enable checked Nat conversion" 81 2
        ([FInd representation_nat, FInd representation_maybe, representation_word, representation_from_nat] : List FileItem)
    , representation_accept "explicit Nat and Maybe roles enable checked Nat conversion" 6
        ([FInd representation_nat, FInd representation_maybe,
          FRepresentation(10, representation_key PrimitiveNatRole), FRepresentation(50, representation_key PrimitiveMaybeRole),
          representation_word, representation_from_nat] : List FileItem)
    , representation_reject "Bool-shaped data alone does not enable machine comparison" 82 2
        ([FInd representation_bool, representation_word, representation_equal] : List FileItem)
    , representation_accept "explicit Bool role enables machine comparison" 4
        ([FInd representation_bool, FRepresentation(20, representation_key PrimitiveBoolRole),
          representation_word, representation_equal] : List FileItem)
    ];

-- @entry main
def main : IO Unit :=
    (fix run (laws : List RepresentationLaw) (failed : Bool) : IO Unit :=
      match laws with
      | Nil => match failed with | True => exit 1 | False => exit 0 end
      | Cons law rest =>
          match law with
          | RepresentationLawOf name passed actual =>
              do println (prim_string_concat
                   (match passed with | True => "ok " | False => "FAIL " end)
                   (prim_string_concat name
                     (match passed with | True => "" | False => prim_string_concat ": " actual end)));
                 run(rest, orb(failed, notb passed))
          end
      end)
      (append RepresentationLaw representation_valid_laws
        (append RepresentationLaw representation_identity_laws
          (append RepresentationLaw representation_shape_laws representation_operation_laws))) False;
