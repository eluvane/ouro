-- Source policy uses independent strings and exact expected diagnostics.
import "../tools/repo_gate/compiler_boundary.ouro";
import "../std/test.ouro";

def boundary_test_reasons (issues : List GateIssue) : String :=
    str_join "\n" (map GateIssue String issue_reason issues);

def boundary_test_clean (name : String) (source : String) : Test :=
    assert_eq name (boundary_test_reasons (compiler_boundary_source_issues "compiler/core.ouro" source)) "";

def boundary_test_bad (name : String) (source : String) (expected : String) : Test :=
    assert_eq name (boundary_test_reasons (compiler_boundary_source_issues "compiler/core.ouro" source)) expected;

def boundary_test_factory (name : String) (owner : String) (source : String) (expected : String) : Test :=
    assert_eq name (boundary_test_reasons (compiler_boundary_factory_issues owner source)) expected;

def boundary_test_document : String :=
    str_join "\n" (append String ["## Compiler checking boundary", "## Checked values"]
      (append String compiler_boundary_modules
        (append String compiler_boundary_value_owners compiler_boundary_result_owners)));

def boundary_test_laws : List Test :=
    [ boundary_test_clean "checker dependency is allowed" "import \"../std/data.ouro\"; def value := 0;"
    , boundary_test_clean "shared type declarations are allowed" "import \"../std/types.ouro\";"
    , assert_eq "prelude resolves the shared type module"
        (boundary_test_reasons (compiler_boundary_source_issues "std/prelude.ouro"
          "import \"types.ouro\";")) ""
    , assert_eq "shared type module cannot acquire host declarations"
        (boundary_test_reasons (compiler_boundary_source_issues "std/types.ouro"
          "extern foreign : Type;"))
        "checker contains a host or assumed declaration: extern at line 1"
    , boundary_test_clean "normalized dependency remains allowed" "import \"./../compiler/base.ouro\";"
    , boundary_test_clean "import alias retains the same dependency" "import \"base.ouro\" as Base;"
    , boundary_test_clean "comments do not gain dependency authority"
        "-- import \"../runtime/native_types.ouro\"; axiom unsafe : Type;\ndef value := 0;"
    , boundary_test_clean "quoted policy words stay data"
        "def text := \"import extern axiom effect perform handle\";"
    , boundary_test_clean "escaped quotes stay inside literal data"
        "def text := \"a\\\" extern \\\"b\";"
    , boundary_test_clean "keyword prefixes stay ordinary identifiers"
        "def externally := intrinsically; def axiomatic := effective;"
    , boundary_test_bad "runtime import is blocked" "import \"../runtime/native_types.ouro\";"
        "checker import is outside the documented module allowlist: ../runtime/native_types.ouro"
    , boundary_test_bad "unlisted compiler import is blocked" "import \"driver.ouro\";"
        "checker import is outside the documented module allowlist: driver.ouro"
    , boundary_test_bad "tool import is blocked" "import \"../tools/collect.ouro\";"
        "checker import is outside the documented module allowlist: ../tools/collect.ouro"
    , boundary_test_bad "test import is blocked" "import \"../tests/compiler_check_tests.ouro\";"
        "checker import is outside the documented module allowlist: ../tests/compiler_check_tests.ouro"
    , boundary_test_bad "cache import is blocked after normalization" "import \"../compiler/../_cache/input.ouro\";"
        "checker import is outside the documented module allowlist: ../compiler/../_cache/input.ouro"
    , boundary_test_bad "absolute import is blocked" "import \"/compiler/core.ouro\";"
        "checker import is outside the documented module allowlist: /compiler/core.ouro"
    , boundary_test_bad "backslash import is blocked" "import \"..\\std\\data.ouro\";"
        "checker import is outside the documented module allowlist: ..\\std\\data.ouro"
    , boundary_test_bad "unquoted import is blocked" "import missing;"
        "checker import has no valid quoted path"
    , boundary_test_bad "missing import path is blocked" "import"
        "checker import has no quoted path"
    , boundary_test_bad "empty checker source is blocked" "-- only a comment"
        "checker module has no source tokens"
    , boundary_test_bad "assumptions are blocked on the same line" "def value := 0; axiom unsafe : Type;"
        "checker contains a host or assumed declaration: axiom at line 1"
    , boundary_test_bad "extern declarations are blocked" "extern foreign : Type;"
        "checker contains a host or assumed declaration: extern at line 1"
    , boundary_test_bad "intrinsic declarations are blocked" "intrinsic raw : Type;"
        "checker contains a host or assumed declaration: intrinsic at line 1"
    , boundary_test_bad "effects are blocked" "effect Console where"
        "checker contains a host or assumed declaration: effect at line 1"
    , boundary_test_bad "effect execution is blocked" "def value := perform emit(0);"
        "checker contains a host or assumed declaration: perform at line 1"
    , boundary_test_bad "unterminated literal cannot hide declarations" "def text := \"extern hidden"
        "unterminated checker source string at line 1"
    , boundary_test_bad "escaped final quote is not a closing delimiter" "def text := \"extern hidden\\\""
        "unterminated checker source string at line 1"
    , boundary_test_factory "documented program owner is accepted" "compiler/pipeline_support.ouro"
        "CheckedProgramOf state entries bodies" ""
    , boundary_test_factory "documented result owner is accepted" "compiler/file_elab.ouro"
        "DeclarationsOk entries" ""
    , boundary_test_factory "new program representation owner is blocked" "compiler/extra.ouro"
        "CheckedProgramOf state entries bodies"
        "checked-value representation used outside its documented owners: CheckedProgramOf"
    , boundary_test_factory "qualified program constructor is still blocked" "compiler/extra.ouro"
        "Checked.CheckedProgramOf state entries bodies"
        "checked-value representation used outside its documented owners: CheckedProgramOf"
    , boundary_test_factory "new declaration result owner is blocked" "compiler/extra.ouro"
        "DeclarationsOk entries"
        "checked-value representation used outside its documented owners: DeclarationsOk"
    , boundary_test_factory "comment and literal constructor names remain data" "compiler/extra.ouro"
        "-- CheckedProgramOf state entries bodies\ndef text := \"DeclarationsOk\";" ""
    , boundary_test_factory "constructor suffix is not the same identifier" "compiler/extra.ouro"
        "def CheckedProgramOfHelper := 0;" ""
    , assert_eq "documented module and representation owners are complete"
        (boundary_test_reasons (compiler_boundary_doc_issues boundary_test_document)) ""
    , assert_true "missing boundary documentation is blocking"
        (notb (nullb GateIssue (compiler_boundary_doc_issues "")))
    , assert_eq "complete inventory has no hidden failure"
        (boundary_test_reasons (compiler_boundary_walk_issues "std" (FsWalkComplete []))) ""
    , assert_eq "truncated inventory is blocking"
        (boundary_test_reasons (compiler_boundary_walk_issues "std" (FsWalkTruncated "std/next")))
        "filesystem walk limit reached at: std/next"
    , assert_eq "unreadable inventory is blocking"
        (boundary_test_reasons (compiler_boundary_walk_issues "compiler" (FsWalkUnreadable "compiler/next")))
        "filesystem walk could not read: compiler/next"
    , assert_eq "unsafe inventory is blocking"
        (boundary_test_reasons (compiler_boundary_walk_issues "std" (FsWalkUnsafe "std/link")))
        "filesystem walk rejected link or escape: std/link"
    ];

-- @entry main
def main : IO Unit := test_run boundary_test_laws;
