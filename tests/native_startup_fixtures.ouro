-- Injection follows complete source checking and replay. Calls in the raw
-- allocator/runtime retain their real targets. Generated managed calls alone
-- select the ownership probes; every allocation also observes the real GC.
import "native_startup_fault_calls.ouro",
  "../compiler/native/managed_source.ouro";

def startup_fault_instruction (base : Nat) (symbols : List Nat) (managed : Bool)
    (instruction : MirInstruction) : MirInstruction :=
    native_fixture_fault_instruction 9 10 base symbols managed instruction;

def startup_fault_function (base : Nat) (symbols : List Nat) (contracts : List LowerContract)
    (function : MirFunction) : MirFunction :=
    native_fixture_fault_function 9 10 base symbols contracts function;

def native_startup_fixture (mode : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    match parts with | ManagedProgramOf checked contracts program =>
      let base : Nat := S (foldr Nat Nat maxNat 0 (mir_global_ids program)) in
      lower_bind (List Nat) MirProgram (startup_fault_symbols checked) (fun (symbols : List Nat) =>
        lower_map (List MirFunction) MirProgram (fun (wrappers : List MirFunction) =>
          match program with | MirProgramDef functions data libraries entry =>
            MirProgramDef (append MirFunction wrappers
              (map MirFunction MirFunction (startup_fault_function base symbols contracts) functions))
              (Cons MirData (MirDataDef(startup_fault_counter base, True, pe_zeros 192)) data) libraries entry end)
          (startup_fault_wrappers base mode symbols)) end;
