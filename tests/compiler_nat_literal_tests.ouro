-- Compact literals still enter ordinary declaration checking and bounded reduction.
import "../std/test.ouro",
  "../compiler/lower_nat.ouro",
  "../compiler/lower.ouro",
  "../compiler/file_elab.ouro",
  "../compiler/file_elab_lookup.ouro",
  "../compiler/extract.ouro",
  "../compiler/driver.ouro",
  "compiler_core_test_decls.ouro";

def nat_literal_test_fuel : Nat := mul 100 50;

def nat_literal_test_env (parameters : Nat) (kind : Maybe Surface) : LowerEnv :=
    MkLowerEnv [40] [10]
      [MkCtorInfo 11 10 0 parameters 0 0,
        MkCtorInfo 12 10 1 parameters 1 0]
      empty_special_ids ([] : List (Pair Nat Surface))
      (match kind with
       | Nothing => ([] : List (Pair Nat Surface))
       | Just typ => [MkPair Nat Surface 10 typ]
       end) ([] : List DefInfo);

def nat_literal_env : LowerEnv := nat_literal_test_env 0 (Just Surface (SSort 0));

def nat_literal_surface (value : Nat) : Surface :=
    lower_nat_literal 64 nat_literal_env (Nothing Nat) [] value;

def nat_literal_core (value : Nat) : CoreTerm :=
    elaborate 100 (nat_literal_surface value) [];

def nat_literal_maximum : Nat := sub (mul 17 (mul 16 (mul 16 (mul 16 16)))) 1;
def nat_literal_emoji : Nat := add (mul 31 (mul 16 (mul 16 16))) (mul 6 (mul 16 16));

def nat_literal_small_unchanged : Bool :=
    (fix check (value : Nat) : Bool :=
      let unchanged : Bool := eqTerm nat_literal_test_fuel
        (elaborate nat_literal_test_fuel
          (lower_nat_literal 0 nat_literal_env (Just Nat 99) [] value) [])
        (elaborate nat_literal_test_fuel (lower_nat_env nat_literal_env value) []) in
      match value with
      | Z => unchanged
      | S previous => andb unchanged (check previous)
      end) 255;

def nat_literal_fallback_same (env : LowerEnv) : Bool :=
    let value : Nat := S 255 in
    eqTerm nat_literal_test_fuel
      (elaborate nat_literal_test_fuel (lower_nat_literal 64 env (Nothing Nat) [] value) [])
      (elaborate nat_literal_test_fuel (lower_nat_env env value) []);

def nat_literal_check (term : CoreTerm) (typ : CoreTerm) : Bool :=
    match check_file nat_literal_test_fuel
        [FInd checker_test_nat_decl, FInd checker_test_bool_decl, FDef 50 typ term] with
    | FROk _ => True
    | FRErr _ _ => False
    end;

def nat_literal_normal_same (value : Nat) : Bool :=
    match normalize_checked nat_literal_test_fuel
        [MkIndEntry 10 checker_test_nat_decl] (nat_literal_core value) with
    | Normalized normal => eqTerm nat_literal_test_fuel normal
        (elaborate nat_literal_test_fuel (lower_nat_env nat_literal_env value) [])
    | NormalizeExhausted => False
    | NormalizeMalformed _ => False
    end;

def nat_literal_fuel_rejects : Bool :=
    let limited : CoreTerm := elaborate 100
      (lower_nat_literal 17 nat_literal_env (Nothing Nat) [] (S 255)) [] in
    andb (eqTerm 10 limited (elaborate 100 hole0 []))
      (notb (nat_literal_check limited checker_test_nat));

def nat_literal_reduction_exhausts : Bool :=
    match normalize_checked 2 [MkIndEntry 10 checker_test_nat_decl]
        (nat_literal_core (S 255)) with
    | NormalizeExhausted => True
    | Normalized _ => False
    | NormalizeMalformed _ => False
    end;

def nat_literal_capture_env : LowerEnv :=
    MkLowerEnv [230] [10]
      [MkCtorInfo 231 10 0 0 0 0, MkCtorInfo 232 10 1 0 1 0]
      empty_special_ids ([] : List (Pair Nat Surface))
      [MkPair Nat Surface 10 (SSort 0)] ([] : List DefInfo);

def nat_literal_capture_locals : List (Pair Nat Surface) :=
    [MkPair Nat Surface 201 (SPi 240 (SInd 10) (SInd 10))];

def nat_literal_capture_safe : Bool :=
    let term : Surface := lower_nat_literal 64 nat_literal_capture_env
      (Just Nat 250) nat_literal_capture_locals (S 255) in
    let closed : CoreTerm := elaborate 100 term [] in
    andb (eqNat (literal_nat_fresh nat_literal_capture_env (Just Nat 250)
        nat_literal_capture_locals) (S 250))
      (andb (eqTerm 100 closed (elaborate 100 term [201, 240, 250]))
        (nat_literal_check closed checker_test_nat));

def nat_literal_parameter_first : LowerEnv :=
    MkLowerEnv [] [20, 10]
      [MkCtorInfo 21 20 0 1 0 0, MkCtorInfo 22 20 1 1 1 0,
        MkCtorInfo 11 10 0 0 0 0, MkCtorInfo 12 10 1 0 1 0]
      empty_special_ids ([] : List (Pair Nat Surface))
      [MkPair Nat Surface 10 (SSort 0), MkPair Nat Surface 20 (SSort 0)]
      ([] : List DefInfo);

def nat_literal_forged_shape : Bool :=
    let claimed : LowerEnv := MkLowerEnv [] [20]
      [MkCtorInfo 21 20 0 0 0 0, MkCtorInfo 22 20 1 0 1 0]
      empty_special_ids ([] : List (Pair Nat Surface))
      [MkPair Nat Surface 20 (SSort 0)] ([] : List DefInfo) in
    let term : CoreTerm := elaborate 100
      (lower_nat_literal 64 claimed (Nothing Nat) [] (S 255)) [] in
    notb (nat_literal_check term checker_test_bool);

def nat_literal_source_accepts (source : String) : Bool :=
    match compile_checked_source nat_literal_test_fuel (prim_string_to_char_codes source) with
    | COk _ => True
    | CErr _ => False
    end;

def nat_literal_source_type_error (source : String) : Bool :=
    match compile_checked_source nat_literal_test_fuel (prim_string_to_char_codes source) with
    | COk _ => False
    | CErr failure => match failure with | ErrCode code _ => eqNat code 41 end
    end;

def nat_literal_source_lower_fuel (budget : Nat) (source : String)
    : CompResult CheckedProgram :=
    pipeline_compile_checked_source lex_go_import driver_parse_file_visibility desugar_file rewrite_declarations
      (fun (env : LowerEnv) (expected : Maybe Surface) (expr : Expr) =>
        vsurf_or_hole (lower_run budget env expected (Nothing Nat) [] (LExpr expr)))
      compile_program driver_elaborate_surfaces elaborate check_module
      preprocess_imports_reg preprocess_records_reg nat_literal_test_fuel
      (prim_string_to_char_codes source);

def nat_literal_full_fuel_rejects : Bool :=
    let source : String :=
      "inductive Count : Type := | Zero : Count | Next : Count -> Count; def value : Count := 256; " in
    match nat_literal_source_lower_fuel 64 source with
    | CErr _ => False
    | COk _ => match nat_literal_source_lower_fuel 17 source with
        | CErr _ => True
        | COk _ => False
        end
    end;

def nat_literal_source_family : String :=
    "inductive Count : Type := | Zero : Count | Next : Count -> Count; ";

-- @entry main
def main : IO Unit := test_run
    [ assert_true "Nat literals 0 through 255 preserve exact old Core"
        nat_literal_small_unchanged
    , assert_true "256 uses a compact checked term"
        (andb (eqNat (extract_size (nat_literal_core (S 255))) 115)
          (nat_literal_check (nat_literal_core (S 255)) checker_test_nat))
    , assert_true "odd 257 reduces to the exact successor value"
        (nat_literal_normal_same (add 255 2))
    , assert_true "even 256 reduces to the exact successor value"
        (nat_literal_normal_same (S 255))
    , assert_true "emoji has 223 ordinary Core nodes and checks at unchanged fuel"
        (andb (eqNat (extract_size (nat_literal_core nat_literal_emoji)) 223)
          (nat_literal_check (nat_literal_core nat_literal_emoji) checker_test_nat))
    , assert_true "scalar maximum has 291 ordinary Core nodes and checks at unchanged fuel"
        (andb (eqNat (extract_size (nat_literal_core nat_literal_maximum)) (add 255 36))
          (nat_literal_check (nat_literal_core nat_literal_maximum) checker_test_nat))
    , assert_true "compact literal has no ambient capture and fresh names exceed all inputs"
        nat_literal_capture_safe
    , assert_true "no-family fallback keeps exact legacy Core"
        (nat_literal_fallback_same empty_env)
    , assert_true "missing family kind keeps exact legacy Core"
        (nat_literal_fallback_same (nat_literal_test_env 0 (Nothing Surface)))
    , assert_true "constructor hints without an environment family keep exact legacy Core"
        (nat_literal_fallback_same
          (MkLowerEnv [] [] [MkCtorInfo 11 10 0 0 0 0, MkCtorInfo 12 10 1 0 1 0]
            empty_special_ids ([] : List (Pair Nat Surface))
            [MkPair Nat Surface 10 (SSort 0)] ([] : List DefInfo)))
    , assert_true "parameterized family keeps exact legacy Core"
        (nat_literal_fallback_same (nat_literal_test_env 1 (Just Surface (SSort 0))))
    , assert_true "indexed family keeps exact legacy Core"
        (nat_literal_fallback_same
          (nat_literal_test_env 0 (Just Surface (SPi 9 (SInd 20) (SSort 0)))))
    , assert_true "first shape match is not replaced by a later parameterless family"
        (nat_literal_fallback_same nat_literal_parameter_first)
    , assert_true "compact lowering fuel cannot return a partial value"
        nat_literal_fuel_rejects
    , assert_true "full source pipeline rejects insufficient lowering fuel after a clean control"
        nat_literal_full_fuel_rejects
    , assert_true "normalization exhaustion remains a typed failure"
        nat_literal_reduction_exhausts
    , assert_true "a compact literal cannot inhabit a different family"
        (notb (nat_literal_check (nat_literal_core (S 255)) checker_test_bool))
    , assert_true "forged arity hints cannot bypass declaration checking"
        nat_literal_forged_shape
    , assert_true "closed digits do not silently accept an incomplete bit list"
        (match literal_nat_function 64 10 60 1 [] with
         | Nothing => True | Just _ => False end)
    , assert_true "renamed family accepts boundary and maximum without a Nat role"
        (nat_literal_source_accepts (prim_string_concat nat_literal_source_family
          "def boundary : Count := 256; def emoji : Count := 0x1F600; def maximum : Count := 0x10FFFF; "))
    , assert_true "an indexed zero/successor family keeps checked source acceptance"
        (nat_literal_source_accepts
          "inductive Flag : Type := | Off : Flag | On : Flag; inductive Count : Flag -> Type := | Zero : Count On | Next : Count On -> Count On; def kept : Count On := 256; ")
    , assert_true "large source literal remains closed beneath user binders"
        (nat_literal_source_accepts (prim_string_concat nat_literal_source_family
          "def value (f : Count -> Count) (x : Count) : Count := 0x10FFFF; "))
    , assert_true "a selected successor with the wrong domain is rejected by the checker"
        (nat_literal_source_type_error
          "inductive Flag : Type := | Off : Flag | On : Flag; inductive Count : Type := | Zero : Count | Next : Flag -> Count; def bad : Count := 256; ")
    , assert_true "source literal annotation still rejects an unrelated type"
        (nat_literal_source_type_error (prim_string_concat nat_literal_source_family
          "inductive Flag : Type := | Off : Flag | On : Flag; def bad : Flag := 256; "))
    ];
