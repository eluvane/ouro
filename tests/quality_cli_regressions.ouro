import "../std/cli.ouro",
  "../std/test.ouro";

def quality_cli_payload : String :=
    (fix double (remaining : Nat) (value : String) : String :=
      match remaining with
      | Z => value
      | S rest => double rest (str_concat value value)
      end) 16 "x";

def quality_cli_large_inline_words : List String :=
    replicate String (str_concat "--payload=" quality_cli_payload) 128;

def quality_cli_tests : List Test :=
    [ assert_true "large inline values are complete"
        (args_argv_options_complete []
          (Cons String "tool" quality_cli_large_inline_words))
    , assert_true "large inline values do not hide a missing later value"
        (notb (args_argv_options_complete []
          (Cons String "tool"
            (snoc String quality_cli_large_inline_words "--missing"))))
    , assert_true "empty inline values and additional separators are complete"
        (args_argv_options_complete [] ["tool", "--empty=", "--value=a=b=c"])
    , assert_true "an inline boolean value does not consume the following option"
        (notb (args_argv_options_complete ["verbose"]
          ["tool", "--verbose=false", "--missing"]))
    , assert_true "separators in short flags and positional words do not hide missing values"
        (notb (args_argv_options_complete [] ["tool", "-x=y", "input=value", "--missing"]))
    , assert_true "a separate dashed value remains incomplete"
        (notb (args_argv_options_complete [] ["tool", "--value", "-literal=value"]))
    , assert_true "the end marker stops checking option-looking words"
        (args_argv_options_complete [] ["tool", "--", "--missing", "--value="])
    , assert_eq "inline values retain literal bytes and additional separators"
        (args_opt_or (cli_parse [] ["--value=-literal=雪\"\\"]) "value" "")
        "-literal=雪\"\\"
    , assert_true "later inline natural values take precedence"
        (match cli_required_nat (cli_parse [] ["--limit=bad", "--limit=12"]) "limit" with
         | Left _ => False
         | Right value => eq_nat value 12
         end)
    , assert_true "invalid later natural values retain their typed error"
        (match cli_optional_nat (cli_parse [] ["--limit=12", "--limit=-1"]) "limit" 7 with
         | Right _ => False
         | Left error => if let CliBadNat name value := (error : CliError) then
             andb (str_eq name "limit") (str_eq value "-1")
           else False
         end)
    , assert_true "explicit inline booleans retain their typed value"
        (match cli_required_bool (cli_parse ["verbose"] ["--verbose=false"]) "verbose" with
         | Left _ => False
         | Right value => notb value
         end)
    , assert_true "invalid inline booleans retain their typed error"
        (match cli_optional_bool (cli_parse ["verbose"] ["--verbose=perhaps"]) "verbose" True with
         | Right _ => False
         | Left error => if let CliBadBool name value := (error : CliError) then
             andb (str_eq name "verbose") (str_eq value "perhaps")
           else False
         end)
    ];

-- @entry main
def main : IO Unit := test_run quality_cli_tests;
