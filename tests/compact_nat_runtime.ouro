-- The ordinary emitter must execute compact literals, including the scalar maximum.
import "../std/test.ouro";

def compact_nat_boundary : Nat := 256;
def compact_nat_odd : Nat := 257;
def compact_nat_emoji : Nat := 0x1F600;
def compact_nat_maximum : Nat := 0x10FFFF;

-- ouro-structural: {"rule":"STRUCT_DUPLICATE_IMPLEMENTATION","category":"independent-oracle","related":["tests/compiler_nat_literal_tests.ouro#nat_literal_emoji"],"reason":"Compute the emitted runtime value oracle independently of the compiler lowering/checking input oracle and large numeric literals, using only small arithmetic operands."}
def compact_nat_expected_emoji : Nat :=
    add (mul 31 (mul 16 (mul 16 16))) (mul 6 (mul 16 16));

def compact_nat_expected_maximum : Nat :=
    sub (mul 17 (mul 16 (mul 16 (mul 16 16)))) 1;

def compact_nat_user_binders (f : Nat -> Nat) (x : Nat) : Nat :=
    add x (f 0x10FFFF);

def compact_nat_prime (x' : Nat) : Nat := add x' 0x1F600;

-- @entry main
def main : IO Unit := test_run
    [ assert_true "compact runtime boundary" (eq_nat compact_nat_boundary (S 255))
    , assert_true "compact runtime odd digit" (eq_nat compact_nat_odd (add 255 2))
    , assert_true "compact runtime emoji" (eq_nat compact_nat_emoji compact_nat_expected_emoji)
    , assert_true "compact runtime scalar maximum"
        (eq_nat compact_nat_maximum compact_nat_expected_maximum)
    , assert_true "compact runtime local binder capture"
        (eq_nat (compact_nat_user_binders (fun (n : Nat) => n) 3)
          (add compact_nat_expected_maximum 3))
    , assert_true "compact runtime primed identifier"
        (eq_nat (compact_nat_prime 2) (add compact_nat_expected_emoji 2))
    ];
