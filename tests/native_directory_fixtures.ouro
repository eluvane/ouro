-- The transformer operates after full checking/replay and preserves the
-- original raw bodies. Only generated managed calls select the fault probes.
import "native_directory_fault_calls.ouro";
import "../compiler/native/managed_source.ouro";

def directory_fault_instruction (base : Nat) (symbols : List Nat) (managed : Bool)
    (instruction : MirInstruction) : MirInstruction :=
    match instruction with
    | MirCall gc result target arguments => match target with
      | MirIndirect _ _ => instruction | MirDirect id => match startup_fault_target symbols id with
        | Nothing => instruction | Just index => match orb managed (orb (eqNat index 12) (eqNat index 13)) with
          | False => instruction | True => MirCall gc result (MirDirect (add base index)) arguments end end end
    | MirManagedAlloc local allocator _ descriptor bytes => MirManagedAlloc local allocator (add base 13) descriptor bytes
    | MirMove _ _ => instruction | MirBinaryOp _ _ _ _ => instruction | MirCompare _ _ _ _ => instruction
    | MirConvert _ _ _ => instruction | MirLoad _ _ _ => instruction | MirStore _ _ _ => instruction
    | MirLoadAt _ _ _ => instruction | MirStoreAt _ _ _ => instruction | MirAddress _ _ => instruction
    | MirPointerAdd _ _ _ => instruction | MirManagedContext _ => instruction end;

def directory_fault_function (base : Nat) (symbols : List Nat) (contracts : List LowerContract)
    (function : MirFunction) : MirFunction :=
    match function with | MirFunctionDef id name arguments locals result entry blocks =>
      let managed : Bool := match lower_find_contract id contracts with | Nothing => True | Just _ => False end in
      MirFunctionDef id name arguments locals result entry
        (map MirBlock MirBlock (fun (block : MirBlock) => match block with | MirBlockDef label instructions terminator =>
          MirBlockDef label (map MirInstruction MirInstruction (directory_fault_instruction base symbols managed) instructions) terminator end) blocks) end;

def native_directory_fixture (selection : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    let listable : Bool := leb_nat 40 selection in
    let mode : Nat := match listable with | True => sub selection 40 | False => selection end in
    match parts with | ManagedProgramOf checked contracts program =>
      let base : Nat := S (foldr Nat Nat maxNat 0 (mir_global_ids program)) in
      lower_bind (List Nat) MirProgram (directory_fault_symbols checked) (fun (symbols : List Nat) =>
        lower_map (List MirFunction) MirProgram (fun (wrappers : List MirFunction) =>
          match program with | MirProgramDef functions data libraries entry =>
            MirProgramDef (append MirFunction wrappers
              (map MirFunction MirFunction (directory_fault_function base symbols contracts) functions))
              (Cons MirData (MirDataDef (startup_fault_counter base) True (pe_zeros 208)) data) libraries entry end)
          (directory_fault_wrappers base listable mode symbols)) end;
