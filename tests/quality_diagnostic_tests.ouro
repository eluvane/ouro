-- Contract laws are independent of each analyzer's decision logic.
import "../tools/quality/diagnostic.ouro";
import "../tools/analyze/model.ouro";
import "../std/test.ouro";

def quality_test_level (text : String) (expected : String) : Bool :=
    match quality_legacy_level text with
    | Nothing => False
    | Just level => prim_string_eq (quality_level_name level) expected
    end;

def quality_test_diagnostic (path : String) (level : QualityLevel)
    (suppressed : Bool) : QualityDiagnostic :=
    MkQualityDiagnostic (MkQualityRule "OURO-TEST001" "test-owner" "test-rule")
      level (MkQualityLocation path 3 7)
      (MkQualityAdvice "message" "evidence" "hint" QualitySuggestedEdit
        [MkQualityEdit 2 4 "replacement"])
      suppressed;

def quality_test_renamed : Bool :=
    let before : QualityDiagnostic := quality_test_diagnostic "before.ouro" QualityDeny False in
    let after : QualityDiagnostic := quality_test_diagnostic "другой путь/同じ.ouro" QualityDeny False in
    andb (prim_string_eq (quality_rule_id (quality_diagnostic_rule before))
            (quality_rule_id (quality_diagnostic_rule after)))
      (andb (prim_string_eq (quality_advice_evidence (quality_diagnostic_advice before))
              (quality_advice_evidence (quality_diagnostic_advice after)))
        (prim_string_eq (quality_text_details before) (quality_text_details after)));

def quality_test_base (level : String) (suppressed : Bool) : ADiag :=
    MkADiag "OURO-API001" level "api_surface" "unexpected-new-export"
      0 3 7 "message" "hint" "evidence" suppressed;

def quality_diagnostic_laws : List Test :=
    [ assert_true "allow mapping" (quality_test_level "allow" "allow")
    , assert_true "warn mapping" (quality_test_level "warn" "warn")
    , assert_true "deny mapping" (quality_test_level "deny" "deny")
    , assert_true "forbid mapping" (quality_test_level "forbid" "forbid")
    , assert_true "info remains nonblocking" (quality_test_level "info" "warn")
    , assert_true "warning compatibility" (quality_test_level "warning" "warn")
    , assert_true "error compatibility" (quality_test_level "error" "deny")
    , assert_true "fatal cannot be suppressed" (quality_test_level "fatal" "forbid")
    , assert_true "unknown level rejected"
        (match quality_legacy_level "warning-only" with | Nothing => True | Just _ => False end)
    , assert_true "empty level rejected"
        (match quality_level_parse "" with | Nothing => True | Just _ => False end)
    , assert_true "legacy name is not a canonical level"
        (match quality_level_parse "fatal" with | Nothing => True | Just _ => False end)
    , assert_true "allow is nonblocking" (notb (quality_level_blocks QualityAllow False))
    , assert_true "warn is nonblocking" (notb (quality_level_blocks QualityWarn False))
    , assert_true "deny blocks" (quality_level_blocks QualityDeny False)
    , assert_true "precise permitted suppression" (notb (quality_level_blocks QualityDeny True))
    , assert_true "forbid blocks suppressed finding" (quality_level_blocks QualityForbid True)
    , assert_true "registry cannot make forbid suppressible"
        (notb (quality_level_suppressible QualityForbid True))
    , assert_true "registry can prohibit warn suppression"
        (notb (quality_level_suppressible QualityWarn False))
    , assert_true "registry permits deny suppression"
        (quality_level_suppressible QualityDeny True)
    , assert_true "diagnostic shares blocking decision"
        (quality_diagnostic_blocks (quality_test_diagnostic "a.ouro" QualityForbid True))
    , assert_eq "compatibility text head"
        (quality_text_head "warning" (quality_test_diagnostic "a.ouro" QualityWarn False))
        "a.ouro:3:7: warning[OURO-TEST001] test-owner/test-rule: message"
    , assert_eq "compatibility analyzer evidence"
        (quality_text_analyzer "error" (quality_test_diagnostic "a.ouro" QualityDeny False))
        "a.ouro:3:7: error[OURO-TEST001] test-owner/test-rule: message\n  hint: hint\n  witness: evidence"
    , assert_true "renaming changes only location" quality_test_renamed
    , assert_eq "unknown location remains explicit"
        (quality_text_location (MkQualityLocation "a.ouro" 0 0))
        "a.ouro:0:0"
    , assert_true "base info compatibility" (ADiag_hidden (quality_test_base "info" False))
    , assert_true "base forbid survives suppressed flag"
        (notb (ADiag_hidden (quality_test_base "forbid" True)))
    , assert_true "base fatal survives suppressed flag"
        (notb (ADiag_hidden (quality_test_base "fatal" True)))
    , assert_true "base malformed level stays visible"
        (notb (ADiag_hidden (quality_test_base "invalid" True)))
    , assert_true "base malformed level has no valid transport"
        (match ADiag_quality "a.ouro" (quality_test_base "invalid" False) with
         | Nothing => True | Just _ => False end)
    ];

def main : IO Unit := test_run quality_diagnostic_laws;
