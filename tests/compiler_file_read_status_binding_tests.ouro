-- A status/body action carries no authority from a spelling or a pure alias.
import "../compiler/driver.ouro",
  "../compiler/checked_program_output.ouro",
  "compiler_binding_test_support.ouro",
  "compiler_startup_test_support.ouro";

def file_status_binding_prefix : String :=
    prim_string_concat
      "intrinsic Action : Type -> Type := \"ouro.runtime\"; intrinsic Text : Type := \"ouro.string\"; inductive Count : Type := | Zero : Count | Next : Count -> Count; representation Count := \"ouro.nat\"; "
      "inductive Couple (A : Type) (B : Type) : Type := | Both : A -> B -> Couple A B; representation Couple := \"ouro.pair\"; def Deferred (A : Type) : Type := Action A; def Name : Type := Text; def Reply : Type := Couple Count Text; ";

def file_status_binding_compile (source : String) : CompResult CheckedProgram :=
    compile_checked_source (mul 100 50)
      (prim_string_to_char_codes (prim_string_concat file_status_binding_prefix source));

def file_status_binding_selected (source : String) : Bool :=
    match file_status_binding_compile source with | CErr _ => False | COk program =>
      any Entry (fun (entry : Entry) => match entry with
        | MkBoundEntry _ _ binding => match binding with
          | PrimitiveExternBinding _ => False
          | PrimitiveIntrinsicBinding id mode gc specialization =>
              andb (primitive_id_equal id PrimitiveFileReadStatus)
                (binding_test_runtime_action mode gc specialization) end
        | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False end)
        (checked_program_entries program) end;

def file_status_binding_rejected (source : String) : Bool :=
    binding_test_rejection (file_status_binding_compile source);

def file_status_binding_c_shim : Bool :=
    match file_status_binding_compile
      "intrinsic renamed : Name -> Deferred Reply := \"ouro.fs.read_file_status\";" with
    | CErr _ => False | COk program =>
      any (Pair Nat (List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair _ key =>
        primitive_bytes_equal key (prim_string_to_char_codes "prim_fs_read_file_status") end)
        (checked_program_c_shims program) end;

def file_status_binding_axiom : Bool :=
    match file_status_binding_compile "axiom prim_fs_read_file_status : Name -> Deferred Reply;" with
    | CErr _ => False | COk program =>
      notb (any (Pair Nat (List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair _ key =>
        primitive_bytes_equal key (prim_string_to_char_codes "prim_fs_read_file_status") end)
        (checked_program_c_shims program)) end;

def main : IO Unit :=
    startup_test_run
      [startup_test_assert "read status/body binding is an allocating action"
         (file_status_binding_selected "intrinsic read : Text -> Action (Couple Count Text) := \"ouro.fs.read_file_status\";"),
       startup_test_assert "read status/body binding accepts transparent aliases"
         (file_status_binding_selected "intrinsic renamed : Name -> Deferred Reply := \"ouro.fs.read_file_status\";"),
       startup_test_assert "read status/body rejects the String-only result"
         (file_status_binding_rejected "intrinsic read : Text -> Action Text := \"ouro.fs.read_file_status\";"),
       startup_test_assert "read status/body rejects a pure result"
         (file_status_binding_rejected "intrinsic read : Text -> Reply := \"ouro.fs.read_file_status\";"),
       startup_test_assert "read status/body rejects a wrong status role"
         (file_status_binding_rejected "intrinsic read : Text -> Action (Couple Text Text) := \"ouro.fs.read_file_status\";"),
       startup_test_assert "read status/body rejects swapped fields"
         (file_status_binding_rejected "intrinsic read : Text -> Action (Couple Text Count) := \"ouro.fs.read_file_status\";"),
       startup_test_assert "read status/body rejects a wrong argument"
         (file_status_binding_rejected "intrinsic read : Count -> Action Reply := \"ouro.fs.read_file_status\";"),
       startup_test_assert "read status/body rejects an unknown near key"
         (file_status_binding_rejected "intrinsic read : Text -> Action Reply := \"ouro.fs.read_file_status.extra\";"),
       startup_test_assert "renamed read status/body maps only through the checked C shim" file_status_binding_c_shim,
       startup_test_assert "ordinary axiom cannot select read status/body C authority" file_status_binding_axiom,
       startup_test_assert "existing file primitive codes stay stable"
         (andb (eqNat (primitive_id_code PrimitiveFileRead) 255)
           (andb (eqNat (primitive_id_code PrimitiveFileWrite) 256)
             (andb (eqNat (primitive_id_code PrimitiveFileReplace) 273)
               (eqNat (primitive_id_code PrimitiveFileReadStatus) 274))))];
