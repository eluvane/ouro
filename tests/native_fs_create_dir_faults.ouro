-- Source-level native fault observation of the actual owning implementation.
-- The fixture retains a deliberately unreleased buffer, observes the error,
-- then releases that exact owner itself. No failed release is pretended to pass.
import "../std/fs_create.ouro",
  "../std/fs.ouro",
  "native_fs_create_dir_support.ouro";

def fs_create_fault_cell (state : RawPtr U8) (offset : USize) : Runtime (RawPtr USize) :=
    runtime_bind (RawPtr U8) (RawPtr USize) (raw_add U8 state offset)
      (fun (address : RawPtr U8) => raw_cast U8 USize address);

def fs_create_fault_increment (state : RawPtr U8) (offset : USize) (one : USize) : Runtime Unit :=
    runtime_bind (RawPtr USize) Unit (fs_create_fault_cell state offset)
      (fun (cell : RawPtr USize) => runtime_bind USize Unit (raw_load_usize cell)
        (fun (value : USize) => raw_store_usize(cell, usize_add value one)));

def fs_create_fault_allocate (state : RawPtr U8) (one : USize) (fail : Bool)
    (bytes : USize) (alignment : USize) : Runtime (RawPtr U8) :=
    runtime_bind Unit (RawPtr U8) (fs_create_fault_increment state (usize_sub one one) one)
      (fun (_ : Unit) => match fail with
       | True => runtime_pure(RawPtr U8, raw_null U8)
       | False => raw_pages_allocate bytes alignment
       end);

def fs_create_fault_release (state : RawPtr U8) (one : USize) (eight : USize)
    (fail : Bool) (owner : RawPtr U8) : Runtime Bool :=
    runtime_bind Unit Bool (fs_create_fault_increment state eight one)
      (fun (_ : Unit) => match fail with
       | False => raw_pages_release owner
       | True => runtime_bind (RawPtr USize) Bool
           (fs_create_fault_cell(state, usize_add(eight, usize_add eight eight)))
           (fun (cell : RawPtr USize) => runtime_bind USize Bool (raw_to_bits U8 owner)
             (fun (bits : USize) => runtime_bind Unit Bool (raw_store_usize cell bits)
               (fun (_ : Unit) => runtime_pure Bool False)))
       end);

def fs_create_fault_create (state : RawPtr U8) (one : USize) (eight : USize)
    (wide : RawPtr U8) (units : USize) : Runtime U32 :=
    runtime_bind Unit U32 (fs_create_fault_increment state (usize_add eight eight) one)
      (fun (_ : Unit) => raw_windows_directory_create wide units);

def fs_create_fault_count (state : RawPtr U8) (offset : USize) (expected : USize) : Runtime Bool :=
    runtime_bind (RawPtr USize) Bool (fs_create_fault_cell state offset)
      (fun (cell : RawPtr USize) => runtime_bind USize Bool (raw_load_usize cell)
        (fun (actual : USize) => runtime_pure(Bool, usize_equal actual expected)));

def fs_create_fault_finish (state : RawPtr U8) (eight : USize) : Runtime Bool :=
    runtime_bind (RawPtr USize) Bool (fs_create_fault_cell(state, usize_add(eight, usize_add eight eight)))
      (fun (cell : RawPtr USize) => runtime_bind USize Bool (raw_load_usize cell)
        (fun (held : USize) => runtime_bind Bool Bool
          (match usize_equal(held, usize_sub eight eight) with
           | True => runtime_pure Bool True
           | False => runtime_bind (RawPtr U8) Bool (raw_from_bits U8 held)
               (fun (owner : RawPtr U8) => raw_pages_release owner)
           end)
          (fun (released : Bool) => runtime_bind Bool Bool (raw_pages_release state)
            (fun (closed : Bool) => runtime_pure(Bool, andb released closed)))));

def fs_create_fault_result (mode : String) (result : Either FsCreateDirError Unit) : Bool :=
    match str_eq mode "allocation-failure" with
    | True => andb(fs_create_test_error 3 result, notb (fs_create_dir_was_created result))
    | False => match str_eq mode "nul" with
      | True => andb(fs_create_test_error 1 result, notb (fs_create_dir_was_created result))
      | False => match str_eq mode "cleanup-created" with
        | True => fs_create_test_cleanup True (Nothing Nat) result
        | False => match str_eq mode "cleanup-refused" with
          | True => fs_create_test_cleanup False (Just Nat 6) result
          | False => match str_eq mode "cleanup-conversion" with
            | True => fs_create_test_cleanup False (Just Nat 4) result
            | False => andb(fs_create_test_error 4 result, notb (fs_create_dir_was_created result))
            end
          end
        end
      end
    end;

def fs_create_fault_path (mode : String) (path : String) : String :=
    match str_eq mode "nul" with
    | True => str_concat(path, str_of_codes ([0,115,117,102,102,105,120] : List Nat))
    | False => match str_eq mode "utf8-surrogate" with
      | True => str_concat(path, str_of_codes ([237,160,128] : List Nat))
      | False => match str_eq mode "utf8-truncated" with
        | True => str_concat(path, str_of_codes ([226,130] : List Nat))
        | False => match orb(str_eq mode "utf8-overlong", str_eq mode "cleanup-conversion") with
          | True => str_concat(path, str_of_codes ([192,175] : List Nat))
          | False => path
          end
        end
      end
    end;

def fs_create_fault_observed (state : RawPtr U8) (one : USize) (eight : USize)
    (mode : String) (result : Either FsCreateDirError Unit) : Runtime Bool :=
    let zero : USize := usize_sub one one in
    let allocated : USize := match str_eq mode "nul" with | True => zero | False => one end in
    let released : USize := match orb(str_eq mode "nul", str_eq mode "allocation-failure") with
      | True => zero | False => one end in
    let created : USize := match orb(str_eq mode "cleanup-created", str_eq mode "cleanup-refused") with
      | True => one | False => zero end in
    runtime_bind Bool Bool (fs_create_fault_count state zero allocated)
      (fun (allocations_ok : Bool) => runtime_bind Bool Bool (fs_create_fault_count state eight released)
        (fun (releases_ok : Bool) => runtime_bind Bool Bool (fs_create_fault_count state (usize_add eight eight) created)
          (fun (creates_ok : Bool) => runtime_bind Bool Bool (fs_create_fault_finish state eight)
            (fun (cleanup_ok : Bool) => runtime_pure Bool (andb (fs_create_fault_result mode result)
              (andb(allocations_ok, andb(releases_ok, andb creates_ok cleanup_ok))))))));

def fs_create_fault_run (mode : String) (path : String) : IO Bool :=
    match usize_from_nat 1 with
    | Nothing => io_pure Bool False
    | Just one =>
        let two : USize := usize_add one one in
        let four : USize := usize_add two two in
        let eight : USize := usize_add four four in
        let sixteen : USize := usize_add eight eight in
        runtime_bind (RawPtr U8) Bool (raw_pages_allocate(usize_add sixteen sixteen, eight))
          (fun (state : RawPtr U8) => runtime_bind USize Bool (raw_to_bits U8 state)
            (fun (address : USize) => match usize_equal(address, usize_sub one one) with
              | True => runtime_pure Bool False
              | False => runtime_bind WindowsFsCreateResult Bool
                  (windows_fs_create_with
                    (fun (bytes : USize) (alignment : USize) =>
                      fs_create_fault_allocate state one (str_eq mode "allocation-failure") bytes alignment)
                    (fun (owner : RawPtr U8) => fs_create_fault_release state one eight
                      (orb (str_eq mode "cleanup-created")
                        (orb(str_eq mode "cleanup-refused", str_eq mode "cleanup-conversion"))) owner)
                    (fun (wide : RawPtr U8) (units : USize) => fs_create_fault_create state one eight wide units)
                    (fs_create_fault_path mode path))
                  (fun (result : WindowsFsCreateResult) => fs_create_fault_observed state one eight mode result)
              end))
    end;
