-- Native branch evidence uses the existing allocator that exits with 42.
-- Only the test main writes a chosen credit before its managed allocation.
import "native_gc_fixtures.ouro",
  "native_frame_text.ouro";

def gc_budget_image (budget : Nat) (answer : Nat) : MirProgram :=
    let original : MirProgram := gc_test_hook_image answer in
    match original with | MirProgramDef functions objects libraries entry =>
      match functions with | Nil => original | Cons _ rest =>
        MirProgramDef (Cons MirFunction (gc_test_body 1
          ([MirManagedContext 0, MirStore (MirUse 0) (codegen_disp (codegen_runtime_budget_offset original))
            (mir_fixture_nat MirUSize budget), gc_test_allocate] : List MirInstruction)) rest)
          objects libraries entry end end;

def gc_budget_case (name : String) : Maybe (Pair Nat Nat) :=
    match str_eq name "budget_0_status_0" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat 0 0) | False =>
    match str_eq name "budget_0_status_1" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat 0 1) | False =>
    match str_eq name "budget_0_status_2" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat 0 2) | False =>
    match str_eq name "budget_0_status_255" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat 0 255) | False =>
    match str_eq name "budget_4095_status_0" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 63 64, 63)) 0) | False =>
    match str_eq name "budget_4095_status_1" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 63 64, 63)) 1) | False =>
    match str_eq name "budget_4095_status_2" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 63 64, 63)) 2) | False =>
    match str_eq name "budget_4095_status_255" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 63 64, 63)) 255) | False =>
    match str_eq name "budget_4096_status_0" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul 64 64) 0) | False =>
    match str_eq name "budget_4096_status_1" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul 64 64) 1) | False =>
    match str_eq name "budget_4096_status_2" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul 64 64) 2) | False =>
    match str_eq name "budget_4096_status_255" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul 64 64) 255) | False =>
    match str_eq name "budget_4135_status_0" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 39)) 0) | False =>
    match str_eq name "budget_4135_status_1" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 39)) 1) | False =>
    match str_eq name "budget_4135_status_2" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 39)) 2) | False =>
    match str_eq name "budget_4135_status_255" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 39)) 255) | False =>
    match str_eq name "budget_4136_status_0" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 40)) 0) | False =>
    match str_eq name "budget_4136_status_1" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 40)) 1) | False =>
    match str_eq name "budget_4136_status_2" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 40)) 2) | False =>
    match str_eq name "budget_4136_status_255" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 40)) 255) | False =>
    match str_eq name "budget_4137_status_0" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 41)) 0) | False =>
    match str_eq name "budget_4137_status_1" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 41)) 1) | False =>
    match str_eq name "budget_4137_status_2" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 41)) 2) | False =>
    match str_eq name "budget_4137_status_255" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (add(mul 64 64, 41)) 255) | False =>
    match str_eq name "budget_65536_status_0" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul(mul 16 64, 64)) 0) | False =>
    match str_eq name "budget_65536_status_1" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul(mul 16 64, 64)) 1) | False =>
    match str_eq name "budget_65536_status_2" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul(mul 16 64, 64)) 2) | False =>
    match str_eq name "budget_65536_status_255" with
    | True => Just(Pair Nat Nat, MkPair Nat Nat (mul(mul 16 64, 64)) 255) | False =>
      Nothing (Pair Nat Nat) end end end end end end end end end end end end end end end end end end end end end end end end end end end end;

def gc_budget_emit (metadata : Bool) (name : String) : IO Unit :=
    match gc_budget_case name with
    | Nothing => do eprintln "unknown GC budget fixture"; exit 2
    | Just values => match values with | MkPair budget answer =>
      match codegen_program(mir_default_limits, gc_budget_image budget answer) with
      | Left _ => do eprintln "GC budget fixture rejected"; exit 2
      | Right image => match image with | NativeImageOf pe frames =>
        match metadata with
        | True => println (str_join("\n", map NativeFrameInfo String native_frame_text frames))
        | False => match pe with | PeImageFile bytes _ =>
            println (str_join(",", map Nat String str_of_nat bytes)) end end end end end end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match andb (eq_nat(length String arguments, 3))
         (orb (str_eq(nth String "" 1 arguments, "--image"))
           (str_eq(nth String "" 1 arguments, "--metadata"))) with
       | True => gc_budget_emit(str_eq(nth String "" 1 arguments, "--metadata"), nth String "" 2 arguments)
       | False => do eprintln "usage: native_gc_budget_driver --image|--metadata NAME"; exit 2 end
