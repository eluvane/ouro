-- Typed-MIR ABI regressions. Source closure acceptance is a separate layer.
import "native_managed_fixtures.ouro";

def managed_value_descriptors (base : Nat) : List MirData :=
    [MirDataDef(add base 100, False, mir_managed_descriptor_bytes 11),
     MirDataDef(add base 101, False, mir_managed_descriptor_bytes 1),
     MirDataDef(add base 102, False, mir_managed_descriptor_bytes 2),
     MirDataDef(add base 103, False, mir_managed_descriptor_bytes 3),
     MirDataDef(add base 104, True, pe_zeros 32)];

def managed_value_box (id : Nat) (allocator : Nat) (collector : Nat) (descriptor : Nat) (value : MirValue)
    : List MirInstruction :=
    [MirManagedAlloc id allocator collector descriptor (managed_fixture_word MirUSize 40),
     MirStore(MirUse id, codegen_disp 32, value)];

def managed_value_env (id : Nat) (allocator : Nat) (collector : Nat) (descriptor : Nat) (values : List MirValue)
    : List MirInstruction :=
    append MirInstruction
      ([MirManagedAlloc id allocator collector descriptor (managed_fixture_word(MirUSize, add(40, mul(8, length MirValue values)))),
        MirStore(MirUse id, codegen_disp 32, managed_fixture_word(MirUSize, length MirValue values))] : List MirInstruction)
      ((fix fields (rest : List MirValue) (offset : Nat) : List MirInstruction :=
        match rest with | Nil => [] | Cons value tail =>
          Cons(MirInstruction, MirStore(MirUse id, codegen_disp offset, value), fields(tail, add offset 8)) end) values 40);

def managed_value_closure (id : Nat) (code_local : Nat) (allocator : Nat) (collector : Nat) (descriptor : Nat)
    (code : Nat) (environment : MirValue) : List MirInstruction :=
    [MirManagedAlloc id allocator collector descriptor (managed_fixture_word MirUSize 48),
     MirAddress code_local code, MirStore(MirUse id, codegen_disp 32, MirUse code_local),
     MirStore(MirUse id, codegen_disp 40, environment)];

def managed_value_call (result : Nat) (code_local : Nat) (env_local : Nat)
    (closure : MirValue) (argument : MirValue) : List MirInstruction :=
    [MirLoad code_local closure (codegen_disp 32), MirLoad env_local closure (codegen_disp 40),
     MirCall MirMayGc (Just Nat result)
       (MirIndirect(MirSignatureOf([MirManagedPtr, MirManagedPtr], Just MirType MirManagedPtr), MirUse code_local))
       [MirUse env_local, argument]];

def managed_value_function (id : Nat) (args : List MirLocal) (locals : List MirLocal)
    (instructions : List MirInstruction) (result : MirValue) : MirFunction :=
    MirFunctionDef id [109,97,110,97,103,101,100,95,99,111,100,101] args locals (Just MirType MirManagedPtr) 0
      [MirBlockDef 0 instructions (MirReturn (Just MirValue result))];

def managed_value_constructor (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ inspect _ base collector =>
      managed_fixture_finish runtime
        [managed_fixture_body (S base)
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr,
           MirLocalDef 4 MirRawPtr, MirLocalDef 5 MirRawPtr, MirLocalDef 6 MirU64, MirLocalDef 7 MirU32]
          (managed_fixture_join ([
            managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
            ([MirManagedAlloc 2 allocator collector (add base 101) (managed_fixture_word MirUSize 64),
              MirStore(MirUse 2, codegen_disp 32, managed_fixture_word MirUSize 71),
              MirStore(MirUse 2, codegen_disp 40, managed_fixture_word MirUSize 2),
              MirStore(MirUse 2, codegen_disp 48, managed_fixture_word MirUSize 1),
              MirStore(MirUse 2, codegen_disp 56, MirUse 1),
              MirLoad(3, MirUse 2, codegen_disp 56), MirManagedContext 4, MirAddress(5, add base 104),
              MirCall(MirMayGc, Nothing Nat, MirDirect inspect, [MirUse 4, MirUse 5])] : List MirInstruction),
            managed_fixture_stat 2 32 71, managed_fixture_stat 2 40 2, managed_fixture_stat 2 48 1,
            managed_fixture_stat 5 0 1, managed_fixture_stat 5 8 3, managed_fixture_stat 5 16 3,
            managed_fixture_stat 4 16 2, managed_fixture_stat 4 24 104,
            ([MirLoad(6, MirUse 3, codegen_disp 32), MirConvert 7 MirNarrow (MirUse 6)] : List MirInstruction)]
              : List (List MirInstruction))) (MirUse 7)]
        (managed_value_descriptors base) end;

-- A closure escapes its factory. Its captured object remains accessible after
-- the factory's shadow frame has returned; the caller owns all live roots.
def managed_value_escape (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ inspect _ base collector =>
      let maker : Nat := add base 2 in
      let code : Nat := add base 3 in
      managed_fixture_finish runtime
        [managed_fixture_body (S base)
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr,
           MirLocalDef 4 MirManagedPtr, MirLocalDef 5 MirRawPtr, MirLocalDef 6 MirRawPtr,
           MirLocalDef 7 MirRawPtr, MirLocalDef 8 MirU64, MirLocalDef 9 MirU32]
          (managed_fixture_join ([
            ([MirCall(MirMayGc, Just Nat 1, MirDirect maker, [])] : List MirInstruction),
            managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 0),
            managed_value_call 4 5 2 (MirUse 1) (MirUse 3),
            ([MirManagedContext 6, MirAddress(7, add base 104),
              MirCall(MirMayGc, Nothing Nat, MirDirect inspect, [MirUse 6, MirUse 7])] : List MirInstruction),
            managed_fixture_stat 7 0 1, managed_fixture_stat 7 8 4, managed_fixture_stat 7 16 4,
            managed_fixture_stat 6 16 4, managed_fixture_stat 6 24 176,
            ([MirLoad(8, MirUse 4, codegen_disp 32), MirConvert 9 MirNarrow (MirUse 8)] : List MirInstruction)]
              : List (List MirInstruction))) (MirUse 9),
         managed_value_function maker []
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr, MirLocalDef 4 MirRawPtr]
          (managed_fixture_join ([
            managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
            managed_value_env 2 allocator collector (add base 102) [MirUse 1],
            managed_value_closure 3 4 allocator collector (add base 103) code (MirUse 2)] : List (List MirInstruction))) (MirUse 3),
         managed_value_function code [MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr]
          [MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirRawPtr, MirLocalDef 4 MirRawPtr]
          [MirLoad(2, MirUse 0, codegen_disp 40), MirManagedContext 3, MirAddress(4, add base 104),
           MirCall(MirMayGc, Nothing Nat, MirDirect inspect, [MirUse 3, MirUse 4])] (MirUse 2)]
        (managed_value_descriptors base) end;

-- The same residual closure is applied twice. Capturing happens in the
-- factory, so the supplied first operand is retained and never re-evaluated.
def managed_value_pap (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ inspect _ base collector =>
      let maker : Nat := add base 2 in
      let code : Nat := add base 3 in
      managed_fixture_finish runtime
        [managed_fixture_body (S base)
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr,
           MirLocalDef 4 MirManagedPtr, MirLocalDef 5 MirManagedPtr, MirLocalDef 6 MirManagedPtr,
           MirLocalDef 7 MirManagedPtr, MirLocalDef 8 MirRawPtr, MirLocalDef 9 MirRawPtr,
           MirLocalDef 10 MirRawPtr, MirLocalDef 11 MirU64, MirLocalDef 12 MirU32]
          (managed_fixture_join ([
            managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 20),
            ([MirCall(MirMayGc, Just Nat 2, MirDirect maker, [MirUse 1])] : List MirInstruction),
            managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 21),
            managed_value_call 4 8 7 (MirUse 2) (MirUse 3),
            managed_fixture_stat 4 32 41,
            managed_value_box 5 allocator collector (add base 100) (managed_fixture_word MirU64 22),
            managed_value_call 6 8 7 (MirUse 2) (MirUse 5),
            managed_fixture_stat 1 32 20,
            ([MirManagedContext 9, MirAddress(10, add base 104),
              MirCall(MirMayGc, Nothing Nat, MirDirect inspect, [MirUse 9, MirUse 10])] : List MirInstruction),
            managed_fixture_stat 10 0 1, managed_fixture_stat 10 8 7, managed_fixture_stat 10 16 7,
            managed_fixture_stat 9 16 7, managed_fixture_stat 9 24 296,
            ([MirLoad(11, MirUse 6, codegen_disp 32), MirConvert 12 MirNarrow (MirUse 11)] : List MirInstruction)]
              : List (List MirInstruction))) (MirUse 12),
         managed_value_function maker [MirLocalDef 0 MirManagedPtr]
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirRawPtr]
          (append MirInstruction (managed_value_env 1 allocator collector (add base 102) [MirUse 0])
            (managed_value_closure 2 3 allocator collector (add base 103) code (MirUse 1))) (MirUse 2),
         managed_value_function code [MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr]
          [MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr,
           MirLocalDef 4 MirU64, MirLocalDef 5 MirU64, MirLocalDef 6 MirU64]
          (append MirInstruction
            ([MirLoad(2, MirUse 0, codegen_disp 40), MirLoad(4, MirUse 2, codegen_disp 32),
              MirLoad(5, MirUse 1, codegen_disp 32), MirBinaryOp(6, MirAdd, MirUse 4, MirUse 5)] : List MirInstruction)
            (managed_value_box 3 allocator collector (add base 100) (MirUse 6))) (MirUse 3)]
        (managed_value_descriptors base) end;

def managed_value_recursive (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ inspect _ base collector =>
      let code : Nat := add base 2 in
      managed_fixture_finish runtime
        [managed_fixture_body (S base)
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr,
           MirLocalDef 4 MirManagedPtr, MirLocalDef 5 MirManagedPtr, MirLocalDef 6 MirRawPtr,
           MirLocalDef 7 MirRawPtr, MirLocalDef 8 MirRawPtr, MirLocalDef 9 MirU64, MirLocalDef 10 MirU32]
          (managed_fixture_join ([
            managed_value_env 1 allocator collector (add base 102) [managed_fixture_word MirManagedPtr 0],
            managed_value_closure 2 6 allocator collector (add base 103) code (MirUse 1),
            ([MirStore(MirUse 1, codegen_disp 40, MirUse 2)] : List MirInstruction),
            managed_value_box 3 allocator collector (add base 100) (managed_fixture_word MirU64 42),
            managed_value_call 4 6 5 (MirUse 2) (MirUse 3),
            managed_fixture_assert(MirUse 4, MirUse 2),
            ([MirManagedContext 7, MirAddress(8, add base 104),
              MirCall(MirMayGc, Nothing Nat, MirDirect inspect, [MirUse 7, MirUse 8])] : List MirInstruction),
            managed_fixture_stat 7 16 3, managed_fixture_stat 7 24 136,
            ([MirLoad(9, MirUse 3, codegen_disp 32), MirConvert 10 MirNarrow (MirUse 9)] : List MirInstruction)]
              : List (List MirInstruction))) (MirUse 10),
         managed_value_function code [MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr]
          [MirLocalDef 2 MirManagedPtr] [MirLoad(2, MirUse 0, codegen_disp 40)] (MirUse 2)]
        (managed_value_descriptors base) end;

-- Shutdown cleanup is rejected while the caller's shadow frame is live.
def managed_value_live_cleanup (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator release _ _ base collector =>
      managed_fixture_finish runtime
        [managed_fixture_body (S base)
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirRawPtr, MirLocalDef 3 MirU8]
          (managed_fixture_join ([
            managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42),
            ([MirManagedContext 2, MirCall(MirMayGc, Just Nat 3, MirDirect release, [MirUse 2])] : List MirInstruction),
            managed_fixture_assert(MirUse 3, managed_fixture_word MirU8 0),
            managed_fixture_stat 2 16 1, managed_fixture_stat 2 24 40]
              : List (List MirInstruction))) (managed_fixture_word MirU32 42)]
        (managed_value_descriptors base) end;

def managed_value_record (symbol : Nat) (address : Nat) (word : Nat) (digit : Nat)
    : List MirInstruction :=
    [MirAddress address symbol, MirLoad(word, MirUse address, codegen_disp 0),
     MirBinaryOp(word, MirMul, MirUse word, managed_fixture_word MirU64 10),
     MirBinaryOp(word, MirAdd, MirUse word, managed_fixture_word MirU64 digit),
     MirStore(MirUse address, codegen_disp 0, MirUse word)];

-- Effect markers establish function-expression, argument-expression, then
-- call-body order. Each marker is emitted by a separate actual machine call.
def managed_value_order (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      let function_expr : Nat := add base 2 in
      let argument_expr : Nat := add base 3 in
      let body : Nat := add base 4 in
      let log : Nat := add base 105 in
      managed_fixture_finish runtime
        [managed_fixture_body (S base)
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr, MirLocalDef 3 MirManagedPtr,
           MirLocalDef 4 MirManagedPtr, MirLocalDef 5 MirRawPtr, MirLocalDef 6 MirRawPtr,
           MirLocalDef 7 MirU64, MirLocalDef 8 MirU32]
          (managed_fixture_join ([
            ([MirCall(MirMayGc, Just Nat 1, MirDirect function_expr, []),
              MirCall(MirMayGc, Just Nat 2, MirDirect argument_expr, [])] : List MirInstruction),
            managed_value_call 3 5 4 (MirUse 1) (MirUse 2),
            ([MirAddress 6 log] : List MirInstruction), managed_fixture_stat 6 0 123,
            ([MirLoad(7, MirUse 3, codegen_disp 32), MirConvert 8 MirNarrow (MirUse 7)] : List MirInstruction)]
              : List (List MirInstruction))) (MirUse 8),
         managed_value_function function_expr []
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirManagedPtr,
           MirLocalDef 3 MirRawPtr, MirLocalDef 4 MirRawPtr, MirLocalDef 5 MirU64]
          (managed_fixture_join ([managed_value_record log 4 5 1,
            managed_value_env 1 allocator collector (add base 102) [],
            managed_value_closure 2 3 allocator collector (add base 103) body (MirUse 1)] : List (List MirInstruction))) (MirUse 2),
         managed_value_function argument_expr []
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirRawPtr, MirLocalDef 3 MirU64]
          (append MirInstruction (managed_value_record log 2 3 2)
            (managed_value_box 1 allocator collector (add base 100) (managed_fixture_word MirU64 42))) (MirUse 1),
         managed_value_function body [MirLocalDef 0 MirManagedPtr, MirLocalDef 1 MirManagedPtr]
          [MirLocalDef 2 MirRawPtr, MirLocalDef 3 MirU64] (managed_value_record log 2 3 3) (MirUse 1)]
        (Cons(MirData, MirDataDef log True (pe_zeros 8), managed_value_descriptors base)) end;
