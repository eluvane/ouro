-- Small process fixture for successful publication and refused replacement of
-- an output held open by the host. Every error leaves stdout empty and exits 1.
import "../tools/native_build_output.ouro";

-- @entry main
def main : IO Unit :=
    do let! argv := prim_argv;
       match argv with
       | Nil => exit 2
       | Cons _ args =>
           match args with
           | Nil => exit 2
           | Cons output rest =>
               match rest with
               | Nil => exit 2
               | Cons content tail =>
                   match tail with
                   | Cons _ _ => exit 2
                   | Nil =>
                       do let! published := native_build_publish_checked output content;
                          match published with
                          | Left e => do eprintln (fs_error_message e); exit 1
                          | Right _ => println output
                          end
                   end
               end
           end
       end
