-- Refiner failures preserve resource, typing and malformed-Core distinctions.

import "compiler_refine_result_fixtures.ouro";

def refine_result_laws : List RefineResultLaw :=
    [ MkRefineResultLaw "zero refiner fuel is resource exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_term_checked 0 refine_result_no_sig refine_result_no_ctx (Nothing CoreTerm) (CSort 0)))
    , MkRefineResultLaw "recursive product preserves child exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_term_checked 1 refine_result_no_sig refine_result_no_ctx (Nothing CoreTerm)
            (CPi (CSort 0) (CSort 0))))
    , MkRefineResultLaw "one fuel unit can refine a leaf"
        (refine_result_matches (CSort 0)
          (refine_term_checked 1 refine_result_no_sig refine_result_no_ctx (Nothing CoreTerm) (CSort 0)))
    , MkRefineResultLaw "pattern search preserves equality exhaustion"
        (refine_result_has_kind (Maybe Nat) 1
          (refine_pattern_index 0 0 (CSort 0) ([CSort 0] : List CoreTerm) 0))
    , MkRefineResultLaw "pattern search continues after a proven mismatch"
        (refine_result_index 1
          (refine_pattern_index 2 0 (CSort 0) ([CSort 1, CSort 0] : List CoreTerm) 0))
    , MkRefineResultLaw "abstraction cannot use exhausted equality as a mismatch"
        (refine_result_has_kind CoreTerm 1
          (refine_abstract 0 ([CSort 0] : List CoreTerm) 1 (CSort 0) 0))
    , MkRefineResultLaw "abstraction preserves recursive equality exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_abstract 2 ([refine_result_deep] : List CoreTerm) 1 refine_result_deep 0))
    , MkRefineResultLaw "abstraction keeps a proven unmatched leaf"
        (refine_result_matches (CSort 1)
          (refine_abstract 2 ([CSort 0] : List CoreTerm) 1 (CSort 1) 0))
    , MkRefineResultLaw "abstraction respects a dependent product binder"
        (refine_result_matches (CPi (CSort 0) (CRel 1))
          (refine_abstract 20 ([CSort 1] : List CoreTerm) 1 (CPi (CSort 0) (CSort 1)) 0))
    , MkRefineResultLaw "outer scope removal preserves equality exhaustion"
        (refine_result_has_kind CoreTerm 1 (refine_outer_type 0 1 (CSort 0)))
    , MkRefineResultLaw "field-dependent result is a typing failure"
        (refine_result_has_kind CoreTerm 2 (refine_outer_type 100 1 (CRel 0)))
    , MkRefineResultLaw "outer scope removal shifts a free outer variable"
        (refine_result_matches (CRel 0) (refine_outer_type 100 1 (CRel 1)))
    , MkRefineResultLaw "zero removed binders require no equality work"
        (refine_result_matches (CSort 0) (refine_outer_type 0 0 (CSort 0)))
    , MkRefineResultLaw "expected Pi exhaustion cannot select lambda fallback"
        (refine_result_has_kind CoreTerm 1
          (refine_lambda refine_result_copy 0 refine_result_no_environment refine_result_no_scope
            (Just CoreTerm refine_result_function) (CSort 0) (CRel 0)))
    , MkRefineResultLaw "malformed expected lambda type preserves reduction failure"
        (refine_result_has_kind CoreTerm 4
          (refine_lambda refine_result_copy 100 refine_result_no_environment refine_result_no_scope
            (Just CoreTerm refine_result_bad_type) (CSort 0) (CRel 0)))
    , MkRefineResultLaw "nonfunction lambda expectation is a typing failure"
        (refine_result_has_kind CoreTerm 2
          (refine_lambda refine_result_copy 100 refine_result_no_environment refine_result_no_scope
            (Just CoreTerm (CSort 0)) (CSort 0) (CRel 0)))
    ];

-- @entry main
def main : IO Unit := refine_result_run refine_result_laws;
