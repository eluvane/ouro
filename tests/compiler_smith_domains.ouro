-- Every legacy inductive family has a checked native declaration and a value builder.
import "compiler_smith_model.ouro";

inductive SmithData : Type :=
  | SmithDataNat : SmithData | SmithDataBool : SmithData
  | SmithDataOption : SmithData -> SmithData
  | SmithDataList : SmithData -> SmithData
  | SmithDataPair : SmithData -> SmithData -> SmithData;

def smith_data_type : SmithData -> CoreTerm :=
  fix typ (shape : SmithData) : CoreTerm :=
    match shape with
    | SmithDataNat => retained_nat | SmithDataBool => retained_bool
    | SmithDataOption element => CApp (CInd 44) (typ element)
    | SmithDataList element => CApp (CInd 43) (typ element)
    | SmithDataPair first second => retained_pair (typ first) (typ second)
    end;

def smith_data_shape : Nat -> Nat -> SmithData :=
  fix build (fuel : Nat) (seed : Nat) : SmithData :=
    match fuel with
    | Z => match smith_choose seed 1 with | True => SmithDataNat | False => SmithDataBool end
    | S rest => match smith_choice seed 2 5 with
        | Z => SmithDataNat
        | S first => match first with
            | Z => SmithDataBool
            | S second => match second with
                | Z => SmithDataOption (build rest (property_seed seed 3))
                | S third => match third with
                    | Z => SmithDataList (build rest (property_seed seed 4))
                    | S _ => SmithDataPair (build rest (property_seed seed 5)) (build rest (property_seed seed 6))
                    end
                end
            end
        end
    end;

def smith_list_value (typ : CoreTerm) : List CoreTerm -> CoreTerm :=
  fix build (values : List CoreTerm) : CoreTerm :=
    match values with
    | Nil => CApp (CConstruct 43 0 1) typ
    | Cons first rest => smith_apply3 (CConstruct 43 1 1) typ first (build rest)
    end;

def smith_data_value : SmithData -> Nat -> CoreTerm :=
  fix value (shape : SmithData) (seed : Nat) : CoreTerm :=
    match shape with
    | SmithDataNat => smith_numeral (smith_choice seed 7 5)
    | SmithDataBool => CConstruct 20 (smith_choice seed 8 2) 0
    | SmithDataOption element =>
        match smith_choose seed 9 with
        | True => CApp (CConstruct 44 0 1) (smith_data_type element)
        | False => smith_apply2 (CConstruct 44 1 1) (smith_data_type element)
            (value element (property_seed seed 10))
        end
    | SmithDataList element =>
        smith_list_value (smith_data_type element)
          ((fix elements (count : Nat) (salt : Nat) : List CoreTerm :=
            match count with
            | Z => Nil CoreTerm
            | S rest => Cons CoreTerm (value element (property_seed seed salt)) (elements rest (S salt))
            end) (smith_choice seed 11 4) 12)
    | SmithDataPair first second => retained_pair_value (smith_data_type first) (smith_data_type second)
        (value first (property_seed seed 16)) (value second (property_seed seed 17))
    end;

def smith_payload (seed : Nat) : SmithData :=
    match smith_choose seed 18 with | True => SmithDataNat | False => SmithDataBool end;

def smith_enum_size (seed : Nat) : Nat := add 2 (smith_choice seed 19 3);

def smith_list_decl : IndDecl :=
    MkIndDecl 43 ([MkParam 47 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([ MkCtor 45 (CPi (CSort 0) (CApp (CInd 43) (CRel 0)))
       , MkCtor 46 (CPi (CSort 0) (CPi (CRel 0)
           (CPi (CApp (CInd 43) (CRel 1)) (CApp (CInd 43) (CRel 2)))))
       ] : List Ctor);

def smith_option_decl : IndDecl :=
    MkIndDecl 44 ([MkParam 50 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([ MkCtor 48 (CPi (CSort 0) (CApp (CInd 44) (CRel 0)))
       , MkCtor 49 (CPi (CSort 0) (CPi (CRel 0) (CApp (CInd 44) (CRel 1))))
       ] : List Ctor);

def smith_enum_decl (seed : Nat) : IndDecl :=
    MkIndDecl 60 (Nil Param) (Nil CoreTerm) 0
      ((fix constructors (count : Nat) (name : Nat) : List Ctor :=
        match count with
        | Z => Nil Ctor | S rest => Cons Ctor (MkCtor name (CInd 60)) (constructors rest (S name))
        end) (smith_enum_size seed) 61);

def smith_wrap_decl (seed : Nat) : IndDecl :=
    MkIndDecl 70 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 71 (CPi (smith_data_type (smith_payload seed)) (CInd 70))] : List Ctor);

def smith_tree_payload (seed : Nat) : Bool := smith_choose seed 20;

def smith_tree_decl (seed : Nat) : IndDecl :=
    MkIndDecl 80 (Nil Param) (Nil CoreTerm) 0
      ([ MkCtor 81 (match smith_tree_payload seed with
          | True => CPi (smith_data_type (smith_payload seed)) (CInd 80)
          | False => CInd 80 end)
       , MkCtor 82 (CPi (CInd 80) (CPi (CInd 80) (CInd 80)))
       ] : List Ctor);

def smith_box_decl : IndDecl :=
    MkIndDecl 90 (Nil Param) (Nil CoreTerm) 1 ([MkCtor 91 (CPi (CSort 0) (CInd 90))] : List Ctor);

def smith_empty_decl : IndDecl := MkIndDecl 100 (Nil Param) (Nil CoreTerm) 0 (Nil Ctor);

def smith_vec_type (length : CoreTerm) : CoreTerm := CApp (CInd 110) length;

def smith_vec_decl (seed : Nat) : IndDecl :=
    MkIndDecl 110 (Nil Param) ([retained_nat] : List CoreTerm) 0
      ([ MkCtor 111 (smith_vec_type retained_zero)
       , MkCtor 112 (CPi retained_nat (CPi (smith_data_type (smith_payload seed))
           (CPi (smith_vec_type (CRel 1)) (smith_vec_type (CApp retained_succ (CRel 2))))))
       ] : List Ctor);

def smith_tree_value (environment_seed : Nat) : Nat -> Nat -> CoreTerm :=
  fix build (depth : Nat) (seed : Nat) : CoreTerm :=
    let leaf : CoreTerm := match smith_tree_payload environment_seed with
      | True => CApp (CConstruct 80 0 0) (smith_data_value (smith_payload environment_seed) seed)
      | False => CConstruct 80 0 0 end in
    match depth with
    | Z => leaf
    | S rest => match smith_choose seed 21 with
        | True => leaf
        | False => smith_apply2 (CConstruct 80 1 0)
            (build rest (property_seed seed 22)) (build rest (property_seed seed 23))
        end
    end;

def smith_vec_value (environment_seed : Nat) : Nat -> Nat -> CoreTerm :=
  fix build (length : Nat) (seed : Nat) : CoreTerm :=
    match length with
    | Z => CConstruct 110 0 0
    | S rest => smith_apply3 (CConstruct 110 1 0) (smith_numeral rest)
        (smith_data_value (smith_payload environment_seed) seed) (build rest (property_seed seed 24))
    end;

def smith_string_type : CoreTerm := CConst 18;
def smith_codes_type : CoreTerm := CApp (CInd 43) retained_nat;
def smith_string_binary : CoreTerm := CPi smith_string_type (CPi smith_string_type smith_string_type);

def smith_string_binding (name : Nat) (typ : CoreTerm) (operation : PrimitiveStringOp) : FileItem :=
    FIntrinsic name typ (primitive_key (PrimitiveStringOperation operation)) (Nothing CoreTerm);

def smith_string_declarations : List FileItem :=
    [ FIntrinsic 18 (CSort 0) (primitive_key PrimitiveStringType) (Nothing CoreTerm)
    , FRepresentation 10 ([111, 117, 114, 111, 46, 110, 97, 116] : List Nat)
    , FRepresentation 20 ([111, 117, 114, 111, 46, 98, 111, 111, 108] : List Nat)
    , FRepresentation 43 ([111, 117, 114, 111, 46, 108, 105, 115, 116] : List Nat)
    , smith_string_binding 220 smith_string_binary PrimitiveStringConcat
    , smith_string_binding 221 (CPi smith_string_type retained_nat) PrimitiveStringLength
    , smith_string_binding 222 (CPi smith_string_type (CPi retained_nat (CPi retained_nat smith_string_type))) PrimitiveStringSlice
    , smith_string_binding 223 (CPi smith_string_type (CPi smith_string_type retained_bool)) PrimitiveStringEqual
    , smith_string_binding 224 (CPi retained_nat smith_string_type) PrimitiveStringOfNat
    , smith_string_binding 225 (CPi smith_string_type smith_codes_type) PrimitiveStringToCodes
    , smith_string_binding 226 (CPi smith_codes_type smith_string_type) PrimitiveStringOfCodes
    ];

def smith_poly_type : CoreTerm := CPi (CSort 0) (CPi (CRel 0) (CRel 1));
def smith_poly_body : CoreTerm := CLam (CSort 0) (CLam (CRel 0) (CRel 0));

def smith_declarations (seed : Nat) : List FileItem :=
    append FileItem
      ([ FInd retained_nat_decl, FInd retained_bool_decl, FInd retained_pair_decl
       , FInd smith_list_decl, FInd smith_option_decl, FInd (smith_enum_decl seed)
       , FInd (smith_wrap_decl seed), FInd (smith_tree_decl seed), FInd smith_box_decl
       , FInd smith_empty_decl, FInd (smith_vec_decl seed)
       , FAxiom 200 (CSort 0), FAxiom 201 (CConst 200)
       , FDef 202 (CConst 200) (CConst 201), FDef 203 (CConst 200) (CConst 202)
       , FDef 300 smith_poly_type smith_poly_body
       , FDef 301 (CPi (CSort 0) (CPi (CSort 0) (CPi (CRel 1) (CPi (CRel 1) (CRel 3)))))
           (CLam (CSort 0) (CLam (CSort 0) (CLam (CRel 1) (CLam (CRel 1) (CRel 1)))))
       ] : List FileItem) smith_string_declarations;

def smith_environment (seed : Nat) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking smith_fuel (smith_declarations seed);

def smith_ascii (seed : Nat) : List Nat :=
    (fix bytes (length : Nat) (salt : Nat) : List Nat :=
      match length with
      | Z => Nil Nat
      | S rest =>
          let alphabet : List Nat := [97, 98, 99, 120, 121, 122, 48, 57, 32, 95, 45] in
          match compiler_nth Nat alphabet (smith_choice seed salt 11) with
          | Nothing => Cons Nat 256 (bytes rest (S salt))
          | Just byte => Cons Nat byte (bytes rest (S salt))
          end
      end) (smith_choice seed 25 6) 26;

def smith_nested (mode : Nat) : CoreTerm :=
    match mode with
    | Z => retained_nested_strict
    | S first => match first with | Z => retained_nested_nonzero | S _ => retained_nested_eta_short end
    end;

def smith_domain_count : Nat := 18;

def smith_domain (environment_seed : Nat) (depth : Nat) (seed : Nat) (family : Nat) : SmithWitness :=
    let small : SmithData := smith_data_shape (minNat depth 2) (property_seed seed 32) in
    match family with
    | Z => smith_leaf family retained_nat (smith_numeral (smith_choice seed 33 7)) True
    | S remaining_1 => match remaining_1 with
    | Z => smith_leaf family retained_bool (CConstruct 20 (smith_choice seed 34 2) 0) True
    | S remaining_2 => match remaining_2 with
    | Z => smith_leaf family (CInd 60) (CConstruct 60 (smith_choice seed 35 (smith_enum_size environment_seed)) 0) True
    | S remaining_3 => match remaining_3 with
    | Z => let shape : SmithData := SmithDataOption small in
        smith_leaf family (smith_data_type shape) (smith_data_value shape seed) True
    | S remaining_4 => match remaining_4 with
    | Z => let shape : SmithData := SmithDataList small in
        smith_leaf family (smith_data_type shape) (smith_data_value shape seed) True
    | S remaining_5 => match remaining_5 with
    | Z => let shape : SmithData := SmithDataPair small (smith_payload seed) in
        smith_leaf family (smith_data_type shape) (smith_data_value shape seed) True
    | S remaining_6 => match remaining_6 with
    | Z => smith_leaf family (CInd 70)
        (CApp (CConstruct 70 0 0) (smith_data_value (smith_payload environment_seed) seed)) True
    | S remaining_7 => match remaining_7 with
    | Z => smith_leaf family (CInd 80) (smith_tree_value environment_seed (minNat depth 3) seed) True
    | S remaining_8 => match remaining_8 with
    | Z => smith_leaf family (CInd 90) (CApp (CConstruct 90 0 0) (smith_data_type small)) True
    | S remaining_9 => match remaining_9 with
    | Z => let length : Nat := smith_choice seed 36 4 in
        smith_leaf family (smith_vec_type (smith_numeral length)) (smith_vec_value environment_seed length seed) True
    | S remaining_10 => match remaining_10 with
    | Z => SmithWitnessOf family (CConst 200) (CConst 203) (CConst 201) False (Nil Nat)
    | S remaining_11 => match remaining_11 with
    | Z => smith_leaf family smith_string_type (CStrBytes (smith_ascii seed) 18) True
    | S remaining_12 => match remaining_12 with
    | Z => let typ : CoreTerm := smith_data_type small in
        smith_leaf family (CPi typ typ) (smith_identity typ) False
    | S remaining_13 => match remaining_13 with
    | Z => smith_leaf family (CSort 0) (smith_data_type small) False
    | S remaining_14 => match remaining_14 with
    | Z => smith_leaf family (CSort 1) (CSort 0) False
    | S remaining_15 => match remaining_15 with
    | Z => SmithWitnessOf family smith_poly_type
        (CLam (CSort 0) (CLam (CRel 0) (smith_apply2 (CConst 300) (CRel 1) (CRel 0))))
        smith_poly_body False (Nil Nat)
    | S remaining_16 => match remaining_16 with
    | Z => let body : CoreTerm := CLam (CInd 100)
        (CCase (MkCaseInfo 100 0 (Nil Nat)) (CLam (CInd 100) retained_nat) (CRel 0) (Nil CoreTerm)) in
        smith_leaf family (CPi (CInd 100) retained_nat) body False
    | S remaining_17 => let number : CoreTerm := smith_numeral (smith_choice seed 37 7) in
        SmithWitnessOf 17 retained_nat (CApp (smith_nested (smith_choice seed 38 3)) number) number True (Nil Nat)

    end
    end
    end
    end
    end
    end
    end
    end
    end
    end
    end
    end
    end
    end
    end
    end
    end;
