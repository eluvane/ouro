import "../std/pathx.ouro",
  "../std/test.ouro";

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_eq "POSIX root is its own parent" (path_dirname "/") "/"
       , assert_eq "host root is its own parent" (path_dirname "\\") "/"
       , assert_eq "repeated POSIX root separators" (path_dirname "////") "/"
       , assert_eq "drive root is its own parent" (path_dirname "C:/") "C:/"
       , assert_eq "host drive root is its own parent" (path_dirname "C:\\") "C:/"
       , assert_eq "repeated drive root separators" (path_dirname "C:////") "C:/"
       , assert_eq "POSIX root parent remains anchored"
           (path_dirname (path_dirname "/main.ouro")) "/"
       , assert_eq "drive root parent remains anchored"
           (path_dirname (path_dirname "C:/main.ouro")) "C:/"
       , assert_eq "POSIX child parent" (path_dirname "/dir/main.ouro") "/dir"
       , assert_eq "drive child parent" (path_dirname "C:/dir/main.ouro") "C:/dir"
       , assert_eq "relative child parent" (path_dirname "dir/main.ouro") "dir"
       , assert_eq "relative leaf parent" (path_dirname "main.ouro") "."
       , assert_eq "empty path parent" (path_dirname "") "."
       , assert_true "POSIX root contains itself" (path_under "/" (path_dirname "/"))
       , assert_true "drive root contains itself" (path_under "C:/" (path_dirname "C:/"))
       , assert_true "POSIX root contains absolute child" (path_under "/" "/dir/main.ouro")
       , assert_true "POSIX root excludes relative child" (notb (path_under "/" "dir/main.ouro"))
       , assert_true "drive root excludes another drive" (notb (path_under "C:/" "D:/main.ouro"))
       , assert_true "path prefix requires a separator" (notb (path_under "C:/dir" "C:/directory/main.ouro"))
       , assert_true "UNC root contains host child" (path_under "//server/share" "\\\\server\\share\\dir\\main.ouro")
       , assert_true "UNC root excludes another share" (notb (path_under "//server/share" "//server/share-other/main.ouro"))
       , assert_true "UNC root excludes another server" (notb (path_under "//server/share" "//server-other/share/main.ouro"))
       , assert_true "empty root authorizes no path" (notb (path_under "" "/main.ouro"))
       , assert_true "identical paths match across host separators"
           (path_under "C:\\dir" "C:/dir")
       , assert_eq "relative spelling omits the shared drive path"
           (path_relative "C:\\dir" "C:/dir/雪.ouro") "雪.ouro"
       , assert_eq "relative spelling preserves the remainder after one extra separator"
           (path_relative "C:/dir/" "C:/dir///leaf.ouro") "/leaf.ouro"
       , assert_eq "relative spelling keeps a sibling path outside the root"
           (path_relative "C:/dir" "C:\\directory\\leaf.ouro") "C:/directory/leaf.ouro"
       , assert_eq "relative spelling of the root itself is empty"
           (path_relative "//server/share" "\\\\server\\share") ""
       , assert_true "build directory exclusions accept host separators"
           (andb (path_skip_build "_build\\cache") (path_skip_build "_tools\\scratch"))
       , assert_eq "stem removes only the final extension of a host path"
           (path_stem "C:\\tests\\case.name.ouro") "case.name"
       , assert_eq "stem preserves a hidden basename"
           (path_stem "project/.ouro") ".ouro"
       ] : List Test);
