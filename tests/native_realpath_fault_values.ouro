-- Typed wrappers run after checked-source replay. Original raw bodies
-- retain their targets; injected close/release errors follow actual cleanup.
import "native_realpath_probe_strings.ouro";
import "native_realpath_fault_support.ouro";
import "native_startup_fault_values.ouro";
import "../compiler/native/managed_realpath.ouro";

def realpath_fault_mode (mode : Nat) (values : List Nat) : Bool :=
    any Nat (eqNat mode) values;

def realpath_fault_overflow : MirValue :=
    MirBits MirU32 (X64Words64 (X64Bytes32 0 0 0 128) codegen_zero);

def realpath_fault_symbol_names : List String :=
    ["raw_pages_allocate", "raw_pages_release", "raw_windows_utf8_to_utf16", "raw_windows_utf16_to_utf8",
      "raw_windows_realpath_open", "raw_windows_realpath_read", "raw_windows_file_close", "windows_exit_process", "managed_collect"];

def realpath_fault_symbols (checked : CheckedProgram) : Either NativeLowerError (List Nat) :=
    (fix resolve (names : List String) : Either NativeLowerError (List Nat) :=
      match names with | Nil => Right NativeLowerError (List Nat) ([] : List Nat)
      | Cons name rest => lower_bind Nat (List Nat) (managed_source_symbol checked (prim_string_to_char_codes name))
          (fun (id : Nat) => lower_map (List Nat) (List Nat) (Cons Nat id) (resolve rest)) end) realpath_fault_symbol_names;

-- Slots 0..48 count allocate/release/open/close/read/input/output calls.
-- 56 counts successful opens; 64/72/80 track depth/owned/stream_handle. 88 counts
-- forced GC; 96/104 reuse the collector observations. 112/120 retain query
-- byte/capacity sizes. Exact raw allocation bases occupy slots 128..184.

def realpath_fault_collect (base : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedResult ManagedState (startup_fault_count base 88 state)
      (fun (attempt_result : ManagedResult) => match attempt_result with
        | ManagedResultOf attempt counted => lower_bind ManagedResult ManagedState (managed_fresh MirRawPtr (fun (local : Nat) => MirManagedContext local) counted)
      (fun (context_result : ManagedResult) => match context_result with
        | ManagedResultOf context located => lower_bind ManagedResult ManagedState (startup_fault_call MirU8 (add base 8) ([context] : List MirValue) located)
      (fun (okay_result : ManagedResult) => match okay_result with
        | ManagedResultOf okay collected => managed_require_equal okay (managed_bits MirU8 1) collected end) end) end);

def realpath_fault_size (base : Nat) (mode : Nat) (depth : MirValue) (checked : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (managed_compare MirEqual depth (managed_bits MirUSize 0) checked)
      (fun (at_0_result : ManagedResult) => match at_0_result with
        | ManagedResultOf at_0 tested_0 => managed_string_choose MirUSize at_0 (startup_fault_result MirUSize 24)
        (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_compare MirEqual depth (managed_bits MirUSize 1) checked)
      (fun (at_1_result : ManagedResult) => match at_1_result with
        | ManagedResultOf at_1 tested_1 => managed_string_choose MirUSize at_1 (startup_fault_result MirUSize (match eqNat mode 30 with | True => 1 | False => match eqNat mode 31 with | True => 3 | False => 14 end end))
        (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_compare MirEqual depth (managed_bits MirUSize 2) checked)
      (fun (at_2_result : ManagedResult) => match at_2_result with
        | ManagedResultOf at_2 tested_2 => managed_string_choose MirUSize at_2 (startup_fault_result MirUSize (match eqNat mode 31 with | True => 8 | False => 30 end))
        (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (managed_compare MirEqual depth (managed_bits MirUSize 3) checked)
      (fun (is_wide_result : ManagedResult) => match is_wide_result with
        | ManagedResultOf is_wide tested => managed_string_choose MirUSize is_wide (fun (current : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_load base 120 MirUSize current)
      (fun (capacity_result : ManagedResult) => match capacity_result with
        | ManagedResultOf capacity loaded => lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirMul capacity (managed_bits MirUSize 2) loaded)
      (fun (bytes_result : ManagedResult) => match bytes_result with
        | ManagedResultOf bytes sized => Right NativeLowerError ManagedResult (ManagedResultOf bytes sized) end) end))
        (startup_fault_load base 112 MirUSize) tested end)) tested_2 end)) tested_1 end)) tested_0 end);

def realpath_fault_allocate (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (realpath_fault_collect base state)
      (fun (collected : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_load base 64 MirUSize collected)
      (fun (depth_result : ManagedResult) => match depth_result with
        | ManagedResultOf depth loaded => lower_bind ManagedResult ManagedResult (managed_compare MirLess depth (managed_bits MirUSize 5) loaded)
      (fun (bounded_result : ManagedResult) => match bounded_result with
        | ManagedResultOf bounded tested => lower_bind ManagedState ManagedResult (managed_require_equal bounded (managed_bits MirU8 1) tested)
      (fun (checked : ManagedState) => lower_bind ManagedResult ManagedResult (realpath_fault_size base mode depth checked)
      (fun (bytes_result : ManagedResult) => match bytes_result with
        | ManagedResultOf bytes sized => lower_bind ManagedState ManagedResult (managed_require_equal (MirUse 0) bytes sized)
      (fun (exact : ManagedState) => startup_fault_allocate base (match andb (leb_nat 1 mode) (leb_nat mode 5) with | True => mode | False => 0 end) original exact) end)) end) end));

def realpath_fault_release (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (realpath_fault_collect base state)
      (fun (collected : ManagedState) => lower_bind ManagedState ManagedResult (startup_fault_stat base 72 0 collected)
      (fun (closed : ManagedState) => lower_bind ManagedState ManagedResult (startup_fault_pop base (MirUse 0) closed)
      (fun (popped : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_call MirU8 original ([MirUse 0] : List MirValue) popped)
      (fun (okay_result : ManagedResult) => match okay_result with
        | ManagedResultOf okay released => lower_bind ManagedState ManagedResult (managed_require_equal okay (managed_bits MirU8 1) released)
      (fun (success : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 8 success)
      (fun (attempt_result : ManagedResult) => match attempt_result with
        | ManagedResultOf attempt counted => match (realpath_fault_mode mode ([25, 26, 35, 37] : List Nat)) with | False => startup_fault_result MirU8 1 counted
      | True => managed_compare MirNotEqual attempt (managed_bits MirUSize 1) counted end end)) end))));

def realpath_fault_close (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (realpath_fault_collect base state)
      (fun (collected : ManagedState) => lower_bind ManagedState ManagedResult (startup_fault_stat base 72 1 collected)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_load base 80 MirRawPtr owned)
      (fun (handle_result : ManagedResult) => match handle_result with
        | ManagedResultOf stream_handle loaded => lower_bind ManagedState ManagedResult (managed_require_equal (MirUse 0) stream_handle loaded)
      (fun (same : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 24 same)
      (fun (attempt_result : ManagedResult) => match attempt_result with
        | ManagedResultOf attempt counted => lower_bind ManagedResult ManagedResult (startup_fault_call MirU32 original ([MirUse 0] : List MirValue) counted)
      (fun (status_result : ManagedResult) => match status_result with
        | ManagedResultOf status closed => lower_bind ManagedState ManagedResult (managed_require_equal status (managed_bits MirU32 0) closed)
      (fun (success : ManagedState) => lower_bind ManagedState ManagedResult (startup_fault_store base 72 (managed_bits MirUSize 0) success)
      (fun (cleared : ManagedState) => startup_fault_result MirU32 (match (realpath_fault_mode mode ([24, 26, 36] : List Nat)) with | True => 5 | False => 0 end) cleared)) end) end)) end)));

def realpath_fault_open (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 0 state)
      (fun (vacant : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize (MirUse 2) 0 vacant)
      (fun (previous_result : ManagedResult) => match previous_result with
        | ManagedResultOf previous loaded => lower_bind ManagedState ManagedResult (managed_require_equal previous (managed_bits MirUSize 0) loaded)
      (fun (empty : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 16 empty)
      (fun (attempt_result : ManagedResult) => match attempt_result with
        | ManagedResultOf attempt counted => match (realpath_fault_mode mode ([10, 35] : List Nat)) with | True => startup_fault_result MirU32 1 counted | False =>
      match eqNat mode 11 with | True => startup_fault_result MirU32 87 counted | False => lower_bind ManagedResult ManagedResult (startup_fault_call MirU32 original ([MirUse 0, MirUse 1, MirUse 2] : List MirValue) counted)
      (fun (status_result : ManagedResult) => match status_result with
        | ManagedResultOf status opened => match eqNat mode 31 with | True => lower_bind ManagedState ManagedResult (managed_require_equal status (managed_bits MirU32 87) opened)
      (fun (rejected : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf status rejected)) | False => lower_bind ManagedState ManagedResult (managed_require_equal status (managed_bits MirU32 0) opened)
      (fun (okay : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize (MirUse 2) 0 okay)
      (fun (bits_result : ManagedResult) => match bits_result with
        | ManagedResultOf bits loaded => lower_bind ManagedResult ManagedResult (managed_convert MirRawPtr MirRawFromBits bits loaded)
      (fun (handle_result : ManagedResult) => match handle_result with
        | ManagedResultOf stream_handle converted => lower_bind ManagedState ManagedResult (startup_fault_store base 80 stream_handle converted)
      (fun (saved : ManagedState) => lower_bind ManagedState ManagedResult (startup_fault_store base 72 (managed_bits MirUSize 1) saved)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 56 owned)
      (fun (attempt_result : ManagedResult) => match attempt_result with
        | ManagedResultOf attempt counted => Right NativeLowerError ManagedResult (ManagedResultOf status counted) end))) end) end)) end end) end end end)) end));
