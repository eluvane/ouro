-- Accepted checked-Core cases exercise the shared C/native emission view.
import "../compiler/erasure_checked.ouro",
  "../compiler/extract.ouro";

def erasure_case_fuel : Nat := 2000;

def erasure_case_nat : CoreTerm := CInd 100;
def erasure_case_zero : CoreTerm := CConstruct 100 0 0;
def erasure_case_one : CoreTerm := CApp(CConstruct 100 1 0, erasure_case_zero);
def erasure_case_poly_type : CoreTerm := CPi(CSort 0, CPi(CRel 0, CRel 1));
def erasure_case_poly_body : CoreTerm := CLam(CSort 0, CLam(CRel 0, CRel 0));
def erasure_case_alias_body : CoreTerm := CLam(CConst 200, CLam(CRel 0, CRel 0));

def erasure_case_entries : List Entry :=
    [ MkEntry 205 (CPi(CSort 0, erasure_case_nat))
        (Just CoreTerm (CLam(CSort 0, erasure_case_zero)))
    , MkEntry 203 erasure_case_poly_type (Just CoreTerm erasure_case_poly_body)
    , MkEntry 202 (CPi(CConst 200, CPi(CRel 0, CRel 1)))
        (Just CoreTerm erasure_case_alias_body)
    , MkEntry 201 (CSort 0) (Just CoreTerm erasure_case_nat)
    , MkEntry 200 (CSort 1) (Just CoreTerm (CSort 0))
    , MkIndEntry 100 (MkIndDecl 100 (Nil Param) (Nil CoreTerm) 0
        [MkCtor 101 erasure_case_nat, MkCtor 102 (CPi erasure_case_nat erasure_case_nat)])
    ];

def erasure_case_environment : CheckEnvironment :=
    check_environment_from_entries erasure_case_entries;

def erasure_case_types : List Nat := [100, 200, 201];

def erasure_case_prepare (term : CoreTerm) : CheckResult CoreTerm :=
    erasure_prepare_closed_indexed erasure_case_fuel erasure_case_environment erasure_case_types term;

def erasure_case_accepted (term : CoreTerm) (annotation : CoreTerm) : Bool :=
    check_succeeded Unit
      (check_term_checked_indexed erasure_case_fuel erasure_case_environment
        (Nil CoreTerm) term annotation);

def erasure_case_variable_ir (name : Nat) (term : JsIR) : Bool :=
    match term with
    | JVar variable => eqNat name variable
    | JGlob _ => False | JLam _ _ => False | JApp _ _ => False
    | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
    | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
    end;

def erasure_case_global_ir (name : Nat) (term : JsIR) : Bool :=
    match term with
    | JGlob global => eqNat name global
    | JVar _ => False | JLam _ _ => False | JApp _ _ => False
    | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
    | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
    end;

def erasure_case_one_ir (term : JsIR) : Bool :=
    match term with
    | JCtor family ordinal fields => andb(eqNat family 100,
        andb(eqNat ordinal 1, eqNat(length JsIR fields, 1)))
    | JVar _ => False | JGlob _ => False | JLam _ _ => False | JApp _ _ => False
    | JSwitch _ _ _ => False | JFix _ _ _ => False | JLet _ _ _ => False
    | JErr _ => False | JStr _ => False | JStrBytes _ => False
    end;

def erasure_case_identity_lambda (term : JsIR) : Bool :=
    match term with
    | JLam name body => erasure_case_variable_ir name body
    | JVar _ => False | JGlob _ => False | JApp _ _ => False
    | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
    | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
    end;

def erasure_case_identity_ir (term : CoreTerm) (annotation : CoreTerm) : Bool :=
    andb (erasure_case_accepted term annotation)
      (match erasure_case_prepare term with
       | CheckErr _ => False
       | CheckOk prepared => erasure_case_identity_lambda (extract_term_with erasure_case_types prepared)
       end);

def erasure_case_global_alias : Bool :=
    erasure_case_identity_ir erasure_case_alias_body
      (CPi(CConst 200, CPi(CRel 0, CRel 1)));

def erasure_case_nat_alias : Bool :=
    erasure_case_identity_ir (CLam(CConst 201, CRel 0)) (CPi(CConst 201, CConst 201));

def erasure_case_type_application (argument : CoreTerm) : Bool :=
    let term : CoreTerm := CApp(CApp(CConst 203, argument), erasure_case_one) in
    andb (erasure_case_accepted term erasure_case_nat)
      (match erasure_case_prepare term with
       | CheckErr _ => False
       | CheckOk prepared => match extract_term_with erasure_case_types prepared with
           | JApp function argument => andb(erasure_case_global_ir 203 function, erasure_case_one_ir argument)
           | JVar _ => False | JGlob _ => False | JLam _ _ => False
           | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
           | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
           end
       end);

def erasure_case_beta_type : Bool :=
    erasure_case_type_application (CApp(CLam(CSort 0, CRel 0), erasure_case_nat));

def erasure_case_let_type : Bool :=
    erasure_case_type_application (CLetIn erasure_case_nat (CSort 0) (CRel 0));

def erasure_case_type_choice (scrutinee : CoreTerm) : CoreTerm :=
    CCase (MkCaseInfo 100 0 [0, 1]) (CLam erasure_case_nat (CSort 0)) scrutinee
      [erasure_case_nat, CLam erasure_case_nat erasure_case_nat];

def erasure_case_case_type : Bool :=
    erasure_case_type_application (erasure_case_type_choice erasure_case_zero);

def erasure_case_runtime_application (argument : CoreTerm) (kept : JsIR -> Bool) : Bool :=
    let term : CoreTerm := CApp(CApp(CConst 203, erasure_case_nat), argument) in
    andb (erasure_case_accepted term erasure_case_nat)
      (match erasure_case_prepare term with
       | CheckErr _ => False
       | CheckOk prepared => match extract_term_with erasure_case_types prepared with
           | JApp function runtime_argument => andb(erasure_case_global_ir 203 function, kept runtime_argument)
           | JVar _ => False | JGlob _ => False | JLam _ _ => False
           | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
           | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
           end
       end);

def erasure_case_beta_ir (term : JsIR) : Bool :=
    match term with
    | JApp function argument => andb(erasure_case_identity_lambda function, erasure_case_one_ir argument)
    | JVar _ => False | JGlob _ => False | JLam _ _ => False
    | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
    | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
    end;

def erasure_case_let_ir (term : JsIR) : Bool :=
    match term with
    | JLet name value body => andb(erasure_case_one_ir value, erasure_case_variable_ir name body)
    | JVar _ => False | JGlob _ => False | JLam _ _ => False | JApp _ _ => False
    | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
    | JErr _ => False | JStr _ => False | JStrBytes _ => False
    end;

def erasure_case_beta_value : Bool :=
    erasure_case_runtime_application
      (CApp(CLam erasure_case_nat (CRel 0), erasure_case_one)) erasure_case_beta_ir;

def erasure_case_let_value : Bool :=
    erasure_case_runtime_application
      (CLetIn erasure_case_one erasure_case_nat (CRel 0)) erasure_case_let_ir;

def erasure_case_poly_value : Bool :=
    let apply : CoreTerm := CLam erasure_case_poly_type
      (CApp(CApp(CRel 0, erasure_case_nat), erasure_case_one)) in
    let term : CoreTerm := CApp apply (CConst 203) in
    andb (erasure_case_accepted term erasure_case_nat)
      (match erasure_case_prepare term with
       | CheckErr _ => False
       | CheckOk prepared => match extract_term_with erasure_case_types prepared with
           | JApp function argument => andb(erasure_case_global_ir 203 argument,
               match function with
               | JLam _ _ => True | JVar _ => False | JGlob _ => False | JApp _ _ => False
               | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
               | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
               end)
           | JVar _ => False | JGlob _ => False | JLam _ _ => False
           | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
           | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
           end
       end);

def erasure_case_local_alias_term : CoreTerm :=
    CLetIn (CSort 0) (CSort 1)
      (CLetIn (CLam(CRel 0, CLam(CRel 0, CRel 0)))
        (CPi(CRel 0, CPi(CRel 0, CRel 1)))
        (CApp(CApp(CRel 0, erasure_case_nat), erasure_case_one)));

def erasure_case_shadow_term : CoreTerm :=
    CLetIn erasure_case_nat (CSort 0)
      (CLetIn (CLam(CRel 0, CRel 0)) (CPi(CRel 0, CRel 1))
        (CApp(CRel 0, erasure_case_one)));

def erasure_case_local_identity (term : CoreTerm) : Bool :=
    andb (erasure_case_accepted term erasure_case_nat)
      (match erasure_case_prepare term with
       | CheckErr _ => False
       | CheckOk prepared => match extract_term_with erasure_case_types prepared with
           | JLet name value body => andb(erasure_case_identity_lambda value,
               match body with
               | JApp function argument => andb(erasure_case_variable_ir name function, erasure_case_one_ir argument)
               | JVar _ => False | JGlob _ => False | JLam _ _ => False
               | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
               | JLet _ _ _ => False | JErr _ => False | JStr _ => False | JStrBytes _ => False
               end)
           | JVar _ => False | JGlob _ => False | JLam _ _ => False | JApp _ _ => False
           | JCtor _ _ _ => False | JSwitch _ _ _ => False | JFix _ _ _ => False
           | JErr _ => False | JStr _ => False | JStrBytes _ => False
           end
       end);

def erasure_case_local_alias : Bool := erasure_case_local_identity erasure_case_local_alias_term;
def erasure_case_shadow : Bool := erasure_case_local_identity erasure_case_shadow_term;

def erasure_case_exhausted : Bool :=
    match erasure_prepare_closed_indexed 0 erasure_case_environment erasure_case_types erasure_case_poly_body with
    | CheckErr failure => eqNat(check_failure_code 1 failure, 4) | CheckOk _ => False end;

def erasure_case_unreduced_type : Bool :=
    let term : CoreTerm := CLam erasure_case_nat
      (CApp(CConst 205, erasure_case_type_choice (CRel 0))) in
    andb (erasure_case_accepted term (CPi erasure_case_nat erasure_case_nat))
      (match erasure_case_prepare term with
       | CheckErr failure => eqNat(check_failure_code 1 failure, 7) | CheckOk _ => False end);
