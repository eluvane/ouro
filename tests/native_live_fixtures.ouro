import "native_gc_fixtures.ouro";

def live_test_roots : List Nat := [0,1,2,3,4,5];

def live_test_instruction (name : String) (instruction : MirInstruction)
    (after : List Nat) (expected : List Nat) : Test :=
    assert_true(name, mir_set_equal(mir_live_instruction live_test_roots after instruction, expected));

def live_test_fact (facts : List MirBlockFact) (expected : MirBlockFact) : Bool :=
    match expected with | MirFact id values => match mir_fact_at id facts with
      | Left _ => False | Right actual => mir_set_equal actual values end end;

def live_test_facts (name : String) (blocks : List MirBlock) (expected : List MirBlockFact) : Test :=
    match mir_live_facts (S (length MirBlock blocks)) live_test_roots blocks with
    | Left err => test_fail(name, mir_test_error_text err)
    | Right facts => assert_true name (andb (eq_nat(length MirBlockFact facts, length MirBlockFact expected))
        (all MirBlockFact (live_test_fact facts) expected)) end;

def live_test_failure (name : String) (fuel : Nat) (blocks : List MirBlock) (expected : MirError) : Test :=
    match mir_live_facts fuel live_test_roots blocks with
    | Left err => assert_eq(name, mir_test_error_text err, mir_test_error_text expected)
    | Right _ => test_fail name "incomplete liveness accepted" end;

def live_test_branch : List MirBlock := [
    MirBlockDef 0 [] (MirBranch (MirUse 10) 1 2),
    MirBlockDef 1 [MirMove(2, MirUse 0)] (MirJump 3),
    MirBlockDef 2 [MirMove(2, MirUse 1)] (MirJump 3),
    MirBlockDef 3 [] (MirReturn (Just(MirValue, MirUse 2)))];

def live_test_branch_facts : List MirBlockFact := [MirFact 0 [0,1], MirFact 1 [0], MirFact 2 [1], MirFact 3 [2]];

-- The only use is block 7. Reaching it crosses 5->3, 3->1, 6->4 and 4->2;
-- backedges 5->0, 4->1 and 2->5 form overlapping loops. Entry 0 receives the
-- root in growth round 8, so its fixed-point confirmation needs round 9.
def live_test_backedges : List MirBlock := [
    MirBlockDef 0 [] (MirJump 5),
    MirBlockDef 1 [] (MirJump 6),
    MirBlockDef 2 [] (MirBranch (MirUse 10) 5 7),
    MirBlockDef 3 [] (MirJump 1),
    MirBlockDef 4 [] (MirBranch (MirUse 10) 1 2),
    MirBlockDef 5 [] (MirBranch (MirUse 10) 0 3),
    MirBlockDef 6 [] (MirJump 4),
    MirBlockDef 7 [] (MirReturn (Just(MirValue, MirUse 0)))];

def live_test_backedge_facts : List MirBlockFact :=
    map(Nat, MirBlockFact, fun (id : Nat) => MirFact(id, [0] : List Nat), [0,1,2,3,4,5,6,7] : List Nat);

def live_test_kill : List MirBlock := [
    MirBlockDef 0 [] (MirJump 1),
    MirBlockDef 1 [MirMove(0, mir_fixture_nat MirManagedPtr 0)] (MirJump 2),
    MirBlockDef 2 [] (MirReturn (Just(MirValue, MirUse 0)))];

def live_test_set_lists : List (List Nat) -> List (List Nat) -> Bool :=
  fix same (actual : List (List Nat)) (expected : List (List Nat)) : Bool :=
    match actual, expected with
    | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
    | Cons a rest, Cons b more => andb(mir_set_equal a b, same rest more) end;

def live_test_sequence (name : String) (instructions : List MirInstruction) (after : List Nat)
    (expected : List (List Nat)) : Test :=
    match mir_live_instructions live_test_roots instructions after with | MkPair before annotated =>
      let actual : List (List Nat) := map (Pair(MirInstruction, List Nat)) (List Nat)
        (fun (item : Pair MirInstruction (List Nat)) => match item with | MkPair _ values => values end) annotated in
      assert_true name (andb (mir_set_equal(before, mir_live_before live_test_roots instructions after))
        (live_test_set_lists actual expected)) end;

def live_test_slots : List CodegenSlot := [CodegenSlotAt 0 MirManagedPtr 32, CodegenSlotAt 1 MirRawPtr 40,
    CodegenSlotAt 2 MirManagedPtr 48, CodegenSlotAt 3 MirManagedPtr 56];

def live_test_clears (name : String) (live : List Nat) (expected : List Nat) : Test :=
    match codegen_assemble (codegen_clear_dead_roots live_test_slots live) 0 0 with
    | Left _ => test_fail name "clear encoding failed"
    | Right encoded => match encoded with | CodegenEncodedParts bytes fixups calls =>
      assert_true name (andb (pe_bytes_equal bytes expected)
        (andb(eq_nat(length PeFixup fixups, 0), eq_nat(length NativeCallSite calls, 0)))) end end;

def live_test_unknown_block_codegen : Test :=
    let function : MirFunction := MirFunctionDef 1 [108] [] [MirLocalDef 0 MirManagedPtr]
      (Nothing MirType) 0 [MirBlockDef 0 [] (MirJump 99)] in
    let program : MirProgram := MirProgramDef [function] [] [] 1 in
    match codegen_body program function (codegen_frame function) with
    | Right _ => test_fail "Codegen fails closed on unknown liveness edge" "invalid graph emitted"
    | Left err => match err with
      | NativeMirError failure => assert_eq "Codegen fails closed on unknown liveness edge" (mir_test_error_text failure) "unknown-block:99"
      | NativeEncodingError _ => test_fail "Codegen fails closed on unknown liveness edge" "wrong error"
      | NativePeError _ => test_fail "Codegen fails closed on unknown liveness edge" "wrong error"
      | NativeMissingSlot _ => test_fail "Codegen fails closed on unknown liveness edge" "wrong error"
      | NativeMissingLabel _ => test_fail "Codegen fails closed on unknown liveness edge" "wrong error"
      | NativeCodeTooLarge => test_fail "Codegen fails closed on unknown liveness edge" "wrong error" end end;
