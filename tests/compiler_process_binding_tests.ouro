-- Compile the capture contract against the standard representation module.
-- Keeping this closure small detects a missing Pair role without platform IO.
import "../std/types.ouro";

intrinsic Runtime : Type -> Type := "ouro.runtime";
intrinsic String : Type := "ouro.string";
intrinsic runtime_pure : (A : Type) -> A -> Runtime A := "ouro.runtime.pure";

def IO (A : Type) : Type := Runtime A;

intrinsic capture : String -> List String -> IO (Pair Nat (Pair String String))
    := "ouro.process.capture";

def capture_alias : String -> List String -> IO (Pair Nat (Pair String String)) := capture;

def main : IO Unit := runtime_pure Unit MkUnit;
