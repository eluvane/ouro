-- Case fields, primitive results and dependent applications have concrete witnesses.
import "compiler_smith_generate.ouro";

def smith_predecessor (value : Nat) : Nat := match value with | Z => 0 | S rest => rest end;

def smith_enum_branches : Nat -> Nat -> List CoreTerm :=
  fix build (count : Nat) (index : Nat) : List CoreTerm :=
    match count with
    | Z => Nil CoreTerm
    | S rest => Cons CoreTerm (smith_numeral index) (build rest (S index))
    end;

def smith_tree_case (seed : Nat) (left : CoreTerm) (right : CoreTerm) : SmithWitness :=
    let payload : CoreTerm := smith_data_value (smith_payload seed) (property_seed seed 48) in
    let leaf : CoreTerm := match smith_tree_payload seed with
      | True => CApp (CConstruct 80 0 0) payload | False => CConstruct 80 0 0 end in
    let leaf_branch : CoreTerm := match smith_tree_payload seed with
      | True => CLam (smith_data_type (smith_payload seed)) (CApp (CConstruct 80 0 0) (CRel 0))
      | False => CConstruct 80 0 0 end in
    let arity : Nat := match smith_tree_payload seed with | True => 1 | False => 0 end in
    let select_leaf : Bool := smith_choose seed 49 in
    let input : CoreTerm := match select_leaf with
      | True => leaf | False => smith_apply2 (CConstruct 80 1 0) left right end in
    let expected : CoreTerm := match select_leaf with | True => leaf | False => left end in
    smith_result 7 (CInd 80)
      (CCase (MkCaseInfo 80 0 ([arity, 2] : List Nat)) (CLam (CInd 80) (CInd 80)) input
        ([leaf_branch, CLam (CInd 80) (CLam (CInd 80) (CRel 1))] : List CoreTerm)) expected True;

def smith_elimination_cases (seed : Nat) : List (Pair String SmithWitness) :=
    let number : Nat := smith_choice seed 50 7 in
    let value : CoreTerm := smith_numeral number in
    let bool : Nat := smith_choice seed 51 2 in
    let inverse : Nat := match bool with | Z => 1 | S _ => 0 end in
    let tag : Nat := smith_choice seed 52 (smith_enum_size seed) in
    let option_some : Bool := smith_choose seed 53 in
    let option : CoreTerm := match option_some with
      | True => smith_apply2 (CConstruct 44 1 1) retained_nat value
      | False => CApp (CConstruct 44 0 1) retained_nat end in
    let option_normal : CoreTerm := match option_some with | True => value | False => retained_zero end in
    let list_empty : Bool := smith_choose seed 54 in
    let list_values : List CoreTerm := match list_empty with
      | True => Nil CoreTerm | False => [value, smith_numeral (S number)] end in
    let list_normal : CoreTerm := match list_empty with | True => retained_zero | False => value end in
    let payload_type : CoreTerm := smith_data_type (smith_payload seed) in
    let payload : CoreTerm := smith_data_value (smith_payload seed) (property_seed seed 55) in
    let boxed : CoreTerm := smith_data_type (smith_data_shape 2 (property_seed seed 56)) in
    [ smith_named "case-nat-field"
        (smith_result 0 retained_nat
          (CCase retained_nat_info retained_nat_motive value ([retained_zero, CLam retained_nat (CRel 0)] : List CoreTerm))
          (smith_numeral (smith_predecessor number)) True)
    , smith_named "case-bool-branch"
        (smith_result 1 retained_bool
          (CCase (MkCaseInfo 20 0 ([0, 0] : List Nat)) (CLam retained_bool retained_bool)
            (CConstruct 20 bool 0) ([CConstruct 20 1 0, CConstruct 20 0 0] : List CoreTerm))
          (CConstruct 20 inverse 0) True)
    , smith_named "case-enum-coverage"
        (smith_result 0 retained_nat
          (CCase (MkCaseInfo 60 0 (replicate Nat 0 (smith_enum_size seed)))
            (CLam (CInd 60) retained_nat) (CConstruct 60 tag 0) (smith_enum_branches (smith_enum_size seed) 0))
          (smith_numeral tag) True)
    , smith_named "case-option-parameter"
        (smith_result 0 retained_nat
          (CCase (MkCaseInfo 44 1 ([0, 1] : List Nat)) (CLam (CApp (CInd 44) retained_nat) retained_nat)
            option ([retained_zero, CLam retained_nat (CRel 0)] : List CoreTerm)) option_normal True)
    , smith_named "case-list-parameters-and-fields"
        (smith_result 0 retained_nat
          (CCase (MkCaseInfo 43 1 ([0, 2] : List Nat)) (CLam (CApp (CInd 43) retained_nat) retained_nat)
            (smith_list_value retained_nat list_values)
            ([retained_zero, CLam retained_nat (CLam (CApp (CInd 43) retained_nat) (CRel 1))] : List CoreTerm))
          list_normal True)
    , smith_named "case-pair-field-order"
        (smith_result 0 retained_nat
          (CCase (MkCaseInfo 30 2 ([2] : List Nat)) (CLam (retained_pair retained_nat retained_bool) retained_nat)
            (retained_pair_value retained_nat retained_bool value (CConstruct 20 bool 0))
            ([CLam retained_nat (CLam retained_bool (CRel 1))] : List CoreTerm)) value True)
    , smith_named "case-wrap-field"
        (smith_result 0 payload_type
          (CCase (MkCaseInfo 70 0 ([1] : List Nat)) (CLam (CInd 70) payload_type)
            (CApp (CConstruct 70 0 0) payload) ([CLam payload_type (CRel 0)] : List CoreTerm)) payload True)
    , smith_named "case-tree-fields"
        (smith_tree_case seed (smith_tree_value seed 2 (property_seed seed 57))
          (smith_tree_value seed 2 (property_seed seed 58)))
    , smith_named "case-box1-universe"
        (smith_result 13 (CSort 0)
          (CCase (MkCaseInfo 90 0 ([1] : List Nat)) (CLam (CInd 90) (CSort 0))
            (CApp (CConstruct 90 0 0) boxed) ([CLam (CSort 0) (CRel 0)] : List CoreTerm)) boxed False)
    , smith_named "case-nested-pair-field-binders"
        (smith_result 0 retained_nat retained_nested_pair_body retained_two True)
    ];

def smith_decimal : Nat -> Nat -> List Nat :=
  fix digits (fuel : Nat) (value : Nat) : List Nat :=
    match fuel with
    | Z => [256]
    | S rest => match compareNat value 10 with
        | LT => [add 48 value]
        | EQ => [49, 48]
        | GT => append Nat (digits rest (div_nat value 10)) ([add 48 (mod_nat value 10)] : List Nat)
        end
    end;

def smith_codes (bytes : List Nat) : CoreTerm :=
    smith_list_value retained_nat (map Nat CoreTerm smith_numeral bytes);

def smith_string_cases (seed : Nat) : List (Pair String SmithWitness) :=
    let seed_bytes : List Nat := str_codes (str_of_nat seed) in
    let left : List Nat := append Nat ([108, 101, 102, 116] : List Nat) seed_bytes in
    let right : List Nat := append Nat ([114, 105, 103, 104, 116] : List Nat) seed_bytes in
    let bytes : List Nat := smith_ascii (property_seed seed 60) in
    let literal : CoreTerm := CStrBytes bytes 18 in
    let start : Nat := smith_choice seed 61 9 in
    let count : Nat := smith_choice seed 62 9 in
    let number : Nat := smith_choice seed 63 100 in
    let equal : Bool := smith_choose seed 64 in
    let comparison : List Nat := match equal with
      | True => bytes | False => append Nat bytes ([33] : List Nat) end in
    let bool : Nat := match equal with | True => 0 | False => 1 end in
    let neutral : CoreTerm := CLam smith_string_type
      (smith_apply2 (CConst 220) (CRel 0) (CStrBytes bytes 18)) in
    [ smith_named "string-concat-order"
        (smith_result 11 smith_string_type
          (smith_apply2 (CConst 220) (CStrBytes left 18) (CStrBytes right 18)) (CStrBytes (append Nat left right) 18) True)
    , smith_named "string-length-bytes"
        (smith_result 0 retained_nat (CApp (CConst 221) literal) (smith_numeral (length Nat bytes)) True)
    , smith_named "string-slice-clamped"
        (smith_result 11 smith_string_type (smith_apply3 (CConst 222) literal (smith_numeral start) (smith_numeral count))
          (CStrBytes (take Nat count (drop Nat start bytes)) 18) True)
    , smith_named "string-equality"
        (smith_result 1 retained_bool (smith_apply2 (CConst 223) literal (CStrBytes comparison 18)) (CConstruct 20 bool 0) True)
    , smith_named "string-of-nat-decimal"
        (smith_result 11 smith_string_type (CApp (CConst 224) (smith_numeral number)) (CStrBytes (smith_decimal 12 number) 18) True)
    , smith_named "string-to-codes"
        (smith_result 4 smith_codes_type (CApp (CConst 225) literal) (smith_codes bytes) True)
    , smith_named "string-of-codes"
        (smith_result 11 smith_string_type (CApp (CConst 226) (smith_codes bytes)) literal True)
    , smith_named "string-neutral-argument" (smith_leaf 12 (CPi smith_string_type smith_string_type) neutral False)
    ];
