-- Conditions and bodies mutate Windows last-error state so their count and
-- ordering remain externally observable after the native loop terminates.
import "native_lower_raw_fixtures.ouro";

def lower_loop_count_fixture : String := lower_fixture_join
    ([lower_raw_common,
      "def main : Runtime W := bind W W pid (fun (x : W) => bind Size W one_size (fun (one : Size) => let unit : W := one_word one in let count : Byte := byte_add (byte x) (byte unit) in ",
      "bind Empty W (set_error (sub x x)) (fun (reset : Empty) => bind Byte W (loop_action Byte count ",
      "(fun (remaining : Byte) => bind W Byte (increment unit) (fun (tested : W) => pure Byte remaining)) ",
      "(fun (remaining : Byte) => bind W Byte (increment x) (fun (stepped : W) => pure Byte (byte_sub remaining (byte unit))))) ",
      "(fun (finished : Byte) => bind W W get_error (fun (total : W) => pure W (sub total (add (unbyte count) unit)))))));"] : List String);

def lower_loop_order_fixture : String := lower_fixture_join
    ([lower_raw_common,
      "def main : Runtime W := bind W W pid (fun (x : W) => bind Size W one_size (fun (one : Size) => let unit : W := one_word one in let count : Byte := byte (one_word (four_bytes one)) in ",
      "bind Empty W (set_error x) (fun (reset : Empty) => bind Byte W (loop_action Byte count ",
      "(fun (remaining : Byte) => bind W Byte (increment unit) (fun (tested : W) => pure Byte remaining)) ",
      "(fun (remaining : Byte) => bind W Byte double_error (fun (stepped : W) => pure Byte (byte_sub remaining (byte unit))))) ",
      "(fun (finished : Byte) => get_error))));"] : List String);

def lower_loop_zero_fixture : String := lower_fixture_join
    ([lower_raw_common,
      "def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in bind Empty W (set_error zero) (fun (reset : Empty) => ",
      "bind Byte W (loop_action Byte (byte zero) ",
      "(fun (remaining : Byte) => bind W Byte (increment x) (fun (tested : W) => pure Byte remaining)) ",
      "(fun (remaining : Byte) => bind W Byte (increment x) (fun (stepped : W) => pure Byte remaining))) ",
      "(fun (finished : Byte) => get_error))); "] : List String);

def lower_loop_nested_fixture : String := lower_fixture_join
    ([lower_raw_common,
      "def main : Runtime W := bind W W pid (fun (x : W) => bind Size W one_size (fun (one : Size) => let unit : W := one_word one in let two : Byte := byte (add unit unit) in let three : Byte := byte_add two (byte unit) in ",
      "bind Empty W (set_error (sub x x)) (fun (reset : Empty) => bind Byte W (loop_action Byte two ",
      "(fun (outer : Byte) => pure Byte outer) ",
      "(fun (outer : Byte) => bind Byte Byte (loop_action Byte three (fun (inner : Byte) => pure Byte inner) ",
      "(fun (inner : Byte) => bind W Byte (increment x) (fun (stepped : W) => pure Byte (byte_sub inner (byte unit))))) ",
      "(fun (finished_inner : Byte) => pure Byte (byte_sub outer (byte unit))))) ",
      "(fun (finished : Byte) => get_error))));"] : List String);

def lower_loop_unit_fixture : String := lower_fixture_join
    ([lower_raw_common,
      "def main : Runtime W := bind W W pid (fun (x : W) => let zero : W := sub x x in bind Empty W (set_error zero) (fun (reset : Empty) => ",
      "bind Empty W (loop_action Empty EmptyValue ",
      "(fun (state : Empty) => bind W Byte (increment x) (fun (tested : W) => pure Byte (byte zero))) ",
      "(fun (state : Empty) => bind W Empty (increment x) (fun (stepped : W) => pure Empty state))) ",
      "(fun (finished : Empty) => get_error))); "] : List String);

-- Modes 3/4/5 are count*PID, 16*PID+31, and 6*PID respectively (mod 2^32).
def lower_loop_fixtures : List NativeLowerFixture :=
    [NativeLowerFixtureOf "loop_count" lower_loop_count_fixture 3,
     NativeLowerFixtureOf "loop_order" lower_loop_order_fixture 4,
     NativeLowerFixtureOf "loop_zero" lower_loop_zero_fixture 0,
     NativeLowerFixtureOf "loop_nested" lower_loop_nested_fixture 5,
     NativeLowerFixtureOf "loop_unit" lower_loop_unit_fixture 0];

def lower_all_fixtures : List NativeLowerFixture :=
    append NativeLowerFixture lower_fixtures (append NativeLowerFixture lower_raw_fixtures lower_loop_fixtures);
