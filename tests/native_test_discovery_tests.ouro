-- Discovery preserves roots/explicit paths and reports incomplete inventories.
import "../tools/test/discovery.ouro",
  "analyze/precision/assertions.ouro";

def native_test_discovery_equal (result : Either FsError (List String)) (wanted : List String) : Bool :=
    match result with | Left _ => False | Right files => list_eq String str_eq files wanted end;

def native_test_discovery_failed (result : Either FsError (List String)) : Bool :=
    match result with | Left _ => True | Right _ => False end;

-- @entry main
def main : IO Unit :=
    let root : String := "tests/native_test_discovery_cases" in
    let first : String := fs_child root "first" in
    let second : String := fs_child root "second" in
    do let! ordered := test_discover_inputs [second, first];
       let! literal := test_discover_inputs [fs_child first "fixtures/hidden_test.ouro", "missing explicit.ouro"];
       let! exhausted := test_discover_walk 1 [first] [];
       let! missing := test_discover_walk 4 [fs_child root "missing"] [];
       let! repeated := test_discover_inputs [second, second];
       let! empty := test_discover_walk 0 [] ["earlier"];
       let! no_tests := test_discover_inputs [fs_child root "empty"];
       precision_run "native-test-discovery"
         [ MkPair String Bool "native-test-discovery/ordered-roots-and-files"
             (native_test_discovery_equal ordered [fs_child second "z_test.ouro", fs_child first "a_test.ouro", fs_child first "b_test.ouro"])
         , MkPair String Bool "native-test-discovery/explicit-paths-stay-literal"
             (native_test_discovery_equal literal [fs_child first "fixtures/hidden_test.ouro", "missing explicit.ouro"])
         , MkPair String Bool "native-test-discovery/exhaustion-is-error" (native_test_discovery_failed exhausted)
         , MkPair String Bool "native-test-discovery/missing-inventory-is-error" (native_test_discovery_failed missing)
         , MkPair String Bool "native-test-discovery/repeated-roots-preserved"
             (native_test_discovery_equal repeated [fs_child second "z_test.ouro", fs_child second "z_test.ouro"])
         , MkPair String Bool "native-test-discovery/empty-walk-preserves-state"
             (native_test_discovery_equal empty ["earlier"])
         , MkPair String Bool "native-test-discovery/directory-without-tests-is-empty"
             (native_test_discovery_equal no_tests [])
         ]
