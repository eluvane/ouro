-- Exact command grammar before filesystem access or compiler execution.
import "analyze/precision/assertions.ouro";
import "../tools/native_cli_args.ouro";

def native_cli_test_error (words : List String) (expected : String) : Bool :=
    match native_cli_parse words with
    | Right _ => False
    | Left error => str_eq (native_cli_error_code error) expected
    end;

def native_cli_test_diagnostic (words : List String) (code : String) (message : String) : Bool :=
    match native_cli_parse words with
    | Right _ => False
    | Left error => andb (str_eq (native_cli_error_code error) code)
        (str_eq (native_cli_error_message error) message)
    end;

def native_cli_test_artifact (actual : Maybe String) (expected : Maybe String) : Bool :=
    match actual with
    | Nothing => match expected with | Nothing => True | Just _ => False end
    | Just output => match expected with | Nothing => False | Just other => str_eq output other end
    end;

def native_cli_test_check (words : List String) (source : String) (fuel : Nat)
    (artifact : Maybe String) : Bool :=
    match native_cli_parse words with
    | Left _ => False
    | Right command => match command with
      | NativeCliDoctor => False
      | NativeCliBuild _ => False
      | NativeCliRun _ _ => False
      | NativeCliCheck actual budget output =>
          andb (str_eq actual source) (andb (eq_nat budget fuel) (native_cli_test_artifact output artifact))
      end
    end;

def native_cli_test_build (words : List String) (source : String) (output : String) : Bool :=
    match native_cli_parse words with
    | Left _ => False
    | Right command => match command with
      | NativeCliDoctor => False
      | NativeCliCheck _ _ _ => False
      | NativeCliRun _ _ => False
      | NativeCliBuild request =>
          andb (str_eq (native_build_request_source request) source)
            (andb (str_eq (native_build_request_out request) output)
              (andb (str_eq (native_build_request_backend request) "native")
                (andb (str_eq (native_build_request_target request) "x86_64-windows")
                  (andb (str_eq (native_build_request_entry request) "main")
                    (eq_nat (native_build_request_fuel request) (mul 200 1000))))))
      end
    end;

def native_cli_test_run (words : List String) (source : String) (output : String)
    (arguments : List String) : Bool :=
    match native_cli_parse words with
    | Left _ => False
    | Right command => match command with
      | NativeCliDoctor => False
      | NativeCliCheck _ _ _ => False
      | NativeCliBuild _ => False
      | NativeCliRun request actual =>
          andb (list_eq String str_eq actual arguments)
            (andb (str_eq (native_build_request_source request) source)
              (andb (str_eq (native_build_request_out request) output)
                (andb (str_eq (native_build_request_backend request) "native")
                  (andb (str_eq (native_build_request_target request) "x86_64-windows")
                    (andb (str_eq (native_build_request_entry request) "main")
                      (eq_nat (native_build_request_fuel request) (mul 200 1000)))))))
      end
    end;

def native_cli_args_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-cli-args/doctor"
        (match native_cli_parse (["doctor"] : List String) with
         | Left _ => False
         | Right command => match command with
           | NativeCliDoctor => True | NativeCliCheck _ _ _ => False
           | NativeCliBuild _ => False | NativeCliRun _ _ => False end
         end)
    , MkPair String Bool "native-cli-args/check-default"
        (native_cli_test_check (["check", "src/main.ouro"] : List String)
          "src/main.ouro" (mul 16 1000) (Nothing String))
    , MkPair String Bool "native-cli-args/check-budget-artifact"
        (native_cli_test_check (["check", "src/main.ouro", "17", "--emit-checked-program", "out dir/check.dump"] : List String)
          "src/main.ouro" 17 (Just String "out dir/check.dump"))
    , MkPair String Bool "native-cli-args/check-zero-is-a-checker-budget"
        (native_cli_test_check (["check", "main.ouro", "0"] : List String)
          "main.ouro" 0 (Nothing String))
    , MkPair String Bool "native-cli-args/build-default"
        (native_cli_test_build (["build", "src/main.ouro"] : List String)
          "src/main.ouro" "_build/native/main.exe")
    , MkPair String Bool "native-cli-args/build-paths"
        (native_cli_test_build (["build", "каталог/my file.ouro", "--out", "out dir/app.exe",
          "--target", "x86_64-windows", "--backend", "native"] : List String)
          "каталог/my file.ouro" "out dir/app.exe")
    , MkPair String Bool "native-cli-args/no-command"
        (native_cli_test_error (Nil String) "missing-command")
    , MkPair String Bool "native-cli-args/unknown-command"
        (native_cli_test_error (["compile", "main.ouro"] : List String) "unknown-command")
    , MkPair String Bool "native-cli-args/run-not-silently-captured"
        (native_cli_test_run (["run", "main.ouro"] : List String)
          "main.ouro" "_build/native/run/main.exe" (Nil String))
    , MkPair String Bool "native-cli-args/legacy-command"
        (native_cli_test_error (["legacy-c", "main.ouro"] : List String) "unknown-command")
    , MkPair String Bool "native-cli-args/doctor-extra"
        (native_cli_test_error (["doctor", "extra"] : List String) "unexpected-argument")
    , MkPair String Bool "native-cli-args/check-missing"
        (native_cli_test_error (["check"] : List String) "missing-source")
    , MkPair String Bool "native-cli-args/build-missing"
        (native_cli_test_error (["build", "--out", "app.exe"] : List String) "missing-source")
    , MkPair String Bool "native-cli-args/check-empty-source"
        (native_cli_test_error (["check", ""] : List String) "missing-source")
    , MkPair String Bool "native-cli-args/build-empty-source"
        (native_cli_test_error (["build", ""] : List String) "missing-source")
    , MkPair String Bool "native-cli-args/build-source-extension"
        (native_cli_test_error (["build", "main.txt"] : List String) "invalid-source")
    , MkPair String Bool "native-cli-args/build-extra-source"
        (native_cli_test_error (["build", "one.ouro", "two.ouro"] : List String) "unexpected-argument")
    , MkPair String Bool "native-cli-args/check-extra-positional"
        (native_cli_test_error (["check", "one.ouro", "42", "extra"] : List String) "unexpected-argument")
    , MkPair String Bool "native-cli-args/check-bad-fuel"
        (native_cli_test_error (["check", "main.ouro", "12oops"] : List String) "invalid-fuel")
    , MkPair String Bool "native-cli-args/check-empty-fuel"
        (native_cli_test_error (["check", "main.ouro", ""] : List String) "invalid-fuel")
    , MkPair String Bool "native-cli-args/build-unknown-option"
        (native_cli_test_error (["build", "main.ouro", "--unknown", "value"] : List String) "unknown-option")
    , MkPair String Bool "native-cli-args/build-entry-rejected"
        (native_cli_test_error (["build", "main.ouro", "--entry", "other"] : List String) "unknown-option")
    , MkPair String Bool "native-cli-args/build-fuel-rejected"
        (native_cli_test_error (["build", "main.ouro", "--fuel", "1"] : List String) "unknown-option")
    , MkPair String Bool "native-cli-args/check-option-rejected"
        (native_cli_test_error (["check", "main.ouro", "--out", "app.exe"] : List String) "unknown-option")
    , MkPair String Bool "native-cli-args/joined-option-rejected"
        (native_cli_test_error (["build", "main.ouro", "--out=app.exe"] : List String) "unknown-option")
    , MkPair String Bool "native-cli-args/short-option-rejected"
        (native_cli_test_error (["build", "main.ouro", "-o", "app.exe"] : List String) "unknown-option")
    , MkPair String Bool "native-cli-args/missing-last-value"
        (native_cli_test_error (["build", "main.ouro", "--out"] : List String) "missing-value")
    , MkPair String Bool "native-cli-args/empty-option-value"
        (native_cli_test_error (["build", "main.ouro", "--out", ""] : List String) "missing-value")
    , MkPair String Bool "native-cli-args/option-is-not-value"
        (native_cli_test_error (["build", "main.ouro", "--out", "--target", "x86_64-windows"] : List String) "missing-value")
    , MkPair String Bool "native-cli-args/missing-dump-value"
        (native_cli_test_error (["check", "main.ouro", "--emit-checked-program"] : List String) "missing-value")
    , MkPair String Bool "native-cli-args/duplicate-out"
        (native_cli_test_error (["build", "main.ouro", "--out", "a.exe", "--out", "b.exe"] : List String) "duplicate-option")
    , MkPair String Bool "native-cli-args/duplicate-backend"
        (native_cli_test_error (["build", "main.ouro", "--backend", "native", "--backend", "native"] : List String) "duplicate-option")
    , MkPair String Bool "native-cli-args/duplicate-target"
        (native_cli_test_error (["build", "main.ouro", "--target", "x86_64-windows", "--target", "x86_64-windows"] : List String) "duplicate-option")
    , MkPair String Bool "native-cli-args/duplicate-dump"
        (native_cli_test_error (["check", "main.ouro", "--emit-checked-program", "one", "--emit-checked-program", "two"] : List String) "duplicate-option")
    , MkPair String Bool "native-cli-args/legacy-backend"
        (native_cli_test_error (["build", "main.ouro", "--backend", "legacy-c"] : List String) "rejected-build")
    , MkPair String Bool "native-cli-args/other-backend"
        (native_cli_test_error (["build", "main.ouro", "--backend", "llvm"] : List String) "rejected-build")
    , MkPair String Bool "native-cli-args/other-target"
        (native_cli_test_error (["build", "main.ouro", "--target", "x86_64-linux"] : List String) "rejected-build")
    , MkPair String Bool "native-cli-args/check-unit-rejected"
        (native_cli_test_diagnostic (["check", "main.ouro", "--unit", "dep.ouro"] : List String)
          "unknown-option" "unknown option: --unit")
    , MkPair String Bool "native-cli-args/check-dashed-source"
        (native_cli_test_diagnostic (["check", "-main.ouro"] : List String)
          "unknown-option" "unknown option: -main.ouro")
    , MkPair String Bool "native-cli-args/build-dashed-source"
        (native_cli_test_diagnostic (["build", "-main.ouro"] : List String)
          "unknown-option" "unknown option: -main.ouro")
    , MkPair String Bool "native-cli-args/check-relative-dashed-source"
        (native_cli_test_check (["check", "./-main.ouro"] : List String)
          "./-main.ouro" (mul 16 1000) (Nothing String))
    , MkPair String Bool "native-cli-args/build-relative-dashed-source"
        (native_cli_test_build (["build", "./-main.ouro"] : List String)
          "./-main.ouro" "_build/native/-main.exe")
    , MkPair String Bool "native-cli-args/first-unknown-option"
        (native_cli_test_diagnostic (["build", "main.ouro", "--unknown", "--out"] : List String)
          "unknown-option" "unknown option: --unknown")
    , MkPair String Bool "native-cli-args/run-path-spaces-unicode"
        (native_cli_test_run (["run", "каталог/雪 file.ouro", "hello"] : List String)
          "каталог/雪 file.ouro" "_build/native/run/雪 file.exe" (["hello"] : List String))
    , MkPair String Bool "native-cli-args/run-host-separators"
        (native_cli_test_run (["run", "C:\\dir name\\main.ouro"] : List String)
          "C:\\dir name\\main.ouro" "_build/native/run/main.exe" (Nil String))
    , MkPair String Bool "native-cli-args/run-leading-dot-basename"
        (native_cli_test_run (["run", "src/.ouro"] : List String)
          "src/.ouro" "_build/native/run/.exe" (Nil String))
    , MkPair String Bool "native-cli-args/run-last-source-suffix"
        (native_cli_test_run (["run", "src/main.ouro.ouro"] : List String)
          "src/main.ouro.ouro" "_build/native/run/main.ouro.exe" (Nil String))
    , MkPair String Bool "native-cli-args/run-dashed-source-is-positional"
        (native_cli_test_run (["run", "-main.ouro"] : List String)
          "-main.ouro" "_build/native/run/-main.exe" (Nil String))
    , MkPair String Bool "native-cli-args/run-relative-dashed-source"
        (native_cli_test_run (["run", "./-main.ouro"] : List String)
          "./-main.ouro" "_build/native/run/-main.exe" (Nil String))
    , MkPair String Bool "native-cli-args/run-build-options-are-child-arguments"
        (native_cli_test_run (["run", "main.ouro", "--backend", "legacy-c", "--target", "linux",
          "--out", "other.exe", "--entry", "other", "--fuel", "0"] : List String)
          "main.ouro" "_build/native/run/main.exe"
          (["--backend", "legacy-c", "--target", "linux", "--out", "other.exe", "--entry", "other", "--fuel", "0"] : List String))
    , MkPair String Bool "native-cli-args/run-repeated-incomplete-options-are-literal"
        (native_cli_test_run (["run", "main.ouro", "--out", "one", "--out", ""] : List String)
          "main.ouro" "_build/native/run/main.exe" (["--out", "one", "--out", ""] : List String))
    , MkPair String Bool "native-cli-args/run-delimiter-is-literal"
        (native_cli_test_run (["run", "main.ouro", "--", "--help", ""] : List String)
          "main.ouro" "_build/native/run/main.exe" (["--", "--help", ""] : List String))
    , MkPair String Bool "native-cli-args/run-argument-bytes-and-order"
        (native_cli_test_run (["run", "main.ouro", "", "space name", "雪😀", "quote\"here", "trailing\\", "--out=literal"] : List String)
          "main.ouro" "_build/native/run/main.exe"
          (["", "space name", "雪😀", "quote\"here", "trailing\\", "--out=literal"] : List String))
    , MkPair String Bool "native-cli-args/run-second-source-is-child-argument"
        (native_cli_test_run (["run", "one.ouro", "two.ouro"] : List String)
          "one.ouro" "_build/native/run/one.exe" (["two.ouro"] : List String))
    , MkPair String Bool "native-cli-args/run-child-command-names"
        (native_cli_test_run (["run", "main.ouro", "doctor", "check", "build", "run"] : List String)
          "main.ouro" "_build/native/run/main.exe" (["doctor", "check", "build", "run"] : List String))
    , MkPair String Bool "native-cli-args/run-missing-source"
        (native_cli_test_diagnostic (["run"] : List String) "missing-source" "missing source file")
    , MkPair String Bool "native-cli-args/run-empty-source-precedes-tail"
        (native_cli_test_diagnostic (["run", "", "main.ouro"] : List String) "missing-source" "missing source file")
    , MkPair String Bool "native-cli-args/run-invalid-source-extension"
        (native_cli_test_diagnostic (["run", "main.txt"] : List String)
          "invalid-source" "expected an .ouro source file: main.txt")
    , MkPair String Bool "native-cli-args/run-options-cannot-precede-source"
        (native_cli_test_diagnostic (["run", "--out", "other.exe", "main.ouro"] : List String)
          "invalid-source" "expected an .ouro source file: --out")
    , MkPair String Bool "native-cli-args/run-no-leading-delimiter"
        (native_cli_test_diagnostic (["run", "--", "main.ouro"] : List String)
          "invalid-source" "expected an .ouro source file: --")
    , MkPair String Bool "native-cli-args/run-case-sensitive-source-suffix"
        (native_cli_test_error (["run", "main.OURO"] : List String) "invalid-source")
    , MkPair String Bool "native-cli-args/run-source-directory-is-not-suffix"
        (native_cli_test_error (["run", "main.ouro/"] : List String) "invalid-source")
    , MkPair String Bool "native-cli-args/run-source-trailing-space-is-literal"
        (native_cli_test_error (["run", "main.ouro "] : List String) "invalid-source")
    ];

-- @entry main
def main : IO Unit := precision_run "native-cli-args" native_cli_args_laws;
