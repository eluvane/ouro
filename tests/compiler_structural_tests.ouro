-- Behavior coverage for compiler helpers whose recursion follows source data.

import "../std/test.ouro",
  "../compiler/file_elab.ouro",
  "../compiler/file_elab_lookup.ouro",
  "../compiler/lower_uses.ouro",
  "../compiler/lower_env.ouro",
  "../compiler/lower_support.ouro",
  "../compiler/lower_implicit.ouro",
  "../compiler/lower_implicit_function.ouro",
  "../compiler/lower_named.ouro",
  "../compiler/lower_spread.ouro",
  "../compiler/pipeline_check.ouro",
  "../compiler/path.ouro",
  "canonical.ouro",
  "compiler_test_list_equal.ouro";

def structural_test_directives : Bool :=
    match canonical_directives_from_source
      (str_codes "a-- \t@one\r\n\"q\\\"--@hidden\"-- no\n--@two") with
    | Nil => False
    | Cons first rest =>
      match first with
      | MkSourceDirective start finish text =>
        andb (andb(eqNat start 1, eqNat finish 11))
          (andb (str_eq(str_of_codes text, "@one"))
            (match rest with
            | Nil => False
            | Cons last tail =>
              match last with
              | MkSourceDirective last_start last_finish last_text =>
                andb (andb(eqNat last_start 31, eqNat last_finish 37))
                  (andb (str_eq(str_of_codes last_text, "@two"))
                    (match tail with | Nil => True | Cons _ _ => False end))
              end
            end))
      end
    end;

def structural_test_no_directives (source : String) : Bool :=
    match canonical_directives_from_source (str_codes source) with
    | Nil => True
    | Cons _ _ => False
    end;

def structural_test_handler (binders : List Nat) : Expr :=
    EHandle (ENat 0)
      ([MkPair Nat (Pair(List Nat, Expr)) 20
        (MkPair(List Nat, Expr, binders, EVar 7))]
        : List (Pair(Nat, Pair(List Nat, Expr))));

def structural_test_multi_match : Expr :=
    EMultiMatch ([ENat 0] : List Expr)
      ([MkPair (List (Pair(Nat, List Nat))) Expr
        (Nil (Pair(Nat, List Nat))) (EVar 7)]
        : List (Pair(List (Pair(Nat, List Nat)), Expr)));

def structural_test_paths : List Test :=
    [ assert_eq "path uses importing directory"
        (str_of_codes (canon_path(str_codes "a/b/main.ouro", str_codes "unit.ouro")))
        "a/b/unit.ouro"
    , assert_eq "path folds separators and dot segments"
        (str_of_codes (canon_path(str_codes "a/b/main.ouro", str_codes "./c//../unit.ouro")))
        "a/b/unit.ouro"
    , assert_eq "path pops an existing stack"
        (str_of_codes (canon_path(str_codes "a/b/main.ouro", str_codes "../unit.ouro")))
        "a/unit.ouro"
    , assert_eq "UNC import keeps the network root"
        (str_of_codes (canon_path(str_codes "//server/share/main.ouro", str_codes "child.ouro")))
        "//server/share/child.ouro"
    , assert_eq "UNC parent import keeps the share boundary"
        (str_of_codes (canon_path(str_codes "//server/share/dir/main.ouro", str_codes "../child.ouro")))
        "//server/share/child.ouro"
    , assert_eq "path parent segments stop at empty stack"
        (str_of_codes (canon_path(str_codes "main.ouro", str_codes "../../unit.ouro")))
        "unit.ouro"
    ];

def structural_test_source : List Test :=
    [ assert_true "canonical source smoke behavior" canonical_smoke_all
    , assert_eq "decimal zero" (str_of_codes (cs_nat_codes 0)) "0"
    , assert_eq "decimal single digit" (str_of_codes (cs_nat_codes 9)) "9"
    , assert_eq "decimal ten" (str_of_codes (cs_nat_codes 10)) "10"
    , assert_eq "decimal carries across zero" (str_of_codes (cs_nat_codes 101)) "101"
    , assert_eq "decimal power of ten"
        (str_of_codes (cs_nat_codes (mul(10, mul 10 10)))) "1000"
    , assert_eq "reversed decimal helper" (str_of_codes (cs_nat_rev 120)) "021"
    , assert_true "directive spans skip escaped strings and ordinary comments"
        structural_test_directives
    , assert_true("empty source has no directives", structural_test_no_directives "")
    , assert_true("lone dash is ordinary source", structural_test_no_directives "-")
    , assert_true "unterminated string hides comment spelling"
        (structural_test_no_directives "\"--@hidden")
    ];

def structural_test_uses : List Test :=
    [ assert_true "variable-use exhaustion stays conservative"
        (expr_uses_var 0 7 (ENat 0))
    , assert_true "variable-use finds nested application"
        (expr_uses_var 10 7 (EApp(EVar 8, EVar 7)))
    , assert_true "lambda binder shadows its body"
        (notb (expr_uses_var 10 7 (ELam(7, Nothing Expr, EVar 7))))
    , assert_true "lambda binder does not shadow its annotation"
        (expr_uses_var 10 7 (ELam(7, Just(Expr, EVar 7), ENat 0)))
    , assert_true "variable-use visits operation argument list"
        (expr_uses_var 10 7 (EPerform(20, [ENat 0, EVar 7] : List Expr)))
    , assert_true "handler binders shadow the clause body"
        (notb (expr_uses_var 10 7 (structural_test_handler ([7] : List Nat))))
    , assert_true "handler finds an unbound clause variable"
        (expr_uses_var 10 7 (structural_test_handler ([8] : List Nat)))
    , assert_true "variable-use visits multi-match rows"
        (expr_uses_var 10 7 structural_test_multi_match)
    ];

def structural_test_hint_shadowed_let : Bool :=
    match surface_type_hint empty_env
        ([MkPair Nat Surface 7 (SSort 0)] : List (Pair Nat Surface)) 8
        (SLet 7 (SSort 0) (SSort 1) (SVar 7)) with
    | Nothing => False
    | Just hint => match hint with
        | SSort level => eqNat level 1
        | SVar _ => False
        | SPi _ _ _ => False
        | SLam _ _ _ => False
        | SApp _ _ => False
        | SLet _ _ _ _ => False
        | SConst _ => False
        | SInd _ => False
        | SConstruct _ _ _ => False
        | SCase _ _ _ _ => False
        | SFix _ _ _ _ _ => False
        | SHole _ => False
        | SEffectRow _ => False
        | SPerform _ _ => False
        | SStr _ _ => False
        end
    end;

def structural_test_lower_hints : List Test :=
    [ assert_true "Pi-bound type variable remains a usable hint"
        (notb (surface_hint_has_placeholder
          ([] : List (Pair Nat Surface)) 8 (SPi 7 (SSort 0) (SVar 7))))
    , assert_true "free local type variable remains a usable hint"
        (notb (surface_hint_has_placeholder
          ([MkPair Nat Surface 7 (SSort 0)] : List (Pair Nat Surface)) 8 (SVar 7)))
    , assert_true "escaped type variable cannot supply a hint"
        (surface_hint_has_placeholder
          ([] : List (Pair Nat Surface)) 8 (SVar 7))
    , assert_true "shadowed free type variable cannot supply a hint"
        (surface_hint_has_placeholder
          ([MkPair Nat Surface 7 (SSort 0), MkPair Nat Surface 7 (SSort 1)]
            : List (Pair Nat Surface)) 8 (SVar 7))
    , assert_true "zero inductive sentinel cannot supply a hint"
        (surface_hint_has_placeholder
          ([] : List (Pair Nat Surface)) 8 (SInd 0))
    , assert_true "source hole cannot supply a hint"
        (surface_hint_has_placeholder
          ([] : List (Pair Nat Surface)) 8 (SHole 9))
    , assert_true "exhausted hint traversal rejects a complete type"
        (surface_hint_has_placeholder
          ([] : List (Pair Nat Surface)) 0 (SSort 0))
    , assert_true "shadowed let retains its existing substituted hint"
        structural_test_hint_shadowed_let
    , assert_true "expected Pi domain can type an unannotated lambda local"
        (match lambda_domain_hint ([] : List (Pair Nat Surface))
            (Just(Surface, SPi 7 (SInd 9) (SInd 10))) with
         | Nothing => False
         | Just _ => True
         end)
    , assert_true "expected Pi domain may depend on an outer local"
        (match lambda_domain_hint
            ([MkPair Nat Surface 7 (SSort 0)] : List (Pair Nat Surface))
            (Just(Surface, SPi 8 (SVar 7) (SVar 7))) with
         | Nothing => False
         | Just _ => True
         end)
    , assert_true "unknown expected Pi domain cannot become a local hint"
        (match lambda_domain_hint ([] : List (Pair Nat Surface))
            (Just(Surface, SPi 8 (SVar 99) (SSort 0))) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "shadowed expected Pi domain cannot become a local hint"
        (match lambda_domain_hint
            ([MkPair Nat Surface 7 (SSort 0), MkPair Nat Surface 7 (SSort 0)]
              : List (Pair Nat Surface))
            (Just(Surface, SPi 8 (SVar 7) (SSort 0))) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "dummy expected Pi domain cannot become a local hint"
        (match lambda_domain_hint ([] : List (Pair Nat Surface))
            (Just(Surface, SPi 0 (SInd 0) (SInd 10))) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "hole expected Pi domain cannot become a local hint"
        (match lambda_domain_hint ([] : List (Pair Nat Surface))
            (Just(Surface, SPi 8 (SHole 4) (SSort 0))) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "dependent Pi codomain follows a renamed lambda binder"
        (match lambda_body_expected
            (Just(Surface, SPi 7 (SSort 0)
              (SPi 8 (SVar 7) (SVar 7)))) 9 with
         | Nothing => False
         | Just codomain =>
             andb(surface_mentions_name 8 9 codomain,
               notb(surface_mentions_name 8 7 codomain))
         end)
    , assert_true "same-spelling Pi binder retains lexical shadowing"
        (match lambda_body_expected
            (Just(Surface, SPi 7 (SSort 0) (SApp (SInd 10) (SVar 7)))) 7 with
         | Nothing => False
         | Just codomain => surface_mentions_name 8 7 codomain
         end)
    , assert_true "nested shadow of old Pi binder is not renamed"
        (match lambda_body_expected
            (Just(Surface, SPi 7 (SSort 0) (SPi 7 (SSort 0) (SVar 7)))) 9 with
         | Nothing => False
         | Just codomain =>
             andb(surface_mentions_name 8 7 codomain,
               notb(surface_mentions_name 8 9 codomain))
         end)
    , assert_true "unused Pi binder leaves nested lambda name untouched"
        (match lambda_body_expected
            (Just(Surface, SPi 7 (SSort 0) (SPi 9 (SSort 0) (SVar 9)))) 9 with
         | Nothing => False
         | Just _ => True
         end)
    , assert_true "renaming a Pi binder cannot capture an inner binder"
        (match lambda_body_expected
            (Just(Surface, SPi 7 (SSort 0) (SPi 9 (SVar 7) (SVar 9)))) 9 with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "exhausted codomain scan declines a dependent hint"
        (surface_mentions_name 0 7 (SSort 0))
    ];

def structural_implicit_ctor : CtorInfo :=
    MkCtorInfo 11 10 0 1 1 1;

def structural_implicit_env : LowerEnv :=
    MkLowerEnv (Nil Nat) ([10] : List Nat)
      ([structural_implicit_ctor] : List CtorInfo) empty_special_ids
      (Nil (Pair Nat Surface)) (Nil (Pair Nat Surface))
      (Nil DefInfo);

def structural_implicit_first_ind (candidate : Maybe (List Surface))
    (wanted : Nat) : Bool :=
    match candidate with
    | Nothing => False
    | Just args =>
        match args with
        | Nil => False
        | Cons first rest =>
            match first with
            | SInd name => andb(eqNat name wanted, nullb Surface rest)
            | SVar _ => False
            | SSort _ => False
            | SPi _ _ _ => False
            | SLam _ _ _ => False
            | SApp _ _ => False
            | SLet _ _ _ _ => False
            | SConst _ => False
            | SConstruct _ _ _ => False
            | SCase _ _ _ _ => False
            | SFix _ _ _ _ _ => False
            | SHole _ => False
            | SEffectRow _ => False
            | SPerform _ _ => False
            | SStr _ _ => False
            end
        end
    end;

def structural_implicit_first_var (candidate : Maybe (List Surface))
    (wanted : Nat) : Bool :=
    match candidate with
    | Nothing => False
    | Just args =>
        match args with
        | Nil => False
        | Cons first rest =>
            match first with
            | SVar name => andb(eqNat name wanted, nullb Surface rest)
            | SSort _ => False
            | SPi _ _ _ => False
            | SLam _ _ _ => False
            | SApp _ _ => False
            | SLet _ _ _ _ => False
            | SConst _ => False
            | SInd _ => False
            | SConstruct _ _ _ => False
            | SCase _ _ _ _ => False
            | SFix _ _ _ _ _ => False
            | SHole _ => False
            | SEffectRow _ => False
            | SPerform _ _ => False
            | SStr _ _ => False
            end
        end
    end;

def structural_implicit_field_signature : Surface :=
    SPi 8 (SVar 7) (SApp (SInd 10) (SVar 7));

def structural_implicit_repeated_ctor : CtorInfo :=
    MkCtorInfo 13 12 0 1 2 1;

def structural_implicit_repeated_fields : Surface :=
    SPi 8 (SVar 7)
      (SPi 9 (SVar 7) (SApp (SInd 12) (SVar 7)));

def structural_implicit_duo_ctor : CtorInfo :=
    MkCtorInfo 14 12 0 2 2 2;

def structural_implicit_duo_fields : Surface :=
    SPi 8 (SVar 7)
      (SPi 10 (SVar 9)
        (SApp (SApp (SInd 12) (SVar 7)) (SVar 9)));

def structural_implicit_later_ctor : CtorInfo :=
    MkCtorInfo 15 10 0 1 2 1;

def structural_implicit_later_fields : Surface :=
    SPi 8 (SInd 20)
      (SPi 9 (SVar 7) (SApp (SInd 10) (SVar 7)));

def structural_implicit_value_env : LowerEnv :=
    MkLowerEnv (Nil Nat) ([9, 20, 21, 22] : List Nat)
      (Nil CtorInfo) empty_special_ids
      (Nil (Pair Nat Surface))
      ([MkPair Nat Surface 9 (SSort 0),
        MkPair Nat Surface 20 (SSort 0),
        MkPair Nat Surface 21 (SSort 0),
        MkPair Nat Surface 22 (SPi 30 (SSort 0) (SSort 0))]
        : List (Pair Nat Surface)) (Nil DefInfo);

def structural_implicit_value_prefix
    (locals : List (Pair Nat Surface)) (ctor : CtorInfo)
    (names : List Nat) (fields : Surface)
    (hints : List (Maybe Surface)) : Maybe (List Surface) :=
    match implicit_collect_field_hints structural_implicit_value_env
        locals ctor names fields hints with
    | Nothing => Nothing (List Surface)
    | Just known => implicit_prefix_from_known names known
    end;

def structural_test_implicit : List Test :=
    [ assert_true "one marked Type parameter passes metadata validation"
        (checked_implicit_prefix 1 ([MkParam 7 (CSort 0)] : List Param))
    , assert_true "marked metadata exceeding the parameter count is rejected"
        (notb (checked_implicit_prefix 2 ([MkParam 7 (CSort 0)] : List Param)))
    , assert_true "marked Type1 parameter is rejected"
        (notb (checked_implicit_prefix 1 ([MkParam 7 (CSort 1)] : List Param)))
    , assert_true "marked non-sort parameter is rejected"
        (notb (checked_implicit_prefix 1 ([MkParam 7 (CInd 10)] : List Param)))
    , assert_true "direct expected family supplies the marked prefix"
        (structural_implicit_first_ind
          (implicit_expected_prefix ([] : List (Pair Nat Surface))
            (Just(Surface, SApp (SInd 10) (SInd 9)))
            structural_implicit_ctor) 9)
    , assert_true "bound local expected parameter remains in scope"
        (structural_implicit_first_var
          (implicit_expected_prefix
            ([MkPair Nat Surface 7 (SSort 0)] : List (Pair Nat Surface))
            (Just(Surface, SApp (SInd 10) (SVar 7)))
            structural_implicit_ctor) 7)
    , assert_true "escaped expected parameter cannot supply the prefix"
        (match implicit_expected_prefix ([] : List (Pair Nat Surface))
            (Just(Surface, SApp (SInd 10) (SVar 7)))
            structural_implicit_ctor with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "shadowed expected parameter cannot supply the prefix"
        (match implicit_expected_prefix
            ([MkPair Nat Surface 7 (SSort 0), MkPair Nat Surface 7 (SSort 0)]
              : List (Pair Nat Surface))
            (Just(Surface, SApp (SInd 10) (SVar 7)))
            structural_implicit_ctor with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "expected hole cannot supply the prefix"
        (match implicit_expected_prefix ([] : List (Pair Nat Surface))
            (Just(Surface, SApp (SInd 10) (SHole 7)))
            structural_implicit_ctor with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "wrong family cannot supply the prefix"
        (match implicit_expected_prefix ([] : List (Pair Nat Surface))
            (Just(Surface, SApp (SInd 20) (SInd 9)))
            structural_implicit_ctor with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "unsaturated expected family cannot supply the prefix"
        (match implicit_expected_prefix ([] : List (Pair Nat Surface))
            (Just(Surface, SInd 10)) structural_implicit_ctor with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "marked Pi binders retain declaration order"
        (match implicit_marked_binders 2
            (SPi 7 (SSort 0) (SPi 9 (SSort 0)
              structural_implicit_duo_fields)) with
         | Nothing => False
         | Just split =>
             match split with
             | MkPair names fields =>
                 andb(implicit_nat_keys_equal names [7, 9],
                   implicit_result_matches
                     structural_implicit_duo_ctor names
                     (SApp (SApp (SInd 12) (SVar 7)) (SVar 9)))
             end
         end)
    , assert_true "direct value field supplies a marked parameter"
        (structural_implicit_first_ind
          (structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            structural_implicit_field_signature
            ([Just(Surface, SInd 9)] : List (Maybe Surface))) 9)
    , assert_true "two direct value fields supply parameters in declaration order"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_duo_ctor [7, 9]
            structural_implicit_duo_fields
            ([Just(Surface, SInd 20), Just(Surface, SInd 21)]
              : List (Maybe Surface)) with
         | Nothing => False
         | Just prefix =>
             implicit_hints_agree
               (implicit_apply_surfaces (SInd 12) prefix)
               (SApp (SApp (SInd 12) (SInd 20)) (SInd 21))
         end)
    , assert_true "repeated direct fields accept agreeing hints"
        (structural_implicit_first_ind
          (structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_repeated_ctor [7]
            structural_implicit_repeated_fields
            ([Just(Surface, SInd 9), Just(Surface, SInd 9)]
              : List (Maybe Surface))) 9)
    , assert_true "later direct field can infer after a known first value"
        (structural_implicit_first_ind
          (structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_later_ctor [7]
            structural_implicit_later_fields
            ([Just(Surface, SInd 20), Just(Surface, SInd 9)]
              : List (Maybe Surface))) 9)
    , assert_true "repeated direct fields reject conflicting hints"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_repeated_ctor [7]
            structural_implicit_repeated_fields
            ([Just(Surface, SInd 9), Just(Surface, SInd 20)]
              : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "unknown direct value hint cannot complete a parameter"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            structural_implicit_field_signature
            ([Nothing Surface] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "unknown first value cannot borrow a later field hint"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_repeated_ctor [7]
            structural_implicit_repeated_fields
            ([Nothing Surface, Just(Surface, SInd 9)]
              : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "unknown inductive value type cannot supply a parameter"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            structural_implicit_field_signature
            ([Just(Surface, SInd 39)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "escaped value type variable cannot supply a parameter"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            structural_implicit_field_signature
            ([Just(Surface, SVar 99)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "bound value type variable supplies a parameter"
        (structural_implicit_first_var
          (structural_implicit_value_prefix
            ([MkPair Nat Surface 99 (SSort 0)] : List (Pair Nat Surface))
            structural_implicit_ctor [7] structural_implicit_field_signature
            ([Just(Surface, SVar 99)] : List (Maybe Surface))) 99)
    , assert_true "bound term variable cannot masquerade as a Type0 hint"
        (match structural_implicit_value_prefix
            ([MkPair Nat Surface 99 (SInd 9)] : List (Pair Nat Surface))
            structural_implicit_ctor [7] structural_implicit_field_signature
            ([Just(Surface, SVar 99)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "Type1 variable cannot supply a Type0 parameter"
        (match structural_implicit_value_prefix
            ([MkPair Nat Surface 99 (SSort 1)] : List (Pair Nat Surface))
            structural_implicit_ctor [7] structural_implicit_field_signature
            ([Just(Surface, SVar 99)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "known inductive application is a Type0 value hint"
        (implicit_type0_hint structural_implicit_value_env
          ([] : List (Pair Nat Surface)) 8
          (SApp (SInd 22) (SInd 9)))
    , assert_true "known function type is a Type0 value hint"
        (implicit_type0_hint structural_implicit_value_env
          ([] : List (Pair Nat Surface)) 8
          (SPi 31 (SInd 9) (SInd 9)))
    , assert_true "shadowed value type variable cannot supply a parameter"
        (match structural_implicit_value_prefix
            ([MkPair Nat Surface 99 (SSort 0),
              MkPair Nat Surface 99 (SSort 0)] : List (Pair Nat Surface))
            structural_implicit_ctor [7] structural_implicit_field_signature
            ([Just(Surface, SVar 99)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "hole value type cannot supply a parameter"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            structural_implicit_field_signature
            ([Just(Surface, SHole 99)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "first universe argument stays an explicit partial call"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            structural_implicit_field_signature
            ([Just(Surface, SSort 0)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "nested field domain does not guess a marked parameter"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            (SPi 8 (SApp (SInd 21) (SVar 7))
              (SApp (SInd 10) (SVar 7)))
            ([Just(Surface, SApp (SInd 21) (SInd 9))]
              : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "constructor result must directly retain its marked parameter"
        (match structural_implicit_value_prefix
            ([] : List (Pair Nat Surface)) structural_implicit_ctor [7]
            (SPi 8 (SVar 7) (SApp (SInd 10) (SInd 9)))
            ([Just(Surface, SInd 9)] : List (Maybe Surface)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "duplicate marked binder names decline value inference"
        (match implicit_marked_binders 2
            (SPi 7 (SSort 0) (SPi 7 (SSort 0) (SInd 10))) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "exhausted hint shape scan declines value inference"
        (match implicit_hint_key 0 (SInd 9) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "actual constructor head resolves for marked lookup"
        (match implicit_ctor_head 8 structural_implicit_env (Nothing Nat)
            ([] : List (Pair Nat Surface)) (EVar 11) with
         | Nothing => False
         | Just _ => True
         end)
    , assert_true "local binder shadows the marked constructor"
        (match implicit_ctor_head 8 structural_implicit_env (Nothing Nat)
            ([MkPair Nat Surface 11 (SSort 0)] : List (Pair Nat Surface))
            (EVar 11) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "fix-self binder shadows the marked constructor"
        (match implicit_ctor_head 8 structural_implicit_env (Just(Nat, 11))
            ([] : List (Pair Nat Surface)) (EVar 11) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "exhausted constructor spine scan supplies no head"
        (match implicit_app_head 0 (EVar 11) with
         | Nothing => True
         | Just _ => False
         end)
    ];

def structural_implicit_def_fields : Surface :=
    SPi 10 (SPi 0 (SVar 7) (SVar 8))
      (SPi 11 (SApp (SInd 22) (SVar 7))
        (SApp (SInd 22) (SVar 8)));

def structural_implicit_def_env : LowerEnv :=
    MkLowerEnv ([30] : List Nat) ([9, 20, 21, 22] : List Nat)
      (Nil CtorInfo) empty_special_ids
      (Nil (Pair Nat Surface))
      ([MkPair Nat Surface 9 (SSort 0),
        MkPair Nat Surface 20 (SSort 0),
        MkPair Nat Surface 21 (SSort 0),
        MkPair Nat Surface 22 (SPi 40 (SSort 0) (SSort 0)),
        MkPair Nat Surface 30
          (SPi 7 (SSort 0) (SPi 8 (SSort 0) structural_implicit_def_fields))]
        : List (Pair Nat Surface))
      ([DefInfoOf 30 2
          [DefParamOf 7 7 (Nothing Expr),
           DefParamOf 8 8 (Nothing Expr),
           DefParamOf 10 10 (Nothing Expr),
           DefParamOf 11 11 (Nothing Expr)]] : List DefInfo);

def structural_test_implicit_defs : List Test :=
    [ assert_true "marked def metadata counts declared binders, not return Pi"
        (checked_def_prefix 1 2
          (CPi (CSort 0) (CPi (CInd 9) (CPi (CInd 9) (CInd 9)))))
    , assert_true "marked def count cannot exceed declared binder count"
        (notb (checked_def_prefix 2 1 (CPi (CSort 0) (CInd 9))))
    , assert_true "marked def requires each declared Pi"
        (notb (checked_def_prefix 1 2 (CPi (CSort 0) (CInd 9))))
    , assert_true "marked def requires Type0 domains"
        (notb (checked_def_prefix 1 1 (CPi (CSort 1) (CInd 9))))
    , assert_true "nondependent callback Pi matches across binder spellings"
        (match implicit_match_def_type 16 structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7, 8]
            ([] : List (Pair Nat Surface))
            (SPi 0 (SVar 7) (SVar 8))
            (SPi 99 (SInd 9) (SInd 20)) with
         | Nothing => False
         | Just known =>
             andb(implicit_hints_agree
                 (match lookup_local 7 known with
                  | Nothing => SHole 0
                  | Just value => value
                  end) (SInd 9),
               implicit_hints_agree
                 (match lookup_local 8 known with
                  | Nothing => SHole 0
                  | Just value => value
                  end) (SInd 20))
         end)
    , assert_true "nested anonymous callback and return Pi remain nondependent"
        (match implicit_match_def_type 16 structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7, 8]
            ([] : List (Pair Nat Surface))
            (SPi 0 (SPi 0 (SVar 7) (SVar 8))
              (SPi 0 (SVar 8) (SVar 7)))
            (SPi 99 (SPi 88 (SInd 9) (SInd 20))
              (SPi 77 (SInd 20) (SInd 9))) with
         | Nothing => False
         | Just known =>
             andb(implicit_hints_agree
                 (match lookup_local 7 known with
                  | Nothing => SHole 0
                  | Just value => value
                  end) (SInd 9),
               implicit_hints_agree
                 (match lookup_local 8 known with
                  | Nothing => SHole 0
                  | Just value => value
                  end) (SInd 20))
         end)
    , assert_true "exhausted marked def type matcher provides no constraint"
        (match implicit_match_def_type 0 structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7]
            ([] : List (Pair Nat Surface)) (SVar 7) (SInd 9) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "map callback and List argument determine both parameters"
        (match implicit_collect_def_hints structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7, 8]
            structural_implicit_def_fields
            ([Just(Surface, SPi 99 (SInd 9) (SInd 20)),
              Just(Surface, SApp (SInd 22) (SInd 9))]
              : List (Maybe Surface))
            (Just(Surface, SApp (SInd 22) (SInd 20))) with
         | Nothing => False
         | Just known =>
             match implicit_prefix_from_known [7, 8] known with
             | Nothing => False
             | Just prefix =>
                 implicit_hints_agree
                   (implicit_apply_surfaces (SInd 22) prefix)
                   (SApp (SApp (SInd 22) (SInd 9)) (SInd 20))
             end
         end)
    , assert_true "expected result conflicts with callback codomain"
        (match implicit_collect_def_hints structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7, 8]
            structural_implicit_def_fields
            ([Just(Surface, SPi 99 (SInd 9) (SInd 20)),
              Just(Surface, SApp (SInd 22) (SInd 9))]
              : List (Maybe Surface))
            (Just(Surface, SApp (SInd 22) (SInd 21))) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "unknown first callback cannot borrow a later List hint"
        (match implicit_collect_def_hints structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7, 8]
            structural_implicit_def_fields
            ([Nothing Surface, Just(Surface, SApp (SInd 22) (SInd 9))]
              : List (Maybe Surface)) (Nothing Surface) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "first callback with a non-Type0 local hint cannot infer"
        (match implicit_collect_def_hints structural_implicit_def_env
            ([MkPair Nat Surface 99 (SInd 9)] : List (Pair Nat Surface))
            [7, 8] structural_implicit_def_fields
            ([Just(Surface, SVar 99),
              Just(Surface, SApp (SInd 22) (SInd 9))]
              : List (Maybe Surface)) (Nothing Surface) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "explicit type argument stays an explicit partial def call"
        (match implicit_collect_def_hints structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7]
            (SPi 10 (SVar 7) (SVar 7))
            ([Just(Surface, SSort 0)] : List (Maybe Surface))
            (Just(Surface, SPi 0 (SInd 9) (SInd 9))) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "dependent callback Pi requests an annotation"
        (match implicit_match_def_type 16 structural_implicit_def_env
            ([] : List (Pair Nat Surface)) [7]
            ([] : List (Pair Nat Surface))
            (SPi 10 (SVar 7) (SVar 10))
            (SPi 99 (SInd 9) (SInd 9)) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "marked def head requires a global constant"
        (match implicit_def_head 8 structural_implicit_def_env (Nothing Nat)
            ([] : List (Pair Nat Surface)) (EVar 30) with
         | Nothing => False
         | Just _ => True
         end)
    , assert_true "local binder shadows marked def metadata"
        (match implicit_def_head 8 structural_implicit_def_env (Nothing Nat)
            ([MkPair Nat Surface 30 (SInd 9)] : List (Pair Nat Surface))
            (EVar 30) with
         | Nothing => True
         | Just _ => False
         end)
    , assert_true "fix-self name shadows marked def metadata"
        (match implicit_def_head 8 structural_implicit_def_env (Just(Nat, 30))
            ([] : List (Pair Nat Surface)) (EVar 30) with
         | Nothing => True
         | Just _ => False
         end)
    ];

def structural_named_env : LowerEnv :=
    MkLowerEnv ([30] : List Nat) ([9] : List Nat)
      (Nil CtorInfo) empty_special_ids
      (Nil (Pair Nat Surface))
      ([MkPair Nat Surface 30
        (SPi 11 (SInd 9) (SPi 12 (SInd 9) (SInd 9)))]
        : List (Pair Nat Surface))
      ([DefInfoOf 30 0
        [DefParamOf 2 11 (Nothing Expr),
          DefParamOf 3 12 (Nothing Expr)]] : List DefInfo);

def structural_named_ind_is (term : Surface) (wanted : Nat) : Bool :=
    match term with
    | SInd name => eqNat name wanted
    | SVar _ => False
    | SSort _ => False
    | SPi _ _ _ => False
    | SLam _ _ _ => False
    | SApp _ _ => False
    | SLet _ _ _ _ => False
    | SConst _ => False
    | SConstruct _ _ _ => False
    | SCase _ _ _ _ => False
    | SFix _ _ _ _ _ => False
    | SHole _ => False
    | SEffectRow _ => False
    | SPerform _ _ => False
    | SStr _ _ => False
    end;

def structural_named_const_is (term : Surface) (wanted : Nat) : Bool :=
    match term with
    | SConst name => eqNat name wanted
    | SVar _ => False
    | SSort _ => False
    | SPi _ _ _ => False
    | SLam _ _ _ => False
    | SApp _ _ => False
    | SLet _ _ _ _ => False
    | SInd _ => False
    | SConstruct _ _ _ => False
    | SCase _ _ _ _ => False
    | SFix _ _ _ _ _ => False
    | SHole _ => False
    | SEffectRow _ => False
    | SPerform _ _ => False
    | SStr _ _ => False
    end;

def structural_named_var_is (term : Surface) (wanted : Nat) : Bool :=
    match implicit_field_direct_name term with
    | Nothing => False
    | Just name => eqNat name wanted
    end;

def structural_named_applied_is (term : Surface) (first : Nat)
    (second : Nat) : Bool :=
    match implicit_app_view term with
    | Nothing => False
    | Just outer => match outer with
      | MkPair left final_arg =>
          match implicit_app_view left with
          | Nothing => False
          | Just inner => match inner with
            | MkPair callee first_arg =>
                andb(structural_named_const_is callee 30,
                  andb(structural_named_var_is first_arg second,
                    structural_named_var_is final_arg first))
            end
          end
      end
    end;

def structural_named_order_and_freshness : Bool :=
    match lower_expr_env structural_named_env
        (ENamedCall (EVar 30)
          [MkPair Nat Expr 3 (EVar 40),
            MkPair Nat Expr 2 (EVar 41)]) with
    | SLet first first_value first_domain body =>
        match body with
        | SLet second second_value second_domain applied =>
            andb(structural_named_var_is first_value 40,
              andb(structural_named_var_is second_value 41,
                andb(structural_named_ind_is first_domain 9,
                  andb(structural_named_ind_is second_domain 9,
                    andb(ltb_nat 41 first,
                      andb(eqNat second (S first),
                        structural_named_applied_is applied first second))))))
        | SVar _ => False
        | SSort _ => False
        | SPi _ _ _ => False
        | SLam _ _ _ => False
        | SApp _ _ => False
        | SConst _ => False
        | SInd _ => False
        | SConstruct _ _ _ => False
        | SCase _ _ _ _ => False
        | SFix _ _ _ _ _ => False
        | SHole _ => False
        | SEffectRow _ => False
        | SPerform _ _ => False
        | SStr _ _ => False
        end
    | SVar _ => False
    | SSort _ => False
    | SPi _ _ _ => False
    | SLam _ _ _ => False
    | SApp _ _ => False
    | SConst _ => False
    | SInd _ => False
    | SConstruct _ _ _ => False
    | SCase _ _ _ _ => False
    | SFix _ _ _ _ _ => False
    | SHole _ => False
    | SEffectRow _ => False
    | SPerform _ _ => False
    | SStr _ _ => False
    end;

def structural_named_rejected (rows : List (Pair Nat Expr)) : Bool :=
    match lower_expr_env structural_named_env (ENamedCall (EVar 30) rows) with
    | SHole _ => True
    | SVar _ => False
    | SSort _ => False
    | SPi _ _ _ => False
    | SLam _ _ _ => False
    | SApp _ _ => False
    | SLet _ _ _ _ => False
    | SConst _ => False
    | SInd _ => False
    | SConstruct _ _ _ => False
    | SCase _ _ _ _ => False
    | SFix _ _ _ _ _ => False
    | SEffectRow _ => False
    | SPerform _ _ => False
    | SStr _ _ => False
    end;

def structural_test_named_calls : List Test :=
    [ assert_true "named args use source-order lets and freshen after every RHS"
        structural_named_order_and_freshness
    , assert_true "spread freshness visits a nested named argument value"
        (match spread_max_expr 8
            (EListSpread
              ([ENamedCall (EVar 30)
                [MkPair Nat Expr 3 (EVar 99)]] : List Expr)
              (EVar 40)) with
         | Nothing => False
         | Just name => eqNat name 99
         end)
    , assert_true "direct AST positional argument after a label is rejected"
        (structural_named_rejected
          [MkPair Nat Expr 2 (EVar 40), MkPair Nat Expr 0 (EVar 41)])
    , assert_true "duplicate named label is rejected"
        (structural_named_rejected
          [MkPair Nat Expr 2 (EVar 40), MkPair Nat Expr 2 (EVar 41)])
    , assert_true "unknown named label is rejected"
        (structural_named_rejected
          [MkPair Nat Expr 2 (EVar 40), MkPair Nat Expr 99 (EVar 41)])
    , assert_true "missing named argument is rejected"
        (structural_named_rejected [MkPair Nat Expr 2 (EVar 40)])
    , assert_true "malformed default metadata is rejected at checker boundary"
        (notb(checked_def_metadata
          [DefParamOf 2 11 (Just Expr (ENat 0))]
          (EPi 11 (EVar 9) (EVar 9))
          (ELam 11 (Just Expr (EVar 9)) (EVar 11))))
    , assert_true "ordinary duplicate binder labels remain accepted"
        (checked_def_metadata
          [DefParamOf 11 11 (Nothing Expr),
            DefParamOf 11 11 (Nothing Expr)]
          (EPi 11 (EVar 9) (EPi 11 (EVar 9) (EVar 9)))
          (ELam 11 (Just Expr (EVar 9))
            (ELam 11 (Just Expr (EVar 9)) (EVar 11))))
    , assert_true "anonymous positional binder metadata remains accepted"
        (checked_def_metadata
          [DefParamOf 0 0 (Nothing Expr)]
          (EPi 0 (EVar 9) (EVar 9))
          (ELam 0 (Just Expr (EVar 9)) (EVar 9)))
    , assert_true "result Pi is outside the declared parameter count"
        (checked_def_prefix 0 1
          (CPi (CInd 9) (CPi (CInd 9) (CInd 9))))
    ];

def structural_test_maybe_equal (A : Type) (same : A -> A -> Bool)
    (left : Maybe A) (right : Maybe A) : Bool :=
    match left, right with
    | Nothing, Nothing => True
    | Nothing, Just _ => False
    | Just _, Nothing => False
    | Just first, Just other => same first other
    end;

def structural_test_param_equal (left : Param) (right : Param) : Bool :=
    match left, right with
    | MkParam name typ, MkParam other other_type =>
        andb(eqNat name other, eqTerm 100 typ other_type)
    end;

def structural_test_ctor_equal (left : Ctor) (right : Ctor) : Bool :=
    match left, right with
    | MkCtor name typ, MkCtor other other_type =>
        andb(eqNat name other, eqTerm 100 typ other_type)
    end;

def structural_test_ind_equal (left : IndDecl) (right : IndDecl) : Bool :=
    match left, right with
    | MkIndDecl name params indices sort ctors,
      MkIndDecl other other_params other_indices other_sort other_ctors =>
        andb (eqNat name other)
          (andb (eqNat sort other_sort)
            (andb (compiler_test_list_equal Param structural_test_param_equal params other_params)
              (andb (compiler_test_list_equal CoreTerm (eqTerm 100) indices other_indices)
                (compiler_test_list_equal Ctor structural_test_ctor_equal ctors other_ctors))))
    end;

def structural_test_family : IndDecl :=
    MkIndDecl 10 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor(11, CInd 10), MkCtor(12, CPi(CInd 10, CInd 10))] : List Ctor);

-- Deliberately conflicting metadata exercises lookup on malformed signatures.
-- The first descriptor must win without combining fields from the older one.
def structural_test_other_family : IndDecl :=
    MkIndDecl 10 ([MkParam(50, CSort 0)] : List Param)
      ([CSort 0] : List CoreTerm) 1 ([MkCtor(51, CRel 0)] : List Ctor);

def structural_test_native (name : Nat) : Entry :=
    MkBoundEntry name (CSort 0)
      (PrimitiveIntrinsicBinding PrimitiveU32Type PrimitiveTypeOnly PrimitiveNoGc (Nothing CoreTerm));

def structural_test_role : Entry :=
    MkRoleEntry (PrimitiveRoleOf(PrimitiveNatRole, primitive_inductive_shape structural_test_family));

def structural_test_lookup_entries : List Entry :=
    [ MkEntry(20, CSort 0, Just(CoreTerm, CInd 10))
    , MkEntry(21, CConst 20, Nothing CoreTerm)
    , structural_test_native 30
    , structural_test_role
    , MkIndEntry 10 structural_test_family
    ];

def structural_test_lookup_equivalent (name : Nat) (entries : List Entry) : Bool :=
    let view : List Entry := declaration_lookup_environment entries in
    andb (structural_test_maybe_equal CoreTerm (eqTerm 100)
      (lookup_const name entries) (lookup_const name view))
      (andb (structural_test_maybe_equal CoreTerm (eqTerm 100)
        (lookup_type name entries) (lookup_type name view))
        (structural_test_maybe_equal IndDecl structural_test_ind_equal
          (lookup_ind name entries) (lookup_ind name view)));

def structural_test_entry_name (entry : Entry) : Nat :=
    match entry with
    | MkEntry name _ _ => name
    | MkIndEntry name _ => name
    | MkBoundEntry name _ _ => name
    | MkRoleEntry _ => 0
    end;

def structural_test_definition_order (mode : CheckMode) : Bool :=
    match check_declaration mode 200 structural_test_lookup_entries
      (FDef(40, CConst 20, CConstruct 10 0 0)) with
    | DeclarationsErr _ _ _ => False
    | DeclarationsOk entries =>
        andb (eqList(map Entry Nat structural_test_entry_name entries, [40, 20, 21, 30, 0, 10]))
          (andb (structural_test_maybe_equal CoreTerm (eqTerm 100)
            (lookup_type 40 entries) (Just(CoreTerm, CConst 20)))
            (structural_test_maybe_equal CoreTerm (eqTerm 100)
              (lookup_const 40 entries) (Just(CoreTerm, CConstruct 10 0 0))))
    end;

def structural_test_lookup : List Test :=
    [ assert_true "lookup view preserves transparent bodies and types"
        (structural_test_lookup_equivalent 20 structural_test_lookup_entries)
    , assert_true "lookup view preserves opaque assumptions"
        (structural_test_lookup_equivalent 21 structural_test_lookup_entries)
    , assert_true "lookup view preserves inductive metadata"
        (structural_test_lookup_equivalent 10 structural_test_lookup_entries)
    , assert_true "lookup view preserves unknown-name failure"
        (structural_test_lookup_equivalent 99 structural_test_lookup_entries)
    , assert_true "lookup view keeps native bindings opaque"
        (structural_test_lookup_equivalent 30 structural_test_lookup_entries)
    , assert_true "lookup view does not turn role metadata into a declaration"
        (structural_test_lookup_equivalent 10 [structural_test_role])
    , assert_true "lookup view preserves a constant shadowing an inductive"
        (structural_test_lookup_equivalent 10
          [MkEntry(10, CSort 1, Just(CoreTerm, CSort 0)), MkIndEntry 10 structural_test_family])
    , assert_true "lookup view preserves an inductive shadowing a constant"
        (structural_test_lookup_equivalent 10
          [MkIndEntry 10 structural_test_family, MkEntry(10, CSort 1, Just(CoreTerm, CSort 0))])
    , assert_true "lookup view preserves the first conflicting inductive descriptor"
        (structural_test_lookup_equivalent 10
          [MkIndEntry 10 structural_test_family, MkIndEntry 10 structural_test_other_family])
    , assert_true "lookup view preserves a native binding shadowing an inductive"
        (structural_test_lookup_equivalent 10
          [structural_test_native 10, MkIndEntry 10 structural_test_family])
    , assert_true "exact definition keeps alias bodies and original environment order"
        (structural_test_definition_order CheckExactCore)
    , assert_true "source definition keeps alias bodies and original environment order"
        (structural_test_definition_order CheckSourceCore)
    ];

-- @entry main
def main : IO Unit :=
    test_run
      (append Test structural_test_paths
        (append Test structural_test_source
          (append Test structural_test_uses
            (append Test structural_test_lower_hints
              (append Test structural_test_implicit
                (append Test structural_test_implicit_defs
                  (append Test structural_test_named_calls
                    structural_test_lookup)))))));
