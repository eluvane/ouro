-- The development C lifetime host invokes this exported Ouro function. Source
-- checking, closure conversion, runtime linking and MIR validation stay here.
import "../compiler/native/managed_source.ouro";
import "native_managed_driver_common.ouro";

-- Source fixtures include the linked runtime and generated closure names.
-- Keep the global default and the validator's hard ceilings unchanged.
def managed_source_driver_limits : MirLimits := MirLimitsWith (mul 32 256) (mul 16 pe_byte2_place) (mul 16 256);

def managed_source_driver_program (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError MirProgram :=
    match native_managed_lower_units (mul 100 160) managed_source_driver_limits [109,97,105,110] root files with
    | Left error => Left NativeSourceError MirProgram error
    | Right lowered => match lowered with | NativeLoweredOf _ _ program => Right NativeSourceError MirProgram program end end;

def managed_source_driver_nodes (program : MirProgram) : Either NativeCodegenError String :=
    match program with | MirProgramDef functions objects libraries _ =>
      let counted : Either MirError Nat := match mir_count_functions functions pe_byte2_place with
        | Left error => Left MirError Nat error
        | Right remaining => match mir_count_libraries libraries remaining with
          | Left error => Left MirError Nat error
          | Right after => mir_spend MirData after objects end end in
      mapLeft MirError String NativeCodegenError NativeMirError
        (mapRight MirError Nat String (fun (remaining : Nat) => prim_string_of_nat (sub pe_byte2_place remaining)) counted) end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 2 | Cons _ rest =>
         match rest with | Nil => exit 2 | Cons mode paths =>
           match paths with | Nil => exit 2 | Cons root inputs =>
             match orb (prim_string_eq mode "--image") (prim_string_eq mode "--metadata") with
             | False => do eprintln "usage: native_managed_source_driver --image|--metadata ROOT SOURCES..."; exit 2
             | True => do let! files := managed_driver_files (Cons String root inputs);
                          match managed_source_driver_program (prim_string_to_char_codes root) files with
                          | Left error => do eprintln (managed_driver_source_error error); exit 2
                          | Right program => match codegen_program managed_source_driver_limits program with
                            | Left error => do eprintln (managed_driver_error error); exit 2
                            | Right image => managed_driver_write_image (prim_string_eq mode "--metadata") image
                            end end
             end end end end
