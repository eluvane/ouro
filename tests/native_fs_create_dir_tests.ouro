import "analyze/precision/assertions.ouro";
import "native_fs_create_dir_support.ouro";

def fs_create_test_path : String := "dir with spaces/Каталог 雪";

def native_fs_create_dir_tests : List (Pair String Bool) :=
    [ MkPair String Bool "fs-create-dir/empty-path"
        (fs_create_test_length_error 1 (fs_create_dir_path_length "" 8))
    , MkPair String Bool "fs-create-dir/path-nul-prefix"
        (fs_create_test_length_error 1 (fs_create_dir_path_length (str_of_codes ([0,65] : List Nat)) 8))
    , MkPair String Bool "fs-create-dir/path-nul-middle"
        (fs_create_test_length_error 1 (fs_create_dir_path_length (str_of_codes ([65,0,66] : List Nat)) 8))
    , MkPair String Bool "fs-create-dir/path-nul-suffix"
        (fs_create_test_length_error 1 (fs_create_dir_path_length (str_of_codes ([65,0] : List Nat)) 8))
    , MkPair String Bool "fs-create-dir/exact-input-capacity"
        (fs_create_test_length 3 (fs_create_dir_path_length "abc" 3))
    , MkPair String Bool "fs-create-dir/input-too-long"
        (fs_create_test_length_error 2 (fs_create_dir_path_length "abcd" 3))
    , MkPair String Bool "fs-create-dir/unicode-byte-count"
        (fs_create_test_length (str_len fs_create_test_path) (fs_create_dir_path_length fs_create_test_path 64))
    , MkPair String Bool "fs-create-dir/wide-zero"
        (fs_create_test_length_error 5 (fs_create_dir_wide_count 0 8))
    , MkPair String Bool "fs-create-dir/wide-last-terminated"
        (fs_create_test_length 7 (fs_create_dir_wide_count 7 8))
    , MkPair String Bool "fs-create-dir/wide-at-capacity"
        (fs_create_test_length_error 5 (fs_create_dir_wide_count 8 8))
    , MkPair String Bool "fs-create-dir/wide-over-capacity"
        (fs_create_test_length_error 5 (fs_create_dir_wide_count 9 8))
    , MkPair String Bool "fs-create-dir/create-success-owns"
        (andb (fs_create_test_success (fs_create_dir_result True)) (fs_create_dir_was_created (fs_create_dir_result True)))
    , MkPair String Bool "fs-create-dir/create-refusal-never-owns"
        (andb (fs_create_test_error 6 (fs_create_dir_result False)) (notb (fs_create_dir_was_created (fs_create_dir_result False))))
    , MkPair String Bool "fs-create-dir/successful-release-keeps-success"
        (fs_create_test_success (fs_create_dir_released (fs_create_dir_result True) True))
    , MkPair String Bool "fs-create-dir/successful-release-keeps-refusal"
        (fs_create_test_error 6 (fs_create_dir_released (fs_create_dir_result False) True))
    , MkPair String Bool "fs-create-dir/cleanup-retains-created-claim"
        (fs_create_test_cleanup True (Nothing Nat) (fs_create_dir_released (fs_create_dir_result True) False))
    , MkPair String Bool "fs-create-dir/cleanup-retains-create-refusal"
        (fs_create_test_cleanup False (Just Nat 6) (fs_create_dir_released (fs_create_dir_result False) False))
    , MkPair String Bool "fs-create-dir/cleanup-retains-conversion-failure"
        (fs_create_test_cleanup False (Just Nat 4)
          (fs_create_dir_released (Left FsCreateDirError Unit FsCreateDirConversionFailed) False))
    , MkPair String Bool "fs-create-dir/cleanup-claim-survives-another-cleanup-error"
        (fs_create_test_cleanup True (Just Nat 7)
          (fs_create_dir_released (fs_create_dir_released (fs_create_dir_result True) False) False))
    ];

-- @entry main
def main : IO Unit := precision_run "fs-create-dir" native_fs_create_dir_tests;
