-- Disposable observation of the unchanged native_lower import closure.
import "../compiler/driver.ouro",
  "../std/fs.ouro",
  "compiler_test_phase.ouro";

def nltp_fuel : Nat := sub (mul (mul 100 100) 100) 1;

def nltp_bool (value : Bool) : String :=
    match value with | True => "true" | False => "false" end;

def nltp_num (key : String) (value : Nat) : String :=
    prim_string_concat key (prim_string_of_nat value);

def nltp_name (state : InternState) (name : Nat) : String :=
    prim_string_of_char_codes (name_of_id state name);

def nltp_stage (name : String) : IO Unit :=
    (do println (prim_string_concat "NLT_STAGE name=" name); flush);

def nltp_error_line (prefix : String) (error : CompError) : String :=
    match error with
    | ErrCode code detail => prim_string_concat prefix
        (prim_string_concat (nltp_num " code=" code) (nltp_num " detail=" detail))
    end;

def nltp_type_fault (fault : CheckTypeFault) : String :=
    match fault with
    | CheckTypeMismatch => "CheckTypeMismatch"
    | CheckExpectedSort => "CheckExpectedSort"
    | CheckExpectedFunction => "CheckExpectedFunction"
    | CheckCaseMotive => "CheckCaseMotive"
    | CheckNonPositive => "CheckNonPositive"
    | CheckNonTerminating => "CheckNonTerminating"
    | CheckUniverseBound => "CheckUniverseBound"
    end;

def nltp_core_fault (fault : CheckCoreFault) : String :=
    match fault with
    | CheckUnboundVariable index => nltp_num "CheckUnboundVariable index=" index
    | CheckUnboundGlobal name => nltp_num "CheckUnboundGlobal id=" name
    | CheckUnknownInductive name => nltp_num "CheckUnknownInductive id=" name
    | CheckUnknownConstructor name index => prim_string_concat
        (nltp_num "CheckUnknownConstructor id=" name) (nltp_num " index=" index)
    | CheckConstructorParameters => "CheckConstructorParameters"
    | CheckCaseMetadata => "CheckCaseMetadata"
    | CheckFixMetadata => "CheckFixMetadata"
    | CheckLiteralType name => nltp_num "CheckLiteralType id=" name
    | CheckDuplicateName name => nltp_num "CheckDuplicateName id=" name
    | CheckUnresolvedLiteral name => nltp_num "CheckUnresolvedLiteral id=" name
    end;

def nltp_normalize_fault (fault : NormalizeFault) : String :=
    match fault with
    | NormalizeNonFunction => "NormalizeNonFunction"
    | NormalizeCaseBranchCount => "NormalizeCaseBranchCount"
    | NormalizeCaseScrutinee => "NormalizeCaseScrutinee"
    | NormalizeCaseInductive => "NormalizeCaseInductive"
    | NormalizeCaseParameters => "NormalizeCaseParameters"
    | NormalizeCaseConstructor => "NormalizeCaseConstructor"
    | NormalizeCaseArguments => "NormalizeCaseArguments"
    | NormalizeFixArgument => "NormalizeFixArgument"
    | NormalizeFixArity => "NormalizeFixArity"
    | NormalizeUnreducedHead => "NormalizeUnreducedHead"
    | NormalizeStringBytes => "NormalizeStringBytes"
    | NormalizeStringArguments => "NormalizeStringArguments"
    | NormalizeUnresolvedLiteral => "NormalizeUnresolvedLiteral"
    | NormalizeStringType => "NormalizeStringType"
    end;

def nltp_layout_fault (fault : PrimitiveLayoutFault) : String :=
    match fault with
    | PrimitiveLayoutSize => "PrimitiveLayoutSize"
    | PrimitiveLayoutAlignment => "PrimitiveLayoutAlignment"
    | PrimitiveLayoutFieldRange field => nltp_num "PrimitiveLayoutFieldRange field=" field
    | PrimitiveLayoutFieldAlignment field => nltp_num "PrimitiveLayoutFieldAlignment field=" field
    | PrimitiveLayoutFieldOverlap field => nltp_num "PrimitiveLayoutFieldOverlap field=" field
    | PrimitiveLayoutDuplicateField field => nltp_num "PrimitiveLayoutDuplicateField field=" field
    end;

def nltp_primitive_fault (fault : PrimitiveError) : String :=
    match fault with
    | PrimitiveResourceExhausted => "PrimitiveResourceExhausted"
    | PrimitiveUnknownKey => "PrimitiveUnknownKey"
    | PrimitiveMissingType id => nltp_num "PrimitiveMissingType id=" (primitive_id_code id)
    | PrimitiveDuplicateType id => nltp_num "PrimitiveDuplicateType id=" (primitive_id_code id)
    | PrimitiveDuplicateName name => nltp_num "PrimitiveDuplicateName id=" name
    | PrimitiveInvalidTypeBinding name => nltp_num "PrimitiveInvalidTypeBinding id=" name
    | PrimitiveMissingRole role => nltp_num "PrimitiveMissingRole role=" (primitive_role_code role)
    | PrimitiveDuplicateRole role => nltp_num "PrimitiveDuplicateRole role=" (primitive_role_code role)
    | PrimitiveInvalidRole role => nltp_num "PrimitiveInvalidRole role=" (primitive_role_code role)
    | PrimitiveUnsupportedTarget => "PrimitiveUnsupportedTarget"
    | PrimitiveUnsupportedAbi => "PrimitiveUnsupportedAbi"
    | PrimitiveInvalidExternName => "PrimitiveInvalidExternName"
    | PrimitiveVariadicExtern => "PrimitiveVariadicExtern"
    | PrimitiveDependentAbi => "PrimitiveDependentAbi"
    | PrimitiveUnsupportedAbiType => "PrimitiveUnsupportedAbiType"
    | PrimitiveRuntimeResultRequired => "PrimitiveRuntimeResultRequired"
    | PrimitiveInvalidFunctionPointer => "PrimitiveInvalidFunctionPointer"
    | PrimitiveSpecializationRequired => "PrimitiveSpecializationRequired"
    | PrimitiveUnexpectedSpecialization => "PrimitiveUnexpectedSpecialization"
    | PrimitiveInvalidConversion => "PrimitiveInvalidConversion"
    | PrimitiveInvalidLayout layout => prim_string_concat "PrimitiveInvalidLayout/"
        (nltp_layout_fault layout)
    end;

def nltp_failure (failure : CheckFailure) : String :=
    match failure with
    | CheckTypeFailure fault => prim_string_concat "CheckTypeFailure/" (nltp_type_fault fault)
    | CheckMalformedCore fault => prim_string_concat "CheckMalformedCore/" (nltp_core_fault fault)
    | CheckReductionFailure fault => prim_string_concat "CheckReductionFailure/"
        (nltp_normalize_fault fault)
    | CheckResourceLimit => "CheckResourceLimit"
    | CheckUnsupported code => nltp_num "CheckUnsupported code=" code
    | CheckCancelled => "CheckCancelled"
    | CheckInternalFailure code => nltp_num "CheckInternalFailure code=" code
    | CheckPrimitiveFailure fault => prim_string_concat "CheckPrimitiveFailure/"
        (nltp_primitive_fault fault)
    end;

def nltp_surface_kind (surface : Surface) : String :=
    match surface with
    | SVar _ => "SVar" | SSort _ => "SSort" | SPi _ _ _ => "SPi"
    | SLam _ _ _ => "SLam" | SApp _ _ => "SApp" | SLet _ _ _ _ => "SLet"
    | SConst _ => "SConst" | SInd _ => "SInd" | SConstruct _ _ _ => "SConstruct"
    | SCase _ _ _ _ => "SCase" | SFix _ _ _ _ _ => "SFix" | SHole _ => "SHole"
    | SEffectRow _ => "SEffectRow" | SPerform _ _ => "SPerform" | SStr _ _ => "SStr"
    end;

def nltp_first_hole : List (Pair Nat Surface) -> Maybe Nat :=
    fix visit (surfaces : List (Pair Nat Surface)) : Maybe Nat :=
      match surfaces with
      | Nil => Nothing Nat
      | Cons pair rest => match pair with
          | MkPair name surface => match surface_has_hole surface with
              | True => Just Nat name | False => visit rest end end
      end;

inductive NltpSurfaceFailure : Type :=
  | NltpNoSurfaceFailure : NltpSurfaceFailure
  | NltpSurfaceFailureOf : Nat -> Surface -> List Nat -> CompError -> NltpSurfaceFailure;

-- This observation starts with the same context and adds a name only after COk.
-- A preceding duplicate/future-global error cannot be passed by compile_program.
def nltp_first_surface_failure : List (Pair Nat Surface) -> List Nat -> NltpSurfaceFailure :=
    fix visit (surfaces : List (Pair Nat Surface)) (context : List Nat) : NltpSurfaceFailure :=
      match surfaces with
      | Nil => NltpNoSurfaceFailure
      | Cons pair rest => match pair with
          | MkPair name surface => match compile_pipeline surface context with
              | CErr failure => NltpSurfaceFailureOf name surface context failure
              | COk _ => visit rest (Cons Nat name context)
              end end
      end;

def nltp_report_surface (state : InternState) (result : NltpSurfaceFailure) : IO Unit :=
    match result with
    | NltpNoSurfaceFailure => println "NLT_FIRST_SURFACE status=none"
    | NltpSurfaceFailureOf name surface context error =>
        (do println (prim_string_concat (nltp_num "NLT_FIRST_SURFACE id=" name)
              (prim_string_concat " name=" (nltp_name state name)));
            println (prim_string_concat "NLT_FIRST_SURFACE_FLAGS kind="
              (prim_string_concat (nltp_surface_kind surface)
                (prim_string_concat " depth32="
                  (prim_string_concat (nltp_bool (surface_depth_at_least depth_gate surface))
                    (prim_string_concat " hole=" (nltp_bool (surface_has_hole surface)))))));
            println (prim_string_concat "NLT_FIRST_SURFACE_SUPPORTED32 value="
              (nltp_bool (surface_supported fuel32 surface context)));
            println (nltp_error_line "NLT_FIRST_SURFACE_ERROR" error);
            flush)
    end;

def nltp_verdict (result : CompResult (List (Pair Nat CoreTerm))) : IO Unit :=
    match result with
    | COk _ => (do println "NLT_ORIGINAL accepted=true";
                    println "NLT_COMPLETE verdict=accept"; flush; exit 0)
    | CErr error => (do println (nltp_error_line "NLT_ORIGINAL" error);
                        println "NLT_COMPLETE verdict=reject"; flush; exit 1)
    end;

def nltp_rejected (files : List (Pair (List Nat) (List Nat))) (error : CompError) : IO Unit :=
    nltp_verdict (remap_comp_files False files
      (CErr (List (Pair Nat CoreTerm)) error));

def nltp_check_declarations (files : List (Pair (List Nat) (List Nat)))
    (state : InternState) (selected : List Nat) (env : LowerEnv) (decls : List Decl)
    (cores : List (Pair Nat CoreTerm)) : IO Unit :=
    (do nltp_stage "build-check-plan";
        match build_check_plan lower_expr_env2 elaborate nltp_fuel env state decls cores with
        | CheckPlanErr detail =>
            (do println "NLT_DECL status=NOT_RUN reason=check-plan";
                nltp_rejected files (ErrCode 46 detail))
        | CheckPlanOk items =>
            (do nltp_stage "resolve-literal-plan";
                match resolve_literal_plan nltp_fuel state items with
                | CErr error =>
                    (do println "NLT_DECL status=NOT_RUN reason=literal-plan";
                        nltp_rejected files error)
                | COk resolved =>
                    (do nltp_stage "check-module";
                        match check_module nltp_fuel selected resolved with
                        | DeclarationsErr name phase failure =>
                            (do println (prim_string_concat (nltp_num "NLT_DECL status=error id=" name)
                                  (prim_string_concat " name=" (nltp_name state name)));
                                println (prim_string_concat "NLT_DECL_FAILURE phase="
                                  (prim_string_concat (compiler_test_phase_name phase)
                                    (prim_string_concat " failure=" (nltp_failure failure))));
                                nltp_rejected files
                                  (ErrCode (add 40 (declaration_failure_code CheckSourceCore phase failure)) name))
                        | DeclarationsOk checked =>
                            (do println "NLT_DECL status=accepted";
                                nltp_stage "checked-emitted-cores";
                                nltp_verdict (remap_comp_files False files
                                  (checked_emitted_cores checked cores)))
                        end)
                end)
        end);

def nltp_lower_declarations (files : List (Pair (List Nat) (List Nat)))
    (state : InternState) (selected : List Nat) (decls : List Decl) : IO Unit :=
    (do nltp_stage "desugar-file";
        let ds1 : List Decl := desugar_file decls in
        (do nltp_stage "collect-lower-env";
            let base_env : LowerEnv := collect_lower_env_from state ds1 in
            (do nltp_stage "rewrite-declarations";
                let ds2 : List Decl := rewrite_declarations nltp_fuel base_env ds1 in
                (do nltp_stage "populate-io-payloads";
                    let env : LowerEnv := populate_io_payloads lower_expr_env2 base_env ds2 in
                    (do nltp_stage "lower-decls";
                        let surfaces : List (Pair Nat Surface) :=
                          rewrite_surface_pairs (lower_decls_env lower_expr_env2 env ds2) in
                        (do nltp_stage "surface-flags";
                            println (prim_string_concat "NLT_FLAGS depth32="
                              (prim_string_concat (nltp_bool (surfaces_depth_at_least depth_gate surfaces))
                                (prim_string_concat " hole=" (nltp_bool (surfaces_have_hole surfaces)))));
                            match nltp_first_hole surfaces with
                            | Nothing => println "NLT_FIRST_HOLE status=none"
                            | Just name => println (prim_string_concat (nltp_num "NLT_FIRST_HOLE id=" name)
                                (prim_string_concat " name=" (nltp_name state name)))
                            end;
                            nltp_stage "compile-program";
                            let raw : CompResult (List (Pair Nat CoreTerm)) := compile_program surfaces in
                            (do match raw with
                                | COk _ => println "NLT_RAW accepted=true"
                                | CErr error =>
                                    (do println (nltp_error_line "NLT_RAW" error);
                                        match error with
                                        | ErrCode code _ => match eqNat code 2 with
                                            | True => nltp_report_surface state
                                                (nltp_first_surface_failure surfaces (Nil Nat))
                                            | False => println "NLT_FIRST_SURFACE status=NOT_RUN reason=non-2"
                                            end end)
                                end;
                                nltp_stage "compile-surfaces";
                                match compile_surfaces
                                  (fun (_ : List (Pair Nat Surface)) => raw)
                                  driver_elaborate_surfaces nltp_fuel surfaces with
                                | CErr error =>
                                    (do println "NLT_DECL status=NOT_RUN reason=preflight";
                                        nltp_rejected files error)
                                | COk cores => nltp_check_declarations files state selected env ds2 cores
                                end)))))));

def nltp_resolved_declarations (files : List (Pair (List Nat) (List Nat)))
    (state : InternState) (selected : List Nat) (decls : List Decl) : IO Unit :=
    match first_unresolved_import decls with
    | Just path => (do println "NLT_DECL status=NOT_RUN reason=unresolved-import";
                       nltp_rejected files (ErrCode 92 path))
    | Nothing => match first_residual_open_decls decls with
        | Just alias => (do println "NLT_DECL status=NOT_RUN reason=residual-open";
                            nltp_rejected files (ErrCode 98 alias))
        | Nothing => nltp_lower_declarations files state selected decls
        end
    end;

def nltp_parsed_units (files : List (Pair (List Nat) (List Nat)))
    (aliases : List (Pair (List Nat) ImpReg)) (units : List SrcUnit)
    (state : InternState) : IO Unit :=
    match intern_string state (prim_string_to_char_codes "tests/native_lower_tests.ouro") with
    | MkPair root_id st2 =>
        (do nltp_stage "module-resolve-units";
            match module_resolve_units nltp_fuel units aliases root_id st2 with
            | RErr code detail =>
                (do println "NLT_DECL status=NOT_RUN reason=module-resolution";
                    nltp_verdict (import_err (List (Pair Nat CoreTerm)) code detail))
            | ROk plan => match plan with
                | MkPair scoped st3 =>
                    (do nltp_stage "resolve-imports";
                        match resolve_imports scoped root_id with
                        | RErr code detail =>
                            (do println "NLT_DECL status=NOT_RUN reason=import-resolution";
                                nltp_verdict (import_err (List (Pair Nat CoreTerm)) code detail))
                        | ROk decls => nltp_resolved_declarations files st3
                            (unit_decl_names scoped root_id) decls
                        end)
                end
            end)
    end;

def nltp_files (files : List (Pair (List Nat) (List Nat))) : IO Unit :=
    (do nltp_stage "preprocess-files";
        match preprocess_file_list preprocess_imports_reg preprocess_records_reg files with
        | FilesPrepErr code detail =>
            (do println "NLT_DECL status=NOT_RUN reason=preprocess";
                nltp_verdict (CErr (List (Pair Nat CoreTerm)) (ErrCode code detail)))
        | FilesPrepOk prepared aliases =>
            (do nltp_stage "parse-units";
                match parse_units lex_go_import intern_string driver_parse_file
                  nltp_fuel empty_intern prepared with
                | UsErr code detail _ =>
                    (do println "NLT_DECL status=NOT_RUN reason=parse";
                        nltp_verdict (CErr (List (Pair Nat CoreTerm)) (ErrCode code detail)))
                | UsOk units state => nltp_parsed_units prepared aliases units state
                end)
        end);

def nltp_read_files : List String -> IO (Either FsError (List (Pair (List Nat) (List Nat)))) :=
    fix visit (paths : List String) : IO (Either FsError (List (Pair (List Nat) (List Nat)))) :=
      match paths with
      | Nil => io_pure (Either FsError (List (Pair (List Nat) (List Nat))))
          (Right FsError (List (Pair (List Nat) (List Nat))) (Nil (Pair (List Nat) (List Nat))))
      | Cons path rest =>
          (do let! read := fs_read_checked path;
              match read with
              | Left failure => io_pure (Either FsError (List (Pair (List Nat) (List Nat))))
                  (Left FsError (List (Pair (List Nat) (List Nat))) failure)
              | Right content =>
                  (do let! tail_result := visit rest;
                      match tail_result with
                      | Left failure => io_pure (Either FsError (List (Pair (List Nat) (List Nat))))
                          (Left FsError (List (Pair (List Nat) (List Nat))) failure)
                      | Right tail => io_pure (Either FsError (List (Pair (List Nat) (List Nat))))
                          (Right FsError (List (Pair (List Nat) (List Nat)))
                            (Cons (Pair (List Nat) (List Nat))
                              (MkPair (List Nat) (List Nat)
                                (prim_string_to_char_codes path) (prim_string_to_char_codes content)) tail))
                      end)
              end)
      end;

def main : IO Unit :=
    (do nltp_stage "read-manifest";
        let! manifest := fs_read_checked "_build/ci/native-lower-typed/units.txt";
        match manifest with
        | Left failure => (do eprintln (prim_string_concat "NLT_IO_ERROR " (fs_error_message failure));
                              exit 2)
        | Right content =>
            (do let! loaded := nltp_read_files (prim_string_split content 10);
                match loaded with
                | Left failure => (do eprintln (prim_string_concat "NLT_IO_ERROR " (fs_error_message failure));
                                      exit 2)
                | Right files =>
                    (do println (nltp_num "NLT_UNITS count=" (length (Pair (List Nat) (List Nat)) files));
                        flush;
                        match eqNat (length (Pair (List Nat) (List Nat)) files) 169 with
                        | False => (do eprintln "NLT_IO_ERROR wrong-unit-count"; exit 2)
                        | True => nltp_files files
                        end)
                end)
        end);
