-- Native-only timing/conversion probe. The bounded external harness records
-- exact binary marker order, monotonic observation times, and image hashes.
import "../std/async.ouro",
  "../std/natx.ouro",
  "analyze/precision/assertions.ouro";

intrinsic async_sleep_u32_to_nat : U32 -> Nat := "ouro.u32.to_nat.bits";
intrinsic async_sleep_usize_to_nat : USize -> Nat := "ouro.usize.to_nat.bits";

def async_sleep_mark (text : String) : IO Unit := do println text; flush

def async_sleep_require (condition : Bool) : IO Unit :=
    match condition with | True => io_unit | False => exit 91 end;

def async_sleep_u32_missing (value : Nat) : Bool :=
    match u32_from_nat value with | Nothing => True | Just _ => False end;

def async_sleep_size_missing (value : Nat) : Bool :=
    match usize_from_nat value with | Nothing => True | Just _ => False end;

def async_sleep_values : IO Unit :=
    match u32_from_nat 1 with | Nothing => exit 91 | Just one32 =>
      match usize_from_nat 1 with | Nothing => exit 91 | Just one64 =>
        let max32 : U32 := u32_sub(u32_sub one32 one32, one32) in
        let max64 : USize := usize_sub(usize_sub one64 one64, one64) in
        let wide32 : Nat := S (S (async_sleep_u32_to_nat max32)) in
        let wide64 : Nat := S (S (async_sleep_usize_to_nat max64)) in
        precision_run "async-sleep" [
          MkPair String Bool "async-sleep/millisecond-constant"
            (match u32_from_nat 1000 with | Nothing => False | Just value =>
              prim_string_eq(prim_string_of_nat (async_sleep_u32_to_nat value), "1000") end),
          MkPair String Bool "async-sleep/loop-flag-constant"
            (match u8_from_nat 1 with | Nothing => False | Just value =>
              u32_equal(u8_to_u32 value, one32) end),
          MkPair String Bool "async-sleep/last-finite-word"
            (match u32_from_nat (async_sleep_u32_to_nat (u32_sub max32 one32)) with
             | Nothing => False | Just value => u32_equal(value, u32_sub max32 one32) end),
          MkPair String Bool "async-sleep/infinite-word-recognized-not-called"
            (prim_string_eq(prim_string_of_nat (async_sleep_u32_to_nat max32), "4294967295")),
          MkPair String Bool "async-sleep/over-u32-conversion-rejected"
            (async_sleep_u32_missing (S (async_sleep_u32_to_nat max32))),
          MkPair String Bool "async-sleep/over-u64-conversion-rejected"
            (async_sleep_size_missing (S (async_sleep_usize_to_nat max64))),
          MkPair String Bool "async-sleep/wide32-seconds-preserved"
            (prim_string_eq(prim_string_of_nat wide32, "4294967297")),
          MkPair String Bool "async-sleep/wide64-seconds-preserved"
            (prim_string_eq(prim_string_of_nat wide64, "18446744073709551617"))
        ]
      end end;

def async_sleep_once (seconds : Nat) : IO Unit :=
    do async_sleep_mark "ASYNC_BEFORE";
       let action : IO Unit := sleep_s seconds in
       do async_sleep_mark "ASYNC_CONSTRUCTED";
          action;
          async_sleep_mark "ASYNC_AFTER"

def async_sleep_delayed : IO Unit :=
    do async_sleep_mark "ASYNC_BEFORE";
       let action : IO Nat := delay_then Nat 1
         (do async_sleep_mark "ASYNC_ACTION"; io_pure Nat 7) in
       do async_sleep_mark "ASYNC_CONSTRUCTED";
          let! value := action;
          async_sleep_require (eq_nat value 7);
          async_sleep_mark "ASYNC_AFTER"

def async_sleep_reused : IO Unit :=
    do async_sleep_mark "ASYNC_BEFORE";
       let action : IO Unit := sleep_s 1 in
       do async_sleep_mark "ASYNC_CONSTRUCTED";
          action;
          async_sleep_mark "ASYNC_FIRST";
          action;
          async_sleep_mark "ASYNC_AFTER"

def async_sleep_wide (machine64 : Bool) : IO Unit :=
    match machine64 with
    | False => match u32_from_nat 1 with | Nothing => exit 91 | Just one =>
        async_sleep_once (S (S (async_sleep_u32_to_nat (u32_sub(u32_sub one one, one))))) end
    | True => match usize_from_nat 1 with | Nothing => exit 91 | Just one =>
        async_sleep_once (S (S (async_sleep_usize_to_nat (usize_sub(usize_sub one one, one))))) end
    end;

def async_sleep_usage : IO Unit :=
    do eprintln "usage: native-async-sleep zero|short|delay|reused|wide32|wide64|values";
       exit 64

def async_sleep_dispatch (mode : String) : IO Unit :=
    match prim_string_eq mode "zero" with | True => async_sleep_once 0 | False =>
      match prim_string_eq mode "short" with | True => async_sleep_once 1 | False =>
        match prim_string_eq mode "delay" with | True => async_sleep_delayed | False =>
          match prim_string_eq mode "reused" with | True => async_sleep_reused | False =>
            match prim_string_eq mode "wide32" with | True => async_sleep_wide False | False =>
              match prim_string_eq mode "wide64" with | True => async_sleep_wide True | False =>
                match prim_string_eq mode "values" with | True => async_sleep_values
                | False => async_sleep_usage end end end end end end end;

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with
       | Nil => async_sleep_usage
       | Cons _ rest => match rest with
           | Nil => async_sleep_usage
           | Cons mode extra => match extra with
               | Nil => async_sleep_dispatch mode
               | Cons _ _ => async_sleep_usage end end
       end
