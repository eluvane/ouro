-- Shared Nat-recognizer suite helpers for fast-nat and small-nat laws.
import "compiler_program_lookup.ouro";
import "../std/io.ouro";

def nat_test_run : List (Pair String Bool) -> IO Unit :=
  fix run (tests : List (Pair String Bool)) : IO Unit :=
    match tests with
    | Nil => exit 0
    | Cons test rest => match test with | MkPair name passed => match passed with
        | True => do println (prim_string_concat "ok " name); run rest
        | False => do println (prim_string_concat "FAIL " name); exit 1 end end end;

def nat_test_with_body (fuel : Nat) (program : CheckedProgram) (name : String)
    (test : Nat -> CoreTerm -> CoreTerm -> Bool) : Bool :=
    match compiler_test_name program name with
    | Nothing => False
    | Just id => let entries : List Entry := checked_program_entries program in
        match lookup_type id entries, lookup_const id entries with
        | Just annotation, Just body => match close_constructors_checked fuel entries body with
            | CheckErr _ => False
            | CheckOk closed => match check_term_checked fuel entries ([] : List CoreTerm) closed annotation with
                | CheckErr _ => False | CheckOk _ => test id annotation closed end end
        | Nothing, Just _ => False | Just _, Nothing => False | Nothing, Nothing => False end end;

def nat_forge_role (entry : Entry) : Entry :=
    match entry with
    | MkRoleEntry binding => match binding with | PrimitiveRoleOf role shape => match shape with
        | PrimitiveInductiveOf id parameters indices family constructors =>
            MkRoleEntry (PrimitiveRoleOf role (PrimitiveInductiveOf id (S parameters) indices family constructors)) end end
    | MkEntry _ _ _ => entry | MkIndEntry _ _ => entry | MkBoundEntry _ _ _ => entry end;
