-- Renamed checked identities retain the existing transitional C handlers.
import "../std/io.ouro";

def FileText : Type := String;
def FileAction (A : Type) : Type := IO A;
intrinsic file_c_read : FileText -> FileAction FileText := "ouro.fs.read_file";
intrinsic file_c_write : FileText -> FileText -> FileAction Unit := "ouro.fs.write_file";

def file_c_expect (condition : Bool) : IO Unit :=
    match condition with | True => io_unit | False => exit 91 end;

def main : IO Unit :=
    let writer : String -> String -> IO Unit := file_c_write in
    let reader : String -> IO String := file_c_read in
    do writer "files/c-smoke.txt" "files-c\n";
       let! value := reader "files/c-smoke.txt";
       file_c_expect (prim_string_eq value "files-c\n");
       print value;
       exit 42
