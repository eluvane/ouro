-- Fail-closed boundaries for the private allocation bridge and root reader.
import "native_managed_values.ouro";
import "../std/runtime.ouro";

def managed_reject_allocator (runtime : NativeManagedRuntime) (mode : Nat) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      let fake : Nat := add base 2 in
      let raw_result : MirValue := match eqNat mode 0 with
        | True => managed_fixture_word MirRawPtr 0 | False => MirUse 3 end in
      let instructions : List MirInstruction := match eqNat mode 0 with | True => [] | False =>
        match eqNat mode 1 with
        | True => [MirAddress 3 (add base 104), MirPointerAdd 3 (MirUse 3) (managed_fixture_word MirUSize 1)]
        | False => match eqNat mode 2 with | True => [MirAddress 3 (add base 104)] | False =>
          Cons MirInstruction (MirCall MirMayGc (Just Nat 3) (MirDirect allocator) [MirUse 0, MirUse 1, MirUse 2])
            (match eqNat mode 3 with
              | True => [MirStore (MirUse 3) (codegen_disp 0) (managed_fixture_word MirRawPtr 0)]
              | False => match eqNat mode 4 with
                | True => [MirStore (MirUse 3) (codegen_disp 8) (managed_fixture_word MirUSize 48)]
                | False => [MirStore (MirUse 3) (codegen_disp 24) (managed_fixture_word MirUSize 1)] end end)
          end end end in
      managed_fixture_finish runtime
        [managed_fixture_body (S base) [MirLocalDef 1 MirManagedPtr]
          [MirManagedAlloc 1 fake collector (add base 100) (managed_fixture_word MirUSize 40)] (managed_fixture_word MirU32 42),
         MirFunctionDef fake [98,97,100,95,97,108,108,111,99,97,116,111,114]
          [MirLocalDef 0 MirRawPtr, MirLocalDef 1 MirRawPtr, MirLocalDef 2 MirUSize]
          [MirLocalDef 3 MirRawPtr] (Just MirType MirRawPtr) 0 [MirBlockDef 0 instructions (MirReturn (Just MirValue raw_result))]]
        (managed_value_descriptors base) end;

def managed_reject_object (runtime : NativeManagedRuntime) (mode : Nat) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ inspect _ base collector =>
      managed_fixture_finish runtime
        [managed_fixture_body (S base)
          [MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirRawPtr, MirLocalDef 3 MirRawPtr]
          (managed_fixture_join ([
            ([MirManagedAlloc 1 allocator collector (add base 102) (managed_fixture_word MirUSize 40),
              MirManagedContext 2, MirAddress 3 (add base 104)] : List MirInstruction),
            (match eqNat mode 0 with
              | True => [MirStore (MirUse 1) (codegen_disp 32) (managed_fixture_word MirUSize 1)]
              | False => [MirStore (MirUse 1) (codegen_disp 0) (managed_fixture_word MirUSize 1)] end : List MirInstruction),
            ([MirCall MirMayGc (Nothing Nat) (MirDirect inspect) [MirUse 2, MirUse 3]] : List MirInstruction)]
              : List (List MirInstruction))) (managed_fixture_word MirU32 42)]
        (managed_value_descriptors base) end;

def managed_reject_size (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      managed_fixture_finish runtime
        [managed_fixture_body (S base) [MirLocalDef 1 MirManagedPtr]
          [MirManagedAlloc 1 allocator collector (add base 100) (managed_fixture_word MirUSize 32)] (managed_fixture_word MirU32 42)]
        (managed_value_descriptors base) end;

def managed_reject_signature (runtime : NativeManagedRuntime) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ _ _ inspect _ base collector =>
      managed_fixture_finish runtime
        [managed_fixture_body (S base) [MirLocalDef 1 MirManagedPtr]
          [MirManagedAlloc 1 inspect collector (add base 100) (managed_fixture_word MirUSize 40)] (managed_fixture_word MirU32 42)]
        (managed_value_descriptors base) end;

def managed_reject_descriptor (runtime : NativeManagedRuntime) (mode : Nat) : MirProgram :=
    match runtime with | NativeManagedRuntimeOf _ allocator _ _ _ base collector =>
      let bytes : List Nat := match eqNat mode 0 with | True => mir_managed_descriptor_bytes 11
        | False => match eqNat mode 1 with | True => take Nat 39 (mir_managed_descriptor_bytes 11)
          | False => match eqNat mode 2 with
            | True => append Nat (pe_le32 2) (drop Nat 4 (mir_managed_descriptor_bytes 11))
            | False => pe_join [pe_le32 1, pe_le32 2, pe_le64_rva 40, pe_le64_rva 40, pe_le64_rva 2, pe_le64_rva 48] end end end in
      managed_fixture_finish runtime
        [managed_fixture_body (S base) [MirLocalDef 1 MirManagedPtr]
          [MirManagedAlloc 1 allocator collector (add base 100) (managed_fixture_word MirUSize 40)] (managed_fixture_word MirU32 42)]
        [MirDataDef (add base 100) (eqNat mode 0) bytes] end;

def managed_case_is (name : List Nat) (expected : String) : Bool :=
    pe_bytes_equal name (prim_string_to_char_codes expected);

def managed_case (name : String) (build : NativeManagedRuntime -> MirProgram)
    : Pair String (NativeManagedRuntime -> MirProgram) :=
    MkPair String (NativeManagedRuntime -> MirProgram) name build;

def managed_cases : List (Pair String (NativeManagedRuntime -> MirProgram)) :=
    [
     managed_case "constructor" (managed_value_constructor),
     managed_case "escaping" (managed_value_escape),
     managed_case "pap_reuse" (managed_value_pap),
     managed_case "recursive_env" (managed_value_recursive),
     managed_case "live_cleanup" (managed_value_live_cleanup),
     managed_case "evaluation_order" (managed_value_order),
     managed_case "return_null" (fun (runtime : NativeManagedRuntime) => managed_reject_allocator runtime 0),
     managed_case "return_unaligned" (fun (runtime : NativeManagedRuntime) => managed_reject_allocator runtime 1),
     managed_case "return_unmanaged" (fun (runtime : NativeManagedRuntime) => managed_reject_allocator runtime 2),
     managed_case "header_descriptor" (fun (runtime : NativeManagedRuntime) => managed_reject_allocator runtime 3),
     managed_case "header_size" (fun (runtime : NativeManagedRuntime) => managed_reject_allocator runtime 4),
     managed_case "header_mark" (fun (runtime : NativeManagedRuntime) => managed_reject_allocator runtime 5),
     managed_case "object_count" (fun (runtime : NativeManagedRuntime) => managed_reject_object runtime 0),
     managed_case "object_descriptor" (fun (runtime : NativeManagedRuntime) => managed_reject_object runtime 1),
     managed_case "allocation_size" (managed_reject_size),
     managed_case "allocator_signature" (managed_reject_signature),
     managed_case "descriptor_writable" (fun (runtime : NativeManagedRuntime) => managed_reject_descriptor runtime 0),
     managed_case "descriptor_truncated" (fun (runtime : NativeManagedRuntime) => managed_reject_descriptor runtime 1),
     managed_case "descriptor_version" (fun (runtime : NativeManagedRuntime) => managed_reject_descriptor runtime 2),
     managed_case "descriptor_count_offset" (fun (runtime : NativeManagedRuntime) => managed_reject_descriptor runtime 3)];

def managed_case_named (name : List Nat) (runtime : NativeManagedRuntime) : Maybe MirProgram :=
    (fix find_case (cases : List (Pair String (NativeManagedRuntime -> MirProgram))) : Maybe MirProgram :=
      match cases with | Nil => managed_fixture_named name runtime | Cons pair rest =>
        match pair with | MkPair label build => match managed_case_is name label with
          | True => Just MirProgram (build runtime) | False => find_case rest end end end) managed_cases;
