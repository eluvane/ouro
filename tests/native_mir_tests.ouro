import "native_indexed_memory_tests.ouro";
import "native_codegen_assembly_tests.ouro";

def mir_test_bytes (name : String) (actual : List Nat) (expected : List Nat) : Test :=
    assert_eq name (str_join "," (map Nat String str_of_nat actual)) (str_join "," (map Nat String str_of_nat expected));

def mir_test_encoding (name : String) (instruction : X64Instruction) (expected : List Nat) : Test :=
    match x64_encode instruction with | Left _ => test_fail name "encoder rejected instruction"
    | Right bytes => mir_test_bytes name bytes expected end;

def mir_test_frame (name : String) (frame : PeFrame) (expected : List Nat) : Test :=
    match pe_encode_frame 7 frame with | Left _ => test_fail name "PE writer rejected frame"
    | Right info => match info with | PeUnwindInfoData _ metadata => mir_test_bytes name metadata expected end end;

def mir_encoding_tests : List Test :=
    [mir_test_encoding "MOVZX byte through RSP/SIB" (X64Load8Zero X64Rax (X64Base X64Rsp (codegen_disp 8)))
      ([15, 182, 68, 36, 8] : List Nat),
      mir_test_encoding "MOVZX extended register and disp32" (X64Load8Zero X64R9 (X64Base X64R12 (codegen_disp 257)))
        ([69, 15, 182, 140, 36, 1, 1, 0, 0] : List Nat),
      mir_test_encoding "byte store SPL requires REX" (X64Store8 (X64Base X64Rax (codegen_disp 0)) X64Rsp) ([64, 136, 32] : List Nat),
      mir_test_encoding "byte store BPL requires REX" (X64Store8 (X64Base X64Rax (codegen_disp 0)) X64Rbp) ([64, 136, 40] : List Nat),
      mir_test_encoding "byte store SIL requires REX" (X64Store8 (X64Base X64Rax (codegen_disp 0)) X64Rsi) ([64, 136, 48] : List Nat),
      mir_test_encoding "byte store DIL requires REX" (X64Store8 (X64Base X64Rax (codegen_disp 0)) X64Rdi) ([64, 136, 56] : List Nat),
      mir_test_encoding "byte store R15B" (X64Store8 (X64Base X64Rax (codegen_disp 0)) X64R15) ([68, 136, 56] : List Nat),
      mir_test_encoding "byte store AL through RBP needs zero displacement" (X64Store8 (X64Base X64Rbp (codegen_disp 0)) X64Rax)
        ([136, 69, 0] : List Nat),
      mir_test_encoding "MOVSXD extended registers" (X64SignExtend32 X64R12 X64R9) ([77, 99, 225] : List Nat),
      mir_test_encoding "stack probe reads byte without clobbering registers" (X64TestMemory8 (X64Base X64R10 (codegen_disp 0)) 0)
        ([65, 246, 2, 0] : List Nat),
      match x64_encode (X64TestMemory8 (X64Base X64R10 (codegen_disp 0)) 256) with
      | Left err => match err with | X64ByteOutOfRange byte => assert_true "probe immediate byte range" (eq_nat byte 256)
        | X64DisplacementOutOfRange => test_fail "probe immediate byte range" "wrong error"
        | X64StackPointerIndex => test_fail "probe immediate byte range" "wrong error"
        | X64ShiftOutOfRange _ _ => test_fail "probe immediate byte range" "wrong error" end
      | Right _ => test_fail "probe immediate byte range" "invalid immediate accepted" end,
      mir_test_frame "probed frame short UWOP_ALLOC_LARGE" (PeProbedFrame ([] : List X64Register)
        (add pe_section_alignment 8) (codegen_disp 0)) ([1, 13, 2, 0, 13, 1, 1, 2] : List Nat),
      mir_test_frame "probed frame long UWOP_ALLOC_LARGE" (PeProbedFrame ([] : List X64Register)
        (add (mul 8 pe_byte2_place) 8) (codegen_disp 0)) ([1, 13, 3, 0, 13, 17, 8, 0, 8, 0, 0, 0] : List Nat),
      mir_test_frame "probed frame accounts for saved RBX" (PeProbedFrame ([X64Rbx] : List X64Register)
        pe_section_alignment (codegen_disp 0)) ([1, 14, 3, 0, 14, 1, 0, 2, 1, 48, 0, 0] : List Nat),
      match pe_encode_frame 7 (PeProbedFrame ([] : List X64Register) 40 (codegen_disp 0)) with
      | Left err => match err with | PeUnsupportedFrame id => assert_true "small frame cannot claim a probe layout" (eq_nat id 7)
        | PeInvalidByte _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeImageTooLarge => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeEmptyText => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeDuplicateSymbol _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeMissingSymbol _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeInvalidSymbol _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeInvalidName => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeDuplicateLibrary => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeDuplicateImport _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeMissingImport _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeEmptyLibrary => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeInvalidFixup _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeUnorderedFixup _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeNonzeroFixup _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeRelativeOverflow _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeMissingEntry _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeInvalidFunction _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeUnorderedFunction _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeStackProbeRequired _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PePrologMismatch _ => test_fail "small frame cannot claim a probe layout" "wrong error"
        | PeInstructionError _ => test_fail "small frame cannot claim a probe layout" "wrong error" end
      | Right _ => test_fail "small frame cannot claim a probe layout" "invalid frame accepted" end];

def mir_codegen_error_text (err : NativeCodegenError) : String :=
    match err with
    | NativeMirError problem => mir_test_error_text problem
    | NativeEncodingError _ => "x64 encoding error" | NativePeError _ => "PE writer error"
    | NativeMissingSlot id => str_concat "slot:" (str_of_nat id)
    | NativeMissingLabel id => str_concat "label:" (str_of_nat id)
    | NativeCodeTooLarge => "code-size limit" end;

def mir_codegen_accept (name : String) (program : MirProgram) : Test :=
    match codegen_program mir_default_limits program with
    | Left err => test_fail name (mir_codegen_error_text err)
    | Right image => match image with | NativeImageOf pe _ => match pe with | PeImageFile bytes _ =>
        assert_true name (ltb_nat 0 (length Nat bytes)) end end end;

def mir_test_roots (roots : List NativeRootSlot) : String := str_join ","
    (map NativeRootSlot String (fun (root : NativeRootSlot) => match root with
      | NativeRootAt id offset => str_cat3 (str_of_nat id) ":" (str_of_nat offset) end) roots);

def mir_metadata_tests : List Test :=
    match codegen_program mir_default_limits mir_fixture_calls with
    | Left err => [test_fail "managed root metadata" (mir_codegen_error_text err)]
    | Right result => match result with | NativeImageOf image frames =>
      match find NativeFrameInfo (fun (frame : NativeFrameInfo) => match frame with
        | NativeFrameAt id _ _ _ => eq_nat id 4 end) frames with
      | Nothing => [test_fail "managed root metadata" "frame absent"]
      | Just frame => match frame with | NativeFrameAt _ allocation roots calls =>
        [assert_true "managed root frame includes its linked shadow record" (eq_nat allocation 88),
          assert_eq "managed argument and saved local are distinct root slots" (mir_test_roots roots) "0:32,1:40",
          assert_true "call boundary has one return PC" (eq_nat (length NativeCallSite calls) 1),
          assert_true "call return PC belongs to its emitted function" (match image with | PeImageFile _ addresses =>
            all NativeCallSite (fun (site : NativeCallSite) => match site with | NativeCallAt block instruction pc =>
              andb (andb (eq_nat block 0) (eq_nat instruction 1))
                (any PeFunctionAddress (fun (address : PeFunctionAddress) => match address with
                  | PeFunctionAt id start finish _ => andb (eq_nat id 4) (andb (ltb_nat start pc) (ltb_nat pc finish)) end) addresses) end) calls end)]
        end end end end;

def mir_fixture_reordered : MirProgram := mir_fixture_program
    (MirFunctionDef 1 ([114, 101, 111, 114, 100, 101, 114] : List Nat) ([] : List MirLocal) ([] : List MirLocal)
      mir_fixture_void 7 ([mir_fixture_exit_block 8 42, MirBlockDef 7 ([] : List MirInstruction) (MirJump 8)] : List MirBlock));

def mir_fixture_named (name : String) : Maybe MirProgram :=
    match str_eq name "indexed_memory" with | True => Just MirProgram indexed_fixture_raw | False =>
    match str_eq name "control" with | True => Just MirProgram mir_fixture_control | False =>
    match str_eq name "arithmetic" with | True => Just MirProgram mir_fixture_arithmetic | False =>
    match str_eq name "memory" with | True => Just MirProgram mir_fixture_memory | False =>
    match str_eq name "calls" with | True => Just MirProgram mir_fixture_calls | False =>
    match str_eq name "large" with | True => Just MirProgram mir_fixture_large | False =>
    match str_eq name "stdout" with | True => Just MirProgram mir_fixture_stdout | False =>
    match str_eq name "reordered" with | True => Just MirProgram mir_fixture_reordered | False =>
    match str_eq name "div_zero" with | True => Just MirProgram
      (mir_fixture_trap MirDiv MirU64 (mir_fixture_nat MirU64 1) (mir_fixture_nat MirU64 0)) | False =>
    match str_eq name "div_overflow" with | True => Just MirProgram
      (mir_fixture_trap MirDiv MirI32 (mir_fixture_i32 (X64Bytes32 0 0 0 128)) (mir_fixture_i32 (X64Bytes32 255 255 255 255))) | False =>
    match str_eq name "rem_overflow" with | True => Just MirProgram
      (mir_fixture_trap MirRem MirI32 (mir_fixture_i32 (X64Bytes32 0 0 0 128)) (mir_fixture_i32 (X64Bytes32 255 255 255 255))) | False =>
      Nothing MirProgram end end end end end end end end end end end;

def mir_emit_fixture (name : String) : IO Unit :=
    match mir_fixture_named name with
    | Nothing => do eprintln "unknown native MIR fixture"; exit 2
    | Just program => match codegen_program mir_default_limits program with
      | Left err => do eprintln (mir_codegen_error_text err); exit 2
      | Right image => match image with | NativeImageOf pe _ => match pe with | PeImageFile bytes _ =>
        println (str_join "," (map Nat String str_of_nat bytes)) end end end end;

def mir_emit_metadata (name : String) : IO Unit :=
    match mir_fixture_named name with
    | Nothing => do eprintln "unknown native MIR fixture"; exit 2
    | Just program => match codegen_program mir_default_limits program with
      | Left err => do eprintln (mir_codegen_error_text err); exit 2
      | Right image => match image with | NativeImageOf _ frames =>
        println (str_join "\n" (map NativeFrameInfo String (fun (frame : NativeFrameInfo) => match frame with
          | NativeFrameAt id allocation roots calls => str_cat4
            (str_cat3 (str_of_nat id) "|" (str_of_nat allocation)) "|" (mir_test_roots roots)
            (str_concat "|" (str_join "," (map NativeCallSite String (fun (site : NativeCallSite) => match site with
              | NativeCallAt block instruction pc => str_cat4 (str_of_nat block) ":" (str_of_nat instruction)
                (str_concat ":" (str_of_nat pc)) end) calls))) end) frames)) end end end;

def mir_tests : List Test := append Test (append Test mir_validation_tests indexed_memory_tests) (append Test mir_encoding_tests
    (append Test mir_metadata_tests ([
      mir_codegen_accept "MIR control graph emits a PE" mir_fixture_control,
      mir_codegen_accept "MIR arithmetic emits a PE" mir_fixture_arithmetic,
      mir_codegen_accept "MIR byte/word/pointer memory emits a PE" mir_fixture_memory,
      mir_codegen_accept "MIR large probed frame emits a PE" mir_fixture_large,
      mir_codegen_accept "MIR five-argument WinAPI call emits a PE" mir_fixture_stdout,
      mir_codegen_accept "MIR entry block is independent of layout order" mir_fixture_reordered,
      match codegen_program mir_default_limits (mir_test_one (MirMove 10 (MirUse 11))) with
      | Left err => match err with | NativeMirError problem =>
          assert_eq "codegen entry cannot bypass MIR validation" (mir_test_error_text problem) "uninitialized:0:11"
        | NativeEncodingError _ => test_fail "codegen entry cannot bypass MIR validation" "wrong error"
        | NativePeError _ => test_fail "codegen entry cannot bypass MIR validation" "wrong error"
        | NativeMissingSlot _ => test_fail "codegen entry cannot bypass MIR validation" "wrong error"
        | NativeMissingLabel _ => test_fail "codegen entry cannot bypass MIR validation" "wrong error"
        | NativeCodeTooLarge => test_fail "codegen entry cannot bypass MIR validation" "wrong error" end
      | Right _ => test_fail "codegen entry cannot bypass MIR validation" "invalid MIR emitted" end] : List Test)));

-- Each wide case runs with its own temporary analysis graph. The bootstrap
-- C runtime otherwise retains both graphs while initializing a global list.
def mir_memory_case_names : List String := ["wide_flow", "wide_missing_predecessor"];

-- The shared test_run exits even on success; these batches must return so
-- the default invocation also executes both wide graphs.
def mir_run_test_batch (tests : List Test) : IO Unit :=
    do io_foreach Test test_report tests;
       match any Test test_failed tests with
       | True => exit 1
       | False => io_unit
       end

def mir_run_memory_case (name : String) : IO Unit :=
    match str_eq name "wide_flow" with
    | True => mir_run_test_batch ([mir_test_accept "MIR wide branch graph stays within the default resource budget"
        (mir_test_wide_flow True)] : List Test)
    | False => match str_eq name "wide_missing_predecessor" with
      | True => mir_run_test_batch ([mir_test_bad "MIR wide merge still requires every predecessor" (MirUninitialized 121 10)
          (mir_test_wide_flow False)] : List Test)
      | False => do eprintln "unknown native MIR case"; exit 2 end end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match eq_nat (length String arguments) 1 with
       | True => do mir_run_test_batch mir_tests;
                    mir_run_test_batch native_codegen_assembly_tests;
                    mir_run_memory_case "wide_flow";
                    mir_run_memory_case "wide_missing_predecessor"
       | False => match andb (eq_nat (length String arguments) 2)
           (str_eq (nth String "" 1 arguments) "--list-cases") with
         | True => println (str_join "\n" mir_memory_case_names)
         | False => match andb (eq_nat (length String arguments) 3)
             (str_eq (nth String "" 1 arguments) "--case") with
           | True => mir_run_memory_case (nth String "" 2 arguments)
           | False =>
         match andb (eq_nat (length String arguments) 3)
             (orb (str_eq (nth String "" 1 arguments) "--image") (str_eq (nth String "" 1 arguments) "--metadata")) with
         | True => match str_eq (nth String "" 1 arguments) "--image" with
             | True => mir_emit_fixture (nth String "" 2 arguments) | False => mir_emit_metadata (nth String "" 2 arguments) end
         | False => do eprintln "usage: native_mir_tests [--image NAME|--metadata NAME|--list-cases|--case NAME]"; exit 2
         end end end
       end
