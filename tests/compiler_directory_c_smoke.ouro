-- Renamed directory identities retain the existing development C handlers.
import "../std/io.ouro",
  "../std/listx.ouro";

def DirectoryText : Type := String;
def DirectoryWork (A : Type) : Type := IO A;
intrinsic directory_c_list : DirectoryText -> DirectoryWork (List DirectoryText) := "ouro.fs.list_dir";
intrinsic directory_c_probe : DirectoryText -> DirectoryWork Bool := "ouro.fs.listable";

def directory_c_expect (condition : Bool) : IO Unit :=
    match condition with | True => io_unit | False => exit 91 end;

def main : IO Unit :=
    let listing : String -> IO (List String) := directory_c_list in
    let probing : String -> IO Bool := directory_c_probe in
    do prim_fs_write_file "files/directory-c.txt" "directory-c";
       let! names := listing "files";
       let! readable := probing "files";
       let! missing := probing "files/missing";
       directory_c_expect (andb(readable, notb missing));
       directory_c_expect (any String (prim_string_eq "directory-c.txt") names);
       print "directories-c\n";
       exit 42
