-- Focused acceptance tests for practical workflow helpers.

import "../std/configx.ouro",
  "../std/format.ouro",
  "../std/jsonx.ouro",
  "../std/lines.ouro",
  "../std/processx.ouro",
  "../std/tablex.ouro",
  "../std/test.ouro",
  "../std/validation.ouro";

def workflow_lines : List String :=
    line_data_lines("#", lines_from_text "# header\n1 2\n\n3 bad\n");

def workflow_values : List Nat := line_nat_values workflow_lines;

def workflow_json : Json :=
    jsonx_parse_or_null "{\"name\":\"ouro\",\"enabled\":true,\"limit\":3}";

def workflow_table : List (List String) :=
    table_from_csv "name,kind\ncli,tool\nreport,doc\n";

def workflow_schema : Validation ConfigError Unit :=
    configx_validate_schema
      (config_parse "path=input.txt\nlimit=3\nenabled=true\n")
      ([ configx_field "path" ConfigAsString
      , configx_field "limit" ConfigAsNat
      , configx_field "enabled" ConfigAsBool
      ] : List ConfigField);

def workflow_plan : ProcessPlan :=
    process_plan_add process_plan_empty
      (command_spec("echo", ["ouro"] : List String));

def workflow_validation : Validation String Unit :=
    validation_and String
      (validation_require String "missing input" False)
      (validation_require String "missing output" False);

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_eq "line values" (show_nat (length Nat workflow_values)) "3"
      , assert_eq "json getter" (fromMaybe String "" (jsonx_get_string workflow_json "name")) "ouro"
      , assert_eq "table count" (show_nat (tablex_count_where workflow_table "kind" "tool")) "1"
      , assert_eq "process render" (process_plan_render workflow_plan) "echo ouro"
      , assert_true("config schema", validation_is_valid ConfigError Unit workflow_schema)
      , assert_eq "validation errors" (show_nat (length(String, validation_errors String Unit workflow_validation))) "2"
      ] : List Test);
