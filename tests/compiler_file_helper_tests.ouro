-- The helper candidate is checked source. Mutated raw-contract tables below
-- test the internal linker boundary independently of helper name lookup.
import "../compiler/native/managed_files_memory.ouro",
  "../compiler/driver.ouro",
  "compiler_startup_test_support.ouro",
  "compiler_managed_helper_test_support.ouro";

def file_helper_prefix : String :=
    prim_string_concat
      "intrinsic Effect : Type -> Type := \"ouro.runtime\"; intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic Byte : Type := \"ouro.u8\"; intrinsic Word : Type := \"ouro.u32\"; intrinsic Size : Type := \"ouro.usize\"; "
      "inductive Flag : Type := | Yes : Flag | No : Flag; representation Flag := \"ouro.bool\"; intrinsic pure : (A : Type) -> A -> Effect A := \"ouro.runtime.pure\"; axiom zero : Word; def AliasWord : Type := Word; def AliasPointer (A : Type) : Type := Pointer A; def Deferred (A : Type) : Type := Effect A; ";

def file_helper_source (mode : Nat) : String :=
    prim_string_concat file_helper_prefix (match eqNat mode 7 with
      | True => "axiom raw_windows_file_read : Pointer Byte -> Pointer Byte -> Size -> Pointer Word -> Effect Word;"
      | False => match eqNat mode 9 with
        | True => "extern raw_windows_file_read : Pointer Byte -> Pointer Byte -> Size -> Pointer Word -> Effect Word := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetLastError\" \"nogc\";"
        | False => match eqNat mode 1 with
          | True => "def raw_windows_file_read (stream : AliasPointer Byte) (buffer : AliasPointer Byte) (bytes : Size) (count : AliasPointer AliasWord) : Deferred AliasWord := pure Word zero;"
          | False => "def raw_windows_file_read (stream : Pointer Byte) (buffer : Pointer Byte) (bytes : Size) (count : Pointer Word) : Effect Word := pure Word zero;" end end end);

def file_helper_compiler (program : CheckedProgram) (contracts : List LowerContract) : ManagedCompiler :=
    managed_helper_test_compiler program contracts;

def file_helper_contracts (mode : Nat) (contract : LowerContract) : List LowerContract :=
    managed_helper_test_contracts PrimitiveFileRead mode contract;

def file_helper_resolve (mode : Nat) (program : CheckedProgram) : Either NativeLowerError Nat :=
    managed_helper_test_resolve mode (managed_file_helper_name ManagedFileRead)
      (fun (compiler : ManagedCompiler) => managed_file_expected compiler ManagedFileRead)
      (file_helper_contracts mode) program;

def file_helper_probe (mode : Nat) : String :=
    managed_helper_test_probe (file_helper_source mode) (file_helper_resolve mode);

def main : IO Unit :=
    startup_test_run
      [startup_test_eq "checked file body links the same raw definition" (file_helper_probe 0) "linked",
       startup_test_eq "file helper accepts normalized pointer, word and Runtime aliases" (file_helper_probe 1) "linked",
       startup_test_eq "checked body without compiled raw contract is rejected" (file_helper_probe 2) "call",
       startup_test_eq "another raw contract ID cannot authorize the helper" (file_helper_probe 3) "call",
       startup_test_eq "same raw ID with different Core contract is rejected" (file_helper_probe 4) "metadata",
       startup_test_eq "primitive binding cannot replace a compiled helper body" (file_helper_probe 5) "body",
       startup_test_eq "a helper axiom cannot supply an implementation" (file_helper_probe 7) "body",
       startup_test_eq "helper normalization preserves fuel failure" (file_helper_probe 8) "resource",
       startup_test_eq "a foreign declaration cannot masquerade as a checked helper body" (file_helper_probe 9) "body"];
