import "compiler_property_model.ouro";
import "../compiler/file_elab_lookup.ouro";

def property_scoped_leaf (depth : Nat) (seed : Nat) : CoreTerm :=
    match property_choice seed (match depth with | Z => 5 | S _ => 8 end) with
    | Z => CSort (property_choice (property_seed seed 51) 3)
    | S first => match first with
        | Z => CStrBytes ([115, 0, 255] : List Nat) 80
        | S second => match second with
            | Z => CConst (add 10 (property_choice (property_seed seed 52) 4))
            | S third => match third with
                | Z => CInd (add 10 (property_choice (property_seed seed 53) 4))
                | S fourth => match fourth with
                    | Z => CConstruct (add 10 (property_choice (property_seed seed 54) 4))
                        (property_choice (property_seed seed 55) 3) (property_choice (property_seed seed 56) 2)
                    | S _ => CRel (property_choice (property_seed seed 57) depth)
                    end
                end
            end
        end
    end;

def property_scoped : Nat -> Nat -> Nat -> CoreTerm :=
  fix generate (fuel : Nat) (depth : Nat) (seed : Nat) : CoreTerm :=
    match fuel with
    | Z => property_scoped_leaf depth seed
    | S next =>
        let subterm : Nat -> Nat -> CoreTerm :=
          fun (scope : Nat) (salt : Nat) => generate next scope (property_seed seed salt) in
        match property_choice seed 9 with
        | Z => property_scoped_leaf depth seed
        | S first => match first with
            | Z => CPi (subterm depth 1) (subterm (S depth) 2)
            | S second => match second with
                | Z => CLam (subterm depth 3) (subterm (S depth) 4)
                | S third => match third with
                    | Z => CApp (subterm depth 5) (subterm depth 6)
                    | S fourth => match fourth with
                        | Z => CApp (subterm depth 7) (subterm depth 8)
                        | S fifth => match fifth with
                            | Z => CLetIn (subterm depth 9) (subterm depth 10) (subterm (S depth) 11)
                            | S sixth => match sixth with
                                | Z => CCase
                                    (MkCaseInfo (add 10 (property_choice (property_seed seed 58) 4))
                                      (property_choice (property_seed seed 59) 2)
                                      ([0, property_choice (property_seed seed 60) 3] : List Nat))
                                    (subterm depth 12) (subterm depth 13)
                                    ([subterm depth 14, subterm depth 15] : List CoreTerm)
                                | S seventh => match seventh with
                                    | Z => let arity : Nat := S (property_choice (property_seed seed 61) 3) in
                                        CFix (property_choice (property_seed seed 62) 4)
                                          (property_choice (property_seed seed 63) arity) arity
                                          (subterm depth 16) (subterm (S depth) 17)
                                    | S _ => CApp (subterm depth 18) (subterm depth 19)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end;

-- This only checks the generator's invariant. Acceptance and rejection laws
-- below use the production checker on typed terms. Branch lambdas carry scope.
def property_scope_valid : CoreTerm -> Nat -> Bool :=
  fix valid (term : CoreTerm) (depth : Nat) : Bool :=
      match term with
      | CRel index => ltNat index depth
      | CSort _ => True | CConst _ => True | CInd _ => True
      | CConstruct _ _ _ => True | CStrLit _ _ => False | CStrBytes _ _ => True
      | CPi domain body => andb (valid domain depth) (valid body (S depth))
      | CLam annotation body => andb (valid annotation depth) (valid body (S depth))
      | CApp function argument => andb (valid function depth) (valid argument depth)
      | CLetIn value annotation body => andb (valid value depth)
          (andb (valid annotation depth) (valid body (S depth)))
      | CFix _ _ _ annotation body => andb (valid annotation depth) (valid body (S depth))
      | CCase _ motive scrutinee branches => andb (valid motive depth)
          (andb (valid scrutinee depth)
            ((fix check_branches (rest : List CoreTerm) : Bool :=
              match rest with
              | Nil => True
              | Cons branch tail => andb (valid branch depth) (check_branches tail)
              end) branches))
      end;

def property_globals : CoreTerm -> List Nat :=
  fix names (term : CoreTerm) : List Nat :=
      match term with
      | CRel _ => [] | CSort _ => [] | CStrLit _ typ => [typ] | CStrBytes _ typ => [typ]
      | CConst name => [name] | CInd name => [name] | CConstruct family _ _ => [family]
      | CPi domain body => append Nat (names domain) (names body)
      | CLam annotation body => append Nat (names annotation) (names body)
      | CApp function argument => append Nat (names function) (names argument)
      | CLetIn value annotation body => append Nat (names value)
          (append Nat (names annotation) (names body))
      | CFix _ _ _ annotation body => append Nat (names annotation) (names body)
      | CCase info motive scrutinee branches => match info with
          | MkCaseInfo family _ _ => Cons Nat family
              (append Nat (names motive) (append Nat (names scrutinee)
                ((fix collect (rest : List CoreTerm) : List Nat :=
                    match rest with | Nil => [] | Cons branch tail =>
                      append Nat (names branch) (collect tail) end) branches)))
          end
      end;

def property_rel_count : CoreTerm -> Nat :=
  fix count (term : CoreTerm) : Nat :=
    match term with
    | CRel _ => 1 | CSort _ => 0 | CConst _ => 0 | CInd _ => 0
    | CConstruct _ _ _ => 0 | CStrLit _ _ => 0 | CStrBytes _ _ => 0
    | CPi domain body => add (count domain) (count body)
    | CLam annotation body => add (count annotation) (count body)
    | CApp function argument => add (count function) (count argument)
    | CLetIn value annotation body => add (count value) (add (count annotation) (count body))
    | CFix _ _ _ annotation body => add (count annotation) (count body)
    | CCase _ motive scrutinee branches => add (count motive) (add (count scrutinee)
        ((fix total (rest : List CoreTerm) : Nat :=
          match rest with | Nil => 0 | Cons branch tail => add (count branch) (total tail) end) branches))
    end;

def property_nat_list_equal : List Nat -> List Nat -> Bool :=
  fix same (left : List Nat) (right : List Nat) : Bool :=
    match left with
    | Nil => match right with | Nil => True | Cons _ _ => False end
    | Cons first rest =>
        match right with
        | Nil => False
        | Cons other tail =>
            match eqNat first other with
            | False => False
            | True => same rest tail
            end
        end
    end;

def property_scoped_laws (seed : Nat) (term : CoreTerm) : Maybe String :=
    let value : CoreTerm := property_scoped 2 0 (property_seed seed 101) in
    let first : Nat := property_choice seed 4 in
    let second : Nat := property_choice (property_seed seed 103) 4 in
    property_require (property_scope_valid term 0) "generator scope"
      (fun (_ : Unit) => property_require (property_equal (lift 0 term) term) "zero lift"
      (fun (_ : Unit) => property_require (property_equal (lift 3 term) term) "closed lift"
      (fun (_ : Unit) => property_require
        (property_equal (lift first (lift second term)) (lift (add first second) term)) "lift composition"
      (fun (_ : Unit) => property_require (property_equal (subst value term) term) "closed substitution"
      (fun (_ : Unit) => property_require (property_equal (subst value (lift 1 term)) term) "substitution after lift"
      (fun (_ : Unit) => property_require
        (property_nat_list_equal (property_globals (lift 2 term)) (property_globals term))
        "lift preserves globals" (fun (_ : Unit) => Nothing String)))))));
