-- Each predicate alone activates the shared metadata roots, without FS_KIND.
import "../compiler/native/managed_fs_predicates.ouro";
import "../compiler/driver.ouro";
import "compiler_startup_test_support.ouro";

def predicate_helper_prefix : String :=
    prim_string_concat
      "intrinsic Effect : Type -> Type := \"ouro.runtime\"; intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic Byte : Type := \"ouro.u8\"; intrinsic Word : Type := \"ouro.u32\"; intrinsic Size : Type := \"ouro.usize\"; intrinsic Text : Type := \"ouro.string\"; inductive Boolean : Type := | No : Boolean | Yes : Boolean; representation Boolean := \"ouro.bool\"; "
      "intrinsic pure : (A : Type) -> A -> Effect A := \"ouro.runtime.pure\"; axiom word : Word; axiom byte : Byte; axiom pointer : Pointer Byte; def raw_pages_allocate (bytes : Size) (alignment : Size) : Effect (Pointer Byte) := pure (Pointer Byte) pointer; def raw_pages_release (buffer : Pointer Byte) : Effect Boolean := pure Boolean Yes; def raw_windows_utf8_to_utf16 (source : Pointer Byte) (bytes : Size) (target : Pointer Byte) (units : Size) (written : Pointer Word) : Effect Word := pure Word word; ";

def predicate_helper_source (predicate : PrimitiveId) (mode : Nat) : String :=
    prim_string_concat predicate_helper_prefix (prim_string_concat
      (prim_string_concat "intrinsic query : Text -> Effect Boolean := \""
        (prim_string_concat (prim_string_of_char_codes (primitive_key predicate)) "\"; "))
      (match eqNat mode 1 with | True => ""
       | False => match eqNat mode 2 with
         | True => "axiom raw_windows_file_metadata : Pointer Byte -> Size -> Pointer Byte -> Effect Word;"
         | False => match eqNat mode 3 with
           | True => "def raw_windows_file_metadata (path : Pointer Byte) (units : Size) (output : Pointer Word) : Effect Word := pure Word word;"
           | False => "def raw_windows_file_metadata (path : Pointer Byte) (units : Size) (output : Pointer Byte) : Effect Word := pure Word word;"
           end end end));

def predicate_helper_probe (predicate : PrimitiveId) (mode : Nat) : Bool :=
    match compile_checked_source (mul 100 50) (prim_string_to_char_codes (predicate_helper_source predicate mode)) with
    | CErr _ => False | COk program =>
      let compiler : ManagedCompiler := ManagedCompilerOf program ([] : List Nat) 0 0 0 0 0 0 ([] : List LowerContract)
        (check_environment_from_entries (checked_program_entries program)) in
      match managed_fs_kind_roots compiler primitive_default_fuel with
      | Right roots => andb (eqNat mode 0) (eqNat (length Nat roots) 4)
      | Left error => match error with
        | LowerUnknownGlobal _ => eqNat mode 1 | LowerBodyMismatch _ => eqNat mode 2 | LowerMetadataMismatch _ => eqNat mode 3
        | LowerResourceExhausted => False | LowerInvalidCall _ => False | LowerDeclarationFailure _ _ _ => False
        | LowerUnsupportedType _ => False | LowerUnsupportedTerm _ => False | LowerUnsupportedPrimitive _ => False
        | LowerUnboundLocal _ => False | LowerEffectMismatch => False | LowerInvalidEntry _ => False
        | LowerMirFailure _ => False | LowerBackendFailure _ => False end end end;

def main : IO Unit :=
    startup_test_run (concat_map PrimitiveId StartupTest (fun (predicate : PrimitiveId) =>
      let key : String := prim_string_of_char_codes (primitive_key predicate) in
      ([startup_test_assert (prim_string_concat key " alone resolves all four checked metadata helpers") (predicate_helper_probe predicate 0),
        startup_test_assert (prim_string_concat key " rejects an absent metadata helper") (predicate_helper_probe predicate 1),
        startup_test_assert (prim_string_concat key " rejects an axiom metadata helper") (predicate_helper_probe predicate 2),
        startup_test_assert (prim_string_concat key " rejects a wrong metadata pointer type") (predicate_helper_probe predicate 3)] : List StartupTest))
      ([PrimitiveFileExists, PrimitiveFileIsDirectory] : List PrimitiveId));
