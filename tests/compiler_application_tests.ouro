-- Application argument context must come from the callee's declared domain.
-- The list arguments intentionally have no expression type ascriptions.

import "../std/test.ouro";

def application_test_take (values : List Nat) : Nat := length Nat values;

def application_test_local (consume : List Nat -> Nat) : Nat :=
    consume [1, 2, 3];

def application_test_identity (A : Type) (value : A) : A := value;

def application_test_just : Maybe (List Nat) := Just (List Nat) [1, 2];

def application_test_nested (outer : Bool) (inner : Bool) : Maybe (List Nat) :=
    match outer with
    | True => Just (List Nat) [1]
    | False =>
        match inner with
        | True => Just (List Nat) [2, 3]
        | False => Nothing (List Nat)
        end
    end;

def application_test_maybe_length (value : Maybe (List Nat)) : Nat :=
    match value with
    | Nothing => 0
    | Just values => length Nat values
    end;

inductive ApplicationTestBox (A : Type) : Type :=
    | ApplicationTestValue : A -> ApplicationTestBox A;

def application_test_box : ApplicationTestBox (List Nat) :=
    ApplicationTestValue (List Nat) [1, 2, 3];

def application_test_box_length : Nat :=
    match application_test_box with
    | ApplicationTestValue values => length Nat values
    end;

def application_test_pair : Pair (List Nat) (List Bool) :=
    MkPair (List Nat) (List Bool) [1] [True, False];

def application_test_pair_lengths : Nat :=
    match application_test_pair with
    | MkPair numbers flags => add (length Nat numbers) (length Bool flags)
    end;

def application_test_local_alias : Nat :=
    let consume : List Nat -> Nat := application_test_take in
    consume [1, 2];

def application_test_curried_lambda : List Nat :=
    (fun (A : Type) (values : List A) => values) Nat [1, 2];

def application_test_io_values : IO (List Nat) := io_pure (List Nat) [1, 2, 3];

def application_test_io_flags : IO (List Bool) := io_pure (List Bool) [True];

-- @entry main
def main : IO Unit :=
    (do let! values := application_test_io_values;
       let! flags := application_test_io_flags;
       test_run
         [ assert_eq "global list argument" (str_of_nat (application_test_take [1, 2])) "2"
         , assert_eq "empty list argument" (str_of_nat (application_test_take [])) "0"
         , assert_eq "local function argument"
             (str_of_nat (application_test_local application_test_take)) "3"
         , assert_eq "generic global argument"
             (str_of_nat (length Nat (application_test_identity (List Nat) [1, 2]))) "2"
         , assert_eq "explicit lambda argument"
             (str_of_nat ((fun (items : List Nat) => length Nat items) [1, 2])) "2"
         , assert_eq "curried lambda substitutes type parameter"
             (str_of_nat (length Nat application_test_curried_lambda)) "2"
         , assert_eq "generic constructor argument"
             (str_of_nat (application_test_maybe_length application_test_just)) "2"
         , assert_eq "nested match true list argument"
             (str_of_nat (application_test_maybe_length (application_test_nested True False))) "1"
         , assert_eq "nested match false list argument"
             (str_of_nat (application_test_maybe_length (application_test_nested False True))) "2"
         , assert_eq "nested match absent value"
             (str_of_nat (application_test_maybe_length (application_test_nested False False))) "0"
         , assert_eq "user constructor argument" (str_of_nat application_test_box_length) "3"
         , assert_eq "constructor arguments use distinct domains"
             (str_of_nat application_test_pair_lengths) "3"
         , assert_eq "annotated local callee" (str_of_nat application_test_local_alias) "2"
         , assert_eq "nested list element context"
             (str_of_nat (length (List Nat) [[1], [2, 3]])) "2"
         , assert_eq "higher-order generic application"
             (str_of_nat (length Nat (map Nat Nat (fun (n : Nat) => S n) [1, 2, 3]))) "3"
         , assert_eq "IO retains list Nat payload" (str_of_nat (length Nat values)) "3"
         , assert_eq "IO retains distinct list Bool payload" (str_of_nat (length Bool flags)) "1"
         ]);
