-- Shared checked-program identifier, binding and C-shim lookup used by
-- compiler and native source tests.
import "../compiler/driver.ouro",
  "../compiler/checked_program_output.ouro",
  "../std/listx.ouro";

def compiler_test_name (program : CheckedProgram) (name : String) : Maybe Nat :=
    match checked_program_intern program with | MkIntern names _ _ _ => source_lookup_id(names, prim_string_to_char_codes name) end;

def compiler_test_runtime_binding (program : CheckedProgram) (name : Nat) (expected : PrimitiveId) : Bool :=
    (fix find (entries : List Entry) : Bool :=
      match entries with | Nil => False | Cons entry rest => match entry with
        | MkBoundEntry id _ binding => match eqNat id name with | False => find rest | True =>
          match binding with | PrimitiveExternBinding _ => False
          | PrimitiveIntrinsicBinding actual mode gc specialization =>
            andb (primitive_id_equal actual expected)
              (andb (match mode with | PrimitiveRuntimeAction => True | PrimitivePureValue => False | PrimitiveTypeOnly => False end)
                (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                  (match specialization with | Nothing => True | Just _ => False end))) end end
        | MkEntry _ _ _ => find rest | MkIndEntry _ _ => find rest | MkRoleEntry _ => find rest end end)
      (checked_program_entries program);

def compiler_test_c_shim (program : CheckedProgram) (name : Nat) (key : String) : Bool :=
    any (Pair(Nat, List Nat)) (fun (pair : Pair Nat (List Nat)) => match pair with | MkPair id bytes =>
      andb(eqNat id name, primitive_bytes_equal(bytes, prim_string_to_char_codes key)) end) (checked_program_c_shims program);

def compiler_test_unit (path : String) (source : String) : Pair (List Nat) (List Nat) :=
    MkPair(List Nat, List Nat, prim_string_to_char_codes path, prim_string_to_char_codes source);
