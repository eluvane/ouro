-- Foreground process authority requires exact checked OS-status/exit types.
import "../compiler/driver.ouro";
import "compiler_startup_test_support.ouro";

def inherit_binding_prefix : String :=
    prim_string_concat
      "intrinsic Action : Type -> Type := \"ouro.runtime\"; intrinsic Text : Type := \"ouro.string\"; inductive Count : Type := | Zero : Count | Next : Count -> Count; representation Count := \"ouro.nat\"; "
      "inductive Chain (A : Type) : Type := | End : Chain A | Link : A -> Chain A -> Chain A; representation Chain := \"ouro.list\"; inductive Couple (A : Type) (B : Type) : Type := | Both : A -> B -> Couple A B; representation Couple := \"ouro.pair\"; def Deferred (A : Type) : Type := Action A; def Name : Type := Text; def Reply : Type := Couple Count Count; ";

def inherit_binding_compile (source : String) : CompResult CheckedProgram :=
    compile_checked_source (mul 100 50)
      (prim_string_to_char_codes (prim_string_concat inherit_binding_prefix source));

def inherit_binding_selected (source : String) : Bool :=
    match inherit_binding_compile source with
    | CErr _ => False
    | COk program =>
        (fix find (entries : List Entry) : Bool :=
          match entries with | Nil => False | Cons entry rest =>
            match entry with
            | MkBoundEntry _ _ binding =>
                match binding with
                | PrimitiveExternBinding _ => find rest
                | PrimitiveIntrinsicBinding id mode gc specialization =>
                    match primitive_id_equal id PrimitiveProcessInherit with
                    | False => find rest
                    | True =>
                        andb (match mode with | PrimitiveRuntimeAction => True
                          | PrimitivePureValue => False | PrimitiveTypeOnly => False end)
                          (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                            (match specialization with | Nothing => True | Just _ => False end))
                    end
                end
            | MkEntry _ _ _ => find rest
            | MkIndEntry _ _ => find rest
            | MkRoleEntry _ => find rest
            end
          end) (checked_program_entries program)
    end;

def inherit_binding_rejected (source : String) : Bool :=
    match inherit_binding_compile source with
    | COk _ => False
    | CErr error => match error with | ErrCode code _ => eqNat code 42 end
    end;

def main : IO Unit :=
    startup_test_run
      [startup_test_assert "inherited process is an allocating Runtime action"
         (inherit_binding_selected "intrinsic run : Text -> Chain Text -> Action (Couple Count Count) := \"ouro.process.inherit\";"),
       startup_test_assert "inherited process accepts transparent aliases"
         (inherit_binding_selected "intrinsic renamed : Name -> Chain Name -> Deferred Reply := \"ouro.process.inherit\";"),
       startup_test_assert "inherited process rejects a pure result"
         (inherit_binding_rejected "intrinsic run : Text -> Chain Text -> Reply := \"ouro.process.inherit\";"),
       startup_test_assert "inherited process rejects a merged status"
         (inherit_binding_rejected "intrinsic run : Text -> Chain Text -> Action Count := \"ouro.process.inherit\";"),
       startup_test_assert "inherited process rejects capture-shaped streams"
         (inherit_binding_rejected "intrinsic run : Text -> Chain Text -> Action (Couple Count (Couple Text Text)) := \"ouro.process.inherit\";"),
       startup_test_assert "inherited process rejects scalar argv"
         (inherit_binding_rejected "intrinsic run : Text -> Text -> Action Reply := \"ouro.process.inherit\";"),
       startup_test_assert "inherited process rejects non-String arguments"
         (inherit_binding_rejected "intrinsic run : Text -> Chain Count -> Action Reply := \"ouro.process.inherit\";"),
       startup_test_assert "inherited process rejects missing executable"
         (inherit_binding_rejected "intrinsic run : Chain Text -> Action Reply := \"ouro.process.inherit\";")];
