    , MkPair String Bool "native-ci/report-refuse-hidden-null-gate"
        (sibling_test_host_reject_value "gates"
          (JArr [check_json (gate_check "first" []), JNull]))
    , MkPair String Bool "native-ci/report-refuse-nonboolean-gate-blocking"
        (all Json (sibling_test_host_reject_gate_value "blocking")
