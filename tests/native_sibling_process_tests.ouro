    , MkPair String Bool "native-ci/report-refuse-nonarray-gate-metrics"
        (all Json (sibling_test_host_reject_gate_value "metrics")
          [JNull, JBool True, JNum "1", JStr "metrics", JObj []])
    , MkPair String Bool "native-ci/report-refuse-malformed-metric"
        (all Json sibling_test_host_reject_metric
          [ JNull, JBool True, JNum "1", JStr "metric", JArr [], JObj []
          , JObj [json_kv "name" (JStr "rows")]
          , JObj [json_kv "value" (JStr "1")]
          , JObj [json_kv "name" JNull, json_kv "value" (JStr "1")]
          , JObj [json_kv "name" (JStr "rows"), json_kv "value" (JNum "1")]
          , JObj [json_kv "name" (JStr "rows"), json_kv "value" (JStr "1"),
              json_kv "value" JNull] ])
    , MkPair String Bool "native-ci/report-refuse-pass-with-gate-issues"
