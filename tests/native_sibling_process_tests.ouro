          (issues_json [gate_issue "fixture failed" "fixture"]))
    , MkPair String Bool "native-ci/report-refuse-nonarray-gate-issues"
        (all Json (sibling_test_host_reject_gate_value "issues")
          [JNull, JBool True, JNum "0", JStr "[]", JObj []])
    , MkPair String Bool "native-ci/report-refuse-summary-issues"
        (sibling_test_host_reject_value "issues"
          (issues_json [gate_issue "fixture failed" "fixture"]))
    , MkPair String Bool "native-ci/report-refuse-nonarray-summary-issues"
        (all Json (sibling_test_host_reject_value "issues")
          [JNull, JBool True, JNum "0", JStr "[]", JObj []])
    , MkPair String Bool "native-ci/report-refuse-duplicate-report-field"
        (notb (host_bound_validation_report_text_ok
          (json_print (JObj (snoc (Pair String Json) sibling_test_host_fields
            (json_kv "pass" (JBool False)))))))
    , MkPair String Bool "native-ci/report-refuse-duplicate-gate-field"
        (sibling_test_host_reject_gate
          (JObj (snoc (Pair String Json) sibling_test_host_gate_fields
            (json_kv "status" (JStr "fail")))))
    , MkPair String Bool "native-ci/report-refuse-missing-contract-fields"
        (all String (fun (key : String) =>
          notb (host_bound_validation_report_text_ok (sibling_test_host_without key)))
          ["kind", "version", "profile", "execution_backend", "execution_mode", "issues"])
    , MkPair String Bool "native-ci/report-refuse-wrong-kind"
        (sibling_test_host_reject_value "kind" (JStr "ouro.ci-gate-report.v1"))
    , MkPair String Bool "native-ci/report-refuse-wrong-version"
        (sibling_test_host_reject_value "version" (JStr "2"))
    , MkPair String Bool "native-ci/report-refuse-wrong-profile"
        (sibling_test_host_reject_value "profile" (JStr "control-plane"))
    , MkPair String Bool "native-ci/report-refuse-wrong-backend"
