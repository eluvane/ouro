-- Pure subprocess routing and LSP/package verdict regression laws.
import "analyze/precision/assertions.ouro",
  "../tools/lsp_process_model.ouro",
  "../tools/ci_gate/native_host_bound_model.ouro",
  "../tools/repo_gate/report.ouro";

def sibling_test_right (status : Nat) (output : String) (error : String) : Either NativeSiblingError ProcResult :=
    Right NativeSiblingError ProcResult (MkProcResult status output error);

def sibling_test_command (image : String) (name : String) (arguments : List String)
    (program : String) (expected : List String) : Bool :=
    match native_sibling_command image name arguments with
    | Left _ => False
    | Right command => andb (str_eq(command_program command, program))
        (list_eq String str_eq (command_args command) expected)
    end;

def sibling_test_checked_command (image : String) (arguments : List String)
    (program : String) : Bool :=
    match native_sibling_command_checked (Right ExecutablePathError String image)
        "ouro-native-build.exe" arguments with
    | Left _ => False
    | Right command => andb (str_eq(command_program command, program))
        (list_eq String str_eq (command_args command) arguments)
    end;

def sibling_test_checked_image_error (cause : ExecutablePathError) : Bool :=
    match native_sibling_command_checked (Left ExecutablePathError String cause)
        "ouro-native-build.exe" ["--coil-dispatch", "check", "source.ouro"] with
    | Right _ => False
    | Left error => if let NativeSiblingImageError actual := (error : NativeSiblingError) then
        str_eq(executable_path_error_message actual, executable_path_error_message cause)
      else False
    end;

def sibling_test_checked_no_parent (image : String) : Bool :=
    match native_sibling_command_checked (Right ExecutablePathError String image)
        "ouro-native-build.exe" ["--coil-dispatch", "check", "source.ouro"] with
    | Right _ => False
    | Left error => if let NativeSiblingParentError actual := (error : NativeSiblingError) then str_eq actual image else False
    end;

def sibling_test_no_parent (image : String) : Bool :=
    match native_sibling_command image "coil.exe" (native_sibling_check_args "source.ouro") with
    | Right _ => False
    | Left error => if let NativeSiblingParentError actual := (error : NativeSiblingError) then str_eq actual image else False
    end;

def sibling_test_diagnostic (path : String) (result : Either NativeSiblingError ProcResult)
    (code : String) (severity : Nat) (line : Nat) (column : Nat) (message : String) : Bool :=
    match lsp_process_diagnostics path result with
    | Nil => False
    | Cons diagnostic tail =>
        let start : Json := json_field(json_field diagnostic "range", "start") in
        andb (nullb Json tail)
          (andb (str_eq(json_field_str diagnostic "code" "", code))
            (andb (eq_nat(json_field_nat diagnostic "severity" 99, severity))
              (andb (eq_nat(json_field_nat start "line" 99, line))
                (andb (eq_nat(json_field_nat start "character" 99, column))
                  (str_eq(json_field_str diagnostic "message" "", message))))))
    end;

def sibling_test_format_null (result : Either NativeSiblingError ProcResult) : Bool :=
    str_eq(json_print (lsp_process_format "before" result), "null");

def sibling_test_limits (limits : ProcessCaptureLimits) (expected : Nat) : Bool :=
    let (ProcessCaptureLimitsOf timeout memory cpu output error) := limits in
    andb (eq_nat timeout expected)
      (andb (eq_nat(memory, mul 12 256))
        (andb (eq_nat cpu 1)
          (andb(eq_nat(output, mul(256, mul 256 256)), eq_nat error output))));

def sibling_test_uri (path : String) (expected : String) : Bool :=
    andb (str_eq(path_to_uri path, expected))
      (match uri_file_path expected with
      | Nothing => False
      | Just decoded => str_eq decoded (path_normalize path)
      end);

def sibling_test_symbol_uri_runs : Bool :=
    let symbol : String -> String -> Nat -> Sym :=
      fun (path : String) (name : String) (line : Nat) =>
        MkSym path (MkDecl "def" name "" (Nil String) line) in
    let empty : Sym := symbol "" "keep_empty" 0 in
    let first : Sym := symbol "/one/main #.ouro" "keep_first" 1 in
    let same : Sym := symbol "/one/main #.ouro" "keep_second" 5 in
    let other : Sym := symbol "/two/main #.ouro" "keep_first" 3 in
    let skipped : Sym := symbol "/one/skip.ouro" "skip" 2 in
    let syms : List Sym := [empty, first, skipped, same, other, first, empty] in
    let items : List Sym -> String := fun (xs : List Sym) =>
      json_print (JArr (map Sym Json document_symbol_item xs)) in
    andb (str_eq (json_print (workspace_symbol_result "keep" syms))
            (items [empty, first, same, other, first, empty]))
      (str_eq (json_print (document_symbol_result "main #.ouro" syms))
        (items [first, same, other, first]));

def sibling_test_lsp_range (range : Json) (first : Nat) (last : Nat) : Bool :=
    let start : Json := json_field range "start" in
    let finish : Json := json_field range "end" in
    andb (eq_nat(json_field_nat start "line" 99, 0))
      (andb (eq_nat(json_field_nat finish "line" 99, 0))
        (andb (eq_nat(json_field_nat start "character" 99, first))
          (eq_nat(json_field_nat finish "character" 99, last))));

def sibling_test_lsp_positioned (text : String) (column : Nat)
    (first : Nat) (last : Nat) : Bool :=
    let diagnostic : Json := lsp_diagnostic_utf16 (str_lines text)
      (diag_of "OURO-POSITION" (JNum "1") 0 column "positioned error") in
    andb (str_eq(json_field_str diagnostic "code" "", "OURO-POSITION"))
      (andb (str_eq(json_field_str diagnostic "message" "", "positioned error"))
        (sibling_test_lsp_range (json_field diagnostic "range") first last));

def sibling_test_lsp_decoded_widths : Bool :=
    let line : String := str_of_codes [127, 194, 128, 239, 191, 191, 240, 144, 128, 128, 255] in
    andb (maybe Nat Bool False (eq_nat 6) (lsp_byte_column line 4))
      (andb (maybe Nat Bool False (eq_nat 2) (lsp_utf16_column line 2 True))
        (andb (maybe Nat Bool False (eq_nat 3) (lsp_utf16_column line 8 False))
          (andb (maybe Nat Bool False (eq_nat 5) (lsp_utf16_column line 8 True))
            (match lsp_byte_column line 6 with
             | Just _ => False
             | Nothing => match lsp_utf16_column line 11 False with
               | Just _ => False | Nothing => True end
             end))));

def sibling_test_lsp_completion (text : String) (column : Nat) : Bool :=
    let symbols : List Sym :=
      [ MkSym "C:/work/main.ouro" (MkDecl "def" "target" "def target : Nat" [] 1)
      , MkSym "C:/work/main.ouro" (MkDecl "def" "other" "def other : Nat" [] 2) ] in
    if let JArr items := (completion_result text 0 column symbols : Json) then
      match items with
      | Cons item rest => andb (nullb Json rest)
          (str_eq(json_field_str item "label" "", "target"))
      | Nil => False
      end
    else False;

def sibling_test_native_host_command (located : Either ExecutablePathError String)
    (root : String) (out : String) (program : String) : Bool :=
    match native_sibling_command_checked located native_host_bound_sibling
        (native_host_bound_validation_argv root out) with
    | Left _ => False
    | Right command => andb (str_eq(command_program command, program))
        (list_eq String str_eq (command_args command)
          ["--profile", "control-plane-native", "--root", root, "--out", out])
    end;

def sibling_test_native_host_error (located : Either ExecutablePathError String)
    (message : String) : Bool :=
    match native_sibling_command_checked located native_host_bound_sibling
        (native_host_bound_validation_argv "." "_build/native-ci") with
    | Right _ => False
    | Left error => str_eq(native_sibling_error_message error, message)
    end;

def sibling_test_native_host_cli (raw : List String) : Bool :=
    native_host_bound_cli_valid raw (args_of_argv_bools native_host_bound_switches raw);

def sibling_test_host_fields : List (Pair String Json) :=
    if let JObj fields := (gate_report_json "control-plane-native"
        [gate_check "native-host-bound-fixture" []] : Json) then
      fields
    else [];

def sibling_test_host_replace (key : String) (value : Json) : String :=
    json_print (JObj (map (Pair String Json) (Pair String Json)
      (fun (field : Pair String Json) => let (MkPair name old) := field in
        MkPair String Json name
          (match str_eq name key with | True => value | False => old end)) sibling_test_host_fields));

def sibling_test_host_without (key : String) : String :=
    json_print (JObj (filter (Pair String Json)
      (fun (field : Pair String Json) => let (MkPair name _) := field in notb (str_eq name key)) sibling_test_host_fields));

def sibling_test_host_reject_value (key : String) (value : Json) : Bool :=
    notb (host_bound_validation_report_text_ok (sibling_test_host_replace key value));

def sibling_test_host_gate_fields : List (Pair String Json) :=
    if let JObj fields := (check_json (gate_check "native-host-bound-fixture" []) : Json) then
      fields
    else [];

def sibling_test_host_gate_replace (key : String) (value : Json) : Json :=
    JObj (map (Pair String Json) (Pair String Json)
      (fun (field : Pair String Json) => let (MkPair name old) := field in
        MkPair String Json name
          (match str_eq name key with | True => value | False => old end)) sibling_test_host_gate_fields);

def sibling_test_host_gate_without (key : String) : Json :=
    JObj (filter (Pair String Json)
      (fun (field : Pair String Json) => let (MkPair name _) := field in notb (str_eq name key)) sibling_test_host_gate_fields);

def sibling_test_host_reject_gate (gate : Json) : Bool :=
    sibling_test_host_reject_value "gates" (JArr [gate]);

def sibling_test_host_reject_gate_value (key : String) (value : Json) : Bool :=
    sibling_test_host_reject_gate (sibling_test_host_gate_replace key value);

def sibling_test_host_reject_gate_missing (key : String) : Bool :=
    sibling_test_host_reject_gate (sibling_test_host_gate_without key);

def sibling_test_host_reject_metric (metric : Json) : Bool :=
    sibling_test_host_reject_gate_value "metrics" (JArr [metric]);

def sibling_test_host_missing_report : Bool :=
    let result : CiResult := host_bound_result False
      (host_bound_effective_code True False 0) "log" "gate" "validation" True False in
    andb (str_eq(ci_result_status result, "fail"))
      (andb (ci_result_required result)
        (andb (ci_result_blocking result)
          (eq_nat(host_bound_effective_code True False 0, 1))));

def sibling_test_host_captured_result : Bool :=
    let status : Nat := sub process_capture_u32_bound 1 in
    let output : String := str_of_codes [111, 117, 116, 0, 255, 13, 10] in
    let error : String := str_of_codes [101, 114, 114, 0, 254, 10] in
    let result : ProcResult := native_host_bound_process_result
      (sibling_test_right status output error) in
    andb (eq_nat(proc_code result, status))
      (andb (str_eq(proc_stdout result, output))
        (str_eq(proc_stderr result, error)));


def native_sibling_process_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-sibling/command-drive"
        (sibling_test_command "C:/release/ouro-lsp.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:/release/coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-backslash"
        (sibling_test_command "C:\\release\\ouro-pkg.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:\\release\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-drive-root"
        (sibling_test_command "C:\\ouro-lsp.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-unc"
        (sibling_test_command "\\\\host\\share\\toolchain\\ouro-lsp.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "\\\\host\\share\\toolchain\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-extended"
        (sibling_test_command "\\\\?\\C:\\toolchain\\renamed.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "\\\\?\\C:\\toolchain\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-extended-unc"
        (sibling_test_command "\\\\?\\UNC\\host\\share\\renamed.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "\\\\?\\UNC\\host\\share\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-unicode"
        (sibling_test_command "C:/Каталог 雪😀/renamed.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:/Каталог 雪😀/coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/checked-loaded-image-command"
        (sibling_test_checked_command "C:\\release 雪\\coil.exe"
          (["--coil-dispatch", "run", "space/../main.ouro", "", "a\"b", "tail\\", "&|<>"] : List String)
          "C:\\release 雪\\ouro-native-build.exe")
    , MkPair String Bool "native-sibling/checked-image-query-failure"
        (sibling_test_checked_image_error ExecutablePathQueryFailed)
    , MkPair String Bool "native-sibling/checked-image-cleanup-cause"
        (sibling_test_checked_image_error
          (ExecutablePathCleanupFailed (Just ExecutablePathError ExecutablePathQueryFailed)))
    , MkPair String Bool "native-sibling/checked-image-empty"
        (sibling_test_checked_no_parent "")
    , MkPair String Bool "native-sibling/checked-image-no-parent"
        (sibling_test_checked_no_parent "coil.exe")
    , MkPair String Bool "native-sibling/no-parent-empty"
        (sibling_test_no_parent "")
    , MkPair String Bool "native-sibling/no-parent-bare-image"
        (sibling_test_no_parent "ouro-lsp.exe")
    , MkPair String Bool "native-sibling/check-args-literal"
        (list_eq(String, str_eq, native_sibling_check_args "C:\\source 雪\\a & b.ouro", ["check", "C:\\source 雪\\a & b.ouro"] : List String))
    , MkPair String Bool "native-sibling/fmt-args-no-command-prefix"
        (list_eq(String, str_eq, native_sibling_format_args "C:\\source 雪\\scratch", ["C:\\source 雪\\scratch"] : List String))
    , MkPair String Bool "native-sibling/verify-stdout-marker"
        (native_sibling_check_ok (MkProcResult 0 "CHECK_OK\n" ""))
    , MkPair String Bool "native-sibling/verify-stderr-marker"
        (native_sibling_check_ok (MkProcResult 0 "" "CHECK_OK\n"))
    , MkPair String Bool "native-sibling/verify-nonzero-with-marker"
        (notb (native_sibling_check_ok (MkProcResult 259 "CHECK_OK\n" "")))
    , MkPair String Bool "native-sibling/verify-missing-marker"
        (notb (native_sibling_check_ok (MkProcResult 0 "" "")))
    , MkPair String Bool "native-sibling/verify-rejected-after-marker"
        (notb (native_sibling_check_ok (MkProcResult 0 "CHECK_OK\nCHECK_FAIL: no\n" "")))
    , MkPair String Bool "native-sibling/verify-stderr-rejection"
        (notb (native_sibling_check_ok (MkProcResult 0 "CHECK_OK\n" "CHECK_FAIL: no\n")))
    , MkPair String Bool "native-sibling/verify-case-sensitive-marker"
        (notb (native_sibling_check_ok (MkProcResult 0 "check_ok\n" "")))
    , MkPair String Bool "native-sibling/lsp-check-timeout"
        (sibling_test_limits(lsp_check_process_limits, mul(30, mul 10 100)))
    , MkPair String Bool "native-sibling/lsp-fmt-timeout"
        (sibling_test_limits(lsp_format_process_limits, mul(10, mul 10 100)))
    , MkPair String Bool "native-sibling/pkg-verify-timeout-policy"
        (sibling_test_limits(native_sibling_limits (mul(120, mul 10 100)), mul(120, mul 10 100)))
    , MkPair String Bool "native-sibling/lsp-clean-marker"
        (nullb(Json, lsp_process_diagnostics("C:/work/main.ouro", sibling_test_right 0 "CHECK_OK\n" "")))
    , MkPair String Bool "native-sibling/lsp-clean-marker-crlf"
        (nullb(Json, lsp_process_diagnostics("C:/work/main.ouro", sibling_test_right 0 "CHECK_OK\r\n" "")))
    , MkPair String Bool "native-sibling/lsp-marker-across-streams"
        (nullb(Json, lsp_process_diagnostics("C:/work/main.ouro", sibling_test_right 0 "runner detail\nCHECK_" "OK\n")))
    , MkPair String Bool "native-sibling/lsp-rejection-marker-without-diagnostic"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 0 "CHECK_OK\n" "runner detail: CHECK_FAIL\n")
          "CHECK_PROTOCOL" 1 0 0 "native checker exited 0 without a successful CHECK_OK verdict")
    , MkPair String Bool "native-sibling/lsp-clean-marker-with-failed-status"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 2 "CHECK_OK\n" "") "CHECK_FAIL" 1 0 0 "CHECK_OK")
    , MkPair String Bool "native-sibling/lsp-clean-marker-with-stderr-warning"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 0 "CHECK_OK\n"
          "OURO-STYLE warning C:/work/main.ouro:7:2 style note\n") "OURO-STYLE" 2 6 1 "style note")
    , MkPair String Bool "native-sibling/lsp-native-rejection"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "" "coil: source 41:3\n") "CHECK_FAIL" 1 0 0 "coil: source 41:3")
    , MkPair String Bool "native-sibling/lsp-unparsed-empty-failure"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 42 "" "") "CHECK_FAIL" 1 0 0 "native checker exited 42")
    , MkPair String Bool "native-sibling/lsp-unparsed-whitespace-failure"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 42 " \r\n" "\t \n") "CHECK_FAIL" 1 0 0 "native checker exited 42")
    , MkPair String Bool "native-sibling/lsp-preserve-check-fail"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "CHECK_FAIL: rejected declaration\n" "") "CHECK_FAIL" 1 0 0 "rejected declaration")
    , MkPair String Bool "native-sibling/lsp-preserve-indented-check-fail"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "runner detail\r\n"
          " \tCHECK_FAIL:\t rejected declaration \t\r\n") "CHECK_FAIL" 1 0 0 "rejected declaration")
    , MkPair String Bool "native-sibling/lsp-preserve-positioned"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "OURO-TYPE error C:/work/main.ouro:3:5 type mismatch\n" "") "OURO-TYPE" 1 2 4 "type mismatch")
    , MkPair String Bool "native-sibling/lsp-location-retains-path-colons"
        (sibling_test_diagnostic "/workspace/part:main.ouro" (sibling_test_right 1
          "OURO-TYPE  error /workspace/part:main.ouro:0:5 type  mismatch\r\n" "") "OURO-TYPE" 1 0 4 "type mismatch\r")
    , MkPair String Bool "native-sibling/lsp-preserve-warning"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 0 "CHECK_OK\nOURO-STYLE warning C:/work/main.ouro:7:2 style note\n" "") "OURO-STYLE" 2 6 1 "style note")
    , MkPair String Bool "native-sibling/lsp-zero-without-verdict"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 0 "" "") "CHECK_PROTOCOL" 1 0 0 "native checker exited 0 without a successful CHECK_OK verdict")
    , MkPair String Bool "native-sibling/lsp-preserve-foreign-diagnostic-filter"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "OURO-TYPE error C:/work/imported.ouro:3:5 elsewhere\n" "") "CHECK_FAIL" 1 0 0 "OURO-TYPE error C:/work/imported.ouro:3:5 elsewhere")
    , MkPair String Bool "native-sibling/lsp-unknown-name-unmatched-path"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "OURO-NAME error <input>:1:20 unknown name no_such_name\n" "") "CHECK_FAIL" 1 0 0 "OURO-NAME error <input>:1:20 unknown name no_such_name")
    , MkPair String Bool "native-sibling/lsp-unknown-name-check-fail"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "" "CHECK_FAIL: front end rejected the input\nouro1: CErr tag=0 n=1\nouro1: CErr code=2 det=0\n") "CHECK_FAIL" 1 0 0 "front end rejected the input")
    , MkPair String Bool "native-sibling/lsp-tool-error-image-query"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingImageError ExecutablePathQueryFailed)) "TOOL_ERROR" 1 0 0 "current executable path: GetModuleFileNameW failed")
    , MkPair String Bool "native-sibling/fmt-error-null-image-query"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingImageError ExecutablePathQueryFailed)))
    , MkPair String Bool "native-sibling/lsp-tool-error-os"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureOsError 2))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process OS error=2")
    , MkPair String Bool "native-sibling/fmt-error-null-os"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureOsError 2))))
    , MkPair String Bool "native-sibling/lsp-tool-error-timeout"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureTimedOut 30 "partial" "error"))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process timeout=30 ms")
    , MkPair String Bool "native-sibling/fmt-error-null-timeout"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureTimedOut 30 "partial" "error"))))
    , MkPair String Bool "native-sibling/lsp-tool-error-cleanup"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureCleanupFailed 6))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process cleanup error=6")
    , MkPair String Bool "native-sibling/fmt-error-null-cleanup"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureCleanupFailed 6))))
    , MkPair String Bool "native-sibling/lsp-tool-error-output-cap"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureOutputLimit CaptureStdout 8 9))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: stdout bytes=9 exceeds cap=8")
    , MkPair String Bool "native-sibling/fmt-error-null-output-cap"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureOutputLimit CaptureStdout 8 9))))
    , MkPair String Bool "native-sibling/lsp-tool-error-memory"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureResourceLimit 10 64 "partial" "error"))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process memory event=10 peak_bytes=64")
    , MkPair String Bool "native-sibling/fmt-error-null-memory"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError("C:/tools/coil.exe", ProcessCaptureResourceLimit 10 64 "partial" "error"))))
    , MkPair String Bool "native-sibling/fmt-nonzero-is-null"
        (sibling_test_format_null (sibling_test_right 259 "partial output" "failure"))
    , MkPair String Bool "native-sibling/fmt-success-output"
        (str_eq(json_print (lsp_process_format("before", sibling_test_right 0 "after" "ignored warning")), json_print (format_edits "before" "after")))
    , MkPair String Bool "native-sibling/fmt-empty-success-output"
        (str_eq(json_print (lsp_process_format("before", sibling_test_right 0 "" "")), json_print (format_edits "before" "")))
    , MkPair String Bool "lsp/uri-ascii"
        (sibling_test_uri "C:/work/main.ouro" "file:///C:/work/main.ouro")
    , MkPair String Bool "lsp/uri-reserved-path-bytes"
        (sibling_test_uri "C:/work/%41#file?.ouro" "file:///C:/work/%2541%23file%3F.ouro")
    , MkPair String Bool "lsp/uri-unicode-and-space"
        (sibling_test_uri "C:/work/雪😀 space.ouro" "file:///C:/work/%E9%9B%AA%F0%9F%98%80%20space.ouro")
    , MkPair String Bool "lsp/uri-host-separators"
        (sibling_test_uri "C:\\work\\%41 #?.ouro" "file:///C:/work/%2541%20%23%3F.ouro")
    , MkPair String Bool "lsp/uri-posix-reserved-path-bytes"
        (sibling_test_uri "/work/%41#?.ouro" "file:///work/%2541%23%3F.ouro")
    , MkPair String Bool "lsp/symbol-uri-path-runs" sibling_test_symbol_uri_runs
    , MkPair String Bool "lsp/utf16-default-capability"
        (str_eq(json_field_str lsp_capabilities "positionEncoding" "", "utf-16"))
    , MkPair String Bool "lsp/import-group-semicolon-in-path"
        (precision_strings (imports_of "import \"a;b.ouro\", \"second.ouro\";")
          ["a;b.ouro", "second.ouro"])
    , MkPair String Bool "lsp/import-after-nul"
        (precision_strings (imports_of (str_cat3 "import \"first.ouro\";" (str_of_codes [0])
          "import \"second.ouro\";")) ["first.ouro", "second.ouro"])
    , MkPair String Bool "lsp/word-ascii"
        (str_eq(word_at "\"x\" target" 0 5, "target"))
    , MkPair String Bool "lsp/word-after-bmp"
        (str_eq(word_at "\"雪\" target" 0 5, "target"))
    , MkPair String Bool "lsp/word-after-non-bmp"
        (str_eq(word_at "\"😀\" target" 0 6, "target"))
    , MkPair String Bool "lsp/word-past-line-clamps"
        (str_eq(word_at "target" 0 99, "target"))
    , MkPair String Bool "lsp/word-and-prefix-at-punctuation"
        (andb (str_eq(word_in_line "f_2'.g" 4, "f_2'"))
          (andb (str_eq(prefix_in_line "f_2'.g" 3, "f_2"))
            (str_eq(word_in_line "f_2'.g" 5, "g"))))
    , MkPair String Bool "lsp/byte-column-past-line"
        (andb (str_null (word_in_line "target" 7)) (str_null (prefix_in_line "target" 7)))
    , MkPair String Bool "lsp/prepare-rename-empty-line"
        (str_eq(json_print (prepare_rename_result "" 0 0), "null"))
    , MkPair String Bool "lsp/prepare-rename-inside-surrogate-pair"
