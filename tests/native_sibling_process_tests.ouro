    , MkPair String Bool "native-ci/report-refuse-empty-gates"
        (sibling_test_host_reject_value "gates" (JArr []))
    , MkPair String Bool "native-ci/report-refuse-missing-gates"
        (notb (host_bound_validation_report_text_ok (sibling_test_host_without "gates")))
    , MkPair String Bool "native-ci/report-refuse-nonarray-gates"
        (all Json (sibling_test_host_reject_value "gates") [JObj [], JNull, JStr "gates"])
