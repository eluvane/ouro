-- Pure subprocess routing and LSP/package verdict regression laws.
import "analyze/precision/assertions.ouro";
import "../tools/lsp_process_model.ouro";

def sibling_test_right (status : Nat) (output : String) (error : String) : Either NativeSiblingError ProcResult :=
    Right NativeSiblingError ProcResult (MkProcResult status output error);

def sibling_test_command (image : String) (name : String) (arguments : List String)
    (program : String) (expected : List String) : Bool :=
    match native_sibling_command image name arguments with
    | Left _ => False
    | Right command => andb (str_eq (command_program command) program)
        (list_eq String str_eq (command_args command) expected)
    end;

def sibling_test_no_parent (image : String) : Bool :=
    match native_sibling_command image "coil.exe" (native_sibling_check_args "source.ouro") with
    | Right _ => False
    | Left error => match error with
      | NativeSiblingImageError _ => False
      | NativeSiblingParentError actual => str_eq actual image
      | NativeSiblingProcessError _ _ => False
      end
    end;

def sibling_test_diagnostic (path : String) (result : Either NativeSiblingError ProcResult)
    (code : String) (severity : Nat) (line : Nat) (column : Nat) (message : String) : Bool :=
    match lsp_process_diagnostics path result with
    | Nil => False
    | Cons diagnostic tail =>
        let start : Json := json_field (json_field diagnostic "range") "start" in
        andb (nullb Json tail)
          (andb (str_eq (json_field_str diagnostic "code" "") code)
            (andb (eq_nat (json_field_nat diagnostic "severity" 99) severity)
              (andb (eq_nat (json_field_nat start "line" 99) line)
                (andb (eq_nat (json_field_nat start "character" 99) column)
                  (str_eq (json_field_str diagnostic "message" "") message)))))
    end;

def sibling_test_format_null (result : Either NativeSiblingError ProcResult) : Bool :=
    str_eq (json_print (lsp_process_format "before" result)) "null";

def sibling_test_limits (limits : ProcessCaptureLimits) (expected : Nat) : Bool :=
    match limits with | ProcessCaptureLimitsOf timeout memory cpu output error =>
      andb (eq_nat timeout expected)
        (andb (eq_nat memory (mul 12 256))
          (andb (eq_nat cpu 1)
            (andb (eq_nat output (mul 256 (mul 256 256))) (eq_nat error output))))
    end;

def native_sibling_process_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-sibling/command-drive"
        (sibling_test_command "C:/release/ouro-lsp.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:/release/coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-backslash"
        (sibling_test_command "C:\\release\\ouro-pkg.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:\\release\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-drive-root"
        (sibling_test_command "C:\\ouro-lsp.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-unc"
        (sibling_test_command "\\\\host\\share\\toolchain\\ouro-lsp.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "\\\\host\\share\\toolchain\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-extended"
        (sibling_test_command "\\\\?\\C:\\toolchain\\renamed.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "\\\\?\\C:\\toolchain\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-extended-unc"
        (sibling_test_command "\\\\?\\UNC\\host\\share\\renamed.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "\\\\?\\UNC\\host\\share\\coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/command-unicode"
        (sibling_test_command "C:/Каталог 雪😀/renamed.exe" "coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String) "C:/Каталог 雪😀/coil.exe" (["check", "space 雪/../literal.ouro", "", "a\"b", "tail\\", "&|<>"] : List String))
    , MkPair String Bool "native-sibling/no-parent-empty"
        (sibling_test_no_parent "")
    , MkPair String Bool "native-sibling/no-parent-bare-image"
        (sibling_test_no_parent "ouro-lsp.exe")
    , MkPair String Bool "native-sibling/check-args-literal"
        (list_eq String str_eq (native_sibling_check_args "C:\\source 雪\\a & b.ouro") (["check", "C:\\source 雪\\a & b.ouro"] : List String))
    , MkPair String Bool "native-sibling/fmt-args-no-command-prefix"
        (list_eq String str_eq (native_sibling_format_args "C:\\source 雪\\scratch") (["C:\\source 雪\\scratch"] : List String))
    , MkPair String Bool "native-sibling/verify-stdout-marker"
        (native_sibling_check_ok (MkProcResult 0 "CHECK_OK\n" ""))
    , MkPair String Bool "native-sibling/verify-stderr-marker"
        (native_sibling_check_ok (MkProcResult 0 "" "CHECK_OK\n"))
    , MkPair String Bool "native-sibling/verify-nonzero-with-marker"
        (notb (native_sibling_check_ok (MkProcResult 259 "CHECK_OK\n" "")))
    , MkPair String Bool "native-sibling/verify-missing-marker"
        (notb (native_sibling_check_ok (MkProcResult 0 "" "")))
    , MkPair String Bool "native-sibling/verify-rejected-after-marker"
        (notb (native_sibling_check_ok (MkProcResult 0 "CHECK_OK\nCHECK_FAIL: no\n" "")))
    , MkPair String Bool "native-sibling/verify-stderr-rejection"
        (notb (native_sibling_check_ok (MkProcResult 0 "CHECK_OK\n" "CHECK_FAIL: no\n")))
    , MkPair String Bool "native-sibling/verify-case-sensitive-marker"
        (notb (native_sibling_check_ok (MkProcResult 0 "check_ok\n" "")))
    , MkPair String Bool "native-sibling/lsp-check-timeout"
        (sibling_test_limits lsp_check_process_limits (mul 30 (mul 10 100)))
    , MkPair String Bool "native-sibling/lsp-fmt-timeout"
        (sibling_test_limits lsp_format_process_limits (mul 10 (mul 10 100)))
    , MkPair String Bool "native-sibling/pkg-verify-timeout-policy"
        (sibling_test_limits (native_sibling_limits (mul 120 (mul 10 100))) (mul 120 (mul 10 100)))
    , MkPair String Bool "native-sibling/lsp-clean-marker"
        (nullb Json (lsp_process_diagnostics "C:/work/main.ouro" (sibling_test_right 0 "CHECK_OK\n" "")))
    , MkPair String Bool "native-sibling/lsp-native-rejection"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "" "coil: source 41:3\n") "CHECK_FAIL" 1 0 0 "coil: source 41:3")
    , MkPair String Bool "native-sibling/lsp-unparsed-empty-failure"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 42 "" "") "CHECK_FAIL" 1 0 0 "native checker exited 42")
    , MkPair String Bool "native-sibling/lsp-preserve-check-fail"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "CHECK_FAIL: rejected declaration\n" "") "CHECK_FAIL" 1 0 0 "rejected declaration")
    , MkPair String Bool "native-sibling/lsp-preserve-positioned"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 1 "OURO-TYPE error C:/work/main.ouro:3:5 type mismatch\n" "") "OURO-TYPE" 1 2 4 "type mismatch")
    , MkPair String Bool "native-sibling/lsp-preserve-warning"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 0 "CHECK_OK\nOURO-STYLE warning C:/work/main.ouro:7:2 style note\n" "") "OURO-STYLE" 2 6 1 "style note")
    , MkPair String Bool "native-sibling/lsp-zero-without-verdict"
        (sibling_test_diagnostic "C:/work/main.ouro" (sibling_test_right 0 "" "") "CHECK_PROTOCOL" 1 0 0 "native checker exited 0 without a successful CHECK_OK verdict")
    , MkPair String Bool "native-sibling/lsp-preserve-foreign-diagnostic-filter"
        (nullb Json (lsp_process_diagnostics "C:/work/main.ouro" (sibling_test_right 1 "OURO-TYPE error C:/work/imported.ouro:3:5 elsewhere\n" "")))
    , MkPair String Bool "native-sibling/lsp-tool-error-image-query"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingImageError ExecutablePathQueryFailed)) "TOOL_ERROR" 1 0 0 "current executable path: GetModuleFileNameW failed")
    , MkPair String Bool "native-sibling/fmt-error-null-image-query"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingImageError ExecutablePathQueryFailed)))
    , MkPair String Bool "native-sibling/lsp-tool-error-os"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureOsError 2))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process OS error=2")
    , MkPair String Bool "native-sibling/fmt-error-null-os"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureOsError 2))))
    , MkPair String Bool "native-sibling/lsp-tool-error-timeout"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureTimedOut 30 "partial" "error"))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process timeout=30 ms")
    , MkPair String Bool "native-sibling/fmt-error-null-timeout"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureTimedOut 30 "partial" "error"))))
    , MkPair String Bool "native-sibling/lsp-tool-error-cleanup"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureCleanupFailed 6))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process cleanup error=6")
    , MkPair String Bool "native-sibling/fmt-error-null-cleanup"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureCleanupFailed 6))))
    , MkPair String Bool "native-sibling/lsp-tool-error-output-cap"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureOutputLimit CaptureStdout 8 9))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: stdout bytes=9 exceeds cap=8")
    , MkPair String Bool "native-sibling/fmt-error-null-output-cap"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureOutputLimit CaptureStdout 8 9))))
    , MkPair String Bool "native-sibling/lsp-tool-error-memory"
        (sibling_test_diagnostic "C:/work/main.ouro" (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureResourceLimit 10 64 "partial" "error"))) "TOOL_ERROR" 1 0 0 "C:/tools/coil.exe: captured process memory event=10 peak_bytes=64")
    , MkPair String Bool "native-sibling/fmt-error-null-memory"
        (sibling_test_format_null (Left NativeSiblingError ProcResult (NativeSiblingProcessError "C:/tools/coil.exe" (ProcessCaptureResourceLimit 10 64 "partial" "error"))))
    , MkPair String Bool "native-sibling/fmt-nonzero-is-null"
        (sibling_test_format_null (sibling_test_right 259 "partial output" "failure"))
    , MkPair String Bool "native-sibling/fmt-success-output"
        (str_eq (json_print (lsp_process_format "before" (sibling_test_right 0 "after" "ignored warning"))) (json_print (format_edits "before" "after")))
    , MkPair String Bool "native-sibling/fmt-empty-success-output"
        (str_eq (json_print (lsp_process_format "before" (sibling_test_right 0 "" ""))) (json_print (format_edits "before" "")))
    ];

-- @entry main
def main : IO Unit := precision_run "native-sibling" native_sibling_process_laws;
