        (sibling_test_lsp_positioned "\"😀\" target" 7 5 6)
    , MkPair String Bool "lsp/diagnostic-bmp-scalar-range"
        (sibling_test_lsp_positioned "\"雪\" target" 1 1 2)
    , MkPair String Bool "lsp/diagnostic-non-bmp-scalar-range"
        (sibling_test_lsp_positioned "\"😀\" target" 1 1 3)
    , MkPair String Bool "lsp/column-width-boundaries-and-invalid-tail" sibling_test_lsp_decoded_widths
    , MkPair String Bool "lsp/invalid-source-position-is-explicit"
        (str_eq(json_field_str (lsp_diagnostic_utf16 [str_of_codes [255]]
          (diag_of "OURO-POSITION" (JNum "1") 0 0 "invalid source")) "code" "", "CHECK_PROTOCOL"))
    , MkPair String Bool "lsp/envelope-valid-number-id"
        (lsp_message_valid (rpc_request (JNum "1") "initialize" (JObj [])))
    , MkPair String Bool "lsp/envelope-valid-string-id"
        (lsp_message_valid (rpc_request (JStr "request") "initialize" (JObj [])))
    , MkPair String Bool "lsp/envelope-null-id-is-a-request"
        (andb (lsp_message_valid (rpc_request JNull "unknown" (JObj [])))
          (notb (lsp_message_is_notification (rpc_request JNull "unknown" (JObj [])))))
    , MkPair String Bool "lsp/envelope-valid-notification"
        (andb (lsp_message_valid (rpc_notify "initialized" (JObj [])))
          (lsp_message_is_notification (rpc_notify "initialized" (JObj []))))
    , MkPair String Bool "lsp/envelope-invalid-version"
        (notb (lsp_message_valid (JObj
          [MkPair String Json "jsonrpc" (JStr "1.0"),
           MkPair String Json "id" (JNum "20"),
           MkPair String Json "method" (JStr "initialize")])))
    , MkPair String Bool "lsp/envelope-invalid-array-id"
        (andb (notb (lsp_message_valid (rpc_request (JArr []) "initialize" (JObj []))))
          (str_eq(json_print (lsp_message_error_id (rpc_request (JArr []) "initialize" (JObj []))), "null")))
    , MkPair String Bool "lsp/envelope-invalid-body"
        (all Json (fun (body : Json) => notb (lsp_message_valid body))
          [JNull, JNum "0", JBool True, JStr "body", JArr []])
    , MkPair String Bool "lsp/envelope-invalid-method"
        (notb (lsp_message_valid (JObj
          [rpc_version_field, MkPair String Json "id" (JNum "22"),
           MkPair String Json "method" (JBool False)])))
    , MkPair String Bool "native-ci/loaded-image-command"
        (sibling_test_native_host_command
