    , MkPair String Bool "lsp/prepare-rename-past-line-clamps"
        (sibling_test_lsp_range (prepare_rename_result "._2'" 0 99) 1 4)
    , MkPair String Bool "lsp/prepare-rename-after-bmp"
        (sibling_test_lsp_range (prepare_rename_result "\"雪\" target" 0 8) 4 10)
    , MkPair String Bool "lsp/prepare-rename-after-non-bmp"
        (sibling_test_lsp_range (prepare_rename_result "\"😀\" target" 0 8) 5 11)
    , MkPair String Bool "lsp/prepare-rename-after-mixed-unicode"
        (sibling_test_lsp_range (prepare_rename_result "\"雪😀\" target" 0 7) 6 12)
    , MkPair String Bool "lsp/rename-whole-tokens-preserves-unicode-and-newlines"
