    , MkPair String Bool "native-ci/report-refuse-nonpassing-gate"
        (all Json (sibling_test_host_reject_gate_value "status")
          [JStr "fail", JStr "skip", JStr "unavailable", JStr "PASS",
           JBool True, JNum "1", JNull, JArr [], JObj []])
    , MkPair String Bool "native-ci/report-refuse-hidden-failed-gate"
        (sibling_test_host_reject_value "gates"
          (JArr [check_json (gate_check "first" []),
