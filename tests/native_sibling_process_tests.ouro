    , MkPair String Bool "native-ci/report-refuse-wrong-mode"
        (sibling_test_host_reject_value "execution_mode" (JStr "subprocess"))
    , MkPair String Bool "native-ci/report-refuse-malformed-or-trailing"
        (andb (notb (host_bound_validation_report_text_ok "{"))
          (notb (host_bound_validation_report_text_ok
            (str_concat(json_print (JObj sibling_test_host_fields), " trailing")))))
    , MkPair String Bool "native-ci/zero-without-report-is-failure"
        sibling_test_host_missing_report
    , MkPair String Bool "native-ci/failed-child-keeps-full-status"
        (eq_nat(host_bound_effective_code False True (add 256 3), add 256 3))
    , MkPair String Bool "native-ci/failure-issue-order"
        (list_eq String str_eq (host_bound_validation_issues False False "validation")
          ["inventory consistency validation command failed",
           "required native validation report missing, malformed, or non-passing: validation"])
    , MkPair String Bool "native-ci/capture-error-is-failure"
        (let result : ProcResult := native_host_bound_process_result
          (Left NativeSiblingError ProcResult
            (NativeSiblingProcessError("C:/tools/ouro-repo-gate.exe", ProcessCaptureOsError 2))) in
          andb (eq_nat(proc_code result, 127))
            (andb (notb (proc_ok result))
              (str_eq(proc_stderr result,
                "C:/tools/ouro-repo-gate.exe: captured process OS error=2\n"))))
    , MkPair String Bool "native-ci/captured-dword-and-bytes-preserved"
        sibling_test_host_captured_result
    ];

-- @entry main
def main : IO Unit := precision_run "native-sibling" native_sibling_process_laws;
