-- Exact frontend terms, including names that elaboration would erase.
import "../compiler/core.ouro",
  "compiler_test_list_equal.ouro";

def compiler_test_surface_fields (term : Surface) : List Nat :=
    match term with
    | SVar name => [0, name]
    | SSort level => [1, level]
    | SPi name _ _ => [2, name]
    | SLam name _ _ => [3, name]
    | SApp _ _ => [4]
    | SLet name _ _ _ => [5, name]
    | SConst name => [6, name]
    | SInd name => [7, name]
    | SConstruct family index parameters => [8, family, index, parameters]
    | SCase info _ _ _ => match info with
        | MkCaseInfo family parameters arities =>
            Cons Nat 9 (Cons Nat family (Cons Nat parameters arities))
        end
    | SFix name argument arity _ _ => [10, name, argument, arity]
    | SHole name => [11, name]
    | SEffectRow _ => [12]
    | SPerform operation _ => [13, operation]
    | SStr name type_id => [14, name, type_id]
    end;

def compiler_test_surface_children (term : Surface) : List Surface :=
    match term with
    | SVar _ => Nil Surface
    | SSort _ => Nil Surface
    | SPi _ domain codomain => [domain, codomain]
    | SLam _ annotation body => [annotation, body]
    | SApp function argument => [function, argument]
    | SLet _ value typ body => [value, typ, body]
    | SConst _ => Nil Surface
    | SInd _ => Nil Surface
    | SConstruct _ _ _ => Nil Surface
    | SCase _ predicate scrutinee branches =>
        Cons Surface predicate (Cons Surface scrutinee branches)
    | SFix _ _ _ typ body => [typ, body]
    | SHole _ => Nil Surface
    | SEffectRow typ => [typ]
    | SPerform _ arguments => arguments
    | SStr _ _ => Nil Surface
    end;

def compiler_test_surface_equal : Nat -> Surface -> Surface -> Bool :=
  fix same (fuel : Nat) (left : Surface) (right : Surface) : Bool :=
    match fuel with
    | Z => False
    | S remaining =>
        andb
          (compiler_test_list_equal Nat eqNat
            (compiler_test_surface_fields left) (compiler_test_surface_fields right))
          ((fix siblings (left_children : List Surface) (right_children : List Surface) : Bool :=
              match left_children, right_children with
              | Nil, Nil => True
              | Nil, Cons _ _ => False
              | Cons _ _, Nil => False
              | Cons first rest, Cons second tail =>
                  andb(same remaining first second, siblings rest tail)
              end) (compiler_test_surface_children left) (compiler_test_surface_children right))
    end;
