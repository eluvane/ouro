-- Acceptance tests for practical stdlib capability modules.

import "../std/args.ouro";
import "../std/cli.ouro";
import "../std/config.ouro";
import "../std/map.ouro";
import "../std/num.ouro";
import "../std/table.ouro";
import "../std/test.ouro";
import "../std/text.ouro";

def sample_cfg : Config :=
    config_parse "name=ouro\nthreads=4\nenabled=true\n";

def check_cfg_threads : Bool :=
    match config_get_nat sample_cfg "threads" with
    | Left _ => False
    | Right n => eq_nat n 4
    end;

def check_cfg_enabled : Bool :=
    match config_get_bool sample_cfg "enabled" with
    | Left _ => False
    | Right b => b
    end;

def sample_args : Args :=
    cli_parse (["verbose"] : List String)
      (["run", "--limit", "5", "--verbose"] : List String);

def check_cli_limit : Bool :=
    match cli_required_nat sample_args "limit" with
    | Left _ => False
    | Right n => eq_nat n 5
    end;

def check_cli_pos : Bool :=
    match cli_required_pos sample_args 0 "command" with
    | Left _ => False
    | Right cmd => str_eq cmd "run"
    end;

def sample_table : List (List String) :=
    table_from_csv "name,count\nalpha,2\nbeta,3\n";

def first_record : Map String :=
    head (Map String) (map_empty String) (table_records sample_table);

def check_table_lookup : Bool :=
    match table_lookup first_record "count" with
    | Nothing => False
    | Just value => str_eq value "2"
    end;

def split_sample : List Nat := [1, 2, 3, 4];

def split_empty : List Nat := Nil Nat;

def split_prefix : List Nat := [1, 2];

def split_suffix : List Nat := [3, 4];

def split_parts_eq (got : Pair (List Nat) (List Nat)) (want_left : List Nat) (want_right : List Nat) : Bool :=
    match got with
    | MkPair left right =>
      andb (list_eq Nat eq_nat left want_left) (list_eq Nat eq_nat right want_right)
    end;

def split_matches_take_drop (n : Nat) (xs : List Nat) : Bool :=
    match split_at Nat n xs with
    | MkPair left right =>
      andb (list_eq Nat eq_nat left (take Nat n xs))
        (list_eq Nat eq_nat right (drop Nat n xs))
    end;

def check_split_at_empty_zero : Bool :=
    split_parts_eq (split_at Nat 0 split_empty) split_empty split_empty;

def check_split_at_empty_oversized : Bool :=
    split_parts_eq (split_at Nat 3 split_empty) split_empty split_empty;

def check_split_at_zero : Bool :=
    split_parts_eq (split_at Nat 0 split_sample) split_empty split_sample;

def check_split_at_mid : Bool :=
    split_parts_eq (split_at Nat 2 split_sample) split_prefix split_suffix;

def check_split_at_exact : Bool :=
    split_parts_eq (split_at Nat 4 split_sample) split_sample split_empty;

def check_split_at_oversized : Bool :=
    split_parts_eq (split_at Nat 6 split_sample) split_sample split_empty;

def check_split_at_matches_take_drop : Bool :=
    andb (split_matches_take_drop 0 split_empty)
      (andb (split_matches_take_drop 3 split_empty)
        (andb (split_matches_take_drop 0 split_sample)
          (andb (split_matches_take_drop 1 split_sample)
            (andb (split_matches_take_drop 2 split_sample)
              (andb (split_matches_take_drop 4 split_sample)
                (split_matches_take_drop 6 split_sample))))));

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_eq "tokens" (str_join "," (str_tokens " a\tb\nc ")) "a,b,c"
      , assert_eq "join" (str_join "," (["a", "", "c"] : List String)) "a,,c"
      , assert_eq "repeat" (str_repeat "ab" 3) "ababab"
      , assert_true "range"
          (list_eq Nat eq_nat (nat_range_closed 2 4) ([2, 3, 4] : List Nat))
      , assert_eq "mean" (str_of_nat (nat_mean_floor ([2, 4, 6] : List Nat))) "4"
      , assert_true "config nat" check_cfg_threads
      , assert_true "config bool" check_cfg_enabled
      , assert_true "cli nat" check_cli_limit
      , assert_true "cli positional" check_cli_pos
      , assert_true "table lookup" check_table_lookup
      , assert_true "split_at empty zero" check_split_at_empty_zero
      , assert_true "split_at empty oversized" check_split_at_empty_oversized
      , assert_true "split_at zero" check_split_at_zero
      , assert_true "split_at mid" check_split_at_mid
      , assert_true "split_at exact" check_split_at_exact
      , assert_true "split_at oversized" check_split_at_oversized
      , assert_true "split_at take drop" check_split_at_matches_take_drop
      ] : List Test);
