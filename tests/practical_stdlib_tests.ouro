-- Acceptance tests for practical stdlib capability modules.

import "../std/args.ouro",
  "../std/cli.ouro",
  "../std/collections.ouro",
  "../std/config.ouro",
  "../std/map.ouro",
  "../std/num.ouro",
  "../std/result.ouro",
  "../std/table.ouro",
  "../std/test.ouro",
  "../std/text.ouro";

def sample_cfg : Config :=
    config_parse "name=ouro\nthreads=4\nenabled=true\n";

def check_cfg_threads : Bool :=
    match config_get_nat sample_cfg "threads" with
    | Left _ => False
    | Right n => eq_nat n 4
    end;

def check_cfg_enabled : Bool :=
    match config_get_bool sample_cfg "enabled" with
    | Left _ => False
    | Right b => b
    end;

def sample_args : Args :=
    cli_parse (["verbose"] : List String)
      (["run", "--limit", "5", "--verbose"] : List String);

def check_cli_limit : Bool :=
    match cli_required_nat sample_args "limit" with
    | Left _ => False
    | Right n => eq_nat n 5
    end;

def check_cli_pos : Bool :=
    match cli_required_pos sample_args 0 "command" with
    | Left _ => False
    | Right cmd => str_eq cmd "run"
    end;

def sample_table : List (List String) :=
    table_from_csv "name,count\nalpha,2\nbeta,3\n";

def first_record : Map String :=
    head(Map String, map_empty String, table_records sample_table);

def check_table_lookup : Bool :=
    match table_lookup first_record "count" with
    | Nothing => False
    | Just value => str_eq value "2"
    end;

-- Repeated keys in a config file keep the later value. Pair construction and
-- map union must agree, including keys the override does not mention.
def polish_stdlib_show (cfg : Config) (key : String) : String :=
    match config_get cfg key with
    | Nothing => "NOTHING"
    | Just value => value
    end;

def polish_stdlib_file : Config :=
    config_parse "keep=yes\nlimit=1\nname=ouro\nlimit=4\nlimit=9\n";

def polish_stdlib_pairs : List (Pair String String) :=
    ([ MkPair String String "limit" "1"
     , MkPair String String "name" "ouro"
     , MkPair String String "limit" "4"
     , MkPair String String "limit" "9"
     ] : List (Pair String String));

def polish_stdlib_from_pairs : Config :=
    config_merge(config_parse "keep=yes\n", config_from_pairs polish_stdlib_pairs);

def polish_stdlib_direct : Map String :=
    map_from_pairs String polish_stdlib_pairs;

def practical_maybe_traverse_values : Maybe (List Nat) :=
    list_traverse_maybe String Nat str_parse_nat
      (["1", "2", "3"] : List String);

def practical_maybe_traverse_first_failure : Maybe (List Nat) :=
    list_traverse_maybe String Nat str_parse_nat
      (["bad", "2", "3"] : List String);

def practical_maybe_traverse_last_failure : Maybe (List Nat) :=
    list_traverse_maybe String Nat str_parse_nat
      (["1", "2", "bad"] : List String);

def practical_maybe_traverse_empty : Maybe (List Nat) :=
    list_traverse_maybe String Nat str_parse_nat ([] : List String);

def check_maybe_traverse_values : Bool :=
    match practical_maybe_traverse_values with
    | Nothing => False
    | Just values => list_eq(Nat, eq_nat, values, [1, 2, 3] : List Nat)
    end;

def check_maybe_traverse_failure (value : Maybe (List Nat)) : Bool :=
    maybe (List Nat) Bool True (fun (_ : List Nat) => False) value;

def check_maybe_traverse_empty : Bool :=
    match practical_maybe_traverse_empty with
    | Nothing => False
    | Just values => list_eq(Nat, eq_nat, values, [] : List Nat)
    end;

def practical_result_success : String :=
    result_unwrap_or_else Nat String (fun (e : Nat) => str_of_nat e)
      (Right Nat String "ok");

def practical_result_failure : String :=
    result_unwrap_or_else Nat String (fun (e : Nat) => str_of_nat e)
      (Left Nat String 7);

def practical_nat_lists_eq (xs : List (List Nat))
    (ys : List (List Nat)) : Bool :=
    list_eq (List Nat) (list_eq Nat eq_nat) xs ys;

def practical_nat_pair_eq (lhs : Pair Nat Nat) (rhs : Pair Nat Nat) : Bool :=
    match lhs with
    | MkPair left1 right1 =>
        match rhs with
        | MkPair left2 right2 =>
            andb(eq_nat left1 left2, eq_nat right1 right2)
        end
    end;

def practical_nat_group_eq (lhs : Pair Nat (List Nat))
    (rhs : Pair Nat (List Nat)) : Bool :=
    match lhs with
    | MkPair key1 members1 =>
        match rhs with
        | MkPair key2 members2 =>
            andb(eq_nat key1 key2, list_eq Nat eq_nat members1 members2)
        end
    end;

def practical_result_value (x : Nat) : Either String Nat :=
    match eq_nat x 2 with
    | True => Left String Nat "two"
    | False =>
        match eq_nat x 3 with
        | True => Left String Nat "three"
        | False => Right String Nat x
        end
    end;

def practical_result_fold_step (state : Nat) (x : Nat)
    : Either String Nat :=
    match practical_result_value x with
    | Left error => Left String Nat error
    | Right value => Right String Nat (add state value)
    end;

def practical_maybe_fold_step (state : Nat) (x : Nat) : Maybe Nat :=
    match eq_nat x 2 with
    | True => Nothing Nat
    | False => Just Nat (add state x)
    end;

def practical_group_key (x : Nat) : Nat :=
    match eq_nat x 2 with
    | True => 2
    | False => 1
    end;

def practical_map_accum_step (state : Nat) (x : Nat) : Pair Nat Nat :=
    MkPair Nat Nat (add state x) state;

def practical_map_accum_order : Bool :=
    match list_map_accum Nat Nat Nat
        practical_map_accum_step
        Z ([1, 2, 3] : List Nat) with
    | MkPair final values =>
        andb(eq_nat final 6,
          list_eq Nat eq_nat values ([0, 1, 3] : List Nat))
    end;

def practical_map_accum_empty : Bool :=
    match list_map_accum Nat Nat Nat
        practical_map_accum_step
        7 ([] : List Nat) with
    | MkPair final values =>
        andb(eq_nat final 7,
          list_eq Nat eq_nat values ([] : List Nat))
    end;

-- @entry main
def main : IO Unit :=
    test_run
      ([ assert_eq "tokens" (str_join(",", str_tokens " a\tb\nc ")) "a,b,c"
      , assert_eq "join" (str_join(",", ["a", "", "c"] : List String)) "a,,c"
      , assert_eq "repeat" (str_repeat "ab" 3) "ababab"
      , assert_true "range"
          (list_eq(Nat, eq_nat, nat_range_closed 2 4, [2, 3, 4] : List Nat))
      , assert_eq "mean" (str_of_nat (nat_mean_floor ([2, 4, 6] : List Nat))) "4"
      , assert_true "adjacent pairs move the left element"
          (list_eq (Pair Nat Nat) practical_nat_pair_eq
            (adjacent_pairs Nat ([1, 2, 3] : List Nat))
            ([MkPair Nat Nat 1 2, MkPair Nat Nat 2 3]
              : List (Pair Nat Nat)))
      , assert_true "windows overlap"
          (practical_nat_lists_eq
            (list_windows Nat 2 ([1, 2, 3, 4] : List Nat))
            ([[1, 2], [2, 3], [3, 4]] : List (List Nat)))
      , assert_true "windows zero width"
          (practical_nat_lists_eq
            (list_windows Nat Z ([1, 2] : List Nat))
            ([] : List (List Nat)))
      , assert_true "windows too wide"
          (practical_nat_lists_eq
            (list_windows Nat 3 ([1, 2] : List Nat))
            ([] : List (List Nat)))
      , assert_true "windows empty"
          (practical_nat_lists_eq
            (list_windows Nat 1 ([] : List Nat))
            ([] : List (List Nat)))
      , assert_true "scan includes initial and final states"
          (list_eq Nat eq_nat
            (list_scan Nat Nat add Z ([1, 2, 3] : List Nat))
            ([0, 1, 3, 6] : List Nat))
      , assert_true "scan empty keeps initial"
          (list_eq Nat eq_nat
            (list_scan Nat Nat add 7 ([] : List Nat))
            ([7] : List Nat))
      , assert_true "map accum follows state and input order"
          practical_map_accum_order
      , assert_true "map accum empty keeps state"
          practical_map_accum_empty
      , assert_true "group by collects nonadjacent equal keys stably"
          (list_eq (Pair Nat (List Nat)) practical_nat_group_eq
            (list_group_by Nat Nat eq_nat practical_group_key
              ([1, 2, 3, 1] : List Nat))
            ([MkPair Nat (List Nat) 1 [1, 3, 1],
              MkPair Nat (List Nat) 2 [2]]
              : List (Pair Nat (List Nat))))
      , assert_true "group by empty"
          (list_eq (Pair Nat (List Nat)) practical_nat_group_eq
            (list_group_by Nat Nat eq_nat practical_group_key
              ([] : List Nat))
            ([] : List (Pair Nat (List Nat))))
      , assert_true "result traverse keeps values in order"
          (match list_traverse_result String Nat Nat practical_result_value
              ([1, 4] : List Nat) with
           | Left _ => False
           | Right values =>
               list_eq Nat eq_nat values ([1, 4] : List Nat)
           end)
      , assert_true "result traverse returns first failure"
          (match list_traverse_result String Nat Nat practical_result_value
              ([1, 2, 3] : List Nat) with
           | Left error => str_eq error "two"
           | Right _ => False
           end)
      , assert_true "result traverse empty"
          (match list_traverse_result String Nat Nat practical_result_value
              ([] : List Nat) with
           | Left _ => False
           | Right values => list_eq Nat eq_nat values ([] : List Nat)
           end)
      , assert_true "result try fold follows state"
          (match list_try_fold_result String Nat Nat
              practical_result_fold_step 7 ([1, 4] : List Nat) with
           | Left _ => False
           | Right value => eq_nat value 12
           end)
      , assert_true "result try fold returns first failure"
          (match list_try_fold_result String Nat Nat
              practical_result_fold_step Z ([1, 2, 3] : List Nat) with
           | Left error => str_eq error "two"
           | Right _ => False
           end)
      , assert_true "result try fold empty"
          (match list_try_fold_result String Nat Nat
              practical_result_fold_step 7 ([] : List Nat) with
           | Left _ => False
           | Right value => eq_nat value 7
           end)
      , assert_true "maybe try fold follows state"
          (match list_try_fold_maybe Nat Nat practical_maybe_fold_step
              7 ([1, 4] : List Nat) with
           | Nothing => False
           | Just value => eq_nat value 12
           end)
      , assert_true "maybe try fold stops on first missing state"
          (match list_try_fold_maybe Nat Nat practical_maybe_fold_step
              7 ([1, 2, 4] : List Nat) with
           | Nothing => True
           | Just _ => False
           end)
      , assert_true "maybe try fold empty"
          (match list_try_fold_maybe Nat Nat practical_maybe_fold_step
              7 ([] : List Nat) with
           | Nothing => False
           | Just value => eq_nat value 7
           end)
      , assert_true "config nat" check_cfg_threads
      , assert_true "config bool" check_cfg_enabled
      , assert_true "cli nat" check_cli_limit
      , assert_true "cli positional" check_cli_pos
      , assert_true "table lookup" check_table_lookup
      , assert_true "maybe traverse preserves order" check_maybe_traverse_values
      , assert_true "maybe traverse preserves first failure"
          (check_maybe_traverse_failure practical_maybe_traverse_first_failure)
      , assert_true "maybe traverse preserves last failure"
          (check_maybe_traverse_failure practical_maybe_traverse_last_failure)
      , assert_true "maybe traverse empty" check_maybe_traverse_empty
      , assert_eq "result fallback keeps success" practical_result_success "ok"
      , assert_eq "result fallback receives error" practical_result_failure "7"
      , assert_eq "polish-stdlib later key"
          (polish_stdlib_show polish_stdlib_from_pairs "limit") "9"
      , assert_eq "polish-stdlib kept key"
          (polish_stdlib_show polish_stdlib_from_pairs "keep") "yes"
      , assert_eq "polish-stdlib other key"
          (polish_stdlib_show polish_stdlib_from_pairs "name") "ouro"
      , assert_eq "polish-stdlib missing key"
          (polish_stdlib_show polish_stdlib_from_pairs "extra") "NOTHING"
      , assert_eq "polish-stdlib pair file agree"
          (config_render polish_stdlib_from_pairs) (config_render polish_stdlib_file)
      , assert_eq "polish-stdlib direct map"
          (polish_stdlib_show polish_stdlib_direct "limit") "9"
      , assert_eq "polish-stdlib empty override"
          (config_render (config_merge polish_stdlib_file config_empty))
          (config_render polish_stdlib_file)
      , assert_eq "polish-stdlib unique override"
          (polish_stdlib_show
            (config_merge (config_parse "limit=1\nkeep=yes\n")
              (config_from_pairs
                ([ MkPair String String "limit" "9" ] : List (Pair String String))))
            "limit") "9"
      ] : List Test);
