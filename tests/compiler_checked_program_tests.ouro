-- Native compilation retains checked declarations and the literal table.
import "../compiler/driver.ouro",
  "../std/io.ouro",
  "compiler_program_lookup.ouro";

def program_test_files : List (Pair (List Nat) (List Nat)) :=
    [ compiler_test_unit "main.ouro"
        "import \"dep.ouro\"; intrinsic Runtime : Type -> Type := \"ouro.runtime\"; extern pid : Runtime Word := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetCurrentProcessId\" \"maygc\"; def identity (x : Word) : Word := x;"
    , compiler_test_unit "dep.ouro"
        "intrinsic Word : Type := \"ouro.u32\"; intrinsic String : Type := \"ouro.string\"; inductive Count : Type := | Zero : Count | Next : Count -> Count; representation Count := \"ouro.nat\"; def text : String := \"payload\";"
    ];

def program_test_result : CompResult CheckedProgram :=
    compile_checked_units(mul 100 50, prim_string_to_char_codes "main.ouro", program_test_files);

def program_test_name (state : InternState) (name : String) : Maybe Nat :=
    match state with
    | MkIntern names _ _ _ => source_lookup_id(names, prim_string_to_char_codes name)
    end;

def program_test_named (program : CheckedProgram) (name : String) (check : Nat -> Bool) : Bool :=
    match program_test_name(checked_program_intern program, name) with
    | Nothing => False
    | Just id => check id
    end;

def program_test_word (program : CheckedProgram) : Bool :=
    program_test_named program "Word" (fun (id : Nat) =>
      match primitive_named_identity(id, primitive_environment (checked_program_entries program)) with
      | Nothing => False
      | Just native => primitive_id_equal native PrimitiveU32Type
      end);

def program_test_role (program : CheckedProgram) : Bool :=
    program_test_named program "Count" (fun (id : Nat) =>
      match primitive_role_ref(PrimitiveNatRole, primitive_roles_environment (checked_program_entries program)) with
      | Left _ => False
      | Right term => check_bool (check_from_normalize(Bool, eqTerm_checked 100 term (CInd id)))
      end);

def program_test_extern (program : CheckedProgram) : Bool :=
    program_test_named program "pid" (fun (id : Nat) =>
      (fix find (entries : List Entry) : Bool :=
        match entries with
        | Nil => False
        | Cons entry rest =>
            match entry with
            | MkBoundEntry name _ binding =>
                match eqNat name id with
                | False => find rest
                | True =>
                    match binding with
                    | PrimitiveIntrinsicBinding _ _ _ _ => False
                    | PrimitiveExternBinding external =>
                        match external with
                        | CheckedExternOf _ _ dll symbol signature gc =>
                            andb (source_bytes_equal(dll, prim_string_to_char_codes "kernel32.dll"))
                              (andb (source_bytes_equal(symbol, prim_string_to_char_codes "GetCurrentProcessId"))
                                (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                                  (match signature with
                                   | PrimitiveAbiSignatureOf args result =>
                                       andb (match args with | Nil => True | Cons _ _ => False end)
                                         (match result with
                                          | Nothing => False
                                          | Just value =>
                                              match value with
                                              | PrimitiveAbiWord word => primitive_word_equal word PrimitiveWordU32
                                              | PrimitiveAbiPointer _ => False
                                              | PrimitiveAbiFunction _ => False
                                              end
                                          end)
                                   end)))
                        end
                    end
                end
            | MkEntry _ _ _ => find rest
            | MkIndEntry _ _ => find rest
            | MkRoleEntry _ => find rest
            end
        end) (checked_program_entries program));

def program_test_literal_pool (program : CheckedProgram) (expected : List Nat) : Bool :=
    match checked_program_intern program with
    | MkIntern _ _ strings _ =>
        (fix find (remaining : List (Pair (List Nat) Nat)) : Bool :=
          match remaining with
          | Nil => False
          | Cons pair rest => match pair with
              | MkPair bytes literal =>
                  match source_bytes_equal bytes expected with
                  | False => find rest
                  | True => match plan_string(checked_program_intern program, literal) with
                      | Nothing => False
                      | Just payload => source_bytes_equal payload expected
                      end
                  end
              end
          end) strings
    end;

def program_test_literal (program : CheckedProgram) : Bool :=
    program_test_named program "text" (fun (id : Nat) =>
      match checked_emitted_body(id, checked_program_entries program) with
      | Nothing => False
      | Just body =>
          match body with
          | CStrBytes bytes type_id =>
              andb (program_test_named program "String" (fun (expected : Nat) => eqNat type_id expected))
                (andb (source_bytes_equal(bytes, prim_string_to_char_codes "payload"))
                  (program_test_literal_pool program bytes))
          | CStrLit _ _ => False
          | CRel _ => False | CSort _ => False | CPi _ _ => False
          | CLam _ _ => False | CApp _ _ => False | CLetIn _ _ _ => False
          | CConst _ => False | CInd _ => False | CConstruct _ _ _ => False
          | CCase _ _ _ _ => False | CFix _ _ _ _ _ => False
          end
      end);

def program_test_order (program : CheckedProgram) : Bool :=
    match checked_program_cores program with
    | Nil => False
    | Cons first_pair remaining =>
        match first_pair with
        | MkPair first _ =>
            match remaining with
            | Nil => False
            | Cons second_pair rest =>
                match second_pair with
                | MkPair second _ =>
                    andb (match rest with | Nil => True | Cons _ _ => False end)
                      (andb (program_test_named program "text" (fun (id : Nat) => eqNat first id))
                        (program_test_named program "identity" (fun (id : Nat) => eqNat second id)))
                end
            end
        end
    end;

def program_test_exact_bodies (program : CheckedProgram) : Bool :=
    (fix compare (cores : List (Pair Nat CoreTerm)) : Bool :=
      match cores with
      | Nil => True
      | Cons pair rest =>
          match pair with
          | MkPair name emitted =>
          match checked_emitted_body(name, checked_program_entries program) with
          | Nothing => False
          | Just checked =>
              andb (check_bool (check_from_normalize(Bool, eqTerm_checked 100 emitted checked)))
                (compare rest)
          end
          end
      end) (checked_program_cores program);

def program_test_bad_import : Bool :=
    let result : CompResult CheckedProgram :=
      compile_checked_units (mul 100 50) (prim_string_to_char_codes "main.ouro")
        ([ compiler_test_unit "main.ouro" "import \"dep.ouro\"; intrinsic Word : Type := \"ouro.u32\";"
         , compiler_test_unit "dep.ouro" "axiom A : Type; def hidden : A := Type;"
         ] : List (Pair(List Nat, List Nat))) in
    match result with
    | COk _ => False
    | CErr failure => match failure with | ErrCode code _ => eqNat code 41 end
    end;

def program_test_projection_failure : Bool :=
    match checked_program_erase (CErr(CheckedProgram, ErrCode 48 7)) with
    | COk _ => False
    | CErr failure => match failure with | ErrCode code detail => andb(eqNat code 48, eqNat detail 7) end
    end;

def program_test_assert (name : String) (passed : Bool) : IO Unit :=
    match passed with
    | True => println (prim_string_concat "ok " name)
    | False => do println (prim_string_concat "FAIL " name); exit 1
    end;

-- @entry main
def main : IO Unit :=
    match program_test_result with
    | CErr _ => do println "FAIL checked native dependency closure"; exit 1
    | COk program =>
        do program_test_assert("checked word identity", program_test_word program);
           program_test_assert("checked inductive role", program_test_role program);
           program_test_assert("foreign symbol ABI and GC metadata", program_test_extern program);
           program_test_assert("literal payload and type identity", program_test_literal program);
           program_test_assert("ordered definitions exclude opaque declarations", program_test_order program);
           program_test_assert("emitted bodies equal checked environment bodies", program_test_exact_bodies program);
           program_test_assert "invalid imported body returns no checked program" program_test_bad_import;
           program_test_assert "compatibility projection preserves failure" program_test_projection_failure
    end;
