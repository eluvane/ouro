-- Partial progress, exact exit status and complete cleanup are independent
-- assertions. Returned failure codes are injected after real cleanup calls.
import "native_file_fault_values.ouro";

def file_fault_transfer_call (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    match orb(eqNat mode 15, eqNat mode 16) with
    | False => startup_fault_call MirU32 original ([MirUse 0, MirUse 1, MirUse 2, MirUse 3] : List MirValue) state
    | True => lower_bind ManagedResult ManagedResult (managed_compare(MirLess, MirUse 2, managed_bits MirUSize 2, state))
        (fun (tested : ManagedResult) => match tested with | ManagedResultOf small next =>
          lower_bind ManagedResult ManagedResult (managed_string_choose MirUSize small
            (fun (selected : ManagedState) => Right NativeLowerError ManagedResult (ManagedResultOf(MirUse 2, selected)))
            (startup_fault_result MirUSize 2) next)
            (fun (chosen : ManagedResult) => match chosen with | ManagedResultOf bytes after =>
              startup_fault_call MirU32 original ([MirUse 0, MirUse 1, bytes, MirUse 3] : List MirValue) after end) end) end;

def file_fault_transfer (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 1 state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 32 owned)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf attempt next =>
          match orb(eqNat mode 10, eqNat mode 17) with | True => startup_fault_result MirU32 5 next | False =>
            match eqNat mode 11 with
            | True => startup_fault_result MirU32 0 (managed_emit(MirStore(MirUse 3, codegen_disp 0, managed_bits MirU32 0), next))
            | False => match eqNat mode 12 with
              | True => lower_bind ManagedResult ManagedResult (managed_binary MirUSize MirAdd (MirUse 2) (managed_bits MirUSize 1) next)
                  (fun (added : ManagedResult) => match added with | ManagedResultOf oversized after =>
                    lower_bind ManagedResult ManagedResult (managed_convert MirU32 MirNarrow oversized after)
                      (fun (converted : ManagedResult) => match converted with | ManagedResultOf word final =>
                        startup_fault_result MirU32 0 (managed_emit(MirStore(MirUse 3, codegen_disp 0, word), final)) end) end)
              | False => match eqNat mode 15 with
                | False => file_fault_transfer_call mode original next
                | True => lower_bind ManagedResult ManagedResult (managed_compare MirEqual attempt (managed_bits MirUSize 1) next)
                    (fun (tested : ManagedResult) => match tested with | ManagedResultOf first after =>
                      managed_string_choose MirU32 first (file_fault_transfer_call mode original)
                        (startup_fault_result MirU32 5) after end) end end end end end));

def file_fault_allocations (mode : Nat) : Nat :=
    match andb(leb_nat 1 mode, leb_nat mode 4) with | True => mode | False =>
      match eqNat mode 5 with | True => 2 | False =>
        match orb(andb(leb_nat 6 mode, leb_nat mode 9), eqNat mode 18) with
        | True => 3 | False => 4 end end end;

def file_fault_open_calls (mode : Nat) : Nat :=
    match orb(andb(leb_nat 1 mode, leb_nat mode 3), andb(leb_nat 5 mode, leb_nat mode 7)) with
    | True => 0 | False => 1 end;

def file_fault_close_calls (mode : Nat) : Nat :=
    match eqNat mode 8 with | True => 0 | False => file_fault_open_calls mode end;

def file_fault_transfer_calls (mode : Nat) : Nat :=
    match orb(andb(leb_nat 1 mode, leb_nat mode 9), eqNat mode 18) with | True => 0 | False =>
      match eqNat mode 15 with | True => 2 | False => match eqNat mode 16 with | True => 4 | False => 1 end end end;

def file_fault_conversion_calls (mode : Nat) : Nat :=
    match andb(leb_nat 1 mode, leb_nat mode 2) with | True => 0 | False =>
      match orb(eqNat mode 3, eqNat mode 5) with | True => 1 | False => 2 end end;

def file_fault_fixed_counts (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let allocations : Nat := file_fault_allocations mode in
    let releases : Nat := sub(allocations, match andb(leb_nat 1 mode, leb_nat mode 4) with | True => 1 | False => 0 end) in
    lower_bind ManagedState ManagedState (startup_fault_stat base 0 allocations state)
      (fun (allocated : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 8 releases allocated)
        (fun (released : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 16 (file_fault_open_calls mode) released)
          (fun (opened : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 24 (file_fault_close_calls mode) opened)
            (fun (closed : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 32 (file_fault_transfer_calls mode) closed)
              (fun (transferred : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 40 (file_fault_conversion_calls mode) transferred)
                (startup_fault_stat base 48 (file_fault_close_calls mode)))))));

def file_fault_exit_checks (base : Nat) (mode : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    let success : Bool := orb(eqNat mode 0, orb(eqNat mode 16, leb_nat 20 mode)) in
    lower_bind ManagedState ManagedState (managed_require_equal (MirUse 0)
      (managed_bits(MirU32, match success with | True => 42 | False => 73 end)) state)
      (fun (exited : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 64 0 exited)
        (fun (released : ManagedState) => lower_bind ManagedState ManagedState (startup_fault_stat base 72 0 released)
          (fun (closed : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 96 MirUSize closed)
            (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf count next =>
              lower_bind ManagedResult ManagedState (managed_compare MirGreater count (managed_bits MirUSize 0) next)
                (fun (tested : ManagedResult) => match tested with | ManagedResultOf collected after =>
                  lower_bind ManagedState ManagedState (managed_require_equal collected (managed_bits MirU8 1) after)
                    (fun (checked : ManagedState) => match leb_nat 20 mode with
                      | False => file_fault_fixed_counts base mode checked
                      | True => lower_bind ManagedResult ManagedState (startup_fault_load base 104 MirU8 checked)
                          (fun (observed : ManagedResult) => match observed with | ManagedResultOf reclaimed final =>
                            lower_bind ManagedState ManagedState (managed_require_equal reclaimed (managed_bits MirU8 1) final)
                              (fun (gc : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 0 MirUSize gc)
                                (fun (allocations : ManagedResult) => match allocations with | ManagedResultOf total ready =>
                                  lower_bind ManagedResult ManagedState (startup_fault_load base 8 MirUSize ready)
                                    (fun (frees : ManagedResult) => match frees with | ManagedResultOf actual finished =>
                                      managed_require_equal actual total finished end) end)) end) end) end) end))));

def file_fault_arguments (index : Nat) : List MirType :=
    match eqNat index 0 with | True => [MirUSize, MirUSize] | False =>
      match orb(eqNat index 1, orb(eqNat index 9, eqNat index 11)) with | True => [MirRawPtr] | False =>
        match eqNat index 2 with | True => [MirRawPtr, MirUSize, MirRawPtr, MirUSize, MirRawPtr] | False =>
          match eqNat index 3 with | True => [MirRawPtr, MirUSize, MirU32, MirU32, MirU32, MirU8, MirRawPtr] | False =>
            match eqNat index 4 with | True => [MirRawPtr, MirUSize, MirRawPtr] | False =>
              match orb(eqNat index 5, eqNat index 6) with | True => [MirRawPtr, MirRawPtr] | False =>
                match eqNat index 10 with | True => [MirU32]
                | False => [MirRawPtr, MirRawPtr, MirUSize, MirRawPtr] end end end end end end end;

def file_fault_wrapper (base : Nat) (mode : Nat) (index : Nat) (original : Nat)
    : Either NativeLowerError MirFunction :=
    let types : List MirType := file_fault_arguments index in
    let entered : ManagedState := ManagedStateOf 0 ([] : List MirFunction) ([] : List MirData)
      ([] : List Nat) ([] : List Nat) (lower_empty_state (length MirType types)) in
    let arguments : List MirValue := map MirLocal MirValue (fun (local : MirLocal) => match local with
      | MirLocalDef id _ => MirUse id end) (startup_fault_locals types) in
    let body : Either NativeLowerError ManagedResult := match eqNat index 0 with
      | True => startup_fault_allocate base (match andb(leb_nat 1 mode, leb_nat mode 4) with | True => mode | False => 0 end) original entered
      | False => match eqNat index 1 with | True => file_fault_release base mode original entered | False =>
        match eqNat index 2 with | True => startup_fault_conversion base mode original entered | False =>
          match orb(eqNat index 3, eqNat index 4) with
          | True => file_fault_open base mode original arguments (MirUse (match eqNat index 3 with | True => 6 | False => 2 end)) entered
          | False => match orb(eqNat index 5, eqNat index 6) with | True => file_fault_prepare base mode original entered | False =>
            match orb(eqNat index 7, eqNat index 8) with | True => file_fault_transfer base mode original entered | False =>
              match eqNat index 9 with | True => file_fault_close base mode original entered | False =>
                match eqNat index 11 with | True => startup_fault_collector base original entered | False =>
                  lower_bind ManagedState ManagedResult (file_fault_exit_checks base mode entered)
                    (fun (checked : ManagedState) => startup_fault_result MirU8 1
                      (managed_emit(MirCall(MirMayGc, Nothing Nat, MirDirect original, [MirUse 0] : List MirValue), checked)))
                end end end end end end end end in
    lower_map ManagedResult MirFunction (fun (result : ManagedResult) => match result with | ManagedResultOf value after =>
      match managed_flow after with | LowerStateOf _ locals _ _ =>
        let exiting : Bool := eqNat index 10 in
        let result_type : MirType := match eqNat index 0 with | True => MirRawPtr | False =>
          match orb(eqNat index 1, eqNat index 11) with | True => MirU8 | False => MirU32 end end in
        MirFunctionDef (add base index) ([102,105,108,101,95,102,97,117,108,116] : List Nat)
          (startup_fault_locals types) (reverse MirLocal locals)
          (match exiting with | True => Nothing MirType | False => Just MirType result_type end) 0
          (lower_finish_blocks (match exiting with | True => MirTrap
            | False => MirReturn (Just MirValue value) end) (managed_flow after)) end end) body;

def file_fault_wrappers (base : Nat) (mode : Nat) (symbols : List Nat) : Either NativeLowerError (List MirFunction) :=
    (fix build (remaining : List Nat) (index : Nat) : Either NativeLowerError (List MirFunction) :=
      match remaining with | Nil => Right(NativeLowerError, List MirFunction, [] : List MirFunction)
      | Cons original rest => lower_bind MirFunction (List MirFunction) (file_fault_wrapper base mode index original)
          (fun (wrapper : MirFunction) => lower_map (List MirFunction) (List MirFunction) (Cons MirFunction wrapper)
            (build(rest, S index))) end) symbols 0;
