-- The C bridge is selected by checked identity even under another name.
import "../std/test.ouro";

def RealpathText : Type := String;
def RealpathAction (A : Type) : Type := IO A;
intrinsic renamed_realpath : RealpathText -> RealpathAction RealpathText := "ouro.fs.realpath";

def main : IO Unit :=
    let query : String -> IO String := renamed_realpath in
    let saved : IO String := query "std/runtime.ouro" in
    do let! empty := query "";
       let! file := saved;
       let! again := saved;
       let! directory := query "tests";
       let! absent := query "__ouro_realpath_missing_probe_265__";
       test_run
         [assert_true("renamed realpath returns empty for an empty path", str_eq empty ""),
          assert_true("renamed realpath resolves a file each invocation", andb(notb (str_null file), str_eq file again)),
          assert_true("renamed realpath normalizes a file suffix", str_ends file "/std/runtime.ouro"),
          assert_true("renamed realpath resolves a directory", str_ends directory "/tests"),
          assert_true("renamed realpath preserves a missing path", str_eq absent "")]
