-- Development harness for real imported Ouro runtime sources. Host file IO
-- only supplies source bytes; all checking, MIR, instructions and PE are Ouro.
import "../compiler/native/lower_source.ouro",
  "../compiler/native/diagnostics.ouro",
  "../std/io.ouro",
  "native_lower_error_code.ouro";

def native_runtime_error (error : NativeSourceError) : String :=
    match error with
    | NativeSourceCheckError failure => match failure with | ErrCode code detail =>
        managed_driver_join(":", ["source", prim_string_of_nat code, prim_string_of_nat detail] : List String) end
    | NativeSourceLowerError failure =>
        managed_driver_join(":", ["lower", prim_string_of_nat (native_lower_error_code failure)] : List String) end;

def native_runtime_frame (frame : NativeFrameInfo) : String :=
    match frame with | NativeFrameAt id allocation roots calls =>
      managed_driver_join "|" ([prim_string_of_nat id, prim_string_of_nat allocation,
        managed_driver_join "," (map NativeRootSlot String (fun (root : NativeRootSlot) => match root with
          | NativeRootAt local offset => managed_driver_join(":", [prim_string_of_nat local, prim_string_of_nat offset] : List String) end) roots),
        managed_driver_join "," (map NativeCallSite String (fun (site : NativeCallSite) => match site with
          | NativeCallAt block instruction pc => managed_driver_join ":"
              ([prim_string_of_nat block, prim_string_of_nat instruction, prim_string_of_nat pc] : List String) end) calls)] : List String) end;

def native_runtime_image (metadata : Bool) (image : NativeImage) : String :=
    match image with | NativeImageOf pe frames => match metadata with
      | True => managed_driver_join("\n", map NativeFrameInfo String native_runtime_frame frames)
      | False => match pe with | PeImageFile bytes _ =>
          managed_driver_join(",", map Nat String prim_string_of_nat bytes) end end end;

def native_runtime_files : List String -> IO (List (Pair (List Nat) (List Nat))) :=
  fix read_files (paths : List String) : IO (List (Pair (List Nat) (List Nat))) :=
    match paths with | Nil => io_pure(List (Pair(List Nat, List Nat)), [])
    | Cons path rest =>
        do let! exists := prim_fs_exists path;
           match exists with
           | False => do eprintln (prim_string_concat "missing native source: " path);
                         exit 2;
                         io_pure(List (Pair(List Nat, List Nat)), [])
           | True => do let! source := prim_fs_read_file path;
                        let! tail := read_files rest;
                        io_pure (List (Pair(List Nat, List Nat)))
                          (Cons (Pair(List Nat, List Nat))
                            (MkPair (List Nat) (List Nat) (prim_string_to_char_codes path)
                              (prim_string_to_char_codes source)) tail)
           end
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 2 | Cons _ rest =>
         match rest with | Nil => exit 2 | Cons mode more =>
           match more with | Nil => exit 2 | Cons root inputs =>
             match orb(prim_string_eq mode "--image", prim_string_eq mode "--metadata") with
             | False => do eprintln "usage: native_runtime_driver --image|--metadata ROOT SOURCES..."; exit 2
             | True => do let! files := native_runtime_files (Cons String root inputs);
                          match native_compile_units (mul 100 160) mir_default_limits [109, 97, 105, 110]
                            (prim_string_to_char_codes root) files with
                          | Left error => do eprintln (native_runtime_error error); exit 2
                          | Right image => println (native_runtime_image(prim_string_eq mode "--metadata", image))
                          end
             end end end end
