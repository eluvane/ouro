-- Construct exact Core declarations and recheck the complete wrapper before
-- exercising internal managed lowering. The test does not authorize entries.
import "../compiler/native/managed_terms.ouro",
  "compiler_startup_test_support.ouro";

def intrinsic_value_items (signature : CoreTerm) (operation : PrimitiveStringOp)
    (annotation : CoreTerm) (body : CoreTerm) : List FileItem :=
    [FInd (MkIndDecl 1 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor(2, CInd 1), MkCtor(3, CPi(CInd 1, CInd 1))] : List Ctor)),
     FRepresentation(1, lower_role_key PrimitiveNatRole primitive_role_keys),
     FIntrinsic(4, CSort 0, primitive_key PrimitiveStringType, Nothing CoreTerm),
     FDef(7, CSort 0, CConst 4),
     FIntrinsic(5, signature, primitive_key (PrimitiveStringOperation operation), Nothing CoreTerm),
     FDef 6 annotation body];

def intrinsic_value_result (result : Either NativeLowerError ManagedResult) : String :=
    match result with
    | Left error => match error with
      | LowerUnsupportedPrimitive _ => "unsupported-primitive" | LowerInvalidCall _ => "invalid-call"
      | LowerResourceExhausted => "resource" | LowerDeclarationFailure _ _ _ => "declaration"
      | LowerMetadataMismatch _ => "metadata" | LowerBodyMismatch _ => "body"
      | LowerUnsupportedType _ => "type" | LowerUnsupportedTerm _ => "term"
      | LowerUnknownGlobal _ => "global" | LowerUnboundLocal _ => "local"
      | LowerEffectMismatch => "effect" | LowerInvalidEntry _ => "entry"
      | LowerMirFailure _ => "mir" | LowerBackendFailure _ => "backend" end
    | Right lowered => match lowered with | ManagedResultOf _ state => match state with
      | ManagedStateOf _ functions _ _ _ _ => prim_string_of_nat (length MirFunction functions) end end end;

def intrinsic_value_lower (items : List FileItem) : String :=
    match check_declarations CheckExactCore keep_checking (mul 16 250) items with
    | DeclarationsErr _ _ _ => "declarations-rejected"
    | DeclarationsOk entries =>
        match lower_recheck_program(mul 16 250, CheckedProgramOf empty_intern entries (lower_expected_bodies (reverse Entry entries))) with
        | Left _ => "recheck-rejected"
        | Right program =>
          let compiler : ManagedCompiler := ManagedCompilerOf program ([] : List Nat) 10 11 12 13 14 20 ([] : List LowerContract)
            (check_environment_from_entries (checked_program_entries program)) in
          match managed_global_body compiler (mul 16 250) 6 with
          | Left _ => "body-rejected"
          | Right body => intrinsic_value_result (managed_expression compiler (mul 16 250) ([] : List (Maybe MirValue)) body
              (ManagedStateOf(100, [] : List MirFunction, [] : List MirData, [] : List Nat, [] : List Nat, lower_empty_state 0))) end end end;

def intrinsic_unary_signature : CoreTerm := CPi(CConst 4, CInd 1);
def intrinsic_binary_signature : CoreTerm := CPi(CConst 4, CPi(CConst 4, CConst 4));
def intrinsic_ternary_signature : CoreTerm := CPi(CConst 4, intrinsic_binary_signature);

def main : IO Unit :=
    startup_test_run [
      startup_test_eq "unary intrinsic identity becomes one managed closure"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_unary_signature PrimitiveStringLength
          intrinsic_unary_signature (CConst 5))) "1",
      startup_test_eq "binary intrinsic identity becomes two managed closures"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_binary_signature PrimitiveStringConcat
          intrinsic_binary_signature (CConst 5))) "2",
      startup_test_eq "ternary intrinsic identity becomes three managed closures"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_ternary_signature PrimitiveStringReplace
          intrinsic_ternary_signature (CConst 5))) "3",
      startup_test_eq "binary partial application captures its first string"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_binary_signature PrimitiveStringConcat
          (CPi(CConst 4, CConst 4)) (CApp(CConst 5, CStrBytes [97] 4)))) "2",
      startup_test_eq "ternary partial application accepts two strings"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_ternary_signature PrimitiveStringReplace
          (CPi(CConst 4, CConst 4)) (CApp(CApp(CConst 5, CStrBytes [97] 4), CStrBytes [98] 4)))) "3",
      startup_test_eq "unary closure can be reused through a let alias"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_unary_signature PrimitiveStringLength (CInd 1)
          (CLetIn (CConst 5) intrinsic_unary_signature
            (CLetIn (CApp(CRel 0, CStrBytes [97] 4)) (CInd 1)
              (CApp(CRel 1, CStrBytes [98,99] 4)))))) "1",
      startup_test_eq "transparent String type aliases preserve intrinsic identity"
        (intrinsic_value_lower (intrinsic_value_items (CPi(CConst 7, CInd 1)) PrimitiveStringLength
          intrinsic_unary_signature (CConst 5))) "1",
      startup_test_eq "saturated unary retains its direct path"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_unary_signature PrimitiveStringLength (CInd 1)
          (CApp(CConst 5, CStrBytes [97] 4)))) "0",
      startup_test_eq "wrong intrinsic contract stays rejected"
        (intrinsic_value_lower (intrinsic_value_items intrinsic_binary_signature PrimitiveStringLength
          intrinsic_binary_signature (CConst 5))) "declarations-rejected"];
