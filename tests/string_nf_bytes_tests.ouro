-- Expected bytes are explicit independent oracles, including embedded NUL.
import "../compiler/string_nf_bytes.ouro",
  "../compiler/base.ouro",
  "../std/test.ouro",
  "compiler_test_list_equal.ouro";

def string_nf_test_fuel : Nat := 128;

def string_nf_test_maybe_equal (left : Maybe Nat) (right : Maybe Nat) : Bool :=
    match left, right with
    | Nothing, Nothing => True
    | Nothing, Just _ => False
    | Just _, Nothing => False
    | Just first, Just other => eqNat first other
    end;

def string_nf_test_result (A : Type) (same : A -> A -> Bool)
    (expected : A) (result : NormalizeResult A) : Bool :=
    match result with
    | Normalized value => same expected value
    | NormalizeExhausted => False
    | NormalizeMalformed _ => False
    end;

def string_nf_test_bytes (expected : List Nat) (result : NormalizeResult (List Nat)) : Bool :=
    string_nf_test_result(List Nat, compiler_test_list_equal Nat eqNat, expected, result);

def string_nf_test_parts (expected : List (List Nat))
    (result : NormalizeResult (List (List Nat))) : Bool :=
    string_nf_test_result (List (List Nat))
      (compiler_test_list_equal(List Nat, compiler_test_list_equal Nat eqNat)) expected result;

def string_nf_test_nat (expected : Nat) (result : NormalizeResult Nat) : Bool :=
    string_nf_test_result Nat eqNat expected result;

def string_nf_test_bool (expected : Bool) (result : NormalizeResult Bool) : Bool :=
    string_nf_test_result Bool compiler_bool_equal expected result;

def string_nf_test_index (expected : Maybe Nat) (result : NormalizeResult (Maybe Nat)) : Bool :=
    string_nf_test_result (Maybe Nat) string_nf_test_maybe_equal expected result;

def string_nf_test_exhausted (A : Type) (result : NormalizeResult A) : Bool :=
    match result with
    | Normalized _ => False
    | NormalizeExhausted => True
    | NormalizeMalformed _ => False
    end;

def string_nf_test_malformed (A : Type) (result : NormalizeResult A) : Bool :=
    match result with
    | Normalized _ => False
    | NormalizeExhausted => False
    | NormalizeMalformed fault =>
        match fault with
        | NormalizeStringBytes => True
        | NormalizeStringArguments => False
        | NormalizeUnresolvedLiteral => False
        | NormalizeStringType => False
        | NormalizeNonFunction => False
        | NormalizeCaseBranchCount => False
        | NormalizeCaseScrutinee => False
        | NormalizeCaseInductive => False
        | NormalizeCaseParameters => False
        | NormalizeCaseConstructor => False
        | NormalizeCaseArguments => False
        | NormalizeFixArgument => False
        | NormalizeFixArity => False
        | NormalizeUnreducedHead => False
        end
    end;

def string_nf_test_basic : List Test :=
    ([ assert_true "concat preserves order NUL and 255"
        (string_nf_test_bytes([97, 0, 98, 255] : List Nat, string_nf_concat(string_nf_test_fuel, [97, 0] : List Nat, [98, 255] : List Nat)))
    , assert_true "concat accepts empty left"
        (string_nf_test_bytes([0, 255] : List Nat, string_nf_concat(string_nf_test_fuel, Nil Nat, [0, 255] : List Nat)))
    , assert_true "concat accepts empty right"
        (string_nf_test_bytes([0, 255] : List Nat, string_nf_concat(string_nf_test_fuel, [0, 255] : List Nat, Nil Nat)))
    , assert_true "length counts UTF8 bytes"
        (string_nf_test_nat(2, string_nf_length(string_nf_test_fuel, [195, 169] : List Nat)))
    , assert_true "length includes NUL"
        (string_nf_test_nat(3, string_nf_length(string_nf_test_fuel, [97, 0, 98] : List Nat)))
    , assert_true "empty length is zero"
        (string_nf_test_nat(0, string_nf_length(string_nf_test_fuel, Nil Nat)))
    , assert_true "byte_at reads NUL"
        (string_nf_test_nat(0, string_nf_byte_at string_nf_test_fuel ([97, 0, 255] : List Nat) 1))
    , assert_true "byte_at reads the last byte"
        (string_nf_test_nat(255, string_nf_byte_at string_nf_test_fuel ([97, 0, 255] : List Nat) 2))
    , assert_true "byte_at at length is zero"
        (string_nf_test_nat(0, string_nf_byte_at string_nf_test_fuel ([97] : List Nat) 1))
    , assert_true "byte_at far outside is zero"
        (string_nf_test_nat(0, string_nf_byte_at string_nf_test_fuel ([97] : List Nat) 1000))
    , assert_true "slice start past end is empty"
        (string_nf_test_bytes(Nil Nat, string_nf_slice string_nf_test_fuel ([97, 98, 99] : List Nat) 5 2))
    , assert_true "slice clamps length"
        (string_nf_test_bytes([99] : List Nat, string_nf_slice string_nf_test_fuel ([97, 98, 99] : List Nat) 2 5))
    , assert_true "slice zero length is empty"
        (string_nf_test_bytes(Nil Nat, string_nf_slice string_nf_test_fuel ([97, 98, 99] : List Nat) 1 0))
    , assert_true "slice preserves selected NUL"
        (string_nf_test_bytes([0] : List Nat, string_nf_slice string_nf_test_fuel ([97, 0, 98] : List Nat) 1 1))
    , assert_true "slice through end preserves bytes"
        (string_nf_test_bytes([0, 255] : List Nat, string_nf_slice string_nf_test_fuel ([0, 255] : List Nat) 0 1000))
    , assert_true "byte equality distinguishes NUL from empty"
        (string_nf_test_bool(False, string_nf_equal(string_nf_test_fuel, [0] : List Nat, Nil Nat)))
    , assert_true "byte equality compares bytes after NUL"
        (string_nf_test_bool(False, string_nf_equal(string_nf_test_fuel, [97, 0, 98] : List Nat, [97, 0, 99] : List Nat)))
    , assert_true "byte equality accepts identical arbitrary bytes"
        (string_nf_test_bool(True, string_nf_equal(string_nf_test_fuel, [0, 255] : List Nat, [0, 255] : List Nat)))
    ] : List Test);

def string_nf_test_conversions : List Test :=
    ([ assert_true "of_nat zero has one decimal digit"
        (string_nf_test_bytes([48] : List Nat, string_nf_decimal_bytes string_nf_test_fuel 0))
    , assert_true "of_nat single digit"
        (string_nf_test_bytes([57] : List Nat, string_nf_decimal_bytes string_nf_test_fuel 9))
    , assert_true "of_nat keeps internal zeroes"
        (string_nf_test_bytes([49, 48, 49] : List Nat, string_nf_decimal_bytes string_nf_test_fuel 101))
    , assert_true "of_nat carries across decimal positions"
        (string_nf_test_bytes([49, 48, 48, 48] : List Nat, string_nf_decimal_bytes string_nf_test_fuel 1000))
    , assert_true "to_codes preserves NUL and high bytes"
        (string_nf_test_bytes([0, 255, 195, 169] : List Nat, string_nf_to_codes(string_nf_test_fuel, [0, 255, 195, 169] : List Nat)))
    , assert_true "of_codes reduces every code modulo 256"
        (string_nf_test_bytes ([0, 255, 0, 255, 0] : List Nat)
          (string_nf_of_codes(string_nf_test_fuel, [0, 255, 256, 511, 512] : List Nat)))
    , assert_true "of_codes accepts an empty list"
        (string_nf_test_bytes(Nil Nat, string_nf_of_codes(string_nf_test_fuel, Nil Nat)))
    ] : List Test);

def string_nf_test_search : List Test :=
    ([ assert_true "empty prefix matches"
        (string_nf_test_bool(True, string_nf_starts(string_nf_test_fuel, [97] : List Nat, Nil Nat)))
    , assert_true "prefix matches through NUL"
        (string_nf_test_bool(True, string_nf_starts(string_nf_test_fuel, [97, 0, 98] : List Nat, [97, 0] : List Nat)))
    , assert_true "prefix longer than input fails"
        (string_nf_test_bool(False, string_nf_starts(string_nf_test_fuel, [97] : List Nat, [97, 98] : List Nat)))
    , assert_true "empty suffix matches"
        (string_nf_test_bool(True, string_nf_ends(string_nf_test_fuel, [97] : List Nat, Nil Nat)))
    , assert_true "suffix matches through NUL"
        (string_nf_test_bool(True, string_nf_ends(string_nf_test_fuel, [97, 0, 98] : List Nat, [0, 98] : List Nat)))
    , assert_true "suffix longer than input fails"
        (string_nf_test_bool(False, string_nf_ends(string_nf_test_fuel, [98] : List Nat, [97, 98] : List Nat)))
    , assert_true "a prefix alone is not a suffix"
        (string_nf_test_bool(False, string_nf_ends(string_nf_test_fuel, [97, 98] : List Nat, [97] : List Nat)))
    , assert_true "contains finds NUL"
        (string_nf_test_bool(True, string_nf_contains(string_nf_test_fuel, [97, 0, 98] : List Nat, [0] : List Nat)))
    , assert_true "contains reports missing bytes"
        (string_nf_test_bool(False, string_nf_contains(string_nf_test_fuel, [97, 98] : List Nat, [255] : List Nat)))
    , assert_true "contains accepts empty pattern"
        (string_nf_test_bool(True, string_nf_contains(string_nf_test_fuel, Nil Nat, Nil Nat)))
    , assert_true "index selects the first match"
        (string_nf_test_index(Just Nat 1, string_nf_index(string_nf_test_fuel, [97, 98, 97, 98] : List Nat, [98] : List Nat)))
    , assert_true "index finds an overlapping candidate after partial mismatch"
        (string_nf_test_index(Just Nat 1, string_nf_index(string_nf_test_fuel, [97, 97, 98] : List Nat, [97, 98] : List Nat)))
    , assert_true "index sees bytes after NUL"
        (string_nf_test_index(Just Nat 2, string_nf_index(string_nf_test_fuel, [97, 0, 98] : List Nat, [98] : List Nat)))
    , assert_true "index empty pattern is zero"
        (string_nf_test_index(Just Nat 0, string_nf_index(string_nf_test_fuel, Nil Nat, Nil Nat)))
    , assert_true "index distinguishes absence from zero"
        (string_nf_test_index(Nothing Nat, string_nf_index(string_nf_test_fuel, [97] : List Nat, [98] : List Nat)))
    , assert_true "index nonempty pattern in empty input is absent"
        (string_nf_test_index(Nothing Nat, string_nf_index(string_nf_test_fuel, Nil Nat, [97] : List Nat)))
    ] : List Test);

def string_nf_test_partition : List Test :=
    ([ assert_true "split empty input preserves one empty field"
        (string_nf_test_parts([(Nil Nat)] : List (List Nat), string_nf_split string_nf_test_fuel (Nil Nat) 0))
    , assert_true "split preserves leading repeated and trailing empty fields"
        (string_nf_test_parts([(Nil Nat), ([97] : List Nat), (Nil Nat), (Nil Nat)] : List (List Nat), string_nf_split string_nf_test_fuel ([0, 97, 0, 0] : List Nat) 0))
    , assert_true "split accepts byte 255 as separator"
        (string_nf_test_parts([(Nil Nat), ([97] : List Nat), (Nil Nat)] : List (List Nat), string_nf_split string_nf_test_fuel ([255, 97, 255] : List Nat) 255))
    , assert_true "split separator above 255 never matches"
        (string_nf_test_parts([([0, 255] : List Nat)] : List (List Nat), string_nf_split string_nf_test_fuel ([0, 255] : List Nat) 256))
    , assert_true "replace empty pattern preserves input"
        (string_nf_test_bytes([97, 0] : List Nat, string_nf_replace(string_nf_test_fuel, [97, 0] : List Nat, Nil Nat, [98] : List Nat)))
    , assert_true "replace consumes nonoverlapping matches"
        (string_nf_test_bytes([98, 97] : List Nat, string_nf_replace(string_nf_test_fuel, [97, 97, 97] : List Nat, [97, 97] : List Nat, [98] : List Nat)))
    , assert_true "replace handles adjacent matches"
        (string_nf_test_bytes([98, 98] : List Nat, string_nf_replace(string_nf_test_fuel, [97, 97, 97, 97] : List Nat, [97, 97] : List Nat, [98] : List Nat)))
    , assert_true "replace does not rescan replacement bytes"
        (string_nf_test_bytes([97, 97] : List Nat, string_nf_replace(string_nf_test_fuel, [97] : List Nat, [97] : List Nat, [97, 97] : List Nat)))
    , assert_true "replace can delete matches"
        (string_nf_test_bytes([98] : List Nat, string_nf_replace(string_nf_test_fuel, [97, 98, 97] : List Nat, [97] : List Nat, Nil Nat)))
    , assert_true "replace preserves absent patterns"
        (string_nf_test_bytes([97, 98] : List Nat, string_nf_replace(string_nf_test_fuel, [97, 98] : List Nat, [255] : List Nat, Nil Nat)))
    , assert_true "replace preserves NUL in replacement and source"
        (string_nf_test_bytes ([97, 255, 0, 98, 255, 0] : List Nat)
          (string_nf_replace(string_nf_test_fuel, [97, 0, 98, 0] : List Nat, [0] : List Nat, [255, 0] : List Nat)))
    , assert_true "tokens empty input is empty"
        (string_nf_test_parts(Nil (List Nat), string_nf_tokens(string_nf_test_fuel, Nil Nat)))
    , assert_true "tokens omits fields between whitespace"
        (string_nf_test_parts(Nil (List Nat), string_nf_tokens(string_nf_test_fuel, [32, 9, 10, 13, 32] : List Nat)))
    , assert_true "tokens keeps NUL and 255 inside words"
        (string_nf_test_parts ([([97, 0] : List Nat), ([98, 255] : List Nat)] : List (List Nat))
          (string_nf_tokens(string_nf_test_fuel, [32, 9, 97, 0, 10, 13, 98, 255, 32] : List Nat)))
    , assert_true "tokens treats form feed as an ordinary byte"
        (string_nf_test_parts([([12, 97] : List Nat), ([98] : List Nat)] : List (List Nat), string_nf_tokens(string_nf_test_fuel, [12, 97, 32, 98] : List Nat)))
    ] : List Test);

def string_nf_test_ordering : List Test :=
    ([ assert_true "less_equal includes equality"
        (string_nf_test_bool(True, string_nf_less_equal(string_nf_test_fuel, [0, 255] : List Nat, [0, 255] : List Nat)))
    , assert_true "less_equal orders a proper prefix first"
        (string_nf_test_bool(True, string_nf_less_equal(string_nf_test_fuel, [97] : List Nat, [97, 0] : List Nat)))
    , assert_true "less_equal orders empty before nonempty"
        (string_nf_test_bool(False, string_nf_less_equal(string_nf_test_fuel, [0] : List Nat, Nil Nat)))
    , assert_true "less_equal treats high bytes as unsigned"
        (string_nf_test_bool(False, string_nf_less_equal(string_nf_test_fuel, [255] : List Nat, [127] : List Nat)))
    , assert_true "less_equal uses first difference instead of length"
        (string_nf_test_bool(True, string_nf_less_equal(string_nf_test_fuel, [0, 255] : List Nat, [1] : List Nat)))
    , assert_true "less_equal rejects reversed first difference"
        (string_nf_test_bool(False, string_nf_less_equal(string_nf_test_fuel, [98] : List Nat, [97, 255] : List Nat)))
    ] : List Test);

def string_nf_test_invalid : List Test :=
    ([ assert_true "concat validates its right input"
        (string_nf_test_malformed(List Nat, string_nf_concat(string_nf_test_fuel, Nil Nat, [256] : List Nat)))
    , assert_true "length rejects bytes above 255"
        (string_nf_test_malformed(Nat, string_nf_length(string_nf_test_fuel, [256] : List Nat)))
    , assert_true "byte_at validates an unread tail"
        (string_nf_test_malformed(Nat, string_nf_byte_at string_nf_test_fuel ([1, 256] : List Nat) 0))
    , assert_true "empty slice does not hide malformed input"
        (string_nf_test_malformed(List Nat, string_nf_slice string_nf_test_fuel ([256] : List Nat) 99 0))
    , assert_true "equality validates after an early mismatch"
        (string_nf_test_malformed(Bool, string_nf_equal(string_nf_test_fuel, [1, 256] : List Nat, [2] : List Nat)))
    , assert_true "to_codes validates every byte"
        (string_nf_test_malformed(List Nat, string_nf_to_codes(string_nf_test_fuel, [256] : List Nat)))
    , assert_true "empty prefix does not hide malformed input"
        (string_nf_test_malformed(Bool, string_nf_starts(string_nf_test_fuel, [256] : List Nat, Nil Nat)))
    , assert_true "ends validates the suffix"
        (string_nf_test_malformed(Bool, string_nf_ends(string_nf_test_fuel, [1] : List Nat, [256] : List Nat)))
    , assert_true "contains validates the whole pattern"
        (string_nf_test_malformed(Bool, string_nf_contains(string_nf_test_fuel, [1] : List Nat, [2, 256] : List Nat)))
    , assert_true "empty index pattern does not hide malformed input"
        (string_nf_test_malformed(Maybe Nat, string_nf_index(string_nf_test_fuel, [256] : List Nat, Nil Nat)))
    , assert_true "split validates bytes even with an unmatched separator"
        (string_nf_test_malformed(List (List Nat), string_nf_split string_nf_test_fuel ([256] : List Nat) 512))
    , assert_true "empty replacement pattern still validates replacement bytes"
        (string_nf_test_malformed(List Nat, string_nf_replace(string_nf_test_fuel, [1] : List Nat, Nil Nat, [256] : List Nat)))
    , assert_true "ordering validates after an early decisive byte"
        (string_nf_test_malformed(Bool, string_nf_less_equal(string_nf_test_fuel, [1, 256] : List Nat, [2] : List Nat)))
    , assert_true "tokens validates bytes after whitespace"
        (string_nf_test_malformed(List (List Nat), string_nf_tokens(string_nf_test_fuel, [32, 256] : List Nat)))
    ] : List Test);

def string_nf_test_zero_fuel : List Test :=
    ([ assert_true("concat zero fuel exhausts", string_nf_test_exhausted(List Nat, string_nf_concat(0, Nil Nat, Nil Nat)))
    , assert_true("length zero fuel exhausts", string_nf_test_exhausted(Nat, string_nf_length(0, Nil Nat)))
    , assert_true("byte_at zero fuel exhausts", string_nf_test_exhausted(Nat, string_nf_byte_at 0 (Nil Nat) 0))
    , assert_true("slice zero fuel exhausts", string_nf_test_exhausted(List Nat, string_nf_slice 0 (Nil Nat) 0 0))
    , assert_true("equal zero fuel exhausts", string_nf_test_exhausted(Bool, string_nf_equal(0, Nil Nat, Nil Nat)))
    , assert_true("of_nat zero fuel exhausts", string_nf_test_exhausted(List Nat, string_nf_decimal_bytes 0 0))
    , assert_true("to_codes zero fuel exhausts", string_nf_test_exhausted(List Nat, string_nf_to_codes(0, Nil Nat)))
    , assert_true("of_codes zero fuel exhausts", string_nf_test_exhausted(List Nat, string_nf_of_codes(0, Nil Nat)))
    , assert_true("starts zero fuel exhausts", string_nf_test_exhausted(Bool, string_nf_starts(0, Nil Nat, Nil Nat)))
    , assert_true("ends zero fuel exhausts", string_nf_test_exhausted(Bool, string_nf_ends(0, Nil Nat, Nil Nat)))
    , assert_true("contains zero fuel exhausts", string_nf_test_exhausted(Bool, string_nf_contains(0, Nil Nat, Nil Nat)))
    , assert_true("index zero fuel exhausts", string_nf_test_exhausted(Maybe Nat, string_nf_index(0, Nil Nat, Nil Nat)))
    , assert_true("split zero fuel exhausts", string_nf_test_exhausted(List (List Nat), string_nf_split 0 (Nil Nat) 0))
    , assert_true("replace zero fuel exhausts", string_nf_test_exhausted(List Nat, string_nf_replace(0, Nil Nat, Nil Nat, Nil Nat)))
    , assert_true("less_equal zero fuel exhausts", string_nf_test_exhausted(Bool, string_nf_less_equal(0, Nil Nat, Nil Nat)))
    , assert_true("tokens zero fuel exhausts", string_nf_test_exhausted(List (List Nat), string_nf_tokens(0, Nil Nat)))
    ] : List Test);

def string_nf_test_nested_fuel : List Test :=
    ([ assert_true "concat never returns a validated prefix on exhaustion"
        (string_nf_test_exhausted(List Nat, string_nf_concat(2, [97, 98] : List Nat, Nil Nat)))
    , assert_true "of_codes propagates exhaustion inside modulo"
        (string_nf_test_exhausted(List Nat, string_nf_of_codes(2, [512] : List Nat)))
    , assert_true "of_nat propagates exhaustion inside division"
        (string_nf_test_exhausted(List Nat, string_nf_decimal_bytes 3 100))
    , assert_true "split propagates exhaustion inside final field reversal"
        (string_nf_test_exhausted(List (List Nat), string_nf_split 4 ([97, 98, 99] : List Nat) 0))
    , assert_true "replace propagates exhaustion while building replacement"
        (string_nf_test_exhausted(List Nat, string_nf_replace(4, [97, 97] : List Nat, [97] : List Nat, [98, 99, 100] : List Nat)))
    , assert_true "tokens propagates exhaustion inside final token reversal"
        (string_nf_test_exhausted(List (List Nat), string_nf_tokens(4, [97, 98, 99] : List Nat)))
    ] : List Test);

-- @entry main
def main : IO Unit :=
    test_run
      (append Test string_nf_test_basic
        (append Test string_nf_test_conversions
          (append Test string_nf_test_search
            (append Test string_nf_test_partition
              (append Test string_nf_test_ordering
                (append Test string_nf_test_invalid
                  (append Test string_nf_test_zero_fuel string_nf_test_nested_fuel)))))));
