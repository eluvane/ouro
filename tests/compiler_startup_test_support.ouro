-- Compiler source tests avoid importing the standard String convenience
-- module, whose lexer constants intentionally have the same public names.
import "../std/io.ouro";

inductive StartupTest : Type :=
  | StartupTestOf : String -> Bool -> String -> StartupTest;

def startup_test_assert (name : String) (passed : Bool) : StartupTest :=
    StartupTestOf name passed "expected true";

def startup_test_eq (name : String) (actual : String) (expected : String) : StartupTest :=
    StartupTestOf(name, prim_string_eq actual expected, prim_string_concat "observed " actual);

def startup_test_line (success_prefix : String) (name : String) (passed : Bool)
    (detail_prefix : String) (detail : String) : Pair Bool String :=
    MkPair Bool String passed
      (match passed with
       | True => prim_string_concat success_prefix name
       | False => prim_string_concat "FAIL "
           (prim_string_concat name (prim_string_concat detail_prefix detail))
       end);

def startup_test_exit (failed : Bool) : IO Unit :=
    exit (match failed with | True => 1 | False => 0 end);

def startup_test_summary (suite : String) (failed : Bool) : IO Unit :=
    do println (prim_string_concat suite
         (match failed with | True => ": FAIL" | False => ": PASS" end));
       startup_test_exit failed;

def startup_test_run_with (Law : Type) (row : Law -> Pair Bool String)
    (finish : Bool -> IO Unit) (laws : List Law) (failed : Bool) : IO Unit :=
    do let! failed_result := io_fold Law Bool
         (fun (prior : Bool) (law : Law) =>
           match row law with
           | MkPair passed line =>
               do println line; io_pure Bool (orb prior (notb passed))
           end)
         failed laws;
       finish failed_result;

def startup_test_run (tests : List StartupTest) : IO Unit :=
    startup_test_run_with StartupTest
      (fun (law : StartupTest) =>
        match law with | StartupTestOf name passed observed =>
          startup_test_line "ok " name passed " " observed end)
      startup_test_exit tests False;
