-- Compiler source tests avoid importing the standard String convenience
-- module, whose lexer constants intentionally have the same public names.
import "../std/io.ouro";

inductive StartupTest : Type :=
  | StartupTestOf : String -> Bool -> String -> StartupTest;

def startup_test_assert (name : String) (passed : Bool) : StartupTest :=
    StartupTestOf name passed "expected true";

def startup_test_eq (name : String) (actual : String) (expected : String) : StartupTest :=
    StartupTestOf(name, prim_string_eq actual expected, prim_string_concat "observed " actual);

def startup_test_run (tests : List StartupTest) : IO Unit :=
    (fix report (remaining : List StartupTest) (failed : Bool) : IO Unit :=
      match remaining with | Nil => match failed with | True => exit 1 | False => exit 0 end
      | Cons law rest => match law with | StartupTestOf name passed observed =>
          do println (prim_string_concat (match passed with | True => "ok " | False => "FAIL " end)
               (prim_string_concat(name, match passed with | True => "" | False => prim_string_concat " " observed end)));
             report(rest, orb(failed, notb passed)) end end) tests False;
