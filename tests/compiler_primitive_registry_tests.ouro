         (Just CoreTerm (CConst 18))),
     pr_error CoreTerm "file kind propagates normalization failure" PrimitiveResourceExhausted
       (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles PrimitiveFileKind (Nothing CoreTerm)),
