-- All primitive registry assertions execute from this test entrypoint.
import "compiler_primitive_registry_fixtures.ouro";

def pr_operation_tests : List Test :=
    concat_map (Pair PrimitiveWord String) Test
      (fun (word_spec : Pair PrimitiveWord String) => match word_spec with | MkPair word name =>
        append Test
          (map (Pair PrimitiveWordOp String) Test (fun (op_spec : Pair PrimitiveWordOp String) => match op_spec with | MkPair op op_name =>
            pr_signature (str_cat4 "signature " name "." op_name) (PrimitiveWordOperation word op) (pr_word_signature word op) end) pr_op_specs)
          ([pr_signature (str_concat "from Nat " name) (PrimitiveWordFromNat word) (CPi (CInd 40) (CApp (CInd 44) (pr_word_type word))),
            pr_signature (str_concat "to Nat " name) (PrimitiveWordToNat word) (CPi (pr_word_type word) (CInd 40))] : List Test) end) pr_word_specs;

def pr_conversion_tests : List Test :=
    concat_map (Pair PrimitiveWord String) Test
      (fun (source_spec : Pair PrimitiveWord String) => match source_spec with | MkPair source source_name =>
        concat_map (Pair PrimitiveWord String) Test
          (fun (dest_spec : Pair PrimitiveWord String) => match dest_spec with | MkPair dest dest_name =>
            map (Pair PrimitiveConversion String) Test
              (fun (mode_spec : Pair PrimitiveConversion String) => match mode_spec with | MkPair mode mode_name =>
                let id : PrimitiveId := PrimitiveWordConversion source dest mode in
                let name : String := str_cat4 source_name " -> " dest_name (str_concat " " mode_name) in
                match pr_conversion_allowed source dest mode with
                | False => pr_error CoreTerm name PrimitiveInvalidConversion (pr_expected id)
                | True => pr_signature name id (CPi (pr_word_type source)
                    (match mode with | PrimitiveConvertChecked => CApp (CInd 44) (pr_word_type dest)
                     | PrimitiveNarrowWrap => pr_word_type dest | PrimitiveZeroExtend => pr_word_type dest
                     | PrimitiveSignExtend => pr_word_type dest | PrimitiveReinterpret => pr_word_type dest end)) end end) pr_conv_specs end) pr_word_specs end) pr_word_specs;

def pr_context (bindings : List PrimitiveResolved) (roles : List PrimitiveRoleBinding) : Either PrimitiveError Unit :=
    primitive_validate_context primitive_default_fuel pr_nf bindings roles;

def pr_bad_role (role : PrimitiveRole) (params : Nat) (indices : Nat) (family : CoreTerm) (ctors : List CoreTerm) : Test :=
    pr_error Unit (str_concat "invalid role " (str_of_nat (primitive_role_code role))) (PrimitiveInvalidRole role)
      (primitive_validate_role primitive_default_fuel pr_nf (PrimitiveRoleOf role (PrimitiveInductiveOf 50 params indices family ctors)));

def pr_context_tests : List Test :=
    [pr_ok Unit "all checked type and inductive identities" (pr_context pr_bindings pr_roles),
     pr_error Unit "duplicate builtin identity under different names" (PrimitiveDuplicateType PrimitiveU32Type)
       (pr_context (Cons PrimitiveResolved (PrimitiveResolvedAs 19 PrimitiveU32Type (CSort 0)) pr_bindings) pr_roles),
     pr_error Unit "same numeric name for different primitive types" (PrimitiveDuplicateName 10)
       (pr_context (Cons PrimitiveResolved (PrimitiveResolvedAs 10 PrimitiveU32Type (CSort 0)) pr_bindings) pr_roles),
     pr_error Unit "wrong builtin universe" (PrimitiveInvalidTypeBinding 19)
       (pr_context ([PrimitiveResolvedAs 19 PrimitiveU32Type (CSort 1)] : List PrimitiveResolved) pr_roles),
     pr_error Unit "wrong pointer family" (PrimitiveInvalidTypeBinding 19)
       (pr_context ([PrimitiveResolvedAs 19 PrimitiveRawPtrType (CSort 0)] : List PrimitiveResolved) pr_roles),
     pr_ok Unit "type aliases pass through supplied normalizer"
       (primitive_validate_context primitive_default_fuel pr_alias_nf
         ([PrimitiveResolvedAs 19 PrimitiveU32Type (CConst 90)] : List PrimitiveResolved) pr_roles),
     pr_error Unit "normalization failure propagates" PrimitiveResourceExhausted
       (primitive_validate_context primitive_default_fuel pr_nf_error pr_bindings pr_roles),
     pr_error Unit "zero context budget" PrimitiveResourceExhausted (primitive_validate_context 0 pr_nf pr_bindings pr_roles),
     pr_error Unit "oversized context budget" PrimitiveResourceExhausted
       (primitive_validate_context (S primitive_max_fuel) pr_nf pr_bindings pr_roles),
     pr_error CoreTerm "unregistered U32 is not found by source spelling" (PrimitiveMissingType PrimitiveU32Type)
       (primitive_expected_signature primitive_default_fuel pr_nf (Nil PrimitiveResolved) pr_roles
         (PrimitiveWordOperation PrimitiveWordU32 PrimitiveAddWrap) (Nothing CoreTerm)),
     pr_error CoreTerm "checked result requires Maybe role" (PrimitiveMissingRole PrimitiveMaybeRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings (Nil PrimitiveRoleBinding)
         (PrimitiveWordOperation PrimitiveWordU32 PrimitiveDivChecked) (Nothing CoreTerm)),
     pr_error CoreTerm "comparison requires Bool role" (PrimitiveMissingRole PrimitiveBoolRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings (Nil PrimitiveRoleBinding)
         (PrimitiveWordOperation PrimitiveWordU32 PrimitiveWordEqual) (Nothing CoreTerm)),
     pr_error Unit "duplicate role kind" (PrimitiveDuplicateRole PrimitiveNatRole)
       (pr_context pr_bindings (append PrimitiveRoleBinding pr_roles pr_roles)),
     pr_bad_role PrimitiveNatRole 0 0 (CSort 0) ([CPi (CInd 50) (CInd 50), CInd 50] : List CoreTerm),
     pr_bad_role PrimitiveBoolRole 0 0 (CSort 0) ([CInd 50, CPi (CInd 50) (CInd 50)] : List CoreTerm),
     pr_bad_role PrimitiveUnitRole 0 0 (CSort 0) ([CPi (CInd 50) (CInd 50)] : List CoreTerm),
     pr_bad_role PrimitiveListRole 0 0 (CPi (CSort 0) (CSort 0)) (Nil CoreTerm),
     pr_bad_role PrimitiveMaybeRole 1 1 (CPi (CSort 0) (CSort 0)) (Nil CoreTerm),
     pr_bad_role PrimitivePairRole 2 0 (CSort 0) (Nil CoreTerm),
     pr_bad_role PrimitiveListRole 1 0 (CPi (CSort 0) (CSort 0))
       ([CPi (CSort 0) (CApp (CInd 50) (CRel 0)),
         CPi (CSort 0) (CPi (CRel 0) (CPi (CApp (CInd 50) (CRel 1)) (CApp (CInd 50) (CRel 1))))] : List CoreTerm),
     pr_bad_role PrimitiveMaybeRole 1 0 (CPi (CSort 0) (CSort 0))
       ([CPi (CSort 0) (CPi (CRel 0) (CApp (CInd 50) (CRel 1))),
         CPi (CSort 0) (CApp (CInd 50) (CRel 0))] : List CoreTerm),
     pr_bad_role PrimitivePairRole 2 0 (CPi (CSort 0) (CPi (CSort 0) (CSort 0)))
       ([CPi (CSort 0) (CPi (CSort 0) (CPi (CRel 1) (CPi (CRel 2)
         (CApp (CApp (CInd 50) (CRel 3)) (CRel 2)))))] : List CoreTerm),
     pr_error CoreTerm "call specialization is required" PrimitiveSpecializationRequired (pr_expected PrimitiveFnCall),
     pr_error CoreTerm "other keys reject specialization" PrimitiveUnexpectedSpecialization
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles PrimitiveU32Type (Just CoreTerm (CConst 11)))];

def pr_runtime (typ : CoreTerm) : CoreTerm := CApp (CConst 16) typ;
def pr_pointer (typ : CoreTerm) : CoreTerm := CApp (CConst 15) typ;
def pr_function (typ : CoreTerm) : CoreTerm := CApp (CConst 17) typ;

def pr_template_tests : List Test :=
    [pr_signature "Runtime pure retains bound A" PrimitiveRuntimePure
       (CPi (CSort 0) (CPi (CRel 0) (pr_runtime (CRel 1)))),
     pr_signature "temporary file is an effectful String" PrimitiveFileTemp (pr_runtime (CConst 18)),
     pr_signature "temporary directory argument remains String" PrimitiveFileTempIn
       (CPi (CConst 18) (pr_runtime (CConst 18))),
     pr_signature "inherited process keeps OS error distinct from child exit" PrimitiveProcessInherit
       (CPi (CConst 18) (CPi (CApp (CInd 43) (CConst 18))
         (pr_runtime (CApp (CApp (CInd 45) (CInd 40)) (CInd 40))))),
     pr_error CoreTerm "inherited process requires Pair identity" (PrimitiveMissingRole PrimitivePairRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
         (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) =>
           notb (primitive_role_equal (primitive_role_kind role) PrimitivePairRole)) pr_roles)
         PrimitiveProcessInherit (Nothing CoreTerm)),
     pr_error CoreTerm "inherited process requires Nat identity" (PrimitiveMissingRole PrimitiveNatRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
         (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) =>
           notb (primitive_role_equal (primitive_role_kind role) PrimitiveNatRole)) pr_roles)
         PrimitiveProcessInherit (Nothing CoreTerm)),
     pr_error CoreTerm "inherited process rejects specialization" PrimitiveUnexpectedSpecialization
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles
         PrimitiveProcessInherit (Just CoreTerm (CConst 18))),
     pr_signature "process capture status and both streams" PrimitiveProcessCapture
       (CPi (CConst 18) (CPi (CApp (CInd 43) (CConst 18))
         (pr_runtime (CApp (CApp (CInd 45) (CInd 40))
           (CApp (CApp (CInd 45) (CConst 18)) (CConst 18)))))),
     pr_signature "HTTP headers and body are distinct arguments" PrimitiveHttpPost
       (CPi (CConst 18) (CPi (CApp (CInd 43) (CApp (CApp (CInd 45) (CConst 18)) (CConst 18)))
         (CPi (CConst 18) (pr_runtime (CApp (CApp (CInd 45) (CInd 40))
           (CApp (CApp (CInd 45) (CConst 18)) (CConst 18))))))),
     pr_error CoreTerm "process capture cannot invent the Pair representation" (PrimitiveMissingRole PrimitivePairRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
         (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) =>
           notb (primitive_role_equal (primitive_role_kind role) PrimitivePairRole)) pr_roles)
         PrimitiveProcessCapture (Nothing CoreTerm)),
     pr_signature "Runtime bind retains A and B across action/continuation" PrimitiveRuntimeBind
       (CPi (CSort 0) (CPi (CSort 0) (CPi (pr_runtime (CRel 1))
         (CPi (CPi (CRel 2) (pr_runtime (CRel 2))) (pr_runtime (CRel 2)))))),
     pr_signature "Runtime loop keeps state and both actions opaque" PrimitiveRuntimeLoop
       (CPi (CSort 0) (CPi (CRel 0) (CPi (CPi (CRel 1) (pr_runtime (CConst 10)))
         (CPi (CPi (CRel 2) (pr_runtime (CRel 3))) (pr_runtime (CRel 3)))))),
     pr_signature "typed null" PrimitiveRawNull (CPi (CSort 0) (pr_pointer (CRel 0))),
     pr_error CoreTerm "raw load requires scalar specialization" PrimitiveSpecializationRequired (pr_expected PrimitiveRawLoad),
     pr_error CoreTerm "raw store requires scalar specialization" PrimitiveSpecializationRequired (pr_expected PrimitiveRawStore),
     pr_signature "raw byte offset is usize" PrimitiveRawAddWrap
       (CPi (CSort 0) (CPi (pr_pointer (CRel 0)) (CPi (CConst 14) (pr_runtime (pr_pointer (CRel 2)))))),
     pr_signature "raw cast preserves target binder" PrimitiveRawCast
       (CPi (CSort 0) (CPi (CSort 0) (CPi (pr_pointer (CRel 1)) (pr_runtime (pr_pointer (CRel 1)))))),
     pr_signature "pointer address bits" PrimitiveRawToBits
       (CPi (CSort 0) (CPi (pr_pointer (CRel 0)) (pr_runtime (CConst 14)))),
     pr_signature "pointer from address bits" PrimitiveRawFromBits
       (CPi (CSort 0) (CPi (CConst 14) (pr_runtime (pr_pointer (CRel 1))))),
     pr_signature "String concat" (PrimitiveStringOperation PrimitiveStringConcat) (CPi (CConst 18) (CPi (CConst 18) (CConst 18))),
     pr_signature "String length stays structural Nat" (PrimitiveStringOperation PrimitiveStringLength) (CPi (CConst 18) (CInd 40)),
     pr_signature "String byte index stays structural Nat" (PrimitiveStringOperation PrimitiveStringByteAt) (CPi (CConst 18) (CPi (CInd 40) (CInd 40))),
     pr_signature "String slice" (PrimitiveStringOperation PrimitiveStringSlice) (CPi (CConst 18) (CPi (CInd 40) (CPi (CInd 40) (CConst 18)))),
     pr_signature "String of Nat" (PrimitiveStringOperation PrimitiveStringOfNat) (CPi (CInd 40) (CConst 18)),
     pr_signature "String to List Nat" (PrimitiveStringOperation PrimitiveStringToCodes) (CPi (CConst 18) (CApp (CInd 43) (CInd 40))),
     pr_signature "String of List Nat" (PrimitiveStringOperation PrimitiveStringOfCodes) (CPi (CApp (CInd 43) (CInd 40)) (CConst 18)),
     pr_signature "String index Maybe Nat" (PrimitiveStringOperation PrimitiveStringIndex) (CPi (CConst 18) (CPi (CConst 18) (CApp (CInd 44) (CInd 40)))),
     pr_signature "String split List String" (PrimitiveStringOperation PrimitiveStringSplit) (CPi (CConst 18) (CPi (CInd 40) (CApp (CInd 43) (CConst 18)))),
     pr_signature "String replace" (PrimitiveStringOperation PrimitiveStringReplace) (CPi (CConst 18) (CPi (CConst 18) (CPi (CConst 18) (CConst 18)))),
     pr_signature "String tokens" (PrimitiveStringOperation PrimitiveStringTokens) (CPi (CConst 18) (CApp (CInd 43) (CConst 18)))];

def pr_abi_text (value : PrimitiveAbiValue) : String :=
    match value with | PrimitiveAbiWord word => str_concat "word" (str_of_nat (primitive_word_code word))
    | PrimitiveAbiPointer pointee => str_concat "ptr:" (pr_core_text 64 pointee)
    | PrimitiveAbiFunction signature => str_concat "fn:" (pr_core_text 64 signature) end;

def pr_abi_result (name : String) (expected : String) (got : Either PrimitiveError PrimitiveAbiSignature) : Test :=
    match got with | Left err => test_fail name (pr_error_text err)
    | Right signature => match signature with | PrimitiveAbiSignatureOf args result =>
        assert_eq name (str_cat3 (str_join "," (map PrimitiveAbiValue String pr_abi_text args)) " -> "
          (match result with | Nothing => "void" | Just value => pr_abi_text value end)) expected end end;

def pr_resolve (signature : CoreTerm) : Either PrimitiveError PrimitiveAbiSignature :=
    primitive_resolve_signature primitive_default_fuel pr_nf pr_bindings pr_roles signature;

def pr_reject_abi_value (name : String) (typ : CoreTerm) (err : PrimitiveError) : Test :=
    pr_error PrimitiveAbiSignature name err (pr_resolve (CPi typ (pr_runtime (CConst 11))));

def pr_abi_tests : List Test :=
    [pr_abi_result "zero-argument external" " -> word1" (pr_resolve (pr_runtime (CConst 11))),
     pr_abi_result "all machine ABI arguments plus raw pointee" "word0,word1,word2,word3,word4,ptr:c18 -> void"
       (pr_resolve (CPi (CConst 10) (CPi (CConst 11) (CPi (CConst 12) (CPi (CConst 13)
         (CPi (CConst 14) (CPi (pr_pointer (CConst 18)) (pr_runtime (CInd 42))))))))),
     pr_abi_result "function pointers retain checked signature" "fn:Pi(c11,App(c16,i42)) -> fn:App(c16,c12)"
       (pr_resolve (CPi (pr_function (CPi (CConst 11) (pr_runtime (CInd 42))))
         (pr_runtime (pr_function (pr_runtime (CConst 12)))))),
     pr_abi_result "aliases normalize nested ABI types" "word1,ptr:c11 -> void"
       (primitive_resolve_signature primitive_default_fuel pr_alias_nf pr_bindings pr_roles
         (CPi (CConst 91) (CPi (CApp (CConst 92) (CConst 91)) (CApp (CConst 93) (CConst 94))))),
     pr_reject_abi_value "unregistered same-spelled machine type" (CConst 99) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "Nat is not an ABI word" (CInd 40) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "Bool is not an ABI byte" (CInd 41) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "Unit is result-only" (CInd 42) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "String is a managed value" (CConst 18) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "ordinary closure is not raw function pointer" (CPi (CConst 11) (pr_runtime (CConst 11))) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "List is not aggregate-by-value ABI" (CApp (CInd 43) (CConst 11)) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "runtime action is not an ABI argument" (pr_runtime (CConst 11)) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "dependent word argument" (CRel 0) PrimitiveDependentAbi,
     pr_reject_abi_value "dependent pointer pointee" (pr_pointer (CRel 0)) PrimitiveDependentAbi,
     pr_reject_abi_value "nested function dependency" (pr_function (CPi (pr_pointer (CRel 0)) (pr_runtime (CConst 11)))) PrimitiveDependentAbi,
     pr_reject_abi_value "raw function returning pure proof rejected" (pr_function (CInd 99)) PrimitiveRuntimeResultRequired,
     pr_reject_abi_value "raw function returning pure word rejected" (pr_function (CPi (CConst 11) (CConst 11))) PrimitiveRuntimeResultRequired,
     pr_reject_abi_value "nested function with managed argument" (pr_function (CPi (CConst 18) (pr_runtime (CInd 42)))) PrimitiveUnsupportedAbiType,
     pr_reject_abi_value "lambda in opaque pointee rejected" (pr_pointer (CLam (CSort 0) (CRel 0))) PrimitiveUnsupportedAbiType,
     pr_error PrimitiveAbiSignature "external pure result rejected" PrimitiveRuntimeResultRequired (pr_resolve (CPi (CConst 11) (CConst 11))),
     pr_error PrimitiveAbiSignature "external managed result rejected" PrimitiveUnsupportedAbiType (pr_resolve (pr_runtime (CConst 18))),
     pr_error PrimitiveAbiSignature "same-spelled Runtime is not a binding" PrimitiveRuntimeResultRequired (pr_resolve (CApp (CConst 99) (CConst 11))),
     pr_error PrimitiveAbiSignature "unregistered Unit is not void" PrimitiveUnsupportedAbiType
       (primitive_resolve_signature primitive_default_fuel pr_nf pr_bindings (Nil PrimitiveRoleBinding) (pr_runtime (CInd 42))),
     pr_error PrimitiveAbiSignature "ABI normalization errors propagate" PrimitiveResourceExhausted
       (primitive_resolve_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles (pr_runtime (CConst 11))),
     pr_error PrimitiveAbiSignature "bounded ABI scan" PrimitiveResourceExhausted
       (primitive_resolve_signature 1 pr_nf pr_bindings pr_roles (pr_runtime (CConst 11))),
     pr_signature_result "specialized call has RawFn S then exact S"
       (CPi (pr_function (CPi (CConst 11) (pr_runtime (CInd 42)))) (CPi (CConst 11) (pr_runtime (CInd 42))))
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles PrimitiveFnCall
         (Just CoreTerm (CPi (CConst 11) (pr_runtime (CInd 42))))),
     pr_error CoreTerm "generic RawFn S to S proof escape rejected" PrimitiveDependentAbi
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles PrimitiveFnCall
         (Just CoreTerm (CPi (CSort 0) (CPi (pr_function (CRel 0)) (CRel 1)))))];

def pr_extern (target : List Nat) (abi : List Nat) (dll : List Nat) (symbol : List Nat) (variadic : Bool) (gc : PrimitiveGc)
    : Either PrimitiveError CheckedExtern :=
    primitive_check_extern primitive_default_fuel pr_nf pr_bindings pr_roles
      (ExternRequestOf target abi dll symbol variadic gc) (CPi (CConst 11) (pr_runtime (CInd 42)));

def pr_win : List Nat := str_codes "windows-x86_64";
def pr_winabi : List Nat := str_codes "win64";
def pr_dll : List Nat := str_codes "kernel32.dll";
def pr_symbol : List Nat := str_codes "ExitProcess";
def pr_name_case (label : String) (dll : List Nat) (symbol : List Nat) : Test :=
    pr_error CheckedExtern label PrimitiveInvalidExternName (pr_extern pr_win pr_winabi dll symbol False PrimitiveMayGc);

def pr_extern_gc (gc : PrimitiveGc) : Test :=
    match pr_extern pr_win pr_winabi pr_dll pr_symbol False gc with
    | Left err => test_fail "extern metadata" (pr_error_text err)
    | Right checked => match checked with | CheckedExternOf PrimitiveWindowsX64 PrimitiveWin64 dll symbol signature actual =>
        assert_true "extern metadata preserves names, signature and GC contract"
          (andb (primitive_bytes_equal dll pr_dll) (andb (primitive_bytes_equal symbol pr_symbol)
            (andb (match signature with | PrimitiveAbiSignatureOf args result =>
              andb (eqNat (length PrimitiveAbiValue args) 1) (match result with | Nothing => True | Just _ => False end) end)
              (match actual, gc with | PrimitiveNoGc, PrimitiveNoGc => True | PrimitiveMayGc, PrimitiveMayGc => True
               | PrimitiveNoGc, PrimitiveMayGc => False | PrimitiveMayGc, PrimitiveNoGc => False end)))) end end;

def pr_extern_tests : List Test :=
    [pr_extern_gc PrimitiveMayGc, pr_extern_gc PrimitiveNoGc,
     pr_error CheckedExtern "unsupported target" PrimitiveUnsupportedTarget
       (pr_extern (str_codes "linux-x86_64") pr_winabi pr_dll pr_symbol False PrimitiveMayGc),
     pr_error CheckedExtern "wrong ABI" PrimitiveUnsupportedAbi
       (pr_extern pr_win (str_codes "cdecl") pr_dll pr_symbol False PrimitiveMayGc),
     pr_error CheckedExtern "variadic extern rejected" PrimitiveVariadicExtern
       (pr_extern pr_win pr_winabi pr_dll pr_symbol True PrimitiveMayGc),
     pr_name_case "empty DLL" (Nil Nat) pr_symbol, pr_name_case "empty symbol" pr_dll (Nil Nat),
     pr_name_case "NUL DLL" ([65, 0, 66] : List Nat) pr_symbol,
     pr_name_case "NUL symbol" pr_dll ([65, 0, 66] : List Nat),
     pr_name_case "non-ASCII DLL" ([128] : List Nat) pr_symbol,
     pr_name_case "non-byte symbol" pr_dll ([256] : List Nat),
     pr_name_case "DLL exceeds bounded name length" (replicate Nat 65 (add 256 5)) pr_symbol,
     pr_name_case "symbol exceeds bounded name length" pr_dll (replicate Nat 65 (S (mul 4 256))),
     pr_ok CheckedExtern "exact name limits accepted"
       (pr_extern pr_win pr_winabi (replicate Nat 65 (add 256 4)) (replicate Nat 65 (mul 4 256)) False PrimitiveMayGc)];

def pr_layout (size : Nat) (alignment : Nat) (packed : Bool) (fields : List PrimitiveRawField)
    : Either PrimitiveError PrimitiveCheckedLayout :=
    primitive_validate_layout primitive_default_fuel pr_nf pr_bindings pr_roles (PrimitiveRawLayoutOf size alignment packed fields);
def pr_field (id : Nat) (offset : Nat) (word : PrimitiveWord) : PrimitiveRawField :=
    PrimitiveRawFieldAt id offset (PrimitiveAbiWord word);
def pr_layout_error (label : String) (fault : PrimitiveLayoutFault) (size : Nat) (alignment : Nat)
    (packed : Bool) (fields : List PrimitiveRawField) : Test :=
    pr_error PrimitiveCheckedLayout label (PrimitiveInvalidLayout fault) (pr_layout size alignment packed fields);

def pr_layout_tests : List Test :=
    [pr_ok PrimitiveCheckedLayout "aligned mixed-width fields" (pr_layout 24 8 False
       ([pr_field 1 0 PrimitiveWordU8, pr_field 2 4 PrimitiveWordU32, pr_field 3 8 PrimitiveWordU64,
         PrimitiveRawFieldAt 4 16 (PrimitiveAbiPointer (CConst 18))] : List PrimitiveRawField)),
     pr_ok PrimitiveCheckedLayout "explicit packed fields" (pr_layout 9 1 True
       ([pr_field 1 0 PrimitiveWordU8, pr_field 2 1 PrimitiveWordU64] : List PrimitiveRawField)),
     pr_ok PrimitiveCheckedLayout "maximum positive layout offset" (pr_layout primitive_max_offset 1 True
       ([pr_field 1 (sub primitive_max_offset 1) PrimitiveWordU8] : List PrimitiveRawField)),
     pr_ok PrimitiveCheckedLayout "maximum supported alignment" (pr_layout (mul 16 256) (mul 16 256) False (Nil PrimitiveRawField)),
     pr_layout_error "zero size" PrimitiveLayoutSize 0 1 False (Nil PrimitiveRawField),
     pr_layout_error "zero alignment" PrimitiveLayoutAlignment 8 0 False (Nil PrimitiveRawField),
     pr_layout_error "non-power-of-two alignment" PrimitiveLayoutAlignment 12 3 False (Nil PrimitiveRawField),
     pr_layout_error "excess alignment" PrimitiveLayoutAlignment (mul 32 256) (mul 32 256) False (Nil PrimitiveRawField),
     pr_layout_error "size is not alignment multiple" PrimitiveLayoutAlignment 9 8 False (Nil PrimitiveRawField),
     pr_layout_error "maximum offset cannot round past signed Nat bound" PrimitiveLayoutAlignment primitive_max_offset 2 False (Nil PrimitiveRawField),
     pr_layout_error "offset exceeds size" (PrimitiveLayoutFieldRange 1) 8 8 False ([pr_field 1 primitive_max_offset PrimitiveWordU8] : List PrimitiveRawField),
     pr_layout_error "field end exceeds size" (PrimitiveLayoutFieldRange 1) 8 8 False ([pr_field 1 8 PrimitiveWordU8] : List PrimitiveRawField),
     pr_layout_error "field end checked before overflowing addition" (PrimitiveLayoutFieldRange 1) primitive_max_offset 1 True
       ([pr_field 1 (sub primitive_max_offset 1) PrimitiveWordU64] : List PrimitiveRawField),
     pr_layout_error "field address misalignment" (PrimitiveLayoutFieldAlignment 1) 16 8 False ([pr_field 1 1 PrimitiveWordU64] : List PrimitiveRawField),
     pr_layout_error "aggregate alignment too small" (PrimitiveLayoutFieldAlignment 1) 8 1 False ([pr_field 1 0 PrimitiveWordU64] : List PrimitiveRawField),
     pr_layout_error "overlap rejected even when packed" (PrimitiveLayoutFieldOverlap 2) 16 1 True
       ([pr_field 1 0 PrimitiveWordU64, pr_field 2 4 PrimitiveWordU32] : List PrimitiveRawField),
     pr_layout_error "unordered fields rejected" (PrimitiveLayoutFieldOverlap 2) 16 8 False
       ([pr_field 1 8 PrimitiveWordU64, pr_field 2 0 PrimitiveWordU8] : List PrimitiveRawField),
     pr_layout_error "duplicate field identity" (PrimitiveLayoutDuplicateField 1) 16 8 False
       ([pr_field 1 0 PrimitiveWordU64, pr_field 1 8 PrimitiveWordU64] : List PrimitiveRawField),
     pr_error PrimitiveCheckedLayout "layout rechecks function pointer signature" PrimitiveRuntimeResultRequired
       (pr_layout 8 8 False ([PrimitiveRawFieldAt 1 0 (PrimitiveAbiFunction (CConst 11))] : List PrimitiveRawField)),
     pr_error PrimitiveCheckedLayout "layout rejects dependent pointer metadata" PrimitiveDependentAbi
       (pr_layout 8 8 False ([PrimitiveRawFieldAt 1 0 (PrimitiveAbiPointer (CRel 0))] : List PrimitiveRawField)),
     pr_error Nat "remainder zero divisor is a typed error" (PrimitiveInvalidLayout PrimitiveLayoutAlignment) (primitive_layout_remainder 8 0)];

def pr_misc_tests : List Test :=
    [assert_true "closed identities and spellings are unique"
       (andb (pr_unique_ids primitive_catalog) (pr_unique_keys primitive_key_table)),
     pr_signature "rename reports OS status without inventing Unit success" PrimitiveFileRename
       (CPi (CConst 18) (CPi (CConst 18) (pr_runtime (CInd 40)))),
     pr_error PrimitiveId "embedded NUL key" PrimitiveUnknownKey (primitive_decode primitive_default_fuel ([111, 0] : List Nat)),
     pr_error PrimitiveId "non-ASCII key" PrimitiveUnknownKey (primitive_decode primitive_default_fuel ([128] : List Nat)),
     pr_error PrimitiveId "excess key length" PrimitiveUnknownKey (primitive_decode primitive_default_fuel (replicate Nat 65 129)),
     pr_error PrimitiveId "lookup exhausted before last key" PrimitiveResourceExhausted (primitive_decode 1 (str_codes "ouro.string.tokens")),
     pr_error PrimitiveId "zero decode budget" PrimitiveResourceExhausted (primitive_decode 0 (str_codes "ouro.u8")),
     assert_true "pure machine addition is NoGc" (match primitive_binding (PrimitiveWordOperation PrimitiveWordU64 PrimitiveAddWrap) (Nothing CoreTerm) with
       | PrimitiveIntrinsicBinding _ execution gc _ => match execution with
         | PrimitivePureValue => match gc with | PrimitiveNoGc => True | PrimitiveMayGc => False end
         | PrimitiveTypeOnly => False | PrimitiveRuntimeAction => False end
       | PrimitiveExternBinding _ => False end),
     assert_true "checked arithmetic can allocate Maybe" (match primitive_gc (PrimitiveWordOperation PrimitiveWordI32 PrimitiveDivChecked) with | PrimitiveMayGc => True | PrimitiveNoGc => False end),
     assert_true "unknown indirect call remains MayGc" (match primitive_gc PrimitiveFnCall with | PrimitiveMayGc => True | PrimitiveNoGc => False end)];

def pr_nat_result (name : String) (expected : Nat) (got : Either PrimitiveError Nat) : Test :=
    match got with | Left err => test_fail name (pr_error_text err)
    | Right value => assert_eq name (str_of_nat value) (str_of_nat expected) end;

def pr_layout_alias_test : Test :=
    match primitive_validate_layout primitive_default_fuel pr_alias_nf pr_bindings pr_roles
      (PrimitiveRawLayoutOf 16 8 False
        ([PrimitiveRawFieldAt 1 0 (PrimitiveAbiPointer (CConst 91)),
          PrimitiveRawFieldAt 2 8 (PrimitiveAbiFunction (CPi (CConst 91) (CApp (CConst 93) (CConst 94))))] : List PrimitiveRawField)) with
    | Left err => test_fail "layout retains normalized ABI metadata" (pr_error_text err)
    | Right checked => match checked with | PrimitiveLayoutChecked layout => match layout with
      | PrimitiveRawLayoutOf size alignment packed fields =>
          assert_eq "layout retains normalized ABI metadata"
            (str_cat4 (str_of_nat size) "/" (str_of_nat alignment)
              (str_concat (match packed with | False => ":natural:" | True => ":packed:" end)
                (str_join ";" (map PrimitiveRawField String
                  (fun (field : PrimitiveRawField) => match field with | PrimitiveRawFieldAt id offset value =>
                    str_cat4 (str_of_nat id) "@" (str_of_nat offset) (str_concat ":" (pr_abi_text value)) end) fields))))
            "16/8:natural:1@0:ptr:c11;2@8:fn:Pi(c11,App(c16,i42))" end end end;

def pr_additional_tests : List Test :=
    [pr_signature "U8 type template" PrimitiveU8Type (CSort 0),
     pr_signature "U32 type template" PrimitiveU32Type (CSort 0),
     pr_signature "U64 type template" PrimitiveU64Type (CSort 0),
     pr_signature "I32 type template" PrimitiveI32Type (CSort 0),
     pr_signature "usize type template" PrimitiveUSizeType (CSort 0),
     pr_signature "String type template" PrimitiveStringType (CSort 0),
     pr_signature "RawPtr type family template" PrimitiveRawPtrType (CPi (CSort 0) (CSort 0)),
     pr_signature "RawFn type family template" PrimitiveRawFnType (CPi (CSort 0) (CSort 0)),
     pr_signature "Runtime type family template" PrimitiveRuntimeType (CPi (CSort 0) (CSort 0)),
     pr_ok Unit "operation identity may have distinct checked declaration names"
       (pr_context (append PrimitiveResolved pr_bindings
         ([PrimitiveResolvedAs 19 (PrimitiveWordOperation PrimitiveWordU32 PrimitiveAddWrap) (CPi (CConst 11) (CPi (CConst 11) (CConst 11))),
           PrimitiveResolvedAs 20 (PrimitiveWordOperation PrimitiveWordU32 PrimitiveAddWrap) (CPi (CConst 11) (CPi (CConst 11) (CConst 11)))] : List PrimitiveResolved)) pr_roles),
     pr_error Unit "one inductive ID cannot provide distinct roles" (PrimitiveDuplicateRole PrimitiveBoolRole)
       (pr_context pr_bindings
         ([PrimitiveRoleOf PrimitiveUnitRole (PrimitiveInductiveOf 50 0 0 (CSort 0) ([CInd 50] : List CoreTerm)),
           PrimitiveRoleOf PrimitiveBoolRole (PrimitiveInductiveOf 50 0 0 (CSort 0) ([CInd 50, CInd 50] : List CoreTerm))] : List PrimitiveRoleBinding)),
     pr_ok Unit "role family and constructors normalize through aliases"
       (primitive_validate_role primitive_default_fuel pr_alias_nf
         (PrimitiveRoleOf PrimitiveNatRole (PrimitiveInductiveOf 50 0 0 (CConst 90)
           ([CConst 95, CPi (CConst 95) (CConst 95)] : List CoreTerm)))),
     pr_error Unit "closed type traversal has explicit resource failure" PrimitiveResourceExhausted
       (primitive_closed_type 1 (CPi (CConst 11) (pr_runtime (CConst 11)))),
     pr_error PrimitiveAbiValue "ABI value zero budget" PrimitiveResourceExhausted
       (primitive_abi_value 0 pr_nf pr_bindings pr_roles (CConst 11)),
     pr_nat_result "maximum offset remainder 1" 0 (primitive_layout_remainder primitive_max_offset 1),
     pr_nat_result "maximum offset remainder 2" 1 (primitive_layout_remainder primitive_max_offset 2),
     pr_nat_result "maximum offset remainder 8" 7 (primitive_layout_remainder primitive_max_offset 8),
     pr_nat_result "maximum offset equal divisor" 0 (primitive_layout_remainder primitive_max_offset primitive_max_offset),
     pr_nat_result "maximum offset adjacent divisor" 1 (primitive_layout_remainder primitive_max_offset (sub primitive_max_offset 1)),
     pr_nat_result "divisor exceeds dividend" 17 (primitive_layout_remainder 17 primitive_max_offset),
     pr_nat_result "zero dividend" 0 (primitive_layout_remainder 0 8),
     pr_nat_result "non-power-of-two remainder" 2 (primitive_layout_remainder 17 3),
     pr_layout_alias_test];

def pr_storage (id : PrimitiveId) (typ : CoreTerm) : Either PrimitiveError CoreTerm :=
    primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles id (Just CoreTerm typ);

def pr_storage_tests : List Test :=
    append Test
      (concat_map (Pair String CoreTerm) Test
        (fun (example : Pair String CoreTerm) => match example with
          | MkPair label typ =>
              ([pr_signature_result (str_concat "raw load " label) (CPi (pr_pointer typ) (pr_runtime typ))
                 (pr_storage PrimitiveRawLoad typ),
               pr_signature_result (str_concat "raw store " label)
                 (CPi (pr_pointer typ) (CPi typ (pr_runtime (CInd 42)))) (pr_storage PrimitiveRawStore typ)] : List Test)
          end)
        ([MkPair String CoreTerm "u8" (CConst 10), MkPair String CoreTerm "u32" (CConst 11),
          MkPair String CoreTerm "u64" (CConst 12), MkPair String CoreTerm "i32" (CConst 13),
          MkPair String CoreTerm "usize" (CConst 14), MkPair String CoreTerm "pointer to managed bytes" (pr_pointer (CConst 18)),
          MkPair String CoreTerm "pointer to proof" (pr_pointer (CInd 99)),
          MkPair String CoreTerm "typed function pointer" (pr_function (CPi (CConst 11) (pr_runtime (CInd 42))))]
          : List (Pair String CoreTerm)))
      (append Test
        (concat_map (Pair String CoreTerm) Test
          (fun (example : Pair String CoreTerm) => match example with
            | MkPair label typ =>
                ([pr_error CoreTerm (str_concat "raw load rejects " label) PrimitiveUnsupportedAbiType
                   (pr_storage PrimitiveRawLoad typ),
                 pr_error CoreTerm (str_concat "raw store rejects " label) PrimitiveUnsupportedAbiType
                   (pr_storage PrimitiveRawStore typ)] : List Test)
            end)
          ([MkPair String CoreTerm "managed String" (CConst 18), MkPair String CoreTerm "Nat" (CInd 40),
            MkPair String CoreTerm "Bool" (CInd 41), MkPair String CoreTerm "Unit storage" (CInd 42),
            MkPair String CoreTerm "proof term" (CInd 99), MkPair String CoreTerm "closure" (CPi (CConst 11) (CConst 11))]
            : List (Pair String CoreTerm)))
        ([pr_signature_result "raw storage alias normalizes to machine identity"
            (CPi (pr_pointer (CConst 11)) (pr_runtime (CConst 11)))
            (primitive_expected_signature primitive_default_fuel pr_alias_nf pr_bindings pr_roles PrimitiveRawLoad
              (Just CoreTerm (CConst 91))),
          pr_error CoreTerm "raw load rejects dependent storage" PrimitiveDependentAbi
            (pr_storage PrimitiveRawLoad (CRel 0)),
          pr_error CoreTerm "raw store requires checked Unit role" (PrimitiveMissingRole PrimitiveUnitRole)
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings (Nil PrimitiveRoleBinding) PrimitiveRawStore
              (Just CoreTerm (CConst 11))),
          pr_error CoreTerm "raw storage normalization errors propagate" PrimitiveResourceExhausted
            (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles PrimitiveRawLoad
              (Just CoreTerm (CConst 11)))] : List Test));

def pr_stdio_ids : List PrimitiveId :=
    [PrimitiveStdoutWrite, PrimitiveStderrWrite, PrimitiveStdoutFlush, PrimitiveProcessExit];

def pr_stdio_tests : List Test :=
    append Test
      ([pr_signature "stdout consumes managed String and returns an action" PrimitiveStdoutWrite
          (CPi (CConst 18) (pr_runtime (CInd 42))),
        pr_signature "stderr consumes managed String and returns an action" PrimitiveStderrWrite
          (CPi (CConst 18) (pr_runtime (CInd 42))),
        pr_signature "flush is a zero-argument action" PrimitiveStdoutFlush (pr_runtime (CInd 42)),
        pr_signature "exit consumes structural Nat and returns an action" PrimitiveProcessExit
          (CPi (CInd 40) (pr_runtime (CInd 42))),
        pr_error CoreTerm "stdout requires registered String" (PrimitiveMissingType PrimitiveStringType)
          (primitive_expected_signature primitive_default_fuel pr_nf
            (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
              | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveStringType) end) pr_bindings)
            pr_roles PrimitiveStdoutWrite (Nothing CoreTerm)),
        pr_error CoreTerm "exit requires the Nat role" (PrimitiveMissingRole PrimitiveNatRole)
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
            (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) => match role with
              | PrimitiveRoleOf id _ => notb (eqNat (primitive_role_code id) (primitive_role_code PrimitiveNatRole)) end) pr_roles)
            PrimitiveProcessExit (Nothing CoreTerm))] : List Test)
      (concat_map PrimitiveId Test (fun (id : PrimitiveId) =>
        let key : String := str_of_codes (primitive_key id) in
        ([pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles id (Just CoreTerm (CConst 11))),
          pr_error CoreTerm (str_concat key " requires registered Runtime") (PrimitiveMissingType PrimitiveRuntimeType)
            (primitive_expected_signature primitive_default_fuel pr_nf
              (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
                | PrimitiveResolvedAs _ current _ => notb (primitive_id_equal current PrimitiveRuntimeType) end) pr_bindings)
              pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " requires the Unit role") (PrimitiveMissingRole PrimitiveUnitRole)
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
              (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) => match role with
                | PrimitiveRoleOf current _ => notb (eqNat (primitive_role_code current) (primitive_role_code PrimitiveUnitRole)) end) pr_roles)
              id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " propagates normalization failure") PrimitiveResourceExhausted
            (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " has bounded signature work") PrimitiveResourceExhausted
            (primitive_expected_signature 0 pr_nf pr_bindings pr_roles id (Nothing CoreTerm)),
          assert_true (str_concat key " keeps execution deferred")
            (match primitive_execution id with | PrimitiveRuntimeAction => True | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
          assert_true (str_concat key " accounts for managed action construction")
            (match primitive_gc id with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test)) pr_stdio_ids);

def pr_startup_tests : List Test :=
    append Test
      ([pr_signature "argv returns a checked List of String" PrimitiveArgv (pr_runtime (CApp (CInd 43) (CConst 18))),
        pr_signature "environment returns checked Maybe String" PrimitiveEnvGet
          (CPi (CConst 18) (pr_runtime (CApp (CInd 44) (CConst 18)))),
        assert_true "startup IDs follow stdio without overlapping String identities"
          (andb (eqNat (primitive_id_code PrimitiveArgv) 250) (eqNat (primitive_id_code PrimitiveEnvGet) 251))] : List Test)
      (concat_map PrimitiveId Test (fun (id : PrimitiveId) =>
        let key : String := str_of_codes (primitive_key id) in
        let role : PrimitiveRole := match primitive_id_equal id PrimitiveArgv with
          | True => PrimitiveListRole | False => PrimitiveMaybeRole end in
        ([pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles id (Just CoreTerm (CConst 18))),
          pr_error CoreTerm (str_concat key " requires checked Runtime") (PrimitiveMissingType PrimitiveRuntimeType)
            (primitive_expected_signature primitive_default_fuel pr_nf
              (filter PrimitiveResolved (fun (binding : PrimitiveResolved) => match binding with
                | PrimitiveResolvedAs _ current _ => notb (primitive_id_equal current PrimitiveRuntimeType) end) pr_bindings)
              pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " requires checked String") (PrimitiveMissingType PrimitiveStringType)
            (primitive_expected_signature primitive_default_fuel pr_nf
              (filter PrimitiveResolved (fun (binding : PrimitiveResolved) => match binding with
                | PrimitiveResolvedAs _ current _ => notb (primitive_id_equal current PrimitiveStringType) end) pr_bindings)
              pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " requires the exact container role") (PrimitiveMissingRole role)
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
              (filter PrimitiveRoleBinding (fun (binding : PrimitiveRoleBinding) => match binding with
                | PrimitiveRoleOf current _ => notb (primitive_role_equal current role) end) pr_roles)
              id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " preserves normalization failure") PrimitiveResourceExhausted
            (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " bounds signature work") PrimitiveResourceExhausted
            (primitive_expected_signature 0 pr_nf pr_bindings pr_roles id (Nothing CoreTerm)),
          assert_true (str_concat key " is a deferred action")
            (match primitive_execution id with | PrimitiveRuntimeAction => True | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
          assert_true (str_concat key " accounts for GC construction")
            (match primitive_gc id with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test))
        ([PrimitiveArgv, PrimitiveEnvGet] : List PrimitiveId));

def pr_time_tests : List Test :=
    [pr_signature "time returns a deferred managed String" PrimitiveTimeNow (pr_runtime (CConst 18)),
     pr_error CoreTerm "time requires registered String" (PrimitiveMissingType PrimitiveStringType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveStringType) end) pr_bindings)
         pr_roles PrimitiveTimeNow (Nothing CoreTerm)),
     pr_error CoreTerm "time requires registered Runtime" (PrimitiveMissingType PrimitiveRuntimeType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveRuntimeType) end) pr_bindings)
         pr_roles PrimitiveTimeNow (Nothing CoreTerm)),
     pr_error CoreTerm "time rejects specialization" PrimitiveUnexpectedSpecialization
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles PrimitiveTimeNow
         (Just CoreTerm (CConst 18))),
     pr_error CoreTerm "time propagates normalization failure" PrimitiveResourceExhausted
       (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles PrimitiveTimeNow (Nothing CoreTerm)),
     pr_error CoreTerm "time has bounded signature work" PrimitiveResourceExhausted
       (primitive_expected_signature 0 pr_nf pr_bindings pr_roles PrimitiveTimeNow (Nothing CoreTerm)),
     pr_ok CoreTerm "time needs no unrelated data representation"
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
         PrimitiveTimeNow (Nothing CoreTerm)),
     assert_true "time keeps execution deferred"
       (match primitive_execution PrimitiveTimeNow with | PrimitiveRuntimeAction => True
         | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
     assert_true "time accounts for managed action construction"
       (match primitive_gc PrimitiveTimeNow with | PrimitiveMayGc => True | PrimitiveNoGc => False end)];

def pr_stdin_tests : List Test :=
    append Test
      (concat_map Bool Test (fun (bytes : Bool) =>
        let id : PrimitiveId := match bytes with | False => PrimitiveStdinReadLine | True => PrimitiveStdinReadBytes end in
        let key : String := prim_string_of_char_codes (primitive_key id) in
        ([pr_signature (str_concat key " preserves argument, effect and result") id
            (match bytes with | False => pr_runtime (CConst 18) | True => CPi (CInd 40) (pr_runtime (CConst 18)) end),
          pr_error CoreTerm (str_concat key " requires registered String") (PrimitiveMissingType PrimitiveStringType)
            (primitive_expected_signature primitive_default_fuel pr_nf
              (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
                | PrimitiveResolvedAs _ current _ => notb (primitive_id_equal current PrimitiveStringType) end) pr_bindings)
              pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " requires registered Runtime") (PrimitiveMissingType PrimitiveRuntimeType)
            (primitive_expected_signature primitive_default_fuel pr_nf
              (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
                | PrimitiveResolvedAs _ current _ => notb (primitive_id_equal current PrimitiveRuntimeType) end) pr_bindings)
              pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles id (Just CoreTerm (CConst 18))),
          pr_error CoreTerm (str_concat key " preserves normalization failure") PrimitiveResourceExhausted
            (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " bounds signature work") PrimitiveResourceExhausted
            (primitive_expected_signature 0 pr_nf pr_bindings pr_roles id (Nothing CoreTerm)),
          assert_true (str_concat key " is a deferred action")
            (match primitive_execution id with | PrimitiveRuntimeAction => True | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
          assert_true (str_concat key " accounts for managed construction")
            (match primitive_gc id with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test))
        ([False, True] : List Bool))
      ([pr_error CoreTerm "byte input requires the canonical Nat role" (PrimitiveMissingRole PrimitiveNatRole)
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
            ([] : List PrimitiveRoleBinding) PrimitiveStdinReadBytes (Nothing CoreTerm)),
        pr_ok CoreTerm "line input needs no unrelated representation"
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
            ([] : List PrimitiveRoleBinding) PrimitiveStdinReadLine (Nothing CoreTerm)),
        pr_ok CoreTerm "byte input needs only the Nat representation"
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
            (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) => match role with
              | PrimitiveRoleOf current _ => primitive_role_equal current PrimitiveNatRole end) pr_roles)
            PrimitiveStdinReadBytes (Nothing CoreTerm))] : List Test);
def pr_file_tests : List Test :=
    append Test
      ([pr_signature "file read keeps path and result String identity" PrimitiveFileRead
          (CPi (CConst 18) (pr_runtime (CConst 18))),
        pr_signature "file write keeps both String arguments and Unit result" PrimitiveFileWrite
          (CPi (CConst 18) (CPi (CConst 18) (pr_runtime (CInd 42)))),
        pr_ok CoreTerm "file read needs no unrelated data representation"
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
            PrimitiveFileRead (Nothing CoreTerm)),
        pr_error CoreTerm "file write requires the registered Unit representation" (PrimitiveMissingRole PrimitiveUnitRole)
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
            PrimitiveFileWrite (Nothing CoreTerm))] : List Test)
      (concat_map PrimitiveId Test (fun (id : PrimitiveId) =>
        let key : String := prim_string_of_char_codes (primitive_key id) in
        ([pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles id (Just CoreTerm (CConst 18))),
          pr_error CoreTerm (str_concat key " propagates normalization failure") PrimitiveResourceExhausted
            (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " bounds signature work") PrimitiveResourceExhausted
            (primitive_expected_signature 0 pr_nf pr_bindings pr_roles id (Nothing CoreTerm)),
          assert_true (str_concat key " is deferred")
            (match primitive_execution id with | PrimitiveRuntimeAction => True | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
          assert_true (str_concat key " retains GC metadata")
            (match primitive_gc id with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test))
        ([PrimitiveFileRead, PrimitiveFileWrite] : List PrimitiveId));

