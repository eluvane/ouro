def pr_fs_predicate_tests : List Test :=
    concat_map PrimitiveId Test (fun (predicate : PrimitiveId) =>
      let key : String := prim_string_of_char_codes (primitive_key predicate) in
      ([pr_signature (str_concat key " accepts a String and returns deferred Bool") predicate (CPi (CConst 18) (pr_runtime (CInd 41))),
     pr_error CoreTerm (str_concat key " requires registered String") (PrimitiveMissingType PrimitiveStringType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveStringType) end) pr_bindings)
         pr_roles predicate (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " requires registered Runtime") (PrimitiveMissingType PrimitiveRuntimeType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveRuntimeType) end) pr_bindings)
         pr_roles predicate (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles predicate
         (Just CoreTerm (CConst 18))),
     pr_error CoreTerm (str_concat key " propagates normalization failure") PrimitiveResourceExhausted
       (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles predicate (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " has bounded signature work") PrimitiveResourceExhausted
       (primitive_expected_signature 0 pr_nf pr_bindings pr_roles predicate (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " requires the canonical Bool role") (PrimitiveMissingRole PrimitiveBoolRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
         predicate (Nothing CoreTerm)),
     pr_ok CoreTerm (str_concat key " needs only the Bool representation")
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
         (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) => match role with
           | PrimitiveRoleOf current _ => primitive_role_equal current PrimitiveBoolRole end) pr_roles)
         predicate (Nothing CoreTerm)),
     assert_true (str_concat key " keeps execution deferred")
       (match primitive_execution predicate with | PrimitiveRuntimeAction => True
         | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
     assert_true (str_concat key " accounts for managed action construction")
       (match primitive_gc predicate with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test))
      ([PrimitiveFileExists, PrimitiveFileIsDirectory] : List PrimitiveId);

def pr_directory_tests : List Test :=
    append Test
      ([pr_signature "directory listing keeps String input and List String output" PrimitiveDirectoryList
          (CPi (CConst 18) (pr_runtime (CApp (CInd 43) (CConst 18)))),
        pr_signature "directory access probe keeps String input and Bool output" PrimitiveDirectoryListable
          (CPi (CConst 18) (pr_runtime (CInd 41))),
        pr_error CoreTerm "directory listing requires the registered List role" (PrimitiveMissingRole PrimitiveListRole)
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
            PrimitiveDirectoryList (Nothing CoreTerm)),
        pr_error CoreTerm "directory access requires the registered Bool role" (PrimitiveMissingRole PrimitiveBoolRole)
          (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
            PrimitiveDirectoryListable (Nothing CoreTerm))] : List Test)
      (concat_map PrimitiveId Test (fun (id : PrimitiveId) =>
        let key : String := prim_string_of_char_codes (primitive_key id) in
        ([pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
            (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles id (Just CoreTerm (CConst 18))),
          pr_error CoreTerm (str_concat key " propagates normalization failure") PrimitiveResourceExhausted
            (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles id (Nothing CoreTerm)),
          pr_error CoreTerm (str_concat key " bounds signature work") PrimitiveResourceExhausted
            (primitive_expected_signature 0 pr_nf pr_bindings pr_roles id (Nothing CoreTerm)),
          assert_true (str_concat key " is deferred")
            (match primitive_execution id with | PrimitiveRuntimeAction => True | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
          assert_true (str_concat key " retains GC metadata")
            (match primitive_gc id with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test))
        ([PrimitiveDirectoryList, PrimitiveDirectoryListable] : List PrimitiveId));

def pr_fs_mutation_tests : List Test :=
    concat_map PrimitiveId Test (fun (mutation : PrimitiveId) =>
      let key : String := prim_string_of_char_codes (primitive_key mutation) in
      ([pr_signature (str_concat key " accepts a String and returns deferred Unit") mutation (CPi (CConst 18) (pr_runtime (CInd 42))),
     pr_error CoreTerm (str_concat key " requires registered String") (PrimitiveMissingType PrimitiveStringType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveStringType) end) pr_bindings)
         pr_roles mutation (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " requires registered Runtime") (PrimitiveMissingType PrimitiveRuntimeType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveRuntimeType) end) pr_bindings)
         pr_roles mutation (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles mutation
         (Just CoreTerm (CConst 18))),
     pr_error CoreTerm (str_concat key " propagates normalization failure") PrimitiveResourceExhausted
       (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles mutation (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " has bounded signature work") PrimitiveResourceExhausted
       (primitive_expected_signature 0 pr_nf pr_bindings pr_roles mutation (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " requires the canonical Unit role") (PrimitiveMissingRole PrimitiveUnitRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
         mutation (Nothing CoreTerm)),
     pr_ok CoreTerm (str_concat key " needs only the Unit representation")
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
         (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) => match role with
           | PrimitiveRoleOf current _ => primitive_role_equal current PrimitiveUnitRole end) pr_roles)
         mutation (Nothing CoreTerm)),
     assert_true (str_concat key " keeps execution deferred")
       (match primitive_execution mutation with | PrimitiveRuntimeAction => True
         | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
     assert_true (str_concat key " accounts for managed action construction")
       (match primitive_gc mutation with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test))
      ([PrimitiveDirectoryCreate, PrimitivePathRemove] : List PrimitiveId);

def pr_file_copy_tests : List Test :=
    concat_map PrimitiveId Test (fun (copy : PrimitiveId) =>
      let key : String := prim_string_of_char_codes (primitive_key copy) in
      ([pr_signature (str_concat key " accepts two Strings and returns deferred Unit") copy (CPi (CConst 18) (CPi (CConst 18) (pr_runtime (CInd 42)))),
     pr_error CoreTerm (str_concat key " requires registered String") (PrimitiveMissingType PrimitiveStringType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveStringType) end) pr_bindings)
         pr_roles copy (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " requires registered Runtime") (PrimitiveMissingType PrimitiveRuntimeType)
       (primitive_expected_signature primitive_default_fuel pr_nf
         (filter PrimitiveResolved (fun (resolved : PrimitiveResolved) => match resolved with
           | PrimitiveResolvedAs _ id _ => notb (primitive_id_equal id PrimitiveRuntimeType) end) pr_bindings)
         pr_roles copy (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " rejects specialization") PrimitiveUnexpectedSpecialization
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings pr_roles copy
         (Just CoreTerm (CConst 18))),
     pr_error CoreTerm (str_concat key " propagates normalization failure") PrimitiveResourceExhausted
       (primitive_expected_signature primitive_default_fuel pr_nf_error pr_bindings pr_roles copy (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " has bounded signature work") PrimitiveResourceExhausted
       (primitive_expected_signature 0 pr_nf pr_bindings pr_roles copy (Nothing CoreTerm)),
     pr_error CoreTerm (str_concat key " requires the canonical Unit role") (PrimitiveMissingRole PrimitiveUnitRole)
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings ([] : List PrimitiveRoleBinding)
         copy (Nothing CoreTerm)),
     pr_ok CoreTerm (str_concat key " needs only the Unit representation")
       (primitive_expected_signature primitive_default_fuel pr_nf pr_bindings
         (filter PrimitiveRoleBinding (fun (role : PrimitiveRoleBinding) => match role with
           | PrimitiveRoleOf current _ => primitive_role_equal current PrimitiveUnitRole end) pr_roles)
         copy (Nothing CoreTerm)),
     assert_true (str_concat key " keeps execution deferred")
       (match primitive_execution copy with | PrimitiveRuntimeAction => True
         | PrimitivePureValue => False | PrimitiveTypeOnly => False end),
     assert_true (str_concat key " accounts for managed action construction")
       (match primitive_gc copy with | PrimitiveMayGc => True | PrimitiveNoGc => False end)] : List Test))
      ([PrimitiveFileCopy] : List PrimitiveId);

def main : IO Unit :=
    test_run (foldr (List Test) (List Test) (fun (tests : List Test) (tail : List Test) => append Test tests tail) (Nil Test)
      ([map (Pair PrimitiveId String) Test pr_key_test pr_all_specs, pr_operation_tests, pr_conversion_tests,
        pr_context_tests, pr_template_tests, pr_abi_tests, pr_extern_tests, pr_layout_tests, pr_misc_tests, pr_additional_tests, pr_storage_tests, pr_stdio_tests, pr_startup_tests, pr_time_tests, pr_stdin_tests, pr_file_tests, pr_fs_kind_tests, pr_fs_predicate_tests, pr_directory_tests, pr_fs_mutation_tests, pr_file_copy_tests,
        map PrimitiveStringOp Test (fun (op : PrimitiveStringOp) => pr_signature "String predicate signature"
          (PrimitiveStringOperation op) (CPi (CConst 18) (CPi (CConst 18) (CInd 41))))
          ([PrimitiveStringEqual, PrimitiveStringStarts, PrimitiveStringEnds, PrimitiveStringContains, PrimitiveStringLessEqual] : List PrimitiveStringOp),
        map Nat Test (fun (alignment : Nat) => pr_ok PrimitiveCheckedLayout (str_concat "layout alignment " (str_of_nat alignment))
          (pr_layout alignment alignment False (Nil PrimitiveRawField)))
          ([1, 2, 4, 8, 16, 32, 64, 128, 256, mul 2 256, mul 4 256, mul 8 256, mul 16 256] : List Nat),
        map String Test (fun (key : String) => pr_error PrimitiveId (str_concat "unknown key " key) PrimitiveUnknownKey
          (primitive_decode primitive_default_fuel (str_codes key)))
          (["", "add", "ouro.u32.add", "ouro.u32.div.wrap", "Ouro.u32", "ouro.u32.", "ouro.runtime.run"] : List String)] : List (List Test)));
