-- @entry main

import "../std/jsonrpc.ouro",
  "../std/test.ouro";

def quality_jsonrpc_length (header : String) (expected : Nat) : Bool :=
    match rpc_content_len header with
    | Nothing => False
    | Just actual => eq_nat actual expected
    end;

def quality_jsonrpc_no_length (header : String) : Bool :=
    match rpc_content_len header with
    | Nothing => True
    | Just _ => False
    end;

def quality_jsonrpc_take (buffer : String) (body : String) (remainder : String) : Bool :=
    match rpc_take buffer with
    | Nothing => False
    | Just frame =>
      match frame with
      | MkPair actual_body actual_remainder =>
        andb (str_eq actual_body body) (str_eq actual_remainder remainder)
      end
    end;

def quality_jsonrpc_rejected (buffer : String) : Bool :=
    match rpc_take buffer with
    | Nothing => True
    | Just _ => False
    end;

def main : IO Unit :=
    test_run
      ([ assert_true("single length", quality_jsonrpc_length "Content-Length: 3" 3)
       , assert_true("length after other header", quality_jsonrpc_length
           "Content-Type: application/vscode-jsonrpc; charset=utf-8\r\nContent-Length: 3" 3)
       , assert_true("length before other header", quality_jsonrpc_length
           "Content-Length: 3\r\nContent-Type: application/vscode-jsonrpc; charset=utf-8" 3)
       , assert_true("retained header whitespace", quality_jsonrpc_length
           " Content-Length:3 \r\n\r\n" 3)
       , assert_true("zero length", quality_jsonrpc_length "Content-Length: 0" 0)
       , assert_true("missing length", quality_jsonrpc_no_length "Content-Type: application/json")
       , assert_true("empty length", quality_jsonrpc_no_length "Content-Length:")
       , assert_true("nonnumeric length", quality_jsonrpc_no_length "Content-Length: bad")
       , assert_true("negative length", quality_jsonrpc_no_length "Content-Length: -3")
       , assert_true("trailing length bytes", quality_jsonrpc_no_length "Content-Length: 3x")
       , assert_true("conflicting lengths", quality_jsonrpc_no_length
           "Content-Length: 3\r\nContent-Length: 5")
       , assert_true("reversed conflicting lengths", quality_jsonrpc_no_length
           "Content-Length: 5\r\nContent-Length: 3")
       , assert_true("equal duplicate lengths", quality_jsonrpc_no_length
           "Content-Length: 3\r\nContent-Length: 3")
       , assert_true("zero duplicate lengths", quality_jsonrpc_no_length
           "Content-Length: 0\r\nContent-Length: 0")
       , assert_true("invalid length before valid length", quality_jsonrpc_no_length
           "Content-Length: bad\r\nContent-Length: 3")
       , assert_true("invalid length after valid length", quality_jsonrpc_no_length
           "Content-Length: 3\r\nContent-Length: bad")
       , assert_true("duplicate separated by other header", quality_jsonrpc_no_length
           "Content-Length: 3\r\nContent-Type: application/json\r\nContent-Length: 3")
       , assert_true("complete frame and remainder", quality_jsonrpc_take
           (str_concat (rpc_frame "abc") (rpc_frame "{}")) "abc" (rpc_frame "{}"))
       , assert_true("empty frame and remainder", quality_jsonrpc_take
           (str_concat (rpc_frame "") "next") "" "next")
       , assert_true("UTF8 body length is bytes", quality_jsonrpc_take
           "Content-Length: 3\r\n\r\n雪next" "雪" "next")
       , assert_true("truncated header", quality_jsonrpc_rejected "Content-Length: 3\r\n")
       , assert_true("truncated body", quality_jsonrpc_rejected "Content-Length: 4\r\n\r\nabc")
       , assert_true("missing length frame", quality_jsonrpc_rejected
           "Content-Type: application/json\r\n\r\nabc")
       , assert_true("malformed length frame", quality_jsonrpc_rejected "Content-Length: bad\r\n\r\nabc")
       , assert_true("duplicate length frame", quality_jsonrpc_rejected
           "Content-Length: 3\r\nContent-Length: 5\r\n\r\nabcde")
       , assert_eq("outbound frame bytes", rpc_frame "{}", "Content-Length: 2\r\n\r\n{}")
       , assert_eq("outbound UTF8 frame bytes", rpc_frame "雪", "Content-Length: 3\r\n\r\n雪")
       ] : List Test);
