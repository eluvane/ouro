-- Pure input fixtures exercise the same checker function called by coil check.
-- No main lookup, filesystem reads or PE lowering belongs in these assertions.
import "analyze/precision/assertions.ouro";
import "../tools/native_build_core.ouro";

def native_cli_check_unit (path : String) (source : String) : Pair (List Nat) (List Nat) :=
    MkPair (List Nat) (List Nat) (str_codes path) (str_codes source);

def native_cli_check_ok (result : CompResult CheckedProgram) : Bool :=
    match result with | COk _ => True | CErr _ => False end;

def native_cli_check_error (expected : Nat) (result : CompResult CheckedProgram) : Bool :=
    match result with
    | COk _ => False
    | CErr error => match error with | ErrCode code _ => eq_nat code expected end
    end;

def native_cli_check_single (source : String) : CompResult CheckedProgram :=
    native_build_check_files 5000 "main.ouro"
      ([native_cli_check_unit "main.ouro" source] : NativeBuildFiles);

def native_cli_check_dependency (dependency : String) : CompResult CheckedProgram :=
    native_build_check_files 5000 "main.ouro"
      ([native_cli_check_unit "dep.ouro" dependency,
        native_cli_check_unit "main.ouro" "import \"dep.ouro\"; def value : Nat := Z;"] : NativeBuildFiles);

def native_cli_check_nat : String :=
    "inductive Nat : Type := | Z : Nat | S : Nat -> Nat; ";

def native_cli_check_dump_header (result : CompResult CheckedProgram) : Bool :=
    match result with
    | CErr _ => False
    | COk checked => match checked_program_dump 5000 checked with
      | CErr _ => False
      | COk bytes => str_starts (str_of_codes bytes) "ouro.checked-program.v1\n"
      end
    end;

def native_cli_check_config_error (backend : String) (target : String) (expected : String) : Bool :=
    match native_build_validate_request
        (MkNativeBuildRequest backend target "main.ouro" "app.exe" "main" native_build_fuel) with
    | Right _ => False
    | Left error => match error with
      | NativeBuildConfiguration message => str_eq message expected
      | NativeBuildFilesystem _ => False
      | NativeBuildCollection _ => False
      | NativeBuildSource _ => False
      end
    end;

def native_cli_check_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-cli-check/module-without-main"
        (native_cli_check_ok (native_cli_check_single "axiom Library : Type;"))
    , MkPair String Bool "native-cli-check/higher-order-main"
        (native_cli_check_ok (native_cli_check_single
          "def identity (A : Type) (value : A) : A := value; def main (A : Type) (value : A) : A := identity A value;"))
    , MkPair String Bool "native-cli-check/imported-good-body"
        (native_cli_check_ok (native_cli_check_dependency (str_concat native_cli_check_nat "def hidden : Nat := Z;")))
    , MkPair String Bool "native-cli-check/imported-unused-bad-body"
        (native_cli_check_error 41 (native_cli_check_dependency (str_concat native_cli_check_nat "def hidden : Nat := Type;")))
    , MkPair String Bool "native-cli-check/root-bad-body"
        (native_cli_check_error 41 (native_cli_check_single (str_concat native_cli_check_nat "def value : Nat := Type;")))
    , MkPair String Bool "native-cli-check/missing-unit"
        (native_cli_check_error 92 (native_cli_check_single "import \"absent.ouro\"; axiom Library : Type;"))
    , MkPair String Bool "native-cli-check/duplicate-declaration"
        (native_cli_check_error 45 (native_cli_check_single "axiom Library : Type; axiom Library : Type;"))
    , MkPair String Bool "native-cli-check/normalizes-host-separators"
        (native_cli_check_ok (native_build_check_files 5000 "folder\\main.ouro"
          ([native_cli_check_unit "folder/main.ouro" "axiom Library : Type;"] : NativeBuildFiles)))
    , MkPair String Bool "native-cli-check/zero-fuel-fails"
        (match native_build_check_files 0 "main.ouro"
           ([native_cli_check_unit "main.ouro" "axiom Library : Type;"] : NativeBuildFiles) with
         | CErr _ => True | COk _ => False end)
    , MkPair String Bool "native-cli-check/canonical-dump"
        (native_cli_check_dump_header (native_cli_check_single "axiom Library : Type;"))
    , MkPair String Bool "native-cli-check/constructed-legacy-request"
        (native_cli_check_config_error "legacy-c" "x86_64-windows"
          (native_build_err_backend "legacy-c"))
    , MkPair String Bool "native-cli-check/constructed-other-target"
        (native_cli_check_config_error "native" "x86_64-linux"
          (native_build_err_target "x86_64-linux"))
    ];

-- @entry main
def main : IO Unit := precision_run "native-cli-check" native_cli_check_laws;
