-- Inspect actual PE writer output without importing the source compiler/lowerer.
import "native_pe_inspect_fixtures.ouro",
  "native_pe_fixtures.ouro",
  "../std/test.ouro";

def native_pe_writer_probe (name : String) (program : Either PeError PeProgram)
    (expected : List NativePeImportLibrary) : Test :=
    match pe_test_image program with
    | Left _ => test_fail name "writer fixture rejected"
    | Right image => match image with
      | PeImageFile bytes _ =>
          match native_pe_inspect_imports (str_of_codes bytes) with
          | Left error => test_fail(name, native_pe_inspect_error_code error)
          | Right imports => assert_true(name, native_pe_probe_imports_equal imports expected)
          end
      end
    end;

-- @entry main
def main : IO Unit :=
    test_run
      [ native_pe_writer_probe "inspect writer ExitProcess image"
          (pe_test_exit_program [] 40 42)
          [NativePeImportLibraryOf "kernel32.dll" ["ExitProcess"]]
      , native_pe_writer_probe "inspect writer two-DLL image"
          pe_test_unwind_program
          [NativePeImportLibraryOf "ntdll.dll" ["RtlLookupFunctionEntry"],
           NativePeImportLibraryOf "kernel32.dll" ["ExitProcess"]]
      ];
