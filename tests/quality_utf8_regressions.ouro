import "../std/utf8_scalar.ouro",
  "../std/collections.ouro",
  "../std/test.ouro";

def quality_utf8_accepts (value : Nat) (expected : List Nat) : Bool :=
    match utf8_scalar_checked value with
    | Nothing => False
    | Just bytes =>
        andb (utf8_scalar_valid value)
          (andb (list_eq Nat eq_nat bytes expected)
            (list_eq Nat eq_nat (utf8_scalar_bytes value) expected))
    end;

def quality_utf8_rejects (value : Nat) : Bool :=
    match utf8_scalar_checked value with
    | Nothing => notb (utf8_scalar_valid value)
    | Just _ => False
    end;

def quality_utf8_laws : List Test :=
    let byte_group : Nat := mul 16 16 in
    let plane : Nat := mul byte_group byte_group in
    let surrogate_start : Nat := mul 216 byte_group in
    let surrogate_end : Nat := mul 224 byte_group in
    let wide_group : Nat := mul 4 plane in
    let scalar_limit : Nat := mul 17 plane in
    [ assert_true("NUL is one zero byte", quality_utf8_accepts 0 [0])
    , assert_true("last ASCII scalar", quality_utf8_accepts 127 [127])
    , assert_true("first two-byte scalar", quality_utf8_accepts 128 [194, 128])
    , assert_true("two-byte remainder", quality_utf8_accepts 233 [195, 169])
    , assert_true("last two-byte scalar",
        quality_utf8_accepts (sub(mul 8 byte_group, 1)) [223, 191])
    , assert_true("first three-byte scalar",
        quality_utf8_accepts (mul 8 byte_group) [224, 160, 128])
    , assert_true("three-byte remainders",
        quality_utf8_accepts (add(mul 32 byte_group, 172)) [226, 130, 172])
    , assert_true("last scalar before surrogates",
        quality_utf8_accepts (sub surrogate_start 1) [237, 159, 191])
    , assert_true("first scalar after surrogates",
        quality_utf8_accepts surrogate_end [238, 128, 128])
    , assert_true("last three-byte scalar",
        quality_utf8_accepts (sub plane 1) [239, 191, 191])
    , assert_true("first four-byte scalar",
        quality_utf8_accepts plane [240, 144, 128, 128])
    , assert_true("four-byte remainders",
        quality_utf8_accepts (mul 251 (mul 2 byte_group)) [240, 159, 152, 128])
    , assert_true("last scalar before leading-byte carry",
        quality_utf8_accepts (sub wide_group 1) [240, 191, 191, 191])
    , assert_true("first scalar after leading-byte carry",
        quality_utf8_accepts wide_group [241, 128, 128, 128])
    , assert_true("last scalar before final plane",
        quality_utf8_accepts (sub(mul 16 plane, 1)) [243, 191, 191, 191])
    , assert_true("first scalar in final plane",
        quality_utf8_accepts (mul 16 plane) [244, 128, 128, 128])
    , assert_true("maximum Unicode scalar",
        quality_utf8_accepts (sub scalar_limit 1) [244, 143, 191, 191])
    , assert_true("first high surrogate rejected",
        quality_utf8_rejects surrogate_start)
    , assert_true("last high surrogate rejected",
        quality_utf8_rejects (sub(mul 220 byte_group, 1)))
    , assert_true("first low surrogate rejected",
        quality_utf8_rejects (mul 220 byte_group))
    , assert_true("last low surrogate rejected",
        quality_utf8_rejects (sub surrogate_end 1))
    , assert_true("first value above Unicode maximum rejected",
        quality_utf8_rejects scalar_limit)
    , assert_true("larger values rejected",
        quality_utf8_rejects (mul 2 scalar_limit))
    ];

-- @entry main
def main : IO Unit := test_run quality_utf8_laws;
