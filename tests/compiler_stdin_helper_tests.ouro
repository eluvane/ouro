-- The helper candidate is checked source. Mutated raw-contract tables below
-- test the internal linker boundary independently of helper name lookup.
import "../compiler/native/managed_stdin_model.ouro",
  "../compiler/driver.ouro",
  "compiler_startup_test_support.ouro",
  "compiler_managed_helper_test_support.ouro";

def stdin_helper_prefix : String :=
    prim_string_concat
      "intrinsic Effect : Type -> Type := \"ouro.runtime\"; intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic Byte : Type := \"ouro.u8\"; intrinsic Word : Type := \"ouro.u32\"; intrinsic Size : Type := \"ouro.usize\"; "
      "intrinsic pure : (A : Type) -> A -> Effect A := \"ouro.runtime.pure\"; axiom zero : Word; axiom size_zero : Size; def AliasWord : Type := Word; def AliasPointer (A : Type) : Type := Pointer A; def Deferred (A : Type) : Type := Effect A; ";

def stdin_helper_source (mode : Nat) : String :=
    prim_string_concat stdin_helper_prefix (match eqNat mode 7 with
      | True => "axiom raw_windows_stdin : Pointer Byte -> Size -> Pointer Word -> Effect Word;"
      | False => match eqNat mode 9 with
        | True => "extern raw_windows_stdin : Pointer Byte -> Size -> Pointer Word -> Effect Word := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetLastError\" \"nogc\";"
        | False => match eqNat mode 1 with
          | True => "def raw_windows_stdin (buffer : AliasPointer Byte) (capacity : Size) (count : AliasPointer AliasWord) : Deferred AliasWord := pure Word zero;"
          | False => match eqNat mode 6 with
            | True => "def raw_windows_stdin (buffer : Pointer Byte) (capacity : Size) (count : Pointer Size) : Effect Word := pure Word zero;"
            | False => match eqNat mode 10 with
              | True => "def raw_windows_stdin (buffer : Pointer Word) (capacity : Size) (count : Pointer Word) : Effect Word := pure Word zero;"
              | False => match eqNat mode 11 with
                | True => "def raw_windows_stdin (buffer : Pointer Byte) (capacity : Word) (count : Pointer Word) : Effect Word := pure Word zero;"
                | False => match eqNat mode 12 with
                  | True => "def raw_windows_stdin (buffer : Pointer Byte) (capacity : Size) (count : Pointer Word) : Effect Size := pure Size size_zero;"
                  | False => "def raw_windows_stdin (buffer : Pointer Byte) (capacity : Size) (count : Pointer Word) : Effect Word := pure Word zero;"
                  end end end end end end end);

def stdin_helper_compiler (program : CheckedProgram) (contracts : List LowerContract) : ManagedCompiler :=
    managed_helper_test_compiler program contracts;

def stdin_helper_contracts (mode : Nat) (contract : LowerContract) : List LowerContract :=
    managed_helper_test_contracts PrimitiveStdinReadBytes mode contract;

def stdin_helper_resolve (mode : Nat) (program : CheckedProgram) : Either NativeLowerError Nat :=
    managed_helper_test_resolve mode (managed_stdin_reader_name)
      (fun (compiler : ManagedCompiler) => managed_stdin_reader_expected compiler)
      (stdin_helper_contracts mode) program;

def stdin_helper_probe (mode : Nat) : String :=
    managed_helper_test_probe (stdin_helper_source mode) (stdin_helper_resolve mode);

def main : IO Unit :=
    startup_test_run
      [startup_test_eq "checked stdin body links the same raw definition" (stdin_helper_probe 0) "linked",
       startup_test_eq "stdin helper accepts normalized pointer, word and Runtime aliases" (stdin_helper_probe 1) "linked",
       startup_test_eq "checked body without compiled raw contract is rejected" (stdin_helper_probe 2) "call",
       startup_test_eq "another raw contract ID cannot authorize the helper" (stdin_helper_probe 3) "call",
       startup_test_eq "same raw ID with different Core contract is rejected" (stdin_helper_probe 4) "metadata",
       startup_test_eq "primitive binding cannot replace a compiled helper body" (stdin_helper_probe 5) "body",
       startup_test_eq "stdin count storage must point to U32" (stdin_helper_probe 6) "metadata",
       startup_test_eq "stdin buffer must point to bytes" (stdin_helper_probe 10) "metadata",
       startup_test_eq "stdin capacity must preserve USize" (stdin_helper_probe 11) "metadata",
       startup_test_eq "stdin raw result must preserve Runtime U32" (stdin_helper_probe 12) "metadata",
       startup_test_eq "a helper axiom cannot supply an implementation" (stdin_helper_probe 7) "body",
       startup_test_eq "helper normalization preserves fuel failure" (stdin_helper_probe 8) "resource",
       startup_test_eq "a foreign declaration cannot masquerade as a checked helper body" (stdin_helper_probe 9) "body"];
