-- Shared development-driver formatting and checked file input.
import "../compiler/native/lower_source.ouro",
  "../std/io.ouro",
  "../compiler/native/diagnostics.ouro";


def managed_driver_frame (frame : NativeFrameInfo) : String :=
    match frame with | NativeFrameAt id allocation roots calls =>
      managed_driver_join "|" ([prim_string_of_nat id, prim_string_of_nat allocation,
        managed_driver_join "," (map NativeRootSlot String (fun (root : NativeRootSlot) => match root with
          | NativeRootAt local offset => managed_driver_join ":" [prim_string_of_nat local, prim_string_of_nat offset] end) roots),
        managed_driver_join "," (map NativeCallSite String (fun (site : NativeCallSite) => match site with
          | NativeCallAt block instruction pc => managed_driver_join ":"
              [prim_string_of_nat block, prim_string_of_nat instruction, prim_string_of_nat pc] end) calls)] : List String) end;

def managed_driver_image (metadata : Bool) (image : NativeImage) : String :=
    match image with | NativeImageOf pe frames => match metadata with
      | True => managed_driver_join("\n", map NativeFrameInfo String managed_driver_frame frames)
      | False => match pe with | PeImageFile bytes _ =>
          managed_driver_join(",", map Nat String prim_string_of_nat bytes) end end end;

-- Write each byte once: joining a complete PE with String concatenation keeps
-- every growing suffix in the development runtime's process-lifetime arena.
def managed_driver_write_bytes : List Nat -> IO Unit :=
  fix write_bytes (bytes : List Nat) : IO Unit :=
    match bytes with
    | Nil => println ""
    | Cons byte rest => match rest with
      | Nil => println (prim_string_of_nat byte)
      | Cons _ _ => do print (prim_string_concat(prim_string_of_nat byte, ",")); write_bytes rest
      end
    end;

def managed_driver_write_image (metadata : Bool) (image : NativeImage) : IO Unit :=
    match metadata with
    | True => println (managed_driver_image True image)
    | False => match image with | NativeImageOf pe _ => match pe with
      | PeImageFile bytes _ => managed_driver_write_bytes bytes end end
    end;


def managed_driver_files : List String -> IO (List (Pair (List Nat) (List Nat))) :=
  fix read_files (paths : List String) : IO (List (Pair (List Nat) (List Nat))) :=
    match paths with | Nil => io_pure(List (Pair(List Nat, List Nat)), [])
    | Cons path rest => do let! exists := prim_fs_exists path;
      match exists with
      | False => do eprintln (prim_string_concat "missing managed source: " path); exit 2;
                    io_pure(List (Pair(List Nat, List Nat)), [])
      | True => do let! source := prim_fs_read_file path; let! tail := read_files rest;
                   io_pure (List (Pair(List Nat, List Nat)))
                     (Cons (Pair(List Nat, List Nat))
                       (MkPair(List Nat, List Nat, prim_string_to_char_codes path, prim_string_to_char_codes source)) tail)
      end end;
