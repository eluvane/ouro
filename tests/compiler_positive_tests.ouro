-- Direct core regressions for the compiler's environment-aware positivity proof.
-- These test its judgment; declaration typing is covered by compiler_check_tests.

import "../compiler/file_elab_positive.ouro";
import "../std/io.ouro";

inductive PositiveLaw : Type :=
  | MkPositiveLaw : String -> Bool -> PositiveLaw;

def positive_test_fuel : Nat := mul 20 20;
def positive_test_nat : CoreTerm := CInd 10;
def positive_test_tree : CoreTerm := CInd 80;

def positive_test_list : IndDecl :=
    MkIndDecl 30 ([MkParam 31 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([ MkCtor 32 (CPi (CSort 0) (CApp (CInd 30) (CRel 0)))
       , MkCtor 33
          (CPi (CSort 0)
            (CPi (CRel 0)
              (CPi (CApp (CInd 30) (CRel 1)) (CApp (CInd 30) (CRel 2)))))
       ] : List Ctor);

def positive_test_wrapper (name : Nat) (field : CoreTerm) : IndDecl :=
    MkIndDecl name ([MkParam (S name) (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([MkCtor (add name 2)
        (CPi (CSort 0) (CPi field (CApp (CInd name) (CRel 1))))] : List Ctor);

def positive_test_contra : IndDecl :=
    positive_test_wrapper 40 (CPi (CRel 0) positive_test_nat);

def positive_test_reader : IndDecl :=
    positive_test_wrapper 45 (CPi positive_test_nat (CRel 1));

def positive_test_pair : IndDecl :=
    MkIndDecl 50 ([MkParam 51 (CSort 0), MkParam 52 (CSort 0)] : List Param)
      (Nil CoreTerm) 0
      ([MkCtor 53
        (CPi (CSort 0) (CPi (CSort 0)
          (CPi (CRel 1) (CPi (CRel 1)
            (CApp (CApp (CInd 50) (CRel 3)) (CRel 2))))))] : List Ctor);

def positive_test_pair_contra (negative_index : Nat) : IndDecl :=
    MkIndDecl 55 ([MkParam 56 (CSort 0), MkParam 57 (CSort 0)] : List Param)
      (Nil CoreTerm) 0
      ([MkCtor 58
        (CPi (CSort 0) (CPi (CSort 0)
          (CPi (CPi (CRel negative_index) positive_test_nat)
            (CApp (CApp (CInd 55) (CRel 2)) (CRel 1)))))] : List Ctor);

def positive_test_nested : IndDecl :=
    positive_test_wrapper 60 (CApp (CInd 30) (CRel 0));

def positive_test_hidden_contra : IndDecl :=
    positive_test_wrapper 70 (CApp (CInd 40) (CRel 0));

def positive_test_provisional_trap : IndDecl :=
    MkIndDecl 75 ([MkParam 76 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([ MkCtor 77 (CPi (CSort 0) (CApp (CInd 75) (CRel 0)))
       , MkCtor 78
          (CPi (CSort 0)
            (CPi (CApp (CInd 75) (CRel 0))
              (CPi (CPi (CRel 1) positive_test_nat) (CApp (CInd 75) (CRel 2)))))
       ] : List Ctor);

def positive_test_tree_decl : IndDecl :=
    MkIndDecl 80 (Nil Param) (Nil CoreTerm) 0
      ([ MkCtor 81 positive_test_tree
       , MkCtor 82 (CPi (CApp (CInd 30) positive_test_tree) positive_test_tree)
       ] : List Ctor);

def positive_test_base : List Entry :=
    [ MkIndEntry 75 positive_test_provisional_trap
    , MkIndEntry 70 positive_test_hidden_contra
    , MkIndEntry 60 positive_test_nested
    , MkIndEntry 50 positive_test_pair
    , MkIndEntry 45 positive_test_reader
    , MkIndEntry 40 positive_test_contra
    , MkIndEntry 30 positive_test_list
    ];

def positive_test_sig : List Entry :=
    append Entry
    ([ MkEntry 90 (CPi (CSort 0) (CSort 0)) (Just CoreTerm (CInd 30))
    , MkEntry 91 (CPi (CSort 0) (CSort 0))
        (Just CoreTerm (CLam (CSort 0) (CRel 0)))
    , MkEntry 92 (CPi (CSort 0) (CSort 0))
        (Just CoreTerm (CLam (CSort 0) (CPi (CRel 0) positive_test_nat)))
    , MkEntry 93 (CPi (CSort 0) (CSort 0))
        (Just CoreTerm (CLam (CSort 0) (CPi positive_test_nat (CRel 1))))
    , MkEntry 94 (CSort 0) (Just CoreTerm (CConst 94))
    , MkEntry 95 (CSort 0) (Just CoreTerm (CConst 94))
    , MkEntry 96 (CSort 0) (Just CoreTerm positive_test_tree)
    , MkEntry 97 (CSort 1) (Just CoreTerm (CSort 0))
    , MkEntry 98 (CPi (CSort 0) (CSort 0)) (Nothing CoreTerm)
    ] : List Entry) positive_test_base;

def positive_test_known : List PositiveFunctor :=
    positive_environment positive_test_fuel positive_test_sig;

def positive_test_has (name : Nat) (known : List PositiveFunctor) : Bool :=
    match positive_functor_arity name known with
    | Nothing => False
    | Just _ => True
    end;

def positive_test_field (term : CoreTerm) : Bool :=
    positive_arg positive_test_fuel positive_test_sig positive_test_known 80 term;

def positive_test_decl (declaration : IndDecl) : Bool :=
    positive_inductive positive_test_fuel positive_test_sig positive_test_known declaration;

def positive_test_direct (field : CoreTerm) : IndDecl :=
    MkIndDecl 80 (Nil Param) (Nil CoreTerm) 0
      ([MkCtor 81 (CPi field positive_test_tree)] : List Ctor);

def positive_test_indexed : IndDecl :=
    MkIndDecl 65 ([MkParam 66 (CSort 0)] : List Param)
      ([positive_test_nat] : List CoreTerm) 0
      ([MkCtor 67
        (CPi (CSort 0)
          (CApp (CApp (CInd 65) (CRel 0)) (CConstruct 10 0 0)))] : List Ctor);

def positive_test_dependent : IndDecl :=
    MkIndDecl 68 ([MkParam 69 (CSort 0), MkParam 70 (CRel 0)] : List Param)
      (Nil CoreTerm) 0 (Nil Ctor);

def positive_test_bad_return : IndDecl :=
    MkIndDecl 30 ([MkParam 31 (CSort 0)] : List Param) (Nil CoreTerm) 0
      ([MkCtor 32 (CPi (CSort 0) (CApp (CInd 30) positive_test_nat))] : List Ctor);

def positive_test_shadowed : List Entry :=
    Cons Entry (MkIndEntry 30
      (positive_test_wrapper 30 (CPi (CRel 0) positive_test_nat))) positive_test_base;

def positive_test_cycle : List Entry :=
    [ MkIndEntry 62 (positive_test_wrapper 62 (CApp (CInd 61) (CRel 0)))
    , MkIndEntry 61 (positive_test_wrapper 61 (CApp (CInd 62) (CRel 0)))
    ];

def positive_test_laws : List PositiveLaw :=
    [ MkPositiveLaw "certify List uniform parameter"
        (positive_test_has 30 positive_test_known)
    , MkPositiveLaw "certify Pair both parameters"
        (positive_test_has 50 positive_test_known)
    , MkPositiveLaw "certify positive function codomain"
        (positive_test_has 45 positive_test_known)
    , MkPositiveLaw "certify nested known container"
        (positive_test_has 60 positive_test_known)
    , MkPositiveLaw "reject negative first parameter in binary functor"
        (notb (positive_functor positive_test_fuel positive_test_sig positive_test_known
          (positive_test_pair_contra 1)))
    , MkPositiveLaw "reject negative second parameter in binary functor"
        (notb (positive_functor positive_test_fuel positive_test_sig positive_test_known
          (positive_test_pair_contra 0)))
    , MkPositiveLaw "certify container through List alias"
        (positive_functor positive_test_fuel positive_test_sig positive_test_known
          (positive_test_wrapper 71 (CApp (CConst 90) (CRel 0))))
    , MkPositiveLaw "certify parameter under positive beta alias"
        (positive_functor positive_test_fuel positive_test_sig positive_test_known
          (positive_test_wrapper 71 (CApp (CConst 93) (CRel 0))))
    , MkPositiveLaw "reject parameter under negative beta alias"
        (notb (positive_functor positive_test_fuel positive_test_sig positive_test_known
          (positive_test_wrapper 71 (CApp (CConst 92) (CRel 0)))))
    , MkPositiveLaw "do not certify contravariant parameter"
        (notb (positive_test_has 40 positive_test_known))
    , MkPositiveLaw "do not certify hidden contravariance"
        (notb (positive_test_has 70 positive_test_known))
    , MkPositiveLaw "provisional self cannot excuse a later negative field"
        (notb (positive_test_has 75 positive_test_known))
    , MkPositiveLaw "accept List Tree field"
        (positive_test_field (CApp (CInd 30) positive_test_tree))
    , MkPositiveLaw "accept List List Tree field"
        (positive_test_field (CApp (CInd 30) (CApp (CInd 30) positive_test_tree)))
    , MkPositiveLaw "accept Pair Tree Nat field"
        (positive_test_field (CApp (CApp (CInd 50) positive_test_tree) positive_test_nat))
    , MkPositiveLaw "accept nested proved functor field"
        (positive_test_field (CApp (CInd 60) positive_test_tree))
    , MkPositiveLaw "reject negative functor field"
        (notb (positive_test_field (CApp (CInd 40) positive_test_tree)))
    , MkPositiveLaw "reject unknown inductive application"
        (notb (positive_test_field (CApp (CInd 99) positive_test_tree)))
    , MkPositiveLaw "reject opaque type function application"
        (notb (positive_test_field (CApp (CConst 98) positive_test_tree)))
    , MkPositiveLaw "accept independent opaque type function application"
        (positive_test_field (CApp (CConst 98) positive_test_nat))
    , MkPositiveLaw "accept independent negative container"
        (positive_test_field (CApp (CInd 40) positive_test_nat))
    , MkPositiveLaw "reject negative type inside List"
        (notb (positive_test_field
          (CApp (CInd 30) (CPi positive_test_tree positive_test_nat))))
    , MkPositiveLaw "accept function returning Tree"
        (positive_test_field (CPi positive_test_nat positive_test_tree))
    , MkPositiveLaw "reject function consuming Tree"
        (notb (positive_test_field (CPi positive_test_tree positive_test_nat)))
    , MkPositiveLaw "reject double negative recursion"
        (notb (positive_test_field
          (CPi (CPi positive_test_tree positive_test_nat) positive_test_nat)))
    , MkPositiveLaw "accept List head alias"
        (positive_test_field (CApp (CConst 90) positive_test_tree))
    , MkPositiveLaw "accept beta alias of Tree"
        (positive_test_field (CApp (CConst 91) positive_test_tree))
    , MkPositiveLaw "reject beta alias hiding negative occurrence"
        (notb (positive_test_field (CApp (CConst 92) positive_test_tree)))
    , MkPositiveLaw "accept beta alias returning Tree"
        (positive_test_field (CApp (CConst 93) positive_test_tree))
    , MkPositiveLaw "reject alias of Tree in function domain"
        (notb (positive_test_field (CPi (CConst 96) positive_test_nat)))
    , MkPositiveLaw "accept let alias of List"
        (positive_test_field
          (CLetIn (CInd 30) (CPi (CSort 0) (CSort 0))
            (CApp (CRel 0) positive_test_tree)))
    , MkPositiveLaw "accept discarded let type argument"
        (positive_test_field (CLetIn positive_test_tree (CSort 0) positive_test_nat))
    , MkPositiveLaw "reject cyclic alias"
        (notb (positive_test_field (CConst 95)))
    , MkPositiveLaw "fuel zero rejects positive occurrence"
        (notb (positive_arg 0 positive_test_sig positive_test_known 80 positive_test_tree))
    , MkPositiveLaw "fuel exhaustion cannot prove absence"
        (notb (positive_absent 1 positive_test_sig (PositiveInductive 80)
          (CPi positive_test_tree positive_test_nat)))
    , MkPositiveLaw "fuel exhaustion cannot certify container"
        (notb (positive_test_has 30 (positive_environment 0 positive_test_base)))
    , MkPositiveLaw "missing exhausted certificate rejects nesting"
        (notb (positive_arg positive_test_fuel positive_test_sig
          (positive_environment 0 positive_test_base) 80 (CApp (CInd 30) positive_test_tree)))
    , MkPositiveLaw "accept List recursive declaration"
        (positive_test_decl positive_test_list)
    , MkPositiveLaw "reject direct recursion nested in its own parameter"
        (notb (positive_test_decl
          (positive_test_wrapper 30 (CApp (CInd 30) (CApp (CInd 30) (CRel 0))))))
    , MkPositiveLaw "accept nested-tree-fold declaration"
        (positive_test_decl positive_test_tree_decl)
    , MkPositiveLaw "accept constructor field function codomain"
        (positive_test_decl (positive_test_direct (CPi positive_test_nat positive_test_tree)))
    , MkPositiveLaw "reject constructor field function domain"
        (notb (positive_test_decl (positive_test_direct (CPi positive_test_tree positive_test_nat))))
    , MkPositiveLaw "contravariant parameter declaration itself remains admissible"
        (positive_test_decl positive_test_contra)
    , MkPositiveLaw "accept ordinary indexed declaration"
        (positive_test_decl positive_test_indexed)
    , MkPositiveLaw "indexed container has no covariance certificate"
        (notb (positive_functor positive_test_fuel positive_test_sig positive_test_known
          positive_test_indexed))
    , MkPositiveLaw "dependent parameter container has no covariance certificate"
        (notb (positive_functor positive_test_fuel positive_test_sig positive_test_known
          positive_test_dependent))
    , MkPositiveLaw "reject nonuniform constructor result"
        (notb (positive_test_decl positive_test_bad_return))
    , MkPositiveLaw "reject undeclared constructor index"
        (notb (positive_test_decl
          (MkIndDecl 80 (Nil Param) (Nil CoreTerm) 0
            ([MkCtor 81 (CApp positive_test_tree positive_test_nat)] : List Ctor))))
    , MkPositiveLaw "shadowing invalidates old functor certificate"
        (notb (positive_test_has 30
          (positive_environment positive_test_fuel positive_test_shadowed)))
    , MkPositiveLaw "shadowing invalidates dependent functor certificate"
        (notb (positive_test_has 60
          (positive_environment positive_test_fuel positive_test_shadowed)))
    , MkPositiveLaw "constant shadowing invalidates old functor certificate"
        (notb (positive_test_has 30
          (positive_environment positive_test_fuel
            (Cons Entry (MkEntry 30 (CSort 0) (Nothing CoreTerm)) positive_test_base))))
    , MkPositiveLaw "forward dependencies cannot certify each other"
        (eqNat 0 (length PositiveFunctor
          (positive_environment positive_test_fuel positive_test_cycle)))
    , MkPositiveLaw "case metadata cannot hide target in a branch"
        (notb (positive_absent positive_test_fuel positive_test_sig (PositiveInductive 80)
          (CCase (MkCaseInfo 10 0 (Nil Nat)) (CSort 0) (CRel 0)
            ([positive_test_nat, positive_test_tree] : List CoreTerm))))
    ];

def positive_test_status (A : Type) (result : CheckResult A) : Nat :=
    match result with
    | CheckOk _ => 0
    | CheckErr failure => check_failure_code 1 failure
    end;

def positive_test_boolean (expected : Bool) (result : CheckResult Bool) : Bool :=
    match result with
    | CheckErr _ => False
    | CheckOk actual => match expected with | True => actual | False => notb actual end
    end;

def positive_test_empty (result : CheckResult (List PositiveFunctor)) : Bool :=
    match result with
    | CheckErr _ => False
    | CheckOk known => eqNat 0 (length PositiveFunctor known)
    end;

def positive_test_aliases : Nat -> Nat -> List Entry :=
  fix positive_test_aliases (remaining : Nat) (name : Nat) : List Entry :=
    match remaining with
    | Z => [MkEntry name (CSort 1) (Just CoreTerm (CSort 0))]
    | S rest =>
        Cons Entry (MkEntry name (CSort 1) (Just CoreTerm (CConst (S name))))
          (positive_test_aliases rest (S name))
    end;

def positive_test_deep_sig : List Entry := positive_test_aliases 205 100;

def positive_test_typed_laws : List PositiveLaw :=
    [ MkPositiveLaw "checked field distinguishes positive proof"
        (positive_test_boolean True
          (positive_arg_checked positive_test_fuel positive_test_sig positive_test_known
            80 (CApp (CInd 30) positive_test_tree)))
    , MkPositiveLaw "checked field distinguishes negative proof"
        (positive_test_boolean False
          (positive_arg_checked positive_test_fuel positive_test_sig positive_test_known
            80 (CPi positive_test_tree positive_test_nat)))
    , MkPositiveLaw "checked functor distinguishes contravariance"
        (positive_test_boolean False
          (positive_functor_checked positive_test_fuel positive_test_sig positive_test_known
            positive_test_contra))
    , MkPositiveLaw "checked environment omits proved negative functor"
        (positive_test_empty (positive_environment_checked positive_test_fuel
          ([MkIndEntry 40 positive_test_contra] : List Entry)))
    , MkPositiveLaw "checked environment accepts empty input without proof fuel"
        (positive_test_empty (positive_environment_checked 0 (Nil Entry)))
    , MkPositiveLaw "checked environment reports fuel zero"
        (eqNat 4 (positive_test_status (List PositiveFunctor)
          (positive_environment_checked 0 positive_test_base)))
    , MkPositiveLaw "checked environment reports exhausted functor proof"
        (eqNat 4 (positive_test_status (List PositiveFunctor)
          (positive_environment_checked 2
            ([MkIndEntry 30 positive_test_list] : List Entry))))
    , MkPositiveLaw "checked field reports fuel zero"
        (eqNat 4 (positive_test_status Bool
          (positive_arg_checked 0 positive_test_sig positive_test_known 80 positive_test_tree)))
    , MkPositiveLaw "checked absence reports fuel exhaustion"
        (eqNat 4 (positive_test_status Bool
          (positive_absent_checked 1 positive_test_sig (PositiveInductive 80)
            (CPi positive_test_tree positive_test_nat))))
    , MkPositiveLaw "checked absence proves target occurrence is present"
        (positive_test_boolean False
          (positive_absent_checked positive_test_fuel positive_test_sig
            (PositiveInductive 80) positive_test_tree))
    , MkPositiveLaw "checked declaration reports fuel zero"
        (eqNat 4 (positive_test_status Bool
          (positive_inductive_checked 0 positive_test_sig positive_test_known
            positive_test_tree_decl)))
    , MkPositiveLaw "checked functor reports fuel zero"
        (eqNat 4 (positive_test_status Bool
          (positive_functor_checked 0 positive_test_sig positive_test_known positive_test_list)))
    , MkPositiveLaw "checked cyclic field is a resource error"
        (eqNat 4 (positive_test_status Bool
          (positive_arg_checked 20 positive_test_sig positive_test_known 80 (CConst 95))))
    , MkPositiveLaw "checked cyclic constructor field is a resource error"
        (eqNat 4 (positive_test_status Bool
          (positive_inductive_checked 20 positive_test_sig positive_test_known
            (positive_test_direct (CConst 95)))))
    , MkPositiveLaw "checked environment propagates cyclic constructor field"
        (eqNat 4 (positive_test_status (List PositiveFunctor)
          (positive_environment_checked positive_test_fuel
            (Cons Entry (MkIndEntry 71 (positive_test_wrapper 71 (CConst 95)))
              positive_test_sig))))
    , MkPositiveLaw "checked absence reports deep alias exhaustion"
        (eqNat 4 (positive_test_status Bool
          (positive_absent_checked 100 positive_test_deep_sig
            (PositiveInductive 80) (CConst 100))))
    , MkPositiveLaw "checked field reports deep alias exhaustion"
        (eqNat 4 (positive_test_status Bool
          (positive_arg_checked 100 positive_test_deep_sig (Nil PositiveFunctor)
            80 (CConst 100))))
    , MkPositiveLaw "checked field resolves aliases beyond former depth 200"
        (positive_test_boolean True
          (positive_arg_checked positive_test_fuel positive_test_deep_sig
            (Nil PositiveFunctor) 80 (CConst 100)))
    , MkPositiveLaw "checked absence resolves aliases beyond former depth 200"
        (positive_test_boolean True
          (positive_absent_checked positive_test_fuel positive_test_deep_sig
            (PositiveInductive 80) (CConst 100)))
    , MkPositiveLaw "checked malformed application is a reduction error"
        (eqNat 6 (positive_test_status Bool
          (positive_arg_checked positive_test_fuel positive_test_sig positive_test_known
            80 (CApp (CSort 0) positive_test_tree))))
    , MkPositiveLaw "checked malformed case is a reduction error"
        (eqNat 6 (positive_test_status Bool
          (positive_absent_checked positive_test_fuel positive_test_sig (PositiveInductive 80)
            (CCase (MkCaseInfo 10 0 (Nil Nat)) (CSort 0) (CRel 0)
              ([positive_test_tree] : List CoreTerm)))))
    , MkPositiveLaw "checked known negative proof stops before cyclic remainder"
        (positive_test_boolean False
          (positive_arg_checked positive_test_fuel positive_test_sig positive_test_known
            80 (CPi positive_test_tree (CConst 95))))
    ];

-- A single IO pass reports every law and preserves a nonzero failure exit.
def positive_tests_run : List PositiveLaw -> Bool -> IO Unit :=
  fix positive_tests_run (laws : List PositiveLaw) (failed : Bool) : IO Unit :=
    match laws with
    | Nil => match failed with | True => exit 1 | False => exit 0 end
    | Cons law rest =>
        match law with
        | MkPositiveLaw name passed =>
            do println (prim_string_concat
                 (match passed with | True => "ok " | False => "FAIL " end) name);
               positive_tests_run rest (orb failed (notb passed))
        end
    end;

def main : IO Unit :=
    positive_tests_run (append PositiveLaw positive_test_laws positive_test_typed_laws) False;
