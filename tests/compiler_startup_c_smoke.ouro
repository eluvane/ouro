-- Development compatibility uses only the existing C implementation keys.
-- Native startup behavior is exercised by the separate Windows PE fixtures.
import "../std/io.ouro";

def StartupText : Type := String;
def StartupAction (A : Type) : Type := IO A;
intrinsic selected_arguments : StartupAction (List StartupText) := "ouro.runtime.argv";
intrinsic selected_environment : StartupText -> StartupAction (Maybe StartupText) := "ouro.runtime.env_get";

def startup_c_expect (condition : Bool) : IO Unit :=
    match condition with | True => io_unit | False => exit 93 end;

def main : IO Unit :=
    let argument_action : IO (List String) := selected_arguments in
    let environment_action : IO (Maybe String) := selected_environment "OURO_STARTUP_TEST_C_SHIM" in
    do let! arguments := argument_action;
       startup_c_expect (match arguments with | Nil => False | Cons _ rest =>
         match rest with | Nil => True | Cons _ _ => False end end);
       let! value := environment_action;
       startup_c_expect (match value with | Nothing => False | Just text => prim_string_eq text "startup-c-value" end);
       print "startup-c\n";
       exit 42
