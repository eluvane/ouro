-- Copy/replacement authority follows the checked identity and complete signature.
import "../compiler/file_elab.ouro",
  "../compiler/checked_program_output.ouro",
  "../std/test.ouro",
  "compiler_binding_surface.ouro";

def copy_binding_type (copy : PrimitiveId) (aliases : Bool) (mode : Nat) : CoreTerm :=
    let replacement : Bool := primitive_id_equal copy PrimitiveFileReplace in
    let text : CoreTerm := match aliases with | True => CConst 108 | False => CConst 100 end in
    let unit_value : CoreTerm := match aliases with | True => CConst 111 | False => CInd 102 end in
    let runtime : CoreTerm := match aliases with | True => CConst 109 | False => CConst 101 end in
    let result : CoreTerm := match eqNat mode 2 with | True => unit_value
      | False => CApp runtime (match eqNat mode 3 with | True => text | False => match eqNat mode 6 with
        | True => CInd (match replacement with | True => 105 | False => 112 end) | False => unit_value end end) end in
    let ending : CoreTerm := match andb(replacement, notb (eqNat mode 9)) with
      | True => CPi(match eqNat mode 10 with | True => CInd 105 | False => text end, result)
      | False => result end in
    let destination : CoreTerm := CPi (match eqNat mode 7 with | True => unit_value | False => text end)
      (match eqNat mode 5 with | True => CPi text ending | False => ending end) in
    match eqNat mode 4 with | True => result | False =>
      CPi (match eqNat mode 1 with | True => unit_value | False => text end)
        (match eqNat mode 8 with | True => result | False => destination end) end;

def copy_binding_base (copy : PrimitiveId) : List FileItem :=
    match primitive_id_equal copy PrimitiveFileReplace with
    | True => compiler_binding_nat_unit_base
    | False => compiler_binding_unit_extra_base end;

def copy_binding_declaration (copy : PrimitiveId) (typ : CoreTerm) : FileItem :=
    FIntrinsic(120, typ, primitive_key copy, Nothing CoreTerm);

def copy_binding_metadata (copy : PrimitiveId) (aliases : Bool) : Bool :=
    match compiler_binding_check_last(copy_binding_base copy, copy_binding_declaration(copy, copy_binding_type copy aliases 0)) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      any Entry (fun (entry : Entry) => match entry with
        | MkBoundEntry name _ binding => match eqNat name 120 with | False => False | True =>
            match binding with | PrimitiveExternBinding _ => False
            | PrimitiveIntrinsicBinding actual execution gc specialization => andb (primitive_id_equal actual copy)
                (andb (match execution with | PrimitiveRuntimeAction => True
                  | PrimitiveTypeOnly => False | PrimitivePureValue => False end)
                  (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                    (match specialization with | Nothing => True | Just _ => False end))) end end
        | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False end) entries end;

def copy_binding_rejected (copy : PrimitiveId) (mode : Nat) : Bool :=
    match compiler_binding_check_last(copy_binding_base copy, copy_binding_declaration(copy, copy_binding_type copy False mode)) with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure => andb (eqNat name 120)
        (eqNat(declaration_failure_code CheckExactCore phase failure, 2)) end;

def copy_binding_shim (copy : PrimitiveId) (axiom_only : Bool) : Bool :=
    match compiler_binding_check_last (copy_binding_base copy) (match axiom_only with
      | True => FAxiom(120, copy_binding_type copy False 0)
      | False => copy_binding_declaration(copy, copy_binding_type copy True 0) end) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      let shims : List (Pair Nat (List Nat)) :=
        checked_program_c_shims (CheckedProgramOf empty_intern entries ([] : List (Pair Nat CoreTerm))) in
      match axiom_only with
      | True => notb (any (Pair(Nat, List Nat)) (fun (item : Pair Nat (List Nat)) =>
          match item with | MkPair name _ => eqNat name 120 end) shims)
      | False => any (Pair(Nat, List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair name key =>
          andb (eqNat name 120) (primitive_bytes_equal key (prim_string_to_char_codes
            (match primitive_id_equal copy PrimitiveFileReplace with
             | True => "prim_fs_replace_file" | False => "prim_fs_copy_file" end))) end) shims end end;

def copy_binding_tests (copy : PrimitiveId) : List Test :=
    let key : String := prim_string_of_char_codes (primitive_key copy) in
    [assert_true(str_concat key " records canonical effect and GC metadata", copy_binding_metadata copy False),
     assert_true(str_concat key " accepts normalized String, result and Runtime aliases", copy_binding_metadata copy True),
     assert_true(str_concat key " rejects a non-String source path", copy_binding_rejected copy 1),
     assert_true(str_concat key " rejects a pure result", copy_binding_rejected copy 2),
     assert_true(str_concat key " rejects a Runtime String result", copy_binding_rejected copy 3),
     assert_true(str_concat key " rejects both missing path arguments", copy_binding_rejected copy 4),
     assert_true(str_concat key " rejects an extra path argument", copy_binding_rejected copy 5),
     assert_true(str_concat key " rejects an unrelated result representation", copy_binding_rejected copy 6),
     assert_true(str_concat key " rejects a non-String destination path", copy_binding_rejected copy 7),
     assert_true(str_concat key " rejects the missing destination argument", copy_binding_rejected copy 8),
     assert_true(str_concat key " maps a renamed checked identity to the retained C handler", copy_binding_shim copy False),
     assert_true(str_concat key " gives no checked authority to a same-shaped axiom", copy_binding_shim copy True)];

def main : IO Unit :=
    test_run (append Test (concat_map PrimitiveId Test copy_binding_tests
      ([PrimitiveFileCopy, PrimitiveFileReplace] : List PrimitiveId))
      ([assert_true("replacement rejects a missing backup argument", copy_binding_rejected PrimitiveFileReplace 9),
        assert_true("replacement rejects a non-String backup", copy_binding_rejected PrimitiveFileReplace 10)] : List Test));
