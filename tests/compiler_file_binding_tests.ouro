-- File authority comes from checked identities and complete action types.
import "../compiler/file_elab.ouro",
  "../compiler/checked_program_output.ouro",
  "../std/test.ouro",
  "compiler_binding_surface.ouro";

def file_binding_ids : List PrimitiveId :=
    [PrimitiveFileRead, PrimitiveFileWrite];

def file_binding_type (id : PrimitiveId) (aliases : Bool) (bad_argument : Bool) (pure_result : Bool) : CoreTerm :=
    let text : CoreTerm := match aliases with | True => CConst 108 | False => CConst 100 end in
    let unit : CoreTerm := match aliases with | True => CConst 110 | False => CInd 105 end in
    let runtime : CoreTerm := match aliases with | True => CConst 109 | False => CConst 101 end in
    let reading : Bool := primitive_id_equal id PrimitiveFileRead in
    let output : CoreTerm := match reading with | True => text | False => unit end in
    let result : CoreTerm := match pure_result with | True => output | False => CApp runtime output end in
    let argument : CoreTerm := match bad_argument with | True => unit | False => text end in
    match reading with | True => CPi argument result | False => CPi(text, CPi argument result) end;

def file_binding_declaration (id : PrimitiveId) (typ : CoreTerm) : FileItem :=
    FIntrinsic(120, typ, primitive_key id, Nothing CoreTerm);

def file_binding_entries (id : PrimitiveId) (aliases : Bool) : DeclarationResult :=
    compiler_binding_check (append FileItem compiler_binding_nat_unit_base
      ([file_binding_declaration(id, file_binding_type id aliases False False)] : List FileItem));

def file_binding_metadata (id : PrimitiveId) (aliases : Bool) : Bool :=
    match file_binding_entries id aliases with | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      any Entry (fun (entry : Entry) => match entry with
        | MkBoundEntry name _ binding => match eqNat name 120 with | False => False | True =>
            match binding with | PrimitiveExternBinding _ => False
            | PrimitiveIntrinsicBinding actual execution gc specialization => andb (primitive_id_equal actual id)
                (andb (match execution with | PrimitiveRuntimeAction => True
                  | PrimitiveTypeOnly => False | PrimitivePureValue => False end)
                  (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                    (match specialization with | Nothing => True | Just _ => False end))) end end
        | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False end) entries end;

def file_binding_rejected (id : PrimitiveId) (bad_argument : Bool) (pure_result : Bool) : Bool :=
    match compiler_binding_check (append FileItem compiler_binding_nat_unit_base
      ([file_binding_declaration(id, file_binding_type id False bad_argument pure_result)] : List FileItem)) with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure => andb (eqNat name 120)
        (eqNat(declaration_failure_code CheckExactCore phase failure, 2)) end;

def file_binding_c_key (id : PrimitiveId) : String :=
    match primitive_id_equal id PrimitiveFileRead with | True => "prim_fs_read_file"
    | False => "prim_fs_write_file" end;

def file_binding_c_shim (id : PrimitiveId) : Bool :=
    match file_binding_entries id True with | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      any (Pair(Nat, List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair name key =>
        andb(eqNat name 120, primitive_bytes_equal(key, prim_string_to_char_codes (file_binding_c_key id))) end)
        (checked_program_c_shims (CheckedProgramOf empty_intern entries ([] : List (Pair Nat CoreTerm)))) end;

def file_binding_axiom (id : PrimitiveId) : Bool :=
    match compiler_binding_check (append FileItem compiler_binding_nat_unit_base
      ([FAxiom(120, file_binding_type id False False False)] : List FileItem)) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
        notb (any (Pair(Nat, List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair name _ => eqNat name 120 end)
          (checked_program_c_shims (CheckedProgramOf empty_intern entries ([] : List (Pair Nat CoreTerm))))) end;

def main : IO Unit :=
    test_run (concat_map PrimitiveId Test (fun (id : PrimitiveId) =>
      let key : String := prim_string_of_char_codes (primitive_key id) in
      ([assert_true(prim_string_concat key " records canonical effect metadata", file_binding_metadata id False),
        assert_true(prim_string_concat key " accepts transparent argument/result aliases", file_binding_metadata id True),
        assert_true(prim_string_concat key " rejects the wrong argument shape", file_binding_rejected id True False),
        assert_true(prim_string_concat key " rejects a pure result", file_binding_rejected id False True),
        assert_true(prim_string_concat key " maps renamed checked identity to the exact legacy C handler", file_binding_c_shim id),
        assert_true(prim_string_concat key " keeps ordinary axioms outside checked C identity mapping", file_binding_axiom id)] : List Test))
      file_binding_ids);
