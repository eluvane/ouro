-- String -> Runtime String is authorized by the checked realpath identity.
import "../compiler/file_elab.ouro",
  "../compiler/checked_program_output.ouro",
  "../std/test.ouro";

def realpath_binding_base : List FileItem :=
    [FIntrinsic(100, CSort 0, primitive_key PrimitiveStringType, Nothing CoreTerm),
     FIntrinsic(101, CPi(CSort 0, CSort 0), primitive_key PrimitiveRuntimeType, Nothing CoreTerm),
     FInd (MkIndDecl 102 ([] : List Param) ([] : List CoreTerm) 0
       ([MkCtor(103, CInd 102)] : List Ctor)),
     FRepresentation(102, prim_string_to_char_codes "ouro.unit"),
     FDef(108, CSort 0, CConst 100), FDef(109, CPi(CSort 0, CSort 0), CConst 101)];

def realpath_binding_type (aliases : Bool) (mode : Nat) : CoreTerm :=
    let text : CoreTerm := match aliases with | True => CConst 108 | False => CConst 100 end in
    let runtime : CoreTerm := match aliases with | True => CConst 109 | False => CConst 101 end in
    let result : CoreTerm := match eqNat mode 2 with | True => text
      | False => CApp(runtime, match eqNat mode 3 with | True => CInd 102 | False => text end) end in
    match eqNat mode 4 with | True => result | False =>
      CPi (match eqNat mode 1 with | True => CInd 102 | False => text end)
        (match eqNat mode 5 with | True => CPi text result | False => result end) end;

def realpath_binding_declaration (aliases : Bool) (mode : Nat) : FileItem :=
    FIntrinsic 120 (realpath_binding_type aliases mode)
      (match eqNat mode 6 with | True => prim_string_to_char_codes "ouro.fs.realpatH"
        | False => primitive_key PrimitiveFileRealpath end) (Nothing CoreTerm);

def realpath_binding_check (last : FileItem) : DeclarationResult :=
    check_declarations CheckExactCore keep_checking (mul 20 50)
      (append FileItem realpath_binding_base ([last] : List FileItem));

def realpath_binding_metadata (aliases : Bool) : Bool :=
    match realpath_binding_check (realpath_binding_declaration aliases 0) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      any Entry (fun (entry : Entry) => match entry with
        | MkBoundEntry name _ binding => match eqNat name 120 with | False => False | True =>
            match binding with | PrimitiveExternBinding _ => False
            | PrimitiveIntrinsicBinding actual execution gc specialization => andb (primitive_id_equal actual PrimitiveFileRealpath)
                (andb (match execution with | PrimitiveRuntimeAction => True
                  | PrimitiveTypeOnly => False | PrimitivePureValue => False end)
                  (andb (match gc with | PrimitiveMayGc => True | PrimitiveNoGc => False end)
                    (match specialization with | Nothing => True | Just _ => False end))) end end
        | MkEntry _ _ _ => False | MkIndEntry _ _ => False | MkRoleEntry _ => False end) entries end;

def realpath_binding_rejected (mode : Nat) : Bool :=
    match realpath_binding_check (realpath_binding_declaration False mode) with
    | DeclarationsOk _ => False
    | DeclarationsErr name phase failure => andb (eqNat name 120)
        (eqNat (declaration_failure_code CheckExactCore phase failure)
          (match eqNat mode 6 with | True => 7 | False => 2 end)) end;

def realpath_binding_shim (axiom_only : Bool) : Bool :=
    match realpath_binding_check (match axiom_only with
      | True => FAxiom(120, realpath_binding_type False 0)
      | False => realpath_binding_declaration True 0 end) with
    | DeclarationsErr _ _ _ => False | DeclarationsOk entries =>
      let shims : List (Pair Nat (List Nat)) :=
        checked_program_c_shims (CheckedProgramOf empty_intern entries ([] : List (Pair Nat CoreTerm))) in
      match axiom_only with
      | True => notb (any (Pair(Nat, List Nat)) (fun (item : Pair Nat (List Nat)) =>
          match item with | MkPair name _ => eqNat name 120 end) shims)
      | False => any (Pair(Nat, List Nat)) (fun (item : Pair Nat (List Nat)) => match item with | MkPair name key =>
          andb(eqNat name 120, primitive_bytes_equal(key, prim_string_to_char_codes "prim_fs_realpath")) end) shims end end;

def main : IO Unit :=
    test_run
      [assert_true("realpath retains reserved identity 265", eqNat(primitive_id_code PrimitiveFileRealpath, 265)),
       assert_true("realpath records canonical effect and GC metadata", realpath_binding_metadata False),
       assert_true("realpath accepts normalized String and Runtime aliases", realpath_binding_metadata True),
       assert_true("realpath rejects a non-String path", realpath_binding_rejected 1),
       assert_true("realpath rejects a pure String result", realpath_binding_rejected 2),
       assert_true("realpath rejects a Runtime Unit result", realpath_binding_rejected 3),
       assert_true("realpath rejects a missing path argument", realpath_binding_rejected 4),
       assert_true("realpath rejects an extra path argument", realpath_binding_rejected 5),
       assert_true("realpath rejects an unknown near-matching key", realpath_binding_rejected 6),
       assert_true("realpath maps renamed checked identity to the retained C handler", realpath_binding_shim False),
       assert_true("realpath grants no checked authority to a same-shaped axiom", realpath_binding_shim True)];
