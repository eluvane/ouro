-- Explicit typed MIR wrappers audit raw ownership after checked source replay.
-- Real OS allocate/free/open/close calls remain in the positive wrapper paths.
import "native_startup_fault_calls.ouro",
  "../compiler/native/managed_files.ouro";

def file_fault_symbol_names : List String :=
    ["raw_pages_allocate", "raw_pages_release", "raw_windows_utf8_to_utf16", "raw_windows_file_open",
      "raw_windows_file_open_write", "raw_windows_file_length", "raw_windows_file_prepare_write",
      "raw_windows_file_read", "raw_windows_file_write", "raw_windows_file_close", "windows_exit_process", "managed_collect"];

def file_fault_symbols (checked : CheckedProgram) : Either NativeLowerError (List Nat) :=
    (fix resolve (names : List String) : Either NativeLowerError (List Nat) :=
      match names with | Nil => Right(NativeLowerError, List Nat, [] : List Nat)
      | Cons name rest => lower_bind Nat (List Nat) (managed_source_symbol(checked, prim_string_to_char_codes name))
          (fun (id : Nat) => lower_map(List Nat, List Nat, Cons Nat id, resolve rest)) end) file_fault_symbol_names;

def file_fault_release (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 0 state)
      (fun (closed : ManagedState) => lower_bind ManagedState ManagedResult (startup_fault_pop base (MirUse 0) closed)
        (fun (popped : ManagedState) => lower_bind ManagedResult ManagedResult
          (startup_fault_call MirU8 original ([MirUse 0] : List MirValue) popped)
          (fun (released : ManagedResult) => match released with | ManagedResultOf okay after =>
            lower_bind ManagedState ManagedResult (managed_require_equal okay (managed_bits MirU8 1) after)
              (fun (success : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 8 success)
                (fun (counted : ManagedResult) => match counted with | ManagedResultOf attempt next =>
                  match orb(eqNat mode 14, eqNat mode 17) with
                  | False => startup_fault_result MirU8 1 next
                  | True => managed_compare MirNotEqual attempt (managed_bits MirUSize 1) next end end)) end)));

def file_fault_open (base : Nat) (mode : Nat) (original : Nat) (arguments : List MirValue)
    (owner : MirValue) (state : ManagedState) : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (startup_fault_count base 16 state)
      (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
        lower_bind ManagedState ManagedResult (startup_fault_stat base 72 0 next)
          (fun (vacant : ManagedState) => match eqNat mode 8 with
            | True => startup_fault_result MirU32 5 vacant
            | False => lower_bind ManagedResult ManagedResult (startup_fault_call MirU32 original arguments vacant)
                (fun (opened : ManagedResult) => match opened with | ManagedResultOf status after =>
                  lower_bind ManagedState ManagedResult (managed_require_equal status (managed_bits MirU32 0) after)
                    (fun (success : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize owner 0 success)
                      (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bits ready =>
                        lower_bind ManagedResult ManagedResult (managed_convert MirRawPtr MirRawFromBits bits ready)
                          (fun (converted : ManagedResult) => match converted with | ManagedResultOf stream final =>
                            lower_bind ManagedState ManagedResult (startup_fault_store base 80 stream final)
                              (fun (saved : ManagedState) => lower_map ManagedState ManagedResult
                                (fun (finished : ManagedState) => ManagedResultOf status finished)
                                (startup_fault_store base 72 (managed_bits MirUSize 1) saved)) end) end)) end) end) end);

def file_fault_close (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 1 state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_load base 80 MirRawPtr owned)
        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf stream next =>
          lower_bind ManagedState ManagedResult (managed_require_equal stream (MirUse 0) next)
            (fun (same : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 24 same)
              (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ entered =>
                lower_bind ManagedResult ManagedResult (startup_fault_call MirU32 original ([MirUse 0] : List MirValue) entered)
                  (fun (closed : ManagedResult) => match closed with | ManagedResultOf status after =>
                    lower_bind ManagedState ManagedResult (managed_require_equal status (managed_bits MirU32 0) after)
                      (fun (success : ManagedState) => lower_bind ManagedState ManagedResult
                        (startup_fault_store base 72 (managed_bits MirUSize 0) success)
                        (startup_fault_result(MirU32, match orb(eqNat mode 13, eqNat mode 17) with | True => 5 | False => 0 end))) end) end)) end));

def file_fault_prepare (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 1 state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 48 owned)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
          match eqNat mode 9 with | True => startup_fault_result MirU32 5 next | False =>
            match eqNat mode 18 with
            | True => startup_fault_result MirU32 0 (managed_emit (MirStore (MirUse 1) (codegen_disp 0)
                (MirBits(MirUSize, X64Words64(X64Bytes32 255 255 255 255, X64Bytes32 255 255 255 255)))) next)
            | False => startup_fault_call MirU32 original ([MirUse 0, MirUse 1] : List MirValue) next end end end));
