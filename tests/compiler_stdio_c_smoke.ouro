-- Arbitrary declaration names must reach exactly the checked C host adapters.
import "../std/io.ouro";

intrinsic renamed_stdout : String -> IO Unit := "ouro.runtime.stdout.write";
intrinsic renamed_stderr : String -> IO Unit := "ouro.runtime.stderr.write";
intrinsic renamed_flush : IO Unit := "ouro.runtime.stdout.flush";
intrinsic renamed_exit : Nat -> IO Unit := "ouro.runtime.exit";

def main : IO Unit :=
    do renamed_stdout "stdio-out";
       renamed_stderr "stdio-err";
       renamed_flush;
       renamed_exit 42
