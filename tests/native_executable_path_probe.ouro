-- Run the emitted executable from different directories and copied path names.
-- Its exact stdout must equal the loaded absolute path plus LF.
import "../std/executable.ouro";

def main : IO Unit :=
    do let! result := executable_path_checked;
       match result with
       | Left error => do eprintln (executable_path_error_message error); exit 1
       | Right path => println path
       end
