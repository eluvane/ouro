-- Reuse every metadata fault/count/order assertion. A real collection during
-- each raw-page release additionally tests the returned Bool's caller roots.
import "native_fs_kind_fixtures.ouro";

def native_predicate_fixture (mode : Nat) (parts : ManagedProgramParts) : Either NativeLowerError MirProgram :=
    match parts with | ManagedProgramOf _ _ original =>
      let base : Nat := S (foldr Nat Nat maxNat 0 (mir_global_ids original)) in
      lower_map MirProgram MirProgram (fun (program : MirProgram) => match program with
        | MirProgramDef functions data libraries entry =>
          MirProgramDef (map MirFunction MirFunction (native_fault_release_collect(S base, add base 11)) functions)
            data libraries entry end) (native_kind_fixture mode parts) end;
