-- Native edit transaction, applicability and convergence regression laws.
-- @entry main
import "quality_test_support.ouro",
  "../tools/fix/pipeline.ouro",
  "../std/io.ouro";

def fp_edit (start : Nat) (stop : Nat) (replacement : String) (rule : String) : FxEdit :=
    MkFxEdit start stop replacement rule 1 "test preservation witness";

def fp_reject (src : String) (edits : List FxEdit) : Bool :=
    match fx_checked_plan src edits with | Left _ => True | Right _ => False end;

def fp_count (src : String) (edits : List FxEdit) (count : Nat) : Bool :=
    match fx_checked_plan src edits with
    | Left _ => False
    | Right plan => eq_nat(length FxEdit plan, count)
    end;

def fp_cycle_round (src : String) : Either FxPrepareError (Pair String (List FxEdit)) :=
    Right FxPrepareError (Pair(String, List FxEdit))
      (MkPair String (List FxEdit) (match prim_string_eq src "A" with | True => "B" | False => "A" end)
        [fp_edit 0 1 "B" "double-semi"]);

def fp_cycle : Bool :=
    match fx_checked_fixpoint_with fp_cycle_round 8 "A" [] [] with
    | Right _ => False
    | Left error => match error with
      | FxCycle => True
      | FxInvalidPlan _ => False | FxNotConverged => False | FxFormatError _ => False
      | FxFormatReopensFix => False | FxLiteralBinding => False
      end
    end;

def fp_fixed (src : String) : Bool :=
    match fx_prepare [] src with
    | Left _ => False
    | Right first => match fx_prepare([], fx_outcome_text first) with
      | Left _ => False
      | Right second => andb (str_eq(fx_outcome_text first, fx_outcome_text second))
          (nullb(FxEdit, fx_outcome_edits second))
      end
    end;

def fp_format_commutes (src : String) : Bool :=
    match fmt_checked src with
    | Left _ => False
    | Right formatted => match fx_prepare [] src with
      | Left _ => False
      | Right a => match fx_prepare [] formatted with
        | Left _ => False
        | Right b => str_eq(fx_outcome_text a, fx_outcome_text b)
        end
      end
    end;

def fp_priority : Bool :=
    match fx_checked_plan "abcd" [fp_edit 0 1 "" "identity-let", fp_edit 2 3 "" "double-semi"] with
    | Left _ => False
    | Right plan => match plan with
      | Nil => False
      | Cons edit rest => andb(nullb FxEdit rest, str_eq(fx_edit_rule edit, "double-semi"))
      end
    end;

def fp_order : Bool :=
    let edits : List FxEdit := [fp_edit 0 1 "" "double-semi", fp_edit 2 3 "" "do-bind"] in
    match fx_checked_plan "abcd" edits with
    | Left _ => False
    | Right a => match fx_checked_plan("abcd", reverse_lin FxEdit edits) with
      | Left _ => False
      | Right b => andb(str_eq(fx_apply "abcd" a, "bd"), str_eq(fx_apply "abcd" a, fx_apply "abcd" b))
      end
    end;

def fp_comment_atomic : Bool :=
    let src : String := "let -- rationale\n x := call in x" in
    let edits : List FxEdit := [fp_edit 0 22 "" "do-bind", fp_edit 27 32 "" "do-bind"] in
    andb (nullb(FxEdit, fx_automatic_proposals src edits))
      (eq_nat(length(FxEdit, fx_review_proposals src edits), 2));

def fp_laws : List (Pair String Bool) :=
    [ MkPair String Bool "same-priority-overlap-fails" (fp_reject "abcd"
        [fp_edit 0 2 "" "double-semi", fp_edit 1 3 "" "do-bind"])
    , MkPair String Bool "conflicting-same-point-insertions-fail" (fp_reject "abcd"
        [fp_edit 1 1 "a" "do-bind", fp_edit 1 1 "b" "do-bind"])
    , MkPair String Bool "duplicate-identical-proposals-coalesce" (fp_count "abcd"
        [fp_edit 0 1 "" "double-semi", fp_edit 0 1 "" "double-semi"] 1)
    , MkPair String Bool "out-of-bounds-fails" (fp_reject "abcd" [fp_edit 1 6 "" "double-semi"])
    , MkPair String Bool "inverted-span-fails" (fp_reject "abcd" [fp_edit 3 1 "" "double-semi"])
    , MkPair String Bool "unknown-rule-fails" (fp_reject "abcd" [fp_edit 0 1 "" "unknown"])
    , MkPair String Bool "no-op-proposal-fails" (fp_reject "abcd" [fp_edit 0 1 "a" "double-semi"])
    , MkPair String Bool "empty-plan-succeeds" (fp_count "abcd" [] 0)
    , MkPair String Bool "priority-before-byte-position" fp_priority
    , MkPair String Bool "order-independent-disjoint-edits" fp_order
    , MkPair String Bool "comment-sensitive-compound-is-atomic" fp_comment_atomic
    , MkPair String Bool "comment-looking-string-is-data" (fx_plain_fragment "\"-- data\"")
    , MkPair String Bool "actual-comment-is-protected" (notb (fx_plain_fragment "x -- rationale\n y"))
    , MkPair String Bool "constructor-rewrite-needs-review" (fp_count "S Z" [fp_edit 0 3 "1" "peano-literal"] 0)
    , MkPair String Bool "coverage-rewrite-needs-review" (fp_count "abcd" [fp_edit 0 1 "" "unreachable-arm"] 0)
    , MkPair String Bool "binder-rewrite-needs-review" (fp_count "abcd" [fp_edit 0 1 "_" "unused-binder"] 0)
    , MkPair String Bool "cycle-fails-before-publication" fp_cycle
    , MkPair String Bool "second-fix-is-no-op" (fp_fixed "def value : Nat := let unused := 0 in 1;;\n")
    , MkPair String Bool "format-only-is-stable" (fp_fixed "def value:Nat:=1;\n")
    , MkPair String Bool "fix-fmt-order-commutes" (fp_format_commutes "def value:Nat:=let unused := 0 in 1;;\n")
    , MkPair String Bool "retained-comments-remain-stable" (fp_fixed "def value : Nat := let unused := 0 in -- policy\n  1;\n")
    ];

def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True fp_laws;
       println (prim_string_concat("FIX_PRECISION: ", match ok with | True => "OK" | False => "FAIL" end));
       exit (match ok with | True => 0 | False => 1 end)
