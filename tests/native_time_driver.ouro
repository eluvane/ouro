-- Shared exports retain the ordinary source driver and the explicit MIR tests.
import "native_managed_source_driver.ouro",
  "native_time_fixtures.ouro";

-- The complete current raw runtime exceeds the global 4096 MIR-node default.
-- Keep source checking and raw lowering intact with the existing test limit.
def native_time_fixture_runtime (root : List Nat) (files : List (Pair (List Nat) (List Nat)))
    : Either NativeSourceError NativeManagedRuntime :=
    managed_fixture_runtime_with_limits managed_source_driver_limits root files;
