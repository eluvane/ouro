import "../std/fs_bounded.ouro", "../std/fs.ouro";

def bounded_calls_expect (ok : Bool) : IO Unit :=
    match ok with | True => io_pure(Unit, MkUnit) | False => exit 99 end;

def bounded_calls_bytes (bytes : List Nat) (result : Either FsBoundedReadError String) : Bool :=
    match result with | Left _ => False | Right body => str_eq body (str_of_codes bytes) end;

def bounded_calls_invalid (result : Either FsBoundedReadError String) : Bool :=
    match result with
    | Right _ => False
    | Left error => if let FsBoundedReadInvalidPath := error then True else False
    end;

def bounded_calls_utf8 (result : Either FsBoundedReadError String) : Bool :=
    match result with
    | Right _ => False
    | Left error => if let FsBoundedReadOsError phase status := error then
        andb(str_eq phase "path conversion", eq_nat status 1113)
      else False
    end;

def bounded_calls_too_large (result : Either FsBoundedReadError String) : Bool :=
    match result with
    | Right _ => False
    | Left error => if let FsBoundedReadTooLarge cap size := error then
        andb(eq_nat cap 2, eq_nat size 3)
      else False
    end;

def bounded_calls_run (mode : String) (path : String) : IO Unit :=
    let binary : List Nat := [65,0,255,128,10,13,90] in
    let replacement : List Nat := [85,0,254] in
    match str_eq mode "nul" with
    | True => do let! result := fs_read_bounded_checked 3 (str_concat path (str_of_codes ([0,66] : List Nat)));
                 bounded_calls_expect (bounded_calls_invalid result)
    | False => match str_eq mode "utf8" with
      | True => do let! result := fs_read_bounded_checked 3 (str_of_codes ([195,40] : List Nat));
                   bounded_calls_expect (bounded_calls_utf8 result)
      | False => match str_eq mode "deferred" with
        | True => let action : IO (Either FsBoundedReadError String) := fs_read_bounded_checked 7 path in
                  do fs_write path (str_of_codes binary);
                     let! result := action;
                     bounded_calls_expect (bounded_calls_bytes binary result);
                     print (str_of_codes binary)
        | False => match str_eq mode "reuse" with
          | True => let action : IO (Either FsBoundedReadError String) := fs_read_bounded_checked 7 path in
                    do let! first := action;
                       bounded_calls_expect (bounded_calls_bytes ([102,105,114,115,116] : List Nat) first);
                       fs_write path (str_of_codes binary);
                       let! second := action;
                       bounded_calls_expect (bounded_calls_bytes binary second);
                       print (str_of_codes binary)
          | False => match str_eq mode "recovery" with
            | True => do let! refused := fs_read_bounded_checked 2 path;
                         bounded_calls_expect (bounded_calls_too_large refused);
                         fs_write path (str_of_codes replacement);
                         let! accepted := fs_read_bounded_checked 3 path;
                         bounded_calls_expect (bounded_calls_bytes replacement accepted);
                         print (str_of_codes replacement)
            | False => exit 99
            end
          end
        end
      end
    end;

-- @entry main
def main : IO Unit :=
    do let! args := argv;
       match args with
       | Nil => exit 99
       | Cons _ rest => match rest with
         | Nil => exit 99
         | Cons mode tail => match tail with
           | Nil => exit 99
           | Cons path extra => match extra with
             | Nil => bounded_calls_run mode path
             | Cons _ _ => exit 99
             end
           end
         end
       end;
