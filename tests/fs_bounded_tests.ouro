import "analyze/precision/assertions.ouro", "../std/fs_bounded_model.ouro";
import "compiler_wide_nat_fixtures.ouro";

def fs_bounded_test_length (expected : Nat) (result : Either FsBoundedReadError Nat) : Bool :=
    match result with | Left _ => False | Right actual => eq_nat expected actual end;

def fs_bounded_test_too_large (cap : Nat) (size : Nat) : Bool :=
    match fs_bounded_read_length cap size with
    | Right _ => False
    | Left error => if let FsBoundedReadTooLarge actual_cap actual_size := (error : FsBoundedReadError) then
        andb(eq_nat cap actual_cap, eq_nat size actual_size)
      else False
    end;

def fs_bounded_test_path_error (expected : String) (path : String) (capacity : Nat) : Bool :=
    match fs_bounded_read_path_length path capacity with
    | Right _ => False | Left error => str_eq expected (fs_bounded_read_error_code error) end;

def fs_bounded_tests : List (Pair String Bool) :=
    [ MkPair String Bool "fs-bounded/empty-with-zero-cap" (fs_bounded_test_length(0, fs_bounded_read_length 0 0))
    , MkPair String Bool "fs-bounded/nonempty-with-zero-cap" (fs_bounded_test_too_large 0 1)
    , MkPair String Bool "fs-bounded/exact-cap" (fs_bounded_test_length(3, fs_bounded_read_length 3 3))
    , MkPair String Bool "fs-bounded/cap-plus-one" (fs_bounded_test_too_large 3 4)
    , MkPair String Bool "fs-bounded/cap-above-usize" (fs_bounded_test_length(3, fs_bounded_read_length compiler_test_wide_nat_base 3))
    , MkPair String Bool "fs-bounded/large-error-not-truncated" (fs_bounded_test_too_large
        compiler_test_wide_nat_base (S compiler_test_wide_nat_base))
    , MkPair String Bool "fs-bounded/empty-path" (fs_bounded_test_path_error "fs_bounded_read_invalid_path" "" 8)
    , MkPair String Bool "fs-bounded/nul-path" (fs_bounded_test_path_error "fs_bounded_read_invalid_path"
        (str_of_codes ([65,0,66] : List Nat)) 8)
    , MkPair String Bool "fs-bounded/path-capacity" (fs_bounded_test_length(3, fs_bounded_read_path_length "abc" 3))
    , MkPair String Bool "fs-bounded/path-too-long" (fs_bounded_test_path_error "fs_bounded_read_path_too_long" "abcd" 3)
    ];

def main : IO Unit := precision_run "fs-bounded" fs_bounded_tests;
