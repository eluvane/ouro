-- Typed MIR regression inputs. Every function body is selected and encoded by
-- Ouro codegen; the host only writes the resulting PE and starts the process.
import "native_mir_fixtures.ouro";
import "../std/string.ouro";

def tail_return (id : Nat) : MirTerminator := MirReturn (Just MirValue (MirUse id));

def tail_named_function (id : Nat) (args : List MirLocal) (locals : List MirLocal)
    (result : Maybe MirType) (blocks : List MirBlock) : MirFunction :=
    MirFunctionDef id ([116, 97, 105, 108] : List Nat) args locals result 0 blocks;

def tail_program (ty : MirType) (worker : MirFunction) (callees : List MirFunction)
    (arguments : List MirValue) (expected : MirValue) : MirProgram :=
    MirProgramDef (Cons MirFunction
      (mir_fixture_assert_function ([MirLocalDef 10 ty] : List MirLocal)
        (mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 10) (MirDirect 2) arguments) 10 expected))
      (Cons MirFunction worker callees)) ([] : List MirData)
      ([mir_fixture_kernel ([] : List MirExtern)] : List MirLibrary) 1;

def tail_capture : MirExtern := MirExternDef MirNoGc 1001
    ([82, 116, 108, 67, 97, 112, 116, 117, 114, 101, 67, 111, 110, 116, 101, 120, 116] : List Nat)
    (MirSignatureOf ([MirRawPtr] : List MirType) mir_fixture_void);

-- AMD64 CONTEXT is 1232 bytes, 16-byte aligned; Rsp is at byte 152.
-- Both calls enter the same Windows routine. Their saved stack pointers must
-- differ by at most 1024 bytes despite one million recursive tail transfers.
def tail_context_bytes : List Nat := pe_zeros (add (mul 4 256) 208);

def tail_million : MirValue := mir_fixture_u32 (X64Bytes32 64 66 15 0);

def tail_recursive (indirect : Bool) : MirProgram :=
    let recurse : List MirInstruction := append MirInstruction
      ([MirBinaryOp 21 MirSub (MirUse 20) (mir_fixture_nat MirU32 1)] : List MirInstruction)
      (match indirect with
        | False => [MirCall MirMayGc (Just Nat 23) (MirDirect 2) ([MirUse 21] : List MirValue)]
        | True => [MirAddress 24 2, MirCall MirMayGc (Just Nat 23)
            (MirIndirect (MirSignatureOf ([MirU32] : List MirType) (Just MirType MirU32)) (MirUse 24))
            ([MirUse 21] : List MirValue)] end) in
    MirProgramDef ([
      mir_fixture_assert_function
        ([MirLocalDef 10 MirU32, MirLocalDef 11 MirRawPtr, MirLocalDef 12 MirRawPtr,
          MirLocalDef 13 MirUSize, MirLocalDef 14 MirUSize, MirLocalDef 15 MirUSize] : List MirLocal)
        (managed_fixture_join ([
          ([MirAddress 11 300, MirCall MirMayGc mir_fixture_no_dest (MirDirect 1001) ([MirUse 11] : List MirValue)]
            : List MirInstruction),
          mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 10) (MirDirect 2) ([tail_million] : List MirValue)) 10
            (mir_fixture_nat MirU32 42),
          ([MirAddress 12 301, MirLoad 13 (MirUse 11) (codegen_disp 152), MirLoad 14 (MirUse 12) (codegen_disp 152),
            MirBinaryOp 15 MirSub (MirUse 13) (MirUse 14)] : List MirInstruction),
          mir_fixture_assert_ops (MirCompare 90 MirLessEqual (MirUse 15) (mir_fixture_nat MirUSize 1024)) 90
            (mir_fixture_nat MirU8 1)] : List (List MirInstruction))),
      tail_named_function 2 ([MirLocalDef 20 MirU32] : List MirLocal)
        ([MirLocalDef 21 MirU32, MirLocalDef 22 MirU8, MirLocalDef 23 MirU32, MirLocalDef 24 MirRawPtr] : List MirLocal)
        (Just MirType MirU32)
        ([MirBlockDef 0 ([MirCompare 22 MirEqual (MirUse 20) (mir_fixture_nat MirU32 0)] : List MirInstruction)
            (MirBranch (MirUse 22) 1 2),
          MirBlockDef 1 ([MirAddress 24 301,
            MirCall MirMayGc mir_fixture_no_dest (MirDirect 1001) ([MirUse 24] : List MirValue)] : List MirInstruction)
            (MirReturn (Just MirValue (mir_fixture_nat MirU32 42))),
          MirBlockDef 2 recurse (tail_return 23)] : List MirBlock)] : List MirFunction)
      ([MirDataDef 300 True tail_context_bytes, MirDataDef 301 True tail_context_bytes] : List MirData)
      ([mir_fixture_kernel ([tail_capture] : List MirExtern)] : List MirLibrary) 1;

def tail_four_args : List MirLocal :=
    [MirLocalDef 0 MirU32, MirLocalDef 1 MirU32, MirLocalDef 2 MirU32, MirLocalDef 3 MirU32];

def tail_four_values : List MirValue :=
    [mir_fixture_nat MirU32 1, mir_fixture_nat MirU32 2, mir_fixture_nat MirU32 3, mir_fixture_nat MirU32 4];

def tail_weighted : MirFunction := tail_named_function 3 tail_four_args
    ([MirLocalDef 30 MirU32, MirLocalDef 31 MirU32] : List MirLocal) (Just MirType MirU32)
    ([MirBlockDef 0 ([MirBinaryOp 30 MirMul (MirUse 0) (mir_fixture_nat MirU32 1000),
        MirBinaryOp 31 MirMul (MirUse 1) (mir_fixture_nat MirU32 100), MirBinaryOp 30 MirAdd (MirUse 30) (MirUse 31),
        MirBinaryOp 31 MirMul (MirUse 2) (mir_fixture_nat MirU32 10), MirBinaryOp 30 MirAdd (MirUse 30) (MirUse 31),
        MirBinaryOp 30 MirAdd (MirUse 30) (MirUse 3)] : List MirInstruction) (tail_return 30)] : List MirBlock);

def tail_shuffle (indirect : Bool) : MirProgram :=
    let instructions : List MirInstruction := match indirect with
      | False => [MirCall MirMayGc (Just Nat 10) (MirDirect 3) ([MirUse 3, MirUse 2, MirUse 0, MirUse 1] : List MirValue)]
      | True => [MirAddress 4 3, MirCall MirMayGc (Just Nat 10)
          (MirIndirect (MirSignatureOf ([MirU32, MirU32, MirU32, MirU32] : List MirType) (Just MirType MirU32)) (MirUse 4))
          ([MirUse 3, MirUse 2, MirUse 0, MirUse 1] : List MirValue)] end in
    tail_program MirU32 (tail_named_function 2 tail_four_args
      ([MirLocalDef 10 MirU32, MirLocalDef 4 MirRawPtr] : List MirLocal) (Just MirType MirU32)
      ([MirBlockDef 0 instructions (tail_return 10)] : List MirBlock))
      ([tail_weighted] : List MirFunction) tail_four_values (mir_fixture_u32 (X64Bytes32 216 16 0 0));

def tail_identity (ty : MirType) : MirFunction := tail_named_function 3 ([MirLocalDef 0 ty] : List MirLocal)
    ([] : List MirLocal) (Just MirType ty) ([MirBlockDef 0 ([] : List MirInstruction) (tail_return 0)] : List MirBlock);

def tail_aliases (ty : MirType) (join : Bool) (value : MirValue) : MirProgram :=
    let blocks : List MirBlock := match join with
      | True => [MirBlockDef 0 ([MirCall MirMayGc (Just Nat 1) (MirDirect 3) ([MirUse 0] : List MirValue),
            MirMove 2 (MirUse 1)] : List MirInstruction) (MirJump 1),
          MirBlockDef 1 ([MirMove 3 (MirUse 2)] : List MirInstruction) (tail_return 3)]
      | False => [MirBlockDef 0 ([MirCall MirMayGc (Just Nat 1) (MirDirect 3) ([MirUse 0] : List MirValue),
          MirMove 1 (MirUse 1)] : List MirInstruction) (tail_return 1)] end in
    tail_program ty (tail_named_function 2 ([MirLocalDef 0 ty] : List MirLocal)
      ([MirLocalDef 1 ty, MirLocalDef 2 ty, MirLocalDef 3 ty] : List MirLocal) (Just MirType ty) blocks)
      ([tail_identity ty] : List MirFunction) ([value] : List MirValue) value;

def tail_five_args : List MirLocal := append MirLocal tail_four_args ([MirLocalDef 4 MirU32] : List MirLocal);

def tail_five : MirProgram := tail_program MirU32
    (tail_named_function 2 tail_five_args ([MirLocalDef 10 MirU32] : List MirLocal) (Just MirType MirU32)
      ([MirBlockDef 0 ([MirCall MirMayGc (Just Nat 10) (MirDirect 3)
        ([MirUse 4, MirUse 3, MirUse 2, MirUse 1, MirUse 0] : List MirValue)] : List MirInstruction) (tail_return 10)] : List MirBlock))
    ([tail_named_function 3 tail_five_args ([MirLocalDef 10 MirU32] : List MirLocal) (Just MirType MirU32)
      ([MirBlockDef 0 ([MirBinaryOp 10 MirAdd (MirUse 0) (MirUse 1), MirBinaryOp 10 MirAdd (MirUse 10) (MirUse 2),
        MirBinaryOp 10 MirAdd (MirUse 10) (MirUse 3), MirBinaryOp 10 MirAdd (MirUse 10) (MirUse 4)] : List MirInstruction)
        (tail_return 10)] : List MirBlock)] : List MirFunction)
    (append MirValue tail_four_values ([mir_fixture_nat MirU32 5] : List MirValue)) (mir_fixture_nat MirU32 15);

def tail_constant : MirFunction := tail_named_function 3 ([] : List MirLocal) ([] : List MirLocal)
    (Just MirType MirU32) ([MirBlockDef 0 ([] : List MirInstruction)
      (MirReturn (Just MirValue (mir_fixture_nat MirU32 42)))] : List MirBlock);

def tail_effect : MirProgram := MirProgramDef ([
    mir_fixture_assert_function ([MirLocalDef 10 MirU32, MirLocalDef 11 MirRawPtr, MirLocalDef 12 MirU32] : List MirLocal)
      (managed_fixture_join ([
        mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 10) (MirDirect 2) ([] : List MirValue)) 10 (mir_fixture_nat MirU32 42),
        ([MirAddress 11 300] : List MirInstruction),
        mir_fixture_assert_ops (MirLoad 12 (MirUse 11) (codegen_disp 0)) 12 (mir_fixture_nat MirU32 77)] : List (List MirInstruction))),
    tail_named_function 2 ([] : List MirLocal) ([MirLocalDef 0 MirU32, MirLocalDef 1 MirRawPtr] : List MirLocal)
      (Just MirType MirU32) ([MirBlockDef 0 ([MirAddress 1 300,
        MirCall MirMayGc (Just Nat 0) (MirDirect 3) ([] : List MirValue),
        MirStore (MirUse 1) (codegen_disp 0) (mir_fixture_nat MirU32 77)] : List MirInstruction) (tail_return 0)] : List MirBlock),
    tail_constant] : List MirFunction) ([MirDataDef 300 True (pe_zeros 8)] : List MirData)
    ([mir_fixture_kernel ([] : List MirExtern)] : List MirLibrary) 1;

def tail_fixture_names : List String :=
    ["million_direct", "million_indirect", "shuffle_direct", "shuffle_indirect", "u8_join", "u32_max", "five_args", "post_store"];

def tail_fixture_named (name : String) : Maybe MirProgram :=
    match prim_string_eq name "million_direct" with | True => Just MirProgram (tail_recursive False) | False =>
    match prim_string_eq name "million_indirect" with | True => Just MirProgram (tail_recursive True) | False =>
    match prim_string_eq name "shuffle_direct" with | True => Just MirProgram (tail_shuffle False) | False =>
    match prim_string_eq name "shuffle_indirect" with | True => Just MirProgram (tail_shuffle True) | False =>
    match prim_string_eq name "u8_join" with | True => Just MirProgram (tail_aliases MirU8 True (mir_fixture_nat MirU8 255)) | False =>
    match prim_string_eq name "u32_max" with | True => Just MirProgram
      (tail_aliases MirU32 False (mir_fixture_u32 (X64Bytes32 255 255 255 255))) | False =>
    match prim_string_eq name "five_args" with | True => Just MirProgram tail_five | False =>
    match prim_string_eq name "post_store" with | True => Just MirProgram tail_effect | False => Nothing MirProgram
    end end end end end end end end;
