-- @entry main
import "quality_test_support.ouro",
  "../tools/fix/proof.ouro",
  "../std/io.ouro";

def quality_fix_import_applies (src : String) (expected : String) : Bool :=
    match fx_checked_plan src (fx_simple_rules(src, fx_lex src)) with
    | Left _ => False
    | Right edits => match fx_certify_transaction src edits with
      | Left _ => False
      | Right proof => andb (str_eq(fx_transaction_output proof, expected))
          (eq_nat(length(FxEdit, fx_transaction_edits proof), 1))
      end
    end;

def quality_fix_import_refused (src : String) : Bool :=
    match fx_checked_plan src (fx_simple_rules(src, fx_lex src)) with
    | Left _ => False
    | Right edits => andb (notb (nullb FxEdit edits))
        (match fx_certify_transaction src edits with
         | Right _ => False
         | Left error => if let FxPlanNoSyntaxProof := (error : FxPlanError) then True else False
         end)
    end;

def quality_fix_empty_transaction (src : String) : Bool :=
    match fx_certify_transaction src [] with
    | Left _ => False
    | Right proof => andb (fx_transaction_matches src proof)
        (andb (str_eq src (fx_transaction_output proof))
          (nullb FxEdit (fx_transaction_edits proof)))
    end;

def quality_fix_regression_laws : List (Pair String Bool) :=
    let pending : String := "import \"x.ouro\";\nimport \"x.ouro\";\n" in
    [ MkPair String Bool "empty-transaction-preserves-empty-source"
        (quality_fix_empty_transaction "")
    , MkPair String Bool "empty-transaction-preserves-source-bytes"
        (quality_fix_empty_transaction "-- comment\r\ndef value : Nat := 0;\r\n")
    , MkPair String Bool "empty-transaction-preserves-pending-syntax"
        (andb (notb (nullb FxCertifiedEdit (fx_syntax_certificates pending (fx_lex pending))))
          (quality_fix_empty_transaction pending))
    , MkPair String Bool "mixed-syntax-certificates-retain-source-order"
        (let src : String := str_concat pending "def use : Nat := do value <- step; value;;\n" in
          list_eq String str_eq
            (map FxCertifiedEdit String
              (fun (certificate : FxCertifiedEdit) => fx_edit_rule (fx_certified_edit certificate))
              (fx_syntax_certificates src (fx_lex src)))
            ["dup-import", "do-bind", "double-semi"])
    , MkPair String Bool "plain-duplicate-import-retains-proof" (quality_fix_import_applies
        pending "import \"x.ouro\";\n")
    , MkPair String Bool "aliased-duplicate-import-retains-proof" (quality_fix_import_applies
        "import \"x.ouro\" as Alias;\nimport \"x.ouro\" as Alias;\n"
        "import \"x.ouro\" as Alias;\n")
    , MkPair String Bool "raw-path-duplicate-import-retains-proof" (quality_fix_import_applies
        "import r#\"x.ouro\"#;\nimport r#\"x.ouro\"#;\n"
        "import r#\"x.ouro\"#;\n")
    , MkPair String Bool "prime-alias-duplicate-import-retains-proof" (quality_fix_import_applies
        "import \"x.ouro\" as Alias';\nimport \"x.ouro\" as Alias';\n"
        "import \"x.ouro\" as Alias';\n")
    , MkPair String Bool "missing-as-clause-has-no-proof" (quality_fix_import_refused
        "import \"x.ouro\" as Alias;\nimport \"x.ouro\" Alias;\n")
    , MkPair String Bool "missing-alias-has-no-proof" (quality_fix_import_refused
        "import \"x.ouro\";\nimport \"x.ouro\" as;\n")
    , MkPair String Bool "repeated-as-clause-has-no-proof" (quality_fix_import_refused
        "import \"x.ouro\" as Alias;\nimport \"x.ouro\" as as Alias;\n")
    , MkPair String Bool "as-is-not-an-alias-proof" (quality_fix_import_refused
        "import \"x.ouro\";\nimport \"x.ouro\" as as;\n")
    , MkPair String Bool "malformed-first-import-cannot-anchor-proof" (quality_fix_import_refused
        "import \"x.ouro\" Alias;\nimport \"x.ouro\" as Alias;\n")
    ];

def main : IO Unit :=
    do let! ok := io_fold (Pair String Bool) Bool quality_test_print True quality_fix_regression_laws;
       exit (match ok with | True => 0 | False => 1 end)
