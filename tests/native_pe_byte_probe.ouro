-- Typed raw-input parity probes; every result includes the complete input.
import "../compiler/native/pe.ouro";

inductive PeByteCase : Type :=
  | PeByteInput : Nat -> List Nat -> PeByteCase;
inductive PeByteInputCase : Type :=
  | PeByteInputParts : Nat -> List Nat -> List Nat -> List Nat -> PeByteInputCase;
inductive PeByteSerializeCase : Type :=
  | PeByteSerializeParts : Nat -> PeLayout -> Nat -> PeImportTable -> List PeFunctionAddress -> PeByteSerializeCase;
inductive PeByteCompleteCase : Type :=
  | PeByteCompleteParts : Nat -> PeLayout -> Nat -> PeImportTable -> List PeFunctionInfo -> List Nat -> PeByteCompleteCase;

def pe_byte_probe_section (kind : PeSection) (bytes : List Nat) : PePlacedSection :=
    PeSectionAt kind (mul(S (pe_section_code kind), pe_section_alignment))
      (add(pe_header_size, mul(pe_section_code kind, pe_file_alignment))) pe_file_alignment bytes;

def pe_byte_probe_layout (sections : List PePlacedSection) : PeLayout :=
    PeLayoutAt(mul 9 pe_section_alignment, add(pe_header_size, mul 8 pe_file_alignment), sections);

def pe_byte_probe_imports : PeImportTable := PeImportTableData [] [] 0 0 0;

def pe_byte_cases_small : List PeByteCase :=
  [
    PeByteInput 1 [],
    PeByteInput 2 [0],
    PeByteInput 3 [255],
    PeByteInput 4 [0, 1, 127, 128, 254, 255],
    PeByteInput 5 [256],
    PeByteInput 6 [257, 256],
    PeByteInput 7 [0, 256, 257],
    PeByteInput 8 [255, 255, 256]
  ];

def pe_byte_probe_small
    (call : List Nat -> Either PeError (List Nat)) : List (Pair PeByteCase (Either PeError (List Nat))) :=
    map PeByteCase (Pair(PeByteCase, Either(PeError, List Nat)))
      (fun (input : PeByteCase) => MkPair PeByteCase (Either(PeError, List Nat)) input
        (match input with | PeByteInput _ bytes => call bytes end)) pe_byte_cases_small;

def pe_byte_cases_boundary : List PeByteCase :=
  [
    PeByteInput(9, pe_zeros (sub pe_header_size 1)),
    PeByteInput(10, pe_zeros pe_header_size),
    PeByteInput(11, pe_zeros (S pe_header_size)),
    PeByteInput(12, pe_zeros (sub(mul 2 pe_header_size, 1))),
    PeByteInput(13, pe_zeros (mul 2 pe_header_size)),
    PeByteInput(14, pe_zeros (S (mul 2 pe_header_size))),
    PeByteInput(15, append Nat (pe_zeros pe_header_size) [255]),
    PeByteInput(16, append Nat [255] (pe_zeros (mul 2 pe_header_size)))
  ];

def pe_byte_probe_boundary
    (call : List Nat -> Either PeError (List Nat)) : List (Pair PeByteCase (Either PeError (List Nat))) :=
    map PeByteCase (Pair(PeByteCase, Either(PeError, List Nat)))
      (fun (input : PeByteCase) => MkPair PeByteCase (Either(PeError, List Nat)) input
        (match input with | PeByteInput _ bytes => call bytes end)) pe_byte_cases_boundary;

def pe_byte_cases_invalid : List PeByteCase :=
  [
    PeByteInput(17, append Nat (pe_zeros 0) [256, 257]),
    PeByteInput(18, append Nat (pe_zeros (sub pe_header_size 1)) [256, 257]),
    PeByteInput(19, append Nat (pe_zeros pe_header_size) [256, 257]),
    PeByteInput(20, append Nat (pe_zeros (S pe_header_size)) [256, 257]),
    PeByteInput(21, append Nat (pe_zeros (sub(mul 2 pe_header_size, 1))) [256, 257]),
    PeByteInput(22, append Nat (pe_zeros (mul 2 pe_header_size)) [256, 257]),
    PeByteInput(23, append Nat (append Nat (pe_zeros (sub pe_header_size 1)) [257]) [256]),
    PeByteInput(24, append(Nat, append Nat (pe_zeros pe_header_size) [257], append Nat (pe_zeros pe_header_size) [256]))
  ];

def pe_byte_probe_invalid
    (call : List Nat -> Either PeError (List Nat)) : List (Pair PeByteCase (Either PeError (List Nat))) :=
    map PeByteCase (Pair(PeByteCase, Either(PeError, List Nat)))
      (fun (input : PeByteCase) => MkPair PeByteCase (Either(PeError, List Nat)) input
        (match input with | PeByteInput _ bytes => call bytes end)) pe_byte_cases_invalid;

def pe_byte_cases_input : List PeByteInputCase :=
  [
    PeByteInputParts 25 [] [] [],
    PeByteInputParts 26 [] [256] [257],
    PeByteInputParts 27 [0] [] [],
    PeByteInputParts 28 [255] [0, 255] [128],
    PeByteInputParts 29 [256] [257] [258],
    PeByteInputParts 30 [0] [257] [258],
    PeByteInputParts 31 [0] [1] [258],
    PeByteInputParts(32, pe_zeros pe_header_size, pe_zeros pe_header_size, pe_zeros pe_header_size),
    PeByteInputParts 33 (append Nat (pe_zeros pe_header_size) [256]) [257] [258],
    PeByteInputParts 34 [0] (append Nat (pe_zeros pe_header_size) [257]) [258],
    PeByteInputParts 35 [0] [1] (append Nat (pe_zeros pe_header_size) [258]),
    PeByteInputParts 36 (append Nat (pe_zeros pe_header_size) [255]) [] [255]
  ];

def pe_byte_probe_input
    (call : List Nat -> List Nat -> List Nat -> Either PeError Unit) : List (Pair PeByteInputCase (Either PeError Unit)) :=
    map PeByteInputCase (Pair(PeByteInputCase, Either PeError Unit))
      (fun (input : PeByteInputCase) => MkPair PeByteInputCase (Either PeError Unit) input
        (match input with | PeByteInputParts _ text read_only writable => call text read_only writable end)) pe_byte_cases_input;

def pe_byte_cases_serialize : List PeByteSerializeCase :=
  [
    PeByteSerializeParts 37 (pe_byte_probe_layout []) 0 pe_byte_probe_imports [],
    PeByteSerializeParts 38 (pe_byte_probe_layout [(pe_byte_probe_section PeText [256])]) 0 pe_byte_probe_imports [],
    PeByteSerializeParts 39 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 40 (pe_byte_probe_layout [(pe_byte_probe_section PeText [256]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 41 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly [257]), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 42 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable [258]), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 43 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [259]), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 44 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions [260]), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 45 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData [261]), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 46 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap [262]), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 47 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [263])]) pe_section_alignment pe_byte_probe_imports [],
    PeByteSerializeParts 48 (pe_byte_probe_layout [(pe_byte_probe_section PeText [256]), (pe_byte_probe_section PeReadOnly [257]), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) 0 pe_byte_probe_imports [],
    PeByteSerializeParts 49 (pe_byte_probe_layout [(pe_byte_probe_section(PeText, append Nat (pe_zeros pe_header_size) [255])), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions []), (pe_byte_probe_section PeUnwindData []), (pe_byte_probe_section PeFunctionMap []), (pe_byte_probe_section PeRelocations [])]) pe_section_alignment pe_byte_probe_imports [PeFunctionAt 1 pe_section_alignment (S pe_section_alignment) [65]]
  ];

def pe_byte_probe_serialize
    (call : PeLayout -> Nat -> PeImportTable -> List PeFunctionAddress -> Either PeError PeImage) : List (Pair PeByteSerializeCase (Either PeError PeImage)) :=
    map PeByteSerializeCase (Pair(PeByteSerializeCase, Either PeError PeImage))
      (fun (input : PeByteSerializeCase) => MkPair PeByteSerializeCase (Either PeError PeImage) input
        (match input with | PeByteSerializeParts _ layout entry imports addresses => call layout entry imports addresses end)) pe_byte_cases_serialize;

def pe_byte_cases_complete : List PeByteCompleteCase :=
  [
    PeByteCompleteParts 50 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [])]) pe_section_alignment pe_byte_probe_imports [] [],
    PeByteCompleteParts 51 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [])]) pe_section_alignment pe_byte_probe_imports [(PeFunctionInfoData 1 pe_section_alignment (S pe_section_alignment) [65] [1, 0, 0, 0])] [],
    PeByteCompleteParts 52 (pe_byte_probe_layout []) 0 pe_byte_probe_imports [] [],
    PeByteCompleteParts 53 (pe_byte_probe_layout [(pe_byte_probe_section PeText [256])]) 0 pe_byte_probe_imports [] [],
    PeByteCompleteParts 54 (pe_byte_probe_layout [(pe_byte_probe_section PeText [256]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [])]) 0 pe_byte_probe_imports [] [],
    PeByteCompleteParts 55 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [])]) 0 pe_byte_probe_imports [] [256],
    PeByteCompleteParts 56 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports []), (pe_byte_probe_section PeExceptions [])]) 0 pe_byte_probe_imports [] [],
    PeByteCompleteParts 57 (PeLayoutAt pe_max_rva pe_header_size [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [])]) 0 pe_byte_probe_imports [(PeFunctionInfoData 1 pe_section_alignment (S pe_section_alignment) [65] [1, 0, 0, 0])] [],
    PeByteCompleteParts 58 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [])]) 0 pe_byte_probe_imports [PeFunctionInfoData 1 pe_section_alignment (S pe_section_alignment) [256] [1, 0, 0, 0]] [],
    PeByteCompleteParts 59 (pe_byte_probe_layout [(pe_byte_probe_section PeText [195]), (pe_byte_probe_section PeReadOnly []), (pe_byte_probe_section PeWritable []), (pe_byte_probe_section PeImports [])]) 0 pe_byte_probe_imports [PeFunctionInfoData 1 pe_section_alignment (S pe_section_alignment) [65] [257]] [258]
  ];

def pe_byte_probe_complete
    (call : PeLayout -> Nat -> PeImportTable -> List PeFunctionInfo -> List Nat -> Either PeError PeImage) : List (Pair PeByteCompleteCase (Either PeError PeImage)) :=
    map PeByteCompleteCase (Pair(PeByteCompleteCase, Either PeError PeImage))
      (fun (input : PeByteCompleteCase) => MkPair PeByteCompleteCase (Either PeError PeImage) input
        (match input with | PeByteCompleteParts _ layout entry imports functions relocations => call layout entry imports functions relocations end)) pe_byte_cases_complete;
