import "compiler_property_scoped.ouro";

def property_typed : Nat -> List CoreTerm -> PropertyGoal -> Nat -> CoreTerm :=
  fix generate (fuel : Nat) (context : List CoreTerm) (goal : PropertyGoal) (seed : Nat) : CoreTerm :=
    match fuel with
    | Z => property_typed_leaf goal seed context
    | S next =>
        let subterm (scope : List CoreTerm) (target : PropertyGoal) (salt : Nat) : CoreTerm :=
            generate next scope target (property_seed seed salt) in
        let nat_scope : List CoreTerm := Cons CoreTerm property_nat context in
        let bool_scope : List CoreTerm := Cons CoreTerm property_bool context in
        match goal with
        | PropertyNat => match property_choice seed 8 with
            | Z => property_typed_leaf goal seed context
            | S first => match first with
                | Z => CApp(property_succ, subterm context PropertyNat 1)
                | S second => match second with
                    | Z => CApp(subterm context PropertyFunction 2, subterm context PropertyNat 3)
                    | S third => match third with
                        | Z => match property_even (property_seed seed 4) with
                            | True => CLetIn (subterm context PropertyNat 5) property_nat
                                (subterm nat_scope PropertyNat 6)
                            | False => CLetIn (subterm context PropertyBool 5) property_bool
                                (subterm bool_scope PropertyNat 6)
                            end
                        | S fourth => match fourth with
                            | Z => CCase property_bool_case (CLam property_bool property_nat)
                                (subterm context PropertyBool 7)
                                ([subterm context PropertyNat 8, subterm context PropertyNat 9] : List CoreTerm)
                            | S fifth => match fifth with
                                | Z => CCase property_nat_case (CLam property_nat property_nat)
                                    (subterm context PropertyNat 10)
                                    ([subterm context PropertyNat 11,
                                      CLam(property_nat, subterm nat_scope PropertyNat 12)] : List CoreTerm)
                                | S sixth => match sixth with
                                    | Z => CApp (CLam(property_nat, subterm nat_scope PropertyNat 13))
                                        (subterm context PropertyNat 14)
                                    | S _ => CApp(CConst 30, subterm context PropertyNat 15)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        | PropertyBool => match property_choice seed 6 with
            | Z => property_typed_leaf goal seed context
            | S first => match first with
                | Z => CApp(CConst 32, subterm context PropertyBool 16)
                | S second => match second with
                    | Z => CLetIn (subterm context PropertyNat 17) property_nat
                        (subterm nat_scope PropertyBool 18)
                    | S third => match third with
                        | Z => CCase property_bool_case (CLam property_bool property_bool)
                            (subterm context PropertyBool 19)
                            ([subterm context PropertyBool 20, subterm context PropertyBool 21] : List CoreTerm)
                        | S fourth => match fourth with
                            | Z => CCase property_nat_case (CLam property_nat property_bool)
                                (subterm context PropertyNat 22)
                                ([subterm context PropertyBool 23,
                                  CLam(property_nat, subterm nat_scope PropertyBool 24)] : List CoreTerm)
                            | S _ => CApp (CLam(property_bool, subterm bool_scope PropertyBool 25))
                                (subterm context PropertyBool 26)
                            end
                        end
                    end
                end
            end
        | PropertyFunction => match property_choice seed 4 with
            | Z => property_typed_leaf goal seed context
            | S first => match first with
                | Z => CLam(property_nat, subterm nat_scope PropertyNat 27)
                | S second => match second with
                    | Z => CLam(property_nat, subterm nat_scope PropertyNat 28)
                    | S _ => CLetIn (subterm context PropertyNat 29) property_nat
                        (subterm nat_scope PropertyFunction 30)
                    end
                end
            end
        | PropertyType => match property_choice seed 3 with
            | Z => property_typed_leaf goal seed context
            | S _ => let domain : CoreTerm := subterm context PropertyType 31 in
                CPi(domain, subterm (Cons CoreTerm domain context) PropertyType 32)
            end
        end
    end;

-- Select a relative-variable occurrence in preorder. The recorded index is
-- exactly the first unbound index at that occurrence's explicit binder depth.
inductive PropertyMutation : Type :=
  | PropertyMutationOf : CoreTerm -> Maybe Nat -> PropertyMutation;

def property_mutation_map (rebuild : CoreTerm -> CoreTerm)
    (mutation : PropertyMutation) : PropertyMutation :=
    match mutation with | PropertyMutationOf term index => PropertyMutationOf(rebuild term, index) end;

def property_mutate : CoreTerm -> Nat -> Nat -> PropertyMutation :=
  fix mutate (term : CoreTerm) (depth : Nat) (target : Nat) : PropertyMutation :=
    match term with
    | CRel _ => match target with
        | Z => PropertyMutationOf(CRel depth, Just Nat depth)
        | S _ => PropertyMutationOf(term, Nothing Nat)
        end
    | CPi annotation body => let count : Nat := property_rel_count annotation in
        match ltNat target count with
        | True => property_mutation_map (fun (inner : CoreTerm) => CPi inner body)
            (mutate annotation depth target)
        | False => property_mutation_map (fun (inner : CoreTerm) => CPi annotation inner)
            (mutate(body, S depth, sub target count))
        end
    | CLam annotation body => let count : Nat := property_rel_count annotation in
        match ltNat target count with
        | True => property_mutation_map (fun (inner : CoreTerm) => CLam inner body)
            (mutate annotation depth target)
        | False => property_mutation_map (fun (inner : CoreTerm) => CLam annotation inner)
            (mutate(body, S depth, sub target count))
        end
    | CApp function argument => let count : Nat := property_rel_count function in
        match ltNat target count with
        | True => property_mutation_map (fun (inner : CoreTerm) => CApp inner argument)
            (mutate function depth target)
        | False => property_mutation_map (fun (inner : CoreTerm) => CApp function inner)
            (mutate argument depth (sub target count))
        end
    | CLetIn value annotation body => let count : Nat := property_rel_count value in
        match ltNat target count with
        | True => property_mutation_map (fun (inner : CoreTerm) => CLetIn inner annotation body)
            (mutate value depth target)
        | False => let rest : Nat := sub target count in
            let annotations : Nat := property_rel_count annotation in
            match ltNat rest annotations with
            | True => property_mutation_map (fun (inner : CoreTerm) => CLetIn value inner body)
                (mutate annotation depth rest)
            | False => property_mutation_map (fun (inner : CoreTerm) => CLetIn value annotation inner)
                (mutate(body, S depth, sub rest annotations))
            end
        end
    | CFix name argument arity annotation body => let count : Nat := property_rel_count annotation in
        match ltNat target count with
        | True => property_mutation_map (fun (inner : CoreTerm) => CFix name argument arity inner body)
            (mutate annotation depth target)
        | False => property_mutation_map (fun (inner : CoreTerm) => CFix name argument arity annotation inner)
            (mutate(body, S depth, sub target count))
        end
    | CCase info motive scrutinee branches =>
        let count : Nat := property_rel_count motive in
        match ltNat target count with
        | True => property_mutation_map (fun (inner : CoreTerm) => CCase info inner scrutinee branches)
            (mutate motive depth target)
        | False => let rest : Nat := sub target count in
            let scrutinees : Nat := property_rel_count scrutinee in
            match ltNat rest scrutinees with
            | True => property_mutation_map (fun (inner : CoreTerm) => CCase info motive inner branches)
                (mutate scrutinee depth rest)
            | False => match (fix walk (rest : List CoreTerm) (at : Nat)
                    : Pair (List CoreTerm) (Maybe Nat) :=
                  match rest with
                  | Nil => MkPair(List CoreTerm, Maybe Nat, [] : List CoreTerm, Nothing Nat)
                  | Cons branch tail => let count : Nat := property_rel_count branch in
                      match ltNat at count with
                      | True => match mutate branch depth at with
                          | PropertyMutationOf inner index =>
                              MkPair(List CoreTerm, Maybe Nat, Cons CoreTerm inner tail, index)
                          end
                      | False => match walk(tail, sub at count) with | MkPair more index =>
                          MkPair(List CoreTerm, Maybe Nat, Cons CoreTerm branch more, index) end
                      end
                  end) branches (sub rest scrutinees) with
                | MkPair changed_branches index => PropertyMutationOf(CCase info motive scrutinee changed_branches, index)
                end
            end
        end
    | CSort _ => PropertyMutationOf(term, Nothing Nat) | CConst _ => PropertyMutationOf(term, Nothing Nat)
    | CInd _ => PropertyMutationOf(term, Nothing Nat) | CConstruct _ _ _ => PropertyMutationOf(term, Nothing Nat)
    | CStrLit _ _ => PropertyMutationOf(term, Nothing Nat) | CStrBytes _ _ => PropertyMutationOf(term, Nothing Nat)
    end;

def property_typed_laws (entries : List Entry) (cold : List Entry)
    (goal : PropertyGoal) (term : CoreTerm) : Maybe String :=
    let expected : CoreTerm := property_goal_type goal in
    property_require (property_scope_valid term 0) "typed generator scope"
      (fun (_ : Unit) => property_from_check CoreTerm "infer"
        (infer_checked(property_fuel, entries, [] : List CoreTerm, IGTerm term))
      (fun (inferred : CoreTerm) => property_require (property_converts entries inferred expected) "inferred type"
      (fun (_ : Unit) => property_from_check Unit "check goal"
        (check_term_checked property_fuel entries ([] : List CoreTerm) term expected)
      (fun (_ : Unit) => property_from_check Unit "check inferred type"
        (check_term_checked property_fuel entries ([] : List CoreTerm) term inferred)
      (fun (_ : Unit) => property_from_normal "normalize" (normalize_checked property_fuel entries term)
      (fun (normal : CoreTerm) => property_from_normal "normalize normal form" (normalize_checked property_fuel entries normal)
      (fun (again : CoreTerm) => property_require (property_equal again normal) "normalization idempotence"
      (fun (_ : Unit) => property_require (property_converts entries term normal) "conversion to normal form"
      (fun (_ : Unit) => property_from_check Unit "check normal form"
        (check_term_checked property_fuel entries ([] : List CoreTerm) normal expected)
      (fun (_ : Unit) => property_from_normal "weak head" (whnf_checked property_fuel entries term)
      (fun (head : CoreTerm) => property_require (property_converts entries term head) "conversion to weak head"
      (fun (_ : Unit) => property_from_normal "cold normalize" (normalize_checked property_fuel cold term)
      (fun (fresh : CoreTerm) => property_require (property_equal fresh normal) "cold environment"
      (fun (_ : Unit) => property_from_normal "repeated normalize" (normalize_checked property_fuel entries term)
      (fun (repeated : CoreTerm) => property_require (property_equal repeated normal) "repeated normalization"
      (fun (_ : Unit) => Nothing String))))))))))))))));

def property_unbound_result (A : Type) (index : Nat) (result : CheckResult A) : Bool :=
    match result with
    | CheckOk _ => False
    | CheckErr failure => match failure with
        | CheckMalformedCore fault => match fault with
            | CheckUnboundVariable actual => eqNat index actual
            | CheckUnboundGlobal _ => False | CheckUnknownInductive _ => False
            | CheckUnknownConstructor _ _ => False | CheckConstructorParameters => False
            | CheckCaseMetadata => False | CheckFixMetadata => False | CheckLiteralType _ => False
            | CheckDuplicateName _ => False | CheckUnresolvedLiteral _ => False
            end
        | CheckTypeFailure _ => False | CheckReductionFailure _ => False | CheckResourceLimit => False
        | CheckUnsupported _ => False | CheckCancelled => False | CheckInternalFailure _ => False
        | CheckPrimitiveFailure _ => False
        end
    end;

def property_mutant_law (entries : List Entry) (expected : CoreTerm)
    (term : CoreTerm) (target : Nat) : Maybe String :=
    match property_mutate term 0 target with
    | PropertyMutationOf mutant selected => match selected with
        | Nothing => Just String "selected relative variable was not mutated"
        | Just index =>
            property_require (notb (property_scope_valid mutant 0)) "mutation remains in scope"
              (fun (_ : Unit) => property_require (notb (property_equal term mutant)) "mutation unchanged"
              (fun (_ : Unit) => property_require
                (eqNat(property_rel_count term, property_rel_count mutant)) "mutation changed relative-variable count"
              (fun (_ : Unit) => property_require
                (property_unbound_result CoreTerm index
                  (infer_checked(property_fuel, entries, [] : List CoreTerm, IGTerm mutant)))
                (str_cat3 "infer expected unbound-variable=" (str_of_nat index) "")
              (fun (_ : Unit) => property_require
                (property_unbound_result Unit index
                  (check_term_checked property_fuel entries ([] : List CoreTerm) mutant expected))
                (str_cat3 "check expected unbound-variable=" (str_of_nat index) "")
              (fun (_ : Unit) => Nothing String)))))
        end
    end;

inductive PropertyShape : Type :=
  | PropertyShapeOf : String -> CoreTerm -> CoreTerm -> PropertyShape;

def property_identity_type : CoreTerm := CPi(CSort 0, CPi(CRel 0, CRel 1));

-- Every relative-variable occurrence in these independently written typed
-- shapes is mutated. Random samples then select any occurrence by seed.
def property_scope_shapes : List PropertyShape :=
    [ PropertyShapeOf "pi domain and codomain" (CSort 1) property_identity_type
    , PropertyShapeOf "lambda annotation and body" property_identity_type
        (CLam(CSort 0, CLam(CRel 0, CRel 0)))
    , PropertyShapeOf "application function" (CPi property_function property_nat)
        (CLam(property_function, CApp(CRel 0, property_zero)))
    , PropertyShapeOf "application argument" property_function
        (CLam(property_nat, CApp(property_succ, CRel 0)))
    , PropertyShapeOf "let value and body" property_function
        (CLam(property_nat, CLetIn(CRel 0, property_nat, CRel 0)))
    , PropertyShapeOf "let annotation" property_identity_type
        (CLam(CSort 0, CLam(CRel 0, CLetIn(CRel 0, CRel 1, CRel 0))))
    , PropertyShapeOf "nested let original index" property_function
        (CLam property_nat (CLetIn (CRel 0) property_nat
          (CLetIn(CRel 0, property_nat, CRel 2))))
    , PropertyShapeOf "case motive and both branches" property_identity_type
        (CLam (CSort 0) (CLam (CRel 0)
          (CCase property_bool_case (CLam(property_bool, CRel 2)) property_false
            ([CRel 0, CRel 0] : List CoreTerm))))
    , PropertyShapeOf "case scrutinee" (CPi property_bool property_bool)
        (CLam property_bool (CCase property_bool_case (CLam property_bool property_bool)
          (CRel 0) ([property_true, property_false] : List CoreTerm)))
    , PropertyShapeOf "case branch lambda depth" property_function
        (CLam property_nat (CCase property_nat_case (CLam property_nat property_nat)
          (CRel 0) ([CRel 0, CLam(property_nat, CRel 0)] : List CoreTerm)))
    , PropertyShapeOf "fix body binder" property_function
        (CFix 70 0 1 property_function (CLam(property_nat, CRel 0)))
    , PropertyShapeOf "fix annotation under binder" property_identity_type
        (CLam (CSort 0) (CFix 70 0 1 (CPi(CRel 0, CRel 1))
          (CLam(CRel 1, CRel 0))))
    ];

def property_shape_laws (entries : List Entry) (expected : CoreTerm) (term : CoreTerm) : Maybe String :=
    property_from_check CoreTerm "shape infer"
      (infer_checked(property_fuel, entries, Nil CoreTerm, IGTerm term))
      (fun (inferred : CoreTerm) => property_require (property_converts entries inferred expected) "shape type"
      (fun (_ : Unit) => property_from_check Unit "shape check"
        (check_term_checked property_fuel entries (Nil CoreTerm) term expected)
      (fun (_ : Unit) => Nothing String)));

-- Buckets are Nat[leaf,0..7], Bool[leaf,0..5], Fn[leaf,0..3],
-- Type[leaf,0..2]. They record the actual generator's root choices.
def property_typed_bucket (goal : PropertyGoal) (fuel : Nat) (seed : Nat) : Nat :=
    let shape (width : Nat) : Nat := match fuel with
      | Z => 0 | S _ => S (property_choice seed width) end in
    match goal with
    | PropertyNat => shape 8 | PropertyBool => add(9, shape 6)
    | PropertyFunction => add(16, shape 4) | PropertyType => add(21, shape 3)
    end;

def property_count_bucket : Nat -> List Nat -> List Nat :=
  fix count (bucket : Nat) (values : List Nat) : List Nat :=
    match values with
    | Nil => match bucket with
        | Z => [1] | S next => Cons Nat 0 (count(next, Nil Nat)) end
    | Cons value rest => match bucket with
        | Z => Cons Nat (S value) rest | S next => Cons Nat value (count next rest) end
    end;
