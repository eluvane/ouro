-- Deterministic native CoreGenerator cases; replay identifies seed and bounds.
import "compiler_smith_relations.ouro";
import "compiler_smith_negative.ouro";

def smith_fail (seed : Nat) (name : String) (reason : String) : IO Unit :=
    do eprintln (str_cat4 "not ok compiler-smith seed=" (str_of_nat seed) " " (str_cat3 name " " reason)); exit 1

def smith_ok (seed : Nat) (name : String) : IO Unit :=
    println (str_cat4 "ok smith seed=" (str_of_nat seed) " " name);

def smith_assert (seed : Nat) (name : String) (result : Maybe String) : IO Unit :=
    match result with | Nothing => smith_ok seed name | Just reason => smith_fail seed name reason end;

def smith_run_domains (seed : Nat) (depth : Nat) (entries : List Entry) : Nat -> Nat -> IO Unit :=
  fix run (remaining : Nat) (family : Nat) : IO Unit :=
    match remaining with
    | Z => io_unit
    | S rest => do
        let witness : SmithWitness := smith_domain seed depth (property_seed seed family) family in
        smith_assert seed (str_concat "domain=" (str_of_nat family)) (smith_positive entries witness);
        run rest (S family)
    end;

def smith_run_operations (seed : Nat) (entries : List Entry) : List (Pair String SmithWitness) -> IO Unit :=
  fix run (cases : List (Pair String SmithWitness)) : IO Unit :=
    match cases with
    | Nil => io_unit
    | Cons current rest => match current with
        | MkPair name witness => do smith_assert seed name (smith_positive entries witness); run rest
        end
    end;

def smith_run_relations (seed : Nat) (entries : List Entry) : List SmithRelation -> IO Unit :=
  fix run (cases : List SmithRelation) : IO Unit :=
    match cases with
    | Nil => io_unit
    | Cons current rest => do smith_assert seed (smith_relation_name current) (smith_relation_check entries current); run rest
    end;

def smith_run_definitions (seed : Nat) (entries : List Entry) : List SmithDefinition -> IO Unit :=
  fix run (definitions : List SmithDefinition) : IO Unit :=
    match definitions with
    | Nil => io_unit
    | Cons definition rest => match definition with
        | SmithDefinitionOf name witness =>
            match witness with
            | SmithWitnessOf family _ _ expected _ forms =>
                do smith_assert seed (str_concat (str_cat4 "generated=" (str_of_nat name) " family=" (str_of_nat family))
                    (str_concat " references=" (property_nats
                      (filter Nat (fun (global : Nat) => andb (notb (ltb_nat global 400)) (ltb_nat global 416))
                        (property_globals (smith_witness_term witness))))))
                    (smith_positive entries witness);
                   smith_assert seed (str_concat "delta=" (str_of_nat name))
                    (smith_normal "normalize-constant" expected (normalize_checked smith_fuel entries (CConst name))
                      (fun (_normal : CoreTerm) => Nothing String));
                   println (str_cat4 "forms seed=" (str_of_nat seed) " selected=" (property_nats forms));
                   run rest
            end
        end
    end;

def smith_run_cold (seed : Nat) (entries : List Entry) : List SmithDefinition -> IO Unit :=
  fix run (definitions : List SmithDefinition) : IO Unit :=
    match definitions with
    | Nil => io_unit
    | Cons definition rest => match definition with
        | SmithDefinitionOf name witness =>
            do smith_assert seed (str_concat "cold-delta=" (str_of_nat name))
                (smith_normal "cold-independent" (smith_witness_normal witness)
                  (normalize_checked smith_fuel entries (CConst name)) (fun (_normal : CoreTerm) => Nothing String));
               run rest
        end
    end;

def smith_run_negatives (seed : Nat) (entries : List Entry) : List SmithNegative -> IO Unit :=
  fix run (cases : List SmithNegative) : IO Unit :=
    match cases with
    | Nil => io_unit
    | Cons current rest => match current with
        | SmithNegativeOf name _ _ _ _ =>
            do smith_assert seed (str_concat "negative=" name) (smith_negative_check entries current); run rest
        end
    end;

def smith_run_declaration_controls (seed : Nat) (entries : List Entry) : IO Unit :=
    do smith_assert seed "covariant-option-nesting"
         (smith_positive_declarations entries ([FInd (smith_covariant_decl 44)] : List FileItem));
       smith_assert seed "covariant-list-nesting"
         (smith_positive_declarations entries ([FInd (smith_covariant_decl 43)] : List FileItem));
       smith_assert seed "earlier-inductive-reference"
         (smith_positive_declarations entries
           ([ FInd (MkIndDecl 997 (Nil Param) (Nil CoreTerm) 0 ([MkCtor 996 (CInd 997)] : List Ctor))
            , FInd (MkIndDecl 900 (Nil Param) (Nil CoreTerm) 0
                ([MkCtor 901 (CPi (CInd 997) (CInd 900))] : List Ctor))
            ] : List FileItem));
       io_unit

def smith_run_seed (seed : Nat) (depth : Nat) (max_defs : Nat) : IO Unit :=
    match smith_definitions seed depth max_defs with
    | Left error => smith_fail seed "generator" error
    | Right definitions =>
        let declarations : List FileItem := append FileItem (smith_declarations seed)
          (map SmithDefinition FileItem smith_definition_item definitions) in
        match check_declarations CheckExactCore keep_checking smith_fuel declarations with
        | DeclarationsErr name phase failure => smith_fail seed "environment"
            (str_cat4 (str_of_nat name) ":" (smith_phase phase) (str_concat ":" (smith_fault failure)))
        | DeclarationsOk entries =>
            do smith_run_domains seed depth entries smith_domain_count 0;
               smith_run_definitions seed entries definitions;
               smith_run_operations seed entries (smith_operation_cases seed);
               smith_run_relations seed entries (smith_relations seed);
               smith_run_declaration_controls seed entries;
               smith_run_negatives seed entries (smith_negative_cases seed);
               match smith_rel_negative seed depth with
               | Left error => smith_fail seed "generator-rel" error
               | Right negative => match negative with
                   | SmithNegativeOf name _ _ _ _ => smith_assert seed (str_concat "negative=" name)
                       (smith_negative_check entries negative)
                   end
               end;
               match check_declarations CheckExactCore keep_checking smith_fuel declarations with
               | DeclarationsErr name phase failure => smith_fail seed "cold-environment"
                   (str_cat4 (str_of_nat name) ":" (smith_phase phase) (str_concat ":" (smith_fault failure)))
               | DeclarationsOk cold => do smith_run_cold seed cold definitions;
                   println (str_concat (str_cat4 "ok compiler-smith seed=" (str_of_nat seed) " definitions="
                     (str_of_nat (length SmithDefinition definitions)))
                     (str_concat (str_cat4 " depth=" (str_of_nat depth) " max-defs=" (str_of_nat max_defs))
                       " domains=18 operations=27 relations=12 negatives=32 controls=3"))
               end
        end
    end;

inductive SmithProfile : Type :=
  | SmithProfileOf : Nat -> Nat -> Nat -> Nat -> SmithProfile;

def smith_profile (name : String) : Maybe SmithProfile :=
    match str_eq name "pr" with
    | True => Just SmithProfile (SmithProfileOf 1 40 4 4)
    | False => match str_eq name "kernel" with
        | True => Just SmithProfile (SmithProfileOf 1 100 5 5)
        | False => match str_eq name "nightly" with
            | True => Just SmithProfile (SmithProfileOf (mul 100 1000) 400 6 6)
            | False => Nothing SmithProfile
            end
        end
    end;

def smith_usage : String :=
    "usage: compiler-smith [--profile pr|kernel|nightly] [--seed N] [--count N] [--depth N] [--max-defs N]";

def smith_cli_failure (error : CliError) : IO Unit :=
    do eprintln (cli_error_message error); eprintln smith_usage; exit 2

def smith_options_known (options : Args) : Bool :=
    andb (nullb String (args_positional options)) (andb (nullb String (args_flags options))
      (all (Pair String String)
        (fun (option : Pair String String) => match option with
          | MkPair name _ => orb (str_eq name "profile") (orb (str_eq name "seed") (orb (str_eq name "count")
              (orb (str_eq name "depth") (str_eq name "max-defs"))))
          end) (args_opts options)));

def smith_run (depth : Nat) (max_defs : Nat) : Nat -> Nat -> IO Unit :=
  fix run (remaining : Nat) (seed : Nat) : IO Unit :=
    match remaining with
    | Z => println "ok compiler-smith complete"
    | S rest => do smith_run_seed seed depth max_defs; run rest (S seed)
    end;

def smith_cli_profile (options : Args) (profile : SmithProfile) : IO Unit :=
    match profile with
    | SmithProfileOf default_seed default_count default_depth default_defs =>
        match cli_optional_nat options "seed" default_seed with
        | Left error => smith_cli_failure error
        | Right seed => match cli_optional_nat options "count" default_count with
            | Left error => smith_cli_failure error
            | Right count => match cli_optional_nat options "depth" default_depth with
                | Left error => smith_cli_failure error
                | Right depth => match cli_optional_nat options "max-defs" default_defs with
                    | Left error => smith_cli_failure error
                    | Right max_defs => match orb (eqNat count 0)
                        (orb (eqNat max_defs 0) (orb (ltb_nat 8 depth) (ltb_nat 16 max_defs))) with
                        | True => smith_cli_failure (CliUsage "count must be positive, depth <= 8 and max-defs 1..16")
                        | False => smith_run depth max_defs count seed
                        end
                    end
                end
            end
        end
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       let options : Args := cli_from_argv (Nil String) arguments in
       match andb (args_argv_options_complete (Nil String) arguments) (smith_options_known options) with
       | False => smith_cli_failure (CliUsage smith_usage)
       | True => match smith_profile (fromMaybe String "pr" (cli_opt options "profile")) with
           | Nothing => smith_cli_failure (CliUsage "unknown profile")
           | Just profile => smith_cli_profile options profile
           end
       end
