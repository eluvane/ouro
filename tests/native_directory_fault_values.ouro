-- Typed probes run after complete source checking and replay. Real OS
-- ownership is retained; injected close/release errors follow real cleanup.
import "native_startup_fault_values.ouro",
  "../compiler/native/managed_directories.ouro";

def directory_fault_symbol_names : List String :=
    ["raw_pages_allocate", "raw_pages_release", "raw_windows_utf8_to_utf16", "raw_windows_utf16_to_utf8", "raw_windows_wide_length", "raw_windows_path_valid", "raw_windows_directory_open_literal", "raw_windows_directory_check_handle", "raw_windows_file_close", "raw_windows_directory_first", "raw_windows_directory_next", "raw_windows_directory_close", "windows_exit_process", "managed_collect", "raw_windows_file_open_write"];

def directory_fault_symbols (checked : CheckedProgram) : Either NativeLowerError (List Nat) :=
    (fix resolve (names : List String) : Either NativeLowerError (List Nat) :=
      match names with | Nil => Right(NativeLowerError, List Nat, [] : List Nat)
      | Cons name rest => lower_bind Nat (List Nat) (managed_source_symbol(checked, prim_string_to_char_codes name))
          (fun (id : Nat) => lower_map(List Nat, List Nat, Cons Nat id, resolve rest)) end) directory_fault_symbol_names;

def directory_fault_release (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 0 state)
      (fun (closed : ManagedState) => lower_bind ManagedState ManagedResult (startup_fault_pop base (MirUse 0) closed)
        (fun (popped : ManagedState) => lower_bind ManagedResult ManagedResult
          (startup_fault_call MirU8 original ([MirUse 0] : List MirValue) popped)
          (fun (released : ManagedResult) => match released with | ManagedResultOf okay after =>
            lower_bind ManagedState ManagedResult (managed_require_equal okay (managed_bits MirU8 1) after)
              (fun (success : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 8 success)
                (fun (counted : ManagedResult) => match counted with | ManagedResultOf attempt next =>
                  match orb(eqNat mode 14, eqNat mode 27) with
                  | False => startup_fault_result MirU8 1 next
                  | True => managed_compare MirNotEqual attempt (managed_bits MirUSize 1) next end end)) end)));

-- Counters: allocations/releases 0/8; owned file open/close 16/24;
-- first/path conversion/next/name conversion 32/40/48/56; raw stack 64;
-- live handle kind/pointer 72/80; collector/reclaimed 96/104;
-- metadata/name length 112/120; allocation bases 128..184;
-- path validation/search close 192/200. Kind 1 is a file, kind 2 a search.
-- The reused-action probe also records the real intervening file write.
def directory_fault_owned (base : Nat) (kind : Nat) (value : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedState :=
    lower_bind ManagedState ManagedState (startup_fault_stat base 72 kind state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedState (startup_fault_load base 80 MirRawPtr owned)
        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf expected next =>
          managed_require_equal value expected next end));

def directory_fault_open (base : Nat) (mode : Nat) (original : Nat) (searching : Bool)
    (arguments : List MirValue) (owner : MirValue) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let offset : Nat := match searching with | True => 32 | False => 16 end in
    lower_bind ManagedResult ManagedResult (startup_fault_count base offset state)
      (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
        lower_bind ManagedState ManagedResult (startup_fault_stat base 72 0 next)
          (fun (vacant : ManagedState) =>
            let fail : Bool := match searching with | True => eqNat mode 13 | False => eqNat mode 8 end in
            match fail with | True => startup_fault_result MirU32 5 vacant | False =>
              match andb(searching, eqNat mode 12) with | True => startup_fault_result MirU32 2 vacant | False =>
                lower_bind ManagedResult ManagedResult (startup_fault_call MirU32 original arguments vacant)
                  (fun (opened : ManagedResult) => match opened with | ManagedResultOf status after =>
                    lower_bind ManagedState ManagedResult (managed_require_equal status (managed_bits MirU32 0) after)
                      (fun (success : ManagedState) => lower_bind ManagedResult ManagedResult (managed_load MirUSize owner 0 success)
                        (fun (loaded : ManagedResult) => match loaded with | ManagedResultOf bits ready =>
                          lower_bind ManagedResult ManagedResult (managed_convert MirRawPtr MirRawFromBits bits ready)
                            (fun (converted : ManagedResult) => match converted with | ManagedResultOf stream final =>
                              lower_bind ManagedState ManagedResult (startup_fault_store base 80 stream final)
                                (fun (saved : ManagedState) => lower_map ManagedState ManagedResult
                                  (fun (finished : ManagedState) => ManagedResultOf status finished)
                                  (startup_fault_store base 72 (managed_bits MirUSize
                                    (match searching with | True => 2 | False => 1 end)) saved)) end) end)) end) end end) end);

def directory_fault_close (base : Nat) (mode : Nat) (original : Nat) (searching : Bool) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let kind : Nat := match searching with | True => 2 | False => 1 end in
    let offset : Nat := match searching with | True => 200 | False => 24 end in
    let fail : Bool := match searching with | True => orb(eqNat mode 26, eqNat mode 27) | False => eqNat mode 11 end in
    lower_bind ManagedState ManagedResult (directory_fault_owned base kind (MirUse 0) state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base offset owned)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
          lower_bind ManagedResult ManagedResult (startup_fault_call MirU32 original ([MirUse 0] : List MirValue) next)
            (fun (closed : ManagedResult) => match closed with | ManagedResultOf status after =>
              lower_bind ManagedState ManagedResult (managed_require_equal status (managed_bits MirU32 0) after)
                (fun (success : ManagedState) => lower_bind ManagedState ManagedResult
                  (startup_fault_store base 72 (managed_bits MirUSize 0) success)
                  (startup_fault_result(MirU32, match fail with | True => 5 | False => 0 end))) end) end));

def directory_fault_check (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (directory_fault_owned base 1 (MirUse 0) state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 112 owned)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
          match eqNat mode 9 with | True => startup_fault_result MirU32 267 next | False =>
            match eqNat mode 10 with | True => startup_fault_result MirU32 5 next | False =>
              startup_fault_call MirU32 original ([MirUse 0, MirUse 1] : List MirValue) next end end end));

def directory_fault_path (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedResult ManagedResult (startup_fault_count base 192 state)
      (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
        match eqNat mode 4 with | True => startup_fault_result MirU8 0 next | False =>
          startup_fault_call MirU8 original ([MirUse 0, MirUse 1, MirUse 2] : List MirValue) next end end);

-- Fill only the declared 260 UTF-16 units, leaving no zero terminator.
def directory_fault_unterminated (state : ManagedState) : Either NativeLowerError ManagedState :=
    lower_bind (Pair Nat ManagedState) ManagedState (managed_fresh_local MirUSize state)
      (fun (cell : Pair Nat ManagedState) => match cell with | MkPair index next =>
        lower_bind LowerLoopBlocks ManagedState
          (lower_loop_blocks (managed_flow (managed_emit(MirMove(index, managed_bits MirUSize 0), next))))
          (fun (labels : LowerLoopBlocks) => match labels with | LowerLoopAt header body finish flow =>
            lower_bind ManagedResult ManagedState (managed_compare MirLess (MirUse index) (managed_bits MirUSize 520)
              (managed_with_flow(next, lower_switch_block header (MirJump header) flow)))
              (fun (tested : ManagedResult) => match tested with | ManagedResultOf running after =>
                Right NativeLowerError ManagedState (managed_switch_block finish (MirJump header)
                  (managed_emit_all ([MirStoreAt(MirUse 0, MirUse index, managed_bits MirU8 65),
                    MirBinaryOp(index, MirAdd, MirUse index, managed_bits MirUSize 1)] : List MirInstruction)
                    (managed_switch_block body (MirBranch running body finish) after))) end) end) end);

def directory_fault_length (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 2 state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 120 owned)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
          match eqNat mode 17 with | True => startup_fault_result MirU32 5 next | False =>
            match orb(eqNat mode 18, eqNat mode 19) with
            | True => startup_fault_result MirU32 0 (managed_emit (MirStore (MirUse 2) (codegen_disp 0)
                (managed_bits(MirU32, match eqNat mode 18 with | True => 0 | False => 260 end))) next)
            | False => lower_bind ManagedState ManagedResult (match eqNat mode 21 with
                | True => directory_fault_unterminated next
                | False => Right NativeLowerError ManagedState (match eqNat mode 20 with
                    | False => next | True => managed_emit (MirStore (MirUse 0) (codegen_disp 0)
                        (MirBits(MirU32, X64Words64(X64Bytes32 0 216 0 0, codegen_zero)))) next end) end)
                (fun (prepared : ManagedState) => startup_fault_call MirU32 original
                  ([MirUse 0, MirUse 1, MirUse 2] : List MirValue) prepared) end end end));

def directory_fault_name (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    let arguments : List MirValue := [MirUse 0, MirUse 1, MirUse 2, MirUse 3, MirUse 4] in
    lower_bind ManagedState ManagedResult (startup_fault_stat base 72 2 state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 56 owned)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
          lower_bind ManagedResult ManagedResult (managed_compare(MirEqual, MirUse 3, managed_bits MirUSize 0, next))
            (fun (tested : ManagedResult) => match tested with | ManagedResultOf query after =>
              managed_string_choose MirU32 query
                (fun (sizing : ManagedState) => match eqNat mode 22 with | True => startup_fault_result MirU32 5 sizing | False =>
                  match eqNat mode 24 with
                  | True => startup_fault_result MirU32 0
                      (managed_emit(MirStore(MirUse 4, codegen_disp 0, managed_bits MirU32 1041), sizing))
                  | False => startup_fault_call MirU32 original arguments sizing end end)
                (fun (filling : ManagedState) => match eqNat mode 23 with | True => startup_fault_result MirU32 5 filling | False =>
                  lower_map ManagedResult ManagedResult (fun (result : ManagedResult) => match result with
                    | ManagedResultOf status finished => ManagedResultOf status (match eqNat mode 25 with
                      | False => finished | True => managed_emit
                          (MirStore(MirUse 4, codegen_disp 0, managed_bits MirU32 0)) finished end) end)
                    (startup_fault_call MirU32 original arguments filling) end) after end) end));

def directory_fault_next (base : Nat) (mode : Nat) (original : Nat) (state : ManagedState)
    : Either NativeLowerError ManagedResult :=
    lower_bind ManagedState ManagedResult (directory_fault_owned base 2 (MirUse 0) state)
      (fun (owned : ManagedState) => lower_bind ManagedResult ManagedResult (startup_fault_count base 48 owned)
        (fun (counted : ManagedResult) => match counted with | ManagedResultOf _ next =>
          match eqNat mode 15 with | True => startup_fault_result MirU32 5 next | False =>
            match orb(eqNat mode 16, eqNat mode 27) with
            | False => startup_fault_call MirU32 original ([MirUse 0, MirUse 1, MirUse 2] : List MirValue) next
            | True => lower_bind ManagedResult ManagedResult (startup_fault_load base 56 MirUSize next)
                (fun (converted : ManagedResult) => match converted with | ManagedResultOf names after =>
                  lower_bind ManagedResult ManagedResult (managed_compare MirGreaterEqual names (managed_bits MirUSize 2) after)
                    (fun (tested : ManagedResult) => match tested with | ManagedResultOf prefix finished =>
                      managed_string_choose MirU32 prefix (startup_fault_result MirU32 5)
                        (startup_fault_call MirU32 original ([MirUse 0, MirUse 1, MirUse 2] : List MirValue)) finished end) end) end end end));
