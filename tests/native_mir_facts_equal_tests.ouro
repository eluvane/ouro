-- The original pure comparison remains an oracle for Boolean parity.
import "native_mir_validation_tests.ouro";

def mir_facts_reference : List MirBlockFact -> List MirBlockFact -> Bool :=
  fix mir_facts_reference (left : List MirBlockFact) (right : List MirBlockFact) : Bool :=
    match left, right with
    | Nil, Nil => True | Nil, Cons _ _ => False | Cons _ _, Nil => False
    | Cons a rest_a, Cons b rest_b => match a, b with | MirFact id_a values_a, MirFact id_b values_b =>
      andb(andb(eq_nat id_a id_b, mir_set_equal values_a values_b), mir_facts_reference rest_a rest_b) end end;

def mir_facts_same (left : List MirBlockFact) (right : List MirBlockFact) : Bool :=
    match mir_facts_reference left right with
    | True => mir_facts_equal left right | False => notb (mir_facts_equal left right) end;

def mir_facts_parity (name : String) (left : List MirBlockFact) (right : List MirBlockFact) : Test :=
    assert_true(name, mir_facts_same left right);

def mir_facts_values : List (List Nat) :=
    [([] : List Nat), [0], [1], [0, 1], [1, 0], [0, 0, 1]];

def mir_facts_large_values : List Nat :=
    (fix values (remaining : Nat) : List Nat := match remaining with
      | Z => Nil Nat | S rest => Cons Nat rest (values rest) end) 320;

def mir_facts_family : Bool :=
    all Nat (fun (left_id : Nat) => all Nat (fun (right_id : Nat) =>
      all (List Nat) (fun (left_values : List Nat) => all (List Nat) (fun (right_values : List Nat) =>
        let left : List MirBlockFact := [MirFact left_id left_values] in
        let right : List MirBlockFact := [MirFact right_id right_values] in
        andb (mir_facts_same left right)
          (mir_facts_same (Cons MirBlockFact (MirFact(7, [7] : List Nat)) left)
            (Cons MirBlockFact (MirFact(7, [7, 7] : List Nat)) right))) mir_facts_values) mir_facts_values)
      ([0, 1, 256] : List Nat)) ([0, 1, 256] : List Nat);

def native_mir_facts_equal_tests : List Test :=
    [mir_facts_parity("Facts equality preserves two empty lists", [] : List MirBlockFact, [] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves an empty left list" ([] : List MirBlockFact)
        ([MirFact(0, [] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves an empty right list"
        ([MirFact(0, [] : List Nat)] : List MirBlockFact) ([] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves identical facts"
        ([MirFact(0, [0, 1] : List Nat)] : List MirBlockFact) ([MirFact(0, [0, 1] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves differing IDs"
        ([MirFact(0, [0] : List Nat)] : List MirBlockFact) ([MirFact(1, [0] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves permuted sets"
        ([MirFact(0, [0, 1, 2] : List Nat)] : List MirBlockFact) ([MirFact(0, [2, 0, 1] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves duplicate insensitive sets"
        ([MirFact(0, [0, 0, 1] : List Nat)] : List MirBlockFact) ([MirFact(0, [1, 0, 1] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves differing values"
        ([MirFact(0, [0, 1] : List Nat)] : List MirBlockFact) ([MirFact(0, [0, 2] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves a mismatch after equal facts"
        ([MirFact(0, [0] : List Nat), MirFact(1, [1] : List Nat)] : List MirBlockFact)
        ([MirFact(0, [0, 0] : List Nat), MirFact(1, [2] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves a shorter left tail"
        ([MirFact(0, [] : List Nat)] : List MirBlockFact)
        ([MirFact(0, [] : List Nat), MirFact(1, [] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves a shorter right tail"
        ([MirFact(0, [] : List Nat), MirFact(1, [] : List Nat)] : List MirBlockFact)
        ([MirFact(0, [] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves full natural ID equality"
        ([MirFact(pe_byte2_place, [256, pe_byte2_place] : List Nat)] : List MirBlockFact)
        ([MirFact(pe_byte2_place, [pe_byte2_place, 256] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves full natural ID differences"
        ([MirFact(pe_byte2_place, [256] : List Nat)] : List MirBlockFact)
        ([MirFact(S pe_byte2_place, [256] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves fact ordering"
        ([MirFact(0, [0] : List Nat), MirFact(1, [1] : List Nat)] : List MirBlockFact)
        ([MirFact(1, [1] : List Nat), MirFact(0, [0] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality preserves repeated fact IDs"
        ([MirFact(0, [0] : List Nat), MirFact(0, [1] : List Nat)] : List MirBlockFact)
        ([MirFact(0, [0, 0] : List Nat), MirFact(0, [1, 1] : List Nat)] : List MirBlockFact),
      mir_facts_parity "Facts equality rejects mismatched IDs with large sets"
        ([MirFact 0 mir_facts_large_values] : List MirBlockFact)
        ([MirFact 1 mir_facts_large_values] : List MirBlockFact),
      mir_facts_parity "Facts equality rejects mismatched IDs before different large sets"
        ([MirFact 0 mir_facts_large_values] : List MirBlockFact)
        ([MirFact(1, Cons Nat 900 mir_facts_large_values)] : List MirBlockFact),
      mir_facts_parity "Facts equality keeps an early mismatch before large later facts"
        ([MirFact(0, [] : List Nat), MirFact 2 mir_facts_large_values] : List MirBlockFact)
        ([MirFact(1, [] : List Nat), MirFact(2, Cons Nat 900 mir_facts_large_values)] : List MirBlockFact),
      assert_true "Facts equality matches 648 arbitrary ID set and prefix combinations" mir_facts_family,
      assert_true "Facts equality still accepts ordered facts with unordered duplicate sets"
        (mir_facts_equal ([MirFact(0, [0, 0, 1] : List Nat), MirFact(1, [7] : List Nat)] : List MirBlockFact)
          ([MirFact(0, [1, 0] : List Nat), MirFact(1, [7, 7] : List Nat)] : List MirBlockFact))];

-- @entry main
def main : IO Unit := test_run native_mir_facts_equal_tests
