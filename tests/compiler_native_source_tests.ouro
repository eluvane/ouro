-- Native declaration keywords retain their bytes and reserved-name behavior
-- through the source preprocessors used before declaration parsing.

import "../compiler/canonical_source.ouro";
import "../compiler/preprocess_record_text.ouro";
import "../compiler/preprocess_import.ouro";
import "analyze/precision/assertions.ouro";

def native_source_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-canonical/intrinsic-keyword-bytes"
        (match cs_token_codes [] [] (TKeyword kwIntrinsic) with
         | CanonicalBytesOk codes => prim_string_eq (prim_string_of_char_codes codes) "intrinsic"
         | CanonicalBytesErr _ _ => False
         end)
    , MkPair String Bool "native-canonical/extern-keyword-bytes"
        (match cs_token_codes [] [] (TKeyword kwExtern) with
         | CanonicalBytesOk codes => prim_string_eq (prim_string_of_char_codes codes) "extern"
         | CanonicalBytesErr _ _ => False
         end)
    , MkPair String Bool "native-canonical/unknown-keyword-still-rejected"
        (match cs_token_codes [] [] (TKeyword 20) with
         | CanonicalBytesOk _ => False
         | CanonicalBytesErr code id => andb (eqNat code cs_err_keyword) (eqNat id 20)
         end)
    , MkPair String Bool "native-record/declared-names-enter-collision-check"
        (precision_strings (map (List Nat) String prim_string_of_char_codes
          (collect_decl_names (prim_string_to_char_codes
            "intrinsic U32 : Type := \"key\"; extern call : U32 := \"a\" \"b\" \"c\" \"d\" \"e\";")))
          ["U32", "call"])
    , MkPair String Bool "native-record/declared-names-ignore-strings-comments-and-prefixes"
        (match collect_decl_names (prim_string_to_char_codes
          "intrinsically value; external value; -- extern comment\n\"intrinsic quoted\"") with
         | Nil => True
         | Cons _ _ => False
         end)
    , MkPair String Bool "native-import/intrinsic-alias-is-reserved"
        (eqNat (import_alias_error (prim_string_to_char_codes "intrinsic") []) imp_code_badname)
    , MkPair String Bool "native-import/extern-alias-is-reserved"
        (eqNat (import_alias_error (prim_string_to_char_codes "extern") []) imp_code_badname)
    , MkPair String Bool "native-import/keyword-prefix-alias-stays-available"
        (eqNat (import_alias_error (prim_string_to_char_codes "external") []) Z)
    , MkPair String Bool "representation-canonical/keyword-bytes"
        (match cs_token_codes [] [] (TKeyword kwRepresentation) with
         | CanonicalBytesOk codes => prim_string_eq (prim_string_of_char_codes codes) "representation"
         | CanonicalBytesErr _ _ => False
         end)
    , MkPair String Bool "representation-record/annotation-does-not-redeclare-target"
        (precision_strings (map (List Nat) String prim_string_of_char_codes
          (collect_decl_names (prim_string_to_char_codes
            "inductive Natural : Type := | Zero : Natural; representation Natural := \"ouro.nat\";")))
          ["Natural"])
    , MkPair String Bool "representation-import/alias-is-reserved"
        (eqNat (import_alias_error (prim_string_to_char_codes "representation") []) imp_code_badname)
    , MkPair String Bool "representation-import/keyword-prefix-alias-stays-available"
        (eqNat (import_alias_error (prim_string_to_char_codes "representational") []) Z)
    ];

-- @entry main
def main : IO Unit := precision_run "compiler-native-source" native_source_laws;
