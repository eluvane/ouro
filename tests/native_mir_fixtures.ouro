-- Executable MIR acceptance fixtures. No preassembled function bytes appear
-- here: every body goes through the same validator and instruction selector.
import "../compiler/native/codegen.ouro";
import "native_managed_fixtures.ouro";

def mir_fixture_bits (ty : MirType) (low : X64Word32) (high : X64Word32) : MirValue :=
    MirBits ty (X64Words64 low high);
def mir_fixture_nat (ty : MirType) (value : Nat) : MirValue :=
    mir_fixture_bits ty (pe_word32 value) codegen_zero;
def mir_fixture_i32 (low : X64Word32) : MirValue := mir_fixture_bits MirI32 low codegen_zero;
def mir_fixture_u32 (low : X64Word32) : MirValue := mir_fixture_bits MirU32 low codegen_zero;
def mir_fixture_void : Maybe MirType := Nothing MirType;
def mir_fixture_no_dest : Maybe Nat := Nothing Nat;
def mir_fixture_no_value : Maybe MirValue := Nothing MirValue;

def mir_fixture_exit : MirExtern := MirExternDef MirNoGc 1000
    ([69, 120, 105, 116, 80, 114, 111, 99, 101, 115, 115] : List Nat)
    (MirSignatureOf ([MirU32] : List MirType) mir_fixture_void);
def mir_fixture_kernel (externs : List MirExtern) : MirLibrary := MirLibraryDef
    ([107, 101, 114, 110, 101, 108, 51, 50, 46, 100, 108, 108] : List Nat)
    (Cons MirExtern mir_fixture_exit externs);
def mir_fixture_exit_call (status : Nat) : MirInstruction :=
    MirCall MirMayGc mir_fixture_no_dest (MirDirect 1000) ([mir_fixture_nat MirU32 status] : List MirValue);
def mir_fixture_exit_block (id : Nat) (status : Nat) : MirBlock :=
    MirBlockDef id ([mir_fixture_exit_call status] : List MirInstruction) MirTrap;
def mir_fixture_function (locals : List MirLocal) (blocks : List MirBlock) : MirFunction :=
    MirFunctionDef 1 ([101, 110, 116, 114, 121] : List Nat) ([] : List MirLocal) locals mir_fixture_void 0 blocks;
def mir_fixture_program (function : MirFunction) : MirProgram :=
    MirProgramDef ([function] : List MirFunction) ([] : List MirData)
      ([mir_fixture_kernel ([] : List MirExtern)] : List MirLibrary) 1;

-- Local 90 holds one comparison, 91 the accumulated success bit.
def mir_fixture_expect (value : MirValue) (expected : MirValue) : List MirInstruction :=
    [MirCompare 90 MirEqual value expected, MirBinaryOp 91 MirAnd (MirUse 91) (MirUse 90)];
def mir_fixture_assert_ops (operation : MirInstruction) (id : Nat) (expected : MirValue) : List MirInstruction :=
    Cons MirInstruction operation (mir_fixture_expect (MirUse id) expected);
def mir_fixture_assert_locals : List MirLocal := [MirLocalDef 90 MirU8, MirLocalDef 91 MirU8];
def mir_fixture_assert_function (locals : List MirLocal) (instructions : List MirInstruction) : MirFunction :=
    mir_fixture_function (append MirLocal locals mir_fixture_assert_locals)
      ([MirBlockDef 0 (Cons MirInstruction (MirMove 91 (mir_fixture_nat MirU8 1)) instructions) (MirBranch (MirUse 91) 1 2),
        mir_fixture_exit_block 1 42, mir_fixture_exit_block 2 99] : List MirBlock);

def mir_fixture_control : MirProgram := mir_fixture_program
    (mir_fixture_function ([MirLocalDef 10 MirU32, MirLocalDef 11 MirU32, MirLocalDef 12 MirU8] : List MirLocal)
      ([MirBlockDef 0 ([MirMove 10 (mir_fixture_nat MirU32 0), MirMove 11 (mir_fixture_nat MirU32 0)] : List MirInstruction) (MirJump 1),
        MirBlockDef 1 ([MirCompare 12 MirLess (MirUse 10) (mir_fixture_nat MirU32 6)] : List MirInstruction) (MirBranch (MirUse 12) 2 3),
        MirBlockDef 2 ([MirBinaryOp 10 MirAdd (MirUse 10) (mir_fixture_nat MirU32 1),
          MirBinaryOp 11 MirAdd (MirUse 11) (MirUse 10)] : List MirInstruction) (MirJump 1),
        MirBlockDef 3 ([MirCompare 12 MirEqual (MirUse 11) (mir_fixture_nat MirU32 21)] : List MirInstruction) (MirBranch (MirUse 12) 4 5),
        mir_fixture_exit_block 4 42, mir_fixture_exit_block 5 99] : List MirBlock));

def mir_fixture_arithmetic_ops : List MirInstruction := managed_fixture_join ([
    mir_fixture_assert_ops (MirBinaryOp 1 MirAdd (mir_fixture_nat MirU8 250) (mir_fixture_nat MirU8 10)) 1 (mir_fixture_nat MirU8 4),
    mir_fixture_assert_ops (MirBinaryOp 1 MirSub (mir_fixture_nat MirU8 0) (mir_fixture_nat MirU8 1)) 1 (mir_fixture_nat MirU8 255),
    mir_fixture_assert_ops (MirBinaryOp 1 MirMul (mir_fixture_nat MirU8 40) (mir_fixture_nat MirU8 10)) 1 (mir_fixture_nat MirU8 144),
    mir_fixture_assert_ops (MirBinaryOp 1 MirShl (mir_fixture_nat MirU8 3) (mir_fixture_nat MirU32 9)) 1 (mir_fixture_nat MirU8 6),
    mir_fixture_assert_ops (MirBinaryOp 1 MirShr (mir_fixture_nat MirU8 128) (mir_fixture_nat MirU32 8)) 1 (mir_fixture_nat MirU8 128),
    mir_fixture_assert_ops (MirBinaryOp 2 MirAdd (mir_fixture_u32 (X64Bytes32 255 255 255 255)) (mir_fixture_nat MirU32 2)) 2 (mir_fixture_nat MirU32 1),
    mir_fixture_assert_ops (MirBinaryOp 2 MirSub (mir_fixture_nat MirU32 0) (mir_fixture_nat MirU32 1)) 2 (mir_fixture_u32 (X64Bytes32 255 255 255 255)),
    mir_fixture_assert_ops (MirBinaryOp 2 MirMul (mir_fixture_u32 (X64Bytes32 1 0 0 128)) (mir_fixture_nat MirU32 3)) 2 (mir_fixture_u32 (X64Bytes32 3 0 0 128)),
    mir_fixture_assert_ops (MirBinaryOp 2 MirDiv (mir_fixture_u32 (X64Bytes32 255 255 255 255)) (mir_fixture_nat MirU32 2)) 2 (mir_fixture_u32 (X64Bytes32 255 255 255 127)),
    mir_fixture_assert_ops (MirBinaryOp 2 MirRem (mir_fixture_u32 (X64Bytes32 255 255 255 255)) (mir_fixture_nat MirU32 2)) 2 (mir_fixture_nat MirU32 1),
    mir_fixture_assert_ops (MirBinaryOp 2 MirShr (mir_fixture_u32 (X64Bytes32 0 0 0 128)) (mir_fixture_nat MirU32 33)) 2 (mir_fixture_u32 (X64Bytes32 0 0 0 64)),
    mir_fixture_assert_ops (MirBinaryOp 2 MirShl (mir_fixture_nat MirU32 1) (mir_fixture_nat MirU32 32)) 2 (mir_fixture_nat MirU32 1),
    mir_fixture_assert_ops (MirBinaryOp 3 MirAdd (mir_fixture_bits MirU64 (X64Bytes32 255 255 255 255) (X64Bytes32 255 255 255 255))
      (mir_fixture_nat MirU64 1)) 3 (mir_fixture_nat MirU64 0),
    mir_fixture_assert_ops (MirBinaryOp 3 MirSub (mir_fixture_nat MirU64 0) (mir_fixture_nat MirU64 1)) 3
      (mir_fixture_bits MirU64 (X64Bytes32 255 255 255 255) (X64Bytes32 255 255 255 255)),
    mir_fixture_assert_ops (MirBinaryOp 3 MirMul (mir_fixture_bits MirU64 codegen_zero (pe_word32 1)) (mir_fixture_nat MirU64 3)) 3
      (mir_fixture_bits MirU64 codegen_zero (pe_word32 3)),
    mir_fixture_assert_ops (MirBinaryOp 3 MirDiv (mir_fixture_bits MirU64 (pe_word32 42) (pe_word32 1))
      (mir_fixture_bits MirU64 codegen_zero (pe_word32 1))) 3 (mir_fixture_nat MirU64 1),
    mir_fixture_assert_ops (MirBinaryOp 3 MirRem (mir_fixture_bits MirU64 (pe_word32 42) (pe_word32 1))
      (mir_fixture_bits MirU64 codegen_zero (pe_word32 1))) 3 (mir_fixture_nat MirU64 42),
    mir_fixture_assert_ops (MirBinaryOp 3 MirShl (mir_fixture_nat MirU64 1) (mir_fixture_nat MirU32 100)) 3
      (mir_fixture_bits MirU64 codegen_zero (pe_word32 16)),
    mir_fixture_assert_ops (MirBinaryOp 3 MirShr (mir_fixture_bits MirU64 codegen_zero (pe_word32 16)) (mir_fixture_nat MirU32 100)) 3
      (mir_fixture_nat MirU64 1),
    mir_fixture_assert_ops (MirBinaryOp 3 MirOr (mir_fixture_bits MirU64 (pe_word32 5) (pe_word32 1)) (mir_fixture_nat MirU64 2)) 3
      (mir_fixture_bits MirU64 (pe_word32 7) (pe_word32 1)),
    mir_fixture_assert_ops (MirBinaryOp 3 MirXor (MirUse 3) (mir_fixture_bits MirU64 (pe_word32 3) (pe_word32 1))) 3 (mir_fixture_nat MirU64 4),
    mir_fixture_assert_ops (MirBinaryOp 5 MirAdd (mir_fixture_nat MirUSize 41) (mir_fixture_nat MirUSize 1)) 5 (mir_fixture_nat MirUSize 42),
    mir_fixture_assert_ops (MirBinaryOp 4 MirDiv (mir_fixture_i32 (X64Bytes32 249 255 255 255)) (mir_fixture_nat MirI32 2)) 4
      (mir_fixture_i32 (X64Bytes32 253 255 255 255)),
    mir_fixture_assert_ops (MirBinaryOp 4 MirRem (mir_fixture_i32 (X64Bytes32 249 255 255 255)) (mir_fixture_nat MirI32 2)) 4
      (mir_fixture_i32 (X64Bytes32 255 255 255 255)),
    mir_fixture_assert_ops (MirBinaryOp 4 MirShr (mir_fixture_i32 (X64Bytes32 248 255 255 255)) (mir_fixture_nat MirU32 33)) 4
      (mir_fixture_i32 (X64Bytes32 252 255 255 255)),
    mir_fixture_assert_ops (MirConvert 3 MirSignExtend (MirUse 4)) 3
      (mir_fixture_bits MirU64 (X64Bytes32 252 255 255 255) (X64Bytes32 255 255 255 255)),
    mir_fixture_assert_ops (MirConvert 3 MirZeroExtend (mir_fixture_nat MirU8 255)) 3 (mir_fixture_nat MirU64 255),
    mir_fixture_assert_ops (MirConvert 1 MirNarrow (mir_fixture_bits MirU64 (X64Bytes32 222 188 10 0) (X64Bytes32 1 0 0 0))) 1 (mir_fixture_nat MirU8 222),
    mir_fixture_assert_ops (MirConvert 2 MirReinterpret (mir_fixture_i32 (X64Bytes32 255 255 255 255))) 2
      (mir_fixture_u32 (X64Bytes32 255 255 255 255)),
    mir_fixture_assert_ops (MirCompare 1 MirLess (mir_fixture_i32 (X64Bytes32 255 255 255 255)) (mir_fixture_nat MirI32 1)) 1 (mir_fixture_nat MirU8 1),
    mir_fixture_assert_ops (MirCompare 1 MirLess (mir_fixture_u32 (X64Bytes32 255 255 255 255)) (mir_fixture_nat MirU32 1)) 1 (mir_fixture_nat MirU8 0),
    mir_fixture_assert_ops (MirCompare 1 MirLessEqual (mir_fixture_nat MirU64 7) (mir_fixture_nat MirU64 7)) 1 (mir_fixture_nat MirU8 1),
    mir_fixture_assert_ops (MirCompare 1 MirGreater (mir_fixture_i32 (X64Bytes32 254 255 255 255)) (mir_fixture_i32 (X64Bytes32 253 255 255 255))) 1 (mir_fixture_nat MirU8 1),
    mir_fixture_assert_ops (MirCompare 1 MirGreaterEqual (mir_fixture_nat MirU64 8) (mir_fixture_nat MirU64 9)) 1 (mir_fixture_nat MirU8 0),
    mir_fixture_assert_ops (MirCompare 1 MirNotEqual (mir_fixture_nat MirRawPtr 0) (mir_fixture_nat MirRawPtr 0)) 1 (mir_fixture_nat MirU8 0)]
      : List (List MirInstruction));

def mir_fixture_arithmetic : MirProgram := mir_fixture_program (mir_fixture_assert_function
    ([MirLocalDef 1 MirU8, MirLocalDef 2 MirU32, MirLocalDef 3 MirU64, MirLocalDef 4 MirI32, MirLocalDef 5 MirUSize] : List MirLocal)
    mir_fixture_arithmetic_ops);

def mir_fixture_memory : MirProgram := MirProgramDef
    ([mir_fixture_assert_function
      ([MirLocalDef 10 MirRawPtr, MirLocalDef 11 MirRawPtr, MirLocalDef 12 MirU8, MirLocalDef 13 MirU32, MirLocalDef 14 MirU64] : List MirLocal)
      (managed_fixture_join ([
        ([MirAddress 10 200, MirStore (MirUse 10) (codegen_disp 0) (mir_fixture_nat MirU8 42)] : List MirInstruction),
        mir_fixture_assert_ops (MirLoad 12 (MirUse 10) (codegen_disp 0)) 12 (mir_fixture_nat MirU8 42),
        mir_fixture_assert_ops (MirLoad 12 (MirUse 10) (codegen_disp 1)) 12 (mir_fixture_nat MirU8 170),
        ([MirStore (MirUse 10) (codegen_disp 4) (mir_fixture_u32 (X64Bytes32 33 67 101 135))] : List MirInstruction),
        mir_fixture_assert_ops (MirLoad 13 (MirUse 10) (codegen_disp 4)) 13 (mir_fixture_u32 (X64Bytes32 33 67 101 135)),
        ([MirStore (MirUse 10) (codegen_disp 8) (mir_fixture_bits MirU64 (pe_word32 42) (X64Bytes32 1 2 3 4)),
          MirPointerAdd 11 (MirUse 10) (mir_fixture_nat MirUSize 8)] : List MirInstruction),
        mir_fixture_assert_ops (MirLoad 14 (MirUse 11) (codegen_disp 0)) 14 (mir_fixture_bits MirU64 (pe_word32 42) (X64Bytes32 1 2 3 4)),
        mir_fixture_assert_ops (MirLoad 13 (MirUse 11) (X64Backward (pe_word32 4))) 13 (mir_fixture_u32 (X64Bytes32 33 67 101 135)),
        ([MirAddress 10 201] : List MirInstruction),
        mir_fixture_assert_ops (MirLoad 12 (MirUse 10) (codegen_disp 0)) 12 (mir_fixture_nat MirU8 21)] : List (List MirInstruction)))]
      : List MirFunction)
    ([MirDataDef 200 True (Cons Nat 0 (Cons Nat 170 (pe_zeros 14))), MirDataDef 201 False ([21] : List Nat)] : List MirData)
    ([mir_fixture_kernel ([] : List MirExtern)] : List MirLibrary) 1;

def mir_fixture_six_args : List MirLocal :=
    [MirLocalDef 0 MirU64, MirLocalDef 1 MirU64, MirLocalDef 2 MirU64,
      MirLocalDef 3 MirU64, MirLocalDef 4 MirU64, MirLocalDef 5 MirU64];
def mir_fixture_six_signature : MirSignature :=
    MirSignatureOf ([MirU64, MirU64, MirU64, MirU64, MirU64, MirU64] : List MirType) (Just MirType MirU64);
def mir_fixture_six_values (step : Nat) : List MirValue :=
    map Nat MirValue (fun (value : Nat) => mir_fixture_nat MirU64 (mul value step)) ([1, 2, 3, 4, 5, 6] : List Nat);
def mir_fixture_sum_ops : List MirInstruction :=
    [MirBinaryOp 10 MirAdd (MirUse 0) (MirUse 1), MirBinaryOp 10 MirAdd (MirUse 10) (MirUse 2),
      MirBinaryOp 10 MirAdd (MirUse 10) (MirUse 3), MirBinaryOp 10 MirAdd (MirUse 10) (MirUse 4),
      MirBinaryOp 10 MirAdd (MirUse 10) (MirUse 5)];
def mir_fixture_clobber : MirFunction := MirFunctionDef 3 ([99, 108, 111, 98, 98, 101, 114] : List Nat)
    ([] : List MirLocal) ([] : List MirLocal) (Just MirType MirU64) 0
    ([MirBlockDef 0 ([] : List MirInstruction) (MirReturn (Just MirValue (mir_fixture_nat MirU64 9)))] : List MirBlock);
def mir_fixture_sum : MirFunction := MirFunctionDef 2 ([115, 117, 109, 54] : List Nat) mir_fixture_six_args
    ([MirLocalDef 10 MirU64, MirLocalDef 11 MirU64] : List MirLocal) (Just MirType MirU64) 0
    ([MirBlockDef 0 (Cons MirInstruction (MirCall MirMayGc (Just Nat 11) (MirDirect 3) ([] : List MirValue)) mir_fixture_sum_ops)
      (MirReturn (Just MirValue (MirUse 10)))] : List MirBlock);

def mir_fixture_pid : MirExtern := MirExternDef MirNoGc 1001
    ([71, 101, 116, 67, 117, 114, 114, 101, 110, 116, 80, 114, 111, 99, 101, 115, 115, 73, 100] : List Nat)
    (MirSignatureOf ([] : List MirType) (Just MirType MirU32));
def mir_fixture_managed : MirFunction := MirFunctionDef 4 ([114, 111, 111, 116] : List Nat)
    ([MirLocalDef 0 MirManagedPtr] : List MirLocal) ([MirLocalDef 1 MirManagedPtr, MirLocalDef 2 MirU64] : List MirLocal)
    (Just MirType MirManagedPtr) 0 ([MirBlockDef 0
      ([MirMove 1 (MirUse 0), MirCall MirMayGc (Just Nat 2) (MirDirect 3) ([] : List MirValue)] : List MirInstruction)
      (MirReturn (Just MirValue (MirUse 1)))] : List MirBlock);

def mir_fixture_calls : MirProgram := MirProgramDef
    ([mir_fixture_assert_function
      ([MirLocalDef 10 MirU64, MirLocalDef 11 MirU64, MirLocalDef 12 MirRawPtr,
        MirLocalDef 13 MirU32, MirLocalDef 14 MirU32, MirLocalDef 15 MirManagedPtr] : List MirLocal)
      (managed_fixture_join ([
        mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 10) (MirDirect 2) (mir_fixture_six_values 1)) 10 (mir_fixture_nat MirU64 21),
        ([MirAddress 12 2] : List MirInstruction),
        mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 11) (MirIndirect mir_fixture_six_signature (MirUse 12))
          (mir_fixture_six_values 2)) 11 (mir_fixture_nat MirU64 42),
        mir_fixture_expect (MirUse 10) (mir_fixture_nat MirU64 21),
        mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 11) (MirDirect 2)
          ([mir_fixture_nat MirU64 1, mir_fixture_nat MirU64 0, mir_fixture_nat MirU64 0, mir_fixture_nat MirU64 0,
            mir_fixture_bits MirU64 (pe_word32 2) (pe_word32 1), mir_fixture_bits MirU64 (pe_word32 3) (pe_word32 1)] : List MirValue)) 11
          (mir_fixture_bits MirU64 (pe_word32 6) (pe_word32 2)),
        ([MirCall MirMayGc (Just Nat 13) (MirDirect 1001) ([] : List MirValue), MirAddress 12 1001,
          MirCall MirMayGc (Just Nat 14) (MirIndirect (MirSignatureOf ([] : List MirType) (Just MirType MirU32)) (MirUse 12)) ([] : List MirValue)] : List MirInstruction),
        mir_fixture_expect (MirUse 13) (MirUse 14),
        mir_fixture_assert_ops (MirCompare 90 MirGreater (MirUse 13) (mir_fixture_nat MirU32 0)) 90 (mir_fixture_nat MirU8 1),
        mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 15) (MirDirect 4) ([mir_fixture_nat MirManagedPtr 0] : List MirValue)) 15
          (mir_fixture_nat MirManagedPtr 0)] : List (List MirInstruction))),
      mir_fixture_sum, mir_fixture_clobber, mir_fixture_managed] : List MirFunction)
    ([] : List MirData) ([mir_fixture_kernel ([mir_fixture_pid] : List MirExtern)] : List MirLibrary) 1;

def mir_fixture_large_locals : List MirLocal :=
    (fix go (count : Nat) : List MirLocal := match count with | Z => [] | S rest =>
      Cons MirLocal (MirLocalDef (add 100 count) MirU64) (go rest) end) (mul 12 256);
def mir_fixture_large_function : MirFunction := MirFunctionDef 2 ([108, 97, 114, 103, 101] : List Nat) mir_fixture_six_args
    (Cons MirLocal (MirLocalDef 10 MirU64) (Cons MirLocal (MirLocalDef 20 MirManagedPtr) mir_fixture_large_locals))
    (Just MirType MirU64) 0 ([MirBlockDef 0 mir_fixture_sum_ops (MirReturn (Just MirValue (MirUse 10)))] : List MirBlock);
def mir_fixture_lookup : MirExtern := MirExternDef MirNoGc 1002
    ([82, 116, 108, 76, 111, 111, 107, 117, 112, 70, 117, 110, 99, 116, 105, 111, 110, 69, 110, 116, 114, 121] : List Nat)
    (MirSignatureOf ([MirRawPtr, MirRawPtr, MirRawPtr] : List MirType) (Just MirType MirRawPtr));
def mir_fixture_large : MirProgram := MirProgramDef
    ([mir_fixture_assert_function ([MirLocalDef 10 MirU64, MirLocalDef 11 MirRawPtr, MirLocalDef 12 MirRawPtr, MirLocalDef 13 MirRawPtr] : List MirLocal)
      (managed_fixture_join ([
        mir_fixture_assert_ops (MirCall MirMayGc (Just Nat 10) (MirDirect 2) (mir_fixture_six_values 2)) 10 (mir_fixture_nat MirU64 42),
        ([MirAddress 11 2, MirPointerAdd 11 (MirUse 11) (mir_fixture_nat MirUSize 13), MirAddress 12 200,
          MirCall MirMayGc (Just Nat 13) (MirDirect 1002) ([MirUse 11, MirUse 12, mir_fixture_nat MirRawPtr 0] : List MirValue)] : List MirInstruction),
        mir_fixture_assert_ops (MirCompare 90 MirNotEqual (MirUse 13) (mir_fixture_nat MirRawPtr 0)) 90 (mir_fixture_nat MirU8 1)]
          : List (List MirInstruction))), mir_fixture_large_function] : List MirFunction)
    ([MirDataDef 200 True (pe_zeros 8)] : List MirData)
    ([mir_fixture_kernel ([] : List MirExtern), MirLibraryDef ([110, 116, 100, 108, 108, 46, 100, 108, 108] : List Nat)
      ([mir_fixture_lookup] : List MirExtern)] : List MirLibrary) 1;

def mir_fixture_trap (operation : MirBinary) (ty : MirType) (left : MirValue) (right : MirValue) : MirProgram :=
    mir_fixture_program (mir_fixture_function ([MirLocalDef 10 ty] : List MirLocal)
      ([MirBlockDef 0 ([MirBinaryOp 10 operation left right, mir_fixture_exit_call 99] : List MirInstruction) MirTrap] : List MirBlock));

def mir_fixture_stdout : MirProgram := MirProgramDef
    ([mir_fixture_assert_function
      ([MirLocalDef 10 MirRawPtr, MirLocalDef 11 MirRawPtr, MirLocalDef 12 MirRawPtr, MirLocalDef 13 MirI32, MirLocalDef 14 MirU32] : List MirLocal)
      (managed_fixture_join ([
        ([MirCall MirMayGc (Just Nat 10) (MirDirect 1001) ([mir_fixture_u32 (X64Bytes32 245 255 255 255)] : List MirValue),
          MirAddress 11 200, MirAddress 12 201,
          MirCall MirMayGc (Just Nat 13) (MirDirect 1002)
            ([MirUse 10, MirUse 11, mir_fixture_nat MirU32 11, MirUse 12, mir_fixture_nat MirRawPtr 0] : List MirValue)] : List MirInstruction),
        mir_fixture_assert_ops (MirCompare 90 MirNotEqual (MirUse 13) (mir_fixture_nat MirI32 0)) 90 (mir_fixture_nat MirU8 1),
        mir_fixture_assert_ops (MirLoad 14 (MirUse 12) (codegen_disp 0)) 14 (mir_fixture_nat MirU32 11)] : List (List MirInstruction)))]
      : List MirFunction)
    ([MirDataDef 200 False ([110, 97, 116, 105, 118, 101, 32, 109, 105, 114, 10] : List Nat), MirDataDef 201 True (pe_zeros 8)] : List MirData)
    ([mir_fixture_kernel ([
      MirExternDef MirNoGc 1001 ([71, 101, 116, 83, 116, 100, 72, 97, 110, 100, 108, 101] : List Nat)
        (MirSignatureOf ([MirU32] : List MirType) (Just MirType MirRawPtr)),
      MirExternDef MirNoGc 1002 ([87, 114, 105, 116, 101, 70, 105, 108, 101] : List Nat)
        (MirSignatureOf ([MirRawPtr, MirRawPtr, MirU32, MirRawPtr, MirRawPtr] : List MirType) (Just MirType MirI32))]
          : List MirExtern)] : List MirLibrary) 1;
