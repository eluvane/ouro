-- Package scanner laws preserve quote/comment and rolling digest behavior.
import "../tools/pkg/model.ouro";
import "../std/test.ouro";

def pkg_scanner_rejects (text : String) : Bool :=
    match seal_parse text with | Nothing => True | Just _ => False end;

def pkg_scanner_name (text : String) : String :=
    match seal_parse text with
    | Nothing => "parse failed"
    | Just doc => seal_field_text (seal_block_named doc "project") "name" "missing name"
    end;

def main : IO Unit := test_run
    [ assert_eq "seal empty scanner input" (seal_cut_line "") ""
    , assert_eq "seal hash comment outside quotes" (seal_cut_line " name = alpha-beta # ignored") "name = alpha-beta"
    , assert_eq "seal dash comment outside quotes" (seal_cut_line "name = alpha-beta -- ignored") "name = alpha-beta"
    , assert_eq "seal double quotes retain comment markers" (seal_cut_line "name = \"a#b--c\" # ignored") "name = \"a#b--c\""
    , assert_eq "seal single quote scanner state retains markers" (seal_cut_line "name = 'a#b--c' -- ignored") "name = 'a#b--c'"
    , assert_eq "seal other quote does not close the active quote" (seal_cut_line "name = \"a'b#c\" -- ignored") "name = \"a'b#c\""
    , assert_eq "seal lone final dash is not a comment" (seal_cut_line "name = alpha-") "name = alpha-"
    , assert_eq "seal parser retains quoted markers across comments"
        (pkg_scanner_name "seal 1 # header\nproject { -- block\nname = \"a#b--c\" # value\n}\n") "a#b--c"
    , assert_true "seal unterminated quote remains invalid"
        (pkg_scanner_rejects "seal 1\nproject {\nname = \"a#b\n}\n")
    , assert_true "seal single quoted values remain invalid"
        (pkg_scanner_rejects "seal 1\nproject {\nname = 'a'\n}\n")
    , assert_true "seal duplicate fields remain invalid"
        (pkg_scanner_rejects "seal 1\nproject {\nname = \"a\"\nname = \"b\"\n}\n")
    , assert_true "seal duplicate blocks remain invalid"
        (pkg_scanner_rejects "seal 1\nproject {\n}\nproject {\n}\n")
    , assert_true "seal unsupported version remains invalid"
        (pkg_scanner_rejects "seal 2\nproject {\n}\n")
    , assert_eq "digest starts from the retained seed" (digest_show digest_empty) "files=0,bytes=0,mix=1"
    , assert_eq "digest mixes path before body" (digest_show (digest_step digest_empty "a" "b")) "files=1,bytes=1,mix=4098"
    , assert_eq "digest includes empty-file paths" (digest_show (digest_step digest_empty "a" "")) "files=1,bytes=0,mix=129"
    , assert_eq "digest rename changes the rolling mix" (digest_show (digest_step digest_empty "b" "b")) "files=1,bytes=1,mix=4129"
    , assert_eq "digest preserves file order" (digest_show (digest_step (digest_step digest_empty "a" "b") "c" "d")) "files=2,bytes=2,mix=3941379"
    , assert_eq "digest reverse order has a different mix" (digest_show (digest_step (digest_step digest_empty "c" "d") "a" "b")) "files=2,bytes=2,mix=4002819"
    , assert_eq "digest modulus remains unchanged" (show_nat (digest_mix_codes ([0] : List Nat) (sub digest_mod 1))) "16777183"
    ];
