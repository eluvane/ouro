-- Known x86-64 encodings, signed displacement boundaries, and rejected inputs.
-- Expected bytes follow Intel SDM vol. 2 opcode/ModR/M tables, independently
-- inspectable with objdump -D -b binary -m i386:x86-64 -M intel.

import "../compiler/native/x64.ouro",
  "../std/test.ouro";

inductive X64TestVector : Type :=
  | X64Vector : String -> X64Instruction -> List Nat -> X64TestVector;

def x64_test_zero : X64Displacement := X64Forward (X64Bytes32 0 0 0 0);

def x64_test_positive (value : Nat) : X64Displacement := X64Forward (X64Bytes32 value 0 0 0);

def x64_test_negative (value : Nat) : X64Displacement := X64Backward (X64Bytes32 value 0 0 0);

def x64_test_bytes_equal (left : List Nat) (right : List Nat) : Bool :=
    str_eq (str_join(",", map Nat String str_of_nat left))
      (str_join(",", map Nat String str_of_nat right));

def x64_test_vectors : List X64TestVector :=
    [ X64Vector("mov eax immediate", X64MovImm32(X64Rax, X64Bytes32 120 86 52 18), [184, 120, 86, 52, 18] : List Nat)
    , X64Vector("mov r15d immediate", X64MovImm32(X64R15, X64Bytes32 255 255 255 255), [65, 191, 255, 255, 255, 255] : List Nat)
    , X64Vector("mov rax full immediate", X64MovImm64(X64Rax, X64Words64(X64Bytes32 136 119 102 85, X64Bytes32 68 51 34 17)), [72, 184, 136, 119, 102, 85, 68, 51, 34, 17] : List Nat)
    , X64Vector("mov r15 full immediate", X64MovImm64(X64R15, X64Words64(X64Bytes32 255 255 255 255, X64Bytes32 255 255 255 255)), [73, 191, 255, 255, 255, 255, 255, 255, 255, 255] : List Nat)
    , X64Vector("mov eax ecx", X64Mov X64Bits32 X64Rax X64Rcx, [137, 200] : List Nat)
    , X64Vector("mov eax r8d REX.R", X64Mov X64Bits32 X64Rax X64R8, [68, 137, 192] : List Nat)
    , X64Vector("mov r9d eax REX.B", X64Mov X64Bits32 X64R9 X64Rax, [65, 137, 193] : List Nat)
    , X64Vector("mov r9 r10 REX.WRB", X64Mov X64Bits64 X64R9 X64R10, [77, 137, 209] : List Nat)
    , X64Vector("load rax from rbx", X64Load X64Bits64 X64Rax (X64Base X64Rbx x64_test_zero), [72, 139, 3] : List Nat)
    , X64Vector("load eax from rsp SIB", X64Load X64Bits32 X64Rax (X64Base X64Rsp x64_test_zero), [139, 4, 36] : List Nat)
    , X64Vector("load rax from r12 SIB", X64Load X64Bits64 X64Rax (X64Base X64R12 x64_test_zero), [73, 139, 4, 36] : List Nat)
    , X64Vector("load rax from rbp zero disp8", X64Load X64Bits64 X64Rax (X64Base X64Rbp x64_test_zero), [72, 139, 69, 0] : List Nat)
    , X64Vector("load r8 from r13 zero disp8", X64Load X64Bits64 X64R8 (X64Base X64R13 x64_test_zero), [77, 139, 69, 0] : List Nat)
    , X64Vector("store r9 to rsp plus 32", X64Store X64Bits64 (X64Base(X64Rsp, x64_test_positive 32)) X64R9, [76, 137, 76, 36, 32] : List Nat)
    , X64Vector("store ecx to rbx minus 8", X64Store X64Bits32 (X64Base(X64Rbx, x64_test_negative 8)) X64Rcx, [137, 75, 248] : List Nat)
    , X64Vector("load disp8 positive maximum", X64Load X64Bits64 X64Rax (X64Base(X64Rbx, x64_test_positive 127)), [72, 139, 67, 127] : List Nat)
    , X64Vector("load positive 128 uses disp32", X64Load X64Bits64 X64Rax (X64Base(X64Rbx, x64_test_positive 128)), [72, 139, 131, 128, 0, 0, 0] : List Nat)
    , X64Vector("load disp8 negative minimum", X64Load X64Bits64 X64Rax (X64Base(X64Rbx, x64_test_negative 128)), [72, 139, 67, 128] : List Nat)
    , X64Vector("load negative 129 uses disp32", X64Load X64Bits64 X64Rax (X64Base(X64Rbx, x64_test_negative 129)), [72, 139, 131, 127, 255, 255, 255] : List Nat)
    , X64Vector("load negative 256 carries", X64Load X64Bits64 X64Rax (X64Base(X64Rbx, X64Backward (X64Bytes32 0 1 0 0))), [72, 139, 131, 0, 255, 255, 255] : List Nat)
    , X64Vector("negative zero has no disp", X64Load X64Bits64 X64Rax (X64Base(X64Rbx, x64_test_negative 0)), [72, 139, 3] : List Nat)
    , X64Vector("SIB scale1", X64Load X64Bits64 X64Rax (X64Indexed X64Rbx X64Rcx X64Scale1 x64_test_zero), [72, 139, 4, 11] : List Nat)
    , X64Vector("SIB scale2", X64Load X64Bits64 X64Rax (X64Indexed X64Rbx X64Rcx X64Scale2 x64_test_zero), [72, 139, 4, 75] : List Nat)
    , X64Vector("SIB scale4", X64Load X64Bits64 X64Rax (X64Indexed X64Rbx X64Rcx X64Scale4 x64_test_zero), [72, 139, 4, 139] : List Nat)
    , X64Vector("SIB scale8 with rbp disp8", X64Load X64Bits64 X64Rax (X64Indexed X64Rbp X64Rcx X64Scale8 x64_test_zero), [72, 139, 68, 205, 0] : List Nat)
    , X64Vector("SIB r12 is a valid index REX.X", X64Load X64Bits64 X64Rax (X64Indexed X64Rbx X64R12 X64Scale2 x64_test_zero), [74, 139, 4, 99] : List Nat)
    , X64Vector("SIB REX.WRXB", X64Load X64Bits64 X64R10 (X64Indexed X64R13 X64R9 X64Scale4 (x64_test_negative 128)), [79, 139, 84, 141, 128] : List Nat)
    , X64Vector("SIB store REX.WRXB", X64Store X64Bits64 (X64Indexed X64R12 X64R15 X64Scale8 (x64_test_positive 128)) X64R11, [79, 137, 156, 252, 128, 0, 0, 0] : List Nat)
    , X64Vector("RIP-relative load", X64Load X64Bits64 X64R9 (X64Rip (x64_test_negative 4)), [76, 139, 13, 252, 255, 255, 255] : List Nat)
    , X64Vector("lea rax rsp plus 32", X64Lea(X64Rax, X64Base(X64Rsp, x64_test_positive 32)), [72, 141, 68, 36, 32] : List Nat)
    , X64Vector("add rax rcx", X64ArithmeticReg X64Bits64 X64Add X64Rax X64Rcx, [72, 1, 200] : List Nat)
    , X64Vector("or eax ecx", X64ArithmeticReg X64Bits32 X64Or X64Rax X64Rcx, [9, 200] : List Nat)
    , X64Vector("and r9 r10", X64ArithmeticReg X64Bits64 X64And X64R9 X64R10, [77, 33, 209] : List Nat)
    , X64Vector("sub rsp rax", X64ArithmeticReg X64Bits64 X64Subtract X64Rsp X64Rax, [72, 41, 196] : List Nat)
    , X64Vector("xor r8d r8d", X64ArithmeticReg X64Bits32 X64Xor X64R8 X64R8, [69, 49, 192] : List Nat)
    , X64Vector("cmp rax rcx", X64ArithmeticReg X64Bits64 X64Compare X64Rax X64Rcx, [72, 57, 200] : List Nat)
    , X64Vector("add rax sign-extended minus one", X64ArithmeticImm32 X64Bits64 X64Add X64Rax (X64Bytes32 255 255 255 255), [72, 129, 192, 255, 255, 255, 255] : List Nat)
    , X64Vector("sub rsp immediate", X64ArithmeticImm32 X64Bits64 X64Subtract X64Rsp (X64Bytes32 32 0 0 0), [72, 129, 236, 32, 0, 0, 0] : List Nat)
    , X64Vector("cmp r15d immediate", X64ArithmeticImm32 X64Bits32 X64Compare X64R15 (X64Bytes32 0 0 0 128), [65, 129, 255, 0, 0, 0, 128] : List Nat)
    , X64Vector("imul r9 r10", X64Multiply X64Bits64 X64R9 (X64RegisterOperand X64R10), [77, 15, 175, 202] : List Nat)
    , X64Vector("imul eax memory", X64Multiply X64Bits32 X64Rax (X64MemoryOperand (X64Base X64Rbx x64_test_zero)), [15, 175, 3] : List Nat)
    , X64Vector("div ecx", X64Divide X64Bits32 X64Unsigned (X64RegisterOperand X64Rcx), [247, 241] : List Nat)
    , X64Vector("div r8", X64Divide X64Bits64 X64Unsigned (X64RegisterOperand X64R8), [73, 247, 240] : List Nat)
    , X64Vector("idiv r9", X64Divide X64Bits64 X64Signed (X64RegisterOperand X64R9), [73, 247, 249] : List Nat)
    , X64Vector("idiv memory32", X64Divide X64Bits32 X64Signed (X64MemoryOperand (X64Base(X64Rbp, x64_test_negative 4))), [247, 125, 252] : List Nat)
    , X64Vector("cdq", X64SignExtendDividend X64Bits32, [153] : List Nat)
    , X64Vector("cqo", X64SignExtendDividend X64Bits64, [72, 153] : List Nat)
    , X64Vector("shl rax one", X64ShiftImm X64Bits64 X64ShiftLeft X64Rax 1, [72, 209, 224] : List Nat)
    , X64Vector("shr eax 31", X64ShiftImm X64Bits32 X64ShiftRight X64Rax 31, [193, 232, 31] : List Nat)
    , X64Vector("sar r15 63", X64ShiftImm X64Bits64 X64ShiftArithmeticRight X64R15 63, [73, 193, 255, 63] : List Nat)
    , X64Vector("shl eax zero retains instruction", X64ShiftImm X64Bits32 X64ShiftLeft X64Rax 0, [193, 224, 0] : List Nat)
    , X64Vector("shl rax cl", X64ShiftCL X64Bits64 X64ShiftLeft X64Rax, [72, 211, 224] : List Nat)
    , X64Vector("shr r8d cl", X64ShiftCL X64Bits32 X64ShiftRight X64R8, [65, 211, 232] : List Nat)
    , X64Vector("sar r9 cl", X64ShiftCL X64Bits64 X64ShiftArithmeticRight X64R9, [73, 211, 249] : List Nat)
    , X64Vector("call relative plus 1", X64CallRelative (x64_test_positive 1), [232, 1, 0, 0, 0] : List Nat)
    , X64Vector("jmp relative minus 5", X64JumpRelative (x64_test_negative 5), [233, 251, 255, 255, 255] : List Nat)
    , X64Vector("rel32 maximum", X64CallRelative (X64Forward (X64Bytes32 255 255 255 127)), [232, 255, 255, 255, 127] : List Nat)
    , X64Vector("rel32 minimum", X64JumpRelative (X64Backward (X64Bytes32 0 0 0 128)), [233, 0, 0, 0, 128] : List Nat)
    , X64Vector("jge relative minus one", X64JumpIf(X64GreaterEqual, x64_test_negative 1), [15, 141, 255, 255, 255, 255] : List Nat)
    , X64Vector("call rax implicit 64-bit width", X64CallIndirect (X64RegisterOperand X64Rax), [255, 208] : List Nat)
    , X64Vector("jmp r11 implicit 64-bit width", X64JumpIndirect (X64RegisterOperand X64R11), [65, 255, 227] : List Nat)
    , X64Vector("call IAT RIP-relative memory", X64CallIndirect (X64MemoryOperand (X64Rip (x64_test_positive 8))), [255, 21, 8, 0, 0, 0] : List Nat)
    , X64Vector("jmp r12 memory", X64JumpIndirect (X64MemoryOperand (X64Base X64R12 x64_test_zero)), [65, 255, 36, 36] : List Nat)
    , X64Vector("tail jmp rax memory has unwind marker", X64TailJumpIndirect (X64Base X64Rax x64_test_zero), [72, 255, 32] : List Nat)
    , X64Vector("tail jmp r11 memory has unwind marker", X64TailJumpIndirect (X64Base X64R11 x64_test_zero), [73, 255, 35] : List Nat)
    , X64Vector("tail jmp r12 SIB memory has unwind marker", X64TailJumpIndirect (X64Base X64R12 x64_test_zero), [73, 255, 36, 36] : List Nat)
    , X64Vector("push rax", X64Push X64Rax, [80] : List Nat)
    , X64Vector("push rcx", X64Push X64Rcx, [81] : List Nat)
    , X64Vector("push rdx", X64Push X64Rdx, [82] : List Nat)
    , X64Vector("push rbx", X64Push X64Rbx, [83] : List Nat)
    , X64Vector("push rsp", X64Push X64Rsp, [84] : List Nat)
    , X64Vector("push rbp", X64Push X64Rbp, [85] : List Nat)
    , X64Vector("push rsi", X64Push X64Rsi, [86] : List Nat)
    , X64Vector("push rdi", X64Push X64Rdi, [87] : List Nat)
    , X64Vector("push r8", X64Push X64R8, [65, 80] : List Nat)
    , X64Vector("push r9", X64Push X64R9, [65, 81] : List Nat)
    , X64Vector("push r10", X64Push X64R10, [65, 82] : List Nat)
    , X64Vector("push r11", X64Push X64R11, [65, 83] : List Nat)
    , X64Vector("push r12", X64Push X64R12, [65, 84] : List Nat)
    , X64Vector("push r13", X64Push X64R13, [65, 85] : List Nat)
    , X64Vector("push r14", X64Push X64R14, [65, 86] : List Nat)
    , X64Vector("push r15", X64Push X64R15, [65, 87] : List Nat)
    , X64Vector("pop rdi", X64Pop X64Rdi, [95] : List Nat)
    , X64Vector("pop r15", X64Pop X64R15, [65, 95] : List Nat)
    , X64Vector "return" X64Return ([195] : List Nat)
    , X64Vector "trap ud2" X64Trap ([15, 11] : List Nat)
    ];

def x64_test_vector (vector : X64TestVector) : Test :=
    match vector with
    | X64Vector name instruction expected =>
      match x64_encode instruction with
      | Left _ => test_fail name "encoding unexpectedly rejected"
      | Right bytes => assert_eq name
          (str_join(",", map Nat String str_of_nat bytes))
          (str_join(",", map Nat String str_of_nat expected))
      end
    end;

def x64_test_error_code (err : X64EncodeError) : Nat :=
    match err with
    | X64ByteOutOfRange _ => 1
    | X64DisplacementOutOfRange => 2
    | X64StackPointerIndex => 3
    | X64ShiftOutOfRange _ _ => 4
    end;

def x64_test_rejected (name : String) (instruction : X64Instruction) (expected_code : Nat) : Test :=
    match x64_encode instruction with
    | Left err => assert_eq(name, str_of_nat (x64_test_error_code err), str_of_nat expected_code)
    | Right _ => test_fail name "invalid instruction accepted"
    end;

def x64_test_conditions : List X64Condition :=
    [ X64Overflow, X64NotOverflow, X64Below, X64AboveEqual
    , X64Equal, X64NotEqual, X64BelowEqual, X64Above
    , X64Negative, X64Nonnegative, X64Parity, X64NotParity
    , X64Less, X64GreaterEqual, X64LessEqual, X64Greater
    ];

def x64_test_all_conditions : Bool :=
    (fix go (conditions : List X64Condition) (opcode : Nat) : Bool :=
      match conditions with
      | Nil => eq_nat opcode 144
      | Cons condition rest =>
        match x64_encode (X64JumpIf condition x64_test_zero) with
        | Left _ => False
        | Right bytes => andb(x64_test_bytes_equal(bytes, [15, opcode, 0, 0, 0, 0] : List Nat), go(rest, S opcode))
        end
      end) x64_test_conditions 128;

def x64_test_failed_block : Bool :=
    match x64_encode_block ([X64Return, X64ShiftImm X64Bits32 X64ShiftLeft X64Rax 32, X64Trap] : List X64Instruction) with
    | Left err => eq_nat(x64_test_error_code err, 4)
    | Right _ => False
    end;

def x64_test_successful_block : Bool :=
    match x64_encode_block ([X64Push X64Rbp, X64Mov X64Bits64 X64Rbp X64Rsp, X64Pop X64Rbp, X64Return] : List X64Instruction) with
    | Left _ => False
    | Right bytes => x64_test_bytes_equal(bytes, [85, 72, 137, 229, 93, 195] : List Nat)
    end;

def x64_test_errors : List Test :=
    [ x64_test_rejected "immediate byte0 exceeds 255" (X64MovImm32(X64Rax, X64Bytes32 256 0 0 0)) 1
    , x64_test_rejected "immediate byte1 exceeds 255" (X64MovImm32(X64Rax, X64Bytes32 0 256 0 0)) 1
    , x64_test_rejected "immediate byte2 exceeds 255" (X64MovImm32(X64Rax, X64Bytes32 0 0 256 0)) 1
    , x64_test_rejected "immediate byte3 exceeds 255" (X64MovImm32(X64Rax, X64Bytes32 0 0 0 256)) 1
    , x64_test_rejected "immediate high word invalid" (X64MovImm64(X64Rax, X64Words64(X64Bytes32 0 0 0 0, X64Bytes32 0 0 0 256))) 1
    , x64_test_rejected "arithmetic immediate invalid" (X64ArithmeticImm32 X64Bits64 X64And X64Rax (X64Bytes32 0 0 256 0)) 1
    , x64_test_rejected "rel32 positive overflow" (X64CallRelative (X64Forward (X64Bytes32 0 0 0 128))) 2
    , x64_test_rejected "rel32 negative overflow" (X64JumpRelative (X64Backward (X64Bytes32 1 0 0 128))) 2
    , x64_test_rejected "conditional rel32 overflow" (X64JumpIf(X64Equal, X64Forward (X64Bytes32 255 255 255 255))) 2
    , x64_test_rejected "load displacement overflow" (X64Load X64Bits32 X64Rax (X64Base(X64Rbp, X64Forward (X64Bytes32 0 0 0 128)))) 2
    , x64_test_rejected "RIP displacement overflow" (X64Load X64Bits64 X64Rax (X64Rip (X64Backward (X64Bytes32 0 1 0 128)))) 2
    , x64_test_rejected "tail memory displacement overflow" (X64TailJumpIndirect (X64Base(X64R11, X64Forward (X64Bytes32 0 0 0 128)))) 2
    , x64_test_rejected "displacement invalid byte" (X64JumpRelative (X64Forward (X64Bytes32 256 0 0 0))) 1
    , x64_test_rejected "rsp cannot be SIB index" (X64Load X64Bits64 X64Rax (X64Indexed X64Rbx X64Rsp X64Scale1 x64_test_zero)) 3
    , x64_test_rejected "shift32 count32 rejected" (X64ShiftImm X64Bits32 X64ShiftLeft X64Rax 32) 4
    , x64_test_rejected "shift64 count64 rejected" (X64ShiftImm X64Bits64 X64ShiftRight X64Rax 64) 4
    , x64_test_rejected "shift count byte overflow rejected" (X64ShiftImm X64Bits64 X64ShiftArithmeticRight X64Rax 256) 4
    , assert_true "all sixteen condition opcodes" x64_test_all_conditions
    , assert_true "block failure returns no prefix" x64_test_failed_block
    , assert_true "block preserves instruction order" x64_test_successful_block
    ];

-- --vectors prints the actual encoder bytes for independent disassembly. This
-- is a development inspection path; the default run always executes assertions.
def x64_test_dump_vector (vector : X64TestVector) : IO Unit :=
    match vector with
    | X64Vector name instruction _ =>
      match x64_encode instruction with
      | Left _ => do println (str_concat "ERROR " name); exit 1
      | Right bytes => println (str_cat3 name "|" (str_join(",", map Nat String str_of_nat bytes)))
      end
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match elem String str_eq "--vectors" arguments with
       | True => io_foreach X64TestVector x64_test_dump_vector x64_test_vectors
       | False => test_run (append Test (map X64TestVector Test x64_test_vector x64_test_vectors) x64_test_errors)
       end
