-- Native test policy laws; actual process/input behavior has runtime probes.
import "../tools/test/common.ouro";
import "analyze/precision/assertions.ouro";

def native_test_process_laws : List (Pair String Bool) :=
    [ MkPair String Bool "native-test-process/check-literal-path"
        (list_eq String str_eq (test_check_arguments "C:\\source 雪\\a.ouro" False) ["check", "C:\\source 雪\\a.ouro"])
    , MkPair String Bool "native-test-process/suite-retains-fuel"
        (list_eq String str_eq (test_check_arguments "sample.ouro" True) ["check", "sample.ouro", "999999"])
    , MkPair String Bool "native-test-process/build-native-argv"
        (list_eq String str_eq (test_build_arguments "source & 雪.ouro" "out dir/a.exe") ["build", "source & 雪.ouro", "--out", "out dir/a.exe"])
    , MkPair String Bool "native-test-process/native-pe-output-name"
        (str_eq (test_binary_path "out dir" "fixture") "out dir/fixture.exe")
    , MkPair String Bool "native-test-process/child-exit-0"
        (test_process_exit_is (Right NativeTestProcessError ProcResult (MkProcResult 0 "" "")) 0)
    , MkPair String Bool "native-test-process/child-exit-1"
        (test_process_exit_is (Right NativeTestProcessError ProcResult (MkProcResult 1 "" "")) 1)
    , MkPair String Bool "native-test-process/child-exit-37"
        (test_process_exit_is (Right NativeTestProcessError ProcResult (MkProcResult 37 "" "")) 37)
    , MkPair String Bool "native-test-process/child-exit-259"
        (test_process_exit_is (Right NativeTestProcessError ProcResult (MkProcResult 259 "" "")) 259)
    , MkPair String Bool "native-test-process/child-u32-exit"
        (test_process_exit_is (Right NativeTestProcessError ProcResult (MkProcResult (sub (pow_nat 2 32) 1) "" "")) (sub (pow_nat 2 32) 1))
    , MkPair String Bool "native-test-process/child-wrong-exit"
        (notb (test_process_exit_is (Right NativeTestProcessError ProcResult (MkProcResult 259 "" "")) 1))
    , MkPair String Bool "native-test-process/infra-os-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureOsError 1))) 1))
    , MkPair String Bool "native-test-process/infra-timeout-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureTimedOut 1 "CHECK_OK" "CErr code=41"))) 1))
    , MkPair String Bool "native-test-process/infra-cleanup-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureCleanupFailed 1))) 1))
    , MkPair String Bool "native-test-process/infra-memory-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureResourceLimit 1 1 "CHECK_OK" "CErr code=41"))) 1))
    , MkPair String Bool "native-test-process/infra-stdout-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureOutputLimit CaptureStdout 1 2))) 1))
    , MkPair String Bool "native-test-process/infra-stderr-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureOutputLimit CaptureStderr 1 2))) 1))
    , MkPair String Bool "native-test-process/infra-limits-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureInvalidLimits CaptureTimeoutLimit))) 1))
    , MkPair String Bool "native-test-process/infra-protocol-cannot-be-negative-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestCaptureError "fixture.exe" (ProcessCaptureProtocolError 1))) 1))
    , MkPair String Bool "native-test-process/missing-sibling-cannot-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestSiblingError (NativeSiblingParentError "bare.exe"))) 1))
    , MkPair String Bool "native-test-process/input-read-cannot-pass"
        (notb (test_process_exit_is (Left NativeTestProcessError ProcResult (NativeTestInputError "in" (FsMissing "in"))) 1))
    , MkPair String Bool "native-test-process/infra-output-stays-distinct"
        (str_starts (test_process_output (Left NativeTestProcessError ProcResult (NativeTestCaptureError "child.exe" (ProcessCaptureOsError 5)))) "TEST_PROCESS_ERROR child.exe:")
    , MkPair String Bool "native-test-process/child-output-exact-bytes"
        (list_eq Nat eq_nat (str_codes (test_process_output (Right NativeTestProcessError ProcResult (MkProcResult 0 (str_from_codes [0, 255, 13]) (str_from_codes [10, 254]))))) [0, 255, 13, 10, 254])
    , MkPair String Bool "native-test-process/positive-check"
        (check_result_ok (MkProcResult 0 "CHECK_OK\n" ""))
    , MkPair String Bool "native-test-process/positive-check-stderr"
        (check_result_ok (MkProcResult 0 "" "CHECK_OK\n"))
    , MkPair String Bool "native-test-process/nonzero-marker-rejected"
        (notb (check_result_ok (MkProcResult 1 "CHECK_OK" "")))
    , MkPair String Bool "native-test-process/conflicting-marker-rejected"
        (notb (check_result_ok (MkProcResult 0 "CHECK_OK" "CHECK_FAIL")))
    , MkPair String Bool "native-test-process/empty-success-rejected"
        (notb (check_result_ok (MkProcResult 0 "" "")))
    , MkPair String Bool "native-test-process/negative-exact-status-diagnostic"
        (test_process_rejected (MkProcResult 1 "" "CErr code=41") "CErr code=41")
    , MkPair String Bool "native-test-process/negative-wrong-status"
        (notb (test_process_rejected (MkProcResult 2 "" "CErr code=41") "CErr code=41"))
    , MkPair String Bool "native-test-process/negative-crash-status"
        (notb (test_process_rejected (MkProcResult 139 "" "CErr code=41") "CErr code=41"))
    , MkPair String Bool "native-test-process/negative-missing-diagnostic"
        (notb (test_process_rejected (MkProcResult 1 "" "CErr code=42") "CErr code=41"))
    , MkPair String Bool "native-test-process/negative-with-acceptance-marker"
        (notb (test_process_rejected (MkProcResult 1 "CHECK_OK" "CErr code=41") "CErr code=41"))
    , MkPair String Bool "native-test-process/prune-_build"
        (test_discovery_pruned "root/_build/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-_cache"
        (test_discovery_pruned "root/_cache/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-_opam"
        (test_discovery_pruned "root/_opam/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-_tools"
        (test_discovery_pruned "root/_tools/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-dot-git"
        (test_discovery_pruned "root/.git/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-bad"
        (test_discovery_pruned "root/bad/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-future"
        (test_discovery_pruned "root/future/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-fixtures"
        (test_discovery_pruned "root/fixtures/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-bench"
        (test_discovery_pruned "root/bench/child_test.ouro")
    , MkPair String Bool "native-test-process/prune-windows-separators"
        (test_discovery_pruned "C:\\source\\fixtures\\a_test.ouro")
    , MkPair String Bool "native-test-process/discover-positive"
        (test_discovery_selected "src/check_test.ouro")
    , MkPair String Bool "native-test-process/discover-precise-suffix"
        (notb (test_discovery_selected "src/check_tests.ouro"))
    , MkPair String Bool "native-test-process/discover-nonsource"
        (notb (test_discovery_selected "src/check_test.ouro.bak"))
    , MkPair String Bool "native-test-process/discover-directory-substring"
        (test_discovery_selected "src/fixtures2/check_test.ouro")
    ];

-- @entry main
def main : IO Unit := precision_run "native-test-process" native_test_process_laws;
