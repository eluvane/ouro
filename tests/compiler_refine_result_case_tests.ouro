-- Refiner failures preserve resource, typing and malformed-Core distinctions.

import "compiler_refine_result_fixtures.ouro";

def refine_result_case_laws : List RefineResultLaw :=
    [ MkRefineResultLaw "constructor branch preserves its body callback failure"
        (refine_result_has_kind CoreTerm 1
          (refine_branch refine_result_resource 100 refine_result_no_environment 0 refine_result_no_scope
            (Nothing CoreTerm) refine_result_nat refine_result_zero))
    , MkRefineResultLaw "case result preserves checked telescope exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_case_result refine_result_copy 0 refine_result_environment refine_result_no_scope
            (Nil CoreTerm) refine_result_ctors refine_result_bodies))
    , MkRefineResultLaw "empty match needs an explicit result type"
        (refine_result_has_kind CoreTerm 2
          (refine_case_result refine_result_copy 100 refine_result_environment refine_result_no_scope
            (Nil CoreTerm) (Nil Ctor) (Nil CoreTerm)))
    , MkRefineResultLaw "case motive preserves parameter-instantiation exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_case_motive 0 refine_result_environment checker_test_box
            ([refine_result_nat] : List CoreTerm) refine_result_zero refine_result_nat))
    , MkRefineResultLaw "case motive preserves telescope-peeling exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_case_motive 0 refine_result_environment refine_result_decl (Nil CoreTerm)
            refine_result_zero refine_result_nat))
    , MkRefineResultLaw "case motive preserves deep abstraction exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_case_motive 2 refine_result_environment refine_result_decl (Nil CoreTerm)
            refine_result_deep refine_result_deep))
    , MkRefineResultLaw "branch traversal preserves a later resource failure"
        (refine_result_has_kind (List CoreTerm) 1
          (refine_case_branches refine_result_later_resource 100 refine_result_environment refine_result_no_scope
            10 0 0 (Nil CoreTerm) (CLam refine_result_nat refine_result_nat)
            refine_result_ctors ([0, 1] : List Nat)
            ([refine_result_zero, CLam (CInd 0) (CConst 901)] : List CoreTerm) 0))
    , MkRefineResultLaw "branch list metadata stays distinct from typing failure"
        (refine_result_has_kind (List CoreTerm) 3
          (refine_case_branches refine_result_copy 100 refine_result_environment refine_result_no_scope
            10 0 0 (Nil CoreTerm) (CLam refine_result_nat refine_result_nat)
            (Nil Ctor) ([0] : List Nat) (Nil CoreTerm) 0))
    , MkRefineResultLaw "case refinement preserves scrutinee recursion exhaustion"
        (refine_result_has_kind CoreTerm 1
          (refine_term_checked 1 refine_result_sig refine_result_no_ctx
            (Just CoreTerm refine_result_nat) refine_result_case))
    , MkRefineResultLaw "case refinement preserves scrutinee-type reduction failure"
        (refine_result_has_kind CoreTerm 4
          (refine_term_checked 100 refine_result_bad_sig refine_result_no_ctx
            (Just CoreTerm refine_result_nat)
            (CCase refine_result_info (CInd 999) (CConst 90) refine_result_bodies)))
    , MkRefineResultLaw "case with a noninductive scrutinee is a typing failure"
        (refine_result_has_kind CoreTerm 2
          (refine_term_checked 100 refine_result_sig refine_result_no_ctx
            (Just CoreTerm refine_result_nat)
            (CCase refine_result_info (CInd 999) (CSort 0) refine_result_bodies)))
    , MkRefineResultLaw "case with a wrong constructor arity is malformed Core"
        (refine_result_has_kind CoreTerm 3
          (refine_term_checked 100 refine_result_sig refine_result_no_ctx
            (Just CoreTerm refine_result_nat)
            (CCase (MkCaseInfo 10 0 ([0, 2] : List Nat)) (CInd 999)
              refine_result_zero refine_result_bodies)))
    , MkRefineResultLaw "strict checking of a refined wrong value reports typing failure"
        (refine_result_has_kind Unit 2 (refine_result_check refine_result_nat (CSort 0)))
    , MkRefineResultLaw "strict checking of a refined unknown value reports malformed Core"
        (refine_result_has_kind Unit 3 (refine_result_check refine_result_nat (CConst 999)))
    , MkRefineResultLaw "synthetic lambda still refines and passes strict checking"
        (refine_result_has_kind Unit 0
          (refine_result_check refine_result_function (CLam (CInd 0) (CRel 0))))
    , MkRefineResultLaw "legacy Maybe API projects resource failure to Nothing"
        (match refine_term 0 refine_result_no_sig refine_result_no_ctx (Nothing CoreTerm) (CSort 0) with
         | Nothing => True
         | Just _ => False
         end)
    ];

-- @entry main
def main : IO Unit := refine_result_run refine_result_case_laws;
