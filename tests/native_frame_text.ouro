-- Shared NativeFrameInfo encoding for GC-budget and tail drivers.
import "../compiler/native/codegen_model.ouro",
  "../std/string.ouro",
  "../std/listx.ouro";

def native_frame_text (frame : NativeFrameInfo) : String :=
    match frame with | NativeFrameAt id allocation roots calls =>
      str_join "|" ([str_of_nat id, str_of_nat allocation,
        str_join "," (map NativeRootSlot String (fun (root : NativeRootSlot) => match root with
          | NativeRootAt local offset => str_join(":", [str_of_nat local, str_of_nat offset] : List String) end) roots),
        str_join "," (map NativeCallSite String (fun (site : NativeCallSite) => match site with
          | NativeCallAt block instruction pc => str_join ":"
              ([str_of_nat block, str_of_nat instruction, str_of_nat pc] : List String) end) calls)] : List String) end;
