import "../std/io.ouro";

def small_nat_fixture_canonical : String := "inductive Nat : Type := | Z : Nat | S : Nat -> Nat;\nrepresentation Nat := \"ouro.nat\";\ninductive Bool : Type := | True : Bool | False : Bool;\nrepresentation Bool := \"ouro.bool\";\ninductive Ordering : Type := | LT : Ordering | EQ : Ordering | GT : Ordering;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (add n' m) end;\n\ndef mul : Nat -> Nat -> Nat :=\n  fix mul (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => Z | S n' => add m (mul n' m) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n\ndef ltb_nat (n : Nat) (m : Nat) : Bool :=\n    match compareNat n m with\n    | LT => True\n    | EQ => False\n    | GT => False\n    end;\n\ndef div_nat (n : Nat) (m : Nat) : Nat :=\n    match m with\n    | Z => Z\n    | S _ =>\n      (fix go (fuel : Nat) (acc : Nat) (left : Nat) : Nat :=\n        match fuel with\n        | Z => acc\n        | S fuel2 =>\n          match ltb_nat left m with\n          | True => acc\n          | False => go fuel2 (S acc) (sub left m)\n          end\n        end) (S n) Z n\n    end;\n\ndef mod_nat (n : Nat) (m : Nat) : Nat :=\n    match m with\n    | Z => n\n    | S _ =>\n      (fix go (fuel : Nat) (left : Nat) : Nat :=\n        match fuel with\n        | Z => left\n        | S fuel2 =>\n          match ltb_nat left m with\n          | True => left\n          | False => go fuel2 (sub left m)\n          end\n        end) (S n) n\n    end;\n";

def small_nat_fixture_renamed : String := "inductive Padding : Type := | PadA : Padding | PadB : Padding;\ninductive Count : Type := | Zero : Count | Next : Count -> Count;\nrepresentation Count := \"ouro.nat\";\ninductive Truth : Type := | Yes : Truth | No : Truth;\nrepresentation Truth := \"ouro.bool\";\ninductive Relation : Type := | Before : Relation | Same : Relation | After : Relation;\n\ndef sum : Count -> Count -> Count :=\n  fix sum (n : Count) (m : Count) : Count :=\n    match n with | Zero => m | Next n' => Next (sum n' m) end;\n\ndef product : Count -> Count -> Count :=\n  fix product (n : Count) (m : Count) : Count :=\n    match n with | Zero => Zero | Next n' => sum m (product n' m) end;\n\ndef difference : Count -> Count -> Count :=\n  fix difference (n : Count) (m : Count) : Count :=\n    match n with\n    | Zero => Zero\n    | Next n' =>\n      match m with\n      | Zero => n\n      | Next m' => difference n' m'\n      end\n    end;\n\ndef relation : Count -> Count -> Relation :=\n  fix relation (n : Count) (m : Count) : Relation :=\n    match n, m with\n    | Zero, Zero => Same\n    | Zero, Next _ => Before\n    | Next _, Zero => After\n    | Next n', Next m' => relation n' m'\n    end;\n\ndef below (n : Count) (m : Count) : Truth :=\n    match relation n m with\n    | Before => Yes\n    | Same => No\n    | After => No\n    end;\n\ndef quotient (n : Count) (m : Count) : Count :=\n    match m with\n    | Zero => Zero\n    | Next _ =>\n      (fix go (fuel : Count) (acc : Count) (left : Count) : Count :=\n        match fuel with\n        | Zero => acc\n        | Next fuel2 =>\n          match below left m with\n          | Yes => acc\n          | No => go fuel2 (Next acc) (difference left m)\n          end\n        end) (Next n) Zero n\n    end;\n\ndef residue (n : Count) (m : Count) : Count :=\n    match m with\n    | Zero => n\n    | Next _ =>\n      (fix go (fuel : Count) (left : Count) : Count :=\n        match fuel with\n        | Zero => left\n        | Next fuel2 =>\n          match below left m with\n          | Yes => left\n          | No => go fuel2 (difference left m)\n          end\n        end) (Next n) n\n    end;\n";

def small_nat_fixture_changed_mul : String := "inductive Nat : Type := | Z : Nat | S : Nat -> Nat;\nrepresentation Nat := \"ouro.nat\";\ninductive Bool : Type := | True : Bool | False : Bool;\nrepresentation Bool := \"ouro.bool\";\ninductive Ordering : Type := | LT : Ordering | EQ : Ordering | GT : Ordering;\n\ndef add : Nat -> Nat -> Nat :=\n  fix add (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => S (add n' m) end;\n\ndef mul : Nat -> Nat -> Nat :=\n  fix mul (n : Nat) (m : Nat) : Nat :=\n    match n with | Z => m | S n' => add m (mul n' m) end;\n\ndef sub : Nat -> Nat -> Nat :=\n  fix sub (n : Nat) (m : Nat) : Nat :=\n    match n with\n    | Z => Z\n    | S n' =>\n      match m with\n      | Z => n\n      | S m' => sub n' m'\n      end\n    end;\n\ndef compareNat : Nat -> Nat -> Ordering :=\n  fix compareNat (n : Nat) (m : Nat) : Ordering :=\n    match n, m with\n    | Z, Z => EQ\n    | Z, S _ => LT\n    | S _, Z => GT\n    | S n', S m' => compareNat n' m'\n    end;\n\ndef ltb_nat (n : Nat) (m : Nat) : Bool :=\n    match compareNat n m with\n    | LT => True\n    | EQ => False\n    | GT => False\n    end;\n\ndef div_nat (n : Nat) (m : Nat) : Nat :=\n    match m with\n    | Z => Z\n    | S _ =>\n      (fix go (fuel : Nat) (acc : Nat) (left : Nat) : Nat :=\n        match fuel with\n        | Z => acc\n        | S fuel2 =>\n          match ltb_nat left m with\n          | True => acc\n          | False => go fuel2 (S acc) (sub left m)\n          end\n        end) (S n) Z n\n    end;\n\ndef mod_nat (n : Nat) (m : Nat) : Nat :=\n    match m with\n    | Z => n\n    | S _ =>\n      (fix go (fuel : Nat) (left : Nat) : Nat :=\n        match fuel with\n        | Z => left\n        | S fuel2 =>\n          match ltb_nat left m with\n          | True => left\n          | False => go fuel2 (sub left m)\n          end\n        end) (S n) n\n    end;\n";

