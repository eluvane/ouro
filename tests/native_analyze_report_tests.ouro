        (MkProcResult Z (str_concat native_analyze_report_clean "extra\n") "")
        "structured worker emitted unreported output")
  , MkPair String Bool "native-report/output/extra-blank-row"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_concat native_analyze_report_clean "\n") "")
        "structured worker emitted unreported output")
  , MkPair String Bool "native-report/header/delimiter-heavy-nonheader"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_concat (str_repeat "note: value: " 256)
          (str_concat "\n" native_analyze_report_clean)) "")
