-- @entry main
import "../tools/analyze/bounded_report.ouro",
  "analyze/precision/assertions.ouro", "native_analyze_wire_fixtures.ouro";

-- Synthetic wire cases do not establish native worker acceptance.

def native_analyze_report_expected : BoundedDriveExpected :=
    MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String "std/io.ouro");

def native_analyze_report_any_path : BoundedDriveExpected :=
    MkBoundedDriveExpected (Nothing String) (Just String "dataflow") (Nothing String);

def native_analyze_report_clean : String :=
    "ANALYZE_DRIVE files=1 findings=0 rejected=0 families=dataflow\n";

def native_analyze_report_found : String :=
    "ANALYZE_DRIVE files=1 findings=1 rejected=0 families=dataflow\n";

def native_analyze_report_finding (path : String) : String :=
    str_concat path
      ":6:1: warning[OURO-DF003] dataflow/alias: let-binding aliases a name\n  hint: Use the original name; the binding adds nothing.\n  witness: def main: let copy aliases a name\n";

def native_analyze_report_rejection (path : String) : String :=
    str_concat path ": structured analyzer could not build the unit: parse-fail\n";

def native_analyze_report_error_name (error : BoundedNativeReportError) : String :=
    match error with
    | BoundedNativeReportByteLimit => "byte-limit"
    | BoundedNativeReportEncoding stream => match stream with
      | CaptureStdout => "stdout-encoding" | CaptureStderr => "stderr-encoding" end
    | BoundedNativeReportNewline stream => match stream with
      | CaptureStdout => "stdout-newline" | CaptureStderr => "stderr-newline" end
    | BoundedNativeReportStatus _ => "DWORD"
    | BoundedNativeReportPolicy policy => bounded_drive_error_message policy
    end;

def native_analyze_report_error (expected : BoundedDriveExpected) (result : ProcResult)
    (message : String) : Bool :=
    match bounded_native_report_verify expected result with
    | Right _ => False
    | Left error => str_eq (native_analyze_report_error_name error) message
    end;

def native_analyze_report_accept (expected : BoundedDriveExpected) (result : ProcResult)
    (want_files : String) (want_findings : String) (want_rejected : String)
    (want_families : String) : Bool :=
    match bounded_native_report_verify expected result with
    | Left _ => False
    | Right banner => let (MkBoundedDriveBanner files findings rejected families) := banner in
        andb(str_eq files want_files, andb(str_eq findings want_findings,
          andb(str_eq rejected want_rejected, str_eq families want_families)))
    end;

def native_analyze_report_good_finding : String :=
    str_concat (native_analyze_report_finding "std/io.ouro") native_analyze_report_found;

def native_analyze_report_bad_encodings : List String :=
    native_analyze_invalid_wire_strings;

def native_analyze_report_utf8_paths : List String :=
    [ str_of_codes [194, 128], str_of_codes [224, 160, 128]
    , str_of_codes [237, 159, 191], str_of_codes [240, 144, 128, 128]
    , str_of_codes [244, 143, 191, 191] ];

def native_analyze_report_stream_bytes : Nat :=
    pow_nat 2 24;

def native_analyze_report_large_count : String :=
    str_concat "1" (str_repeat "0" 1001);

def native_analyze_report_rows : List (Pair String Bool) :=
  [ MkPair String Bool "native-report/clean/LF"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult Z native_analyze_report_clean "") "1" "0" "0" "dataflow")
  , MkPair String Bool "native-report/clean/CRLF"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult Z (str_replace native_analyze_report_clean "\n" "\r\n") "")
        "1" "0" "0" "dataflow")
  , MkPair String Bool "native-report/finding/complete-triplet"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult 1 native_analyze_report_good_finding "") "1" "1" "0" "dataflow")
  , MkPair String Bool "native-report/finding/CRLF-triplet"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult 1 (str_replace native_analyze_report_good_finding "\n" "\r\n") "")
        "1" "1" "0" "dataflow")
  , MkPair String Bool "native-report/finding/mixed-line-endings"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult 1 (str_concat (native_analyze_report_finding "std/io.ouro")
          (str_replace native_analyze_report_found "\n" "\r\n")) "") "1" "1" "0" "dataflow")
  , MkPair String Bool "native-report/finding/unicode-colon-space-path"
      (let path : String := "C:/каталог/漢字 file.ouro" in
        native_analyze_report_accept
          (MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String path))
          (MkProcResult 1 (str_concat (native_analyze_report_finding path)
            native_analyze_report_found) "") "1" "1" "0" "dataflow")
  , MkPair String Bool "native-report/finding/delimiter-text-in-path"
      (let path : String := "a: warning[noise:1:2.ouro" in
        native_analyze_report_accept
          (MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String path))
          (MkProcResult 1 (str_concat (native_analyze_report_finding path)
            native_analyze_report_found) "") "1" "1" "0" "dataflow")
  , MkPair String Bool "native-report/finding/UTF8-scalar-boundaries"
      (all String (fun (suffix : String) =>
        let path : String := str_concat "std/" suffix in
        native_analyze_report_accept
          (MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String path))
          (MkProcResult 1 (str_concat (native_analyze_report_finding path)
            native_analyze_report_found) "") "1" "1" "0" "dataflow")
        native_analyze_report_utf8_paths)
  , MkPair String Bool "native-report/finding/UTF8-advice"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult 1
          "std/io.ouro:6:1: warning[OURO-DF003] dataflow/alias: сообщение 漢字\n  hint: исправить\n  witness: имя: 漢字\nANALYZE_DRIVE files=1 findings=1 rejected=0 families=dataflow\n"
          "") "1" "1" "0" "dataflow")
  , MkPair String Bool "native-report/finding/empty-hint-and-witness"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult 1
          "std/io.ouro:6:1: warning[OURO-DF003] dataflow/alias: message\n  hint: \n  witness: \nANALYZE_DRIVE files=1 findings=1 rejected=0 families=dataflow\n"
          "") "1" "1" "0" "dataflow")
  , MkPair String Bool "native-report/finding/error-severity"
      (native_analyze_report_accept
        (MkBoundedDriveExpected (Just String "1") (Just String "trust") (Just String "std/io.ouro"))
        (MkProcResult 1
          "std/io.ouro:6:1: error[OURO-TRUST004] trust/tainted-proof-path: trusted definition reads a taint source\n  hint: Validate the input outside the trusted path, or record the review with @trust-reviewed REASON.\n  witness: def main: reads a taint source\nANALYZE_DRIVE files=1 findings=1 rejected=0 families=trust\n"
          "") "1" "1" "0" "trust")
  , MkPair String Bool "native-report/rejection/nonzero"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult 1 "ANALYZE_DRIVE files=1 findings=0 rejected=1 families=dataflow\n"
          (native_analyze_report_rejection "std/io.ouro")) "1" "0" "1" "dataflow")
  , MkPair String Bool "native-report/rejection/CRLF"
      (native_analyze_report_accept native_analyze_report_expected
        (MkProcResult 1 "ANALYZE_DRIVE files=1 findings=0 rejected=1 families=dataflow\r\n"
          (str_replace (native_analyze_report_rejection "std/io.ouro") "\n" "\r\n"))
        "1" "0" "1" "dataflow")
  , MkPair String Bool "native-report/rejection/unicode-colon-space-path"
      (let path : String := "C:/каталог/漢字 file.ouro" in
        native_analyze_report_accept
          (MkBoundedDriveExpected (Just String "1") (Just String "dataflow") (Just String path))
          (MkProcResult 1 "ANALYZE_DRIVE files=1 findings=0 rejected=1 families=dataflow\n"
            (native_analyze_report_rejection path)) "1" "0" "1" "dataflow")
  , MkPair String Bool "native-report/rejection/multiple-path-order"
      (let result : ProcResult := MkProcResult 1
        "ANALYZE_DRIVE files=2 findings=0 rejected=2 families=dataflow\n"
        (str_concat (native_analyze_report_rejection "first.ouro") (native_analyze_report_rejection "second.ouro")) in
       andb(native_analyze_report_accept native_analyze_report_any_path result "2" "0" "2" "dataflow",
         match bounded_native_report_observe result with
         | Left _ => False
         | Right observed => let (MkBoundedDriveObserved _ _ rejections _ _ _) := observed in
             precision_strings rejections ["first.ouro", "second.ouro"]
         end))
  , MkPair String Bool "native-report/aggregate/finding-rejection-and-path-order"
      (let result : ProcResult := MkProcResult 1
        (str_concat (native_analyze_report_finding "first.ouro")
          (str_concat (native_analyze_report_finding "second.ouro")
            "ANALYZE_DRIVE files=3 findings=2 rejected=1 families=dataflow\n"))
        (native_analyze_report_rejection "third.ouro") in
       andb(native_analyze_report_accept native_analyze_report_any_path result
         "3" "2" "1" "dataflow",
         match bounded_native_report_observe result with
         | Left _ => False
         | Right observed => let (MkBoundedDriveObserved _ paths rejections extra_out extra_err code) := observed in
             andb(precision_strings paths ["first.ouro", "second.ouro"],
               andb(precision_strings rejections ["third.ouro"],
                 andb(notb (orb extra_out extra_err), str_eq code "1")))
         end))
  , MkPair String Bool "native-report/families/ordered-list-retained"
      (native_analyze_report_accept
        (MkBoundedDriveExpected (Just String "1") (Just String "effects,dataflow") (Nothing String))
        (MkProcResult Z "ANALYZE_DRIVE files=1 findings=0 rejected=0 families=effects,dataflow\n" "")
        "1" "0" "0" "effects,dataflow")
  , MkPair String Bool "native-report/count/1002-digit-text-retained"
      (match bounded_native_report_observe
        (MkProcResult Z (str_concat "ANALYZE_DRIVE files="
          (str_concat native_analyze_report_large_count
            " findings=0 rejected=0 families=dataflow\n")) "") with
       | Left _ => False
       | Right observed => let (MkBoundedDriveObserved banners _ _ _ _ _) := observed in
           match banners with
           | Cons banner rest => let (MkBoundedDriveBanner files _ _ _) := banner in
               andb(nullb BoundedDriveBanner rest, str_eq files native_analyze_report_large_count)
           | Nil => False
           end
       end)
  , MkPair String Bool "native-report/bounds/exact-owned-streams"
      (bounded_native_report_size_valid native_analyze_report_stream_bytes native_analyze_report_stream_bytes)
  , MkPair String Bool "native-report/bounds/one-stream-excess"
      (andb(notb (bounded_native_report_size_valid (add native_analyze_report_stream_bytes 1) Z),
        notb (bounded_native_report_size_valid Z (add native_analyze_report_stream_bytes 1))))
  , MkPair String Bool "native-report/status/full-DWORD-retained"
      (match bounded_native_report_observe
        (MkProcResult (sub process_capture_u32_bound 1) native_analyze_report_clean "") with
       | Left _ => False
       | Right observed => let (MkBoundedDriveObserved _ _ _ _ _ code) := observed in
           str_eq code "4294967295"
       end)
  , MkPair String Bool "native-report/status/DWORD-overflow"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult process_capture_u32_bound native_analyze_report_clean "") "DWORD")
  , MkPair String Bool "native-report/status/clean-DWORD-max-rejected"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult (sub process_capture_u32_bound 1) native_analyze_report_clean "")
        "structured exit code disagrees with the completion report")
  , MkPair String Bool "native-report/encoding/stdout-invalid"
      (all String (fun (bad : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_concat bad (str_concat "\n" native_analyze_report_clean)) "")
        "stdout-encoding") native_analyze_report_bad_encodings)
  , MkPair String Bool "native-report/encoding/stderr-invalid"
      (all String (fun (bad : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z native_analyze_report_clean (str_concat bad "\n"))
        "stderr-encoding") native_analyze_report_bad_encodings)
  , MkPair String Bool "native-report/newline/unterminated-completion"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_chomp native_analyze_report_clean) "") "stdout-newline")
  , MkPair String Bool "native-report/newline/bare-CR"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_replace native_analyze_report_clean "\n" "\r") "") "stdout-newline")
  , MkPair String Bool "native-report/newline/CR-in-payload"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 (str_replace native_analyze_report_good_finding "a name" "a\rname") "")
        "stdout-newline")
  , MkPair String Bool "native-report/newline/stderr-partial"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 "ANALYZE_DRIVE files=1 findings=0 rejected=1 families=dataflow\n"
          (str_chomp (native_analyze_report_rejection "std/io.ouro"))) "stderr-newline")
  , MkPair String Bool "native-report/completion/missing-priority"
      (native_analyze_report_error native_analyze_report_expected (MkProcResult 137 "" "failure\n")
        "missing, malformed or repeated structured completion report")
  , MkPair String Bool "native-report/completion/repeated-priority"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 137 (str_concat native_analyze_report_clean native_analyze_report_clean) "failure\n")
        "missing, malformed or repeated structured completion report")
  , MkPair String Bool "native-report/completion/native-counts-canonical-ASCII"
      (all String (fun (count : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_concat "ANALYZE_DRIVE files="
          (str_concat count " findings=0 rejected=0 families=dataflow\n")) "")
        "missing, malformed or repeated structured completion report") ["01", "+1", "-1", "١", " 1", ""])
  , MkPair String Bool "native-report/completion/unsupported-fields"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_replace native_analyze_report_clean "findings=0" "findings=0 extra=0") "")
        "missing, malformed or repeated structured completion report")
  , MkPair String Bool "native-report/completion/families-malformed"
      (all String (fun (families : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_concat "ANALYZE_DRIVE files=1 findings=0 rejected=0 families="
          (str_concat families "\n")) "") "missing, malformed or repeated structured completion report")
        ["", "dataflow,dataflow", "dataflow,", "Dataflow", "data flow"])
  , MkPair String Bool "native-report/completion/finding-after-terminal"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 (str_concat native_analyze_report_found
          (native_analyze_report_finding "std/io.ouro")) "")
        "structured worker emitted unreported output")
  , MkPair String Bool "native-report/files/priority-before-output"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 137 "extra\nANALYZE_DRIVE files=0 findings=0 rejected=0 families=effects\n" "failure\n")
        "structured report omitted or duplicated requested files")
  , MkPair String Bool "native-report/families/priority-before-output"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 137 "extra\nANALYZE_DRIVE files=1 findings=0 rejected=0 families=effects\n" "failure\n")
        "structured report did not run the requested families")
  , MkPair String Bool "native-report/counts/priority-before-extra-stderr"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 native_analyze_report_found "failure\n")
        "structured diagnostic counts disagree with the completion report")
  , MkPair String Bool "native-report/rejection/duplicate-paths"
      (native_analyze_report_error native_analyze_report_any_path
        (MkProcResult 1 "ANALYZE_DRIVE files=2 findings=0 rejected=2 families=dataflow\n"
          (str_concat (native_analyze_report_rejection "same.ouro") (native_analyze_report_rejection "same.ouro")))
        "structured report has duplicate or excess rejected files")
  , MkPair String Bool "native-report/rejection/excess-before-path"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 "ANALYZE_DRIVE files=1 findings=0 rejected=2 families=dataflow\n"
          (str_concat (native_analyze_report_rejection "first.ouro") (native_analyze_report_rejection "second.ouro")))
        "structured report has duplicate or excess rejected files")
  , MkPair String Bool "native-report/path/priority-before-stderr"
      (native_analyze_report_error native_analyze_report_expected
