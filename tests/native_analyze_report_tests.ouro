        "stdout-newline")
  , MkPair String Bool "native-report/triplet/orphan-advice"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult Z (str_concat "  hint: x\n  witness: y\n" native_analyze_report_clean) "")
        "structured worker emitted unreported output")
  , MkPair String Bool "native-report/header/unsupported-severity"
      (all String (fun (label : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 (str_replace native_analyze_report_good_finding "warning[" (str_concat label "[")) "")
        "structured diagnostic counts disagree with the completion report") ["info", "fatal", "warn"])
  , MkPair String Bool "native-report/header/malformed-code"
      (all String (fun (code : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 (str_replace native_analyze_report_good_finding "OURO-DF003" code) "")
        "structured diagnostic counts disagree with the completion report")
        ["OURO-", "OURO-DF", "OURO-003", "OURO-Df003", "OURO-DF٠٠٣", "DF003"])
  , MkPair String Bool "native-report/header/noncanonical-location"
      (all String (fun (line : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 (str_replace native_analyze_report_good_finding ":6:1:" line) "")
        "structured diagnostic counts disagree with the completion report") [":06:1:", ":٦:1:", ":6:01:", ":6:-1:"])
  , MkPair String Bool "native-report/header/malformed-owner-or-rule"
      (all String (fun (rule : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 (str_replace native_analyze_report_good_finding "dataflow/alias" rule) "")
        "structured diagnostic counts disagree with the completion report")
        ["Dataflow/alias", "dataflow/", "/alias", "dataflow/Bad", "dataflow/bad rule"])
  , MkPair String Bool "native-report/rejection/malformed-reason"
      (all String (fun (reason : String) => native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 "ANALYZE_DRIVE files=1 findings=0 rejected=1 families=dataflow\n"
          (str_replace (native_analyze_report_rejection "std/io.ouro") "parse-fail" reason))
        "structured diagnostic counts disagree with the completion report") ["", "parse fail", "parse\tfail"])
  , MkPair String Bool "native-report/rejection/missing-path"
      (native_analyze_report_error native_analyze_report_expected
        (MkProcResult 1 "ANALYZE_DRIVE files=1 findings=0 rejected=1 families=dataflow\n"
          (native_analyze_report_rejection "")) "structured diagnostic counts disagree with the completion report")
  , MkPair String Bool "native-report/rejection/quality-read-error-cannot-pass"
      (native_analyze_report_error native_analyze_report_expected
