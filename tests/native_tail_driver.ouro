import "native_tail_fixtures.ouro",
  "../std/test.ouro",
  "native_frame_text.ouro";

def tail_emit (metadata : Bool) (name : String) : IO Unit :=
    match tail_fixture_named name with
    | Nothing => do eprintln "unknown native tail fixture"; exit 2
    | Just program => match codegen_program mir_default_limits program with
      | Left _ => do eprintln "native tail codegen rejected fixture"; exit 2
      | Right image => match image with | NativeImageOf pe frames =>
        match metadata with
        | True => println (str_join("\n", map NativeFrameInfo String native_frame_text frames))
        | False => match pe with | PeImageFile bytes _ => println (str_join(",", map Nat String str_of_nat bytes)) end
        end end end end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match andb(eq_nat(length String arguments, 2), str_eq(nth String "" 1 arguments, "--list-cases")) with
       | True => println (str_join "\n" tail_fixture_names)
       | False => match andb (eq_nat(length String arguments, 3))
           (orb(str_eq(nth String "" 1 arguments, "--image"), str_eq(nth String "" 1 arguments, "--metadata"))) with
         | True => tail_emit(str_eq(nth String "" 1 arguments, "--metadata"), nth String "" 2 arguments)
         | False => do eprintln "usage: native_tail_driver --image|--metadata NAME"; exit 2
         end end
