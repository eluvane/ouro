-- Shared list equality used by compiler structural and string-NF suites.
import "../std/prelude.ouro";

def compiler_test_list_equal (A : Type) (same : A -> A -> Bool)
    : List A -> List A -> Bool :=
  fix compare (left : List A) (right : List A) : Bool :=
    match left, right with
    | Nil, Nil => True
    | Nil, Cons _ _ => False
    | Cons _ _, Nil => False
    | Cons first rest, Cons other tail =>
        andb (same first other) (compare rest tail)
    end;
