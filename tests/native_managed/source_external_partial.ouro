-- Capturing the first scalar argument creates a reusable managed closure.
-- Applying its raw-pointer argument constructs each deferred foreign action.
import "source_foreign_values.ouro";

extern source_tls_allocate : Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsAlloc" "nogc";
extern source_tls_set : U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsSetValue" "nogc";
extern source_tls_release : U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsFree" "nogc";
extern source_tls_get : U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsGetValue" "nogc";

def source_use_partial (slot : U32) (zero : U32) : Runtime U32 :=
    let setter : RawPtr U8 -> Runtime U32 := source_tls_set slot in
    let shared : RawPtr U8 -> Runtime U32 := source_identity (RawPtr U8 -> Runtime U32) setter in
    runtime_bind U32 U32 (shared (raw_null U8)) (fun (first : U32) =>
      runtime_bind (RawPtr U8) U32 (raw_from_bits U8 (raw_u32_to_size (source_forty_two zero)))
        (fun (token : RawPtr U8) =>
          runtime_bind U32 U32 (shared token) (fun (second : U32) =>
            runtime_bind (RawPtr U8) U32 (source_tls_get slot) (fun (observed : RawPtr U8) =>
              runtime_bind USize U32 (raw_to_bits U8 observed) (fun (bits : USize) =>
                runtime_bind U32 U32 (source_tls_release slot) (fun (released : U32) =>
                  runtime_pure U32 (match u32_equal first zero with
                    | True => zero | False => match u32_equal second zero with
                      | True => zero | False => match u32_equal released zero with
                        | True => zero | False => match usize_equal bits (raw_u32_to_size (source_forty_two zero)) with
                          | True => source_forty_two zero | False => zero end end end end)))))));

def source_with_slot (zero : U32) : Runtime U32 :=
    runtime_bind U32 U32 source_tls_allocate (fun (slot : U32) =>
      match u32_equal slot (u32_sub zero (source_one zero)) with
      | True => runtime_pure U32 zero | False => source_use_partial slot zero end);

def main : Runtime U32 := runtime_bind U32 U32 source_zero source_with_slot;
