-- The checked MIR fault fixture injects raw statuses after source replay.
-- Arguments select the asserted result; cleanup faults must terminate first.
import "source_file_values.ouro",
  "../../std/natx.ouro";

def file_status_fault_run (expected : String) : IO Unit :=
         let reader : String -> IO (Pair Nat String) := prim_fs_read_file_status in
         do let! reply := reader "files/fault-read.bin";
            match reply with | MkPair status body =>
              do file_expect (prim_string_eq (prim_string_of_nat status) expected);
                 file_expect (match eq_nat status 0 with | True => prim_string_eq body file_binary
                   | False => prim_string_eq body "" end);
                 exit 42 end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 2 | Cons _ rest =>
         match rest with | Nil => exit 2 | Cons expected extra =>
           match extra with | Nil => file_status_fault_run expected
           | Cons _ _ => exit 2 end end end
