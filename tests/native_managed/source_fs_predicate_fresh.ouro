import "source_fs_predicate_values.ouro";
import "source_values.ouro";

def PredicateText : Type := String;
def PredicateAction (A : Type) : Type := IO A;
intrinsic chosen_exists : PredicateText -> PredicateAction Bool := "ouro.fs.exists";
intrinsic chosen_directory : PredicateText -> PredicateAction Bool := "ouro.fs.is_dir";

def main : IO Unit :=
    let exists : String -> IO Bool := chosen_exists in
    let directory : String -> IO Bool := chosen_directory in
    let path : String := prim_string_concat "files/predicate-" "fresh" in
    let saved_exists : IO Bool := exists path in
    let saved_directory : IO Bool := directory path in
    let ignored : IO Bool := exists (prim_string_of_char_codes [255]) in
    do print "ready\n";
       let! first_barrier := readLine;
       startup_expect (prim_string_eq first_barrier "first");
       let! first_exists := saved_exists;
       let! first_directory := saved_directory;
       predicate_print first_exists;
       predicate_print first_directory;
       print "\n";
       let! second_barrier := readLine;
       startup_expect (prim_string_eq second_barrier "second");
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second_exists := saved_exists;
       let! second_directory := saved_directory;
       predicate_print second_exists;
       predicate_print second_directory;
       print "\n";
       let! third_barrier := readLine;
       startup_expect (prim_string_eq third_barrier "third");
       let! third_exists := saved_exists;
       let! third_directory := saved_directory;
       predicate_print third_exists;
       predicate_print third_directory;
       print "\n";
       exit 42
