import "source_file_values.ouro";

def main : IO Unit :=
    let bound : String -> IO Unit := prim_fs_write_file "files/direct-partial.bin" in
    do bound file_binary;
       let! value := prim_fs_read_file "files/direct-partial.bin";
       file_expect (prim_string_eq value file_binary);
       exit 42
