import "source_startup_values.ouro";

-- The checked accessor returns an empty list before the typed probe replaces
-- its body. The untransformed source therefore cannot satisfy these 19 cases.
def realpath_normalization_source : List String := [];

def realpath_normalization_expected : List String :=
    ["C:/work/a.ouro",
     "C:/работа/файл😀.ouro",
     "C:/work/a.ouro",
     "C:/работа/файл😀.ouro",
     "//server/share/a.ouro",
     "//server/share/a.ouro",
     "//сервер/папка/😀.ouro",
     "C:/work/a.ouro",
     "",
     "/",
     "//",
     "//?",
     "",
     "//",
     "uNc/server/share",
     "UNCA/server",
     "//?/C:/work",
     "C:/part//?/leaf",
     "//server"];

def main : IO Unit :=
    do startup_expect (startup_arguments_equal realpath_normalization_source realpath_normalization_expected);
       exit 42
