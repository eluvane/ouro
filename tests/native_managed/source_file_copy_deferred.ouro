import "source_file_copy_values.ouro";

def main : IO Unit :=
    let copy : String -> String -> IO Unit := prim_fs_copy_file in
    let invalid : String := prim_string_of_char_codes [255] in
    let nul : String := prim_string_of_char_codes [65, 0, 66] in
    let unused_partial : String -> IO Unit := copy invalid in
    let unused_source : IO Unit := unused_partial "files/deferred-target" in
    let unused_target : IO Unit := copy "files/deferred-source" invalid in
    let unused_nul_source : IO Unit := copy nul "files/deferred-target" in
    let unused_nul_target : IO Unit := copy "files/deferred-source" nul in
    let unused_valid : IO Unit := copy "files/deferred-source" "files/deferred-target" in
    exit 42
