import "source_nat_values.ouro";
import "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u32_from_nat 1024 with | Nothing => runtime_pure U32 zero | Just expected =>
        runtime_pure U32 (source_answer zero (nat_u32_same expected (nat_identity 1024))) end);
