import "source_fast_nat_values.ouro";
import "source_values.ouro";

def fast_nat_small_sub (origin : Nat) : Bool :=
    andb (fast_nat_sub_same 17 25 origin) (fast_nat_sub_same 63 21 42);

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      runtime_pure U32 (source_answer zero (fast_nat_small_sub (nat_u32_to_nat zero))));
