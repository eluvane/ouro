import "source_values.ouro";

inductive SourceCallable : Type := | SourceCallableOf : (U32 -> U32) -> SourceCallable;
inductive SourceCaptured : Type := | SourceCapturedOf : U32 -> U32 -> SourceCaptured;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let make : U32 -> SourceCaptured := SourceCapturedOf (source_twenty zero) in
      let first : SourceCaptured := make (source_twenty_one zero) in
      let second : SourceCaptured := make (source_twenty_two zero) in
      let select : SourceCallable := SourceCallableOf (match first with | SourceCapturedOf a b =>
        match second with | SourceCapturedOf c d => fun (_ : U32) => source_add c d end end) in
      runtime_pure(U32, (match select with | SourceCallableOf function => function end) zero));
