import "source_loop_values.ouro",
  "source_values.ouro";

inductive LoopState : Type := | LoopStateOf : U32 -> U32 -> LoopState;

def loop_state_condition (zero : U8) (state : LoopState) : Runtime U8 :=
    match state with | LoopStateOf count limit => loop_condition limit zero count end;
def loop_state_advance (one : U32) (state : LoopState) : Runtime LoopState :=
    match state with | LoopStateOf count limit => runtime_pure(LoopState, LoopStateOf(source_add count one, limit)) end;
def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let limit : U32 := loop_word zero 41 in
      runtime_bind LoopState U32 (runtime_loop LoopState (LoopStateOf zero limit)
        (loop_state_condition (loop_zero_byte zero)) (loop_state_advance (loop_word zero 1)))
        (fun (state : LoopState) => match state with | LoopStateOf count saved =>
          runtime_pure(U32, source_answer(zero, raw_bool_and(u32_equal count limit, u32_equal saved limit))) end));
