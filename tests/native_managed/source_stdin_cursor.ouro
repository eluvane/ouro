-- Shared C/native cursor contract. Harness inputs cover an ordinary CRLF
-- line, 8191 bytes before LF, LF at the cap, and EOF without a final LF.
import "source_stdio_values.ouro";

def main : IO Unit :=
    do let! zero := prim_stdin_read_bytes 0;
       print zero;
       let! first := readLine;
       print first;
       print "|";
       let! middle := prim_stdin_read_bytes 4;
       print middle;
       print "|";
       let! second := readLine;
       print second;
       print "|";
       let! tail := prim_stdin_read_bytes 8;
       print tail;
       print "|";
       let! eof := readLine;
       print eof
