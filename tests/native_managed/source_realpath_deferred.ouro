-- Capturing invalid paths performs no conversion, open or raw allocation.
import "source_startup_values.ouro",
  "../../std/natx.ouro";

def realpath_deferred_empty : IO String := prim_fs_realpath "";
def realpath_deferred_invalid_utf8 : IO String := prim_fs_realpath (prim_string_of_char_codes [255]);
def realpath_deferred_embedded_nul : IO String := prim_fs_realpath (prim_string_of_char_codes [65,0]);

def main : IO Unit :=
    let actions : List (IO String) :=
      [realpath_deferred_empty, realpath_deferred_invalid_utf8, realpath_deferred_embedded_nul] in
    do startup_expect (eq_nat(length(IO String, actions), 3));
       exit 42
