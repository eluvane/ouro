import "source_values.ouro";

intrinsic I32 : Type := "ouro.i32";
intrinsic source_i32_bits : U32 -> I32 := "ouro.convert.u32.i32.reinterpret";
intrinsic source_i32_sub : I32 -> I32 -> I32 := "ouro.i32.sub.wrap";
intrinsic source_i32_less : I32 -> I32 -> Bool := "ouro.i32.lt";

def source_identity (A : Type) (value : A) : A := value;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u8_from_nat 42 with | Nothing => runtime_pure U32 zero | Just byte =>
        let small : U8 := source_identity U8 byte in
        let word : U32 := source_identity(U32, u8_to_u32 small) in
        let wide : U64 := source_identity(U64, u32_to_u64 word) in
        let size : USize := source_identity(USize, u64_to_usize wide) in
        let signed_zero : I32 := source_i32_bits zero in
        let negative : I32 := source_identity(I32, source_i32_sub(signed_zero, source_i32_bits word)) in
        runtime_pure U32 (match source_i32_less negative signed_zero with
          | True => raw_size_to_u32 size | False => zero end) end);
