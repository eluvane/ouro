-- Values and effects use the shared runtime identities. Only per-child
-- OURO_STARTUP_TEST_* environment variables are used by these fixtures.
import "source_file_values.ouro",
  "../../std/io.ouro";

def startup_expect (condition : Bool) : IO Unit :=
    match condition with | True => io_unit | False => exit 91 end;

def source_expect_file (path : String) (expected : String) : IO Unit :=
    do let! actual := prim_fs_read_file path;
       startup_expect (prim_string_eq actual expected)

def mutation_typed_reused (operation : String -> IO Unit) : IO Unit :=
    let saved : IO Unit := operation (prim_string_concat "files/" "mutation-target") in
    do saved;
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       saved;
       saved;
       exit 42

def startup_print_arguments : List String -> IO Unit :=
    fix print_arguments (values : List String) : IO Unit :=
      match values with | Nil => io_unit | Cons value rest =>
        do print "<"; print value; print ">\n"; print_arguments rest end;

def startup_print_optional (value : Maybe String) : IO Unit :=
    match value with | Nothing => print "<missing>\n" | Just text =>
      do print "<"; print text; print ">\n" end;

def startup_arguments_equal : List String -> List String -> Bool :=
    fix same (left : List String) (right : List String) : Bool :=
      match left, right with | Nil, Nil => True | Cons first tail, Cons second rest =>
        andb(prim_string_eq first second, same tail rest)
      | Nil, Cons _ _ => False | Cons _ _, Nil => False end;
