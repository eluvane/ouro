import "source_file_values.ouro",
  "../../std/natx.ouro",
  "../../runtime/managed_heap_observer.ouro";

def main : IO Unit :=
    let saved : IO (Maybe Nat) := managed_allocated_requested_bytes in
    do let! first := saved;
       let payload : String := file_double 15 "x" in
       let! second := saved;
       let noise : String := source_churn 32 "" in
       let! third := saved;
       file_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       file_expect (eq_nat(prim_string_length payload, mul 128 256));
       file_expect (match first, second, third with
         | Just before, Just after, Just retained =>
             andb (ltb_nat before (mul 128 256))
               (andb (leb_nat (prim_string_length payload) after) (leb_nat (prim_string_length payload) retained))
         | Nothing, Nothing, Nothing => False
         | Nothing, Nothing, Just _ => False
         | Nothing, Just _, Nothing => False
         | Nothing, Just _, Just _ => False
         | Just _, Nothing, Nothing => False
         | Just _, Nothing, Just _ => False
         | Just _, Just _, Nothing => False end);
       println "HEAP_OBSERVER_REUSED";
       exit 42
