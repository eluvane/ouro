import "source_fs_kind_values.ouro",
  "source_values.ouro";

def KindText : Type := String;
def KindAction (A : Type) : Type := IO A;
intrinsic chosen_kind : KindText -> KindAction Nat := "ouro.fs.kind";

def main : IO Unit :=
    let lookup : String -> IO Nat := chosen_kind in
    let saved : IO Nat := lookup (prim_string_concat "files/kind-" "fresh") in
    let ignored : IO Nat := lookup (prim_string_of_char_codes [255]) in
    do print "ready\n";
       let! first_barrier := readLine;
       startup_expect (prim_string_eq first_barrier "first");
       let! first := saved;
       kind_print first;
       print "\n";
       let! second_barrier := readLine;
       startup_expect (prim_string_eq second_barrier "second");
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second := saved;
       kind_print second;
       print "\n";
       let! third_barrier := readLine;
       startup_expect (prim_string_eq third_barrier "third");
       let! third := saved;
       kind_print third;
       print "\n";
       exit 42
