import "source_values.ouro";

def source_factory (first : U32) : U32 -> U32 :=
    let captured : U32 := source_add first first in
    fun (second : U32) => source_add captured second;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let escaped : U32 -> U32 := source_factory (source_twenty_one zero) in
      runtime_pure(U32, escaped zero));
