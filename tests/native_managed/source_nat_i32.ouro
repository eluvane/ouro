import "source_nat_values.ouro";
import "source_values.ouro";

intrinsic I32 : Type := "ouro.i32";
intrinsic nat_i32_bits : U32 -> I32 := "ouro.convert.u32.i32.reinterpret";
intrinsic nat_i32_to_nat : I32 -> Nat := "ouro.i32.to_nat.bits";
intrinsic nat_i32_from_nat : Nat -> Maybe I32 := "ouro.i32.from_nat.checked";
intrinsic nat_i32_equal : I32 -> I32 -> Bool := "ouro.i32.eq";

def nat_i32_missing (value : Nat) : Bool := match nat_i32_from_nat value with | Nothing => True | Just _ => False end;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u32_from_nat 1 with | Nothing => runtime_pure U32 zero | Just one =>
        match u32_from_nat 31 with | Nothing => runtime_pure U32 zero | Just shift =>
          let negative : Nat := nat_i32_to_nat (nat_i32_bits (u32_sub zero one)) in
          let maximum : I32 := nat_i32_bits (u32_sub (u32_shift_left one shift) one) in
          let positive : Nat := nat_i32_to_nat maximum in
          runtime_pure U32 (source_answer zero (raw_bool_and (nat_u32_same (u32_sub zero one) negative)
            (raw_bool_and (nat_i32_missing negative) (raw_bool_and
              (match nat_i32_from_nat positive with | Nothing => False | Just actual => nat_i32_equal actual maximum end)
              (nat_i32_missing (nat_successor positive)))))) end end);
