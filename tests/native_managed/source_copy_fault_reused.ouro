import "source_startup_values.ouro";
import "../../std/natx.ouro";
import "source_values.ouro";

def CopyFaultText : Type := String;
def CopyFaultAction (A : Type) : Type := IO A;
intrinsic copy_fault_chosen : CopyFaultText -> CopyFaultText -> CopyFaultAction Unit := "ouro.fs.copy_file";

def main : IO Unit :=
    let copy : String -> String -> IO Unit := copy_fault_chosen in
    let source : String := prim_string_concat "files/" "source" in
    let target : String := prim_string_concat "files/" "destination" in
    let partial : String -> IO Unit := copy source in
    let saved : IO Unit := partial target in
    do saved;
       let first : String := source_churn 64 "root" in
       do saved;
          let second : String := source_churn 64 first in
          do saved;
             startup_expect (andb (eq_nat (prim_string_length first) 68) (eq_nat (prim_string_length second) 132));
             exit 42
