import "source_string_decimal_values.ouro",
  "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let one : U32 := source_one zero in
      let maximum : U32 := u32_sub zero one in
      let word : U64 := decimal_u64_add(u32_to_u64 maximum, u32_to_u64 (source_add one one)) in
      let value : Nat := decimal_add_steps(2, decimal_u32_to_nat maximum) in
      runtime_pure(U32, source_answer(zero, decimal_checked "4294967297" word value)));
