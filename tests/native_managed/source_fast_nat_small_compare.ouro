import "source_fast_nat_values.ouro";
import "../../compiler/base.ouro";
import "source_values.ouro";

def fast_nat_small_compare (origin : Nat) : Bool :=
    andb (fast_nat_equal_order origin origin)
      (andb (compiler_lt_nat 41 42) (andb (fast_nat_greater 43 42) (fast_nat_equal_order 42 42)));

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      runtime_pure U32 (source_answer zero (fast_nat_small_compare (nat_u32_to_nat zero))));
