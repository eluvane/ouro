-- A first-class alias, one captured argument, and reuse of that closure.
import "source_string_values.ouro";

def witness_concat : String -> String -> String := source_concat;

def witness_concat_case (left : String) (right : String) (zero : U32) : U32 :=
    let join : String -> String := witness_concat left in
    match source_string_equal("ab-cd", join right) with
    | False => zero
    | True => source_expect_string "ab-ef" (join "-ef") zero end;

def main : Runtime U32 := runtime_bind U32 U32 source_zero
    (fun (zero : U32) => runtime_pure(U32, witness_concat_case "ab" "-cd" zero));
