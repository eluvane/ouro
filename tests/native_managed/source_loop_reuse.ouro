import "source_loop_values.ouro",
  "source_values.ouro";

def loop_reused (cell : RawPtr U32) (zero : U32) : Runtime U32 :=
    let one : U32 := loop_word zero 1 in
    let limit : U32 := loop_word zero 17 in
    let pending : Runtime U32 := runtime_loop U32 zero
      (loop_count_condition cell one limit (loop_zero_byte zero)) (loop_advance one) in
    runtime_bind U32 U32 (raw_load_u32 cell) (fun (before : U32) =>
      runtime_bind U32 U32 pending (fun (first : U32) =>
        runtime_bind U32 U32 pending (fun (second : U32) =>
          runtime_bind U32 U32 (raw_load_u32 cell) (fun (after : U32) =>
            runtime_pure U32 (source_answer zero (raw_bool_and (u32_equal before zero)
              (raw_bool_and (u32_equal first limit) (raw_bool_and (u32_equal second limit)
                (u32_equal(after, loop_word zero 36))))))))));

def main : Runtime U32 := loop_with_cell loop_reused;
