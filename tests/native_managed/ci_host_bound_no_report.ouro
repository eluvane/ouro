-- Negative child protocol fixture: zero status deliberately omits the report.
-- @entry main
import "../../std/io.ouro";

def ci_no_report_arguments (arguments : List String) : Bool :=
    andb (eq_nat(length String arguments, 6))
      (andb (str_eq(nth String "" 0 arguments, "--profile"))
        (andb (str_eq(nth String "" 1 arguments, "control-plane-native"))
          (andb (str_eq(nth String "" 2 arguments, "--root"))
            (str_eq(nth String "" 4 arguments, "--out")))));

def main : IO Unit :=
    do let! raw := argv;
       exit (match ci_no_report_arguments (tail String raw) with
         | True => 0
         | False => 91
         end)
