import "source_nat_values.ouro",
  "source_values.ouro";

-- The standard display name with a different checked body must stay generic.
def eqNat (left : Nat) (right : Nat) : Bool := False;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      runtime_pure(U32, source_answer(zero, notb (eqNat 42 42))));
