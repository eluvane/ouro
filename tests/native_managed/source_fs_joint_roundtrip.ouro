-- All paths are inside the harness-owned files directory.
import "source_startup_values.ouro",
  "source_values.ouro";

def joint_expect_names (path : String) (names : List String) : IO Unit :=
    do let! actual := prim_fs_list_dir path;
       startup_expect (startup_arguments_equal actual names)

def joint_prepare (directory : String) (original : String) : IO Unit :=
    do prim_fs_mkdir directory;
       let! first := prim_fs_listable directory;
       startup_expect first;
       joint_expect_names directory [];
       prim_fs_write_file(original, prim_string_of_char_codes [65, 0, 255, 128, 10, 13, 90])

def joint_first (directory : String) (original : String) (target : String) (copy : IO Unit) : IO Unit :=
    let payload : String := prim_string_of_char_codes [65, 0, 255, 128, 10, 13, 90] in
    do copy;
       joint_expect_names directory ["source", "target"];
       source_expect_file original payload;
       source_expect_file target payload;
       let noise : String := source_churn 512 "root" in
       startup_expect (prim_string_eq(prim_string_slice noise 0 4, "root"))

def joint_reuse (directory : String) (original : String) (target : String) (copy : IO Unit) (remove : IO Unit) : IO Unit :=
    do prim_fs_write_file original "last";
       copy;
       source_expect_file target "last";
       remove;
       remove;
       joint_expect_names directory ["source"];
       copy;
       source_expect_file target "last"

def joint_finish (directory : String) (original : String) (remove : IO Unit) (listable : IO Bool) : IO Unit :=
    do remove;
       prim_fs_remove original;
       joint_expect_names directory [];
       prim_fs_remove directory;
       let! last := listable;
       startup_expect (notb last);
       let! absent := prim_fs_exists directory;
       startup_expect (notb absent)

def main : IO Unit :=
    let directory : String := prim_string_concat "files/joint/" "root" in
    let original : String := prim_string_concat directory "/source" in
    let target : String := prim_string_concat directory "/target" in
    let copy : IO Unit := prim_fs_copy_file original target in
    let listable : IO Bool := prim_fs_listable directory in
    let remove : IO Unit := prim_fs_remove target in
    do joint_prepare directory original;
       let! first := listable;
       startup_expect first;
       joint_first directory original target copy;
       joint_reuse directory original target copy remove;
       joint_finish directory original remove listable;
       exit 42
