import "source_nat_values.ouro",
  "source_values.ouro";

inductive NatHolder : Type := | NatHolderOf : Nat -> NatHolder;

def nat_add (left : Nat) : Nat -> Nat :=
    fix sum (right : Nat) : Nat :=
      match right with | Z => left | S prior => S (sum prior) end;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let make_successor : Nat -> Nat := S in
      let held : NatHolder := NatHolderOf (nat_identity 20) in
      let first : Nat := match held with | NatHolderOf value => make_successor value end in
      let answer : Nat := nat_add(first, nat_identity 21) in
      runtime_pure U32 (source_answer zero (raw_bool_and (nat_u32_same(source_forty_two zero, answer))
        (raw_bool_and (match nat_predecessor (S Z) with | Z => True | S _ => False end)
          (match nat_identity Z with | Z => True | S _ => False end)))));
