import "source_file_values.ouro";

def FileText : Type := String;
def FileAction (A : Type) : Type := IO A;
intrinsic read_selected : FileText -> FileAction FileText := "ouro.fs.read_file";
intrinsic write_selected : FileText -> FileText -> FileAction Unit := "ouro.fs.write_file";

def main : IO Unit :=
    let writer : String -> String -> IO Unit := write_selected in
    let bound : String -> IO Unit := writer "files/partial.bin" in
    let reader : String -> IO String := read_selected in
    do bound file_binary;
       let! value := reader "files/partial.bin";
       file_expect (prim_string_eq value file_binary);
       exit 42
