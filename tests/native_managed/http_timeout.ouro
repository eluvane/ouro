-- Server delays its response beyond five seconds or drips chunks indefinitely.
-- Host allows scheduling/WinHTTP phase overhead; there is no hard wall-clock
-- cancellation claim. Expired operations must not return partial success.
import "http_values.ouro";

def main : IO Unit :=
    http_fixture_run (fun (url : String) =>
      do let! result := prim_http_request url [] "body";
         http_fixture_expect_failure result;
         match result with | MkPair _ payload => match payload with | MkPair _ reason =>
           file_expect (str_contains reason "12002") end end;
         exit 42);
