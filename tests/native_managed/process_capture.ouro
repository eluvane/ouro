-- Build/run this executable from a Unicode path containing spaces. Supply
-- one nonexistent marker path in a harness-owned directory. The executable
-- launches itself without a shell; child mode checks every argument exactly.
import "source_file_values.ouro",
  "../../std/natx.ouro";

def process_fixture_words : List String :=
    ["space name", "雪😀", "", "quote\"here", "trailing\\", "many\\\\\"quote"];

def process_fixture_codes : Nat -> List Nat :=
    fix codes (count : Nat) : List Nat :=
      match count with | Z => Nil Nat | S rest => Cons Nat rest (codes rest) end;

def process_fixture_bytes : String :=
    prim_string_of_char_codes (process_fixture_codes 256);

def process_fixture_output : String := file_double 10 process_fixture_bytes;
def process_fixture_error : String := file_double(10, prim_string_concat process_fixture_bytes "err");

def process_fixture_child (arguments : List String) : IO Unit :=
    match arguments with | Nil => exit 91 | Cons marker words =>
      do file_expect (source_words_equal words process_fixture_words);
         prim_fs_write_file marker "ran";
         print process_fixture_output;
         eprint process_fixture_error;
         exit 37 end;

def process_fixture_result (result : Pair Nat (Pair String String)) : IO Unit :=
    match result with | MkPair code streams => match streams with | MkPair output error =>
      do file_expect (eq_nat code 37);
         file_expect (prim_string_eq output process_fixture_output);
         file_expect (prim_string_eq error process_fixture_error) end end;

def process_fixture_parent (program : String) (marker : String) : IO Unit :=
    let invoke : String -> List String -> IO (Pair Nat (Pair String String)) := prim_process_capture in
    let partial : List String -> IO (Pair Nat (Pair String String)) := invoke program in
    let action : IO (Pair Nat (Pair String String)) :=
      partial (Cons String "--child" (Cons String marker process_fixture_words)) in
    do let! before := prim_fs_exists marker;
       file_expect (notb before);
       let! first := action;
       process_fixture_result first;
       let! written := prim_fs_read_file marker;
       file_expect (prim_string_eq written "ran");
       prim_fs_write_file marker "reset";
       let! second := action;
       process_fixture_result second;
       let! rewritten := prim_fs_read_file marker;
       file_expect (prim_string_eq rewritten "ran");
       let! public := proc_exec program
         (Cons String "--child" (Cons String marker process_fixture_words));
       file_expect (eq_nat(proc_code public, 37));
       file_expect (prim_string_eq(proc_stdout public, process_fixture_output));
       file_expect (prim_string_eq(proc_stderr public, process_fixture_error));
       prim_fs_remove marker;
       exit 42;

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 91 | Cons program rest =>
         match rest with | Nil => exit 91 | Cons mode tail =>
           match prim_string_eq mode "--child" with
           | True => process_fixture_child tail
           | False => process_fixture_parent program mode end end end
