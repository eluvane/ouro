import "source_directory_values.ouro";

def main : IO Unit :=
    do let! names := fs_list "directories/Каталог с пробелом 😀";
       directory_expect (directory_members names ["zeta.txt", ".hidden", "имя с пробелом ☃.txt", "emoji-😀.txt", "child"]);
       let! readable := prim_fs_listable "directories/Каталог с пробелом 😀";
       directory_expect readable;
       print (str_join "\n" names);
       exit 42
