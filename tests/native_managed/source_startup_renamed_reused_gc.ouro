import "source_startup_values.ouro";
import "source_values.ouro";

def StartupText : Type := String;
def StartupAction (A : Type) : Type := IO A;
intrinsic startup_selected_args : StartupAction (List StartupText) := "ouro.runtime.argv";
intrinsic startup_selected_env : StartupText -> StartupAction (Maybe StartupText) := "ouro.runtime.env_get";

def main : IO Unit :=
    let lookup : String -> IO (Maybe String) := startup_selected_env in
    let saved : IO (Maybe String) := lookup (prim_string_concat "OURO_STARTUP_TEST_" "CAPTURED") in
    let saved_args : IO (List String) := startup_selected_args in
    do let! first := saved_args;
       let! first_value := saved;
       let noise : String := source_churn 64 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second := saved_args;
       startup_expect (startup_arguments_equal first second);
       let! second_value := saved;
       startup_expect (match first_value, second_value with | Just first_text, Just second_text =>
         andb (prim_string_eq first_text "сохранено😀") (prim_string_eq first_text second_text)
       | Nothing, Nothing => False | Nothing, Just _ => False | Just _, Nothing => False end);
       exit 42
