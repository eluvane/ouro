-- A stored action observes a file created between its invocations.
import "source_startup_values.ouro";
import "../../std/natx.ouro";
import "source_values.ouro";

def main : IO Unit :=
    let path : String := prim_string_concat "realpaths/" "created.txt" in
    let query : String -> IO String := prim_fs_realpath in
    let saved : IO String := query path in
    do let! before := saved;
       startup_expect (prim_string_eq before "");
       prim_fs_write_file path "created";
       let churned : String := source_churn 96 "root" in
       do let! after := saved;
          let! again := saved;
          startup_expect (andb (prim_string_ends after "/realpaths/created.txt") (prim_string_eq after again));
          startup_expect (eq_nat (prim_string_length churned) 100);
          exit 42
