import "source_fast_nat_values.ouro";

def fast_nat_add_carries (maximum : Nat) : Bool :=
    let boundary : Nat := S maximum in
    let after : Nat := S boundary in
    let partial : Nat -> Nat := add maximum in
    andb (eqNat (partial 1) boundary)
      (andb (eqNat (partial 2) after)
        (andb (fast_nat_add_same 0 boundary boundary)
          (andb (fast_nat_add_same boundary 0 boundary) (fast_nat_add_same boundary 1 after))));

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) => fast_nat_boundaries zero fast_nat_add_carries);
