-- Both queries share strict path conversion and return ordinary managed Bool.
import "source_startup_values.ouro";

def predicate_print (value : Bool) : IO Unit :=
    match value with | False => print "0" | True => print "1" end;

def predicate_paths : List String -> IO Unit :=
    fix paths (remaining : List String) : IO Unit :=
      match remaining with | Nil => io_unit | Cons path rest =>
        do let! exists := prim_fs_exists path;
           let! directory := prim_fs_is_dir path;
           predicate_print exists;
           predicate_print directory;
           print "\n";
           paths rest end;
