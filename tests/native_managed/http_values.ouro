-- Native harness owns the loopback server; no fixture uses external network.
import "source_file_values.ouro";
import "../../std/http.ouro";
import "../../runtime/platform/windows_http.ouro";

def http_fixture_run (body : String -> IO Unit) : IO Unit :=
    do let! arguments := argv;
       match arguments with | Cons _ rest => match rest with
         | Cons url trailing => match trailing with | Nil => body url | Cons _ _ => exit 91 end
         | Nil => exit 91 end
       | Nil => exit 91 end;

def http_fixture_expect_failure (result : Pair Nat (Pair String String)) : IO Unit :=
    match result with | MkPair status payload => match payload with | MkPair body reason =>
      file_expect (andb (eq_nat status 0)
        (andb (prim_string_eq body "") (notb (prim_string_eq reason "")))) end end;
