-- A foreign function can travel through an ordinary managed closure. Its
-- result remains a deferred Runtime action until bind invokes it.
import "source_foreign_values.ouro";

extern source_version : U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetProcessVersion" "nogc";

def source_call_foreign (function : U32 -> Runtime U32) (zero : U32) : Runtime U32 :=
    runtime_bind U32 U32 (function zero) (fun (version : U32) =>
      runtime_pure(U32, match u32_equal version zero with | True => zero | False => source_forty_two zero end));

def main : Runtime U32 := runtime_bind U32 U32 source_zero (source_call_foreign source_version);
