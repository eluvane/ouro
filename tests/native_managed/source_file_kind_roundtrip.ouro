import "source_file_values.ouro";
import "../../std/natx.ouro";
import "source_values.ouro";

intrinsic joint_read : String -> IO String := "ouro.fs.read_file";
intrinsic joint_write : String -> String -> IO Unit := "ouro.fs.write_file";
intrinsic joint_kind : String -> IO Nat := "ouro.fs.kind";

def main : IO Unit :=
    let path : String := prim_string_concat "files/joint-" "binary.bin" in
    let writer : String -> IO Unit := joint_write path in
    let saved_read : IO String := joint_read path in
    let saved_kind : IO Nat := joint_kind path in
    let ignored : IO String := joint_read (prim_string_of_char_codes [255]) in
    let doubled : String := prim_string_concat file_binary file_binary in
    do let! barrier := readLine;
       file_expect (prim_string_eq barrier "joint");
       let! missing := saved_kind;
       file_expect (eq_nat missing 0);
       writer file_binary;
       let! first_kind := saved_kind;
       file_expect (eq_nat first_kind 1);
       let! first := saved_read;
       file_expect (prim_string_eq first file_binary);
       let noise : String := source_churn 32 "" in
       file_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       writer doubled;
       let! second := saved_read;
       file_expect (prim_string_eq second doubled);
       let! final_kind := saved_kind;
       file_expect (eq_nat final_kind 1);
       let! directory_kind := joint_kind "files";
       file_expect (eq_nat directory_kind 2);
       print first;
       print second;
       print "joint-ok\n";
       exit 42
