-- Neither the low-level nor public action runs during its construction.
-- This fixture has no network dependency and requires no host URL argument.
import "../../std/http.ouro";
import "../../std/io.ouro";

def main : IO Unit :=
    let request : String -> List (Pair String String) -> String
        -> IO (Pair Nat (Pair String String)) := prim_http_request in
    let deferred : IO (Pair Nat (Pair String String)) := request "invalid URL" [] "body" in
    let public : IO HttpResp := http_post "invalid URL" [] "body" in
    exit 42;
