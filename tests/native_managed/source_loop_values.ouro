import "source_values.ouro";

intrinsic loop_narrow_u8 : U32 -> U8 := "ouro.convert.u32.u8.narrow.wrap";
intrinsic loop_multiply : U32 -> U32 -> U32 := "ouro.u32.mul.wrap";

def loop_word (fallback : U32) (value : Nat) : U32 :=
    match u32_from_nat value with | Nothing => fallback | Just word => word end;
def loop_byte (fallback : U8) (value : Nat) : U8 :=
    match u8_from_nat value with | Nothing => fallback | Just word => word end;
def loop_true (zero : U8) : U8 := loop_byte zero 255;
def loop_zero_byte (zero : U32) : U8 := loop_narrow_u8 zero;
def loop_advance (one : U32) (value : U32) : Runtime U32 := runtime_pure U32 (source_add value one);
def loop_condition (limit : U32) (zero : U8) (value : U32) : Runtime U8 :=
    runtime_pure U8 (match u32_less value limit with | True => loop_true zero | False => zero end);
def loop_abort (value : U32) : Runtime U32 :=
    runtime_bind Unit U32 (windows_exit_process value) (fun (_ : Unit) => runtime_pure U32 value);
def loop_abort_condition (value : U32) : Runtime U8 :=
    runtime_bind Unit U8 (windows_exit_process value) (fun (_ : Unit) => runtime_pure U8 (loop_zero_byte value));
def loop_run (zero : U32) (limit : U32) : Runtime U32 :=
    runtime_loop U32 zero (loop_condition limit (loop_zero_byte zero)) (loop_advance (loop_word zero 1));

def loop_count_condition (cell : RawPtr U32) (one : U32) (limit : U32) (zero : U8) (value : U32) : Runtime U8 :=
    runtime_bind U32 U8 (raw_load_u32 cell) (fun (before : U32) =>
      runtime_bind Unit U8 (raw_store_u32 cell (source_add before one))
        (fun (_ : Unit) => loop_condition limit zero value));

def loop_with_cell (action : RawPtr U32 -> U32 -> Runtime U32) : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let bytes : USize := raw_u32_to_size (loop_word zero 4) in
      runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes bytes) (fun (owner : RawPtr U8) =>
        runtime_bind USize U32 (raw_to_bits U8 owner) (fun (address : USize) =>
          match usize_equal address (usize_sub address address) with | True => runtime_pure U32 zero
          | False => runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 owner) (fun (cell : RawPtr U32) =>
              runtime_bind Unit U32 (raw_store_u32 cell zero) (fun (_ : Unit) =>
                runtime_bind U32 U32 (action cell zero) (fun (answer : U32) =>
                  runtime_bind Bool U32 (raw_pages_release owner) (fun (released : Bool) =>
                    runtime_pure U32 (match released with | True => answer | False => zero end))))) end)));
