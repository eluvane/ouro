-- Supply a nonexistent executable path in a harness-owned directory.
import "source_file_values.ouro",
  "../../std/natx.ouro";

def process_missing_expect (result : Pair Nat (Pair String String)) : IO Unit :=
    match result with | MkPair code streams => match streams with | MkPair output error =>
      do file_expect (eq_nat code 127);
         file_expect (prim_string_eq output "");
         file_expect (notb (prim_string_eq error "")) end end;

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 91 | Cons _ rest =>
         match rest with | Nil => exit 91 | Cons path _ =>
           let action : IO (Pair Nat (Pair String String)) := prim_process_capture path ["", "雪 space"] in
           do let! first := action;
              process_missing_expect first;
              let! second := action;
              process_missing_expect second;
              exit 42 end end
