-- This checks retention across allocation pressure. Churn alone is not
-- evidence that the runtime collector executed.
import "source_file_values.ouro";

intrinsic checked_gc_add : USize -> USize -> Maybe USize := "ouro.usize.add.checked";
intrinsic checked_gc_to_u32 : USize -> Maybe U32 := "ouro.convert.usize.u32.checked";

extern checked_gc_process_id : Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetCurrentProcessId" "maygc";

def main : IO Unit :=
    do let! seed := checked_gc_process_id;
       let size : USize := raw_u32_to_size seed in
       let zero : USize := usize_sub size size in
       match usize_from_nat 1 with | Nothing => exit 91 | Just one =>
         let maximum : USize := usize_sub zero one in
         let saved : Maybe USize := checked_gc_add size zero in
         let absent : Maybe USize := checked_gc_add maximum one in
         let narrowed : Maybe U32 := checked_gc_to_u32 size in
         let rejected : Maybe U32 := checked_gc_to_u32 maximum in
         let noise : String := source_churn 32 "" in
         do file_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
            file_expect (match saved with | Nothing => False | Just actual => usize_equal actual size end);
            file_expect (match absent with | Nothing => True | Just _ => False end);
            file_expect (match narrowed with | Nothing => False | Just actual => u32_equal actual seed end);
            file_expect (match rejected with | Nothing => True | Just _ => False end);
            println "CHECKED_USIZE_RETAINED";
            exit 42
       end
