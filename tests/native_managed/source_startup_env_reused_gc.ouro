import "source_startup_values.ouro";
import "source_values.ouro";

def StartupText : Type := String;
def StartupAction (A : Type) : Type := IO A;
intrinsic selected : StartupText -> StartupAction (Maybe StartupText) := "ouro.runtime.env_get";

def main : IO Unit :=
    let lookup : String -> IO (Maybe String) := selected in
    let saved : IO (Maybe String) := lookup (prim_string_concat "OURO_STARTUP_TEST_" "CAPTURED") in
    do let! first := saved;
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second := saved;
       startup_expect (match first, second with | Just one, Just two =>
         andb (prim_string_eq one "сохранено😀") (prim_string_eq one two)
       | Nothing, Nothing => False | Nothing, Just _ => False | Just _, Nothing => False end);
       exit 42
