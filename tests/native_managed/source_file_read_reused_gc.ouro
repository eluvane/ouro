import "source_file_values.ouro";
import "source_values.ouro";

def main : IO Unit :=
    let saved : IO String := prim_fs_read_file "files/read-reused.bin" in
    do let! first := saved;
       prim_fs_write_file "files/read-reused.bin" file_binary;
       let noise : String := source_churn 32 "" in
       file_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second := saved;
       file_expect (prim_string_eq first "first");
       file_expect (prim_string_eq second file_binary);
       exit 42
