import "source_string_values.ouro";

def source_string_join_case (left : String) (right : String) (zero : U32) : U32 :=
    source_expect_string "привет-😀" (source_concat left right) zero;

def main : Runtime U32 := runtime_bind U32 U32 source_zero
    (fun (zero : U32) => runtime_pure(U32, source_string_join_case "привет" "-😀" zero));
