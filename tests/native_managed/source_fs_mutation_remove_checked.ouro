import "source_fs_mutation_values.ouro",
  "../../std/fsx.ouro";

def main : IO Unit :=
    do let! file := fsx_remove_if_exists "files/checked-file";
       mutation_checked_result file;
       let! absent := fsx_remove_if_exists "files/checked-file";
       mutation_checked_result absent;
       let! directory := fsx_remove_if_exists "files/checked-empty";
       mutation_checked_result directory;
       let! blocked := fsx_remove_if_exists "files/checked-nonempty";
       match blocked with | Right _ => exit 91 | Left error =>
         match error with
         | FsOperationFailed operation path => do
             startup_expect (andb (prim_string_eq operation "remove")
               (prim_string_eq path "files/checked-nonempty"));
             let! empty := fsx_remove_if_exists "";
             match empty with | Right _ => exit 91 | Left invalid =>
               match invalid with | FsEmptyPath => exit 42
               | FsMissing _ => exit 91 | FsExpectedFile _ => exit 91
               | FsExpectedDirectory _ => exit 91 | FsOperationFailed _ _ => exit 91 end end
         | FsEmptyPath => exit 91 | FsMissing _ => exit 91 | FsExpectedFile _ => exit 91
         | FsExpectedDirectory _ => exit 91 end end
