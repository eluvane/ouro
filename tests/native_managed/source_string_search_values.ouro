-- Primitive operands are function parameters so native tests execute the
-- operation at runtime even when callers supply known byte strings.
import "source_string_values.ouro";

intrinsic search_primitive_starts : String -> String -> Bool := "ouro.string.starts";
intrinsic search_primitive_ends : String -> String -> Bool := "ouro.string.ends";
intrinsic search_primitive_contains : String -> String -> Bool := "ouro.string.contains";
intrinsic search_primitive_index : String -> String -> Maybe Nat := "ouro.string.index";
intrinsic search_primitive_order : String -> String -> Bool := "ouro.string.le";
intrinsic search_primitive_replace : String -> String -> String -> String := "ouro.string.replace";

def search_and (left : Bool) (right : Bool) : Bool :=
    match right with | False => False | True => left end;
def search_not (value : Bool) : Bool := match value with | True => False | False => True end;

def search_starts (input : String) (pattern : String) : Bool := search_primitive_starts input pattern;
def search_ends (input : String) (pattern : String) : Bool := search_primitive_ends input pattern;
def search_contains (input : String) (pattern : String) : Bool := search_primitive_contains input pattern;
def search_order (left : String) (right : String) : Bool := search_primitive_order left right;
def search_replace (input : String) (pattern : String) (replacement : String) : String :=
    search_primitive_replace input pattern replacement;

def search_index_equals (expected : Nat) (input : String) (pattern : String) : Bool :=
    match search_primitive_index input pattern with | Nothing => False | Just actual =>
      match u32_from_nat expected with | Nothing => False | Just wanted =>
        match u32_from_nat actual with | Nothing => False | Just value => u32_equal value wanted end end end;

def search_index_missing (input : String) (pattern : String) : Bool :=
    match search_primitive_index input pattern with | Nothing => True | Just _ => False end;

