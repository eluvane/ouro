import "source_string_decimal_values.ouro",
  "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match usize_from_nat 1 with | Nothing => runtime_pure U32 zero | Just one =>
        let word : U64 := usize_to_u64 (usize_sub(raw_u32_to_size zero, one)) in
        let value : Nat := decimal_add_steps(0, decimal_u64_to_nat word) in
        runtime_pure(U32, source_answer(zero, decimal_checked "18446744073709551615" word value)) end);
