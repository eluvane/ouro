import "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let partial : U32 -> U32 := source_adder (source_twenty zero) in
      let first : U32 := partial (source_twenty_one zero) in
      let second : U32 := partial (source_twenty_two zero) in
      runtime_pure U32 (match u32_less first second with | True => second | False => zero end));
