-- Server echoes the POST body with HTTP 418. HTTP errors are completed
-- responses, not transport failures, and must retain their binary payload.
import "http_values.ouro";

def main : IO Unit :=
    http_fixture_run (fun (url : String) =>
      do let! response := http_post url [] file_binary;
         file_expect (andb (eq_nat (http_status response) 418)
           (andb (notb (http_ok response)) (prim_string_eq (http_body response) file_binary)));
         exit 42);
