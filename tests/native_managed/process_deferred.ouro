-- None of these actions may convert input or acquire OS resources until run.
import "source_file_values.ouro",
  "../../std/natx.ouro";

def main : IO Unit :=
    let partial : List String -> IO (Pair Nat (Pair String String)) :=
      prim_process_capture (prim_string_of_char_codes [255]) in
    let actions : List (IO (Pair Nat (Pair String String))) :=
      [partial [""], prim_process_capture "" [],
       prim_process_capture "unused" [prim_string_of_char_codes [65,0,66]]] in
    do file_expect (eq_nat(length(IO (Pair(Nat, Pair String String)), actions), 3));
       exit 42
