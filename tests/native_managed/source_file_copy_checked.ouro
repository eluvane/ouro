import "source_file_copy_values.ouro",
  "../../std/fs.ouro";

def main : IO Unit :=
    do let! result := fs_copy_checked "files/checked-source" "files/checked/parent/target";
       match result with | Left _ => exit 91 | Right _ =>
         do source_expect_file "files/checked/parent/target" "checked";
            let! missing := fs_copy_checked "files/checked-missing" "files/checked/parent/target";
            match missing with | Right _ => exit 91 | Left error =>
              match error with | FsMissing path =>
                do startup_expect (prim_string_eq path "files/checked-missing");
                   source_expect_file "files/checked/parent/target" "checked";
                   let! empty := fs_copy_checked "" "files/checked/parent/target";
                   match empty with | Right _ => exit 91 | Left invalid =>
                     match invalid with | FsEmptyPath => exit 42
                     | FsMissing _ => exit 91 | FsExpectedFile _ => exit 91
                     | FsExpectedDirectory _ => exit 91 | FsOperationFailed _ _ => exit 91 end end
              | FsEmptyPath => exit 91 | FsExpectedFile _ => exit 91
              | FsExpectedDirectory _ => exit 91 | FsOperationFailed _ _ => exit 91 end end end
