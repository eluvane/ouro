import "source_directory_values.ouro";

def DirectoryName : Type := String;
def DirectoryAction (A : Type) : Type := IO A;
intrinsic enumerate_alias : DirectoryName -> DirectoryAction (List DirectoryName) := "ouro.fs.list_dir";
intrinsic probe_alias : DirectoryName -> DirectoryAction Bool := "ouro.fs.listable";

def main : IO Unit :=
    let enumerate : String -> IO (List String) := enumerate_alias in
    let probe : String -> IO Bool := probe_alias in
    do let! names := enumerate "directories/aliases";
       let! readable := probe "directories/aliases";
       directory_expect (andb readable (directory_members names ["entry.txt"]));
       exit 42
