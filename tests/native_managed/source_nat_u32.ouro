import "source_nat_values.ouro",
  "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u32_from_nat 1 with | Nothing => runtime_pure U32 zero | Just one =>
        let maximum : U32 := u32_sub zero one in
        let original : Nat := nat_identity (nat_u32_to_nat maximum) in
        let larger : Nat := nat_successor original in
        let expected : U64 := usize_to_u64 (usize_add(raw_u32_to_size maximum, raw_u32_to_size one)) in
        runtime_pure U32 (source_answer zero (raw_bool_and (nat_u32_same maximum original)
          (raw_bool_and (nat_u32_missing larger) (raw_bool_and (nat_u64_same expected larger)
            (nat_u32_same(maximum, nat_predecessor larger)))))) end);
