import "source_nat_values.ouro";
import "../../compiler/base.ouro";
import "source_values.ouro";

def fast_nat_greater (left : Nat) (right : Nat) : Bool :=
    match compareNat left right with | LT => False | EQ => False | GT => True end;

def fast_nat_equal_order (left : Nat) (right : Nat) : Bool :=
    match compareNat left right with | LT => False | EQ => True | GT => False end;

def fast_nat_apply (operation : Nat -> Nat -> Nat) (left : Nat) (right : Nat) : Nat :=
    let partial : Nat -> Nat := operation left in partial right;

def fast_nat_apply_bool (operation : Nat -> Nat -> Bool) (left : Nat) (right : Nat) : Bool :=
    let partial : Nat -> Bool := operation left in partial right;

def fast_nat_apply_order (operation : Nat -> Nat -> Ordering) (left : Nat) (right : Nat) : Ordering :=
    let partial : Nat -> Ordering := operation left in partial right;

def fast_nat_add_same (left : Nat) (right : Nat) (expected : Nat) : Bool :=
    eqNat (fast_nat_apply add left right) expected;

def fast_nat_sub_same (left : Nat) (right : Nat) (expected : Nat) : Bool :=
    eqNat (fast_nat_apply sub left right) expected;

def fast_nat_max32 (zero : U32) : Maybe Nat :=
    mapMaybe U32 Nat (fun (one : U32) => nat_u32_to_nat (u32_sub zero one)) (u32_from_nat 1);

def fast_nat_max64 (zero : U32) : Maybe Nat :=
    mapMaybe USize Nat (fun (one : USize) =>
      nat_u64_to_nat (usize_to_u64 (usize_sub (raw_u32_to_size zero) one))) (usize_from_nat 1);

def fast_nat_boundaries (zero : U32) (test : Nat -> Bool) : Runtime U32 :=
    match fast_nat_max32 zero, fast_nat_max64 zero with
    | Just first, Just second => runtime_pure U32 (source_answer zero
        (andb (nat_u32_missing (S first)) (andb (nat_u64_missing (S second))
          (andb (test first) (test second)))))
    | Nothing, Just _ => runtime_pure U32 zero
    | Just _, Nothing => runtime_pure U32 zero
    | Nothing, Nothing => runtime_pure U32 zero end;
