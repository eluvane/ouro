import "source_file_values.ouro",
  "../../std/fs.ouro";

def file_status_finish (reply : Pair Nat String) : IO Unit :=
    match reply with | MkPair status body => match eq_nat status 0 with
      | True => print body
      | False => do file_expect (prim_string_eq body "");
                    eprintln (prim_string_concat "read OS status=" (prim_string_of_nat status));
                    exit 1
      end end;

def file_status_checked_finish (reply : Either FsError String) : IO Unit :=
    match reply with | Left error => do eprintln (fs_error_message error); exit 1
    | Right body => print body end;

def file_status_path (command : String) (path : String) : String :=
    match prim_string_eq command "--read-status-nul-path" with
    | True => prim_string_concat path (prim_string_of_char_codes [0,120])
    | False => match prim_string_eq command "--read-status-invalid-utf8-path" with
      | True => prim_string_concat path (prim_string_of_char_codes [192,175])
      | False => path end end;

def file_status_run (command : String) (supplied : String) : IO Unit :=
         let path : String := file_status_path command supplied in
         let reader : String -> IO (Pair Nat String) := prim_fs_read_file_status in
         let saved : IO (Pair Nat String) := reader path in
         match prim_string_eq command "--read-checked" with
         | True => do let! reply := fs_read_checked path; file_status_checked_finish reply
         | False => match prim_string_eq command "--read-deferred-status" with
           | True => do prim_fs_remove path;
                        let! remains := prim_fs_exists path;
                        file_expect (notb remains);
                        let! reply := saved;
                        file_status_finish reply
           | False => match prim_string_eq command "--read-reuse-status" with
             | True => do let! first := saved;
                          file_expect (match first with | MkPair status body =>
                            andb (eq_nat status 0) (prim_string_eq body "first") end);
                          prim_fs_write_file path file_binary;
                          let noise : String := source_churn 64 "" in
                          file_expect (eq_nat (prim_string_length noise) 64);
                          let! second := saved;
                          file_status_finish second
             | False => do let! reply := saved; file_status_finish reply end end end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 2 | Cons _ rest =>
         match rest with | Nil => exit 2 | Cons command paths =>
           match paths with | Nil => exit 2 | Cons supplied extra =>
             match extra with | Nil => file_status_run command supplied
             | Cons _ _ => exit 2 end end end end
