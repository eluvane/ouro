import "source_fs_mutation_values.ouro";
import "source_values.ouro";

def MutationText : Type := String;
def MutationAction (A : Type) : Type := IO A;
intrinsic chosen_create : MutationText -> MutationAction Unit := "ouro.fs.mkdir";
intrinsic chosen_remove : MutationText -> MutationAction Unit := "ouro.fs.remove";

def main : IO Unit :=
    let create : String -> IO Unit := chosen_create in
    let remove : String -> IO Unit := chosen_remove in
    let path : String := prim_string_concat "files/reused-" "directory" in
    let saved_create : IO Unit := create path in
    let saved_remove : IO Unit := remove path in
    do saved_create;
       let! first := prim_fs_is_dir path;
       startup_expect first;
       let noise : String := source_churn 64 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       saved_remove;
       let! second := prim_fs_exists path;
       startup_expect (notb second);
       saved_create;
       let! third := prim_fs_is_dir path;
       startup_expect third;
       saved_remove;
       saved_remove;
       let! fourth := prim_fs_exists path;
       startup_expect (notb fourth);
       saved_create;
       let! fifth := prim_fs_is_dir path;
       startup_expect fifth;
       exit 42
