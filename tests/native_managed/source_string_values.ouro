-- The registered String identity is independent of these fixture names.
import "source_foreign_values.ouro";

intrinsic String : Type := "ouro.string";
intrinsic source_concat : String -> String -> String := "ouro.string.concat";
intrinsic source_string_equal : String -> String -> Bool := "ouro.string.eq";

def source_expect_string (wanted : String) (actual : String) (zero : U32) : U32 :=
    match source_string_equal wanted actual with
    | True => source_forty_two zero | False => zero end;
