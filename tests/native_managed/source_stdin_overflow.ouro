-- 64 doublings produce 2^64. Rejection occurs only when the action runs.
import "source_stdio_values.ouro";

def stdin_double_count : Nat -> Nat -> Nat :=
    fix grow (remaining : Nat) (value : Nat) : Nat :=
      match remaining with | Z => value | S rest => grow(rest, add value value) end;

def stdin_large_count : Nat := stdin_double_count 64 1;

def main : IO Unit :=
    let action : IO String := prim_stdin_read_bytes stdin_large_count in
    do print "before";
       let! value := action;
       print value
