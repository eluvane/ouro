import "source_fs_predicate_values.ouro",
  "source_values.ouro";

def main : IO Unit :=
    let saved : IO Bool := prim_fs_is_dir (prim_string_concat "std/" "runtime.ouro") in
    do let! first := saved;
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second := saved;
       let! third := saved;
       startup_expect (andb(notb first, andb(notb second, notb third)));
       exit 42
