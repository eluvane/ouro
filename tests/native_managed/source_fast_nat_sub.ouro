import "source_fast_nat_values.ouro";

def fast_nat_sub_borrows (maximum : Nat) : Bool :=
    let boundary : Nat := S maximum in
    let after : Nat := S boundary in
    let partial : Nat -> Nat := sub boundary in
    andb (eqNat(partial 1, maximum))
      (andb (eqNat(partial maximum, 1))
        (andb (eqNat(partial after, 0))
          (andb (fast_nat_sub_same boundary boundary 0)
            (andb(fast_nat_sub_same 0 boundary 0, fast_nat_sub_same after 1 boundary)))));

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) => fast_nat_boundaries zero fast_nat_sub_borrows);
