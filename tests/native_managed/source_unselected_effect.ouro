import "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u32_equal zero zero with
      | True => runtime_pure U32 (source_forty_two zero)
      | False => runtime_bind Unit U32 (windows_exit_process zero)
          (fun (stopped : Unit) => runtime_pure U32 zero) end);
