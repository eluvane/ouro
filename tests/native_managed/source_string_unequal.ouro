import "source_string_values.ouro";

def source_unequal_case (value : String) (zero : U32) : U32 :=
    match source_string_equal value "a" with
    | True => zero
    | False => match source_string_equal value "ac" with
        | True => zero
        | False => match source_string_equal value "abc" with
            | True => zero | False => source_expect_string "ab" value zero end end end;

def main : Runtime U32 := runtime_bind U32 U32 source_zero
    (fun (zero : U32) => runtime_pure U32 (source_unequal_case "ab" zero));
