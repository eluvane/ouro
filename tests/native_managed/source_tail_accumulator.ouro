import "source_tail_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u32_from_nat 512 with
      | Nothing => runtime_pure U32 zero
      | Just count => match u32_from_nat 1 with
        | Nothing => runtime_pure U32 zero
        | Just one => runtime_pure U32
            (tail_countup count one zero (nat_u32_to_nat (source_add zero count)) zero) end end);
