import "source_stdio_values.ouro";
import "source_values.ouro";

def main : IO Unit :=
    let captured : IO Unit := print (prim_string_concat "cap" "tured") in
    let noise : String := source_churn 32 "" in
    do captured;
       print ":";
       print noise;
       print ":";
       captured;
       exit 42
