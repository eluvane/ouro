import "source_loop_values.ouro",
  "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let limit : U32 := loop_multiply(loop_word zero 100, loop_word zero 100) in
      runtime_bind U32 U32 (loop_run zero limit)
        (fun (answer : U32) => runtime_pure(U32, source_answer(zero, u32_equal answer limit))));
