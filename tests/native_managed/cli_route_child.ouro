-- A fixed sibling transport fixture; it does not implement LSP or packages.
import "source_file_values.ouro",
  "source_nat_values.ouro",
  "../../std/executable.ouro",
  "../../std/fs.ouro";

def cli_route_words : List String :=
    ["", "space name", "雪😀", "quote\"here", "trailing\\", "many\\\\\"quote",
     "--", "--out", "elsewhere.exe", "&|<>", "lsp", "pkg", "test", "fmt"];

def cli_route_environment (name : String) (expected : String) : IO Unit :=
    do let! value := env_get name;
       match value with
       | Nothing => exit 91
       | Just text => file_expect (prim_string_eq text expected) end;

def cli_route_write_marker : IO Unit :=
    do let! result := fs_write_checked "launched.txt" "route child\n";
       match result with | Left _ => exit 91 | Right _ => io_unit end;

def cli_route_context (program : String) : IO Unit :=
    do cli_route_write_marker;
       let! expected := env_get "OURO_CLI_ROUTE_IMAGE";
       match expected with
       | Nothing => exit 91
       | Just path =>
           do file_expect (prim_string_eq program path);
              let! located := executable_path_checked;
              match located with
              | Left _ => exit 91
              | Right actual => file_expect (prim_string_eq actual path) end end;
       cli_route_environment "OURO_CLI_ROUTE_TEST" "雪 value";
       cli_route_environment "OURO_CLI_ROUTE_EMPTY" "";
       let! cwd := fs_read_checked "cwd-input.txt";
       match cwd with
       | Left _ => exit 91
       | Right text => file_expect (prim_string_eq text "owned cwd\n") end;
       let! input := prim_stdin_read_bytes 7;
       file_expect (prim_string_eq input file_binary);
       let! eof := prim_stdin_read_bytes 1;
       file_expect (prim_string_eq eof "");
       print (prim_string_of_char_codes [65, 0, 255, 13, 10]);
       eprint (prim_string_of_char_codes [69, 0, 255, 13, 10]);
       io_unit;

def cli_route_exit (word : String) : IO Unit :=
    match prim_string_eq word "0" with
    | True => exit 0
    | False => match prim_string_eq word "1" with
      | True => exit 1
      | False => match prim_string_eq word "259" with
        | True => exit 259
        | False => match prim_string_eq word "max" with
          | False => exit 91
          | True => match u32_from_nat 1 with
            | Nothing => exit 91
            | Just one => exit (nat_u32_to_nat (u32_sub (u32_sub one one) one)) end
          end end end end;

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with
       | Nil => exit 91
       | Cons program words =>
           do cli_route_context program;
              match words with
              | Nil => exit 42
              | Cons code rest =>
                  do file_expect (source_words_equal rest cli_route_words);
                     cli_route_exit code end end;
