import "source_fs_kind_values.ouro";
import "../../std/natx.ouro";
import "source_values.ouro";

def main : IO Unit :=
    let saved : IO Nat := prim_fs_kind (prim_string_concat "std/" "runtime.ouro") in
    do let! first := saved;
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second := saved;
       let! third := saved;
       startup_expect (andb (eq_nat first 1) (andb (eq_nat second 1) (eq_nat third 1)));
       exit 42
