-- Dynamic arguments ensure these tests exercise native String operations.
import "source_string_values.ouro";

intrinsic access_len : String -> Nat := "ouro.string.length";
intrinsic access_byte : String -> Nat -> Nat := "ouro.string.byte_at";
intrinsic access_slice : String -> Nat -> Nat -> String := "ouro.string.slice";
intrinsic access_to_codes : String -> List Nat := "ouro.string.to_char_codes";
intrinsic access_of_codes : List Nat -> String := "ouro.string.of_char_codes";

def access_natural_same (expected : Nat) (actual : Nat) : Bool :=
    match u32_from_nat expected with | Nothing => False | Just wanted =>
      match u32_from_nat actual with | Nothing => False | Just got => u32_equal wanted got end end;
def access_length (expected : Nat) (value : String) : Bool := access_natural_same expected (access_len value);
def access_at (expected : Nat) (value : String) (offset : Nat) : Bool := access_natural_same expected (access_byte value offset);
def access_part (expected : String) (value : String) (start : Nat) (count : Nat) : Bool :=
    source_string_equal expected (access_slice value start count);
def access_empty_codes (value : String) : Bool := match access_to_codes value with | Nil => True | Cons _ _ => False end;
def access_three_codes (first : Nat) (second : Nat) (third : Nat) (value : String) : Bool :=
    match access_to_codes value with | Nil => False | Cons a rest =>
      match rest with | Nil => False | Cons b tail =>
        match tail with | Nil => False | Cons c last =>
          match last with | Cons _ _ => False | Nil => raw_bool_and (access_natural_same first a)
            (raw_bool_and (access_natural_same second b) (access_natural_same third c)) end end end end;
def access_codes_string (expected : String) (values : List Nat) : Bool := source_string_equal expected (access_of_codes values);
def access_roundtrip (value : String) : Bool := source_string_equal value (access_of_codes (access_to_codes value));
def access_answer (zero : U32) (valid : Bool) : U32 := match valid with | True => source_forty_two zero | False => zero end;

intrinsic access_size_nat : USize -> Nat := "ouro.usize.to_nat.bits";

-- Build the same large mathematical inputs without a deep Peano source term.
def access_huge (zero : U32) : Nat :=
    match usize_from_nat 1 with | Nothing => Z | Just one =>
      S (access_size_nat (usize_sub (raw_u32_to_size zero) one)) end;
def access_modulo_large (zero : U32) : Nat :=
    match usize_from_nat 1 with | Nothing => Z | Just one =>
      match u32_from_nat 32 with | Nothing => Z | Just shift =>
        access_size_nat (usize_add (usize_shift_left one shift) one) end end;
