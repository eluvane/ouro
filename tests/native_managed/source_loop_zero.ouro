import "source_loop_values.ouro";
import "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      runtime_bind U32 U32 (runtime_loop U32 zero (loop_condition zero (loop_zero_byte zero)) loop_abort)
        (fun (answer : U32) => runtime_pure U32 (source_answer zero (u32_equal answer zero))));
