-- Empty/missing directories and file-as-directory are ordinary creation
-- failures. The primitive neither creates missing parents nor truncates an
-- existing path, and a reused failing action performs no cached success.
import "source_startup_values.ouro";


def main : IO Unit :=
    do let! empty := prim_fs_temp_file_in "";
       startup_expect (prim_string_eq empty "");
       let! file := prim_fs_temp_file;
       startup_expect (notb (prim_string_eq file ""));
       prim_fs_write_file file "preserve";
       let failed : IO String := prim_fs_temp_file_in file in
       do let! first := failed;
          let! second := failed;
          startup_expect (andb (prim_string_eq first "") (prim_string_eq second ""));
          let! contents := prim_fs_read_file file;
          startup_expect (prim_string_eq contents "preserve");
          prim_fs_remove file;
          let! missing := prim_fs_temp_file_in file;
          startup_expect (prim_string_eq missing "");
          let! exists := prim_fs_exists file;
          startup_expect (notb exists);
          exit 42
