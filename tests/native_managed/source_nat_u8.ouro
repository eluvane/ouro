import "source_nat_values.ouro";
import "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u8_from_nat 255 with | Nothing => runtime_pure U32 zero | Just maximum =>
        let original : Nat := nat_identity (nat_u8_to_nat maximum) in
        let larger : Nat := nat_successor original in
        let expected : U32 := match u32_from_nat 256 with | Nothing => zero | Just value => value end in
        runtime_pure U32 (source_answer zero (raw_bool_and
          (match u8_from_nat original with | Nothing => False | Just actual => u8_equal actual maximum end)
          (raw_bool_and (nat_u8_missing larger)
            (raw_bool_and (nat_u32_same expected larger)
              (nat_u32_same (u8_to_u32 maximum) (nat_predecessor larger)))))) end);
