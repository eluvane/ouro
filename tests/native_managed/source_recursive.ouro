import "source_values.ouro";

inductive SourceChain : Type := | SourceEnd : U32 -> SourceChain | SourceNext : SourceChain -> SourceChain;

def source_last : SourceChain -> U32 :=
    fix last (chain : SourceChain) : U32 :=
      match chain with | SourceEnd value => value | SourceNext rest => last rest end;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      runtime_pure(U32, source_last (SourceNext (SourceNext (SourceEnd (source_forty_two zero))))));
