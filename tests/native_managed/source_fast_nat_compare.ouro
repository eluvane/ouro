import "source_fast_nat_values.ouro";
import "../../compiler/base.ouro";

def fast_nat_full_order (maximum : Nat) : Bool :=
    let boundary : Nat := S maximum in
    let after : Nat := S boundary in
    andb (compiler_lt_nat maximum boundary)
      (andb (fast_nat_greater boundary maximum)
        (andb (compiler_lt_nat boundary after)
          (andb (fast_nat_greater after boundary)
            (match fast_nat_apply_order compareNat boundary boundary with
              | LT => False | EQ => True | GT => False end))));

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) => fast_nat_boundaries zero fast_nat_full_order);
