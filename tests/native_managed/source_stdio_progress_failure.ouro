-- Exact retained raw progress assertions, grouped for bounded native preparation.
import "source_stdio_values.ouro";
import "../native_runtime/common.ouro";

def main : Runtime U32 :=
    match usize_from_nat 1 with | Nothing => runtime_test_failure | Just one =>
      match usize_from_nat 10 with | Nothing => runtime_test_failure | Just bytes =>
        match u32_from_nat 32 with | Nothing => runtime_test_failure | Just shift =>
          let zero : USize := usize_sub one one in
          let two : USize := usize_add one one in
          let three : USize := usize_add two one in
          let five : USize := usize_add three two in
          let word_one : U32 := raw_size_to_u32 one in
          let word_zero : U32 := u32_sub word_one word_one in
          let requested : U32 := raw_size_to_u32 (usize_sub bytes two) in
          let maximum : U32 := u32_sub word_zero word_one in
          let failure : USize := usize_add bytes one in
          runtime_test_outcome (raw_bool_and (usize_equal (raw_windows_write_progress bytes two requested word_zero word_one one) failure)
              (raw_bool_and (usize_equal (raw_windows_write_progress bytes two requested requested word_zero one) failure)
              (usize_equal (raw_windows_write_progress bytes two requested
                  (raw_size_to_u32 (usize_sub bytes one)) word_one one) failure))) end end end;
