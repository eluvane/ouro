-- Server must require POST and X-Ouro: native, then echo all request bytes
-- with status 207. Exactly three requests prove deferred action reuse.
import "http_values.ouro";
import "source_values.ouro";

def http_roundtrip_check (expected : String) (result : Pair Nat (Pair String String)) : IO Unit :=
    match result with | MkPair status payload => match payload with | MkPair body _ =>
      file_expect (andb (eq_nat status 207) (prim_string_eq expected body)) end end;

def main : IO Unit :=
    http_fixture_run (fun (url : String) =>
      let first_class : String -> List (Pair String String) -> String -> IO (Pair Nat (Pair String String)) := prim_http_request in
      let partial : List (Pair String String) -> String -> IO (Pair Nat (Pair String String)) := first_class url in
      let fields : List (Pair String String) := [MkPair String String "X-Ouro" "native"] in
      let send : String -> IO (Pair Nat (Pair String String)) := partial fields in
      let binary : String := file_double 12 file_binary in
      let saved : IO (Pair Nat (Pair String String)) := send binary in
      do let! first := saved;
         http_roundtrip_check binary first;
         let churned : String := source_churn 96 "root" in
         let! second := saved;
         http_roundtrip_check binary second;
         file_expect (eq_nat (prim_string_length churned) 100);
         let! public := http_post url fields binary;
         file_expect (andb (eq_nat (http_status public) 207) (prim_string_eq (http_body public) binary));
         exit 42);
