import "source_fast_nat_values.ouro",
  "source_values.ouro";

def fast_nat_small_eq (origin : Nat) : Bool :=
    andb(fast_nat_apply_bool eqNat 42 42, notb (fast_nat_apply_bool eqNat 41 42));

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      runtime_pure(U32, source_answer(zero, fast_nat_small_eq (nat_u32_to_nat zero))));
