import "source_directory_values.ouro",
  "source_values.ouro";

def main : IO Unit :=
    let listing : IO (List String) := fs_list "directories/reused" in
    let probing : IO Bool := prim_fs_listable "directories/reused" in
    do let! first := listing;
       let! before := probing;
       prim_fs_write_file "directories/reused/after.txt" "after";
       let churned : String := source_churn 64 "root" in
       do let! second := listing;
          let! after := probing;
          directory_expect (andb before after);
          directory_expect (directory_members first ["before.txt"]);
          directory_expect (directory_members second ["before.txt", "after.txt"]);
          directory_expect (eq_nat(prim_string_length churned, 68));
          exit 42
