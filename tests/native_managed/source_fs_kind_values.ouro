-- Path queries preserve exact bytes until the strict UTF-8 boundary.
import "source_startup_values.ouro";

def kind_print (value : Nat) : IO Unit :=
    match value with | Z => print "0" | S one =>
      match one with | Z => print "1" | S two =>
        match two with | Z => print "2" | S three =>
          match three with | Z => print "3" | S _ => exit 91 end end end end;

def kind_paths : List String -> IO Unit :=
    fix paths (remaining : List String) : IO Unit :=
      match remaining with | Nil => io_unit | Cons path rest =>
        do let! result := prim_fs_kind path;
           kind_print result;
           print "\n";
           paths rest end;
