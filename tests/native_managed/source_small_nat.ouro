-- Native arithmetic/word source laws. Every numeric boundary is built from
-- existing machine conversions and small Nat arithmetic, not giant literals.
import "source_nat_values.ouro",
  "source_file_values.ouro",
  "../../std/word.ouro",
  "../../std/listx.ouro",
  "../../std/string.ouro";

def small_nat_apply (operation : Nat -> Nat -> Nat) (left : Nat) (right : Nat) : Nat :=
    let partial : Nat -> Nat := operation left in partial right;

def small_nat_all (checks : List Bool) : Bool := all Bool (fun (value : Bool) => value) checks;

def small_nat_small : Bool := small_nat_all
    [eq_nat(mul 0 9, 0), eq_nat(mul 7 6, 42),
     eq_nat(div_nat 0 3, 0), eq_nat(div_nat 42 1, 42),
     eq_nat(div_nat 42 6, 7), eq_nat(div_nat 43 6, 7),
     eq_nat(mod_nat 43 6, 1), eq_nat(mod_nat 42 6, 0)];

def small_nat_zero (maximum : Nat) : Bool := small_nat_all
    [eq_nat(div_nat 0 0, 0), eq_nat(mod_nat 0 0, 0),
     eq_nat(div_nat maximum 0, 0), eq_nat(mod_nat maximum 0, maximum)];

def small_nat_u64 (max32 : Nat) (max64 : Nat) : Bool :=
    let high63 : Nat := small_nat_apply div_nat max64 2 in
    small_nat_all [eq_nat(mul max32 max32, sub(max64, add max32 max32)),
      eq_nat(div_nat max64 max64, 1), eq_nat(mod_nat max64 max64, 0),
      eq_nat(div_nat(max64, S max32), max32), eq_nat(mod_nat(max64, S max32), max32),
      eq_nat(add(add high63 high63, 1), max64), eq_nat(mod_nat max64 2, 1),
      eq_nat(div_nat(S max32, 2), shl32 1 31)];

def small_nat_fallback (max64 : Nat) : Bool :=
    let wide : Nat := S max64 in
    let divisor : Nat := S wide in
    small_nat_all [eq_nat(mul 0 divisor, 0), eq_nat(mul 1 divisor, divisor),
      eq_nat(div_nat(add divisor 16, divisor), 1),
      eq_nat(mod_nat(add divisor 16, divisor), 16),
      eq_nat(div_nat 42 divisor, 0), eq_nat(mod_nat 42 divisor, 42),
      eq_nat(div_nat divisor 0, 0), eq_nat(mod_nat divisor 0, divisor)];

def small_nat_word (max32 : Nat) (max64 : Nat) : Bool :=
    let bound : Nat := S max32 in
    let high : Nat := shl32 1 31 in
    small_nat_all [eq_nat(shl32 bound 0, bound), eq_nat(shl32 bound 32, bound),
      eq_nat(shl32 bound 1, 0), eq_nat(shr32 bound 1, high),
      eq_nat(rotr32 bound 1, high), eq_nat(rotr32 bound 32, 0),
      eq_nat(shl32(S max64, 0), S max64),
      eq_nat(xor32(add bound 1, 0), 1),
      eq_nat(and32(add bound 15, 9), 9), eq_nat(or32(S bound, 2), 3),
      eq_nat(add32(add bound 9, max32), 8)];

def small_nat_partial (max32 : Nat) (max64 : Nat) : Bool :=
    let quotient : Nat -> Nat := div_nat max64 in
    let remainder : Nat -> Nat := mod_nat max64 in
    small_nat_all [eq_nat(small_nat_apply mul 6 7, 42),
      eq_nat(quotient max64, 1), eq_nat(quotient (S max32), max32),
      eq_nat(remainder (S max32), max32),
      eq_nat(small_nat_apply(mod_nat, add(S max64, 17), add(S max64, 1)), 16)];

def small_nat_dormant (max64 : Nat) : Bool :=
    let huge : Nat := add(S max64, 17) in
    let partial : Nat -> Nat := mul huge in
    let pending : Runtime Nat := runtime_bind Unit Nat (runtime_pure Unit MkUnit)
      (fun (_ : Unit) => runtime_pure(Nat, mul huge huge)) in
    andb(eq_nat(length(Nat -> Nat, [partial]), 1), eq_nat(length(Runtime Nat, [pending]), 1));

def small_mutant_add (n : Nat) (m : Nat) : Nat := Z;

def small_mutant_mul : Nat -> Nat -> Nat :=
  fix small_mutant_mul (n : Nat) (m : Nat) : Nat :=
    match n with | Z => Z | S n' => small_mutant_add(m, small_mutant_mul n' m) end;

def small_mutant_sub (n : Nat) (m : Nat) : Nat := Z;

def small_mutant_div_sub (n : Nat) (m : Nat) : Nat :=
    match m with
    | Z => Z
    | S _ =>
      (fix go (fuel : Nat) (acc : Nat) (left : Nat) : Nat :=
        match fuel with
        | Z => acc
        | S fuel2 =>
          match ltb_nat left m with
          | True => acc
          | False => go(fuel2, S acc, small_mutant_sub left m)
          end
        end) (S n) Z n
    end;

def small_mutant_mod_sub (n : Nat) (m : Nat) : Nat :=
    match m with
    | Z => n
    | S _ =>
      (fix go (fuel : Nat) (left : Nat) : Nat :=
        match fuel with
        | Z => left
        | S fuel2 =>
          match ltb_nat left m with
          | True => left
          | False => go(fuel2, small_mutant_sub left m)
          end
        end) (S n) n
    end;

def small_mutant_ltb (n : Nat) (m : Nat) : Bool := False;

def small_mutant_div_ltb (n : Nat) (m : Nat) : Nat :=
    match m with
    | Z => Z
    | S _ =>
      (fix go (fuel : Nat) (acc : Nat) (left : Nat) : Nat :=
        match fuel with
        | Z => acc
        | S fuel2 =>
          match small_mutant_ltb left m with
          | True => acc
          | False => go(fuel2, S acc, sub left m)
          end
        end) (S n) Z n
    end;

def small_mutant_compare : Nat -> Nat -> Ordering :=
  fix small_mutant_compare (n : Nat) (m : Nat) : Ordering :=
    match n, m with
    | Z, Z => EQ
    | Z, S _ => GT
    | S _, Z => GT
    | S n', S m' => small_mutant_compare n' m'
    end;

def small_mutant_compare_ltb (n : Nat) (m : Nat) : Bool :=
    match small_mutant_compare n m with
    | LT => True
    | EQ => False
    | GT => False
    end;

def small_mutant_div_compare (n : Nat) (m : Nat) : Nat :=
    match m with
    | Z => Z
    | S _ =>
      (fix go (fuel : Nat) (acc : Nat) (left : Nat) : Nat :=
        match fuel with
        | Z => acc
        | S fuel2 =>
          match small_mutant_compare_ltb left m with
          | True => acc
          | False => go(fuel2, S acc, sub left m)
          end
        end) (S n) Z n
    end;

def small_mutant_div_zero (n : Nat) (m : Nat) : Nat :=
    match m with
    | Z => S Z
    | S _ =>
      (fix go (fuel : Nat) (acc : Nat) (left : Nat) : Nat :=
        match fuel with
        | Z => acc
        | S fuel2 =>
          match ltb_nat left m with
          | True => acc
          | False => go(fuel2, S acc, sub left m)
          end
        end) (S n) Z n
    end;

def small_mutant_mod_zero (n : Nat) (m : Nat) : Nat :=
    match m with
    | Z => Z
    | S _ =>
      (fix go (fuel : Nat) (left : Nat) : Nat :=
        match fuel with
        | Z => left
        | S fuel2 =>
          match ltb_nat left m with
          | True => left
          | False => go(fuel2, sub left m)
          end
        end) (S n) n
    end;

def small_nat_mutants : Bool := small_nat_all
    [eq_nat(small_mutant_mul 2 3, 0), eq_nat(small_mutant_div_sub 7 2, 1),
     eq_nat(small_mutant_mod_sub 7 2, 0), eq_nat(small_mutant_div_ltb 1 2, 2),
     eq_nat(small_mutant_div_compare 1 2, 2), eq_nat(small_mutant_div_zero 42 0, 1),
     eq_nat(small_mutant_mod_zero 42 0, 0)];

def small_nat_case (name : String) (max32 : Nat) (max64 : Nat) : Bool :=
    match str_eq name "small" with | True => small_nat_small | False =>
      match str_eq name "zero" with | True => small_nat_zero max64 | False =>
        match str_eq name "u64" with | True => small_nat_u64 max32 max64 | False =>
          match str_eq name "fallback" with | True => small_nat_fallback max64 | False =>
            match str_eq name "word" with | True => small_nat_word max32 max64 | False =>
              match str_eq name "partial" with | True => small_nat_partial max32 max64 | False =>
                match str_eq name "dormant" with | True => small_nat_dormant max64 | False =>
                  match str_eq name "mutants" with | True => small_nat_mutants | False => False end end end end end end end end;

def small_nat_main (name : String) : IO Unit :=
    runtime_bind U32 Unit source_zero (fun (zero : U32) =>
      match u32_from_nat 1, usize_from_nat 1 with
      | Just first, Just second =>
          let max32 : Nat := nat_u32_to_nat (u32_sub zero first) in
          let max64 : Nat := nat_u64_to_nat (usize_to_u64 (usize_sub(raw_u32_to_size zero, second))) in
          match small_nat_case name max32 max64 with
          | False => do eprintln (str_concat "SMALL_NAT_FAIL " name); exit 91
          | True => do println (str_concat "SMALL_NAT_OK " name); exit 42 end
      | Nothing, Just _ => exit 91 | Just _, Nothing => exit 91 | Nothing, Nothing => exit 91 end);

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Cons _ rest => match rest with
         | Cons name remaining => match remaining with | Nil => small_nat_main name | Cons _ _ => exit 91 end
         | Nil => exit 91 end | Nil => exit 91 end
