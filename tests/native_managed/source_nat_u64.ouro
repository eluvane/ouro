import "source_nat_values.ouro";
import "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match usize_from_nat 1 with | Nothing => runtime_pure U32 zero | Just one =>
        let maximum : U64 := usize_to_u64 (usize_sub (raw_u32_to_size zero) one) in
        let original : Nat := nat_u64_to_nat maximum in
        let larger : Nat := nat_successor original in
        let twice : Nat := nat_successor larger in
        runtime_pure U32 (source_answer zero (raw_bool_and (nat_u64_same maximum original)
          (raw_bool_and (nat_u64_missing larger) (raw_bool_and (nat_u64_missing twice)
            (raw_bool_and (nat_u64_same maximum (nat_predecessor larger))
              (nat_u64_same maximum (nat_predecessor (nat_predecessor twice)))))))) end);
