import "source_values.ouro";

inductive SourceBox (A : Type) : Type := | SourceBoxOf : A -> SourceBox A;
inductive SourcePair : Type := | SourcePairOf : U32 -> U32 -> SourcePair;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let pair : SourcePair := SourcePairOf (source_twenty zero) (source_twenty_two zero) in
      let boxed : SourceBox SourcePair := SourceBoxOf SourcePair pair in
      runtime_pure U32 (match boxed with | SourceBoxOf value =>
        match value with | SourcePairOf first second => source_add first second end end));
