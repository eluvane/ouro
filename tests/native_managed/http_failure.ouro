-- Supply a refused loopback port, malformed local response, or local HTTPS
-- endpoint with an untrusted/self-signed certificate. None may fake success.
import "http_values.ouro";

def main : IO Unit :=
    http_fixture_run (fun (url : String) =>
      let saved : IO (Pair Nat (Pair String String)) := prim_http_request url [] file_binary in
      do let! first := saved;
         http_fixture_expect_failure first;
         let! second := saved;
         http_fixture_expect_failure second;
         exit 42);
