import "source_startup_values.ouro";

def copy_fault_pending_empty_source : IO Unit :=
    prim_fs_copy_file "" "files/destination";

def copy_fault_pending_invalid_target : IO Unit :=
    prim_fs_copy_file("files/source", prim_string_of_char_codes [255]);

def copy_fault_pending_nul_source : IO Unit :=
    prim_fs_copy_file(prim_string_of_char_codes [65, 0], "files/destination");

def copy_fault_pending : List (IO Unit) :=
    [copy_fault_pending_empty_source, copy_fault_pending_invalid_target, copy_fault_pending_nul_source];

def copy_fault_three_pending (pending : List (IO Unit)) : Bool :=
    match pending with | Nil => False | Cons _ first =>
      match first with | Nil => False | Cons _ second =>
        match second with | Nil => False | Cons _ rest =>
          match rest with | Nil => True | Cons _ _ => False end end end end;

def main : IO Unit :=
    do startup_expect (copy_fault_three_pending copy_fault_pending);
       exit 42
