import "source_values.ouro";

extern source_process_version : U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetProcessVersion" "maygc";

def source_after_foreign (value : U32) : Runtime U32 :=
    runtime_pure U32 (source_forty_two (u32_sub value value));

def source_query_version (zero : U32) : Runtime U32 :=
    runtime_bind U32 U32 (source_process_version zero) source_after_foreign;

def main : Runtime U32 := runtime_bind U32 U32 source_zero source_query_version;
