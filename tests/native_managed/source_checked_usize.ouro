import "source_values.ouro",
  "../../std/io.ouro";

intrinsic checked_usize_add : USize -> USize -> Maybe USize := "ouro.usize.add.checked";
intrinsic checked_usize_to_u32 : USize -> Maybe U32 := "ouro.convert.usize.u32.checked";

extern checked_usize_process_id : Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetCurrentProcessId" "maygc";

def checked_usize_present (expected : USize) (result : Maybe USize) : Bool :=
    match result with | Nothing => False | Just actual => usize_equal actual expected end;

def checked_u32_present (expected : U32) (result : Maybe U32) : Bool :=
    match result with | Nothing => False | Just actual => u32_equal actual expected end;

def checked_usize_absent (result : Maybe USize) : Bool :=
    match result with | Nothing => True | Just _ => False end;

def checked_u32_absent (result : Maybe U32) : Bool :=
    match result with | Nothing => True | Just _ => False end;

def checked_usize_fail (zero : U32) : Runtime U32 :=
    runtime_bind Unit U32 (exit 91) (fun (_ : Unit) => runtime_pure U32 zero);

def checked_usize_finish (zero : U32) (valid : Bool) : Runtime U32 :=
    match valid with | False => checked_usize_fail zero | True =>
      match u32_from_nat 42 with | Nothing => checked_usize_fail zero
        | Just answer => runtime_pure U32 answer end end;

def checked_usize_add_edges (zero : USize) (one : USize) (maximum : USize) : Bool :=
    raw_bool_and (checked_usize_present zero (checked_usize_add zero zero))
      (raw_bool_and (checked_usize_present one (checked_usize_add zero one))
        (raw_bool_and (checked_usize_present maximum (checked_usize_add maximum zero))
          (raw_bool_and (checked_usize_present maximum (checked_usize_add (usize_sub maximum one) one))
            (raw_bool_and (checked_usize_absent (checked_usize_add maximum one))
              (checked_usize_absent (checked_usize_add maximum maximum))))));

def checked_usize_conversion_edges (zero : U32) (maximum : U32) (wide_maximum : USize)
    (one : USize) (all_bits : USize) : Bool :=
    let over : USize := usize_add wide_maximum one in
    raw_bool_and (checked_u32_present zero (checked_usize_to_u32 (raw_u32_to_size zero)))
      (raw_bool_and (checked_u32_present maximum (checked_usize_to_u32 wide_maximum))
        (raw_bool_and (checked_u32_absent (checked_usize_to_u32 over))
          (raw_bool_and (checked_u32_absent (checked_usize_to_u32 all_bits))
            (u32_equal (raw_size_to_u32 over) zero))));

def main : Runtime U32 :=
    runtime_bind U32 U32 checked_usize_process_id (fun (seed : U32) =>
      let zero : U32 := u32_sub seed seed in
      let size_zero : USize := raw_u32_to_size zero in
      let size_seed : USize := raw_u32_to_size seed in
      match usize_from_nat 1 with | Nothing => checked_usize_fail zero | Just one =>
        match u32_from_nat 1 with | Nothing => checked_usize_fail zero | Just word_one =>
          match u32_from_nat 255 with | Nothing => checked_usize_fail zero | Just byte_maximum =>
            match u32_from_nat 256 with | Nothing => checked_usize_fail zero | Just above_byte =>
              let maximum : USize := usize_sub size_zero one in
              let word_maximum : U32 := u32_sub zero word_one in
              let wide_maximum : USize := raw_u32_to_size word_maximum in
              let saved : Maybe USize := checked_usize_add size_seed size_zero in
              let rejected : Maybe USize := checked_usize_add maximum one in
              let converted : Maybe U32 := checked_usize_to_u32 size_seed in
              checked_usize_finish zero
                (raw_bool_and (checked_usize_present size_seed saved)
                  (raw_bool_and (checked_usize_absent rejected)
                    (raw_bool_and (checked_u32_present seed converted)
                      (raw_bool_and (usize_equal (usize_add maximum one) size_zero)
                        (raw_bool_and (checked_usize_add_edges size_zero one maximum)
                          (raw_bool_and (checked_usize_conversion_edges zero word_maximum wide_maximum one maximum)
                            (raw_bool_and (checked_u32_present byte_maximum (checked_usize_to_u32 (raw_u32_to_size byte_maximum)))
                              (checked_u32_present above_byte (checked_usize_to_u32 (raw_u32_to_size above_byte))))))))))
            end end end end);
