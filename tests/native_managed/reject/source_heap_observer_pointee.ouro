import "../source_values.ouro";

intrinsic selected_heap_observer : Runtime (Maybe Nat) := "ouro.managed.allocated_requested_bytes";
def raw_managed_allocated_requested_bytes (context : RawPtr U32) : Runtime USize :=
    raw_to_bits U32 context;

def main : Runtime Unit :=
    runtime_bind (Maybe Nat) Unit selected_heap_observer
      (fun (_sample : Maybe Nat) => runtime_pure Unit MkUnit);
