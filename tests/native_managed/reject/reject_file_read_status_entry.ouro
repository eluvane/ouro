import "../source_values.ouro";

intrinsic String : Type := "ouro.string";
intrinsic selected_status : String -> Runtime (Pair Nat String) := "ouro.fs.read_file_status";

def main : Runtime Unit :=
    runtime_bind (Pair Nat String) Unit (selected_status "files/unused.bin")
      (fun (_ : Pair Nat String) => runtime_pure Unit MkUnit);
