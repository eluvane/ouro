import "../source_values.ouro";

intrinsic String : Type := "ouro.string";
def CaptureLimits : Type := Pair Nat (Pair Nat (Pair Nat (Pair Nat Nat)));
def CaptureRequest : Type := Pair String CaptureLimits;
def CaptureReply : Type := Pair Nat (Pair Nat (Pair Nat (Pair String String)));
intrinsic selected : String -> List String -> CaptureRequest -> Runtime CaptureReply := "ouro.process.capture_bounded";

def main : Runtime Unit :=
    runtime_bind CaptureReply Unit (selected "unused.exe" ([] : List String)
      (MkPair String CaptureLimits "" (MkPair Nat (Pair Nat (Pair Nat (Pair Nat Nat))) 250
        (MkPair Nat (Pair Nat (Pair Nat Nat)) 64 (MkPair Nat (Pair Nat Nat) 1 (MkPair Nat Nat 0 0))))))
      (fun (_ : CaptureReply) => runtime_pure Unit MkUnit);
