import "../source_values.ouro";

intrinsic String : Type := "ouro.string";
intrinsic selected_time : Runtime String := "ouro.time.now";
def raw_windows_wall_time (_ : RawPtr U32) : Runtime U32 := source_zero;

def main : Runtime Unit :=
    runtime_bind String Unit selected_time (fun (_ : String) => runtime_pure Unit MkUnit);
