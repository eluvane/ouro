import "../source_values.ouro";

intrinsic String : Type := "ouro.string";
intrinsic selected_write : String -> Runtime Unit := "ouro.runtime.stdout.write";
axiom false_byte : U8;
def raw_windows_stdout (message : RawPtr U8) (bytes : USize) (written : RawPtr U32) : Runtime U8 :=
    runtime_pure U8 false_byte;

def main : Runtime Unit := selected_write "must reject";
