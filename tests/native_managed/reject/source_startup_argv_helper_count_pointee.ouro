import "reject_startup_argv_entry.ouro";
-- Checked source mutant: the startup helper contract must fail before emission.
import "../source_values.ouro";

def raw_windows_utf16_to_utf8 (source : RawPtr U8) (units : USize)
    (target : RawPtr U8) (bytes : USize) (count : RawPtr U32) : Runtime U32 :=
    runtime_pure U32 (raw_size_to_u32 (usize_sub units units));
def raw_windows_argv_open (owner : RawPtr USize) (count : RawPtr USize) : Runtime U32 :=
    runtime_bind USize U32 (raw_load_usize count) (fun (word : USize) => runtime_pure U32 (raw_size_to_u32 (usize_sub word word)));

