import "../source_values.ouro";

intrinsic String : Type := "ouro.string";
intrinsic selected : String -> List String -> Runtime (Pair Nat Nat) := "ouro.process.inherit";

def main : Runtime Unit :=
    runtime_bind (Pair Nat Nat) Unit (selected "unused.exe" ([] : List String))
      (fun (_ : Pair Nat Nat) => runtime_pure Unit MkUnit);
