-- The harness supplies an ASCII 'a' file. Keep the complete byte list alive
-- across two tail folds, as compiler source loading does before checking.
import "source_file_values.ouro";
import "../../std/fs.ouro";
import "../../std/listx.ouro";

def file_codes_check (text : String) : IO Unit :=
    let codes : List Nat := prim_string_to_char_codes text in
    let count : Nat := foldl Nat Nat
        (fun (total : Nat) (_ : Nat) => add total 1) 0 codes in
    let exact : Bool := foldl Nat Bool
        (fun (valid : Bool) (byte : Nat) => andb valid (eq_nat byte 97)) True codes in
    do file_expect (andb exact (eq_nat count (prim_string_length text)));
       println "NATIVE_FILE_CODES_OK";
       exit 42

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with
       | Nil => exit 91
       | Cons _ rest => match rest with
         | Nil => exit 91
         | Cons path trailing => match trailing with
           | Cons _ _ => exit 91
           | Nil =>
               do let! loaded := fs_read_checked path;
                  match loaded with
                  | Left error => do eprintln (fs_error_message error); exit 1
                  | Right text => file_codes_check text
                  end
           end
         end
       end
