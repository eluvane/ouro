import "source_nat_values.ouro";

intrinsic String : Type := "ouro.string";
intrinsic tail_string_equal : String -> String -> Bool := "ouro.string.eq";

def tail_countdown (fallback : U32) : Nat -> U32 :=
    fix countdown (value : Nat) : U32 :=
      match value with | Z => source_forty_two fallback | S previous => countdown previous end;

def tail_captured (fallback : U32) (text : String) : Nat -> U32 :=
    fix countdown (value : Nat) : U32 :=
      match value with
      | Z => match tail_string_equal text "captured across tail calls" with
        | True => source_forty_two fallback | False => fallback end
      | S previous => countdown previous end;

def tail_after_call (zero : U32) : Nat -> U32 :=
    fix countdown (value : Nat) : U32 :=
      match value with | Z => zero | S previous =>
        match u32_from_nat 1 with | Nothing => zero | Just one => source_add one (countdown previous) end end;

def tail_countup (expected : U32) (one : U32) (zero : U32) : Nat -> U32 -> U32 :=
    fix countdown (value : Nat) (count : U32) : U32 :=
      match value with
      | Z => match u32_equal count expected with
        | True => source_forty_two zero | False => zero end
      | S previous => countdown previous (source_add count one) end;
