import "source_values.ouro";

def source_select (fallback : U32) : Runtime U32 :=
    let chosen : Bool := u32_equal fallback fallback in
    match chosen with
    | True => runtime_pure U32 (source_forty_two fallback)
    | False => runtime_pure U32 fallback end;

def main : Runtime U32 := runtime_bind U32 U32 source_zero source_select;
