import "source_startup_values.ouro";

def main : IO Unit :=
    let ignored_args : IO (List String) := argv in
    let invalid_name : String := prim_string_of_char_codes [255] in
    let ignored_lookup : IO (Maybe String) := env_get invalid_name in
    let ignored_zero : IO (Maybe String) := env_get (prim_string_of_char_codes [65, 0, 66]) in
    exit 42;
