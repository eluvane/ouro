-- Reusing a zero-argument action must create separate empty files. Every
-- returned path transfers removal ownership and permits exact binary IO.
import "source_startup_values.ouro";


def main : IO Unit :=
    let saved : IO String := prim_fs_temp_file in
    do let! first := saved;
       let! second := saved;
       startup_expect (andb(notb (prim_string_eq first ""), notb (prim_string_eq first second)));
       let! first_empty := prim_fs_read_file first;
       let! second_empty := prim_fs_read_file second;
       startup_expect (andb(prim_string_eq first_empty "", prim_string_eq second_empty ""));
       let payload : String := prim_string_of_char_codes [0, 255, 128, 65, 13, 10, 0] in
       do prim_fs_write_file first payload;
          let! contents := prim_fs_read_file first;
          startup_expect (prim_string_eq contents payload);
          prim_fs_remove first;
          prim_fs_remove second;
          let! first_exists := prim_fs_exists first;
          let! second_exists := prim_fs_exists second;
          startup_expect (andb(notb first_exists, notb second_exists));
          exit 42
