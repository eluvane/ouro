import "source_directory_values.ouro";

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with
       | Cons _ rest => match rest with
         | Cons path last => match last with
           | Nil => do let! names := fs_list path;
                       directory_expect (directory_members names ["sentinel.txt"]);
                       exit 42
           | Cons _ _ => exit 91 end
         | Nil => exit 91 end
       | Nil => exit 91 end
