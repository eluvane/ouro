-- File fixtures only access files created by their owned host harness.
import "source_values.ouro",
  "../../std/io.ouro";

def source_words_equal : List String -> List String -> Bool :=
    fix same (left : List String) (right : List String) : Bool :=
      match left with
      | Nil => match right with | Nil => True | Cons _ _ => False end
      | Cons first rest => match right with | Nil => False | Cons other tail =>
          andb(prim_string_eq first other, same rest tail) end end;

def file_expect (condition : Bool) : IO Unit :=
    match condition with | True => io_unit | False => exit 91 end;

def file_binary : String := prim_string_of_char_codes [65, 0, 255, 128, 10, 13, 90];

-- Allocation pressure for IO fixtures belongs with the checked String imports.
def source_churn : Nat -> String -> String :=
    fix churn (remaining : Nat) (value : String) : String :=
      match remaining with | Z => value | S rest => churn(rest, prim_string_concat value "x") end;

def file_double : Nat -> String -> String :=
    fix double (remaining : Nat) (value : String) : String :=
      match remaining with | Z => value | S rest => double(rest, prim_string_concat value value) end;
