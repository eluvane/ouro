-- Test-owned child for the stage transport, not a compiler or accepted seed.
import "../native_pe_inspect_fixtures.ouro",
  "../../tools/native_toolchain_model.ouro",
  "../../std/fs.ouro";

def toolchain_protocol_binary : String := str_of_codes [65, 0, 255, 13, 10, 66, 67];

def toolchain_protocol_units (mode : String) : List String :=
    [native_toolchain_root, "units/雪 space.ouro", "units/quote\"here.ouro",
      "units/trailing\\.ouro", "", mode];

def toolchain_protocol_expect (accepted : Bool) : IO Unit :=
    match accepted with | True => io_unit | False => exit 91 end;

def toolchain_protocol_write (path : String) (text : String) : IO Unit :=
    do let! written := fs_write_checked path text;
       match written with | Left _ => exit 91 | Right _ => io_unit end;

def toolchain_protocol_context : IO Unit :=
    do let! read := fs_read_checked "cwd-input.bin";
       match read with | Left _ => exit 91
       | Right bytes => toolchain_protocol_expect (prim_string_eq bytes toolchain_protocol_binary) end;
       let! value := prim_env_get "OURO_TOOLCHAIN_PROTOCOL";
       match value with | Nothing => exit 91
       | Just text => toolchain_protocol_expect (prim_string_eq text "owned 雪") end;
       let! eof := prim_stdin_read_bytes 1;
       toolchain_protocol_expect (str_null eof);

def toolchain_protocol_child_mode (mode : String) (output : String) : IO Unit :=
    match str_eq mode "exit259" with
    | True => do print toolchain_protocol_binary; eprint toolchain_protocol_binary; exit 259
    | False => match str_eq mode "timeout" with
      | True => match u32_from_nat (mul 8 250) with
        | Nothing => exit 91 | Just delay => do windows_capture_sleep delay; exit 91 end
      | False => match str_eq mode "output-cap" with
        | True => do print (str_repeat "x" (mul 4 256)); exit 0
        | False => match str_eq mode "no-image" with
          | True => do println output; exit 0
          | False => match elem String str_eq mode
              ["success", "extra-output", "binary-stderr", "mutate-original", "mutate-snapshot"] with
            | False => exit 91
            | True =>
                do match str_eq mode "mutate-original" with
                   | True => toolchain_protocol_write "../original/Ouro.seal" "seal altered\n"
                   | False => match str_eq mode "mutate-snapshot" with
                     | True => toolchain_protocol_write "Ouro.seal" "seal altered\n"
                     | False => io_unit end end;
                   toolchain_protocol_write output native_pe_probe_image;
                   println output;
                   match str_eq mode "extra-output" with
                   | True => print (str_of_codes [0])
                   | False => match str_eq mode "binary-stderr" with
                     | True => eprint toolchain_protocol_binary
                     | False => io_unit end end;
                   exit 0
            end
          end
        end
      end
    end;

-- @entry main
def main : IO Unit :=
    do let! arguments := argv;
       match tail String arguments with
       | Nil => exit 91
       | Cons root rest => match rest with
         | Nil => exit 91
         | Cons output units =>
             let mode : String := last String "" units in
             do toolchain_protocol_expect (prim_string_eq root native_toolchain_root);
                toolchain_protocol_expect (list_eq String prim_string_eq units (toolchain_protocol_units mode));
                toolchain_protocol_context;
                toolchain_protocol_child_mode mode output
         end
       end;
