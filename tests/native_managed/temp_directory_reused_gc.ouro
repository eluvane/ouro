-- The directory-taking primitive escapes as a first-class value. Its
-- captured dynamic Unicode path survives allocations and repeated execution.
-- The target directory is created only after the action has been built.
import "source_startup_values.ouro",
  "../../std/natx.ouro",
  "source_values.ouro";


def main : IO Unit :=
    let create : String -> IO String := prim_fs_temp_file_in in
    do let! reserved := prim_fs_temp_file;
       startup_expect (notb (prim_string_eq reserved ""));
       prim_fs_remove reserved;
       let directory : String := prim_string_concat reserved "/雪" in
       let saved : IO String := create directory in
       do prim_fs_mkdir directory;
          let noise : String := source_churn 192 "root" in
          do let! first := saved;
             let! second := saved;
             startup_expect (eq_nat(prim_string_length noise, 196));
             startup_expect (andb (prim_string_starts(first, prim_string_concat directory "/"))
               (andb(prim_string_starts(second, prim_string_concat directory "/"), notb (prim_string_eq first second))));
             let! empty := prim_fs_read_file first;
             startup_expect (prim_string_eq empty "");
             prim_fs_remove first;
             prim_fs_remove second;
             prim_fs_remove directory;
             prim_fs_remove reserved;
             let! remains := prim_fs_exists reserved;
             startup_expect (notb remains);
             exit 42
