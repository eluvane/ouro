import "source_string_decimal_values.ouro",
  "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match u32_from_nat 255 with | Nothing => runtime_pure U32 zero | Just bits =>
        let word : U64 := u32_to_u64 bits in
        runtime_pure(U32, source_answer(zero, decimal_checked "255" word (decimal_u32_to_nat bits))) end);
