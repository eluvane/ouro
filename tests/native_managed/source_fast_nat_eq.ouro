import "source_fast_nat_values.ouro";

def fast_nat_full_equal (maximum : Nat) : Bool :=
    let boundary : Nat := S maximum in
    let after : Nat := S boundary in
    let partial : Nat -> Bool := eqNat boundary in
    andb (partial boundary)
      (andb (notb (partial 0))
        (andb (notb (partial maximum)) (notb (partial after))));

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) => fast_nat_boundaries zero fast_nat_full_equal);
