import "source_values.ouro";

intrinsic nat_u8_to_nat : U8 -> Nat := "ouro.u8.to_nat.bits";
intrinsic nat_u32_to_nat : U32 -> Nat := "ouro.u32.to_nat.bits";
intrinsic nat_u64_to_nat : U64 -> Nat := "ouro.u64.to_nat.bits";
intrinsic nat_usize_to_nat : USize -> Nat := "ouro.usize.to_nat.bits";
intrinsic nat_u64_from_nat : Nat -> Maybe U64 := "ouro.u64.from_nat.checked";
intrinsic nat_u64_equal : U64 -> U64 -> Bool := "ouro.u64.eq";

def nat_identity (value : Nat) : Nat := value;
def nat_successor (value : Nat) : Nat := S value;
def nat_predecessor (value : Nat) : Nat := match value with | Z => Z | S prior => prior end;

def nat_u32_same (expected : U32) (value : Nat) : Bool :=
    match u32_from_nat value with | Nothing => False | Just actual => u32_equal actual expected end;

def nat_u64_same (expected : U64) (value : Nat) : Bool :=
    match nat_u64_from_nat value with | Nothing => False | Just actual => nat_u64_equal actual expected end;

def nat_u8_missing (value : Nat) : Bool := match u8_from_nat value with | Nothing => True | Just _ => False end;
def nat_u32_missing (value : Nat) : Bool := match u32_from_nat value with | Nothing => True | Just _ => False end;
def nat_u64_missing (value : Nat) : Bool := match nat_u64_from_nat value with | Nothing => True | Just _ => False end;
