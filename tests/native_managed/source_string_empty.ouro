import "source_string_values.ouro";

def source_empty_case (empty : String) (value : String) (zero : U32) : U32 :=
    match source_string_equal (source_concat empty value) value with
    | False => zero
    | True => match source_string_equal (source_concat value empty) value with
        | False => zero
        | True => source_expect_string "" (source_concat empty empty) zero end end;

def main : Runtime U32 := runtime_bind U32 U32 source_zero
    (fun (zero : U32) => runtime_pure U32 (source_empty_case "" "x" zero));
