import "source_fs_mutation_values.ouro";

def main : IO Unit :=
    let create : String -> IO Unit := prim_fs_mkdir in
    let remove : String -> IO Unit := prim_fs_remove in
    let bad_create : IO Unit := create (prim_string_of_char_codes [255]) in
    let zero_create : IO Unit := create (prim_string_of_char_codes [65, 0, 66]) in
    let bad_remove : IO Unit := remove (prim_string_of_char_codes [255]) in
    let zero_remove : IO Unit := remove (prim_string_of_char_codes [65, 0, 66]) in
    let directory : IO Unit := create "files/deferred-new" in
    let file : IO Unit := remove "files/deferred-keep" in
    exit 42
