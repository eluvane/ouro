import "source_startup_values.ouro",
  "../../std/natx.ouro",
  "source_values.ouro";

def RealpathFaultText : Type := String;
def RealpathFaultAction (A : Type) : Type := IO A;
intrinsic realpath_fault_chosen : RealpathFaultText -> RealpathFaultAction RealpathFaultText := "ouro.fs.realpath";

def main : IO Unit :=
    let query : String -> IO String := realpath_fault_chosen in
    let saved : IO String := query (prim_string_concat "realpaths/" "file") in
    do let! first := saved;
       let first_churn : String := source_churn 96 "root" in
       do let! second := saved;
          let second_churn : String := source_churn 96 first_churn in
          do let! third := saved;
             startup_expect (andb (prim_string_ends first "/realpaths/file")
               (andb(prim_string_eq first second, prim_string_eq first third)));
             startup_expect (andb (eq_nat(prim_string_length first_churn, 100))
               (eq_nat(prim_string_length second_churn, 196)));
             exit 42
