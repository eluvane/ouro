-- The harness supplies a private Unicode directory and its canonical target.
import "source_startup_values.ouro";
import "source_values.ouro";

def realpath_joint_expect (action : IO String) (expected : String) : IO Unit :=
    do let! actual := action;
       startup_expect (prim_string_eq actual expected)

def realpath_joint_payload : String := prim_string_of_char_codes [65, 0, 255, 128, 10, 13, 90];

def realpath_joint_create (directory : String) (original : String) (target : String)
    (query : IO String) (expected : String) : IO Unit :=
    do realpath_joint_expect query "";
       prim_fs_mkdir directory;
       prim_fs_write_file original realpath_joint_payload;
       prim_fs_copy_file original target;
       realpath_joint_expect query expected;
       let! copied := prim_fs_read_file target;
       startup_expect (prim_string_eq copied realpath_joint_payload)

def realpath_joint_reuse (original : String) (target : String) (query : IO String) (expected : String) : IO Unit :=
    do prim_fs_remove target;
       realpath_joint_expect query "";
       let noise : String := source_churn 96 "root" in
       do startup_expect (prim_string_eq (prim_string_slice noise 0 4) "root");
          prim_fs_write_file original "last";
          prim_fs_copy_file original target;
          realpath_joint_expect query expected;
          let! copied := prim_fs_read_file target;
          startup_expect (prim_string_eq copied "last")

def realpath_joint_run (directory : String) (expected : String) : IO Unit :=
    let original : String := prim_string_concat directory "/source" in
    let target : String := prim_string_concat directory "/target" in
    let query : IO String := prim_fs_realpath target in
    do realpath_joint_create directory original target query expected;
       realpath_joint_reuse original target query expected;
       prim_fs_remove target;
       prim_fs_remove original;
       prim_fs_remove directory;
       realpath_joint_expect query "";
       let! present := prim_fs_exists directory;
       startup_expect (notb present);
       exit 42

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 91 | Cons _ paths =>
       match paths with | Nil => exit 91 | Cons directory expectations =>
       match expectations with | Nil => exit 91 | Cons expected rest =>
       match rest with | Nil => realpath_joint_run directory expected
       | Cons _ _ => exit 91 end end end end
