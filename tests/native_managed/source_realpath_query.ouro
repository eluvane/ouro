-- The harness supplies the complete independent canonical expectation.
import "source_startup_values.ouro";
import "../../std/natx.ouro";
import "source_values.ouro";

def RealpathQueryText : Type := String;
def RealpathQueryAction (A : Type) : Type := IO A;
intrinsic realpath_query_chosen : RealpathQueryText -> RealpathQueryAction RealpathQueryText := "ouro.fs.realpath";

def main : IO Unit :=
    do let! arguments := argv;
       match arguments with | Nil => exit 91 | Cons _ paths =>
       match paths with | Nil => exit 91 | Cons path expectations =>
       match expectations with | Nil => exit 91 | Cons expected rest =>
       match rest with
       | Nil =>
           let query : String -> IO String := realpath_query_chosen in
           let saved : IO String := query (prim_string_concat "" path) in
           do let! first := saved;
              let churned : String := source_churn 96 "root" in
              do let! second := saved;
                 startup_expect (andb (prim_string_eq first expected) (prim_string_eq second expected));
                 startup_expect (eq_nat (prim_string_length churned) 100);
                 exit 42
       | Cons _ _ => exit 91 end end end end
