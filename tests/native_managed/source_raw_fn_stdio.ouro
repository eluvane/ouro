import "source_raw_fn_values.ouro",
  "../../runtime/native_types.ouro",
  "../../runtime/platform/windows_io.ouro",
  "../../std/io.ouro",
  "../../std/string_prims.ouro";

extern rawfn_stdio_resolve : RawPtr Unit -> RawPtr U8 -> Runtime RawFnTestWriter :=
    "windows-x86_64" "win64" "kernel32.dll" "GetProcAddress" "nogc";

-- The loaded DLL owns the code; the temporary name/code-cell buffer is released.
def rawfn_stdio_code : IO RawFnTestWriter :=
    do let! base := rawfn_test_allocate;
       let! module := rawfn_test_module base;
       let! bytes := rawfn_test_size 64;
       rawfn_test_text base bytes "WriteFile";
       let! code := rawfn_stdio_resolve module base;
       let! slot := rawfn_test_slot base;
       let! cell := raw_cast U8 RawFnTestWriter slot;
       rawfn_test_store_writer cell code;
       rawfn_test_slot_present slot;
       let! loaded := rawfn_test_load_writer cell;
       rawfn_test_release base;
       io_pure RawFnTestWriter loaded;

def main : IO Unit :=
    do let! code := rawfn_stdio_code;
       let! base := rawfn_test_allocate;
       let! bytes := rawfn_test_size 64;
       let! offset := rawfn_test_size 8;
       let! address := raw_add U8 base offset;
       let! count := raw_cast U8 U32 address;
       let! zero := rawfn_test_word 0;
       let! four := rawfn_test_word 4;
       let! eleven := rawfn_test_word 11;
       let! stdout_handle := windows_get_std_handle (u32_sub zero eleven);
       let! bits := raw_to_bits U8 stdout_handle;
       let! one := rawfn_test_size 1;
       let empty : USize := usize_sub bits bits in
       do rawfn_test_expect (raw_bool_and
            (raw_bool_not (usize_equal bits empty))
            (raw_bool_not (usize_equal bits (usize_sub empty one))));
          rawfn_test_text base bytes (prim_string_of_char_codes ([65,0,90,10] : List Nat));
          raw_store_u32 count zero;
          let partial : U32 -> RawPtr U32 -> RawPtr U8 -> IO U32 :=
              rawfn_test_call_writer code stdout_handle base in
          let saved : IO U32 := partial four count (raw_null U8) in
          do let! before := raw_load_u32 count;
             rawfn_test_expect (u32_equal before zero);
             print "B\n";
             let! status := saved;
             rawfn_test_expect (raw_bool_not (u32_equal status zero));
             let! written := raw_load_u32 count;
             rawfn_test_expect (u32_equal written four);
             rawfn_test_text base bytes (prim_string_of_char_codes ([67,0,90,10] : List Nat));
             raw_store_u32 count zero;
             let! again := saved;
             rawfn_test_expect (raw_bool_not (u32_equal again zero));
             let! rewritten := raw_load_u32 count;
             rawfn_test_expect (u32_equal rewritten four);
             rawfn_test_release base;
             print "D\n";
             flush;
             exit 42;
