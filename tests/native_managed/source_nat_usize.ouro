import "source_nat_values.ouro";
import "source_values.ouro";

def nat_usize_same (expected : USize) (value : Nat) : Bool :=
    match usize_from_nat value with | Nothing => False | Just actual => usize_equal actual expected end;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      match usize_from_nat 1 with | Nothing => runtime_pure U32 zero | Just one =>
        let size_zero : USize := raw_u32_to_size zero in
        let maximum : USize := usize_sub size_zero one in
        let original : Nat := nat_usize_to_nat maximum in
        runtime_pure U32 (source_answer zero (raw_bool_and (nat_usize_same maximum original)
          (raw_bool_and (nat_usize_same size_zero (nat_usize_to_nat size_zero))
            (raw_bool_and (match usize_from_nat (nat_successor original) with | Nothing => True | Just _ => False end)
              (match nat_usize_to_nat size_zero with | Z => True | S _ => False end))))) end);
