import "source_startup_values.ouro",
  "../../std/fs.ouro";

def mutation_checked_result (result : Either FsError Unit) : IO Unit :=
    match result with | Right _ => io_unit | Left _ => exit 91 end;

def mutation_paths (operation : String -> IO Unit) : List String -> IO Unit :=
    fix paths (remaining : List String) : IO Unit :=
      match remaining with | Nil => io_unit | Cons path rest =>
        do operation path; operation path; paths rest end;
