-- Split and tokens receive dynamic function parameters. The comparator
-- checks every field and the exact list length, including empty strings.
import "source_string_values.ouro";


intrinsic source_string_split : String -> Nat -> List String := "ouro.string.split";
intrinsic source_string_tokens : String -> List String := "ouro.string.tokens";

def source_string_parts_same : List String -> List String -> Bool :=
  fix same (expected : List String) (actual : List String) : Bool :=
    match expected with
    | Nil => match actual with | Nil => True | Cons _ _ => False end
    | Cons wanted more => match actual with | Nil => False | Cons found rest =>
        match source_string_equal wanted found with
        | False => False | True => same more rest end end end;

def source_string_parts_answer (expected : List String) (actual : List String) (zero : U32) : U32 :=
    match source_string_parts_same expected actual with
    | False => zero | True => source_forty_two zero end;

def source_string_split_case (value : String) (separator : Nat) (expected : List String) (zero : U32) : U32 :=
    source_string_parts_answer expected (source_string_split value separator) zero;

def source_string_tokens_case (value : String) (expected : List String) (zero : U32) : U32 :=
    source_string_parts_answer expected (source_string_tokens value) zero;

def source_string_split_unbroken (value : String) (separator : Nat) (zero : U32) : U32 :=
    source_string_split_case value separator ([value] : List String) zero;

def source_string_tokens_unbroken (value : String) (zero : U32) : U32 :=
    source_string_tokens_case value ([value] : List String) zero;
