import "source_values.ouro";
import "../../std/string.ouro";

def shared_answer (zero : U32) : U32 :=
    match u32_from_nat 42 with | Nothing => zero | Just answer =>
      match prim_string_eq (prim_string_concat "hello" "-world") "hello-world" with
      | False => zero | True =>
        match prim_string_eq (str_join "," (["a", "b", "c"] : List String)) "a,b,c" with
        | False => zero | True => answer end end end;

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) => runtime_pure U32 (shared_answer zero));
