import "source_startup_values.ouro",
  "source_values.ouro";

def StartupText : Type := String;
def StartupAction (A : Type) : Type := IO A;
intrinsic selected : StartupAction (List StartupText) := "ouro.runtime.argv";

def main : IO Unit :=
    let saved : IO (List String) := selected in
    do let! first := saved;
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       let! second := saved;
       startup_expect (startup_arguments_equal first second);
       exit 42
