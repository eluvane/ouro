import "source_stdio_values.ouro";

intrinsic selected_write : String -> IO Unit := "ouro.runtime.stdout.write";
intrinsic selected_exit : Nat -> IO Unit := "ouro.runtime.exit";

def main : IO Unit :=
    let ignored : IO Unit := print "ignored" in
    let ignored_exit : IO Unit := selected_exit 77 in
    let output : String -> IO Unit := selected_write in
    let saved : IO Unit := output "X" in
    do output "A";
       saved;
       flush;
       saved;
       eprint "E";
       output "Z";
       selected_exit 42;
       output "after-exit"
