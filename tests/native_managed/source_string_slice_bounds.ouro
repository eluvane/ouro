import "source_string_access_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      runtime_pure U32 (access_answer zero (raw_bool_and (access_part "" "abc" 3 1) (raw_bool_and (access_part "" "abc" (access_huge zero) 1) (raw_bool_and (access_part "abc" "abc" 0 (access_huge zero)) (access_part "c" "abc" 2 (access_huge zero)))))));
