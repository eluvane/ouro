import "source_file_values.ouro";

def main : IO Unit :=
    let ignored_read : IO String := prim_fs_read_file "files/missing-deferred.bin" in
    let ignored_write : IO Unit := prim_fs_write_file "files/untouched.bin" "changed" in
    let ignored_bad : IO String := prim_fs_read_file "" in
    exit 42;
