-- Pass a bare unary intrinsic alias through a normalized String type alias.
import "source_string_values.ouro";

intrinsic witness_length_primitive : String -> Nat := "ouro.string.length";
def WitnessString : Type := String;
def witness_length : WitnessString -> Nat := witness_length_primitive;

def witness_length_case (measure : WitnessString -> Nat) (text : WitnessString) (zero : U32) : U32 :=
    match u32_from_nat (measure text), u32_from_nat 5 with
    | Just actual, Just expected => match u32_equal actual expected with
      | True => source_forty_two zero | False => zero end
    | Nothing, Nothing => zero | Nothing, Just _ => zero | Just _, Nothing => zero end;

def main : Runtime U32 := runtime_bind U32 U32 source_zero
    (fun (zero : U32) => runtime_pure U32 (witness_length_case witness_length "ab-cd" zero));
