-- Fixtures only access directories and files created by their owned harness.
import "source_file_values.ouro",
  "../../std/fs.ouro";

def directory_expect (condition : Bool) : IO Unit :=
    match condition with | True => io_unit | False => exit 91 end;

def directory_members (actual : List String) (expected : List String) : Bool :=
    andb (eq_nat(length String actual, length String expected))
      (all String (fun (name : String) => any String (fun (candidate : String) => prim_string_eq name candidate) actual) expected);
