-- Reusing one zero-argument Runtime action must invoke TlsAlloc twice. The
-- indexes stay opaque; two live allocations must differ and both are freed.
import "source_foreign_values.ouro";

extern source_tls_allocate : Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsAlloc" "nogc";
extern source_tls_release : U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsFree" "nogc";

def source_tls_cleanup (first : U32) (second : U32) (zero : U32) : Runtime U32 :=
    match u32_equal first second with
    | True => runtime_bind U32 U32 (source_tls_release first) (fun (_ : U32) => runtime_pure U32 zero)
    | False => runtime_bind U32 U32 (source_tls_release first) (fun (released_first : U32) =>
        runtime_bind U32 U32 (source_tls_release second) (fun (released_second : U32) =>
          runtime_pure U32 (match u32_equal released_first zero with
            | True => zero | False => match u32_equal released_second zero with
              | True => zero | False => source_forty_two zero end end))) end;

def source_tls_twice (zero : U32) : Runtime U32 :=
    let failure : U32 := u32_sub zero (source_one zero) in
    let action : Runtime U32 := source_tls_allocate in
    runtime_bind U32 U32 action (fun (first : U32) => match u32_equal first failure with
      | True => runtime_pure U32 zero
      | False => runtime_bind U32 U32 action (fun (second : U32) => match u32_equal second failure with
          | True => runtime_bind U32 U32 (source_tls_release first) (fun (_ : U32) => runtime_pure U32 zero)
          | False => source_tls_cleanup first second zero end) end);

def main : Runtime U32 := runtime_bind U32 U32 source_zero source_tls_twice;
