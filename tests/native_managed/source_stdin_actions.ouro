-- Reusing stored actions consumes the next input only on each invocation.
import "source_stdio_values.ouro";

def stdin_read_function : Nat -> IO String := prim_stdin_read_bytes;
def stdin_pair_action : IO String := stdin_read_function 2;
def stdin_line_action : IO String := readLine;

def main : IO Unit :=
    let unused : IO String := stdin_read_function (mul 128 128) in
    do print "ready|";
       let! first := stdin_pair_action;
       print first;
       let! second := stdin_pair_action;
       print second;
       print "|";
       let! line := stdin_line_action;
       print line;
       print "|";
       let! next := stdin_line_action;
       print next
