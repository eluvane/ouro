import "source_string_decimal_values.ouro";
import "source_values.ouro";

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let word : U64 := u32_to_u64 zero in
      runtime_pure U32 (source_answer zero (decimal_checked "0" word (decimal_u64_to_nat word))));
