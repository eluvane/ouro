import "source_values.ouro";

def source_one (fallback : U32) : U32 :=
    match u32_from_nat 1 with | Nothing => fallback | Just value => value end;

def source_cell_bytes (fallback : USize) : USize :=
    match usize_from_nat 4 with | Nothing => fallback | Just value => value end;

def source_increment (cell : RawPtr U32) (one : U32) : Runtime U32 :=
    runtime_bind U32 U32 (raw_load_u32 cell) (fun (old : U32) =>
      let next : U32 := source_add old one in
      runtime_bind(Unit, U32, raw_store_u32 cell next, fun (stored : Unit) => runtime_pure U32 next));

def source_reuse (cell : RawPtr U32) (zero : U32) : Runtime U32 :=
    let one : U32 := source_one zero in
    let action : Runtime U32 := source_increment cell one in
    runtime_bind U32 U32 action (fun (first : U32) =>
      runtime_bind U32 U32 action (fun (second : U32) =>
        runtime_bind U32 U32 (raw_load_u32 cell) (fun (final : U32) =>
          runtime_pure U32 (match u32_equal first one with | False => zero | True =>
            match u32_equal(second, source_add one one) with | False => zero | True =>
              match u32_equal final second with | False => zero | True => source_forty_two zero end end end))));

def main : Runtime U32 :=
    runtime_bind U32 U32 source_zero (fun (zero : U32) =>
      let bytes : USize := source_cell_bytes (raw_u32_to_size zero) in
      runtime_bind (RawPtr U8) U32 (raw_pages_allocate bytes bytes) (fun (owner : RawPtr U8) =>
        runtime_bind USize U32 (raw_to_bits U8 owner) (fun (address : USize) =>
          match usize_equal(address, usize_sub address address) with | True => runtime_pure U32 zero
          | False => runtime_bind (RawPtr U32) U32 (raw_cast U8 U32 owner) (fun (cell : RawPtr U32) =>
              runtime_bind Unit U32 (raw_store_u32 cell zero) (fun (initialized : Unit) =>
                runtime_bind U32 U32 (source_reuse cell zero) (fun (answer : U32) =>
                  runtime_bind Bool U32 (raw_pages_release owner) (fun (released : Bool) =>
                    runtime_pure(U32, match released with | True => answer | False => zero end))))) end)));
