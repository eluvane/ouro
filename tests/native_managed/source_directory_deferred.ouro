import "source_directory_values.ouro";

def main : IO Unit :=
    let unused_list : IO (List String) := fs_list "" in
    let unused_probe : IO Bool := prim_fs_listable (prim_string_of_char_codes [255]) in
    let absent : IO (List String) := fs_list "directories/absent" in
    do let! names := fs_list "directories/deferred";
       directory_expect (directory_members names ["untouched.txt"]);
       exit 42
