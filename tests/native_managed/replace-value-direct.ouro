-- Two captured arguments and closure reuse; keep assertions within the MIR budget.
import "source_string_values.ouro";

intrinsic witness_replace_primitive : String -> String -> String -> String := "ouro.string.replace";
def witness_replace : String -> String -> String -> String := witness_replace_primitive;

def witness_replace_case (text : String) (zero : U32) : U32 :=
    let replace : String -> String := witness_replace text "-" in
    match source_string_equal "ab/cd" (replace "/") with
    | False => zero
    | True => match source_string_equal "ab=cd" (replace "=") with
      | False => zero | True => source_forty_two zero end end;

def main : Runtime U32 := runtime_bind U32 U32 source_zero
    (fun (zero : U32) => runtime_pure U32 (witness_replace_case "ab-cd" zero));
