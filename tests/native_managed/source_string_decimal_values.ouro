import "source_string_values.ouro";

intrinsic decimal_primitive_of_nat : Nat -> String := "ouro.string.of_nat";
intrinsic decimal_u32_to_nat : U32 -> Nat := "ouro.u32.to_nat.bits";
intrinsic decimal_u64_to_nat : U64 -> Nat := "ouro.u64.to_nat.bits";
intrinsic decimal_u64_from_nat : Nat -> Maybe U64 := "ouro.u64.from_nat.checked";
intrinsic decimal_u64_equal : U64 -> U64 -> Bool := "ouro.u64.eq";
intrinsic decimal_u64_add : U64 -> U64 -> U64 := "ouro.u64.add.wrap";

-- The intrinsic sees an actual Nat parameter, preventing closed normalization.
def decimal_format (value : Nat) : String := decimal_primitive_of_nat value;
def decimal_successor (value : Nat) : Nat := S value;
def decimal_predecessor (value : Nat) : Nat := match value with | Z => Z | S previous => previous end;

def decimal_add_steps : Nat -> Nat -> Nat :=
  fix advance (count : Nat) (value : Nat) : Nat :=
    match count with | Z => value | S remaining => advance remaining (decimal_successor value) end;

def decimal_drop_steps : Nat -> Nat -> Nat :=
  fix retreat (count : Nat) (value : Nat) : Nat :=
    match count with | Z => value | S remaining => retreat remaining (decimal_predecessor value) end;

def decimal_word_same (expected : U64) (value : Nat) : Bool :=
    match decimal_u64_from_nat value with | Nothing => False | Just actual => decimal_u64_equal actual expected end;

def decimal_checked (expected : String) (word : U64) (value : Nat) : Bool :=
    let rendered : String := decimal_format value in
    raw_bool_and (source_string_equal expected rendered) (decimal_word_same word value);

-- After conversion, independently recover the original upper word boundary.
def decimal_checked_above (expected : String) (steps : Nat) (word : U64) (value : Nat) : Bool :=
    let rendered : String := decimal_format value in
    raw_bool_and (source_string_equal expected rendered) (decimal_word_same word (decimal_drop_steps steps value));

def decimal_reused (expected : String) (value : Nat) : Bool :=
    raw_bool_and (source_string_equal expected (decimal_format value))
      (source_string_equal expected (decimal_format value));

