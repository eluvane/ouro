import "source_raw_fn_values.ouro",
  "../../runtime/native_types.ouro",
  "../../std/io.ouro";

extern rawfn_deferred_resolve : RawPtr Unit -> RawPtr U8 -> Runtime RawFnTestSetter :=
    "windows-x86_64" "win64" "kernel32.dll" "GetProcAddress" "nogc";
extern rawfn_deferred_allocate : Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsAlloc" "nogc";
extern rawfn_deferred_set : U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsSetValue" "nogc";
extern rawfn_deferred_get : U32 -> Runtime (RawPtr U8) :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsGetValue" "nogc";
extern rawfn_deferred_release : U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "TlsFree" "nogc";

-- Kernel32 remains loaded; code survives releasing the name/code-cell buffer.
private def rawfn_deferred_code : IO RawFnTestSetter :=
    do let! base := rawfn_test_allocate;
       let! module := rawfn_test_module base;
       let! bytes := rawfn_test_size 64;
       rawfn_test_text base bytes "TlsSetValue";
       let! code := rawfn_deferred_resolve module base;
       let! slot := rawfn_test_slot base;
       let! cell := raw_cast U8 RawFnTestSetter slot;
       rawfn_test_store_setter cell code;
       rawfn_test_slot_present slot;
       let! loaded := rawfn_test_load_setter cell;
       rawfn_test_release base;
       io_pure RawFnTestSetter loaded;

def rawfn_deferred_clear (slot : U32) (zero : U32) : IO Unit :=
    do let! cleared := rawfn_deferred_set slot (raw_null U8);
       rawfn_test_expect (raw_bool_not (u32_equal cleared zero));

def main : IO Unit :=
    do let! setter := rawfn_deferred_code;
       let! first := rawfn_test_allocate;
       let! second := rawfn_test_allocate;
       let! first_bits := raw_to_bits U8 first;
       let! second_bits := raw_to_bits U8 second;
       rawfn_test_expect (raw_bool_not (usize_equal first_bits second_bits));
       let! zero := rawfn_test_word 0;
       let! one := rawfn_test_word 1;
       let! slot := rawfn_deferred_allocate;
       rawfn_test_expect (raw_bool_not (u32_equal slot (u32_sub zero one)));
       rawfn_deferred_clear slot zero;
       let partial : RawPtr U8 -> IO U32 := rawfn_test_partial setter slot in
       let ignored : IO U32 := partial second in
       let saved : IO U32 := partial first in
       let getter_action : IO (RawPtr U8) := rawfn_deferred_get slot in
       do let! before := getter_action;
          let! before_bits := raw_to_bits U8 before;
          rawfn_test_expect (usize_equal before_bits (usize_sub before_bits before_bits));
          let! status := saved;
          rawfn_test_expect (raw_bool_not (u32_equal status zero));
          let! observed := getter_action;
          let! observed_bits := raw_to_bits U8 observed;
          rawfn_test_expect (usize_equal observed_bits first_bits);
          rawfn_deferred_clear slot zero;
          let! again := saved;
          rawfn_test_expect (raw_bool_not (u32_equal again zero));
          let! repeated := getter_action;
          let! repeated_bits := raw_to_bits U8 repeated;
          rawfn_test_expect (usize_equal repeated_bits first_bits);
          rawfn_deferred_clear slot zero;
          let later : IO U32 := partial second in
          do let! still_deferred := getter_action;
             let! deferred_bits := raw_to_bits U8 still_deferred;
             rawfn_test_expect (usize_equal deferred_bits (usize_sub deferred_bits deferred_bits));
             let! changed := later;
             rawfn_test_expect (raw_bool_not (u32_equal changed zero));
             let! last := getter_action;
             let! last_bits := raw_to_bits U8 last;
             rawfn_test_expect (usize_equal last_bits second_bits);
             let! released := rawfn_deferred_release slot;
             rawfn_test_expect (raw_bool_not (u32_equal released zero));
             rawfn_test_release first;
             rawfn_test_release second;
             exit 42;
