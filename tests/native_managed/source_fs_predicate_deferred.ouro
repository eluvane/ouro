import "source_fs_predicate_values.ouro";

def main : IO Unit :=
    let exists : String -> IO Bool := prim_fs_exists in
    let directory : String -> IO Bool := prim_fs_is_dir in
    let invalid_exists : IO Bool := exists (prim_string_of_char_codes [255]) in
    let invalid_directory : IO Bool := directory (prim_string_of_char_codes [255]) in
    let nul_exists : IO Bool := exists (prim_string_of_char_codes [65, 0, 66]) in
    let nul_directory : IO Bool := directory (prim_string_of_char_codes [65, 0, 66]) in
    exit 42;
