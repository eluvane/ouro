import "source_startup_values.ouro";

def main : IO Unit :=
    do let! unicode := env_get "OURO_STARTUP_TEST_ПУТЬ";
       startup_print_optional unicode;
       let! empty := env_get "OURO_STARTUP_TEST_EMPTY";
       startup_print_optional empty;
       let! missing := env_get "OURO_STARTUP_TEST_MISSING";
       startup_print_optional missing;
       let! unnamed := env_get "";
       startup_print_optional unnamed;
       exit 42
