import "source_directory_values.ouro",
  "source_values.ouro";

def main : IO Unit :=
    let path : String := prim_string_concat "directories/" "fault" in
    let probe : IO Bool := prim_fs_listable path in
    do let! first := probe;
       let churned : String := source_churn 64 "root" in
       do let! second := probe;
          directory_expect (andb first second);
          directory_expect (eq_nat(prim_string_length churned, 68));
          exit 42
