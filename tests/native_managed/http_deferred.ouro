-- Harness observes no POST; constructing either action must perform no OS work.
import "http_values.ouro";

def main : IO Unit :=
    http_fixture_run (fun (url : String) =>
      let saved : IO (Pair Nat (Pair String String)) := prim_http_request url [] file_binary in
      let public : IO HttpResp := http_post url [] file_binary in
      exit 42);
