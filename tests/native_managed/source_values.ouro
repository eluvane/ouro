-- Shared checked source support. Zero is obtained through the explicit raw
-- Runtime boundary; machine constants use their checked from-Nat adapters.
import "../../runtime/managed.ouro";

intrinsic source_add : U32 -> U32 -> U32 := "ouro.u32.add.wrap";

def source_zero : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits(U8, raw_null U8)) (fun (zero : USize) =>
      runtime_pure(U32, raw_size_to_u32 zero));

def source_twenty (fallback : U32) : U32 :=
    match u32_from_nat 20 with | Nothing => fallback | Just value => value end;

def source_twenty_one (fallback : U32) : U32 :=
    match u32_from_nat 21 with | Nothing => fallback | Just value => value end;

def source_twenty_two (fallback : U32) : U32 :=
    match u32_from_nat 22 with | Nothing => fallback | Just value => value end;

def source_forty_two (fallback : U32) : U32 :=
    match u32_from_nat 42 with | Nothing => fallback | Just value => value end;

def source_answer (zero : U32) (valid : Bool) : U32 :=
    match valid with | True => source_forty_two zero | False => zero end;

def source_adder (first : U32) : U32 -> U32 :=
    fun (second : U32) => source_add first second;
