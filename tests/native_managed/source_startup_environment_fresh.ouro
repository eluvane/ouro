import "source_startup_values.ouro";

extern startup_set_environment : RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "SetEnvironmentVariableW" "nogc";

def startup_write_raw (base : RawPtr U8) (offset : USize) (bytes : List Nat) : IO Unit :=
    (fix write (remaining : List Nat) (at : USize) : IO Unit :=
      match remaining with | Nil => io_unit | Cons value rest =>
        match u8_from_nat value, usize_from_nat 1 with
        | Just byte, Just one =>
          runtime_bind (RawPtr U8) Unit (raw_add U8 base at) (fun (address : RawPtr U8) =>
            runtime_bind Unit Unit (raw_store_u8 address byte)
              (fun (_ : Unit) => write(rest, usize_add at one)))
        | Nothing, Nothing => exit 93 | Nothing, Just _ => exit 93 | Just _, Nothing => exit 93 end end) bytes offset;

def startup_change (again : Bool) : IO Unit :=
    match usize_from_nat 64, usize_from_nat 8, usize_from_nat 48 with
    | Just capacity, Just alignment, Just value_at =>
      runtime_bind (RawPtr U8) Unit (raw_pages_allocate capacity alignment) (fun (storage : RawPtr U8) =>
        runtime_bind USize Unit (raw_to_bits U8 storage) (fun (address : USize) =>
          match usize_equal(address, usize_sub address address) with | True => exit 93 | False =>
            do startup_write_raw storage (usize_sub address address) [79, 0, 85, 0, 82, 0, 79, 0, 95, 0, 83, 0, 84, 0, 65, 0, 82, 0, 84, 0, 85, 0, 80, 0, 95, 0, 84, 0, 69, 0, 83, 0, 84, 0, 95, 0, 83, 0, 84, 0, 65, 0, 84, 0, 69, 0, 0, 0];
               startup_write_raw storage value_at (match again with | False => [97, 0, 102, 0, 116, 0, 101, 0, 114, 0, 0, 0] | True => [97, 0, 103, 0, 97, 0, 105, 0, 110, 0, 0, 0] end);
               runtime_bind (RawPtr U8) Unit (raw_add U8 storage value_at) (fun (value : RawPtr U8) =>
                 runtime_bind U32 Unit (startup_set_environment storage value) (fun (changed : U32) =>
                   runtime_bind Bool Unit (raw_pages_release storage) (fun (released : Bool) =>
                     startup_expect (andb(released, notb (u32_equal(changed, u32_sub changed changed))))))) end))
    | Nothing, Nothing, Nothing => exit 93 | Nothing, Nothing, Just _ => exit 93
    | Nothing, Just _, Nothing => exit 93 | Nothing, Just _, Just _ => exit 93
    | Just _, Nothing, Nothing => exit 93 | Just _, Nothing, Just _ => exit 93
    | Just _, Just _, Nothing => exit 93 end;

def main : IO Unit :=
    let saved : IO (Maybe String) := env_get "OURO_STARTUP_TEST_STATE" in
    do startup_change False;
       let! first := saved;
       startup_print_optional first;
       startup_change True;
       let! second := saved;
       startup_print_optional second;
       exit 42
