import "source_file_copy_values.ouro";
import "source_values.ouro";

def CopyText : Type := String;
def CopyAction (A : Type) : Type := IO A;
intrinsic chosen_copy : CopyText -> CopyText -> CopyAction Unit := "ouro.fs.copy_file";

def main : IO Unit :=
    let copy : String -> String -> IO Unit := chosen_copy in
    let source : String := prim_string_concat "files/reused-" "source" in
    let target : String := prim_string_concat "files/reused-" "target" in
    let partial : String -> IO Unit := copy source in
    let saved : IO Unit := partial target in
    let binary : String := prim_string_of_char_codes [65, 0, 255] in
    do prim_fs_write_file source binary;
       saved;
       copy_expect_file target binary;
       let noise : String := source_churn 32 "" in
       startup_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       prim_fs_write_file source "";
       saved;
       copy_expect_file target "";
       prim_fs_write_file source "last";
       saved;
       copy_expect_file target "last";
       exit 42
