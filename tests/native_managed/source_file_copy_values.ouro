import "source_startup_values.ouro";

def copy_paths : List String -> IO Unit :=
    fix paths (remaining : List String) : IO Unit :=
      match remaining with | Nil => io_unit | Cons source rest =>
        match rest with | Nil => exit 91 | Cons target tail =>
          do prim_fs_copy_file source target;
             prim_fs_copy_file source target;
             paths tail end end;
