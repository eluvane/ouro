import "source_stdio_values.ouro";

extern stdio_set_handle : U32 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "SetStdHandle" "nogc";

def main : IO Unit :=
    match usize_from_nat 1 with | Nothing => exit 99 | Just one =>
      runtime_bind (RawPtr U8) Unit (raw_from_bits U8 one) (fun (invalid : RawPtr U8) =>
        match u32_from_nat 12 with | Nothing => exit 99 | Just selector =>
          runtime_bind U32 Unit (stdio_set_handle(u32_sub(u32_sub selector selector, selector), invalid))
            (fun (changed : U32) => match u32_equal(changed, u32_sub changed changed) with
              | True => exit 99 | False => eprint "unavailable" end) end) end;
