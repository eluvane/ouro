import "source_file_values.ouro",
  "source_values.ouro";

def main : IO Unit :=
    let saved : IO Unit := prim_fs_write_file "files/write-reused.bin" file_binary in
    do saved;
       prim_fs_write_file "files/write-reused.bin" "intermediate";
       let noise : String := source_churn 32 "" in
       file_expect (prim_string_eq noise "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
       saved;
       let! value := prim_fs_read_file "files/write-reused.bin";
       file_expect (prim_string_eq value file_binary);
       exit 42
