import "source_file_values.ouro";

def main : IO Unit :=
    let bytes : String := file_double 14 file_binary in
    do prim_fs_write_file "files/large.bin" bytes;
       let! value := prim_fs_read_file "files/large.bin";
       file_expect (prim_string_eq value bytes);
       file_expect (prim_string_eq(prim_string_of_nat (prim_string_length value), "114688"));
       exit 42
