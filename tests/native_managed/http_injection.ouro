-- Harness supplies a valid loopback echo URL and asserts zero POST requests.
import "http_values.ouro";

def main : IO Unit :=
    http_fixture_run (fun (url : String) =>
      do let! name := prim_http_request url [MkPair String String "X-Test\r\nInjected" "x"] "body";
         http_fixture_expect_failure name;
         let! value := prim_http_request url [MkPair String String "X-Test" "x\r\nInjected: yes"] "body";
         http_fixture_expect_failure value;
         let! empty := prim_http_request url [MkPair String String "" "x"] "body";
         http_fixture_expect_failure empty;
         let! bad_url := prim_http_request (prim_string_concat url "\r\nInjected: yes") [] "body";
         http_fixture_expect_failure bad_url;
         exit 42);
