import "../../runtime/platform/windows_startup.ouro",
  "../../runtime/platform/windows_file.ouro",
  "process_test_common.ouro";

extern process_child_handle_info : RawPtr U8 -> RawPtr U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetHandleInformation" "nogc";
def process_child_sleep (milliseconds : U32) : Runtime Unit :=
    windows_capture_sleep milliseconds;
extern process_child_file_information : RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFileInformationByHandle" "nogc";

def raw_process_eight (value : USize) : USize :=
    let twice : USize := usize_add value value in let four : USize := usize_add twice twice in usize_add four four;
def raw_process_one (anchor : USize) : USize :=
    let one : USize := managed_one anchor in one;
def process_child_write (stream : RawPtr U8) (buffer : RawPtr U8) (bytes : USize) (count : RawPtr U32) (one : USize) : Runtime Unit :=
    runtime_bind U32 Unit (raw_windows_file_write stream buffer bytes count) (fun (status : U32) =>
      runtime_bind Unit Unit (process_test_status status) (fun (written : Unit) =>
        runtime_bind U32 Unit (raw_load_u32 count) (fun (actual : U32) =>
          process_test_require(u32_equal(actual, raw_size_to_u32 bytes), raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add one one, usize_add(one, usize_add one one)))), usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one))))))));
def process_child_number (stream : RawPtr U8) (number : U32) (header : RawPtr U32) (count : RawPtr U32) (one : USize) : Runtime Unit :=
    runtime_bind Unit Unit (raw_store_u32 header number) (fun (stored : Unit) =>
      runtime_bind (RawPtr U8) Unit (raw_cast U32 U8 header) (fun (bytes : RawPtr U8) =>
        process_child_write stream bytes (usize_add(usize_add one one, usize_add one one)) count one));
def process_child_frame (stream : RawPtr U8) (text : RawPtr U8) (units : U32)
    (header : RawPtr U32) (count : RawPtr U32) (one : USize) : Runtime Unit :=
    runtime_bind Unit Unit (process_child_number stream units header count one) (fun (length_written : Unit) =>
      match u32_equal(units, raw_size_to_u32 (usize_sub one one)) with | True => runtime_pure Unit MkUnit | False =>
        let size : USize := raw_u32_to_size units in
        process_child_write stream text (usize_add size size) count one end);

def process_child_argument (table : RawPtr U8) (argc : U32) (index : USize) (stream : RawPtr U8)
    (entry : RawPtr USize) (length : RawPtr U32) (header : RawPtr U32) (count : RawPtr U32) (one : USize) : Runtime USize :=
    runtime_bind U32 USize (raw_windows_argv_at table argc index entry) (fun (at : U32) =>
      runtime_bind Unit USize (process_test_status at) (fun (found : Unit) =>
        runtime_bind USize USize (raw_load_usize entry) (fun (bits : USize) =>
          runtime_bind (RawPtr U8) USize (raw_from_bits U8 bits) (fun (text : RawPtr U8) =>
            runtime_bind U32 USize (raw_windows_wide_length text (usize_add(raw_process_eight (usize_add(raw_process_eight (usize_add(raw_process_eight (usize_add(raw_process_eight (usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))) length) (fun (measured : U32) =>
              runtime_bind Unit USize (process_test_status measured) (fun (length_ok : Unit) =>
                runtime_bind U32 USize (raw_load_u32 length) (fun (units : U32) =>
                  runtime_bind Unit USize (process_child_frame stream text units header count one)
                    (fun (written : Unit) => runtime_pure(USize, usize_add index one)))))))));

def process_child_environment (name : RawPtr U8) (name_units : USize) (buffer : RawPtr U8) (stream : RawPtr U8)
    (length : RawPtr U32) (header : RawPtr U32) (count : RawPtr U32) (one : USize) : Runtime Unit :=
    runtime_bind U32 Unit (raw_windows_environment_get name name_units buffer (usize_add(raw_process_eight (usize_add(raw_process_eight (usize_add(raw_process_eight (usize_add(raw_process_eight (usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))) length) (fun (status : U32) =>
      runtime_bind Unit Unit (process_child_number stream status header count one) (fun (status_written : Unit) =>
        runtime_bind U32 Unit (match u32_equal(status, raw_size_to_u32 (usize_sub one one)) with
          | True => raw_load_u32 length | False => runtime_pure(U32, raw_size_to_u32 (usize_sub one one)) end) (fun (units : U32) =>
            process_child_frame stream buffer units header count one)));

def process_child_information_field (information : RawPtr U8) (offset : USize) : Runtime U32 :=
    let result : Runtime U32 := raw_load_word_at information offset in result;

-- BY_HANDLE_FILE_INFORMATION: volume serial at 28, file index high/low at
-- 44/48. Both parent and child query live file objects, so identity is stable.
def process_child_same_file (left : RawPtr U8) (right : RawPtr U8) (one : USize) : Runtime Bool :=
    let process_number_28 : USize := (usize_add(raw_process_eight (usize_add(one, usize_add one one)), usize_add(usize_add one one, usize_add one one))) in
    let process_number_44 : USize := (usize_add(raw_process_eight (usize_add(usize_add one one, usize_add(one, usize_add one one))), usize_add(usize_add one one, usize_add one one))) in
    let process_number_48 : USize := (raw_process_eight (usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one)))) in

    runtime_bind U32 Bool (process_child_information_field left process_number_28) (fun (lv : U32) =>
      runtime_bind U32 Bool (process_child_information_field right process_number_28) (fun (rv : U32) =>
        runtime_bind U32 Bool (process_child_information_field left process_number_44) (fun (lh : U32) =>
          runtime_bind U32 Bool (process_child_information_field right process_number_44) (fun (rh : U32) =>
            runtime_bind U32 Bool (process_child_information_field left process_number_48) (fun (ll : U32) =>
              runtime_bind U32 Bool (process_child_information_field right process_number_48) (fun (rl : U32) =>
                runtime_pure(Bool, raw_bool_and(u32_equal lv rv, raw_bool_and(u32_equal lh rh, u32_equal ll rl)))))))));

-- Result 0 means no such numeric handle, 1 means another object type, 2 means
-- another file. Inheritance of the unique sentinel file is a hard failure 113.
def process_child_inheritance (input : RawPtr U8) (sentinel : RawPtr U8) (flags : RawPtr U32)
    (expected : RawPtr U8) (observed : RawPtr U8) (count : RawPtr U32) (one : USize) : Runtime U32 :=
    let process_number_52 : USize := (usize_add(raw_process_eight (usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one))), usize_add(usize_add one one, usize_add one one))) in

    runtime_bind U32 U32 (raw_windows_file_read input expected process_number_52 count) (fun (read : U32) =>
      runtime_bind Unit U32 (process_test_status read) (fun (read_ok : Unit) =>
        runtime_bind U32 U32 (raw_load_u32 count) (fun (bytes : U32) =>
          runtime_bind Unit U32 (process_test_require(u32_equal(bytes, raw_size_to_u32 process_number_52), raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(usize_add one one, usize_add one one)))), one)))) (fun (complete : Unit) =>
            runtime_bind U32 U32 (process_child_handle_info sentinel flags) (fun (valid : U32) =>
              match u32_equal(valid, raw_size_to_u32 (usize_sub one one)) with
              | True => runtime_bind U32 U32 windows_get_last_error (fun (error : U32) =>
                  runtime_bind Unit U32 (process_test_require(u32_equal(error, raw_size_to_u32 (usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one)))), raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one)))), usize_add one one))))
                    (fun (invalid : Unit) => runtime_pure(U32, raw_size_to_u32 (usize_sub one one))))
              | False => runtime_bind U32 U32 (process_child_file_information sentinel observed) (fun (queried : U32) =>
                  match u32_equal(queried, raw_size_to_u32 (usize_sub one one)) with
                  | True => runtime_pure(U32, raw_size_to_u32 one)
                  | False => runtime_bind Bool U32 (process_child_same_file expected observed one) (fun (same : Bool) =>
                      runtime_bind Unit U32 (process_test_require(raw_bool_not same, raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add(one, usize_add one one), usize_add(one, usize_add one one)))), one))))
                        (fun (excluded : Unit) => runtime_pure(U32, raw_size_to_u32 (usize_add one one)))) end) end)))));
