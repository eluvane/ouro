import "../../runtime/platform/windows_process_capture.ouro",
  "process_test_common.ouro";

extern process_test_handle_count : RawPtr U8 -> RawPtr U32 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetProcessHandleCount" "nogc";
extern process_test_file_information : RawPtr U8 -> RawPtr U8 -> Runtime U32 :=
    "windows-x86_64" "win64" "kernel32.dll" "GetFileInformationByHandle" "nogc";
def process_test_settle (milliseconds : U32) : Runtime Unit :=
    windows_capture_sleep milliseconds;

def process_test_write_all (stream : RawPtr U8) (buffer : RawPtr U8) (bytes : USize)
    (count : RawPtr U32) (one : USize) : Runtime Unit :=
    match u8_from_nat 1 with | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(one, usize_add one one))), usize_add one one))) | Just running =>
      runtime_bind USize Unit (runtime_loop USize (usize_sub one one)
        (fun (position : USize) => runtime_pure U8 (match usize_less position bytes with
          | True => running | False => u8_sub running running end))
        (fun (position : USize) => runtime_bind (RawPtr U8) USize (raw_add U8 buffer position) (fun (source : RawPtr U8) =>
          runtime_bind U32 USize (raw_windows_file_write stream source (usize_sub bytes position) count) (fun (status : U32) =>
            runtime_bind Unit USize (process_test_status status) (fun (written : Unit) =>
              runtime_bind U32 USize (raw_load_u32 count) (fun (actual : U32) =>
                runtime_pure(USize, usize_add(position, raw_u32_to_size actual))))))))
        (fun (finished : USize) => runtime_pure Unit MkUnit) end;

def process_test_forward (owner : RawPtr U8) (error_stream : Bool) (stream : RawPtr U8)
    (buffer : RawPtr U8) (count : RawPtr U32) (one : USize) : Runtime Unit :=
    match u8_from_nat 1 with | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(one, usize_add one one))), usize_add(one, usize_add one one)))) | Just running =>
      runtime_bind U8 Unit (runtime_loop U8 running
        (fun (state : U8) => runtime_pure U8 state)
        (fun (state : U8) => runtime_bind U32 U8 (raw_windows_process_capture_read owner error_stream buffer (raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight one)))) count)
          (fun (status : U32) => runtime_bind Unit U8 (process_test_status status) (fun (read : Unit) =>
            runtime_bind U32 U8 (raw_load_u32 count) (fun (actual : U32) =>
              match u32_equal(actual, raw_size_to_u32 (usize_sub one one)) with | True => runtime_pure(U8, u8_sub running running) | False =>
                runtime_bind Unit U8 (process_test_write_all stream buffer (raw_u32_to_size actual) count one)
                  (fun (written : Unit) => runtime_pure U8 running) end)))))
        (fun (finished : U8) => runtime_pure Unit MkUnit) end;

-- The harness supplies a bounded binary input, never executable code. Relative
-- offsets become raw pointers here; all process semantics remain in Ouro.
def process_test_pointer (data : RawPtr U8) (field : USize) (one : USize) : Runtime (RawPtr U8) :=
    runtime_bind USize (RawPtr U8) (raw_process_load data field) (fun (offset : USize) =>
      match usize_equal(offset, usize_sub one one) with | True => runtime_pure(RawPtr U8, raw_null U8)
      | False => raw_add U8 data offset end);

def process_test_argument_pointers (data : RawPtr U8) (table : RawPtr U8) (count : USize) (one : USize) : Runtime Unit :=
    match usize_less(raw_process_eight (raw_process_eight one), count) with | True => runtime_pure Unit MkUnit | False =>
      match u8_from_nat 1 with | Nothing => windows_exit_process (raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(one, usize_add one one))), usize_add(usize_add one one, usize_add one one)))) | Just running =>
        runtime_bind USize Unit (runtime_loop USize (usize_sub one one)
          (fun (index : USize) => runtime_pure U8 (match usize_less index count with
            | True => running | False => u8_sub running running end))
          (fun (index : USize) => let offset : USize := raw_process_eight (usize_add index index) in
            runtime_bind USize USize (raw_process_load table offset) (fun (relative : USize) =>
              runtime_bind (RawPtr U8) USize (match usize_equal(relative, usize_sub one one) with
                | True => runtime_pure(RawPtr U8, raw_null U8) | False => raw_add U8 data relative end)
                (fun (text : RawPtr U8) => runtime_bind USize USize (raw_to_bits U8 text) (fun (bits : USize) =>
                  runtime_bind Unit USize (raw_process_store table offset bits)
                    (fun (stored : Unit) => runtime_pure(USize, usize_add index one)))))))
          (fun (finished : USize) => runtime_pure Unit MkUnit) end end;

def process_test_read_input (stream : RawPtr U8) (data : RawPtr U8) (count : RawPtr U32) (one : USize) : Runtime USize :=
    let process_number_0 : USize := (usize_sub one one) in

    runtime_bind U32 USize (raw_windows_file_read stream data (raw_process_eight one) count) (fun (header_status : U32) =>
      runtime_bind Unit USize (process_test_status header_status) (fun (header_read : Unit) =>
        runtime_bind U32 USize (raw_load_u32 count) (fun (header_bytes : U32) =>
          runtime_bind Unit USize (process_test_require(u32_equal(header_bytes, raw_size_to_u32 (raw_process_eight one)), raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add one one, usize_add(one, usize_add one one)))), usize_add(one, usize_add one one))))) (fun (header_ok : Unit) =>
            runtime_bind USize USize (raw_process_load data process_number_0) (fun (total : USize) =>
              runtime_bind Unit USize (process_test_require(raw_bool_and(raw_bool_not (usize_less(total, raw_process_eight (raw_process_eight (usize_add one one)))), raw_bool_not (usize_less(raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight (raw_process_eight one))))), total))), raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add one one, usize_add(one, usize_add one one)))), usize_add(usize_add one one, usize_add one one))))) (fun (length_ok : Unit) =>
                match u8_from_nat 1 with | Nothing => runtime_pure USize process_number_0 | Just running =>
                  runtime_loop USize process_number_0
                    (fun (position : USize) => runtime_pure U8 (match usize_less position total with
                      | True => running | False => u8_sub running running end))
                    (fun (position : USize) => runtime_bind (RawPtr U8) USize (raw_add U8 data position) (fun (target : RawPtr U8) =>
                      runtime_bind U32 USize (raw_windows_file_read stream target (usize_sub total position) count) (fun (status : U32) =>
                        runtime_bind Unit USize (process_test_status status) (fun (read : Unit) =>
                          runtime_bind U32 USize (raw_load_u32 count) (fun (actual : U32) =>
                            runtime_bind Unit USize (process_test_require(raw_bool_not (u32_equal(actual, raw_size_to_u32 process_number_0)), raw_size_to_u32 (usize_add(raw_process_eight (usize_add(raw_process_eight one, usize_add(usize_add one one, usize_add(one, usize_add one one)))), usize_add(usize_add one one, usize_add(one, usize_add one one)))))) (fun (nonempty : Unit) =>
                              runtime_pure(USize, usize_add(position, raw_u32_to_size actual)))))))) end))))));
