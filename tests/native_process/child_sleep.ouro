import "../../runtime/platform/windows_x64.ouro";
def process_child_sleep (milliseconds : U32) : Runtime Unit :=
    windows_capture_sleep milliseconds;
def main : Runtime U32 :=
    match u32_from_nat 1 with | Nothing => runtime_bind USize U32 (raw_to_bits(U8, raw_null U8))
      (fun (zero : USize) => runtime_pure(U32, raw_size_to_u32 zero))
    | Just one_word => match u32_from_nat 16 with | Nothing => runtime_pure U32 one_word | Just shift =>
      runtime_bind Unit U32 (process_child_sleep (u32_shift_left one_word shift))
        (fun (finished : Unit) => runtime_pure U32 one_word) end end;
