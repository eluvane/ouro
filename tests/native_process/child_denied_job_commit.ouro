-- Under a 64 MiB hard Job cap this one-shot 128 MiB commit is denied.
-- A denied allocation has no successful committed peak above a 32 MiB soft
-- threshold. Exit 73 intentionally matches ordinary negative runtime fixtures.
import "../../runtime/platform/windows_x64.ouro";

def main : Runtime U32 :=
    runtime_bind USize U32 (raw_to_bits(U8, raw_null U8)) (fun (anchor : USize) =>
      let one : USize := match usize_from_nat 1 with | Just value => value | Nothing => usize_sub anchor anchor end in
      let shift : U32 := raw_size_to_u32 (usize_add (usize_add(usize_add one one, one))
        (usize_shift_left(usize_add(usize_add one one, one), raw_size_to_u32 (usize_add(usize_add one one, one))))) in
      runtime_bind (RawPtr U8) U32 (raw_pages_allocate(usize_shift_left one shift, one)) (fun (allocation : RawPtr U8) =>
        runtime_bind USize U32 (raw_to_bits U8 allocation) (fun (bits : USize) =>
          match usize_equal(bits, usize_sub one one) with
          | True => match u32_from_nat 73 with | Just code => runtime_pure U32 code | Nothing => runtime_pure U32 shift end
          | False => runtime_bind Bool U32 (raw_pages_release allocation) (fun (released : Bool) =>
              match u32_from_nat 91 with | Just code => runtime_pure U32 code | Nothing => runtime_pure U32 shift end) end)));
