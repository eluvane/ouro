import "../native_host/host_test_common.ouro";

def process_test_require (condition : Bool) (code : U32) : Runtime Unit :=
    let result : Runtime Unit := host_test_require condition code in result;

def process_test_write (base : RawPtr U8) (offset : USize) (value : U8) : Runtime Unit :=
    let result : Runtime Unit := host_test_write base offset value in result;

def process_test_status (status : U32) : Runtime Unit :=
    match u32_equal(status, u32_sub status status) with
    | True => runtime_pure Unit MkUnit | False => windows_exit_process status end;
