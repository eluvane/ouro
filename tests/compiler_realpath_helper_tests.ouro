-- Each helper is linked by checked body identity and complete Core type.
-- MIR pointer erasure never authorizes a different source pointee.
import "../compiler/native/managed_realpath_memory.ouro",
  "../compiler/driver.ouro",
  "compiler_startup_test_support.ouro";

def realpath_helper_cat3 (first : String) (second : String) (third : String) : String :=
    prim_string_concat(first, prim_string_concat second third);

def realpath_helper_cat4 (first : String) (second : String) (third : String) (fourth : String) : String :=
    prim_string_concat(first, realpath_helper_cat3 second third fourth);

def realpath_helper_prefix : String :=
    prim_string_concat
      "intrinsic Effect : Type -> Type := \"ouro.runtime\"; intrinsic Pointer : Type -> Type := \"ouro.raw_ptr\"; intrinsic Byte : Type := \"ouro.u8\"; intrinsic Word : Type := \"ouro.u32\"; intrinsic Size : Type := \"ouro.usize\"; "
      "inductive Flag : Type := | Yes : Flag | No : Flag; representation Flag := \"ouro.bool\"; intrinsic pure : (A : Type) -> A -> Effect A := \"ouro.runtime.pure\"; axiom zero : Word; axiom size_zero : Size; def AliasWord : Type := Word; def AliasSize : Type := Size; def AliasPointer (A : Type) : Type := Pointer A; def Deferred (A : Type) : Type := Effect A; ";

def realpath_helper_kind (opening : Bool) : ManagedRealpathHelper :=
    match opening with | True => ManagedRealpathOpen | False => ManagedRealpathRead end;

def realpath_helper_source (opening : Bool) (mode : Nat) : String :=
    let alias : Bool := eqNat mode 1 in
    let pointer : String := match alias with | True => "AliasPointer " | False => "Pointer " end in
    let first : String := prim_string_concat(pointer, match eqNat mode 10 with | True => "Word" | False => "Byte" end) in
    let second : String := prim_string_concat(pointer, match eqNat mode 13 with | True => "Size" | False => "Byte" end) in
    let size : String := match eqNat mode 11 with | True => "Word" | False => match alias with | True => "AliasSize" | False => "Size" end end in
    let output : String := prim_string_concat pointer (match opening with
      | True => match eqNat mode 6 with | True => "Word" | False => "Size" end
      | False => match eqNat mode 6 with | True => "Size" | False => "Word" end end) in
    let result : String := match eqNat mode 12 with | True => "Effect Size"
      | False => match alias with | True => "Deferred AliasWord" | False => "Effect Word" end end in
    let parameters : String := realpath_helper_cat4 "(stream : " first ") " (prim_string_concat
      (match opening with | True => "" | False => realpath_helper_cat3 "(buffer : " second ") " end)
      (realpath_helper_cat4 "(capacity : " size ") (count : " (prim_string_concat output ")"))) in
    let arguments : String := realpath_helper_cat4 first " -> "
      (match opening with | True => "" | False => prim_string_concat second " -> " end)
      (realpath_helper_cat4 size " -> " output " -> ") in
    let name : String := prim_string_of_char_codes (managed_realpath_helper_name (realpath_helper_kind opening)) in
    prim_string_concat realpath_helper_prefix (match eqNat mode 7 with
      | True => realpath_helper_cat4 "axiom " name " : " (realpath_helper_cat3 arguments result ";")
      | False => match eqNat mode 9 with
        | True => realpath_helper_cat4 "extern " name " : " (realpath_helper_cat3 arguments result
            " := \"windows-x86_64\" \"win64\" \"kernel32.dll\" \"GetLastError\" \"nogc\";")
        | False => realpath_helper_cat4 "def " name " " (realpath_helper_cat4 parameters " : " result
            (match eqNat mode 12 with | True => " := pure Size size_zero;" | False => " := pure Word zero;" end)) end end);

def realpath_helper_compiler (program : CheckedProgram) (contracts : List LowerContract) : ManagedCompiler :=
    ManagedCompilerOf program ([] : List Nat) 0 0 0 0 0 0 contracts
      (check_environment_from_entries (checked_program_entries program));

def realpath_helper_contracts (mode : Nat) (contract : LowerContract) : List LowerContract :=
    match contract with | LowerContractOf id annotation arguments result binding =>
      match eqNat mode 2 with | True => ([] : List LowerContract) | False =>
        ([LowerContractOf (match eqNat mode 3 with | True => S id | False => id end)
          (match eqNat mode 4 with | True => CSort 0 | False => annotation end) arguments result
          (match eqNat mode 5 with
            | True => Just(PrimitiveBinding, PrimitiveIntrinsicBinding PrimitiveFileRealpath PrimitiveRuntimeAction PrimitiveMayGc (Nothing CoreTerm))
            | False => binding end)] : List LowerContract) end end;

def realpath_helper_resolve (opening : Bool) (mode : Nat) (program : CheckedProgram) : Either NativeLowerError Nat :=
    let compiler : ManagedCompiler := realpath_helper_compiler(program, [] : List LowerContract) in
    let helper : ManagedRealpathHelper := realpath_helper_kind opening in
    let name : List Nat := managed_realpath_helper_name helper in
    lower_bind Nat Nat (managed_source_symbol program name) (fun (id : Nat) =>
      match lookup_type(id, checked_program_entries program) with
      | Nothing => Left NativeLowerError Nat (LowerUnknownGlobal id)
      | Just annotation => lower_bind LowerContract Nat
          (lower_make_contract primitive_default_fuel (checked_program_entries program) id annotation (Nothing PrimitiveBinding))
          (fun (contract : LowerContract) => lower_bind CoreTerm Nat (managed_realpath_expected compiler helper)
            (fun (expected : CoreTerm) => lower_bind LowerContract Nat
              (managed_runtime_contract (realpath_helper_compiler(program, realpath_helper_contracts mode contract))
                (match eqNat mode 8 with | True => 0 | False => primitive_default_fuel end) name expected)
              (fun (selected : LowerContract) => lower_map Unit Nat (fun (_ : Unit) => id)
                (lower_require(eqNat(lower_contract_id selected, id), LowerInvalidCall id))))) end);

def realpath_helper_probe (opening : Bool) (mode : Nat) : String :=
    match compile_checked_source(mul 100 50, prim_string_to_char_codes (realpath_helper_source opening mode)) with
    | CErr _ => "source-rejected"
    | COk program => match realpath_helper_resolve opening mode program with
      | Right _ => "linked" | Left error => match error with
        | LowerResourceExhausted => "resource" | LowerMetadataMismatch _ => "metadata"
        | LowerBodyMismatch _ => "body" | LowerInvalidCall _ => "call"
        | LowerDeclarationFailure _ _ _ => "declaration" | LowerUnsupportedType _ => "type"
        | LowerUnsupportedTerm _ => "term" | LowerUnsupportedPrimitive _ => "primitive"
        | LowerUnknownGlobal _ => "global" | LowerUnboundLocal _ => "local" | LowerEffectMismatch => "effect"
        | LowerInvalidEntry _ => "entry" | LowerMirFailure _ => "mir" | LowerBackendFailure _ => "backend" end end end;

def realpath_helper_tests (opening : Bool) : List StartupTest :=
    let label : String := match opening with | True => "realpath open " | False => "realpath read " end in
    let test (name : String) (mode : Nat) (expected : String) : StartupTest :=
      startup_test_eq(prim_string_concat label name, realpath_helper_probe opening mode, expected) in
    append StartupTest
      ([test "links its checked body" 0 "linked",
        test "accepts normalized pointer, scalar and Runtime aliases" 1 "linked",
        test "rejects an absent raw contract" 2 "call",
        test "rejects another raw contract ID" 3 "call",
        test "rejects the same ID with different Core metadata" 4 "metadata",
        test "rejects a primitive binding instead of a body" 5 "body",
        test "preserves the output cell pointee" 6 "metadata",
        test "rejects an axiom instead of a body" 7 "body",
        test "propagates normalization fuel exhaustion" 8 "resource",
        test "rejects an extern instead of a body" 9 "body",
        test "preserves the path or handle pointee" 10 "metadata",
        test "preserves the USize capacity" 11 "metadata",
        test "preserves Runtime U32 result" 12 "metadata"] : List StartupTest)
      (match opening with | True => ([] : List StartupTest)
        | False => [test "preserves the destination buffer pointee" 13 "metadata"] end);

def main : IO Unit :=
    startup_test_run (append(StartupTest, realpath_helper_tests True, realpath_helper_tests False));
